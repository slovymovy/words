                                        "entry_id": "e5054905-ba5e-3b00-8ea1-4d96d35b922c",
                                        "glosses": [
                                            "A silent or passive assent or submission, or a submission with apparent consent, distinguished from avowed consent on the one hand, and on the other, from opposition or open discontent; quiet satisfaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22b4d036-7271-4cf8-a2b9-d110073efb24",
                                                "sense_id": "269d17c5-7fe0-33e3-977f-c87af5df51e8",
                                                "text": "reluctant acquiescence"
                                            },
                                            {
                                                "example_id": "c05c19c5-0c52-4430-b65d-ae9838a157eb",
                                                "sense_id": "269d17c5-7fe0-33e3-977f-c87af5df51e8",
                                                "text": "sign of acquiescence"
                                            },
                                            {
                                                "example_id": "9bf880a2-6233-4ad3-a085-2ce06485e633",
                                                "sense_id": "269d17c5-7fe0-33e3-977f-c87af5df51e8",
                                                "text": "in acquiescence with"
                                            },
                                            {
                                                "example_id": "7b6558d9-7212-435d-ab47-2624b2cee088",
                                                "sense_id": "269d17c5-7fe0-33e3-977f-c87af5df51e8",
                                                "text": "She nodded in quiet acquiescence."
                                            },
                                            {
                                                "example_id": "43fec454-6d25-4873-8456-e71d19586656",
                                                "sense_id": "269d17c5-7fe0-33e3-977f-c87af5df51e8",
                                                "text": "His acquiescence to their demands surprised everyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da981fec-5f97-31b2-80f4-e1b31c6d1129",
                                        "entry_id": "e5054905-ba5e-3b00-8ea1-4d96d35b922c",
                                        "glosses": [
                                            "Inaction, passivity, or neglect to take legal action when it is called for in order to assert, preserve, or safeguard a right, and which inaction implies the abandonment of said right."
                                        ],
                                        "tags": [
                                            "countable",
