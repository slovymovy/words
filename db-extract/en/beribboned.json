        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9a22afde-d34e-3385-9b9b-15e438989312",
                "word": "beribboned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "627ca76a-5faa-32b6-ae96-5d94b7e552c7",
                        "entry_id": "9a22afde-d34e-3385-9b9b-15e438989312",
                        "glosses": [
                            "Adorned or trimmed with ribbons."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e929a2e-3f07-4829-8efd-3d292d23bac4",
                                "sense_id": "627ca76a-5faa-32b6-ae96-5d94b7e552c7",
                                "text": "The beplumed and beribboned equipages were designed to harmonize with and en­hance the appearances of the performers."
                            },
                            {
                                "example_id": "28d3b35c-13f2-4ea7-b941-96f6823a4045",
                                "sense_id": "627ca76a-5faa-32b6-ae96-5d94b7e552c7",
                                "text": "The marble lobby of The Game Club was full of hearty handshakes and members' backslaps. Lights twinkling with Christmas, the gift counter piled with white teddy bears and boxes of beribboned candies."
                            },
                            {
                                "example_id": "00552318-2235-4784-bd8a-46f01e949b4b",
                                "sense_id": "627ca76a-5faa-32b6-ae96-5d94b7e552c7",
                                "text": "In a far cry from the late ’70s, when Tracy Austin’s pigtails and bangs signaled her youth and Chris Evert’s beribboned ponytail personified the country club ideal, today’s braids are creative and sophisticated."
                            },
                            {
                                "example_id": "9cfb4f93-0b37-4f26-8474-3e7d4affbde5",
                                "sense_id": "627ca76a-5faa-32b6-ae96-5d94b7e552c7",
                                "text": "This would have struck a discordant note in a place where the meadows are beribboned with late-summer wildflowers and where the transformed barn offers soothing intimacy without sacrificing visual drama."
                            }
                        ]
                    }
