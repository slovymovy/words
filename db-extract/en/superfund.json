                "senses": [
                    {
                        "sense_id": "e98e57e2-70d8-3c4b-95b2-92a794f840ce",
                        "entry_id": "858e5866-d869-3258-88df-253fdc6cfb3c",
                        "glosses": [
                            "To fund (a college payment plan) with a large payment, more than the usual annual payment."
                        ],
                        "tags": [
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ca6d7369-58c5-4c8f-9bde-002edde934d8",
                                "sense_id": "e98e57e2-70d8-3c4b-95b2-92a794f840ce",
                                "text": "You also have the option to \"superfund\" a 529 account by giving a five-year annual gift all at once. The benefit of superfunding the account is that with a higher starting balance, the account will accrue higher earnings. Individuals can donate up to $75,000 (couples can donate $150,000) at one time."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3105f59-91c3-3fcf-84e6-bc6fb576e621",
                        "entry_id": "858e5866-d869-3258-88df-253fdc6cfb3c",
                        "glosses": [
                            "To fund (environmental cleanup) by means of a Superfund."
                        ],
                        "tags": [
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc92943b-0128-4b22-ad65-65f12db0143e",
                                "sense_id": "d3105f59-91c3-3fcf-84e6-bc6fb576e621",
                                "text": "Defendants also had \"ample opportunity to propose incorporation\" of a provision in the decree prohibiting or limiting the FPA from superfunding the area outside the Box."
                            }
                        ]
                    }
