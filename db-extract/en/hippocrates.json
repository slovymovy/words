                        "sense_id": "47808ae1-7d40-34fc-9256-449611337311",
                        "entry_id": "892e718f-4ea8-3851-a052-b9d881b2ed22",
                        "glosses": [
                            "A transliteration of the Ancient Greek male given name Ἱπποκράτης (Hippokrátēs), notably borne by Hippocrates of Cos, an Ancient Greek physician, circa 5th century BC, sometimes called the \\\"father of medicine\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15bb7ac-219e-43a1-8319-1b18b2387f18",
                                "sense_id": "47808ae1-7d40-34fc-9256-449611337311",
                                "text": "The ancient Greek physician Hippocrates promoted wine for various purposes, including reducing fevers and dressing wounds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af9132e6-6024-41ab-a12e-ff0c7f3c7694",
