{
    "word_family": [
        "эмоциональный",
        "эмоциональность",
        "эмоционировать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f356c73e-9443-38ab-930d-dc9191bc52f3",
                    "sense_definition": "Душевное переживание, внутреннее чувство человека, отражающее его отношение к окружающему миру или к самому себе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "чувство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Радость — это очень сильная и приятная <w>эмоция</w>, которую испытывает каждый человек.",
                            "target_lang_translations": {
                                "en": "Joy is a very strong and pleasant <w>emotion</w> that every person experiences."
                            }
                        },
                        {
                            "text": "В этот момент его переполняли самые разные <w>эмоции</w>, от удивления до страха.",
                            "target_lang_translations": {
                                "en": "At that moment, he was overwhelmed by a wide variety of <w>emotions</w>, from surprise to fear."
                            }
                        }
                    ],
                    "synonyms": [
                        "переживание",
                        "чувство"
                    ],
                    "antonyms": [
                        "индифферентность",
                        "бесстрастность",
                        "равнодушие"
                    ],
                    "common_phrases": [
                        "положительные эмоции",
                        "вызывать эмоции",
                        "сдерживать эмоции"
                    ],
                    "target_lang_definitions": {
                        "en": "An internal mental experience or feeling of a person, reflecting their attitude towards the surrounding world or themselves."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emotion",
                                "target_lang_sense_clarification": "strong internal feeling"
                            },
                            {
                                "target_lang_word": "feeling",
                                "target_lang_sense_clarification": "emotional state or experience"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0418a3c1-73c8-36d1-9e23-eec16cd918ca",
                    "sense_definition": "Внешнее проявление или выражение душевного переживания, чувств.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "выражение чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На его лице не отразилось ни одной <w>эмоции</w>, когда он услышал эту новость.",
                            "target_lang_translations": {
                                "en": "Not a single <w>emotion</w> showed on his face when he heard the news."
                            }
                        },
                        {
                            "text": "Художник пытался передать на холсте живые человеческие <w>эмоции</w>.",
                            "target_lang_translations": {
                                "en": "The artist tried to convey vivid human <w>emotions</w> on the canvas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "выражение эмоций",
                        "буря эмоций"
                    ],
                    "target_lang_definitions": {
                        "en": "The outward manifestation or expression of an internal mental experience or feeling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emotion",
                                "target_lang_sense_clarification": "visible expression of feeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}