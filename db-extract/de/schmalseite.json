                "senses": [
                    {
                        "sense_id": "88faae64-036d-338e-abaf-44235e8fee54",
                        "entry_id": "14bcb7ce-8b82-3e17-a89c-2f5500304baa",
                        "glosses": [
                            "schmale (weniger ausgedehnte) Seite eines länglichen Gegenstands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68b9b50-2cd7-4f0c-acce-067254748eba",
                                "sense_id": "88faae64-036d-338e-abaf-44235e8fee54",
                                "text": "„Sie saßen wieder am Küchentisch, der mit dem gelben Wachstuch bedeckt war, und Josey stand an der Schmalseite des Tischs und hatte die Arme verschränkt.“"
                            },
                            {
                                "example_id": "37ead617-38c9-40bf-87c1-320cd373e6e0",
                                "sense_id": "88faae64-036d-338e-abaf-44235e8fee54",
                                "text": "„Ein paar kleine Sofas standen wie früher an den Schmalseiten einander gegenüber, während zwei größere die Mitte der Längswand einnahmen und nichts als die vergoldete Rokokodoppeltür zwischen sich hatten.“"
                            },
                            {
                                "example_id": "ff5dae42-cf48-4a30-a9c7-0cf03422062d",
                                "sense_id": "88faae64-036d-338e-abaf-44235e8fee54",
                                "text": "„Bei diesen Worten hatte sie auf die entfernte Schmalseite des Platzovals gewiesen.“"
                            },
                            {
                                "example_id": "5c527f2f-2ad9-46c7-8e59-5e6de6825c90",
                                "sense_id": "88faae64-036d-338e-abaf-44235e8fee54",
                                "text": "„Das Schwimmen war sehr schön und erfrischend, und ich bin von einer Schmalseite des großen Schwimmbeckens zur anderen Schmalseite getaucht, ohne den Kopf aus dem Wasser zu heben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
