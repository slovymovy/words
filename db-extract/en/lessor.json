                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8badac2-36f8-47f4-b64a-19c054f87997",
                                                "sense_id": "c57e04df-945d-3beb-8e58-a0ef0f781801",
                                                "text": "De verhuurder zorgde dat het huis geen gebreken had."
