                                        "glosses": [
                                            "stan wywołany przez czynniki fizyczne lub psychiczne poprzedzający wymioty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49970dfd-8820-44ee-a9ea-6ecac90c7385",
                                                "sense_id": "e07c26c6-acc2-3c73-bf41-0dfb18f507ec",
                                                "text": "Jego zachowanie przyprawiło niektórych widzów o mdłości."
                                            },
                                            {
                                                "example_id": "e53e1365-529b-4961-9071-f97009a5f53d",
                                                "sense_id": "e07c26c6-acc2-3c73-bf41-0dfb18f507ec",
                                                "text": "Gołąbek wymiotny nie należy do najsilniej trujących grzybów, jednak po zjedzeniu nawet małej ilości powoduje bóle brzucha, mdłości i wymioty."
                                            }
