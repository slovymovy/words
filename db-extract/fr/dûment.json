                                                "sense_id": "e821f35f-c36e-3515-aa8e-1b6cbfce7493",
                                                "text": "Hij heeft zijn opleiding behoorlijk snel gedaan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
