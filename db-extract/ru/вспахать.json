                                            },
                                            {
                                                "example_id": "c42579e0-8e47-4989-a7bc-0070e28834d8",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Il put donc reconnaître que, s'il avait de-ci de-là, un peu partout, les chairs labourées, aucune de ses blessures ne l'avait atteint en profondeur."
                                            },
                                            {
                                                "example_id": "38ac6cfd-b1e4-4dd2-8ee5-8fc450160709",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "[…] la mer est devant moi, immense et glauque, rayée de larges ombres violettes, labourée par des vagues profondes, dont les crêtes, balancées çà et là, blanchissent."
                                            },
                                            {
                                                "example_id": "3c40ee56-b7fb-48fa-a806-1f3672f4148c",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Cheval qui laboure le terrain, se dit d’un cheval qui butte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196999f7-d763-3f29-8e5f-797f92577312",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Blesser moralement en profondeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5271ea-aa1c-4edc-bce9-e9352551d0de",
                                                "sense_id": "196999f7-d763-3f29-8e5f-797f92577312",
                                                "text": "Nous fûmes, cet été-là, soumis à la plus dangereuse des tentations. Je dis nous… oh! je n'étais alors qu'un frêle petit garçon ; mais je ressentais nos épreuves avec une passion toute fraîche et les misères de mon clan me labouraient jusqu'au fond de l'âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Se dit d’une ancre qui ne tient pas sur le fond où on l’a jetée, ou d’un navire qui passe et touche le fond sans être arrêté."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d4bb942-e09f-488e-baf4-beb4ba5bd649",
                                                "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                                "text": "Cette ancre laboure le fond, ou simplement laboure."
                                            },
                                            {
                                                "example_id": "8769ed0e-5cbb-4157-9008-bd55dd391e95",
                                                "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                                "text": "Notre vaisseau labourait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc9653f3-3716-4477-b2e1-4ff9909fdd68",
                        "source_entry_id": "e601dea4-8ff5-3ee9-85b9-a0c79129d6d9",
                        "source_sense_id": "84fb637c-d895-39f7-b4a3-0afbfebf95ca",
                        "target_lang_word": "zorat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zorat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "617d6881-5897-31d4-bab5-770241d9dd4d",
                                        "entry_id": "7d89d8d1-7519-34dc-b230-5eb7fe5244f5",
                                        "glosses": [
                                            "pluhem nebo obdobným zařízením zkypřit, např. před zasetím obilí; oráním celé obdělat, vytvořit brázdu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad98131-c205-439e-ac55-9fdd582ed534",
                                                "sense_id": "617d6881-5897-31d4-bab5-770241d9dd4d",
                                                "text": "Cestičku jsem zoral, dělal jsem ji užší, abych blíž se tisknul k milované duši"
                                            },
                                            {
                                                "example_id": "9fb3714f-3423-4c2b-ad94-f066ff68cdf8",
                                                "sense_id": "617d6881-5897-31d4-bab5-770241d9dd4d",
                                                "text": "Nebo takto praví Hospodin mužům Judským a Jeruzalémským: Zořte sobě ouhor, a nerozsívejte do trní."
                                            },
                                            {
                                                "example_id": "892e4cf0-316c-46d1-b47e-06f56ace9552",
                                                "sense_id": "617d6881-5897-31d4-bab5-770241d9dd4d",
                                                "text": "Jde ku žni, před ním andělů sbory rovnají zemské doly i hory/ již pluhem poslední zhouby, a hrobů lány zoravše, čisté sbírají zrní k odplatě jisté / tam boží očisty v hloubi"
                                            },
                                            {
                                                "example_id": "cc04e672-6861-49e9-ae72-5406578d058f",
                                                "sense_id": "617d6881-5897-31d4-bab5-770241d9dd4d",
                                                "text": "Na poli, na roli když ty se usměješ, zoře se, požne se, nežli se naděješ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81424db6-7a71-35db-8c38-4269a3ce2ea0",
                                        "entry_id": "7d89d8d1-7519-34dc-b230-5eb7fe5244f5",
                                        "glosses": [
                                            "(zorat to, častěji varianta s protetickým v-, tedy zvorat) zkazit, zbřídit, odvést práci s nekvalitními výsledky"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78870ef-9def-485b-9259-bff453a61907",
                                                "sense_id": "81424db6-7a71-35db-8c38-4269a3ce2ea0",
                                                "text": "Obrázek hlasujícího Schwarzenberga je doprovozen sloganem: Tentokrát to nesmíme z(v)orat."
                                            },
                                            {
                                                "example_id": "a9d0f052-2001-4044-b3f8-2f4e4890499f",
                                                "sense_id": "81424db6-7a71-35db-8c38-4269a3ce2ea0",
                                                "text": "Co mladí zorali, to museli starší napravovat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
