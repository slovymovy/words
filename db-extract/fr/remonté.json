                    {
                        "translation_id": "8f91bc27-5bc7-4cd3-b56d-22ddfa2dd84f",
                        "source_entry_id": "d9c78c03-77d9-30f7-b69e-04659574c855",
                        "source_sense_id": "1165bb62-8d7b-3fcc-a33d-d61ddbb1d9f5",
