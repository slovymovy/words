                "senses": [
                    {
                        "sense_id": "e1474780-8b26-3b9e-832e-885b97031222",
                        "entry_id": "b0fd1951-abbf-35a2-a09f-62a45d027146",
                        "glosses": [
                            "ein durch einen Motor angetriebenes Landfahrzeug mit Passagierraum, welches nicht an Bahngleise gebunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20adba5-705c-4bf6-9be2-966f218931ef",
                                "sense_id": "e1474780-8b26-3b9e-832e-885b97031222",
                                "text": "Es gibt so viele Kraftwagen auf der Welt wie nie zuvor."
                            },
                            {
                                "example_id": "4c4a526a-79fe-403f-9843-6ad152237155",
                                "sense_id": "e1474780-8b26-3b9e-832e-885b97031222",
                                "text": "Der Ausdruck Kraftwagen wird in der Alltagssprache wenig gebraucht."
                            },
                            {
                                "example_id": "e2dd8a9c-2763-46c5-b007-3eeaeada3d58",
                                "sense_id": "e1474780-8b26-3b9e-832e-885b97031222",
                                "text": "„Als der Kraftwagen vor ihrer Wohnung hielt, bat sie leise: »Komm mit.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "519ec2cd-dbbb-4a82-8a7c-91e55a83278c",
                        "source_entry_id": "b0fd1951-abbf-35a2-a09f-62a45d027146",
                        "source_sense_id": "e1474780-8b26-3b9e-832e-885b97031222",
                        "target_lang_word": "motor car",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motor car",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5447184b-aa57-3d2e-a1de-eacbd8be98eb",
                                        "entry_id": "2a044aea-837c-316d-866c-2f1957c484fd",
                                        "glosses": [
                                            "Alternative form of motorcar (“self-propelled railway vehicle”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e444504-eb12-4bb5-9175-b41233ed14ed",
                                                "sense_id": "5447184b-aa57-3d2e-a1de-eacbd8be98eb",
                                                "text": "The 20 sets of B.W. [British Westinghouse] equipment, including motor bogies and traction motors, were refitted to 20 new motor cars, similar in design to the 1913 stock, again at the railway company's Neasden Works."
                                            },
                                            {
                                                "example_id": "2187dda7-08db-4d7a-b2f9-de0f1ec9bf34",
                                                "sense_id": "5447184b-aa57-3d2e-a1de-eacbd8be98eb",
                                                "text": "A motor car is provided with two self-ventilated series-wound G.E.C. traction motors, each having a continuous rating of 80 h.p. at 575 V. 116 A. at a field strength of 66 per cent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec69ce2-2f0e-3358-b9a9-56f4131dac41",
                                        "entry_id": "2a044aea-837c-316d-866c-2f1957c484fd",
                                        "glosses": [
                                            "Alternative form of motorcar (“automobile”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84136a8-e4af-4205-b347-4cbaeffbfadb",
                                                "sense_id": "9ec69ce2-2f0e-3358-b9a9-56f4131dac41",
                                                "text": "Today the motor car is not taken seriously as a solution to the problems of mass transport, and the transport planners of south-east England - and the mayor of London himself, judging by his Transport Plan - think in terms of trains and underground trains in particular […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
