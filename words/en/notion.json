                            },
                            {
                                "target_lang_word": "fournitures de couture",
                                "target_lang_sense_clarification": "matériel nécessaire pour coudre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09f1a45b-5ced-3e36-b09b-b7fbbe485ece",
                    "sense_definition": "A small, clever invention or a decorative knickknack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peddler sold various Yankee <w>notions</w> and household gadgets to the villagers.",
                            "target_lang_translations": {
                                "ru": "Разносчик продавал жителям деревни различные американские <w>безделушки</w> и бытовые приспособления.",
                                "fr": "Le colporteur vendait divers <w>bibelots</w> et gadgets ménagers aux villageois."
                            }
                        },
                        {
                            "text": "His desk was covered in strange little <w>notions</w> he had collected over the years.",
                            "target_lang_translations": {
                                "ru": "Его стол был завален странными маленькими <w>вещицами</w>, которые он собирал годами.",
                                "fr": "Son bureau était couvert d'étranges petits <w>objets</w> qu'il avait collectionnés au fil des ans."
                            }
                        }
                    ],
                    "synonyms": [
                        "knickknack",
                        "trinket",
                        "gadget",
                        "device"
                    ],
                    "common_phrases": [
                        "Yankee notions"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое умное изобретение или декоративная безделушка.",
                        "fr": "Une petite invention ingénieuse ou un bibelot décoratif."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "маленькая декоративная вещь"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "небольшое хитроумное устройство"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "bibelot",
                                "target_lang_sense_clarification": "petit objet décoratif"
                            },
                            {
                                "target_lang_word": "gadget",
                                "target_lang_sense_clarification": "petit objet ingénieux ou accessoire"
                            }
                        ]
                    }
                }
            ]
        }
    ]
