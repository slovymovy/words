        "fr-extract.jsonl": [
            {
                "entry_id": "cb1710cf-2b5f-3b38-8fd6-9a568ba90415",
                "word": "nid-de-poule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0272c944-81a0-4dee-87ff-deff4a9ab003",
                        "entry_id": "cb1710cf-2b5f-3b38-8fd6-9a568ba90415",
                        "tags": [
                            "plural"
                        ],
                        "form": "nids-de-poule"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                        "entry_id": "cb1710cf-2b5f-3b38-8fd6-9a568ba90415",
                        "glosses": [
                            "Variante de nid de poule."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "dff0b404-0908-4f4e-b079-8e3b69e398c7",
                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                "text": "Bien que projeté souvent au plafond à cause des nids-de-poule qui en ce temps n’étaient pas rares sur les nationales françaises, mon oncle Henri gardait l’air serein des samouraïs face à la mort."
                            },
                            {
                                "example_id": "770f49b7-2bdf-4084-9c6c-f5aacd94d4b7",
                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                "text": "Cahin-caha, après avoir déposé tous ses passagers palestiniens et franchi encore quelques passages difficiles sur une route semée de chicanes, de ralentisseurs et de nids-de-poule, le taxi atteint notre troisième checkpoint, Zatara."
                            },
                            {
                                "example_id": "a0d80ee8-45d2-4412-8d09-22112ec2ebbc",
                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                "text": "La route étroite et non goudronnée, grêlée de nids-de-poule, ne cessait de monter et descendre, tout droit devant elle."
                            },
                            {
                                "example_id": "53f77896-6e31-457f-a5b1-ee0dcc0e3dff",
                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                "text": "Les faits se sont déroulés en fin d’après-midi : selon une source judiciaire, citée par nos confrères de Lille Actu, la victime s’est fait surprendre par un nid-de-poule avant de tomber sur la tête."
                            },
                            {
                                "example_id": "be6105bb-4ad7-449c-a867-c269b6f6e511",
                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                "text": "Tu es très bien habillé ! Par contre je ne sais pas quel imbécile t'a coupé les cheveux, c'est raté, il y a des nids-de-poule partout !"
                            }
                        ]
                    }
                ],
