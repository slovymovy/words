                "senses": [
                    {
                        "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                        "entry_id": "08d6fe63-8c5b-343c-bd1d-fad8b4dded07",
                        "glosses": [
                            "Leistungsvermögen eines Spielers oder einer Spielerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3a7360-b803-49f6-a2cc-64d5d3b02991",
                                "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                                "text": "„In der Begegnung mit der bildlichen Darstellung von Spielen, die vielleicht unbekannt sind, im Betrachten, Erproben, Experimentieren mit diesen Spielen, in der sprachlichen Auseinandersetzung und im physischen Erleben können von den Spielenden vielleicht schon verschüttete Spielpotenziale entdeckt und aktiviert werden.“"
                            },
                            {
                                "example_id": "5740066d-f1d6-47dc-ad6b-2da8d0dbbb8f",
                                "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                                "text": "„Gelangt der Vorgabenausschuss des Heimatclubs eines Spielers zu der begründeten Überzeugung, dass die EGA-Vorgabe des Spielers ein falsches Bild von dessen tatsächlichem Spielpotenzial vermittelt, so hat der Vorgabenausschuss die EGA-Vorgabe des Spielers angemessen und um mindestens einen vollen Schlag herauf- bzw. herabzusetzen.“"
                            },
                            {
                                "example_id": "57baae9b-50a8-4229-ace7-bb0c1ad62d1e",
                                "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                                "text": "„Die Pleite gegen Recklinghausen hat die FC-Spielerinnen wachgerüttelt. Wie groß ihr Spielpotenzial ist, zeigten sie den rund 100 Zuschauern in der spannenden Partie gegen den Tabellenführer.“"
                            },
                            {
                                "example_id": "75a208f9-c9f4-47e4-aa3e-e9a3122ca0c6",
                                "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                                "text": "„Von unserem Spielpotenzial sind wir in der Lage, jederzeit Sätze zu gewinnen und den Gegner unter Druck zu setzen, versichert Trainer Adrian Pfleghar, und vergisst nicht, hinzuzufügen: Das müssen wir nur umsetzen.“"
                            },
                            {
                                "example_id": "dc6fe48b-22ad-402a-8930-15de7d2f1abd",
                                "sense_id": "1d43ec09-376c-3f41-a250-0b5eff1411c9",
                                "text": "„Die Sicherheit gibt ihm nicht nur das Wissen um das Spielpotenzial ‚meiner Mädels‘, sondern auch der Fakt, dass von den bisher acht Spielen die Hälfte mit maximal fünf Toren Differenz verloren ging, zwei davon mit nur einem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                        "entry_id": "08d6fe63-8c5b-343c-bd1d-fad8b4dded07",
                        "glosses": [
                            "Spielmöglichkeiten eines Spielzeugs, eines Spielgeräts oder Spielgeländes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb62a006-5cad-4fb4-bdef-e5fc9d37d1a5",
                                "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                                "text": "„Claus Peymann nimmt die orthodoxe Chose fröhlich, ganz Theatermann: eine hübsche alte Form mit viel Spielpotenzial.“"
                            },
                            {
                                "example_id": "2d252342-621a-4046-935e-1595dc84f764",
                                "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                                "text": "„Die zentralen Ergebnisse dieser Studien zusammenfassend lässt sich also sagen, dass der Spielplatztyp allein für das Spielverhalten wenig ausschlaggebend ist. Jeder Spielplatztyp weist ein eigenes Spielpotenzial auf.“"
                            },
                            {
                                "example_id": "bf8cac30-3147-4b0c-9005-d325207c3277",
                                "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                                "text": "„Qualitätssteigernd wirken das Spielpotenzial, die Menge an Bäumen, Sträuchern und hügeligem Terrain sowie das ausgewogene Zusammenspiel von Vegetation, offenen Flächen und Spielflächen.“"
                            },
                            {
                                "example_id": "93cd356d-91a4-41e0-8198-226905d63db4",
                                "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                                "text": "„Die Sets sorgten auch dafür, dass die Kinder durch Fahrzeuge, Bäume, Büsche und Verkehrszeichen die Straßenzüge ausschmücken und dadurch zusätzliches Spielpotenzial entdecken konnten.“"
                            },
                            {
                                "example_id": "def483c1-00ed-4a35-b6ca-cecca3a6b839",
                                "sense_id": "694cd3f6-14b1-3bcc-a448-a5f060c8f2e8",
                                "text": "„Es gilt, Flächen für kindliches Spiel zu sichern, die keine Spielplätze sind, aber offensichtlich Spielpotenzial aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
