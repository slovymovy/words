                    {
                        "sense_id": "1482bf8d-2360-3c4c-a624-c301deff0547",
                        "entry_id": "215eb646-5bc2-3398-8405-53695df2baa5",
                        "glosses": [
                            "To center (something) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9a22ff33-eb28-4a19-84b5-52cd8dc6703a",
                                "sense_id": "1482bf8d-2360-3c4c-a624-c301deff0547",
                                "text": "Now I recenter my immortal mind / In the deep sabbath of meek self-content; / Cleans'd from the vaporous passions that bedim / God's Image, sister of the Seraphim."
                            },
                            {
                                "example_id": "f6ff767b-eda5-4e29-81ea-1dfd0ae30a67",
                                "sense_id": "1482bf8d-2360-3c4c-a624-c301deff0547",
                                "text": "18.1 Scrolling\nC-l (recenter-top-bottom) is a basic scrolling command. It recenters the selected window, scrolling it so that the current screen line is exactly in the center of the window, or as close to the center as possible."
                            }
                        ]
                    }
