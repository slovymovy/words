                            {
                                "example_id": "12b45e37-8208-436e-935b-3ca67e4db416",
                                "sense_id": "a9ec4d09-ac8b-3468-a5f9-77de762b1fa9",
                                "text": "De woonwagencultuur dient te worden behouden. Net zomin als er onderscheid mag worden gemaakt op basis van ras, mag dat op basis van het verschil woonwagenbewoner of huisbewoner."
                            }
                        ]
                    },
                    {
