        "fr-extract.jsonl": [
            {
                "entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                "word": "iconique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e6eaea74-8823-4979-8373-2e31ceeff30f",
                        "entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "iconiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d393816-0928-31a0-b409-3a8876d2e39f",
                        "entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                        "glosses": [
                            "Relatif aux icônes, à la représentation de(s) dieu(x)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f49bf7-b82c-4f3c-8f93-feadfc84ad2f",
                                "sense_id": "3d393816-0928-31a0-b409-3a8876d2e39f",
                                "text": "Une première phase, essentiellement indienne, appelée phase aniconique, durant laquelle la personne du Bouddha est évoquée par des symboles, est suivie vers le Iᵉʳ siècle d’une phase iconique durant laquelle apparaissent des représentations anthropomorphiques du Bouddha."
                            }
                        ]
                    },
                    {
                        "sense_id": "17423b42-7e19-3234-bccc-e912f2985e46",
                        "entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                        "glosses": [
                            "Relatif à toute forme de représentation visuelle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "240d0785-6bcc-42a0-928c-d44c8f66a4e8",
                                "sense_id": "17423b42-7e19-3234-bccc-e912f2985e46",
                                "text": "La littérature iconique comme les romans photos et les BD."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5d74b2d-66f9-39d3-8fc6-c978e96183d0",
                        "entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                        "glosses": [
                            "(Usage critiqué) référence nécessaire (résoudre le problème) Mythique, emblématique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b917a3fc-921a-429c-8edc-ae676f4a4d81",
                                "sense_id": "f5d74b2d-66f9-39d3-8fc6-c978e96183d0",
                                "text": "\"Combattez avec les vaisseaux iconiques de la saga Star Wars\", \"Pilotez des voitures iconiques\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c5aa38b-99e6-4f7b-9e7d-69ad9e17655a",
                        "source_entry_id": "303d1111-e0df-3ac6-a2f5-3984d8173c25",
                        "source_sense_id": "3d393816-0928-31a0-b409-3a8876d2e39f",
                        "target_lang_word": "iconic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iconic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "558eebe5-e62e-36a5-82fe-59fce8ed3dd0",
                                        "entry_id": "c47c2c29-a913-3921-aed2-962e2109550b",
                                        "glosses": [
                                            "Relating to, or having the characteristics of, an icon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d832f60-1338-3e18-b5a5-05761c3d5be1",
                                        "entry_id": "c47c2c29-a913-3921-aed2-962e2109550b",
                                        "glosses": [
                                            "Distinctive, characteristic, indicative of identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3737a35-223d-4685-83c9-d483759f4858",
                                                "sense_id": "2d832f60-1338-3e18-b5a5-05761c3d5be1",
                                                "text": "an iconic move in martial arts"
                                            },
                                            {
                                                "example_id": "afe18064-e3db-4b4d-aae3-f283ad3758a7",
                                                "sense_id": "2d832f60-1338-3e18-b5a5-05761c3d5be1",
                                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a289642-fc9d-3ca2-a7fc-a3bc40f6ec00",
                                        "entry_id": "c47c2c29-a913-3921-aed2-962e2109550b",
                                        "glosses": [
                                            "Famously and distinctively representative of its type."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5887dc-ba2c-45bc-923e-14f02af23be3",
                                                "sense_id": "4a289642-fc9d-3ca2-a7fc-a3bc40f6ec00",
                                                "text": "For younger musicians, Coltrane’s death became one of those iconic events that stays vividly in the mind."
                                            },
                                            {
                                                "example_id": "7d4ef13d-243c-4fa7-b533-f7ebcea7ecc8",
                                                "sense_id": "4a289642-fc9d-3ca2-a7fc-a3bc40f6ec00",
                                                "text": "She angrily turned, giving me my favorite view, that iconic view of a woman from the rear."
                                            },
                                            {
                                                "example_id": "25dab4fd-3aac-4098-9f7d-772134b783a1",
                                                "sense_id": "4a289642-fc9d-3ca2-a7fc-a3bc40f6ec00",
                                                "text": "In time The Simpsons would, indeed, resort to spoofing such decidedly non-spooktacular fare like E.T and Mr. And Mrs. Smith (both in “Treehouse Of Horror XVIII”) but in 1992 the field was wide-open and the show could cherry-pick the most iconic and beloved fright fare of all time."
                                            },
                                            {
                                                "example_id": "41e87f61-74a7-4c9b-b404-f093bd1fa7eb",
                                                "sense_id": "4a289642-fc9d-3ca2-a7fc-a3bc40f6ec00",
                                                "text": "\"We did look at building a new bridge, but this is an iconic structure,\" says Network Rail Project Manager Michael Bryan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e553d9d7-b936-3eb2-bd56-45b0dedc6ff4",
                                        "entry_id": "c47c2c29-a913-3921-aed2-962e2109550b",
                                        "glosses": [
                                            "Representing something; symbolic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab15633-f677-4e11-bcb1-4a592aadcc41",
                                                "sense_id": "e553d9d7-b936-3eb2-bd56-45b0dedc6ff4",
                                                "text": "an iconic gesture in sign language"
                                            },
                                            {
                                                "example_id": "ac899284-ff50-45b4-bdc5-ea12890f92d8",
                                                "sense_id": "e553d9d7-b936-3eb2-bd56-45b0dedc6ff4",
                                                "text": "A portrait of a person is to a considerable extent iconic, but is not completely so since the painted canvas does not have the texture of the skin, or the capacities for speech and motion, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
