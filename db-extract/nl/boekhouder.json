                ],
                "senses": [
                    {
                        "sense_id": "3b6f6a5c-af38-33a6-a753-e4b758c27234",
                        "entry_id": "b51e4cab-4a5a-3905-b260-13ad79137930",
                        "glosses": [
                            "iemand die de inkomsten en uitgaven van een organisatie bijhoudt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "d976f4b3-a072-4111-8b0b-c82104af979c",
                                "sense_id": "3b6f6a5c-af38-33a6-a753-e4b758c27234",
                                "text": "Mijn vader is boekhouder. Vroeger hielp ik hem vaak met het sorteren van bonnen op datum. Het was een bevredigend proces om van de kluwen papieren briefjes uit de schoenendoos uiteindelijk een georganiseerde map te maken. Helaas heeft deze kinderarbeid niet geresulteerd in enige affiniteit met administratie. Integendeel."
                            },
                            {
                                "example_id": "cb17e190-8e13-4acb-8e0e-47e57b098874",
                                "sense_id": "3b6f6a5c-af38-33a6-a753-e4b758c27234",
                                "text": "Toch was hij ook eigen plannen gaan ontwikkelen. Hij wilde weg, hij voelde wel wat voor Tonkin, al wist hij zelf niet goed waarom. In ieder geval wilde hij het beroep van boekhouder opgeven en iets anders gaan doen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1cefd07-a82c-415d-88b6-2ead1e57019f",
                        "source_entry_id": "b51e4cab-4a5a-3905-b260-13ad79137930",
                        "source_sense_id": "3b6f6a5c-af38-33a6-a753-e4b758c27234",
                        "source_sense_description": "iemand die de inkomsten en uitgaven van een organisatie bijhoudt",
                        "target_lang_word": "Buchhalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                        "entry_id": "2cd9b7b4-2c47-3921-ba08-e34ff075cff2",
                                        "glosses": [
                                            "Person, die in der Buchhaltung tätig ist und die Geschäftsbücher eines Unternehmens führt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Finanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27601cf2-e7b9-46bc-ac5c-92ef8d5fc5e5",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "Die meisten Unternehmen beschäftigen einen eigenen Buchhalter."
                                            },
                                            {
                                                "example_id": "95c3db50-1cd0-4be7-8c4b-97ff5fb22baf",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "Buchhalter mit fundierten und aktuellen Kenntnissen sind gefragte Fachkräfte."
                                            },
                                            {
                                                "example_id": "1df74a6b-9106-48ad-9dfe-ae197c693043",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "„Buchhalter bearbeiten unterschiedliche Geschäftsfälle nach den Grundsätzen ordnungsgemäßer Buchführung und handelsrechtlichen Vorschriften.“"
                                            },
                                            {
                                                "example_id": "a4c48f80-fcfb-40ac-bb08-1474ade11d2c",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "„Der Archivar erblickte einen Schwarm emsiger Buchhalter und Buchhalterinnen, die die Kennziffern der Belegschaftsmitglieder sorgfältig aufschrieben und sorgfältig ausradierten.“"
                                            },
                                            {
                                                "example_id": "ff116ec7-64c7-470e-b122-a31fbe53af33",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "„An dem Abend, an dem Thomas bei Lakuleit zu Gast war, hatte dieser seinen Buchhalter telefonisch hinausgefeuert.“"
                                            },
                                            {
                                                "example_id": "77d6c1bd-7b8e-4b2d-839d-78062acb331d",
                                                "sense_id": "9127c2af-e5f6-33ca-b14e-471f8d32b48d",
                                                "text": "„»Wolf unter Wölfen« spielt im Inflationsjahr 1923 an zwei Fallada bekannten Orten: der Großstadt Berlin und dem Rittergut Radach, dreißig Kilometer nordöstlich von Frankfurt an der Oder, wo Fallada von Anfang Mai bis Oktober 1923 Buchhalter war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "019ca837-b886-47e6-b82e-9ac2c0f19be7",
                        "source_entry_id": "b51e4cab-4a5a-3905-b260-13ad79137930",
