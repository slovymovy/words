                    {
                        "sense_id": "5400eb7a-f40a-3ce6-8685-dff08631d340",
                        "entry_id": "3aa8b45a-dc72-366b-9863-4dd8ceb23cf6",
                        "glosses": [
                            "Qui n’est pas enflammable, ne peut pas être mis en feu facilement."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "88dcf0d9-95cf-4e5c-813d-64a887856efb",
                                "sense_id": "5400eb7a-f40a-3ce6-8685-dff08631d340",
                                "text": "Rebâtir une charpente en bois n’est il pas dangereux ? Elle pourrait brûler de nouveau ! REIMS a donné l’exemple avec une structure Inenflammable"
                            },
                            {
                                "example_id": "17f2303f-54cb-44dd-8ea3-d06458f3ba20",
                                "sense_id": "5400eb7a-f40a-3ce6-8685-dff08631d340",
                                "text": "C’est carrément inenflammable c’est flippant."
                            },
                            {
                                "example_id": "ba9395e3-c58c-436a-9ede-c14269a815a1",
                                "sense_id": "5400eb7a-f40a-3ce6-8685-dff08631d340",
                                "text": "On ne doit pas la dénaturer, donc ok pour une charpente en béton ou autre matériau inenflammable, ou pour ne pas refaire ou modifier la flèche qui ne date que de Viollet le Duc ,mais la toiture doit être identique."
                            },
                            {
                                "example_id": "d7d1cb4f-006e-45cf-bb2a-c850bd42cbc4",
                                "sense_id": "5400eb7a-f40a-3ce6-8685-dff08631d340",
                                "text": "Quand tu auras une société inenflammable fais moi signe... Le diable est dans les détails ! A bon populiste salut!"
                            }
                        ]
                    }
                ],
