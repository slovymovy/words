                                        "sense_id": "7c21878d-d134-359a-a3de-aba621457bb4",
                                        "entry_id": "97b7f05c-6b8a-338b-843f-e5baa3a6ca5f",
                                        "glosses": [
                                            "A poisonous plant, Hyoscyamus niger, used sometimes as a drug that causes at least hallucinations, dilated pupils, restlessness, and flushed skin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878da6aa-cb2d-4f57-8cb4-92ae568e57ea",
                                                "sense_id": "7c21878d-d134-359a-a3de-aba621457bb4",
                                                "text": "Deadly nightshade, henbane, hellebore and mandrakes were of evil reputation[.]"
                                            },
                                            {
                                                "example_id": "7d3caf79-b82a-4ef6-bd12-20b80237ff43",
                                                "sense_id": "7c21878d-d134-359a-a3de-aba621457bb4",
                                                "text": "Henbane acts as an anaphrodisiac."
                                            }
                                        ]
                                    },
