                    }
                ],
                "senses": [
                    {
                        "sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                        "entry_id": "647fb080-fd0b-3cfa-94f1-057f4b9bed68",
                        "glosses": [
                            "emotionele opwinding veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6c27fa-6887-41be-82d9-fb3add2ca202",
                                "sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                                "text": "Dat was de spannendste film die ik ook gezien heb."
                            },
                            {
                                "example_id": "ac7f1db3-4fc9-42a8-99fc-1077f11b6320",
                                "sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                                "text": "‘Het past in het wielrennen van deze tijd. Het moet spannender, specialer, steiler, gekker.’"
                            },
                            {
                                "example_id": "32eb1ba5-7177-42cf-98d3-fd5368b8f758",
                                "sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                                "text": "Haar laatste boek is geen roman geworden. Renate Dorrestein ontdekte al opruimend zoveel spannends in haar huis dat er iets heel anders ontstond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ed669aa-3ce3-4baf-aa8b-f0878fecf8ed",
                        "source_entry_id": "647fb080-fd0b-3cfa-94f1-057f4b9bed68",
                        "source_sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                        "source_sense_description": "emotionele opwinding veroorzakend",
                        "target_lang_word": "enervating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enervating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a570060e-80d9-34af-ac7e-9dabc5479e88",
                                        "entry_id": "5cb521be-489d-3a56-b4ae-e5da71184030",
                                        "glosses": [
                                            "present participle and gerund of enervate"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enervating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2528231-da7a-3108-a254-855251567b24",
                                        "entry_id": "0c688779-2e68-306e-bb4b-e65262559e19",
                                        "glosses": [
                                            "That enervates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a407a178-573a-4158-ac01-cf549ea54dfc",
                                                "sense_id": "a2528231-da7a-3108-a254-855251567b24",
                                                "text": "No enervating arts refined\nTo slumber lull'd his heaven-born might;\nNo weak indulgence warp'd thy mind,\nTo cloud a hero's path of light."
                                            },
                                            {
                                                "example_id": "6829fecb-3673-43a2-b72f-7a92d90eeaee",
                                                "sense_id": "a2528231-da7a-3108-a254-855251567b24",
                                                "text": "I rose by candle-light, and consumed, in the intensest application, the hours which every other individual of our party wasted in enervating slumbers, from the hesternal dissipation or debauch."
                                            },
                                            {
                                                "example_id": "97fa2bb6-72dd-4b71-a9ff-5649234f2e73",
                                                "sense_id": "a2528231-da7a-3108-a254-855251567b24",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "797f53d0-aa1b-475b-9c10-1509b0badbac",
                        "source_entry_id": "647fb080-fd0b-3cfa-94f1-057f4b9bed68",
                        "source_sense_id": "7678c593-66b5-33a7-8d22-4e52d9e52e4d",
                        "source_sense_description": "emotionele opwinding veroorzakend",
                        "target_lang_word": "thrilling",
                        "target_lang_code": "en",
