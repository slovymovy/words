                        "glosses": [
                            "Personne qui étudie les rêves, qui pratique l’onirologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef199b33-2964-499b-b17f-3ff0e34671d2",
                                "sense_id": "a7bd51d9-1ae8-332d-97c5-d61fb6f68153",
                                "text": "Je ne sais quel onirologue a dit « que l’on ne rêvait pas de compagnie. »"
                            },
                            {
                                "example_id": "5a97fe91-aca3-43f1-8b3f-2968a5f641b5",
                                "sense_id": "a7bd51d9-1ae8-332d-97c5-d61fb6f68153",
                                "text": "Le physiologiste et onirologue Michel Jouvet (1997) nous dit qu’il a accumulé, tout au long des années, des centaines, voire plus d’un millier de ses propres rêves."
                            }
                        ]
                    }
