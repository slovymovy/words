                "senses": [
                    {
                        "sense_id": "08c6afdc-11bf-3477-ad06-ec1ce66b814a",
                        "entry_id": "356bd39f-e7c1-37a3-9bf4-357e1e3a1efa",
                        "glosses": [
                            "Eigenschaft eines optischen Gerätes, speziell von einem Objektiv, ein qualitativ hochwertiges Abbild zu erzeugen"
                        ],
                        "tags": [
                            "Fotografie",
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "f0c5eb44-79f3-4ccb-a8ca-f274d39668ce",
                                "sense_id": "08c6afdc-11bf-3477-ad06-ec1ce66b814a",
                                "text": "„Die anfänglich mangelhafte Abbildungsleistung ist inzwischen erheblich verbessert worden, doch sind Objektive mit festen Brennweiten lichtstärker und zeichnen im Extrembereich schärfer.“"
                            },
                            {
                                "example_id": "dc5e23a5-d5e0-4a48-837b-9833f13db442",
                                "sense_id": "08c6afdc-11bf-3477-ad06-ec1ce66b814a",
                                "text": "„Eine Verbesserung der Abbildungsleistung kann durch die Verwendung von Phasenmasken erreicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
