                    {
                        "translation_id": "ccb6adea-7e97-4d5b-8726-08cd4bd6011f",
                        "source_entry_id": "b55d142c-ee46-3c72-84bc-626407b0b2ac",
                        "source_sense_id": "73cc3f6c-2dd8-3599-ae2e-67ca02213ca6",
                        "target_lang_word": "encadrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encadrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9068885f-8321-3b37-9cc5-6b08c3e833f9",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Action d’encadrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d9a5fc-bb30-4a5c-ab3f-4bbe731a9395",
                                                "sense_id": "9068885f-8321-3b37-9cc5-6b08c3e833f9",
                                                "text": "L’encadrement de ce tableau n'est pas fini."
                                            },
                                            {
                                                "example_id": "738a1dab-87b5-44ee-8f56-729bf6c778ea",
                                                "sense_id": "9068885f-8321-3b37-9cc5-6b08c3e833f9",
                                                "text": "Encadrement de crédit, limitation par le gouvernement des facilités monétaires que les banques sont autorisées à accorder aux entreprises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92331e1f-2e27-308a-bf4e-01f0da1606ae",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Ce qui sert à encadrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275e9d75-2e2f-40e7-be90-bf5ac78cd334",
                                                "sense_id": "92331e1f-2e27-308a-bf4e-01f0da1606ae",
                                                "text": "Par une double porte, capitonnée de moleskine, nous pénétrâmes dans une pièce carrelée, aux murs blancs à encadrements rouges, et que les habitués appellent « la chapelle »."
                                            },
                                            {
                                                "example_id": "79d6a93b-6c1b-4811-82e6-2056a4f72391",
                                                "sense_id": "92331e1f-2e27-308a-bf4e-01f0da1606ae",
                                                "text": "Giselle entendit un pas rapide et l'instant d'après, vit le Nubien se dresser dans l'encadrement de la porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef6cd65-c191-38c9-abc2-4fbf4cc7599b",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Action de surveiller et d’animer un groupe dont on a la responsabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f1dffe-e298-460e-9ff6-5afd5ba18e69",
                                                "sense_id": "1ef6cd65-c191-38c9-abc2-4fbf4cc7599b",
                                                "text": "Le candidat retenu participera à l’encadrement de sessions de discussion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04cc3b33-fd18-320c-b9bc-f732663e2e92",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Action de surveiller et d’animer un groupe dont on a la responsabilité.",
                                            "Par extension, action de mettre un cadre pour borner les choses (cadre réglementaire, législatif, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0e60fa-8595-49c8-9616-492ffe39176f",
                                                "sense_id": "04cc3b33-fd18-320c-b9bc-f732663e2e92",
                                                "text": "À l’heure actuelle, les infrastructures et les activités en crypto-actifs génèrent des risques comparables à ceux des services financiers traditionnels, que ce soient pour le risque de crédit, le risque de liquidité et de marché ou le risque cyber, mais sans toujours faire l’objet d’un encadrement similaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73cd65d-cf2b-3438-b8ca-ba99cc86e152",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Ensemble des personnes responsables d’une équipe, d’un groupe (notamment, ensemble des cadres d’une entreprise)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a8d64b-7b42-4fa7-9d29-33b3d33760d0",
                                                "sense_id": "a73cd65d-cf2b-3438-b8ca-ba99cc86e152",
                                                "text": "L’encadrement permanent de centaines de milliers d'hommes, voire de millions (dès 1913, la Social-Démocratie allemande dépassera un million d'adhérents), le recouvrement régulier de cette sorte d'impôt partisan qu'est la cotisation, imposaient une organisation administrative beaucoup plus rigide que celle des partis de cadres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9b9c2a-2417-343e-8ddc-7acfb77d9e91",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Donner deux valeurs approchées d'un nombre réel par défaut et par excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e713c16e-ff17-42e2-acb9-45dc4d0f90b9",
                                                "sense_id": "2c9b9c2a-2417-343e-8ddc-7acfb77d9e91",
                                                "text": "L’encadrement au dixème de 42.627 est 42.6 < 42.627 < 42.7 ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ddc7a7-0507-3652-bd8e-f5b510c97147",
                                        "entry_id": "78b5e0f8-85de-3352-93ae-045ca66b38c4",
                                        "glosses": [
                                            "Motif continu extérieur au cadre, ayant un simple but décoratif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
