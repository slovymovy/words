                        "glosses": [
                            "Einwohnerin der altrömischen Provinz Rätien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00f5120-168b-4925-acb1-4aa8259777a1",
                                "sense_id": "6d26c8c9-c0bb-3ef3-a59f-ec6c9c538917",
                                "text": "Mit ruhigem Blicke prüfte Stemma das grellbeleuchtete knochige Gesicht der gleichaltrigen Räterin."
                            },
                            {
                                "example_id": "3d966062-c557-4a40-a991-29115553b800",
                                "sense_id": "6d26c8c9-c0bb-3ef3-a59f-ec6c9c538917",
                                "text": "Eine Räterin wolte ein Hembde oder Kleid, welches ein rasender Hund etwas zerrissen, wieder flicken, weil aber die Stücke etwas kurz, zog sie dieselben aus Unbedacht mit den Zähnen zusammen."
                            }
                        ],
