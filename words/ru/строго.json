                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она держалась очень <w>строго</w> и почти ни с кем не разговаривала на приёме.",
                            "target_lang_translations": {
                                "en": "She behaved very <w>coldly</w> and spoke to almost no one at the reception.",
                                "de": "Sie verhielt sich sehr <w>kühl</w> und sprach auf dem Empfang mit fast niemandem.",
                                "es": "Ella se comportó de manera muy <w>fría</w> y casi no habló con nadie en la recepción."
                            }
                        },
                        {
                            "text": "Гостья ответила на приветствие <w>строго</w> и сдержанно.",
                            "target_lang_translations": {
                                "en": "The guest replied to the greeting <w>sternly</w> and reservedly.",
                                "de": "Die Gästin erwiderte den Gruß <w>streng</w> und zurückhaltend.",
                                "es": "La invitada respondió al saludo <w>con severidad</w> y reserva."
                            }
