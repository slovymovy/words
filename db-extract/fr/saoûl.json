                                            {
                                                "example_id": "0172e4a0-00f3-4d49-a335-65fee1705d20",
                                                "sense_id": "e81f18a9-cad0-3aa7-9489-bc026fc06229",
                                                "text": "Another drunk is sleeping in dangerous proximity to a brush fire."
