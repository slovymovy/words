                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coupure de mot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c822bfb7-9273-37cf-9b74-a7231f8ee238",
                                        "entry_id": "336a7238-6091-3ca8-82c0-0a513adbd087",
                                        "glosses": [
                                            "Coupure nécessaire d’un mot en fin de ligne se matérialisant par le début du mot restant sur la ligne (suivi d’un trait d’union) et par la fin du mot commençant la ligne suivante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd2ca76-ecfd-45fb-9f10-135da4a21a82",
                                                "sense_id": "c822bfb7-9273-37cf-9b74-a7231f8ee238",
                                                "text": "Ciel, mon mari ! cache-toi vite dans l’ar-\n moire. Dans cette phrase la coupure du mot se situe dans le mot « armoire »."
                                            },
                                            {
                                                "example_id": "73d1d309-6c45-47e7-ab1d-9bfb211a3143",
                                                "sense_id": "c822bfb7-9273-37cf-9b74-a7231f8ee238",
                                                "text": "Word demande confirmation avant chaque coupure de mot."
                                            },
                                            {
                                                "example_id": "67979cac-9926-4706-bd03-dbd29a014593",
                                                "sense_id": "c822bfb7-9273-37cf-9b74-a7231f8ee238",
                                                "text": "Les règles de typographie, comme la proscription d’une coupure de mot à la fin d’une page impaire par exemple, ont tendance à ne plus être observées."
                                            },
                                            {
                                                "example_id": "a037a56e-78ea-4a3e-95aa-f452128cb4bd",
                                                "sense_id": "c822bfb7-9273-37cf-9b74-a7231f8ee238",
                                                "text": "Un trait d’union sert à indiquer une coupure de mot en bout de ligne, à créer des mots composés, comme un trois-quarts, un arc-en-ciel ou un sourd-muet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
