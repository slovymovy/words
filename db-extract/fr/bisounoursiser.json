                "senses": [
                    {
                        "sense_id": "274e7443-4938-3140-8102-2cbbf3de8def",
                        "entry_id": "4a9a7c30-ae8d-3eb1-9ef0-885ab9f1073f",
                        "glosses": [
                            "Donner un caractère rappelant les Bisounours à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b2f7d2-d25c-4549-b0f2-597552ea2f79",
                                "sense_id": "274e7443-4938-3140-8102-2cbbf3de8def",
                                "text": "L’humour, l’inventivité, dont témoignaient les slogans et affiches d’époque, avaient cannibalisé, « bisounoursisé » toutes les effervescences browniennes d’un événement qui charria tout, le meilleur et le pire, ce que charrient toujours les torrentielles bifurcations, fussent-elles régénératrices."
                            },
                            {
                                "example_id": "b0c3e31e-d100-4356-a6e1-591065463980",
                                "sense_id": "274e7443-4938-3140-8102-2cbbf3de8def",
                                "text": "Passe aux aveux au lieu de bisounoursiser la conversation."
                            },
                            {
                                "example_id": "0cc2b2f7-8367-4943-abaa-e49c699385e6",
                                "sense_id": "274e7443-4938-3140-8102-2cbbf3de8def",
                                "text": "Et même si ils les ont bisounoursisés pour mieux plaire au grand public, bah ce ne sont pas que des héros bad boys."
                            }
                        ]
                    }
                ],
