                "senses": [
                    {
                        "sense_id": "4a2b835b-1922-3c3e-a0e3-2d5f8aee2ce3",
                        "entry_id": "b2d6c987-93e3-3736-8c89-b1b2a1e1f1b4",
                        "glosses": [
                            "имеющий короткую шею"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f507d28f-a5f9-4e0d-a6b5-7e1010c213f5",
                                "sense_id": "4a2b835b-1922-3c3e-a0e3-2d5f8aee2ce3",
                                "text": "Он небольшого роста, сутулый, короткошеий, и кажется, что голова его сидит не на плечах, а на спине."
                            },
                            {
                                "example_id": "2391f06b-d28d-408f-869a-61a52843c03f",
                                "sense_id": "4a2b835b-1922-3c3e-a0e3-2d5f8aee2ce3",
                                "text": "Мауро невысокий, плечистый, короткошеий, улыбающийся, с астматическою одышкой."
                            }
                        ]
                    }
                ],
