{
    "word": "toper",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "14049c53-179a-3fba-bb46-1a8d00d83a3d",
                "word": "toper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "97135095-1426-4db1-af1e-853cbcb548d1",
                        "entry_id": "14049c53-179a-3fba-bb46-1a8d00d83a3d",
                        "tags": [
                            "plural"
                        ],
                        "form": "topers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                        "entry_id": "14049c53-179a-3fba-bb46-1a8d00d83a3d",
                        "glosses": [
                            "Someone who drinks alcoholic beverages a lot; a drunkard."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "30645eac-bfc0-4050-b085-e9be274af6f7",
                                "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                                "text": "A Toper this! He plied his glass / More strictly than he said the Mass, […]"
                            },
                            {
                                "example_id": "a2ef150a-e38f-402e-990a-514baa97c006",
                                "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                                "text": "The liquor soon mounted into their heads, as it generally does even with the arrantest topers newly landed from sea, and they began capering about most obstreperously."
                            },
                            {
                                "example_id": "036452d4-8c78-4f88-af09-2e8a6b4bbcc1",
                                "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                                "text": "[…] Mrs. Irons rebelled in her bed, and refused peremptorily to get up again, to furnish the musical topers with rum and lemons, […]"
                            },
                            {
                                "example_id": "fc7b2268-1938-42f2-8f8b-1b8e316aeb7f",
                                "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                                "text": "“Well, if you ask me, Barney is a combination of eight ball, mick, and shonicker,” said McArdle, one of the corner topers."
                            },
                            {
                                "example_id": "b547adcb-6f94-422f-8d22-d56abd7645bb",
                                "sense_id": "d24c560e-15e8-386d-8fcd-8125cb8d4f54",
                                "text": "George Relph plays the part of the Vicar of the Parish, a railway enthusiast, who becomes amateur engine driver, with Sir Godfrey Tearle (the Bishop) as his fireman, while Stanley Holloway is the genial toper who provides the cash to buy the line."
                            }
                        ]
                    }
                ],
