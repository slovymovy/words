                ],
                "senses": [
                    {
                        "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                        "entry_id": "f291687d-8dc6-3a12-8cc3-7de2172f6bc7",
                        "glosses": [
                            "die erste Fahrt eines Verkehrsmittel nach abgeschlossener Konstruktion und Bau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74ded26-ecc8-4a8b-adae-f9c0c82a4535",
                                "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                                "text": "Die Titanic kollidierte auf ihrer Jungfernfahrt mit einem Eisberg."
                            },
                            {
                                "example_id": "30ea6e92-ffef-49bf-b38f-7ae6f3d6e9b4",
                                "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                                "text": "„Die Wilhelm Gustloff soll, als sie ganz in Weiß endlich fertiggestellt auf Jungfernfahrt ging, vom Bug bis zum Heck ein schwimmendes Erlebnis gewesen sein.“"
                            },
                            {
                                "example_id": "91810c05-4fb8-4b6c-b8c1-cce627447244",
                                "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                                "text": "„So übernahm Kapitän John Nutting Parker das Kommando der Jungfernfahrt, während der die AMAZON vor der Küste von Maine in ein Fischwehr geriet.“"
                            },
                            {
                                "example_id": "1e9d4f04-ddae-4e68-a0b2-aaf2f59cd898",
                                "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                                "text": "„Wenn alles nach Plan gegangen wäre, dann hätten sie den Golf jetzt schon verlassen und würden sich Belle Ile nähern, wo sie von Bord gehen wollten, nachdem sie die Diligent auf den ersten Meilen ihrer Jungfernfahrt nach Afrika begleitet hatten.“"
                            },
                            {
                                "example_id": "170aa600-2f16-40a8-939a-fe786b7f9f4c",
                                "sense_id": "a9117bb0-3f55-3f72-9f2b-c32aa6b89845",
                                "text": "„Der damalige Bahnchef Dürr hat mir kürzlich erzählt, wie es zu diesem Toiletten-Desaster bei der Jungfernfahrt gekommen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2065a4e9-6ef2-4a2f-a666-e9cef98a4ce0",
