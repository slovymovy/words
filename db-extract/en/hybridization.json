                "senses": [
                    {
                        "sense_id": "c6915f79-6ac7-3cb9-9052-cb56c2d26a61",
                        "entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
                        "glosses": [
                            "The act of hybridizing, or the state of being hybridized.",
                            "The linear combination of atomic orbitals in a molecule to form hybrid orbitals."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "33d953cc-632b-4c5b-82d5-06dfc810db67",
                                "sense_id": "c6915f79-6ac7-3cb9-9052-cb56c2d26a61",
                                "text": "The electron pairing theory of orbital hybridization has been shown to account, very satisfactorily, for the variations which have been observed in the properties of C-H bonds."
                            }
                        ]
                    },
                    {
                        "sense_id": "a25500ba-5b0f-3b52-9f2b-8b6c4a1b14b5",
                        "entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
                        "glosses": [
                            "The act of hybridizing, or the state of being hybridized.",
                            "The process of breeding a mixed offspring from two different strains or species of animal or plant"
                        ],
                        "tags": [
                            "countable",
                            "including",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfafabb8-13bd-4e04-b2a9-5a5268a9a6c5",
                                "sense_id": "a25500ba-5b0f-3b52-9f2b-8b6c4a1b14b5",
                                "text": "Hybridization, strictly speaking, is the art or act of obtaining an offspring or progeny between two different species of animals or plants; ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca4ce991-f870-3aa4-b3a7-04a12acdc962",
                        "entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
                        "glosses": [
                            "The act of hybridizing, or the state of being hybridized.",
                            "The formation of double-stranded nucleic acid by complementary base-pairing"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7e084f13-d936-3fd8-a48f-cb7128880599",
                        "entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
                        "glosses": [
                            "the conversion of a fleet of vehicles to hybrids."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "04855978-65e2-46c5-b4fd-541634f9acff",
                                "sense_id": "7e084f13-d936-3fd8-a48f-cb7128880599",
                                "text": "He said he has read up on the hybridization of vessels, and described it as “extremely costly,” but conceded it’s “where the industry is heading.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b98d9a94-9c2b-4808-876d-7aea2deabd21",
                        "source_entry_id": "a88b9eb2-dd1f-3465-92c5-e23afcfb20fe",
