                    {
                        "translation_id": "734cb7a0-4942-4d9b-820f-d9d9d41ea0ee",
                        "source_entry_id": "1a402117-3085-3a66-a699-63396e949e9f",
                        "source_sense_id": "f092f710-dbaa-3ad2-a54f-856e5a270a4e",
                        "target_lang_word": "hitlérisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hitlérisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be69846e-94df-3533-8d8b-2c24e8a3e5ba",
                                        "entry_id": "aacda6c1-0940-37cf-8a8b-e53d12fe4940",
                                        "glosses": [
                                            "Totalitarisme pratiqué par Adolf Hitler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5d0fa0-6c16-470f-a850-a84592bbf14f",
                                                "sense_id": "be69846e-94df-3533-8d8b-2c24e8a3e5ba",
                                                "text": "L’attitude de l’occupant vis-à-vis de l’occupé évolue aussi. Elle change même du tout au tout. La poigne de fer de l’hitlérisme, relâchée les premiers mois, se resserre brutalement."
                                            },
                                            {
                                                "example_id": "bf87df1e-63a8-4fc2-8914-153553214e51",
                                                "sense_id": "be69846e-94df-3533-8d8b-2c24e8a3e5ba",
                                                "text": "Après la nuit des Longs Couteaux, l'adoption des lois de Nuremberg et la montée de l'hitlérisme, les interdits et les tourments s'abattent sur la population juive et le baron Hermann von Weinbrenner n'est pas épargné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "202d730e-16f9-4be1-8fbc-99dd4a9e339d",
                        "source_entry_id": "1a402117-3085-3a66-a699-63396e949e9f",
                        "source_sense_id": "f092f710-dbaa-3ad2-a54f-856e5a270a4e",
