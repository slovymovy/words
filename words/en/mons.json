                    "sense_definition": "The plural of <w>mon</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The text lists several different <w>mons</w> used in traditional heraldry.",
