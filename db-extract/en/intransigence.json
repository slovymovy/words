                    },
                    {
                        "translation_id": "6d9c65c3-d2a4-421a-a9be-e6dc19bb3bdc",
                        "source_entry_id": "c503187b-2dd0-31df-a785-d5e058478a8d",
                        "source_sense_id": "2722e512-ee37-37d9-8142-a081d49b6d09",
                        "source_sense_description": "intransigence",
                        "target_lang_word": "Intransigenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intransigenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd863681-9b53-3bca-86dc-f7ac8ce1bbce",
                                        "entry_id": "8c0f8cd3-6850-3cdc-a3af-f25027945610",
                                        "glosses": [
                                            "unbeugsame Haltung der Ablehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0123aede-01d2-49a2-ba78-b7f97595a12c",
                                                "sense_id": "dd863681-9b53-3bca-86dc-f7ac8ce1bbce",
                                                "text": "„Im 19. Jahrhundert wurden die liberalen Nationalstaaten zum Objekt päpstlicher Intransigenz (vgl. Syllabus errorum, 1864).“"
                                            },
                                            {
                                                "example_id": "ec2fd5e3-4839-4a67-92d8-6f02ab4748cf",
                                                "sense_id": "dd863681-9b53-3bca-86dc-f7ac8ce1bbce",
                                                "text": "„Alle Versuche, die Situation zu bessern, scheiterten an der Intransigenz der täglich größer werdenden Versicherungsinstitute, die längst ein Staat im Staate geworden sind — nicht mehr nur zur Hilfe anderer da, sondern mehr noch um ihrer selbst willen.“"
                                            },
                                            {
                                                "example_id": "3d6f4cc9-6854-4cc7-a6d8-0883403a1514",
                                                "sense_id": "dd863681-9b53-3bca-86dc-f7ac8ce1bbce",
                                                "text": "„Die arabische Welt insgesamt zeigt den USA die kalte Schulter, weil es diesen nicht gelingen will, die Intransigenz der Israelis zu überwinden.“"
                                            },
                                            {
                                                "example_id": "c8f8c004-548f-499e-a265-8914379616ed",
                                                "sense_id": "dd863681-9b53-3bca-86dc-f7ac8ce1bbce",
                                                "text": "„Angesichts der Intransigenz und politischen Verhärtung bei den Siedlern lehnten die schwarzen Nationalisten genauso wie diejenigen der beiden übrigen Territorien die Föderation generell ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
