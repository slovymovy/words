                    {
                        "sense_id": "e7940d97-4e9c-38ec-9257-f01504599ce3",
                        "entry_id": "411f52bf-56a4-3130-9b0d-477e6b5c7c9c",
                        "glosses": [
                            "Plante vivace à tubercule, de la famille des aroïdes, souvent nommée aussi arum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd92171-2e4e-4b40-82f9-5c7f3064255b",
                                "sense_id": "e7940d97-4e9c-38ec-9257-f01504599ce3",
                                "text": "Ce fait a été observé dans le gouet d’Italie, par M. Lamarck […]"
                            },
                            {
                                "example_id": "c6dd48c0-8a53-42d2-bd67-ffdbe5d7cee1",
                                "sense_id": "e7940d97-4e9c-38ec-9257-f01504599ce3",
                                "text": "Les Aroïdées habitent généralement les lieux humides, marécageux, et les bois très-ombragés; elles sont presque toutes âcres, même vésicantes. On distingue dans cette famille le Gouet ou Pied-de-veau (Arum L.), le Calla et l’Acorus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "288849cf-aa2e-41f6-b8e6-e7f0c96b62be",
                        "source_entry_id": "411f52bf-56a4-3130-9b0d-477e6b5c7c9c",
                        "source_sense_id": "e7940d97-4e9c-38ec-9257-f01504599ce3",
                        "source_sense_description": "fleur",
                        "target_lang_word": "Aronstab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aronstab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc30c08-1d5e-3c89-b827-f0e65ca0cc23",
                                        "entry_id": "53e95a32-7ac3-371a-99e1-9da61cd990c5",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Arum aus der Familie der Aronstabgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9897133-15f6-46c4-b1a1-95500a40b7c7",
                                                "sense_id": "0dc30c08-1d5e-3c89-b827-f0e65ca0cc23",
                                                "text": "Aronstäbe sind vor allem tropisch verbreitete Pflanzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79243376-7c1b-3be8-873f-619595e3bda9",
                                        "entry_id": "53e95a32-7ac3-371a-99e1-9da61cd990c5",
                                        "glosses": [
                                            "speziell der auch in Deutschland heimische gefleckte Aronstab (Arum maculatum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29bba2b-8db9-4592-8ab3-b28ecee3f382",
                                                "sense_id": "79243376-7c1b-3be8-873f-619595e3bda9",
                                                "text": "die roten Beeren des Aronstabes sind giftig."
                                            },
                                            {
                                                "example_id": "436242e1-3d6e-477c-a3e2-91c67cf172a8",
                                                "sense_id": "79243376-7c1b-3be8-873f-619595e3bda9",
                                                "text": "Der Blütenstand des Aronstabs ist von einem hellgrünen Hochblatt umgeben."
                                            }
