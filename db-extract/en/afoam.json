                                "sense_id": "9530b770-e49e-3405-a4fb-8fd1de001a9b",
                                "text": "“Well, this old great-grandfather [whale], with the white head and hump, runs all afoam into the pod, and goes to snapping furiously at my fast-line.”"
                            },
                            {
                                "example_id": "70cedfea-cd57-4ddb-9d8b-d743530766d1",
                                "sense_id": "9530b770-e49e-3405-a4fb-8fd1de001a9b",
                                "text": "Sunday beer / Afoam in silver rumkins"
                            },
                            {
                                "example_id": "be940eae-fdca-4331-85fb-86887181a0a9",
                                "sense_id": "9530b770-e49e-3405-a4fb-8fd1de001a9b",
                                "text": "a tugboat hauling barges, its bow afoam pushing its way through the ripples and waves"
                            }
                        ]
                    },
