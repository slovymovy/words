                                            "Sinnesphysiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53db4df5-a30d-4471-8054-95191e207c2e",
                                                "sense_id": "d1c58751-eb40-3c04-b0d8-17898bf1aa10",
                                                "text": "Dieses Kind ist ein absolut kinästhetischer Lerntyp. Es bewegt jeden Lernstoff in der Hand, bevor es ihn verinnerlicht."
                                            },
                                            {
                                                "example_id": "5bb3f9a3-cb18-489f-8d19-d2eced50dbbc",
                                                "sense_id": "d1c58751-eb40-3c04-b0d8-17898bf1aa10",
                                                "text": "Kinästhetisch veranlagte Kinder lernen durch Bewegung und Aktivität."
                                            }
