{
    "word_family": [
        "réduction",
        "réducteur",
        "réductible",
        "irréductible",
        "irréductibilité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "144d89fe-5ded-3c23-a119-ae69a1b7c546",
                    "sense_definition": "Diminuer la quantité, la valeur, le volume ou l'importance de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diminution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement tente de <w>réduire</w> les dépenses publiques cette année."
                        },
                        {
                            "text": "Vous devez <w>réduire</w> votre vitesse en entrant dans ce village."
                        }
                    ],
                    "synonyms": [
                        "diminuer",
                        "baisser",
                        "restreindre"
                    ],
                    "antonyms": [
                        "augmenter",
                        "accroître"
                    ],
                    "common_phrases": [
                        "réduire les coûts",
                        "réduire la vitesse",
                        "réduire de moitié"
                    ]
                },
                {
                    "sense_id": "38cf34b9-0e19-3c03-bcae-79215e02ab08",
                    "sense_definition": "Faire épaissir un liquide ou diminuer son volume par ébullition et évaporation en cuisine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laissez <w>réduire</w> le bouillon pendant vingt minutes pour concentrer les arômes."
                        },
                        {
                            "text": "Le cuisinier <w>réduit</w> la sauce à feu doux avant de la servir."
                        }
                    ],
                    "synonyms": [
                        "épaissir",
                        "concentrer"
                    ],
                    "antonyms": [
                        "diluer",
                        "allonger"
                    ],
                    "common_phrases": [
                        "faire réduire une sauce",
                        "laisser réduire à feu doux"
                    ]
                },
                {
                    "sense_id": "9671ab7a-cf1a-3aae-9b90-09d59b9c3f56",
                    "sense_definition": "Décomposer ou transformer une matière en éléments plus petits ou différents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moulin permet de <w>réduire</w> le blé en farine très fine."
                        },
                        {
                            "text": "L'incendie a complètement <w>réduit</w> la vieille grange en cendres."
                        }
                    ],
                    "synonyms": [
                        "broyer",
                        "écraser",
                        "moudre"
                    ],
                    "common_phrases": [
                        "réduire en poussière",
                        "réduire en miettes",
                        "réduire en cendres"
                    ]
                },
                {
                    "sense_id": "d95449c9-6bcf-3515-b12f-eb2c183c4afc",
                    "sense_definition": "Contraindre quelqu'un ou l'amener par nécessité à un état difficile ou pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La perte de son emploi l'a <w>réduit</w> à accepter des petits travaux précaires."
                        },
                        {
                            "text": "Le juge a réussi à <w>réduire</w> l'accusé au silence par ses questions précises."
                        }
                    ],
                    "synonyms": [
                        "contraindre",
                        "obliger",
                        "forcer"
                    ],
                    "common_phrases": [
                        "réduire au silence",
                        "réduire au désespoir",
                        "être réduit à mendier"
                    ]
                },
                {
                    "sense_id": "04cf3b07-32dd-359d-a79b-1d48f554df68",
                    "sense_definition": "Se limiter ou se ramener essentiellement à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leur dispute se <w>réduit</w> en réalité à un simple malentendu financier."
                        },
                        {
                            "text": "Toutes ces explications complexes se <w>réduisent</w> à un problème d'organisation."
                        }
                    ],
                    "synonyms": [
                        "se résumer",
                        "se borner",
                        "se limiter"
                    ],
                    "common_phrases": [
                        "se réduire à rien",
                        "se réduire à peu de chose"
                    ]
                },
                {
                    "sense_id": "7a5d0a15-7f6b-396e-bc70-fd72e97fa589",
                    "sense_definition": "Soumettre par les armes ou par la force un groupe ou une rébellion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a fini par <w>réduire</w> les insurgés retranchés dans la forteresse."
                        },
                        {
                            "text": "Après des semaines de siège, ils ont réussi à <w>réduire</w> cette place forte."
                        }
                    ],
                    "synonyms": [
                        "soumettre",
                        "dompter",
                        "mater",
                        "subjuguer"
                    ],
                    "common_phrases": [
                        "réduire une rébellion",
                        "réduire les insurgés"
                    ]
                },
                {
                    "sense_id": "59c8d5f2-0ba9-396f-8eb1-924c8329f502",
                    "sense_definition": "Remettre à sa place anatomique normale un os luxé, fracturé ou un organe déplacé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a dû <w>réduire</w> la fracture du fémur avant de poser une plaque."
                        },
                        {
                            "text": "Le médecin urgentiste <w>réduit</w> immédiatement la luxation de l'épaule du sportif."
                        }
                    ],
                    "synonyms": [
                        "remettre",
                        "replacer"
                    ],
                    "common_phrases": [
                        "réduire une fracture",
                        "réduire une hernie",
                        "réduire une luxation"
                    ]
                },
                {
                    "sense_id": "123fd65d-b058-3a05-bf81-51d685810dcc",
                    "sense_definition": "Faire subir à une entité chimique un gain d'électrons ou une désoxydation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réaction d'oxydoréduction <w>réduit</w> les ions cuivre en métal solide."
                        },
                        {
                            "text": "L'hydrogène permet de <w>réduire</w> cet oxyde métallique à haute température."
                        }
                    ],
                    "synonyms": [
                        "désoxyder"
                    ],
                    "antonyms": [
                        "oxyder"
                    ],
                    "common_phrases": [
                        "réduire un oxyde",
                        "réduire un ion"
                    ]
                }
            ]
        }
    ]
}