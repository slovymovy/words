{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "911e6ddd-f2e3-35d7-8a50-a601a0985487",
                    "sense_definition": "A way out; a door, gate, or passage used to go from inside a place to the outside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "way_out_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please locate the nearest <w>exit</w> in case of an emergency.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, найдите ближайший <w>выход</w> на случай чрезвычайной ситуации.",
                                "zh": "紧急情况下，请找到最近的<w>出口</w>。"
                            }
                        },
                        {
                            "text": "He walked towards the <w>exit</w> of the cinema after the movie ended.",
                            "target_lang_translations": {
                                "ru": "Он направился к <w>выходу</w> из кинотеатра после окончания фильма.",
                                "zh": "电影结束后，他走向电影院的<w>出口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "way out",
                        "egress",
                        "door"
                    ],
                    "antonyms": [
                        "entrance",
                        "entry",
                        "ingress"
                    ],
                    "common_phrases": [
                        "emergency exit",
                        "fire exit",
                        "rear exit",
                        "nearest exit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путь наружу; дверь, ворота или проход, используемые для выхода из помещения.",
                        "zh": "通往外面的路径；用于从室内走到室外的门、大门或通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "место выхода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口",
                                "target_lang_sense_clarification": "物理上的出口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a75865f-3765-32f4-8f44-b776cb191ac5",
                    "sense_definition": "A minor road, such as a ramp, used to leave a major highway or expressway.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "way_out_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take the next <w>exit</w> to get to the city center.",
                            "target_lang_translations": {
                                "ru": "Сверните на следующий <w>съезд</w>, чтобы попасть в центр города.",
                                "zh": "从下一个<w>出口</w>驶出即可到达市中心。"
                            }
                        },
                        {
                            "text": "We missed our <w>exit</w> and had to drive five miles to turn around.",
                            "target_lang_translations": {
                                "ru": "Мы пропустили свой <w>съезд</w> и были вынуждены проехать пять миль, чтобы развернуться.",
                                "zh": "我们错过了<w>出口</w>，不得不开了五英里才掉头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "turnoff",
                        "off-ramp"
                    ],
                    "antonyms": [
                        "entrance"
                    ],
                    "common_phrases": [
                        "take the exit",
                        "miss the exit",
                        "highway exit",
                        "next exit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Второстепенная дорога или рампа для съезда с главной автомагистрали.",
                        "zh": "用于离开高速公路或快速路的小路或匝道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съезд",
                                "target_lang_sense_clarification": "с дороги"
                            },
                            {
                                "target_lang_word": "выезд",
                                "target_lang_sense_clarification": "место выезда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口",
                                "target_lang_sense_clarification": "高速公路出口"
                            },
                            {
                                "target_lang_word": "匝道",
                                "target_lang_sense_clarification": "高速公路连接路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd1a097d-d6f6-300c-9550-ccea7ecd6b71",
                    "sense_definition": "The act of going out or leaving a place or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_leaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor made a dramatic <w>exit</w> from the stage.",
                            "target_lang_translations": {
                                "ru": "Актёр совершил драматичный <w>уход</w> со сцены.",
                                "zh": "演员戏剧性地<w>退场</w>了。"
                            }
                        },
                        {
                            "text": "She made a quick <w>exit</w> to avoid the awkward conversation.",
                            "target_lang_translations": {
                                "ru": "Она поспешила на <w>выход</w>, чтобы избежать неловкого разговора.",
                                "zh": "为了避免尴尬的谈话，她迅速<w>离开</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "departure",
                        "leaving",
                        "withdrawal"
                    ],
                    "antonyms": [
                        "entrance",
                        "entry"
                    ],
                    "common_phrases": [
                        "make an exit",
                        "hasty exit",
                        "quick exit",
                        "dramatic exit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по уходу или покиданию места или ситуации.",
                        "zh": "离开某地或某种情况的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "покидание места"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "行为"
                            },
                            {
                                "target_lang_word": "退场",
                                "target_lang_sense_clarification": "离开现场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba10fd83-f23f-3d7c-a8ec-886ba52c7264",
                    "sense_definition": "The act of dying or departing from life.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_leaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero made a noble <w>exit</w> at the end of the story.",
                            "target_lang_translations": {
                                "ru": "Герой совершил благородный <w>уход</w> в конце истории.",
                                "zh": "故事结尾，英雄以高尚的方式<w>离世</w>。"
                            }
                        },
                        {
                            "text": "Reflecting on the <w>exits</w> of great historical figures can be inspiring.",
                            "target_lang_translations": {
                                "ru": "Размышления об <w>уходе</w> великих исторических личностей могут вдохновлять.",
                                "zh": "回顾历史伟人的<w>离世</w>可能会给人以启发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "death",
                        "demise",
                        "passing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смерть или уход из жизни (часто используется как эвфемизм).",
                        "zh": "死亡或离开人世（常作为委婉语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "из жизни"
                            },
                            {
                                "target_lang_word": "кончина",
                                "target_lang_sense_clarification": "смерть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离世",
                                "target_lang_sense_clarification": "委婉语"
                            },
                            {
                                "target_lang_word": "去世",
                                "target_lang_sense_clarification": "死亡"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af20acae-c62c-3ed4-ba01-803f967ed3ba",
                    "sense_definition": "To go out of or leave a place or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_leave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>exit</w> the building through the rear doors.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выходите</w> из здания через задние двери.",
                                "zh": "请从后门<w>离开</w>大楼。"
                            }
                        },
                        {
                            "text": "The passengers <w>exited</w> the train at the final station.",
                            "target_lang_translations": {
                                "ru": "Пассажиры <w>вышли</w> из поезда на конечной станции.",
                                "zh": "乘客们在终点站<w>下车</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leave",
                        "depart",
                        "go out"
                    ],
                    "antonyms": [
                        "enter"
                    ],
                    "common_phrases": [
                        "exit the building",
                        "exit the room",
                        "exit the vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходить наружу или покидать место или ситуацию.",
                        "zh": "从某地或某种情况中出去或离开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "покидать место"
                            },
                            {
                                "target_lang_word": "выйти",
                                "target_lang_sense_clarification": "сов. вид"
                            },
                            {
                                "target_lang_word": "покидать",
                                "target_lang_sense_clarification": "оставлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "出去",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e256d16-490b-3bdd-b250-6f7c371af883",
                    "sense_definition": "To close or terminate a computer program or application.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_leave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to save your work before you <w>exit</w> the application.",
                            "target_lang_translations": {
                                "ru": "Не забудьте сохранить работу, прежде чем <w>выйти</w> из приложения.",
                                "zh": "在<w>退出</w>应用程序之前，请务必保存你的工作。"
                            }
                        },
                        {
                            "text": "Press the escape key to <w>exit</w> full-screen mode.",
                            "target_lang_translations": {
                                "ru": "Нажмите клавишу Escape, чтобы <w>выйти</w> из полноэкранного режима.",
                                "zh": "按Esc键<w>退出</w>全屏模式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "close",
                        "quit",
                        "terminate",
                        "shut down"
                    ],
                    "common_phrases": [
                        "exit the program",
                        "save and exit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрыть или завершить работу компьютерной программы или приложения.",
                        "zh": "关闭或终止计算机程序或应用程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выйти",
                                "target_lang_sense_clarification": "из программы"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "приложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "退出",
                                "target_lang_sense_clarification": "程序"
                            },
                            {
                                "target_lang_word": "关闭",
                                "target_lang_sense_clarification": "程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7071be95-0159-34b9-ac08-cdbd3a6f06b3",
                    "sense_definition": "To leave the stage or scene in a play or performance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_leave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain <w>exits</w> stage left while laughing maniacally.",
                            "target_lang_translations": {
                                "ru": "Злодей <w>уходит</w> за кулисы налево, маниакально смеясь.",
                                "zh": "反派狂笑着从舞台左侧<w>下场</w>。"
                            }
                        },
                        {
                            "text": "After her monologue, she <w>exits</w> to the dressing room.",
                            "target_lang_translations": {
                                "ru": "После монолога она <w>уходит</w> в гримёрную.",
                                "zh": "独白结束后，她<w>退场</w>前往化妆间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "go off"
                    ],
                    "antonyms": [
                        "enter"
                    ],
                    "common_phrases": [
                        "exit stage left",
                        "exit stage right"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уйти со сцены во время спектакля или представления.",
                        "zh": "在戏剧或表演中离开舞台或场景。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "со сцены"
                            },
                            {
                                "target_lang_word": "удаляться",
                                "target_lang_sense_clarification": "уходить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下场",
                                "target_lang_sense_clarification": "舞台术语"
                            },
                            {
                                "target_lang_word": "退场",
                                "target_lang_sense_clarification": "离开舞台"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}