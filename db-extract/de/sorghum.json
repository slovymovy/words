                "senses": [
                    {
                        "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                        "entry_id": "d468ed8b-80dd-3240-9041-d43c26bacdc0",
                        "glosses": [
                            "Wissenschaftlicher Name der Gattung „Mohrenhirse“ aus der Familie der Süßgräser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12114676-04f6-4c06-a9d4-3fe4263c0682",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "Sorghum ist das Grundnahrungsmittel vieler afrikanischer Stämme."
                            },
                            {
                                "example_id": "ca07f5d0-68b8-4fff-aff4-e0caaea8f13b",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "Ursprünglich war das anspruchslose Sorghum in Afrika beheimatet, aber heute wird es weltweit angebaut und ist die fünftwichtigste Nahrungsgetreideart der Welt."
                            },
                            {
                                "example_id": "8979c178-0244-4b3c-965e-b2bae499c0bb",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "Gleichzeitig führt ein Subventionswettlauf dazu, daß der Sudan die Getreidesorte Sorghum in die EG exportiert."
                            },
                            {
                                "example_id": "606db9f7-e374-4791-8ed6-ac2de2f27732",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "In Somalia ist der Preis für Sorghum, eine Getreideart, unerschwinglich geworden (Anstieg gar um 240 Prozent)."
                            },
                            {
                                "example_id": "7765abcb-480a-4164-ac8a-c31321bb1143",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "Den Ärmeren ließen wir Reis und Hirse und Sorghum."
                            },
                            {
                                "example_id": "89345b30-ec8f-4538-81ae-933a778cecfc",
                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                "text": "Das Genom der afrikanischen Hirse Sorghum bicolor ist entschlüsselt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eda8c14-f16b-49b1-b44a-a78d083dc26f",
                        "source_entry_id": "d468ed8b-80dd-3240-9041-d43c26bacdc0",
                        "source_sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                        "source_sense_description": "Botanik: Wissenschaftlicher Name der Gattung „Mohrenhirse“ aus der Familie der Süßgräser",
                        "target_lang_word": "sorghum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorghum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e40d7676-0830-36d1-98c5-e4f737c0195e",
                                        "entry_id": "521b75cf-569b-3f5c-9014-1df01dec5627",
                                        "glosses": [
                                            "A cereal, Sorghum genus and species, the grains of which are cultivated to make flour and feed cattle. Almost all cultivated ones as well as some wild ones belong to the species Sorghum bicolor (syn. Sorghum vulgare)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09cbd560-f5a4-4b04-b55a-55e29d37e8df",
                                                "sense_id": "e40d7676-0830-36d1-98c5-e4f737c0195e",
                                                "text": "1936, Harry Nelson Vinall, Joseph Charlworth Stephens, John Holmes Martin, Identification, History, and Distribution of Common Sorghum Varieties, US Department of Agriculture, Technical Bulletin No. 506, page 2,\nThe sorghum crop has four uses — forage, grain, sirup, and industrial (such as the manufacture of brooms, wallboard, etc.)."
                                            },
                                            {
                                                "example_id": "57fcd781-a27a-4c5c-9b26-f619dc6ba6cd",
                                                "sense_id": "e40d7676-0830-36d1-98c5-e4f737c0195e",
                                                "text": "1978, US Department of Agriculture, Watch out for witchweed, a serious pest of corn, sorghum, and other crops, Animal and Plant Health Inspection Service, Program Number 1212, unnumbered page,\nWitchweed (Striga spp.) is a parasitic plant that attacks corn, sorghum, sugarcane, rice, and more than 60 different species of the grass family."
                                            },
                                            {
                                                "example_id": "9a25d303-5884-46cc-bc6c-36f8c92f33f6",
                                                "sense_id": "e40d7676-0830-36d1-98c5-e4f737c0195e",
                                                "text": "2008, Lamissa Diakité, Amadou Sidibé, Melinda Smale, Mikkel Grum, Seed Value Chains for Sorghum and Millet in Mali: A State-based System in Transition, International Food Policy Research Institute, Discussion Paper 00749, page 2,\nArchaeological evidence suggests that economies based on cattle, goats, sorghum, and pearl millet were established in this region between 5,000 and 3,000 years ago (Smith 1998)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c83d4ec-bf6e-3849-84df-c6e54d728a47",
                                        "entry_id": "521b75cf-569b-3f5c-9014-1df01dec5627",
                                        "glosses": [
                                            "Sorghum syrup."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e430198-6982-4dd8-8b83-55ae167f031b",
                        "source_entry_id": "d468ed8b-80dd-3240-9041-d43c26bacdc0",
                        "source_sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                        "source_sense_description": "Botanik: Wissenschaftlicher Name der Gattung „Mohrenhirse“ aus der Familie der Süßgräser",
                        "target_lang_word": "sorgho",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorgho",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                        "entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
                                        "glosses": [
                                            "Sorghum bicolor, plante herbacée, annuelle, de grande taille, de la famille des Poacées, c’est une céréale originaire des régions chaudes d’Afrique et d’Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd0f027-9a39-44e2-b8dc-42f5ea97cf5b",
                                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                                "text": "SORGHO, (Mat. méd. & diet.) voyez Mil, gros, & l’article Farine & Farineux."
                                            },
                                            {
                                                "example_id": "1714dea0-9c8c-461a-a42a-fbf7bdb6419b",
                                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                                "text": "Le sorgho, planté en succession de la culture commerciale, est desséché sur pied 8 à 10 jours avant de semer le cotonnier […], afin d’obtenir une couverture morte dans laquelle est effectué le semis."
                                            },
                                            {
                                                "example_id": "fbeb41a4-eddf-41f1-843d-d1489ae548cf",
                                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                                "text": "Il arrive que des plants de sorgho contiennent du cyanure, surtout les jeunes pousses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f667917c-0883-3ba3-b53e-5268408d072d",
                                        "entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
                                        "glosses": [
                                            "Graminée du genre Sorghum."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0148fc-5430-459a-943d-6f27dc8c8e4c",
                                                "sense_id": "f667917c-0883-3ba3-b53e-5268408d072d",
                                                "text": "Les botanistes (HARLAN - STEMLER, 1972) situent plutôt les premiers sorghos domestiques (S. bicolor) plus au nord et à l’est, en territoire principalement nilo-saharien, entre Tchad et Éthiopie."
                                            }
                                        ]
                                    }
                                ]
                            }
