                                    {
                                        "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Material applied to a wound for protection or therapy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7f64a5-65e0-4264-bba8-bf1d5ebcf57d",
                                                "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination. The elder woman returned with dressings and a sponge, which she placed on a chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17f01b4-b864-3a18-9812-237e1514a269",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "A sauce, especially a cold one for salads."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95208a35-8b2c-47d3-a7c1-7c5d19d67a64",
                                                "sense_id": "b17f01b4-b864-3a18-9812-237e1514a269",
                                                "text": "I was even more excited to tailor it with a choice of dressings — blue cheese, ranch, French, Russian, Italian, creamy Italian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c65d333-f26b-3c44-8687-029993dcc04a",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Something added to the soil as a fertilizer etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6348edd3-5ae6-3e39-9265-4bdf4e732f6c",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "The activity of getting dressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "127fab7d-27e3-4a93-a1a6-8d5d3072f1e3",
                                                "sense_id": "6348edd3-5ae6-3e39-9265-4bdf4e732f6c",
                                                "text": "Considered thus, the performance is a translation into images of bodies on display, as is well demonstrated by Monsieur Jourdain's repeated dressings and undressings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9808848d-9512-3f00-a3ad-f9efe7975f7e",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Dress; raiment; especially, ornamental habiliment or attire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc01089-0a4b-4e5f-90e9-3c4f06ce103e",
                                                "sense_id": "9808848d-9512-3f00-a3ad-f9efe7975f7e",
                                                "text": "Women ought to repair the losses , time and years have made in their features, with dressings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75335880-1342-3c42-bc1c-993c7970bebd",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "The stuffing of fowls, pigs, etc."
