                ],
                "senses": [
                    {
                        "sense_id": "6d020199-10c8-3053-9c9c-42b36e129f3a",
                        "entry_id": "8090fe84-4861-3fc8-b26a-115ba9f0faf4",
                        "glosses": [
                            "A person who is antagonistic to feminism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a2c86b-46e2-46ec-ab31-ba2371cacdef",
                                "sense_id": "6d020199-10c8-3053-9c9c-42b36e129f3a",
                                "text": "This means, then, that many, if not most, male feminists and male womanists exist, literally, in a \"no-man's land,\" where they receive the cold shoulder from feminists and womanists, and are shamelessly shunned by male antifeminists and antiwomanists and the supersexist men who rule the male supremacist world."
                            }
                        ]
                    },
                    {
                        "sense_id": "215d4990-5b40-34cb-920a-8dff9507a08d",
                        "entry_id": "8090fe84-4861-3fc8-b26a-115ba9f0faf4",
                        "glosses": [
                            "An advocate of antifeminism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4528ada5-7eb5-4667-a95c-23dbbd7030ce",
                        "source_entry_id": "8090fe84-4861-3fc8-b26a-115ba9f0faf4",
                        "source_sense_description": "person antagonistic to feminism",
                        "target_lang_word": "Antifeminist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antifeminist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                                        "entry_id": "cd6c40d9-0818-3edf-906f-aaba54c0befe",
                                        "glosses": [
                                            "Person, die sich gegen das ausspricht, was im jeweiligen Kontext als Feminismus verstanden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad77a65-cd18-443e-8ffc-d6ac6a911e74",
                                                "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                                                "text": "„Möchte der Antifeminist doch bei der Stange der Wahrheit bleiben, und sich hübsch der Gänsefüßchen bedienen, wenn er blödsinnige Lehren des Reformweibes geißelt.“"
                                            },
                                            {
                                                "example_id": "4672479a-37aa-44c3-9ba3-8720dea5cb71",
                                                "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                                                "text": "„Damit war klargestellt: Wer behauptet, der Feminismus habe sich überlebt, weil die wesentlichen Ziele erreicht sind, ist ein Antifeminist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2369298-3657-42dc-bd7a-faf119ce6ff8",
