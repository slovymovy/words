                "senses": [
                    {
                        "sense_id": "d31b488b-f616-3e05-a56a-d3b5d9be25e9",
                        "entry_id": "c3f1c92f-afe4-3238-a069-c277507bcbfa",
                        "glosses": [
                            "Pflaster, das aus Steinen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3871b2ee-58a3-4390-8faf-6bff42cb5394",
                                "sense_id": "d31b488b-f616-3e05-a56a-d3b5d9be25e9",
                                "text": "„Dort grub 1913 der Ortspfarrer Rudolf Herold ein Grabhügelfeld aus, und vor einem der größten Grabhügel aus der Zeit von 800 bis 500 vor Christus entdeckte er ein rechteckiges, mit hochkant gestellten Steinplatten umzäuntes Steinpflaster mit fünf Menhiren oder Stelen.“"
                            },
                            {
                                "example_id": "748b821b-0c95-4223-8bfa-3d1310b92c67",
                                "sense_id": "d31b488b-f616-3e05-a56a-d3b5d9be25e9",
                                "text": "„Auf Teerstraßen pfiffen sie, auf Steinpflaster donnerten sie dumpf.“"
                            },
                            {
                                "example_id": "720736a4-5504-4d0c-af0e-e80460073e0c",
                                "sense_id": "d31b488b-f616-3e05-a56a-d3b5d9be25e9",
                                "text": "„Sie setzte sich auf das Steinpflaster nieder vor den Fenstern des Bischofs, saß so mit ihren von Gicht gekrümmten Beinen, und der Kopf sank auf die Brust herab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
