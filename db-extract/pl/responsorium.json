                                "sense_id": "c6c49dc5-b574-3622-a94b-491bc3800ffd",
                                "text": "W naszej parafii w każdy wtorek śpiewane jest responsorium do św. Antoniego z Padwy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
