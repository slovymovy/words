                {
                    "sense_id": "515a150b-2b8e-32e1-9f04-63ae18ec4f9c",
                    "sense_definition": "ein leeres oder teilweise geleertes Behältnis wieder vollständig voll machen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fuellen_behaelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Kellner <w>füllt</w> mein leeres Glas sofort wieder mit Mineralwasser <w>auf</w>."
                        },
                        {
                            "text": "Vor der langen Fahrt in den Urlaub müssen wir unbedingt noch den Tank <w>auffüllen</w>."
                        }
                    ],
                    "synonyms": [
                        "nachfüllen",
                        "vollmachen"
                    ],
                    "common_phrases": [
                        "das Glas auffüllen",
                        "den Tank auffüllen"
                    ]
                },
                {
                    "sense_id": "6527f53d-f1e9-33f4-b9b8-31dee623b0d8",
                    "sense_definition": "einen Vorrat, Bestand oder ein Kontingent durch Hinzufügen wieder auf das nötige Maß bringen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ergaenzen_menge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem kalten Winter müssen die Menschen ihre Vorräte an Brennholz rechtzeitig <w>auffüllen</w>."
                        },
                        {
                            "text": "Die Mitarbeiter im Supermarkt <w>füllten</w> am späten Abend die fast leeren Regale wieder <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "nachfüllen"
                    ],
                    "common_phrases": [
                        "die Vorräte auffüllen",
                        "die Regale auffüllen"
                    ]
                },
                {
                    "sense_id": "14710328-320a-3bcf-8aa4-3e71ccadf9a4",
                    "sense_definition": "Speisen auf einen Teller oder in ein Essgeschirr schöpfen bzw. nachnehmen",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "auftun_speise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Kantine ließ er sich den großen Teller noch ein zweites Mal mit Gemüse <w>auffüllen</w>."
                        },
                        {
                            "text": "Die Großmutter <w>füllte</w> den Kindern ihre Teller mit leckerer Suppe <w>auf</w>."
                        }
                    ],
                    "common_phrases": [
                        "den Teller auffüllen"
                    ]
                },
                {
                    "sense_id": "04c9bee0-bb0d-3ece-adc8-9433fd58211f",
                    "sense_definition": "beim Kochen eine Flüssigkeit zugeben, um ein Gericht zu verdünnen oder Kochflüssigkeit zu ergänzen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zugeben_fluessigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zuerst brät man das Fleisch scharf an und <w>füllt</w> den Topf danach mit Gemüsebrühe <w>auf</w>."
                        },
                        {
                            "text": "Wenn die Sauce beim Kochen zu dick wird, kann man sie mit etwas Wasser <w>auffüllen</w>."
                        }
                    ],
                    "common_phrases": [
                        "mit Wasser auffüllen",
                        "mit Brühe auffüllen"
                    ]
                },
                {
                    "sense_id": "9d6bf284-46cc-34bd-a5b2-e8e1b7fcccaf",
                    "sense_definition": "eine Vertiefung, Grube oder ein Gelände mit Material wie Erde oder Schotter zuschütten und einebnen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zuschütten_vertiefung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Arbeiter <w>füllten</w> die gefährliche Grube an der Baustelle mit frischem Kies <w>auf</w>."
                        },
                        {
                            "text": "Vor dem Bau des neuen Hauses musste die unebene Senke im Garten mühsam <w>aufgefüllt</w> werden."
                        }
                    ],
                    "common_phrases": [
                        "das Loch auffüllen",
                        "die Grube auffüllen"
                    ]
                },
                {
                    "sense_id": "b00c2b00-5832-3d4a-8a03-25ebfff85ba6",
                    "sense_definition": "sich auflösen oder an Intensität verlieren, bezogen auf ein meteorologisches Tiefdruckgebiet",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meteorologie_abschwaechung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laut dem Bericht der Meteorologen wird sich das stürmische Tief über dem Meer allmählich <w>auffüllen</w>."
                        },
                        {
                            "text": "Wenn der Luftdruck im Zentrum wieder ansteigt, <w>füllt</w> sich das Tiefdruckgebiet rasch <w>auf</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich auffüllen"
                    ]
                }
            ]
