                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fc32f39-f4ac-3efd-811a-94ba8ed6cca9",
                        "entry_id": "963de94a-b56f-370b-9105-34a553c389e2",
                        "glosses": [
                            "to tinkle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005e8146-58fb-46af-b3da-24b9064f1936",
                                "sense_id": "8fc32f39-f4ac-3efd-811a-94ba8ed6cca9",
                                "text": "В двух-трёх места́х они́ толпи́лись на тротуа́ре гру́ппами, преиму́щественно у схо́дов в ни́жний эта́ж, куда́, по двум ступе́нькам, мо́жно бы́ло спуска́ться в ра́зные весьма́ увесели́тельные заведе́ния. В одно́м из них, в э́ту мину́ту, шёл стук и гам на всю у́лицу, тре́нькала гита́ра, пе́ли пе́сни, и бы́ло о́чень ве́село.",
                                "translation": "Here and there they gathered in groups, on the pavement, especially about the entrances to various festive establishments in the lower storeys. From one of these a loud din, sounds of singing, the tinkling of a guitar and shouts of merriment, floated into the street.",
                                "english": "Here and there they gathered in groups, on the pavement, especially about the entrances to various festive establishments in the lower storeys. From one of these a loud din, sounds of singing, the tinkling of a guitar and shouts of merriment, floated into the street."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
