    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                "word": "overshoot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7de32e3d-981d-4146-ab0e-e5ad4d8884f9",
                        "entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                        "tags": [
                            "plural"
                        ],
                        "form": "overshoots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6658363c-3d1a-3820-9b52-d176223ec611",
                        "entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                        "glosses": [
                            "The amount by which something goes too far."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ace663e3-c9e6-4430-9953-c2756c87f778",
                                "sense_id": "6658363c-3d1a-3820-9b52-d176223ec611",
                                "text": "Let's see if we can predict and correct for the overshoot."
                            }
                        ]
                    },
                    {
                        "sense_id": "230453c4-390c-31d5-9946-19574c042a0d",
                        "entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                        "glosses": [
                            "The situation where the population of a species exceeds its environment's carrying capacity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "07733098-06df-45c4-ad0e-b49997a248bb",
                                "sense_id": "230453c4-390c-31d5-9946-19574c042a0d",
                                "text": "With appropriate choice and action such uncontrolled decline could be avoided; overshoot could instead be resolved by a conscious effort to reduce humanity's demand on the planet."
                            },
                            {
                                "example_id": "0d25ffff-75ff-4505-9c3e-4dc3edc951e1",
                                "sense_id": "230453c4-390c-31d5-9946-19574c042a0d",
                                "text": "Population overshoot is therefore unlikely to yield to management. Rather, the usual suspects will enter the scene and do their thing: starvation, disease, […] violence […] [and] death […]."
                            },
                            {
                                "example_id": "38231a9b-6768-4e86-af3b-605f4df8551f",
                                "sense_id": "230453c4-390c-31d5-9946-19574c042a0d",
                                "text": "Our core ecological problem is not climate change. It is overshoot, of which global warming is a symptom."
                            }
                        ]
                    },
                    {
                        "sense_id": "107782c1-e7db-366f-a560-9f67ac6ede06",
                        "entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                        "glosses": [
                            "The portion of a letter extending above the capline of other letters of the same font, or the relative degree of such extent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f3eeb97-ed8d-4341-ba4e-336452731ba7",
                                "sense_id": "107782c1-e7db-366f-a560-9f67ac6ede06",
                                "text": "The portion resting beyond the capline or baseline is called overshoot."
                            },
                            {
                                "example_id": "2b90c87b-3219-4084-a676-2919fb90be99",
                                "sense_id": "107782c1-e7db-366f-a560-9f67ac6ede06",
                                "text": "The bowl of the D and the O are usually not identical, as most D forms do not have overshoot or undershoot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fce8ec5-68eb-4624-8dff-7c2b5b2f4938",
                        "source_entry_id": "df6d9432-ec54-3dae-9d24-8f464e256d18",
                        "source_sense_description": "when the population of a species exceeds its environment's carrying capacity",
