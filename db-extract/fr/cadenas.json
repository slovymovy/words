                                ]
                            },
                            {
                                "target_word": "замо́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "устройство для запирания чего-либо ключом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666dc501-2811-4d91-b780-2e7003d2e45e",
                                                "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                                "text": "Дверной замок."
                                            },
                                            {
                                                "example_id": "919be68b-d74c-4da5-bae0-f07fd035f6b8",
                                                "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                                "text": "Запереть дверь на замок."
                                            },
                                            {
                                                "example_id": "266a441a-f66e-44be-9a01-178176afa077",
                                                "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                                "text": "Ключ в замке."
                                            },
                                            {
                                                "example_id": "9505e567-78d8-42a6-8a6d-9f440c85d755",
                                                "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                                "text": "Каморка запиралась на замо́к, напоминавший своим видом калач, только чёрный; ключ от этого замка́ Герасим всегда носил с собой на пояске."
                                            },
                                            {
                                                "example_id": "51a5b220-5325-40ac-9f4f-dd360de3fe4e",
                                                "sense_id": "e50bd8d4-f82c-306f-988e-3e0d953b032c",
                                                "text": "Ключ заскрипел в заржавленном замке, и дверь отворилась; им в лицо пахнуло сыростью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8cfeb9-efd4-32ec-8cef-c1ba9e2bb00c",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "приспособление для смыкания концов ожерелья, браслета, цепочки, серёг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097cf60e-d1ac-4446-a261-e3b6374a763a",
                                                "sense_id": "ad8cfeb9-efd4-32ec-8cef-c1ba9e2bb00c",
                                                "text": "У браслетки замок испортился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b2d1d7-e614-38e5-86da-e51c55d573f2",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "плотн. способ соединения деревянных частей между собой (бревен, брусьев)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4cb05f2-d7e9-4342-8cb2-a0cd99ed7349",
                                                "sense_id": "03b2d1d7-e614-38e5-86da-e51c55d573f2",
                                                "text": "Замок угловой внакладку."
                                            },
                                            {
                                                "example_id": "c5b1a1c8-3eee-4d1d-aa39-4a61492e51ca",
                                                "sense_id": "03b2d1d7-e614-38e5-86da-e51c55d573f2",
                                                "text": "Замок шпунтовый."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f91939ac-472f-3929-ac4b-24d3ae78b048",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "спец. часть ружья, винтовки, где воспламеняется заряд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d7edd2-8e22-4408-a9a2-55e879c40fe5",
                                                "sense_id": "f91939ac-472f-3929-ac4b-24d3ae78b048",
                                                "text": "Стали к нему из дальних деревень приезжать: кто замок на ружье или пистолет починить принесёт, кто часы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bef4034-e717-38f6-9173-9982ac3e13d4",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "архит. центральный камень клинообразной или пирамидальной формы в вершине арки или свода, часто имеет орнаментальную или скульптурную обработку; то же, что замковый камень"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb17892d-31ca-3026-a8e7-0213fd94ffd9",
                                        "entry_id": "1579e1be-3170-3da7-936c-ddeaf1cfa48a",
                                        "glosses": [
                                            "то же, что уключина, приспособление для фиксации вёсел на лодке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44d74b04-4b9c-4a0b-83ca-42fcdec8508f",
                                                "sense_id": "eb17892d-31ca-3026-a8e7-0213fd94ffd9",
                                                "text": "Садится он, Акундин, на судёнышко оснащённое, кладёт вёсельца кленовые во замки дубовые, а сам садится на корму."
                                            }
                                        ]
                                    }
                                ]
                            },
