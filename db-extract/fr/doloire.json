        "fr-extract.jsonl": [
            {
                "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                "word": "doloire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "afe6aa4f-54d3-4862-a424-80f42775d906",
                        "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                        "tags": [
                            "plural"
                        ],
                        "form": "doloires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11ea49d8-4619-3647-a9aa-05ccd72fc0a4",
                        "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                        "glosses": [
                            "Outil de tonnelier à lame très large, qui sert à doler le bois."
                        ],
                        "tags": [
                            "Tonnellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "4324b0f4-be09-45ff-a25f-f545041aef28",
                                "sense_id": "11ea49d8-4619-3647-a9aa-05ccd72fc0a4",
                                "text": "D’autres répliquaient que monsieur et madame des Grassins étaient nobles, puissamment riches, qu’Adolphe était un bien gentil cavalier, et qu’à moins d’avoir un neveu du pape dans sa manche, une alliance si convenable devait satisfaire des gens de rien, un homme que tout Saumur avait vu la doloire en main."
                            },
                            {
                                "example_id": "a3d9f7ee-c2b5-443e-986b-41a4a83e31de",
                                "sense_id": "11ea49d8-4619-3647-a9aa-05ccd72fc0a4",
                                "text": "Ce n’est pas le tout de chaudronner : il faut vendre ! affirme monsieur Valat sûr de son fait, de son geste, de sa doloire dont, fermant un œil, il vérifie le tranchant avant d’en accourcir le cercle d’un tonneau."
                            },
                            {
                                "example_id": "f1e62aef-e7e2-4bd8-890b-733098b4cdf4",
                                "sense_id": "11ea49d8-4619-3647-a9aa-05ccd72fc0a4",
                                "text": "Feuilles en doloire, feuilles dolabriformes, cylindriques à leur base, planes et élargies en dessus, épaisses d’un côté et tranchantes de l'autre."
                            },
                            {
                                "example_id": "226cb0bd-d7dc-4963-9367-ee2e74655f0c",
                                "sense_id": "11ea49d8-4619-3647-a9aa-05ccd72fc0a4",
                                "text": "Bandage en doloire, celui dont les circonvolutions vont en biaisant, de sorte que chaque tour couvre les deux tiers du précédent."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fd60f3e-9fa8-364c-b5c9-61559f03be1e",
                        "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                        "glosses": [
                            "Sorte de hache, appelée aussi épaule de mouton, utilisée par les charpentiers pour amincir ou équarrir les pièces de bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca48a4d-70f8-4491-a291-3e7aa6da9e97",
                                "sense_id": "9fd60f3e-9fa8-364c-b5c9-61559f03be1e",
                                "text": "Ou bien, et c’était encore plus beau, il sortait des haches, des cognées, des serpes ou des herminettes, des planes, des doloires dont le stock s’amoncelait dans le noir."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a2c0779-9da3-3516-95a6-a5cfcb784634",
                        "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                        "glosses": [
                            "Instrument dont se servent les maçons pour corroyer le sable et la chaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10f13da9-efcb-3d3d-b0da-9c9c2d397fe9",
                        "entry_id": "99d320d1-140f-3340-ab6c-1576811a2d18",
                        "glosses": [
                            "Synonyme de phalène linéolée."
