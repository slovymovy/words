                        "translation_id": "f997d9ba-7404-462e-8bc4-d8de78d3e5a9",
                        "source_entry_id": "f76c7f94-135e-3e07-8ec9-6227fb4fb7a1",
                        "source_sense_id": "8c4107a0-655a-3576-b038-732507f766e7",
                        "target_lang_word": "Memel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Memel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25827190-0f36-3577-9f75-8219dcb69272",
                                        "entry_id": "01d0ed52-d406-3060-badd-cc75efc9fc8e",
                                        "glosses": [
                                            "osteuropäischer Fluss, der in Weißrussland entspringt, Litauen und Russland durchfließt und bei Klaipėda in das Kurische Haff (die Ostsee) mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b69326-d362-4153-95a2-9c4d7a8ef883",
                                                "sense_id": "25827190-0f36-3577-9f75-8219dcb69272",
                                                "text": "„Die Memel entspringt in Weißrussland auf dem Weißrussischen Höhenrücken etwas südwestlich von Minsk.“"
                                            },
                                            {
                                                "example_id": "c2eff563-375e-4798-8284-53302df861e4",
                                                "sense_id": "25827190-0f36-3577-9f75-8219dcb69272",
                                                "text": "Wir überquerten die Memel."
                                            },
                                            {
                                                "example_id": "9829b05a-437a-4537-9481-b16ca4ac76f0",
                                                "sense_id": "25827190-0f36-3577-9f75-8219dcb69272",
                                                "text": "Die Kinder versuchten, in der Memel zu baden."
                                            },
                                            {
                                                "example_id": "e18727e1-3ee8-411a-ad37-bc1438f6db7b",
                                                "sense_id": "25827190-0f36-3577-9f75-8219dcb69272",
                                                "text": "„Martin war traurig, weil Napoleon nicht zurück an die Memel kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Memel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77b2db34-a91f-3caa-b47c-995f0fb45583",
                                        "entry_id": "5d50a504-dce1-3927-a010-fc075847f533",
                                        "glosses": [
                                            "Hafenstadt in Litauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c775c9e0-75a7-404e-9481-c28605cc20ea",
                                                "sense_id": "77b2db34-a91f-3caa-b47c-995f0fb45583",
                                                "text": "„Memel erstarkte wirtschaftlich, bis es im Schwedisch-Polnischen Krieg von 1629 bis 1635 unter schwedische Verwaltung geriet.“"
                                            },
                                            {
                                                "example_id": "fbf5f6dc-1cae-4b4a-8d58-32577173cd99",
                                                "sense_id": "77b2db34-a91f-3caa-b47c-995f0fb45583",
                                                "text": "„Da ich genügend Geld hatte, um in Mitau wie ein Herr einzufahren, mietete ich einen viersitzigen Wagen mit sechs Pferden und gelangte mit Lambert, der während der ganzen Fahrt nur schlief, in drei Tagen nach Memel.“"
                                            },
                                            {
                                                "example_id": "0ea2e5e3-4464-4fea-aafb-d1b648579c57",
                                                "sense_id": "77b2db34-a91f-3caa-b47c-995f0fb45583",
                                                "text": "„Kants Vater, der zu Beginn des 18. Jahrhunderts in Memel gelebt hatte, war ein Handwerker, der seine Familie und sich angemessen ernährte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
