                ],
                "senses": [
                    {
                        "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                        "entry_id": "4330990a-7144-3a4b-a7af-0b012ff5c481",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802ba8b9-f020-47b7-bbe9-0d8cb356add7",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Frau Füchsle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7cadeb76-7a50-41f5-b33d-fe26fe1bb7af",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Herr Füchsle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e3c9909-6aa8-4932-a200-8dbcde43c537",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Die Füchsles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b7d1a7e3-7109-4008-ac6c-136d892ca298",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Der Füchsle trägt nie die Pullover, die die Füchsle ihm strickt."
                            },
                            {
                                "example_id": "3a2fbd6d-7839-4121-97df-d41565d9d46c",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Füchsle kommt, geht der Herr Füchsle.“"
                            },
                            {
                                "example_id": "f2acd0ea-4b26-4c3b-bb4a-0896ed4b530b",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Füchsle kommt und geht."
                            },
                            {
                                "example_id": "6ccb419d-b617-4b9b-922d-7fa74105f541",
                                "sense_id": "b84ade57-b3ee-39b4-a80c-13e02ead5ec8",
                                "text": "Füchsles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
