                "senses": [
                    {
                        "sense_id": "e08d3ef0-ab78-32fe-be48-fb65c6f3df81",
                        "entry_id": "c40b1078-8dc3-3c33-8afd-1505c856e08e",
                        "glosses": [
                            "Donner un caractère amerloque (américain) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af4db4f8-9e98-4c1a-b903-a5d03d8d0405",
                                "sense_id": "e08d3ef0-ab78-32fe-be48-fb65c6f3df81",
                                "text": "On n'est pas obligé de tout amerloquiser ou de rester figé à l'ombre de Lucky Luke."
                            },
                            {
                                "example_id": "8c87f683-dfb7-479c-8798-be25e1e381c0",
                                "sense_id": "e08d3ef0-ab78-32fe-be48-fb65c6f3df81",
                                "text": "Il s'est amerloquisé."
                            },
                            {
                                "example_id": "b5dc5021-8ef9-4a65-8b52-4c5548db63f5",
                                "sense_id": "e08d3ef0-ab78-32fe-be48-fb65c6f3df81",
                                "text": "En effet, pour lui, le summum serait que les autochtones de ce pays s'amerloquisent et acceptent sans rechigner les conditions sociales les plus détestables, celles qui sont responsables de millions de pauvres dans le pays qui est un des plus riches au monde !"
                            }
                        ]
                    }
