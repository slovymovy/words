                ],
                "senses": [
                    {
                        "sense_id": "c3f21409-d2ce-3f15-9dc7-a9932d2b126d",
                        "entry_id": "9d88ef25-f10d-34c1-95c1-851261eff1fe",
                        "glosses": [
                            "Redonner un caractère sensoriel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ab5145-fb88-495d-9ae4-329a5055cb1d",
                                "sense_id": "c3f21409-d2ce-3f15-9dc7-a9932d2b126d",
                                "text": "Dans les parties resensorialisées la douleur est amortie, recouverte, contrôlée."
                            },
                            {
                                "example_id": "3aa4f599-72cd-4f14-8bfe-b0301bb1fa56",
                                "sense_id": "c3f21409-d2ce-3f15-9dc7-a9932d2b126d",
                                "text": "Penser, c’est créer et resensorialiser un texte qui au départ est, en fait, parfaitement abstrait."
                            },
                            {
                                "example_id": "7a2dcde4-e059-4003-988f-2081fc9a547e",
                                "sense_id": "c3f21409-d2ce-3f15-9dc7-a9932d2b126d",
                                "text": "Par rapport à l'écrit, l'écran électrifie, extériorise et resensorialise le langage."
                            },
                            {
                                "example_id": "6712d175-d923-441f-b70d-d3e76d9a7c43",
                                "sense_id": "c3f21409-d2ce-3f15-9dc7-a9932d2b126d",
                                "text": "Nous avons donc besoin de disposer de l’arbre entier des connaissances, où les liaisons verticales fournissent précisément les articulations nécessaires, et permettent finalement de resensorialiser les concepts."
                            }
                        ]
                    }
