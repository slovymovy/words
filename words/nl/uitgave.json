                                "target_lang_sense_clarification": "затраты, связанные с производством или услугами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db6c068-aa4a-3e9a-a1ed-fd1be07be3dc",
                    "sense_definition": "Een specifiek gepubliceerd werk, zoals een boek, tijdschrift of krant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "publicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de nieuwste <w>uitgave</w> van het roddelblad staan de allerlaatste nieuwtjes over beroemdheden.",
                            "target_lang_translations": {
                                "en": "The latest <w>issue</w> of the gossip magazine contains the very latest news about celebrities.",
                                "ru": "В свежем <w>номере</w> бульварной газеты напечатаны самые последние новости о знаменитостях."
                            }
                        },
                        {
                            "text": "Deze wekelijkse <w>uitgave</w> wordt door duizenden mensen in de stad gelezen.",
                            "target_lang_translations": {
                                "en": "This weekly <w>publication</w> is read by thousands of people in the city.",
                                "ru": "Это еженедельное <w>издание</w> читают тысячи людей в городе."
                            }
                        }
                    ],
                    "synonyms": [
