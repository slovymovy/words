        "de-extract.jsonl": [
            {
                "entry_id": "bae92ced-3eb8-33c0-8a1c-5c37305398ae",
                "word": "manchenorts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                        "entry_id": "bae92ced-3eb8-33c0-8a1c-5c37305398ae",
                        "glosses": [
                            "an manchen Orten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635b27b9-c94c-4a84-856e-2cec747fa9ba",
                                "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                                "text": "„12 000 Menschen tragen die Flamme seit dem 30. Oktober 45 000 Kilometer durchs Land; sie werden vom Strassenrand aus oft euphorisch begleitet, manchenorts steigen grosse Volksfeste.“"
                            },
                            {
                                "example_id": "dcefd374-3fb9-4382-8d2a-913c6040a9f8",
                                "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                                "text": "„‚Die Überschwemmungen sind verheerend, manchenorts stehen fast die gesamten Dörfer unter Wasser‘, sagte ein Polizeisprecher.“"
                            },
                            {
                                "example_id": "4a559fd3-3d4d-485c-b904-8d11e159025c",
                                "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                                "text": "„Und die Politik hat manchenorts entschieden, so auch im Kanton Zürich: Schulschwache, schwierige und sogar behinderte Kinder sollen wenn immer möglich in die normale Schule ihres Wohnquartiers gehen dürfen.“"
                            },
                            {
                                "example_id": "20113e95-9d06-48d7-a38a-6b8d3188ac5b",
                                "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                                "text": "„In den Innerschweizer Stammlanden etwa befürwortet manchenorts ein Drittel der Basis der C-Partei die von SVP und EDU lancierte Initiative.“"
                            },
                            {
                                "example_id": "674e57c1-236e-43ae-bfcd-ed61c0ebddd6",
                                "sense_id": "f4f3ceb4-e0bd-3949-a545-3891d703cf34",
                                "text": "„Terminlich losgelöst von den Festen der Heiligen gehen manchenorts heute noch zwischen dem 11. November und Weihnachten Teufelsgestalten um, die den Namen der verschwundenen Hauptfigur tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
