                        "glosses": [
                            "Capable of being assigned a bijection to the natural numbers. Applied to sets which are not finite, but have a one-to-one mapping to the natural numbers."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
