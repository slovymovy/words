                                "target_senses": [
                                    {
                                        "sense_id": "d080b13c-f787-3ccf-bf08-cec2524947cc",
                                        "entry_id": "144c8af2-6e19-307e-9f3c-b2f95be7804e",
                                        "glosses": [
                                            "Celui, celle qui donne sa démission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a873517c-147c-414c-802a-93be1044e361",
                                                "sense_id": "d080b13c-f787-3ccf-bf08-cec2524947cc",
                                                "text": "Il est nommé à la préfecture de… en remplacement de monsieur un tel, démissionnaire."
                                            },
                                            {
                                                "example_id": "59ce06a5-9e24-4ba5-9207-59c82cfe8c13",
                                                "sense_id": "d080b13c-f787-3ccf-bf08-cec2524947cc",
                                                "text": "Il proteste néanmoins contre les motifs allégués par M. de Cassagnac pour justifier sa démission, déclarant, au besoin, que le démissionnaire a assigné à la déclaration publiée par le Comité un sens et une portée que repoussent les termes mêmes de cette déclaration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "démissionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                        "entry_id": "b7e479a4-9765-3c3d-b0f5-a46fbcb9f868",
                                        "glosses": [
                                            "Qui démissionne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb020bec-cb66-404a-abfd-a1446e596db7",
                                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                                "text": "Un ministre, un préfet démissionnaire."
                                            },
                                            {
                                                "example_id": "95a7e6a1-1345-48e0-bb0d-2b14e9c5ec19",
                                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                                "text": "— Les élèves perturbateurs, c'est à la schlague qu'il faut les remettre au pas. Quant aux parents démissionnaires, on va leur supprimer les allocs !"
                                            },
                                            {
                                                "example_id": "1b518923-ae36-4471-b57c-5d0cb3539c7c",
                                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                                "text": "Le salarié présumé démissionnaire ne bénéficiera pas des allocations chômage et devra exécuter son préavis de démission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a38364a-2ceb-4c1e-b56a-0e491432273d",
                        "source_entry_id": "a0e232ca-38f5-3c5c-b428-95fbd649ec09",
                        "source_sense_id": "bf9f053f-9b34-3cc3-b93d-0bd8cd6d50ae",
                        "target_lang_word": "sortant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
