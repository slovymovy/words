                        "examples": [
                            {
                                "example_id": "675470bb-37cd-42b2-abc2-4ac003e7eb27",
                                "sense_id": "91e4a84c-aea1-368a-a236-68eb3838bcf9",
                                "text": "Een van de weinige vruchten waar je van op aan kunt, is de sinaasappel. Zo'n dikke, zware navelsinaasappel. Heel vervelend om schoon te maken, natuurlijk. Maar wel echt lekker."
                            },
                            {
                                "example_id": "f3199a77-1247-46e3-95fb-ecdad5752642",
                                "sense_id": "91e4a84c-aea1-368a-a236-68eb3838bcf9",
                                "text": "Hij toont de navelsinaasappels die hij wel laat plukken. „20 cent per kilo krijg ik ervoor. Ze zijn niet opgespoten om extra te glimmen, ze zijn netjes met de schaar geknipt, en zonder kunstmest gevoed. Dat is de toekomst.’’"
                            }
                        ]
                    }
