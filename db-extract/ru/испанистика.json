                                                "example_id": "f29840b6-1356-4dc6-bafc-236162615baf",
                                                "sense_id": "cb6b7ea2-695d-3ab5-95f5-f62155359d10",
                                                "text": "„Der 1959 in Salzburg geborene Bernhofer studierte Hispanistik und Theaterwissenschaften und war in Theaterprojekten und als Dramaturg tätig.“"
                                            }
