                "senses": [
                    {
                        "sense_id": "5d23bb65-2a0b-3871-a81f-ab48740ba017",
                        "entry_id": "b24686db-c6b6-310b-80fa-7c8d842b7376",
                        "glosses": [
                            "Geschichte, die in einer fiktiven Gesellschaft spielt, die sich zum Negativen entwickelt hat, (literarische) Endzeit"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "13d104cb-d21e-4269-ac68-b57be87c0578",
                                "sense_id": "5d23bb65-2a0b-3871-a81f-ab48740ba017",
                                "text": "„Der Sozialismus, als Gegenutopie zur offenen Gesellschaft, hatte von Beginn an extremistische Gestalt.“"
                            },
                            {
                                "example_id": "b7856408-24ba-4e62-beb3-b51c7acc8aa7",
                                "sense_id": "5d23bb65-2a0b-3871-a81f-ab48740ba017",
                                "text": "„Wo solche Träume blühen und solche undemokratischen Denkmuster herrschen, ist eine Gegenutopie geradezu zwingend erforderlich.“"
                            },
                            {
                                "example_id": "9e2e3130-1dd5-48f6-a52c-82174fcd3c0c",
                                "sense_id": "5d23bb65-2a0b-3871-a81f-ab48740ba017",
                                "text": "„Die beiden Romane, die diesen Mann zum Helden machen, sind die Gegenutopie zu der Misere des Anton Reiser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
