                        "examples": [
                            {
                                "example_id": "dda78c47-deae-465f-8762-a53a6c0abf4e",
                                "sense_id": "76580cd6-fa6a-3ac0-8c93-5ecee56cb971",
                                "text": "Begin maart is door het Fonds voor Cultuurparticipatie bekend gemaakt dat de Overijsselse subsidieaanvraag in het kader van het programma is toegewezen. Dit betekent dat ook de door de 'De Sleutel', in samenwerking en op initiatief van Cor de Jong van de stichting Culturele Basisvorming en Ben Kijl ingediende pilot is gehonoreerd en nu de eerste stappen gezet kunnen gaan worden."
                            },
                            {
                                "example_id": "2fa2f416-d88e-497d-8d15-b0129e489205",
                                "sense_id": "76580cd6-fa6a-3ac0-8c93-5ecee56cb971",
                                "text": "Aan de gemeentelijke bezuinigingen die in Enschede vooral de ouderen lijken te raken ontkwam Eerenberg natuurlijk niet. De Seniorenraad Enschede bood hem de adviesnota Cultuurparticipatie voor en door senioren aan."
                            },
                            {
                                "example_id": "4edd0e3c-c1b4-4ae0-b029-4125474883b4",
                                "sense_id": "76580cd6-fa6a-3ac0-8c93-5ecee56cb971",
                                "text": "Circa 125 leerlingen hebben twee jaar lang wekelijks instrumentale les gehad op de Mariaschool in Vasse. Het project, dat mede mogelijk is gemaakt door het Oranjefonds en Fonds voor Cultuurparticipatie, heeft als doel om zoveel mogelijk kinderen een instrument te leren bespelen en samen muziek te maken. Dertig kinderen gaven aan dat zij met hun slag- of blaasinstrument mee wilden doen aan het slotconcert."
                            }
                        ]
                    }
