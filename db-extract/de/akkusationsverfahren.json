                        "glosses": [
                            "gerichtliches Verfahren, bei dem ein Privatmann Anklage erhebt und mit seinem Eigentum haftet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa6bc45-b5cd-4ede-bf96-d0ed5a0a5110",
                                "sense_id": "a3ce2217-6e57-3757-88e8-cb91fb352766",
                                "text": "„Das Akkusationsverfahren erfoderte einen Ankläger.“"
                            },
                            {
