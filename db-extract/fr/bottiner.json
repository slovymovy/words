                "senses": [
                    {
                        "sense_id": "6cbca4d4-45bd-3acb-adba-c931b7786e6a",
                        "entry_id": "d45a2708-e718-31cc-8e2d-cd0b3166e5cf",
                        "glosses": [
                            "Demander un prêt d’argent, latter, taper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2059a4ed-baa2-4837-aaf5-3de8a49a51be",
                                "sense_id": "6cbca4d4-45bd-3acb-adba-c931b7786e6a",
                                "text": "« Coup de bottine » s’est contracté dans le verbe « bottiner » : demander un prêt d’argent."
                            },
                            {
                                "example_id": "e97ec815-8fce-4281-bc17-ec46dca45499",
                                "sense_id": "6cbca4d4-45bd-3acb-adba-c931b7786e6a",
                                "text": "Je pensais bottiner mon pote Léo de cinquante sacs, maldonne, il est flingué."
                            },
                            {
                                "example_id": "c7cfe158-5ca7-4acd-bdb5-56f1489ffc3c",
                                "sense_id": "6cbca4d4-45bd-3acb-adba-c931b7786e6a",
                                "text": "J’ai préféré bottiner un Indien, un certain Talimur, dont tout le monde parlait comme le plus riche des usuriers."
                            },
                            {
                                "example_id": "1b7229ec-8104-4906-81ec-90635c5240f6",
                                "sense_id": "6cbca4d4-45bd-3acb-adba-c931b7786e6a",
                                "text": "Il se demande un peu s'ils ne viennent pas le bottiner ces chers petits compagnons de jeux interdits... s'ils ne se sont pas par hasard mis en tronche de le racketter."
                            }
                        ]
                    }
                ],
