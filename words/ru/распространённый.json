                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verbreitet",
                                "target_lang_sense_clarification": "allgemein gebräuchlich oder häufig vorkommend"
                            },
                            {
                                "target_lang_word": "gängig",
                                "target_lang_sense_clarification": "allgemein üblich oder akzeptiert"
