                        "entry_id": "4055618c-3fe1-30e3-860c-67313b75cec2",
                        "glosses": [
                            "Perception, contemplation passive de Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ee6bbd-70a9-42bc-b91e-91d1012eb5a9",
                                "sense_id": "5b0ad85a-ea56-3c93-b09a-7eafb45c9171",
                                "text": "Sous le nom de théopathie, il (Hartley) désigne la contemplation de Dieu, de ses qualités et de ses rapports avec nous, ainsi que les impressions morales, agréables ou désagréables, qui résultent de cette considération."
                            }
                        ]
                    }
                ],
