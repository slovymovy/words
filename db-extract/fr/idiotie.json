                "senses": [
                    {
                        "sense_id": "1a44affa-a5cd-3419-8386-285766e98e45",
                        "entry_id": "0ace5885-342a-3128-83a3-ae8ba35b21cf",
                        "glosses": [
                            "Arriération mentale profonde, congénitale, (oligophrénie) caractérisée entre autre par un QI inférieur à 20."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "note": "Le terme a été remplacé par la notion de handicap mental",
                        "examples": []
                    },
                    {
                        "sense_id": "efaf0044-a6ae-334d-aa61-33ded38bf118",
                        "entry_id": "0ace5885-342a-3128-83a3-ae8ba35b21cf",
                        "glosses": [
                            "Actes ou paroles qui dénotent un esprit borné."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b5dfc831-92a2-43c8-bf48-8abd819e6dc6",
                                "sense_id": "efaf0044-a6ae-334d-aa61-33ded38bf118",
                                "text": "Il ne dit, il ne fait que des idioties."
                            },
                            {
                                "example_id": "a97658e8-1a95-47f2-abc4-b06c193831f9",
                                "sense_id": "efaf0044-a6ae-334d-aa61-33ded38bf118",
                                "text": "C’est d’une idiotie sans borne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c5b8225-41c4-4422-bb5e-fd1026a8acb2",
                        "source_entry_id": "0ace5885-342a-3128-83a3-ae8ba35b21cf",
                        "target_lang_word": "Idiotie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiotie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e17f3b42-ade2-3f68-93a7-fa7377521ba4",
                                        "entry_id": "d5672f5a-8dff-36c9-9b1f-f2c6e346be9f",
                                        "glosses": [
                                            "Stufe der geistigen Behinderung, die durch einen Intelligenzquotienten/IQ von unter 19 gekennzeichnet ist"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac68bd7c-ea51-401c-884e-4c904f0d63c8",
                                                "sense_id": "e17f3b42-ade2-3f68-93a7-fa7377521ba4",
                                                "text": "Deutlich zu früh geborene Kinder sind in höherem Maße als voll ausgetragene von Idiotie, Imbezillität und Epilepsie betroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa05eac9-8245-3075-a408-33fb231a028e",
                                        "entry_id": "d5672f5a-8dff-36c9-9b1f-f2c6e346be9f",
                                        "glosses": [
                                            "sehr dummes Verhalten; eine Idee, die nicht durchdacht wurde und negative Konsequenzen mit sich bringt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e87631-7fca-4736-83ba-4bdd94a416a2",
                                                "sense_id": "aa05eac9-8245-3075-a408-33fb231a028e",
                                                "text": "Kurz vor dem Abi die Schule zu verlassen ist reinste Idiotie."
                                            },
                                            {
                                                "example_id": "e64fa0e0-5007-4f2b-9b18-5041ab269a69",
                                                "sense_id": "aa05eac9-8245-3075-a408-33fb231a028e",
                                                "text": "Was für eine Idiotie! Nun wollen sie die neue Brücke wieder abreißen, weil die viel zu klein ist, nachdem man beschlossen hat, dass da ein Einkaufszentrum hin soll."
                                            },
                                            {
                                                "example_id": "ae3de153-6359-4ff8-8656-b9c96015f21f",
                                                "sense_id": "aa05eac9-8245-3075-a408-33fb231a028e",
                                                "text": "„Idiotie und Mut liegen nah beieinander, hatte Amalia immer gesagt, aber wenn man nie etwas wagt, dann findet man auch nie heraus, welche Eigenschaft einem näherliegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fcf62fb-a1ed-4187-abd8-f76db084741b",
