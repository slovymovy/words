                        "glosses": [
                            "Que l'on peut modérer."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "59bc3528-c65f-411e-8342-304567aef643",
                                "sense_id": "ee361da6-505d-369b-90d6-5b135d09b5b3",
                                "text": "Une vis de rappel micrométrique peut ensuite soulever ou abaisser la lunette par un mouvement doux et modérable , pour faire atteindre plus exactement à son axe optique la hauteur voulue."
                            },
                            {
                                "example_id": "160b1b32-bc64-4ebb-ba88-954bcc8918f9",
                                "sense_id": "ee361da6-505d-369b-90d6-5b135d09b5b3",
                                "text": "En revanche, ces véhicules n'étaient pas compatibles avec le frein modérable dont était équipée la locomotive à vapeur française qui bénéficiait d’ordinaire, grâce à ce dernier, d'un double système de frein continu."
                            },
                            {
                                "example_id": "eca4fcd9-bb05-404a-9a77-a72fe186e57d",
                                "sense_id": "ee361da6-505d-369b-90d6-5b135d09b5b3",
                                "text": "Le frein de circulation est généralement du type hydraulique à commande modérable actionnée depuis le poste de conduite du tracteur."
                            }
                        ]
                    }
