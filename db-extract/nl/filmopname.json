                                    {
                                        "sense_id": "d45d4a6d-a9f0-3b68-ad95-ed4967ea5e85",
                                        "entry_id": "463c65db-c1b1-3c66-8e34-c83da91c3552",
                                        "glosses": [
                                            "The act of launching a ball or similar object toward a goal."
