                        "sense_id": "3baf9c81-3d37-3411-879b-6eb9c8aa17e7",
                        "entry_id": "ae0fd95b-c793-3cb9-92be-c06e606e1b41",
                        "glosses": [
                            "To heal a wound through scarring (by causing a scar or cicatrix to form)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8fd6a55f-ff9b-479a-9483-ca985623e35a",
                                "sense_id": "3baf9c81-3d37-3411-879b-6eb9c8aa17e7",
                                "text": "But hardly had I accused myself of the theft, when my arm was seized and my right hand cut off. When the stump was dipped in boiling oil to cicatrise the wound, I fell down in a faint."
                            }
                        ]
                    },
