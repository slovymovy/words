                "senses": [
                    {
                        "sense_id": "59d6c3e3-adec-300b-822c-191b1c9595be",
                        "entry_id": "a207f693-3c87-3f7f-bdd4-f47ed3b5c948",
                        "glosses": [
                            "Autre appellation du rutabaga, particulièrement lorsque sa chair est blanche et non jaune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "459ffd08-1dc5-49ca-ba47-37c5914a5213",
                                "sense_id": "59d6c3e3-adec-300b-822c-191b1c9595be",
                                "text": "Sa racine, renflée, ressemble à un gros navet court; la chair en est blanche dans le chou-navet proprement dit, jaune dans le rutabaga."
                            },
                            {
                                "example_id": "7386a215-3b58-405c-a652-0333a0c2a749",
                                "sense_id": "59d6c3e3-adec-300b-822c-191b1c9595be",
                                "text": "Cependant cette combinaison a eu lieu dans la nature, il y a plusieurs siècles, pour donner le colza (B. napus) et après sélection par l’homme des colzas fourragers et le chou-navet."
                            },
                            {
                                "example_id": "219b8af0-e7d6-4966-8145-09e83ab4cec8",
                                "sense_id": "59d6c3e3-adec-300b-822c-191b1c9595be",
                                "text": "Plus connu sous le nom de « chou-navet », ou encore « chou de Siam » au Québec, le rutabaga est issu du croisement entre le navet et le chou frisé."
                            }
                        ]
                    }
                ],
