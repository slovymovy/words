                        "target_lang_word": "lemon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cbc2af0-a691-33fb-898f-d22c00c98256",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A yellowish citrus fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56423ef1-d8ff-4f4e-b5b2-f0d22b306f3b",
                                                "sense_id": "7cbc2af0-a691-33fb-898f-d22c00c98256",
                                                "text": "The juice of Lemmons killeth Warts, but better the water of the ſame juice, diſtilled through a glaſs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "850fd656-5e4b-30b5-8e05-b989c8a8bf76",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A semitropical evergreen tree, Citrus limon, that bears such fruits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c186d017-24af-3757-84c4-d5e490655900",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A more or less bright shade of yellow associated with lemon fruits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "Lemon juice."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a599ca0-1764-424f-b92a-443c6b4ea88d",
                                                "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                                "text": "[J]uſt at the laſt ſcald four or five ſpoonfuls of thick new cream, with a few drops of lemon or vinegar, muſhrooms pickled do well, […]"
                                            },
                                            {
                                                "example_id": "60f333c2-566c-4d44-b88d-cd4296f96378",
                                                "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                                "text": "[S]tir into this, after taking from the fire, two ounces of butter cut into little bits, putting in one piece at a time, and squeeze a few drops of lemon in this sauce."
                                            },
                                            {
                                                "example_id": "302e0aed-1f49-4389-873e-606cc7dc0a2e",
                                                "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                                "text": "The fact that he is drinking lemon is, therefore, an image of the bitterness of his life."
                                            },
                                            {
                                                "example_id": "2a7af0a2-33d5-4e46-973a-f2040d28fd16",
                                                "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                                "text": "She should stay in bed for 40 days and should avoid getting close to her husband till the end of 40 days, not taking a shower, not drinking lemon, and not letting anybody enter her room while she has her menses because this will affect her milk."
                                            },
                                            {
                                                "example_id": "efa2b5aa-12d2-47ea-b408-0f52cf200d6d",
                                                "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                                                "text": "Drinking lemon is known to aid with digestion, as it contains limonene, compounds that can assist with weight loss and fighting inflammation!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da61bd6-758d-3843-9c69-ef082ea72007",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A lemon shark (Negaprion brevirostris)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb8f7877-4825-3daf-b6a8-0e05a712544b",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A defective or inadequate item or individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3903126a-8650-4fc9-baf0-cd405540171b",
                                                "sense_id": "cb8f7877-4825-3daf-b6a8-0e05a712544b",
                                                "text": "He didn’t realise until he’d paid for it that the car was a lemon."
                                            },
                                            {
                                                "example_id": "3afa333b-674b-43de-93ca-b323143526be",
                                                "sense_id": "cb8f7877-4825-3daf-b6a8-0e05a712544b",
                                                "text": "“[…]the Navy's supposed to give me a ship that goes, and a captain that fights—— That's what all this muck is for, isn't it?”\n “Look, it's an old story by now. We're stuck with a lemon. Misfortune of war.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a28e26-45fd-32f7-8b48-3635ff0898ef",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "Favor."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51dc5794-d42e-495c-be98-6792e2955560",
                                                "sense_id": "23a28e26-45fd-32f7-8b48-3635ff0898ef",
                                                "text": "A thousand quid for that motor? Do me a lemon! I could get it for half that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e6b976e-8b9e-376b-840c-30d00b566a15",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "A piece of fanfiction involving explicit sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "874eea49-5a19-4c67-9e28-1ecf31d20a37",
                                                "sense_id": "0e6b976e-8b9e-376b-840c-30d00b566a15",
                                                "text": "I'd really like to know what people think of this and whether I should carry on writing lemons or go and hide under a rock somewhere."
                                            },
                                            {
                                                "example_id": "79c4ae05-b480-4c5a-a5a6-a2e2fa8189bf",
                                                "sense_id": "0e6b976e-8b9e-376b-840c-30d00b566a15",
                                                "text": "WARNING: This story is a lemon and must be viewed with great care. If you are either under the age of 18, think graphic sex is discussing^([sic]) or you know what my writing is like you should turn away now."
                                            },
                                            {
                                                "example_id": "1e489c75-83b4-46a2-b9c5-d8de4858bbcc",
                                                "sense_id": "0e6b976e-8b9e-376b-840c-30d00b566a15",
                                                "text": "This won't be a lemon simply because I can't see myself writing anything like that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85f79a3b-e9e2-3d0d-93b4-19766759ae47",
                                        "entry_id": "7d839266-8a32-31ec-9020-706cdc165cdc",
                                        "glosses": [
                                            "The surface of revolution of a circular arc of angle less than 180° rotated about the straight line passing through the arc’s two endpoints."
                                        ],
                                        "tags": [
                                            "countable",
