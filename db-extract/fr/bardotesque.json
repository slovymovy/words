                        "glosses": [
                            "Propre ou relatif à Brigitte Bardot et à ses interprétations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90302bbf-4c7a-42b0-822a-60e254770cb8",
                                "sense_id": "9dc95c15-3cba-3f35-8818-f7d3b583cefc",
                                "text": "Les saynètes que Gainsbourg donne à chanter à son « ingénue libertine » (ainsi la qualifie-t-il) sont un subtil alliage de poésie teintée de jeux de mots, de malice et d’humour, comme « Kawasaki », moins glamour que la bardotesque « Harley Davidson », mais qui n’en reste pas moins une « belle mécanique », ou « Les Capotes anglaises », qui sont la version « plate » des « Petits Ballons », récemment offerts à France Gall."
                            },
                            {
                                "example_id": "657d4239-8de9-4a7f-a239-e02da715f0f5",
                                "sense_id": "9dc95c15-3cba-3f35-8818-f7d3b583cefc",
                                "text": "Et puis... « zut », expression favorite de la langue bardotesque. Le mot de la fin."
                            }
                        ]
                    }
