                                        "tags": [
                                            "van vloeistoffen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221ad665-9488-49bd-ba62-bd59c406d286",
                                                "sense_id": "677a5a0b-75d2-3284-8e38-a8644897b992",
                                                "text": "De soep was veel te dun omdat er teveel water bij was gedaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9717041-754a-335b-be5e-5320ae035e90",
                                        "entry_id": "9f631170-d9ad-37bd-8a3c-ee17acd8fc76",
                                        "glosses": [
                                            "als er veel ruimte zit tussen de verschillende haren"
                                        ],
                                        "tags": [
                                            "van haar op het menselijk lichaam, m.n. hoofdhaar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4bd4d48-4816-4ba4-80a8-4ce08e6ea3af",
                                                "sense_id": "a9717041-754a-335b-be5e-5320ae035e90",
                                                "text": "De man van middelbare leeftijd had reeds dun haar, maar kaal was hij nog niet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "215323c1-c13a-3370-8065-6a804bfa0f38",
                                        "entry_id": "9f631170-d9ad-37bd-8a3c-ee17acd8fc76",
                                        "glosses": [
                                            "weinig steekhoudend of overtuigend, zwak"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ccf7ce-f0ea-448b-87ce-c26543bd0e57",
                                                "sense_id": "215323c1-c13a-3370-8065-6a804bfa0f38",
                                                "text": "Het geleverde bewijs was te dun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a89f175-35fa-35ba-b2b0-e0f088b5e485",
                                        "entry_id": "9f631170-d9ad-37bd-8a3c-ee17acd8fc76",
                                        "glosses": [
                                            "dun gekleed: dunne, luchtige kleding dragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5c065e-3bb9-4760-b7c6-102bbc13697a",
                                                "sense_id": "0a89f175-35fa-35ba-b2b0-e0f088b5e485",
                                                "text": "Ik ben te dun gekleed, met mijn sandalen en mijn korte, katoenen zomerjurk."
