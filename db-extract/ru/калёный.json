                "translations": [
                    {
                        "translation_id": "0e13a9a9-b2d2-433f-8013-4432ddf22bbc",
                        "source_entry_id": "ef328ed8-6988-3702-8895-5c73508c923e",
                        "target_lang_word": "red-hot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "red-hot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                        "entry_id": "650f2033-5f6e-349c-b0c9-df90b0c5133e",
                                        "glosses": [
                                            "Heated to the point that it glows with a visible red color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6bc2d5-c296-4692-b7ca-9aa95c666436",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "The smith's apprentice was still wary of manipulating the red-hot metal."
                                            },
                                            {
                                                "example_id": "04b8735a-0b6e-48b3-b24b-89cc9e099c4d",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "The Iron of it ſelfe, though heate red hot, / Approaching neere theſe eyes, would drinke my teares, / And quench this fierie indignation, / Euen in the matter of mine innocence."
                                            },
                                            {
                                                "example_id": "763d4393-19b2-4e3a-8400-4844a1a2cd4f",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "Heaped up upon the floor, to form a kind of throne, were turkeys, geese, game, poultry, brawn, great joints of meat, sucking-pigs, long wreaths of sausages, mince-pies, plum-puddings, barrels of oysters, red-hot chesnuts, cherry-cheeked apples, juicy oranges, luscious pears, immense twelfth-cakes, and seething bowls of punch, that made the chamber dim with their delicious steam."
                                            },
                                            {
                                                "example_id": "346ffab2-0447-4e4f-924d-5fa834bab241",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "Among this nation of necromancers there was also one who had in his veins the blood of the salamanders; for he made no scruple of sitting down to smoke his chibouc in a red-hot oven until his dinner was thoroughly roasted upon its floor."
                                            },
                                            {
                                                "example_id": "6f751210-6cfd-435e-979f-dcbccfecfe47",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "[A] red-hot poker will burn you if you hold it too long; […]"
                                            },
                                            {
                                                "example_id": "4a6b6db3-4d7f-4abe-a4e7-b9d9def73918",
                                                "sense_id": "57abc55f-6761-35cb-b5ed-1d4fa8475831",
                                                "text": "The cat-heads had burned away, and the two red-hot anchors had gone to the bottom, tearing out after them two hundred fathom of red-hot chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f3ed7b-989c-361c-a60b-b65d4acd48cf",
                                        "entry_id": "650f2033-5f6e-349c-b0c9-df90b0c5133e",
                                        "glosses": [
                                            "Very hot."
                                        ],
                                        "tags": [
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "693f90a0-3f24-4c4d-8ece-0ac24cac9678",
                                                "sense_id": "c8f3ed7b-989c-361c-a60b-b65d4acd48cf",
                                                "text": "That curry was red-hot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e37fcd-30d5-3ef3-92aa-a8b967e7a6d8",
                                        "entry_id": "650f2033-5f6e-349c-b0c9-df90b0c5133e",
                                        "glosses": [
                                            "Emotionally charged, especially with anger or enthusiasm."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd64f5c-6459-4d48-9297-0a16b7ff3dcd",
                                                "sense_id": "68e37fcd-30d5-3ef3-92aa-a8b967e7a6d8",
                                                "text": "He really delivered a red-hot speech today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee34d27-50b3-3716-9cb2-0bc7fd3a6d34",
                                        "entry_id": "650f2033-5f6e-349c-b0c9-df90b0c5133e",
                                        "glosses": [
                                            "Having very strong sex appeal."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64eed53a-ebac-4a59-8bf1-cbd9946d4f86",
                                                "sense_id": "7ee34d27-50b3-3716-9cb2-0bc7fd3a6d34",
                                                "text": "Did you see that red-hot bikini model in today's paper?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15b7a811-6bee-31d3-90cf-eb02c9e68b23",
                                        "entry_id": "650f2033-5f6e-349c-b0c9-df90b0c5133e",
                                        "glosses": [
                                            "Very fresh, exciting, and up-to-date."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de4c7ed-4473-45f0-9776-eeba59dd709f",
                                                "sense_id": "15b7a811-6bee-31d3-90cf-eb02c9e68b23",
                                                "text": "Tune in at ten to catch this red-hot story!"
                                            },
                                            {
                                                "example_id": "b27f338a-5599-4268-8ab0-8c3991a40dea",
                                                "sense_id": "15b7a811-6bee-31d3-90cf-eb02c9e68b23",
                                                "text": "She sits at the intersection of start-up investing and the fast-growing ecosystem of online creators, both of which are red hot."
                                            }
                                        ]
                                    }
                                ]
                            },
