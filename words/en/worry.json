{
    "word_family": [
        "worried",
        "worrying",
        "worrier",
        "worrisome",
        "worryingly",
        "unworried"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cc11cd8-a2ca-3312-a646-7cc991ada4ca",
                    "sense_definition": "To feel anxious or troubled about actual or potential problems",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>worry</w> about the exam because you have studied very hard.",
                            "target_lang_translations": {
                                "ru": "Тебе не стоит <w>беспокоиться</w> об экзамене, потому что ты очень усердно учился."
                            }
                        },
                        {
                            "text": "Many people <w>worry</w> about money when the cost of living increases.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>тревожатся</w> из-за денег, когда стоимость жизни растет."
                            }
                        }
                    ],
                    "synonyms": [
                        "fret",
                        "stress",
                        "fuss"
                    ],
                    "common_phrases": [
                        "worry about money",
                        "worry about future"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать беспокойство или тревогу из-за реальных или потенциальных проблем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "наиболее частое значение"
                            },
                            {
                                "target_lang_word": "волноваться",
                                "target_lang_sense_clarification": "испытывать душевное волнение"
                            },
                            {
                                "target_lang_word": "тревожиться",
                                "target_lang_sense_clarification": "испытывать чувство тревоги"
                            },
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "разговорный вариант, сильно беспокоиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                    "sense_definition": "To cause someone to feel anxious, distressed, or uneasy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>worries</w> me that he hasn't called home in over a week.",
                            "target_lang_translations": {
                                "ru": "Меня <w>беспокоит</w>, что он не звонил домой больше недели."
                            }
                        },
                        {
                            "text": "The dark clouds <w>worry</w> the farmers who are trying to harvest their crops.",
                            "target_lang_translations": {
                                "ru": "Темные тучи <w>тревожат</w> фермеров, которые пытаются собрать урожай."
                            }
                        }
                    ],
                    "synonyms": [
                        "concern",
                        "preoccupy",
                        "vex"
                    ],
                    "common_phrases": [
                        "worry the government",
                        "worry someone deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать беспокойство, тревогу или дискомфорт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "вызывать тревогу у кого-то"
                            },
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "нарушать чей-то покой"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "вызывать сильные эмоции или опасения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                    "sense_definition": "To touch, pull, or fiddle with something repeatedly, often due to nervousness",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_agitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat in the waiting room, <w>worrying</w> his lower lip with his teeth.",
                            "target_lang_translations": {
                                "ru": "Он сидел в приемной, <w>покусывая</w> нижнюю губу от нервозности."
                            }
                        },
                        {
                            "text": "The old man began to <w>worry</w> his prayer beads while he waited for the news.",
                            "target_lang_translations": {
                                "ru": "Старик начал <w>перебирать</w> четки, ожидая новостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worry his lip",
                        "worry the beads"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно трогать, тянуть или вертеть что-либо в руках, часто из-за нервозности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теребить",
                                "target_lang_sense_clarification": "дергать или вертеть в руках"
                            },
                            {
                                "target_lang_word": "тискать",
                                "target_lang_sense_clarification": "сжимать или мять"
                            },
                            {
                                "target_lang_word": "кусать",
                                "target_lang_sense_clarification": "в контексте губ от нервозности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                    "sense_definition": "To seize or shake an animal by the throat with the teeth",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wolves will <w>worry</w> the sheep if the fence is not repaired soon.",
                            "target_lang_translations": {
                                "ru": "Волки будут <w>терзать</w> овец, если забор не починят в ближайшее время."
                            }
                        },
                        {
                            "text": "The terrier managed to <w>worry</w> the rat until it finally stopped moving.",
                            "target_lang_translations": {
                                "ru": "Терьеру удалось <w>трепать</w> крысу до тех пор, пока она наконец не перестала двигаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worry sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хватать или трясти животное за горло зубами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепать",
                                "target_lang_sense_clarification": "хватать зубами и трясти"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "кусать или терзать зубами"
                            },
                            {
                                "target_lang_word": "загрызть",
                                "target_lang_sense_clarification": "убить, кусая за горло"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                    "sense_definition": "A strong feeling of anxiety or unhappiness caused by problems or fear of the unknown",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anxiety_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>worry</w> about his health was starting to make him feel exhausted.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>беспокойство</w> о здоровье начало его изматывать."
                            }
                        },
                        {
                            "text": "She was afflicted by <w>worry</w> throughout the night and could not sleep.",
                            "target_lang_translations": {
                                "ru": "Ее мучила <w>тревога</w> всю ночь, и она не могла уснуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "care"
                    ],
                    "common_phrases": [
                        "constant worry",
                        "cause for worry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство тревоги или несчастья, вызванное проблемами или страхом перед неизвестным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние тревоги"
                            },
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "сильное опасение"
                            },
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "душевное смятение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e33985b-7744-3a68-a60b-b5a3348f0e6c",
                    "sense_definition": "A specific problem or situation that causes a person to feel anxious",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anxiety_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My main <w>worry</w> is that we will not arrive at the airport on time.",
                            "target_lang_translations": {
                                "ru": "Моя главная <w>забота</w> — чтобы мы вовремя приехали в аэропорт."
                            }
                        },
                        {
                            "text": "The rising price of fuel is a major <w>worry</w> for many families this winter.",
                            "target_lang_translations": {
                                "ru": "Рост цен на топливо — серьезный <w>повод для беспокойства</w> для многих семей этой зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "concern"
                    ],
                    "common_phrases": [
                        "main worry",
                        "financial worries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная проблема или ситуация, вызывающая у человека чувство тревоги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "обременительное дело или проблема"
                            },
                            {
                                "target_lang_word": "повод для беспокойства",
                                "target_lang_sense_clarification": "причина тревоги"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "трудная ситуация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3edf384a-2209-3c03-b920-27637e02c59b",
                    "sense_definition": "A person who consistently causes others to feel anxious or troubled",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "troublesome_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That child is a perfect <w>worry</w> to his parents because he never listens.",
                            "target_lang_translations": {
                                "ru": "Этот ребенок — сущее <w>наказание</w> для родителей, потому что он никогда не слушается."
                            }
                        },
                        {
                            "text": "He was such a <w>worry</w> night and day that they didn't know what to do.",
                            "target_lang_translations": {
                                "ru": "Он был такой <w>бедой</w> и днем и ночью, что они не знали, что делать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect worry"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe a person who is a source of anxiety"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который постоянно заставляет других чувствовать тревогу или беспокойство"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горе",
                                "target_lang_sense_clarification": "в переносном смысле о человеке, приносящем беды"
                            },
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "разговорное о трудном человеке"
                            },
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "источник постоянных проблем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}