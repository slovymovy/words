    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a175c75-9dfb-32f8-9b35-7c5ec355fd59",
                    "sense_definition": "having a low, rough, and harsh sound, especially of a person's voice",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voice_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor answered in a <w>gruff</w> voice that was difficult to understand.",
                            "target_lang_translations": {
                                "ru": "Старый моряк ответил <w>хриплым</w> голосом, который было трудно разобрать.",
                                "cs": "Starý námořník odpověděl <w>chraplavým</w> hlasem, kterému bylo těžké rozumět."
                            }
                        },
                        {
                            "text": "He woke up with a <w>gruff</w> whisper after sleeping for nearly twelve hours.",
                            "target_lang_translations": {
                                "ru": "Он проснулся с <w>грубым</w> шепотом, проспав почти двенадцать часов.",
                                "cs": "Probudil se s <w>drsným</w> šepotem poté, co spal téměř dvanáct hodin."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoarse",
                        "husky",
                        "gravelly",
                        "raspy"
                    ],
                    "antonyms": [
                        "mellow",
                        "soft",
                        "clear"
                    ],
                    "common_phrases": [
                        "gruff voice",
                        "gruff whisper"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий низкий, резкий и хриплый звук, особенно о голосе человека",
                        "cs": "mající nízký, drsný a chraplavý zvuk, zejména u lidského hlasu"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хриплый",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о звучании"
                            },
                            {
                                "target_lang_word": "прокуренный",
                                "target_lang_sense_clarification": "о сиплом голосе"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chraplavý",
                                "target_lang_sense_clarification": "o hlasu"
                            },
                            {
                                "target_lang_word": "drsný",
                                "target_lang_sense_clarification": "o zvuku nebo hlasu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16789e0e-f9fa-3fd4-b3f3-6bb6aee3bd12",
                    "sense_definition": "having a rough, unfriendly, or surly manner or appearance",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his <w>gruff</w> exterior, the grandfather was actually a very kind and generous man.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свою <w>неприветливую</w> внешность, дедушка на самом деле был очень добрым и щедрым человеком.",
                                "cs": "Navzdory svému <w>drsnému</w> zevnějšku byl dědeček ve skutečnosti velmi laskavý a štědrý muž."
                            }
                        },
                        {
                            "text": "The manager gave a <w>gruff</w> mannered response when I asked for a day off.",
                            "target_lang_translations": {
                                "ru": "Менеджер ответил в <w>резкой</w> манере, когда я попросил выходной.",
                                "cs": "Manažer odpověděl <w>mrzutým</w> tónem, když jsem požádal o den volna."
                            }
                        }
                    ],
                    "synonyms": [
                        "surly",
                        "brusque",
                        "curt",
                        "grumpy"
                    ],
                    "antonyms": [
                        "affable",
                        "genial",
                        "friendly",
                        "polite"
                    ],
                    "common_phrases": [
                        "gruff exterior",
                        "gruff manner"
                    ],
                    "target_lang_definitions": {
