                                        "glosses": [
                                            "Celui qui s’occupe de géophysique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e9e6cb-0c21-4de8-a946-5ce7c30c2320",
                                                "sense_id": "600a6a28-82cf-3567-a877-ddb6565e8fcb",
                                                "text": "On peut soutenir, en exagérant à peine, que le géophysicien trouve ce qu’on lui suggère de chercher."
                                            }
