                "senses": [
                    {
                        "sense_id": "ca56d06d-54b0-3bc9-807f-03a8ae0c934c",
                        "entry_id": "1e64d6c4-9041-3a7e-a6bf-2a1d0b80b856",
                        "glosses": [
                            "Théoricien du complot, adepte des théories du complot, complotiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ebf249-32b4-4634-8f3c-fa15fc412aea",
                                "sense_id": "ca56d06d-54b0-3bc9-807f-03a8ae0c934c",
                                "text": "Denn sowohl die aufgeklärten Verschwörungstheoretiker wie auch ihre konservativen Gegenspieler kehrten ein älteres, bereits im 17. Jahrhundert in die Welt gesetztes Szenario um.",
                                "translation": "Car tant les théoriciens du complot éclairés que leurs adversaires conservateurs ont exhumé un scénario plus ancien, déjà mis au monde au 17^(ème) siècle."
                            },
                            {
                                "example_id": "6b90ccbd-24a3-4f4a-a5bc-8169ebed5387",
                                "sense_id": "ca56d06d-54b0-3bc9-807f-03a8ae0c934c",
                                "text": "So glauben Verschwörungstheoretiker an ihre Elaborate, was bei den Verbreitern von Fake News oft nicht der Fall ist.",
                                "translation": "Ainsi, les théoriciens du complot croient aux produits de leurs élaborations, ce qui n’est souvent pas le cas des diffuseurs d’infox."
                            }
                        ]
                    }
                ],
