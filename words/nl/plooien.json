{
    "word_family": [
        "plooi",
        "plooibaar",
        "plooiing",
        "opplooien",
        "vouwen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c93bbc50-d2c7-3255-9b96-ffc716a1e5b4",
                    "sense_definition": "Iets in vouwen leggen of dubbelvouwen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me helpen om deze schone lakens netjes te <w>plooien</w>?",
                            "target_lang_translations": {
                                "en": "Can you help me to <w>fold</w> these clean sheets neatly?"
                            }
                        },
                        {
                            "text": "Zij besloot de brief zorgvuldig te <w>plooien</w> voordat ze hem in de envelop deed.",
                            "target_lang_translations": {
                                "en": "She decided to carefully <w>fold</w> the letter before putting it in the envelope."
                            }
                        }
                    ],
                    "synonyms": [
                        "vouwen",
                        "opplooien"
                    ],
                    "antonyms": [
                        "ontvouwen",
                        "strekken"
                    ],
                    "common_phrases": [
                        "papier plooien",
                        "kleren plooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To fold something or lay it in creases."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fold",
                                "target_lang_sense_clarification": "to bend paper, cloth, etc. over itself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efca4176-ad4c-3840-ab32-11b6be32669a",
                    "sense_definition": "Zich aanpassen aan of schikken naar bepaalde omstandigheden of personen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aanpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De taal <w>plooit</w> zich voortdurend naar de veranderende omstandigheden.",
                            "target_lang_translations": {
                                "en": "Language constantly <w>adapts</w> to changing circumstances."
                            }
                        },
                        {
                            "text": "Opvallend gewillig <w>plooit</w> hij zich in die nieuwe rol binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "Remarkably willingly, he <w>adapts</w> to that new role within the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "schikken",
                        "aanpassen",
                        "voegen"
                    ],
                    "antonyms": [
                        "verzetten",
                        "weigeren"
                    ],
                    "common_phrases": [
                        "zich plooien naar"
                    ],
                    "target_lang_definitions": {
                        "en": "To adapt or conform to certain circumstances or people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adapt",
                                "target_lang_sense_clarification": "to adjust to new conditions"
                            },
                            {
                                "target_lang_word": "conform",
                                "target_lang_sense_clarification": "to comply with rules or standards"
                            },
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "to yield or submit to pressure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62f13530-2e77-3f75-9919-685768ba00ac",
                    "sense_definition": "Het buigen van een gewricht of lichaamsdeel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "buigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan mijn elleboog moeizaam <w>plooien</w> en strekken, maar het blijft erg pijnlijk.",
                            "target_lang_translations": {
                                "en": "I can only <w>bend</w> and stretch my elbow with difficulty, but it remains very painful."
                            }
                        },
                        {
                            "text": "Na de knieoperatie moest hij dagelijks oefenen om zijn been weer goed te kunnen <w>plooien</w>.",
                            "target_lang_translations": {
                                "en": "After the knee surgery, he had to practice daily to be able to <w>bend</w> his leg properly again."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigen"
                    ],
                    "antonyms": [
                        "strekken"
                    ],
                    "common_phrases": [
                        "de knieën plooien",
                        "de arm plooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To bend a joint or limb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "to flex a joint or limb"
                            },
                            {
                                "target_lang_word": "flex",
                                "target_lang_sense_clarification": "to bend a muscle or joint"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d043b53-355b-3007-beee-e02fe9e98679",
                    "sense_definition": "Zaken zo regelen of aanpassen dat ze passend of geschikt worden gemaakt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sinds mijn overstap kan zij haar baan <w>plooien</w> rond mijn regelmatige bestaan als docent.",
                            "target_lang_translations": {
                                "en": "Since my transition, she has been able to <w>arrange</w> her job around my regular life as a teacher."
                            }
                        },
                        {
                            "text": "We moeten de planning een beetje <w>plooien</w> om iedereen tevreden te stellen.",
                            "target_lang_translations": {
                                "en": "We need to <w>adjust</w> the schedule a bit to keep everyone happy."
                            }
                        }
                    ],
                    "synonyms": [
                        "regelen",
                        "schikken",
                        "vormen"
                    ],
                    "common_phrases": [
                        "een regeling plooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrange or adjust matters so that they fit or are made suitable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrange",
                                "target_lang_sense_clarification": "to organize or plan"
                            },
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to alter slightly to achieve a desired fit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4adca5c-3fc0-3467-ab7d-78cb274b1d90",
                    "sense_definition": "Het rimpelen of in een bepaalde plooi trekken van het gezicht of de huid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rimpelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>plooit</w> zijn gezicht in een brede grijns zodra hij zijn vrienden ziet.",
                            "target_lang_translations": {
                                "en": "He <w>breaks</w> his face into a broad grin as soon as he sees his friends."
                            }
                        },
                        {
                            "text": "Met een bezorgde blik <w>plooide</w> de oude man zijn voorhoofd.",
                            "target_lang_translations": {
                                "en": "With a worried look, the old man <w>wrinkled</w> his forehead."
                            }
                        }
                    ],
                    "synonyms": [
                        "rimpelen",
                        "fronsen"
                    ],
                    "antonyms": [
                        "gladstrijken"
                    ],
                    "common_phrases": [
                        "het gezicht plooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To wrinkle or pull the face or skin into a certain expression."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrinkle",
                                "target_lang_sense_clarification": "to crease the skin or face"
                            },
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "to tightly gather or wrinkle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3b219c7-17ea-376a-a8cc-ac5176a0dcbe",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>plooi</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meervoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zaten diepe <w>plooien</w> in het gordijn nadat het uit de wasmachine kwam.",
                            "target_lang_translations": {
                                "en": "There were deep <w>folds</w> in the curtain after it came out of the washing machine."
                            }
                        },
                        {
                            "text": "Zij streek de <w>plooien</w> van haar rok glad voordat ze het podium opstapte.",
                            "target_lang_translations": {
                                "en": "She smoothed the <w>folds</w> of her skirt before stepping onto the stage."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'plooi' (fold, crease)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "folds",
                                "target_lang_sense_clarification": "plural of fold, creases in fabric or paper"
                            },
                            {
                                "target_lang_word": "creases",
                                "target_lang_sense_clarification": "plural of crease, lines made by folding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}