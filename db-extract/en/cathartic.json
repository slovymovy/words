                    {
                        "translation_id": "a3e35181-a14e-464a-8e6c-32ce74ec2f1e",
                        "source_entry_id": "6a61d1c5-be52-3e61-8cfc-5d4574200c3b",
                        "source_sense_description": "purgative; inducing catharsis",
                        "target_lang_word": "kathartisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kathartisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "230b7b5c-4fe1-3473-bfc2-457430d26703",
                                        "entry_id": "acf5a731-bf58-30ea-813a-6bc2f4a2f648",
                                        "glosses": [
                                            "die Katharsis betreffend, Katharsis aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a336ec57-3956-4c73-ab1c-cc7e71756634",
                                                "sense_id": "230b7b5c-4fe1-3473-bfc2-457430d26703",
                                                "text": "„Gute Kunst ist immer kathartisch. Aber selbst gute Menschen zuweilen nicht. Kathartische Menschen vermögen ihre geistige Existenz nicht fortzusetzen, wenn nicht mit Hilfe täglich erneuter Katharsis. Von allen Neueren besitzt das Kathartische am mächtigsten Beethoven.“"
                                            },
                                            {
                                                "example_id": "9882723f-910b-4332-ba4c-dea4557e3fb6",
                                                "sense_id": "230b7b5c-4fe1-3473-bfc2-457430d26703",
                                                "text": "„Mit gutem Benehmen allein ist dem Theater doch nicht geholfen. Ein wenig Emotion darf schon auch dabei sein, und da ist ein kräftiges Buh allemal kathartischer als ein fatalistisches Schweigen.“"
                                            },
                                            {
                                                "example_id": "e1f1e078-c7fa-4594-a8bf-a4c6ceeb888f",
                                                "sense_id": "230b7b5c-4fe1-3473-bfc2-457430d26703",
                                                "text": "„Die Male, die ich zurückschlug und meine Gewalt als groß und schrecklich bewertet wurde, weil ich kein Junge war, waren die kathartischsten Momente meiner Jugend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4d0a79b-2ddc-48e6-82a2-59d8802e2fca",
                        "source_entry_id": "6a61d1c5-be52-3e61-8cfc-5d4574200c3b",
                        "source_sense_description": "purgative; inducing catharsis",
                        "target_lang_word": "abführend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abführend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a09a77f0-f719-3e95-bf76-7df5ca7dcab9",
                                        "entry_id": "43c7acd4-a3de-311c-86a6-be3ad180d2c6",
                                        "glosses": [
                                            "so beschaffen, dass es den Stuhlgang fördert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3faa47f-ee02-4e3f-abe8-049a91f5842a",
                                                "sense_id": "a09a77f0-f719-3e95-bf76-7df5ca7dcab9",
                                                "text": "„Die Ägypter kannten und nutzten zum Beispiel die abführende Wirkung von Rizinusöl oder Feigen und behandelten Wunden mit antimikrobiell wirkendem Honig, Harzen oder Metallen […].“",
                                                "translation": "mit Komparativ:"
                                            },
                                            {
                                                "example_id": "d293c489-f63a-4ce8-a627-7cc6e8e5bfd8",
                                                "sense_id": "a09a77f0-f719-3e95-bf76-7df5ca7dcab9",
                                                "text": "„Allerdings solltest du nicht zu viele Pflaumen essen, denn sie können zu Durchfall führen. […] Trockenpflaumen wirken in hohen Mengen sogar noch abführender.“"
                                            },
                                            {
                                                "example_id": "deff0ce7-5955-40b0-beb8-4e27a9fba7d8",
                                                "sense_id": "a09a77f0-f719-3e95-bf76-7df5ca7dcab9",
                                                "text": "„Xylit soll allerdings noch abführender wirken als Erythrit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89dbe4a0-fb13-3b7c-b774-d81bffbe9d25",
                                        "entry_id": "43c7acd4-a3de-311c-86a6-be3ad180d2c6",
                                        "glosses": [
                                            "so beschaffen, dass es etwas ableitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d784f5-59cf-4787-9233-43c377519ff8",
                                                "sense_id": "89dbe4a0-fb13-3b7c-b774-d81bffbe9d25",
                                                "text": "„Das Blut im Nierenkörperchen steht unter hohem Druck, nicht zuletzt weil der Durchmesser der zuführenden Arteriole größer ist als der der abführenden Arteriole.“"
                                            },
                                            {
                                                "example_id": "7cb9ed1e-f732-4e00-99c9-2c9976cdaa75",
                                                "sense_id": "89dbe4a0-fb13-3b7c-b774-d81bffbe9d25",
                                                "text": "„Zu- und abführende elektrische Anschlüsse sind so angelegt, daß Feuchtigkeit nicht eindringen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
