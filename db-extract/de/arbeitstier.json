                "senses": [
                    {
                        "sense_id": "f41c77ad-afe1-3f3c-a4c7-de3e7a1d9f45",
                        "entry_id": "0ac4a431-66bb-3188-983d-cabc46179222",
                        "glosses": [
                            "an animal that does labour for people; beast of burden"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "4c25dc93-76f2-45fd-93f5-e0c66d519657",
                                "sense_id": "f41c77ad-afe1-3f3c-a4c7-de3e7a1d9f45",
                                "text": "Ochsen wurden hauptsächlich als Arbeitstiere gehalten.",
                                "translation": "Oxen were kept predominantly as beasts of burden.",
                                "english": "Oxen were kept predominantly as beasts of burden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5813673-51ef-39df-a15f-44b9bca9d5b4",
                        "entry_id": "0ac4a431-66bb-3188-983d-cabc46179222",
                        "glosses": [
                            "a person who works exaggeratedly hard",
                            "workaholic (one who cannot relax)"
                        ],
                        "tags": [
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ad76d94d-4083-4e1b-bb6d-9c01377efc1e",
                                "sense_id": "c5813673-51ef-39df-a15f-44b9bca9d5b4",
                                "text": "Er ist so ein Arbeitstier, dass er seine Tabellen noch als Bettlektüre benutzt.",
                                "translation": "He’s such a workaholic that he still reads his tables when he goes to bed.",
                                "english": "He’s such a workaholic that he still reads his tables when he goes to bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "b44a44ca-9d2a-3745-959a-c430454e159c",
                        "entry_id": "0ac4a431-66bb-3188-983d-cabc46179222",
                        "glosses": [
                            "a person who works exaggeratedly hard",
                            "plodder (one who must level out lacking talent)"
                        ],
                        "tags": [
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a0e4ed7b-74c7-467a-aa50-08c635a3deee",
                                "sense_id": "b44a44ca-9d2a-3745-959a-c430454e159c",
                                "text": "Es gibt drei Arten von guten Schülern: die Genies, die Schleimer und die Arbeitstiere.",
                                "translation": "There are three kinds of people who are good in school: the geniuses, the teacher’s pets, and the plodders.",
                                "english": "There are three kinds of people who are good in school: the geniuses, the teacher’s pets, and the plodders."
                            }
                        ]
                    },
                    {
                        "sense_id": "994f83c4-0ca1-3eeb-a923-140b51c01c17",
                        "entry_id": "0ac4a431-66bb-3188-983d-cabc46179222",
                        "glosses": [
                            "a machine, e.g. a car, kept for practical use rather than for leisure or as a status symbol"
                        ],
                        "tags": [
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c15cc5d1-87e7-4cc5-9b54-cdceaee13108",
                                "sense_id": "994f83c4-0ca1-3eeb-a923-140b51c01c17",
                                "text": "Der Kombi ist ein reines Arbeitstier. Für den Rest hab ich den Porsche.",
                                "translation": "The estate car is just for practical use. For the rest, I’ve got the Porsche.",
                                "english": "The estate car is just for practical use. For the rest, I’ve got the Porsche."
                            }
                        ]
                    }
                ],
