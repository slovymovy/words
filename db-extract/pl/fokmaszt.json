                                            {
                                                "example_id": "dc1e4534-d709-41fa-a1c6-ebe386ab0e12",
                                                "sense_id": "3d0e984c-70b6-33ad-8ffc-2fb55c4d2600",
                                                "text": "Brzy potom zvédal se uprostřed lodičky malý stěžeň;"
                                            },
                                            {
                                                "example_id": "f8cfdad0-a23c-43ee-b3ed-ee88c81a61eb",
                                                "sense_id": "3d0e984c-70b6-33ad-8ffc-2fb55c4d2600",
                                                "text": "Stožár se nazývá předmět, na který při slavnostních příležitostech stoupá vlajka. To, na co stoupá plachta, se jmenuje stěžeň. Na této lodi nemá plachta na co stoupat. Tato loď nemá stěžeň."
                                            }
                                        ]
                                    }
                                ]
                            }
