                                            {
                                                "example_id": "39739dcf-599f-4a75-ae5f-0675cf873015",
                                                "sense_id": "5f47e6a4-e7b3-3950-9d21-95acdc91a6b3",
                                                "text": "Overal in het centrum van de stad kom je zijn naam of beeltenis tegen: op de gevel van het theater, op de gedenksteen van zijn rode geboortehuis, op het standbeeld van de bibliotheek waar zijn bijzondere boekencollectie wordt bewaard."
                                            },
                                            {
                                                "example_id": "2937b280-133e-4a82-aee4-d974b079881c",
                                                "sense_id": "5f47e6a4-e7b3-3950-9d21-95acdc91a6b3",
