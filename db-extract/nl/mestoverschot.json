                            {
                                "example_id": "c88105ff-a6b3-4257-bda6-42bae760dedb",
                                "sense_id": "c110021b-7991-36e1-8fd0-4f26fb07ed90",
                                "text": "De intensieve varkenshouderij in Bretagne produceert een groot mestoverschot. Dat wordt over de landbouwgronden verspreid. De grote hoeveelheden nitraat en stikstof uit de mest vloeien via riviertjes naar zee. Door de verhoogde concentraties groeien de algen zo fel aan de kust."
                            },
                            {
                                "example_id": "dc549434-6f97-4c09-a29f-0db560e6b351",
                                "sense_id": "c110021b-7991-36e1-8fd0-4f26fb07ed90",
                                "text": "Het kabinet wil er zo voor zorgen dat het mestoverschot daar niet verder toeneemt."
                            }
