                    "sense_id": "8d9e382c-4ca2-3195-af8d-90199e53b005",
                    "sense_definition": "Fermer de nouveau ce qui a été ouvert.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à bien <w>refermer</w> la porte quand tu sors de la maison.",
                            "target_lang_translations": {
                                "en": "Remember to <w>close</w> the door properly when you leave the house.",
                                "ru": "Не забудь хорошенько <w>закрыть</w> дверь, когда выходишь из дома.",
                                "nl": "Denk eraan de deur goed <w>dicht</w> te <w>doen</w> als je het huis verlaat.",
                                "de": "Denk daran, die Tür richtig <w>zuzumachen</w>, wenn du das Haus verlässt.",
                                "pl": "Pamiętaj, żeby dobrze <w>zamknąć</w> drzwi, kiedy wychodzisz z domu.",
                                "it": "Ricordati di <w>chiudere</w> bene la porta quando esci di casa.",
                                "cs": "Nezapomeň dveře dobře <w>zavřít</w>, když odcházíš z domu.",
                                "tr": "Evden çıkarken kapıyı iyice <w>kapatmayı</w> unutma.",
                                "es": "Acuérdate de <w>cerrar</w> bien la puerta cuando salgas de casa.",
                                "zh": "出门的时候记得把门<w>关上</w>。"
                            }
                        },
                        {
                            "text": "Il a lu le dernier chapitre avant de <w>refermer</w> son livre.",
                            "target_lang_translations": {
                                "en": "He read the last chapter before <w>closing</w> his book.",
                                "ru": "Он прочитал последнюю главу, прежде чем <w>закрыть</w> книгу.",
                                "nl": "Hij las het laatste hoofdstuk voordat hij zijn boek <w>dichtdeed</w>.",
                                "de": "Er las das letzte Kapitel, bevor er sein Buch <w>zuklappte</w>.",
                                "pl": "Przeczytał ostatni rozdział, zanim <w>zamknął</w> swoją książkę.",
                                "it": "Ha letto l'ultimo capitolo prima di <w>richiudere</w> il libro.",
                                "cs": "Přečetl poslední kapitolu, než <w>zavřel</w> svou knihu.",
                                "tr": "Kitabını <w>kapatmadan</w> önce son bölümü okudu.",
                                "es": "Ha leído el último capítulo antes de <w>cerrar</w> su libro.",
                                "zh": "他读完最后一章后才把书<w>合上</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fermer"
                    ],
                    "antonyms": [
                        "rouvrir",
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "refermer la porte",
                        "refermer un livre"
                    ],
                    "target_lang_definitions": {
                        "en": "To close again something that has been opened.",
                        "ru": "Снова закрыть то, что было открыто.",
                        "nl": "Opnieuw sluiten wat eerder open was geweest.",
                        "de": "Etwas, das geöffnet war, erneut schließen.",
                        "pl": "Ponownie zamknąć coś, co wcześniej zostało otwarte.",
                        "it": "Chiudere di nuovo qualcosa che era stato aperto.",
                        "cs": "Znovu zavřít to, co bylo otevřeno.",
                        "tr": "Açılmış olan bir şeyi yeniden kapatmak.",
                        "es": "Volver a cerrar algo que estaba abierto.",
                        "zh": "把已经打开的东西再次关上。"
