                            {
                                "example_id": "919e3bc2-ab94-43f0-802f-43b0969d9c4b",
                                "sense_id": "bd5aaf35-f2b4-3f3d-84e1-5b3a6379b97b",
                                "text": "Ik heb laatst een \"Inbrekers niet gewenst\"-sticker op mijn deur geplakt."
                            }
                        ]
