                "senses": [
                    {
                        "sense_id": "830ebabf-7b7a-3e70-972d-644a2a8d4fe5",
                        "entry_id": "e4cda81c-abb8-38db-93a4-af9f6666da24",
                        "glosses": [
                            "Tacher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af9e5c2-48b1-45a1-a006-0883854f349d",
                                "sense_id": "830ebabf-7b7a-3e70-972d-644a2a8d4fe5",
                                "text": "Depuis mon détartrage 15 jours après le début de mon arrêt, tout est resté nickel, alors qu'avant, 2 mois après, l'émail était tout retaché."
                            },
                            {
                                "example_id": "2d291451-46eb-482c-bdab-8aee3a8f6a1c",
                                "sense_id": "830ebabf-7b7a-3e70-972d-644a2a8d4fe5",
                                "text": "Alors, les élèves ont vidé, nettoyé, ciré, lessivé, peint, retaché, repeint, renettoyé, décoré !"
                            },
                            {
                                "example_id": "9d5819ea-3823-49da-9838-ebb97b8625a8",
                                "sense_id": "830ebabf-7b7a-3e70-972d-644a2a8d4fe5",
                                "text": "Exemple avec la même robe, qui a été retachée au chocolat après l'ajout d'une ceinture dans un premier temps."
                            }
                        ]
                    }
