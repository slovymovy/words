                    {
                        "sense_id": "d010c6a9-bb5b-3966-a2d8-e02cb1900b72",
                        "entry_id": "1c7a0762-f988-3621-bd98-1e4a4c8e96fd",
                        "glosses": [
                            "zonder nadruk gespeelde noten aan het begin van een melodie voorafgaand aan de eerste tel van een maat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48cd7842-55f3-42da-865a-3f239a6fa546",
                                "sense_id": "d010c6a9-bb5b-3966-a2d8-e02cb1900b72",
                                "text": "Hij, en zijn vader, speelden Beethovens Romance in een accelerando al fine; geen enkele opmaat in de Chaconne van Vitali deugde."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab9020b8-eb05-3322-a4be-56c8d095d0b6",
                        "entry_id": "1c7a0762-f988-3621-bd98-1e4a4c8e96fd",
                        "glosses": [
                            "eerste maat van een muziekstuk of partij, als in die maat de eerste toon niet meteen op de eerste tel inzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04230ac0-1ee7-466b-80fe-455d59ed99dc",
                                "sense_id": "ab9020b8-eb05-3322-a4be-56c8d095d0b6",
                                "text": "Een opmaat kan met een of meer tellen rust beginnen. Als de opmaat niet wordt voorafgegaan door een of meer tellen rust, eindigt het muziekstuk met een onvolledige maat. De duur van de opmaat wordt dan van de laatste maat afgetrokken."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa3e984-81c8-3f0d-a534-693a2625e3a7",
                        "entry_id": "1c7a0762-f988-3621-bd98-1e4a4c8e96fd",
                        "glosses": [
                            "eerste begin, eerste voorbeelden van een latere ontwikkeling"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1bfb33-962e-4ce7-91e0-a36e5246f575",
                                "sense_id": "6aa3e984-81c8-3f0d-a534-693a2625e3a7",
                                "text": "De trip naar Noorwegen vormt de opmaat tot een hernieuwd zwervend bestaan, waarbij Felix Rutten niet zoals in de jaren tussen 1910 en 1914 een thuisbasis heeft."
                            }
                        ]
                    }
                ],
