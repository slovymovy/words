                    {
                        "sense_id": "487fab03-5b2d-3578-bb22-2ff84c258089",
                        "entry_id": "5bb94f09-1d1d-3e68-a251-5dce59c9fb03",
                        "glosses": [
                            "een ronde, gevulde koek, bestaande uit twee plakjes boterdeeg waartussen een mengsel van banketspijs en amandelspijs wordt gespoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ff0b91-46d4-4eb3-b22a-2dd0b8e4c219",
                                "sense_id": "487fab03-5b2d-3578-bb22-2ff84c258089",
                                "text": "Het amsterdammertje is de Amsterdamse versie van de alom bekende rondo."
                            }
                        ]
