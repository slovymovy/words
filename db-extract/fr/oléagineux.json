                ],
                "senses": [
                    {
                        "sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                        "entry_id": "7ed8baa3-9c9a-31f2-858f-603dd383fabc",
                        "glosses": [
                            "Dont on peut tirer de l’huile ; qui est de la nature de l’huile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb4bb9f-b161-4393-b86d-dc713dfe874f",
                                "sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                                "text": "Parmi les plantes oléagineuses, on cultive le colza et la navette, et, parmi les plantes textiles, le chanvre et le lin ; […]."
                            },
                            {
                                "example_id": "fce5a1fd-c658-4537-8225-c26a4d364148",
                                "sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                                "text": "Plusieurs savants se sont occupés du rôle de l’huile dans la germination des graines oléagineuses. Ils ont examiné la question de deux manières différentes : […]."
                            },
                            {
                                "example_id": "4b6b03fa-cf48-4071-b50c-d9939c9ad353",
                                "sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                                "text": "Originaire du Mexique, le Tournesol a été introduit en Ukraine vers le milieu du XVIIIᵉ siècle à titre de plante ornementale. Les premiers essais de sa culture en tant que plante oléagineuse remontent à 1830."
                            },
                            {
                                "example_id": "8488f8b6-3df8-4d99-aad1-18668c1a34b8",
                                "sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                                "text": "Les fruits oléagineux et les céréales sont pauvres en lysine, on les associe aux légumineuses qui en sont riches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eb8e24c-2090-4b9d-ad22-8b771d7c60d8",
                        "source_entry_id": "7ed8baa3-9c9a-31f2-858f-603dd383fabc",
                        "source_sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                        "target_lang_word": "ölhaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ölhaltig",
