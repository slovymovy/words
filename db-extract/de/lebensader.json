                                "target_senses": [
                                    {
                                        "sense_id": "ddc1d82b-18e9-3698-a588-87d77dec4455",
                                        "entry_id": "7440c369-52bb-339b-85f6-784766111776",
                                        "glosses": [
                                            "A line to which a drowning or falling victim may cling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a10fba9-906a-3f2b-a40b-9ffe75cd6129",
                                        "entry_id": "7440c369-52bb-339b-85f6-784766111776",
                                        "glosses": [
                                            "A source of salvation in a crisis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192eb1e5-80c0-43a5-b6e6-058407b9e629",
                                                "sense_id": "4a10fba9-906a-3f2b-a40b-9ffe75cd6129",
                                                "text": "The girls, of course, were my lifeline during this time."
                                            },
                                            {
                                                "example_id": "d70edf67-0fd2-4a49-b28a-b617b31a331c",
                                                "sense_id": "4a10fba9-906a-3f2b-a40b-9ffe75cd6129",
                                                "text": "Slowly I began to fill up some of the emptiness inside—writing had become my lifeline."
                                            },
                                            {
                                                "example_id": "ab74dd5d-6292-4b3d-8a36-a22e141ae66c",
                                                "sense_id": "4a10fba9-906a-3f2b-a40b-9ffe75cd6129",
                                                "text": "The Government has thrown a lifeline to Alstom's Derby Works, with an offer of an order for ten Class 345 nine-car electric multiple units (EMUs) for the Elizabeth line - but only if the 'price is right'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d13ef855-eca5-304b-9e31-4af93b878690",
                                        "entry_id": "7440c369-52bb-339b-85f6-784766111776",
                                        "glosses": [
                                            "A means or route for transporting indispensable supplies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93860082-a395-445a-9602-557cac7c5e4a",
                                                "sense_id": "d13ef855-eca5-304b-9e31-4af93b878690",
                                                "text": "Planners did not see the access routes as west Berlin's sole lifeline, which now seems instinctive to us."
                                            },
                                            {
                                                "example_id": "03244250-e732-4b54-a664-e478df76fe0d",
                                                "sense_id": "d13ef855-eca5-304b-9e31-4af93b878690",
                                                "text": "It is no real surprise that half the UK's stations and 5,000 miles of route were recommended to close. Nevertheless, some great mistakes were made in Marples' devil-may-care purge that left commuters stranded and seaside resorts without a lifeline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5756bfe-60d9-3242-a87b-47505dcde273",
                                        "entry_id": "7440c369-52bb-339b-85f6-784766111776",
                                        "glosses": [
                                            "A system or structure of vital importance to a community."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f5873a5-88c8-3523-b390-3355b5e4ca35",
                                        "entry_id": "7440c369-52bb-339b-85f6-784766111776",
                                        "glosses": [
                                            "On the deck of a boat, a line to which one can attach oneself to stay aboard on rough seas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
