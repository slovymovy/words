                    },
                    {
                        "translation_id": "cd67ec39-1db0-4cb4-84da-b6883822017d",
                        "source_entry_id": "e80fb573-1d08-347b-b5ef-ae320287816d",
                        "source_sense_description": "to make something unstable",
                        "target_lang_word": "déstabiliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déstabiliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "802212c5-6a3d-3b75-bcca-a288d4589500",
                                        "entry_id": "0bf06c99-761a-30bb-b1c7-a8fe975282e9",
                                        "glosses": [
                                            "Rendre instable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e09d884-4c71-4ce8-8706-85c33b0fc460",
                                                "sense_id": "802212c5-6a3d-3b75-bcca-a288d4589500",
                                                "text": "Il est donc nécessaire d’œuvrer à la poursuite de leur activité, pour éviter une mise à l’arrêt totale des chantiers, qui déstabiliserait non seulement les entreprises concernées mais aussi l’ensemble de la chaîne économique."
                                            },
                                            {
                                                "example_id": "9e909181-4168-47a3-8eb0-805d9473e9b5",
                                                "sense_id": "802212c5-6a3d-3b75-bcca-a288d4589500",
                                                "text": "Le dollar est déstabilisé par le déficit croissant du commerce extérieur américain."
                                            },
                                            {
                                                "example_id": "b187fe05-ce17-4223-866c-d520398eb638",
                                                "sense_id": "802212c5-6a3d-3b75-bcca-a288d4589500",
                                                "text": "Les arbres résistent au vent par effet bloc. Les balancements des houppiers sont limités par la présence d’arbres voisins, toute éclaircie un peu forte peut donc déstabiliser le peuplement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a71e3fd-243c-3f21-b687-569ef5cb2ebc",
                                        "entry_id": "0bf06c99-761a-30bb-b1c7-a8fe975282e9",
                                        "glosses": [
                                            "Faire perdre sa contenance, perturber (une personne)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7414b440-ec4a-40ac-a52c-491cc5936590",
                                                "sense_id": "9a71e3fd-243c-3f21-b687-569ef5cb2ebc",
                                                "text": "Ta remarque l’a déstabilisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b789b05f-995e-4c66-8e06-dd1a3ea056af",
                        "source_entry_id": "e80fb573-1d08-347b-b5ef-ae320287816d",
                        "source_sense_description": "to make something unstable",
