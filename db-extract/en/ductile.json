                                        "examples": [
                                            {
                                                "example_id": "0e1e31b2-0c27-4740-a9a3-2d5074166bf1",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "„Ich war dazu erzogen, stets freundlich und fügsam zu sein […]“"
                                            },
                                            {
                                                "example_id": "f963a5d4-7774-4628-96de-a610dfc79ec9",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "Bürger müssen nicht fügsam sein."
                                            },
                                            {
                                                "example_id": "dbe60654-d0d3-46dd-a010-344b92e7093b",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "Alexia schaltet eine kleine Kamera ein. Die Aufnahmen sollen beweisen, dass die Polizisten korrekt eingreifen. Die jungen Männer zücken fügsam ihre Ausweise, lassen sich abtasten. So friedlich läuft es nicht immer ab, sagt Xavier."
                                            },
                                            {
                                                "example_id": "7159108b-fff6-4d13-b762-109bb908c8e5",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "Seit über 30 Jahren ist die Arbeitslosenrate in Frankreich höher als in den meisten europäischen Ländern. Das, meint [die Psychologin] Peze, habe Arbeitnehmer fügsam gemacht."
                                            },
                                            {
                                                "example_id": "8eb39719-0802-4ab4-951d-084809fce546",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "[…] oftmals war ihm [Kurt Waldheim] auch vorgeworfen worden, als UN-Generalsekretär in die Rolle eines „fügsamen Vollstreckers des Mehrheitswillens“ geraten zu sein."
                                            },
                                            {
                                                "example_id": "906180f6-0dbe-4a22-afb0-59b11087f9af",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "Fügsam bejubeln die 12.000 Delegierten ihren alten und neuen Vorsitzenden: den 90-jährigen Dauerpräsidenten Robert Mugabe."
                                            },
                                            {
                                                "example_id": "0de9d34d-fc20-4e8d-8ed0-67243054973c",
                                                "sense_id": "15ea2007-8e03-3220-9a0d-645300056739",
                                                "text": "„Die beiden Frauen antworten nicht, doch Louise streckt fügsam den Arm aus, als Paul ihr einen Schwimmflügel über den Ellbogen streift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
