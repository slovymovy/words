                                    {
                                        "sense_id": "31bb9eae-35af-3665-937e-318005ed32be",
                                        "entry_id": "4bc6f6af-066e-3dfd-9845-6ea721bef317",
                                        "glosses": [
                                            "Art des mündlichen oder schriftlichen Ausdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964bb78a-cd85-4cdb-b208-6f96e1114299",
                                                "sense_id": "31bb9eae-35af-3665-937e-318005ed32be",
                                                "text": "Deine Ausdrucksweise gefällt mir (nicht)."
                                            },
                                            {
                                                "example_id": "f29478d9-366e-4fd8-998d-d63339740430",
                                                "sense_id": "31bb9eae-35af-3665-937e-318005ed32be",
                                                "text": "„Zu verlernen waren damals hauptsächlich die typischen nationalsozialistischen Ausdrucksweisen, das Vokabular des Dritten Reiches.“"
                                            },
                                            {
                                                "example_id": "1cce1d7e-036b-411a-9039-19dd0d8a391d",
                                                "sense_id": "31bb9eae-35af-3665-937e-318005ed32be",
                                                "text": "„Trotz der Dunkelheit und Verschwommenheit in der Ausdrucksweise des Soldaten verstand Pierre doch genau, was er sagen wollte, und nickte beifällig.“"
                                            },
                                            {
                                                "example_id": "bec8c366-b882-4a24-9bc4-2320f274206f",
                                                "sense_id": "31bb9eae-35af-3665-937e-318005ed32be",
                                                "text": "„Der weltkluge Abate Gama nahm mich beiseite und warnte mich, meine Ausdrucksweise sei zu scharf, und das werde auf die Dauer mißfallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
