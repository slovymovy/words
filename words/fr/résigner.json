                    "frequency": "Middle",
                    "semantic_group_id": "acceptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues hésitations, il a fini par se <w>résigner</w> à son sort."
                        },
                        {
                            "text": "Elle refuse absolument de se <w>résigner</w> face à cette injustice flagrante."
                        }
                    ],
                    "synonyms": [
