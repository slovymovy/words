                        "sense_id": "740143fc-6ddf-3b88-839d-ae893240f542",
                        "entry_id": "b0f707e4-4471-3434-b075-c2e03fb8e4f2",
                        "glosses": [
                            "Qui peut être additionné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518e44d6-f2bf-4990-8050-7da24622190d",
                                "sense_id": "740143fc-6ddf-3b88-839d-ae893240f542",
                                "text": "Mais ce n’est rien encore : la substance et ses deux manifestations qui forment une trinité, comme si la substance et les manifestations étaient choses séparables et additionnables !"
                            },
                            {
                                "example_id": "0b0f6473-3243-4ed3-ab89-93f22efa5976",
                                "sense_id": "740143fc-6ddf-3b88-839d-ae893240f542",
                                "text": "Ce temps, uniforme dans sa vacuité, fragmenté et additionnable, est celui de la science."
                            },
                            {
                                "example_id": "e2a7b4c0-cb29-44e6-9e16-de8cb2968b94",
                                "sense_id": "740143fc-6ddf-3b88-839d-ae893240f542",
                                "text": "Au soir du 22 mars, le résultat final pourrait ne pas surprendre, puisque « les » gauches, même divisées, bénéficient d’un réservoir de voix additionnables si la droite se fait trop menaçante."
                            }
                        ]
                    }
