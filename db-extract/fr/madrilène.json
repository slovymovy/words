                    },
                    {
                        "form_id": "4a9f17b8-3d80-470c-90ad-3ac7c1553e64",
                        "entry_id": "c1d4faa6-e8de-336a-b963-5801ce1ce729",
                        "tags": [],
                        "form": "madrilègne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                        "entry_id": "c1d4faa6-e8de-336a-b963-5801ce1ce729",
                        "glosses": [
                            "Relatif à Madrid, la capitale de l’Espagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3cd9d5-7504-4a01-91cd-20025a53c716",
                                "sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                                "text": "Mˡˡᵉ Cile était donc restée sous la garde unique, et peut-être un peu jeune, de sa gouvernante madrilène, qui lui apprenait l’espagnol."
                            },
                            {
                                "example_id": "732ee3e7-2e19-4e87-82e5-4d03c3b03bc5",
                                "sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                                "text": "Les agents de la police municipale madrilène sont fort aimables, chacun est muni d’un petit livret contenant l’énumération des rues, boulevards, impasses, plazas (places) et plazuelas (petites places). Ils le feuilletaient avec complaisance pour répondre à ma question."
                            },
                            {
                                "example_id": "c52d40e7-4326-44f5-b325-13bff7b61fd6",
                                "sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                                "text": "On put croire un instant que la résolution votée par le Congrès de Saragosse pour mettre un terme au différend madrilène aurait rétabli la paix. En effet, conformément à la décision du Congrès, la Fédération madrilène annula l’expulsion qu’elle avait prononcée contre six rédacteurs de la Emancipación."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3b5c815-fd6f-4014-9396-6fcafe242ccc",
                        "source_entry_id": "c1d4faa6-e8de-336a-b963-5801ce1ce729",
                        "source_sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                        "target_lang_word": "Madrider",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Madrider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2764ef11-540e-3dae-aeb8-9165f81273f4",
                                        "entry_id": "85f8bd33-0665-3468-a924-2dbb6c370e14",
                                        "glosses": [
                                            "Einwohner der spanischen Hauptstadt Madrid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef7761e-ebb6-40ef-80b4-e896a9f44b6c",
                                                "sense_id": "2764ef11-540e-3dae-aeb8-9165f81273f4",
                                                "text": "Er fragte einen Madrider nach dem Weg zum Plaza Mayor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Madrider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a825120f-bd81-3766-9ea2-de14e44c853f",
                                        "entry_id": "af5ee507-2564-3651-9da2-fbdb03f6d04d",
                                        "glosses": [
                                            "sich auf Madrid beziehend, aus Madrid kommend, zu Madrid gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3113d849-13ee-494f-9113-273427741bdb",
                                                "sense_id": "a825120f-bd81-3766-9ea2-de14e44c853f",
                                                "text": "„Mario wird verhaftet und in ein Madrider Gefängnis gesteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2658a35-cb25-4fb3-9a11-c24f2f571113",
                        "source_entry_id": "c1d4faa6-e8de-336a-b963-5801ce1ce729",
                        "source_sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                        "target_lang_word": "madridisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e33da343-d4d2-4ae1-8dfb-b8861d8a4d57",
                        "source_entry_id": "c1d4faa6-e8de-336a-b963-5801ce1ce729",
                        "source_sense_id": "030038fb-bbda-3bc9-b425-10c6d735bb8a",
                        "target_lang_word": "madrilenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madrilenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                        "entry_id": "83601af5-6809-3005-a41b-484434b1822b",
                                        "glosses": [
                                            "zur spanischen Hauptstadt Madrid oder seinen Bewohnern gehörig, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c67f3f5-5457-4606-96b1-41abe00441b2",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "In der madrilenischen Metrostation Legazpi wurde am Sonntag, den 11. November, ein 20-jähriger so genannter „Red Skin“ mutmaßlich von einem Neonazi mit einem Jagdmesser erstochen."
                                            },
                                            {
                                                "example_id": "875aa644-d277-4b15-bb12-e35d95fd8901",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "[Nuri Sahin wird] es angesichts des Überangebotes von Weltklasse im madrilenischen Mittelfeld schwer haben, einen Stammplatz zu ergattern."
                                            },
                                            {
                                                "example_id": "dc4a2202-5505-41f8-9383-467a700f23d8",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "Dreimal Real Madrid, einmal FC Barcelona: Die Champions League ist derzeit spanisch, zumeist madrilenisch."
                                            },
                                            {
                                                "example_id": "0d671772-9c7b-4467-8145-087c21242136",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "Madrilenische Tapas enthalten alle Köstlichkeiten der gesamten spanischen Küche, wie Meeresfrüchte, Schinken und Wurstwaren, eingelegte Gemüse, Kartoffelgerichte oder Käse."
                                            },
                                            {
                                                "example_id": "7275ff68-cd2b-4b18-81b8-79e842554365",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "So sehr das Buch eine gewisse soziale Allgemeingütigkeit beansprucht, bleibt es doch sehr spanisch, sehr madrilenisch sogar, in den geschilderten Lebensgewohnheiten, Umgangsformen und Familienstrukturen."
                                            },
                                            {
                                                "example_id": "bd2446ca-5011-4415-9428-772d9869e694",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "„Junger Mann, nicht nur das Schweigen des madrilenischen, nein, noch mehr das des japanischen Hofes beunruhigen mich ein wenig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
