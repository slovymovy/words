                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bounce",
                                "target_lang_sense_clarification": "to spring back from a surface after hitting it"
                            },
                            {
                                "target_lang_word": "rebound",
                                "target_lang_sense_clarification": "to spring back from a force or surface"
                            },
                            {
                                "target_lang_word": "ricochet",
                                "target_lang_sense_clarification": "to rebound one or more times off a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94f8939-094d-3617-9ce4-a1044938b5ff",
                    "sense_definition": "een gevoel van afkeer, irritatie of schok teweegbrengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irriteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn arrogante houding <w>stuit</w> veel mensen tegen de borst.",
                            "target_lang_translations": {
                                "en": "His arrogant attitude <w>offends</w> many people."
                            }
                        },
                        {
                            "text": "Het onrechtvaardige gedrag van de manager <w>stuitte</w> de werknemers enorm tegen de borst.",
                            "target_lang_translations": {
                                "en": "The manager's unjust behavior <w>repelled</w> the employees enormously."
                            }
                        }
                    ],
                    "synonyms": [
                        "irriteren",
                        "ergeren",
                        "tegenstaan"
                    ],
                    "antonyms": [
                        "bevallen",
                        "aanstaan"
                    ],
                    "common_phrases": [
