                    "target_lang_definitions": {
                        "en": "Very strong, excessive, exceeding the usual measure (of feelings, states).",
                        "es": "Muy intenso, excesivo o fuera de lo común (dicho de emociones, sensaciones o estados).",
                        "fr": "Très fort, excessif, dépassant la mesure ordinaire (en parlant de sentiments, d'états)."
                    },
