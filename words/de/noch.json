                    "frequency": "High",
                    "semantic_group_id": "zeitlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bist du immer <w>noch</w> bei der Arbeit im Büro?"
                        },
                        {
                            "text": "Ich warte hier schon lange, aber er schläft <w>noch</w>."
                        }
                    ],
                    "synonyms": [
