                "senses": [
                    {
                        "sense_id": "a55da5ac-9bc0-3c53-bab8-48ef77c0dc23",
                        "entry_id": "cdf5c7aa-23f7-3b54-bbdd-ebb46ccbbe78",
                        "glosses": [
                            "To make particular, as opposed to general; to restrict to a specific or individual case, class etc.; to single out."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3cac24e5-fe2b-34f0-be2b-ddfaac34744c",
                        "entry_id": "cdf5c7aa-23f7-3b54-bbdd-ebb46ccbbe78",
                        "glosses": [
                            "To be specific about (individual instances); to go into detail (about), to specify."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "70461a0a-d3d0-4ba6-ac73-34f07246b77a",
                                "sense_id": "3cac24e5-fe2b-34f0-be2b-ddfaac34744c",
                                "text": "'Tis hard I confesse, yet I have disposed of them as I could, and will descend to particularize them according to their species."
                            },
                            {
                                "example_id": "85ecfecd-78d7-4f8d-a706-724691bd2108",
                                "sense_id": "3cac24e5-fe2b-34f0-be2b-ddfaac34744c",
                                "text": "Twice we find him, not only boasting of his Parentage, as an Israelite at large, but particularizing his Descent from the Tribe of Benjamin."
                            },
                            {
                                "example_id": "1cdcdead-1eb2-45e8-9d1e-44205f51c48b",
                                "sense_id": "3cac24e5-fe2b-34f0-be2b-ddfaac34744c",
                                "text": "Now it is his daily work to particularize, item by item, the iniquities of the system, and the petty manifestations of the tyranny here in Arras."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d4f8005-70ad-356e-8983-10d11404dfa7",
                        "entry_id": "cdf5c7aa-23f7-3b54-bbdd-ebb46ccbbe78",
                        "glosses": [
                            "To differentiate, make distinct from others."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
