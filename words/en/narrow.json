                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́зкий",
                                "target_lang_sense_clarification": "перен. ограниченный"
                            },
                            {
                                "target_lang_word": "ограни́ченный",
                                "target_lang_sense_clarification": "о кругозоре или выборе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "beperkt",
                                "target_lang_sense_clarification": "qua omvang of keuze"
                            },
                            {
                                "target_lang_word": "smal",
                                "target_lang_sense_clarification": "figuurlijk, over een bereik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d717b05f-c55c-3c9d-9209-143274c58dec",
                    "sense_definition": "Lacking tolerance or flexibility; unwilling to accept different ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a very <w>narrow</w> view of the world and refuses to travel.",
                            "target_lang_translations": {
                                "ru": "У него очень <w>узкий</w> взгляд на мир, и он отказывается путешествовать.",
                                "nl": "Hij heeft een zeer <w>bekrompen</w> wereldbeeld en weigert te reizen."
                            }
                        },
                        {
                            "text": "Such <w>narrow</w> opinions can prevent you from learning new things.",
                            "target_lang_translations": {
                                "ru": "Такие <w>узкие</w> взгляды могут помешать вам узнавать новое.",
                                "nl": "Dergelijke <w>bekrompen</w> meningen kunnen je ervan weerhouden nieuwe dingen te leren."
                            }
                        }
                    ],
                    "antonyms": [
                        "broad"
                    ],
                    "common_phrases": [
                        "narrow mind",
                        "narrow view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный терпимости или гибкости; не желающий принимать иные идеи.",
                        "nl": "Gebrek aan tolerantie of flexibiliteit; onwillig om andere ideeën te accepteren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́зкий",
                                "target_lang_sense_clarification": "об уме или взглядах"
                            },
                            {
                                "target_lang_word": "недалёкий",
                                "target_lang_sense_clarification": "об умственных способностях"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bekrompen",
                                "target_lang_sense_clarification": "over iemands geest of opvattingen"
                            },
                            {
                                "target_lang_word": "nauwziend",
                                "target_lang_sense_clarification": "streng of beperkt in visie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56acec62-f029-3f5e-a86c-01b7ba862a43",
                    "sense_definition": "To become or make something less wide or extensive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dimensions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road <w>narrows</w> as it goes up the steep hill.",
                            "target_lang_translations": {
                                "ru": "Дорога <w>сужается</w>, поднимаясь на крутой холм.",
                                "nl": "De weg <w>versmalt</w> naarmate deze de steile heuvel opgaat."
                            }
                        },
                        {
                            "text": "We need to <w>narrow</w> the search to find the right candidate.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сузить</w> поиск, чтобы найти подходящего кандидата.",
                                "nl": "We moeten de zoekopdracht <w>beperken</w> om de juiste kandidaat te vinden."
                            }
                        }
                    ],
                    "synonyms": [
                        "taper",
                        "limit",
                        "constrict"
                    ],
                    "antonyms": [
                        "widen"
                    ],
                    "common_phrases": [
                        "narrow down",
                        "narrow the gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать или становиться менее широким.",
                        "nl": "Minder breed of minder uitgebreid worden of maken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сужа́ть",
                                "target_lang_sense_clarification": "делать уже"
                            },
                            {
                                "target_lang_word": "сужа́ться",
                                "target_lang_sense_clarification": "становиться уже"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "versmallen",
                                "target_lang_sense_clarification": "fysiek of figuurlijk nauwer maken"
                            },
                            {
                                "target_lang_word": "beperken",
                                "target_lang_sense_clarification": "de reikwijdte verkleinen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d90555-c003-34d9-ae47-34cde05be76a",
                    "sense_definition": "To partially close the eyelids, often to see better or express emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>narrowed</w> her eyes suspiciously at the stranger.",
                            "target_lang_translations": {
                                "ru": "Она подозрительно <w>сузила</w> глаза, глядя на незнакомца.",
                                "nl": "Ze <w>kneep</w> haar ogen achterdochtig <w>samen</w> naar de vreemdeling."
                            }
                        },
                        {
                            "text": "He <w>narrowed</w> his eyes to read the small print on the sign.",
                            "target_lang_translations": {
                                "ru": "Он <w>сощурил</w> глаза, чтобы прочитать мелкий шрифт на вывеске.",
                                "nl": "Hij <w>kneep</w> zijn ogen <w>samen</w> om de kleine lettertjes op het bord te lezen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrow one's eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частично прикрывать глаза веками, часто чтобы лучше видеть или выразить эмоцию.",
                        "nl": "De oogleden gedeeltelijk sluiten, vaak om beter te zien of om een emotie uit te drukken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щу́рить",
                                "target_lang_sense_clarification": "глаза"
                            },
                            {
                                "target_lang_word": "сужа́ть",
                                "target_lang_sense_clarification": "глаза"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "samenknijpen",
                                "target_lang_sense_clarification": "van de ogen"
                            },
                            {
                                "target_lang_word": "toeknijpen",
                                "target_lang_sense_clarification": "van de ogen"
                            }
                        ]
                    }
                }
            ]
        },
