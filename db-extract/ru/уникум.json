                        "form": "у́никуме"
                    },
                    {
                        "form_id": "76543c5e-ef34-4a01-b8b2-1ae1123ba8f9",
                        "entry_id": "95046ad2-64c7-30c3-afdb-dedcbb1af542",
                        "tags": [
                            "plural",
