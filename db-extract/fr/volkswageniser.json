                "senses": [
                    {
                        "sense_id": "bfa39817-7f96-3763-8767-7cb603007c55",
                        "entry_id": "e719f39b-8ca3-3900-b51b-d5c63d7a2731",
                        "glosses": [
                            "Donner un caractère rappelant les automobiles Volkswagen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfd7cfe-275b-4ee0-a63d-d0dd6db54c46",
                                "sense_id": "bfa39817-7f96-3763-8767-7cb603007c55",
                                "text": "L'ironie de l'histoire c'est qu'il n'y a pas si longtemps, Fiat cherchait à germaniser - volkswageniser même - ses voitures."
                            },
                            {
                                "example_id": "4ca149e4-dbb1-41b2-9ac8-a6a7716bd36e",
                                "sense_id": "bfa39817-7f96-3763-8767-7cb603007c55",
                                "text": "Ca doit couter moins cher “volkswageniser” un Chrysler que “nordaméricaniser” un Routan."
                            },
                            {
                                "example_id": "04992beb-d34c-4631-ac72-14993b0eac60",
                                "sense_id": "bfa39817-7f96-3763-8767-7cb603007c55",
                                "text": "Les japs me font de la peine ils semblent comme beaucoup de plus en plus se Volkswageniser !!!!"
                            }
                        ]
                    },
                    {
                        "sense_id": "40f8470e-664b-301d-8835-584a32d5ecf1",
                        "entry_id": "e719f39b-8ca3-3900-b51b-d5c63d7a2731",
                        "glosses": [
                            "Adapter pour tromper les consommateurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8955c6-7ae9-42f3-b93c-0e623f31079a",
                                "sense_id": "40f8470e-664b-301d-8835-584a32d5ecf1",
                                "text": "Pour évoquer ce nouveau cas de tromperie, le site Quartz a titré : « Samsung est accusé de “volkswageniser” ses téléviseurs pour survendre leur efficacité énergétique »."
                            }
                        ]
                    },
                    {
                        "sense_id": "d813ea68-f928-32a3-b477-1f1e15c994ac",
                        "entry_id": "e719f39b-8ca3-3900-b51b-d5c63d7a2731",
                        "glosses": [
                            "Pigeonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f8eaa8-1afd-49aa-8d0e-0cf5af2b2edc",
                                "sense_id": "d813ea68-f928-32a3-b477-1f1e15c994ac",
                                "text": "Dans la foulée des scandales d’émissions truquées, quelques conseils – à l’attention des particuliers, des constructeurs automobiles et des pouvoirs publics – pour ne pas se faire volkswageniser tout cru..."
                            }
                        ]
                    }
