                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a761e68f-05b6-459c-8873-9ef511b59a33",
                                "sense_id": "2255cf39-9634-3c18-b6ad-b8bfd8933be0",
                                "text": "„In einem Wandschrank steht ein Farbfernseher, ein Zenith mit Sechsunddreißig-Zoll-Bildschirm und sechsunfünfzig Kabelkanälen und vier Lokalsendern.“"
                            },
                            {
                                "example_id": "35c36dd8-3dc9-4917-97bf-86d3772ef381",
                                "sense_id": "2255cf39-9634-3c18-b6ad-b8bfd8933be0",
                                "text": "„Shaw hatte den Fernseher eingeschaltet und einen Lokalsender gewählt.“"
                            },
                            {
                                "example_id": "33ac63f9-f1f2-4ef1-a56f-6c0857400f8c",
                                "sense_id": "2255cf39-9634-3c18-b6ad-b8bfd8933be0",
                                "text": "„Irgendwie war die Information zu der Fernsehreporterin eines Lokalsenders von CBS durchgesickert.“"
                            },
                            {
                                "example_id": "64278bbb-4754-4a66-bd9e-4fc26b072997",
                                "sense_id": "2255cf39-9634-3c18-b6ad-b8bfd8933be0",
                                "text": "„Zeit für die Mittagsnachrichten, also zappte er durch die Kanäle, bis er einen Lokalsender fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
