                "senses": [
                    {
                        "sense_id": "697fee4a-edf2-31df-9273-7e2e6795a6b9",
                        "entry_id": "a4df752c-10da-3d72-ae56-c89e5f9d74e5",
                        "glosses": [
                            "aus dem Edelmetall Gold hergestellte Währung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca822e2c-d7de-40b5-9eed-864aec46b9ca",
                                "sense_id": "697fee4a-edf2-31df-9273-7e2e6795a6b9",
                                "text": "„Mit seiner Goldwährung stand Großbritannien bis in die 1870er Jahre in Europa einzigartig da.“"
                            },
                            {
                                "example_id": "c35b5f79-d341-4a2d-b137-de1c6e831ab6",
                                "sense_id": "697fee4a-edf2-31df-9273-7e2e6795a6b9",
                                "text": "„In der Geldpolitik gelang es, durch die Einführung des Solidus eine nach Gewicht und Metallgehalt im gesamten Reich anerkannte, einheitliche Goldwährung zu schaffen, womit ein hohes Maß an Stabilität gewonnen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
