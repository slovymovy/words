                    },
                    {
                        "translation_id": "e69f7601-b645-43c7-9d9e-2cfac253e383",
                        "source_entry_id": "33263935-a83c-36db-83be-7f9bd467df51",
                        "source_sense_id": "d1fc1f5d-aa86-3c83-a77b-fa8d90a4a133",
                        "target_lang_word": "decrepit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decrepit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                        "entry_id": "7b0d6540-03c0-3b7d-8065-e7a2ad7cfcbe",
                                        "glosses": [
                                            "Weakened or worn out from age or wear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29a45e1c-7eff-4dfe-9f7a-443a7923a5db",
                                                "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                                "text": "Sorrow is subdued by strong necessity; there is no cause why life should be lengthened for our love; and we feel that the worn and the decrepit do but go down into that grave which had received youth, health, beauty,—all that made existence precious—long before."
                                            },
                                            {
                                                "example_id": "fa04d94b-2d26-4096-a49d-71afc5a2e6c0",
                                                "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                                "text": "Two entrants shared this award for their work on two quite different stations, but with the same purpose of bringing a redundant station building back into use for the benefit of the community, with the added result of conserving an historic building. Saltash Town Council bought Saltash station building after it had become very decrepit and 'an eyesore' - such that it was nearly pulled down to make way for housing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aed93243-bb04-4242-b8bb-d03654e3c619",
                        "source_entry_id": "33263935-a83c-36db-83be-7f9bd467df51",
                        "source_sense_id": "d1fc1f5d-aa86-3c83-a77b-fa8d90a4a133",
                        "target_lang_word": "dilapidated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilapidated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f112e05e-fdec-37c1-a8c0-24b7fec054ac",
                                        "entry_id": "96c4280a-26f4-3238-a332-4bc434b6823f",
                                        "glosses": [
                                            "simple past and past participle of dilapidate"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dilapidated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8078362-defe-3148-b987-6b304f53e998",
                                        "entry_id": "e804b558-cd3a-331b-90e8-4a46a5adb097",
                                        "glosses": [
                                            "Having fallen into a state of disrepair or deterioration, especially through neglect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9f45788-011e-4f4f-b9ca-936a2f4542ec",
                                                "sense_id": "c8078362-defe-3148-b987-6b304f53e998",
                                                "text": "Their stately offices—their pleasant gardens—the magnificent cloisters constructed for their recreation, were all dilapidated and ruinous; […]"
                                            },
                                            {
                                                "example_id": "342e6cb9-ef4b-4cd7-9e95-7b5a04fe5dd9",
                                                "sense_id": "c8078362-defe-3148-b987-6b304f53e998",
                                                "text": "It was a strange scene, the contrasts which met in that large but dilapidated chamber. It had been the banqueting-hall in the ancient palace of the La Franchi, but the revelry and the splendour had long since passed away."
                                            },
                                            {
                                                "example_id": "926f1379-b71a-41e5-adbf-4c684d202541",
                                                "sense_id": "c8078362-defe-3148-b987-6b304f53e998",
                                                "text": "The Glenbrook Community Center is in disrepair and has been closed for a number of years, which means it is the exact kind of dilapidated and blighted building CAVE People will do everything to protect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae4c828-34e2-440a-bfa2-18dbbaaa584e",
                        "source_entry_id": "33263935-a83c-36db-83be-7f9bd467df51",
                        "source_sense_id": "d1fc1f5d-aa86-3c83-a77b-fa8d90a4a133",
                        "target_lang_word": "lapsed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapsed",
