            {
                "entry_id": "faaf70ae-d184-3276-8eba-7556e2d69096",
                "word": "beaut",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dac264c8-9d17-4cd0-9cde-7d32f6025d84",
                        "entry_id": "faaf70ae-d184-3276-8eba-7556e2d69096",
                        "tags": [
                            "comparative"
                        ],
                        "form": "beauter"
                    },
                    {
                        "form_id": "eeb64af8-d071-4e1f-ae40-076dd99a2060",
                        "entry_id": "faaf70ae-d184-3276-8eba-7556e2d69096",
                        "tags": [
                            "superlative"
                        ],
                        "form": "beautest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c9422fd-3618-3ed3-81c2-1622f26a233c",
                        "entry_id": "faaf70ae-d184-3276-8eba-7556e2d69096",
                        "glosses": [
                            "Beautiful, splendid."
                        ],
                        "tags": [
                            "Australia",
                            "especially",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2c14a01f-7cd7-43b6-ad2e-e2131f37a9e2",
                                "sense_id": "8c9422fd-3618-3ed3-81c2-1622f26a233c",
                                "text": "An' there was posies all round Jim, He had a bran new suit, The first un that he ever had, An' everything was beaut. An' when the preacher told 'bout Jim— How ' twas he got the swipe— I saw most all them dandy swells A feelin' fer a wipe."
                            },
                            {
                                "example_id": "ca116bee-f7d7-4a13-bae3-607f3cf0c9a3",
                                "sense_id": "8c9422fd-3618-3ed3-81c2-1622f26a233c",
                                "text": "It was beaut to have him home again, and gee, you should have seen the bike he bought me from Paris. From the same factory as his own was made."
                            },
                            {
                                "example_id": "3b85402c-05a2-43a0-a1fc-d2acd88ada5b",
                                "sense_id": "8c9422fd-3618-3ed3-81c2-1622f26a233c",
                                "text": "She was very motherly towards me then and it was beaut. Before I was eighteen, there just wasn't any kind words. All I wanted to do was get away from there."
                            },
                            {
                                "example_id": "a77bb723-3404-49d6-aa0a-c5c1fc617e55",
                                "sense_id": "8c9422fd-3618-3ed3-81c2-1622f26a233c",
                                "text": "Yes, it was beaut."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "526172ed-e004-3e76-9529-bd9bc8b659c8",
                "word": "beaut",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b0992af2-aaa1-4567-a0d8-03ededd57ec6",
                        "entry_id": "526172ed-e004-3e76-9529-bd9bc8b659c8",
                        "tags": [
