                "translations": [
                    {
                        "translation_id": "4eb8a707-d378-40a6-8da8-910c5892d9ec",
                        "source_entry_id": "87fa3017-15eb-36be-882d-e5b09c41c973",
                        "source_sense_description": "process of modifying a person's behaviour",
                        "target_lang_word": "conditionering",
