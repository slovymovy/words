                "senses": [
                    {
                        "sense_id": "b40c63e7-593e-39a5-91ee-d957f823d75b",
                        "entry_id": "ad590c70-4be0-34ef-b8fd-45cee1aa0a79",
                        "glosses": [
                            "Los, das für die Teilnahme an einer Lotterie erworben werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e08e8d6-6d85-4775-b74c-bee08bcf3d01",
                                "sense_id": "b40c63e7-593e-39a5-91ee-d957f823d75b",
                                "text": "„Ein paar Wochen lang verkauften Straßenhändler zwischen Kaugummis, Lotterielosen und Zigaretten Schlüsselanhänger mit dem Bild des Fußballspielers.“"
                            },
                            {
                                "example_id": "ed7ce6e2-d8e9-4d14-badf-9fe0644725b7",
                                "sense_id": "b40c63e7-593e-39a5-91ee-d957f823d75b",
                                "text": "„Die Auflage umfasst 2300 Kalender, die zum Preis von je 5 Euro verkauft werden. Der Kalender ist das Lotterielos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
