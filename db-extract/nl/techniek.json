                "senses": [
                    {
                        "sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "glosses": [
                            "de bewerkingen en verrichtingen die nodig zijn om iets tot stand te brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe790f3e-29d9-4fec-b693-8d38d366e9d2",
                                "sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                                "text": "Wordt er in uw beroep vaak gebruik gemaakt van technieken?"
                            },
                            {
                                "example_id": "73840385-0b1a-4d49-bd24-510fe6dd84cc",
                                "sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                                "text": "Normaal gesproken was dat geen enkel probleem geweest, ze gebruikten een eenvoudige en beproefde techniek met platen en bouten voor de samenvoeging."
                            }
                        ]
                    },
                    {
                        "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "glosses": [
                            "de bewerkingen en verrichtingen die horen bij de industrie en de exacte wetenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d630994-c25f-4546-9cae-2725d48188cf",
                                "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                                "text": "Er is een speciale techniek voor reanimatie."
                            },
                            {
                                "example_id": "3ad0df1f-9d57-4abe-a2c8-491614502efd",
                                "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                                "text": "En met de Duitse organisatie en techniek kon er de hoognodige orde komen in het Franse gekkenhuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb12ca0-b5f7-33cc-ac2b-3942275efb4e",
                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "glosses": [
                            "de manier waarop dingen zijn verricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f87d1c4-3b07-49e7-b9a6-fd893039ed83",
                                "sense_id": "9cb12ca0-b5f7-33cc-ac2b-3942275efb4e",
                                "text": "Hier worden echt speciale technieken gebruikt..."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "glosses": [
                            "technische hulpmiddelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079524aa-21f4-4428-b29d-e9c73c9ac750",
                                "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                                "text": "Het gehele proces is overgenomen door de techniek."
                            },
                            {
                                "example_id": "bb536c7c-e8db-4eff-8ba4-58b11abeb4ec",
                                "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                                "text": "Het was gek om mijn gezondheid helemaal in handen van deze wonderlijke techniek te leggen, maar het leek mij de meest efficiënte optie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "964efa00-6932-44df-91ad-90efcf643262",
                        "source_entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "source_sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                        "source_sense_description": "De bewerkingen en verrichtingen die nodig zijn om iets tot stand te brengen",
                        "target_lang_word": "technique",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technique",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9fd03b-c856-3db7-8033-23f4e3bf069e",
                                        "entry_id": "a442f22f-a6da-3025-a829-934b459f687d",
                                        "glosses": [
                                            "The practical aspects of a given art, occupation etc.; formal requirements."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd20d436-e695-4a49-be68-b69247fd8498",
                                                "sense_id": "eb9fd03b-c856-3db7-8033-23f4e3bf069e",
                                                "text": "Brahms, after realizing that the technique of the piano was developing along mistaken lines, and his own danger of stereotyping his style, keeps away from it for most of his middle age [...]."
                                            },
                                            {
                                                "example_id": "c39ac407-dfcd-440f-86d3-80091f870579",
                                                "sense_id": "eb9fd03b-c856-3db7-8033-23f4e3bf069e",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. That’s because the lenses that are excellent at magnifying tiny subjects produce a narrow depth of field. A photo processing technique called focus stacking has changed that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dbefa4-a35c-35e1-a332-acc1b4a3ada0",
                                        "entry_id": "a442f22f-a6da-3025-a829-934b459f687d",
                                        "glosses": [
                                            "Practical ability in some given field or practice, often as opposed to creativity or imaginative skill."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb5353ab-148c-48bd-9ae3-dc7f76faa087",
                                                "sense_id": "e1dbefa4-a35c-35e1-a332-acc1b4a3ada0",
                                                "text": "Yet those who packed concert halls to listen to him sing, as Indians did for over six decades, rarely mentioned his technique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07d576f-3269-3dea-b14d-c2f908c8c171",
                                        "entry_id": "a442f22f-a6da-3025-a829-934b459f687d",
                                        "glosses": [
                                            "A method of achieving something or carrying something out, especially one requiring some skill or knowledge."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac830681-6b47-4a1e-9a52-fef22f91681c",
                                                "sense_id": "d07d576f-3269-3dea-b14d-c2f908c8c171",
                                                "text": "They said executives were warned about one technique nicknamed \"carpet karaoke\", which involved bending deportees over in aircraft seats to silence them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77304e7b-1ab3-4300-ad2b-0f845a4316ee",
                        "source_entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                        "source_sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                        "source_sense_description": "De bewerkingen en verrichtingen die nodig zijn om iets tot stand te brengen",
                        "target_lang_word": "technique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
