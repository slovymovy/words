            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9af8fb92-7814-3bc1-8eec-e7aea93366bc",
                    "sense_definition": "Devenir plus étroit ou diminuer de taille.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution_taille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention à la température car ce pull risque de <w>rétrécir</w> au lavage.",
                            "target_lang_translations": {
                                "en": "Be careful with the temperature, as this sweater may <w>shrink</w> in the wash.",
                                "ru": "Следи за температурой: этот свитер может <w>сесть</w> при стирке.",
                                "de": "Achte auf die Temperatur, denn dieser Pullover könnte beim Waschen <w>einlaufen</w>.",
                                "es": "Ten cuidado con la temperatura, porque este jersey podría <w>encoger</w> al lavarlo.",
                                "zh": "要注意水温，这件毛衣洗的时候可能会<w>缩水</w>。"
                            }
                        },
                        {
                            "text": "La route commence à <w>rétrécir</w> à l'approche du vieux pont.",
                            "target_lang_translations": {
                                "en": "The road begins to <w>narrow</w> as it nears the old bridge.",
                                "ru": "Дорога начинает <w>сужаться</w> при приближении к старому мосту.",
                                "de": "Bei Annäherung an die alte Brücke beginnt die Straße, sich zu <w>verengen</w>.",
                                "es": "La carretera empieza a <w>estrecharse</w> según se acerca al viejo puente.",
                                "zh": "临近那座老桥时，道路开始<w>变窄</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diminuer"
                    ],
                    "antonyms": [
                        "s'élargir"
                    ],
                    "common_phrases": [
                        "rétrécir au lavage"
                    ],
                    "target_lang_definitions": {
                        "en": "To become narrower or smaller in size.",
                        "ru": "Становиться уже или меньше по размеру.",
                        "de": "Schmaler oder kleiner werden.",
                        "es": "Hacerse más estrecho o disminuir de tamaño.",
                        "zh": "变得更窄，或体积、尺寸变小。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "clothing or fabric becoming smaller"
                            },
                            {
                                "target_lang_word": "narrow",
                                "target_lang_sense_clarification": "roads becoming less wide"
                            }
                        ],
                        "ru": [
