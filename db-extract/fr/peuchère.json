                        "entry_id": "6e40a394-80e7-3d24-b583-a53ae7f399da",
                        "glosses": [
                            "Expression provençale et languedocienne utilisée pour marquer la compassion, la pitié, parfois la commisération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a471bbe4-c168-4b0b-9b80-629c1d40443d",
                                "sense_id": "c2d99efa-8844-3fef-bd50-a962faadf8a1",
                                "text": "Un beau soir, on entendit une sorte de coup de canon. C’était la moitié de la stalactite, peuchère, qui venait de s’effondrer sur le macadam de la terrasse !"
                            },
                            {
                                "example_id": "f91c8603-e383-4739-b46d-6730305d19cf",
                                "sense_id": "c2d99efa-8844-3fef-bd50-a962faadf8a1",
                                "text": "Peuchère Pétugue ! Peuchère Pétugue ! Lili, va vite le chercher ! Peuchère Pétugue !"
                            },
                            {
                                "example_id": "8ae85971-e4f5-4ff2-ac0a-b87433bfdb42",
                                "sense_id": "c2d99efa-8844-3fef-bd50-a962faadf8a1",
                                "text": "À l’heure de l’œuvre de chair,\nElle est souvent triste, peuchère !"
                            }
                        ]
                    }
