                                    },
                                    {
                                        "sense_id": "26b51ce0-bb5e-32c4-8f2a-5a040e1fa9a1",
                                        "entry_id": "3aa6d38d-6274-3b3e-b905-576447fd2836",
                                        "glosses": [
                                            "With affectation of grandness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c64a70f-d27a-4ae1-a845-9d8cd66ddbae",
                                                "sense_id": "26b51ce0-bb5e-32c4-8f2a-5a040e1fa9a1",
                                                "text": "\"Can you play the violin?\" asked Rosemary loftily, out of a chumbling refined mouth."
                                            },
                                            {
                                                "example_id": "d9e3cdd8-fd2d-4818-9e31-8e4e27b6610b",
                                                "sense_id": "26b51ce0-bb5e-32c4-8f2a-5a040e1fa9a1",
                                                "text": "\"I should never dream of calling a kid like you a woman,\" said Digory loftily."
                                            }
                                        ]
                                    }
                                ]
