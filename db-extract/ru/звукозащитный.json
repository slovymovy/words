                        "examples": [
                            {
                                "example_id": "f54ed35c-8cd5-4026-84e3-57f4cceff400",
                                "sense_id": "cf0193be-cd67-372a-903d-6e04fadaa531",
                                "text": "Если по той или иной причине человек вынужден находиться в зоне весьма интенсивного шума, он должен по меньшей мере надеть звукозащитный шлем, а не ограничиваться ушными протекторами."
                            }
                        ]
