    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2e46d0a-7a3e-37c4-9239-bcc7aec78286",
                    "sense_definition": "Strongly emotionally attached or very fond of someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "loving_loyal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>devoted</w> mother who always puts her children's needs first.",
                            "target_lang_translations": {
                                "ru": "Она <w>преданная</w> мать, которая всегда ставит потребности своих детей на первое место.",
                                "nl": "Ze is een <w>toegewijde</w> moeder die de behoeften van haar kinderen altijd op de eerste plaats zet."
                            }
                        },
                        {
                            "text": "He remained a <w>devoted</w> friend throughout all their years of hardship.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>верным</w> другом на протяжении всех их трудных лет.",
                                "nl": "Hij bleef al die moeilijke jaren een <w>trouwe</w> vriend."
                            }
                        }
                    ],
                    "synonyms": [
                        "loyal",
                        "faithful",
                        "loving",
                        "affectionate"
                    ],
                    "antonyms": [
                        "disloyal",
                        "unfaithful",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "devoted husband",
                        "devoted friend",
                        "devoted to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно эмоционально привязанный к кому-либо или чему-либо; очень любящий.",
                        "nl": "Sterk emotioneel gehecht aan of zeer gesteld op iemand of iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "верный, лояльный"
                            },
