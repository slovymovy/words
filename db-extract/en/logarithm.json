                                        "entry_id": "32f9bcef-5560-394b-96ee-8d66cfe35e15",
                                        "glosses": [
                                            "de exponent van de macht waartoe een gegeven getal verheven moet worden om een ander getal te krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387cdc74-ad7d-4552-9b0f-1e8282679568",
                                                "sense_id": "44dc3b71-1a8b-3967-bd59-9b1bed21c714",
                                                "text": "²log(8) = 3 is de logaritme met grondtal 2 van 8, want 2³ = 8."
                                            }
                                        ]
