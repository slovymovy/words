                "forms": [
                    {
                        "form_id": "5e3ea1ec-57e5-4058-be12-d2938770da5d",
                        "entry_id": "f38c5a1c-0d44-363a-809a-c812d2f6195a",
                        "tags": [
                            "plural"
                        ],
                        "form": "helices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74ac255e-e82c-3d39-a3e3-9f96297d8634",
                        "entry_id": "f38c5a1c-0d44-363a-809a-c812d2f6195a",
                        "glosses": [
                            "spiraal met cirkelvormige windingen en constante spoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e75b7e-ea3e-4293-b090-023884dfc0a7",
                                "sense_id": "74ac255e-e82c-3d39-a3e3-9f96297d8634",
                                "text": "De attractie wordt tachtig meter hoog en krijgt een lengte van zo'n 1.600 meter. De sensationele rollercoaster zal tenminste 1 helix (een schuin gezette bocht die met een lichte hellingshoek naar beneden of boven loopt), 5 camelbacks, een tunnel en verschillende watereffecten bevatten."
                            },
                            {
                                "example_id": "f0fcb340-04d0-4737-a507-0d9900cfa567",
                                "sense_id": "74ac255e-e82c-3d39-a3e3-9f96297d8634",
                                "text": "De Britten denken vooral de deling van kankercellen te kunnen stoppen door zich specifiek op het v[i]erstrengs-dna te richten. Zo wordt niet het hele dna aangevallen en de normale celdeling gestopt. In het onderzoek lukt het ze ook om met behulp van een remmer de concentratie van de vierdubbele helix terug te dringen."
                            },
                            {
                                "example_id": "f2b30b41-591d-4d82-ba41-cbb3145e1a38",
                                "sense_id": "74ac255e-e82c-3d39-a3e3-9f96297d8634",
                                "text": "De bioloog schreef de brief in 1953 aan zijn twaalf jaar oude zoon Michael, enkele dagen voor hij zijn ontdekking van het erfelijk materiaal wereldkundig maakte. Crick kreeg voor deze ontdekking in 1962 de Nobelprijs. In de brief schetst de wetenschapper de nu wereldberoemde dubbele helix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a184ab8-c10b-4f0f-8e3e-73c04f0b4a8b",
                        "source_entry_id": "f38c5a1c-0d44-363a-809a-c812d2f6195a",
                        "source_sense_id": "74ac255e-e82c-3d39-a3e3-9f96297d8634",
                        "target_lang_word": "spiral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85e00c9b-e8e3-316b-a9d4-ccfcd1a61cbe",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A curve that is the locus of a point that rotates about a fixed point while continuously increasing its distance from that point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a41c5d32-97fe-3470-94e1-f4ed0844b2f4",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A helix."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d25c56d-09f8-3989-8b0d-3d442ba0eabc",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A self-sustaining process with a lot of momentum involved, so it is difficult to accelerate or stop it at once."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd0d7a2-f07e-4ed8-8565-cf36cfd1aa02",
                                                "sense_id": "2d25c56d-09f8-3989-8b0d-3d442ba0eabc",
                                                "text": "My beloved friends and family who sustained and grounded me as I fell into the rabbit hole of this project or down the spiral of new parenthood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f28ae8-e321-3cf0-84a8-f954e50ee269",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A section of track that forms a circle and crosses over itself, used for gaining height in mountainous territory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685a4c3b-c804-3393-a9c4-ce00e762d2f3",
                                        "entry_id": "76d2438d-1895-3a04-94c1-dced68083951",
                                        "glosses": [
                                            "Helical, like a spiral."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532ef3c7-6b0c-4dcb-9248-5d824bbe2e04",
                                                "sense_id": "685a4c3b-c804-3393-a9c4-ce00e762d2f3",
                                                "text": "The formation of tornados and water-spouts is very probably identical with that of dust-storms and \"devils,\" viz., a sudden disturbance of the vertical equilibrium of the atmosphere, where by an upward rush of air is generated, which rapidly becomes spiral."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d29d377-39d3-35cf-83a4-afa2f2e541d2",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To move along the path of a spiral or helix."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7837f11-0fca-4b6c-900a-a6290288ec49",
                                                "sense_id": "2d29d377-39d3-35cf-83a4-afa2f2e541d2",
                                                "text": "The falling leaves spiralled down from the tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefa05ff-ec7e-372f-8bfd-d089b8ccf8db",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To cause something to spiral."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8378777e-bf63-49ee-97c1-ac5927cc47f0",
                                                "sense_id": "eefa05ff-ec7e-372f-8bfd-d089b8ccf8db",
                                                "text": "You need to learn how to spiral a ball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c39db768-7f97-3bbb-8466-55e15eb25deb",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To increase continually."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15344684-e2ef-4a14-8d26-15e5672fbdf3",
                                                "sense_id": "c39db768-7f97-3bbb-8466-55e15eb25deb",
                                                "text": "Her debts were spiralling out of control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
