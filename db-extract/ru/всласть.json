                                                "example_id": "0386fad8-ba48-40ee-9d6b-cd6acf909dc6",
                                                "sense_id": "b5036aeb-4075-3f5f-a806-89d191edbb1a",
                                                "text": "Du kommst aber reichlich spät!"
