                    {
                        "translation_id": "11865c87-1f80-4928-9a93-5c738c2599e0",
                        "source_entry_id": "6bc7c112-28f1-33be-aca0-81efe24aa159",
                        "source_sense_id": "694de4e5-6889-34f5-ad78-d8ffce596d47",
