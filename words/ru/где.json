{
    "word_family": [
        "где-то",
        "где-либо",
        "где-нибудь",
        "кое-где",
        "нигде",
        "негде"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58132e8b-7201-37a1-9a0a-af8dfa0e603b",
                    "sense_definition": "Вопросительное наречие, используемое для выяснения местонахождения кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location_query",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, пожалуйста, <w>где</w> находится ближайшая станция метро?",
                            "target_lang_translations": {
                                "en": "Could you please tell me <w>where</w> the nearest metro station is?",
                                "zh": "请问，最近的地铁站在<w>哪里</w>？"
                            }
                        },
                        {
                            "text": "<w>Где</w> ты был вчера вечером, когда я тебе звонил?",
                            "target_lang_translations": {
                                "en": "<w>Where</w> were you last night when I called you?",
                                "zh": "我昨天晚上给你打电话时，你<w>在哪儿</w>？"
                            }
                        }
                    ],
                    "synonyms": [
                        "в каком месте"
                    ],
                    "antonyms": [
                        "нигде"
                    ],
                    "common_phrases": [
                        "где это",
                        "где ты",
                        "где находится"
                    ],
                    "target_lang_definitions": {
                        "en": "Interrogative adverb used to ask about the location of someone or something.",
                        "zh": "用于询问某人或某物所在位置的疑问副词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "where",
                                "target_lang_sense_clarification": "interrogative adverb"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪里",
                                "target_lang_sense_clarification": "疑问副词"
                            },
                            {
                                "target_lang_word": "哪儿",
                                "target_lang_sense_clarification": "疑问副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d7a7640-fd4d-3d7b-b093-e8dfeb95d57e",
                    "sense_definition": "Употребляется в значении «где-нибудь» или «где-либо» для обозначения неопределённого места.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Посмотри, не лежит ли <w>где</w> на столе моя синяя ручка.",
                            "target_lang_translations": {
                                "en": "Look and see if my blue pen is lying <w>somewhere</w> on the table.",
                                "zh": "你看看桌子上<w>某处</w>有没有放着我的蓝色圆珠笔。"
                            }
                        },
                        {
                            "text": "Если встретишь его <w>где</w> в городе, передай ему привет.",
                            "target_lang_translations": {
                                "en": "If you meet him <w>anywhere</w> in the city, say hello to him.",
                                "zh": "如果你在城里<w>任何地方</w>遇见他，替我向他问好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "где-нибудь",
                        "где-либо"
                    ],
                    "common_phrases": [
                        "видел ли где",
                        "слышал ли где"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in the sense of \"somewhere\" or \"anywhere\" to indicate an indefinite place.",
                        "zh": "用于表示不确定的地点，意为“某处”或“任何地方”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "somewhere",
                                "target_lang_sense_clarification": "indefinite location"
                            },
                            {
                                "target_lang_word": "anywhere",
                                "target_lang_sense_clarification": "in questions or negative contexts"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "某处",
                                "target_lang_sense_clarification": "不确定地点"
                            },
                            {
                                "target_lang_word": "任何地方",
                                "target_lang_sense_clarification": "用于疑问或否定语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77a2485d-c77a-30e3-9358-36b85f4d53e6",
                    "sense_definition": "Частица, выражающая сомнение, невозможность или усиленное отрицание (обычно в сочетаниях «где уж», «где там»).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Где</w> уж мне понять такие сложные научные теории!",
                            "target_lang_translations": {
                                "en": "<w>How</w> could I possibly understand such complex scientific theories!",
                                "zh": "<w>哪</w>是我能理解得了这么复杂的科学理论的！"
                            }
                        },
                        {
                            "text": "Он обещал прийти вовремя, но <w>где</w> там, опять опоздал на час.",
                            "target_lang_translations": {
                                "en": "He promised to come on time, but <w>no way</w>, he was late by an hour again.",
                                "zh": "他答应准时来，可<w>哪有</w>啊，又迟到了一个小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "где уж там",
                        "где уж мне",
                        "где там"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Particle expressing doubt, impossibility, or emphatic negation (usually in phrases like \"how could\", \"no way\").",
                        "zh": "表示怀疑、不可能或强调否定的语气词（通常用于“怎么可能”、“哪有”等短语中）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "rhetorical, implying impossibility"
                            },
                            {
                                "target_lang_word": "no way",
                                "target_lang_sense_clarification": "colloquial emphatic negation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪",
                                "target_lang_sense_clarification": "反问语气，暗示不可能"
                            },
                            {
                                "target_lang_word": "哪有",
                                "target_lang_sense_clarification": "口语中强调否定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66120776-d462-3986-aded-28cc878e3e8d",
                    "sense_definition": "Используется в повторяющихся конструкциях для указания на то, что в разных местах происходит разное (в значении «в одном месте..., в другом...»).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distributive_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поляна была пёстрой: <w>где</w> цвели ромашки, <w>где</w> виднелись колокольчики.",
                            "target_lang_translations": {
                                "en": "The meadow was colorful: <w>here</w> daisies bloomed, <w>there</w> bluebells appeared.",
                                "zh": "草地五彩斑斓：<w>有的地方</w>开着雏菊，有的地方点缀着风铃草。"
                            }
                        },
                        {
                            "text": "Дорога была плохой, <w>где</w> ямы, <w>где</w> грязь, а <w>где</w> и вовсе лужи.",
                            "target_lang_translations": {
                                "en": "The road was bad: <w>here</w> potholes, <w>there</w> mud, and <w>somewhere</w> even puddles.",
                                "zh": "路况很差，<w>有的地方</w>是坑洞，有的地方是泥泞，甚至还有积水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "где густо где пусто"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in repeating constructions to indicate that different things happen in different places (meaning \"here..., there...\").",
                        "zh": "用于重复结构中，表示不同地点发生不同的事（意为“有的地方……，有的地方……”）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here",
                                "target_lang_sense_clarification": "distributive construction"
                            },
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "distributive construction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有的地方",
                                "target_lang_sense_clarification": "分布结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "2e5f7148-26cd-3d6c-9eec-9da092e49968",
                    "sense_definition": "Союзное слово, которое связывает придаточное предложение места с главным, указывая на место совершения действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relative_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили пообедать в том ресторане, <w>где</w> готовят вкусную пиццу.",
                            "target_lang_translations": {
                                "en": "We decided to have lunch at that restaurant <w>where</w> they make delicious pizza.",
                                "zh": "我们决定去那家做披萨很好吃的餐厅<w>哪里</w>吃午饭。"
                            }
                        },
                        {
                            "text": "Я совершенно не помню, <w>где</w> мы оставили машину на парковке.",
                            "target_lang_translations": {
                                "en": "I don't remember at all <w>where</w> we left the car in the parking lot.",
                                "zh": "我完全不记得我们把车停在停车场的<w>哪儿</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "там где",
                        "туда где",
                        "знаю где"
                    ],
                    "target_lang_definitions": {
                        "en": "Relative word connecting a subordinate clause of place to the main clause.",
                        "zh": "连接地点状语从句与主句的连接词，指明动作发生的地点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "where",
                                "target_lang_sense_clarification": "relative conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪里",
                                "target_lang_sense_clarification": "关系连接词"
                            },
                            {
                                "target_lang_word": "哪儿",
                                "target_lang_sense_clarification": "关系连接词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}