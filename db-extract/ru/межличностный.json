                ],
                "senses": [
                    {
                        "sense_id": "bba93771-aec3-384c-a82d-5393b2442c6c",
                        "entry_id": "69c5c5d9-9d11-38dc-8ac0-67195df7bfea",
                        "glosses": [
                            "существующий, происходящий между отдельными личностями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667cadcf-4883-4742-af0b-7272bb8b3b0b",
                                "sense_id": "bba93771-aec3-384c-a82d-5393b2442c6c",
                                "text": "Повышенная сенситивность к элементам межличностного общения приводит к тому, что индивид легко раздражается при любых социальных контактах, представляющих хоть малейшую угрозу для его личности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8404a009-c472-4dc6-8ffe-15cc0a5ea0d3",
                        "source_entry_id": "69c5c5d9-9d11-38dc-8ac0-67195df7bfea",
                        "source_sense_id": "bba93771-aec3-384c-a82d-5393b2442c6c",
                        "target_lang_word": "zwischenmenschlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwischenmenschlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e57e1a-3307-3d22-8b80-491ab0e55261",
                                        "entry_id": "c9dbdb77-92a4-3575-87b1-0beddd535f51",
                                        "glosses": [
                                            "das Verhältnis zwischen zwei Personen betreffend, zwischen zwei Personen bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2ce1fd-36ff-4438-9d5b-19dbfcf39fa4",
                                                "sense_id": "a1e57e1a-3307-3d22-8b80-491ab0e55261",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
