                "translations": [
                    {
                        "translation_id": "048e1447-fa58-416f-bf1c-220cd776fff0",
                        "source_entry_id": "37206211-985d-30b0-8b4c-8b1bdf390435",
                        "source_sense_id": "11c6c3f1-62fd-368b-9a71-871c18068959",
                        "target_lang_word": "Becher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Becher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                        "entry_id": "934a7928-9373-3799-b8a5-610e06d5684b",
                                        "glosses": [
                                            "Gefäß, mit oder aber oft ohne Henkel, zum Verwahren von Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bf4845f-e7cf-4b27-beb4-70750f25583f",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "Er goss ein wenig Wasser in den Becher."
                                            },
                                            {
                                                "example_id": "0a3d0c40-f38c-49b6-824a-537ce34412b0",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "Ich trinke Tee lieber aus dem Becher als aus der Tasse."
                                            },
                                            {
                                                "example_id": "d2041697-57e3-46d0-b413-c81e5de8720b",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "Könnten Sie mir bitte einen der Becher da rüberreichen, danke."
                                            },
                                            {
                                                "example_id": "1fadb352-a776-42c9-acd9-b27a58424e1d",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "\"Im alten Ägypten galten Becher als Symbol der Nahrung, die Leib und Seele erhält.\""
                                            },
                                            {
                                                "example_id": "3abd295d-82c2-44b1-92b6-72211086aab6",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "„Verwundert schaut dieser nach unten, als er den Becher umstößt und ein wenig Kleingeld herausfällt.“"
                                            },
                                            {
                                                "example_id": "5a70f877-ff93-4ae7-a7af-732549996c08",
                                                "sense_id": "b73e597d-6e7d-3f0e-9cad-2152dbf020cf",
                                                "text": "„Wie auch immer, Schoppen und Becher wurden wieder gefüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d5ae761-8c5d-3dcc-a34d-feb87fe31604",
                                        "entry_id": "934a7928-9373-3799-b8a5-610e06d5684b",
                                        "glosses": [
                                            "ein Sternbild südlich des Himmelsäquators"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77eb3197-70c0-497f-be6d-1e65177c9e52",
                                                "sense_id": "6d5ae761-8c5d-3dcc-a34d-feb87fe31604",
                                                "text": "„Im Sternbild Becher beobachtet Wilhelm Herschel die Galaxien NGC 3511 und NGC 3513 sowie im Sternbild Fische die Galaxie NGC 193.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Becher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1213ea9-3f54-3b4e-a502-fffe8cd0e093",
                                        "entry_id": "bb8fea2b-ec9d-312a-bfde-980d4394bbca",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7a071e-c05e-4115-9ef6-92cfdece854b",
                                                "sense_id": "f1213ea9-3f54-3b4e-a502-fffe8cd0e093",
                                                "text": "Herr Dr. Becher arbeitet in der Radiologie."
                                            },
                                            {
                                                "example_id": "25bca2ab-5043-46a9-bb6c-91294d1f5c12",
                                                "sense_id": "f1213ea9-3f54-3b4e-a502-fffe8cd0e093",
                                                "text": "Frau Becher bekommt demnächst eine Gehaltserhöhung."
                                            },
                                            {
                                                "example_id": "d5d3e2af-4ad6-4a12-9f0f-47b6bcc9282c",
                                                "sense_id": "f1213ea9-3f54-3b4e-a502-fffe8cd0e093",
                                                "text": "Bei den Bechers ist der Vorgarten grüner als bei den Weißkopfs."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
