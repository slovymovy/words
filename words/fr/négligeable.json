                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tirer au hasard un nombre rationnel entre zéro et un est un événement <w>négligeable</w>."
                        },
                        {
                            "text": "L'obtention d'une suite infinie de zéros constitue un événement <w>négligeable</w>."
