                            {
                                "target_lang_word": "极大的",
                                "target_lang_sense_clarification": "形容强度非常高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e061f8fd-0feb-3ed9-932b-084ee90265dc",
                    "sense_definition": "Causing terror or great fear; terrifying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dragon let out a <w>terrific</w> roar that shook the ground.",
                            "target_lang_translations": {
                                "ru": "Дракон издал <w>ужасающий</w> рев, от которого содрогнулась земля.",
                                "zh": "巨龙发出了一声<w>可怕</w>的咆哮，震得大地都在颤抖。"
                            }
                        },
                        {
                            "text": "The storm was <w>terrific</w> to behold, with lightning striking every few seconds.",
                            "target_lang_translations": {
                                "ru": "Шторм был <w>страшен</w> на вид: молнии сверкали каждые несколько секунд.",
                                "zh": "那场风暴看起来<w>惊人</w>，每隔几秒钟就有闪电劈下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrifying",
                        "frightening",
                        "horrific",
                        "dreadful",
                        "ghastly"
                    ],
                    "antonyms": [
                        "comforting",
                        "soothing"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Original meaning, now mostly found in literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий ужас или сильный страх; ужасающий.",
                        "zh": "引起恐惧或极度害怕的；可怕的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасающий",
                                "target_lang_sense_clarification": "внушающий ужас"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "вызывающий чувство страха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可怕的",
                                "target_lang_sense_clarification": "令人感到恐惧的"
                            },
                            {
                                "target_lang_word": "惊人的",
