                "senses": [
                    {
                        "sense_id": "813b7e44-fbf8-3dd5-9ed0-050a699f27f6",
                        "entry_id": "5e5d0c53-ed77-36a6-9faf-4ea2833f8f84",
                        "glosses": [
                            "kleiner bis mittelgroßer Stöberhund mit breiter Schnauze, langem, gewelltem Fell und langen Ohren, die an der Seite des Kopfes hängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019a35cc-8400-4820-a41d-8f9914cf37d3",
                                "sense_id": "813b7e44-fbf8-3dd5-9ed0-050a699f27f6",
                                "text": "„Sie wurden über Einzelheiten des makellosen Privatlebens etlicher Romanschriftstellerinnen informiert und konnten sie mit ihren Spaniels vor rosenumrankten Landhäusern sitzend bewundern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41b6b8b5-db1b-4866-aed9-fe3c6569ce5c",
                        "source_entry_id": "5e5d0c53-ed77-36a6-9faf-4ea2833f8f84",
                        "source_sense_id": "813b7e44-fbf8-3dd5-9ed0-050a699f27f6",
