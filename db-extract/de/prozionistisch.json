                "senses": [
                    {
                        "sense_id": "7e780bb6-1bd3-3c86-b64f-5924bbcb0a84",
                        "entry_id": "65854a0e-c5da-3aea-b95b-c71c07864b6f",
                        "glosses": [
                            "positiv gegenüber dem Zionismus eingestellt, sich für den Zionismus aussprechend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7000d66d-962d-4e56-8125-ca137069f514",
                                "sense_id": "7e780bb6-1bd3-3c86-b64f-5924bbcb0a84",
                                "text": "„Wurden Churchills Ausführungen von jüdischer Seite als Konzession an die Araber empfunden, sahen sich deren militante Wortführer durch die Erklärung des Kolonialministers lediglich in ihrer Kritik an der in ihren Augen prozionistischen Politik der britischen Regierung bestätigt.“"
                            },
                            {
                                "example_id": "aae863a2-3fac-40ef-8d17-e950c12d8a29",
                                "sense_id": "7e780bb6-1bd3-3c86-b64f-5924bbcb0a84",
                                "text": "„Allerdings galt das ICEM als prozionistisch und hatte Israel in der Vergangenheit 15 Millionen Dollar zur Aufnahme von Immigranten gespendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
