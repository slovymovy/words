        "fr-extract.jsonl": [
            {
                "entry_id": "d560f9c2-1166-3225-985a-39607b74fee8",
                "word": "déstabilisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a45980a0-da58-466f-99c5-54139ef8c34b",
                        "entry_id": "d560f9c2-1166-3225-985a-39607b74fee8",
                        "tags": [
                            "plural"
                        ],
                        "form": "déstabilisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
                        "entry_id": "d560f9c2-1166-3225-985a-39607b74fee8",
                        "glosses": [
                            "Fait de déstabiliser, de rendre instable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67d5593-bdc6-4fdb-99de-14d084754157",
                                "sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
                                "text": "Parce qu’il faut avoir l’honnêteté de dire qu’on ne peut pas avoir n’importe quel citoyen qui engage des poursuites contre le président, dans un but de déstabilisation et de paralysie, donc il faut un filtre."
                            },
                            {
                                "example_id": "146cffee-1a07-4e31-abf7-d054f25d3780",
                                "sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
                                "text": "Les violences ethniques qui ensanglantent le Kirghizstan, petit pays d’Asie centrale, sont la conséquence d’un clivage ethnique entre Kirghiz et Ouzbeks, attisé par une déstabilisation politique, selon Arnaud Dubien, directeur de recherche à l’Institut de relations internationales et stratégiques (IRIS)."
                            },
                            {
                                "example_id": "910346dd-a720-4ee5-a06e-2e9ebb791be2",
                                "sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
                                "text": "De leur côté, Louis VII et son fils, Philippe Auguste (1180-1223), jouèrent la carte de la déstabilisation, en intervenant dans les comtés d'Auvergne et de Toulouse, ou en soutenant la révolte de Jean et Richard contre leur père Henri II."
                            },
                            {
                                "example_id": "6b2c3baf-8d39-4349-9082-d92bd01f3a8e",
                                "sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
                                "text": "Une vente de ce type pourrait-elle se révéler un facteur de déstabilisation ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "999d68b1-6203-4488-9b8d-656837f89ea8",
                        "source_entry_id": "d560f9c2-1166-3225-985a-39607b74fee8",
                        "source_sense_id": "4a289994-0975-34a2-ab55-71c5e7483578",
