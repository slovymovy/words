                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn verzorgde <w>vóórkomen</w> maakte direct een goede indruk tijdens het sollicitatiegesprek.",
                            "target_lang_translations": {
                                "en": "His well-groomed <w>appearance</w> immediately made a good impression during the job interview.",
                                "ru": "Его ухоженная <w>внешность</w> сразу произвела хорошее впечатление во время собеседования."
                            }
                        },
                        {
                            "text": "Vertrouw potentiële klanten niet te snel op hun <w>vóórkomen</w> of mooie blauwe ogen.",
                            "target_lang_translations": {
                                "en": "Do not trust potential customers too quickly based on their <w>appearance</w> or beautiful blue eyes.",
                                "ru": "Не доверяйте потенциальным клиентам слишком быстро, полагаясь лишь на их <w>облик</w> или красивые голубые глаза."
                            }
                        }
                    ],
                    "synonyms": [
