                ],
                "senses": [
                    {
                        "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                        "entry_id": "b6450650-5672-3881-a47a-ad4525db42c7",
                        "glosses": [
                            "Region im Westen des Sudan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9f4ae1-e51f-472a-a29f-2f133b555128",
                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                "text": "„In anderen Fällen stufte man ethnische Säuberungen als Kriegsverbrechen ein, auch wenn kein rechtliches Verfahren eingeleitet wurde (das gilt z.B. für das Vorgehen der sudanesischen Regierung in Darfur).“"
                            },
                            {
                                "example_id": "66b71cfb-7feb-48a9-8f40-0197d43e799b",
                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                "text": "„Bei meinem Dad das Gleiche: Warum sonst versucht er immer mehr dankbare Kinder an entsetzlichen Orten wie Darfur oder Baton Rouge aufzulesen?“"
                            },
                            {
                                "example_id": "c9a3b333-ec86-4b47-a544-12fb91f5aa1e",
                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                "text": "„›Wo haben sie dich trainiert, Youssef?‹, fragte er. ›Jaffna? Darfur?‹“"
                            },
                            {
                                "example_id": "4ff55f3d-a250-40ec-80dc-0a8a6227f556",
                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                "text": "„Das UNO-Kriegsverbrechertribunal in Den Haag hat wegen des Völkermords in Darfur einen Haftbefehl gegen ihn ausgestellt.“"
                            },
                            {
                                "example_id": "62e9bf6c-ccb8-4dcf-bdac-57e779f77648",
                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                "text": "„Wir könnten uns in Darfur einsetzen lassen und ein Baby adoptieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa99c58a-594b-4865-abef-3ca8478481bf",
                        "source_entry_id": "b6450650-5672-3881-a47a-ad4525db42c7",
