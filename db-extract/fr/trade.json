                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d1604e0-b49e-31e2-851e-67acebcf1fdd",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "A particular instance of buying or selling."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb27513e-23ca-4c90-9079-9cdc2ef811d9",
                                                "sense_id": "3d1604e0-b49e-31e2-851e-67acebcf1fdd",
                                                "text": "I did no trades with them once the rumors started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6979153-900d-39b6-9c97-73d1117777e2",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "An instance of bartering items in exchange for one another."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "453a156f-c258-4ef2-8196-f14e4b98bc0f",
                                                "sense_id": "a6979153-900d-39b6-9c97-73d1117777e2",
                                                "text": "EXCHANGE — A trade or swap of no material profit to either side."
                                            },
                                            {
                                                "example_id": "261f7179-5743-41de-a4ef-3ce4da0d4d35",
                                                "sense_id": "a6979153-900d-39b6-9c97-73d1117777e2",
                                                "text": "When Golden State matched the Knicks' offer sheet, the Warriors and Knicks worked out a trade that sent King to New York for Richardson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22caaa10-d88e-3c7e-affd-9bc3fa838648",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Those who perform a particular kind of skilled work."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567fabc8-8005-40ad-98b0-c9a7bb656d7c",
                                                "sense_id": "22caaa10-d88e-3c7e-affd-9bc3fa838648",
                                                "text": "The skilled trades were the first to organize modern labor unions."
                                            },
                                            {
                                                "example_id": "2db16002-adab-4002-b34a-32cdb51c9cdb",
                                                "sense_id": "22caaa10-d88e-3c7e-affd-9bc3fa838648",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75c0c8fe-0397-3a5e-a52a-154a590689ee",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Those engaged in an industry or group of related industries."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1525ea58-2875-492a-a088-6ee8e0db39d2",
                                                "sense_id": "75c0c8fe-0397-3a5e-a52a-154a590689ee",
                                                "text": "It is not a retail showroom. It is only for the trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f6a9be1-6097-3bc4-a0fc-19ac604660c6",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "The skilled practice of a practical occupation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a982ce-a701-4588-ad8d-0e875f4101b1",
                                                "sense_id": "6f6a9be1-6097-3bc4-a0fc-19ac604660c6",
                                                "text": "He learned his trade as an apprentice."
                                            },
                                            {
                                                "example_id": "3957958f-66d0-4697-b78d-d84cd9d55bf6",
                                                "sense_id": "6f6a9be1-6097-3bc4-a0fc-19ac604660c6",
                                                "text": "In the clearing stands a boxer and a fighter by his trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c224d5-53f3-3da4-b31c-88a236eb3182",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "An occupation in the secondary sector, as opposed to an agricultural, professional or military one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8559e10a-37dd-4598-bd52-dbedb6640c42",
                                                "sense_id": "51c224d5-53f3-3da4-b31c-88a236eb3182",
                                                "text": "After failing his entrance exams, he decided to go into a trade."
                                            },
                                            {
                                                "example_id": "6153ba5f-4c1b-4e19-b598-5590f5fd6339",
                                                "sense_id": "51c224d5-53f3-3da4-b31c-88a236eb3182",
                                                "text": "Most veterans went into trade when the war ended."
                                            },
                                            {
                                                "example_id": "9082ea15-9c5f-4087-80a8-e6e4d284044e",
                                                "sense_id": "51c224d5-53f3-3da4-b31c-88a236eb3182",
                                                "text": "Subsequently some Scottish troops settled, took up trade as weavers, tailors, or mariners, and married Dutch women."
                                            },
                                            {
                                                "example_id": "78414f8e-0878-4358-aeb6-228f9470d2b5",
                                                "sense_id": "51c224d5-53f3-3da4-b31c-88a236eb3182",
                                                "text": "Getting a job in your major is no breeze: Remember we made fun of those who took up a trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f40a2da-41ee-35f2-8815-16bacbf7cc9d",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "The business given to a commercial establishment by its customers."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef240973-d199-48ac-a756-aaff52e13bbb",
                                                "sense_id": "2f40a2da-41ee-35f2-8815-16bacbf7cc9d",
                                                "text": "Even before noon there was considerable trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f065aef-403c-373d-b66e-1c2f7ed0efd0",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Steady winds blowing from east to west above and below the equator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338d757a-a7b9-420b-a873-567fc83d6c75",
                                                "sense_id": "8f065aef-403c-373d-b66e-1c2f7ed0efd0",
                                                "text": "They rode the trades going west."
                                            },
                                            {
                                                "example_id": "f2e180b4-0039-4359-ad6b-f0d3dc33b887",
                                                "sense_id": "8f065aef-403c-373d-b66e-1c2f7ed0efd0",
                                                "text": "Calms and variable winds, are also experienced during every month of the year, in the space between the trades;[…] the vicinity of the north-east trade seems most liable to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d225f8-a075-3a20-8015-8ea0e09eddea",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "A publication intended for participants in an industry or related group of industries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5ed0b1-5e1a-472b-b1ce-b48423bdb189",
                                                "sense_id": "27d225f8-a075-3a20-8015-8ea0e09eddea",
                                                "text": "Rumors about layoffs are all over the trades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5066b0a6-66bf-37ba-8b45-daad828860bf",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "A masculine man available for casual sex with men, often for pay. (Compare rough trade.)"
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465b6142-c538-4a87-addd-f446c8c354b5",
                                                "sense_id": "5066b0a6-66bf-37ba-8b45-daad828860bf",
                                                "text": "Josh picked up some trade last night."
                                            },
                                            {
                                                "example_id": "490b10f2-3b63-42de-8dd1-789ea3e64d85",
                                                "sense_id": "5066b0a6-66bf-37ba-8b45-daad828860bf",
                                                "text": "In a homosexual of this kind—corresponding to the test of eccentric behavior in the drawing-room—one usually finds a preference for \"trade,\" i.e., sexually normal males, because, if another homosexual yields to him, he is only one of a class, but if he can believe that an exception is being made in his case, it seems a proof that he is being accepted for himself alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90f82c5-1850-3bf8-b940-c6811f5d3ac0",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Instruments of any occupation."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf9bed2-3ea8-4253-b5c1-142a0bf82361",
                                                "sense_id": "e90f82c5-1850-3bf8-b940-c6811f5d3ac0",
                                                "text": "His House and household Gods! his trade of War, / His Bow and Quiver; and his trusty Cur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0df82e-a159-36e6-8119-ef9111ec218f",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Short for trade paperback"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "270774ba-c3bc-377a-9109-00967854af0d",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "Refuse or rubbish from a mine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3b896fc-9ceb-354b-8fc5-df1e687e0e35",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "A track or trail; a way; a path; passage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d8bf5e-9704-4115-a924-a673b55d2351",
                                                "sense_id": "a3b896fc-9ceb-354b-8fc5-df1e687e0e35",
                                                "text": "A postern with a blind wicket there was, / A common trade to pass through Priam's house"
                                            },
                                            {
                                                "example_id": "e6a1d9da-83da-48d8-9ea4-88c6fcfa423b",
                                                "sense_id": "a3b896fc-9ceb-354b-8fc5-df1e687e0e35",
                                                "text": "As Shepheardes curre, that in darke eveninges shade / Hath tracted forth some salvage beastes trade"
                                            },
                                            {
                                                "example_id": "fbf2cf28-ffc9-4624-bd28-8ae0599e509f",
                                                "sense_id": "a3b896fc-9ceb-354b-8fc5-df1e687e0e35",
                                                "text": "Or, I'll be buried in the king's highway, / Some way of common trade, where subjects' feet / May hourly trample on their sovereign's head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0ef4d4-723d-351b-ad55-beb121f2b158",
                                        "entry_id": "71946c6e-0dee-352d-9fec-9d0a57fe1901",
                                        "glosses": [
                                            "A course; a custom; a practice; an occupation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e4cd5e0-590d-424f-a318-217393387da0",
                                                "sense_id": "fc0ef4d4-723d-351b-ad55-beb121f2b158",
                                                "text": "The Jewes, emong whom alone and no moe, God hitherto semed for to reigne, by reason of their knowledge of the law, and of the autoritee of being in the right trade of religion."
                                            },
                                            {
                                                "example_id": "bcb232ee-ebda-4b5e-a0be-ffb55c960e56",
                                                "sense_id": "fc0ef4d4-723d-351b-ad55-beb121f2b158",
                                                "text": "There those five sisters had continual trade / And used to bathe themselves in that deceitful shade."
                                            },
                                            {
                                                "example_id": "1ce14c63-a1c0-4401-a7d9-42f7c856c817",
                                                "sense_id": "fc0ef4d4-723d-351b-ad55-beb121f2b158",
                                                "text": "Long did I love this lady, / Long was my travel, long my trade to win her."
                                            },
                                            {
                                                "example_id": "2da5d8d5-5f2f-4145-a527-8386df6efd32",
                                                "sense_id": "fc0ef4d4-723d-351b-ad55-beb121f2b158",
                                                "text": "Thy sin's not accidental but a trade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
