        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56cf0c0f-b899-30a2-a577-3e2424d86d2c",
                    "sense_definition": "present participle and gerund of <w>jar</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>jarring</w> the table every time he moved his legs, making it hard for me to write.",
                            "target_lang_translations": {
                                "ru": "Он <w>тряс</w> стол каждый раз, когда шевелил ногами, из-за чего мне было трудно писать.",
                                "zh": "他每次动腿都会<w>震动</w>桌子，让我很难写字。",
                                "cs": "Pokaždé, když pohnul nohama, <w>otřásl</w> stolem, takže se mi těžko psalo."
                            }
                        },
                        {
                            "text": "The constant <w>jarring</w> of the old truck on the bumpy road made everyone feel sick.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>тряска</w> старого грузовика на ухабистой дороге вызвала у всех тошноту.",
                                "zh": "旧卡车在颠簸路面上持续的<w>颠簸</w>让每个人都感到恶心。",
                                "cs": "Neustálé <w>drncání</w> starého náklaďáku na hrbolaté cestě způsobilo, že se všem udělalo špatně."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
