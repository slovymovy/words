                "translations": [
                    {
                        "translation_id": "f74a0186-8e27-4dd2-a44d-5abeb4b7e3b2",
                        "source_entry_id": "35015511-335d-32a6-a4a0-11908ca026da",
                        "source_sense_description": "the production of movies",
                        "target_lang_word": "réalisation (cinématographique)",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6fa6b36c-3b6b-477f-9f41-cb690ba900d2",
                        "source_entry_id": "35015511-335d-32a6-a4a0-11908ca026da",
                        "source_sense_description": "the production of movies",
                        "target_lang_word": "cinéma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinéma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5078c97b-29f0-3e91-b2ec-5b0f487f67bc",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Art de réaliser un film ainsi que l’ensemble des techniques employées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c764210-12b8-4241-8504-deb5c59fbe27",
                                                "sense_id": "5078c97b-29f0-3e91-b2ec-5b0f487f67bc",
                                                "text": "Le cinéma est un art."
                                            },
                                            {
                                                "example_id": "03a2cbd3-4eb8-44b8-80ad-c4a894d24e4c",
                                                "sense_id": "5078c97b-29f0-3e91-b2ec-5b0f487f67bc",
                                                "text": "Voici, qui bâillent à côté d’eux, bouffis de suffisance et marinés dans la même nullité, deux jeunes représentants du cinéma français, et quand je dis cinéma, c’est pour être poli."
                                            },
                                            {
                                                "example_id": "47b7ca58-a5e2-4aa3-b337-4e0d6be6a935",
                                                "sense_id": "5078c97b-29f0-3e91-b2ec-5b0f487f67bc",
                                                "text": "— Le cinéma ! Le cinéma ! T’entends, Pradier ? C’est leur marotte à tous. À la mère, au fils… À tout le monde. C’est pas l’cinéma qui t’donnera de bonnes idées, mon garçon. Sois-en sûr. Et c’que j’disais chez les Comparois, je l’maintiens. Le cinéma, c’est des conneries."
                                            },
                                            {
                                                "example_id": "722116ee-d16b-4414-a263-393337ee2336",
                                                "sense_id": "5078c97b-29f0-3e91-b2ec-5b0f487f67bc",
                                                "text": "En 1936, changement de perspective : l’encyclique Vigilanti Cura de Pie XI décrète que le cinéma n’est pas mauvais en soi, qu’il est un outil neutre qui peut servir pour le bien si on éduque les spectateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313bdef3-7293-3f3f-b6a5-240829566384",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Caméra pour filmer des événements remarquables, en vue d’une diffusion par films."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6726c09-4ace-45fe-8c2c-46ae6356dcc8",
                                                "sense_id": "313bdef3-7293-3f3f-b6a5-240829566384",
                                                "text": "Le Yacht Club salua mon départ de trois coups de canon, je répondis en amenant le pavillon français. C’était un départ public, cérémonieux, auquel ne manquaient pas les cinémas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "135e3984-1dac-3f91-ba12-60f1b566020a",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Lieu où l’on projette des films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf871a4-5b90-4c8b-888d-adc98450901b",
                                                "sense_id": "135e3984-1dac-3f91-ba12-60f1b566020a",
                                                "text": "Il y avait beaucoup de monde dans la rue piétonne, à cause de l’heure et de l’endroit : les cinémas dégorgeaient leur public aux yeux fatigués dans les pizzerias, « couscous » et pseudo-grecs, et réciproquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e6e99ea-016a-38f9-b17b-72a61ca34dc9",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Appareil de prise de vue photographique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66939e9c-b0f9-41bc-a3cf-004b719f110a",
                                                "sense_id": "5e6e99ea-016a-38f9-b17b-72a61ca34dc9",
                                                "text": "Avez-vous remarqué ce photographe installé à l’entrée du sentier de la Mer de Glace et qui fusille les couples à bout portant avec un cinéma ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f172d409-8733-3937-b97b-6d7bb59883c1",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Mensonge ou action non spontanée effectuée en public."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "066698de-720e-4562-852e-0092afec217b",
                                                "sense_id": "f172d409-8733-3937-b97b-6d7bb59883c1",
                                                "text": "Il avait les larmes aux yeux quand il a fait le serment qu’il ne recommencerait jamais à détourner de l'argent, mais tout ça, c'est du cinéma. Personne n’y croit une seule seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd33976-088a-39b1-b98b-a72cadbe01e5",
                                        "entry_id": "4c1d46a4-3544-3ef9-ba2c-e504fd815018",
                                        "glosses": [
                                            "Fausse colère, caprice (employé par les parents en direction de leurs enfants)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "childish",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "634722f6-fde1-4f09-8008-c816ae1f4963",
                                                "sense_id": "ffd33976-088a-39b1-b98b-a72cadbe01e5",
                                                "text": "Arrête ton cinéma tout de suite ! Qu’est-ce que c’est que ces caprices !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
