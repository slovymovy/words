                                        "glosses": [
                                            "rice-growing; which grows or is capable of growing rice."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53cd9c94-9101-44a8-96a0-3c699dac2e76",
                                                "sense_id": "7607240b-0eea-3346-958d-dfd206344f64",
                                                "text": "Among other kinds the Patna justly celebrated, but perhaps the most fertile province for rice-growing is Arracan, from whence great quantities of the grain are shipped to Europe from the port of Akyab, the importance of which is yearly increasing."
                                            }
