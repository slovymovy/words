                    {
                        "translation_id": "4d97f950-1f4f-41de-b796-e4814a4b1464",
                        "source_entry_id": "a5eed391-074e-30ff-ba28-433667dd3293",
                        "source_sense_id": "e95bb5a7-f0d0-3574-bd8e-375f3fe3d5ef",
                        "target_lang_word": "Diurese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diurese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                        "entry_id": "afc5282d-02d0-3749-af22-74d712c8a052",
                                        "glosses": [
                                            "physiologische Ausscheidung von Harn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85d1b7e-71e5-4540-83df-57b6e658a3a7",
                                                "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                                "text": "Eine niedrige Diurese kommt in erster Linie durch zu niedrige Trinkmengen und hohen Verlust über die Haut (heißes Klima, Arbeitsbedingungen, Schwitzen oder den Darm (chronische Diarrhö, Kurzdarmsyndrom) zustande."
                                            },
                                            {
                                                "example_id": "386fcc5b-4e63-488a-98a2-e9c84b87a0d0",
                                                "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                                "text": "Während Leitungswasser, per os gegeben, eine meßbare Diurese hervorruft, zeigt sich bei subkutaner und intravenöser Injektion keine erhöhte Diurese."
                                            },
                                            {
                                                "example_id": "ae4c85e4-73c8-4042-a7d6-ef3b52693ee4",
                                                "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                                "text": "Eine direkte Folge der Diurese ist die verstärkte Ausscheidung von Wasser und damit von Stoffen wie Harnstickstoff, Harnsäure, Oxalsäure und Natriumchlorid."
                                            },
                                            {
                                                "example_id": "260eb774-feef-41da-82f3-85974efaa46a",
                                                "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                                "text": "Gelingt es nun, durch eine kräftig einsetzende Diurese die Oedemausschwemmung zu erreichen, dann ist immerhin ein therapeutischer Erfolg erzielt."
                                            },
                                            {
                                                "example_id": "bcdfd621-c462-485c-aa1c-b327bb7f21f7",
                                                "sense_id": "e884bc03-8f44-3c62-9b7e-ea4c51959ed2",
                                                "text": "Diurese kann therapeutisch forciert und zur Entgiftung eingesetzt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
