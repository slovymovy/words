    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                "word": "audiovisual",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                        "entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                        "glosses": [
                            "Containing both aural and visual elements."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f2dcc6af-4891-4d2d-8f06-8226094c9f1d",
                                "sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                                "text": "They put together a stunning audiovisual presentation, with movies and music as well as plenty of information."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3ac7f44-9915-48db-b567-de3fb0df682b",
                        "source_entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                        "source_sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                        "source_sense_description": "audiovisual",
                        "target_lang_word": "audiovizuální",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5bbacbf6-8f5d-4d58-8124-4b6d31eb9eaf",
                        "source_entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                        "source_sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                        "source_sense_description": "audiovisual",
                        "target_lang_word": "audiovisueel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audiovisueel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "71cce15c-0292-3bbe-b507-dda69cfed7bc",
                                        "entry_id": "62855ac1-6685-33e3-b80d-3cca8dff3658",
                                        "glosses": [
                                            "zichtbaar en hoorbaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49760e1-cbfb-4e66-ae57-8283419e95a2",
                                                "sense_id": "71cce15c-0292-3bbe-b507-dda69cfed7bc",
                                                "text": "We willen dit op audiovisuele wijze weergeven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02f9112-bfab-3614-8041-bea3deac1cdc",
                                        "entry_id": "62855ac1-6685-33e3-b80d-3cca8dff3658",
                                        "glosses": [
                                            "met geluid én met beeld"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e18dc2-6061-4565-81a3-aa6367834495",
                                                "sense_id": "f02f9112-bfab-3614-8041-bea3deac1cdc",
                                                "text": "‘Ik werk bij een audiovisueel productiebedrijf dat onder meer tv-commercials maakt. Veel bedrijven zeggen deze dagen hun shoots bij ons af. Maar het werk dat vandaag moet gebeuren, kon niet thuis worden gedaan. Ik hoorde gisteren überhaupt pas laat van de genomen maatregelen. Ik had tot laat gewerkt en daarna waren we gaan eten met collega’s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c3de514-3c0b-4729-a104-bd54cd748cb8",
                        "source_entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                        "source_sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                        "source_sense_description": "audiovisual",
                        "target_lang_word": "audiovisuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audiovisuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb79a6a4-9c2a-35d5-8d74-8ff49a6d1f5f",
                                        "entry_id": "5c533cd7-3814-39d6-a584-f19bd4bf560f",
                                        "glosses": [
                                            "Qui regroupe le son et l’image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e057f1f-0280-4a8a-87ca-065c557ed424",
                                                "sense_id": "bb79a6a4-9c2a-35d5-8d74-8ff49a6d1f5f",
                                                "text": "Il nous a fait une présentation audiovisuelle impressionnante avec de la musique et des bouts de films vraiment au service de l’information."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "audiovisuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "909b4d50-13e1-3da7-81af-5359ed6a9f24",
                                        "entry_id": "3db45423-a6f9-30e1-8655-c107649769d9",
                                        "glosses": [
                                            "Secteur industriel qui regroupe les métiers du son et de l'image notamment la radio, la télévision, le cinéma, les productions et l’internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aae1d9a-9c47-4cb5-8cf8-22b77f0a83e4",
                                                "sense_id": "909b4d50-13e1-3da7-81af-5359ed6a9f24",
                                                "text": "La politique de l’audiovisuel européen reste à définir."
                                            },
                                            {
                                                "example_id": "67ed4344-d899-4472-89d8-3bff6b61012f",
                                                "sense_id": "909b4d50-13e1-3da7-81af-5359ed6a9f24",
                                                "text": "Le problème de l’intégration de l’audiovisuel à l’éducation est donc, lui aussi, un problème industriel, un rapport coût-efficacité."
                                            },
                                            {
                                                "example_id": "22c65d15-0943-4845-b6b3-6270d8b0b492",
                                                "sense_id": "909b4d50-13e1-3da7-81af-5359ed6a9f24",
                                                "text": "C’est grâce à Alain Sussfeld, la cheville ouvrière avec Guy Verrecchia de la spectaculaire réussite du groupe UGC, que j’ai pu m’initier aux dédales de ce droit assez spécial aux confins du droit d’auteur, du droit commercial et d’une réglementation assez contraignante qu’est le droit de l’audiovisuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c927820-0c9c-498e-9e59-8a813fa39494",
                        "source_entry_id": "4559238c-4fd2-3407-93e9-779cde1e8bba",
                        "source_sense_id": "1d2248db-bced-3258-9199-379447e2cdbb",
                        "source_sense_description": "audiovisual",
                        "target_lang_word": "audiovisuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audiovisuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                        "entry_id": "b032b080-7aa6-3234-bd3a-27b781d0c243",
                                        "glosses": [
                                            "zugleich hörbar und sichtbar; zugleich akustisch und optisch wirksam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5298e8-1dea-4bda-b44f-8b4fa261d7e2",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Nach Butzkamm konnten jedoch die Vertreter audiovisueller Methoden den Anspruch nicht einlösen, mithilfe der Bilder die Basistexte einsprachig angemessen zu semantisieren."
                                            },
                                            {
                                                "example_id": "aca9613b-03ba-4ebb-ac0a-9080e2385f54",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Ein Vergleich von audiolingualer und audiovisueller Methode bezüglich ihrer methodischen Verfahrensweisen lässt deutliche Parallelen erkennen."
                                            },
                                            {
                                                "example_id": "dfa67f2f-585b-457b-88b9-753d5231d325",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Als audiovisuelle Medien (AV-Medien) werden synchrone technische Kommunikationsmittel bezeichnet, die die visuellen und auditiven Sinne des Menschen durch Ton und Bild bedienen."
                                            },
                                            {
                                                "example_id": "c3fc7935-e76b-4ca6-8cbf-68aadd4f981b",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Der Studiengang Audiovisuelle Medien geht zurück auf den 1979 gegründeten Studiengang Medientechnik."
                                            },
                                            {
                                                "example_id": "09dcdd89-d4ac-438d-8158-a8962748490c",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Trotz des immer größer werdenden Angebotes an audiovisuellen Materialien gibt es immer noch viele Lehrende, die in ihrem Unterricht kaum Filme einsetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
