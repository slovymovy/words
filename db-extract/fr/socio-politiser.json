                "senses": [
                    {
                        "sense_id": "2db0cf34-e533-3ad7-acf6-ca6cb6cf4b28",
                        "entry_id": "e23d48df-97d3-3616-8775-e10aec99fe6c",
                        "glosses": [
                            "Donner un caractère socio-politique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777133d3-4e85-4164-ae63-831555a999f2",
                                "sense_id": "2db0cf34-e533-3ad7-acf6-ca6cb6cf4b28",
                                "text": "Les analysants vont-ils abandonner leur cure, ou au minimum emporter son livre sur le divan pour socio-politiser leur relation à leur analyste, ou bien son livre va-t-il apparaître comme la tentative courageuse d’un individu cherchant à se faire psychanalyser en place publique ?"
                            },
                            {
                                "example_id": "e8adb682-c7bb-4828-b5e2-164afb6d9c1e",
                                "sense_id": "2db0cf34-e533-3ad7-acf6-ca6cb6cf4b28",
                                "text": "Bref le film continue et l'histoire est à la fois très touchante et très banale, je me dis même que c'est un film pour bobos nostalgiques de leur 20 ans mais pourquoi pas, on n'est pas obligé de socio-politiser tout."
                            }
                        ]
                    }
