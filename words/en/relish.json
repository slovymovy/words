{
    "word_family": [
        "relishable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bf6ab11-30e0-3f3d-b03e-e61661b4173a",
                    "sense_definition": "A cooked or pickled sauce, usually made with vegetables or fruits, used as a condiment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot dog was topped with mustard and a spoonful of sweet <w>relish</w>.",
                            "target_lang_translations": {
                                "nl": "De hotdog was belegd met mosterd en een lepel zoete <w>relish</w>."
                            }
                        },
                        {
                            "text": "Many people enjoy adding a tangy <w>relish</w> to their grilled burgers.",
                            "target_lang_translations": {
                                "nl": "Veel mensen voegen graag een pittige <w>relish</w> toe aan hun gegrilde burgers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweet relish",
                        "corn relish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gekookte of ingemaakte saus, meestal gemaakt van groenten of fruit, gebruikt als smaakmaker."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "relish",
                                "target_lang_sense_clarification": "De algemeen gebruikte term voor deze specifieke saus in de Nederlandse keuken."
                            },
                            {
                                "target_lang_word": "chutney",
                                "target_lang_sense_clarification": "Een vergelijkbare, vaak fruitige of kruidige ingemaakte saus."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9649c111-ba86-3af5-8856-e39315bd619e",
                    "sense_definition": "Great enjoyment or pleasure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ate their ice cream with great <w>relish</w>.",
                            "target_lang_translations": {
                                "nl": "De kinderen aten hun ijsje met groot <w>genot</w>."
                            }
                        },
                        {
                            "text": "He described his travel adventures with obvious <w>relish</w>.",
                            "target_lang_translations": {
                                "nl": "Hij beschreef zijn reisavonturen met overduidelijk <w>plezier</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "enjoy"
                    ],
                    "common_phrases": [
                        "with relish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Groot plezier of genot."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "genot",
                                "target_lang_sense_clarification": "Het ervaren van groot plezier of voldoening."
                            },
                            {
                                "target_lang_word": "plezier",
                                "target_lang_sense_clarification": "Algemene term voor vreugde of genot."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb67da8f-24d6-34c3-a257-8aecb0154033",
                    "sense_definition": "A strong liking or fondness for something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>relish</w> for classical music and spends hours listening to it.",
                            "target_lang_translations": {
                                "nl": "Ze heeft een <w>voorliefde</w> voor klassieke muziek en besteedt uren aan het luisteren ernaar."
                            }
                        },
                        {
                            "text": "His <w>relish</w> for complex puzzles makes him a great game player.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>passie</w> voor complexe puzzels maakt hem een geweldige speler."
                            }
                        }
                    ],
                    "synonyms": [
                        "like"
                    ],
                    "common_phrases": [
                        "relish for"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een sterke voorliefde of passie voor iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorliefde",
                                "target_lang_sense_clarification": "Een sterke voorkeur voor iets."
                            },
                            {
                                "target_lang_word": "passie",
                                "target_lang_sense_clarification": "Een zeer sterke, enthousiaste liefde voor iets."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                    "sense_definition": "To take great pleasure in something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not <w>relish</w> the thought of working on the weekend.",
                            "target_lang_translations": {
                                "nl": "Ik <w>kijk niet uit naar</w> het idee om in het weekend te werken."
                            }
                        },
                        {
                            "text": "The team <w>relishes</w> the challenge of playing against the best opponents.",
                            "target_lang_translations": {
                                "nl": "Het team <w>geniet van</w> de uitdaging om tegen de beste tegenstanders te spelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "enjoy",
                        "appreciate",
                        "delight in",
                        "revel in"
                    ],
                    "common_phrases": [
                        "relish the challenge",
                        "relish the idea"
                    ],
                    "target_lang_definitions": {
                        "nl": "Ergens veel plezier aan beleven of naar uitkijken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "genieten van",
                                "target_lang_sense_clarification": "Plezier beleven aan een activiteit of situatie."
                            },
                            {
                                "target_lang_word": "zin hebben in",
                                "target_lang_sense_clarification": "Uitkijken naar iets (vaak gebruikt in negatieve context)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc9d9929-8b59-350c-9024-a2d1acc6e868",
                    "sense_definition": "To eat or taste something with great pleasure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>relished</w> every bite of the delicious home-cooked meal.",
                            "target_lang_translations": {
                                "nl": "Hij <w>smulde van</w> elke hap van de heerlijke zelfgemaakte maaltijd."
                            }
                        },
                        {
                            "text": "The hungry travelers <w>relished</w> the warm soup after a long day.",
                            "target_lang_translations": {
                                "nl": "De hongerige reizigers <w>genoten van</w> de warme soep na een lange dag."
                            }
                        }
                    ],
                    "synonyms": [
                        "enjoy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets met veel plezier eten of proeven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "smullen van",
                                "target_lang_sense_clarification": "Met zichtbaar en hoorbaar plezier eten."
                            },
                            {
                                "target_lang_word": "genieten van",
                                "target_lang_sense_clarification": "Iets met smaak en plezier nuttigen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}