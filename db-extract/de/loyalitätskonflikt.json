                "senses": [
                    {
                        "sense_id": "3340093d-ce3a-3b5e-b05c-c893a0db1d66",
                        "entry_id": "8113a988-7680-377e-8c99-fb7b1a23bd48",
                        "glosses": [
                            "aus widersprüchlichen/nicht miteinander vereinbaren Verpflichtungen entstehendes Problem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf22857-c9f1-4ddf-a9af-2ebe69f96f5d",
                                "sense_id": "3340093d-ce3a-3b5e-b05c-c893a0db1d66",
                                "text": "„Ein Mitglied der Innenrevision gerät bei seiner Arbeit nicht in Loyalitätskonflikte mit seiner Dienststelle und seinen Kollegen, er fühlt sich allein dem System, dem Polizeiapparat als solchem, verpflichtet.“"
                            },
                            {
                                "example_id": "637b2d12-4ab9-47eb-9319-bcb05795728a",
                                "sense_id": "3340093d-ce3a-3b5e-b05c-c893a0db1d66",
                                "text": "„Doch distanzierte sich die erzkonservative NHK sofort von dem Schlussdokument und brachte dadurch die NGK in eine sehr schwierige Situation, da viele der Mitglieder und Pfarrer dieser Kirche gleichzeitig Mitglieder der regierenden Nationalen Partei oder deren Unterstützer und Wähler waren und nun in einen Loyalitätskonflikt gerieten.“"
                            },
                            {
                                "example_id": "dac163a1-162f-4951-ac9c-dd9e8625098d",
                                "sense_id": "3340093d-ce3a-3b5e-b05c-c893a0db1d66",
                                "text": "„Dieses Gespräch brachte ihn in einen Loyalitätskonflikt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
