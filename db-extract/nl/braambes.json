                    },
                    {
                        "translation_id": "0f9a1c93-a0b4-4a8f-b11c-8cb4281f785f",
                        "source_entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "source_sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "target_lang_word": "mûre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mûre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18b57958-2aff-3693-a630-e51bc07a755e",
                                        "entry_id": "9063878b-04d8-3813-88a1-e01c087e61a5",
                                        "glosses": [
                                            "Fruit composé comestible des mûriers (Morus) de couleur d’abord blanchâtre, puis rouge et enfin noire à maturité. Il est composé de petites baies globuleuses formées par le périanthe devenu charnu et portant un petit akène qui est le vrai fruit, et accolées les unes aux autres en épi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3ebe7a-b3d4-498a-a5bb-8a1132247c98",
                                                "sense_id": "18b57958-2aff-3693-a630-e51bc07a755e",
                                                "text": "À la saison des mûres, il montait sur l’arbre pour emplir son mouchoir de fruits savoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03ba2e1-f094-31b5-b758-f7903200a79c",
                                        "entry_id": "9063878b-04d8-3813-88a1-e01c087e61a5",
                                        "glosses": [
                                            "Fruit multiple comestible de plusieurs espèces de ronces (Rubus spp.), très ressemblant à celui du mûrier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d275650-ba73-4f04-a8fe-29c192b11f95",
                                                "sense_id": "a03ba2e1-f094-31b5-b758-f7903200a79c",
                                                "text": "Il mangea quelques mûres qu'il trouva dans les ronces de la lisière, après quoi il chercha à s'orienter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf027641-ac2c-31da-858c-34129ce5f5ff",
                                        "entry_id": "9063878b-04d8-3813-88a1-e01c087e61a5",
                                        "glosses": [
                                            "Utilisé dans l’expression de mûre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mûre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7035be9e-80f3-3b31-9388-83aa3f930289",
                                        "entry_id": "2e90697a-91fa-3d7e-b763-42cdc0e3d5e3",
                                        "glosses": [
                                            "Féminin singulier de mûr."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb298a96-559d-4ccb-8749-a992418a1b11",
                                                "sense_id": "7035be9e-80f3-3b31-9388-83aa3f930289",
                                                "text": "Décidément, peuples civilisés, vous êtes ou de fiers coquins ou de grands imbéciles : de fiers coquins, si c’est sciemment et après mûre délibération que vous dépensez votre temps, votre or et votre génie pour trouver les meilleurs moyens d’assassiner et de massacrer le plus promptement possible le plus grand nombre de vos semblables ; mais vous n’êtes que de grands imbéciles, si vous qui souffrez de la guerre, vous ne voulez pas tuer la guerre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68ec9198-740f-464c-9341-92ad2dc443a9",
                        "source_entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "source_sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "target_lang_word": "ronce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ronce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                        "entry_id": "e4fabe14-03e1-3e1f-89ff-4fa969c1b915",
                                        "glosses": [
                                            "Nom donné à plusieurs espèces d'arbustes aiguillonnés (Rubus spp.) et rampant, de la famille des Rosacées qui pousse dans les haies et dans les bois et qui porte un fruit multiple nommé mûre qui peut être confondu avec le fruit composé du mûrier et appelé également pour cette raison mûre sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ba5253-8946-4425-839b-87ded46220fe",
                                                "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                                "text": "Au bas, le long du sentier, régnait un rustique palis, perdu dans une haie d’aubépine et de ronce."
                                            },
                                            {
                                                "example_id": "7d6ce760-c3b8-415e-81d9-3e07eb6af721",
                                                "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                                "text": "Une bousculade plus violente se produisit ; les petits veaux et les génisses rejetés de droite et de gauche par la poussée des grands bestiaux s’égratignèrent aux ronces flottantes des haies."
                                            },
                                            {
                                                "example_id": "d23f9e5a-5192-4aca-993f-d38c6e140246",
                                                "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                                "text": "Il mangea quelques mûres qu'il trouva dans les ronces de la lisière, après quoi il chercha à s'orienter."
                                            },
                                            {
                                                "example_id": "887f80b9-5ac0-4194-a338-502a47f78fcc",
                                                "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                                "text": "Sans souci des brindilles qui le giflent, des ronces qui l’agriffent, il court, il court, pareil au solitaire qui charge l’ennemi."
                                            },
                                            {
                                                "example_id": "8e4c4782-1956-4e22-9c65-10193fe79c99",
                                                "sense_id": "0a10e64e-d7ee-32c4-9d7f-13829053259b",
                                                "text": "Moi je veux les oiseaux, les trilles et les stridulations, la rage du ruisseau ou son étirement d’été, l’aboiement des chevreuils, le chant de la hulotte, les ronces et les orties, la procession des chenilles, le gel et l’orage, les fleurs imprévues, la course des cicindèles, les arbres couchés, le vol des hannetons, les cétoines posées en sautoir sur un genêt défait, enchevêtrement des vies selon un ordre mystérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "513e8116-d530-3600-ae4f-1d63ce556c84",
                                        "entry_id": "e4fabe14-03e1-3e1f-89ff-4fa969c1b915",
                                        "glosses": [
                                            "Difficultés ; désagréments que l’on rencontre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a7ab91-bb02-4433-8859-bc214616078d",
                                                "sense_id": "513e8116-d530-3600-ae4f-1d63ce556c84",
                                                "text": "Sydenham, qui voulait publier un traité complet des maladies chroniques, exprime ainsi le regret qu'il éprouve de ne pas trouver de renseignements sur cette partie si intéressante de la médecine : « Les auteurs, si on en excepte le grand Hippocrate et un très-petit nombre d'autres, ne me fournissent presque aucun secours dans la route inconnue où je dois marcher, et qui est toute semée de ronces et d'épines. »"
                                            },
                                            {
                                                "example_id": "b97ffe15-54ba-46bc-9c44-cebd22465308",
                                                "sense_id": "513e8116-d530-3600-ae4f-1d63ce556c84",
                                                "text": "Ils n'avaient pas besoin pour cela de s'imposer de mortifications, de porter le raide cilice ou de se donner la discipline à clous de fer : leur vie de ronces et de pierres suffisait, peu imaginable aujourd'hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac5bd41-c2c1-39cb-b292-563fbc7e053e",
                                        "entry_id": "e4fabe14-03e1-3e1f-89ff-4fa969c1b915",
                                        "glosses": [
                                            "Fil de fer barbelé, nommé aussi ronce artificielle ou ronde d'acier ; morceau de fil de fer barbelé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe3cfa7-ab56-43e9-9f98-8f4c8cabc3a4",
                                                "sense_id": "9ac5bd41-c2c1-39cb-b292-563fbc7e053e",
                                                "text": "Entre les bavolets sont tendus trois rangs de ronces de fil de fer barbelé."
                                            },
                                            {
                                                "example_id": "08b7d66a-ee3c-4ec7-92ed-b5e11a6e112f",
                                                "sense_id": "9ac5bd41-c2c1-39cb-b292-563fbc7e053e",
                                                "text": "Il reste à tendre le fil de ronce, le fil barbelé ; avec le petit mécanisme qu'ils appellent « grenouille », ça se fait facilement."
                                            },
                                            {
                                                "example_id": "154184f5-6c78-4066-bff2-f976613855ce",
                                                "sense_id": "9ac5bd41-c2c1-39cb-b292-563fbc7e053e",
                                                "text": "Le fil de fer barbelé était généralement du fil de fer ronce de modèle spécial , analogue à celui fourni en Belgique par la Société Sambre et Escaut ( dit également fil de fer ronce Reitmayer )."
                                            }
                                        ]
                                    }
                                ]
