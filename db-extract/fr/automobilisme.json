        "fr-extract.jsonl": [
            {
                "entry_id": "90835900-b1fb-327d-b9fa-76fc741a229e",
                "word": "automobilisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c243dcd-911e-4614-b8c1-16c170652095",
                        "entry_id": "90835900-b1fb-327d-b9fa-76fc741a229e",
                        "tags": [
                            "plural"
                        ],
                        "form": "automobilismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a312350-df6c-38b9-9cf9-7e834310a772",
                        "entry_id": "90835900-b1fb-327d-b9fa-76fc741a229e",
                        "glosses": [
                            "Terme général qui désigne tout ce qui concerne les véhicules automobiles à vocation utilitaire ou dédiés au tourisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3e7722-5439-46cc-b3d8-bb2217c0844a",
                                "sense_id": "8a312350-df6c-38b9-9cf9-7e834310a772",
                                "text": "L°automobilisme a pris, dans ces dernières années, une extension considérable : les voitures de promenade, de tourisme, les fiacres, les omnibus pour le transport en commun, les voitures de livraison, les camions, ont successivement demandé à la mécanique une traction plus puissante et plus économique."
                            },
                            {
                                "example_id": "5ad9c67a-7b71-44e0-80d7-48f1021aa3d3",
                                "sense_id": "8a312350-df6c-38b9-9cf9-7e834310a772",
                                "text": "Les jeunes gens que j'ai connus les plus fanatiques d’automobilisme étaient auparavant les moins curieux de voyages. Le plaisir n'est plus ici de voir du pays, ni même d'arriver vite dans tel lieu, où du reste plus rien n'attire ; mais bien précisément d'aller vite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0a3074a-7c42-48d9-b209-bec5e617fa40",
                        "source_entry_id": "90835900-b1fb-327d-b9fa-76fc741a229e",
                        "source_sense_id": "8a312350-df6c-38b9-9cf9-7e834310a772",
                        "target_lang_word": "motoring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
