                ],
                "translations": [
                    {
                        "translation_id": "f8ff6e84-78f1-4457-bb34-efce228af914",
                        "source_entry_id": "eb9227d3-b17f-37f2-9c81-54ca112f4e92",
                        "source_sense_id": "224a40b6-8bec-3f64-b399-4b7c14f4da20",
                        "source_sense_description": "multinational company",
