        "fr-extract.jsonl": [
            {
                "entry_id": "6c546672-0e86-3ae8-81df-69941a9b1e79",
                "word": "lattis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "59146c6b-3a02-324a-8884-884fbf2ddaa0",
                        "entry_id": "6c546672-0e86-3ae8-81df-69941a9b1e79",
                        "glosses": [
                            "Ouvrage fait en lattes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71fad32f-b4e2-4cea-abc9-b51dae4919d8",
                                "sense_id": "59146c6b-3a02-324a-8884-884fbf2ddaa0",
                                "text": "Il s’était approché de la vieille ferme, dont la façade était couverte d’un lattis où grimpaient jusque sur le toit six ou sept gros ceps de vigne noueux ; mais les bourgeons se montraient à peine."
                            },
                            {
                                "example_id": "e540bc73-7761-4b5b-a8a4-af92c0ccc1cd",
                                "sense_id": "59146c6b-3a02-324a-8884-884fbf2ddaa0",
                                "text": "Morceaux d’ardoise, morceaux de tuf jonchaient le pied des murs, donnant une idée de l’état de ceux-ci, tout crevassés, et de celui des toits, rongés de mousse et de parmélies, parcourus d’ondulations suspectes incriminant des solives probablement aussi pourries que le lattis."
                            },
                            {
                                "example_id": "5214b272-1f7e-4145-988c-c2c638be3d19",
                                "sense_id": "59146c6b-3a02-324a-8884-884fbf2ddaa0",
                                "text": "Il serait urgent de recrépir à l’intérieur de la maison les cloisons dont la chaux effritée révélait le lattis de bois et la terre jaune."
                            },
                            {
                                "example_id": "df66f118-e247-42c2-98bd-6d2655878acb",
                                "sense_id": "59146c6b-3a02-324a-8884-884fbf2ddaa0",
                                "text": "Quand tout est très silencieux, la vieille maison fait tic-tac. Pas de façon régulière, comme une pendule, mais doucement et de toutes parts à mesure que le lattis à l’intérieur des murs change de température, que le plâtre se rétracte ou que la terre bouge sous les fondations en granit."
                            }
                        ]
                    }
                ],
