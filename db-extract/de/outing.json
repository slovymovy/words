                        "entry_id": "a49f7afc-240c-3415-a66a-4693c8fb66b0",
                        "glosses": [
                            "Handlung, sich zu etwas zu bekennen, speziell zur Homosexualität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b89e3bdb-a404-42a9-996d-e90cfebb3a6c",
                                "sense_id": "cead214a-e437-37b7-abe1-0ed11ef38e77",
                                "text": "„Wowereit wollte mit seinem Outing im Juni 2001 allen öffentlichen Spekulationen in den Medien und möglichen Kampagnen der Union zuvorkommen…“"
                            },
                            {
                                "example_id": "fe67a303-5fd0-4187-969e-7d10ac1bb613",
                                "sense_id": "cead214a-e437-37b7-abe1-0ed11ef38e77",
                                "text": "„Das war ein wichtiger Befreiungsschlag, dem weitere Outings folgten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3216859-0234-3f98-b8c9-ece081b71674",
                        "entry_id": "a49f7afc-240c-3415-a66a-4693c8fb66b0",
                        "glosses": [
                            "einen anderen betreffende Enthüllung, speziell der Homosexualität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ceb5846-93b3-45bc-9ee5-6cfc3e0ad86c",
                                "sense_id": "e3216859-0234-3f98-b8c9-ece081b71674",
                                "text": "Im Krimi wird die Angst vor einem Outing durch andere und die daraus resultierende Erpressbarkeit auch zum Mordmotiv gemacht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
