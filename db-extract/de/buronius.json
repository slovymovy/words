                "senses": [
                    {
                        "sense_id": "8b4edaa4-3a81-356c-9eb1-584f43b74610",
                        "entry_id": "651e9a1b-f523-3b88-bcdb-11b840c05e02",
                        "glosses": [
                            "Vertreter einer Gattung der Menschenaffen, die während des späten Miozän in Europa lebte"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a94b6231-d0d2-418e-8b70-3c4cc66c9393",
                                "sense_id": "8b4edaa4-3a81-356c-9eb1-584f43b74610",
                                "text": "„Unmittelbar neben den Fundplätzen der Danuvius-Knochen – dort, wo sich in der Epoche des mittleren Miozäns ein Fluss an einem Auwald entlangschlängelte – kamen die Überreste von Buronius zum Vorschein.“"
                            },
                            {
                                "example_id": "f76aac7f-a1ad-4e1c-81de-847f52b353e7",
                                "sense_id": "8b4edaa4-3a81-356c-9eb1-584f43b74610",
                                "text": "„Bei Buronius war das glücklicherweise gar nicht so schwierig, da die Zähne eindeutig gezeigt haben, dass wir es in Pforzen mit zwei sehr unterschiedlichen Menschenaffenarten zu tun hatten.“"
                            },
                            {
                                "example_id": "713234e1-c884-49af-a29c-b76fc5c0b640",
                                "sense_id": "8b4edaa4-3a81-356c-9eb1-584f43b74610",
                                "text": "„Außerdem sei es sehr ungewöhnlich, dass sie Knochen von zwei verschiedenen Menschenaffen-Gruppen – also Danuvius und Buronius – in genau der gleichen Fundschicht entdeckt hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
