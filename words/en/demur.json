{
    "word_family": [
        "demurral",
        "demurrer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e040b2ea-6516-3349-9a7c-9dcd8d8a71fd",
                    "sense_definition": "To object, express reluctance, or raise doubts about something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "object_doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several senior staff members decided to <w>demur</w> at the unexpected policy changes.",
                            "target_lang_translations": {
                                "nl": "Verschillende senior medewerkers besloten <w>bezwaar te maken</w> tegen de onverwachte beleidswijzigingen."
                            }
                        },
                        {
                            "text": "She agreed with most of the contract but felt obliged to <w>demur</w> to the final clause.",
                            "target_lang_translations": {
                                "nl": "Ze was het eens met het merendeel van het contract, maar voelde zich verplicht om <w>tegen te stribbelen</w> bij de laatste clausule."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppose"
                    ],
                    "common_phrases": [
                        "demur at",
                        "demur to"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bezwaar maken, tegenstribbelen of twijfels uiten over iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bezwaar maken",
                                "target_lang_sense_clarification": "meningsverschil of twijfel uiten"
                            },
                            {
                                "target_lang_word": "tegenstribbelen",
                                "target_lang_sense_clarification": "terughoudend zijn of zich verzetten"
                            },
                            {
                                "target_lang_word": "aarzelen",
                                "target_lang_sense_clarification": "twijfelen of afwachtend reageren"
                            },
                            {
                                "target_lang_word": "verzet aantekenen",
                                "target_lang_sense_clarification": "formeel of nadrukkelijk bezwaar maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c866b1b3-1533-3469-a069-4cd9ddc3ae39",
                    "sense_definition": "To submit a demurrer in legal proceedings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense chose to <w>demur</w>, arguing that the complaint failed to state a valid claim.",
                            "target_lang_translations": {
                                "nl": "De verdediging koos ervoor om <w>een exceptie op te werpen</w>, met het argument dat de klacht geen geldige grondslag had."
                            }
                        },
                        {
                            "text": "Rather than presenting evidence immediately, counsel decided to <w>demur</w> to the initial indictment.",
                            "target_lang_translations": {
                                "nl": "In plaats van direct bewijs aan te dragen, besloot de advocaat <w>formeel bezwaar aan te tekenen</w> tegen de initiële aanklacht."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een exceptie opwerpen of formele juridische betwisting indienen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "een exceptie opwerpen",
                                "target_lang_sense_clarification": "juridische exceptie aanvoeren"
                            },
                            {
                                "target_lang_word": "formeel bezwaar aantekenen",
                                "target_lang_sense_clarification": "in een rechtszaak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da9d5165-70b9-335b-9b86-2aeef95121f4",
                    "sense_definition": "To remain, stay, or linger in a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linger_stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary travelers chose to <w>demur</w> in the quiet valley for several weeks.",
                            "target_lang_translations": {
                                "nl": "De vermoeide reizigers kozen ervoor om enkele weken in de rustige vallei te <w>verwijlen</w>."
                            }
                        },
                        {
                            "text": "He hoped to <w>demur</w> until the violent storm had passed completely.",
                            "target_lang_translations": {
                                "nl": "Hij hoopte te <w>blijven</w> totdat de hevige storm volledig voorbij was."
                            }
                        }
                    ],
                    "synonyms": [
                        "abide"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is obsolete or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Ergens blijven, verwijlen of vertoeven (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verwijlen",
                                "target_lang_sense_clarification": "formeel of verouderd voor verblijven"
                            },
                            {
                                "target_lang_word": "verblijven",
                                "target_lang_sense_clarification": "op een plek blijven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffc3f09e-3133-3b76-9a27-9099eafaaad5",
                    "sense_definition": "An objection, hesitation, or expression of doubt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "object_doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accepted the additional responsibilities at work without any <w>demur</w>.",
                            "target_lang_translations": {
                                "nl": "Ze accepteerde de extra verantwoordelijkheden op het werk zonder enige <w>tegenspraak</w>."
                            }
                        },
                        {
                            "text": "After a brief <w>demur</w>, he signed the agreement and shook everyone's hand.",
                            "target_lang_translations": {
                                "nl": "Na een korte <w>aarzeling</w> ondertekende hij de overeenkomst en schudde hij ieders hand."
                            }
                        }
                    ],
                    "synonyms": [
                        "scruple"
                    ],
                    "common_phrases": [
                        "without demur"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een bezwaar, aarzeling of uiting van twijfel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tegenspraak",
                                "target_lang_sense_clarification": "weerwoord, protest"
                            },
                            {
                                "target_lang_word": "bezwaar",
                                "target_lang_sense_clarification": "bedenking of protest"
                            },
                            {
                                "target_lang_word": "aarzeling",
                                "target_lang_sense_clarification": "twijfel, terughoudendheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f8d2d8-c3f5-3589-8c65-0936f352db53",
                    "sense_definition": "A formal objection or legal motion to stop proceedings; a demurrer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attorney filed a <w>demur</w> alleging that the complaint lacked sufficient legal basis.",
                            "target_lang_translations": {
                                "nl": "De advocaat diende een <w>exceptie</w> in met het argument dat de klacht onvoldoende juridische grondslag had."
                            }
                        },
                        {
                            "text": "The judge considered the defendant's <w>demur</w> before allowing the trial to continue.",
                            "target_lang_translations": {
                                "nl": "De rechter overwoog het <w>formele bezwaar</w> van de gedaagde voordat hij het proces liet voortduren."
                            }
                        }
                    ],
                    "synonyms": [
                        "demurrer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "legal usage superseded by demurrer"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een formeel juridisch bezwaar of exceptie (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "exceptie",
                                "target_lang_sense_clarification": "juridisch vormverweer"
                            },
                            {
                                "target_lang_word": "formeel bezwaar",
                                "target_lang_sense_clarification": "juridische betwisting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce119a91-ce52-320e-beb4-885eaea651af",
                    "sense_definition": "A temporary stay, delay, or residence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linger_stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pleasant town merited a short <w>demur</w> before they continued their journey.",
                            "target_lang_translations": {
                                "nl": "Het aangename stadje verdiende een kort <w>verblijf</w> voordat ze hun reis voortzetten."
                            }
                        },
                        {
                            "text": "Their unexpected <w>demur</w> in the border village lasted several days.",
                            "target_lang_translations": {
                                "nl": "Hun onverwachte <w>oponthoud</w> in het grensdorp duurde enkele dagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "abode"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "sense is obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een tijdelijk verblijf, vertraging of oponthoud (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "oponthoud",
                                "target_lang_sense_clarification": "tijdelijke vertraging"
                            },
                            {
                                "target_lang_word": "verblijf",
                                "target_lang_sense_clarification": "tijdelijke rustplaats"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}