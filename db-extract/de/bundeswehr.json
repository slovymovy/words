                "senses": [
                    {
                        "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                        "entry_id": "387ec672-10af-38d9-9e8f-377dec8526b4",
                        "glosses": [
                            "die Streitkräfte der Bundesrepublik Deutschland und ihre Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642f1f39-10fe-47c8-bc97-3965aa2a37a4",
                                "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                                "text": "Die Bundeswehr untersteht dem Verteidigungsminister."
                            },
                            {
                                "example_id": "c45baeb7-7d82-4e35-a0ed-f09617483698",
                                "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                                "text": "„Die Aufgaben der Bundeswehr, die im Rahmen von UNIFIL mit einem robusten Mandat ausgestattet ist, sind Aufklärung und Kontrolle der Seewege sowie die Umleitung von Schiffen im Verdachtsfall.“"
                            },
                            {
                                "example_id": "d1f39f45-4f07-4612-a1de-a46da4fb07ac",
                                "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                                "text": "„Der Franke, der es gestern Abend gut fand, dass Muttersöhnchen bei der Bundeswehr geradegestellt werden, torkelt mit einem Bierglas in der Hand unter den Piratenflaggen aus Plastik um 12:10 Uhr Ortszeit gegen einen Pflanzenkübel.“"
                            },
                            {
                                "example_id": "b8e45275-cce9-4dba-8491-5c0bcf0466f4",
                                "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                                "text": "„Bertram war dann mit der Bundeswehr fertig und könnte bei uns einziehen.“"
                            },
                            {
                                "example_id": "90b4eb83-0769-45ed-9e70-8f480147e709",
                                "sense_id": "2f69c4e5-d4fe-3b54-a993-4183117843b8",
                                "text": "„Auch unsere Bundeswehr wird sich diese Überlegung zu eigen machen, jedoch nicht auf halbem Wege stehen bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
