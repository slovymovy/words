                                    {
                                        "sense_id": "95434f1b-4504-37eb-82ae-554215c5b5b2",
                                        "entry_id": "4c3d331f-8e2e-34a2-828e-4e17552eb5ea",
                                        "glosses": [
                                            "That which is indubitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b3c250-2e1f-4f40-9f92-c6dcb79e7c99",
                                                "sense_id": "95434f1b-4504-37eb-82ae-554215c5b5b2",
                                                "text": "If we build logically upwards from a few indubitables, the whole system must remain correct."
                                            }
