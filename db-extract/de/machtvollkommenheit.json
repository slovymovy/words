                ],
                "senses": [
                    {
                        "sense_id": "f4515929-6e04-3120-81bc-8c6ade11c12b",
                        "entry_id": "9fa5f3d8-4262-3b35-ad55-7a13871b400d",
                        "glosses": [
                            "uneingeschränkte Befugnis zur Machtausübung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd9739c-db56-4c46-93df-3263487bec57",
                                "sense_id": "f4515929-6e04-3120-81bc-8c6ade11c12b",
                                "text": "„Die Unabhängigkeit, ja Machtvollkommenheit besteht für den Richter, für das Gericht, zumal für das oberste Gericht, darin, darüber frei entscheiden zu dürfen, was sie als gleich und was sie als ungleich erachten.“"
                            },
                            {
                                "example_id": "4617b25d-003e-4600-8287-1fdf35bb01d4",
                                "sense_id": "f4515929-6e04-3120-81bc-8c6ade11c12b",
                                "text": "„Denn längst vor dieser Zeit hatte der Beamte begonnen, sich mit der Aufgabe zu verwechseln, hatte das Dienen aufgegeben und war Herrscher aus eigener Machtvollkommenheit geworden.“"
                            },
                            {
                                "example_id": "b3c996b7-f694-48c7-a413-5fa5e3c49d2a",
                                "sense_id": "f4515929-6e04-3120-81bc-8c6ade11c12b",
                                "text": "„Aber das IOC kann doch nun nicht hingehen und seine Machtvollkommenheit beweisen, indem es seine Sicht der Dinge über den Cas hinweg mit Gewalt durchdrückt.“"
                            },
                            {
                                "example_id": "829e37ad-8c45-49d8-9a47-5049530600ea",
                                "sense_id": "f4515929-6e04-3120-81bc-8c6ade11c12b",
                                "text": "„Geplant hatten sie ein Picknick vor dem Sitz des Geheimdienstes, sie wollten damit protestieren gegen die Methoden des Regimes, gegen die Machtvollkommenheit des Königs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
