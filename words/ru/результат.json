                        "показать результат",
                        "улучшить результат",
                        "спортивные результаты"
                    ],
                    "target_lang_definitions": {
                        "en": "A quantitative measure of performance, success, or skill, especially in sports, exams, or business.",
                        "zh": "衡量表现、成功或技能的量化指标，常见于体育、考试或商业领域。"
                    },
