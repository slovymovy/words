                        ],
                        "form": "den Stadtplan"
                    },
                    {
                        "form_id": "d53f22ab-2a18-4712-a269-9e7ecd83715f",
                        "entry_id": "7f6adc19-99be-3d48-9e9d-5d0858f02126",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stadtpläne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                        "entry_id": "7f6adc19-99be-3d48-9e9d-5d0858f02126",
                        "glosses": [
                            "großmaßstäbige Darstellung von Straßen, Plätzen und wichtigen Gebäuden einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64e41668-8450-42e6-bedd-636d26db35e7",
                                "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                                "text": "Wer mit dem Auto in eine fremde Großstadt fährt, sollte auf jeden Fall einen Stadtplan dabeihaben."
                            },
                            {
                                "example_id": "fa7f5a03-9b6f-430d-8f8d-c22a2bb70e25",
                                "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                                "text": "„Draußen steckte ich den Stadtplan in den Rucksack und versuchte, mir die Umgebung einzuprägen, so dass ich auch ohne Plan wieder zurück finden würde.“"
                            },
                            {
                                "example_id": "4839a0e1-c480-4e1f-bf4c-96b140becdcb",
                                "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                                "text": "„Sie studierten den Stadtplan, der an einer Wand in der Rezeption hing.“"
                            },
                            {
                                "example_id": "3ea6f85d-2c56-463c-840d-e3e6426f4bee",
                                "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                                "text": "„Urplötzlich scheren sie aus, schwenken ab zu einem Schaufenster, nesteln an ihrer Kamera oder breiten einen Stadtplan mitten auf dem Bürgersteig aus.“"
                            },
                            {
                                "example_id": "16017f84-635d-4218-972b-0a90b8145236",
                                "sense_id": "f54bd8c5-28cd-326f-a7d9-85f6fd0c2789",
                                "text": "„Bevor Robert am Nachmittag aufgebrochen war, hatte er sich erkundigt, ob es im Gasthaus nicht einen Stadtplan oder einen Prospekt über die Sehenswürdigkeiten gebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
