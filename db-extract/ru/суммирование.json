                                        "entry_id": "997a9d66-c088-33ff-bd37-0c957b56db4b",
                                        "glosses": [
                                            "Zusammenzählung zweier Zahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7f23b7-7044-40a6-a8df-8ea2a9318d1f",
                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "Die Addition von 16 zu 8 ergibt 24."
                                            },
                                            {
                                                "example_id": "922617da-8787-4ed0-9339-027f910bb161",
                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "„Er lernte Addition mit Blick auf Ananas und Melonen.“"
                                            },
                                            {
                                                "example_id": "3b021c4a-8fd1-491e-9472-da85b24c5626",
                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "„Die Addition zweier Zahlen erfolgt so, dass zunächst die erste Zahl auf dem Abakus eingestellt wird und dann die zweite dazukommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06963c36-a42f-39a2-8db4-61aa1acb75d6",
                                        "entry_id": "997a9d66-c088-33ff-bd37-0c957b56db4b",
                                        "glosses": [
                                            "Reaktion, bei der zwei Moleküle verbunden werden, ohne dass ein weiteres Reaktionsprodukt entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16036d53-0840-4f6b-b362-01413cb376f7",
                                                "sense_id": "06963c36-a42f-39a2-8db4-61aa1acb75d6",
                                                "text": "Die Addition von Wasserstoff wird auch als Hydrierung bezeichnet."
                                            }
                                        ],
