        "de-extract.jsonl": [
            {
                "entry_id": "dbb44fb2-058e-30d3-8191-efdcb5927415",
                "word": "biada",
                "pos": "intj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a02eec9-c9b6-3e8e-9aac-82e1a295b455",
                        "entry_id": "dbb44fb2-058e-30d3-8191-efdcb5927415",
                        "glosses": [
                            "wehe, weh"
                        ],
                        "tags": [
                            "literary",
                            "with-dative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e7c875-992d-49b3-8991-a18ffcda765d",
                                "sense_id": "9a02eec9-c9b6-3e8e-9aac-82e1a295b455",
                                "text": "„Biada światu i biada grzesznym, albowiem nie będzie już dla nich miłosierdzia…“",
                                "translation": "Wehe der Welt und wehe den Sündigen, denn es wird für sie keine Barmherzigkeit mehr geben…"
                            },
                            {
                                "example_id": "bb19809e-ce94-406b-926c-f9ecaf3e2dbf",
                                "sense_id": "9a02eec9-c9b6-3e8e-9aac-82e1a295b455",
                                "text": "„Biada, ach, biada ojcom, gdy dzieci zabiją!“",
                                "translation": "Wehe, ach, wehe den Vätern, wenn sie ihre Kinder töten!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "465c1191-9518-410e-8a62-bd798fee8905",
                        "source_entry_id": "dbb44fb2-058e-30d3-8191-efdcb5927415",
                        "source_sense_id": "9a02eec9-c9b6-3e8e-9aac-82e1a295b455",
                        "source_sense_description": "Ausruf der Klage über etwas, das bereits geschehen ist oder vermeintlich eintreffen wird",
                        "target_lang_word": "wehe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wehe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94fae908-003a-303a-aaaa-5545d3630c3b",
                                        "entry_id": "8c082c0e-2238-3a9b-80c7-359798f39472",
                                        "glosses": [
                                            "als Ausruf der Bestürzung, Klage, des Kummers, Leids, (seelischen) Schmerzes oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0326b69-7faf-4e33-ba09-bcaba5607ca9",
                                                "sense_id": "94fae908-003a-303a-aaaa-5545d3630c3b",
                                                "text": "„‚O wehe mir!‘ klagte ſie, ‚es hat mir jemand einen haͤßlichen Stoß verſetzt, ſo daß ich krank bin und die Stimme nicht mehr ſchwinge. […]‘“"
                                            },
                                            {
                                                "example_id": "981636cc-65c9-422b-b812-0f8dea89ef06",
                                                "sense_id": "94fae908-003a-303a-aaaa-5545d3630c3b",
                                                "text": "„Doch wehe, die Übermacht der Feinde war unbezähmbar geweſen; einer nach dem anderen waren die Seinen um ihn gefallen, und nach mehrſtündigem Kampfe ſchließlich, einſam übriggeblieben, habe er um Odem für ſeine Naſe erſuchen müſſen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c85f4f13-702e-3b09-b95b-f55c45231043",
                                        "entry_id": "8c082c0e-2238-3a9b-80c7-359798f39472",
                                        "glosses": [
                                            "Ausruf als Ankündigung oder Androhung von etwas Schlimmen, Unheilvollen oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe16f4f-4816-4627-8f27-6f6f2ec53352",
                                                "sense_id": "c85f4f13-702e-3b09-b95b-f55c45231043",
                                                "text": "„O diese arabischen Querelen! Und wehe dem, der sich da einmischt!“"
                                            },
                                            {
                                                "example_id": "cab98025-b58c-44d2-9086-704f5492914e",
                                                "sense_id": "c85f4f13-702e-3b09-b95b-f55c45231043",
                                                "text": "„Und wehe, es hatte einer gelogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
