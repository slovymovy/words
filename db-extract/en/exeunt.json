                        "entry_id": "13a40c2b-be33-33db-b0b2-bb0d981ec8e9",
                        "glosses": [
                            "A stage direction for more than one actor to leave the stage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c42df5-c7ef-4c2d-89db-be88765e14cb",
                                "sense_id": "1654fed7-1915-3137-908d-62f79a316a74",
                                "text": "undoubtedly the curtains closed at the exeunt of all the characters but one."
                            },
                            {
                                "example_id": "b79cc904-e070-4373-bd90-792e67482a70",
                                "sense_id": "1654fed7-1915-3137-908d-62f79a316a74",
                                "text": "In addition, several exits that have interpretative significance are changed by editors to exeunts and vice-versa."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f9baf03-caab-34e5-8aa4-178c54e5cef6",
                        "entry_id": "13a40c2b-be33-33db-b0b2-bb0d981ec8e9",
                        "glosses": [
                            "An act of one or more actors leaving the stage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9802252a-a3af-4b89-bb4b-8f2aa1604ff1",
                                "sense_id": "2f9baf03-caab-34e5-8aa4-178c54e5cef6",
                                "text": "To supply the place of scenery, it was hung round with crimson curtains, through which we were to make our entrances and exeunts."
                            }
                        ]
                    }
                ],
