                        "form": "den Autoradio"
                    },
                    {
                        "form_id": "5e6bacd2-8214-4ed0-b42b-a8278039f072",
                        "entry_id": "e37bbd16-b59a-32b8-a560-9ffc219c272f",
                        "tags": [
                            "accusative",
