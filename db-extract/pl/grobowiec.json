                "translations": [
                    {
                        "translation_id": "5552c018-1f41-439f-98a5-a079f56dcb4d",
                        "source_entry_id": "d50ac33b-bafb-39f1-bb74-e965870d1b91",
                        "source_sense_id": "0b7ebbc6-264c-3085-abf8-d4ad2a40f180",
                        "target_lang_word": "tomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "495d6354-83f2-357f-96ee-da1f4e610635",
                                        "entry_id": "013f75b8-d946-372e-86ca-1583ec571372",
                                        "glosses": [
                                            "A small building, or a room within one, for the remains of the dead, with walls, a roof, and (if it is to be used for more than one corpse) a door. It may be partly or wholly in the ground (except for its entrance) in a cemetery, or it may be inside a church proper or in its crypt. Single tombs may be permanently sealed; those for families (or other groups) have doors for access whenever needed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0196cca6-e12b-36af-a5cd-eb15326f3745",
                                        "entry_id": "013f75b8-d946-372e-86ca-1583ec571372",
                                        "glosses": [
                                            "A pit in which the dead body of a human being is deposited."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33929476-8d44-431a-ad14-01dff92cefba",
                                                "sense_id": "0196cca6-e12b-36af-a5cd-eb15326f3745",
                                                "text": "As one dead in the bottom of a tomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c04790-0ad5-3308-b09c-8818c137dafa",
                                        "entry_id": "013f75b8-d946-372e-86ca-1583ec571372",
                                        "glosses": [
                                            "One who keeps secrets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa6fd20-3cb6-4683-af3b-185030991112",
                                                "sense_id": "33c04790-0ad5-3308-b09c-8818c137dafa",
                                                "text": "I never told anyone about it. You're the first, except Ivan, of course—Ivan knows everything. He knew about it long before you. But Ivan's a tomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "006200ee-b932-3e13-b7cf-ea4b380a21c8",
                                        "entry_id": "013f75b8-d946-372e-86ca-1583ec571372",
                                        "glosses": [
                                            "Death (literary)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e44285-260a-4c4a-8040-ae17f91643d9",
                                                "sense_id": "006200ee-b932-3e13-b7cf-ea4b380a21c8",
                                                "text": "I'll go to the tomb unrepentant."
                                            }
                                        ]
                                    }
                                ]
                            },
