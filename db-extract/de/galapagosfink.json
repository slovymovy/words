                        "sense_id": "b056198e-a915-3320-a6f1-2c5c4c20a23a",
                        "entry_id": "7b7a34f0-c148-395f-b0f8-bb7a47fc492a",
                        "glosses": [
                            "auf den Galapagos-Inseln verbreitete Singvogelart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d98d249-20c0-4ea1-abd2-64597ed0e2f7",
                                "sense_id": "b056198e-a915-3320-a6f1-2c5c4c20a23a",
                                "text": "„Dass meine Lungen sich verkrampften und mein Herz wie ein ins Netz gegangener Galapagosfink zappelte - während sich aus meiner Blase ein Sturzbach siedend heißen Harns ergoss -, hatte mehr mit der schrecklichen Vorstellung zu tun, dass ich verhaftet werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
