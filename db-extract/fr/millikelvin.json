                                        "glosses": [
                                            "One thousandth of a kelvin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d6a012c-5d35-4e32-ba55-debde921dd14",
                                                "sense_id": "c45fb2e4-81ab-3085-a467-07b03d5c5105",
                                                "text": "ILT's device cools samples to several millikelvins, cold enough to freeze helium."
                                            },
                                            {
                                                "example_id": "11829512-4c7d-472d-9c81-ca2032d2fdae",
                                                "sense_id": "c45fb2e4-81ab-3085-a467-07b03d5c5105",
                                                "text": "This zero-bias maximum disappears as temperature is raised above several hundred millikelvin, in agreement with theory ( 8 ): Because V sd is equal to the separation between the Fermi levels of the two leads, finite V sd splits the Kondo resonance into two peaks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "millikelvin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                        "entry_id": "f1becdfd-fd4a-37aa-8de4-d22f1be5dd74",
                                        "glosses": [
                                            "Of or relating to the temperature range at which temperatures are expressed in millikelvins"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d6a93e-9c1c-42b8-8b76-8a005e948c75",
                                                "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                                "text": "The temperatures required for producing a crystalline solid out of such a \"one-component plasma\" (3) are in the millikelvin range."
                                            },
                                            {
                                                "example_id": "41d76c8f-4ec2-42cb-963b-f4df3a75c650",
                                                "sense_id": "0733f004-45bb-368f-8e17-73f55c7e6bb6",
                                                "text": "These results imply that DNA molecules can be conducting down to millikelvin temperature and that phase coherence is maintained over several hundred nanometers."
                                            }
                                        ]
                                    }
                                ]
                            }
