                    {
                        "form_id": "a0636d2f-578a-4325-9ce5-c6df80016bc0",
                        "entry_id": "ea81d2fa-18fd-322c-8e0d-6c01c7994b43",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ausbauziele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                        "entry_id": "ea81d2fa-18fd-322c-8e0d-6c01c7994b43",
                        "glosses": [
                            "gewünschter, definierter und zeitlich terminierter Ausbauzustand einer Infrastruktur, beispielsweise im Telekommunikationsbereich (Glasfaser, Mobilfunkversorgung), Energiebereich (Windräder, erneuerbare Energien, Stromtrassen, Fernwärmenetze) oder Verkehrswege (Radwege, Schienen, Brücken, Straßen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01002338-053c-4bd1-93e1-dcdd12ae22ee",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„So scheiterte die Festlegung verpflichtender globaler Ausbauziele für erneuerbare Energien am Widerstand der USA und der maßgeblich durch die OPEC-Länder beeinflussten G77-Gruppe (gegenwärtig 140 Entwicklungsländer).“"
                            },
                            {
                                "example_id": "4d99c5b0-b1c0-4a20-8d37-c007e3ab3c54",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Als erstes Ausbauziel sollte die Errichtung von mindestens 5.000 MW Leistung innerhalb von 10 Jahren angestrebt werden, um auch hier die noch möglichen Kostensenkungen rasch zu erreichen.“"
                            },
                            {
                                "example_id": "1a4a9266-0ede-44d7-a964-b4db8303b0dc",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Wind- und Sonnenkraft müssten jedoch deutlich schneller ausgebaut werden als bisher geplant: Die Ausbauziele müssten mindestens verdoppelt werden.“"
                            },
                            {
                                "example_id": "fb34cdbb-1ff9-4a31-ab5c-a20ec56118ca",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Da Bangladesch gleichzeitig die fossile Stromerzeugung massiv ausbaut, wird der Anteil erneuerbarer Energien am Strommix aber auch bei Erreichen der Ausbauziele gering bleiben.“"
                            },
                            {
                                "example_id": "5af932d3-fbc8-47c9-bfbd-64c75f4b555f",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Solarenergie:] „Das Ausbauziel für 2024 von 13 Gigawatt wurde mit fast 16 Gigawatt deutlich übertroffen.“"
                            },
                            {
                                "example_id": "84908ebd-0f31-43d6-9bf2-8207ec57f6dc",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Damit müssen künftig jährlich 19 Gigawatt zugebaut werden, um das Ausbauziel von 215 Gigawatt für Solar im Jahr 2030 zu erreichen.“"
                            },
                            {
                                "example_id": "9775e7fe-3bb0-4e27-953c-31fc423c1d0f",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Schlagzeile:] „Offshore-Windenergie: Ausbauziel wird verfehlt - und zwar deutlich“"
                            },
                            {
                                "example_id": "e0aae879-8f40-4602-97e4-2ae0505ecd47",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Das Ausbauziel für die Offshore-Windenergie von 30 Gigawatt installierter Leistung bis 2030 wird um mehr als ein Drittel verfehlt.“"
                            },
                            {
                                "example_id": "a10cd377-df37-4273-a64c-5149f4f35789",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Wasserkraft:] „Bereits 2011 hatte die Landesregierung ein Ausbauziel von 2,8 Terawattstunden festgelegt.“"
                            },
                            {
                                "example_id": "00d32eda-403b-4a2c-9616-1bdc66ad432a",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Und mehrere Branchenverbände der Windenergie schreiben in einer gemeinsamen Erklärung: »Für die Erreichung der gesetzlichen Ausbauziele muss der Zubau bis 2030 drastisch anziehen.«“"
                            },
                            {
                                "example_id": "1439f885-95e9-45e1-84dd-0599778ff7e8",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Aubau erneuerbarer Energien:] „Der weitere Ausbau konzentriert sich daher auf Photovoltaik (Ausbauziel 2030: 215 GW), Onshore-Wind (Ausbauziel 2030: 115 GW) und Offshore-Wind (Ausbauziel 2030: 30 GW).“"
                            },
                            {
                                "example_id": "cfbc7b26-845f-4ef1-ab72-33d4fe4b79fb",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„[…] Laut Experten braucht es auch PV-Anlagen in der Landschaft, um die Ausbauziele zu erreichen.“"
                            },
                            {
                                "example_id": "3fa1ad9e-4bb0-4338-b68a-7cf1d19dad4b",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Bis 2030 soll 80 Prozent des Strombedarfs durch Erneuerbare gedeckt werden. Wird die Verbrauchsprognose gesenkt, stehen die Ausbauziele für Windräder und Solaranlagen auf der Kippe.“"
                            },
                            {
                                "example_id": "bdf8f295-c79e-4d4f-bb75-4eb1b91dee9e",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "„Thimm betont, Deutschland müsse die ambitionierten Ausbauziele beibehalten: »Ansonsten werden wir unsere Klimaschutzziele sicher verfehlen.«“"
                            },
                            {
                                "example_id": "18bb33da-0306-4711-a48b-c15298110e24",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Ladesäulen für Elektroautos:] „Der deutsche Marktführer in Sachen Ladeinfrastruktur, der Karlsruher Energiekonzern EnBW, hat sein Ausbauziel […] gedrosselt.“"
                            },
                            {
                                "example_id": "7b06b6b5-67e5-44ce-9edd-37c6591140e3",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Mobilfunknetz:] „Im Jahr 2023 verfehlte 1&1 seine Ausbauziele, weshalb die Bundesnetzagentur ein Bußgeldverfahren einleitete.“"
                            },
                            {
                                "example_id": "0922e80a-d2be-47ca-a40b-072308502484",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Hamburger Landesregierung: Es] „findet sich kein konkretes jährliches Ausbauziel von Radwegen mehr im Koalitionsvertrag.“"
                            },
                            {
                                "example_id": "6fabfe3e-1ce6-42df-b738-3c74578fb5e6",
                                "sense_id": "1593baa6-e680-3841-8fc5-164cd446cdb8",
                                "text": "[Schlagzeile:] „Kühnert hält an Ausbauziel für Wohnungen fest“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
