                                        "examples": [
                                            {
                                                "example_id": "a5f34591-311b-4bcf-a682-6b6dc98e0824",
                                                "sense_id": "08aff08b-9d09-36d2-a35a-b1b221799660",
                                                "text": "The Muslim community as the pan-Islamic thinkers conceived it, or the Jewish community of the Zionists, was not held together by common profession of faithor the will to live in accordance with revealed law."
                                            },
                                            {
                                                "example_id": "12cf30d3-3e9e-42e8-bd5c-80ec91ab635a",
                                                "sense_id": "08aff08b-9d09-36d2-a35a-b1b221799660",
                                                "text": "In the following years, Lord Cromer fought vigorously against pan-Islamist propaganda, banning, for instance, the popular Paris-published pan-Islamic journal al'Urwa alWuthqa (The Firmest Bond)."
                                            },
                                            {
                                                "example_id": "29c6a53a-8e4c-4250-9928-cc5530c51e1d",
                                                "sense_id": "08aff08b-9d09-36d2-a35a-b1b221799660",
                                                "text": "He went to Peshawar in 1987 and met with Azzam, who convinced him that the struggle in Afghanistan should be a pan-Islamic struggle and should get top attention from Islamists."
                                            }
                                        ]
                                    }
                                ]
                            }
