                    {
                        "sense_id": "1057d52f-eedf-3e59-8fc0-82ab9bc0c1a8",
                        "entry_id": "a1f5a4de-4bae-3987-b2c2-a5562f4cc22c",
                        "glosses": [
                            "Qui tient au palais, à la partie supérieure du dedans de la bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6905c7-f309-4e2c-a7f2-3f797772afba",
                                "sense_id": "1057d52f-eedf-3e59-8fc0-82ab9bc0c1a8",
                                "text": "Voûte palatale."
                            },
                            {
                                "example_id": "43833217-1e2c-4514-b51a-965b34263d4a",
                                "sense_id": "1057d52f-eedf-3e59-8fc0-82ab9bc0c1a8",
                                "text": "Artère palatale."
                            },
                            {
                                "example_id": "3b4b5c72-ac2d-44b3-aec0-13ce827c767c",
                                "sense_id": "1057d52f-eedf-3e59-8fc0-82ab9bc0c1a8",
                                "text": "Abcès palatal."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb03ca2b-9dbb-33f9-97bd-a37bb43394a8",
                        "entry_id": "a1f5a4de-4bae-3987-b2c2-a5562f4cc22c",
                        "glosses": [
                            "Se dit des voyelles ou des consonnes dont le point d’articulation se situe au niveau du palais dur, à l’avant de la cavité buccale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26bf510f-2e55-42ae-8f43-58f2c6fe8492",
                                "sense_id": "eb03ca2b-9dbb-33f9-97bd-a37bb43394a8",
                                "text": "Le consonantisme français contient, en particulier, la nasale palatale, la fricative ou vibrante uvulaire, l'articulation dentale des [t d n]. L'anglais a des fricatives dentales, la nasale vélaire, les affriquées, les [p t k] aspirés sous accent, l'assibilation des [s z t d]."
                            },
                            {
                                "example_id": "561ff3bc-d28b-460a-836f-47f600e386dc",
                                "sense_id": "eb03ca2b-9dbb-33f9-97bd-a37bb43394a8",
                                "text": "[j] et [ɲ] sont une semi-consonne et une consonne palatales. En français, les voyelles [i], [e], [ɛ], [y], [ø] sont palatales."
                            }
                        ]
                    }
