                "senses": [
                    {
                        "sense_id": "2f163e6a-39c9-3534-8efb-c99c15fcfde6",
                        "entry_id": "919dfeb5-c331-3ba1-9aa7-b38a03d0e442",
                        "glosses": [
                            "an der Ostsee gelegenes Seebad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f66025f4-cd33-4e80-af0c-6c7ed522cdca",
                                "sense_id": "2f163e6a-39c9-3534-8efb-c99c15fcfde6",
                                "text": "\"Ein Ostseebad - zwei Kindertagesstätten. Weil Kitaplätze in Zinnowitz rar sind, soll ab 1. September eine zweite Einrichtung eröffnet werden.\""
                            },
                            {
                                "example_id": "783e3746-a5e4-499d-b21b-0d1d13c22768",
                                "sense_id": "2f163e6a-39c9-3534-8efb-c99c15fcfde6",
                                "text": "„Im Osten, hinter der Zingster Heide und der Straminke, grenzt das Ostseebad Zingst an das Waldmassiv des Ostzingstes; im Westen an das Waldgebiet des Freesenbruches, das sich jenseits der Umgehungsstraße die weiten Wiesen zu beiden Seiten des Prerowstromes anschließen.“"
                            },
                            {
                                "example_id": "1dbc60f4-e81d-432c-af96-34290c0c2286",
                                "sense_id": "2f163e6a-39c9-3534-8efb-c99c15fcfde6",
                                "text": "„Auf dem Programm standen die Besichtigung der neuen Mosaikfenster im Dom, ein historischer Stadtspaziergang, Gespräche mit Germanistikstudenten, auch ein Abstecher zu den Ostseebädern und zu Manns Sommerhaus in Nidden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
