                ],
                "senses": [
                    {
                        "sense_id": "21ced8ca-c6e6-3599-bbed-de7f6b94e0af",
                        "entry_id": "7e67cb05-7508-3407-87ee-ea141fea411e",
                        "glosses": [
                            "Genre de poissons d'eau douce ayant pour type la carpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b0b050-177f-472c-a586-8b1bfd916bc0",
                                "sense_id": "21ced8ca-c6e6-3599-bbed-de7f6b94e0af",
                                "text": "Sous les saules pourris, des coins d’eau s’ouvraient, profonds et calmes, rayés par la danse grêle des cyprins."
                            },
                            {
                                "example_id": "226b8ff2-bb57-4cf5-8631-a9de1d4fafea",
                                "sense_id": "21ced8ca-c6e6-3599-bbed-de7f6b94e0af",
                                "text": "La maison vibrait du cri plaisant qu'il poussait […] quand il nourrissait l'insinuant cyprin du bassin …."
                            }
                        ]
                    },
                    {
                        "sense_id": "63620dd6-af43-39a3-9302-7ca73cce2fd5",
                        "entry_id": "7e67cb05-7508-3407-87ee-ea141fea411e",
                        "glosses": [
                            "Carassin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "159be5f3-eb95-4dc7-be6b-4a72288bf128",
                                "sense_id": "63620dd6-af43-39a3-9302-7ca73cce2fd5",
                                "text": "Il y avait encore des rougets de roche, à la chair exquise, du rouge enluminé des cyprins."
                            },
                            {
                                "example_id": "0707021b-645e-46b7-a562-70d24dceecb8",
                                "sense_id": "63620dd6-af43-39a3-9302-7ca73cce2fd5",
                                "text": "Les spécimens de petite taille seront avides de plancton et de larves d’insectes tandis que les palettes, pouvant mesurer jusqu’à 30 et même 35 cm, raffoleront de petites perchaudes et autres cyprins ainsi que de crustacés comme des gammares, aussi appelés crevettes d’eau de façon erronée."
                            }
                        ]
                    }
                ],
