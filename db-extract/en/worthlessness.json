                "senses": [
                    {
                        "sense_id": "d90a7877-d4be-3aa7-a064-508814ce27f3",
                        "entry_id": "9f8511de-ac84-3f97-b6a4-ea0ebef504f4",
                        "glosses": [
                            "The quality of lacking worth, of being valueless, useless or devoid of benefit."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "81b408ce-db2a-429b-882d-4583255a0292",
                                "sense_id": "d90a7877-d4be-3aa7-a064-508814ce27f3",
                                "text": "Kids these days far too often attribute low academic grades to feelings of worthlessness."
                            },
                            {
                                "example_id": "e691c74a-94bb-444b-980d-116549014208",
                                "sense_id": "d90a7877-d4be-3aa7-a064-508814ce27f3",
                                "text": "We see men of all kinds of professed creeds attain to almost all degrees of worth or worthlessness under each or any of them."
                            },
                            {
                                "example_id": "0ee63e02-9c1d-480c-9af6-ed75c4902c15",
                                "sense_id": "d90a7877-d4be-3aa7-a064-508814ce27f3",
                                "text": "This general teaching as to the worthlessness of alcohol as a food had been set forth by the leaders in medical profession, and accepted largely by the rank and file of practitioners for about twenty-five years."
                            }
                        ]
                    }
                ],
