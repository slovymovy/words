        "fr-extract.jsonl": [
            {
                "entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                "word": "monothéiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "41a0cc42-3f40-42bb-aceb-b7bfb060bc9d",
                        "entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monothéistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                        "entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                        "glosses": [
                            "Relatif au monothéisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b334d3f-d6d9-4211-895a-167817e79cc2",
                                "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                                "text": "Affichant non sans panache un athéisme militant, il appelle à en finir avec une certaine tolérance envers les religions monothéistes, intrinsèquement intolérantes et pétries de haine."
                            },
                            {
                                "example_id": "e7dad415-3648-43c0-8dc8-a9781b9cfdda",
                                "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                                "text": "Paradoxe du discours monothéiste : il proclame le dieu unique et exacerbe (le mot est faible) depuis trois mille ans les différences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5438794-12a7-4427-8d42-21abbb85d3fe",
                        "source_entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                        "source_sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                        "target_lang_word": "monotheistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotheistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                        "entry_id": "85d1ebdd-dfc1-3835-a118-e9988adc7a5e",
                                        "glosses": [
                                            "sich auf den Monotheismus beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5e1dc1-a70b-42a8-b4b2-198c88e6e373",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Demzufolge wären die drei monotheistischen Religionen gleichgeartet, und der demokratische Staat müsste nur danach trachten, jeglicher Glaubensrichtung neutral gegenüberzustehen.“"
                                            },
                                            {
                                                "example_id": "16520ccc-d6a3-43c7-98bf-c9d35843d243",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Der Papst sprach sich für die freie Religionsausübung aller drei großen monotheistischen Glaubensrichtungen in der für sie heiligen Stadt Jerusalem aus:“"
                                            },
                                            {
                                                "example_id": "7119ea3a-af9c-42d7-a22e-4018d4f25d63",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Ob im alten Ägypten, im alten China oder in der biblischen Genesis, in welcher der monotheistische Gott dem Menschen bei dessen Erschaffung den Odem des Lebens einhaucht: Die Seele hat Eigenschaften des Atems, des Windes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb265fd4-0172-451b-abf2-d05ac38bd131",
                        "source_entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                        "source_sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
