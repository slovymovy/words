                "senses": [
                    {
                        "sense_id": "efd6e6eb-4fce-3aa9-8692-fc0fc79dd9cb",
                        "entry_id": "5cde046d-799f-3a24-ad60-f85495a967d1",
                        "glosses": [
                            "Sorte de dard dont la pointe ou harpoise est accompagnée de crocs et dont on se sert spécialement pour la pêche des cétacés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc317b9-46f1-48d3-806f-a5da3d47d679",
                                "sense_id": "efd6e6eb-4fce-3aa9-8692-fc0fc79dd9cb",
                                "text": "La pêche au harpon."
                            },
                            {
                                "example_id": "91b8260c-1812-481e-8955-64ea7c246b06",
                                "sense_id": "efd6e6eb-4fce-3aa9-8692-fc0fc79dd9cb",
                                "text": "Jeter, lancer le harpon."
                            },
                            {
                                "example_id": "775ca569-a596-4689-8eb4-55fb15c0afec",
                                "sense_id": "efd6e6eb-4fce-3aa9-8692-fc0fc79dd9cb",
                                "text": "Attaquer au harpon."
                            },
                            {
                                "example_id": "42db50be-a695-4f37-afa9-e36f961991fc",
                                "sense_id": "efd6e6eb-4fce-3aa9-8692-fc0fc79dd9cb",
                                "text": "Je me lève, la jambe droite en avant, le harpon à la main, paré pour le moment où j’apercevrais la baleine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce3c272d-f099-3675-a2d9-39202b6d3f29",
                        "entry_id": "5cde046d-799f-3a24-ad60-f85495a967d1",
                        "glosses": [
                            "Bande de fer plat, droite, coudée d’un bout, percée de l’autre de plusieurs trous, avec un talon servant à la fixer sur le bois. Le harpon sert à lier les pièces d’un pan de bois, les plates-formes d’un comble"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4592e44c-26fb-4d8d-bab0-062da41ce1fb",
                        "source_entry_id": "5cde046d-799f-3a24-ad60-f85495a967d1",
                        "target_lang_word": "Harpune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harpune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                        "entry_id": "d10a75ba-6743-391d-a048-880e11d19e13",
                                        "glosses": [
                                            "Speer mit Widerhaken für den Fischfang oder Walfang"
                                        ],
                                        "tags": [
                                            "Fischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d6bd42-f9c5-40b8-802e-74a1fa2db2d1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Wie die Umweltschutzorganisation mitteilte, feuerte ein Walfänger beim Schuss auf einen Zwergwal eine Harpune nur einen Meter über ein Greenpeace-Schlauchboot.“"
                                            },
                                            {
                                                "example_id": "6149e4c5-7706-4227-a125-c51d10ccf919",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Besser wäre es natürlich, die Harpune mitzunehmen, einen Riesenfisch zu harpunieren und ihn an Land zu ziehen.“"
                                            },
                                            {
                                                "example_id": "d87e4873-b967-469e-89cd-5382647ee7e9",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Er legt ein unvermutetes Talent für das Wattfischen - mit einer kleinen selbst gefertigten Harpune - an den Tag.“"
                                            },
                                            {
                                                "example_id": "eefc5ace-d84f-43ea-8cc3-77ffef11c5c1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Nach vier erfolglosen Versuchen warf er die Harpune ins Boot, zog sich an Bord und setze sich schweigend ins Heck, um das Paddel wieder aufzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
