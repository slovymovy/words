                            {
                                "example_id": "02adfa03-71fe-46d7-a6af-cc470ecb3e37",
                                "sense_id": "95f963f4-546e-3da7-8328-5266efe2f85d",
                                "text": "„Wir Schauspielschüler besuchten Partys, wurden eingeladen und herumgereicht.“"
                            },
                            {
                                "example_id": "bf89fb78-71f8-4f22-8eb1-2cc36dfd0e32",
                                "sense_id": "95f963f4-546e-3da7-8328-5266efe2f85d",
                                "text": "„Die Schauspielschüler saßen ganz vertieft da, studierten die Seiten, auf denen ihre Texte standen, und schauten nur kurz hoch, als Chrissi und Spyro dazukamen.“"
                            }
                        ],
