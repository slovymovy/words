                "senses": [
                    {
                        "sense_id": "def737e7-8eae-36d3-9217-21074e3c5d67",
                        "entry_id": "efafbe4e-b590-365b-bc29-52ca7e9bc13c",
                        "glosses": [
                            "Royaliste britannique resté fidèle à Jacques II et à ses successeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab18624-f336-4727-bbd5-78de47615f2d",
                                "sense_id": "def737e7-8eae-36d3-9217-21074e3c5d67",
                                "text": "Son destin fut différent de celui des deux autres cofondateurs de la Loge de Saint-Thomas, parce que, esprit réaliste, il n’était pas un jacobite outré et, de plus, il était trop francisé déjà pour nourrir des espérances que la réalité devait déméntir de la plus cruelle façon."
                            },
                            {
                                "example_id": "e59a6a9d-aaee-4978-a021-77be012e7ade",
                                "sense_id": "def737e7-8eae-36d3-9217-21074e3c5d67",
                                "text": "Il se dessina fantastiquement non pas le nommé Rifoël, mais un chevalier du Vissard, une jeune homme quasi semblable au Fergus de Walter Scott, enfin le jacobite français."
                            }
                        ]
                    }
