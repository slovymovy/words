                                            {
                                                "example_id": "e4169d15-6b64-4db9-b53f-ea9748df7e3d",
                                                "sense_id": "65bd948d-1657-330f-a178-2636223f4e99",
                                                "text": "À Volokhivka même, on s’identifie entre voisins comme « russophone » ou « ukrainien », chacun parlant, m’a-t-il semblé, son propre mélange. Pour certains, c’est une base grammaticale ukrainienne émaillée de russismes. D’autres, au contraire décorent leur russe d’un lexique largement ukrainien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe7c03d-9816-3f5e-997e-d17fc0a47735",
                                        "entry_id": "69e139bc-115b-34e3-abd0-66d6df9a84f5",
                                        "glosses": [
                                            "Mot, expression, tournure d’origine russe introduite par emprunt dans une autre langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff9bfbc-fc7c-445f-8e7d-c95f0c048644",
                                                "sense_id": "afe7c03d-9816-3f5e-997e-d17fc0a47735",
                                                "text": "Les termes perestroïka, tsar ou glasnost sont des russismes que l’on utilise en français."
                                            }
                                        ]
                                    }
                                ]
                            }
