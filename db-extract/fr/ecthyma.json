                "senses": [
                    {
                        "sense_id": "6d1bfe90-5d80-3a63-ac7d-f7944a50d003",
                        "entry_id": "8122cc6a-8ec9-303e-a7e1-974adafdccac",
                        "glosses": [
                            "Une infection grave de la peau de l’être humain ou des animaux avec ulcères, pustules profondes puis croûtes, une forme ulcérée de l’impétigo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e5b9b3c-b508-491b-a926-ae764c12f257",
                                "sense_id": "6d1bfe90-5d80-3a63-ac7d-f7944a50d003",
                                "text": "M. Alix assimile complètement le clou de Biskra à l’ecthyma cachectique; nous ne saurions admettre cette assimilation au point de vue des lésions cutanées qui sont très différentes dans les deux dermatoses; […]."
                            },
                            {
                                "example_id": "00d370c5-7266-45cd-b799-f0339b5a70e7",
                                "sense_id": "6d1bfe90-5d80-3a63-ac7d-f7944a50d003",
                                "text": "Dans l’ecthyma cyanotique et nécrotique, la nécrose est un élément secondaire et non prépondérant, dû au terrain et non à l’infection."
                            },
                            {
                                "example_id": "4c40f7e6-5a09-4be3-95a0-c79ba2796e60",
                                "sense_id": "6d1bfe90-5d80-3a63-ac7d-f7944a50d003",
                                "text": "J’avais l’expérience de douleurs injustifiées ; il m’arrivait de me cogner, de m’écorcher ; une éruption d’ecthyma m’avait défigurée : un médecin brûlait mes pustules avec du nitrate d’argent et je criais."
                            }
                        ]
                    }
                ],
