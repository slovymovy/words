                        "examples": [
                            {
                                "example_id": "80d43d08-25c6-473d-8ea5-5c6729c0ee4e",
                                "sense_id": "30f5e678-c834-3090-8975-f60930803a1d",
                                "text": "It is time we forgot the old distinctive class borderline between the snapshotter and the amateur photographer, which was based on the capabilities of the equipment the two sectors used."
                            },
                            {
                                "example_id": "bf5b8c0c-6bd7-4e06-9c6b-e636598d8706",
                                "sense_id": "30f5e678-c834-3090-8975-f60930803a1d",
                                "text": "The implication is that the snapshotter, because of his unwillingness to slow down and perceive the complexity of the unmediated landscape, could only wreak havoc with his camera."
                            }
                        ]
                    }
