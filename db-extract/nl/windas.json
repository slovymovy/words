                                        "sense_id": "40aa5c83-a03b-3db7-a190-c0fa6f1c66e2",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "Any of various forms of winch, in which a rope or cable is wound around a cylinder, used for lifting heavy weights"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cbc2fe9-3867-3294-907f-eaf02b3a6d64",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "A winding and circuitous way; a roundabout course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2077fa6f-dabd-4f50-94c3-b10f4f0315b4",
                                                "sense_id": "5cbc2fe9-3867-3294-907f-eaf02b3a6d64",
                                                "text": "With windlasses and with assays of bias, / By indirections find directions out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14193a94-c5a8-37d1-a6bc-b5876e12f71a",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "An apparatus resembling a winch or windlass, for bending the bow of an arblast, or crossbow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "windlass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae624265-34f5-3e13-b1f9-6bf08202bb00",
                                        "entry_id": "60d01d72-e4fa-34aa-a549-75f459ede026",
                                        "glosses": [
                                            "To raise with, or as if with, a windlass; to use a windlass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecca0899-9b61-4dd9-a75d-6a062bf03933",
                                                "sense_id": "ae624265-34f5-3e13-b1f9-6bf08202bb00",
                                                "text": "A favoring breeze enabled us to sail all the way down the lake, and (having been windlassed across the haul-over) even down the canals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3506ca8b-4161-3560-9168-f307cded999f",
                                        "entry_id": "60d01d72-e4fa-34aa-a549-75f459ede026",
                                        "glosses": [
                                            "To take a roundabout course; to work warily or by indirect means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45894b47-e2c6-4d28-9b0e-95c95bb152b5",
                                                "sense_id": "3506ca8b-4161-3560-9168-f307cded999f",
                                                "text": "He could not expect to allure him forward, and therefore drives him as far back as he can; that so he may be the more sure of him at the rebound; as a skilful woodsman, that by windlassing presently gets a shoot, which, without taking a compass and thereby a commodious stand, he could never have obtained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13e2f42a-6d76-493e-90e9-6570cb7b5692",
                        "source_entry_id": "cc90c9bc-3b84-3756-8632-1af9e59ca533",
                        "source_sense_id": "147517ac-3473-3fd3-b805-c9cb8a5f4283",
                        "source_sense_description": "windas",
                        "target_lang_word": "treuil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treuil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d86d5587-97c5-36a5-92ec-7a7866927048",
                                        "entry_id": "37f54861-ed13-3a4c-ae84-331e73813f8f",
                                        "glosses": [
                                            "Appareil de levage ou de tirage formé d’un cylindre horizontal appelé tambour, tournant sur un axe et qui assure l'enroulement libre du câble. Le treuil peut être, comme le treuil de halage, entraîné manuellement par une manivelle et un pignon qui engrène directement sur une grande couronne dentée associée au tambour, ou actionné par un moteur à vapeur, thermique ou électrique."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5863ffa8-c525-4f5b-b671-f0c55c3ca02d",
                                                "sense_id": "d86d5587-97c5-36a5-92ec-7a7866927048",
                                                "text": "…on monte ce châssis à l’aide d’un treuil disposé à cet effet, et on le fait passer dans l'appareil."
                                            },
                                            {
                                                "example_id": "e5a3da51-7e2f-4f1d-bc32-1a73548f03c6",
                                                "sense_id": "d86d5587-97c5-36a5-92ec-7a7866927048",
                                                "text": "Un embrayage à roue libre, combiné avec un enclenchement à clabots relie l’arbre du frein auxiliaire à l’arbre principal du treuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c36f6b8-ae85-362d-b287-24d6bf5c6429",
                                        "entry_id": "37f54861-ed13-3a4c-ae84-331e73813f8f",
                                        "glosses": [
                                            "Pressoir à raisins."
                                        ],
                                        "tags": [
                                            "Charente",
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1175e46c-f733-4652-b935-3a5bb8e0e431",
                                                "sense_id": "1c36f6b8-ae85-362d-b287-24d6bf5c6429",
                                                "text": "Les pressoirs seuls restaient ouverts pour donner de l’air aux planchers des treuils, et d’un bout à l’autre du village une moiteur de raisins pressés, la chaude exhalaison des vins qui fermentent, se mêlaient à l’odeur des poulaillers et des étables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6312b45-d23e-40d5-b4ce-2c3071a04b7a",
                        "source_entry_id": "cc90c9bc-3b84-3756-8632-1af9e59ca533",
                        "source_sense_id": "147517ac-3473-3fd3-b805-c9cb8a5f4283",
                        "source_sense_description": "windas",
                        "target_lang_word": "cabestan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabestan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a85032e8-077b-3516-b46e-834a9550a957",
                                        "entry_id": "1a047444-1b5c-31e6-a20f-f011b6e732c0",
                                        "glosses": [
                                            "Système tournant dont l’axe vertical permet, en enroulant un câble, de déployer une force très importante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f6ef05-c1df-4436-9948-6a7e6d9754dd",
                                                "sense_id": "a85032e8-077b-3516-b46e-834a9550a957",
                                                "text": "J.-T. Maston avait vissé son crochet dans la lisse de la dunette, et il aurait fallu un cabestan pour l’en arracher."
                                            },
                                            {
                                                "example_id": "60aadbbb-a55f-4820-9288-0dc8a29906c8",
                                                "sense_id": "a85032e8-077b-3516-b46e-834a9550a957",
                                                "text": "Un de ses hommes, qui s’était écrasé deux doigts en tournant un cabestan, n’avait obtenu que cinq mille francs, mais c’étaient des doigts de la main gauche."
                                            },
                                            {
                                                "example_id": "d2edf8e3-2795-4bed-86f7-436cee47e082",
                                                "sense_id": "a85032e8-077b-3516-b46e-834a9550a957",
                                                "text": "Après qu'elle est bien fichée faisant approcher le navire d'où est la dite ancre à force du tour du cabestan"
