                "senses": [
                    {
                        "sense_id": "bfdd56cd-5477-3bf8-a9f4-912e256b9e50",
                        "entry_id": "c1403246-1543-36ad-9f58-e898ec8b4494",
                        "glosses": [
                            "(keine noch so) minimale Äußerung"
                        ],
                        "tags": [
                            "nur in verneinenden Formulierungen"
                        ],
                        "examples": [
                            {
                                "example_id": "96336144-37ea-4529-afee-342ba2436d1e",
                                "sense_id": "bfdd56cd-5477-3bf8-a9f4-912e256b9e50",
                                "text": "„Ich erfuhr seine Art, auf Menschen hinzusehen: lange, solange sie eben zu sehen waren, ohne auch nur eine Sterbenssilbe über das Gesehene zu äußern;…“"
                            },
                            {
                                "example_id": "2b1c6ab4-cad4-4244-9f51-e8201699c7d8",
                                "sense_id": "bfdd56cd-5477-3bf8-a9f4-912e256b9e50",
                                "text": "„»Was sagt er?«, rief Kapitän Meier jetzt, der ungeduldig wurde; »das ist ja ein verdammtes Kauderwelsch, von dem man nicht eine Sterbenssilbe versteht.«“"
                            },
                            {
                                "example_id": "a94039f9-1923-49b2-b925-f72f5503e584",
                                "sense_id": "bfdd56cd-5477-3bf8-a9f4-912e256b9e50",
                                "text": "„»Eine Kleinigkeit, die Angst besorgter Eltern um Ihre Kinder! – Fünf Stunden von Hause fort, ohne eine Sterbenssilbe mir zurückzulassen, und die Kleinen mitgenommen, ohne um Erlaubnis zu fragen!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
