                        "target_lang_word": "Ansteckung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansteckung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9db69f7a-17c3-33ed-a2c8-fe529106d76a",
                                        "entry_id": "8c346a34-d986-36aa-9394-3461704c0c7a",
                                        "glosses": [
                                            "Übertragung einer Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b5b77a-42b8-4d47-a17f-41161e8286b1",
                                                "sense_id": "9db69f7a-17c3-33ed-a2c8-fe529106d76a",
                                                "text": "Die Ansteckung soll durch eine Impfung unterbunden werden."
                                            },
                                            {
                                                "example_id": "99a73ff2-2e0e-4450-922e-e652c828ce76",
                                                "sense_id": "9db69f7a-17c3-33ed-a2c8-fe529106d76a",
                                                "text": "Als sich Angehörige des Klinikpersonals an [mit dem Erreger des damals unbekannten Marburg-Fiebers] verseuchten Nadeln infizieren, wird die Furcht vor der Ansteckung von Mensch zu Mensch groß."
                                            },
                                            {
                                                "example_id": "89839720-84f8-410f-837e-76e0f88b59cc",
                                                "sense_id": "9db69f7a-17c3-33ed-a2c8-fe529106d76a",
                                                "text": "„Der Schutz vor einer Ansteckung mit dem Coronavirus lässt einer britischen Studie zufolge bereits einige Monate nach der vollständigen Impfung etwas nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd7f88c9-b843-4ce5-a5c5-de1d2a24cb80",
                        "source_entry_id": "e4267ccb-7e10-3973-836a-9ce4b781c809",
                        "source_sense_id": "bf3b949c-51d1-361b-988e-4bc8cedf1c1b",
