                    },
                    {
                        "form_id": "cbd63dd6-2eb6-4c69-b5c0-097df7c6eb3f",
                        "entry_id": "f1ad423a-9da1-312d-9a70-ea413a8b04d4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most fussed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                        "entry_id": "f1ad423a-9da1-312d-9a70-ea413a8b04d4",
                        "glosses": [
                            "Bothered; concerned."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "6f6a6a66-74a1-4f90-8de7-e2a5dd7cb00f",
                                "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                                "text": "He's just not that fussed about going to the party."
                            },
                            {
                                "example_id": "528f9524-8efe-4d2d-ae44-8bb1c370e442",
                                "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                                "text": "It's all right, I tell you. Can't you see I'm not fussed, not at all fussed?"
                            },
                            {
                                "example_id": "55e1a6b0-16ec-4e54-8672-5584d879372c",
                                "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                                "text": "An added bonus is that this system protects you against impulse purchases of stuff you're not really fussed about as you have to focus your mind on what you'll chuck out when you get home."
                            },
                            {
                                "example_id": "13ca6535-9d2d-45cc-9148-feac65353d87",
                                "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                                "text": "You know when the person comes to me all fussed up about their husbands or vice versa, I say, \"I'm not fussed about them. I'm fussed about you.\""
                            },
                            {
                                "example_id": "863e7d94-a9ba-4bb1-9fef-ab5fd93a8326",
                                "sense_id": "4659ce57-f777-398e-bfc7-81bfbfd804c8",
                                "text": "This may be a useful lesson beyond the realms of longevity in a world more fussed about efficiency than effectiveness."
                            }
                        ]
                    }
                ],
