                    "frequency": "VeryLow",
                    "semantic_group_id": "héraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason officiel de la commune comporte un <w>homard</w> d'or sur fond bleu."
                        },
                        {
                            "text": "Cette ancienne bannière représentait deux <w>homards</w> stylisés tournés vers le haut."
