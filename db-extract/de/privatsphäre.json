                ],
                "senses": [
                    {
                        "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                        "entry_id": "52524c71-0e6c-3666-aae0-cfed6146003e",
                        "glosses": [
                            "grundgesetzlich geschütztes, persönliches Lebensumfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6ff8c3-2ce1-4f52-a1a2-83c7587cbaff",
                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                "text": "Zur Verwendung anonymer Nutzerkennzeichnungen: „Für die einen ist genau sie eine der großen Stärken des Netzes, ein Garant für Meinungsfreiheit und Privatsphäre.“"
                            },
                            {
                                "example_id": "3d70f853-de3b-40b0-a709-2b34fb27d61e",
                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                "text": "„Holländer benutzen ohne weiteres mit Hunderten Wildfremden zusammen die sanitären Anlagen auf einem Campingplatz, doch wenn es um die eigene Wohnung geht, soll die Privatsphäre gleich unten an der Straße beginnen.“"
                            },
                            {
                                "example_id": "1a90fc2a-6648-4194-a3d0-9baff8446086",
                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                "text": "„Eine Privatsphäre gab es nicht.“"
                            },
                            {
                                "example_id": "00a288ba-c4ad-4496-b761-8313faad92a5",
                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                "text": "„Dann hörte man ein Rumpeln und Quietschen, und wir gingen aus Achtung vor der Privatsphäre hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e0a3250-52e7-479c-85ab-0110bd8a0eb2",
                        "source_entry_id": "52524c71-0e6c-3666-aae0-cfed6146003e",
                        "source_sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                        "source_sense_description": "grundgesetzlich geschütztes, persönliches Lebensumfeld",
                        "target_lang_word": "privacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "The state of being secluded from the presence, sight, or knowledge of others."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1d6ce4-ca51-4123-8a45-9fae37123fa1",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "I need my privacy, so please stay out of my room."
                                            },
                                            {
                                                "example_id": "50bd5f3e-387c-48c9-90c3-8098210a7627",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "8bc80b0a-7be9-49ac-8c84-f77766e18e67",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "It is realised that the old Pullman standard sleeper, with its convertible \"sections\", each containing upper and lower berths, and with no greater privacy at night than the curtains drawn along both sides of a middle aisle, has had its day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe917e7-32b9-325c-9247-c788a9e161ea",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Freedom from unwanted or undue disturbance of one's private life."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3b0435-5799-4054-b2e9-0a9949127153",
                                                "sense_id": "cbe917e7-32b9-325c-9247-c788a9e161ea",
                                                "text": "It takes a village to rob one of a sense of privacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c986a82-281d-351f-937c-f6d05000e999",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Freedom from damaging publicity, public scrutiny, surveillance, and disclosure of personal information, usually by a government or a private organization."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "260e5727-05ad-49c4-8a02-e620fa324413",
                                                "sense_id": "0c986a82-281d-351f-937c-f6d05000e999",
                                                "text": "Privacy is assumed by many to be among common-law rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f62a2e7-f7bf-3e23-a402-52a5f71843f8",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A place of seclusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92c6d585-71d4-3b89-84b7-ae7f8f0eba71",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A relationship between parties seen as being a result of their mutual interest or participation in a given transaction, contract etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86afa88f-e1a6-3d3b-8025-116fc5582700",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Secrecy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2f90340-0085-3325-a80e-e127bcd94a02",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A private matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b792e945-96d9-4af2-be69-3a580fa154ec",
                                                "sense_id": "d2f90340-0085-3325-a80e-e127bcd94a02",
                                                "text": "It ſeems more probable that Ovid vvas either the Confident of ſome other paſſion, or that he had ſtumbled by ſome inadvertency, upon the privacies of Livia, and ſeen her in a Bath: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89dc17eb-dfdb-41c4-994a-81287cca3bc4",
                        "source_entry_id": "52524c71-0e6c-3666-aae0-cfed6146003e",
                        "source_sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                        "source_sense_description": "grundgesetzlich geschütztes, persönliches Lebensumfeld",
                        "target_lang_word": "private sphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9992ed66-76d3-4ced-9cc6-5da057f5af71",
                        "source_entry_id": "52524c71-0e6c-3666-aae0-cfed6146003e",
                        "source_sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                        "source_sense_description": "grundgesetzlich geschütztes, persönliches Lebensumfeld",
                        "target_lang_word": "sphère privée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphère privée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "195312ff-4c4d-3dd5-90f2-a19ec7014545",
                                        "entry_id": "7a7112e6-6eb0-36a7-a4b5-9f5f14baf407",
                                        "glosses": [
                                            "Partie de la vie strictement réservée à une personne et dont elle décide des limites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff99b48a-d131-4eb6-80dc-e2386c9a4223",
                                                "sense_id": "195312ff-4c4d-3dd5-90f2-a19ec7014545",
                                                "text": "La police a le mandat d'entrer sans l'accord de l'habitant dans la sphère privée. Parce qu'il y a de sérieux indices..."
                                            },
                                            {
                                                "example_id": "986b934d-d971-4788-9720-973452531f00",
                                                "sense_id": "195312ff-4c4d-3dd5-90f2-a19ec7014545",
                                                "text": "« La liberté telle que nous l’avons connue, avec la protection absolue d’une sphère privée n’appartenant qu’à l’individu, est une notion en train de disparaître. … La défense acharnée de la vie privée devient une cause oubliée, à cause de la propension des individus à exhiber tous les détails de leur vie, et de leur consentement aussi à la surveillance. »"
                                            },
                                            {
                                                "example_id": "5f0f661e-c2c1-4ad7-a396-a21745f0cb09",
                                                "sense_id": "195312ff-4c4d-3dd5-90f2-a19ec7014545",
                                                "text": "La sphère privée est perçue, non sans raison, comme une zone de choix individuel et même d’autonomie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
