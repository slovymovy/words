                "senses": [
                    {
                        "sense_id": "47e028c0-3f4a-3f18-b10f-03c0456d92e8",
                        "entry_id": "53c453f6-4a5b-3ef6-95cb-b3a7f890ba41",
                        "glosses": [
                            "Airline, die ihre Flüge zu sehr niedrigen Preisen anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d28436e-68b6-4e49-bf01-123e83663233",
                                "sense_id": "47e028c0-3f4a-3f18-b10f-03c0456d92e8",
                                "text": "Herr Schröder hat schon gute, aber auch schlechte Erfahrungen mit Billigairlines gemacht."
                            },
                            {
                                "example_id": "c5ef89cf-b1cb-4bfb-8d35-00b2588bd7eb",
                                "sense_id": "47e028c0-3f4a-3f18-b10f-03c0456d92e8",
                                "text": "Auf diesem Flughafen landen vor allem Flugzeuge einer bestimmten Billigairline."
                            },
                            {
                                "example_id": "6693ea8f-5984-4198-a1b8-a0efddb9b452",
                                "sense_id": "47e028c0-3f4a-3f18-b10f-03c0456d92e8",
                                "text": "„Vergangene Woche hatte die Polizei den betroffenen Flughafen sowie Büros der Billigairline durchsucht.“"
                            }
                        ],
