                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96400208-db16-4f3d-98b9-96bfad30cc91",
                                                "sense_id": "2d241767-79ba-3422-aa68-3424bfefc5e8",
                                                "text": "Snijd de avocado overlangs doormidden. Verwijder de pit en schil en snijd het vruchtvlees in dunne plakken. Verdeel over de surimi-krabsalade."
                                            },
                                            {
                                                "example_id": "79f44b9d-5dd6-4716-becd-6dc26725b7dd",
                                                "sense_id": "2d241767-79ba-3422-aa68-3424bfefc5e8",
                                                "text": "Verwarm de oven voor. Bevochtig het brood, snijd het overlangs doormidden, leg het in de oven en warm de pide op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d81914f-342c-3e5c-8730-f1fdc65cb867",
