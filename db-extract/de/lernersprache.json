                                "sense_id": "a9fdb54d-4479-3e07-9fc8-ae624668929b",
                                "text": "„»Lerner verwenden Formeln und Routinen in ihrer Interlanguage (Lernersprache).«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
