                    "sense_id": "751a7d49-6cfc-399a-a858-ff4c0b5ecdf2",
                    "sense_definition": "Een lichtgevend hemellichaam dat als een klein puntje aan de nachtelijke hemel verschijnt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk naar de <w>ster</w> die daar zo fel aan de hemel staat.",
                            "target_lang_translations": {
