                "senses": [
                    {
                        "sense_id": "299fcec5-dc02-376e-99c8-ba6b57a13fe2",
                        "entry_id": "65cc2e86-44a9-39dd-890e-17a248a807b9",
                        "glosses": [
                            "Action de réorienter ; orientation vers un nouveau but."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c78d3253-fc70-4e76-a3d1-3763b6273650",
                                "sense_id": "299fcec5-dc02-376e-99c8-ba6b57a13fe2",
                                "text": "A l'instar de la commission facultaire d'admission, il existe à l'université, une commission de réorientation qui se réunit une fois par an, sous la présidence du recteur."
                            },
                            {
                                "example_id": "6710a1a8-c8f9-4272-bf36-0394146bb054",
                                "sense_id": "299fcec5-dc02-376e-99c8-ba6b57a13fe2",
                                "text": "Pour sortir l’Europe de sa crise, il faut une réorientation de la politique européenne."
                            },
                            {
                                "example_id": "3d565937-30a2-4bc9-b097-b7453c68b6e7",
                                "sense_id": "299fcec5-dc02-376e-99c8-ba6b57a13fe2",
                                "text": "[…]: les équipements sanitaires manquent partout alors que des pans de l’économie sont à l’arrêt. Dans un contexte d’urgence sanitaire, la réorientation paraît logique pour beaucoup d’industries, […]."
                            }
                        ]
                    }
