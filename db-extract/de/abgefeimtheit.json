                    {
                        "form_id": "702cbc47-0e66-4f82-bb9f-43779ccd0e96",
                        "entry_id": "95ca15f1-734f-392b-be8e-eca52bbe2b15",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Abgefeimtheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                        "entry_id": "95ca15f1-734f-392b-be8e-eca52bbe2b15",
                        "glosses": [
                            "Eigenschaft, auf unmoralische Art schlau zu sein, üble Tricks zu kennen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a629af34-cdba-41bc-9f9c-eede8cda93e8",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Er war ein Schüchterner, der sich unter Abgefeimtheit versteckte, und ein Zärtlicher, der sich vormachte, sein Feld sei die Leidenschaft.“"
                            },
                            {
                                "example_id": "8e1354a5-0443-4520-8fea-a5a0c9aef3d6",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Möge uns denn das Leben der Altväter ein Spiegelbild des sittlichen Wohlverhaltens sein, nicht eine Schule der Abgefeimtheit; ein ehrwürdiger Gegenstand der Nachahmung, nicht kniffiger Streitrede!“"
                            },
                            {
                                "example_id": "5108f152-8e15-435e-8bba-8ba76582dc6d",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Sie setzten sich in eine Ecke, und Xaver Wegrad fuhr fort, ihm zu erklären, wie die Welt in Wahrheit aussehe, und wie alles darin falscher Schein sei, Schwindel, Humbug, Betrug, Gaunerei und Abgefeimtheit.“"
                            },
                            {
                                "example_id": "c5d54d83-76d9-49ec-b73b-c8d02b715354",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Außerdem war er wirklich empört über die Abgefeimtheit der Kipper und Wipper, die inzwischen überall in den deutschen Fürstentümern und Ländereien ihr Unwesen trieben.“"
                            },
                            {
                                "example_id": "543df42b-22b5-4e8c-bd92-72ff511897ec",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Nichts entstammte dem Übermut, was er verübte, es war immer voller Tücke und Abgefeimtheit.“"
                            },
                            {
                                "example_id": "901ade21-6d29-40b9-8425-f89125e8f9ef",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Vorhin hatten sie mit einander gesprochen, und alle Bosheit und Abgefeimtheiten waren ans Licht gekommen.“"
                            },
                            {
                                "example_id": "5ebe6000-9b49-4574-ad74-ff9d3a3e4636",
                                "sense_id": "953d5c35-b89d-3e9d-809e-6052ca2382a1",
                                "text": "„Der Autor spiegelt den Alltag in der Stadt, zeigt die Heucheleien und Abgefeimtheiten der Mächtigen, reflektiert über die Probleme der ungleichen Gesellschaft.“"
                            }
                        ],
