                "senses": [
                    {
                        "sense_id": "7f83fd0a-d52d-3023-af89-cc5ea25d50b6",
                        "entry_id": "f5198cdd-ae2c-3229-8b3f-1dee1fbc18a9",
                        "glosses": [
                            "small, little (often implying affection)"
                        ],
                        "tags": [
                            "Polari"
                        ],
                        "examples": [
                            {
                                "example_id": "74d97b80-8eb6-4100-a1f2-95d9333aba68",
                                "sense_id": "7f83fd0a-d52d-3023-af89-cc5ea25d50b6",
                                "text": "You may have vada'd one of our tiny bijou masterpiecettes, heartface."
                            },
                            {
                                "example_id": "18b73be0-2ef0-476a-b32a-b53b0bf7db09",
                                "sense_id": "7f83fd0a-d52d-3023-af89-cc5ea25d50b6",
                                "text": "We, the Sister of Perpetual Indulgence and the Gathered Faithful, do hereby invoke the spirit of our beloved Muffin the Mule, to recognize the bona work of Mr. Derek Jarman in promulgating Universal Joy […] in his bijou masterpiecettes[.]"
                            },
                            {
                                "example_id": "fbdb9a38-e1b8-42ce-8eba-143c38d479c7",
                                "sense_id": "7f83fd0a-d52d-3023-af89-cc5ea25d50b6",
                                "text": "Polari, used for decades by gay men, actors, and theatre performers and which famously appeared on primetime radio show Round The Horne, has been brought up-to-date with a bijou iPhone appette."
                            }
                        ]
                    },
                    {
                        "sense_id": "df80bcec-67b3-3d72-8445-76678e564aee",
                        "entry_id": "f5198cdd-ae2c-3229-8b3f-1dee1fbc18a9",
                        "glosses": [
                            "small and elegant"
                        ],
                        "tags": [
                            "of a residence"
                        ],
                        "examples": [
                            {
                                "example_id": "92f95b65-bc19-4718-a80f-993e13f0aa8d",
                                "sense_id": "df80bcec-67b3-3d72-8445-76678e564aee",
                                "text": "I soon found Briony Lodge. It is a bijou villa, with a garden at the back, but built out in front right up to the road, two stories. Chubb lock to the door. Large sitting-room on the right side, well furnished, with long windows almost to the floor, and those preposterous English window fasteners which a child could open."
                            },
                            {
                                "example_id": "e7db0100-d705-4ce8-b252-be5a1e4cec8d",
                                "sense_id": "df80bcec-67b3-3d72-8445-76678e564aee",
                                "text": "In small towns like Soldau a small area accommodates the town hall, the church, several miniature squares, a monument to somebody or other, perhaps more than one, all sorts of shops, beerhouses, a post office, a bank, and there may be a bijou park behind wrought-iron railings, then the streets and the town end just as abruptly, and you have scarcely passed the last house when you find a highroad lined with trees stretching before you with a neat grid of precisely demarcated fields on either side."
                            }
                        ]
                    },
