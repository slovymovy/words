{
    "word_family": [
        "unbundle",
        "bundler",
        "bundling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "637db3ec-5752-343c-a29d-02918de19740",
                    "sense_definition": "A group of objects held together by wrapping or tying.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried a heavy <w>bundle</w> of firewood back to the camp.",
                            "target_lang_translations": {
                                "ru": "Он нес тяжелую <w>вязанку</w> дров обратно в лагерь.",
                                "zh": "他背着一<w>捆</w>沉重的木柴回到了营地。",
                                "pl": "Zaniósł ciężką <w>wiązkę</w> drewna na opał z powrotem do obozu."
                            }
                        },
                        {
                            "text": "She found a <w>bundle</w> of old letters in the attic.",
                            "target_lang_translations": {
                                "ru": "Она нашла <w>связку</w> старых писем на чердаке.",
                                "zh": "她在阁楼里发现了一<w>捆</w>旧信件。",
                                "pl": "Znalazła na strychu <w>pęk</w> starych listów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundle of sticks",
                        "bundle of clothes",
                        "bundle of joy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа предметов, связанных или завернутых вместе.",
                        "zh": "指被捆绑或包裹在一起的一组物品。",
                        "pl": "Grupa przedmiotów trzymanych razem poprzez owinięcie lub związanie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "предметов, скрепленных веревкой"
                            },
                            {
                                "target_lang_word": "свёрток",
                                "target_lang_sense_clarification": "предметов, завернутых в бумагу или ткань"
                            },
                            {
                                "target_lang_word": "вязанка",
                                "target_lang_sense_clarification": "дров или хвороста"
                            },
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "вещей, завязанных в ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捆",
                                "target_lang_sense_clarification": "量词，指捆在一起的物品"
                            },
                            {
                                "target_lang_word": "包裹",
                                "target_lang_sense_clarification": "指包好的物品"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wiązka",
                                "target_lang_sense_clarification": "przedmioty ułożone razem i związane"
                            },
                            {
                                "target_lang_word": "pęk",
                                "target_lang_sense_clarification": "zbiór jednorodnych przedmiotów związanych razem"
                            },
                            {
                                "target_lang_word": "zawiniątko",
                                "target_lang_sense_clarification": "niewielki pakunek owinięty materiałem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e0a55c3-71c8-3ca2-be34-0053b30d8795",
                    "sense_definition": "A group of products or services sold together as a unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software <w>bundle</w> includes a word processor and a spreadsheet program.",
                            "target_lang_translations": {
                                "ru": "<w>Пакет</w> программного обеспечения включает текстовый редактор и электронные таблицы.",
                                "zh": "这个软件<w>套装</w>包含一个文字处理程序和一个电子表格程序。",
                                "pl": "<w>Pakiet</w> oprogramowania zawiera edytor tekstu i arkusz kalkulacyjny."
                            }
                        },
                        {
                            "text": "We offer a discount if you buy the game console <w>bundle</w>.",
                            "target_lang_translations": {
                                "ru": "Мы предлагаем скидку, если вы купите <w>комплект</w> с игровой приставкой.",
                                "zh": "如果您购买游戏机<w>套装</w>，我们提供折扣。",
                                "pl": "Oferujemy zniżkę, jeśli kupisz <w>zestaw</w> z konsolą do gier."
                            }
                        }
                    ],
                    "common_phrases": [
                        "software bundle",
                        "product bundle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа товаров или услуг, продаваемых как единое целое.",
                        "zh": "作为单一单元一起销售的一组产品或服务。",
                        "pl": "Grupa produktów lub usług sprzedawanych razem jako jedna całość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "услуг или программ"
                            },
                            {
                                "target_lang_word": "комплект",
                                "target_lang_sense_clarification": "оборудования или товаров"
                            },
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套装",
                                "target_lang_sense_clarification": "指组合在一起销售的商品"
                            },
                            {
                                "target_lang_word": "套餐",
                                "target_lang_sense_clarification": "指组合在一起的服务"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pakiet",
                                "target_lang_sense_clarification": "zestaw usług lub oprogramowania"
                            },
                            {
                                "target_lang_word": "zestaw",
                                "target_lang_sense_clarification": "komplet produktów sprzedawanych razem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbabf75d-3fad-3571-8238-bf651e56451c",
                    "sense_definition": "A large amount, especially of money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inventor must have made a <w>bundle</w> from that simple idea.",
                            "target_lang_translations": {
                                "ru": "Изобретатель, должно быть, заработал <w>кучу денег</w> на этой простой идее.",
                                "zh": "那个发明家一定靠那个简单的点子赚了<w>一大笔</w>钱。",
                                "pl": "Wynalazca musiał zarobić <w>kupę</w> pieniędzy na tym prostym pomyśle."
                            }
                        },
                        {
                            "text": "It will cost a absolute <w>bundle</w> to repair the damage to the car.",
                            "target_lang_translations": {
                                "ru": "Ремонт повреждений автомобиля обойдется в <w>кругленькую сумму</w>.",
                                "zh": "修理这辆车的损坏将花费<w>一大笔</w>钱。",
                                "pl": "Naprawa uszkodzeń samochodu będzie kosztować <w>majątek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mint",
                        "pile",
                        "small fortune"
                    ],
                    "common_phrases": [
                        "make a bundle",
                        "cost a bundle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество чего-либо, особенно денег (разг.).",
                        "zh": "指大量的某物，尤指金钱。",
                        "pl": "Duża ilość czegoś, zwłaszcza pieniędzy (potocznie)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча денег",
                                "target_lang_sense_clarification": "разговорное выражение"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "огромная сумма денег"
                            },
                            {
                                "target_lang_word": "пачка",
                                "target_lang_sense_clarification": "денег (буквально)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一大笔",
                                "target_lang_sense_clarification": "形容钱财数量巨大"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kupa pieniędzy",
                                "target_lang_sense_clarification": "potoczne określenie dużej sumy"
                            },
                            {
                                "target_lang_word": "majątek",
                                "target_lang_sense_clarification": "bardzo duża suma pieniędzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8e42b88-9efe-3ab4-bf6f-e6f6de603c2c",
                    "sense_definition": "A cluster of closely bound muscle or nerve fibres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully repaired the damaged nerve <w>bundle</w>.",
                            "target_lang_translations": {
                                "ru": "Хирург осторожно восстановил поврежденный нервный <w>пучок</w>.",
                                "zh": "外科医生小心地修复了受损的神经<w>束</w>。",
                                "pl": "Chirurg ostrożnie naprawił uszkodzony <w>pęczek</w> nerwowy."
                            }
                        },
                        {
                            "text": "Each muscle <w>bundle</w> is surrounded by a protective sheath.",
                            "target_lang_translations": {
                                "ru": "Каждый мышечный <w>пучок</w> окружен защитной оболочкой.",
                                "zh": "每一块肌肉<w>束</w>都被一层保护膜包裹着。",
                                "pl": "Każdy <w>pęczek</w> mięśniowy jest otoczony ochronną osłonką."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nerve bundle",
                        "muscle bundle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скопление тесно связанных мышечных или нервных волокон.",
                        "zh": "紧密结合的肌肉或神经纤维束。",
                        "pl": "Skupisko ściśle powiązanych włókien mięśniowych lub nerwowych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "нервов или мышц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "束",
                                "target_lang_sense_clarification": "指神经或肌肉纤维的集合"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pęczek",
                                "target_lang_sense_clarification": "w terminologii medycznej i biologicznej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5aea5451-4a57-3c9e-980c-c3539aa36e5c",
                    "sense_definition": "To dress warmly, usually wearing many layers of clothing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dress_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>bundle</w> up before going out in the freezing snow.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>тепло одеться</w> перед выходом на мороз.",
                                "zh": "在冰天雪地里出门前，你需要把自己<w>裹</w>严实点。",
                                "pl": "Musisz się ciepło <w>ubrać</w>, zanim wyjdziesz na mróz."
                            }
                        },
                        {
                            "text": "The mother <w>bundled</w> the children in thick coats and scarves.",
                            "target_lang_translations": {
                                "ru": "Мать <w>укутала</w> детей в толстые пальто и шарфы.",
                                "zh": "母亲给孩子们<w>裹</w>上了厚厚的外套和围巾。",
                                "pl": "Matka <w>otuliła</w> dzieci grubymi płaszczami i szalikami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundle up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тепло одеваться, обычно в несколько слоев одежды.",
                        "zh": "穿得暖和，通常指穿多层衣服。",
                        "pl": "Ciepło się ubrać, zazwyczaj zakładając wiele warstw odzieży."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утепляться",
                                "target_lang_sense_clarification": "надевать теплую одежду"
                            },
                            {
                                "target_lang_word": "кутаться",
                                "target_lang_sense_clarification": "заворачиваться в одежду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裹",
                                "target_lang_sense_clarification": "指用衣物严实地包裹身体"
                            },
                            {
                                "target_lang_word": "穿暖",
                                "target_lang_sense_clarification": "指穿上足够的保暖衣物"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ubrać się ciepło",
                                "target_lang_sense_clarification": "założyć odpowiednią odzież na zimno"
                            },
                            {
                                "target_lang_word": "otulić się",
                                "target_lang_sense_clarification": "szczelnie owinąć się odzieżą"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "937c0ade-dbec-3de1-9d8e-1308dcfa0638",
                    "sense_definition": "To tie or wrap together into a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tie_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should <w>bundle</w> the old newspapers for recycling.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>связать</w> старые газеты для переработки.",
                                "zh": "我们应该把旧报纸<w>捆绑</w>起来以便回收。",
                                "pl": "Powinniśmy <w>związać</w> stare gazety do recyklingu."
                            }
                        },
                        {
                            "text": "She <w>bundled</w> the sticks together with a piece of twine.",
                            "target_lang_translations": {
                                "ru": "Она <w>связала</w> палки вместе куском бечевки.",
                                "zh": "她用一根细绳把木棍<w>捆绑</w>在一起。",
                                "pl": "<w>Związała</w> patyki razem kawałkiem sznurka."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundle together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связывать или заворачивать предметы вместе.",
                        "zh": "将物品捆绑或包裹在一起。",
                        "pl": "Wiązać lub owijać przedmioty razem w grupę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "веревкой или нитью"
                            },
                            {
                                "target_lang_word": "увязывать",
                                "target_lang_sense_clarification": "в пачку или узел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捆绑",
                                "target_lang_sense_clarification": "用绳索等将物品固定在一起"
                            },
                            {
                                "target_lang_word": "打包",
                                "target_lang_sense_clarification": "将物品整理并包裹起来"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wiązać",
                                "target_lang_sense_clarification": "łączyć przedmioty sznurkiem"
                            },
                            {
                                "target_lang_word": "pakować",
                                "target_lang_sense_clarification": "zbierać i zabezpieczać przedmioty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e4515a5-eea6-3072-ac61-4044333b4070",
                    "sense_definition": "To sell hardware and software or multiple services as a single product.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet provider <w>bundles</w> television and phone services with their connection.",
                            "target_lang_translations": {
                                "ru": "Интернет-провайдер <w>объединяет в пакет</w> услуги телевидения и телефонной связи со своим подключением.",
                                "zh": "互联网服务商将电视和电话服务与网络连接进行<w>捆绑销售</w>。",
                                "pl": "Dostawca internetu <w>pakietuje</w> usługi telewizyjne i telefoniczne ze swoim łączem."
                            }
                        },
                        {
                            "text": "They decided to <w>bundle</w> the accessories with the main device to increase sales.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>комплектовать</w> основное устройство аксессуарами, чтобы увеличить продажи.",
                                "zh": "他们决定将配件与主机<w>捆绑销售</w>以增加销量。",
                                "pl": "Zdecydowali się <w>sprzedawać</w> akcesoria w zestawie z głównym urządzeniem, aby zwiększyć sprzedaż."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары или услуги как единый комплект.",
                        "zh": "将硬件、软件或多种服务作为单一产品销售。",
                        "pl": "Sprzedawać sprzęt i oprogramowanie lub wiele usług jako jeden produkt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплектовать",
                                "target_lang_sense_clarification": "собирать в комплект"
                            },
                            {
                                "target_lang_word": "объединять в пакет",
                                "target_lang_sense_clarification": "об услугах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捆绑销售",
                                "target_lang_sense_clarification": "将多种商品组合在一起销售"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pakietować",
                                "target_lang_sense_clarification": "oferować usługi w pakiecie"
                            },
                            {
                                "target_lang_word": "sprzedawać w zestawie",
                                "target_lang_sense_clarification": "oferować produkty jako komplet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196c4f7c-6163-3c29-80c0-c417adf1685d",
                    "sense_definition": "To hastily or clumsily push, put, carry, or send something into a particular place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "move_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guards <w>bundled</w> the intruder into a waiting van.",
                            "target_lang_translations": {
                                "ru": "Охранники <w>запихнули</w> нарушителя в ожидающий фургон.",
                                "zh": "保安把闯入者<w>塞</w>进了等候的货车里。",
                                "pl": "Ochroniarze <w>wepchnęli</w> intruza do czekającego vana."
                            }
                        },
                        {
                            "text": "She hurriedly <w>bundled</w> all her clothes into the washing machine.",
                            "target_lang_translations": {
                                "ru": "Она поспешно <w>запихнула</w> всю свою одежду в стиральную машину.",
                                "zh": "她匆忙地把所有衣服都<w>塞</w>进了洗衣机。",
                                "pl": "Pospiesznie <w>wepchnęła</w> wszystkie swoje ubrania do pralki."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundle into",
                        "bundle out",
                        "bundle off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поспешно или небрежно запихивать или отправлять кого-то или что-то куда-либо.",
                        "zh": "匆忙或笨拙地将某人或某物推入、放入或送往某处。",
                        "pl": "Pospiesznie lub niezdarnie wpychać, wkładać lub wysyłać coś w określone miejsce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запихивать",
                                "target_lang_sense_clarification": "грубо или поспешно"
                            },
                            {
                                "target_lang_word": "заталкивать",
                                "target_lang_sense_clarification": "внутрь чего-либо"
                            }
                        ],
                        "zh": [
