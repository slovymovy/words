                "translations": [
                    {
                        "translation_id": "f21a5f76-4cf4-4057-95ba-038441fafe0e",
                        "source_entry_id": "af6953ce-cf18-3af5-ad15-3dcb1d7c6595",
                        "source_sense_id": "6c3fe346-1ae4-354f-b43d-4e299de7e667",
                        "source_sense_description": "vrouw die andermans huishouden verzorgt",
                        "target_lang_word": "Haushälterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haushälterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                        "entry_id": "1ed951b7-cf08-30b9-a986-757cce00f065",
                                        "glosses": [
                                            "Berufsbezeichnung für Frauen, die anderen Personen den privaten Haushalt führen, die anfallenden Hausarbeiten erledigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44408770-302e-4d58-9a69-91328ca0139f",
                                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                                "text": "Das Gerücht, dass unser Pfarrer seit Jahren ein heimliches Verhältnis mit seiner Haushälterin hat, hält sich hartnäckig."
                                            },
                                            {
                                                "example_id": "50aca24e-a25e-40af-9d3e-5080bb81380c",
                                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                                "text": "„Zwei Frauen teilen die Kellerbehausung mit der Großmutter: ihre Schwester Mirjam und ihre längjährige Haushälterin, Vertraute und Freundin Hannah Brandt.“"
                                            },
                                            {
                                                "example_id": "4a50cf55-f724-44d3-b720-efb2cdf58f98",
                                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                                "text": "„Jeder wusste, dass seine Haushälterin gleich nach der Abendandacht alles mit der Schubkarre ins Pfarramt schaffte.“"
                                            },
                                            {
                                                "example_id": "4a0bbc4f-edde-436d-bc84-2040758ef349",
                                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                                "text": "„Es bestand aus einem Mailänder Haushofmeister namens Carnicelli, einem Ablate, der ihm als Sekretär diente, weil er nicht schreiben konnte, einer alten Frau, die als Haushälterin bezeichnet wurde, einem Koch, seiner grundhäßlichen Frau und acht bis zehn Lakaien.“"
                                            },
                                            {
                                                "example_id": "4b0b219e-02d1-4551-9748-9d6eee3544df",
                                                "sense_id": "1136d6e7-0279-376a-80d1-a64b182c6b73",
                                                "text": "„Ein mürrischer Farmer, der Kinder hasst, heiratet seine hübsche Haushälterin, Mutter eines sechsjährigen Jungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d004a9bf-d328-4e17-89ab-7bcec44a0616",
                        "source_entry_id": "af6953ce-cf18-3af5-ad15-3dcb1d7c6595",
                        "source_sense_id": "6c3fe346-1ae4-354f-b43d-4e299de7e667",
                        "source_sense_description": "vrouw die andermans huishouden verzorgt",
                        "target_lang_word": "housekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone (traditionally a woman) employed to look after the home, typically by managing domestic servants or superintending household management; also someone with equivalent duties in a hotel, institution etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97d267c-1205-45e1-9ddd-0c4eb235e3f5",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "She was their third housekeeper, but after a month or so she also gave up."
                                            },
                                            {
                                                "example_id": "d758d069-de83-419b-97f3-1bbfb8455807",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "The housekeeper, a very decorative brunette of thirty-five with a pseudo-English accent, greeted him with a mixture of grateful effusion and condescending patronage."
                                            },
                                            {
                                                "example_id": "b5290bc2-d2ec-4bbc-ba92-93dd9e0e4c64",
                                                "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                                                "text": "When management of the toney Copley Plaza Hotel ordered housekeepers recently to put down their mops and hand wash the floors, a furor arose among the hotel cleaning staff. Local union representatives and others concerned with issues affecting women workers also rallied in anger to protest the directive, which in essence forced housekeepers to scrub on their hands and knees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9e989a-2dbd-3cc0-ba97-c25c924b9b1d",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who manages the running of a home, traditionally the female head of the household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e159c92d-13fb-3709-b753-1e9cf532d57a",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who keeps to their house; someone who rarely ventures away from home; an unadventurous person, a homebody."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d99a1c5-597d-47c1-9461-df01748e8e99",
                                                "sense_id": "e159c92d-13fb-3709-b753-1e9cf532d57a",
                                                "text": "I do assure you he is no house-keeper. I have seen him in desperate conflict with savage men, and even with His Majesty's redcoats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d6c736-be06-3dec-92ac-f6381b2f59bf",
                                        "entry_id": "31fa9f87-4d57-38f4-862b-da400c810dd7",
                                        "glosses": [
                                            "Someone who owns a house as a place of residence; a householder."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264b4640-745f-4c0e-9e43-5fdd1b300388",
                                                "sense_id": "56d6c736-be06-3dec-92ac-f6381b2f59bf",
                                                "text": "He was often heard to express his fears of coming upon the parish; and to bless God, that, on account of his having been so long a housekeeper, he was intitled to that provision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
