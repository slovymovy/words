                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Salz der Chlorwasserstoffsäure (auch Salzsäure) mit ionischer Bindung"
                                        ],
                                        "tags": [
                                            "anorganische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e6be87-bd03-45e5-817a-dc619d69823f",
                                                "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                                "text": "Kochsalz ist das bekannteste Chlorid."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Derivat der verschiedenen Verbindungen der Kohlenwasserstoffe mit molekularer Bindung"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61cf7174-a26a-4d1a-9399-644f1e1c36a7",
                                                "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                                "text": "„Die Bezeichnung dieser nicht salzartigen organischen Verbindungen als ‚Chlorid‘ ist fragwürdig, aber dennoch üblich.“",
                                                "translation": "„Polen hatte die Übernahme russischen Öls am Mittwochabend gestoppt, nachdem starke Verunreinigungen mit Chloriden nachgewiesen worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88cd3b25-19db-4cfb-9cdc-3925bd62a830",
