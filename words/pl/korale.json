            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3123480b-94e6-38e0-a632-901e5a967a7b",
                    "sense_definition": "ozdoba na szyję wykonana z paciorków nanizanych na sznurek lub nitkę",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Babcia założyła na uroczystość swoje ulubione czerwone <w>korale</w>.",
                            "target_lang_translations": {
                                "ru": "Бабушка надела на праздник свои любимые красные <w>бусы</w>."
                            }
                        },
                        {
                            "text": "Podczas zabawy naszyjnik pękł i drobne <w>korale</w> rozsypały się po całej podłodze.",
                            "target_lang_translations": {
                                "ru": "Во время игры ожерелье порвалось, и мелкие <w>бусины</w> рассыпались по всему полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "naszyjnik"
                    ],
                    "common_phrases": [
                        "czerwone korale",
                        "sznur korali",
                        "drewniane korale"
                    ],
                    "target_lang_definitions": {
                        "ru": "шейное украшение из бусин, нанизанных на нить или шнурок"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бусы",
                                "target_lang_sense_clarification": "шейное украшение из бусин"
                            },
                            {
                                "target_lang_word": "бусины",
                                "target_lang_sense_clarification": "отдельные элементы украшения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64b93a3-0520-3dba-bf86-10c373a72d1e",
                    "sense_definition": "mianownik, biernik oraz wołacz liczby mnogiej od rzeczownika <w>koral</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "form_of",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tropikalnych morzach żyją różnorodne <w>korale</w>, które tworzą barwne rafy.",
                            "target_lang_translations": {
                                "ru": "В тропических морях обитают разнообразные <w>кораллы</w>, образующие красочные рифы."
                            }
                        },
                        {
                            "text": "Nurkowie podziwiali rzadkie czerwone <w>korale</w> rosnące na dnie zatoki.",
                            "target_lang_translations": {
                                "ru": "Водолазы любовались редкими красными <w>кораллами</w>, растущими на дне залива."
                            }
                        }
                    ],
                    "synonyms": [
                        "koralowce"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "liczba mnoga"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма множественного числа от слова «koral» (коралл)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кораллы",
                                "target_lang_sense_clarification": "морские организмы или материал"
