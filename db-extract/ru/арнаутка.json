                "senses": [
                    {
                        "sense_id": "51ab19c6-b2b1-38d5-a3fe-6357596edab9",
                        "entry_id": "4518655e-e757-327c-ad69-2ef20485bb54",
                        "glosses": [
                            "спец. сорт пшеницы с белым и твёрдым зерном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d46d16c-5ddd-4464-8a43-122a0f7d1a4d",
                                "sense_id": "51ab19c6-b2b1-38d5-a3fe-6357596edab9",
                                "text": "Прежней вашей комиссии, насчёт семян пшеницы, сибирской арнаутки, не мог исполнить: во всей Могилевской губернии нет такой."
                            },
                            {
                                "example_id": "041aaeaa-1e0f-489b-bf26-926db4fdb896",
                                "sense_id": "51ab19c6-b2b1-38d5-a3fe-6357596edab9",
                                "text": "Я велела боронить двадцать десятин, вспаханных в прошлом году, и посеять арнаутку."
                            }
                        ]
                    }
                ],
