                "senses": [
                    {
                        "sense_id": "aa7cbede-1994-3547-b7bc-13dff0d81285",
                        "entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "glosses": [
                            "een toestand van algeheel welbevinden waarin er geen sprake is van lichamelijk letsel of ziekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed279788-86da-4e2a-a00b-5b1fef41c356",
                                "sense_id": "aa7cbede-1994-3547-b7bc-13dff0d81285",
                                "text": "Nederlanders die vorig jaar 65 jaar waren, leven gemiddeld nog bijna 20 jaar, meldde het CBS. Onze welstand verlengt ons bestaan – en dat van het zorghotel."
                            }
                        ]
                    },
                    {
                        "sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                        "entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "glosses": [
                            "het overvloed aan geld, land, grondstoffen, bezittingen en/of eigenschappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eecc80e0-bee1-46aa-9538-fe8016585e80",
                                "sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                                "text": "Zonder ‘behoefte’ aan partneralimentatie, geen alimentatie. Behoefte wordt gerelateerd aan de welstand van het huwelijk. Hoe hoger deze is, hoe hoger de alimentatie. Maatstaf is dus niet het kunnen voorzien in de noodzakelijke maandelijkse lasten zoals vaak wordt gedacht."
                            },
                            {
                                "example_id": "219aa67e-3ef4-4035-92a6-0e052569655b",
                                "sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                                "text": "Het is opvallend dat men voortdurend ouderen op de korrel neemt terwijl twintigers het grootste gevaar op de weg vormen en de meeste ongelukken veroorzaken. Zie de torenhoge verzekeringspremies voor die categorie. Waar komt die anti-ouderen houding eigenlijk vandaan? Afgunst wellicht, over vermeende welstand van die groep Nederlanders?"
                            },
                            {
                                "example_id": "dd0180bd-49d3-4f00-9587-3c18e315d680",
                                "sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                            }
                        ]
                    },
                    {
                        "sense_id": "7efa8390-eafd-384c-8c3c-9ffc783f75cd",
                        "entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "glosses": [
                            "overeenkomend met de goede smaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdeb9e3c-892c-4ed8-a4df-5219e501bdac",
                                "sense_id": "7efa8390-eafd-384c-8c3c-9ffc783f75cd",
                                "text": "Rondvaartboten moeten bij een nieuwe vergunningaanvraag of bij verbouwingen aan nieuw vastgesteld welstandsbeleid voldoen. De welstandscriteria volgen de zes algemene criteria van Amsterdams welstandsbeleid voor gebouwen en woonboten. Scheepsvormen als donuts, badkuipen, klompen, andere gekke vormen of de bierwaterfiets zijn verboden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4247e28c-7d51-4a1a-8bf5-0fa4512f2cca",
                        "source_entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "source_sense_id": "aa7cbede-1994-3547-b7bc-13dff0d81285",
                        "source_sense_description": "een toestand van algeheel welbevinden waarin er geen sprake is van lichamelijk letsel of ziekte",
                        "target_lang_word": "well-being",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9d51fc-a85e-300f-9cc9-3e1118a9f25d",
                                        "entry_id": "9c8c9849-db2e-3029-aa11-19d73e60f7fa",
                                        "glosses": [
                                            "A state of health, happiness or prosperity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1294f71e-ea15-44bc-994f-b636d06ec779",
                                                "sense_id": "fb9d51fc-a85e-300f-9cc9-3e1118a9f25d",
                                                "text": "Most foreigners who have heard of Bhutan know two things: the country charges international visitors a $100/day sustainable development fee (aka tourist tax), and that it is the birthplace of the Gross National Happiness Index, a system intended to look after the well-being of citizens and the environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3b3ea3c-54ca-4f65-8624-3a2f642de305",
                        "source_entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "source_sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                        "source_sense_description": "het overvloed aan geld, land, grondstoffen, bezittingen en/of eigenschappen",
                        "target_lang_word": "wealth",
                        "target_lang_code": "en",
