    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "670761c0-fe43-3c48-b048-47ab2925bfba",
                    "sense_definition": "die militärische Führung oder Befehlsgewalt über eine Truppe oder Einheit ausüben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der erfahrene General <w>kommandiert</w> seit zwei Jahren die Truppen an der Grenze."
                        },
                        {
                            "text": "Niemand wusste genau, wer während des plötzlichen Angriffs das Schiff <w>kommandierte</w>."
                        }
                    ],
                    "synonyms": [
                        "befehligen"
                    ],
                    "common_phrases": [
                        "Truppen kommandieren",
                        "ein Regiment kommandieren"
                    ]
                },
                {
                    "sense_id": "cdcc89e2-0e96-32fe-8b11-3669dc91bd3c",
                    "sense_definition": "anderen Personen herrisch oder bestimmend Anweisungen geben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du hast mir nichts zu sagen, also hör auf, mich ständig zu <w>kommandieren</w>."
                        },
                        {
                            "text": "In der Küche lässt sich der stolze Koch von niemandem <w>kommandieren</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "oft abwertend im Alltag gebraucht"
                        }
                    ]
                },
                {
                    "sense_id": "0dbb92e0-124d-3424-aac2-45f337d636b6",
                    "sense_definition": "einen bestimmten militärischen Befehl laut ausrufen oder förmlich anordnen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Offizier <w>kommandierte</w> den sofortigen Rückzug aller Soldaten aus dem Dorf."
                        },
                        {
                            "text": "Als die Gefahr zunahm, wurde auf dem Kriegsschiff sofort Feuer <w>kommandiert</w>."
                        }
                    ],
                    "synonyms": [
                        "anordnen",
                        "befehlen"
                    ],
                    "common_phrases": [
                        "Feuer kommandieren"
                    ]
                },
                {
                    "sense_id": "af19b85d-182e-3376-8cca-1d5145929526",
                    "sense_definition": "jemanden, besonders einen Soldaten, dienstlich an einen bestimmten Ort versetzen oder abordnen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die junge Soldatin wurde für mehrere Monate zur militärischen Weiterbildung in die Hauptstadt <w>kommandiert</w>."
                        },
                        {
                            "text": "Nach seiner Beförderung <w>kommandierte</w> man ihn an eine abgelegene Station im Gebirge."
                        }
                    ]
                }
            ]
        }
    ]
