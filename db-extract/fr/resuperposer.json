                "senses": [
                    {
                        "sense_id": "c5843ebb-2c38-3bd5-9db5-422754222d22",
                        "entry_id": "fb23de8a-19a2-3191-a178-f2497693b4e2",
                        "glosses": [
                            "Superposer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8a46ec-316a-4cd0-a2eb-92fb08c86401",
                                "sense_id": "c5843ebb-2c38-3bd5-9db5-422754222d22",
                                "text": "Après développement, on peut examiner séparément la plaque et la lame mince ou les resuperposer, pour les examiner ensemble;"
                            },
                            {
                                "example_id": "d7dae9b3-2ad7-4b6b-b2db-60f212f1dfb0",
                                "sense_id": "c5843ebb-2c38-3bd5-9db5-422754222d22",
                                "text": "Il leur a fallu resuperposer les Images en les repérant au viseur, et en conservant le déroulement sautillant et scintillant, les ombres soudaines de la succession chronophotographique (que Borowczyk retrouve d'ailleurs sans gêne, en mettant en série les documents qu'il a lui-même photographiés pour L'Ecole)."
                            }
                        ]
                    }
