                ],
                "senses": [
                    {
                        "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                        "entry_id": "4cece6e1-02fe-34d4-bd46-24802bf489e9",
                        "glosses": [
                            "Länge eines Satzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b0197c1-fae8-42e6-a831-a6b543867024",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "Die Satzlänge kann verschieden gemessen werden: Man kann jede kleinere Einheit, aus der ein Satz besteht, nutzen, um seine Länge zu bestimmen."
                            },
                            {
                                "example_id": "d28f36b2-2656-47b3-a2e0-6b36536d2bff",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "Die Satzlänge spielt in der Quantitativen Linguistik ebenso wie in anderen Bereichen der Linguistik, Stilistik und so weiter eine große Rolle."
                            },
                            {
                                "example_id": "82b38624-4f23-4cb6-be04-46b8c4388084",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "„Wir werden hier also explizit auf das Verhältnis zwischen Satzlänge und Clauselänge als Untersuchungsgegenstand dieser Arbeit eingehen…“"
                            },
                            {
                                "example_id": "1f5d2aa2-7c6e-4e78-9847-0cb2bf389cdd",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "„Mißt man jedoch die Satzlänge nicht in der Anzahl der Clauses, sondern in der Anzahl der Wörter, dann muß man die Störung, den Faktor der intervenierenden Ebene in Betracht ziehen…“"
                            },
                            {
                                "example_id": "37cfc63f-7a97-40ce-b745-34850ac18bd6",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "„Mit zunehmender Satzlänge nimmt die Teilsatzlänge - in der Literatur oft auch Clause genannt - ab.“"
                            },
                            {
                                "example_id": "d8660f24-2037-4905-bf45-c321a9d04bd2",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "Satzlänge ist ebenso wie Wortlänge ein wesentliches Kriterium der Lesbarkeitsforschung."
                            },
                            {
                                "example_id": "812ff2ce-a3dc-41d6-8dac-a2539ebd9cfd",
                                "sense_id": "0f4c102a-4fad-372a-ab41-c730d4b66bb4",
                                "text": "„Statistische Untersuchungen haben gezeigt, dass die Satzlänge im Vergleich zum 18. und 19. Jahrhundert abgenommen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
