                ],
                "senses": [
                    {
                        "sense_id": "c851a154-e1b3-37fb-b930-8414c3dbcd00",
                        "entry_id": "80078fb8-1901-3564-a234-5f9fcedbe79d",
                        "glosses": [
                            "Action de biffer certains noms lors d’une élection par liste."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "64889355-ea44-45b5-a079-2d56d2f3fb96",
                                "sense_id": "c851a154-e1b3-37fb-b930-8414c3dbcd00",
                                "text": "Les électeurs qui souhaitent latoiser ou biffer un bulletin feront donc bien de s’équiper rapidement du matériel de haute précision adéquat."
                            },
                            {
                                "example_id": "9446b30a-71d2-4f22-8eec-788f7268cef2",
                                "sense_id": "c851a154-e1b3-37fb-b930-8414c3dbcd00",
                                "text": "Dans ce cas, je peux latoiser : il s’agit alors de choisir une liste de parti et de tracer quelques noms de candidats qu’on ne veut pas élire."
                            },
                            {
                                "example_id": "646b70a4-610c-43ed-94dc-63f94094e2ac",
                                "sense_id": "c851a154-e1b3-37fb-b930-8414c3dbcd00",
                                "text": "Latoiser et latoisage sont des néologismes helvétiques de la fin du XIXᵉ siècle. Ils sont parfaitement vivants dans le lexique politique actuel ; on en trouve plusieurs centaines d’occurrences sur Internet, dans la presse et sur les sites officiels de la Confédération et des cantons suisses."
                            }
                        ]
                    }
                ],
