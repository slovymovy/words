                "senses": [
                    {
                        "sense_id": "9a35a51b-8ae1-3583-91db-4ea18fc1a806",
                        "entry_id": "6836b105-5092-3fb7-a90f-34d14adc5f7f",
                        "glosses": [
                            "das Gestehen (erstmalige Erklärung) der Liebe zu jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561b0bef-786d-4891-9f9f-75044c64b4d2",
                                "sense_id": "9a35a51b-8ae1-3583-91db-4ea18fc1a806",
                                "text": "„Er hatte durch Überreichung der Blume seiner schönen Gebieterin, ohne eine Silbe davon zu wissen, ein förmliches Liebesgeständnis getan, und noch dazu auf eine ganz unplatonische Art.“ (Johann Karl August Musäus, Volksmärchen der Deutschen)"
                            },
                            {
                                "example_id": "d14bd66e-a37e-4be1-9835-4a9133227c5d",
                                "sense_id": "9a35a51b-8ae1-3583-91db-4ea18fc1a806",
                                "text": "„Aber als er merkte, daß ich bei meinem Liebesgeständnis nicht auf die Karten achtete, die er verlor, versprach er schließlich, mich ihr zu empfehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
