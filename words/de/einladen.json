    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26f4aa20-c832-3625-940d-2a6f448c8391",
                    "sense_definition": "jemanden bitten oder auffordern, zu einem bestimmten Anlass, Fest oder Besuch zu kommen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gastfreundschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>laden</w> alle unsere Freunde zu unserem großen Sommerfest <w>ein</w>."
                        },
                        {
                            "text": "Sie hat mich gestern zu ihrem Geburtstag nach Hause <w>eingeladen</w>."
                        }
                    ],
                    "synonyms": [
                        "bitten",
                        "auffordern"
                    ],
                    "antonyms": [
                        "ausladen"
                    ],
                    "common_phrases": [
                        "zum Geburtstag einladen",
                        "zur Hochzeit einladen"
                    ]
                },
                {
                    "sense_id": "52f7e43a-d342-31b5-b633-21ca63d86437",
                    "sense_definition": "für jemanden die Kosten einer gemeinsamen Mahlzeit, eines Getränks oder einer Aktivität bezahlen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewirtung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Darf ich dich heute Abend auf eine Pizza <w>einladen</w>?"
                        },
                        {
                            "text": "Heute bezahle ich die Getränke und <w>lade</w> alle Kollegen <w>ein</w>."
                        }
                    ],
                    "synonyms": [
                        "spendieren",
                        "freihalten"
                    ],
                    "common_phrases": [
                        "zum Essen einladen",
                        "auf einen Kaffee einladen"
                    ]
                },
                {
                    "sense_id": "0831370a-8aa4-34aa-89a2-e65c0f708e8c",
                    "sense_definition": "Gepäck, Fracht oder Gegenstände in ein Transportmittel oder einen Behälter schaffen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen vor der langen Fahrt noch das Gepäck <w>einladen</w>."
                        },
                        {
                            "text": "Der Fahrer <w>lud</w> die schweren Pakete vorsichtig in den Lieferwagen <w>ein</w>."
                        }
                    ],
                    "synonyms": [
                        "beladen",
                        "verladen"
                    ],
                    "antonyms": [
                        "ausladen",
                        "entladen"
                    ],
                    "common_phrases": [
                        "die Koffer einladen",
                        "das Gepäck einladen"
                    ]
                },
                {
                    "sense_id": "70e351d0-3b6a-35d0-8775-18df11b06881",
                    "sense_definition": "durch eine ansprechende Wirkung oder Atmosphäre dazu verlocken oder anregen, etwas zu tun",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anreiz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das schöne Wetter am Nachmittag <w>lädt</w> zu einem langen Spaziergang <w>ein</w>."
                        },
                        {
                            "text": "Der ruhige Park an der Ecke <w>lädt</w> zum Lesen und Entspannen <w>ein</w>."
                        }
                    ],
                    "synonyms": [
                        "anregen",
                        "verlocken"
                    ],
                    "common_phrases": [
                        "zum Verweilen einladen",
                        "zum Träumen einladen"
                    ]
                },
                {
                    "sense_id": "7e43de4e-2c0c-3548-94d1-ce661ffc0400",
                    "sense_definition": "jemandem die kostenfreie Teilnahme an einem Kurs, einer Vorführung oder einer Veranstaltung anbieten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gastfreundschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Museum <w>lädt</w> alle Bürgerinnen und Bürger zu einer kostenlosen Führung <w>ein</w>."
                        },
                        {
                            "text": "Sie wurden dazu <w>eingeladen</w>, unverbindlich an dem neuen Schnupperkurs teilzunehmen."
                        }
                    ],
                    "common_phrases": [
                        "zur Teilnahme einladen"
                    ]
                }
            ]
        },
