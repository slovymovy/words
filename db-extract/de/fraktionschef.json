                                    {
                                        "sense_id": "87919415-2efc-3740-974f-9ce061f04f76",
                                        "entry_id": "b85d11bd-9782-311f-96ac-e1f0f5090c12",
                                        "glosses": [
                                            "de voorzitter van de vertegenwoordigers van een politieke partij"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c621f927-1ed8-412f-8f4f-72a20fa08ffa",
                                                "sense_id": "87919415-2efc-3740-974f-9ce061f04f76",
                                                "text": "De fractieleider slaagde er niet in om zijn partij bijeen te houden."
                                            },
                                            {
                                                "example_id": "f1f4402b-5614-49ea-8f7e-d152ff37b620",
                                                "sense_id": "87919415-2efc-3740-974f-9ce061f04f76",
                                                "text": "Toen Van Mierlo zich na de vorming van het kabinet-Den Uyl in 1973 terugtrok als fractieleider, werd Terlouw zijn opvolger. Het verschil met de oude leider had nauwelijks groter kunnen zijn. Van Mierlo, een ex-journalist en ex-katholiek, was een slonzige, wat warrige en breedsprakige kroegtijger; Terlouw een keurige, kalme en rationeel redenerende domineeszoon."
                                            }
                                        ]
                                    }
