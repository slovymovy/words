                    {
                        "sense_id": "65bab6ae-8102-36f1-a4da-fa0556cca2e1",
                        "entry_id": "5ca4ef56-99b5-36dd-b03d-0fa86b5868f0",
                        "glosses": [
                            "weibliche Person, die spielsüchtig ist, ein krankhaftes Verlangen nach Glücksspielen zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06658231-5063-4cc7-aed2-a58829afe6e5",
                                "sense_id": "65bab6ae-8102-36f1-a4da-fa0556cca2e1",
                                "text": "„Es fiel mir schwer, in dieser Händlerin auch nur ansatzweise eine Parasitin, eine Spielsüchtige oder ein Monster zu sehen.“"
                            },
                            {
                                "example_id": "8d08cb31-5881-467a-bcea-09f8c3d4bf42",
                                "sense_id": "65bab6ae-8102-36f1-a4da-fa0556cca2e1",
                                "text": "„Eine Spielsüchtige will in einem Casino arbeiten? Wieso kommt mir das wie kein sonderlich gelungener Karriereschritt vor?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
