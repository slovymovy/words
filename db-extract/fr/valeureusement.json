        "fr-extract.jsonl": [
            {
                "entry_id": "66f4013d-5e2e-3044-80c6-6af5ab7a57af",
                "word": "valeureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fc6c6b9-b940-30ab-b914-2a0778739d69",
                        "entry_id": "66f4013d-5e2e-3044-80c6-6af5ab7a57af",
                        "glosses": [
                            "Avec vaillance, avec courage, d’une manière valeureuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c31fbf8-2b80-4fc7-96c0-390930177068",
                                "sense_id": "5fc6c6b9-b940-30ab-b914-2a0778739d69",
                                "text": "Il a combattu valeureusement."
                            },
                            {
                                "example_id": "72424cbd-5929-482e-88c3-bd3a0facb6d8",
                                "sense_id": "5fc6c6b9-b940-30ab-b914-2a0778739d69",
                                "text": "Et comme vous êtes des braves petites, vous mentez valeureusement : « Moi, je n’ai jamais froid… Moi, je suis habillée l’hiver comme l’été… »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67c5b294-5dd3-4cf1-9e5f-b9eb4100f967",
                        "source_entry_id": "66f4013d-5e2e-3044-80c6-6af5ab7a57af",
                        "source_sense_id": "5fc6c6b9-b940-30ab-b914-2a0778739d69",
                        "target_lang_word": "valiantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valiantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                        "entry_id": "bd97f98b-1693-3c44-9235-6f848d3d412a",
                                        "glosses": [
                                            "In a valiant manner; showing bravery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ad1bcd-8b3a-4e29-a46b-04f98f10ff63",
                                                "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                                "text": "I valiantly resolve not to go to bed at all, but to walk up and down the pier till morning."
                                            },
                                            {
                                                "example_id": "952b67cd-8468-4af0-8985-af310ba375ff",
                                                "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                                "text": "We may think of the young people who valiantly stood for the cause of human rights and resisted their infringement, in spite of the violent crackdown by the Chinese regime at T’ien-an-men Square in June 1989."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d65dfde-779d-4546-bdb6-378d360f2bdd",
                        "source_entry_id": "66f4013d-5e2e-3044-80c6-6af5ab7a57af",
                        "source_sense_id": "5fc6c6b9-b940-30ab-b914-2a0778739d69",
                        "target_lang_word": "bravely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                        "entry_id": "af06285a-389f-31a9-a47e-ded0c213034c",
                                        "glosses": [
                                            "In a brave manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc15363-cf0b-490e-9b66-4929950541cb",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "The soldiers faced the enemy bravely."
                                            },
                                            {
                                                "example_id": "fe6194dc-737b-4d12-a115-6f3f4028bb1c",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "Here, here, here's an excellent place; here we may see most bravely: I'll tell you them all by their names as they pass by; but mark Troilus above the rest."
                                            },
                                            {
                                                "example_id": "ba74d131-0fac-4ca7-845c-9e79c2c2bcc1",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "No, they hold there a large, round wad of tow and cork, enveloped in the thickest and toughest of ox-hide. That bravely and uninjured takes the jam which would have snapped all their oaken handspikes and iron crow-bars."
                                            },
                                            {
                                                "example_id": "f5033be6-a1ea-429a-93d6-1797fcd465a4",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "[H]e stepped forward and said bravely, though his hand trembled, and his face was as pale as snow:—\n“My true friend, from the bottom of my broken heart I thank you. Tell me what I am to do, and I shall not falter!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a97ec3e4-91a7-479f-b34c-e40ee6dc797e",
                        "source_entry_id": "66f4013d-5e2e-3044-80c6-6af5ab7a57af",
