                                        "sense_id": "735cca1b-b123-30e5-ac01-c3f9489decd3",
                                        "entry_id": "0d4e788f-0567-34a1-939d-5e519bd4c813",
                                        "glosses": [
                                            "einer der vier Verfasser der neutestamentlichen Evangelien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a467eff-99eb-4a1f-8e4b-c3bef2c47e98",
                                                "sense_id": "735cca1b-b123-30e5-ac01-c3f9489decd3",
                                                "text": "„Die vier Evangelisten berichten, wie Christus unter anderem Gelähmte und Blinde durch seine Anwesenheit oder durch Berührung von ihren Leiden befreit hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afc46903-95d9-3aa3-aae8-473b2b0f9818",
                                        "entry_id": "0d4e788f-0567-34a1-939d-5e519bd4c813",
                                        "glosses": [
                                            "Person, die nicht- und andersgläubige Menschen den christlichen Glauben vermittelt und sie zur Bekehrung einlädt"
                                        ],
                                        "tags": [],
                                        "examples": [],
