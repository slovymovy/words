                        "examples": [
                            {
                                "example_id": "7ffb551d-ab7a-4378-93ed-31bed983cd87",
                                "sense_id": "f6b1a236-26a3-3c55-9d06-05ccbd2c2717",
                                "text": "Er is vorig jaar veel minder fraude gepleegd met pinpassen en internetbankieren. Het fraudebedrag daalde met 60 procent naar ruim 30 miljoen euro. Dat blijkt uit cijfers van de Nederlandse Vereniging van Banken. Het is voor het tweede jaar op rij dat er minder gefraudeerd is."
                            },
                            {
                                "example_id": "b2ddf45e-efe4-4e1f-a22c-5400e1e5174b",
                                "sense_id": "f6b1a236-26a3-3c55-9d06-05ccbd2c2717",
                                "text": "In het rapport 'Het verhaal achter notoire uitkeringsfraude' wordt de effectiviteit van deze maatregelen in twijfel getrokken. \"In enkele gevallen liep het bedrag op tot boven de 60.000 euro. Voor veruit de meeste uitkeringsontvangers (?) was het fraudebedrag op het moment van detectie dermate hoog opgelopen dat terugvordering van het teveel uitgekeerde bedrag erg lastig was.\""
                            },
                            {
                                "example_id": "37619dad-daaf-43fe-b8fe-2fb1809fb7d1",
                                "sense_id": "f6b1a236-26a3-3c55-9d06-05ccbd2c2717",
                                "text": "De gemeente zegt dat het aantal adressen waar gefraudeerd wordt meevalt, maar dat het fraudebedrag per adres fors is. Hoe groot het fraudebedrag is, heeft de gemeente niet berekend."
                            }
                        ]
