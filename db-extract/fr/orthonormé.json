                        "entry_id": "48372326-36de-31d0-aefd-02775acfaeb6",
                        "glosses": [
                            "Normé dans une base orthogonale en parlant d'un espace vectoriel euclidien."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f2c5cf3-c679-31bf-9dfd-44fb6bd9f544",
                        "entry_id": "48372326-36de-31d0-aefd-02775acfaeb6",
                        "glosses": [
                            "Très structurant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6153a0-b1d1-4445-ac67-a4f612e0969f",
                                "sense_id": "8f2c5cf3-c679-31bf-9dfd-44fb6bd9f544",
                                "text": "Le petit monde dans lequel elle a commencé à vivre alors lui a semblé rassurant par la discipline qu’il impose. Un tel système est « orthonormé » : un grand nombre de règles, de normes, de dogmes et d’interdits y structurent les faits et gestes du quotidien."
                            }
                        ]
                    }
