                        "sense_id": "be440769-b2e5-3b1d-b6c2-d50b71545107",
                        "entry_id": "605457dd-da48-33b3-98e1-693cc6530c94",
                        "glosses": [
                            "Sturm, der in der Sommerzeit auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9144ed09-869c-4953-8116-6285eaceea44",
                                "sense_id": "be440769-b2e5-3b1d-b6c2-d50b71545107",
                                "text": "„Ernst verspricht ihnen eine schöne Sommerreise in die Mitternachtssonne entlang der norwegischen Küste, rechnet jedoch selbst nicht mit dem Sommersturm im Nordatlantik.“"
                            },
                            {
                                "example_id": "75f7ba19-b53f-4fae-aff7-7221bcd2d394",
                                "sense_id": "be440769-b2e5-3b1d-b6c2-d50b71545107",
                                "text": "„Im Jahr 1755 erschütterte ein Sommersturm den Leuchtturm von Eddystone nahe Plymouth, England.“"
                            },
                            {
                                "example_id": "53243f73-ec1a-4607-bee4-a1651672a67d",
                                "sense_id": "be440769-b2e5-3b1d-b6c2-d50b71545107",
                                "text": "„Allerdings kam die Flotte in einen Sommersturm, der sie stark nach Norden an die Küste von Blanes, etwa 60 km nördlich von Barcelona, abtrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
