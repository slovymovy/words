                "senses": [
                    {
                        "sense_id": "cfe74971-f5dd-35dc-b5bf-4ff2d8b6e92c",
                        "entry_id": "5acc6a26-6ce3-30ce-89f7-cbbcc1a7445d",
                        "glosses": [
                            "weibliche Person, die etwas zu jemandem bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde64a7d-3ff9-4400-9965-8e0fdbbd8ad5",
                                "sense_id": "cfe74971-f5dd-35dc-b5bf-4ff2d8b6e92c",
                                "text": "Als Überbringerin der freudigen Botschaft fungierte die Bürgermeisterin."
                            },
                            {
                                "example_id": "3ade63e8-5012-47f2-81bb-e18594b40701",
                                "sense_id": "cfe74971-f5dd-35dc-b5bf-4ff2d8b6e92c",
                                "text": "Die Überbringerin des Lösegelds wurde überraschend festgenommen."
                            },
                            {
                                "example_id": "1cebeb5a-aae4-4f17-ae37-91288228b34e",
                                "sense_id": "cfe74971-f5dd-35dc-b5bf-4ff2d8b6e92c",
                                "text": "„Ich teilte ihr in meinem Brief mit, daß die Überbringerin von mir den Auftrag habe, sie in jeder Hinsicht in ihre Obhut zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
