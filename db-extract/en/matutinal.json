{
    "word": "matutinal",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ce906f74-648c-334e-b48d-9a51dc0a7116",
                "word": "matutinal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ae2c7b1-7691-39ae-8b9b-cc9c9ab29f45",
                        "entry_id": "ce906f74-648c-334e-b48d-9a51dc0a7116",
                        "glosses": [
                            "Of, occurring in, or relating to the morning, especially the early morning upon waking up."
                        ],
                        "tags": [
                            "formal",
                            "literary",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b4c9839-525a-4305-b170-47594a68e46c",
                                "sense_id": "4ae2c7b1-7691-39ae-8b9b-cc9c9ab29f45",
                                "text": "'Top 'o the mornin' to ye!' he called to Flory in a hearty matutinal voice, putting on an Irish accent."
                            },
                            {
                                "example_id": "da625cc4-cf10-41a0-a6ef-00e064e429ab",
                                "sense_id": "4ae2c7b1-7691-39ae-8b9b-cc9c9ab29f45",
                                "text": "1874, Henry James, \"Professor Fargo\" in The Galaxy 18(2) (August 1874): 233–253.\n[A] young lady was introduced who had come to request him to raise a ghost—a resolute young lady, with several ringlets and a huge ancestral umbrella, whose matutinal appetite for the supernatural had not been quenched by the raw autumnal storm."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9865817-7023-309b-96b8-2a63aabd7efb",
                        "entry_id": "ce906f74-648c-334e-b48d-9a51dc0a7116",
                        "glosses": [
                            "Active in the morning; waking up early."
                        ],
                        "tags": [
                            "formal",
                            "literary",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fca0b882-99af-49a7-ab6a-55d3216c4df6",
                                "sense_id": "f9865817-7023-309b-96b8-2a63aabd7efb",
                                "text": "Pen, putting on his hat, strode forth into the air, and almost over the body of the matutinal housemaid, who was rubbing the steps at the door."
                            },
                            {
                                "example_id": "0bc583e5-865f-4678-aee2-9768cfcacf79",
                                "sense_id": "f9865817-7023-309b-96b8-2a63aabd7efb",
                                "text": "Certain other plants agree with certain other kinds of birds in being peculiarly matutinal. Go out as early as we will, we find the delicate white bells of the wild convolvulus in the dewy hedge, […] just as we are never too soon for the chaffinch, the blackbird, and the lark."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "279361e9-ae50-405c-a819-49fa257255b6",
                        "source_entry_id": "ce906f74-648c-334e-b48d-9a51dc0a7116",
                        "source_sense_description": "of, occurring in, or relating to the early morning",
                        "target_lang_word": "matutinal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matutinal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "175d3bbf-cfe7-3230-87a2-cc4915363be8",
                                        "entry_id": "6d37614b-76ff-308c-bd88-bd0a71308459",
                                        "glosses": [
                                            "Matinal."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0548e069-7076-4652-9124-83ef0f68d7a0",
                                                "sense_id": "175d3bbf-cfe7-3230-87a2-cc4915363be8",
                                                "text": "Sa genèse morale avait commencé au milieu de ces balayeurs matutinaux et de ces voitures maraîchères qui descendent en furie vers les Halles, pour arriver à l’ouverture de la grande Gueule."
                                            },
                                            {
                                                "example_id": "dbd819b9-9907-4f8c-a41a-03051dbcf203",
                                                "sense_id": "175d3bbf-cfe7-3230-87a2-cc4915363be8",
                                                "text": "Le vent matutinal, des coteaux à la rive\nBondit comme un troupeau d’agneaux qu’on délia."
                                            },
                                            {
                                                "example_id": "53a11afa-c8af-41e0-9559-ab62db6ab3d0",
                                                "sense_id": "175d3bbf-cfe7-3230-87a2-cc4915363be8",
                                                "text": "Les zoniers sont nombreux encore qui habitent des cabanes plus ou moins construites avec de vieilles boites à sardines. L'industrie des chiffons et l'exploration matutinale des poubelles ne leur permettent pas de villas plus cossues."
                                            },
                                            {
                                                "example_id": "e8b5809a-0fba-440e-bec0-c23823a166b1",
                                                "sense_id": "175d3bbf-cfe7-3230-87a2-cc4915363be8",
                                                "text": "Puis il [Primo Levi] souligne le plaisir esthétique éprouvé par les Allemands devant ces chorégraphies matutinales et vespertinales du malheur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f606d68-3d08-4aa5-a486-705f84236ead",
                        "source_entry_id": "ce906f74-648c-334e-b48d-9a51dc0a7116",
                        "source_sense_description": "of, occurring in, or relating to the early morning",
                        "target_lang_word": "morgendlich",
