                                "sense_id": "b851356e-80c5-3a0d-8eec-1099a4a4125e",
                                "text": "Albert Einstein heeft met zijn relativiteitstheorie het denken over het heelal voorgoed grondig gewijzigd."
                            },
                            {
                                "example_id": "80fbf647-d4e6-4bdb-b77b-63e6fcccb947",
                                "sense_id": "b851356e-80c5-3a0d-8eec-1099a4a4125e",
                                "text": "een van de twee grondprincipes van de speciale relativiteitstheorie gaat uit van de onveranderlijkheid van de lichtsnelheid"
                            }
                        ]
                    }
                ],
