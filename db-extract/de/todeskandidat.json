                "senses": [
                    {
                        "sense_id": "7a1f8f75-9692-385e-818e-419d9b5dc881",
                        "entry_id": "374ca310-e29c-3b19-b107-5ad86b5b17cf",
                        "glosses": [
                            "jemand, dem der Tod in absehbarer Zeit bevorsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbbc614-e6b0-4e5e-8592-77b9732da39d",
                                "sense_id": "7a1f8f75-9692-385e-818e-419d9b5dc881",
                                "text": "„Sie verschweigen dem jungen Deutschen nicht, daß sie ihn für einen Todeskandidaten halten.“"
                            },
                            {
                                "example_id": "df3854e3-d1af-4f50-9c82-f6274bfe6308",
                                "sense_id": "7a1f8f75-9692-385e-818e-419d9b5dc881",
                                "text": "„Der Supreme Court hatte im Jänner die Vollstreckung von drei Todesurteilen im Bundesstaat Oklahoma ausgesetzt. Das Gericht reagierte damit auf Einsprüche gegen die vorgesehene Giftmischung, die nach Ansicht der Todeskandidaten gegen das verfassungsrechtliche Verbot grausamer Bestrafung verstößt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
