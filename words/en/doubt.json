{
    "word_family": [
        "doubtful",
        "doubtless",
        "doubter",
        "undoubted",
        "undoubtedly",
        "redoubtable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af4c26dd-cdc4-39ac-a3e9-43714408aa44",
                    "sense_definition": "To be undecided about, to lack confidence in, or to question the truth of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>doubted</w> that was really what you meant when you spoke earlier.",
                            "target_lang_translations": {
                                "ru": "Он <w>сомневался</w>, что вы действительно имели это в виду, когда говорили ранее."
                            }
                        },
                        {
                            "text": "I <w>doubt</w> if they would have noticed me even if I had attended.",
                            "target_lang_translations": {
                                "ru": "Я <w>сомневаюсь</w>, что они заметили бы меня, даже если бы я пришел."
                            }
                        }
                    ],
                    "synonyms": [
                        "distrust",
                        "mistrust",
                        "question"
                    ],
                    "common_phrases": [
                        "doubt if",
                        "doubt that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть в нерешительности, испытывать недостаток уверенности или подвергать сомнению истинность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомневаться",
                                "target_lang_sense_clarification": "в чем-либо"
                            },
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "оспаривать истинность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "699fd853-31b8-337c-8ec8-1d30b668e412",
                    "sense_definition": "To harbour suspicion about or to suspect something is the case.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>doubt</w> you will not be found true men at the end of the way.",
                            "target_lang_translations": {
                                "ru": "Я <w>подозреваю</w>, что в конце пути вы не окажетесь честными людьми."
                            }
                        },
                        {
                            "text": "The detective <w>doubted</w> the witness was telling the whole truth about the night.",
                            "target_lang_translations": {
                                "ru": "Детектив <w>сомневался</w>, что свидетель говорит всю правду о той ночи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь подозрения или предполагать, что что-то является правдой (часто с оттенком недоверия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозревать",
                                "target_lang_sense_clarification": "иметь подозрение"
                            },
                            {
                                "target_lang_word": "сомневаться",
                                "target_lang_sense_clarification": "не верить в честность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f7d257a-3b8a-3a2c-996d-006bc074542f",
                    "sense_definition": "To dread or fear a particular outcome or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>doubt</w> some foul play has occurred in this dark alleyway.",
                            "target_lang_translations": {
                                "ru": "Я <w>опасаюсь</w>, что в этом темном переулке произошло какое-то преступление."
                            }
                        },
                        {
                            "text": "She <w>doubted</w> the danger that lay ahead of her in the forest.",
                            "target_lang_translations": {
                                "ru": "Она <w>страшилась</w> опасности, которая подстерегала ее в лесу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of fearing or dreading"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опасаться или бояться определенного исхода или ситуации (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опасаться",
                                "target_lang_sense_clarification": "бояться чего-либо"
                            },
                            {
                                "target_lang_word": "предчувствовать недоброе",
                                "target_lang_sense_clarification": "о дурном исходе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd5c0109-d92b-3234-a9c6-340347e16545",
                    "sense_definition": "To fill someone with fear or to affright them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virtues of the valiant warrior <w>doubts</w> me more than all the army.",
                            "target_lang_translations": {
                                "ru": "Доблесть отважного воина <w>устрашает</w> меня больше, чем вся армия."
                            }
                        },
                        {
                            "text": "The sudden thunderclap <w>doubted</w> the children as they played outside.",
                            "target_lang_translations": {
                                "ru": "Внезапный раскат грома <w>напугал</w> детей, когда они играли на улице."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used as a transitive verb meaning to frighten"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять кого-либо страхом или пугать (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устрашать",
                                "target_lang_sense_clarification": "внушать страх"
                            },
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "приводить в трепет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03842cd2-18ce-3002-b18d-d8590c5d6af3",
                    "sense_definition": "A feeling of uncertainty or lack of conviction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was some <w>doubt</w> as to who the child's real father was.",
                            "target_lang_translations": {
                                "ru": "Были некоторые <w>сомнения</w> относительно того, кто был настоящим отцом ребенка."
                            }
                        },
                        {
                            "text": "He made that way easy, which would otherwise, no <w>doubt</w>, have been tedious.",
                            "target_lang_translations": {
                                "ru": "Он облегчил этот путь, который в противном случае, без <w>сомнения</w>, был бы утомительным."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "belief",
                        "confidence",
                        "faith",
                        "tenet"
                    ],
                    "common_phrases": [
                        "no doubt",
                        "beyond doubt",
                        "cast doubt",
                        "room for doubt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство неуверенности или отсутствие убежденности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "неуверенность"
                            },
                            {
                                "target_lang_word": "недоверие",
                                "target_lang_sense_clarification": "отсутствие веры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df73b585-56b6-31a1-8544-94413e61e4da",
                    "sense_definition": "A specific point of uncertainty, especially a question regarding understanding.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you have any <w>doubts</w> before the exam tomorrow, come see me.",
                            "target_lang_translations": {
                                "ru": "Если у вас возникнут какие-либо <w>вопросы</w> перед завтрашним экзаменом, заходите ко мне."
                            }
                        },
                        {
                            "text": "I have just one <w>doubt</w> about the instructions you gave us.",
                            "target_lang_translations": {
                                "ru": "У меня есть только одно <w>сомнение</w> по поводу инструкций, которые вы нам дали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a doubt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Indian English to mean a question"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный неясный момент, особенно вопрос, касающийся понимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "неясность в понимании"
                            },
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "непонятный момент"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}