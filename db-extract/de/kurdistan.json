                ],
                "senses": [
                    {
                        "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                        "entry_id": "60bd8be7-f342-33b9-ba96-9ae20eadafae",
                        "glosses": [
                            "nicht genau begrenztes Gebiet, das Teile der Türkei, Syriens, Irans und Iraks umfasst, in dem die meisten Kurden angesiedelt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac5168b-7479-470a-af8f-6ec7702be8d1",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "Da sich das Gebiet Kurdistan auf vier Teilen der anderen Staaten befindet, entwickeln sich verschiedene Dialekte der kurdischen Sprache."
                            },
                            {
                                "example_id": "41495eda-693c-40b6-a2ba-0868d392b873",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "„Die Wirtschaft in Kurdistan beruht zum großen Teil auf Ackerbau und Viehzucht“."
                            },
                            {
                                "example_id": "285d5f85-9ce6-4afe-b436-9bd248c5d937",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "„Kurdistan ist auf der einen Seite (z. B. in der Türkei) ein verpöntes, zuweilen auch verbotenes Wort, auf der anderen Seite ein politischer Kampfbegriff, der das Ziel eines beträchtlichen Teils der Kurden benennt.“"
                            },
                            {
                                "example_id": "9fb28a44-1286-4039-9b79-0a64a301876b",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "Kurden, die aus dem türkischen Teil von Kurdistan stammen, sprechen meistens Kurmandschi."
                            },
                            {
                                "example_id": "d85fdb3f-01da-4a02-97d3-33cda1ddf1b8",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "Kurdistan wurde nacheinander von den Arabern, Mongolen, Persern und ab dem 16. Jh. von den Osmanen besetzt."
                            },
                            {
                                "example_id": "e5ce49ef-2afe-408b-97a8-1f35bd7bed81",
                                "sense_id": "0b08eb24-731f-3620-9e30-1b3b8d1e9436",
                                "text": "„Es gibt zwar Christen in Kurdistan, die aber ihrer Sprache und ihrem Selbstverständnis nach keine Kurden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
