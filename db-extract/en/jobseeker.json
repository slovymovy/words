                        "entry_id": "d53b5c0d-b6eb-3603-a1ae-443b74090346",
                        "glosses": [
                            "A person seeking employment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76f8999-d545-4e57-b163-6b63f558dc4b",
                                "sense_id": "8090d9ee-dbb8-3c18-8f0d-a0fd5c63b3eb",
                                "text": "It has taken people off the dole queue, and its online jobseekers board is updated daily."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cad61a9-fd3e-32a2-9186-00443cd47430",
                        "entry_id": "d53b5c0d-b6eb-3603-a1ae-443b74090346",
                        "glosses": [
                            "An unemployed person who needs to prove he/she is looking for work in order to obtain government benefits."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
