                "senses": [
                    {
                        "sense_id": "d6c86156-335b-3402-afe8-6bdbd54a0d85",
                        "entry_id": "899b4ab8-b45a-3e7d-88e1-2e5b95e808a5",
                        "glosses": [
                            "Fachsprache, die bei militärischen Themen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c0a33e-1486-4292-84b4-9791c6e37c6c",
                                "sense_id": "d6c86156-335b-3402-afe8-6bdbd54a0d85",
                                "text": "„Sechs Jahre lang, von 1972 bis 1978, hat Albaniens Armee an ‚Objekt 0774‘ gebaut, wie der Bunker in der Militärsprache hieß.“"
                            },
                            {
                                "example_id": "278d2943-4f2a-4a55-bb1f-50e035878e97",
                                "sense_id": "d6c86156-335b-3402-afe8-6bdbd54a0d85",
                                "text": "„Besonders fasziniert dürfte Jünger von der Rolle sein, welche die futuristische Avantgarde, übrigens ein Begriff der Militärsprache, dem Dichter beimisst.“"
                            },
                            {
                                "example_id": "f25d1cb2-4440-4c46-91a6-969c7834cc1f",
                                "sense_id": "d6c86156-335b-3402-afe8-6bdbd54a0d85",
                                "text": "„Ausdrücke der Militär- und der Hofsprache waren für ihn wegen ihrer exklusiven Verständlichkeit ebenso unbrauchbar wie Berufsjargons und jede Art von Spezialistenvokabular.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
