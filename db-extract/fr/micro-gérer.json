                "senses": [
                    {
                        "sense_id": "0991e60d-452c-3bb8-8071-7e38747c649b",
                        "entry_id": "2691be2a-fb9f-3d59-b5e5-5b84f5cae528",
                        "glosses": [
                            "Gérer de façon très fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64fdd27e-314d-4abf-bc12-db343c583052",
                                "sense_id": "0991e60d-452c-3bb8-8071-7e38747c649b",
                                "text": "Le gouvernement fait un grand pas en avant en arrêtant de micro-gérer les services publics et en passant à la sous-traitance."
                            },
                            {
                                "example_id": "38cbb330-91e5-42f2-9081-c5763037b290",
                                "sense_id": "0991e60d-452c-3bb8-8071-7e38747c649b",
                                "text": "La tâche ne consiste alors pas à micro-gérer les autres – une cause perdue qui ne ferait que saper l’énergie – mais plutôt à se retirer de cette société troublée."
                            }
                        ]
                    }
