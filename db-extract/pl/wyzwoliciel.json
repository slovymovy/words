                        "entry_id": "e78e71a7-ff7a-338b-b65f-b0fdf17ebbc5",
                        "glosses": [
                            "ten, kto wyzwolił (kogoś lub coś)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10265340-4a54-4f97-ae76-0157d58cf21c",
                                "sense_id": "e81c28b3-354b-36bd-b66c-34f67842f6d7",
                                "text": "Jako wyzwoliciel przekazywał władzę prawowitym gospodarzom. Obaj panowie stanęli na balkonie, generał i burmistrz w odświętnym tradycyjnym stroju. Z dołu dochodziły wiwaty i okrzyki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
