                "senses": [
                    {
                        "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                        "entry_id": "04f02cb1-e0a5-3524-876a-e9381cf4f60a",
                        "glosses": [
                            "Frau, die etwas, meist eine Krankheit, vortäuscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f3a29d-53dd-4995-aa4f-c2bd4f523123",
                                "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                                "text": "Um den Schein einer Simulantin zu vermeiden, werden die Kranken unerschöpflich in der Darstellung ihres Leidens, vergrössern ihr Uebel um recht eindringlich zu sprechen, heben das Absonderliche und Ungewöhnliche ihrer Krankheit hervor, …"
                            },
                            {
                                "example_id": "f45da012-5536-477c-babf-86a0d4a0c9cd",
                                "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                                "text": "Eine wirklich von der Epilepsie befallene Kranke ist bewusstlos, hört und sieht also nicht, was in ihrer Umgebung vorgeht; die Simulantin aber merkt auf."
                            },
                            {
                                "example_id": "d23643b9-38f0-47f2-82ca-e8b74b50d609",
                                "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                                "text": "Dann gewann sie überlegen die Abfahrt der Damen, strahlte wie zwei Atomkraftwerke, hatte höhere Einschaltquoten als „American Idol“ – und musste sich als Simulantin beschimpfen lassen."
                            },
                            {
                                "example_id": "eda93975-7d8c-4b58-bf05-1d6b6649c17e",
                                "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                                "text": "In Frankfurt berichtete eine Frau, sie sei jahrelang als Simulantin abgestempelt worden, bis ein Arzt erkannt habe, dass die Schmerzen im Darmbereich wohl von dem kaputten künstlichen Hüftgelenk herrührten."
                            },
                            {
                                "example_id": "062a1b8e-7c5b-48e7-9be5-7f86e103d8d7",
                                "sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                                "text": "Eine Kubanische Zwergboa, die hätt er malen sollen. Diese begnadete Simulantin, die ihre Fressfeinde reinlegt, indem sie Unappetitlichkeit vorschützt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252e1772-8035-44cc-8ea1-bfda3f2c116d",
                        "source_entry_id": "04f02cb1-e0a5-3524-876a-e9381cf4f60a",
                        "source_sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                        "source_sense_description": "Frau, die etwas, meist eine Krankheit, vortäuscht",
                        "target_lang_word": "malingerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malingerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                        "entry_id": "cd0a4517-1c49-3aee-8f98-53e216b16894",
                                        "glosses": [
                                            "A person who malingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe21d44-4b16-4d24-baa0-f8bea204ffb8",
                                                "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                                "text": "It is telling, in this context of rising rates of mental illness, that New Labour committed itself, early in its third term in government, to removing people from Incapacity Benefit, implying that many, if not most, claimants are malingerers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16588f7b-53a5-435d-8ad3-22ec06e3c621",
                        "source_entry_id": "04f02cb1-e0a5-3524-876a-e9381cf4f60a",
                        "source_sense_id": "7f9b9ca5-2d9e-3193-b21d-a6875ac98a3e",
                        "source_sense_description": "Frau, die etwas, meist eine Krankheit, vortäuscht",
                        "target_lang_word": "simulatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c6c3998-985d-37dd-a978-bd6a1c51fa52",
                                        "entry_id": "94b9f813-91a3-3270-bc34-d2f0e0c09548",
                                        "glosses": [
                                            "Celle qui simule, qui feint un sentiment, une attitude, une action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3ca69b-a15f-4c34-b6ed-2398d0174294",
                                                "sense_id": "0c6c3998-985d-37dd-a978-bd6a1c51fa52",
                                                "text": "L’archevêque, Octave de Bellegarde, a fait découvrir et avouer la supercherie de la simulatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990cffe7-4864-311f-9aac-ca682e131136",
                                        "entry_id": "94b9f813-91a3-3270-bc34-d2f0e0c09548",
                                        "glosses": [
                                            "Celle qui simule la folie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac5edc5-959f-4d86-af9e-056c0f6ded66",
                                                "sense_id": "990cffe7-4864-311f-9aac-ca682e131136",
                                                "text": "Du moment que la simulatrice ne pourra pas éviter un examen médical bien conduit, la fraude sera facilement reconnue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eabd9cb-3f9c-3891-b836-3cb09c2eb124",
                                        "entry_id": "94b9f813-91a3-3270-bc34-d2f0e0c09548",
                                        "glosses": [
                                            "Celle qui simule l’orgasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0705f161-9760-4472-9c6f-9c746532653e",
                                                "sense_id": "1eabd9cb-3f9c-3891-b836-3cb09c2eb124",
                                                "text": "Il serait obligé de faire d’elle une simulatrice, une de ces femmes qui gémissent et se cambrent sous les va et vient du pénis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
