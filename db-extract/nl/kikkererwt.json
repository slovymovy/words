                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e74ee63-0808-49b9-911c-113e881631f7",
                                                "sense_id": "9a2cb645-3012-3a26-9ec1-ab8293bfab04",
                                                "text": "Chickpea is valued for its nutritive seeds with high protein content."
