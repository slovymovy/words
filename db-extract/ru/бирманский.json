                                                "sense_id": "2e481709-920e-3c85-90ef-a5460f27b61d",
                                                "text": "Today around 90 percent of people use Zawgyi instead of Unicode.\nIncompatible without fiddly plug-ins, it only allows people to communicate in Burmese with other Zawgyi users, excluding the nation’s minority languages. Its clunkiness also means search functions do not work, crippling data storage systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c653623-f280-3ace-8158-ce5bf1831462",
                                        "entry_id": "b2a97e54-7c23-3258-ac65-ec5bee8a54ec",
                                        "glosses": [
                                            "The script in which the Burmese language is written."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff11de89-caeb-4f6c-89ff-3a05bd566042",
                        "source_entry_id": "f40a9ffb-a5a7-3462-8712-a2dbfbe27dea",
                        "source_sense_id": "afade6e3-d117-389e-8090-2f12c81f5e40",
                        "target_lang_word": "burmesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burmesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bde8f435-d878-330e-9936-c9c3126b4b3a",
                                        "entry_id": "2f0bc170-7094-3d89-829c-6bc3f77e55ad",
                                        "glosses": [
                                            "den asiatischen Staat Burma (Myanmar) betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0de9eb-c9c5-4053-8bef-59c2ef5bf2ed",
                                                "sense_id": "bde8f435-d878-330e-9936-c9c3126b4b3a",
                                                "text": "„Kämpfe zwischen von ethnischen Minderheiten wie den Kachin oder den Wa gebildeten Guerillagruppen und dem burmesischen Militär gibt es bereits seit Jahrzehnten, zuletzt ist es im an Bangladesch angrenzenden Bundesstaat Rakhine zu Unruhen gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f890e64-487d-39fa-9c99-0c4201197bbb",
                                        "entry_id": "2f0bc170-7094-3d89-829c-6bc3f77e55ad",
                                        "glosses": [
                                            "zur Sprache Burmesisch gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66968eca-a8ad-465e-98be-8dfb3e9fc3f1",
                                                "sense_id": "4f890e64-487d-39fa-9c99-0c4201197bbb",
                                                "text": "Dies war auch der Grund dafür, dass er sich für die burmesische Sprache zu interessieren begann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b27edddc-89fd-42b8-8808-34b60dde0f8b",
                        "source_entry_id": "f40a9ffb-a5a7-3462-8712-a2dbfbe27dea",
                        "source_sense_id": "afade6e3-d117-389e-8090-2f12c81f5e40",
