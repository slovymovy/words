                    }
                ],
                "translations": [
                    {
                        "translation_id": "6da6d1b1-384b-4ffa-baf6-23e08e2a3769",
                        "source_entry_id": "9656d626-ef51-3c8a-a0e9-6e46df6d0bb8",
                        "source_sense_id": "abf54cb3-4f66-35ff-beb9-77b685601daa",
                        "source_sense_description": "native of the Maghreb",
                        "target_lang_word": "Maghrebijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maghrebijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "15e29ef1-6df7-3faf-85d3-6bb2b812d704",
                                        "entry_id": "e889c628-c2e0-366d-85b4-4edcb260de0b",
                                        "glosses": [
                                            "iemand uit Noord-Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "938d9cf2-71f9-466b-b42d-9a6422e5c870",
                                                "sense_id": "15e29ef1-6df7-3faf-85d3-6bb2b812d704",
                                                "text": "‘In het begin was het hier echt heel goed leven. Geen enkele deur was gesloten. Er was veel sociale interactie, zelfs tussen Vlamingen en Maghrebijnen’"
                                            },
                                            {
                                                "example_id": "a2c9170e-2055-4d59-8299-5ffb04bd6322",
                                                "sense_id": "15e29ef1-6df7-3faf-85d3-6bb2b812d704",
                                                "text": "Hier doen alleen enkele communisten op leeftijd een poging de van oorsprong vooral Afrikaanse en Maghrebijnse kiezers te verleiden. „En wij zijn hier altijd, niet alleen rond verkiezingen”, verzekert Elisabeth Été, die in het communistische stadsbestuur wethouder is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1612f8be-c052-41a6-b737-b900babc31b7",
                        "source_entry_id": "9656d626-ef51-3c8a-a0e9-6e46df6d0bb8",
                        "source_sense_id": "abf54cb3-4f66-35ff-beb9-77b685601daa",
                        "source_sense_description": "native of the Maghreb",
                        "target_lang_word": "Maghrébin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maghrébin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42fc8cbc-784a-34b9-ac81-f1f9a2ec3c4e",
                                        "entry_id": "9cecd7a5-8da9-3f1a-ba91-d1c37d8545a4",
                                        "glosses": [
                                            "Personne qui est née dans un des pays du Maghreb (Maroc, Algérie, Tunisie), ou qui en est originaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3a6df6-7354-4f89-9cae-f5636e8023ef",
                                                "sense_id": "42fc8cbc-784a-34b9-ac81-f1f9a2ec3c4e",
                                                "text": "Ceux qui, à base d’arguments démagogiques, autoritaires et racistes, prétendent revenir au monde d’antan (« Travail, famille, patrie »), rejettent sur l’étranger, le Maghrébin ou le juif la cause de tous les désordres, de tous les maux et de toutes les insécurités."
                                            },
                                            {
                                                "example_id": "3d4519d2-1c2c-4dd8-b263-223ee70b041c",
                                                "sense_id": "42fc8cbc-784a-34b9-ac81-f1f9a2ec3c4e",
                                                "text": "Il est peut-être plus important pour, disons, un Maghrébin, d'être Arabe et musulman que d'être Tunisien ou Marocain, encore que cela demanderait à être vérifié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
