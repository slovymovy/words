                        "form": "multi-joueur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7235d0e7-ad38-3034-8a38-ee6dfb9ad181",
                        "entry_id": "44ec7fc6-37db-3a0a-be44-399a38c06c94",
                        "glosses": [
                            "Destiné à plusieurs joueurs humains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d4da03-c243-4400-ae22-a24a15419fb8",
                                "sense_id": "7235d0e7-ad38-3034-8a38-ee6dfb9ad181",
                                "text": "Je n'aime pas non plus les jeux massivement multijoueurs, parce que trop répétitifs et un peu trop peuplés de gonadoclastes. Ça n'empêche pas que ce sont des activités qui sont, de mon point de vue, une forme de jeu de rôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94e30a7c-3149-420e-a6a1-1fa84bd4c3f8",
                        "source_entry_id": "44ec7fc6-37db-3a0a-be44-399a38c06c94",
                        "source_sense_id": "7235d0e7-ad38-3034-8a38-ee6dfb9ad181",
                        "target_lang_word": "Mehrspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d03448ac-1aae-4585-b299-5d16e64293da",
                        "source_entry_id": "44ec7fc6-37db-3a0a-be44-399a38c06c94",
                        "source_sense_id": "7235d0e7-ad38-3034-8a38-ee6dfb9ad181",
                        "target_lang_word": "multiplayer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplayer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "303da5c0-a1c7-38f4-9e4d-9238fa458f01",
                                        "entry_id": "d299545e-1745-34c6-8483-9a799ebd786a",
                                        "glosses": [
                                            "Requiring or allowing multiple (or more than the usual two) players to play simultaneously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "multiplayer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ab3fb3-4597-3250-8a13-93d1c97c29f4",
                                        "entry_id": "f35f07af-bff9-3638-9d75-34a732a438cb",
                                        "glosses": [
                                            "The feature of a video game where multiple human players play simultaneously."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e775da55-dcf6-4ae5-9a6c-e91b1bcc2c40",
                                                "sense_id": "07ab3fb3-4597-3250-8a13-93d1c97c29f4",
                                                "text": "I just heard that the game will have multiplayer when it comes out!"
                                            },
                                            {
                                                "example_id": "10b7e39a-e02b-4793-baff-546ec43f3115",
                                                "sense_id": "07ab3fb3-4597-3250-8a13-93d1c97c29f4",
                                                "text": "He always loved to play multiplayer games with his friends."
                                            },
                                            {
                                                "example_id": "8b9a56bd-f211-4ce6-b9eb-9c389f148e9c",
                                                "sense_id": "07ab3fb3-4597-3250-8a13-93d1c97c29f4",
                                                "text": "Glu Mobile, who realigned its workforce towards centralized GaaS functions last year, announced earlier this month that it will shut down GameSpy Technology on May 31. The service provides multiplayer functionality for dozens of games on consoles, computers and mobile devices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082491a0-6369-3e68-8940-f08c52b69e31",
                                        "entry_id": "f35f07af-bff9-3638-9d75-34a732a438cb",
                                        "glosses": [
                                            "Video game players who play multiplayer games."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357e645d-a46e-4fc8-90b2-e87b4df1318c",
                                                "sense_id": "082491a0-6369-3e68-8940-f08c52b69e31",
                                                "text": "The audio suggestions just mentioned would be advantageous when pairs are working together at a computer or multiplayers are collaborating or competing in online educational games and simulations."
                                            },
                                            {
                                                "example_id": "5baf117c-e9f0-4cae-ad6e-d623a0830c48",
                                                "sense_id": "082491a0-6369-3e68-8940-f08c52b69e31",
                                                "text": "After dinner, Isaac brought out his portable gaming console for multiplayers, and he and I began our car racing battle while the others unpacked and brought out the Japanese futons, duvets, and pillows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd31d5de-53a0-4b6e-b275-7f3c552bb0dd",
                        "source_entry_id": "44ec7fc6-37db-3a0a-be44-399a38c06c94",
