                            },
                            {
                                "example_id": "783b5166-fb65-47f1-8268-80eb86289867",
                                "sense_id": "779e9efe-5ab3-39b1-803d-57ae5ae0aad7",
                                "text": "Die Vogelgrippe ist meist eine unbemerkte oder nichtklinische virale Infektion von Wildvögeln."
                            }
