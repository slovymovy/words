                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20762501-0bd1-43bd-b1ec-bb1f48ae07ee",
                                                "sense_id": "6c3d4659-a900-3c0f-9adf-9e2e22a50e98",
                                                "text": "Veel mensen noemen hem een idioot."
                                            },
                                            {
                                                "example_id": "2f239c27-c288-4710-8524-6a9a3c3d4414",
                                                "sense_id": "6c3d4659-a900-3c0f-9adf-9e2e22a50e98",
                                                "text": "Ondanks alle waarschuwingen van Mutti om geen schandaal te veroorzaken bij de diploma-uitreiking was ze er toch buitengewoon goed in geslaagd, ze had een gecommitteerde op de grofst mogelijke manier beledigd door hem zowel een idioot als een nazi te noemen en kreeg komisch genoeg als straf een lager cijfer voor Duits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f0e38a7-91a6-39f6-913e-e6301cfc62f9",
                                        "entry_id": "3bb68c51-2d3c-36fd-a516-b309e99d17f4",
                                        "glosses": [
                                            "scheldwoord voor iemand met een afwijkend standpunt of van afwijkend gedrag"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca8ddf7-0071-4833-bbc7-52dfde04b491",
                                                "sense_id": "0f0e38a7-91a6-39f6-913e-e6301cfc62f9",
                                                "text": "Wat ben jij toch een idioot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8c6a558-5d7e-46c7-a3b8-3b8f82beac0a",
