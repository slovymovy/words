        "fr-extract.jsonl": [
            {
                "entry_id": "d9e15f4b-d58c-37a0-abc3-994767271fb3",
                "word": "loyauté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "65be3976-db27-4ede-accc-3356fef6b97b",
                        "entry_id": "d9e15f4b-d58c-37a0-abc3-994767271fb3",
                        "tags": [
                            "plural"
                        ],
                        "form": "loyautés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                        "entry_id": "d9e15f4b-d58c-37a0-abc3-994767271fb3",
                        "glosses": [
                            "Fidélité à tenir parole, à faire honneur à ses engagements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df98325-5f78-40f1-b953-4a32562c0d21",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "Il félicita le défenseur de sa « loyauté, » et profita habilement de cette loyauté."
                            },
                            {
                                "example_id": "c33b1905-a352-40a4-b0ee-8ce9b8a9ba89",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "En somme, il appartenait à la race qui avait fait l’Angleterre et l’Amérique ce qu’elles étaient. […] : sa personne constituait simplement un individu agressif, doué d’un sens aigu de l’appropriation, sans aucun sentiment de la cohésion de l’État, sans loyauté, sans dévouement, sans code d’honneur et même sans code de courage."
                            },
                            {
                                "example_id": "ec260551-87a5-421b-bdea-5dea6d2a140f",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "M. Fabre représentait l’Honneur, la Loyauté, la Probité, la vie régulière et laborieuse, le livret de Caisse d’Épargne, le pain gagné à la sueur d’un front d’exploité, — bref tout ce que les bourgeois proclament des lèvres comme des vertus civiques."
                            },
                            {
                                "example_id": "0877caba-550e-47c3-b12c-8945398bf3d2",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "Ce retour, nous l'avons vu, n'est pas la simple rémanence d'un passé tribal et paysan, mais la reconstitution dans une société moderne de modes traditionnels de loyauté et d'exercice du pouvoir : alliances matrimoniales, solidarité des corporations, clientélisme, c'est-à-dire échange de la loyauté politique contre une prébende matérielle."
                            },
                            {
                                "example_id": "aea557d0-6a7e-4786-9e12-5e7b5b62dc39",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "L’intégrité journalistique repose largement sur l’absence de conflits de loyautés, et même sur l’absence d’apparence de tels conflits."
                            },
                            {
                                "example_id": "d4815502-da58-4f88-9145-9b1b8f007a6c",
                                "sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                                "text": "Une doctrine claire c’est l’identification et la formulation exempte d’ambiguïtés — condition de la loyauté dans toute discussion privée ou publique — d’idées structurantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28174eb4-330d-4ee3-a918-bade2a3b3bea",
                        "source_entry_id": "d9e15f4b-d58c-37a0-abc3-994767271fb3",
                        "source_sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                        "target_lang_word": "Loyalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Loyalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                        "entry_id": "404edfe5-0147-3158-9cba-06a39dbab5d5",
                                        "glosses": [
                                            "anhaltende, zuverlässige Unterstützung für jemand oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55584a99-a2d7-4a98-99cd-5efb17b58215",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Er erwies seinem Betrieb während seiner ganzen Zugehörigkeit Loyalität."
                                            },
                                            {
                                                "example_id": "4ac4395d-a0d0-4c2f-9eef-0b23614fcea9",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Es ist eine Frage der Loyalität, ob wir jetzt bleiben."
                                            },
                                            {
                                                "example_id": "475c3a12-310c-4b51-97b0-a5236b25e0c7",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Seine Loyalität konnte man sicher nicht in Frage stellen."
                                            },
                                            {
                                                "example_id": "114cc829-66a0-49dc-b9f4-75f1b8ce68e2",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Ihr Verhalten war grausam, was seiner Loyalität keinen Abbruch tat."
                                            },
                                            {
                                                "example_id": "5461fb27-6ecd-4ae6-9b74-28855ec17376",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                                            },
                                            {
                                                "example_id": "b9582b07-6a8c-4b6f-b954-3e5861afc3db",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Über meine Loyalität zu Deutschland muss sich niemand Sorgen machen.“"
                                            },
                                            {
                                                "example_id": "ad9abeae-ff61-4df1-9250-6e623e27d948",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Wie Moorcroft erkannten sie, daß Csomas Loyalität gegenüber den Briten aufrichtig und seine Arbeit an der tibetischen Sprache von echtem Wert war.“"
                                            },
                                            {
                                                "example_id": "430e9118-4551-4125-bf51-71c0ebabc107",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Damit gewinnt er die Loyalität jener Menschen, deren Häuser er im Bruderkampf noch niedergebrannt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1ee3a90-a3d9-45af-a6a4-554eeccbbbd4",
                        "source_entry_id": "d9e15f4b-d58c-37a0-abc3-994767271fb3",
                        "source_sense_id": "3c9415db-a7ea-3169-9174-51e2e5c9b997",
                        "target_lang_word": "loyalty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loyalty",
