{
    "word_family": [
        "introduction",
        "introductif",
        "introducteur",
        "introductrice",
        "réintroduire",
        "réintroduction"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddfb08a0-4301-36b1-978e-fea018c7a544",
                    "sense_definition": "Faire entrer une chose dans une autre ; insérer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>introduire</w> la carte bancaire dans le lecteur avant de taper le code."
                        },
                        {
                            "text": "Le gardien <w>introduisit</w> délicatement la clé dans la serrure pour ne réveiller personne."
                        }
                    ],
                    "synonyms": [
                        "insérer",
                        "glisser",
                        "enfoncer"
                    ],
                    "antonyms": [
                        "extraire",
                        "retirer"
                    ],
                    "common_phrases": [
                        "introduire la clé dans la serrure",
                        "introduire une carte"
                    ]
                },
                {
                    "sense_id": "1d35d236-18d3-3424-80fa-5d8c52ff6a99",
                    "sense_definition": "Mettre en pratique ou faire adopter une règle, une méthode ou une coutume nouvelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conceptuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur souhaite <w>introduire</w> de nouvelles méthodes de travail au sein de l'équipe."
                        },
                        {
                            "text": "Cette loi récente a <w>introduit</w> plusieurs changements majeurs pour les droits des salariés."
                        }
                    ],
                    "synonyms": [
                        "établir",
                        "instaurer",
                        "adopter"
                    ],
                    "antonyms": [
                        "supprimer",
                        "abolir"
                    ],
                    "common_phrases": [
                        "introduire des changements",
                        "introduire une réforme"
                    ]
                },
                {
                    "sense_id": "d530441b-967a-36d0-87d0-41cf6f7d6bbd",
                    "sense_definition": "Faire entrer ou guider quelqu'un dans un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé m'a <w>introduit</w> dans la grande salle où se tenait la réunion."
                        },
                        {
                            "text": "Elle <w>introduisit</w> discrètement son invité par l'entrée de service pour éviter le bruit."
                        }
                    ],
                    "synonyms": [
                        "faire entrer",
                        "mener"
                    ],
                    "antonyms": [
                        "expulser",
                        "reconduire"
                    ],
                    "common_phrases": [
                        "introduire un invité"
                    ]
                },
                {
                    "sense_id": "f91af4ca-3524-3c12-9df2-8d656a087d56",
                    "sense_definition": "Entrer ou pénétrer dans un lieu, souvent sans autorisation ou de manière clandestine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un voleur s'est <w>introduit</w> dans l'immeuble pendant la nuit sans éveiller les voisins."
                        },
                        {
                            "text": "Les manifestants ont tenté de s'<w>introduire</w> dans la cour principale de la mairie."
                        }
                    ],
                    "synonyms": [
                        "pénétrer",
                        "s'infiltrer"
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "s'introduire par effraction"
                    ]
                },
                {
                    "sense_id": "8f4450c1-03b6-3116-9ed3-470e84c61a64",
                    "sense_definition": "Présenter et faire admettre quelqu'un dans un milieu social ou auprès d'une personnalité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son collègue l'a <w>introduit</w> auprès du ministre pour lui exposer directement le projet."
                        },
                        {
                            "text": "Grâce à ses relations influentes, il s'est vite <w>introduit</w> dans la haute société parisienne."
                        }
                    ],
                    "synonyms": [
                        "présenter",
                        "recommander"
                    ],
                    "common_phrases": [
                        "introduire auprès de"
                    ]
                },
                {
                    "sense_id": "dda1c118-ad4e-39d4-911b-3b67b3213b89",
                    "sense_definition": "Implanter une espèce vivante dans un milieu où elle n'existait pas auparavant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les colons ont <w>introduit</w> plusieurs variétés d'arbres fruitiers sur cette île isolée."
                        },
                        {
                            "text": "Cette plante aquatique menace les cours d'eau locaux depuis qu'elle a été <w>introduite</w>."
                        }
                    ],
                    "synonyms": [
                        "implanter",
                        "acclimater"
                    ],
                    "common_phrases": [
                        "introduire une espèce"
                    ]
                },
                {
                    "sense_id": "68baf431-e27e-306b-9b55-dbc9da87faba",
                    "sense_definition": "Faire entrer des marchandises ou des produits sur un territoire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les douaniers ont arrêté des contrebandiers qui tentaient d'<w>introduire</w> du tabac illégalement."
                        },
                        {
                            "text": "Il est strictement interdit d'<w>introduire</w> ces produits alimentaires sur le territoire national."
                        }
                    ],
                    "synonyms": [
                        "importer"
                    ],
                    "antonyms": [
                        "exporter"
                    ],
                    "common_phrases": [
                        "introduire en fraude"
                    ]
                },
                {
                    "sense_id": "43126585-3c4e-377c-8f9a-fa56d7ad0e8f",
                    "sense_definition": "Faire apparaître un personnage ou un thème dans une œuvre artistique ou littéraire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conceptuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dramaturge a <w>introduit</w> un nouveau personnage au deuxième acte pour relancer l'intrigue."
                        },
                        {
                            "text": "L'écrivain <w>introduit</w> ce thème philosophique dès les premières pages de son roman."
                        }
                    ],
                    "synonyms": [
                        "intégrer",
                        "insérer"
                    ],
                    "common_phrases": [
                        "introduire un personnage"
                    ]
                }
            ]
        }
    ]
}