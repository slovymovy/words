                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fccb7393-6aea-4b2b-bf1f-920d50133f48",
                                "sense_id": "bdc0e0aa-f91d-3011-8e19-ef38f940cca2",
                                "text": "Cependant, réalisée dans de mauvaises conditions, la combustion du bois émet des polluants néfastes pour la santé, tels que furanes, benzènes, dioxines, composés organiques volatils (COV)… ainsi que des particules fines nocives."
                            },
                            {
                                "example_id": "a602c72d-498a-464e-bc7a-b7afbd640d71",
                                "sense_id": "bdc0e0aa-f91d-3011-8e19-ef38f940cca2",
                                "text": "Nos commencerons par l’étude de la structure du benzène et de l’aromaticité."
                            }
                        ]
                    }
                ],
