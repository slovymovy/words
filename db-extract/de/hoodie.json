                "senses": [
                    {
                        "sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                        "entry_id": "a059ee6b-23cd-332a-9247-a72d2ae157d5",
                        "glosses": [
                            "Pullover mit einer Kapuze"
                        ],
                        "tags": [
                            "Bekleidung"
                        ],
                        "examples": [
                            {
                                "example_id": "ccce61db-c3d1-45c1-8521-ad35f1fa8901",
                                "sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                                "text": "Ich trage meinen Hoodie in der Schule."
                            },
                            {
                                "example_id": "12a75927-0a5d-4a3f-990b-9e2a2e748555",
                                "sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                                "text": "Hier gibt es eine Vielzahl Sweatshirts, Sweatjacken oder Hoodies für jeden Look: vom Kapuzen-Sweatshirt im Vintage-Look bis zum bunt geringelten Sweat-Hoodie."
                            },
                            {
                                "example_id": "1e5ad513-da96-44ca-9eee-3592275af4ab",
                                "sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                                "text": "„Solche „Sie“-Momente machen deutlich, dass sich das eigentliche Alter auch unter Cap und Hoodie nicht dauerhaft verstecken lässt.“"
                            },
                            {
                                "example_id": "4665ba5f-0161-4842-92d5-54127c944eae",
                                "sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                                "text": "„Wie viele ambitionierte Unternehmer kommen im Hoodie zur Sitzung mit Investoren – in der Hoffnung der nächste Mark Zuckerberg zu werden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab6f1cf4-ffb1-41c3-94a5-50b778654f9f",
                        "source_entry_id": "a059ee6b-23cd-332a-9247-a72d2ae157d5",
                        "source_sense_id": "0c886e9a-2851-3f31-9b60-3a9ce4b575de",
                        "source_sense_description": "Pullover mit einer Kapuze",
                        "target_lang_word": "hoodie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoodie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "658a2b00-74c2-3de6-860c-99e61cbfb690",
                                        "entry_id": "307222f1-5d21-3bac-9b6e-9649efb2ed4f",
                                        "glosses": [
                                            "A sweatshirt with an integral hood and, sometimes, a large kangaroo pocket at the front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed84ad41-cea6-4447-bdab-825400f01fb2",
                                                "sense_id": "658a2b00-74c2-3de6-860c-99e61cbfb690",
                                                "text": "You can buy hoodies on the cheap in summer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9c57d7-2935-3d3a-8170-ed783225e2e6",
                                        "entry_id": "307222f1-5d21-3bac-9b6e-9649efb2ed4f",
                                        "glosses": [
                                            "A young person wearing such a sweatshirt, usually a male, stereotypically associated with antisocial behaviour."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a086e2b-917f-49ad-80ce-d149b04dc9cd",
                                                "sense_id": "fa9c57d7-2935-3d3a-8170-ed783225e2e6",
                                                "text": "David Cameron will completely re-engineer the Conservatives' image on crime this week with a remarkable speech calling for more understanding of 'hoodies' and criticising what he calls short-term solutions to curb youth crime such as anti-social behaviour orders and curfews."
                                            },
                                            {
                                                "example_id": "fc22915f-1cd1-4a03-9270-b690c2c45f0e",
                                                "sense_id": "fa9c57d7-2935-3d3a-8170-ed783225e2e6",
                                                "text": "En route, we dropped by the home of Lips — one of the very few gang members who still lived with his mother — to pick up some clothes for Tuggy. There, we discussed which pair of trainers to bring him — no small decision, as the soul of the hoodie resides in his trainers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8c2b76-a273-3bfd-938c-d143cbb59413",
                                        "entry_id": "307222f1-5d21-3bac-9b6e-9649efb2ed4f",
                                        "glosses": [
                                            "foreskin"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07daae55-7799-3651-a3dd-5bd3fb71fcca",
                                        "entry_id": "307222f1-5d21-3bac-9b6e-9649efb2ed4f",
                                        "glosses": [
                                            "The hooded crow, Corvus cornix."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
