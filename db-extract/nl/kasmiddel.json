                        "examples": [
                            {
                                "example_id": "121d1ad6-cc5a-4ee2-b04b-ae760bb6e310",
                                "sense_id": "266d8328-58d8-3441-89dd-91546f996663",
                                "text": "Volgens Nike is het inkopen van eigen aandelen een verstandige manier om met de kasmiddelen om te gaan en wordt daarmee bewezen dat waarde wordt gecreëerd voor de aandeelhouders. Over de afgelopen 10 jaar heeft Nike al 10 miljard dollar uitgegeven om meer dan 167 miljoen eigen aandelen in te kopen, aldus topman Mark Parker. Bij het slot van de handel op woensdag had Nike in totaal 453,87 miljoen uitstaande aandelen."
                            },
                            {
                                "example_id": "3dcae00c-cffd-46c7-82d1-0c7705648a77",
                                "sense_id": "266d8328-58d8-3441-89dd-91546f996663",
                                "text": "Als de lokale bank daarentegen gebrek aan kasmiddelen had, dan kon hij een voorschot bij diezelfde centrale opnemen."
                            }
                        ]
                    }
