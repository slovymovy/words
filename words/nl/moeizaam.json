                    "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                    "sense_definition": "Wat veel inspanning en tijd kost; niet vlot verlopend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economie maakt momenteel een <w>moeizaam</w> herstel door.",
                            "target_lang_translations": {
                                "ru": "Экономика в настоящее время переживает <w>трудное</w> восстановление.",
                                "en": "The economy is currently going through a <w>difficult</w> recovery.",
                                "de": "Die Wirtschaft durchläuft derzeit eine <w>mühsame</w> Erholung."
                            }
                        },
                        {
                            "text": "Het was een <w>moeizaam</w> proces om tot een goed akkoord te komen.",
                            "target_lang_translations": {
                                "ru": "Прийти к хорошему соглашению было <w>тяжёлым</w> процессом.",
                                "en": "It was a <w>laborious</w> process to reach a good agreement.",
                                "de": "Es war ein <w>mühsamer</w> Prozess, zu einer guten Einigung zu gelangen."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaar",
                        "lastig",
                        "inspannend"
                    ],
                    "antonyms": [
                        "vlot",
                        "soepel",
                        "gemakkelijk"
                    ],
                    "common_phrases": [
                        "een moeizaam proces",
                        "een moeizaam herstel",
                        "een moeizaam begin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий больших усилий и времени; протекающий не гладко",
                        "en": "Requiring much effort and time; not proceeding smoothly.",
                        "de": "Viel Anstrengung und Zeit erfordernd; nicht reibungslos verlaufend."
                    },
