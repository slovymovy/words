                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cisidentity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7940a43f-4071-3a7e-8106-3cfca79ed40a",
                                        "entry_id": "eae69727-017c-36c4-9aac-9984da363874",
                                        "glosses": [
                                            "Cisness; the state of being cis, of having a gender identity which is same from the sex one was assigned at birth (i.e. having a cisgender identity)."
                                        ],
