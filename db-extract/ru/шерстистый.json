                ],
                "translations": [
                    {
                        "translation_id": "d6cec12a-a014-4322-952e-3bb7ea7ef853",
                        "source_entry_id": "35cc1a27-b713-3195-a650-65e6d69b3093",
                        "source_sense_description": "имеющий длинную или густую шерсть",
                        "target_lang_word": "woolly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1345617-4d23-335c-be2e-6c12c55fb63a",
                                        "entry_id": "f6474e2b-643f-36de-a754-173959f6e880",
                                        "glosses": [
                                            "Made of wool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce145ba-076c-47ce-9f60-0915332e8d83",
                                                "sense_id": "e1345617-4d23-335c-be2e-6c12c55fb63a",
                                                "text": "Put on a woolly jumper and turn down the thermostat."
                                            },
                                            {
                                                "example_id": "5287376a-a087-4dbf-9f27-44eedce93247",
                                                "sense_id": "e1345617-4d23-335c-be2e-6c12c55fb63a",
                                                "text": "Sporting a woolly cardigan with four buttons on top of an Oxford smock without a collar, our man has a faintly folksy look about him, calling to mind a zingaro or a gypsy, a carny or a Mongol, but also (switching to a wholly distinct mythology and iconography) a hippy strumming his guitar in a barroom in Haight-Ashbury or at Big Sur or in Katmandu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5bff78-b276-3576-9d00-ec7d75ed42ef",
                                        "entry_id": "f6474e2b-643f-36de-a754-173959f6e880",
                                        "glosses": [
                                            "Having a thick, soft texture, as if made of wool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ade8305-f092-4a74-b3ac-7a1278c061bf",
                                                "sense_id": "2b5bff78-b276-3576-9d00-ec7d75ed42ef",
                                                "text": "woolly hair"
                                            },
                                            {
                                                "example_id": "1c6b9ec2-cf99-4bec-80e4-d95018dfcdfd",
                                                "sense_id": "2b5bff78-b276-3576-9d00-ec7d75ed42ef",
                                                "text": "There was nothing left in the fruit bowl but a brown banana and a couple of woolly pears."
                                            },
                                            {
                                                "example_id": "2d5117b5-3886-41d1-a2ed-c2d6a379a44c",
                                                "sense_id": "2b5bff78-b276-3576-9d00-ec7d75ed42ef",
                                                "text": "My skin is black / My arms are long / My hair is woolly / My back is strong"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40598789-f0e8-36fd-9b25-16a6d87b7128",
                                        "entry_id": "f6474e2b-643f-36de-a754-173959f6e880",
                                        "glosses": [
                                            "Unclear, fuzzy, hazy, cloudy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ce0238-5ce7-4968-b368-83abdd9c3985",
                                                "sense_id": "40598789-f0e8-36fd-9b25-16a6d87b7128",
                                                "text": "That's the sort of woolly thinking that causes wars to start."
                                            },
                                            {
                                                "example_id": "c0e6e5ae-e652-4bbc-a22d-28679dd0cb86",
                                                "sense_id": "40598789-f0e8-36fd-9b25-16a6d87b7128",
                                                "text": "To call David Lean's Dr Zhivago a translation of Pasternak's novel is not only to disregard the specificity of film art, but to make such woolly use of the word ‘translation’ as to fit it to refer to any kind of transformation. Knitting included."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7872a6e-0c48-3e14-b842-344f90d7017f",
                                        "entry_id": "f6474e2b-643f-36de-a754-173959f6e880",
                                        "glosses": [
                                            "Clothed in wool."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fd7bfb9-f43a-43fe-99ff-bd63dc88a1eb",
                                                "sense_id": "e7872a6e-0c48-3e14-b842-344f90d7017f",
                                                "text": "woolly breeders"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa848c52-99a2-35a0-8ec0-749aa5305d69",
                                        "entry_id": "f6474e2b-643f-36de-a754-173959f6e880",
                                        "glosses": [
                                            "Cross; irritable."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567bf2b0-c133-46b2-a38c-78c441c22330",
                                                "sense_id": "aa848c52-99a2-35a0-8ec0-749aa5305d69",
                                                "text": "[…] and don't get woolly because some of your little \"deals\" don't come off. You'd soon consider yourself the superior of God Almighty Himself if He didn't set you in your place once in a while."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dccdb37-4b54-3291-8a6a-9e70dd0dd443",
                                        "entry_id": "14b2da22-822e-3f0f-9747-607ee1465b80",
                                        "glosses": [
                                            "A sweater or similar garment made of wool."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1a3342-bac3-4dc5-9584-378fc5a50ee1",
                                                "sense_id": "2dccdb37-4b54-3291-8a6a-9e70dd0dd443",
                                                "text": "`I've got a rotten cold and I'm not taking my woollies off until it's better.'"
                                            },
                                            {
                                                "example_id": "0286fefa-2c85-4d7f-9362-35440d19c08c",
                                                "sense_id": "2dccdb37-4b54-3291-8a6a-9e70dd0dd443",
                                                "text": "Being an innocent Australian abroad in a European winter, I had taken with me every winter woolly I could borrow or squeeze out of friends and associates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c04ae423-312e-3aa3-8632-da29cf82e786",
                                        "entry_id": "14b2da22-822e-3f0f-9747-607ee1465b80",
                                        "glosses": [
                                            "A sheep not yet shorn."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "449bb0be-8e74-3733-a747-15e5b7e4d098",
                                        "entry_id": "14b2da22-822e-3f0f-9747-607ee1465b80",
                                        "glosses": [
                                            "A piece of woolwork."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "woolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43f6ef7-faeb-39bf-ade7-6f17271e690a",
                                        "entry_id": "b7cd94f0-dda0-3ea4-9d58-3290b3518d04",
                                        "glosses": [
                                            "A woolly back; someone from the area around Liverpool, not from Liverpool itself."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c483882f-999d-458c-bf1f-232ca9502c9d",
                        "source_entry_id": "35cc1a27-b713-3195-a650-65e6d69b3093",
                        "source_sense_description": "имеющий длинную или густую шерсть",
                        "target_lang_word": "fleecy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleecy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                        "entry_id": "e6bf212d-bd5c-30c8-b1fd-25eac869066f",
                                        "glosses": [
                                            "Resembling or covered in fleece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2eaa8b-8a19-435e-8ce9-06d3103d7a60",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "Her path was on the briny deep;\nYet no white sail propell'd her course,\nNor measured oar with graceful sweep\nUrged her to stem the billow's force;\nSelf-moved, with fleecy track she past,\nDisdaining in her pride\nTo woo the breeze or shun the blast,\nOr wait the rolling tide;..."
                                            },
                                            {
                                                "example_id": "9ee71490-76e4-4bd1-88a3-a2dc705beac4",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "{...} turning to take a last glance into the valley, whence a light mist mounted and formed a fleecy cloud on the skirts of the blue."
                                            },
                                            {
                                                "example_id": "87a47ebb-c316-47de-b142-294bd406aa97",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "e5a8583e-ebef-45dc-9a55-65533ea233d8",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "Here the galley paused not at all, but floated easily in the blue of the sky among fleecy clouds tinted with rose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
