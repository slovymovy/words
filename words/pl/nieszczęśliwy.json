                                "en": "Due to an <w>unfortunate</w> coincidence, I missed my flight.",
                                "nl": "Door een <w>ongelukkig</w> toeval heb ik mijn vlucht gemist.",
                                "de": "Durch eine <w>unglückliche</w> Fügung der Umstände habe ich das Flugzeug verpasst.",
                                "fr": "Par un <w>malheureux</w> concours de circonstances, j'ai raté mon avion.",
                                "it": "A causa di una <w>sfortunata</w> coincidenza ho perso l'aereo.",
                                "cs": "Kvůli <w>nešťastné</w> souhře okolností jsem zmeškal letadlo.",
                                "tr": "<w>Talihsiz</w> bir tesadüf yüzünden uçağı kaçırdım.",
                                "es": "Por una <w>desafortunada</w> coincidencia perdí el avión.",
                                "zh": "因为一次<w>不巧</w>的巧合，我误了飞机。"
                            }
