                ],
                "senses": [
                    {
                        "sense_id": "9dff9de3-0848-3a64-b62f-17191180821c",
                        "entry_id": "4690afdf-3c89-3d28-9d2e-c40d5e551187",
                        "glosses": [
                            "Unterricht nicht auf allen Gebieten, sondern vielmehr bereits berufsspezifisch anbietend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a61bcb-2dca-4a3a-9223-ec93e0496275",
                                "sense_id": "9dff9de3-0848-3a64-b62f-17191180821c",
                                "text": "„Rund 27.000 Schüler an allgemeinbildenden (AHS) und berufsbildenden höheren Schulen (BHS) haben die Zentralmatura im Fach Englisch geschrieben, dazu kamen noch rund 100 Kandidaten bei der Berufsreifeprüfung.“"
                            },
                            {
                                "example_id": "16d28126-79a7-4c2f-b14f-e144710f74e2",
                                "sense_id": "9dff9de3-0848-3a64-b62f-17191180821c",
                                "text": "„Die Professorin an der Wirtschaftsuniversität spricht in dem Zusammenhang nicht von Schulabbrechern, sondern lieber von Schulabgängern, die über keinen Abschluss einer Lehre, einer berufsbildenden mittleren Schule oder höheren Schule (Sekundarstufe 2) verfügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
