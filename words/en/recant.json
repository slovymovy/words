{
    "word_family": [
        "recantation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa7cf5fa-9b20-3a5e-9117-16c29d0c7f4e",
                    "sense_definition": "To formally and publicly withdraw or reject a previously stated opinion or belief.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "withdraw_statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness decided to <w>recant</w> his earlier testimony after new evidence was discovered.",
                            "target_lang_translations": {
                                "zh": "新证据发现后，该证人决定<w>撤回</w>之前的证词。"
                            }
                        },
                        {
                            "text": "Under pressure from the public, the politician was forced to <w>recant</w> his controversial remarks.",
                            "target_lang_translations": {
                                "zh": "在公众的压力下，这位政客被迫<w>收回</w>了他那些引发争议的言论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retract",
                        "withdraw",
                        "disavow"
                    ],
                    "antonyms": [
                        "affirm",
                        "maintain",
                        "uphold"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式且公开地撤回或放弃先前的言论、信仰或声明"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撤回",
                                "target_lang_sense_clarification": "收回原先的声明、证词或言论"
                            },
                            {
                                "target_lang_word": "宣布放弃",
                                "target_lang_sense_clarification": "公开宣布不再坚持先前的信仰或主张"
                            },
                            {
                                "target_lang_word": "改变",
                                "target_lang_sense_clarification": "收回或推翻先前的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa8379cd-5096-37eb-94c2-3801745a298e",
                    "sense_definition": "To adjust the angle or slope of a railway track on a curve.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers had to <w>recant</w> the tracks to ensure trains could safely travel at higher speeds.",
                            "target_lang_translations": {
                                "zh": "工程师们不得不<w>调整</w>铁轨的<w>超高</w>，以确保列车能以更高速度安全行驶。"
                            }
                        },
                        {
                            "text": "The maintenance crew will <w>recant</w> the curve to improve passenger comfort during the turn.",
                            "target_lang_translations": {
                                "zh": "维修人员将<w>重新调整</w>弯道轨道的<w>倾角</w>，以提高乘客在转弯时的舒适度。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "调整铁轨弯道处的倾角或坡度（超高）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "调整超高",
                                "target_lang_sense_clarification": "铁路工程中重新调整弯道外轨倾斜高度"
                            },
                            {
                                "target_lang_word": "重新调整倾角",
                                "target_lang_sense_clarification": "调整轨道在弯道处的倾斜角度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}