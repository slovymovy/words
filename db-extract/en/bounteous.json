                "senses": [
                    {
                        "sense_id": "59075a82-ac0d-3325-867d-83a33e0c2a8d",
                        "entry_id": "e7ce1b71-db87-3706-b977-31a3120350ed",
                        "glosses": [
                            "Inclined to be generous."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "c4a41524-6a71-4b44-935c-3e4d4c6ee8ea",
                                "sense_id": "59075a82-ac0d-3325-867d-83a33e0c2a8d",
                                "text": "Which with a bounteous hand was kindly lent"
                            },
                            {
                                "example_id": "cb553367-6109-436e-b11d-69433b5a9dfc",
                                "sense_id": "59075a82-ac0d-3325-867d-83a33e0c2a8d",
                                "text": "Be bounteous at our Meale. Giue me thy hand, / Thou haſt bin rightly honeſt, ſo haſt thou […]"
                            },
                            {
                                "example_id": "281571d7-ef30-4ae5-adee-c1ea01ab3da5",
                                "sense_id": "59075a82-ac0d-3325-867d-83a33e0c2a8d",
                                "text": "Hail, univerſal Lord, be bounteous ſtill / To give us onely good; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b23a02dc-ac55-3b4b-b5ee-5200f605a753",
                        "entry_id": "e7ce1b71-db87-3706-b977-31a3120350ed",
                        "glosses": [
                            "Liberal or abundant."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fce68c74-5e39-49ff-b82a-ffde13c5d7f9",
                                "sense_id": "b23a02dc-ac55-3b4b-b5ee-5200f605a753",
                                "text": "“Your Grace may be well assured,” said the Friar, “that, with the grace of Saint Dunstan, I shall find the way of multiplying your most bounteous gift.”"
                            },
                            {
                                "example_id": "0f38557b-2aa9-4dde-9d08-74afa403892e",
                                "sense_id": "b23a02dc-ac55-3b4b-b5ee-5200f605a753",
                                "text": "“I’d like to say it’s not just bounteous privilege, but it is. People like Boris Johnson, Rishi Sunak, they’re incredibly cut off from the world. […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f51355f-f91f-4629-a1dc-a23164102948",
                        "source_entry_id": "e7ce1b71-db87-3706-b977-31a3120350ed",
                        "source_sense_description": "inclined to be generous",
                        "target_lang_word": "štědrý",
