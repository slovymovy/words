                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a41cdf-f558-45ae-bad4-7d03eb837475",
                                "sense_id": "b1b86fb6-44eb-35b7-9d18-0930238aa221",
                                "text": "Mam nadzieję, że kolega czekający na skrzyżowaniu ma chociaż coś ciepłego w termosie."
