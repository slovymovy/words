                                    {
                                        "sense_id": "c128a88b-6546-3700-9b98-db315c1d5e87",
                                        "entry_id": "f4bcd88b-241d-32cc-8b69-34e83e5349eb",
                                        "glosses": [
                                            "Medizin, Psychologie: die Psychosomatik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92693ddd-f83c-4695-8f77-55829e7cab18",
                                                "sense_id": "c128a88b-6546-3700-9b98-db315c1d5e87",
                                                "text": "Von der Frühgeschichte bis zum 19. Jahrhundert war eine psychosomatische Betrachtungsweise des Menschen als integraler Bestandteil der Heilkunde so selbstverständlich, dass sie als solche nicht hervorgehoben zu werden brauchte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fd7b709-4fa4-3f86-9f8b-5b8f702006c4",
                                        "entry_id": "f4bcd88b-241d-32cc-8b69-34e83e5349eb",
                                        "glosses": [
                                            "Medizin, Psychologie: körperlich, aber durch Seelisches hervorgerufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f9376f2-505f-4a97-a87f-3a8a73ae6f96",
                                                "sense_id": "8fd7b709-4fa4-3f86-9f8b-5b8f702006c4",
                                                "text": "Die Rückenschmerzen können auch psychosomatischer Natur sein."
                                            },
                                            {
                                                "example_id": "f23ec55d-70f6-4e4d-9fa6-fcbe7d3ee53b",
                                                "sense_id": "8fd7b709-4fa4-3f86-9f8b-5b8f702006c4",
                                                "text": "Psychosomatische Erkrankungen kann man nicht allein mit Medikamenten heilen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
