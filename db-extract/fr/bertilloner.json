                "senses": [
                    {
                        "sense_id": "861c8b45-b88b-326f-8662-eeb0c5dad1f6",
                        "entry_id": "2447d008-1d42-3149-a8a5-da7451e77035",
                        "glosses": [
                            "Autre orthographe, plus rare, de bertillonner (répertorier les caractéristiques physiques d’un individu selon la méthode d’Alphonse Bertillon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6143a959-b83b-4148-807f-ca5290eb934e",
                                "sense_id": "861c8b45-b88b-326f-8662-eeb0c5dad1f6",
                                "text": "Ton fils s’est refusé à se faire bertilloner."
                            },
                            {
                                "example_id": "5da2879d-068a-43cd-ade5-07a23036df00",
                                "sense_id": "861c8b45-b88b-326f-8662-eeb0c5dad1f6",
                                "text": "(…) quand je l’ai proposé pour le répertoire général de notre criminalité indigène, je me suis empressé de reconnaître que pendant une période de transition, nous serions encore « forcés de bertilloner quelques détenus » dont il faudrait faire rechercher les fiches en France en Hollande, en Suisse ou dans le Grand-Duché, ces pays ayant conservé jusqu’à présent le système anthropométrique."
                            }
                        ]
                    }
