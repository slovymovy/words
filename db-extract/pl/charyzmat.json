                    },
                    {
                        "sense_id": "fe7b37f3-d42d-3ae4-810c-12813515b828",
                        "entry_id": "249277f1-026c-388e-a368-acd605109a10",
                        "glosses": [
                            "szczególny dar otrzymywany przez człowieka od Ducha Świętego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023e9f2d-7233-4a29-9797-fbabac16e462",
                                "sense_id": "fe7b37f3-d42d-3ae4-810c-12813515b828",
                                "text": "Kościół pierwszych wieków posługiwał się charyzmatami bardzo intensywnie"
                            },
                            {
                                "example_id": "7ab4c78a-8e05-49e3-a1c6-8e4701c547b4",
                                "sense_id": "fe7b37f3-d42d-3ae4-810c-12813515b828",
                                "text": "Obdarowanie charyzmatem nie może zatem być głównym argumentem świadczącym o świętości człowieka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
