                "senses": [
                    {
                        "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                        "entry_id": "87eb9082-2208-365e-aa6e-370656e754c7",
                        "glosses": [
                            "für die öffentliche Sicherheit und Ordnung zuständige Behörde"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "1d0828eb-8dcc-427c-bc07-7a06e45c16df",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„Jong, mit unserer Opolifi kannste muhts Sports erleben.“"
                            },
                            {
                                "example_id": "f017610f-2a02-4ee4-83c4-f0f83e7bae3f",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„Bisher hat das noch keine Schießerei gegeben, obwohl die Opolifi in dieser Woche sowahr Tränengas bei den wüst parmantachen Taxis eingesetzt hat. Zum Glück war die Opolifi nicht weiß, sonst wären alle alten Gespenster aus der Apartheidszeit wieder aufgestanden. […] Nach dem vereinbarten Abschluss der Demo haben einige Chaoten einfach weiter gemacht, bis die Opolifi eingegriffen und sogar Autos beiseite geräumt hat.“"
                            },
                            {
                                "example_id": "62db2325-1957-4532-a829-b8db39337214",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„Die Opolifi hat viele Häscher.“"
                            },
                            {
                                "example_id": "3d32098e-2f34-4972-99da-c2636e526da9",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„Die überschüssigen Kräfte haben noch keine Ausbildung und sind also nicht zur Opolifi zu zählen.“"
                            },
                            {
                                "example_id": "9d0086f9-8b0a-4e85-970e-f32a8254a49e",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„Außerdem ist jetzt am Vormittag die Opolifi noch nicht unterwegs, die am vergangenen Wochenende nochall stief Oukies hat pusten und zittern und schließlich eine Nacht im Tschuckie hat schlafen lassen.“"
                            },
                            {
                                "example_id": "40a9fd19-941c-4259-8074-1e5abe40875f",
                                "sense_id": "59d99953-3843-36eb-98d0-f3ecb55849fc",
                                "text": "„An und für sich sollte die Opolifi, die den Verkehr regelt, jetzt nach Sonnunter für Otjiautos eine Fahrsperre verhängen, zum Selbst- und zum Objektschutz, dass die Tjorries noch eine Weile halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
