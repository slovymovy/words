                            {
                                "example_id": "e3e67fe1-28f4-467d-8f24-86240dd58409",
                                "sense_id": "8dc7a180-8dc5-3c4e-8d7b-a808b6c2e9c9",
                                "text": "We leerden de namen van de microscopische wezentjes en deeltjes pas kennen als ze ons bedreigden, van salmonella tot chlamydia, van influenza tot hiv, van meningokokken tot streptokokken tot staphylokokken."
                            },
                            {
                                "example_id": "0ce98acc-9c9c-478b-bc63-d763436c7090",
                                "sense_id": "8dc7a180-8dc5-3c4e-8d7b-a808b6c2e9c9",
                                "text": "Toch wordt er deze week weinig in de vijver gezwommen. Waarom? „Daar zit allemaal chlamydia in”, weet een campinggast."
                            }
                        ]
                    },
                    {
                        "sense_id": "e246b549-ad1a-38fc-b662-89476bc14de2",
                        "entry_id": "011d9753-401d-3a4b-97f9-c07ed67eef55",
                        "glosses": [
                            "seksueel overdraagbare ziekte of een ooginfectie veroorzaakt door bacteriën uit de groep Chlamydiae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b4de7e-9e17-43f7-933b-b4e0d00e1f2a",
                                "sense_id": "e246b549-ad1a-38fc-b662-89476bc14de2",
                                "text": "Opvallend is dat hij, met zowel zijn vrienden als zijn ouders, openhartige gesprekken voert waarbij moeilijke kwesties – depressie, abortus, chlamydia of de pijnlijke aanblik van okselhaar – niet worden geschuwd."
                            },
                            {
                                "example_id": "4f02f732-0eca-4c33-852b-ef150c821458",
                                "sense_id": "e246b549-ad1a-38fc-b662-89476bc14de2",
                                "text": "Wij zien liever dat de overheid kosten maakt voor soa-testen dan voor ivf-behandelingen omdat vrouwen te lang doorlopen met de geslachtsziekte chlamydia en daardoor onvruchtbaar worden."
                            },
                            {
                                "example_id": "fc790150-2468-4fa1-b42b-bae5e3bbddd4",
                                "sense_id": "e246b549-ad1a-38fc-b662-89476bc14de2",
                                "text": "Chlamydia is de meest voorkomende bacteriële geslachtsziekte."
                            }
                        ]
                    }
