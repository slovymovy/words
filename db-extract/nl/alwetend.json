                "senses": [
                    {
                        "sense_id": "413feba4-cc50-3c72-a2ad-6e372d5a9f2d",
                        "entry_id": "83867c59-950f-3ad7-87f0-98c454eff12e",
                        "glosses": [
                            "dat iemand of iets alles weet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f12382-b9df-4a7f-8cbb-7de4dc15007d",
                                "sense_id": "413feba4-cc50-3c72-a2ad-6e372d5a9f2d",
                                "text": "Alleen god is alwetend."
                            }
                        ]
                    },
                    {
                        "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                        "entry_id": "83867c59-950f-3ad7-87f0-98c454eff12e",
                        "glosses": [
                            "van mensen die wel heel erg veel weten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6947aa84-a31d-4633-b428-18bbe7fd8bbc",
                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                "text": "Voor het alwetend oog van moeder blijft niets verborgen."
                            },
                            {
                                "example_id": "2ee18083-26ff-47e7-8b3c-178ebdbfe508",
                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                "text": "In veel proza komt een alwetende verteller voor."
                            },
                            {
                                "example_id": "dab26556-c4e1-4971-866c-163e3f68ab6a",
                                "sense_id": "be7196bb-07f4-3d2c-93a3-a6e3fb1ce99d",
                                "text": "In zijn ogen stond nu de alwetende blik van een wereldreiziger te lezen die al wat noemenswaardig was minstens twee keer had beleefd."
                            }
                        ]
                    }
