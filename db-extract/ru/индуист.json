                                        "entry_id": "8aac8914-c9a8-3228-bb1e-03c87bca1390",
                                        "glosses": [
                                            "an den Hinduismus glaubende weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a1e78f-dee8-490d-a5eb-1b11a22f34e3",
                                                "sense_id": "f80428ce-34da-3237-ac50-3568ade989fa",
                                                "text": "Seine Frau stammt aus Asien ist streng gläubige Hindu."
                                            }
