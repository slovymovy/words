                "translations": [
                    {
                        "translation_id": "69092e4c-c437-4df3-be4a-070cce026f11",
                        "source_entry_id": "174ce5a0-cde0-33b2-ba3b-2155c0d7fdb8",
                        "source_sense_id": "d739ccf3-9dfa-3ac0-a2e3-5a52cd982d5c",
                        "source_sense_description": "de genetische voorgescheidenis van een individu, volk of soort",
                        "target_lang_word": "Abstammung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstammung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                        "entry_id": "29237c33-2fce-39b1-b4e0-291727b9ffc6",
                                        "glosses": [
                                            "Herkunft von Organismen bezüglich der evolutionären Stammesentwicklung mit der Weitergabe von Erbanlagen; familiäre Herkunft einer Person zur Bestimmung des Verwandtschaftsgrades"
                                        ],
                                        "tags": [
                                            "Vererbungslehre",
                                            "meist bezogen auf die"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b1e4ac-2f27-4880-92cf-5d33540665f2",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "Wenn wir in der Zeit 10 Millionen Jahre zurückreisen könnten und dort einige Primaten mit Markierungen an verschiedenen Stellen der DNA versehen würden und diese Markierungen heute bei Menschen und Schimpansen wiederfinden würden, dann wäre die gemeinsame Abstammung bewiesen."
                                            },
                                            {
                                                "example_id": "e9c041ad-6d0a-43f7-b6c6-59e44195de66",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "Manche Menschen kennen ihre Abstammung nicht und leiden darunter."
                                            },
                                            {
                                                "example_id": "726e849d-96b7-4eff-b934-5cae84956046",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "Manche Wittelsbacher meinten ihre Abstammung bis Karl den Großen zurückführen zu können."
                                            },
                                            {
                                                "example_id": "0f46d241-25b4-4364-a0ae-8ac25e3b28eb",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "Die Abstammung von der Mutter ist durch die Geburt eindeutig geklärt."
                                            },
                                            {
                                                "example_id": "558a1f94-35e9-4057-88fc-3cbf4d8b6a90",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "„Ich hatte seitdem den Verdacht, dass er über meine Abstammung und darüber, dass der Prinz mein Taufpate war, Bescheid wusste.“"
                                            },
                                            {
                                                "example_id": "5f3a51a1-a7a9-485c-91e9-0b338cadcc1e",
                                                "sense_id": "5b39a46f-1070-39b6-b15b-bb9dba2af19c",
                                                "text": "„Beide Elternfamilien sind jüdischer Abstammung und kommen ursprünglich aus Spanien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "264f59bb-ecf0-4208-ba51-6d81a2bc3e22",
                        "source_entry_id": "174ce5a0-cde0-33b2-ba3b-2155c0d7fdb8",
