            "senses": [
                {
                    "sense_id": "fb5885d9-cc65-3494-8f35-33ff2a21c11c",
                    "sense_definition": "Soulagement apporté à la tristesse, à la douleur morale ou au malheur de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reconfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses paroles pleines d'empathie ont apporté une vraie <w>consolation</w> à toute la famille endeuillée."
                        },
                        {
                            "text": "Elle cherche un peu de <w>consolation</w> auprès de ses amis fidèles après cette rupture douloureuse."
                        }
                    ],
                    "synonyms": [
                        "soulagement"
                    ],
                    "common_phrases": [
                        "lot de consolation",
                        "prix de consolation",
                        "source de consolation"
                    ]
                },
                {
                    "sense_id": "8e30a800-ada2-30b2-b0c4-37756fd6c63b",
                    "sense_definition": "Personne ou chose qui réconforte ou adoucit une grande peine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reconfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pratique de la musique est sa plus grande <w>consolation</w> dans les moments de profonde solitude."
                        },
                        {
                            "text": "Ses petits-enfants représentent son unique <w>consolation</w> depuis la disparition tragique de son époux."
                        }
                    ],
                    "common_phrases": [
                        "unique consolation",
                        "seule consolation"
                    ]
                },
                {
                    "sense_id": "64552925-1774-31e9-b829-71d081aea7c8",
                    "sense_definition": "Paroles, arguments ou discours employés pour apaiser et réconforter une personne affligée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré toutes les douces <w>consolations</w> qu'on lui prodiguait, le garçon continuait de pleurer en silence."
                        },
                        {
                            "text": "Il refusait d'écouter les vaines <w>consolations</w> de son entourage après cet échec professionnel imprévu."
                        }
                    ],
                    "common_phrases": [
