                        "cross_references": [
                            {
                                "target_word": "Infusion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                        "entry_id": "6ead9c68-ba3c-3a2f-80f5-af62495bfdc0",
                                        "glosses": [
                                            "das über einen längeren Zeitraum andauernde Einführen von Flüssigkeit in den Körper, dies meist intravenös, aber auch intraossär, intraarteriell, subkutan oder rektal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ea4689-8c0b-44b3-8081-c93192dd243e",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "Er brauchte eine Infusion."
                                            },
                                            {
                                                "example_id": "91f3fae5-ba71-40f0-b0b4-571fb4a09025",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "„An einen Metallgalgen wurde eine Infusion eingehängt und mit dem Katheter verbunden.“"
                                            },
                                            {
                                                "example_id": "9f25997c-8e1c-404b-80b4-124426a54229",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "„Im Krankenhaus wurde Roth mithilfe von Sauerstoff und einer Infusion stabilisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b5e444a-687b-485d-8033-4eb563bdf58a",
                        "source_entry_id": "0d639937-72ca-359b-a7a2-f8e511780a2a",
                        "source_sense_id": "1cdfe163-f740-3468-a1e5-3b8deb3f8425",
                        "source_sense_description": "vochttoediening in de bloedvaten",
                        "target_lang_word": "infuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c12071f2-e26b-3df8-a7b9-5b67b1647869",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To cause to become an element of something; to insert or fill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f193d64b-ffec-4c94-95a8-cba308948071",
                                                "sense_id": "c12071f2-e26b-3df8-a7b9-5b67b1647869",
                                                "text": "Like every day this hellish summer, someone will come to infuse me with four hours with amphotericin, a weed-killer somewhat effective against cryptococcal meningitis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa44fa33-b535-3973-98af-41cead961f15",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To steep in a liquid, so as to extract the soluble constituents (usually medicinal or herbal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cafefeb-818c-4e3e-bd7a-55b67b8f5b1b",
                                                "sense_id": "aa44fa33-b535-3973-98af-41cead961f15",
                                                "text": "1806-1831, John Redman Coxe, The American Dispensatory\nOne scruple of the dried leaves is infused in ten ounces of warm water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6a2f535-bb43-3321-9b9e-aeb4d1237f2d",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To inspire; to inspirit or animate; to fill (with)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a7c4b6d-68bc-4c87-89ac-5deb35a49dc0",
                                                "sense_id": "e6a2f535-bb43-3321-9b9e-aeb4d1237f2d",
                                                "text": "Infuse his breast with magnanimity."
                                            },
                                            {
                                                "example_id": "777256c3-49fc-4154-98fe-fee0f2a57cd4",
                                                "sense_id": "e6a2f535-bb43-3321-9b9e-aeb4d1237f2d",
                                                "text": "infusing him with self and vain conceit"
                                            },
                                            {
                                                "example_id": "ea9554ac-a755-4e99-b3ed-11afa0ad8def",
                                                "sense_id": "e6a2f535-bb43-3321-9b9e-aeb4d1237f2d",
                                                "text": "The uproar of the sea, the yell of the Indians, the rapidity with which the boat at intervals was driven, threatening at every moment to be engulphed, might have infused terror into the most undaunted;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6a3746-bbb4-345e-b449-6b4395402a00",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To instill as a quality."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8cb83e4-0224-4897-92c3-01f71e801367",
                                                "sense_id": "1c6a3746-bbb4-345e-b449-6b4395402a00",
                                                "text": "That souls of animals infuse themselves\n Into the trunks of men."
                                            },
                                            {
                                                "example_id": "d2ec79d8-d08e-4232-a8f8-f07be6c19e16",
                                                "sense_id": "1c6a3746-bbb4-345e-b449-6b4395402a00",
                                                "text": "Why should he desire to have qualities infused into his son, which himself never possessed, or knew, or found the want of, in the acquisition of his wealth?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f895e9d-6422-3247-af66-cae8baed145c",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To undergo infusion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab54413-d1f1-4c74-954e-f507adb8c24a",
                                                "sense_id": "1f895e9d-6422-3247-af66-cae8baed145c",
                                                "text": "Let it infuse for five minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a91063-ece9-37cb-b152-85314f8404be",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To make an infusion with (an ingredient); to tincture; to saturate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9488cdd-0fab-4cc2-af09-fc6214bff09c",
                                                "sense_id": "58a91063-ece9-37cb-b152-85314f8404be",
                                                "text": "if you infuse Rubarb for an hour ; and crush it well, it will purge better, and bind the Body less after the purġing, than if it stood Twenty four hours"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e45628-9235-3342-84bb-8421e354e812",
                                        "entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                                        "glosses": [
                                            "To pour in, as a liquid; to pour (into or upon); to shed."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f15cdb-58c3-4080-9e8b-988bb27ab4d8",
                                                "sense_id": "43e45628-9235-3342-84bb-8421e354e812",
                                                "text": "That strong Circean liquor cease t’infuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b10a61e-7114-49f4-ba52-fc2d48553faa",
                        "source_entry_id": "0d639937-72ca-359b-a7a2-f8e511780a2a",
                        "source_sense_id": "1cdfe163-f740-3468-a1e5-3b8deb3f8425",
                        "source_sense_description": "vochttoediening in de bloedvaten",
                        "target_lang_word": "perfusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Introduction lente et continue d’un médicament ou de sang dans un organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7c1fd2-22c9-4765-82bf-3ffc671716cc",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "On retira les perfusions de ses bras squelettiques posés sagement sur les draps le long de son corps momifié, on arracha le tuyau d’alimentation de son nez, et son cœur vaillant ne se fit pas prier. En trois secondes, l’affaire – la grande – était réglée."
                                            },
                                            {
                                                "example_id": "fb1cdf8d-1bbf-4bcd-b18c-7ec4ec3b5338",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "Élise, infirmière canadienne plus têtue qu'une chèvre et plus généreuse qu'un champ de coquelicots, s'occupa de la perfusion."
                                            },
                                            {
                                                "example_id": "e56b9bf2-cef9-4adc-be7d-a5fe18f28e1e",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "La perfusion à domicile (PAD) permet l’administration d’un grand nombre de spécialités thérapeutiques ainsi que de produits sanguins labiles : la voie d’abord peut être centrale ou périphérique en fonction des produits ; les durées de traitement et les fréquences d’administration peuvent être très différentes selon les pathologies et les traitements concernés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Dispositif permettant la perfusion ; matériel de perfusion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49627e34-ea9f-4ab7-862d-94aeee534804",
                                                "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                                "text": "— Je vais commencer par t'administrer du Valium pour que tu te détendes, a annoncé la vétérinaire comme elle posait une perfusion sur mon bras sans puce."
                                            },
                                            {
                                                "example_id": "2417fdac-585d-4676-9e91-9442bbf36753",
                                                "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                                "text": "Comme chaque matin, l’infirmière est venue changer ma perfusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f0d1db-8434-3492-a25a-92691390f824",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Processus qui alimente un organe en oxygène et nutriments nécessaires à son métabolisme, sa saine activité biochimique au sein de l'organisme. En particulier, alimentation d'un organe en sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afad4a0-88cf-49ba-b419-e88dc9ac563f",
                                                "sense_id": "32f0d1db-8434-3492-a25a-92691390f824",
                                                "text": "Lorsque, en conditions normales de pesanteur, la pression d’éjection systolique (la « tension artérielle ») est de 12 cmHg, la pression de perfusion cérébrale du sujet assis ou debout est de 12 – 2,25 = 9,75 cmHg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e3cb2b2-b50d-4ef0-a3b4-23e1da7d3184",
                        "source_entry_id": "0d639937-72ca-359b-a7a2-f8e511780a2a",
                        "source_sense_id": "1cdfe163-f740-3468-a1e5-3b8deb3f8425",
                        "source_sense_description": "vochttoediening in de bloedvaten",
                        "target_lang_word": "goutte-à-goutte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goutte-à-goutte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                                        "glosses": [
                                            "Mode d'administration d'une solution médicamenteuse par perfusion. Dispositif permettant ce mode d'administration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d5a372-000e-4c66-8a80-06734550cd30",
                                                "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                                                "text": "Presque aussitôt, deux infirmières accoururent pour assister le réveil des patients et les aider à se débarrasser du goutte-à-goutte qui depuis plusieurs heures diffusait dans leur organisme une solution médicamenteuse à base de DMT, un puissant psychotrope hallucinogène."
                                            },
                                            {
                                                "example_id": "2abb17c0-ea17-4fff-ad16-7b6d41c8b7ae",
                                                "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                                                "text": "Sur la gauche, relié au bras de maman, il y avait un goutte-à-goutte. De son nez sortait un tuyau en plastique transparent qui, à travers des machineries compliquées, aboutissait à un bocal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d678fcd-68d4-3721-8c54-f48fa5e488f1",
                                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                                        "glosses": [
                                            "Arrosage par micro-irrigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f310a20-4016-460a-a8fb-103ca67da7d9",
                                                "sense_id": "0d678fcd-68d4-3721-8c54-f48fa5e488f1",
                                                "text": "Le goutte-à-goutte économise de l’eau, réduit les risques de maladies et gagne du temps !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                                        "glosses": [
                                            "Écoulement lent et en très petite quantité d’un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3bb1e33-0ae9-4a34-974b-8d9453f156f1",
                                                "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                                                "text": "[…] entre des façades à encorbellement reliées par des cordes à linge d’où tombaient le goutte à goutte des lessives."
                                            },
                                            {
                                                "example_id": "328ed08f-7b53-4cf7-9a63-37ea30cfa85b",
                                                "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                                                "text": "Assis dans un fauteuil du salon, le visage entre les mains, j’entendais, çà et là, le goutte-à-goutte philharmonique et obsédant des dernières poches d’eau qui se vidaient à l’étage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
