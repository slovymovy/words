                "senses": [
                    {
                        "sense_id": "0ef97e5a-0b7e-3d59-badd-d1a2bcc22a4b",
                        "entry_id": "1cd5f84e-becf-3e3d-b952-37b248c4e8fb",
                        "glosses": [
                            "Zug, der im Fernverkehr eingesetzt wird und nur an den wichtigen Bahnhöfen hält"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf73c40-5560-493a-85bc-527cea0ceb70",
                                "sense_id": "0ef97e5a-0b7e-3d59-badd-d1a2bcc22a4b",
                                "text": "„Schlump holte seinen Tornister und stieg um Mitternacht in den Schnellzug, der nach Brüssel fuhr.“"
                            },
                            {
                                "example_id": "ad5a582e-3b97-4b16-bfb3-86f343863bda",
                                "sense_id": "0ef97e5a-0b7e-3d59-badd-d1a2bcc22a4b",
                                "text": "„Pünktlich fährt er ein, der Schnellzug nach Hamburg.“"
                            },
                            {
                                "example_id": "c742d76e-7100-47ba-9ab2-8bd3f4a35aa9",
                                "sense_id": "0ef97e5a-0b7e-3d59-badd-d1a2bcc22a4b",
                                "text": "„Die Dinge regelten sich in der Tat innerhalb weniger Stunden, und weil beiden Parteien daran lag, allerlei Weiterungen und Hemmnisse vermieden zu sehen, wie sie nicht wohl ausbleiben konnten, wenn Cécile davon erfuhr, so kam man überein, an demselben Abende noch den Dresdner Schnellzug benutzen und am anderen Morgen in einem in der Nähe des Großen Gartens gelegenen Wäldchen den Handel ausfechten zu wollen.“"
                            },
                            {
                                "example_id": "43527b9c-398f-4f85-930c-e132ea569484",
                                "sense_id": "0ef97e5a-0b7e-3d59-badd-d1a2bcc22a4b",
                                "text": "„Im Schnellzug Edinburgh-Aberdeen ertappt der Schaffner einen Mann ohne Fahrkarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
