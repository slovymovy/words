                "senses": [
                    {
                        "sense_id": "1c333193-f15c-3140-93eb-5d5c377534aa",
                        "entry_id": "6363ff1f-006c-398d-9e7a-45cb593b0936",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de réadhérer (adhérer à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2a14ba-285d-4933-be76-9f5a76fc1601",
                                "sense_id": "1c333193-f15c-3140-93eb-5d5c377534aa",
                                "text": "Cependant, à la même date, le gouvernement de Guyane a ré-adhéré au Protocole facultatif en émettant la réserve que le Comité des droits de l’homme n’aura pas compétence pour recevoir ni considérer des plaintes des prisonniers condamnés à mort."
                            },
                            {
                                "example_id": "bf79fc6a-0e9d-48e3-a82a-0b401ae1d907",
                                "sense_id": "1c333193-f15c-3140-93eb-5d5c377534aa",
                                "text": "Ces analystes ensuite tentèrent individuellement de ré-adhérer, ce que l’API accepta pour autant que leur pratique de la cure fût conforme aux règles."
                            }
                        ]
                    }
