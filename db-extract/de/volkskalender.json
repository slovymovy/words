                        "glosses": [
                            "Kalender, der für die literarische Bildung des Volkes eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb5f1fc-12cb-45c8-86d9-00b92a46405b",
                                "sense_id": "ed23434a-6a15-34ef-b286-048dd37b009b",
                                "text": "„Über seinen ursprünglichen Zweck hinaus ist der Kalender als „Volkskalender“ zum literarischen Volksbildungsmittel geworden.“"
                            },
                            {
                                "example_id": "ac5791c4-2867-4aa2-97c4-a33e5094fd44",
                                "sense_id": "ed23434a-6a15-34ef-b286-048dd37b009b",
                                "text": "„Die Bildergeschichte sollte vermutlich in einem Volkskalender für 1864 erscheinen, wurde aber nie gedruckt.“"
                            }
