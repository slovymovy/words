                                        "entry_id": "1287fc06-e52f-3c8f-a2b5-d57fa201fcf9",
                                        "glosses": [
                                            "Étude de la langue et de la civilisation de l’Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
