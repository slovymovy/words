                                "example_id": "368e41c7-eff6-4ce2-88bd-ef308f7570bd",
                                "sense_id": "c3df249a-2100-3ed3-99a0-b32171caf846",
                                "text": "Darren was a beautiful youth, strong and well made."
                            },
                            {
                                "example_id": "3e1c854a-3f30-4786-a67c-38c224e51f86",
                                "sense_id": "c3df249a-2100-3ed3-99a0-b32171caf846",
                                "text": "One of those awful names, Gareth or Darren - no, Jason."
                            }
                        ]
                    },
                    {
                        "sense_id": "61bc05b0-60ec-3854-a829-f09bf306e655",
                        "entry_id": "f7f727b7-b971-380a-8d95-d12852f2d53f",
