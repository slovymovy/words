                "senses": [
                    {
                        "sense_id": "cae64d3b-68bb-362c-92c3-e76d8c3bce5b",
                        "entry_id": "e5f8e2ba-4eb1-3b53-88a1-778182559310",
                        "glosses": [
                            "miasto w Japonii, na wyspie Honsiu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e7755b-71fc-4ac0-939d-6fb1ec5292e5",
                                "sense_id": "cae64d3b-68bb-362c-92c3-e76d8c3bce5b",
                                "text": "Japoński Komitet Olimpijski odrzucił pomysł, aby miasta Hiroszima (1,1 mln mieszkańców) i Nagasaki (0,5 mln) – te, w których w sierpniu 1945 r. w wyniku zrzucenia bomb atomowych zginęło łącznie blisko 200 tys. osób – wspólnie ubiegały się o prawo organizowania letnich igrzysk olimpijskich w 2020 r."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f0480f9-b8b7-30c6-b893-36573b23cde3",
                        "entry_id": "e5f8e2ba-4eb1-3b53-88a1-778182559310",
                        "glosses": [
                            "prefektura w Japonii"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bcf35d6-4e89-4fbb-b813-67e6b4a72366",
                        "source_entry_id": "e5f8e2ba-4eb1-3b53-88a1-778182559310",
                        "source_sense_id": "cae64d3b-68bb-362c-92c3-e76d8c3bce5b",
                        "target_lang_word": "Hiroshima",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hiroshima",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15634342-b575-3c1f-9e9d-9dc94506adcb",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "A prefecture in southwestern Honshu, Japan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "The capital city of Hiroshima Prefecture, Japan; the target of the first atomic bomb dropped in warfare on August 6, 1945."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b025f9-0aa7-41f2-bc01-5879acf44ebd",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "A short time ago, an American airplane dropped one bomb on Hiroshima and destroyed its usefulness to the enemy."
                                            },
                                            {
                                                "example_id": "a17c0918-c6ce-45f6-b4da-ad80a46ab412",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "This slab is where the atomic bombs that were dropped on Hiroshima and Nagasaki 75 years ago were put together. It’s the assembly point for the dawning of the atomic age."
                                            },
                                            {
                                                "example_id": "37137d53-b7a3-4d05-ad6c-64942833fcc3",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "Kishida told the executives, including those from Micron Technology Inc (MU), Intel Corp (INTC) and Taiwan Semiconductor Manufacturing Co (TSM) (TSMC), that stabilizing supply chains would be a topic of discussion at the G7 talks in the western city of Hiroshima."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef88abb-46d5-382a-9541-a6ad6dff7036",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "The 1945 atomic bombing of the city."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4989d1f-f279-4bb2-bb6a-be1f2130bad2",
                                                "sense_id": "1ef88abb-46d5-382a-9541-a6ad6dff7036",
                                                "text": "VINCENT: Tens of thousands killed before sundown; nobody's killed people that fast since Hiroshima and Nagasaki."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hiroshima",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2620c3e-2a36-3b32-88b7-864871e49e99",
                                        "entry_id": "0b88a160-2b88-317b-8a60-5f1452799c29",
                                        "glosses": [
                                            "A catastrophe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97f6766-c96d-4819-a755-78684f261187",
                                                "sense_id": "a2620c3e-2a36-3b32-88b7-864871e49e99",
                                                "text": "Stuxnet is the Hiroshima of cyber-war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91dfd5ee-6903-4475-8078-163f6b1bd856",
                        "source_entry_id": "e5f8e2ba-4eb1-3b53-88a1-778182559310",
                        "source_sense_id": "cae64d3b-68bb-362c-92c3-e76d8c3bce5b",
                        "target_lang_word": "Hirošima",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hirošima",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "78833f26-c811-30ec-96ec-3317492f6e79",
                                        "entry_id": "7e9bdeac-2971-34f5-a117-600cd9aca809",
                                        "glosses": [
                                            "město v Japonsku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5576adcc-380b-40a8-a2eb-1a8d7cad629c",
                                                "sense_id": "78833f26-c811-30ec-96ec-3317492f6e79",
                                                "text": "Nejdřív odletí tři bombardéry k meteorologickému průzkumu nad Hirošimu, Kókuru a Nagasaki."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54948507-9699-3bc7-9370-8f013715ce2b",
                                        "entry_id": "7e9bdeac-2971-34f5-a117-600cd9aca809",
                                        "glosses": [
                                            "výbuch jaderné bomby tamtéž v srpnu 1945"
                                        ],
                                        "tags": [],
