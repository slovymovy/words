                                "target_senses": [
                                    {
                                        "sense_id": "bcebd465-f4b7-36bb-a36d-eabb48395397",
                                        "entry_id": "4eb4b5ad-502c-3819-b756-62852c651834",
                                        "glosses": [
                                            "A substance that causes coagulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da4408c-1a16-465e-a8f7-022c81436bd1",
                                                "sense_id": "bcebd465-f4b7-36bb-a36d-eabb48395397",
                                                "text": "Magnesium sulfate is the coagulant used in making tofu. It causes the liquid soy milk to separate into solid tofu and water."
                                            },
                                            {
                                                "example_id": "4dd13df9-9fbc-4b93-b3c0-e7b46aafd96e",
                                                "sense_id": "bcebd465-f4b7-36bb-a36d-eabb48395397",
                                                "text": "Aluminum also is an incrustant present in most waters in quantities so small that it is not necessary to consider it; but when too much aluminum sulphate, a substance frequently used as a coagulant in filtering water, is added in the process of filtering, the excess passes through the filter and may cause trouble in the boiler, where it hydrolyzes, forming free sulphuric acid."
                                            },
                                            {
                                                "example_id": "9f667ae1-9a01-4b1c-ac56-132a811fdbd5",
                                                "sense_id": "bcebd465-f4b7-36bb-a36d-eabb48395397",
                                                "text": "Primary stage – removal of insoluble particulate material by screening, the addition of coagulants, followed by settlementation."
                                            }
                                        ]
                                    }
                                ]
                            }
