                "senses": [
                    {
                        "sense_id": "6822e292-bdb7-36c9-80f3-207eec7315d4",
                        "entry_id": "b196b179-9843-32b0-8286-35173242a57b",
                        "glosses": [
                            "Couvrir à nouveau de téflon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684bd641-8edb-48b8-9621-b087de03efec",
                                "sense_id": "6822e292-bdb7-36c9-80f3-207eec7315d4",
                                "text": "Le tapis de protection de la table est détérioré, 2 poinçons/rehausses sont rebutés et 2 noyaux sont à re-téflonner."
                            },
                            {
                                "example_id": "1517dddb-e9b7-4fce-95ac-85f498de9e88",
                                "sense_id": "6822e292-bdb7-36c9-80f3-207eec7315d4",
                                "text": "Il faudrait donc tout poncer (et ponçage plus délicat à cause du téflon), repeindre et re-téflonner."
                            },
                            {
                                "example_id": "cae2a990-3df7-4938-b66d-6f37586c504e",
                                "sense_id": "6822e292-bdb7-36c9-80f3-207eec7315d4",
                                "text": "Il faut retravailler les gabarits, une des pièces s'est cassée au démoulage, puis re-téflonner."
                            }
                        ]
                    }
