                                                "example_id": "efa04270-63b6-4928-839b-73ddcf349088",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "Voiture bondée de voyageurs."
                                            },
                                            {
                                                "example_id": "6c70339c-62d8-48b3-8bac-36f97d0effd9",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "La salle était bondée de spectateurs."
                                            },
                                            {
                                                "example_id": "2d7d6916-1541-4721-924e-f916deeda54d",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "La vaste pièce, longue d’une dizaine de mètres, large de six, n’avait d’autres meubles, avec l’armoire, que deux corps de bibliothèque, bondés de livres."
                                            },
                                            {
                                                "example_id": "295b4e5e-e483-4ce5-b780-7f4d706ed18f",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "Les chanteurs sont supérieurs à ceux du même ordre entendus à Paris. La salle, bondée, les encourage par des ovations."
                                            },
                                            {
                                                "example_id": "7de920ba-df08-4988-8bd3-5a592b9ded22",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "Le silence se prolongea, bondé de pensées. On les sentait rôder autour de nous, nous frôler comme des plantes sous-marines, comme des bêtes."
                                            },
                                            {
                                                "example_id": "de8536de-5ec3-4ef4-be1b-c4c3215313c1",
                                                "sense_id": "8762b6c8-7548-3bb9-9b03-ef32486f6933",
                                                "text": "Le petit autocar gris, moche, arriva avec une heure de retard et était bondé."
                                            }
                                        ]
                                    }
                                ]
