                "senses": [
                    {
                        "sense_id": "e59f89dd-b5be-3513-9b64-72ddd9392d1a",
                        "entry_id": "7c6848f7-9337-3666-ab07-da151ee61350",
                        "glosses": [
                            "eine Einrichtung der Vereinten Nationen, die sich mit der Wahrung des Weltfriedens beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c307695-4e3d-4445-b798-d4bd1a0c75cc",
                                "sense_id": "e59f89dd-b5be-3513-9b64-72ddd9392d1a",
                                "text": "„Alle maßgeblichen Entscheidungen über Krieg und Frieden werden nicht in der UN-Vollversammlung, sondern vom UN-Sicherheitsrat mit seinen 15 Mitgliedern getroffen.“ (Internetbeleg)"
                            },
                            {
                                "example_id": "c152112b-1329-4827-aacf-d62abade5a34",
                                "sense_id": "e59f89dd-b5be-3513-9b64-72ddd9392d1a",
                                "text": "„Noch in der gleichen Nacht fordert der UN-Sicherheitsrat die Belgier zum Abzug auf und beschließt die Entsendung bewaffneter Blauhelm-Soldaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
