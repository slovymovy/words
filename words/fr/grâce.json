                    ]
                },
                {
                    "sense_id": "9622ba37-3a13-31c1-9e57-95d8aad80aac",
                    "sense_definition": "Titre honorifique réservé à certains hauts dignitaires de la noblesse ou du clergé.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ambassadeurs se sont inclinés avec respect devant Sa <w>Grâce</w> le duc."
                        },
                        {
                            "text": "Puis-je présenter cette requête directement à Votre <w>Grâce</w> ?"
