                        "examples": [
                            {
                                "example_id": "e06f65fb-18cf-4404-adae-143acaf5081f",
                                "sense_id": "b5920e2b-eb3b-34f4-970b-2d55c3e1e83e",
                                "text": "De villa van Jeroen Piqueur is een hoofdbrok in de bezittingen van Imaco. Die villa staat al een half jaar onderhands te koop. Gisterennamiddag kwam het wel tot een openbare verkoop van twee huizen van Piqueur. Het gaat om de huizen waarin zijn zoon Ruben en zijn dochter Rebecca wonen. Die twee panden zijn voorlopig toegewezen in afwachting van een hoger bod."
                            },
                            {
                                "example_id": "2a1bac66-1d21-4cda-ae56-2f1132f800b5",
                                "sense_id": "b5920e2b-eb3b-34f4-970b-2d55c3e1e83e",
                                "text": "De hoofdbrok was kritisch opgezet: een lang gesprek over hoe Gent de woningmarkt opnieuw onder controle moet krijgen. Het stadsbestuur kreeg forse kritiek. Daarna volgden diversiteit en participatie. Stevige kost voor een middagje op de Feesten."
                            }
                        ]
                    }
