    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                "word": "indenture",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "179f9b1e-aaa5-4983-9b5c-2a913ccf1d0f",
                        "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "tags": [
                            "plural"
                        ],
                        "form": "indentures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e396ed4c-f008-31c1-a54d-12c5d93e142b",
                        "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "glosses": [
                            "A contract which binds a person to work for another, under specified conditions, for a specified time (often as an apprentice)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3224f99f-a848-4019-baa6-ec8180d7a17a",
                                "sense_id": "e396ed4c-f008-31c1-a54d-12c5d93e142b",
                                "text": "And so the schoolmistress reconciled the recommendation to her conscience, and the indentures were cancelled, and the apprentice was free."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d20f719-d02c-3462-9a4e-2f67cacdc163",
                        "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "glosses": [
                            "A contract relating to lending (typically for issuing a bond), a real estate transaction, or a bankruptcy that imposes additional conditions on one or both parties."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7489edb5-bb86-36b9-9187-bbff723a2e46",
                        "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "glosses": [
                            "A document, written as duplicates separated by indentations, specifying either of the above contracts."
                        ],
                        "tags": [
                            "in-plural",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "2ea462d9-8347-4b98-98cd-4c105efa4fe6",
                                "sense_id": "7489edb5-bb86-36b9-9187-bbff723a2e46",
                                "text": "Walking the street very hungry, and not knowing what to do with himself, a crimp's bill was put into his hand, offering immediate entertainment and encouragement to such as would bind themselves to serve in America. He went directly, sign'd the indentures, was put into the ship, and came over, never writing a line to acquaint his friends what was become of him."
                            },
                            {
                                "example_id": "abaf998d-25a0-4b2a-8a8c-aed066674a42",
                                "sense_id": "7489edb5-bb86-36b9-9187-bbff723a2e46",
                                "text": "It was the critical moment of Oliver’s fate. If the inkstand had been where the old gentleman thought it was, he would have dipped his pen into it, and signed the indentures, and Oliver would have been straightway hurried off."
                            },
                            {
                                "example_id": "a4c88128-1c6e-4d59-9e86-ea6efea9ad9f",
                                "sense_id": "7489edb5-bb86-36b9-9187-bbff723a2e46",
                                "text": "For the next two years, Ann's position in the family grew to be more and more that of a daughter. If it had not been for the indentures lying serenely in that tall wooden desk, she would almost have forgotten, herself, that she was a bound girl."
                            }
                        ]
                    },
                    {
                        "sense_id": "4758d9c1-860c-37e8-86c6-d6cb338320ce",
                        "entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "glosses": [
                            "An indentation; a recess."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a178c912-3aad-48b4-8edd-67f61af6d4ca",
                                "sense_id": "4758d9c1-860c-37e8-86c6-d6cb338320ce",
                                "text": "The narrow windows, flanked by deep indentures into the walls, seemed formed rather to exclude than to admit the cheerful light; and the heavy and gloomy appearance of the thunder-sky added still farther to the obscurity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca017f09-18f3-447d-85dd-5df0ff34c305",
                        "source_entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "source_sense_description": "contract",
                        "target_lang_word": "leercontract",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leercontract",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3940e1e9-27d2-3fe2-b91e-f00d09f7ff42",
                                        "entry_id": "31505fd5-3220-35c2-9cc1-58b26be56e71",
                                        "glosses": [
                                            "onderwijs voor leerlingen tussen de 16 en 25 jaar waarbij 1 dag per week theoretische onderwijs wordt gegeven en 4 dagen er een praktische beroepsopleiding is in een onderneming"
                                        ],
                                        "tags": [
                                            "België"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d830cd-be81-4a1d-a26b-108c3a8ea9ab",
                                                "sense_id": "3940e1e9-27d2-3fe2-b91e-f00d09f7ff42",
                                                "text": "Het Gregorius College vraagt aspirant-leerlingen de katholieke grondslag van de school te respecteren. Afspraken hierover worden vastgelegd in een school-leercontract en de regels zijn opgenomen in schoolgids en leerlingenstatuut. Zowel in als buiten de lessen is het verboden kledingstukken en accessoires te dragen die geassocieerd kunnen worden met een niet-katholieke of niet-christelijke levensovertuiging. Ook het dragen van hoofddeksels is verboden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03bc36bc-01df-4f33-adcc-750ea10e092c",
                        "source_entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "source_sense_description": "contract",
                        "target_lang_word": "Vertrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                        "entry_id": "c840b545-8c39-33eb-af93-e2e6064a9c9a",
                                        "glosses": [
                                            "rechtlich bindende Vereinbarung zwischen mindestens zwei verschiedenen Partnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8567a6-ffbe-43d3-b235-0e04d357c7f6",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "Auch wenn wir Freunde sind, haben wir einen Vertrag aufgesetzt, als ich Peters Auto kaufte."
                                            },
                                            {
                                                "example_id": "7cc73868-0f51-4c7b-960f-e3699cfa55cd",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Daphne beklagte sich über ihren Vertrag und über die Nebenrechte.“"
                                            },
                                            {
                                                "example_id": "dff64fe9-0ec0-430e-9fab-60bd57083832",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "27686aeb-feab-44d3-8268-b84586abd2e8",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Er wurde von Kapitän Johnston aufgenommen, unterschrieb den Vertrag und schloss sich uns am folgenden Tag in Seemannsplünnen an.“"
                                            },
                                            {
                                                "example_id": "49bedcfd-a4e6-40d4-8fd3-0d318dad6001",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Remarque hat einen sehr lukrativen Vertrag abgeschlossen, und Alfred Scherz hofft, den Bestsellerautor langfristig an sein Haus binden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e420b6f3-2120-4b5a-8108-1391f332f420",
                        "source_entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
