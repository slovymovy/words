                        "examples": [
                            {
                                "example_id": "49a7927a-1774-4838-b6d8-b936db8c66be",
                                "sense_id": "79d3d0b8-fcba-39ec-9568-50bd7a5ce17f",
                                "text": "Vous avez cent mille livres de rente avec vos placements sur le Grand-Livre."
                            },
                            {
                                "example_id": "189098f7-0718-4056-9f95-3a1ea5ead279",
                                "sense_id": "79d3d0b8-fcba-39ec-9568-50bd7a5ce17f",
                                "text": "il se forme dans les bas-fonds de la Société une épaisse couche de pauvres, tous inscrits sur les registres de l’assistance publique, comme les rentiers sur le Grand-Livre, se transmettant d’une génération à l’autre leurs droits en même temps que leurs vices, race méprisée, mais trop dégradée pour ne pas s’estimer heureuse de sa condition et pour s’évertuer jamais à en sortir."
                            },
                            {
                                "example_id": "578a2c37-8056-4af6-aa3c-a32fc1dfafde",
                                "sense_id": "79d3d0b8-fcba-39ec-9568-50bd7a5ce17f",
                                "text": "Pour eux, cette foule noire, lente et pressés, qui va, vient, serpente, tourne, retourne, monte, descend, et qui ne peut être comparée qu’à des fourmis sur leur tas de bois, n’est pas plus compréhensible que la Bourse pour un paysan bas-breton qui ignore l’existence du Grand-Livre."
                            }
                        ]
                    }
