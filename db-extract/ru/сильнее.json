        "ru-extract.jsonl": [
            {
                "entry_id": "0f8a4465-44c3-3e90-816b-2ac6b083a520",
                "word": "сильнее",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5fdc101-d0b8-36a3-9763-80a06ac665da",
                        "entry_id": "0f8a4465-44c3-3e90-816b-2ac6b083a520",
                        "glosses": [
                            "сравн. ст. к прил. сильный; более сильный, более мощный, здоровый"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "a8578c4d-508c-4487-834d-c0ff7840fb5f",
                                "sense_id": "c5fdc101-d0b8-36a3-9763-80a06ac665da",
                                "text": "Поток, загражденный в стремлении своём, тем сильнее становится, чем твёрже находит противустояние."
                            },
                            {
                                "example_id": "51508215-b37d-49bd-8eb0-5346fe68c060",
                                "sense_id": "c5fdc101-d0b8-36a3-9763-80a06ac665da",
                                "text": "― Не могу, генерал, и потому не могу, что закон сильнее меня, ― сказал государь и занес ногу в стремя."
                            },
                            {
                                "example_id": "72ddf781-1869-43f0-b3d7-fe47130c5ad5",
                                "sense_id": "c5fdc101-d0b8-36a3-9763-80a06ac665da",
                                "text": "― А интересно, их препарат посильнее травки? ― Сильнее, ― сказал Краснов. ― Намного сильнее, Гера."
                            }
                        ]
                    },
                    {
                        "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                        "entry_id": "0f8a4465-44c3-3e90-816b-2ac6b083a520",
                        "glosses": [
                            "сравн. ст. к нареч. сильно; более сильно"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "9ef6a8b5-8374-4fa6-a989-33f6b95b1077",
                                "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                                "text": "Но печальное тем сильнее действовало на сердца и воображение."
                            },
                            {
                                "example_id": "56d7d7bf-4a6f-4285-9bd1-d204305a5dcb",
                                "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                                "text": "Морозило сильнее, чем с утра; но зато так было тихо, что скрып мороза под сапогом слышался за полверсты."
                            },
                            {
                                "example_id": "f80b96db-6e22-4365-ab6f-ac40c7c94709",
                                "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                                "text": "Но странно: эта краска обозначалась как бы ярче и сильнее, чем мог быть обыкновенный детский румянец."
                            },
                            {
                                "example_id": "b418309f-d651-420c-a2a4-b7f63d20f28b",
                                "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                                "text": "― Слыхал, слыхал, ― хмурясь ещё сильнее, сказал Енакиев."
                            },
                            {
                                "example_id": "2df0fb99-bc8c-40ce-a8a6-c478daa92850",
                                "sense_id": "f845845b-b925-38cf-b7af-ac3a46e991ce",
                                "text": "От огорчения, сильнее сказать, с горя, Зеленский изрядно запил."
                            }
                        ]
                    }
                ],
