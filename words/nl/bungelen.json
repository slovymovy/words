    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b926821c-fdf1-36b0-841e-f249d22b77d9",
                    "sense_definition": "Loshangend heen en weer zwaaien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sleutels <w>bungelden</w> aan zijn riem terwijl hij door de gang liep.",
                            "target_lang_translations": {
                                "en": "The keys <w>dangled</w> from his belt as he walked down the hallway."
                            }
                        },
                        {
                            "text": "Zijn benen <w>bungelden</w> boven de grond omdat de stoel te hoog was.",
                            "target_lang_translations": {
                                "en": "His legs <w>dangled</w> above the ground because the chair was too high."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaaien",
                        "slingeren"
                    ],
                    "common_phrases": [
                        "aan een touw bungelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To swing loosely back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to dangle",
                                "target_lang_sense_clarification": "to hang or swing loosely"
                            },
                            {
                                "target_lang_word": "to swing",
                                "target_lang_sense_clarification": "to move back and forth while hanging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c765e1f-f735-33b7-96b7-1585dee4e6f4",
                    "sense_definition": "In onzekerheid verkeren of in een onzekere positie verkeren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toekomst van het bedrijf <w>bungelt</w> aan een zijden draadje door de slechte cijfers.",
                            "target_lang_translations": {
                                "en": "The future of the company <w>hangs in the balance</w> due to the poor figures."
                            }
                        },
                        {
                            "text": "Na de slechte resultaten <w>bungelt</w> de trainer nu onderaan de ranglijst.",
                            "target_lang_translations": {
                                "en": "After the poor results, the coach is now <w>teetering</w> at the bottom of the rankings."
                            }
                        }
                    ],
                    "synonyms": [
                        "wankelen"
                    ],
                    "common_phrases": [
                        "aan een zijden draadje bungelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a state of uncertainty or in a precarious position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to hang in the balance",
                                "target_lang_sense_clarification": "to be in an uncertain or critical state"
                            },
                            {
                                "target_lang_word": "to teeter",
                                "target_lang_sense_clarification": "to be in an unstable or precarious position"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a09c664-e035-34ba-8a05-4d0706fa4ff4",
                    "sense_definition": "Een alternatieve vorm van <w>bengelen</w>",
                    "learner_level": "B2",
