                                "target_senses": [
                                    {
                                        "sense_id": "415dabf2-1b4c-3ba6-a635-46d1b0ba0da6",
                                        "entry_id": "760323fc-8bca-352e-bd0a-35bdec8a5dca",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d3c747-e6fc-485d-a987-eaef6eeb8d90",
                                                "sense_id": "415dabf2-1b4c-3ba6-a635-46d1b0ba0da6",
                                                "text": "O Gertrude, Gertrude! / When sorrows come, they come not single spies, / But in battalions."
                                            },
                                            {
                                                "example_id": "18f203b0-6c64-4b76-a094-615363160d0b",
                                                "sense_id": "415dabf2-1b4c-3ba6-a635-46d1b0ba0da6",
                                                "text": "\"We two,\" she said, \"will seek the groves / Where the lady Mary is, / With her five handmaidens, whose names / Are five sweet symphonies, / Cecily, Gertrude, Magdalen, / Margaret and Rosalys."
                                            }
                                        ]
                                    }
                                ]
                            }
