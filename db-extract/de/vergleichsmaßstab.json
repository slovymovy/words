                "senses": [
                    {
                        "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                        "entry_id": "c7232860-7bd2-3668-9298-0ab9e0876d01",
                        "glosses": [
                            "Menge/Güte/Norm, die als Standard für einen Vergleich benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e08a7237-286f-4560-b7f9-3c611f32bf86",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„»In Sachen Bildung ist Estland ein interessanter Vergleichsmaßstab, in der Pisa-Studie schneidet das Land sehr gut ab.«“"
                            },
                            {
                                "example_id": "cfab46ec-c3a9-43aa-8699-2a795d409592",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Auch in der Spätantike blieb Ciceros Sprache der normsetzende Vergleichsmaßstab.“"
                            },
                            {
                                "example_id": "58d2a653-2fdf-45c0-80b8-1f628bfd261e",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "[Klima:] „Bis einschließlich 2020 war die Referenzperiode der Jahre 1961 bis 1990 der gültige und allgemein gebräuchliche Vergleichsmaßstab. Dieser wurde mit Beginn des Jahres 2021 von der neuen Normalperiode 1991 bis 2020 abgelöst.“"
                            },
                            {
                                "example_id": "e9a4d385-b927-43c2-9455-d5d30ee5ddee",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Strittig ist unter anderem, ob bei solchen geförderten Wohnungen der örtliche Mietspiegel als Vergleichsmaßstab angesetzt werden kann.“"
                            },
                            {
                                "example_id": "6ee05e44-d32f-4d49-8c39-6bc8dbdef4bb",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Um das zu belegen, nutzt er als Vergleichsmaßstab das Jahr 2015, in dem die Emissionen deutlich angestiegen waren – und kommt damit für das Jahr 2018 auf einen Rückgang der Emissionen um 4,5 Prozent.“"
                            },
                            {
                                "example_id": "3561fb5e-1c78-4d92-ba4d-c803669856c6",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Eine Berechnung in Kaufkraftparität soll die internationale Vergleichbarkeit gewährleisten, indem nicht die Einkommen in Landeswährung als Vergleichsmaßstab herangezogen werden, sondern das, was man sich davon kaufen kann.“"
                            },
                            {
                                "example_id": "cae387df-177c-4a17-b76b-c30633a9b98c",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Um einen verlässlichen Vergleichsmaßstab anzulegen, wird Kriminalität auf 100.000 Einwohner der Gesamtbevölkerung bezogen; die so errechnete Zahl heißt Häufigkeitszahl.“"
                            },
                            {
                                "example_id": "7c82740d-4536-47c8-aa33-8c4595592e89",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Serbien gehört zu den aussichtsreichsten Kandidaten der Westbalkan-Länder, die Chancen haben, Mitglied der EU zu werden, weswegen die Union ständig als Vergleichsmaßstab herangezogen wird.“"
                            },
                            {
                                "example_id": "241f7aa9-18a7-407a-bdd2-b1bf61b0a7f4",
                                "sense_id": "40502b0b-ff14-34fc-af38-27707e301adc",
                                "text": "„Nicht der Vergleichsmaßstab ist das Problem, sondern die Ungleichheiten zwischen Ost und West selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
