                    {
                        "translation_id": "1d122ba7-6cf9-4bf2-8fb3-d35886300042",
                        "source_entry_id": "cc610b5f-ea50-356f-bbbd-62cb02e0f82f",
                        "source_sense_id": "992395be-78c8-3ee4-8d76-5da3cebb43d1",
                        "source_sense_description": "nichtbinäre/diversgeschlechtliche Person",
                        "target_lang_word": "enby",
