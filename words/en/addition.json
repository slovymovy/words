    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84e5be6a-5704-3d99-aa04-f03b5a1dddd4",
                    "sense_definition": "The arithmetic operation of calculating the sum of two or more numbers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "math_calc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students are learning basic <w>addition</w> and subtraction.",
                            "target_lang_translations": {
                                "ru": "Ученики изучают простое <w>сложение</w> и вычитание.",
                                "pl": "Uczniowie uczą się podstawowego <w>dodawania</w> i odejmowania.",
                                "tr": "Öğrenciler temel <w>toplama</w> ve çıkarma işlemlerini öğreniyorlar.",
                                "zh": "学生们正在学习基础的<w>加法</w>和减法。"
                            }
                        },
                        {
                            "text": "You made a small mistake in your <w>addition</w>.",
                            "target_lang_translations": {
                                "ru": "Ты сделал небольшую ошибку в <w>сложении</w>.",
                                "pl": "Zrobiłeś mały błąd w swoim <w>dodawaniu</w>.",
                                "tr": "<w>Toplama işleminde</w> küçük bir hata yaptın.",
                                "zh": "你在<w>加法</w>运算中犯了一个小错误。"
                            }
                        }
                    ],
                    "antonyms": [
                        "subtraction"
                    ],
                    "common_phrases": [
                        "simple addition",
                        "addition and subtraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Арифметическая операция вычисления суммы двух или более чисел.",
                        "pl": "Działanie arytmetyczne polegające na obliczaniu sumy dwóch lub więcej liczb.",
                        "tr": "İki veya daha fazla sayının toplamını hesaplama matematiksel işlemi.",
                        "zh": "一种计算两个或多个数字之和的算术运算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложение",
                                "target_lang_sense_clarification": "математическая операция"
                            },
                            {
                                "target_lang_word": "суммирование",
                                "target_lang_sense_clarification": "процесс вычисления суммы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dodawanie",
                                "target_lang_sense_clarification": "działanie matematyczne"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "toplama",
                                "target_lang_sense_clarification": "matematiksel işlem"
                            },
                            {
                                "target_lang_word": "toplama işlemi",
                                "target_lang_sense_clarification": "aritmetik hesaplama"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加法",
                                "target_lang_sense_clarification": "数学运算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3033c37b-1e13-3ded-ae43-35ca9e73af62",
                    "sense_definition": "The act of adding something to something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "act_adding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>addition</w> of fresh herbs improved the flavor of the soup.",
                            "target_lang_translations": {
                                "ru": "<w>Добавление</w> свежей зелени улучшило вкус супа.",
                                "pl": "<w>Dodanie</w> świeżych ziół poprawiło smak zupy.",
                                "tr": "Taze otların <w>eklenmesi</w> çorbanın lezzetini artırdı.",
                                "zh": "<w>添加</w>新鲜香草改善了汤的味道。"
                            }
                        },
                        {
                            "text": "In <w>addition</w> to his regular job, he volunteers at the shelter.",
                            "target_lang_translations": {
                                "ru": "В <w>дополнение</w> к своей основной работе он работает волонтером в приюте.",
                                "pl": "W <w>dodatku</w> do swojej stałej pracy, pomaga jako wolontariusz w schronisku.",
                                "tr": "Düzenli işine <w>ek olarak</w>, barınakta gönüllü çalışıyor.",
                                "zh": "<w>除了</w>日常工作外，他还在收容所做志愿者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adding",
                        "inclusion"
                    ],
                    "antonyms": [
                        "removal",
                        "reduction",
                        "exclusion"
                    ],
                    "common_phrases": [
                        "in addition to",
                        "with the addition of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по добавлению чего-либо к чему-либо другому.",
                        "pl": "Czynność polegająca na dołączaniu czegoś do czegoś innego.",
                        "tr": "Bir şeyi başka bir şeye ekleme eylemi.",
                        "zh": "将某物添加到另一物上的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавление",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "то, что дополняет; часто во фразе «в дополнение»"
                            },
                            {
                                "target_lang_word": "прибавление",
                                "target_lang_sense_clarification": "увеличение количества"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dodawanie",
                                "target_lang_sense_clarification": "czynność"
                            },
                            {
                                "target_lang_word": "dodanie",
                                "target_lang_sense_clarification": "jednorazowa czynność"
                            },
                            {
                                "target_lang_word": "dodatek",
                                "target_lang_sense_clarification": "coś dodanego, np. w wyrażeniu 'jako dodatek'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekleme",
                                "target_lang_sense_clarification": "ilave etme eylemi"
                            },
                            {
                                "target_lang_word": "katma",
                                "target_lang_sense_clarification": "dahil etme"
                            },
                            {
                                "target_lang_word": "ilave",
                                "target_lang_sense_clarification": "eklenen şey veya durum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "添加",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "数量上的增多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fe7a3f8-25a4-38f8-af79-9adaf6352a81",
                    "sense_definition": "A person or thing that is added to a group, collection, or place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thing_added",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new library is a wonderful <w>addition</w> to our town.",
                            "target_lang_translations": {
                                "ru": "Новая библиотека — чудесное <w>дополнение</w> к нашему городу.",
                                "pl": "Nowa biblioteka to wspaniały <w>dodatek</w> do naszego miasta.",
                                "tr": "Yeni kütüphane kasabamız için harika bir <w>kazanım</w> oldu.",
                                "zh": "这座新图书馆是我们镇上一个很棒的<w>新增设施</w>。"
                            }
                        },
                        {
                            "text": "They welcomed the latest <w>addition</w> to their family last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе они приветствовали <w>пополнение</w> в своем семействе.",
                                "pl": "W zeszłym tygodniu powitali nowego <w>członka</w> rodziny.",
                                "tr": "Geçen hafta ailelerinin en yeni <w>üyesini</w> sevgiyle karşıladılar.",
                                "zh": "上周他们迎来了家庭的<w>新成员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extra",
                        "supplement"
                    ],
                    "common_phrases": [
                        "welcome addition",
                        "latest addition",
                        "new addition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, добавленные к группе, коллекции или месту.",
                        "pl": "Osoba lub rzecz dodana do grupy, kolekcji lub miejsca.",
                        "tr": "Bir gruba, koleksiyona veya mekana eklenen yeni bir kişi veya şey.",
                        "zh": "被添加到群体、集合或地方的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнение",
                                "target_lang_sense_clarification": "о людях, семье или коллекции"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "новая часть чего-то целого"
                            },
                            {
                                "target_lang_word": "прибавление",
                                "target_lang_sense_clarification": "разг. о рождении ребенка"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dodatek",
                                "target_lang_sense_clarification": "rzecz dodana do czegoś"
                            },
                            {
                                "target_lang_word": "nabytki",
                                "target_lang_sense_clarification": "nowe elementy w kolekcji lub bibliotece"
                            },
                            {
                                "target_lang_word": "nowy członek",
                                "target_lang_sense_clarification": "o nowej osobie w rodzinie lub zespole"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katkı",
                                "target_lang_sense_clarification": "bir yere veya gruba yeni kazandırılan değer"
                            },
                            {
                                "target_lang_word": "üye",
                                "target_lang_sense_clarification": "aileye veya gruba yeni katılan kişi"
                            },
                            {
                                "target_lang_word": "eklenti",
                                "target_lang_sense_clarification": "sonradan dahil edilen nesne veya unsur"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新增部分",
                                "target_lang_sense_clarification": "新加入的元素"
                            },
                            {
                                "target_lang_word": "新成员",
                                "target_lang_sense_clarification": "指加入家庭或团队的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c33f45-eb81-3a76-8cb1-56f4a6cb71a7",
                    "sense_definition": "An organic reaction where two or more molecules combine to form a larger one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the mechanism of the <w>addition</w> reaction.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил механизм реакции <w>присоединения</w>.",
                                "pl": "Profesor wyjaśnił mechanizm reakcji <w>addycji</w>.",
                                "tr": "Profesör <w>katılma</w> tepkimesinin mekanizmasını açıkladı.",
                                "zh": "教授解释了<w>加成反应</w>的机理。"
                            }
                        },
                        {
                            "text": "We observed the <w>addition</w> of bromine to the compound during the experiment.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали <w>присоединение</w> брома к соединению во время эксперимента.",
                                "pl": "Podczas eksperymentu obserwowaliśmy <w>przyłączanie</w> bromu do związku.",
                                "tr": "Deney sırasında bileşiğe brom <w>katılmasını</w> gözlemledik.",
                                "zh": "我们在实验中观察到了溴对该化合物的<w>加成</w>过程。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "addition reaction"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical (chemistry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Органическая реакция, при которой две или более молекул соединяются, образуя более крупную.",
                        "pl": "Reakcja organiczna, w której dwie lub więcej cząsteczek łączy się, tworząc większą.",
                        "tr": "İki veya daha fazla molekülün birleşerek daha büyük bir molekül oluşturduğu organik tepkime.",
                        "zh": "一种有机反应，其中两个或多个分子结合形成一个更大的分子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присоединение",
                                "target_lang_sense_clarification": "химическая реакция"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "addycja",
                                "target_lang_sense_clarification": "reakcja chemiczna"
                            },
                            {
                                "target_lang_word": "przyłączanie",
                                "target_lang_sense_clarification": "proces chemiczny"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katılma",
                                "target_lang_sense_clarification": "kimyasal tepkime türü"
                            },
                            {
                                "target_lang_word": "katılma reaksiyonu",
                                "target_lang_sense_clarification": "organik kimya terimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加成反应",
                                "target_lang_sense_clarification": "化学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfe38a26-5970-3071-af62-6fdee6cc70eb",
                    "sense_definition": "A title annexed to a person's name to identify him or her more precisely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient documents, a specific <w>addition</w> was often required after a name.",
                            "target_lang_translations": {
                                "ru": "В древних документах после имени часто требовалось особое <w>прибавление</w>.",
                                "pl": "W starożytnych dokumentach po imieniu często wymagany był określony <w>przydomek</w>.",
                                "tr": "Eski belgelerde, bir isimden sonra sıklıkla özel bir <w>unvan</w> eklenmesi gerekirdi.",
                                "zh": "在古代文献中，名字后通常需要加上特定的<w>称号</w>。"
                            }
                        },
                        {
                            "text": "He bore the <w>addition</w> of \"The Brave\" after his heroic deeds.",
                            "target_lang_translations": {
                                "ru": "После своих героических подвигов он носил <w>прозвание</w> «Храбрый».",
                                "pl": "Po swoich bohaterskich czynach nosił <w>przydomek</w> „Chrobry”.",
                                "tr": "Kahramanlıklarından sonra \"Cesur\" <w>lakabını</w> taşıdı.",
                                "zh": "在英勇事迹之后，他获得了“勇敢者”这一<w>称号</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул или эпитет, добавляемый к имени человека для его более точной идентификации.",
                        "pl": "Przydomek lub tytuł dodany do nazwiska osoby w celu jej dokładniejszej identyfikacji.",
                        "tr": "Bir kişinin kimliğini daha kesin belirtmek için adına eklenen unvan veya lakap.",
                        "zh": "附加在人名后的头衔或称号，用于更精确地识别该人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозвание",
                                "target_lang_sense_clarification": "устар. эпитет к имени"
                            },
                            {
                                "target_lang_word": "прибавление",
                                "target_lang_sense_clarification": "устар. дополнение к имени"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przydomek",
                                "target_lang_sense_clarification": "dodatek do imienia lub nazwiska"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lakap",
                                "target_lang_sense_clarification": "ismin yanına eklenen tanımlayıcı ad"
                            },
                            {
                                "target_lang_word": "unvan",
                                "target_lang_sense_clarification": "isme eklenen derece veya takı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "称号",
                                "target_lang_sense_clarification": "附加的头衔"
                            },
                            {
                                "target_lang_word": "别名",
                                "target_lang_sense_clarification": "用于区分的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cebe844-4a45-359b-a81e-7794331edd8a",
                    "sense_definition": "A dot at the right side of a note as an indication that its sound is to be lengthened one half.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer used an <w>addition</w> to extend the duration of the final note.",
                            "target_lang_translations": {
                                "ru": "Композитор использовал <w>точку</w>, чтобы продлить длительность последней ноты.",
                                "pl": "Kompozytor użył <w>kropki</w>, aby wydłużyć czas trwania ostatniej nuty.",
                                "tr": "Besteci, son notanın süresini uzatmak için bir <w>uzatma noktası</w> kullandı.",
                                "zh": "作曲家使用了一个<w>附点</w>来延长最后一个音符的时值。"
                            }
                        },
                        {
                            "text": "Musicians must pay close attention to every <w>addition</w> on the score.",
                            "target_lang_translations": {
                                "ru": "Музыканты должны обращать пристальное внимание на каждое <w>добавление</w> в партитуре.",
                                "pl": "Muzycy muszą zwracać baczną uwagę na każdą <w>kropkę</w> w partyturze.",
                                "tr": "Müzisyenler nota kağıdındaki her <w>noktaya</w> azami dikkat göstermelidir.",
                                "zh": "音乐家必须密切注意乐谱上的每一个<w>附点</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical (music)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка справа от ноты, указывающая на удлинение её звучания наполовину.",
                        "pl": "Kropka po prawej stronie nuty oznaczająca przedłużenie jej wartości o połowę.",
                        "tr": "Müzikte bir notanın sağ tarafına konulan ve değerini yarı oranında uzatan nokta.",
                        "zh": "音符右侧的一个点，表示将其时值延长一半。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка",
                                "target_lang_sense_clarification": "музыкальный знак"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kropka",
                                "target_lang_sense_clarification": "oznaczenie przedłużenia nuty"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzatma noktası",
                                "target_lang_sense_clarification": "nota değerini yarı yarıya uzatan işaret"
                            },
                            {
                                "target_lang_word": "nokta",
                                "target_lang_sense_clarification": "notanın yanındaki uzatma işareti"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附点",
                                "target_lang_sense_clarification": "音乐术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c98d6f-3ff8-34ca-b290-773e492f39ca",
                    "sense_definition": "Something added to a coat of arms as a mark of honour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king granted an <w>addition</w> to the family crest for their loyalty.",
                            "target_lang_translations": {
                                "ru": "Король пожаловал <w>дополнение</w> к фамильному гербу за их верность.",
                                "pl": "Król przyznał <w>uszlachetnienie</w> herbu rodowego za ich lojalność.",
                                "tr": "Kral, sadakatlerinden dolayı aile armasına bir <w>onur sembolü</w> eklenmesini bağışladı.",
                                "zh": "国王因他们的忠诚而授予其家族纹章一项<w>增补</w>。"
                            }
                        },
                        {
                            "text": "This specific <w>addition</w> signifies a great military victory.",
                            "target_lang_translations": {
                                "ru": "Это конкретное <w>дополнение</w> означает великую военную победу.",
