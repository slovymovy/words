                        "target_lang_word": "Sinnlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sinnlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Empfänglichkeit und Hingabe für die Empfindungen und das (angenehme) Erleben der äußeren Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55327336-4210-411d-a284-04152dbdb80c",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "Ich bin wie berauscht von der Sinnlichkeit expressionistischer Gemälde."
                                            },
                                            {
                                                "example_id": "22dbdf11-55a5-4ac2-b596-9dea47df5fae",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "„Die Vorstellung, daß meine oder irgend jemandes Sinnlichkeit gedämpft wurde, war mir ekelhaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Offenheit für/Lust auf Erotisches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b1f823-580f-4ff2-80ac-cb380469f791",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Das Bidet ist Zeuge einer gelebten Sinnlichkeit.“"
                                            },
                                            {
                                                "example_id": "cd897890-10b7-4b8f-bc88-a795af148e14",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Dafür strahlte Adele mehr Sinnlichkeit aus.“"
                                            },
                                            {
                                                "example_id": "46de3234-c3ab-4769-aede-b6d12f9917e9",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Während sie darüber sprachen, entdeckte er ihre Sinnlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35ee71a1-62f4-41dd-9cdf-3e8f0fa27e3a",
                        "source_entry_id": "39b6fe87-d330-3584-a826-54846ca9db68",
