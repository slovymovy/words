                                "example_id": "09c2993c-f213-4be0-8f9a-b2bee6485496",
                                "sense_id": "654c402d-8836-32dc-b909-a1bab4a95e4d",
                                "text": "„\"Am Ende wird das Elektroschrottgesetz diskreditiert, statt ökologischen Fortschritt produzieren wir Rückschritt\", mahnte Abfallexpertin Eva Leonhardt.“"
                            },
                            {
                                "example_id": "1ba319a0-720f-470d-acae-08745c26f3a9",
                                "sense_id": "654c402d-8836-32dc-b909-a1bab4a95e4d",
                                "text": "„Weil die Abfallexpertinnen nicht zum Lehrkörper der Schule gehören, sondern von auswärts anreisen, werden sie von den Schülern zumeist als Autorität akzeptiert.“"
                            }
                        ],
