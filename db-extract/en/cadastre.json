    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                "word": "cadastre",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ae10253e-bad3-451b-bfd2-13a87c3d0321",
                        "entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                        "tags": [
                            "plural"
                        ],
                        "form": "cadastres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ead0f6f3-176e-3d01-aff7-73c938e44f5a",
                        "entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                        "glosses": [
                            "A public survey of land, originally for the purpose of taxation and to create an official register of land ownership."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8ed8e6-ac55-47b6-949d-0c54452a034c",
                                "sense_id": "ead0f6f3-176e-3d01-aff7-73c938e44f5a",
                                "text": "As page 1 of the accompanying text helpfully explains, \"ichnographic plans are particularly well suited for cadastres\" but reveal nothing of the ups and downs and tops of things."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5c3e36f-9d62-3f1a-905f-e2f2d00048d6",
                        "entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                        "glosses": [
                            "A register of such surveys, showing details of ownership and value."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c419f096-65f1-4659-8930-b71e63d751c2",
                                "sense_id": "b5c3e36f-9d62-3f1a-905f-e2f2d00048d6",
                                "text": "The only parts of Greece that have had a land registry and cadastre are the Dodecanese Islands, because they were occupied by the Italians from 1912 to the end of World War II. Land use on the islands, which include Rhodes and Kos, is still guided by Italian law."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "846beeed-fd7b-4b8e-9b2c-45706158a19a",
