                ],
                "senses": [
                    {
                        "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                        "entry_id": "2d8601fd-6ac7-3e85-a6d3-c15835c4afd2",
                        "glosses": [
                            "das Vorlegen (eines Dokuments oder dergleichen), das Darlegen (auch von Argumenten und dergleichen), das Nachweisen; das Vorgelegte, Dargelegte; die Vorlage, die Darlegung, der Nachweis"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c3866edf-fb14-4e0c-ba96-e689df8c1258",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„In dem Königreich Indostan sitzt der grosse Mogol […] auf einen Thron: Um der Unterthanen streitige Sachen zu entscheiden / und den Leuten zu ihren Rechten zu verhelffen / welches von ihnen mit aufgereckter Hand / und Darweisung eines Bittschreibens / begehret und erlanget wird.“ (1693)"
                            },
                            {
                                "example_id": "188ba194-a223-4562-bba1-1e301f8d752d",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„v. Hornthal erinnerte: auf die Größe der Schuld, und wenn sie auf 200 Millionen sich belaufe, konme es nicht an, sondern auf ihre Darweisung.“ (1819)"
                            },
                            {
                                "example_id": "4bd0c9f4-0d15-4f6b-8317-d2225d8bbb5b",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„So enthält Plato’s Republik für uns jetzt viel Ungereimtes, aber auch viel Treffliches, und für ewig als wahr Geltendes; z. B. die Darweisung, daß der Geldreichthum das Elend der Völker verewige […]“ (1827)"
                            },
                            {
                                "example_id": "896f633b-81b9-465f-a7e7-1fd7cfc7f202",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„Warum aber Geschichte nimmer, wie Physik oder Chemie, eine Wissenschaft werden kann, das haben hervorragende Denker, wie Montesquieu, Wilhelm v. Humboldt und Schopenhauer, so unwiderleglich dargewiesen, daß es uns als eine unnöthige Dreistigkeit erscheinen könnte, wollten wir diese ihre Darweisung hier abgeschwächt noch einmal vorbringen.“ (1875)"
                            },
                            {
                                "example_id": "3cb54844-39c3-43f2-b3af-a265da153bfd",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„Hierauf hielt Herr Prof. Dr. Rudolf Klemensiewicz einen durch zahlreiche Darweisungen unterstützten Vortrag über die Beulenpest […]“ (1899)"
                            },
                            {
                                "example_id": "bdd7bfb6-07f7-4485-a797-5bd412c19b2a",
                                "sense_id": "5b5da315-c91f-3bb8-8124-5498bca2e6dd",
                                "text": "„Die Darweisung dieser ganzen Zusammenhänge behält ihre volle Bedeutung, auch wenn das, von dem wir ausgegangen sind, […] in anderer Weise und mit anderen Stoffen vor sich gegangen sein sollte […]“ (1921)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
