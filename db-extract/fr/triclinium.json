                "senses": [
                    {
                        "sense_id": "2868c3d4-e89b-34aa-b018-4a1345ed3160",
                        "entry_id": "94f2a9b1-a0c9-366f-956f-7a8938391c3f",
                        "glosses": [
                            "Salle à manger romaine où il y avait trois lits, sur chacun desquels se plaçaient deux ou trois convives."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "d66286a4-d969-4cd1-8626-180de95681c1",
                                "sense_id": "2868c3d4-e89b-34aa-b018-4a1345ed3160",
                                "text": "Il y a de quoi se perdre. Le triclinium d’hiver avec la grande exèdre, les jardins et leurs arcades, les thermes avec les piliers solitaires du frigidarium, le petit musée qui contient la statue de Niobé en marbre pentélique, et j’en passe."
                            },
                            {
                                "example_id": "65634e39-4c4d-4925-ad1e-5c317e6c7fd5",
                                "sense_id": "2868c3d4-e89b-34aa-b018-4a1345ed3160",
                                "text": "De temps à autre, il s’étalait sur le triclinium. Alors, ses pieds nus dominaient l’assemblée."
                            }
                        ]
                    }
                ],
