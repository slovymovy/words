                ],
                "senses": [
                    {
                        "sense_id": "7a832bfe-46df-31c6-8561-4f183f4dc23a",
                        "entry_id": "3eebe9a4-c930-3f49-9da7-4d2a5426a976",
                        "glosses": [
                            "Donner à quelque chose un caractère purement lié à l’administration, purement administratif."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a48800f8-c5ab-4a34-9e30-acc6bf803aa4",
                                "sense_id": "7a832bfe-46df-31c6-8561-4f183f4dc23a",
                                "text": "Oui, sachez-le bien, tous les sentiments de Paris viennent aboutir à cette loge, et s’y administrationalisent."
                            },
                            {
                                "example_id": "344be677-dcf0-45af-ac01-0b06e0ebdfd2",
                                "sense_id": "7a832bfe-46df-31c6-8561-4f183f4dc23a",
                                "text": "Autre cible adjacente de la logique analytique, les taxinomies abstraites, géométriques : la science comme « nomenclature » que dénonce La Peau de chagrin ; la science comme produisant un immense cimetière en ordre que dénonce Musset, tandis que le Balzac de Ferragus ironise, en écho, sur la mort « administrationalisée » par le concierge du Père-Lachaise."
                            }
                        ]
                    }
