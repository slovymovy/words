                "senses": [
                    {
                        "sense_id": "b862d82e-6b7b-30e1-bacf-a4ccf3e3040e",
                        "entry_id": "ed56468a-a6ff-3334-b4b4-4b23bdb065f6",
                        "glosses": [
                            "Décider de lancer une procédure de destitution contre le détenteur d’une charge officielle, aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c06060-6123-45d6-a13d-ecf41ee28174",
                                "sense_id": "b862d82e-6b7b-30e1-bacf-a4ccf3e3040e",
                                "text": "Andrew Johnson et Bill Clinton ont été « impeachés », c'est-à-dire que la Chambre des représentants a décidé qu'ils avaient commis des actes suffisamment graves pour être jugés."
                            },
                            {
                                "example_id": "530122c4-bebd-43a8-a6de-e6051d370d95",
                                "sense_id": "b862d82e-6b7b-30e1-bacf-a4ccf3e3040e",
                                "text": "La stratégie est de provoquer Trump, de trouver tous les prétextes pour le discréditer, pour qu'il soit battu en 2020, voire pour qu'il soit “impeaché”."
                            },
                            {
                                "example_id": "85ef2e7b-97e2-4e22-b5a9-a005663f1a1e",
                                "sense_id": "b862d82e-6b7b-30e1-bacf-a4ccf3e3040e",
                                "text": "Les Républicains devraient «avoir le courage de se conformer à la Constitution et d'impeacher le président», avait écrit l'ancien représentant du Colorado Tom Tancredo."
                            }
                        ]
                    }
                ],
