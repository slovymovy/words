                                "target_senses": [
                                    {
                                        "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "The act of indulging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee05d9a9-f984-4c1a-a8d8-a49ec84897cd",
                                                "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                                "text": "will all they that either through indulgence to others or fondness to any sin in themselves, substitute for repentance any thing that is less than a sincere, uniform resolution of new obedience"
                                            },
                                            {
                                                "example_id": "b14d8dee-a0d7-4081-8145-c8373f116e66",
                                                "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                                "text": "As indulgence in several wives depended mainly on the length of a man's purse, the poor naturally contented themselves with monogamy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7b681e8-86fc-3c31-acee-e8997e9c5cf3",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "Tolerance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89d3b46-0bc9-38d9-9ef8-97458048ffdb",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "The act of catering to someone's every desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a710e722-cb7c-3cac-a1e7-0e586a5523e4",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "A wish or whim satisfied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43093d6-1e33-4e50-be4e-22342fce7cd7",
                                                "sense_id": "a710e722-cb7c-3cac-a1e7-0e586a5523e4",
                                                "text": "\"In other words, the ONLY indulgences we'll be getting for a while is fixing your wardrobe. This means no new manga. No new games. Nothing. Get used to it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f22bedd-f277-38ac-9c14-6cc28751430a",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "Something in which someone indulges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8704547-99df-43e7-9719-6bc46673ff5a",
                                                "sense_id": "6f22bedd-f277-38ac-9c14-6cc28751430a",
                                                "text": "I made but one error—giving way to petulance in the earlier instance; that lost me the Prince of Conti. Temper is bourgeois indulgence, though I own to a predilection for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29cdf0d8-2125-3ce1-989f-1678d0d3e10e",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "An indulgent act; a favour granted; gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a89188-b5a7-48f9-b7f3-b6d5568afcf1",
                                                "sense_id": "29cdf0d8-2125-3ce1-989f-1678d0d3e10e",
                                                "text": "If all these gracious indulgences are without any effect on us, we must perish in our own folly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23177a1f-32af-30bd-84e0-bb4c74d19799",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "A pardon or release from the expectation of punishment in purgatory, after the sinner has been granted absolution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237ec1c2-ae11-4ed7-a891-a5207bdb02b6",
                                                "sense_id": "23177a1f-32af-30bd-84e0-bb4c74d19799",
                                                "text": "To understand how indulgences were intended to work depends on linking together a number of assumptions about sin and the afterlife, each of which individually makes considerable sense."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indulgence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2caeaf42-49c3-3f57-b191-3d3db3ce8b01",
                                        "entry_id": "a30ac2a1-682d-3596-8609-8ee522e13845",
