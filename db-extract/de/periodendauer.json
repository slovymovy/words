                    }
                ],
                "translations": [
                    {
                        "translation_id": "8288d3d1-09cc-4f34-bec4-ce0242db23d6",
                        "source_entry_id": "ed314fc4-1e55-3a04-ab08-c615139eae52",
                        "source_sense_id": "0f6d760e-dcc4-3d27-93b2-28350ca3d651",
                        "source_sense_description": "kürzeste Dauer eines sich zeitlich periodisch wiederholenden Vorgangs",
                        "target_lang_word": "cycle duration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "362d62b2-7c10-4ef9-a1b0-d33e69df1eea",
                        "source_entry_id": "ed314fc4-1e55-3a04-ab08-c615139eae52",
                        "source_sense_id": "0f6d760e-dcc4-3d27-93b2-28350ca3d651",
                        "source_sense_description": "kürzeste Dauer eines sich zeitlich periodisch wiederholenden Vorgangs",
                        "target_lang_word": "période",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "période",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30af2d37-937c-3779-926d-70fbe38d5d7b",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Temps qu’une chose met à accomplir les phases de sa durée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db079e7b-293f-48e3-8eeb-17cd2306aab7",
                                                "sense_id": "30af2d37-937c-3779-926d-70fbe38d5d7b",
                                                "text": "Le désastre de Mohacz (1526) où mourut le roi Louis II ouvre pour la Hongrie et la Slovaquie la période de domination ottomane qui dure jusqu'au traité de Požarevac (1718)."
                                            },
                                            {
                                                "example_id": "1a741142-1e0d-4a67-a5e6-e1974bb7c861",
                                                "sense_id": "30af2d37-937c-3779-926d-70fbe38d5d7b",
                                                "text": "Pour la période de trente-deux ans, qui correspond aux règnes de Childebert, de Caribert et de Dagobert, les numismates ont classé 141 médailles de Banassac."
                                            },
                                            {
                                                "example_id": "a589e9e7-2fb6-4b98-8248-fde3636d2e5c",
                                                "sense_id": "30af2d37-937c-3779-926d-70fbe38d5d7b",
                                                "text": "Pendant toute la période des fiançailles, le futur gendre va, pour manifester sa bonne volonté au travail et rendre service à sa belle-mère, régulièrement approvisionner la maison de ses beaux-parents en bois de feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a2495c-6377-3e22-8877-8089dd947426",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Intervalle de temps au bout duquel un phénomène ou un groupe de phénomènes se reproduit dans les mêmes conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f05cdd8a-76d2-4a4a-8447-f92e100d78ab",
                                                "sense_id": "65a2495c-6377-3e22-8877-8089dd947426",
                                                "text": "Chaque période interglaciaire amène un adoucissement du climat, qui prend le type froid et sec ou bien doux et humide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a654ee0c-5358-3f4a-bf01-5f5332db9833",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Révolution d’un astre tournant autour d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cace5623-cc27-424f-a08a-db250a50cad4",
                                                "sense_id": "a654ee0c-5358-3f4a-bf01-5f5332db9833",
                                                "text": "La période sidérale de la Lune autour de la Terre est de vingt-sept jours sept heures."
                                            },
                                            {
                                                "example_id": "dd8c8788-aee9-416f-9673-226490d20cba",
                                                "sense_id": "a654ee0c-5358-3f4a-bf01-5f5332db9833",
                                                "text": "La période de la planète Neptune autour du Soleil est de cent soixante-quatre ans."
                                            },
                                            {
                                                "example_id": "dac63830-2702-49ac-a91d-906103d5a3fe",
                                                "sense_id": "a654ee0c-5358-3f4a-bf01-5f5332db9833",
                                                "text": "Le saros des Chaldéens est la période d’environ dix-neuf ans au bout de laquelle les éclipses de soleil et de lune se reproduisent dans le même ordre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb33afe8-b763-3c10-8e86-499a5fe0c115",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Demi-vie."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be236e9-8cdc-480e-b6bd-8868bbd2aa5e",
                                                "sense_id": "bb33afe8-b763-3c10-8e86-499a5fe0c115",
                                                "text": "La période de radioactivité d'un radioélément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "970a9c33-fa11-3530-b001-1e265dc473d8",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Une des subdivisions de l'échelle des temps géologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1bb60e-bfa2-4ee0-832c-a2e43b5f5956",
                                                "sense_id": "970a9c33-fa11-3530-b001-1e265dc473d8",
                                                "text": "Les ères géologiques sont divisées en périodes, qui à leur tour sont divisées en époques."
                                            },
                                            {
                                                "example_id": "d7121ea3-725b-428c-8da0-0eaa37ba5445",
                                                "sense_id": "970a9c33-fa11-3530-b001-1e265dc473d8",
                                                "text": "Des sauriens gigantesques ont vécu pendant la période jurassique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0133323-7f82-3c20-a912-ee3d7d8bced1",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Enchaînement logique et ordonné de propositions dont le sens complet demeure en suspens jusqu’à leur point final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ad39b5-a9a6-4fa3-a287-3ad0b4c5bed2",
                                                "sense_id": "a0133323-7f82-3c20-a912-ee3d7d8bced1",
                                                "text": "Il se mit ensuite à nous parler de notre mère, des deux mille francs, de sa Roberte, de sa Camille, de son Anastagille, et cela avec tant de longueurs, tant de périodes, que nous serions encore, — c’est bien le cas de le dire, — debout dans le magasin, à l’écouter, si, Jacques ne lui avait pas dit d’un ton d’impatience : « Et votre caisse, Pierrotte ! »"
                                            },
                                            {
                                                "example_id": "48d0abe6-1474-4cbf-8624-73cbbb35586f",
                                                "sense_id": "a0133323-7f82-3c20-a912-ee3d7d8bced1",
                                                "text": "Puis il me renvoyait quelques minutes après, s’interrompant au milieu d’une période compliquée, comme si elle l’ennuyait trop pour qu’il s’occupât d’en compléter le sens."
                                            },
                                            {
                                                "example_id": "c1edc93f-31ab-45c2-aeea-8537a758c99b",
                                                "sense_id": "a0133323-7f82-3c20-a912-ee3d7d8bced1",
                                                "text": "J’ai toujours mal supporté les discours, les longues périodes oratoires où se prépare une conclusion que l’auditoire a devinée longtemps à l’avance et qui, lorsque enfin elle tombe, fût-ce dans un splendide envol rhétorique, ne surprend plus, et même ennuie déjà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee101a6-22a3-3ea2-950d-a950405bf459",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Phrase dont l’assemblage des éléments, si variés qu’ils soient, est harmonieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad631093-06e5-4db7-b5d2-b042e1d128a3",
                                                "sense_id": "2ee101a6-22a3-3ea2-950d-a950405bf459",
                                                "text": "Lorenzo.– Vous ne connaissez pas la véritable éloquence. On tourne une grande période autour d’un beau petit mot, pas trop court ni trop long, et rond comme une toupie ; on rejette son bras gauche en arrière, de manière à faire faire à son manteau des plis pleins d’une dignité tempérée par la grâce ; on lâche sa période qui se déroule comme une corde ronflante, et la petite toupie s’échappe avec un murmure délicieux."
                                            },
                                            {
                                                "example_id": "83579d23-8f86-44f3-a79c-437f4b6a420c",
                                                "sense_id": "2ee101a6-22a3-3ea2-950d-a950405bf459",
                                                "text": "Ce prologue le fatiguait, mais il ne pouvait l'écourter. L'éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s'entendre les phraser et de jouir de ces cadences étudiées."
                                            },
                                            {
                                                "example_id": "ddd84c88-adfd-4abe-bb5e-7b4ece063c4a",
                                                "sense_id": "2ee101a6-22a3-3ea2-950d-a950405bf459",
                                                "text": "Les belles périodes prouvent qu'on du souffle. À mérite égal, les phrases courtes seront toujours plus faciles à faire. Les belles périodes exigence un travail compliqué, tandis qu'un article de journal se fait au pied levé."
                                            },
                                            {
                                                "example_id": "0b999c18-d54a-4664-af77-7e721aa31650",
                                                "sense_id": "2ee101a6-22a3-3ea2-950d-a950405bf459",
                                                "text": "… ils sont semblables à ces périodes de Cicéron, longues, mais éloquentes, dont le sens, suspendu pendant toute leur durée, n'est déterminé qu'au dernier mot, et qui, par conséquent, n'ont formé qu'une seule pensée dans l'esprit de l'Auteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04ee49d-08e9-36a6-88b5-9d4fdfe6ac23",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Espace de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a416df-6e76-45dc-aa8c-0444ae5884cf",
                                                "sense_id": "d04ee49d-08e9-36a6-88b5-9d4fdfe6ac23",
                                                "text": "L'année du crapaud se partage en trois périodes distinctes de longueur inégale."
                                            },
                                            {
                                                "example_id": "336a659a-36e0-4a4f-909a-d718ae983ddc",
                                                "sense_id": "d04ee49d-08e9-36a6-88b5-9d4fdfe6ac23",
                                                "text": "Si la pêche du sandre est théoriquement possible toute l'année, les deux meilleures périodes semblent être la fin du printemps, juste après le frai, puis l'automne."
                                            },
                                            {
                                                "example_id": "91c90930-acbf-4f9c-83d0-80e7bc48aca7",
                                                "sense_id": "d04ee49d-08e9-36a6-88b5-9d4fdfe6ac23",
                                                "text": "La période qui s'étend entre le débarquement japonais à l’embouchure du Wang-poo et le bombardement de Nagasaki tut pour la Chine particulièrement fertile en catastrophes."
                                            },
                                            {
                                                "example_id": "7c2aca8c-ca7b-4ea9-bf78-8cc4eb1b7219",
                                                "sense_id": "d04ee49d-08e9-36a6-88b5-9d4fdfe6ac23",
                                                "text": "Ce compositeur excelle dans l’art de lier et d’arrondir ses périodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abf228a-5a3b-3912-b4d5-b5b7417dd01c",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Quantité fixe la plus petite qui puisse s’ajouter à la variable sans changer la valeur de la fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cced4d8a-9268-4ddb-a8e1-84d009eb2e3d",
                                                "sense_id": "0abf228a-5a3b-3912-b4d5-b5b7417dd01c",
                                                "text": "Période d’une fraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398c7c87-570c-32a7-b6bb-203b61c356ae",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Phase d’une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e8e12e-c77a-4e28-9974-5bc80e00ae66",
                                                "sense_id": "398c7c87-570c-32a7-b6bb-203b61c356ae",
                                                "text": "La période d’accroissement, de déclin."
                                            },
                                            {
                                                "example_id": "0f8d3509-197f-4ad1-8152-5b27011715e8",
                                                "sense_id": "398c7c87-570c-32a7-b6bb-203b61c356ae",
                                                "text": "Les fièvres intermittentes ont leurs périodes déterminées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6b9115-e3aa-35cb-9d93-220717f01554",
                                        "entry_id": "2984121b-6466-307b-8ddd-8dfd3bdf29a7",
                                        "glosses": [
                                            "Inverse de la fréquence."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cb7f773-1401-46c6-b89d-81fca3f3324b",
                                                "sense_id": "3f6b9115-e3aa-35cb-9d93-220717f01554",
                                                "text": "La période d’un pendule, d’une onde."
                                            },
                                            {
                                                "example_id": "8ef6a7af-1906-4fe6-85f0-56fc5bffbff7",
                                                "sense_id": "3f6b9115-e3aa-35cb-9d93-220717f01554",
                                                "text": "Les ondes à courtes périodes sont très employées en télégraphie sans fil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "période",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                        "entry_id": "952aa4ac-adc9-32ae-baba-becdeb12d2f2",
                                        "glosses": [
                                            "Le point ou le degré où une chose, une personne est arrivée."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede39548-f770-4b70-ba6d-c7d49150ceb5",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "L’autopsie à laquelle on a procédé sur-le-champ a démontré que cette mort était due à la rupture d’un anévrisme à son dernier période."
                                            },
                                            {
                                                "example_id": "3d47528e-2ca1-46d1-886f-16d1669b2733",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "L’architecture du Mirah montre au contraire une civilisation arrivée à son plus haut développement, un art à son période culminant : au-delà, il n’y a plus que la décadence."
                                            },
                                            {
                                                "example_id": "c399b3aa-0638-4959-9ead-5207c76c0abc",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "— Elle est au dernier période de la phtisie, et c’est un miracle qu’elle vive encore."
                                            },
                                            {
                                                "example_id": "2694008f-f5b0-47b7-832d-c13c4b04bbd0",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "Il aurait voulu faire s’accorder les doctrines avec les œuvres, les critiques et les poètes, saisir l’essence du Beau ; et ces questions le travaillèrent tellement que sa bile en fut remuée. Il y gagna une jaunisse. Elle était à son plus haut période, quand Marianne, la cuisinière de Mme Bordin, vint demander à Bouvard un rendez-vous pour sa maîtresse."
                                            },
                                            {
                                                "example_id": "6127e6fb-f1eb-4bfc-9e55-f1a33b812805",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "Ce jeune garçon, qui était vigoureux et sain lors de son arrestation, est aujourd’hui au dernier période de la phtisie."
                                            },
                                            {
                                                "example_id": "07c6d696-5983-469f-8814-b997c7d4418b",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "Chez Sade, comme dans Vénus en rut, le verbe porter marque l'action qui permet d'atteindre le dernier période. L'expression porter au dernier période marque alors une limite de l'imagination, au sens que le calcul intégral donne à la notion de limite."
                                            },
                                            {
                                                "example_id": "202b7a16-fa90-4cc2-8097-b4d603210e1a",
                                                "sense_id": "01f0052c-e9f8-3e2e-88c1-81a59317469a",
                                                "text": "Mais comme il est d’un tempérament si contraire à celui qui nous fait hommes, que jamais il n’a vie qu’aux mois, remarquez, tout à fait antipathiques à la nôtre, quand nous restons dans la matrice outre le cours naturel, ce n’est pas merveille que le période du temps dont Nature a besoin pour délivrer une jument, soit autre que celui qui fait accoucher une femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
