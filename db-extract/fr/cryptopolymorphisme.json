                        "glosses": [
                            "Cas de polymorphisme caractérisé par la présence d’un allèle largement majoritaire et d’un ou plusieurs allèles plus rares (représentant moins de 1 %)."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "a8eaa794-86a0-4594-8ee0-87b6faef9952",
                                "sense_id": "24c3db92-cef4-3b81-8265-6ad259b74143",
                                "text": "Les maladies génétiques humaines relèvent pour la plupart d’un cryptopolymorphisme."
                            },
                            {
                                "example_id": "23796333-deeb-4409-a622-238ce0869539",
                                "sense_id": "24c3db92-cef4-3b81-8265-6ad259b74143",
                                "text": "On a donné le nom de « cryptopolymorphisme » à cette variabilité génétique, habituellement cachée, qui ne se révèle normalement que par l’apparition occasionnelle de quelques « monstres »."
                            }
                        ]
                    }
