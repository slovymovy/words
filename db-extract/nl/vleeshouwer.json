                                                "sense_id": "8e5742b2-0f28-3d54-b1b7-1dbb38e53b77",
                                                "text": "The band at that bar really butchered \"Hotel California\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec772910-6512-3e21-830f-4f6ab2a3452d",
                                        "entry_id": "fb929f8f-6420-3bd0-b5eb-d66fb7fd6a4b",
                                        "glosses": [
                                            "To mess up hopelessly; to botch; to distort beyond recognition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628a827d-0eaa-4fbf-be6e-e2648b53596b",
                                                "sense_id": "ec772910-6512-3e21-830f-4f6ab2a3452d",
                                                "text": "I am bad at pronouncing names, so my apologies if I butcher any of your names."
                                            }
                                        ]
                                    }
                                ]
