                                "target_senses": [
                                    {
                                        "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                        "entry_id": "864f6d6b-7b72-3d3b-8ea5-50cd3945b837",
                                        "glosses": [
                                            "The state of being stubborn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf384cd-7809-415a-aabb-b9dbbb274f55",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "[H]appy is your Grace / That can tranſlate the ſtubbornneſſe of fortune / Into ſo quiet and ſo ſweet a ſtile."
                                            },
                                            {
                                                "example_id": "3b38afaf-cca1-481b-b6fc-909e6574e7e6",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "Brant Rios and Eos Parish have been dating five years and experienced their state’s stubbornness firsthand Friday when they were the first couple to arrive at the Ouachita Parish Courthouse to be wed – and were the first to be turned away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
