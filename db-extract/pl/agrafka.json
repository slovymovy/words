                                        "entry_id": "b05ce1f8-df4c-3f38-b708-dc4cf73ffddb",
                                        "glosses": [
                                            "verschließbare Nadel, die so gebogen ist, dass das spitze Ende keine Verletzungsgefahr darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba596100-4862-41a7-8260-cbabd81be91e",
                                                "sense_id": "adaee71c-b24a-3eda-8107-dac73c00dd0e",
                                                "text": "Sie hatte den losgerissenen Rocksaum notdürftig mit einer Sicherheitsnadel geflickt."
                                            },
                                            {
                                                "example_id": "30874a4b-79a1-47ad-875f-beb5682a8151",
                                                "sense_id": "adaee71c-b24a-3eda-8107-dac73c00dd0e",
                                                "text": "„Er schiente mir den Daumen mit einem kleinen Stock und wickelte einen Verband drumrum, den er mit einer Sicherheitsnadel zumachte.“"
                                            },
                                            {
                                                "example_id": "63c2b0cd-f59b-426c-a425-98d01869390b",
                                                "sense_id": "adaee71c-b24a-3eda-8107-dac73c00dd0e",
                                                "text": "„Ich glaube, der Handel mit ihm hätte auch dann nichts an Romantik eingebüßt, wenn er Sicherheitsnadeln oder Hosenträger verkauft hätte.“"
                                            },
                                            {
                                                "example_id": "2b203917-1c2b-46b1-b70a-544742c23bf5",
                                                "sense_id": "adaee71c-b24a-3eda-8107-dac73c00dd0e",
                                                "text": "„Der Andere steckte den Verband mit der Sicherheitsnadel fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
