                {
                    "sense_id": "13d5b97a-30b8-3705-8080-e1ffd73e98a0",
                    "sense_definition": "een teken of merk aanbrengen op een voorwerp om het te identificeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "markeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer moet al zijn schapen <w>merken</w> voordat ze de wei in gaan.",
