{
    "word_family": [
        "invade",
        "invader",
        "invasive",
        "invasiveness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                    "sense_definition": "A military action where armed forces enter another country to conquer it or change its government.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general planned a full-scale <w>invasion</w> to take control of the region.",
                            "target_lang_translations": {
                                "ru": "Генерал спланировал полномасштабное <w>вторжение</w>, чтобы взять регион под контроль.",
                                "tr": "General, bölgenin kontrolünü ele geçirmek için kapsamlı bir <w>istila</w> planladı."
                            }
                        },
                        {
                            "text": "History books describe the <w>invasion</w> that changed the country's borders forever.",
                            "target_lang_translations": {
                                "ru": "Учебники истории описывают <w>вторжение</w>, которое навсегда изменило границы страны.",
                                "tr": "Tarih kitapları, ülkenin sınırlarını sonsuza dek değiştiren <w>işgali</w> anlatır."
                            }
                        }
                    ],
                    "synonyms": [
                        "incursion",
                        "attack",
                        "conquest",
                        "occupation"
                    ],
                    "antonyms": [
                        "withdrawal",
                        "retreat"
                    ],
                    "common_phrases": [
                        "military invasion",
                        "launch an invasion",
                        "alien invasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военные действия, при которых вооруженные силы входят в другую страну с целью ее захвата или смены власти.",
                        "tr": "Silahlı kuvvetlerin başka bir ülkeyi ele geçirmek veya hükümetini değiştirmek amacıyla oraya girmesiyle gerçekleşen askeri eylem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторжение",
                                "target_lang_sense_clarification": "военное нападение"
                            },
                            {
                                "target_lang_word": "нашествие",
                                "target_lang_sense_clarification": "массовое вторжение врага"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "istila",
                                "target_lang_sense_clarification": "askeri harekat veya işgal etme"
                            },
                            {
                                "target_lang_word": "işgal",
                                "target_lang_sense_clarification": "bir toprağı ele geçirme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                    "sense_definition": "The arrival or entry of a large number of people or things into a place where they are not wanted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor felt the paparazzi caused a serious <w>invasion</w> of privacy.",
                            "target_lang_translations": {
                                "ru": "Известный актер чувствовал, что папарацци совершили серьезное <w>вторжение</w> в частную жизнь.",
                                "tr": "Ünlü oyuncu, paparazilerin ciddi bir özel hayat <w>ihlaline</w> yol açtığını hissetti."
                            }
                        },
                        {
                            "text": "Every summer, the small quiet village faces an <w>invasion</w> of tourists.",
                            "target_lang_translations": {
                                "ru": "Каждое лето маленькая тихая деревня сталкивается с <w>нашествием</w> туристов.",
                                "tr": "Her yaz, bu küçük ve sakin köy turist <w>akınına</w> uğrar."
                            }
                        }
                    ],
                    "synonyms": [
                        "intrusion",
                        "influx",
                        "encroachment"
                    ],
                    "common_phrases": [
                        "invasion of privacy",
                        "home invasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибытие или проникновение большого количества людей или вещей в место, где они нежелательны.",
                        "tr": "Çok sayıda insanın veya şeyin istenmedikleri bir yere girmesi veya ulaşması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторжение",
                                "target_lang_sense_clarification": "в личную жизнь"
                            },
                            {
                                "target_lang_word": "нашествие",
                                "target_lang_sense_clarification": "большого количества людей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ihlal",
                                "target_lang_sense_clarification": "özel hayata veya sınırlara müdahale"
                            },
                            {
                                "target_lang_word": "akın",
                                "target_lang_sense_clarification": "kalabalık bir grubun gelişi"
                            },
                            {
                                "target_lang_word": "istila",
                                "target_lang_sense_clarification": "her tarafı kaplama, basma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "372f5947-4869-3285-a562-89ed4d941ab8",
                    "sense_definition": "The spread of cancer cells or bacteria into the body's tissues.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early detection can prevent the <w>invasion</w> of the tumor into vital organs.",
                            "target_lang_translations": {
                                "ru": "Ранняя диагностика может предотвратить <w>прорастание</w> опухоли в жизненно важные органы.",
                                "tr": "Erken teşhis, tümörün hayati organlara <w>yayılmasını</w> engelleyebilir."
                            }
                        },
                        {
                            "text": "The doctor explained how the bacterial <w>invasion</w> affected the patient's immune system.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, как бактериальная <w>инвазия</w> повлияла на иммунную систему пациента.",
                                "tr": "Doktor, bakteriyel <w>invazyonun</w> hastanın bağışıklık sistemini nasıl etkilediğini açıkladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "spread",
                        "metastasis",
                        "infection"
                    ],
                    "common_phrases": [
                        "vascular invasion",
                        "tumor invasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространение раковых клеток или бактерий в ткани организма.",
                        "tr": "Kanser hücrelerinin veya bakterilerin vücut dokularına yayılması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвазия",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "прорастание",
                                "target_lang_sense_clarification": "опухоли в ткани"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "invazyon",
                                "target_lang_sense_clarification": "tıbbi yayılım"
                            },
                            {
                                "target_lang_word": "yayılan",
                                "target_lang_sense_clarification": "doku içine ilerleme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f592e4-41ae-3744-ae65-fdd3aac67b2a",
                    "sense_definition": "The act of breaking through the skin or body surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Surgical <w>invasion</w> always carries a small risk of infection.",
                            "target_lang_translations": {
                                "ru": "Хирургическое <w>вмешательство</w> всегда несет небольшой риск инфекции.",
                                "tr": "Cerrahi <w>müdahale</w> her zaman küçük bir enfeksiyon riski taşır."
                            }
                        },
                        {
                            "text": "The procedure involves minimal <w>invasion</w> of the skin using a fine needle.",
                            "target_lang_translations": {
                                "ru": "Процедура предполагает минимальное <w>проникновение</w> под кожу с помощью тонкой иглы.",
                                "tr": "Prosedür, ince bir iğne kullanarak deriye minimum düzeyde <w>müdahale</w> içerir."
                            }
                        }
                    ],
                    "synonyms": [
                        "penetration",
                        "puncture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт нарушения целостности кожного покрова или поверхности тела.",
                        "tr": "Deri veya vücut yüzeyinin bütünlüğünün bozulması/geçilmesi eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешательство",
                                "target_lang_sense_clarification": "хирургическое"
                            },
                            {
                                "target_lang_word": "проникновение",
                                "target_lang_sense_clarification": "сквозь поверхность тела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "müdahale",
                                "target_lang_sense_clarification": "cerrahi veya tıbbi girişim"
                            },
                            {
                                "target_lang_word": "invazyon",
                                "target_lang_sense_clarification": "doku bütünlüğünü bozma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}