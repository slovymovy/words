                "senses": [
                    {
                        "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                        "entry_id": "710bceed-c781-3247-b7df-b01b0b5654d2",
                        "glosses": [
                            "Forscherin, die sich mit der Erforschung der Gletscher beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69267c0-fd5c-445c-9feb-e34e4e6846a8",
                                "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                                "text": "„Selbst wenn die Gletscher doppelt so schnell schmelzen würden und überhaupt kein Schnee mehr falle, seien rund 50 Jahre nötig, um sie vollständig zum Verschwinden zu bringen, so die Gletscherforscherin.“"
                            },
                            {
                                "example_id": "60228151-085b-400d-bf0b-eb349f83bf2c",
                                "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                                "text": "„Die Gletscherforscherin Astrid Lambrecht von der Universität Innsbruck erläuterte, verschärft werde die Situation, da auch die Gletscher langfristig als Wasserreservoirs in den Bergen spürbar schrumpften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
