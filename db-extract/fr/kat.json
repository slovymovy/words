                "senses": [
                    {
                        "sense_id": "986b2bab-68ba-30ab-af51-04d4d7f13b32",
                        "entry_id": "f07fb268-6517-3c93-a544-ab81271520e0",
                        "glosses": [
                            "Variante de qat."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e5115f54-fe42-4e84-b808-e84c37621dd0",
                                "sense_id": "986b2bab-68ba-30ab-af51-04d4d7f13b32",
                                "text": "Tout en mâchonnant le kat plusieurs heures durant, un chauffeur de taxi m’a conduit, avec une remarquable adresse, par des sentiers périlleux, susceptibles de décourager plus d’un Européen."
                            },
                            {
                                "example_id": "c59ef568-4da7-4418-bc77-1bcb8bb143f1",
                                "sense_id": "986b2bab-68ba-30ab-af51-04d4d7f13b32",
                                "text": "On l’envoyait puiser de l’eau pour les femmes, il recevait en aumône un coup de bâton, parfois un peu de tabac ou du kat qui est une drogue amère."
                            },
                            {
                                "example_id": "19ea33f0-16e8-4ee3-a6b0-05879b0affa3",
                                "sense_id": "986b2bab-68ba-30ab-af51-04d4d7f13b32",
                                "text": "Marié, père de trois enfants, dont deux sont morts, il vivait du commerce ambulant des fruits et légumes et du kat, cette drogue très répandue dans la région."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c4020c9-1c10-3605-bf4c-9a4c4c70238f",
                        "entry_id": "f07fb268-6517-3c93-a544-ab81271520e0",
                        "glosses": [
                            "Le corps physique, une des parties de l’âme humaine."
                        ],
                        "tags": [
                            "Mythologie égyptienne"
                        ],
                        "examples": [
                            {
                                "example_id": "6cdcc606-5dc4-4305-822c-e470fc04f8da",
                                "sense_id": "3c4020c9-1c10-3605-bf4c-9a4c4c70238f",
                                "text": "Spécialistes de l’observation, du sondage de la richesse de l’univers, et de la recherche du savoir, les Égyptiens ont dégagé de cet univers 9 éléments constitutifs de la personne humaine à savoir : Le Kat, le Sahu, le Ab, le Ka, le Ba, le Khaibit, le Khu, le Sekhem, le Ren. Voyons à présent point par point la signification et l’importance de chaque élément.\nLe Kat : c’est le corps physique, malléable au toucher, visible, très important chez les Égyptiens qui veulent toujours le maintenir dans son état naturel, pur, d’où la création de la technique de momification."
                            }
                        ]
                    }
