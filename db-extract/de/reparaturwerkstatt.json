                "senses": [
                    {
                        "sense_id": "7088b963-02e8-3057-9469-186cb3a613ba",
                        "entry_id": "3832b298-a83c-3cf2-88d3-2424f212621d",
                        "glosses": [
                            "Räumlichkeiten, die so mit Werkzeug und anderen Hilfsmitteln ausgestattet sind, dass defekte Dinge (zum Beispiel Fahrzeuge, Elektrogeräte) wieder instand gesetzt werden können"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "95c2b7fa-e149-4360-8f29-dca9e029b181",
                                "sense_id": "7088b963-02e8-3057-9469-186cb3a613ba",
                                "text": "„Bis zum Schluss stand er [Detlev Louis] an der Spitze seiner 1938 gegründeten Firma, die er ebenso zielstrebig wie sozial verantwortungsbewusst von einer kleinen Reparaturwerkstatt zum europaweit angesehenen Motorradbekleidungs- und -zubehörunternehmen führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
