            "senses": [
                {
                    "sense_id": "400c896c-7ba2-354e-b828-a2300dd3e5ef",
                    "sense_definition": "Present participle and gerund of <w>stand</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_upright",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>standing</w> by the window waiting for you.",
