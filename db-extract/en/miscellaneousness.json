                                "example_id": "d4f6c66d-8ece-424c-b834-7b351d879ce5",
                                "sense_id": "72683168-e6dd-327a-b097-fd692eca9a26",
                                "text": "But this miscellaneousness comes to an end in one subject, the appalling subject of the Speaker's own death and resurrection."
                            },
                            {
                                "example_id": "eb526526-fdbf-4872-92ab-35d3114aa129",
                                "sense_id": "72683168-e6dd-327a-b097-fd692eca9a26",
                                "text": "There are essentially two different attitudes toward the Outer and Miscellaneous chapters of the Zhuangzi. The first emphasizes their \"disorder\" and \"miscellaneousness\" and fails to take into account a certain sort of consistency among them."
                            }
                        ]
