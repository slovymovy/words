                    {
                        "form_id": "4a49e079-4422-4d6d-a6fb-af5467944136",
                        "entry_id": "b15b9c9f-191f-3f30-a6e1-c9569b4504d6",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ivoiriennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31e1f7a4-d64f-3a4a-aa7c-8b3db89447c7",
                        "entry_id": "b15b9c9f-191f-3f30-a6e1-c9569b4504d6",
                        "glosses": [
                            "Relatif à la Côte d’Ivoire, son peuple et sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36de82b-9746-4d04-9e10-73625c26e6f1",
                                "sense_id": "31e1f7a4-d64f-3a4a-aa7c-8b3db89447c7",
                                "text": "Le drame ivoirien mêle inextricablement ces deux dimensions et a abouti à partir de la tentative d’instauration du concept d’« ivoirité » à une coupure du pays en deux et à une situation de guerre civile."
                            },
                            {
                                "example_id": "5e889855-005d-42d8-96db-b94d17d19876",
                                "sense_id": "31e1f7a4-d64f-3a4a-aa7c-8b3db89447c7",
                                "text": "Cette mainmise du groupe en Côte d’Ivoire fut imposée sans lésiner sur les moyens : les sociétés de transport bolloréennes rançonnent les producteurs ivoiriens tandis que les banques françaises et internationales complices les asphyxient financièrement…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2bca6d9-d993-4ab7-866d-2b49bbea8c5a",
                        "source_entry_id": "b15b9c9f-191f-3f30-a6e1-c9569b4504d6",
                        "source_sense_id": "31e1f7a4-d64f-3a4a-aa7c-8b3db89447c7",
                        "target_lang_word": "ivorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ivorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af9dcbaa-abf8-300f-b057-5c8ab43ff8cb",
                                        "entry_id": "3034c409-99eb-30c4-a1e7-98742cfc4ddb",
                                        "glosses": [
                                            "die Elfenbeinküste (Côte d’Ivoire) betreffend, aus der Elfenbeinküste kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f307c0-3c90-4015-b38d-7937d853b7f8",
                                                "sense_id": "af9dcbaa-abf8-300f-b057-5c8ab43ff8cb",
                                                "text": "Nach dem neuen Staatsbürgerschaftsrecht hat nun nur derjenige Ivorer Anrecht auf die ivorische Staatsbürgerschaft, der die ivorische Abstammung beider Elternteile zweifelsfrei nachweisen kann."
                                            },
                                            {
                                                "example_id": "0bb6cd94-6ff8-4637-9aa7-cab2d95d8c02",
                                                "sense_id": "af9dcbaa-abf8-300f-b057-5c8ab43ff8cb",
                                                "text": "Er wurde zwar in einem höchst dubiosen Urnengang in seinem Amt bestätigt, doch nun setzte eine Periode innerer Zwistigkeiten ein, die plötzlich - am Weihnachtstag 1999 - in einer Revolte ivorischer Soldaten gipfelte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bcfb355-031a-4478-b4a8-ccd85a832739",
                        "source_entry_id": "b15b9c9f-191f-3f30-a6e1-c9569b4504d6",
                        "source_sense_id": "31e1f7a4-d64f-3a4a-aa7c-8b3db89447c7",
