                ],
                "senses": [
                    {
                        "sense_id": "ec5da95a-525e-319c-b68e-96baaab6829a",
                        "entry_id": "de583a3c-65e2-343a-9c28-6d2b2e9cf0a6",
                        "glosses": [
                            "Donner un caractère gnangnan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5569ce-7142-4eef-805f-becefd3f9e0e",
                                "sense_id": "ec5da95a-525e-319c-b68e-96baaab6829a",
                                "text": "Tout ça sans infantiliser bébé ni gnangnantiser mémé."
                            },
                            {
                                "example_id": "f02fdf51-2cc8-426e-a0da-adb61a3a84fc",
                                "sense_id": "ec5da95a-525e-319c-b68e-96baaab6829a",
                                "text": "Nous avons pris beaucoup de plaisir avec mon partenaire à “gnangnantiser” ce couple : on s'est dit qu'on les détesterait si on les connaissait !"
                            },
                            {
                                "example_id": "8f97bf89-5bcc-453f-93fb-39c18c1f8028",
                                "sense_id": "ec5da95a-525e-319c-b68e-96baaab6829a",
                                "text": "Sans guimauve, avec jolie subtilité et images délicatement dessinées, Guy Prunier, qui n'a pas coutume de « gnangnantiser », conte en paroles, ritournelles et mimiques du corps, la remuante tournée du père Noël, bonhomme à bretelles, à rennes d’Angleterre et au cœur gros comme ça !"
                            }
                        ]
                    }
                ],
