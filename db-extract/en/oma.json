                "senses": [
                    {
                        "sense_id": "4cf42c83-a561-3a12-93e1-c3f111b41278",
                        "entry_id": "3dadce9f-45db-38d0-85ef-f0282f7aa3d4",
                        "glosses": [
                            "A township in Gêrzê County, Ngari prefecture, Tibet Autonomous Region, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07e49ec-a983-499b-9bbb-ccc84d8c9b1c",
                                "sense_id": "4cf42c83-a561-3a12-93e1-c3f111b41278",
                                "text": "Reach Wuma (Öma) in 3-4 hr (90 km) from Gerze."
                            },
                            {
                                "example_id": "5bad3da4-6122-4ed5-b66a-f04f19cac464",
                                "sense_id": "4cf42c83-a561-3a12-93e1-c3f111b41278",
                                "text": "About 33 genus 47 species corals were discovered in the so-called \"Xiala Formation(Ft)\" in north of Oma Village, Gêrzê County, Tibet."
                            },
                            {
                                "example_id": "f92b36d5-3419-4f82-ac28-975d8febc18e",
                                "sense_id": "4cf42c83-a561-3a12-93e1-c3f111b41278",
                                "text": "Around Oma-chu, a small village huddled beneath a small rocky splinter, 54km from Gertse, keep your eyes open for the round, tomblike buildings that are actually tsampa (roasted-barley flour) storage bins."
                            }
                        ]
                    }
                ],
