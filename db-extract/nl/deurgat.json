                        "examples": [
                            {
                                "example_id": "ef132db3-f0c4-49a2-9829-1b45a60d3659",
                                "sense_id": "ec22d817-52ee-36b9-85f1-d9e33b943c03",
                                "text": "'Wyatt had Noelle gevraagd hoeveel chemobehandelingen mijn dochter met dat geld kon krijgen', vertelt Trisha. 'Hij stond er absoluut op om zijn prijzengeld weg te schenken om zijn buurmeisje te helpen. Cara is trouwens weg van Wyatt. Hij komt vaak bij mijn zoon spelen. Die is ook acht jaar. Telkens Wyatt zijn hoofd in het deurgat steekt, heeft Cara een lach tot achter haar oren'."
                            },
                            {
                                "example_id": "f20de7b4-947f-4120-bfc2-a793b561fb74",
                                "sense_id": "ec22d817-52ee-36b9-85f1-d9e33b943c03",
                                "text": "Baby Abolfazi wordt door zijn vader boven de menigte omhoog gehouden voor het deurgat. Een familielid in de trein pakt het kind aan."
                            }
                        ]
                    }
