{
    "word_family": [
        "gerrymanderer",
        "gerrymandering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11403b81-7dd5-3a69-9fa9-abae143a499a",
                    "sense_definition": "To manipulate the boundaries of an electoral constituency so as to favor one party or class.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gerrymander_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics accused the ruling party of trying to <w>gerrymander</w> electoral boundaries before the national vote."
                        },
                        {
                            "text": "Politicians often attempt to <w>gerrymander</w> districts to preserve their majority in parliament."
                        }
                    ],
                    "synonyms": [
                        "redistrict"
                    ],
                    "common_phrases": [
                        "gerrymander districts"
                    ]
                },
                {
                    "sense_id": "5ba64483-d69c-32a7-9d6e-da541e72241b",
                    "sense_definition": "To draw dividing lines for other kinds of zones or districts in an unfair way to benefit a specific group.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gerrymander_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school board decided to <w>gerrymander</w> the boundaries to exclude certain neighborhoods."
                        },
                        {
                            "text": "Activists claimed officials worked to <w>gerrymander</w> school districts to favor wealthier families."
                        }
                    ],
                    "common_phrases": [
                        "gerrymander school districts"
                    ]
                },
                {
                    "sense_id": "5e22db73-083c-3328-9b38-f8aa9ed922ae",
                    "sense_definition": "To manipulate the voting franchise or electoral rules to provide an unfair political advantage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gerrymander_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition warned that changes in election law would effectively <w>gerrymander</w> the rules against them."
                        },
                        {
                            "text": "Party leaders sought to <w>gerrymander</w> the franchise to suppress turnout among urban voters."
                        }
                    ],
                    "common_phrases": [
                        "gerrymander the rules"
                    ]
                },
                {
                    "sense_id": "540dc323-c2f5-32f8-b060-00d9963d1e58",
                    "sense_definition": "To relocate or manipulate populations of voters within a district to unfairly secure an electoral advantage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gerrymander_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local council was accused of using housing policies to <w>gerrymander</w> a majority in marginal wards."
                        },
                        {
                            "text": "Officials deliberately relocated residents to <w>gerrymander</w> the political balance of the municipality."
                        }
                    ],
                    "common_phrases": [
                        "gerrymander a majority"
                    ]
                },
                {
                    "sense_id": "e0086a82-092f-31e1-8e00-441cc9f0622b",
                    "sense_definition": "Obsolete form of <w>gerrymander</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, opponents claimed the governor would <w>Gerrymander</w> the state for political gain."
                        },
                        {
                            "text": "The local newspaper accused the faction of attempting to <w>Gerrymander</w> congressional seats."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "capitalized spelling"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "efe58487-718b-328b-bb48-6e677b8919d1",
                    "sense_definition": "The act or practice of manipulating electoral boundaries to favor one party or class.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gerrymander_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reformers argued that the redistricting plan was a blatant <w>gerrymander</w> designed to protect incumbents."
                        },
                        {
                            "text": "The Supreme Court declined to rule on whether a partisan <w>gerrymander</w> violated the constitution."
                        }
                    ],
                    "common_phrases": [
                        "partisan gerrymander"
                    ]
                },
                {
                    "sense_id": "8258c3be-6ebd-3c13-b535-4253bb2fa28d",
                    "sense_definition": "A voting district whose boundaries have been drawn unnaturally through gerrymandering.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gerrymander_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anyone examining the bizarre shape of the district could tell it was a political <w>gerrymander</w>."
                        },
                        {
                            "text": "The map revealed an awkward <w>gerrymander</w> that connected two distant communities by a narrow strip."
                        }
                    ],
                    "common_phrases": [
                        "political gerrymander"
                    ]
                },
                {
                    "sense_id": "510f3976-a170-35f5-8de1-b47907a23491",
                    "sense_definition": "Obsolete form of <w>gerrymander</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nineteenth-century commentators frequently attacked the Massachusetts <w>Gerrymander</w> in the press."
                        },
                        {
                            "text": "The infamous cartoon depicted the strange shape as an unholy creature called the <w>Gerrymander</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "capitalized spelling"
                        }
                    ]
                }
            ]
        }
    ]
