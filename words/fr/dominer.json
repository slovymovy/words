    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c00f42b-a209-3f31-a6e4-e8aa3ba00152",
                    "sense_definition": "Être situé plus haut, s'élever au-dessus d'un lieu et offrir une vue plongeante.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hauteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château fort <w>domine</w> la vallée depuis le haut de la colline."
                        },
                        {
                            "text": "De cette terrasse, l'hôtel <w>domine</w> la ville et offre un magnifique panorama."
                        }
                    ],
                    "synonyms": [
                        "surplomber"
                    ],
                    "common_phrases": [
                        "dominer la ville",
                        "dominer la vallée"
                    ]
                },
                {
                    "sense_id": "940e8c13-176d-3816-a5f3-383eaf484538",
                    "sense_definition": "Montrer une nette supériorité sur des rivaux ou des concurrents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette équipe a largement <w>dominé</w> ses adversaires pendant toute la seconde période."
                        },
                        {
                            "text": "Le jeune athlète <w>domine</w> la compétition internationale depuis deux saisons consécutives."
                        }
                    ],
                    "synonyms": [
                        "surpasser"
                    ],
                    "common_phrases": [
                        "dominer la compétition",
                        "dominer ses concurrents"
                    ]
                },
                {
                    "sense_id": "e0b2f01c-ef09-3df9-9bcf-b501dbb724cd",
                    "sense_definition": "Exercer une autorité souveraine, imposer son pouvoir absolu sur un peuple ou un territoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet empire a <w>dominé</w> une grande partie du continent pendant plusieurs siècles."
                        },
                        {
                            "text": "Le conquérant souhaitait <w>dominer</w> le monde entier grâce à sa puissante armée."
                        }
                    ],
                    "synonyms": [
