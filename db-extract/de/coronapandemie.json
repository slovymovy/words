                        ],
                        "form": "die Coronapandemie"
                    },
                    {
                        "form_id": "78dcfec3-7bc0-41ef-b201-ab92cd4b7d37",
                        "entry_id": "ebe1fe0e-bf3f-319c-8939-26db5b7a359b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Coronapandemien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                        "entry_id": "ebe1fe0e-bf3f-319c-8939-26db5b7a359b",
                        "glosses": [
                            "weltweite Kette mit sehr vielen Infektionen von Menschen mit SARS-CoV-2"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2835d769-fa3d-4d55-a3bb-f61c91f13f8a",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„[…] die Coronapandemie hat auch die Seenotrettung im Mittelmeer ausgeschaltet.“"
                            },
                            {
                                "example_id": "22236afd-9254-473c-b39f-2c1aaebf2aa4",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Es ist Mitte März und vermutlich deshalb so leer, weil die Coronapandemie die Leute zu Hause hält.“"
                            },
                            {
                                "example_id": "d10c7764-709e-4a1f-8238-5f7f1cc6e9fd",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Die Öffnung der Schulen während der Coronapandemie stößt auf Erleichterung und Kritik.“"
                            },
                            {
                                "example_id": "58434bdc-8970-46cc-8a09-4c47f2bbdca9",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Wegen der Coronapandemie sind die Schweizer Schulen seit mehr als zwei Wochen zu – es findet kein Präsenzunterricht mehr statt, sondern die Schülerinnen und Schüler lernen zu Hause.“"
                            },
                            {
                                "example_id": "55b95642-474c-4b94-815c-b42597179e38",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Am Wochenende wurde demonstriert. In Bayern ist das wegen der Coronapandemie strikt verboten.“"
                            },
                            {
                                "example_id": "82aa468f-0d22-49c7-8567-fe453a1d71a8",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Jetzt aber betet der Imam der türkisch-islamischen Gemeinde ganz alleine. […] Versammlungen sind wegen der Coronapandemie verboten, auch Muslime müssen jetzt zu Hause beten.“"
                            },
                            {
                                "example_id": "0bd1fe92-2799-494a-8fec-dc28dd6129e0",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Auf der ganzen Welt setzen Regierungen im Kampf gegen die Coronapandemie auf Handyüberwachung.“"
                            },
                            {
                                "example_id": "f0e22a97-f832-4b4a-9621-f6b74aa29544",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„[…] seit dem Ausbruch der Coronapandemie war er [Anmerkung: der Sonntagsspaziergang] eine gute Möglichkeit, der Enge der heimischen vier Wände zu entfliehen, ohne sich dabei allzu vielen Viren auszusetzen.“"
                            },
                            {
                                "example_id": "1b04fdf1-5f83-4dcd-aca1-2eb3bc9d3c4b",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Der renommierte Virologe Christian Drosten, der in der Coronapandemie die Bundesregierung berät, erhält nach eigenen Angaben Morddrohungen.“"
                            },
                            {
                                "example_id": "fe7a60f4-8f64-4225-beef-57c0bdf80471",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Der Unterschied im Umgang mit der Coronapandemie im Vergleich zu China bestehe darin, dass die deutsche Regierung ihren Bürgerinnen und Bürger vertraue, sagte Historikerin Ute Frevert im Dlf.“"
                            },
                            {
                                "example_id": "3b5ceb15-6666-4ac2-af4b-744b2c26f2a5",
                                "sense_id": "e4197d16-6d51-332f-854c-8330e1bc9ecc",
                                "text": "„Gerade in Zeiten der Coronapandemie dürften die USA und der Iran - beide registrieren zahlreiche Infektionen - an einer Konfrontation kein Interesse haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
