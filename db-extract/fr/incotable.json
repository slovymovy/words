                        "sense_id": "2cbaf1c4-2c3f-3c9f-b2d5-491d24dec25c",
                        "entry_id": "c1b2737c-b522-3dfa-8ae0-7c8a33ad8747",
                        "glosses": [
                            "Qui échappe à toute cotation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c403e0-91e9-46f2-a344-8e0e053a0f31",
                                "sense_id": "2cbaf1c4-2c3f-3c9f-b2d5-491d24dec25c",
                                "text": "Un ensemble d’observations permet de coter les manifestations présentées par le patient et de prescrire la chimie qui lui sera utile pour réduire le symptôme. … Est-ce que cela représente un grand progrès, notamment lorsque le patient se plaindra de souffrir de symptômes d’une façon incotable ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b9a6cae-9388-3813-ac02-3c5f957875ea",
                        "entry_id": "c1b2737c-b522-3dfa-8ae0-7c8a33ad8747",
                        "glosses": [
                            "Qualifie une valeur qui ne peut pas être cotée faute de vendeur, d’acheteur ou de prix d’équilibre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc56045-7247-4f90-a034-81eea9b81827",
                                "sense_id": "5b9a6cae-9388-3813-ac02-3c5f957875ea",
                                "text": "On peut regretter que, sur les trois cents entreprises françaises introduites au second marché de 1984 à 1990, trente fussent suspendues de cotation en 1991 pour cause de difficultés financières et que le même nombre fût presque en permanence incotable."
                            },
                            {
                                "example_id": "f3e9750b-539f-4633-a350-dc08afe3552c",
                                "sense_id": "5b9a6cae-9388-3813-ac02-3c5f957875ea",
                                "text": "Alstom chute de 37% en bourse de Paris après avoir été incotable à la baisse pendant quelques minutes, de retour au plus bas depuis 2005 à moins de 14 euros ce jeudi, à 13,39 euros."
                            },
                            {
                                "example_id": "9d458570-ea4e-4b9b-820d-585a66b752e2",
                                "sense_id": "5b9a6cae-9388-3813-ac02-3c5f957875ea",
                                "text": "L’action du groupe de solutions de paiement a été incotable en ouverture et perd maintenant la moitié de sa valeur."
                            }
                        ]
                    }
