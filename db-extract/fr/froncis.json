                            {
                                "example_id": "415a2777-ddde-4398-856f-a53a3bd8fe7b",
                                "sense_id": "3641139a-cc7a-3288-9e98-473d4d627ee3",
                                "text": "Le froncis (fronçure) consiste en petits plis menus et serrés que l'on forme sur l'aiguille avec le point devant; il doit être aussi menu que l'étoffe le comporte; on l'emploie pour poser les cols, poignets, manches, etc."
                            }
                        ]
                    },
