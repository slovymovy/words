{
    "word_family": [
        "irresponsabilité",
        "irresponsablement",
        "responsable",
        "responsabilité",
        "responsabiliser",
        "responsabilisation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae7aa8f9-05bc-3cdf-890e-05f42e13b851",
                    "sense_definition": "Qui n'assume pas ses responsabilités ou qui agit de manière inconsidérée sans mesurer les conséquences de ses actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defaut_de_responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Conduire à une telle vitesse sur une route verglacée est un comportement totalement <w>irresponsable</w>."
                        },
                        {
                            "text": "Ses parents lui reprochent souvent d'être trop <w>irresponsable</w> avec son argent de poche."
                        }
                    ],
                    "synonyms": [
                        "inconscient",
                        "immature",
                        "imprudent"
                    ],
                    "antonyms": [
                        "responsable"
                    ],
                    "common_phrases": [
                        "comportement irresponsable",
                        "attitude irresponsable",
                        "acte irresponsable"
                    ]
                },
                {
                    "sense_id": "cab55dcb-35ec-3a15-bd81-91c90eb9ca82",
                    "sense_definition": "Qui n'a pas à répondre de ses actes devant une autorité ou la justice en raison de son statut ou d'une altération de son discernement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statut_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'expertise psychiatrique a conclu que l'accusé était pénalement <w>irresponsable</w> au moment des faits."
                        },
                        {
                            "text": "Dans certaines monarchies constitutionnelles, le souverain est politiquement <w>irresponsable</w> de ses décisions officielles."
                        }
                    ],
                    "synonyms": [
                        "inimputable",
                        "exonéré"
                    ],
                    "antonyms": [
                        "responsable"
                    ],
                    "common_phrases": [
                        "pénalement irresponsable",
                        "politiquement irresponsable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffdfec1f-89f4-3804-ab4f-d7651ba82bfd",
                    "sense_definition": "Personne qui n'assume pas ses responsabilités ou qui cause du tort à autrui sans s'en inquiéter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defaut_de_responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet a été ruiné par une bande d'<w>irresponsables</w> qui refusaient d'admettre leurs fautes."
                        },
                        {
                            "text": "Il refuse de laisser son entreprise entre les mains d'un <w>irresponsable</w>."
                        }
                    ],
                    "synonyms": [
                        "inconscient"
                    ],
                    "antonyms": [
                        "responsable"
                    ],
                    "common_phrases": [
                        "bande d'irresponsables"
                    ]
                },
                {
                    "sense_id": "27801f74-3324-35d5-9ccf-695218c19e6a",
                    "sense_definition": "Personne qui ne peut être tenue juridiquement pour responsable de ses actes en raison d'un trouble mental.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statut_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé de faire interner cet <w>irresponsable</w> dans un établissement spécialisé."
                        },
                        {
                            "text": "La justice ne peut pas infliger une peine classique à un <w>irresponsable</w> privé de discernement."
                        }
                    ],
                    "synonyms": [
                        "inimputable"
                    ],
                    "antonyms": [
                        "responsable"
                    ]
                }
            ]
        }
    ]
}