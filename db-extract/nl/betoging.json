                    },
                    {
                        "form_id": "694db00d-985e-4932-bff6-85c9e9ca508d",
                        "entry_id": "4298739f-0c49-3930-a286-e34a0e50836c",
                        "tags": [],
                        "form": "betoghing, betooging",
                        "note": "verouderde schrijfwijzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                        "entry_id": "4298739f-0c49-3930-a286-e34a0e50836c",
                        "glosses": [
                            "openbare samenkomst van velen met als doel een steunbetuiging of protest te laten horen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513fc723-4df4-4e05-b704-fe9718049a36",
                                "sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                                "text": "Het was de grootste anti-regeringsdemonstratie van de laatste jaren. Jongeren hadden tot de betoging opgeroepen nadat de regering-Bouterse de benzineprijzen vorige week had verhoogd."
                            },
                            {
                                "example_id": "09a8ddfc-3e33-4c43-a72f-de59f4434e0f",
                                "sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                                "text": "⧖ Men zong de Marseillaise en de oude revolutionnaire voorstad scheen te trillen, bij het hooren van dat lied. Er verscheen licht aan de vensters, de deuren werden geopend, de straten werden levendig. Sterke detachementen policie stelden een einde aan die betooging."
                            },
                            {
                                "example_id": "83b6c522-d50b-4eb5-bce2-3142a881a8f4",
                                "sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                                "text": "⧖ De vergadering had plaats, in het lokaal van de Cornet, in de fabriekstraat, en is in alle opzigten waardig geweest de gewigtige betooging, waarvan zij schijnt de voorbode te zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "815cc433-e9d7-3aa2-84cb-5c991bbb5cfa",
                        "entry_id": "4298739f-0c49-3930-a286-e34a0e50836c",
                        "glosses": [
                            "presentatie van feiten en argumenten voor een bepaalde opvatting"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bcddca43-d055-40b5-a2a0-f21eaeae20b1",
                                "sense_id": "815cc433-e9d7-3aa2-84cb-5c991bbb5cfa",
                                "text": "De algebra of stelkunde, bevattende de ontbinding der vergelijkingen of eveningen van de twee eerste graden; die der onbepaalde vergelijkingen van den eersten graad; de algemeene zamenstelllngen der vergelijkingen; de betoging der formule van de tweevoudige grootheid of het binoma van Newton, alleen in geval de geheel positive exponenten plaats grijpen"
                            },
                            {
                                "example_id": "982475f1-0c37-4e3c-bf2d-645a6ca85b7a",
                                "sense_id": "815cc433-e9d7-3aa2-84cb-5c991bbb5cfa",
                                "text": "⧖ Betoghing van persoon\nt'zy vroom of snode mensch\nHeeft meer als ander zaken Voorreden na wensch\n(…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaece62e-6ac2-4036-825f-068a1a5c05f4",
                        "source_entry_id": "4298739f-0c49-3930-a286-e34a0e50836c",
                        "source_sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                        "source_sense_description": "een samenkomst van velen, meestal op straat, met als doel een protest te laten horen",
                        "target_lang_word": "demonstration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonstration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7b4eb40-e59e-3a9b-aa2e-b0c144a82647",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "The act of demonstrating; showing or explaining something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0019bf12-0b96-4547-914f-994b2e43f005",
                                                "sense_id": "a7b4eb40-e59e-3a9b-aa2e-b0c144a82647",
                                                "text": "[VV]e are able with playne demonſtration to proue, and vvith reaſon to perſvvade that in tymes paſt our fayth vvas alike, that then vve preached thinges correſpondent vnto the forme of faith already published of vs, ſo that none in this behalfe can repyne or gaynesay vs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07431c6-9764-3b53-aa12-bfa47f674ed9",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "The act of demonstrating; showing or explaining something.",
                                            "A prisoner's act of beating up another prisoner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2553862d-3124-3b01-8a1f-2a91994e72d3",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "An event at which something will be demonstrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb96d71b-c0d5-4da3-ad9c-1ac478f25606",
                                                "sense_id": "2553862d-3124-3b01-8a1f-2a91994e72d3",
                                                "text": "I have to give a demonstration to the class tomorrow, and I'm ill-prepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f95a499-fe9f-3e58-876a-11aee79f760c",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "Expression of one's feelings by outward signs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A public display of group opinion, such as a protest march."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72fb1ea2-9146-4aa6-a9e6-84206d82f517",
                                                "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                                "text": "It's produced tremendous activism and backlash: there's been all sorts of demonstrations and mobilizations in civil society, there's been examples from the people from the Administration being heckled in a restaurant or not served in a restaurant, there's been a growing crescendo of conversation about what that means."
                                            },
                                            {
                                                "example_id": "83effb98-2fad-46fd-9f8c-030f3a93bda0",
                                                "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                                "text": "Even when there had been hecklers, Victor and other members would focus on setting up their demonstration — signs reading “Let them go now,” and posters bearing the faces of 58 hostages still being held in Gaza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c57b219-81cc-3bfc-9e30-04fcd9ff64a6",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A show of military force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A proof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8015bac5-c6d6-461b-aec2-4d52e17fc540",
                                                "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                                "text": "He read the proposition. […] So he reads the demonstration of it, which referred him back to such a proposition,; which proposition he read."
                                            },
                                            {
                                                "example_id": "6fea832a-0cc0-42ad-9efd-0b0f9369a1e3",
                                                "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                                "text": "If, then, proof from the basic truth is more accurate than proof not so derived, demonstration which depends more closely on it is more accurate than demonstration which is less closely dependent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56a4fc36-d180-4e9d-b6e4-609ee8898194",
                        "source_entry_id": "4298739f-0c49-3930-a286-e34a0e50836c",
                        "source_sense_id": "31504d39-b371-37e6-93da-4bf298cf2f70",
                        "source_sense_description": "een samenkomst van velen, meestal op straat, met als doel een protest te laten horen",
                        "target_lang_word": "manifestation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0be79603-3b88-37bf-86e5-4acfa45c9505",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Action de rendre perceptible, de faire connaître ce qui est caché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08116f12-4bc2-465e-8095-5d64a69a73b3",
                                                "sense_id": "0be79603-3b88-37bf-86e5-4acfa45c9505",
                                                "text": "Bois-Guilbert fit un effort sur lui-même pour cacher le mépris et l’indignation qui l’animaient, et dont il sentait que la manifestation n’aurait pu que lui être nuisible."
                                            },
                                            {
                                                "example_id": "1f54e76d-3ecc-493e-bec4-3efb3e909ed1",
                                                "sense_id": "0be79603-3b88-37bf-86e5-4acfa45c9505",
                                                "text": "L’armée est la manifestation la plus claire, la plus tangible et la plus solidement rattachée aux origines que l’on puisse avoir de l’État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6245c40-2cc8-370c-a335-89dacfb97ba9",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Ce qui rend apparente, perceptible l'existence de quelque chose. S'emploie principalement pour la maladie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9758581-75be-474a-a10a-f708535bbfb8",
                                                "sense_id": "c6245c40-2cc8-370c-a335-89dacfb97ba9",
                                                "text": "A Singapour, en 1967, au moment même où la chute de la fécondité atteint sa vitesse maximale, se déclenche une épidemie de Koro, manifestation hystérique spécifiquement masculine. Les individus touchés craignent et perçoivent une rétraction de leur pénis, qui menace, disent-ils, de disparaître dans l'abdomen."
                                            },
                                            {
                                                "example_id": "e59d1985-d53b-468c-8434-72804220b313",
                                                "sense_id": "c6245c40-2cc8-370c-a335-89dacfb97ba9",
                                                "text": "La première conséquence est la possibilité d'un flush facial qui correspond à une vasodilatation apparaissant après une infiltration locale ; cette manifestation disparaît toujours rapidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde4bad2-deab-313f-a485-1d2400a164d8",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Représentation publique ostentatoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca50c16-5c3c-4492-97f8-150bf8863237",
                                                "sense_id": "bde4bad2-deab-313f-a485-1d2400a164d8",
                                                "text": "Les funérailles religieuses du maréchal de Mac-Mahon ont eu le caractère d'une imposante et solennelle manifestation. Elles offraient un consolant contraste avec les apothéoses purement laïques dont Paris a été déshonoré, durant ces dernières années."
                                            },
                                            {
                                                "example_id": "93d0af7a-9421-4b28-9a68-218d97580b9e",
                                                "sense_id": "bde4bad2-deab-313f-a485-1d2400a164d8",
                                                "text": "En aval de la mosquée, un troupeau de prostituées, commandées de service par le pacha, nous salua de grêles you-yous destinés à nous donner l’illusion d’une manifestation spontanée des femmes de Fez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7717bc-b5f0-3e47-9802-8c76122850ad",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Rassemblement ou mouvement ayant pour objet de rendre publiques les revendications d’un groupe, d’un parti."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63927e1-e05e-4652-86c6-6b69fe273158",
                                                "sense_id": "3d7717bc-b5f0-3e47-9802-8c76122850ad",
                                                "text": "Ils organisèrent des manifestations tapageuses dégénérant souvent en pugilats, contre des universitaires ou des dramaturges juifs."
                                            },
                                            {
                                                "example_id": "23b3f8cc-38ad-46e6-8fc4-fa37c8e90548",
                                                "sense_id": "3d7717bc-b5f0-3e47-9802-8c76122850ad",
                                                "text": "La fête des Mères fut encore, en ce printemps 1941, une des grandes manifestations de la France maréchaliste, à Montluçon comme ailleurs."
                                            },
                                            {
                                                "example_id": "fb67041f-2720-47da-8a16-ef652fa9996b",
                                                "sense_id": "3d7717bc-b5f0-3e47-9802-8c76122850ad",
                                                "text": "Cette manifestation pacifique se termina par une intervention de la police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7779fd1f-d4d3-38d1-b49a-5c39c5903835",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Rassemblement de personnes pour des festivités ou des activités professionnelles ou commerciales."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcdd5e10-c93e-48c0-a052-8ddbf999d0fc",
                                                "sense_id": "7779fd1f-d4d3-38d1-b49a-5c39c5903835",
                                                "text": "Certaines communes, écrivait le préfet, à l'occasion des fêtes patronales, ou de manifestations agricoles, ont, à leur programme de réjouissances, des concours de buveurs de cidre ou autres boissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77b4161-d133-3cf4-96dc-7f3c0d43a5e9",
                                        "entry_id": "721c29ed-dd5f-336f-b430-f8336bb47b34",
                                        "glosses": [
                                            "Monde tangible, création, par opposition au monde invisible et éternel."
                                        ],
                                        "tags": [
                                            "Religions orientales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fff4ff4-6415-4695-91c7-16d13aad2f4b",
                                                "sense_id": "c77b4161-d133-3cf4-96dc-7f3c0d43a5e9",
                                                "text": "En agissant ainsi, l’homme ne tente rien d’anormal ou antinaturel. Il s’insère seulement de mieux en mieux, ou de moins en moins mal, dans la manifestation universelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
