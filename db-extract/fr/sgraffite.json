                                    {
                                        "sense_id": "7fa56935-35df-3e1b-95e5-8865d2e978d5",
                                        "entry_id": "14134f53-30ea-3065-b604-9188aee256c3",
                                        "glosses": [
                                            "The act or sound of something being scratched."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "213418be-fe1b-49af-acbf-7e86e15768f1",
                                                "sense_id": "7fa56935-35df-3e1b-95e5-8865d2e978d5",
                                                "text": "We heard further scratchings at the door as the dog whined to be let in."
                                            },
                                            {
                                                "example_id": "843d7b47-23b1-40e9-8f34-24524c76470d",
                                                "sense_id": "7fa56935-35df-3e1b-95e5-8865d2e978d5",
                                                "text": "It was early on the fifteenth day that I heard a curious familiar sequence of sounds in the kitchen, and, listening, identified it as the snuffing and scratching of a dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be073e17-89ac-3941-a5df-63b074f56115",
                                        "entry_id": "14134f53-30ea-3065-b604-9188aee256c3",
                                        "glosses": [
                                            "A pork scratching."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e23dff5d-59cf-461b-9f78-6fda06e906b1",
                                                "sense_id": "be073e17-89ac-3941-a5df-63b074f56115",
                                                "text": "'Ugggghhhhh!' she made a face at the packet. 'Oink, oink!' Cosmo laughed, waving a scratching near her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b797fa49-d92d-30f9-ab44-748f48e5aab4",
                                        "entry_id": "14134f53-30ea-3065-b604-9188aee256c3",
                                        "glosses": [
                                            "Record scratching, a technique of starting and stopping a vinyl record from playing to produce music in hip hop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fb58bb1-ff27-38f4-b118-2c398bafe461",
                                        "entry_id": "14134f53-30ea-3065-b604-9188aee256c3",
                                        "glosses": [
                                            "A piece of deep-fried batter left over from frying fish, sometimes sold with chips."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6341fee4-547a-415e-a173-b2ea358a6f73",
                                                "sense_id": "9fb58bb1-ff27-38f4-b118-2c398bafe461",
                                                "text": "We all had a portion of chips and one fish was shared between all of us. Sometimes the lady serving would give us a free bag of scratchings (the bits of batter)."
                                            },
                                            {
                                                "example_id": "be76856d-44a7-4d9a-9369-2a7b79fcb8f0",
                                                "sense_id": "9fb58bb1-ff27-38f4-b118-2c398bafe461",
                                                "text": "The crispy bits of batter and small crispy chips that were left at the end of the night were given away to whoever needed them. If he could, Cesidio would throw in a free 'haddie' or a haggis with the scratchings, offering a helping hand discreetly, with no thanks asked for."
                                            },
                                            {
                                                "example_id": "c04baa2f-bee4-4e2c-88d5-ea20aa3ba185",
                                                "sense_id": "9fb58bb1-ff27-38f4-b118-2c398bafe461",
                                                "text": "The best thing is, you pay for the chips and you get the pea wet and scratchings for free. It's lovely. You should try it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
