{
    "word_family": [
        "emission",
        "emit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c4630cf-6656-3976-83b9-3c77946cb80d",
                    "sense_definition": "An agent sent on a mission to represent the interests of someone else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "representative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president sent a special <w>emissary</w> to negotiate the peace treaty.",
                            "target_lang_translations": {
                                "ru": "Президент направил специального <w>эмиссара</w> для ведения переговоров о мирном договоре."
                            }
                        },
                        {
                            "text": "She acted as a diplomatic <w>emissary</w> between the two rival nations.",
                            "target_lang_translations": {
                                "ru": "Она выступала в роли дипломатического <w>посланника</w> между двумя соперничающими государствами."
                            }
                        }
                    ],
                    "synonyms": [
                        "envoy",
                        "messenger",
                        "representative",
                        "delegate"
                    ],
                    "common_phrases": [
                        "special emissary",
                        "diplomatic emissary",
                        "peace emissary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агент или представитель, направленный с миссией для представления интересов другого лица или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмиссар",
                                "target_lang_sense_clarification": "политический или секретный представитель"
                            },
                            {
                                "target_lang_word": "посланник",
                                "target_lang_sense_clarification": "лицо, направленное с поручением"
                            },
                            {
                                "target_lang_word": "представитель",
                                "target_lang_sense_clarification": "лицо, действующее от имени кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72aafcd7-b174-39f2-abab-41d9b8b487c5",
                    "sense_definition": "A venous channel in the skull that connects the intracranial venous sinuses with the veins outside the skull.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully avoided damaging the <w>emissary</w> veins during the craniotomy.",
                            "target_lang_translations": {
                                "ru": "Хирург тщательно избегал повреждения <w>эмиссарных</w> вен во время трепанации черепа."
                            }
                        },
                        {
                            "text": "An infection could potentially spread to the brain through an <w>emissary</w> pathway.",
                            "target_lang_translations": {
                                "ru": "Инфекция потенциально может распространиться в мозг через <w>эмиссарный</w> путь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emissary vein"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Венозный канал в черепе, соединяющий внутричерепные синусы с венами на наружной поверхности черепа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмиссарная вена",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "эмиссарий",
                                "target_lang_sense_clarification": "анатомический выпускник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96ffa05-8524-362d-bcda-63dd71d0c853",
                    "sense_definition": "An underground channel or outlet by which the water of a lake escapes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient lake was drained through a subterranean <w>emissary</w> carved into the rock.",
                            "target_lang_translations": {
                                "ru": "Древнее озеро было осушено через подземный <w>водоспуск</w>, высеченный в скале."
                            }
                        },
                        {
                            "text": "Geologists mapped the natural <w>emissary</w> that regulated the water level of the basin.",
                            "target_lang_translations": {
                                "ru": "Геологи нанесли на карту естественный <w>сток</w>, который регулировал уровень воды в бассейне."
                            }
                        }
                    ],
                    "synonyms": [
                        "outlet",
                        "channel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземный канал или сток, через который вытекает вода из озера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водоспуск",
                                "target_lang_sense_clarification": "канал для отвода воды"
                            },
                            {
                                "target_lang_word": "эмиссарий",
                                "target_lang_sense_clarification": "естественный или искусственный подземный сток"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}