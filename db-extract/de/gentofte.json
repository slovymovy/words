                    {
                        "sense_id": "be31b533-5d1b-3ab6-ad6b-28e343b75ed6",
                        "entry_id": "f5dbf97d-5db6-3d26-905d-245bf0a86b2e",
                        "glosses": [
                            "Gemeinde auf Seeland nordlich von Kopenhagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f46acce-17da-4c7c-812b-85d250ed777b",
                                "sense_id": "be31b533-5d1b-3ab6-ad6b-28e343b75ed6",
                                "text": "„So erwarb der dänische Royal die Villa im Jahr 2014 für etwas mehr als 4,5 Millionen Euro. […] Seither hat sich der Quadratmeterpreis in der Gemeinde Gentofte von 4.567 Euro im Jahr 2014 auf 8.863 Euro im Jahr 2022 nahezu verdoppelt.“"
                            },
                            {
                                "example_id": "14ca8db3-efe3-4390-8e13-643543891ba4",
                                "sense_id": "be31b533-5d1b-3ab6-ad6b-28e343b75ed6",
                                "text": "„ Der 38 Jahre alte Jogger war getroffen worden, als er beim Morgenlauf den Eingang des Bernstorff Parks im Vorort Gentofte passieren wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
