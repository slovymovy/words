                                "target_lang_word": "Hoeba",
                                "target_lang_sense_clarification": "achternaam"
                            },
                            {
                                "target_lang_word": "Guba",
                                "target_lang_sense_clarification": "achternaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
