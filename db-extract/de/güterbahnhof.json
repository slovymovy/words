                ],
                "senses": [
                    {
                        "sense_id": "4c16f7c8-b7c4-3d40-ac83-31b8282cab56",
                        "entry_id": "b5bb7112-dc6b-38c3-86fb-7d0d9d3d65c9",
                        "glosses": [
                            "Bahnhof/Bahnhofsbereich für den Güterverkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1441f7ef-b802-42e1-8cdc-81a261de6b89",
                                "sense_id": "4c16f7c8-b7c4-3d40-ac83-31b8282cab56",
                                "text": "„Der Güterbahnhof stand voller Züge, die alle nach Osten abgefertigt waren.“"
                            },
                            {
                                "example_id": "5b79507f-2a8e-49d9-b2d4-b534e888506b",
                                "sense_id": "4c16f7c8-b7c4-3d40-ac83-31b8282cab56",
                                "text": "„Sie erinnerte sich, wie erleichtert sie gewesen war, weil der Himmel über dem Viertel, wo sie wohnte, so dunkel war, wie er nur sein konnte; unter ihm flogen rötliche und sandgraue Wolken dahin, die aus den Feuern im Güterbahnhof aufgestiegen waren.“"
                            },
                            {
                                "example_id": "d5b635a9-a9e2-4188-98ec-58c59cb9677c",
                                "sense_id": "4c16f7c8-b7c4-3d40-ac83-31b8282cab56",
                                "text": "„Auf den Kölner Güterbahnhöfen verschwanden in jenem Winter täglich neunhundert Tonnen Kohle, die eigentlich für das Ausland bestimmt waren.“"
                            },
                            {
                                "example_id": "1ac26d1a-7563-4653-a833-c1c9be75d308",
                                "sense_id": "4c16f7c8-b7c4-3d40-ac83-31b8282cab56",
                                "text": "„Es gab einen Güterbahnhof und eine Heeresmunitionsanstalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
