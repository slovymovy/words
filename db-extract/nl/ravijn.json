                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                        "entry_id": "747d877e-c8ad-3064-ac8d-c2cb0f727a36",
                        "glosses": [
                            "een diepe, steile insnijding in een terrein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45cd64e7-3a94-4bf3-8670-fbcbd4abd077",
                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                "text": "Pas op dat je niet in het ravijn valt!"
                            },
                            {
                                "example_id": "a731742e-d11d-4c32-b659-9784c9c95a90",
                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                "text": "Ze besloten zich vanaf een plateau in een meertje te storten. In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                            },
                            {
                                "example_id": "afea71d7-4db4-4812-98b1-17525250c810",
                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                "text": "Toen we vijf dagen later op een ochtend achter elkaar op een smalle richel langs een ravijn liepen, stopte ze opeens zo abrupt dat ik tegen haar op botste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "140afd89-c369-47b2-a868-27bfedfcd1bd",
                        "source_entry_id": "747d877e-c8ad-3064-ac8d-c2cb0f727a36",
                        "source_sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                        "source_sense_description": "een diepe, steile insnijding in een terrein",
                        "target_lang_word": "Schlucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                        "entry_id": "54067c65-9ddc-313a-88a7-83d82756e18a",
                                        "glosses": [
                                            "enger und steiler Einschnitt in ein Tal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61df12fc-cbe7-46a4-8356-9305aba80d00",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "Der Grand Canyon ist eine bekannte Schlucht im Norden Arizonas."
                                            },
                                            {
                                                "example_id": "8943e53f-206a-485f-b279-a397da50b356",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Ende des 19. Jahrhunderts hatte ein geschäftstüchtiger Kopf die Idee, im oberen Teil der Schlucht Dämme zu errichten und das kostbare Nass zu speichern.“"
                                            },
                                            {
                                                "example_id": "3d4433ef-b521-49a2-8998-d2af9220c518",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Unten war eine Schlucht mit ebener Sohle, die nach rechts vorn führte.“"
                                            },
                                            {
                                                "example_id": "c7cac071-8fce-4c84-ba11-f8bb3dc66227",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Canyoning ist ein Extremsport, bei dem man dem Lauf des Wassers durch Schluchten folgt.“"
                                            },
                                            {
                                                "example_id": "f97bbfb8-d6f1-4ddd-ac16-cd295f7e78e4",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Hinter unserer Stellung zog sich eine steile und tiefe Schlucht hin, die für die Artillerie und Kavallerie einen Rückzug beträchtlich erschweren musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0498c0ed-6079-47c2-918d-8024074fca1f",
                        "source_entry_id": "747d877e-c8ad-3064-ac8d-c2cb0f727a36",
                        "source_sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                        "source_sense_description": "een diepe, steile insnijding in een terrein",
                        "target_lang_word": "ravine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                        "entry_id": "cf75c4b7-21b0-3681-ae3b-07b06a3d506c",
                                        "glosses": [
                                            "A deep narrow valley or gorge in the earth's surface worn by running water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d0846a-5f03-473b-b212-76880998285d",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "Sometimes the earth stretched up towards them with peaks of mountains, sometimes it fell away in steep ravines, blue rivers sang to them as they passed above them, or very faintly came the song of breezes in lone orchards, and far away the sea sang mighty dirges of old forsaken isles."
                                            },
                                            {
                                                "example_id": "d556ae9e-f103-43f3-858e-cf254253d470",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "He fell into a reverie, a most dangerous state of mind for a chauffeur, since a fall into reverie on the part of a driver may mean a fall into a ravine on the part of the machine."
                                            },
                                            {
                                                "example_id": "5392f75c-ef1c-45e1-9f54-e905ed3ba51b",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "Thirty feet below her, where the Persians were crashing through the brush, the streambed kinked to the left side of the ravine and ran under an enormous thorn tree with a thick base."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ravine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4073deaf-8315-39d7-9d59-cfacd35fd714",
                                        "entry_id": "9b1a51e7-6dda-31a6-b10a-6bd91d090400",
                                        "glosses": [
                                            "Alternative form of raven (“rapine, rapacity; prey, plunder”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427c3fa6-ab2a-4141-905e-9664f695c2db",
                                                "sense_id": "4073deaf-8315-39d7-9d59-cfacd35fd714",
                                                "text": "And he, shall he,\nMan, her last work, who seem’d so fair, […]\nWho trusted God was love indeed\nAnd love Creation’s final law—\nTho’ Nature, red in tooth and claw\nWith ravine, shriek’d against his creed—\nWho loved, who suffer’d countless ills,\nWho battled for the True, the Just,\nBe blown about the desert dust,\nOr seal’d within the iron hills?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a13b938f-cdd4-490d-9d9e-f3b15098bbd4",
                        "source_entry_id": "747d877e-c8ad-3064-ac8d-c2cb0f727a36",
                        "source_sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                        "source_sense_description": "een diepe, steile insnijding in een terrein",
                        "target_lang_word": "précipice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précipice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                        "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                                        "glosses": [
                                            "Abîme, gouffre, cavité très profonde et très escarpée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8facbb77-1a36-4786-b3b7-32bb1f5a263a",
                                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                                "text": "Nous commençâmes à côtoyer la pente rapide du col, ayant à notre droite un précipice de cinq ou six cents pieds de profondeur, et au-delà de ce précipice une montagne à pic."
                                            },
                                            {
                                                "example_id": "c6abcdef-9c0a-485c-a404-9f25e4cebeac",
                                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                                "text": "Le capitaine et les quatre hommes […], avaient descendu la pente des rochers, au risque de se briser mille fois en tombant dans les précipices qui s’ouvraient sous leurs pieds."
                                            },
                                            {
                                                "example_id": "d5a45215-3db5-41a2-9c93-d607be025780",
                                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                                "text": "Le Drac ! s’était écrié l’abbé Gévresin, montrant, au fond du précipice, un serpent liquide qui rampait et se tordait, colossal, entre des rocs, ainsi qu’entre les crocs d’un gouffre."
                                            },
                                            {
                                                "example_id": "c453d353-bcee-4045-9503-5cb38ab79b54",
                                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                                "text": "La route est très belle maintenant ; mais toujours pas de parapet, et nos chevaux s’entêtent dans leur manie de trotter au ras du bord. — Il y a près de nous des précipices dont l’obscurité qui vient ne nous laisse déjà plus voir le fond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                        "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                                        "glosses": [
                                            "Grand malheur, disgrâce, catastrophe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eca3826-702f-476a-a4b5-ce82d5dd1262",
                                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                                "text": "Crise du système, crise bipolaire, crise nucléaire, c’est Cuba en 1962 qui plonge le monde dans l’angoisse nucléaire, au bord du précipice de la mort planétaire."
                                            },
                                            {
                                                "example_id": "4edd6fd5-9262-4478-a733-65c245c7c8b1",
                                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                                "text": "Le développement de la société occidentale était le triomphe de l’indépendance de l’homme et de sa puissance. Et voilà que soudain, au XXᵉ siècle, on a vu — avec quelle netteté ! — que cette société était fragile et bâtie sur des précipices."
                                            },
                                            {
                                                "example_id": "a852ac31-4386-41ac-ac91-1be6af21da09",
                                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                                "text": "Une vaine ambition l’a poussé jusqu’au bord du précipice."
                                            },
                                            {
                                                "example_id": "877b1542-9a24-41fc-ae63-6e4f6b61ac34",
                                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                                "text": "Il marche sur le bord du précipice ; s’il ne change pas de conduite, il est perdu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
