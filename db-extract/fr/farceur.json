                        ],
                        "form": "farceurs"
                    },
                    {
                        "form_id": "b774d64e-548f-4012-b58c-a7460f77b7e4",
                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "farceuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "glosses": [
                            "Celui qui aime à faire ou à dire des choses bouffonnes ou à jouer des tours plaisants aux gens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d30730-aae8-417e-8ed4-7edbec38d1ec",
                                "sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur […] qui lui branche la communication avec n’importe qui, n’importe quoi, se plaisant aux pires confusions, aux imbroglios les plus fâcheux, les plus déraisonnables."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e0dd54-f6eb-35e7-b210-9c02153ceb72",
                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "glosses": [
                            "Celui qui cherche à en faire accroire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4898c44f-321a-42f3-9eeb-9aeb81601b13",
                                "sense_id": "c5e0dd54-f6eb-35e7-b210-9c02153ceb72",
                                "text": "Je n’ai aucune confiance en lui, c’est un farceur."
                            }
                        ]
                    },
                    {
                        "sense_id": "56ed2535-2fbc-329f-a843-5a1477935865",
                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "glosses": [
                            "Comédien qui ne joue que dans les farces. Se dit encore par mépris d’un acteur qui charge un rôle comique."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "edfd206b-fe54-4cce-902e-4a6118f2bc55",
                                "sense_id": "56ed2535-2fbc-329f-a843-5a1477935865",
                                "text": "[…] la pauvre désolée ne trouvait plus rien qui l’égayât. En vain avait-on mandé des quatre coins du monde les plus fameux baladins, bateleurs, bouffons, turlupins, pîtres, grimaciers, grotesques et farceurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7665a258-7bc4-4205-8a9f-6145be0b48be",
                        "source_entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "source_sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                        "source_sense_description": "Celui qui aime faire ou dire des choses bouffonnes, ou jouer des tours aux gens",
                        "target_lang_word": "Schelm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schelm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2f1f83-6ca3-3321-9cae-aa80ac50d11a",
                                        "entry_id": "6a06d794-083b-30de-b2cd-e99f20fcd93c",
                                        "glosses": [
                                            "Mensch, der gerne scherzt und neckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf225d4-dd82-4587-b9b6-6a90f8786dab",
                                                "sense_id": "1d2f1f83-6ca3-3321-9cae-aa80ac50d11a",
                                                "text": "„Der Schelm ist, es sei geradeheraus gesagt, eine überaus unsympathische Figur, und seine Streiche können nur Leute lustig finden, die eine Neigung zum Fäkalhumor und zur Schadenfreude haben .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                        "entry_id": "6a06d794-083b-30de-b2cd-e99f20fcd93c",
                                        "glosses": [
                                            "durchtriebener, unehrlicher Mensch"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a331c6ad-c444-469a-a919-3854dbdffad0",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "Ein Schelm, wer Böses dabei denkt."
                                            },
                                            {
                                                "example_id": "1e8012c3-174b-4f22-b2e9-bbc6973deb00",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Auf groben Klotz ein grober Keil! Auf einen Schelmen anderthalbe!“"
                                            },
                                            {
                                                "example_id": "b75c370a-b0b2-4639-b757-caf2e7f24b9d",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Seine Vorliebe galt seit jeher den Schelmen und Lügenbolden, den Sonderlingen und Außenseitern, die sich eine eigene Welt erschufen.“"
                                            },
                                            {
                                                "example_id": "17d86345-8078-4fdc-9c6a-b41f88da713d",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Fast scheint es, ein Schelm stünde vor uns, der uns hinters Licht führen will.“"
                                            },
                                            {
                                                "example_id": "22d6f207-bbac-404f-a244-048ebaf61701",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Selbstverständlich geleitete sie am nächsten Tage den alten Schelm schon in aller Morgenfrühe durch das Hauptportal nach den inneren Gemächern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3efb52aa-dd55-4e85-9d5f-2e58dbc02be6",
                        "source_entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                        "source_sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                        "source_sense_description": "Celui qui aime faire ou dire des choses bouffonnes, ou jouer des tours aux gens",
                        "target_lang_word": "trickster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "Any of numerous figures featuring in various mythologies and folk traditions, who use guile and secret knowledge to challenge authority and play tricks and pranks on others with their acts of trickery; any similar figure in literature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0db848-dd87-488f-83eb-bcda2cffc841",
                                                "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                                "text": "1991, Alan R. Velie (compiler and editor), American Indian Literature: An Anthology, Revised edition, page 44,\nThe trickster is one of the oldest and most widespread of mythological and literary figures. […] As the name implies, the trickster is, on one level—probably the most important—an amoral practical joker who wanders about playing pranks on unsuspecting victims […] With all the fluctuations, certain things about the trickster are predictable: he is always a wanderer, always hungry, and usually oversexed.\nTricksters abound in folktales […] ."
                                            },
                                            {
                                                "example_id": "d5402db5-2d3d-4fae-a29c-69e48dceee01",
                                                "sense_id": "0fe26aff-c8f7-316d-b546-7431d45656b7",
                                                "text": "And let us begin with those sympathetic elements, the tricksters who obtain the lovers and the land, always at the expense of fools and knaves, sometimes at the expense of other tricksters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abda59b9-ea60-3f56-b579-db7568023a14",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "One who plays tricks or pranks on others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2391bf3b-5e94-48b4-9f20-3723ec36d263",
                                                "sense_id": "abda59b9-ea60-3f56-b579-db7568023a14",
                                                "text": "A skilled trickster knows how to outsmart their enemies with ease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbcf88d-8edd-3db0-9ac1-a2a95d21f253",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "One who performs tricks (parts of a magician act or entertainingly difficult physical actions)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9736423d-a44a-48ea-850e-a8475bd195a6",
                                                "sense_id": "cdbcf88d-8edd-3db0-9ac1-a2a95d21f253",
                                                "text": "Our fellow trickster will perform some impressive magic tricks tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c1f4dac-7fcb-3539-87ea-2e702caca85e",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "An impish or playful person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5c5b02b-d505-3a89-b829-689b8e451dc6",
                                        "entry_id": "0816aa5a-68d2-3240-be3b-d58aeeab5565",
                                        "glosses": [
                                            "A fraud or cheat (person who performs a trick or hoax full of falsehoods for the purpose of unlawful gain)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3168273-a0cd-47cb-943e-e0efc45a05b3",
                                                "sense_id": "a5c5b02b-d505-3a89-b829-689b8e451dc6",
                                                "text": "That shady trickster faked being a psychic advisor to spread misinformation and gain profit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trickster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7402ce47-5451-3c82-8fc7-b14d88504327",
                                        "entry_id": "2c85fba3-cb16-35d0-b8df-0b0e3d381034",
                                        "glosses": [
                                            "To engage in the antics of a trickster; to play tricks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
