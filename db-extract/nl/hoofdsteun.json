                        "examples": [
                            {
                                "example_id": "35b5d7a2-44e8-44a5-989d-6d4d10c7f56a",
                                "sense_id": "d49367d8-f3f9-33da-bca3-5891d49fefb3",
                                "text": "De hoofdsteun in een auto dient vooral ter bescherming van de nek de reiziger."
                            },
                            {
                                "example_id": "6de14114-6187-4aa3-8f9d-7be7a46199e5",
                                "sense_id": "d49367d8-f3f9-33da-bca3-5891d49fefb3",
                                "text": "„Goeiemorgen mensennn, ik ben Peter jullie buschauffeur”, galmt het door de boxen van de touringcar. Binnen is het warm en ruikt het nieuw. De hoofdsteunen hebben leren omhulsels en er is veel beenruimte."
                            }
                        ]
                    }
