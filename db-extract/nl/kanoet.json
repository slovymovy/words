                    {
                        "sense_id": "c136d181-93dc-358b-b4ec-8e28e98ddb4f",
                        "entry_id": "36c38315-fad7-363f-a57f-bf0cbe63af4e",
                        "glosses": [
                            "Calidris canutus middelgrote strandloper"
                        ],
                        "tags": [
                            "steltloperachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "6bb707c4-2844-4b01-9c79-2a80b8eea11d",
                                "sense_id": "c136d181-93dc-358b-b4ec-8e28e98ddb4f",
                                "text": "Van Gils onderzocht zelf de kanoet: een grote strandlopersoort die onder meer in de Waddenzee leeft. De populatie kanoets neemt sterk af en dat heeft er volgens hem mee te maken dat de dieren krimpen door klimaatverandering. Kleinere dieren hebben kleinere overlevingskansen, stelt Van Gils."
                            },
                            {
                                "example_id": "3fc96d32-ae8a-4f9d-a95c-ba2b70ef86cf",
                                "sense_id": "c136d181-93dc-358b-b4ec-8e28e98ddb4f",
                                "text": "Als zoutwinbedrijf Frisia Zout BV toestemming krijgt om zout te gaan winnen uit de Waddenzee, zal op den duur een kwart van het totale aantal kanoeten verdwijnen."
                            }
                        ]
                    }
