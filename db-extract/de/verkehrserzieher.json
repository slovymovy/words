                ],
                "senses": [
                    {
                        "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                        "entry_id": "19badc92-f551-30a5-b98f-c1a3b7df14d4",
                        "glosses": [
                            "Person, die beruflich mit Kindern und Jugendlichen praktische Verkehrserziehung betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0365752-93f5-48c0-b165-03a3e5441e3f",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„Es sollte Verkehrserziehern zu denken geben, dass sich beinahe nur noch im Regelverstoß die Bedürfnisse dynamischer kindlicher Persönlichkeiten nach Erproben ihrer Kräfte, ihres Mutes, ihrer Phantasie, ihrer Wettkampflust, nach eigenbestimmtem Denken und Handeln realisieren lassen.“"
                            },
                            {
                                "example_id": "3f9bb00c-03d7-4f81-a329-5fbd09230c2b",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„Sie reagieren auf Hinweise der Verkehrserzieher, die von motorischen Schwächen bei Dritt- und Viertklässlern berichten.“"
                            },
                            {
                                "example_id": "933ff765-c834-4035-b9a9-427738cf21cb",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„Von nun an können Verkehrserzieher der Polizei täglich Schulkinder der dritten und vierten Klasse auf der rund 3600 Quadratmeter großen Fläche unterrichten.“"
                            },
                            {
                                "example_id": "0a6b0747-df45-4dd8-a63d-c99f1a20c055",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„58 hauptamtliche Verkehrserzieher der Polizei, die in jedem Monat vor allem in Schulen ihre Aufklärungsarbeit betreiben, sollen schwerpunktmäßig eingesetzt werden, um dem Kraftfahrer den Sicherheitsgurt schmackhaft zu machen.“"
                            },
                            {
                                "example_id": "c12aa8db-684d-4db7-a285-7b109e18b4f0",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„Neben den professionellen Verkehrserziehern meldeten sich auch die Pfarrer zu Wort.“"
                            },
                            {
                                "example_id": "b7e3faaf-2032-4549-a35a-6b47c67f120c",
                                "sense_id": "6c60c5bf-0468-3d7d-bab8-093df910fba4",
                                "text": "„Verkehrserzieher der Polizeihauptwache Königs Wusterhausen überprüften in Schulzendorf 228 Fahrräder von Schülern der Grund- und Gesamtschule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
