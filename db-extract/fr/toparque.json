                        "entry_id": "a050ea6a-af6e-3b25-909e-2a44ba52ada2",
                        "glosses": [
                            "Chef d’une toparchie."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e306e6c7-dd33-49b1-ad24-90cbd55800d6",
                                "sense_id": "2acd25d6-b7a5-3ba1-9480-edb25104eec4",
                                "text": "L'un des disciples proches de Jésus, aurait converti le toparque d'Édesse (l'actuelle Urfa d'Irak) Abgar V dès les premières années de l'Église."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d53c9474-45a9-44ca-8782-b14a7084eb39",
                        "source_entry_id": "a050ea6a-af6e-3b25-909e-2a44ba52ada2",
                        "source_sense_id": "2acd25d6-b7a5-3ba1-9480-edb25104eec4",
                        "target_lang_word": "toparch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toparch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                        "entry_id": "d8553fe5-cefa-3b84-a321-d43c1dc24e0d",
                                        "glosses": [
                                            "The prince or ruler of a small district, city, or petty state; a petty \\\"king\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7971a9c-8892-4a16-9467-ad93cb482807",
                                                "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                                "text": "[B]y those many kings mentioned in the Old Testament, \"thirty and one\" in the little land of Canaan, (Joshua xii. 24,) is meant only toparchs, not great kings, but lords of a little dition and dominion; […]"
                                            },
                                            {
                                                "example_id": "20261eff-7688-4fe9-b236-d487b38c0081",
                                                "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                                "text": "Toparks, Kings of Cities or narrow territories, such as were the Kings of Sodome and Gomorrah, the Kings of Jericho and Ai."
                                            },
                                            {
                                                "example_id": "86c36c1b-5c07-4488-83aa-21fea62681ea",
                                                "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                                "text": "About the same time […] flourished Cadocus, abbot of Llancarvan in Glamorganshire, son of the prince and toparch of that country."
                                            },
                                            {
                                                "example_id": "1cf6b42d-aae5-40ae-9280-fd564290aebd",
                                                "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                                "text": "The toparchs of India and Ethiopia."
                                            },
                                            {
                                                "example_id": "9aa7cb82-0fd2-40fd-a09b-009adcc85a1b",
                                                "sense_id": "813faedc-ac3e-309b-8430-c61062609d94",
                                                "text": "The top-arch, Turlogh O’Connor, was the friend of O’Rourke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
