                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de83a2d-35c3-4232-97cc-96c2723bb1c8",
                                                "sense_id": "336715c0-3904-39d0-a3d0-79dbf8761532",
