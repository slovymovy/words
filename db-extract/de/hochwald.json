                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Frau Hochwald ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "42d9d9b3-9743-4d25-af47-b0ce7d84652f",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Herr Hochwald wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "66f1c0f3-86a4-4bbd-8ce9-863ba7590691",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Die Hochwalds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a5c5da51-6ca9-4c13-876d-30df35458369",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Der Hochwald trägt nie die Schals, die die Hochwald ihm strickt."
                            },
                            {
                                "example_id": "0289df32-740a-466b-adb4-d4f33eaf8ad5",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hochwald kommt, geht der Herr Hochwald.“"
                            },
                            {
                                "example_id": "3ca29f1f-1261-4533-9c09-ebe2075b1f51",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Hochwald kommt und geht."
                            },
                            {
                                "example_id": "30b0c02c-4879-474f-93b1-ee761e59ff0d",
                                "sense_id": "4efeedac-23df-38f2-bb0f-8bd3e212ff0c",
                                "text": "Hochwalds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
