                "senses": [
                    {
                        "sense_id": "45432b36-0d09-39cc-8c94-776f65445f55",
                        "entry_id": "496fd146-bfb4-3bd5-8b6a-5afcbac8fbc2",
                        "glosses": [
                            "außerhalb der eigenen Lehrverpflichtung für einen verhinderten Kollegen gehaltene Unterrichtsstunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ac219f4-9a1a-4cb9-8c10-cd99cf0114b7",
                                "sense_id": "45432b36-0d09-39cc-8c94-776f65445f55",
                                "text": "„Übersteigt die Unterrichtserteilung eines Unterrichtspraktikanten wegen der Supplierung für einen länger als drei unmittelbar aufeinanderfolgende Kalendertage verhinderten Lehrer das halbe Ausmaß der Lehrverpflichtung eines Bundeslehrers gemäß dem Bundeslehrer-Lehrverpflichtungsgesetz, BGBl. Nr. 244/1965, so gebührt ihm für jede Supplierstunde 2,3 vH des Ausbildungsbeitrages.“"
                            },
                            {
                                "example_id": "ac09a0d4-8e04-496a-8773-40992879cdc4",
                                "sense_id": "45432b36-0d09-39cc-8c94-776f65445f55",
                                "text": "„Auch wurde sie im März 2007 bereits einmal vom Amt der Steiermärkischen Landesregierung wegen dienstrechtlicher Verfehlungen ermahnt (Nachsitzen von Schülern, Nichthalten einer Gangaufsicht und von zwei Supplierstunden, frühzeitiges Beenden einer Unterrichtsstunde).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
