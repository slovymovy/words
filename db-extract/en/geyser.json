                    {
                        "translation_id": "4b2b1676-1600-4b81-8820-bc96a0a6baec",
                        "source_entry_id": "5f91af76-e9ea-3686-bc51-ee108b092f82",
                        "source_sense_description": "boiling spring",
                        "target_lang_word": "Geysir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
