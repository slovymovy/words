                                        "entry_id": "c9037294-77f4-3b8d-ac2e-416d509090ab",
                                        "glosses": [
                                            "Descended from some other North European settlers like the British (English)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
