                ],
                "senses": [
                    {
                        "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                        "entry_id": "53f8bb1b-aeb4-3ce2-bba3-4a64bac1329f",
                        "glosses": [
                            "räumlich begrenztes Areal, das Varianten des Coronavirus aufweist, die als bedenklich (variants of concern) gelten"
                        ],
                        "tags": [
                            "Corona"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef3f5e0-e0fc-4735-b972-99ada2caa65b",
                                "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                                "text": "„Bislang galten elf Länder in Asien, Afrika und Lateinamerika als Virusvariantengebiet. Nun hat die Bundesregierung auch Großbritannien als solches eingestuft.“"
                            },
                            {
                                "example_id": "2f43093f-78da-4613-afc9-df840393af81",
                                "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                                "text": "„Das RKI hat die Liste der Risikogebiete überarbeitet - und Großbritannien zum Virusvariantengebiet hochgestuft.“"
                            },
                            {
                                "example_id": "b96e0e9f-2795-4fc3-ad57-ce1cdf054107",
                                "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                                "text": "„Wegen der Ausbreitung der zuerst in Indien entdeckten Corona-Variante wird Großbritannien von der Bundesregierung ab Sonntag als Virusvariantengebiet eingestuft.“"
                            },
                            {
                                "example_id": "747ba65d-1b9e-445b-bf3b-bf1324b92d90",
                                "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                                "text": "„Rückkehrende Fahrer, die sich in den zurückliegenden 10 Tage in einem sogenannten Virusvariantengebiet aufgehalten haben müssen sich vor ihrer Einreise in die Bundesrepublik Deutschland anmelden, ein negatives Testergebnis nachweisen können und gegebenenfalls in Quarantäne.“"
                            },
                            {
                                "example_id": "d5714b8e-8202-4505-9c98-90a341c35c9f",
                                "sense_id": "75602a09-6eae-3fa2-a7c2-d1da3fb7740c",
                                "text": "Für Länder, in denen Virus-Mutationen weit verbreitet sind - so genannte Virusvariantengebiete - besteht eine Beförderungsverbot. Also Beförderungsunternehmen wie Flug- oder Bahngesellschaften dürfen keine Personen aus diesen Ländern nach Deutschland befördern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
