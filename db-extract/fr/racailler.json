                                "example_id": "463ad7d3-27fd-41dc-ae7a-e55194fe9c56",
                                "sense_id": "850843f3-0d76-33f6-8bcc-7d08a1ae698d",
                                "text": "Les flics flicaillent et la racaille racaille."
