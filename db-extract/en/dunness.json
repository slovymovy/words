                        "glosses": [
                            "The quality of being dun in colour."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6774580-d4ce-4ab0-a800-8563f8356d7e",
                                "sense_id": "d372460f-e430-34fb-b2a0-16a712d9d7c5",
                                "text": "And yet thou thinkest, sad child, whose years have scarce passed into woman, that the sun, once set, never comes back to life! But even while we speak, thy morning draws near, and the dunness of cloud takes the hues of the rose!"
                            },
                            {
                                "example_id": "9981e331-9bd7-48ab-9178-64e6eed42a3c",
                                "sense_id": "d372460f-e430-34fb-b2a0-16a712d9d7c5",
                                "text": "[…] up a hard and stony mountain path to Styhead Pass, whence the contrast between the dunness of the bare mountains and the fertility of green valleys was most striking […]"
                            },
                            {
                                "example_id": "77610881-fa7d-40fe-92da-5571183323cf",
                                "sense_id": "d372460f-e430-34fb-b2a0-16a712d9d7c5",
                                "text": "He saw the stallion of Spartacus white amidst the general dunness, considered that for a moment, passed beyond the moving blurs of nocolour that made up the Gauls and Germans: and met the horizon."
                            }
                        ]
                    }
