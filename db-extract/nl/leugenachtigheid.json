                    }
                ],
                "translations": [
                    {
                        "translation_id": "01725331-42a5-4b6b-aae1-82d7e7b771d1",
                        "source_entry_id": "39bca786-4a03-3ab8-9c6b-d418723a6ed6",
                        "source_sense_id": "2ea4154d-51db-3d2b-9423-b2300a0b2240",
                        "source_sense_description": "het veel en makkelijk kunnen liegen en bedriegen",
                        "target_lang_word": "untruthfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untruthfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45780265-2f77-372c-9363-9794435a0a8d",
                                        "entry_id": "517e13bb-0669-35d5-9ced-b1873224baa6",
                                        "glosses": [
                                            "The state of being untruthful; dishonesty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a10d5f-2f5e-49c2-8600-2f7b7d8e27f4",
                                                "sense_id": "45780265-2f77-372c-9363-9794435a0a8d",
                                                "text": "Subtlety may indeed effect a victory at the deadening cost of a sin, but timeservingness can only get transitory advantage, while the damage of its untruthfulness leaves its corroding taint behind for ever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f6abf50-e51d-4bc7-b29b-900319523347",
                        "source_entry_id": "39bca786-4a03-3ab8-9c6b-d418723a6ed6",
                        "source_sense_id": "2ea4154d-51db-3d2b-9423-b2300a0b2240",
                        "source_sense_description": "het veel en makkelijk kunnen liegen en bedriegen",
                        "target_lang_word": "falseness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falseness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84b40b98-9190-3a67-b24e-9e5d6ca72970",
                                        "entry_id": "d5d317b8-c2e1-3696-8f2a-6aa47aa75955",
                                        "glosses": [
                                            "The characteristic of being false."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04cd8a4-7cb3-43f6-81ee-b03840aaf340",
                                                "sense_id": "84b40b98-9190-3a67-b24e-9e5d6ca72970",
                                                "text": "All falseness collapses under the weight of denied truth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27cd7f21-39e7-452c-b52e-df05a2a97cad",
                        "source_entry_id": "39bca786-4a03-3ab8-9c6b-d418723a6ed6",
                        "source_sense_id": "2ea4154d-51db-3d2b-9423-b2300a0b2240",
                        "source_sense_description": "het veel en makkelijk kunnen liegen en bedriegen",
                        "target_lang_word": "mendacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mendacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                        "entry_id": "90bc80f7-6d68-3b5a-8825-b1a4fce00caf",
                                        "glosses": [
                                            "The fact or condition of being untruthful; dishonesty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed959003-929a-479d-9a2b-cb0a1dcafb07",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "Mendacity is not a uniform offence: it changes its colour according to the nature and substance of the offence to which it is rendered or endeavoured to be rendered subservient. Mendacity, employed in drawing down upon an innocent head the destroying sword of justice, is murder: murder, encompassed with all its correspondent terror. Mendacity, employed in the obtainment of money, is but depredation. Yet, while predatory mendacity is punished with death, the punishment for the murderous mendacity is in comparison but a flea-bite."
                                            },
                                            {
                                                "example_id": "ae7501bd-880c-43c2-8185-258b45edcfe3",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "[…] Treating the assertion of the witness as the effect, he [Pierre-Simon Laplace] considers as its two possible causes, the veracity or mendacity of the witness on the particular occasion, that is, the truth or falsity of the fact."
                                            },
                                            {
                                                "example_id": "2ed4f9b0-cb50-4b2f-afd3-b370235faaba",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "Big Daddy: […] Think of all the lies I got to put up with!—Pretenses! Ain't that mendacity? Having to pretend stuff you don't think or feel or have any idea of?"
                                            },
                                            {
                                                "example_id": "0de18395-958c-4da0-89e8-df4a03777383",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "So now the hard Brexiters say, with astonishingly cynical mendacity, that Britain would be better off going it alone."
                                            },
                                            {
                                                "example_id": "32f0ac6a-ac83-4509-b5ca-02c6cf67dc99",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "A shifty or unreliable politician may hide their mendacity behind deceit, fabrication on confabulation, or by rehearsed counter-attack that simply ignores the questions but makes imputations against the other."
                                            },
                                            {
                                                "example_id": "a91e40e4-04d2-49b9-aaf4-e07d5d0f3dd5",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "And when presidential counsellor Kellyanne Conway coined the phrase “alternative facts” a few days after Trump’s inauguration in early 2017, the mendacity of the incoming administration appeared to be all but official."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                        "entry_id": "90bc80f7-6d68-3b5a-8825-b1a4fce00caf",
                                        "glosses": [
                                            "A deceit, falsehood, or lie."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01920edd-c701-4ba5-a702-735e90d21c7b",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "The scandalous bronze-lacker age, of hungry animalisms, spiritual impotencies and mendacities, will have to run its course, till the Pit swallow it."
                                            },
                                            {
                                                "example_id": "71f4dd5d-acea-49c2-af91-bb19d0936da1",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "Though the rebels had utterly failed in their purposes, having accomplished nothing but the temporary disabling of two lightly armed vessels, and had retreated before the approach of the only formidable vessel there, they formally, and with a mendacity equalled only by some of their own efforts in that direction, proclaimed that they had \"driven out of sight, for a time, the entire hostile fleet,\" and that the blockade of the port of Charleston was raised."
                                            },
                                            {
                                                "example_id": "d6ce6c61-87c2-4f39-a86c-6ff7e33dac25",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "He would have you believe that every error we make is deliberate, that journalists have somehow ginned up a unified conspiracy of lies and mendacities against him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
