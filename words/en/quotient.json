{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e384d20a-5b64-3173-8b77-27c1b4d91bd5",
                    "sense_definition": "The number resulting from the division of one number by another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "math_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dividing twelve by four yields a <w>quotient</w> of three.",
                            "target_lang_translations": {
                                "ru": "Деление двенадцати на четыре даёт <w>частное</w>, равное трём."
                            }
                        },
                        {
                            "text": "The teacher asked the class to calculate the <w>quotient</w> and the remainder.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил класс вычислить <w>частное</w> и остаток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intelligence quotient",
                        "quotient and remainder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, получаемое в результате деления одного числа на другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частное",
                                "target_lang_sense_clarification": "результат деления чисел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22bb7fcc-0ba1-3196-a8b9-70af64904862",
                    "sense_definition": "The mathematical result of an operation that acts as the inverse of multiplication on entities other than numbers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In advanced algebra, we compute the <w>quotient</w> of two polynomials.",
                            "target_lang_translations": {
                                "ru": "В высшей алгебре мы вычисляем <w>частное</w> двух многочленов."
                            }
                        },
                        {
                            "text": "The student struggled to find the <w>quotient</w> group in abstract algebra.",
                            "target_lang_translations": {
                                "ru": "Студенту было трудно найти <w>фактор</w>-группу в абстрактной алгебре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quotient group",
                        "quotient space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат операции деления или обратной к умножению над математическими объектами (многочленами, группами и др.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частное",
                                "target_lang_sense_clarification": "результат деления нечисловых объектов (например, многочленов)"
                            },
                            {
                                "target_lang_word": "фактор-",
                                "target_lang_sense_clarification": "в составе терминов высшей алгебры (факторгруппа, факторпространство)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e702a58a-2c28-3c68-a271-2fa718a4397b",
                    "sense_definition": "A share, proportion, or quota.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "share",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each member received their assigned <w>quotient</w> of the annual harvest.",
                            "target_lang_translations": {
                                "ru": "Каждый участник получил причитающуюся ему <w>долю</w> ежегодного урожая."
                            }
                        },
                        {
                            "text": "The committee established a fair <w>quotient</w> of resources for each department.",
                            "target_lang_translations": {
                                "ru": "Комитет установил справедливую <w>квоту</w> ресурсов для каждого отдела."
                            }
                        }
                    ],
                    "synonyms": [
                        "quota",
                        "share"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделенная доля, часть или квота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть чего-либо"
                            },
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "установленная норма, часть"
                            },
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "доля целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c1c76e3-59e0-3106-939c-4c2fcd32477f",
                    "sense_definition": "In cricket, a statistical tiebreaker calculated from the ratio of runs scored per wicket lost to runs conceded per wicket taken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team advanced to the finals because they had a superior <w>quotient</w>.",
                            "target_lang_translations": {
                                "ru": "Команда вышла в финал, потому что у неё был более высокий <w>коэффициент</w>."
                            }
                        },
                        {
                            "text": "Officials calculated the tournament <w>quotient</w> after the match ended in a draw.",
                            "target_lang_translations": {
                                "ru": "Судьи рассчитали турнирный <w>коэффициент</w> после того, как матч закончился вничью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: статистический показатель для разрешения ничьей, вычисляемый как отношение набранных ранов к пропущенным с учётом потерянных и взятых калиток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коэффициент",
                                "target_lang_sense_clarification": "статистический показатель в крикете"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}