            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                    "sense_definition": "A collection or number of different things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop offers a wide <w>variety</w> of fresh fruits and vegetables every morning.",
                            "target_lang_translations": {
                                "ru": "Магазин каждое утро предлагает широкий <w>ассортимент</w> свежих фруктов и овощей."
                            }
                        },
                        {
                            "text": "Students can choose from a <w>variety</w> of sports including football, tennis, and swimming.",
                            "target_lang_translations": {
                                "ru": "Студенты могут выбирать из <w>множества</w> видов спорта, включая футбол, теннис и плавание."
                            }
                        }
                    ],
                    "synonyms": [
                        "array",
                        "assortment",
                        "spread"
                    ],
                    "antonyms": [
                        "uniformity"
                    ],
                    "common_phrases": [
                        "wide variety",
                        "variety of things",
                        "great variety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор или количество различных предметов или явлений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "большой выбор разных вещей"
                            },
                            {
                                "target_lang_word": "множество",
                                "target_lang_sense_clarification": "большое количество разных вариантов"
                            },
                            {
                                "target_lang_word": "ассортимент",
                                "target_lang_sense_clarification": "набор товаров или услуг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                    "sense_definition": "The quality of being varied; diversity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diversity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They say that <w>variety</w> is the spice of life because it makes things interesting.",
                            "target_lang_translations": {
                                "ru": "Говорят, что <w>разнообразие</w> — это соль жизни, потому что оно делает вещи интересными."
                            }
                        },
                        {
                            "text": "The <w>variety</w> of the landscape in this country is truly breathtaking for tourists.",
                            "target_lang_translations": {
                                "ru": "<w>Многообразие</w> ландшафта в этой стране по-настоящему захватывает дух у туристов."
                            }
                        }
                    ],
                    "synonyms": [
                        "diversity",
                        "heterogeneity",
                        "multiformity"
                    ],
                    "antonyms": [
                        "sameness",
                        "uniformity"
                    ],
                    "common_phrases": [
                        "variety is the spice of life",
                        "lack of variety",
                        "infinite variety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество чего-либо, характеризующееся отсутствием однообразия; многообразие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "отсутствие монотонности"
                            },
                            {
                                "target_lang_word": "многообразие",
                                "target_lang_sense_clarification": "наличие многих вариантов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                    "sense_definition": "A specific type or strain of a plant or animal within a species.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This particular <w>variety</w> of tomato is known for being very resistant to pests.",
                            "target_lang_translations": {
                                "ru": "Этот конкретный <w>сорт</w> томатов известен своей высокой устойчивостью к вредителям."
                            }
                        },
                        {
                            "text": "The gardener decided to plant a new <w>variety</w> of rose that blooms all summer.",
                            "target_lang_translations": {
                                "ru": "Садовник решил посадить новый <w>сорт</w> роз, который цветет все лето."
                            }
                        }
                    ],
                    "synonyms": [
                        "variety"
                    ],
                    "common_phrases": [
                        "new variety",
                        "plant variety",
                        "local variety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный тип или штамм растения или животного внутри вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорт",
                                "target_lang_sense_clarification": "для культурных растений"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "общий биологический термин"
                            },
                            {
                                "target_lang_word": "порода",
                                "target_lang_sense_clarification": "для домашних животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de3736e6-ff77-318c-ab36-897d6aaf57d2",
                    "sense_definition": "A specific form of a language, such as a dialect or register.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists study every <w>variety</w> of English spoken around the world today.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают каждую <w>разновидность</w> английского языка, на которой говорят сегодня во всем мире."
                            }
                        },
                        {
                            "text": "The local <w>variety</w> of the language has many unique words not found elsewhere.",
                            "target_lang_translations": {
                                "ru": "Местный <w>вариант</w> языка содержит много уникальных слов, не встречающихся в других местах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "language variety",
                        "standard variety",
                        "regional variety"
                    ],
                    "target_lang_definitions": {
