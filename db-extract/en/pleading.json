                        "entry_id": "f3d72f74-efd3-3d87-9338-38708fe5aa00",
                        "glosses": [
                            "The act of making a plea."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e0e06e4-af27-43f4-8b73-a75468f07cce",
                                "sense_id": "35d97efd-c615-3a83-a546-e108455aae66",
                                "text": "But it pleased her to play on my passion / And whet me to pleadings / That won from her mirthful negations / And scornings undue."
                            }
                        ]
                    },
                    {
                        "sense_id": "40b69490-db66-3926-8a6a-4c019a3fc2e1",
