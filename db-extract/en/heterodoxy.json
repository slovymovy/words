                                            {
                                                "example_id": "0879a5c6-765f-457c-b029-30047d458249",
                                                "sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                                                "text": "Het uitbannen van tot ketterij bestempelde opvattingen kreeg vorm in de vervolging van de aanhangers van dergelijke opvattingen door lokale kerken en de wereldlijke macht."
                                            }
