                            },
                            {
                                "target_lang_word": "odpad",
                                "target_lang_sense_clarification": "obecně vyhozené věci"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ferraille",
                                "target_lang_sense_clarification": "vieux morceaux de fer ou métal usé"
                            },
                            {
                                "target_lang_word": "déchets",
                                "target_lang_sense_clarification": "matériaux inutilisables"
                            }
                        ],
                        "it": [
