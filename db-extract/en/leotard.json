                    {
                        "translation_id": "06f889b0-e1d0-4c94-8fa5-9e8ff32cfe10",
                        "source_entry_id": "422948ee-565d-3b64-acc4-8cd5d503f44d",
                        "source_sense_id": "0e2a81d2-c98c-3a7f-bb7b-a420c099442c",
                        "source_sense_description": "skin-tight one piece suit of clothing",
                        "target_lang_word": "trykot",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trykot",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                        "entry_id": "15012542-c698-33ff-8a51-9e43b4a42f92",
                                        "glosses": [
                                            "tkanina z: wełny, bawełny, jedwabiu; dziana sposobem pończoszniczym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab31faac-f421-48fe-b5a8-0973963c9011",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Najodpowiedniejszym materiałem na ubranie żeglarskie jest wełna (…) Na drugim miejscu należy postawić trykot bawełniany"
                                            },
                                            {
                                                "example_id": "ad1fed25-173a-40bf-9a94-a874f56f2118",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Ciepła kurtka z jasnego trykotu"
                                            },
                                            {
                                                "example_id": "db8a8196-c371-4623-ac62-2023e2ce5325",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Długą wąską spódnicę z trykotu lub dzianiny nosimy z obszernym kardiganem albo z dwoma"
                                            },
                                            {
                                                "example_id": "33e1490e-fd3d-419d-bc09-c48ccd9cb72d",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Po 1811 roku pojawiły się podwiązki wyrabiane z trykotu o specjalnym ściągaczowym ściegu, a w połowie XIX wieku zaczęto do ich wyrobu używać taśmy gumowej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                        "entry_id": "15012542-c698-33ff-8a51-9e43b4a42f92",
                                        "glosses": [
                                            "odzież z takiej tkaniny trykotu (1.1); zwłaszcza: obcisły, dziany kostium gimnastyczny, kąpielowy, sportowy, baletowy, itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309d789c-e46a-4333-bff1-61efc1633958",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Mijają go pierwsi przebierańcy: zgarbiona kobieta w czarnym spiczastym kapeluszu o szerokim rondzie, zamiatająca chodnik peleryną, mężczyzna-motyl w sinych trykotach"
                                            },
                                            {
                                                "example_id": "35bab2eb-b737-492a-affc-a8eaddc0e4d3",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Zblazowany salonowymi perwersjami, do których wkładał specjalne czarne trykoty, i wściekłą pracą (był niezrównanym chemikiem i dyletantem w mechanice i matematyce), książę oddawał się zupełnemu wypoczynkowi i wszelkim wiejskim rozrywkom"
                                            },
                                            {
                                                "example_id": "b16aa425-d60f-487b-8e9d-efde18abf8e7",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Dziewczyny w gimnastycznych trykotach przerzucały z rąk do rąk piłkę, która wzbijała się wysoko ponad sztandary"
                                            },
                                            {
                                                "example_id": "2058a3d8-2a9d-41f3-81ab-54c224987226",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "W kąpieli panowie nosili cienkie trykoty sięgające od obojczyka do połowy uda"
                                            },
                                            {
                                                "example_id": "117ffc8a-83a5-47f1-a32b-64fbc8d28c0e",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Rick wchodził na scenę w pięknym trykocie czarnym, z wyhaftowaną na piersiach złotą żmiją"
                                            },
                                            {
                                                "example_id": "93a30cbb-12cf-4737-acde-4c7b4f4345cc",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Duch babki szepce do mnie, że ona nie nosiłaby tego, co ja, te dzianiny, trykoty opinające ciało, to dobre na ciepłe majtki, ale na wierzch"
                                            },
                                            {
                                                "example_id": "e94a8844-a254-4727-94c0-d2c9a69f8cb4",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Przychodziliśmy w trykotach, dziewczęta nie umalowane, niczego nie dało się ukryć"
                                            },
                                            {
                                                "example_id": "8e25436b-e30c-403b-86e6-110a3991a79d",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Niestety, już nigdy nie założy zapaśniczego trykotu"
                                            },
                                            {
                                                "example_id": "b427a08a-36c8-4ba5-b2e6-1bbb902bffa9",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Rożne białe, i w kolorach Wstążki, Kornety, kwiatki, Chustki Gazowe i Jedwabne, Fartuszki Gazowe i jedwabne, Rękawiczki, Pończochy Męskie i Damskie jedwabne, Trykoty na kamizelki i Sultany jedwabne i bawełniane"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
