                        "examples": [
                            {
                                "example_id": "8b83b944-5c8a-453a-97ad-bf618c5336f3",
                                "sense_id": "4500aa2d-885e-30e4-bc94-c23ee34c938c",
                                "text": "In den 1990er Jahren machte sich die Politikverdrossenheit mehr und mehr im Volk breit."
                            },
                            {
                                "example_id": "18bd5821-7ebc-405d-a72a-06ce9ea0b0e1",
                                "sense_id": "4500aa2d-885e-30e4-bc94-c23ee34c938c",
                                "text": "„Wir redeten über Demokratie, Politikverdrossenheit und Selbstbestimmtheit.“"
                            },
                            {
                                "example_id": "9ba0b790-7784-4e2c-af97-97c635077aee",
                                "sense_id": "4500aa2d-885e-30e4-bc94-c23ee34c938c",
                                "text": "„Die Ironie dabei: Auch Politikverdrossenheit ist eine Art, sich am Staat zu beteiligen, ja, ihn aufzubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
