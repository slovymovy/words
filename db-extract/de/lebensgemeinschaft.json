                "senses": [
                    {
                        "sense_id": "cef0ad2c-287c-3977-b10b-28d2e743fb05",
                        "entry_id": "461aa0ea-5193-399e-a57e-02d50b7ab76e",
                        "glosses": [
                            "das auf Dauer angelegte Zusammenleben von Personen (oft Sexualpartner) in einem Privathaushalt"
                        ],
                        "tags": [
                            "Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "f9ac3e41-12f8-4fc6-a70c-86b47f42aa4d",
                                "sense_id": "cef0ad2c-287c-3977-b10b-28d2e743fb05",
                                "text": "„Ihr erstes Buch \"Gemeinschaftskompass\" zählt, wie Stützel sagt, in der Szene der Wohnprojekte und Lebensgemeinschaften inzwischen zur Grundlagenliteratur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a22b7f39-fd5c-3454-a328-d506e3442245",
                        "entry_id": "461aa0ea-5193-399e-a57e-02d50b7ab76e",
                        "glosses": [
                            "Gemeinschaft von Organismen verschiedener Arten in einem abgrenzbaren Lebensraum beziehungsweise Standort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb3948c-7500-4085-8f8d-4bcb0747c32b",
                                "sense_id": "a22b7f39-fd5c-3454-a328-d506e3442245",
                                "text": "„Neben der Säuberung solle die Aktion auch zum Ausdruck bringen, dass die Natur kein Abfallplatz ist, sondern eine Lebensgemeinschaft, die nicht gestört werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0e58919-d180-462d-af76-f3a599806249",
                        "source_entry_id": "461aa0ea-5193-399e-a57e-02d50b7ab76e",
                        "source_sense_id": "cef0ad2c-287c-3977-b10b-28d2e743fb05",
                        "source_sense_description": "das auf Dauer angelegte Zusammenleben von Personen in einem Privathaushalt",
                        "target_lang_word": "communauté de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "92ff91cd-7421-4cd1-b140-f0a4aca53d22",
                        "source_entry_id": "461aa0ea-5193-399e-a57e-02d50b7ab76e",
                        "source_sense_id": "a22b7f39-fd5c-3454-a328-d506e3442245",
                        "source_sense_description": "Gemeinschaft von Organismen verschiedener Arten in einem abgrenzbaren Lebensraum beziehungsweise Standort",
                        "target_lang_word": "biocénose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biocénose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                        "entry_id": "975f7b69-4be1-31bb-add7-7f3b9ac74c5c",
                                        "glosses": [
                                            "Ensemble des êtres vivants rencontrés dans un biotope donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011f9f97-b180-4fcd-b822-a863944cba62",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "Notre avenir tient dans notre sagesse à réintégrer la biocénose, cette association harmonieuse entre toutes les espèces vivantes."
                                            },
                                            {
                                                "example_id": "171edbb3-359c-4c66-bbc3-ad6edff1a76d",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "La première conséquence de cette jeunesse des biocénoses est une pauvreté floristique marquée."
                                            },
                                            {
                                                "example_id": "d59a7f74-696c-444f-aea8-f4c2fec864c8",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "L’équilibre des biocénoses n’est donc pas statique mais dynamique, puisqu’il résulte des compétitions internes à la biocénose."
                                            },
                                            {
                                                "example_id": "1cee4833-373e-4425-9acd-cda5938bda35",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "La biocénose est étroitement liée au biotope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
