                "translations": [
                    {
                        "translation_id": "7a92f9ea-8b04-4c0e-aa9d-3887d993c769",
                        "source_entry_id": "4616ddb4-07f9-3095-8801-1e95ad06817d",
                        "source_sense_id": "b79355b9-afb5-37f4-9a69-d5757570c3f6",
                        "source_sense_description": "having bowed legs",
                        "target_lang_word": "krummbeinig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krummbeinig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e24de7aa-67ac-3b3e-827e-abc30351fa0f",
                                        "entry_id": "bd30c159-3785-3b24-90eb-e1620944c0fd",
                                        "glosses": [
                                            "über krumme Beine verfügend, mit krummen Beinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51f1dea-c613-4887-97b5-bc4accffb12a",
                                                "sense_id": "e24de7aa-67ac-3b3e-827e-abc30351fa0f",
                                                "text": "„Mit seinen unbeholfen über den Boden stampfenden Stiefeln und dem lächerlich krummbeinigen Gang fiel es schwer, ihn zu übersehen.“"
                                            },
                                            {
                                                "example_id": "ac71def6-4ad4-466a-8a2e-536ea0fae69c",
                                                "sense_id": "e24de7aa-67ac-3b3e-827e-abc30351fa0f",
                                                "text": "„Sie lief mit den kantigen, krummbeinigen Schritten eines Kleinkindes.“"
                                            },
                                            {
                                                "example_id": "477ba55d-3091-4ca1-98a2-d6300ac6c78b",
                                                "sense_id": "e24de7aa-67ac-3b3e-827e-abc30351fa0f",
                                                "text": "„Ein Zicklein stand krummbeinig da, festgebunden am Wagenrad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd7f03b-8e36-432e-a737-ba3c90fa1e4d",
                        "source_entry_id": "4616ddb4-07f9-3095-8801-1e95ad06817d",
                        "source_sense_id": "b79355b9-afb5-37f4-9a69-d5757570c3f6",
                        "source_sense_description": "having bowed legs",
                        "target_lang_word": "o-beinig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "o-beinig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd112f80-caa6-39ca-b392-adb8943665cc",
                                        "entry_id": "a101f21f-1dfa-33c4-9735-f9fed8da90a4",
                                        "glosses": [
                                            "O-Beine habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a49c97-fef0-4ba2-9acc-7b43c8878a66",
                                                "sense_id": "cd112f80-caa6-39ca-b392-adb8943665cc",
                                                "text": "„Die meisten Männer sind ein klein wenig o-beinig und tragen wohl Rasierklingen unter den Armen, so dass ihr Gang zu einem Schaukeln wird.“"
                                            },
                                            {
                                                "example_id": "df211e52-7363-4dfc-b267-fecff624a8fe",
                                                "sense_id": "cd112f80-caa6-39ca-b392-adb8943665cc",
                                                "text": "„Er hatte einen Körper wie ein aufgedunsener Zweijähriger und war pausbäckig und rundlich und o-beinig.“"
                                            },
                                            {
                                                "example_id": "c2f81e98-e3a0-4975-8d88-84e0cd6745e4",
                                                "sense_id": "cd112f80-caa6-39ca-b392-adb8943665cc",
                                                "text": "„Der Mann hat aber auch gar nichts Militärisches: O-beinig, kleinwüchsig, stoppelbärtig, schiefe Schultern und ein leichter Buckel – so gleicht er eher einem Waldschrat als einem Soldten.“"
                                            },
                                            {
                                                "example_id": "342ee5d7-1929-4ffe-8d7a-c41bc1fa6f70",
                                                "sense_id": "cd112f80-caa6-39ca-b392-adb8943665cc",
                                                "text": "„O-beinig eiert er vor uns her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
