                        "examples": [
                            {
                                "example_id": "3df885f5-9746-4c2c-97cd-464a9dcd047d",
                                "sense_id": "c2ea5541-6560-3342-b34b-c54ef53900b3",
                                "text": "Elle aime entre tous un caniche blanc, enfoui depuis des hivers sous une neige terreuse que ne fond nul été. Il entoure ma bas-rouge d’une assiduité résignée de vieux lettré."
                            },
                            {
                                "example_id": "dcf878ba-4b6e-41b3-98ab-dc2848ff9882",
                                "sense_id": "c2ea5541-6560-3342-b34b-c54ef53900b3",
                                "text": "Sécurité supplémentaire, dans le side attelé à la machine, Sultan, un bas-rouge de quatre-vingt-dix livres, veille, muselé, mais pas moins attentif aux approches, doué d’un sens aigu et quasi divinatoire du personnage ou du véhicule suspect."
                            }
                        ]
                    }
