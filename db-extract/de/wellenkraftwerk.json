                "senses": [
                    {
                        "sense_id": "1fc16c25-c5de-39e1-8a58-ca6fb7f7eab0",
                        "entry_id": "80e44529-2340-3dc2-b0fc-174c304d4afe",
                        "glosses": [
                            "Wasserkraftwerk, das die Energie von Meereswellen zur Stromgewinnung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acb695af-2d79-4dc1-848b-266f200393a7",
                                "sense_id": "1fc16c25-c5de-39e1-8a58-ca6fb7f7eab0",
                                "text": "„In Schottland will man nun aber die Kraft der Wellen in großem Stil zur Energiegewinnung nutzen. Kürzlich gab die Regierung bekannt, ein erstes Wellenkraftwerk mit 40 Megawatt Leistung zu bauen.“"
                            },
                            {
                                "example_id": "450ef75c-0d22-4372-a2a6-09411caf4c57",
                                "sense_id": "1fc16c25-c5de-39e1-8a58-ca6fb7f7eab0",
                                "text": "„Das größte Wellenkraftwerk der Welt, die Oyster (Auster), am European Marine Energy Centre (EMEC) im Orkney-Archipel in Betrieb gegangen, wie Science Daily berichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
