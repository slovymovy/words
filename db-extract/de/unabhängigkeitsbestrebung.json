                "senses": [
                    {
                        "sense_id": "a83413ef-f9f6-3d93-820f-bbe9139055ea",
                        "entry_id": "d2ffb6ca-86d6-3b49-88e2-84b28a0267d4",
                        "glosses": [
                            "ernsthafte Bemühung, Unabhängigkeit zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2461253-24f5-4921-adad-225d2c169903",
                                "sense_id": "a83413ef-f9f6-3d93-820f-bbe9139055ea",
                                "text": "„In der Zwischenzeit hatte Italien einen schärferen Ton angeschlagen und drohte auf Flugblättern offen mit einer Invasion, sollten die Unabhängigkeitsbestrebungen nicht aufgegeben werden.“"
                            },
                            {
                                "example_id": "b540f01b-f2e4-422d-a04e-65855241286d",
                                "sense_id": "a83413ef-f9f6-3d93-820f-bbe9139055ea",
                                "text": "„Erst 1903 ging der irische Boden in den Besitz der irischen Bauern über. Doch damit waren die Iren längst noch nicht besänftigt, die Unabhängigkeitsbestrebungen gingen weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
