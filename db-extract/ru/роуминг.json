                                    {
                                        "sense_id": "6101419f-3a67-3bd3-96ee-b2091f5dbf23",
                                        "entry_id": "3a645b2e-4200-39d2-ad51-3b4822a87e20",
                                        "glosses": [
                                            "Unter Roaming versteht man die weltweite Erreichbarkeit unter der eigenen Mobiltelefonnummer sowie das Telefonieren in ausländische Mobilfunknetze mit dieser."
                                        ],
                                        "tags": [
                                            "Mobilfunktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3f1e7e-764e-4ad3-97d3-239a469d315c",
                                                "sense_id": "6101419f-3a67-3bd3-96ee-b2091f5dbf23",
                                                "text": "„Die tatsächlich entstehenden Kosten für Roaming würden in keinem Verhältnis zu dem stehen, was der Kunde letztendlich zahlen müsste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
