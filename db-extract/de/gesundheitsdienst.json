                "senses": [
                    {
                        "sense_id": "8c84739d-6f64-3b65-9fdd-f51c59acef37",
                        "entry_id": "23d66fac-bf52-3dd4-b466-b4b2127d71ae",
                        "glosses": [
                            "(betriebliche, staatliche) Einrichtung, die dem körperlichen und seelischen Wohlergehen dient, indem sie zum Beispiel hilft, Krankheiten zu behandeln und zu vermeiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4feb3b52-18bf-4fd9-afa9-0b217c0c1e0b",
                                "sense_id": "8c84739d-6f64-3b65-9fdd-f51c59acef37",
                                "text": "Der Gesundheitsdienst in Baustadt ist nun telefonisch unter einer neuen Rufnummern erreichbar."
                            },
                            {
                                "example_id": "39805f4d-e664-4570-956e-b5a7bead707b",
                                "sense_id": "8c84739d-6f64-3b65-9fdd-f51c59acef37",
                                "text": "„Nach den Dermatosen stellen Infektionskrankheiten die zweitwichtigste berufliche Gefährdung für Beschäftigte im Gesundheitsdienst dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "141c5939-1971-3ba4-aca1-c55a9ff96b5e",
                        "entry_id": "23d66fac-bf52-3dd4-b466-b4b2127d71ae",
                        "glosses": [
                            "alle öffentlichen Einrichtungen, die der Bekämpfung von Krankheiten und Seuchen dienen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "98bcb744-e9ca-4554-8d5f-02c02fce0e5c",
                                "sense_id": "141c5939-1971-3ba4-aca1-c55a9ff96b5e",
                                "text": "„Nach den Dermatosen stellen Infektionskrankheiten die zweitwichtigste berufliche Gefährdung für Beschäftigte im Gesundheitsdienst dar.“"
                            },
                            {
                                "example_id": "6724a54b-bb7c-40e4-94d8-e26e006e6967",
                                "sense_id": "141c5939-1971-3ba4-aca1-c55a9ff96b5e",
                                "text": "Der britische Gesundheitsdienst bietet jedem Menschen in Großbritannien eine kostenlose medizinische Betreuung."
                            }
                        ],
                        "sense_index_json": "\"2\""
