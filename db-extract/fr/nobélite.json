                        "glosses": [
                            "Explosif puissant à base de nitroglycérine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f721ce3-e742-43b2-b18d-df56abbed2e2",
                                "sense_id": "cd3b1910-b994-3211-9e05-7052e6d681cb",
                                "text": "Dans les carrières des chantiers hydroélectriques : ceux de Sarrans sur la Truyère et de l’Aigle sur la Dordogne, cartouches de nobélite au fulminate de mercure, cordeaux, détonateurs et outillages divers […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "46219a17-4ba1-30cf-9a0c-1f5885218ffa",
                        "entry_id": "d4b2f382-0885-3b8c-9c91-ff3fed0f800b",
                        "glosses": [
                            "Tendance qu’ont certains récipiendaires du Prix Nobel à devenir défenseurs de théories pseudo-scientifiques ou de théories du complot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8205236f-d551-4075-91c5-810066f4590b",
                                "sense_id": "46219a17-4ba1-30cf-9a0c-1f5885218ffa",
                                "text": "On me dit atteint de nobélite, cette maladie qui pousse les Prix Nobel à donner leur avis sur tout et n’importe quoi"
                            },
                            {
                                "example_id": "ae8d3ac1-898a-4304-be3c-6eb4c5715032",
                                "sense_id": "46219a17-4ba1-30cf-9a0c-1f5885218ffa",
                                "text": "Le premier cas de nobélite remonte à 1903 et concerne Pierre et Marie Curie qui, parallèlement à leurs recherches sur la radioactivité, étaient fascinés par la médium Eusapia Palladino, qui lors de ses séances de spiritisme faisait léviter et disparaître des objets."
                            }
                        ]
                    }
