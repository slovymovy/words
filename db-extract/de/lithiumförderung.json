                                "example_id": "d12b126d-d3fb-482d-89da-6aebf9f1b098",
                                "sense_id": "44f46043-f9c3-3c1c-a581-1772b86c7b2a",
                                "text": "„Es gibt Forderungen, die öffentliche Hand müsse die Lithiumförderung stärker kontrollieren.“"
                            },
                            {
                                "example_id": "22971d10-4dce-403f-b26b-7797b65d5263",
                                "sense_id": "44f46043-f9c3-3c1c-a581-1772b86c7b2a",
                                "text": "„Der argentinische Staat sei in der Region lange Zeit wenig präsent gewesen, sagt Dorn. Im Zuge der Lithiumförderung ändere sich das gerade.“"
                            }
                        ],
