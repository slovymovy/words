                "forms": [
                    {
                        "form_id": "b4fb4356-c02d-439c-a28e-45ccb47311eb",
                        "entry_id": "731f9ff6-2843-3449-bd47-60be4bdc13cd",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "technologiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                        "entry_id": "731f9ff6-2843-3449-bd47-60be4bdc13cd",
                        "glosses": [
                            "Relatif à la technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d588bffd-2d4d-463f-b1b4-9a9795f1bb12",
                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                "text": "[…]; elle estime, comme G. de Molinari, que le progrès moral du prolétariat est aussi nécessaire que le progrès matériel de l'outillage, pour porter l'industrie moderne au niveau toujours plus élevé que la science technologique permet d'atteindre; […]."
                            },
                            {
                                "example_id": "2bdd90c8-39c9-4c8f-a914-ec0ad560a7c8",
                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                "text": "En dépit de sa réussite, l’Europe connaissait d'intenses frustrations. Cette réussite était pourtant éclatante. Les progrès scientifiques, technologiques et industriels y étaient impressionnants."
                            },
                            {
                                "example_id": "a5a3531d-989f-44c2-9dc6-a5b9eae39e4f",
                                "sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                                "text": "Ce n’est pas la première fois (et pas la dernière) que le progrès technologique est remis en cause en raison d’une peur irrationnelle, elle-même engendrée par l’incertitude concernant les risques d’une technologie perçue comme invasive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43e08255-7004-4702-b32a-caf873a7e404",
                        "source_entry_id": "731f9ff6-2843-3449-bd47-60be4bdc13cd",
                        "source_sense_id": "a1e90a9c-95a4-3c65-b48d-e57087664f2d",
                        "target_lang_word": "technologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                        "entry_id": "6eb6f0b1-0be8-31fe-82d1-1febb4986b98",
                                        "glosses": [
                                            "die Technologie betreffend, auf die Technologie bezogen, in der Art und Weise der Technologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e042074-c92c-40d1-83d8-66c99dcd8f3b",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„Hinsichtlich anderer wichtiger technologischer Daten sei auf das Schrifttum verwiesen.“"
                                            },
                                            {
                                                "example_id": "627d2e22-3091-4249-baa0-cd5616e77b97",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„Von \"technologischen Predigten\" etwa darüber, ob das Netz oder der herkömmliche Arbeitsplatzcomputer die EDV bestimmen soll, hält er nichts.“"
                                            },
                                            {
                                                "example_id": "9bb3692d-8240-40c4-b21b-e2a26b897cdc",
                                                "sense_id": "b339473c-b7f1-362a-ad78-b4a3be2a1c48",
                                                "text": "„In einer solchen Zwangslage kann ein Unternehmen versuchen, mit technologischen Mitteln den Einsatz von Rohstoffen zu vermindern. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "053a0c87-0b09-45fd-a0fd-bd491df960fd",
                        "source_entry_id": "731f9ff6-2843-3449-bd47-60be4bdc13cd",
