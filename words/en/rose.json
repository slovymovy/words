                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a bottle of sparkling <w>rose</w> with our dinner.",
                            "target_lang_translations": {
