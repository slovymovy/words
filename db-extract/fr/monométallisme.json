                "senses": [
                    {
                        "sense_id": "d2144625-42cb-34e5-88b5-2b214a9e1278",
                        "entry_id": "0875dfae-2605-3faa-bb6f-6c6c553f868e",
                        "glosses": [
                            "Système monétaire d’après lequel un seul métal, l’or ou l’argent, sert d’étalon pour la monnaie, avec cours légal illimité."
                        ],
                        "tags": [
                            "Économie politique"
                        ],
                        "examples": [
                            {
                                "example_id": "4759b637-a7be-4c14-8945-b85da4194d71",
                                "sense_id": "d2144625-42cb-34e5-88b5-2b214a9e1278",
                                "text": "D’ailleurs, peu à peu, le bimétallisme disparaît partout pour faire place au monométallisme de droit ou de fait."
                            },
                            {
                                "example_id": "d58c0249-211b-4192-8432-ad8ccb58334a",
                                "sense_id": "d2144625-42cb-34e5-88b5-2b214a9e1278",
                                "text": "Le monométallisme est la doctrine économique d'après laquelle un métal unique doit servir à faire de la monnaie, par opposition au bimétallisme, qui admet plusieurs étalons."
                            }
                        ]
                    }
                ],
