                        "examples": [
                            {
                                "example_id": "de5ba0a6-e201-45ec-9c8a-797faa3c4e16",
                                "sense_id": "f87888bd-66ac-33c4-a174-a08cc8ac38ae",
                                "text": "Ze maakten een kampvuur en zongen liedjes.",
                                "translation": "They made a campfire and sang songs.",
                                "english": "They made a campfire and sang songs."
                            },
                            {
                                "example_id": "8102e12a-a1d8-4b0a-8f9e-5f795ed2fb24",
                                "sense_id": "f87888bd-66ac-33c4-a174-a08cc8ac38ae",
                                "text": "We roosterden marshmallows boven het kampvuur.",
                                "translation": "We roasted marshmallows over the campfire.",
                                "english": "We roasted marshmallows over the campfire."
                            },
                            {
                                "example_id": "b4878e60-f4c3-411b-95d5-48556dea88db",
                                "sense_id": "f87888bd-66ac-33c4-a174-a08cc8ac38ae",
                                "text": "Het kampvuur brandde helder in de nacht.",
                                "translation": "The campfire burned brightly in the night.",
                                "english": "The campfire burned brightly in the night."
                            }
                        ]
                    }
