                "senses": [
                    {
                        "sense_id": "8aa0b8f9-3d48-3c48-a3a6-54c259f19267",
                        "entry_id": "4e202e3f-9996-373f-8df0-8f8824843cd4",
                        "glosses": [
                            "Faire perdre son caractère acadien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04590b61-6837-4738-b8c9-645ff03f9008",
                                "sense_id": "8aa0b8f9-3d48-3c48-a3a6-54c259f19267",
                                "text": "Le cadien – un parler acadien «désacadianisé»?"
                            },
                            {
                                "example_id": "47a9dc3d-188c-4c26-b520-b4e785bc448e",
                                "sense_id": "8aa0b8f9-3d48-3c48-a3a6-54c259f19267",
                                "text": "Marguerite à Potte est-elle « désacadianisée » en adoptant un nouvel espace (les États-Unis)?"
                            },
                            {
                                "example_id": "bbb5ebaf-de87-4329-bb85-eeeea9720ab2",
                                "sense_id": "8aa0b8f9-3d48-3c48-a3a6-54c259f19267",
                                "text": "Les années 1980 sont une décennie de malaise pour de nombreux Acadiens et l'exposition Acadia Nova, organisée en 1981, survient au début d'une période où les artistes désacadianisent leur œuvre, car, selon Philippe Doucet, « l'enfant, qu'était l'Acadie pendant plusieurs siècles, a maintenant franchi le stage de son adolescence »."
                            }
                        ]
                    }
