{
    "word_family": [
        "backslider",
        "backsliding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98d0ab15-4199-37dd-82ea-aa91119e08c2",
                    "sense_definition": "To regress or revert to a previous, worse state or habit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "regress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt better for a while, before his health started to <w>backslide</w>.",
                            "target_lang_translations": {
                                "ru": "Какое-то время он чувствовал себя лучше, пока его здоровье не начало снова <w>ухудшаться</w>."
                            }
                        },
                        {
                            "text": "After months of healthy eating, she began to <w>backslide</w> into old junk food habits.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев здорового питания она начала <w>скатываться</w> к старым привычкам есть вредную еду."
                            }
                        }
                    ],
                    "synonyms": [
                        "retrograde"
                    ],
                    "common_phrases": [
                        "start to backslide",
                        "backslide into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться к прежнему, худшему состоянию или привычкам; регрессировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скатываться",
                                "target_lang_sense_clarification": "к прежним плохим привычкам или состоянию"
                            },
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "к старому, худшему образу жизни"
                            },
                            {
                                "target_lang_word": "регрессировать",
                                "target_lang_sense_clarification": "ухудшаться, идти назад в развитии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420b5547-c822-3970-95dc-5b50281498b8",
                    "sense_definition": "To renege on obligations, promises, or commitments; to fail to maintain progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics accused the government of <w>backsliding</w> on its environmental pledges.",
                            "target_lang_translations": {
                                "ru": "Критики обвинили правительство в <w>отступлении</w> от экологических обязательств."
                            }
                        },
                        {
                            "text": "The international community warned the nation not to <w>backslide</w> on its democratic reforms.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество предостерегло страну от <w>отката</w> в демократических реформах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "backslide on commitments",
                        "backslide on promises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отступать от взятых обязательств, обещаний или достигнутого прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "от обещаний или обязательств"
                            },
                            {
                                "target_lang_word": "сдавать позиции",
                                "target_lang_sense_clarification": "терять достигнутый прогресс"
                            },
                            {
                                "target_lang_word": "откатываться назад",
                                "target_lang_sense_clarification": "в реформах или договорённостях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7721a8a-bd1f-3062-9c2c-2d517bbc374e",
                    "sense_definition": "To relapse into bad, sinful, or unfaithful behavior after religious conversion or reform.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned his congregation against the temptation to <w>backslide</w> into their former ways.",
                            "target_lang_translations": {
                                "ru": "Проповедник предостерёг прихожан от искушения <w>вернуться к греховному</w> прошлому."
                            }
                        },
                        {
                            "text": "After years of devout practice, he began to <w>backslide</w> and stopped attending services altogether.",
                            "target_lang_translations": {
                                "ru": "После долгих лет ревностной веры он начал <w>отходить от религии</w> и вовсе перестал посещать службы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Впадать в грех или отступать от веры и праведного поведения после обращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпадать от веры",
                                "target_lang_sense_clarification": "возвращаться к греховной жизни"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "от религиозных принципов"
                            },
                            {
                                "target_lang_word": "впадать в грех",
                                "target_lang_sense_clarification": "снова грешить после покаяния"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a463a02-df3b-3b68-9daf-0b76718a459e",
                    "sense_definition": "A backward regression or relapse to an inferior or worse state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden increase in inflation marked a serious <w>backslide</w> for the recovering economy.",
                            "target_lang_translations": {
                                "ru": "Внезапный рост инфляции стал серьёзным <w>откатом назад</w> для восстанавливающейся экономики."
                            }
                        },
                        {
                            "text": "Doctors observed a slight <w>backslide</w> in the patient's mobility after the therapy was reduced.",
                            "target_lang_translations": {
                                "ru": "Врачи отметили небольшое <w>ухудшение</w> подвижности пациента после сокращения терапии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регресс, откат или возврат к худшему состоянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откат",
                                "target_lang_sense_clarification": "возврат назад, регресс"
                            },
                            {
                                "target_lang_word": "регресс",
                                "target_lang_sense_clarification": "ухудшение, движение назад"
                            },
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "спад показателей или состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46a27e9d-0248-3a2c-b8ee-e11e0ac76a2d",
                    "sense_definition": "A dance move where the dancer slides the feet back while lifting the heels, giving the illusion of walking forward while travelling backward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before it was popularized as the moonwalk, street dancers called the movement the <w>backslide</w>.",
                            "target_lang_translations": {
                                "ru": "До того как это движение стало популярным под названием «лунная походка», уличные танцоры называли его <w>бэкслайдом</w>."
                            }
                        },
                        {
                            "text": "He practiced the smooth gliding technique of the <w>backslide</w> in front of the mirror.",
                            "target_lang_translations": {
                                "ru": "Он отрабатывал перед зеркалом технику плавного скольжения в <w>лунной походке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moonwalk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Танцевальное движение со скольжением стопами назад при приподнятых пятках (оригинальное название «лунной походки»)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бэкслайд",
                                "target_lang_sense_clarification": "название танцевального элемента"
                            },
                            {
                                "target_lang_word": "лунная походка",
                                "target_lang_sense_clarification": "популярное название движения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}