{
    "word_family": [
        "gaan",
        "ontgang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "adeef200-24e2-356b-8927-04105f9bbca4",
                    "sense_definition": "niet opgemerkt worden door iemand of aan iemands aandacht ontsnappen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een aantal vandalistische wijzigingen waren iedereen <w>ontgaan</w>.",
                            "target_lang_translations": {
                                "en": "A number of vandalistic changes had <w>escaped</w> everyone's notice."
                            }
                        },
                        {
                            "text": "Het was ijdele hoop dat dit detail u zou <w>ontgaan</w>.",
                            "target_lang_translations": {
                                "en": "It was vain hope that this detail would <w>elude</w> you."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsnappen",
                        "missen"
                    ],
                    "antonyms": [
                        "opvallen"
                    ],
                    "common_phrases": [
                        "de aandacht ontgaan",
                        "niet kunnen ontgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to go unnoticed by someone or to escape someone's attention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "escape",
                                "target_lang_sense_clarification": "to elude someone's notice or memory"
                            },
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "to fail to notice or see something"
                            },
                            {
                                "target_lang_word": "elude",
                                "target_lang_sense_clarification": "to fail to be grasped or remembered by someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "277a5f37-0551-35d8-9eb0-319e90a79d10",
                    "sense_definition": "iets of iemand weten te vermijden of eraan ontsnappen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief wist de politie te <w>ontgaan</w> door een smal steegje in te rennen.",
                            "target_lang_translations": {
                                "en": "The thief managed to <w>evade</w> the police by running into a narrow alley."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn straf te <w>ontgaan</w> door naar het buitenland te vluchten.",
                            "target_lang_translations": {
                                "en": "He tried to <w>escape</w> his punishment by fleeing abroad."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontwijken",
                        "vermijden",
                        "ontvlieden"
                    ],
                    "antonyms": [
                        "ondergaan",
                        "treffen"
                    ],
                    "common_phrases": [
                        "je lot ontgaan",
                        "de dans ontgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to manage to avoid or escape something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evade",
                                "target_lang_sense_clarification": "to escape or avoid by cleverness or deceit"
                            },
                            {
                                "target_lang_word": "escape",
                                "target_lang_sense_clarification": "to avoid an unpleasant person, thing, or situation"
                            },
                            {
                                "target_lang_word": "avoid",
                                "target_lang_sense_clarification": "to keep away from or stop oneself from doing something"
                            },
                            {
                                "target_lang_word": "flee",
                                "target_lang_sense_clarification": "to run away from a place or situation of danger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6660b2f8-7af2-3ff9-8d75-d2c551a6d141",
                    "sense_definition": "voltooid deelwoord van <w>ontgaan</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is mij volledig <w>ontgaan</w> dat de vergadering was verzet naar morgen.",
                            "target_lang_translations": {
                                "en": "It completely <w>escaped</w> me that the meeting had been moved to tomorrow."
                            }
                        },
                        {
                            "text": "Zijn die subtiele opmerkingen jou ook <w>ontgaan</w> tijdens het gesprek?",
                            "target_lang_translations": {
                                "en": "Did those subtle remarks also <w>escape</w> you during the conversation?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'ontgaan', used to describe something that has been missed or escaped notice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "escaped",
                                "target_lang_sense_clarification": "having gone unnoticed or been avoided"
                            },
                            {
                                "target_lang_word": "missed",
                                "target_lang_sense_clarification": "having been overlooked or not noticed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}