                "senses": [
                    {
                        "sense_id": "fe5e4765-719b-3064-842a-671d7bd35e0c",
                        "entry_id": "a1e9543a-cb7a-342a-b105-150ee44ef46e",
                        "glosses": [
                            "Teilsatz, der durch ein Pronomen oder Pronominaladverb eingeleitet wird"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "544b75a7-9e19-441e-aed5-06831b212d12",
                                "sense_id": "fe5e4765-719b-3064-842a-671d7bd35e0c",
                                "text": "Der Satz: \"Peter, den ich erst gestern sah, liegt im Krankenhaus\" enthält den Pronominalsatz \"den ich erst gestern sah\". Dieser Pronominalsatz dient wie viele andere auch als Attribut."
                            },
                            {
                                "example_id": "4356d8e9-2dce-4dfe-8d91-93d924bd6076",
                                "sense_id": "fe5e4765-719b-3064-842a-671d7bd35e0c",
                                "text": "Der Satz: \"Das Loch, worin man die Funde entdeckte, erwies sich zunächst als zu tief\" enthält einen Pronominalsatz, der mit einem Pronominaladverb (\"worin\") eingeleitet wird."
                            },
                            {
                                "example_id": "bc9225f8-102b-4660-950c-23cf83d38b44",
                                "sense_id": "fe5e4765-719b-3064-842a-671d7bd35e0c",
                                "text": "Die Begriffe Relativsatz und Pronominalsatz unterscheiden sich dadurch, dass der erstere die grammatische Relation zu einer Bezugseinheit betont, während der andere die Art des Einleitewortes herausstellt."
                            },
                            {
                                "example_id": "2552add7-5ec0-4455-9817-7b77e29555dd",
                                "sense_id": "fe5e4765-719b-3064-842a-671d7bd35e0c",
                                "text": "„Pronominalsätze sind Nebensätze, die durch Relativ- und Interrogativpronomen (…) oder entsprechende Pronominaladverbien (…) eingeleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
