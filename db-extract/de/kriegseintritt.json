                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e68522-2880-4277-8ee7-2b2580c8477c",
                                "sense_id": "99b9033e-6180-3f11-86f3-1bca052225ac",
                                "text": "„Obwohl Italien bei Kriegseintritt erheblich mehr Uboote als Deutschland besaß, war die »Regia Marina« (Königliche Marine) nicht in der Lage, die Seeherrschaft im Mittelmeer zu erringen.“"
                            },
                            {
                                "example_id": "c23bc173-6205-49a6-9b3e-306bb511ef4c",
                                "sense_id": "99b9033e-6180-3f11-86f3-1bca052225ac",
                                "text": "„Die Gespräche drehten sich hauptsächlich um den in Bälde vorgesehenen Kriegseintritt Frankreichs und Englands.“"
                            }
                        ],
