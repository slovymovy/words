                "senses": [
                    {
                        "sense_id": "dcacb253-b7fe-38ac-9fa9-462fb72ddf29",
                        "entry_id": "7f401bdb-793c-34bd-991e-72c7b8c0d908",
                        "glosses": [
                            "Relatif à Zapata, au zapatisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69b78fc-8b14-4d86-88e6-01de2e155426",
                                "sense_id": "dcacb253-b7fe-38ac-9fa9-462fb72ddf29",
                                "text": "Les troupes zapatistes ont affronté l'armée gouvernementale."
                            },
                            {
                                "example_id": "6bda8e3e-48c6-4f25-9a5e-c51095556ea6",
                                "sense_id": "dcacb253-b7fe-38ac-9fa9-462fb72ddf29",
                                "text": "Fondée en 1983 comme un classique foyer de guérilla, l’Armée zapatiste de libération nationale (AZLN), devenue l’organisation politique et militaire de centaines de communautés indiennes, inaugure ainsi un cycle de résistance aux effets de la mondialisation néolibérale, avec l’émergence d’un mouvement « altermondialiste » qui se structure à l’occasion du sommet de l’OMC à Seattle, en 1999."
                            },
                            {
                                "example_id": "527db606-ed3f-4490-9d34-824a141ce892",
                                "sense_id": "dcacb253-b7fe-38ac-9fa9-462fb72ddf29",
                                "text": "Je reconnais que le mouvement zapatiste est peu actif dans la métropole, mais quand même, une cagoule devrait être un accessoire facile à trouver dans tout magasin qui se respecte!"
                            }
                        ]
                    }
                ],
