                "senses": [
                    {
                        "sense_id": "11e26ff5-98e6-3f18-af09-c76291dd59f8",
                        "entry_id": "6220fd3e-23b5-3084-9cc1-c153fc9a660a",
                        "glosses": [
                            "Weissagung durch göttliche Eingebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a23cdcb-e04e-44e7-8c4e-7a3d4189d6ab",
                                "sense_id": "11e26ff5-98e6-3f18-af09-c76291dd59f8",
                                "text": "Theomantie, aus dem Griechischen, diejenige Wahrsagung, wo die Menschen durch Gott selbst in zukünftige Dinge eingeweihet, und ihnen die Weissagung eingegeben worden."
                            },
                            {
                                "example_id": "095104a4-19cf-4521-9883-21ce755d54be",
                                "sense_id": "11e26ff5-98e6-3f18-af09-c76291dd59f8",
                                "text": "Zur Theomantie gehörten immer Waschungen, Räucherungen, außerordentliche Vorbereitungen, Entzückungen und Verzuckungen. Ja die Theomanten verfielen gewöhnlich in ein Dilirium."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
