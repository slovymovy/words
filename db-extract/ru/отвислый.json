                        "entry_id": "ab861b59-40b9-35e9-ab7f-7068e34a9c29",
                        "glosses": [
                            "опустившийся, оттянувшийся книзу; отвисший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d22abd-eb78-46e3-8cda-faef9725f5ef",
                                "sense_id": "cc743037-2b87-355d-94c6-9e195e98358d",
                                "text": "Графиня сидела вся жёлтая, шевеля отвислыми губами, качаясь направо и налево."
                            },
                            {
                                "example_id": "12e81f20-9287-49db-9106-bf7a3c9ad29c",
                                "sense_id": "cc743037-2b87-355d-94c6-9e195e98358d",
                                "text": "Нос царя был мясист, кадык отвисл и лоб низок."
                            }
                        ]
                    }
