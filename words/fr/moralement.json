                        "moralement condamnable"
                    ]
                },
                {
                    "sense_id": "bbe6f377-f3b6-3e1f-b82e-6034fd2a1118",
                    "sense_definition": "Sur le plan psychologique, mental ou spirituel, par opposition au corps physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue épreuve difficile, il se sentait complètement <w>moralement</w> épuisé."
                        },
                        {
                            "text": "Ce soutien constant l'a beaucoup aidée à tenir le coup <w>moralement</w>."
                        }
                    ],
                    "synonyms": [
                        "mentalement",
                        "psychologiquement"
                    ],
                    "antonyms": [
                        "physiquement"
                    ],
                    "common_phrases": [
