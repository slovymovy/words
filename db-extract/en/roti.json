                "senses": [
                    {
                        "sense_id": "2d45f122-8477-3dfe-a423-7c2ffebaba9d",
                        "entry_id": "1e2e8782-edaa-352b-925b-cf317c201de1",
                        "glosses": [
                            "A kind of unleavened flatbread commonly consumed in South Asia and the Caribbean."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "37623c55-9b84-4ec0-8822-38a724eea739",
                                "sense_id": "2d45f122-8477-3dfe-a423-7c2ffebaba9d",
                                "text": "Along the sidewalks, hundreds of vendors hawked everything from commemorative T-shirts to rum to roti, the breadlike Caribbean pastry stuffed with pungently barbecued goat or chicken."
                            },
                            {
                                "example_id": "27c70717-425f-4814-9c5a-7648fe05df22",
                                "sense_id": "2d45f122-8477-3dfe-a423-7c2ffebaba9d",
                                "text": "Nepalis eat sweet fried rice-flour doughnuts called sel roti."
                            }
                        ]
                    }
                ],
