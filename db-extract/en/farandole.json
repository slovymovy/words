                                        "entry_id": "5e78e96b-0cd2-375c-902b-bb37b99bf22b",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe farandoler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e618805d-6695-4fe0-be6b-9d30225e046e",
                                                "sense_id": "59b301c4-7bde-399f-aa27-237fdb742fc4",
                                                "text": "Elle farandole avec mes amis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d589ab1-00d1-3e04-aa84-a1d278422b86",
                                        "entry_id": "5e78e96b-0cd2-375c-902b-bb37b99bf22b",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent du verbe farandoler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a82f0fe-7e91-4537-a62e-befcbdc416c9",
                                                "sense_id": "8d589ab1-00d1-3e04-aa84-a1d278422b86",
                                                "text": "Acceptera-t-on que je farandole avec vous tous?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399cec34-db85-3cb4-988b-97830a3f9646",
                                        "entry_id": "5e78e96b-0cd2-375c-902b-bb37b99bf22b",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent du verbe farandoler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af2bb4a-994c-4225-85aa-4e519d3f8ff8",
                                                "sense_id": "399cec34-db85-3cb4-988b-97830a3f9646",
                                                "text": "Nous aimerions qu'elle farandole avec nous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6322f8a-088b-3a74-994d-3325d5394c52",
                                        "entry_id": "5e78e96b-0cd2-375c-902b-bb37b99bf22b",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif du verbe farandoler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9960cf86-16f7-49c5-be18-798341c7db56",
                                                "sense_id": "a6322f8a-088b-3a74-994d-3325d5394c52",
                                                "text": "Va, cours, farandole, et nous venge. — (Pastiche de la pièce Le Cid)"
                                            }
                                        ]
                                    }
                                ]
                            }
