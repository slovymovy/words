                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b6c5cc0-2180-4c50-a02c-d39a59196b6c",
                        "source_entry_id": "fb87702a-eb99-33e8-96af-e3ebaa8ea00f",
                        "source_sense_id": "6f327b56-a536-33c9-a78e-5d6e696d7fb6",
                        "target_lang_word": "fureur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc91381b-674b-39da-8885-7013c6610450",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Égarement d’esprit qui tient de la rage et de la frénésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01eac40-9632-40d9-b2f0-d680a092f744",
                                                "sense_id": "cc91381b-674b-39da-8885-7013c6610450",
                                                "text": "Il est devenu fou, et de temps en temps il lui prend des accès de fureur."
                                            },
                                            {
                                                "example_id": "79a0fcf0-5ad5-4404-8108-773d6bd630df",
                                                "sense_id": "cc91381b-674b-39da-8885-7013c6610450",
                                                "text": "Personne n’ose l’approcher lorsque la fureur le prend."
                                            },
                                            {
                                                "example_id": "4936e27a-a4be-4845-ad01-54893eef2127",
                                                "sense_id": "cc91381b-674b-39da-8885-7013c6610450",
                                                "text": "Vous avez, dit-il en baissant la voix, des fureurs qui ressemblent à des jalousies ; savez-vous cela, milord ? or, ces jalousies, à propos d’une femme, ne vont point à quiconque n’est ni son amant, ni son époux"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff040a64-1ecb-3c88-8b07-70353e2bff6a",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Extrême colère."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0151ab4d-27a1-42cf-b254-a9c43e5ff11d",
                                                "sense_id": "ff040a64-1ecb-3c88-8b07-70353e2bff6a",
                                                "text": "Au moindre geste d’improbation, il nous apostrophait et nous imposait silence avec une fureur qui nous touchait sans nous convaincre ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50aab84-3fdd-3ce3-8ccd-35912af02793",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Colère de Dieu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9bd87c-2abc-4f48-98bd-c8e758c9c32b",
                                                "sense_id": "e50aab84-3fdd-3ce3-8ccd-35912af02793",
                                                "text": "Seigneur, ne me reprenez pas dans votre fureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88d5bce-f8db-3807-86ab-2ced1e29b3d5",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Émotion et agitation violente qui s’empare d’un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b5ea7a-b64b-431b-8272-f0d851da3562",
                                                "sense_id": "e88d5bce-f8db-3807-86ab-2ced1e29b3d5",
                                                "text": "Un lion en fureur. — La fureur d’un taureau."
                                            },
                                            {
                                                "example_id": "a5a8d553-4070-4cac-a846-aedc4b9493dc",
                                                "sense_id": "e88d5bce-f8db-3807-86ab-2ced1e29b3d5",
                                                "text": "Mettre un taureau en fureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Agitation violente de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d52b24-1b22-4b9c-b2e8-c1c9cc76c3b4",
                                                "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                                                "text": "Ce ne sont que des rochers à pic contre lesquels la mer se brise avec fureur : les vents et les vagues les ont façonnés en pyramides, en tours, en cavernes, en arcades; d'innombrables oiseaux de mer animent le paysage."
                                            },
                                            {
                                                "example_id": "40738d0c-6b46-45c6-86ff-a41b10f118c2",
                                                "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                                                "text": "Les ravages faits dans les principaux États producteurs de coton par le ver du cotonnier (Aletia xylina. Say.) leur ont occasionné, dans les moments où ce fléau sévissait avec la plus grande fureur, une perte annuelle de 150 millions de francs, […]."
                                            },
                                            {
                                                "example_id": "2a10d83a-e246-40e2-b39a-25333655a742",
                                                "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                                                "text": "Comme ce sont les dernières mesures de l’ouverture, l’orchestre est en pleine fureur. Les musiciens, sachant qu’ils vont pouvoir se reposer, donnent tout leur souffle. C’est une grande marée dans un ouragan."
                                            },
                                            {
                                                "example_id": "1a93b4c0-d4e8-43e5-9c82-15f9a9bb654e",
                                                "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                                                "text": "La fureur de la tempête, des flots, des vents, des flammes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61642d8c-1eae-3dcc-ab28-75d3611f0df3",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Habitude importune, nuisible, etc., que quelqu’un a de faire une certaine chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9dd96d-8fab-4182-bc0d-3844ddb42ea8",
                                                "sense_id": "61642d8c-1eae-3dcc-ab28-75d3611f0df3",
                                                "text": "Il a la fureur de se mêler des affaires des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37988421-8f95-301c-abcf-f60713b38d1d",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Transport qui élève l’esprit au-dessus de lui-même et qui fait faire ou dire des choses extraordinaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262ba2e6-ec73-46ee-985f-e79234e53c13",
                                                "sense_id": "37988421-8f95-301c-abcf-f60713b38d1d",
                                                "text": "Elle livrait un culte magnifique à l’érotisme, dans une sexualité débordante qui constituait pour elle la vraie musique de l'être, la fureur et l’enchantement pour \" inouïr \" la vie. Géraldine B. aimait les hommes et ceux-ci le lui rendaient à merveille."
                                            },
                                            {
                                                "example_id": "f486b80f-5db1-40e2-9642-14aca26dae65",
                                                "sense_id": "37988421-8f95-301c-abcf-f60713b38d1d",
                                                "text": "Fureur prophétique. — Fureur bachique. — Fureur poétique. — Une sainte fureur s’empara de lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139270b8-9aae-301e-8160-b7894cdb90e9",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Passion excessive, démesurée pour une personne ou pour une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78ea724-7980-435c-816d-bcae6d510657",
                                                "sense_id": "139270b8-9aae-301e-8160-b7894cdb90e9",
                                                "text": "Il aime cette femme à la fureur, avec fureur."
                                            },
                                            {
                                                "example_id": "0725f286-df27-409f-b322-272b986ac555",
                                                "sense_id": "139270b8-9aae-301e-8160-b7894cdb90e9",
                                                "text": "Il a la fureur du jeu."
                                            },
                                            {
                                                "example_id": "4e886e76-8569-42d3-974d-f29be285ae28",
                                                "sense_id": "139270b8-9aae-301e-8160-b7894cdb90e9",
                                                "text": "C’est un homme extrême en toutes choses, il aime et il hait jusqu’à la fureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d2c88c-7ba7-37dd-a7a3-9b3a1f4e1098",
                                        "entry_id": "abc600d8-24d3-395a-9ea7-2d66d6435312",
                                        "glosses": [
                                            "Transports frénétiques, emportement, excès auxquels on se livre dans la fureur, dans la colère, etc."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2339567e-ae1b-40c8-bc4a-09a066e435ee",
                                                "sense_id": "07d2c88c-7ba7-37dd-a7a3-9b3a1f4e1098",
                                                "text": "Les fureurs de l’amour. — Les fureurs du désespoir."
                                            },
                                            {
                                                "example_id": "dc3e7b4d-8831-4f9e-b536-26aefb604e35",
                                                "sense_id": "07d2c88c-7ba7-37dd-a7a3-9b3a1f4e1098",
                                                "text": "Les fureurs de la guerre civile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ed7d100-dfdf-46b1-b6e9-38b77f86881e",
                        "source_entry_id": "fb87702a-eb99-33e8-96af-e3ebaa8ea00f",
                        "source_sense_id": "6f327b56-a536-33c9-a78e-5d6e696d7fb6",
                        "target_lang_word": "engouement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engouement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                        "entry_id": "d32617ed-6e71-30c5-9b66-13f7ec86a569",
                                        "glosses": [
                                            "Action de s’engouer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dee4379-abfd-47e9-bc53-383063dc9795",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "La popularité du prince Louis-Napoléon leur parut un engouement passager de la foule dont on aurait facilement raison."
                                            },
                                            {
                                                "example_id": "08809f10-3674-41fa-843c-a61a52e069c6",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "L’engouement pour l’aéronautique commençait."
                                            },
                                            {
                                                "example_id": "85fc55ef-3f7a-4ac0-9ebf-c7a4da1d5c36",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "La soie artificielle. […]. Elle jouit donc d’une place de faveur et d’un certain engouement."
                                            },
                                            {
                                                "example_id": "24cadd7f-75d6-4d5c-b390-61fff9b516ee",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "Pourtant, comme tous les engouements semblables, la francophilie est un phénomène à sens unique. Un groupe national manifestant un tel penchant affectif, intellectuel ou politique n'obtient pas, en retour, de la grande puissance honorée une meilleure connaissance de ses réalités."
                                            },
                                            {
                                                "example_id": "d4d80b72-304a-47dc-b228-7fc2c5a475c9",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "Dans l’ensemble les jeunes ne l’intéressaient plus tellement, ses étudiants étaient d’un niveau intellectuel effroyablement bas, on pouvait même se demander, parfois, ce qui les avait poussés à entreprendre des études. La seule réponse, au fond d’elle-même elle le savait, était qu’ils voulaient gagner de l’argent, le plus d’argent possible ; malgré quelques engouements humanitaires de courte durée, c’était la seule chose qui les animait réellement."
                                            },
                                            {
                                                "example_id": "d69a6c8e-297a-458b-9011-d21c164d06d8",
                                                "sense_id": "aacd29d3-441e-3925-8149-a780576ce51c",
                                                "text": "Mais Barreto s’attaque aussi à un nouveau phénomène urbain, à l’engouement des masses pour un sport envahissant, le football, dont il pressent le pouvoir d’aliénation, avec ce qu’il charrie de traficotage et de violence. Il ne se doute pas que la maladie deviendra planétaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
