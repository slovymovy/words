                        "cross_references": [
                            {
                                "target_word": "яичник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4c716cde-e968-3a66-8b8f-f79e790ab8f1",
                                        "entry_id": "1eaf6311-8e9a-3023-ad02-555ac97b56a0",
                                        "glosses": [
                                            "анат. парная женская половая железа у млекопитающих животных и человека, расположенная в полости малого таза по обе стороны от матки, в которой созревают яйцеклетки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e28f80e-6f6b-4ad8-9cec-f9420ca98513",
                                                "sense_id": "4c716cde-e968-3a66-8b8f-f79e790ab8f1",
                                                "text": "Яичник ― это пара небольших миндалевидных образований, «подвешенных» с помощью связок справа и слева от матки."
                                            },
