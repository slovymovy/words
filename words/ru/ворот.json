                    "sense_id": "e17c3d46-72e7-38ca-8809-919a6032497b",
                    "sense_definition": "Форма родительного падежа множественного числа существительного <w>ворота</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Возле <ворот> нашего дома остановилась большая чёрная машина.",
                            "target_lang_translations": {
                                "en": "A big black car stopped near the <gates> of our house.",
                                "de": "In der Nähe des <w>Tors</w> unseres Hauses hielt ein großes schwarzes Auto an."
                            }
                        },
                        {
                            "text": "Футбольный мяч пролетел в нескольких сантиметрах от <ворот>.",
                            "target_lang_translations": {
                                "en": "The soccer ball flew a few centimeters from the <goal>.",
                                "de": "Der Fußball flog wenige Zentimeter am <w>Tor</w> vorbei."
                            }
                        }
                    ],
                    "common_phrases": [
                        "у ворот",
                        "возле ворот",
                        "до ворот"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive plural form of the noun 'ворота' (gates, goal)",
                        "de": "Genitiv-Plural-Form des Substantivs 'ворота' (Tore, Tor)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gates",
                                "target_lang_sense_clarification": "entrance or barrier"
                            },
                            {
                                "target_lang_word": "goal",
                                "target_lang_sense_clarification": "sports"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Tore",
                                "target_lang_sense_clarification": "Plural von Tor (Eingang oder Fußballtor)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768497d5-0336-3a10-a20b-34209604efa4",
                    "sense_definition": "Вырез в одежде для шеи или пришитая полоса ткани, облегающая шею",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мужчина расстегнул тесный <ворот> рубашки и глубоко вздохнул.",
                            "target_lang_translations": {
                                "en": "The man unbuttoned the tight <collar> of his shirt and took a deep breath.",
                                "de": "Der Mann knöpfte den engen <w>Kragen</w> seines Hemdes auf und holte tief Luft."
                            }
                        },
                        {
                            "text": "В сильный мороз лучше поднять <ворот> пальто, чтобы не простудиться.",
                            "target_lang_translations": {
                                "en": "In severe frost, it is better to raise the coat <collar> so as not to catch a cold.",
                                "de": "Bei starkem Frost ist es besser, den <w>Kragen</w> des Mantels hochzuschlagen, um sich nicht zu erkälten."
                            }
                        }
                    ],
                    "synonyms": [
                        "воротник"
                    ],
                    "common_phrases": [
                        "схватить за ворот",
                        "расстегнуть ворот",
                        "поднять ворот"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of a garment that fits around the neck",
                        "de": "Der Teil eines Kleidungsstücks, der den Hals umschließt; Kragen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "clothing part"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kragen",
                                "target_lang_sense_clarification": "Teil der Kleidung"
                            },
                            {
                                "target_lang_word": "Hemdkragen",
                                "target_lang_sense_clarification": "speziell bei Hemden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aabad9ed-9cd4-38fc-a345-3a46eadf55b9",
                    "sense_definition": "Простейшее грузоподъёмное устройство в виде вала с ручкой, на который наматывается канат",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строители использовали <ворот> для подъёма тяжёлых камней на стену.",
                            "target_lang_translations": {
                                "en": "The builders used a <windlass> to lift heavy stones onto the wall.",
                                "de": "Die Bauarbeiter benutzten eine <w>Winde</w>, um schwere Steine auf die Mauer zu heben."
                            }
                        },
                        {
                            "text": "Старый деревянный <ворот> у колодца громко скрипел при вращении.",
                            "target_lang_translations": {
                                "en": "The old wooden <windlass> by the well creaked loudly when rotating.",
                                "de": "Die alte hölzerne <w>Brunnenwinde</w> quietschte laut beim Drehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "колодезный ворот"
                    ],
                    "target_lang_definitions": {
                        "en": "A simple lifting device consisting of a rotating shaft with a handle",
                        "de": "Eine einfache Hebevorrichtung, bestehend aus einer rotierenden Welle mit einer Kurbel"
                    },
                    "translations": {
