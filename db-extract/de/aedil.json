                        "glosses": [
                            "niedriges Amt in der römischen Ämterlaufbahn, hauptsächlich Polizeibeamter, aber der Aufgabenbereich unterlag über die Jahrhunderte einem Wandel"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "5359e9ee-1337-4f22-9064-60064870ce79",
                                "sense_id": "1abe1951-3120-3b6b-9c6b-b608db6c5746",
                                "text": "„Im Jahr 33 v. Chr. wird er ins Amt des Aedilen gewählt, der für die Stadtentwicklung zuständig ist.“"
                            },
                            {
                                "example_id": "f5e3630b-ae1e-4f7b-a396-ad776490ca8f",
                                "sense_id": "1abe1951-3120-3b6b-9c6b-b608db6c5746",
                                "text": "„33 v. Chr. lässt Agrippa sich zum Aedilen wählen.“"
                            }
                        ],
