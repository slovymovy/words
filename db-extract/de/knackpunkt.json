                        ],
                        "form": "die Knackpunkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                        "entry_id": "879bb3bb-8f45-3e5d-9376-36cfeeb297a1",
                        "glosses": [
                            "entscheidender Aspekt, der über Erfolg oder Misserfolg einer Sache bestimmt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4c2e3baf-40b6-4f74-8146-fd985e5b5d88",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "Knackpunkt beim Brexit ist die Nordirlandfrage."
                            },
                            {
                                "example_id": "4c10d57b-639a-466b-8982-f48a6b102ccc",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Über den größten Knackpunkt wurde aber nicht einmal gesprochen.“"
                            },
                            {
                                "example_id": "d9ebed6c-1b0d-4ca9-ba0c-adf8dcd86e75",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Knackpunkt der Prüfung des Urteils durch den Oberstaatsanwalt Axel Goos ist offenbar die Beweiswürdigung des Landgerichts.“"
                            },
                            {
                                "example_id": "7013f4f2-3c1c-4085-8b96-98af1dda8eae",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Ein Knackpunkt für [Anmerkung: den Datenschutzbeauftragten Karsten] Neumann sind die aus seiner Sicht offenen Rechtsfragen bei der Video-Überwachung im Straßenverkehr.“"
                            },
                            {
                                "example_id": "e92e3ab7-f298-4814-9104-5508ab8f8601",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "«Der Datenschutz ist der Knackpunkt bei der Einführung des Patientendossiers», sagt Peter Fischer, Leiter des Kompetenzzentrums Informationssicherheit."
                            },
                            {
                                "example_id": "6bd90d95-e3e4-4775-b4df-86012ecce23f",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Wenn Frauen führen, sind Netzwerke wichtig. Selbstbewusstsein und Selbstvertrauen sind oft ein Knackpunkt.“"
                            },
                            {
                                "example_id": "df1e58a2-7396-405a-8c79-b9fd43738725",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Calibre, die Anwendung zur Verwaltung und Manipulation von E-Books, könnte bald […] aus Debian Testing entfernt werden. […] Knackpunkt ist die Entfernung von Python 2 aus Debian, […]“"
                            },
                            {
                                "example_id": "86a57999-ea45-4f10-9487-1a8e2a6f9b7d",
                                "sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                                "text": "„Wichtig [ist] ein bundesweites Tankstellennetz. Genau das ist auch der Knackpunkt, weshalb Brennstoffzellenautos bislang ein Nischenprodukt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9ee1913-a812-4d30-9811-89723c53125f",
                        "source_entry_id": "879bb3bb-8f45-3e5d-9376-36cfeeb297a1",
                        "source_sense_id": "5c3bfe5a-24ed-3ae9-b3e4-e9f9de088bf0",
                        "source_sense_description": "umgangssprachlich: entscheidender Aspekt, der über Erfolg oder Misserfolg einer Sache bestimmt",
                        "target_lang_word": "crux",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crux",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ead2d911-fd03-3a13-8481-5d56d34d446b",
                                        "entry_id": "879c375a-85e6-3ab8-9127-90b6f10d5925",
                                        "glosses": [
                                            "The basic, central, or essential point or feature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8590887a-cf4e-4b94-aca2-3578af157a1a",
                                                "sense_id": "ead2d911-fd03-3a13-8481-5d56d34d446b",
                                                "text": "The crux of her argument was that the roadways needed repair before anything else could be accomplished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c5c0a1-ec83-3e30-8dde-e888f6bdbf7b",
                                        "entry_id": "879c375a-85e6-3ab8-9127-90b6f10d5925",
                                        "glosses": [
                                            "The critical or transitional moment or issue, a turning point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa2849c-ffd5-44be-9d94-553be24139bf",
                                                "sense_id": "31c5c0a1-ec83-3e30-8dde-e888f6bdbf7b",
                                                "text": "The mad certitude of the ogre, Abel Tiffauges, that he stands at the crux of history and that he will be able to raise Prussia \"to a higher power\" (p. 180), contrasts sharply with the anxiety and doubt attendant upon most modern literary dreams."
                                            },
                                            {
                                                "example_id": "4bbee11a-5423-430b-8e52-4a512a7d5417",
                                                "sense_id": "31c5c0a1-ec83-3e30-8dde-e888f6bdbf7b",
                                                "text": "The movie hits its dramatic crux an hour in, when Reality [Winner], at work at the contractor’s facility in Georgia, discovers what she deems a tragic scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc085923-a0e3-38ca-a9dd-48358f07060a",
                                        "entry_id": "879c375a-85e6-3ab8-9127-90b6f10d5925",
                                        "glosses": [
                                            "A puzzle or difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ccb2fe-a8be-471f-8d4a-31fae7675c31",
                                                "sense_id": "dc085923-a0e3-38ca-a9dd-48358f07060a",
                                                "text": "What I have advanced upon this species of verse will contribute to solve a poetical problem, thrown out by Dryden as a crux to his brethren"
                                            },
                                            {
                                                "example_id": "bcb4fc95-6266-4158-855f-5e48c16cdc0d",
                                                "sense_id": "dc085923-a0e3-38ca-a9dd-48358f07060a",
                                                "text": "The perpetual crux of New Testament chronologists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04e19ea3-578d-339f-a044-637b931db0fd",
                                        "entry_id": "879c375a-85e6-3ab8-9127-90b6f10d5925",
                                        "glosses": [
                                            "The hardest point of a climb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edec7111-5fa5-4735-90e3-8648abaacf54",
                                                "sense_id": "04e19ea3-578d-339f-a044-637b931db0fd",
                                                "text": "the real crux of the climb was encountered"
                                            },
                                            {
                                                "example_id": "301cd408-9d66-48dd-97e3-8cbc2c7b30a8",
                                                "sense_id": "04e19ea3-578d-339f-a044-637b931db0fd",
                                                "text": "The final half-mile was the crux of the climb."
                                            },
                                            {
                                                "example_id": "de3202d2-4e0f-417b-bbf9-59ebde14e93d",
                                                "sense_id": "04e19ea3-578d-339f-a044-637b931db0fd",
                                                "text": "Most pitches have a distinct crux, or tough spot; some have multiple cruxes. […] ¶ Climb efficiently on the \"cruiser\" sections to stay fresh for the cruxes."
                                            },
                                            {
                                                "example_id": "033cadc3-06e6-41f4-b807-96c8f79deb8d",
                                                "sense_id": "04e19ea3-578d-339f-a044-637b931db0fd",
                                                "text": "Continue climbing the groove; the crux is passing some vegetation on the second pitch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8359447-b980-3f61-a74f-9b842ef9a9d2",
                                        "entry_id": "879c375a-85e6-3ab8-9127-90b6f10d5925",
                                        "glosses": [
                                            "A cross on a coat of arms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
