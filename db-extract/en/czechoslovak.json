                    {
                        "translation_id": "ebe0f7dc-6ac1-47d6-9188-b1e9937ac893",
                        "source_entry_id": "04c2045c-d0cf-3e68-820e-81af2ad9f933",
                        "source_sense_id": "294754f9-0cc2-3747-ae30-ab41fc92f9bd",
                        "source_sense_description": "pertaining to",
                        "target_lang_word": "tchécoslovaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchécoslovaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                        "entry_id": "5a0731ae-6b71-3897-8ae9-4ca2059d3722",
                                        "glosses": [
                                            "Relatif à la Tchécoslovaquie et à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a1e9f8-eff8-45ea-a3b4-7994c8f4af86",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Ah ! la bougresse ! Elle est maintenant entretenue par un banquier tchécoslovaque qui a réalisé une fortune colossale pendant la guerre dans les fournitures aux armées."
                                            },
                                            {
                                                "example_id": "b14bf61e-cd7b-49c3-8760-251dfe2c9a71",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Le 26 octobre prochain, une touchante cérémonie aura lieu à Chestres (Ardennes) (près de Vouziers). Un monument sera inauguré on souvenir des légionnaires tchécoslovaques morts en luttant pour le Droit et pour la Liberté."
                                            },
                                            {
                                                "example_id": "c53c6faa-c2ee-405c-aaca-856d876cae91",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Avec le régiment de marche de la Légion étrangère, les volontaires tchécoslovaques se battirent quatre fois sur la Somme, trois fois sur l'Aisne, trois fois en Champagne, deux fois sur l'Oise, en Artois, en Alsace, à Verdun et à Saint Mihiel. Le 9 mai 1915, près d'Arras, la compagnie « Nazdar » prit un grand nombre de tranchées ennemies."
                                            },
                                            {
                                                "example_id": "e09d89b6-0966-4c25-901f-91df60a33cd9",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "En France, les 21ᵉ et 22ᵉ régiments d'infanterie tchécoslovaque, formant la première brigade tchécoslovaque, résistent vaillamment sur l'Aisne aux attaques allemandes d'octobre 1918."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchécoslovaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42309081-9105-33f1-94ee-acca592f73dc",
                                        "entry_id": "676bc69c-b33a-3894-b16e-2593a02c37cf",
                                        "glosses": [
                                            "Concept sociolinguistique et construction politique utilisée en Tchécoslovaquie de 1920 à 1938 pour définir la langue officielle du pays réunissant les langues tchèque et slovaque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b91eff9d-24fd-4d5d-88ca-d385fabd45dd",
                        "source_entry_id": "04c2045c-d0cf-3e68-820e-81af2ad9f933",
                        "source_sense_id": "294754f9-0cc2-3747-ae30-ab41fc92f9bd",
