                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies <w>przestraszył</w> się hałasu i uciekł do ogrodu.",
                            "target_lang_translations": {
                                "en": "The dog <w>got scared</w> of the noise and ran away into the garden.",
                                "ru": "Собака <w>испугалась</w> шума и убежала в сад.",
                                "nl": "De hond <w>schrok</w> van het lawaai en vluchtte de tuin in.",
                                "de": "Der Hund <w>erschrak</w> vor dem Lärm und rannte in den Garten.",
                                "fr": "Le chien a <w>eu peur</w> du bruit et s'est enfui dans le jardin.",
                                "it": "Il cane si è <w>spaventato</w> per il rumore ed è scappato in giardino.",
                                "cs": "Pes se <w>polekal</w> hluku a utekl na zahradu.",
                                "tr": "Köpek gürültüden <w>korktu</w> ve bahçeye kaçtı.",
                                "es": "El perro <w>se asustó</w> por el ruido y huyó al jardín.",
                                "zh": "狗听见噪音<w>受了惊</w>，跑进了花园。"
                            }
                        },
                        {
                            "text": "Nigdy nie <w>przestraszyłeś</w> się ciemności, prawda?",
                            "target_lang_translations": {
                                "en": "You have never <w>been scared</w> of the dark, right?",
                                "ru": "Ты ведь никогда не <w>боялся</w> темноты, правда?",
                                "nl": "Je bent nooit <w>geschrokken</w> van het donker, toch?",
                                "de": "Du hast nie <w>Angst vor</w> der Dunkelheit <w>gehabt</w>, oder?",
                                "fr": "Tu n'as jamais <w>eu peur</w> du noir, n'est-ce pas ?",
                                "it": "Non ti sei mai <w>spaventato</w> del buio, vero?",
                                "cs": "Nikdy ses <w>nelekl</w> tmy, že ne?",
                                "tr": "Karanlıktan hiç <w>korkmadın</w>, değil mi?",
                                "es": "Nunca <w>te asustaste</w> de la oscuridad, ¿verdad?",
                                "zh": "你从来没有<w>害怕</w>过黑暗，对吧？"
                            }
                        }
