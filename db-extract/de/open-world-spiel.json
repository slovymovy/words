                ],
                "senses": [
                    {
                        "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                        "entry_id": "c260e744-531f-3daa-bd10-13e326338936",
                        "glosses": [
                            "Computer-/Videospiel, bei dem es dem Spieler möglich ist, die Spielwelt mit der von ihm gesteuerten Spielfigur (weitestgehend) frei und ohne Einschränkungen zu betreten beziehungsweise zu erkunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c0a0c8-04b7-4883-9689-040779979433",
                                "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                                "text": "„‚Destiny‘ ist nach Angaben der Entwickler als Open-World-Spiel gestaltet. Der Spieler soll die riesige Spielwelt frei erkunden können.“"
                            },
                            {
                                "example_id": "1013da7f-b753-42c3-aa56-6f4610cd3e85",
                                "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                                "text": "„‚Heutzutage fängt man bei einem Open-World-Spiel mit der Welt an[,] dann lässt man sich inspirieren und überlegt sich die Charaktere und die Story‘ […]“"
                            },
                            {
                                "example_id": "96d2224c-359e-4a1b-a889-e610706874d8",
                                "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                                "text": "„Der comichafte Cel-Shading-Look [von Crackdown 3] mag zwar nett sein, doch muss das Spiel erst noch beweisen, dass es das Häusermeer als Open-World-Spiel besser inszenieren kann als die Referenztitel Batman und Infamous.“"
                            },
                            {
                                "example_id": "2c1b410d-dc81-433e-8ad2-3e4732d88cf5",
                                "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                                "text": "„[Im] »Open-World-Spiel« [Minecraft] erschafft der Spieler eigene Welten und Landschaften, in denen er sich frei bewegen und seiner Kreativität freien Lauf lassen kann.“"
                            },
                            {
                                "example_id": "6b3d9501-d2c3-471c-91ba-160d07f0e07f",
                                "sense_id": "c669e676-fdc1-33dc-bc41-059cdac94bb8",
                                "text": "„‚No Man’s Sky‘ hat einen ganz eigenen Stil. Das Universum und seine Neonwelten, die wie eine Mischung aus Minecraft, Open-World-Spielen wie ‚Grand Theft Auto‘ oder ‚Dragon Age‘ und natürlich traditionellen Space-Simulationen wie ‚Elite‘ und ‚EVE Online‘ sind, wirken beruhigend und endlos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
