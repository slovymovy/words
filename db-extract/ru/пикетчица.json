                        "source_sense_id": "baf0b600-3ce9-36e6-b847-59c1c6c7afcb",
                        "target_lang_word": "protester",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protester",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d723c2-8239-3966-9b36-3e79ea020ff6",
                                        "entry_id": "217c0908-67a6-37b0-bb60-26f59fd90dd3",
                                        "glosses": [
                                            "One who protests, either alone or in a public display of group feeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c488519-db82-4f45-8e93-27d9337d272a",
                                                "sense_id": "b5d723c2-8239-3966-9b36-3e79ea020ff6",
                                                "text": "The protesters thronged Trafalgar Square and sang anti-war songs."
                                            },
                                            {
                                                "example_id": "2470dede-3a4f-43e0-abae-ba538ff35255",
                                                "sense_id": "b5d723c2-8239-3966-9b36-3e79ea020ff6",
                                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            },
                                            {
                                                "example_id": "e8307b05-4915-4753-a5dd-3685e6400187",
                                                "sense_id": "b5d723c2-8239-3966-9b36-3e79ea020ff6",
                                                "text": "“Don’t help elect Trump, you egotistical billionaire a**hole,” the protester yelled. “Go back to getting ratioed on Twitter. Go back to Davos with the other billionaire elites who think they know how to run the world. That’s not what democracy is.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b557327a-334c-3f64-afbb-f29bfd0676ba",
                                        "entry_id": "217c0908-67a6-37b0-bb60-26f59fd90dd3",
                                        "glosses": [
                                            "One who protests a bill of exchange, or note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db8a2ce-1cc8-445a-9bb1-839e05b7273c",
                                                "sense_id": "b557327a-334c-3f64-afbb-f29bfd0676ba",
                                                "text": "The protester must also draw up an affidavit containing the literal reproduction of the bill with its acceptance, endorsements, guarantee by endorsement (\"aval\"), and anything else contained in the note […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
