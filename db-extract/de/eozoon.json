                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9260d1c3-4947-36ad-bc6a-ea05b3716b1f",
                        "entry_id": "a2a5b99c-0e0d-3e4e-bc0a-276c6c8f1f63",
                        "glosses": [
                            "vermeintlicher Vertreter einer Gruppe fossiler Foramniferen, das der kanadische Geologe John William Dawson 1865 erstmals beschrieben hat; in Wirklichkeit ein Pseudofossil"
                        ],
                        "tags": [
                            "biologische Nomenklatur"
                        ],
                        "examples": [
                            {
                                "example_id": "3f2cc91a-7215-4d9c-aa74-0082504605c0",
                                "sense_id": "9260d1c3-4947-36ad-bc6a-ea05b3716b1f",
                                "text": "Eozoon ist das bekannteste Pseudofossil in der zweiten Hälfte des 19. Jahrhunderts."
                            },
                            {
                                "example_id": "4e319fe8-e385-416a-a9c5-ff2cb38c7f5b",
                                "sense_id": "9260d1c3-4947-36ad-bc6a-ea05b3716b1f",
                                "text": "„Wir meinen das Eozoon, das Morgenröthen-Thier, wie es in der Zuversicht, daß es ein Thier oder wenigstens ein organisches Wesen sei, von dem Entdecker Dawson genannt wurde. Der Name sollte bedeuten, daß es das älteste nunmehr bekannte organische Wesen sei und daß mit ihm, nach dem Stande unserer Kenntnisse, gleichsam die Morgenröthe der organischen Schöpfung anbreche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
