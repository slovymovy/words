                            }
                        },
                        {
                            "text": "The amoeba uses <w>phagocytosis</w> to ingest food particles from its environment.",
                            "target_lang_translations": {
                                "zh": "变形虫利用<w>胞吞作用</w>从环境中摄取食物颗粒。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
