                    },
                    {
                        "translation_id": "089141ff-3b63-47f8-b9da-ecbc69cd4527",
                        "source_entry_id": "5b965154-5cea-384f-b03f-4a8d2412336b",
                        "source_sense_description": "member of ethnic group",
                        "target_lang_word": "Afrikaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrikaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                        "entry_id": "3cf27fb0-066c-3131-9af6-74da60170e4c",
                                        "glosses": [
                                            "Sud-Africain blanc parlant l’afrikaans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfcf99a4-d1d5-45a5-8adc-9e6f3387342f",
                                                "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            },
                                            {
                                                "example_id": "8aff25d1-8cef-424c-87f0-a083c3ccc702",
                                                "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                                "text": "François Hugo était un Afrikaner, un descendant de ces premiers colons hollandais, français ou allemands, tous fervents calvinistes, qui avaient débarqué dans la baie de la Table, non loin du Cap de Bonne-Espérance au XVIIe siècle. Mais lui préférait se définir comme un Burgher, un Boer. Un paysan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a861000-0bd4-46c0-9e1b-10de924a092e",
                        "source_entry_id": "5b965154-5cea-384f-b03f-4a8d2412336b",
                        "source_sense_description": "member of ethnic group",
                        "target_lang_word": "Afrikaander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrikaander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fecfbfe-2817-3dbb-a0a1-bf3adeda0c07",
                                        "entry_id": "87474029-30a5-38d6-885d-49909efbf795",
                                        "glosses": [
                                            "in der Republik Südafrika oder im heutigen Namibia geborener, Afrikaans sprechender Weißer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484a2a63-5da7-4239-a1a1-4c7e438b97e7",
                                                "sense_id": "4fecfbfe-2817-3dbb-a0a1-bf3adeda0c07",
                                                "text": "Die Frage nach der Nähe des Afrikaander - Nationalismus zum Nationalsozialismus bedarf unseres Erachtens allerdings einer eingehenderen und differenzierten Betrachtung."
                                            },
                                            {
                                                "example_id": "bd0a7ea7-3193-4aa2-95c8-1df04d8f5836",
                                                "sense_id": "4fecfbfe-2817-3dbb-a0a1-bf3adeda0c07",
                                                "text": "Nach einer anderen Auffassung werden die Afrikaander als kulturell archaisch oder deviant charakterisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b9dee48-94cd-4271-b701-e3205d0bf0c0",
                        "source_entry_id": "5b965154-5cea-384f-b03f-4a8d2412336b",
                        "source_sense_description": "member of ethnic group",
                        "target_lang_word": "Bure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7fba73-be47-3b99-afff-699fb3c02936",
                                        "entry_id": "0c1b3a4d-7d51-3cf1-939b-6ef1d96e40cc",
                                        "glosses": [
                                            "Siedler, überwiegend niederländischer Herkunft, im Bereich des heutigen Südafrika und Namibia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcbfb10-bf3b-4b6e-8f87-02e1a5ab9bf7",
                                                "sense_id": "fc7fba73-be47-3b99-afff-699fb3c02936",
                                                "text": "„Lange schon hatte der Konflikt zwischen der britischen Kolonialmacht und den südafrikanischen Buren geschwelt, jenen Eroberern, die seit Ende des 17. Jahrhunderts ans Kap gekommen waren.“"
                                            },
                                            {
                                                "example_id": "e7fdb92a-8e44-4d84-b283-1f41dc09895e",
                                                "sense_id": "fc7fba73-be47-3b99-afff-699fb3c02936",
                                                "text": "„Dennoch wollen zahlreiche Buren die britische Herrschaft nicht akzeptieren.“"
                                            },
                                            {
                                                "example_id": "5cb129bb-e729-4578-aeda-185e5c0636aa",
                                                "sense_id": "fc7fba73-be47-3b99-afff-699fb3c02936",
                                                "text": "„Das erfuhr ich in der nächsten Stadt, Malmesbury, wo der Bus eine halbe Stunde Aufenthalt hatte, sodass ich mich mit einem der Buren unterhalten konnte, die auf der anderen Gangseite saßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
