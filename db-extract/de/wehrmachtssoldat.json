                "senses": [
                    {
                        "sense_id": "d7dc655c-7874-397a-bc72-025ce3a6d367",
                        "entry_id": "3260390a-82aa-38e8-881b-0d9125068fe8",
                        "glosses": [
                            "Soldat, der bei der Wehrmacht dient"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6ada28d4-f667-441c-b2e3-e5fce32cb56f",
                                "sense_id": "d7dc655c-7874-397a-bc72-025ce3a6d367",
                                "text": "„Die Deutschen bauten neben dem Bahnhof ein Feldlazarett für leicht verwundete Wehrmachtssoldaten.“"
                            },
                            {
                                "example_id": "4072e7de-209b-447e-9130-63a45b8ba571",
                                "sense_id": "d7dc655c-7874-397a-bc72-025ce3a6d367",
                                "text": "„Gegen Mittag machten wieder ein paar Wehrmachtssoldaten Halt in Götzlack und drängten die Gutsherrin, Haus und Hof so rasch wie möglich zu verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
