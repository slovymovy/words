                        "examples": [
                            {
                                "example_id": "9756865b-0bd9-473e-bc16-ce7d945a330d",
                                "sense_id": "259d1563-bd5f-3ea5-8dfd-861d6634cfb0",
                                "text": "Bol.com ziet dat klanten hun Sinterklaasinkopen eerder doen dan voorgaande jaren."
                            },
                            {
                                "example_id": "c9ae26b7-1e03-40c8-bd48-6678282a7eee",
                                "sense_id": "259d1563-bd5f-3ea5-8dfd-861d6634cfb0",
                                "text": "De meeste Sinterklaasinkopen worden nog altijd in winkels gedaan. \"Mensen willen het speelgoed voelen, in hun handen hebben voordat ze het kopen,\" zegt Peter Krenn van Blokker Holding, waar behalve Blokker ook speelgoedwinkels Intertoys, Bart Smit en Maxitoys onder vallen."
                            },
                            {
                                "example_id": "35e9cacb-e74a-4389-96ed-f4a6762b227c",
                                "sense_id": "259d1563-bd5f-3ea5-8dfd-861d6634cfb0",
                                "text": "König vraagt inwoners die morgen nog hun laatste sinterklaasinkopen willen doen, hun wekker te zetten en vroeg op de zaterdagmorgen naar de stad of de winkelcentra te komen."
                            }
                        ]
