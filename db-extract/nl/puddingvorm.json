                        "examples": [
                            {
                                "example_id": "e12056e9-3a45-454f-962f-05618c6c4421",
                                "sense_id": "9e955d24-c076-3eb9-90c8-2292be26b548",
                                "text": "Getrouwde vrouwen waren zo vast als drilpudding in een puddingvorm, terwijl oude vrijsters als ik vormeloos en onvoorspelbaar waren."
                            },
                            {
                                "example_id": "79861c0e-39ba-4577-8316-74d3c44f4c07",
                                "sense_id": "9e955d24-c076-3eb9-90c8-2292be26b548",
                                "text": "Wikkel nu de puddingvorm in aluminiumfolie om de inhoud nog beter af te schermen tegen het kookwater en bind er een touwtje rond zodat je een handvat hebt om de pudding uit de pan te tillen."
                            }
                        ]
                    }
