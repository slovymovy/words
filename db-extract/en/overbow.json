            {
                "entry_id": "4cd7131d-e8e2-36eb-b2b3-9e72d16cb6c3",
                "word": "overbow",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "34a69bd0-ca23-4d63-9374-961f3c5d49f3",
                        "entry_id": "4cd7131d-e8e2-36eb-b2b3-9e72d16cb6c3",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "overbows"
                    },
                    {
                        "form_id": "7d4a5801-1fbd-41e1-a2f8-f29874379aad",
                        "entry_id": "4cd7131d-e8e2-36eb-b2b3-9e72d16cb6c3",
                        "tags": [
                            "participle",
