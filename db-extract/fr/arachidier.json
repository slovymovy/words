                        "glosses": [
                            "Relatif à l’arachide, en particulier à sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b39cbe3b-d0d2-4a07-977e-5d830744755e",
                                "sense_id": "62785165-0b9a-32bc-ad9b-35f4a6834ca2",
                                "text": "Le Bassin arachidier du Sénégal se caractérise par des sols ferrugineux tropicaux, permettant une production agricole composée essentiellement de céréales sèches (mil) et de légumineuses (arachide, niébé)."
                            },
                            {
                                "example_id": "e831cba1-4d45-40eb-8336-3297bedb2d75",
                                "sense_id": "62785165-0b9a-32bc-ad9b-35f4a6834ca2",
                                "text": "Le cours mondial s’est effondré à cause de la surabondance de la production arachidière dans plusieurs pays."
                            }
                        ]
                    }
