                        "entry_id": "04d0eac8-1be2-396d-a0dc-74f9c0831e91",
                        "glosses": [
                            "Relatif à Port Mahon, commune d’Espagne de l’île de Minorque (communauté autonome des Îles Baléares)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96759d82-378e-4233-8c0d-b6886da79331",
                                "sense_id": "b192c0cb-ce10-3881-ac57-08f287c06404",
                                "text": "Ce matin-là, la petite créole n’a pas pu se lever. Comme une balancelle mahonnaise prise dans les glaces du Nord, le froid l’étreint, la paralyse."
                            }
                        ]
                    },
                    {
                        "sense_id": "afcdb8d2-1218-3f65-bb2d-dcadd7fb808b",
                        "entry_id": "04d0eac8-1be2-396d-a0dc-74f9c0831e91",
                        "glosses": [
                            "Relatif à la population de Port Mahon, immigrée en Algérie après 1830."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f9075969-d76c-420d-b7d9-a6578c1f82c7",
                                "sense_id": "afcdb8d2-1218-3f65-bb2d-dcadd7fb808b",
                                "text": "Les propriétaires européens emploient des ouvriers mahonnais, français ou allemands."
                            },
                            {
                                "example_id": "2f07a8a2-023a-4a42-ba97-954fa2d73881",
                                "sense_id": "afcdb8d2-1218-3f65-bb2d-dcadd7fb808b",
                                "text": "En effet, on voit quelques villages traverser sans crise cette première époque si désastreuse en général pour les colons ; ce sont uniquement les quelques villages mahonnais qui bordent le littoral à l’est de la Mitidja."
                            }
                        ]
                    }
