            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a39c3878-01f8-3e70-9703-aaffe1e89f1d",
                    "sense_definition": "Personne qui manifeste son désaccord ou lutte contre un pouvoir, une politique ou une idée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a fait arrêter un <w>opposant</w> politique très influent."
                        },
                        {
                            "text": "Cette militante est une <w>opposante</w> déterminée à la réforme des retraites."
                        }
                    ],
                    "synonyms": [
                        "dissident"
                    ],
                    "common_phrases": [
                        "opposant politique",
                        "farouche opposant"
                    ]
                },
                {
                    "sense_id": "4f275d49-ac06-324c-af14-40d99e39e2f8",
                    "sense_definition": "Muscle qui permet le mouvement d'opposition d'un doigt, en particulier du pouce ou du petit doigt.",
