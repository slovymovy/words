{
    "word_family": [
        "pollster",
        "polling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6eac4f58-bfe8-3c84-8de2-03124aa8451c",
                    "sense_definition": "A survey of people, usually statistically analyzed to gauge wider public opinion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voting_survey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest <w>poll</w> shows a shift in public opinion regarding the new policy.",
                            "target_lang_translations": {
                                "ru": "Последний <w>опрос</w> показывает изменение общественного мнения относительно новой политики.",
                                "zh": "最新的<w>民意调查</w>显示公众对这项新政策的看法发生了转变。"
                            }
                        },
                        {
                            "text": "We conducted a quick <w>poll</w> to decide where to have lunch.",
                            "target_lang_translations": {
                                "ru": "Мы провели быстрый <w>опрос</w>, чтобы решить, где пообедать.",
                                "zh": "我们进行了一次快速<w>调查</w>来决定去哪里吃午饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "survey",
                        "opinion poll",
                        "questionnaire"
                    ],
                    "common_phrases": [
                        "exit poll",
                        "conduct a poll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опрос людей, обычно статистически проанализированный для оценки общественного мнения.",
                        "zh": "对人群进行的调查，通常经过统计分析以衡量更广泛的公众舆论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрос",
                                "target_lang_sense_clarification": "метод сбора информации"
                            },
                            {
                                "target_lang_word": "социологический опрос",
                                "target_lang_sense_clarification": "исследование общественного мнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民意调查",
                                "target_lang_sense_clarification": "衡量公众舆论的调查"
                            },
                            {
                                "target_lang_word": "调查",
                                "target_lang_sense_clarification": "收集信息的通用方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b92ec78-51af-323b-9e83-0a01bbd63794",
                    "sense_definition": "A place where votes are cast in an election; usually referred to in the plural.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voting_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voters headed to the <w>polls</w> early in the morning to avoid long lines.",
                            "target_lang_translations": {
                                "ru": "Избиратели направились на <w>избирательные участки</w> рано утром, чтобы избежать длинных очередей.",
                                "zh": "选民们清晨就前往<w>投票站</w>，以避开长队。"
                            }
                        },
                        {
                            "text": "The <w>polls</w> close at eight o'clock tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Избирательные участки</w> закрываются сегодня в восемь часов.",
                                "zh": "<w>投票站</w>将于今晚八点关闭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go to the polls",
                        "at the polls",
                        "polls close"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где подаются голоса на выборах; обычно употребляется во множественном числе.",
                        "zh": "选举中投票的地方，通常以复数形式提及。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избирательный участок",
                                "target_lang_sense_clarification": "место для голосования"
                            },
                            {
                                "target_lang_word": "выборы",
                                "target_lang_sense_clarification": "в контексте 'идти на выборы'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票站",
                                "target_lang_sense_clarification": "选举时选民投票的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f68a326e-2ef1-3c6c-b45b-73ae7fa1123b",
                    "sense_definition": "A formal vote held in order to ascertain the most popular choice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voting_survey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee held a <w>poll</w> to elect the new chairperson.",
                            "target_lang_translations": {
                                "ru": "Комитет провел <w>голосование</w>, чтобы избрать нового председателя.",
                                "zh": "委员会举行了一次<w>投票</w>来选举新主席。"
                            }
                        },
                        {
                            "text": "After the <w>poll</w> is ended, the results will be announced immediately.",
                            "target_lang_translations": {
                                "ru": "После того как <w>голосование</w> закончится, результаты будут объявлены немедленно.",
                                "zh": "<w>投票</w>结束后，结果将立即公布。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vote",
                        "election"
                    ],
                    "common_phrases": [
                        "declare the poll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное голосование, проводимое для выяснения наиболее популярного выбора.",
                        "zh": "为确定最受欢迎的选择而举行的正式投票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голосование",
                                "target_lang_sense_clarification": "процесс подачи голосов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票",
                                "target_lang_sense_clarification": "表达选择的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc2416f-80b0-30ca-a11b-bb563b709f91",
                    "sense_definition": "The result of the voting, or the total number of votes recorded.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voting_survey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final <w>poll</w> was declared shortly after midnight.",
                            "target_lang_translations": {
                                "ru": "Окончательный <w>подсчёт голосов</w> был объявлен вскоре после полуночи.",
                                "zh": "午夜过后不久公布了最终的<w>票数</w>。"
                            }
                        },
                        {
                            "text": "He won the election with a heavy <w>poll</w> in his favor.",
                            "target_lang_translations": {
                                "ru": "Он выиграл выборы с большим <w>числом голосов</w> в свою пользу.",
                                "zh": "他以高<w>票数</w>优势赢得了选举。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат голосования или общее количество зарегистрированных голосов.",
                        "zh": "投票的结果，或记录的选票总数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсчёт голосов",
                                "target_lang_sense_clarification": "результат"
                            },
                            {
                                "target_lang_word": "число голосов",
                                "target_lang_sense_clarification": "количество проголосовавших"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "票数",
                                "target_lang_sense_clarification": "记录的选票数量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4074058c-5ec3-3d10-a461-4dc62de7603b",
                    "sense_definition": "The head, particularly the scalp or pate upon which hair normally grows.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man scratched his bald <w>poll</w> in confusion.",
                            "target_lang_translations": {
                                "ru": "Старик в замешательстве почесал свою лысую <w>макушку</w>.",
                                "zh": "老人困惑地抓了抓他那光秃秃的<w>头顶</w>。"
                            }
                        },
                        {
                            "text": "He removed his wig to reveal a close-cropped black <w>poll</w>.",
                            "target_lang_translations": {
                                "ru": "Он снял парик, обнажив коротко остриженный черный <w>затылок</w>.",
                                "zh": "他摘下假发，露出了剪得很短的黑色<w>后脑勺</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scalp"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Голова, особенно макушка или темя, на котором обычно растут волосы.",
                        "zh": "头部，特别是通常长头发的头顶或后脑勺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макушка",
                                "target_lang_sense_clarification": "часть головы"
                            },
                            {
                                "target_lang_word": "затылок",
                                "target_lang_sense_clarification": "задняя часть головы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头顶",
                                "target_lang_sense_clarification": "头部的顶部"
                            },
                            {
                                "target_lang_word": "后脑勺",
                                "target_lang_sense_clarification": "头部的后部"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ce99f12-46e8-3377-8f5f-d9fb3790866a",
                    "sense_definition": "To record the votes or opinions of a group of people.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine <w>polled</w> its readers to find out their favorite travel destinations.",
                            "target_lang_translations": {
                                "ru": "Журнал <w>опросил</w> своих читателей, чтобы узнать их любимые туристические направления.",
                                "zh": "该杂志<w>询问</w>了读者的意见，以了解他们最喜欢的旅游目的地。"
                            }
                        },
                        {
                            "text": "We need to <w>poll</w> the members before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>провести опрос</w> среди членов, прежде чем принимать окончательное решение.",
                                "zh": "在做出最终决定之前，我们需要<w>征求</w>成员们的意见。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poll the jury",
                        "poll the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать голоса или мнения группы людей.",
                        "zh": "记录一群人的投票或意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрашивать",
                                "target_lang_sense_clarification": "проводить опрос"
                            },
                            {
                                "target_lang_word": "проводить опрос",
                                "target_lang_sense_clarification": "собирать мнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行民意调查",
                                "target_lang_sense_clarification": "收集公众意见"
                            },
                            {
                                "target_lang_word": "询问",
                                "target_lang_sense_clarification": "征求意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b03b68-4870-3726-84e3-b48869bda014",
                    "sense_definition": "To receive a specific number of votes in an election.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "voting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate <w>polled</w> more votes than any of his opponents.",
                            "target_lang_translations": {
                                "ru": "Кандидат <w>получил</w> больше голосов, чем любой из его оппонентов.",
                                "zh": "这位候选人<w>获得</w>的票数比任何对手都多。"
                            }
                        },
                        {
                            "text": "Despite a strong campaign, she <w>polled</w> badly in the rural districts.",
                            "target_lang_translations": {
                                "ru": "Несмотря на сильную кампанию, она <w>набрала мало голосов</w> в сельских районах.",
                                "zh": "尽管竞选活动声势浩大，但她在农村地区的<w>得票</w>情况并不理想。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить определенное количество голосов на выборах.",
                        "zh": "在选举中获得特定数量的选票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать голоса",
                                "target_lang_sense_clarification": "на выборах"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "о количестве голосов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "指代获得的票数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fc7b60-4573-3902-8584-5f987529ab41",
                    "sense_definition": "To repeatedly request the status of a device, such as a computer or printer on a network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network hub <w>polled</w> the connected computers to check for activity.",
                            "target_lang_translations": {
                                "ru": "Сетевой концентратор <w>опросил</w> подключенные компьютеры для проверки активности.",
                                "zh": "网络集线器<w>轮询</w>了连接的计算机以检查其活动状态。"
                            }
                        },
                        {
                            "text": "The software <w>polls</w> the server every few seconds for updates.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение <w>опрашивает</w> сервер каждые несколько секунд для получения обновлений.",
                                "zh": "该软件每隔几秒钟就会<w>轮询</w>服务器以获取更新。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Многократно запрашивать статус устройства, например компьютера или принтера в сети.",
                        "zh": "重复请求设备（如网络中的计算机或打印机）的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрашивать",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮询",
                                "target_lang_sense_clarification": "计算机网络中的技术术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61394298-60ca-30c9-8ae9-a98f7914f6ce",
                    "sense_definition": "To remove the horns of an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers often <w>poll</w> their cattle to prevent injuries in the herd.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто <w>обезроживают</w> свой скот, чтобы предотвратить травмы в стаде.",
                                "zh": "农民经常给牛<w>去角</w>，以防止牛群受伤。"
                            }
                        },
                        {
                            "text": "It is safer to handle the animals after they have been <w>polled</w>.",
                            "target_lang_translations": {
                                "ru": "Безопаснее обращаться с животными после того, как их <w>обезрожили</w>.",
                                "zh": "在动物被<w>去角</w>后处理它们会更安全。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "agricultural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять рога у животного.",
                        "zh": "去除动物的角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезроживать",
                                "target_lang_sense_clarification": "сельскохозяйственный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "去角",
                                "target_lang_sense_clarification": "农业操作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0e772eb7-6375-351f-92fc-09285d1ac415",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Poll</w> has been working at the company for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Полл</w> работает в компании уже двадцать лет.",
                                "zh": "<w>波尔</w>先生在这家公司工作已经二十年了。"
                            }
                        },
                        {
                            "text": "We invited the <w>Poll</w> family to the gathering.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Полл</w> на встречу.",
                                "zh": "我们邀请了<w>波尔</w>一家参加聚会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Полл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa90e7d5-9188-3c2b-b162-f957927ea8f0",
                    "sense_definition": "A diminutive of the female given name Mary.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her friends called her <w>Poll</w> instead of her full name.",
                            "target_lang_translations": {
                                "ru": "Друзья звали её <w>Полл</w> вместо полного имени.",
                                "zh": "朋友们叫她<w>波尔</w>，而不是她的全名。"
                            }
                        },
                        {
                            "text": "Aunt <w>Poll</w> was known for her excellent baking.",
                            "target_lang_translations": {
                                "ru": "Тетя <w>Полл</w> была известна своей превосходной выпечкой.",
                                "zh": "<w>波尔</w>阿姨以她精湛的烘焙手艺而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Мэри.",
                        "zh": "女性名字玛丽的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Полл",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波尔",
                                "target_lang_sense_clarification": "名字音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ec9cb2f-194c-3c61-a2f6-00426ed98295",
                    "sense_definition": "Bred without horns, and thus hornless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They raise <w>poll</w> cattle because they are easier to manage.",
                            "target_lang_translations": {
                                "ru": "Они разводят <w>комолый</w> скот, потому что с ним легче управляться.",
                                "zh": "他们饲养<w>无角的</w>牛，因为它们更容易管理。"
                            }
                        },
                        {
