                    {
                        "translation_id": "ae3d34e4-3fdf-4b8d-82c3-98ffdb155297",
                        "source_entry_id": "84c81e3b-35b0-3419-a526-a97384d41d43",
                        "source_sense_id": "0c085142-fb36-372d-a8aa-f118555aae8c",
