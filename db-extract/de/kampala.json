                                    {
                                        "sense_id": "fbc672a5-3f4c-3d41-a5cf-e99fb66e7bec",
                                        "entry_id": "2093441c-203d-311b-8d37-912e750d204c",
                                        "glosses": [
                                            "Ville et capitale de l’Ouganda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92babfe-942c-4702-968c-0889b25d5747",
                                                "sense_id": "fbc672a5-3f4c-3d41-a5cf-e99fb66e7bec",
                                                "text": "La mère, Safina Namukwaya, est en bonne santé avec ses deux enfants dans un établissement de la capitale, Kampala."
                                            },
                                            {
                                                "example_id": "62ddf7d4-4190-4662-8c83-4b648b4c54db",
                                                "sense_id": "fbc672a5-3f4c-3d41-a5cf-e99fb66e7bec",
                                                "text": "– J’arrive de Kampala. Des questions de politique extérieure. Et j’ai pensé que c’était l’occasion rêvée pour passer te voir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fff19a-a8ac-36d6-850d-4d9bb0e28c27",
                                        "entry_id": "2093441c-203d-311b-8d37-912e750d204c",
                                        "glosses": [
                                            "Gouvernement ougandais."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc5aab0-2a7a-4b96-a58c-559be861760e",
                                                "sense_id": "61fff19a-a8ac-36d6-850d-4d9bb0e28c27",
                                                "text": "Ce sommet qui fait suite aux quadripartites antérieurs, notamment celui du 12 juillet et du 21 août 2019 a, une nouvelle fois, mis un accent particulier sur la réconciliation entre Kampala et Kigali après des mois de tension diplomatique."
                                            }
                                        ]
                                    }
