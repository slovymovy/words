                "senses": [
                    {
                        "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                        "entry_id": "f536a254-710e-3f24-999f-d2922e7e3821",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5dad912-5537-4b05-9c5b-62582978d8f3",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Frau Sträßle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35ba8a7e-2d71-44bb-abb4-f4a476d9cdc3",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Herr Sträßle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d2499827-a854-45b7-8ae0-16c30d21506c",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Die Sträßles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9fb94a1d-2914-4ef9-99cf-ad801f5f3bdc",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Der Sträßle trägt nie die Pullover, die die Sträßle ihm strickt."
                            },
                            {
                                "example_id": "162a0105-08f3-4eff-8e39-ea5a143e6d99",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sträßle kommt, geht der Herr Sträßle.“"
                            },
                            {
                                "example_id": "134f97a9-4820-4111-82cf-cf37616340eb",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Sträßle kommt und geht."
                            },
                            {
                                "example_id": "255d815a-f1ed-4bd6-838f-de3e5f3f59da",
                                "sense_id": "1e2f706e-4a0f-3840-b118-8d73b7431bb2",
                                "text": "Sträßles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
