                                "target_senses": [
                                    {
                                        "sense_id": "f797e0fd-e985-3500-a7a6-48d6c1c10259",
                                        "entry_id": "96346fa5-aaf8-3926-aefb-bbaafbb2eca1",
                                        "glosses": [
                                            "durch eigenes Erleben kennen lernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a498026b-5bc1-4049-a998-cf9526b91a5f",
                                                "sense_id": "f797e0fd-e985-3500-a7a6-48d6c1c10259",
                                                "text": "Ich habe im Leben viel Gutes und Böses erfahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "942895e9-53b0-3ccd-a127-19274c2aa0a8",
                                        "entry_id": "96346fa5-aaf8-3926-aefb-bbaafbb2eca1",
                                        "glosses": [
                                            "zur Kenntnis bekommen, von etwas Kenntnis erhalten, etwas mitgeteilt bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "144c6817-a26e-46b6-b16b-53e0d50601b9",
                                                "sense_id": "942895e9-53b0-3ccd-a127-19274c2aa0a8",
                                                "text": "Ich habe aus der Zeitung von Helgas Tod erfahren."
                                            },
                                            {
                                                "example_id": "a17c0a15-be24-4aca-b09f-60d6d21f8f68",
                                                "sense_id": "942895e9-53b0-3ccd-a127-19274c2aa0a8",
                                                "text": "„Wenn die Polizei erfuhr, dass Dragan tot war, würde sie nach dessen Mörder suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "erfahren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e198d38-8f26-3dbb-ace4-9f881bdea5c2",
                                        "entry_id": "7444f81b-c172-317a-887d-e7507f16008b",
                                        "glosses": [
                                            "reich an den in der Praxis erworbenen Kenntnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce14207-ff3f-4362-ba7e-e6e2c697f494",
                                                "sense_id": "3e198d38-8f26-3dbb-ace4-9f881bdea5c2",
                                                "text": "„Der erfahrene Pilot besteigt sein Segelflugzeug mit nicht mehr Angst als der Autofahrer sein Auto.“"
                                            },
                                            {
                                                "example_id": "11eee906-37b7-4da6-bf81-450e78267753",
                                                "sense_id": "3e198d38-8f26-3dbb-ace4-9f881bdea5c2",
                                                "text": "Er ist ein erfahrener Handwerker."
                                            },
                                            {
                                                "example_id": "fc100ff9-3872-4c49-b049-f92ad93ff099",
                                                "sense_id": "3e198d38-8f26-3dbb-ace4-9f881bdea5c2",
                                                "text": "[Wikipedia:] „Erfahrene Nutzer […] nehmen die Neulinge bei der Hand und machen sie freundlich mit den Regeln vertraut.“"
                                            },
                                            {
                                                "example_id": "cf55bc1c-1f46-4f24-b7a7-51e57b408ed3",
                                                "sense_id": "3e198d38-8f26-3dbb-ace4-9f881bdea5c2",
                                                "text": "„Erfahrene Paragleiter wie Jean-Pierre attestieren Jordanien zwar ideale Bedingungen für den im Haschemitischen Königreich bislang fast unbekannten Sport.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
