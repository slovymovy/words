                                    {
                                        "sense_id": "9e840715-a363-3849-ba97-f4b0335c4926",
                                        "entry_id": "23347128-f794-30a5-bbb8-ea654b5f731b",
                                        "glosses": [
                                            "A series of sounds organized in time, usually employing some combination of harmony, melody, rhythm, tempo, etc., often to convey a mood."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edbfd9d0-db3a-47ed-8262-88267fe331ac",
                                                "sense_id": "9e840715-a363-3849-ba97-f4b0335c4926",
                                                "text": "I keep listening to this music because it’s a masterpiece."
                                            },
                                            {
                                                "example_id": "0d29580c-8fc8-4d5d-8360-6acb31a83893",
                                                "sense_id": "9e840715-a363-3849-ba97-f4b0335c4926",
                                                "text": "Muſick has Charms to ſooth a ſavage Breaſt, / To ſoften Rocks, or bend a knotted Oak."
                                            },
                                            {
                                                "example_id": "b0cbc15e-0b0e-4ee8-918b-9c772c5d7878",
                                                "sense_id": "9e840715-a363-3849-ba97-f4b0335c4926",
                                                "text": "Music lessons in early childhood lead to changes in the brain that could improve its performance far into adulthood, researchers say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6dd0f60-038d-32fe-b102-218f91fdd87d",
                                        "entry_id": "23347128-f794-30a5-bbb8-ea654b5f731b",
                                        "glosses": [
                                            "Any interesting or pleasing sounds."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a948d0a6-495c-4196-b36b-a2a6a3ac8f67",
                                                "sense_id": "a6dd0f60-038d-32fe-b102-218f91fdd87d",
                                                "text": "“Oh! this was very kind,” she said, with that simplicity and tenderness, which at times made her voice pure music, “I could not have expected you so soon.”"
                                            },
                                            {
                                                "example_id": "9b2d6f31-908e-4891-8d74-71927a0a12a8",
                                                "sense_id": "a6dd0f60-038d-32fe-b102-218f91fdd87d",
                                                "text": "Wilson's definite genius for rapid, witty dialogue which becomes a kind of conversational music at times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af065f7a-b020-36cd-8a2d-49b56e8c06f0",
                                        "entry_id": "23347128-f794-30a5-bbb8-ea654b5f731b",
                                        "glosses": [
                                            "An art form, created by organizing pitch, rhythm, and sounds made using musical instruments and/or singing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
