                    {
                        "form_id": "b233e952-6a09-4158-8e61-c69a33a9bd20",
                        "entry_id": "a0cbed52-3d13-33c7-a963-54e903e52c34",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rundreisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                        "entry_id": "a0cbed52-3d13-33c7-a963-54e903e52c34",
                        "glosses": [
                            "Reise, die über mehrere Zwischenstationen zurück zum Ausgangspunkt führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c90c7c-c8fc-48cb-a3d8-1e284fd752f2",
                                "sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                                "text": "Im Urlaub werde ich eine Rundreise durch Österreich machen."
                            },
                            {
                                "example_id": "74d657b8-fc78-4ca5-8dd0-4697a9f72d8a",
                                "sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                                "text": "„1839 war Hugo zum ersten Mal auf einer Rundreise durch das Elsass an den Rhein gefahren.“"
                            },
                            {
                                "example_id": "b34c61b8-3e3a-42c7-a651-7b172620664a",
                                "sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                                "text": "„Am 26. Februar 1807 trat der alte Fürst eine Rundreise durch den ihm unterstellten Milizbezirk an.“"
                            },
                            {
                                "example_id": "ba46ae25-49b7-4131-be6b-68a43f5b14fc",
                                "sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                                "text": "„Wenn seine jährlichen Rundreisen im Alter immer kleinere Kreise zogen, besuchte er doch immer die Neffen, die inzwischen, jeder an einem anderen Ort, mit ihrer beruflichen Tätigkeit begonnen und Familien gegründet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbcc780a-bcda-4cff-adcb-cf94c8a7ce2a",
                        "source_entry_id": "a0cbed52-3d13-33c7-a963-54e903e52c34",
                        "source_sense_id": "258c9ee6-a2ad-3a13-97bd-affdba79bd72",
                        "source_sense_description": "Reise, die über mehrere Zwischenstationen zurück zum Ausgangspunkt führt",
                        "target_lang_word": "round trip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "round trip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b827fb6-8d84-30c6-859b-5668a49afdcc",
                                        "entry_id": "ffcf2315-16a0-3c94-a5af-899a3f1e7ba2",
                                        "glosses": [
                                            "A trip from one destination to another and then returning to the starting location."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5150980-c64b-4283-9a2d-f40335f00318",
                                                "sense_id": "0b827fb6-8d84-30c6-859b-5668a49afdcc",
                                                "text": "Margaret purchased a single round trip ticket to and from Chicago, as it was cheaper than buying two one-way tickets."
                                            },
                                            {
                                                "example_id": "9f5b6877-cf9f-47f3-993f-e93a8beb0fd5",
                                                "sense_id": "0b827fb6-8d84-30c6-859b-5668a49afdcc",
                                                "text": "The fare for this sightseeing tour of London is about 1s., but it is necessary to rebook at least once, as through tickets are not issued for the round trip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef24621-7612-3492-a478-d940899acd96",
                                        "entry_id": "ffcf2315-16a0-3c94-a5af-899a3f1e7ba2",
                                        "glosses": [
                                            "In an oil-drilling operation, the raising, disassembly and replacement of the drilling equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69ce47b-edad-4e07-a76a-c838f776595f",
                                                "sense_id": "cef24621-7612-3492-a478-d940899acd96",
                                                "text": "2014, Exploring Tech Careers: Fourth Edition (page 632), Ferguson Publishing\nAs drilling progresses, the bit gets more and more worn, till eventually it has to be replaced. In order for the bit to be replaced, the whole string has to be lugged up to the surface and taken apart section by section. Once done, the string can be put back together and the bit lowered to the well once again. This operation, called a round trip, takes most drilling crews 12 hours to complete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22b75802-b755-3a35-b30f-ec544f4f5f6f",
                                        "entry_id": "ffcf2315-16a0-3c94-a5af-899a3f1e7ba2",
                                        "glosses": [
                                            "A form of barter that involves the sale of an unused asset and the purchase of the same asset back again, or a similar one, typically used in accounting fraud."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba8611e8-2e4b-3dae-8db2-da0e96e61685",
                                        "entry_id": "ffcf2315-16a0-3c94-a5af-899a3f1e7ba2",
                                        "glosses": [
                                            "The investment of a borrowed overdraft in order to make a profit in the same market."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0ba5940-ed42-3cf1-b86d-6008418f98f8",
                                        "entry_id": "ffcf2315-16a0-3c94-a5af-899a3f1e7ba2",
                                        "glosses": [
                                            "The export and eventual reimport of a file, data, etc. without loss of fidelity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
