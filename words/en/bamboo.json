{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dffde603-6275-3d69-8517-390884140158",
                    "sense_definition": "A fast-growing tropical grass with hard, hollow, and jointed stems.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plant_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The giant panda's diet consists almost entirely of fresh <w>bamboo</w>.",
                            "target_lang_translations": {
                                "ru": "Рацион гигантской панды почти полностью состоит из свежего <w>бамбука</w>.",
                                "zh": "大熊猫的食物几乎完全由新鲜的<w>竹子</w>组成。"
                            }
                        },
                        {
                            "text": "We planted some fast-growing <w>bamboo</w> in the garden to create a natural privacy screen.",
                            "target_lang_translations": {
                                "ru": "Мы посадили в саду быстрорастущий <w>бамбук</w>, чтобы создать живую изгородь.",
                                "zh": "我们在花园里种了一些生长迅速的<w>竹子</w>，以营造天然的屏障。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bamboo shoot",
                        "bamboo forest",
                        "bamboo grove",
                        "bamboo leaves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрорастущее тропическое растение с твердыми, полыми и коленчатыми стеблями.",
                        "zh": "一种生长迅速的多年生木质化草本植物，茎干坚硬、中空且有节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамбук",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竹子",
                                "target_lang_sense_clarification": "指植物本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "555e62fd-148a-3e06-b85e-a886716d3b07",
                    "sense_definition": "The hard, hollow wood of the bamboo plant used as a material for building or making furniture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plant_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional hut was constructed entirely from sturdy <w>bamboo</w> and palm leaves.",
                            "target_lang_translations": {
                                "ru": "Традиционная хижина была построена целиком из прочного <w>бамбука</w> и пальмовых листьев.",
                                "zh": "这座传统小屋完全由坚固的<w>竹材</w>和棕榈叶建造而成。"
                            }
                        },
                        {
                            "text": "This eco-friendly flooring is made from compressed <w>bamboo</w> rather than hardwood.",
                            "target_lang_translations": {
                                "ru": "Это экологичное напольное покрытие сделано из прессованного <w>бамбука</w>, а не из твердых пород дерева.",
                                "zh": "这种环保地板是由压缩<w>竹材</w>而非硬木制成的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cane"
                    ],
                    "common_phrases": [
                        "bamboo furniture",
                        "bamboo floor",
                        "bamboo mat",
                        "bamboo pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая, полая древесина бамбука, используемая как материал для строительства или изготовления мебели.",
                        "zh": "竹子的坚硬、中空茎干，常被用作建筑或家具制作的材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамбук",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竹材",
                                "target_lang_sense_clarification": "指作为建筑或制造材料的竹子"
                            },
                            {
                                "target_lang_word": "竹子",
                                "target_lang_sense_clarification": "指作为材料的竹子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f2c7269-e414-32b2-b513-3124dac29aa4",
                    "sense_definition": "A stick or rod made of bamboo, sometimes used for walking or corporal punishment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old traveler walked up the mountain path supported by a long <w>bamboo</w>.",
                            "target_lang_translations": {
                                "ru": "Старый путник поднимался по горной тропе, опираясь на длинную <w>бамбуковую палку</w>.",
                                "zh": "那位年迈的旅行者拄着一根长<w>竹竿</w>沿着山路向上走。"
                            }
                        },
                        {
                            "text": "In the story, the strict teacher threatened the students with a <w>bamboo</w>.",
                            "target_lang_translations": {
                                "ru": "В рассказе строгий учитель угрожал ученикам <w>бамбуковой тростью</w>.",
                                "zh": "在故事里，严厉的老师用<w>竹杖</w>威胁学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cane",
                        "rod",
                        "stick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Палка или трость из бамбука, иногда используемая для ходьбы или телесных наказаний.",
                        "zh": "用竹子制成的棍或杖，有时用于行走支撑或体罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамбуковая палка",
                                "target_lang_sense_clarification": "предмет"
                            },
                            {
                                "target_lang_word": "бамбуковая трость",
                                "target_lang_sense_clarification": "для ходьбы или наказания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竹竿",
                                "target_lang_sense_clarification": "指竹制的长棍"
                            },
                            {
                                "target_lang_word": "竹杖",
                                "target_lang_sense_clarification": "指竹制的拐杖或刑具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "afa049c0-dfc1-3de6-b2df-1f626863c947",
                    "sense_definition": "Made of the wood of the bamboo plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a set of <w>bamboo</w> chairs for the patio because they are lightweight and durable.",
                            "target_lang_translations": {
                                "ru": "Она купила комплект <w>бамбуковых</w> стульев для патио, потому что они легкие и прочные.",
                                "zh": "她为露台买了一套<w>竹制</w>椅子，因为它们轻便又耐用。"
                            }
                        },
                        {
                            "text": "The artist used a small <w>bamboo</w> brush to paint the delicate characters.",
                            "target_lang_translations": {
                                "ru": "Художник использовал маленькую <w>бамбуковую</w> кисть, чтобы написать изящные иероглифы.",
                                "zh": "艺术家用一支小小的<w>竹制</w>毛笔书写精致的汉字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bamboo curtain",
                        "bamboo steamer",
                        "bamboo structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из древесины бамбука.",
                        "zh": "由竹子制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамбуковый",
                                "target_lang_sense_clarification": "сделанный из бамбука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竹制的",
                                "target_lang_sense_clarification": "形容词，表示材质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44336064-94f9-3e2a-aa6d-c28eca79fe8a",
                    "sense_definition": "To hit or beat someone with a bamboo cane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel overseer would <w>bamboo</w> the workers if they did not meet their daily quota.",
                            "target_lang_translations": {
                                "ru": "Жестокий надсмотрщик <w>бил бамбуковой палкой</w> рабочих, если они не выполняли дневную норму.",
                                "zh": "如果工人们没有完成每日定额，残忍的监工就会<w>用竹竿打</w>他们。"
                            }
                        },
                        {
                            "text": "He was <w>bambooed</w> as punishment for stealing rice from the village storehouse.",
                            "target_lang_translations": {
                                "ru": "Его <w>побили бамбуковыми палками</w> в наказание за кражу риса из деревенского амбара.",
                                "zh": "他因从村里的仓库偷米而受到<w>用竹竿鞭打</w>的惩罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flog",
                        "cane",
                        "beat"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical forms of punishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить или наказывать кого-либо бамбуковой тростью.",
                        "zh": "用竹竿鞭打或惩罚某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить бамбуковой палкой",
                                "target_lang_sense_clarification": "наказывать"
                            },
                            {
                                "target_lang_word": "наказывать бамбуком",
                                "target_lang_sense_clarification": "телесное наказание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用竹竿打",
                                "target_lang_sense_clarification": "指体罚行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}