                    {
                        "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                        "entry_id": "1c79c888-ce35-31ef-98c0-f8fb52f46b9b",
                        "glosses": [
                            "ein speziell für Fahrradfahrer ausgebauter und reservierter Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea5a9b0-709c-4430-bd4e-3ad607dbfe37",
                                "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                                "text": "Jeder Fahrradfahrer und jede Fahrradfahrerin muss den Fahrradweg benutzen, wenn dieser auf der Fahrbahn extra eingezeichnet ist."
                            },
                            {
                                "example_id": "331a15bd-4b32-45ba-a6b0-7efb6de480d4",
                                "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                                "text": "„Berlin, Berlin – auf dem Fahrradweg nach Hause sprach sie sich dieses Wort an jeder Kreuzung vor und begann sich unbändig zu freuen, wie immer, wenn ein schneller Aufbruch bevorstand.“"
                            }
                        ],
