                "word": "escrow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "141f13e1-d47b-4fa6-9cde-b0bc8e94a289",
                        "entry_id": "5b8bd709-f3d0-3c55-be68-d55565eb901c",
                        "tags": [
