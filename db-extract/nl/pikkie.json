                        "examples": [
                            {
                                "example_id": "669f4443-92a7-45a5-bb74-ba696c810399",
                                "sense_id": "0646c96c-db1f-384e-90dc-84b06a1ed527",
                                "text": "Lars is heel volwassen voor een pas 19-jarig pikkie."
                            },
                            {
                                "example_id": "e731cf9d-eb5e-49e8-aea0-2ce885fe115a",
                                "sense_id": "0646c96c-db1f-384e-90dc-84b06a1ed527",
                                "text": "\"Hé pikkie!\" Met die woorden begroet Rafael van der Vaart doorgaans zijn maatje Wesley Sneijder. De twee rasvoetballers groeiden op bij Ajax en speelden samen maar liefst 69 keer in het Nederlands elftal."
                            },
                            {
                                "example_id": "f09f8a3b-8600-4c15-8059-c032d5e144ee",
                                "sense_id": "0646c96c-db1f-384e-90dc-84b06a1ed527",
                                "text": "\"Toen was het nog een jong pikkie, dat net bij de selectie kwam\", herinnert Tjerk Smeets zich. \"Voor het WK werd hij als bankspeler toegevoegd, maar hij kon toen wel de titel 'wereldkampioen' achter zijn naam zetten en werd benoemd tot Ridder in de Orde van Oranje-Nassau.\""
                            }
                        ]
                    }
