                                    {
                                        "sense_id": "dc9b2180-5702-3a46-b2ea-7fa34f9061f4",
                                        "entry_id": "518a2362-a402-3e1c-8bd1-c14b29e10c2b",
                                        "glosses": [
                                            "A step on a set of stairs; the rung of a ladder."
