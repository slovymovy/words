                        "translation_id": "3b865d4c-5966-41dd-8917-aeaad1046860",
                        "source_entry_id": "f9234164-f8bd-3592-8c7b-aaaa46a7f227",
                        "source_sense_id": "dae667a3-a5d8-3a52-a732-559db9b77a51",
                        "target_lang_word": "pragmatist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pragmatist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b21dc0e-90b6-3257-9ca7-dba598825b76",
                                        "entry_id": "c0beecbb-cf04-3d8d-a251-6cef134c7d1b",
                                        "glosses": [
                                            "One who acts in a practical or straightforward manner; one who is pragmatic; one who values practicality or pragmatism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07addfc5-e5ff-422f-894e-30aafd4ecbef",
                                                "sense_id": "6b21dc0e-90b6-3257-9ca7-dba598825b76",
                                                "text": "A pragmatist would never plant such a messy tree, but I like its flowers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1cd3de-8fd0-3f24-8e40-1a658be4c356",
                                        "entry_id": "c0beecbb-cf04-3d8d-a251-6cef134c7d1b",
                                        "glosses": [
                                            "One who acts in response to particular situations rather than upon abstract ideals; one who is willing to ignore their ideals to accomplish goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ce45f4-6294-4c28-b0bf-9cc6599ab578",
                                                "sense_id": "0f1cd3de-8fd0-3f24-8e40-1a658be4c356",
                                                "text": "I'm not a thief, I am a pragmatist. I need this bread to feed my family."
                                            },
                                            {
                                                "example_id": "038b56d8-55e0-4c61-ac36-9c9868c4d2ba",
                                                "sense_id": "0f1cd3de-8fd0-3f24-8e40-1a658be4c356",
                                                "text": "We cannot trust him not to lie for his own gain: he's an opportunist and a pragmatist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43d7ad93-cfe9-3d9e-95a2-646edca7cb25",
                                        "entry_id": "c0beecbb-cf04-3d8d-a251-6cef134c7d1b",
                                        "glosses": [
                                            "One who belongs to the philosophic school of pragmatism; one who holds that the meaning of beliefs is the actions they entail, and that the truth of those beliefs consists in the actions they entail, successfully leading a believer to their goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed892d7-9bc0-4e30-afd8-c7424c7918c7",
                                                "sense_id": "43d7ad93-cfe9-3d9e-95a2-646edca7cb25",
                                                "text": "[S]ome pragmatists (such as William James) took a more pantheist or pandeist approach by rejecting views of God as separate from the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb6103a-9438-3f2e-8eb4-3a2c44eab3ef",
                                        "entry_id": "c0beecbb-cf04-3d8d-a251-6cef134c7d1b",
                                        "glosses": [
                                            "An advocate of pragmatism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ca468e1-7fc3-3f66-a898-67b2062eb89a",
                                        "entry_id": "c0beecbb-cf04-3d8d-a251-6cef134c7d1b",
                                        "glosses": [
                                            "One who studies pragmatics."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
