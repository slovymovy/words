            "pos": "noun",
            "senses": [
                {
                    "sense_id": "691aa95d-2a80-3869-9dfe-b96a744b5a61",
                    "sense_definition": "Personne chargée d'enseigner une activité sportive ou technique, comme le ski ou la conduite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personne_encadrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>moniteur</w> d'auto-école m'aide à bien préparer l'examen du permis de conduire."
                        },
                        {
                            "text": "Les enfants écoutent attentivement les conseils du <w>moniteur</w> avant de descendre la piste de ski."
                        }
                    ],
                    "synonyms": [
                        "coach",
                        "formateur"
                    ],
                    "common_phrases": [
                        "moniteur d'auto-école",
                        "moniteur de ski"
                    ]
                },
                {
                    "sense_id": "a814ffa4-8730-3dcf-b82f-134b4ae83382",
                    "sense_definition": "Écran ou appareil permettant de visualiser des images ou des données de contrôle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appareil_affichage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a acheté un nouveau <w>moniteur</w> d'ordinateur pour travailler plus confortablement à la maison."
                        },
                        {
                            "text": "Le technicien observe les images sur le <w>moniteur</w> vidéo de la régie."
                        }
                    ],
                    "synonyms": [
                        "écran de contrôle",
                        "écran témoin"
                    ],
                    "common_phrases": [
                        "moniteur d'ordinateur",
                        "moniteur vidéo"
                    ]
                },
                {
                    "sense_id": "dac7f52e-d8d3-3eb4-9084-89433eff25df",
                    "sense_definition": "Personne chargée d'encadrer et d'animer des enfants dans un centre de loisirs ou de vacances.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_encadrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, il travaille comme <w>moniteur</w> de colonie de vacances au bord de la mer."
                        },
                        {
                            "text": "Le <w>moniteur</w> de centre aéré organise des jeux de plein air pour les enfants du quartier."
                        }
                    ],
                    "synonyms": [
                        "animateur"
                    ],
                    "common_phrases": [
                        "moniteur de centre aéré",
                        "moniteur de colonie de vacances"
                    ]
                },
                {
                    "sense_id": "b7fea621-8b69-3633-8a36-cb013a50797a",
                    "sense_definition": "Appareil électronique médical servant à enregistrer et surveiller en continu les constantes physiologiques d'un patient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appareil_affichage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière vérifie régulièrement les pulsations affichées sur le <w>moniteur</w> cardiaque du patient."
                        },
                        {
                            "text": "Dès son arrivée aux urgences, le médecin a branché le malade sur un <w>moniteur</w>."
                        }
                    ],
                    "common_phrases": [
                        "moniteur cardiaque"
                    ]
                }
            ]
        }
    ]
