                                        "entry_id": "5002c07a-fba4-368a-ade6-a84b7627b025",
                                        "glosses": [
                                            "soustavné pokoušení se o rozvrat diskuse nemístnými příspěvky, např. vulgárními, na první pohled scestnými, mimo téma, apod."
                                        ],
                                        "tags": [
