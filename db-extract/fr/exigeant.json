                    {
                        "sense_id": "ad06b37a-ce67-3fa2-b35d-20b7a10d5c14",
                        "entry_id": "dfc909eb-4a74-3192-8f2e-bec43c6e1ee7",
                        "glosses": [
                            "Qui est dans l’habitude d’exiger beaucoup ou trop de déférence, d’attentions, de travail, d’argent, de services."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f70ac90-fd02-4051-a9b9-fb097f7326b9",
                                "sense_id": "ad06b37a-ce67-3fa2-b35d-20b7a10d5c14",
                                "text": "Un duel de générations a opposé, dimanche, Sébastien Ogier, 39 ans, au Finlandais Kalle Rovanperä, 22 ans, sur les exigeantes pistes rocailleuses du Kenya."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "473772ef-4477-4909-840c-494278746c29",
                        "source_entry_id": "dfc909eb-4a74-3192-8f2e-bec43c6e1ee7",
                        "source_sense_id": "ad06b37a-ce67-3fa2-b35d-20b7a10d5c14",
                        "target_lang_word": "anspruchsvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anspruchsvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                        "entry_id": "d28a1c58-1322-39fc-910e-de95a709ad63",
                                        "glosses": [
                                            "nicht leicht zufriedenzustellen, mit hohen Ansprüchen"
                                        ],
                                        "tags": [
                                            "eine Person betreffend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d9d2eb-1779-47c9-ab8d-b27b6a466ed3",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "Ihr Fazit lautet, dass die Erwartungen der Jugendlichen an ihre spätere Tätigkeit anspruchsvoller geworden seien."
                                            },
                                            {
                                                "example_id": "ae726556-40ba-46f1-9008-940754ccdd5c",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "Unsere Gäste sind sehr anspruchsvoll und wollen einen umfangreichen Service."
                                            },
                                            {
                                                "example_id": "8efb8a41-807e-4e5b-9dd7-fa33ee8ef973",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "„Der anspruchsvolle Grenzgänger am Scheideweg von Leben und Tod lebt in krassen Antinomien, die dem Durchschnittsbürger sein Verständnis erschweren.“"
                                            },
                                            {
                                                "example_id": "0c689e91-65fc-4e07-a036-adf6dd84b224",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "„Sowohl für Genusswanderer als auch für anspruchsvolle Gipfelsammler hält der Band eine große Auswahl an Zielen bereit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                        "entry_id": "d28a1c58-1322-39fc-910e-de95a709ad63",
                                        "glosses": [
                                            "viel Wissen/Können wird benötigt, um es zu verstehen oder zu leisten"
                                        ],
                                        "tags": [
                                            "ein Objekt, einen Sachverhalt betreffend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3d3fe2-4707-4b9f-991e-f88ba5acca45",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                                            },
                                            {
                                                "example_id": "83ad13ce-cb3e-465f-996e-f9e789d17439",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "Ich bevorzuge anspruchsvolle Filme."
                                            },
                                            {
                                                "example_id": "e7674300-45b3-4625-b063-487af3a38fc7",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "Diese Aufgabe ist äußerst anspruchsvoll."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
