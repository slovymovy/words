                "entry_id": "e721d1d7-79bf-3522-a5f4-f7721a24d8f7",
                "word": "toue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "584e956d-df52-4337-a8a3-b54ccb1feb3b",
                        "entry_id": "e721d1d7-79bf-3522-a5f4-f7721a24d8f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "toues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                        "entry_id": "e721d1d7-79bf-3522-a5f4-f7721a24d8f7",
                        "glosses": [
                            "Bateau plat qui sert de bac ou de bateau de pêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad12a5d2-635b-4640-a558-2a0b9e8d5fd1",
                                "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                                "text": "Il est seul sur la toue."
                            },
                            {
                                "example_id": "969dc6c2-6029-4617-a0ad-2bcadf7aa040",
                                "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                                "text": "Toute la journée, au fur et à mesure que les toues amenaient les inondés à la Croix-Verte, les ecclésiastiques de la ville et les sœurs de charité leur distribuaient, au nom de l'autorité, tous les secours possibles en pain, viande et vin."
                            },
                            {
                                "example_id": "3c22f731-a169-4949-97b2-86988efd9ef0",
                                "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                                "text": "La Petite-Seine s’étend de Marcilly à Montereau, sur une longueur de 92 kilomètres. […]. Les bateaux qui fréquentent habituellement la Petite-Seine sont les flûtes, les toues, les margotats et les batelets."
                            },
                            {
                                "example_id": "8088944f-8d90-469d-92dc-ff17047db361",
                                "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                                "text": "Est-ce le marinier qui descendait le fleuve sur sa toue, en fredonnant la chanson de Henri IV ?"
                            },
                            {
                                "example_id": "6b37d10d-13d7-4093-97e6-8a302934530b",
                                "sense_id": "4602f2c4-8ac3-3ffa-943d-f36a3c599264",
                                "text": "Cette toue appartenait à monsieur de Mortsauf, qui s’en servait pour pêcher."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
