                ],
                "senses": [
                    {
                        "sense_id": "ce699e13-e07b-3566-9752-c6196c609a21",
                        "entry_id": "5ee5ccce-ba98-3b7f-b109-5549981382e7",
                        "glosses": [
                            "(berufliche) Tätigkeit, die immer nur kurze Zeit andauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f22f215-5183-4b1f-a8be-24b72460955b",
                                "sense_id": "ce699e13-e07b-3566-9752-c6196c609a21",
                                "text": "„Mit 13 Jahren verließ der junge Robert das Elternhaus und schlug sich im Hafen von Seattle mit Gelegenheitsarbeiten durch.“"
                            },
                            {
                                "example_id": "dd34f114-7114-4d64-a5c0-cb0faf29e226",
                                "sense_id": "ce699e13-e07b-3566-9752-c6196c609a21",
                                "text": "„Hessen will mit einem Arbeitsmarktprogramm verhindern, dass viele Flüchtlinge in die Gelegenheitsarbeit und spätere Langzeitarbeitslosigkeit abrutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29189f76-0dbe-35f5-89c7-3595482f2c06",
                        "entry_id": "5ee5ccce-ba98-3b7f-b109-5549981382e7",
                        "glosses": [
                            "Werk, das für einen bestimmten Anlass angefertigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c06cc6-2634-467d-833b-6545d3f998d4",
                                "sense_id": "29189f76-0dbe-35f5-89c7-3595482f2c06",
                                "text": "„Wenn ein Werk eines so berühmten Komponisten wie Paul Hindemith erst achtzig Jahre nach der Niederschrift uraufgeführt wird, ist man geneigt anzunehmen, es handle sich um eine Gelegenheitsarbeit, einen Geburtstagskanon oder Ähnliches, auf eine Serviette gekritzelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
