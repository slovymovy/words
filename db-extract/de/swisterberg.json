                "senses": [
                    {
                        "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                        "entry_id": "84cc0d1a-fe6e-31aa-ac33-3fc44ecec93f",
                        "glosses": [
                            "markanter Berg bei Köln, am Flüsschen Swist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e597cc-333a-4a08-8224-32a51c68df00",
                                "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                                "text": "Auf dem Swisterberg steht heute das Swister Türmchen und war ehemals besiedelt von dem Dorf Swist, an der alten Römerstraße zwischen Köln und Trier."
                            },
                            {
                                "example_id": "e5c8372d-e6c8-4fd3-aa75-a84e6871149d",
                                "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                                "text": "„Der Swister Turm ist ein Überrest der alten Pfarr-und Wallfahrtskirche des untergegangenen Dorfes Swist auf dem Swisterberg (erbaut ca. 1100-1125).“"
                            },
                            {
                                "example_id": "588d4b05-2716-47c5-9aa7-57985312d701",
                                "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                                "text": "„Der Swister Turm, erbaut in den Jahren 1100 – 1125, ist der Überrest der alten Pfarr- und Wallfahrtskirche des ehemaligen Dorfes Swist am Swisterberg in Weilerswist.“"
                            },
                            {
                                "example_id": "23064c2f-9e66-4056-9976-b73e85777e46",
                                "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                                "text": "„Zu der Zeit, als die Kirche auf dem Swisterberg noch erhalten war, lehnte sich an die Südwand ihres heute noch stehenden Turmes eine kleine Klause an, in der ein Einsiedler hauste,der das alte Wallfahrtskirchlein zu den heilgen Fides, Spes und Caritas betreute.“"
                            },
                            {
                                "example_id": "083cfbd4-b736-4f87-a96f-8fa899a184be",
                                "sense_id": "f029123c-943f-3442-8606-c4daeda8275c",
                                "text": "„Auf dem Weilerswister \"Swisterberg\" (Geschwisterberg) nahmen die heiligen Schwestern im \"Swisterhof\" Wohnung und erwiesen der Bevölkerung viele Wohltaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
