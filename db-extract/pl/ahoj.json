                                            {
                                                "example_id": "a8638a59-54b9-416e-baf0-ae96d4fd362d",
                                                "sense_id": "7b08fa47-2001-3c10-834d-0df7f05352c3",
                                                "text": "Schiff ahoi!"
                                            }
