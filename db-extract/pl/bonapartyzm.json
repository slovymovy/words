                                        "glosses": [
                                            "The practices and ideology of Napoleon Bonaparte"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78d3f8ba-8a19-3c77-8ea9-fc9255075610",
