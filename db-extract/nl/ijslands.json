                                        "entry_id": "6b79abe8-e7d6-39c5-807a-769c5e43aa61",
                                        "glosses": [
                                            "auf Island gesprochene Amts- und Umgangssprache germanischen Stammes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2917c3b-c7ca-4d89-a855-6adeb91c711c",
                                                "sense_id": "0d3f3f0d-6888-398c-8002-af91a6cc35e5",
                                                "text": "Sprechen Sie Isländisch?"
                                            },
                                            {
                                                "example_id": "6618649b-9deb-4fab-9101-ed6611a89748",
                                                "sense_id": "0d3f3f0d-6888-398c-8002-af91a6cc35e5",
                                                "text": "Wie heißt das auf Isländisch?"
                                            },
                                            {
                                                "example_id": "207af8f2-6843-44c7-903f-8bb3b21083ec",
                                                "sense_id": "0d3f3f0d-6888-398c-8002-af91a6cc35e5",
                                                "text": "Wie kann ich mein Isländisch verbessern?"
                                            },
                                            {
                                                "example_id": "bc4ed718-50d4-4525-a239-167b735e3d23",
                                                "sense_id": "0d3f3f0d-6888-398c-8002-af91a6cc35e5",
                                                "text": "Das Isländische ist mit dem Färöischen verwandt."
                                            },
                                            {
                                                "example_id": "40d218ea-cbc0-4544-abc6-4104e73f442f",
                                                "sense_id": "0d3f3f0d-6888-398c-8002-af91a6cc35e5",
                                                "text": "„Er spricht eigentlich sogar besser Isländisch als jeder Isländer; fehlerlos und ohne jeden Slang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "568f1bd2-79d3-451b-89e3-0be40025c3a2",
                        "source_entry_id": "a612609b-109b-3279-8dd9-e4b33e849bc8",
                        "source_sense_id": "46687f44-ba77-3bbe-a9f3-11959ca70336",
                        "source_sense_description": "een Germaanse taal die wordt gesproken op IJsland",
