                        "entry_id": "26553113-b232-39dc-9f1a-6cc43fee11a9",
                        "glosses": [
                            "The study of microscopes, their design and manufacture."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "693664a1-20e9-3083-93c6-e30e065384b8",
                        "entry_id": "26553113-b232-39dc-9f1a-6cc43fee11a9",
                        "glosses": [
                            "The use of microscopes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ced18067-afc2-4750-a7af-5340212bea54",
                                "sense_id": "693664a1-20e9-3083-93c6-e30e065384b8",
                                "text": "Studies of the viable blood cells with phase contrast microscopy showed peculiar cells that had numerous short villi and were arbitrarily called “hairy cells.”"
                            },
                            {
                                "example_id": "de89dcaf-a273-40c7-8327-556b2b6f8dd7",
                                "sense_id": "693664a1-20e9-3083-93c6-e30e065384b8",
                                "text": "Nematodes are transparent. It is one of the features that make them an ideal model organism, amenable to microscopy."
                            },
                            {
                                "example_id": "7da15d62-8e7f-4bcd-a507-8c5c94ba512d",
                                "sense_id": "693664a1-20e9-3083-93c6-e30e065384b8",
                                "text": "A multi-institution US research team has combined some creative chemistry, fluorescence microscopy and laser-driven microballistics to gain a clearer view of just what happens in a high-strain-rate impact, and to tease out the relative contribution of different kinds of energy dissipation within the target (Nat. Commun., doi: 10.1038/s41467-024-52663-1)."
                            }
                        ]
                    }
                ],
