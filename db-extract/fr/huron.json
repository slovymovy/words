                "senses": [
                    {
                        "sense_id": "5bca1b7c-3438-362a-ba6d-f1639484a3b1",
                        "entry_id": "809e1e71-4aa7-340a-bc4a-ffe7b02dafa8",
                        "glosses": [
                            "Langue des Hurons, peuple amérindien de l’est du Canada, de la famille iroquoienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d9d8a5-bc14-4f9c-83d0-cdb98d75a767",
                                "sense_id": "5bca1b7c-3438-362a-ba6d-f1639484a3b1",
                                "text": "…le huron s’est éteint au début du 20ᵉ siècle."
                            },
                            {
                                "example_id": "065e9f17-0887-4590-80dd-4ab6446eb9d4",
                                "sense_id": "5bca1b7c-3438-362a-ba6d-f1639484a3b1",
                                "text": "Plusieurs autres langues iroquoiennes se sont éteintes au cours du dernier siècle, comme le huron, qui pendant la première moitié du 17ᵉ siècle fut pourtant la langue par excellence des échanges entre colons et autochtones de toutes origines."
                            }
                        ]
                    }
                ],
                "translations": [],
