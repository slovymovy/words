                        "examples": [
                            {
                                "example_id": "2b0ac0e5-70b4-46ae-bbc8-65e3c2d6f9fc",
                                "sense_id": "8aac8a23-8d4b-3b20-a81a-40b62eea8a96",
                                "text": "„Am späten Nachmittag durchquerten wir eine dicht bewaldete Talsenke, und es kam Nebel auf.“"
                            },
                            {
                                "example_id": "aa3853c9-582b-4370-9f27-46a30066c175",
                                "sense_id": "8aac8a23-8d4b-3b20-a81a-40b62eea8a96",
                                "text": "„Das liegt in einer Talsenke mitten im Hochland, und von dort erreicht man die Heerstraße, wenn man über die Einöde zwischen den Landsenden wandert.“"
                            }
                        ],
