                    {
                        "sense_id": "a073b8f7-d570-3b72-ad89-c473166ad872",
                        "entry_id": "4b97b14a-1d5b-3612-b6fc-30e630626003",
                        "glosses": [
                            "Chercher, trouver et publier des informations privées de quelqu’un sur Internet."
