                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непослушный",
                                "target_lang_sense_clarification": "о человеке, ребёнке, животном"
                            },
                            {
                                "target_lang_word": "непокорный",
                                "target_lang_sense_clarification": "бунтующий, проявляющий открытое неповиновение"
                            },
                            {
                                "target_lang_word": "неподатливый",
                                "target_lang_sense_clarification": "упрямый, несговорчивый"
                            }
