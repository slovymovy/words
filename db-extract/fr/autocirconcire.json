                        "examples": [
                            {
                                "example_id": "741eb4ea-95a7-4a0b-a6e2-553f23911b84",
                                "sense_id": "eeeb4716-519f-36b4-b2fc-936351b22f05",
                                "text": "Vautré dans une chair sans espoir, dans une sexualité destructrice et vouée à la mort, incapable de s'autocirconcire, l'être humain ne sait plus percevoir la finalité créatrice de la sexualité, par-delà la simple perpétuation de l'espèce."
                            },
                            {
                                "example_id": "0c7a382b-20ed-4478-840e-2d415c41b4ef",
                                "sense_id": "eeeb4716-519f-36b4-b2fc-936351b22f05",
                                "text": "Il ne restait qu'une option au fils : s'autocirconcire - pas le sexe rassurez-vous, mais le texte."
                            }
                        ]
                    }
