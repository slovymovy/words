                "senses": [
                    {
                        "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                        "entry_id": "93821ac9-e584-3cc4-8009-32d57969d056",
                        "glosses": [
                            "neue Bildung eines Kompositums, aus einer speziellen Situation heraus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdce0bd9-52ff-4e5e-a248-96bde26c5f1b",
                                "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                                "text": "Ein Beispiel für ein Ad-hoc-Kompositum aus der Literatur ist „Alphamännchenkontrollfreakegomane“."
                            },
                            {
                                "example_id": "82cee92f-1f79-4a07-bf0f-c6c0416284a2",
                                "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                                "text": "„Klare Beispiele für Ad-hoc-Komposita anderer Muster sind sehr selten.“"
                            },
                            {
                                "example_id": "16732245-adb4-49df-9b0d-7e5a99ad4c33",
                                "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                                "text": "„Über Bedeutungsindizierung und Sachkenntnis hinaus führt HERINGER (1984: 5 f.) für das ›richtige Verständnis von Komposita‹ drei Grundlagen an, mit deren Hilfe auch ad-hoc-Komposita in verschiedenen Textsorten verstehbar sind.“"
                            },
                            {
                                "example_id": "15f3bed3-42a0-4a05-88ba-207655bd0a6e",
                                "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                                "text": "„Anschließend werden die psycho-/neurolinguistischen Grundlagen zur Kompositaverarbeitung vorgestellt, wobei der Schwerpunkt auf der Verarbeitung von Ad-hoc-Komposita liegt.“"
                            },
                            {
                                "example_id": "c88bfb99-b6ec-4e60-991a-6186b4ca1cbc",
                                "sense_id": "526f520d-384f-3c13-be4e-2a58250941a5",
                                "text": "„Man kann ein und dasselbe Ad-hoc-Kompositum gleichzeitig mehreren Grundtypen zuordnen, wenn man es kontextlos betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
