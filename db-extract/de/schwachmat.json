                "senses": [
                    {
                        "sense_id": "e0e71b3d-0e43-32e1-bc57-a44c7e6b6725",
                        "entry_id": "875669a6-fbff-3831-968f-3b5f96b790e7",
                        "glosses": [
                            "someone with intellectual or bodily deficiencies",
                            "moron, idiot"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "87084a53-7c08-4276-8d16-2abe1ef143b8",
                                "sense_id": "e0e71b3d-0e43-32e1-bc57-a44c7e6b6725",
                                "text": "Ich mach mein Ding / Egal was die anderen labern / Was die Schwachmaten einem so raten / Das ist egal / Ich mach mein Ding",
                                "translation": "I do my own thing / Doesn't matter what anyone else has to say / What the morons would have me do / Doesn't matter / I do my own thing",
                                "english": "I do my own thing / Doesn't matter what anyone else has to say / What the morons would have me do / Doesn't matter / I do my own thing"
                            },
                            {
                                "example_id": "33c79a1b-403a-4982-b931-6940711d5efd",
                                "sense_id": "e0e71b3d-0e43-32e1-bc57-a44c7e6b6725",
                                "text": "Das Traurigste aber ist, dass “Der life-saving Handjob“ nämlich eines zeigt: Die Kampagne hält Männer für absolute Schwachmaten.",
                                "translation": "But the sad thing is that \"The Live-Saving Handjob\" ends up demonstrating one thing, and that is that the campaign takes men for absolute idiots.",
                                "english": "But the sad thing is that \"The Live-Saving Handjob\" ends up demonstrating one thing, and that is that the campaign takes men for absolute idiots."
                            }
                        ]
                    },
