    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                "word": "couloir",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2a9d73a9-175a-4f46-9ddd-9159018bee9c",
                        "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "couloirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                        "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                        "glosses": [
                            "A steep gorge along a mountainside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca7dfb2-d2df-46e2-91ae-3eb742bf574d",
                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                "text": "Those deep, dark slots in a mountain known as couloirs are often the most obvious routes of ascent."
                            },
                            {
                                "example_id": "85351098-f246-4f61-aa24-0a500bdfcbd0",
                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                "text": "Looking up the face I could see directly into the Japanese and Hornbein couloirs, an almost direct 9000 feet to the summit."
                            },
                            {
                                "example_id": "ad8468f9-71bf-41fa-b700-8ecf9e707147",
                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                "text": "Ascend a long, easy snow couloir back left to the crest of Cassin Ridge at 17700 feet, where there is a campsite."
                            },
                            {
                                "example_id": "71627040-5ce2-45a5-bf3b-2982d4cc812b",
                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                "text": "2002, American Alpine Club Safety Committee, Alpine Club of Canada Safety Committee, Accidents in North American Mountaineering, Issue 55, page 58,\nWhen they approached the couloir shortly before 0300, the snow was firm enough for them to use crampons."
                            }
                        ]
                    },
                    {
                        "sense_id": "34422008-3871-37a6-93ec-b9b00839005c",
                        "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                        "glosses": [
                            "A corridor or passage."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "27aa37b2-42ef-4d71-add8-4fcf32579796",
                                "sense_id": "34422008-3871-37a6-93ec-b9b00839005c",
                                "text": "It was a hole, in the fence, a large irregular hole, caused by numberless winds, numberless rains, or by a boar, or by a bull, flying, pursuing, a wild boar, a wild bull, blind with fear, blind with rage, or who knows perhaps with carnal desire, crashing at this point, through the fence, weakened by numberless winds, numberless rains. Through this hole I passed, without hurt, or damage to my pretty uniform, and found myself looking about me, for I had not yet recovered my aplomb, in the couloir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "883d1787-14bf-4b29-b706-24a0fe161ab8",
                        "source_entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                        "source_sense_description": "steep gorge along a mountainside",
                        "target_lang_word": "Couloir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Couloir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4000547-ae2c-35dd-a0d7-57386b3cdcd9",
                                        "entry_id": "ea49007f-c79a-3dfd-9238-6ab9bf112847",
                                        "glosses": [
                                            "steile Rinne an einem Berghang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b86bf543-6dc4-4b6d-964d-377299e53716",
                                                "sense_id": "e4000547-ae2c-35dd-a0d7-57386b3cdcd9",
                                                "text": "Vom Sattel durch das Couloir zur Matte hinunter absteigen."
                                            },
                                            {
                                                "example_id": "cabca5c8-7c17-4c33-a9c7-01ca3f5c3f27",
                                                "sense_id": "e4000547-ae2c-35dd-a0d7-57386b3cdcd9",
                                                "text": "Im Couloir ist noch viel Schnee."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de802bce-38cc-48b2-8632-5d25a000d004",
                        "source_entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                        "source_sense_description": "steep gorge along a mountainside",
                        "target_lang_word": "Rinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmale, längliche Vertiefung, durch die Wasser fließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f3b0f6-a626-45b8-a32a-1b75f4af6d60",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Für Wanderer gibt es zwischen den Wänden, Graten und Rinnen kaum Platz, doch die wenigen Möglichkeiten sind atemberaubend.“"
                                            },
                                            {
                                                "example_id": "41fe96ad-7f5b-4873-a018-3709465dad51",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Als wir dicht herankamen, sah ich, dass eine tiefe Rinne hinaufführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "Kurzform für die Fahrrinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26d96a4-b850-4b2f-8b63-22c356bd521d",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Sitzt man am Rhein, so kann man die Frachtschiffe in der Rinne fahren sehen."
                                            },
                                            {
                                                "example_id": "1c865252-3630-4558-a52f-59c8bb44baca",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Die Fahrrinne im Fluss wird extra durch Bojen gekennzeichnet, da diese Rinne im Flussbett auch bei Niedrigwasser immer \"Eine handbreit Platz unter dem Kiel\" bedeutet!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmaler, langer, in Form einer Halbschale ausgehöhlter Körper aus Blech, Holz usw. in der etwas abfließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edd48ac-e091-4190-8bf9-03ff8544ad1b",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "Die Rinne des Daches wird im Herbst oftmals durch Laub verstopft."
                                            },
                                            {
                                                "example_id": "8ed662ff-3d68-49ac-bf31-2b7e213b11a6",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "„Papa stellte zwei Leitern dran, und dann sollten Volker und ich mit Rundspachteln den Kniest aus der Rinne schaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                        "entry_id": "625098f3-7aab-330a-9506-437dca503037",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b7128c-04a7-45f2-9b78-7a2ed54c7130",
                                                "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                                "text": "„Friedrich Heinrich (Fritz) Rinne (* 1852 in Eilsen; † 2. März 1924 in Berlin) war ein deutscher Chirurg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
