                    "sense_definition": "Een specifiek punt in de tijd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op dit <w>moment</w> heb ik helaas geen tijd voor je.",
                            "target_lang_translations": {
                                "en": "At this <w>moment</w>, I unfortunately don't have time for you.",
                                "ru": "В данный <w>момент</w> у меня, к сожалению, нет на тебя времени.",
                                "pl": "W tym <w>momencie</w> nie mam niestety dla ciebie czasu.",
                                "de": "Im <w>Moment</w> habe ich leider keine Zeit für dich.",
                                "fr": "En ce <w>moment</w>, je n'ai malheureusement pas de temps pour toi.",
                                "it": "In questo <w>momento</w> purtroppo non ho tempo per te.",
                                "cs": "V tento <w>moment</w> na tebe bohužel nemám čas.",
                                "tr": "Şu <w>anda</w> maalesef senin için vaktim yok.",
                                "es": "En este <w>momento</w>, lamentablemente no tengo tiempo para ti."
                            }
                        },
                        {
                            "text": "Dit is niet het juiste <w>moment</w> om daarover te praten.",
                            "target_lang_translations": {
                                "en": "This is not the right <w>moment</w> to talk about that.",
                                "ru": "Сейчас не подходящий <w>момент</w>, чтобы говорить об этом.",
                                "pl": "To nie jest odpowiedni <w>moment</w>, aby o tym rozmawiać.",
                                "de": "Dies ist nicht der richtige <w>Moment</w>, um darüber zu sprechen.",
                                "fr": "Ce n'est pas le bon <w>moment</w> pour en parler.",
                                "it": "Questo non è il <w>momento</w> giusto per parlarne.",
                                "cs": "Tohle není ta správná <w>chvíle</w>, abychom o tom mluvili.",
                                "tr": "Bunu konuşmak için doğru <w>zaman</w> değil.",
                                "es": "Este no es el <w>momento</w> adecuado para hablar de eso."
                            }
                        }
