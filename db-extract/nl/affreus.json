                    },
                    {
                        "sense_id": "119981a0-3c45-374c-bae3-e5f59a2a3c13",
                        "entry_id": "033fcc0b-0ac1-3aca-b770-ba2722798f53",
                        "glosses": [
                            "akelig, verschrikkelijk, afschuwelijk"
                        ],
                        "tags": [],
