                        "sense_id": "0f7567bd-b005-3c99-86d0-6d70a684d277",
                        "entry_id": "1b71225f-05f2-3f11-9e9a-0aaf22c2e82a",
                        "glosses": [
                            "Se dit d’un meuble ou d'une partie présentant une surface sur laquelle est posé un orle d’un émail différent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf391ca-ec5d-4a82-81af-9eefc71926f8",
                                "sense_id": "0f7567bd-b005-3c99-86d0-6d70a684d277",
                                "text": "De sable au dragon d’or, au chef chevron renversé du même chargé d’un heaume paré et cimé d’un lion morné, le tout du champ, l’animal reposant sur un bandeau tressé de sept pièces de sable et d’or, garni d’un lambrequin aussi de sable, orlé d’or, le tout accosté de deux mouchetures d’hermine du champ, qui est de la commune de Saint-Derrien du Finistère → voir illustration « armoiries avec un casque orlé »"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea506160-657b-3e16-b182-e7f77a1e8716",
                        "entry_id": "1b71225f-05f2-3f11-9e9a-0aaf22c2e82a",
                        "glosses": [
                            "Se dit d’une pièce, un meuble ou même du champ sur lequel un ensemble de meubles sont rangés en orle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fb7e827c-8ba7-4a7b-834a-a80e1000fb93",
                                "sense_id": "ea506160-657b-3e16-b182-e7f77a1e8716",
                                "text": "D’argent orlé de neuf merlettes de gueules, qui est de la commune de Gaudechart de l’Oise → voir illustration « écu orlé »"
                            }
                        ]
                    }
