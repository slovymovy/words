                "senses": [
                    {
                        "sense_id": "079b66ca-baff-3247-94da-c8d6707b9fc6",
                        "entry_id": "d9087218-82d3-394c-a734-4c45e2351338",
                        "glosses": [
                            "wichtiges Entscheidungs- und Unterscheidungsmerkmal, um Qualität zu beurteilen"
                        ],
                        "tags": [
                            "Hardware",
                            "Software"
                        ],
                        "examples": [
                            {
                                "example_id": "f933cccf-d4bc-4b41-bf2d-b2701f54a0d7",
                                "sense_id": "079b66ca-baff-3247-94da-c8d6707b9fc6",
                                "text": "In diesem Projekt werden noch die Qualitätskriterien von ISO 9126 verwendet. Ab nächstes Jahr verwenden wir dann in neuen Projekten den Nachfolgestandard ISO 25000 an."
                            },
                            {
                                "example_id": "9b026aa0-4055-4475-8539-a08d3ecf212f",
                                "sense_id": "079b66ca-baff-3247-94da-c8d6707b9fc6",
                                "text": "„Wie häufig diese aber zu Ausfällen führen, ist eines der wichtigsten Qualitätskriterien für Programme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95c0a479-b21f-3367-921c-210062d385f0",
                        "entry_id": "d9087218-82d3-394c-a734-4c45e2351338",
                        "glosses": [
                            "Bedingung, um Qualität zu bestätigen"
                        ],
                        "tags": [
                            "Hardware",
                            "Software"
                        ],
                        "examples": [
                            {
                                "example_id": "28689550-2695-4e34-8a81-d63870fce744",
                                "sense_id": "95c0a479-b21f-3367-921c-210062d385f0",
                                "text": "„Die Sicherheit von Lebensmitteln ist der Studie zufolge das übergeordnete Qualitätskriterium, sie ergibt sich aus verschiedenen Aspekten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
