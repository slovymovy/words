                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Konkubine"
                    },
                    {
                        "form_id": "8a90b0bc-acb4-494d-97a1-6231e6a6be8b",
                        "entry_id": "f8164e83-587d-3df4-9b9f-ce23fa2f06c8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Konkubinen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5cf75a2-b4b9-3e51-b6c5-977c641e64de",
                        "entry_id": "f8164e83-587d-3df4-9b9f-ce23fa2f06c8",
                        "glosses": [
                            "eine Frau, die im Konkubinat lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673cc134-ffe3-455d-8e3b-223453b516ad",
                                "sense_id": "b5cf75a2-b4b9-3e51-b6c5-977c641e64de",
                                "text": "„Die meisten versprachen, ihre Konkubinen wegzuschicken, einige weigerten sich.“"
                            },
                            {
                                "example_id": "d9047054-8f3c-45fe-a186-f3cb141afc20",
                                "sense_id": "b5cf75a2-b4b9-3e51-b6c5-977c641e64de",
                                "text": "„Ja, woher wissen sie denn, dass es sich um meine angebliche Konkubine handelt?“"
                            },
                            {
                                "example_id": "94113b61-8781-4afd-9f56-a735d3f472c9",
                                "sense_id": "b5cf75a2-b4b9-3e51-b6c5-977c641e64de",
                                "text": "„1515 verkündete König Manuel I., dass sämtliche Afrikanerinnen, die man den portugiesischen Siedlern als Ehefrauen oder Konkubinen übergeben hatte, und ebenso ihre Kinder frei seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2633076-8ce0-3e2f-8e3f-f3c96d00936f",
                        "entry_id": "f8164e83-587d-3df4-9b9f-ce23fa2f06c8",
                        "glosses": [
                            "abwertend für Geliebte"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba8ec9f4-9d50-4191-a5e5-15c4cd031f72",
                        "source_entry_id": "f8164e83-587d-3df4-9b9f-ce23fa2f06c8",
                        "source_sense_id": "b5cf75a2-b4b9-3e51-b6c5-977c641e64de",
                        "source_sense_description": "eine Frau, die im Konkubinat lebt",
                        "target_lang_word": "concubine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concubine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8450c1c3-9609-324d-aaa3-44b76e5c2c61",
                                        "entry_id": "e17b8801-98d1-3176-8a9c-387d3551dfe0",
                                        "glosses": [
                                            "A sexual partner, especially a woman, to whom one is not or cannot be married."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "696efe23-446c-352d-9ead-50bec2fa0bb7",
                                        "entry_id": "e17b8801-98d1-3176-8a9c-387d3551dfe0",
                                        "glosses": [
                                            "A woman who lives with a man, but who is not a wife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2328fab-5681-438f-a312-ac2c9a3b5530",
                                                "sense_id": "696efe23-446c-352d-9ead-50bec2fa0bb7",
                                                "text": "And that is more than I will yield unto: / I know I am too mean to be your queen, / And yet too good to be your concubine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "966c85c2-3bff-3e2f-9c75-c5b3213b8c87",
                                        "entry_id": "e17b8801-98d1-3176-8a9c-387d3551dfe0",
                                        "glosses": [
                                            "A slave-girl or woman, kept for instance in a harem, who is held for sexual service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37bbc506-ed38-446c-9238-772dac15e621",
                                                "sense_id": "966c85c2-3bff-3e2f-9c75-c5b3213b8c87",
                                                "text": "He ſhall be made a chaſte and luſtleſſe Eunuch,\nAnd in my Sarell tend my Concubines:"
                                            },
                                            {
                                                "example_id": "8b110503-4b3c-4d19-a9ea-766056b32ff0",
                                                "sense_id": "966c85c2-3bff-3e2f-9c75-c5b3213b8c87",
                                                "text": "And the Levite, the husband of the woman that was slain, answered and said, I came into Gibeah that belongeth to Benjamin, I and my concubine, to lodge. And the men of Gibeah rose against me, and beset the house round about upon me by night, and thought to have slain me: and my concubine have they forced, that she is dead. And I took my concubine, and cut her in pieces, and sent her throughout all the country of the inheritance of Israel: for they have committed lewdness and folly in Israel."
                                            },
                                            {
                                                "example_id": "ccbe2b63-4ca5-49e8-8090-19dfc5753227",
                                                "sense_id": "966c85c2-3bff-3e2f-9c75-c5b3213b8c87",
                                                "text": "Solomon, who was one of the Deity's favorities, had a copulation cabinet composed of seven hundred wives and three hundred concubines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
