                        "entry_id": "33934b7d-7065-301d-8a94-dec472334e36",
                        "glosses": [
                            "Homme trans."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "note": "L’usage de ce terme, plutôt que homme trans, sous-entend que les hommes trans ne sont pas des hommes, d’où l’utilisation de trans- comme préfixe pour les différencier des hommes",
                        "examples": [
                            {
                                "example_id": "70a5a598-940e-45ae-bed7-6bf90a083dbd",
                                "sense_id": "76b90842-d628-3032-9cea-f78a6172367c",
                                "text": "C’est le cas pour les « détransitionneuses », des filles et des femmes ayant quitté ce mouvement idéologique et ayant cessé de se dire transhommes."
                            },
                            {
                                "example_id": "0bf233f4-d1f0-4666-9b9d-8f5735be57a7",
                                "sense_id": "76b90842-d628-3032-9cea-f78a6172367c",
                                "text": "Livia, 23 ans, vit comme transhomme depuis cinq ans."
                            }
                        ]
                    }
                ],
