                "senses": [
                    {
                        "sense_id": "68a3fe70-e2b4-3bb4-a885-bc84a90b6ab4",
                        "entry_id": "dfd1cdab-b45d-324a-8018-e9387b88f684",
                        "glosses": [
                            "Scanner, mit dem gerahmte Diapositive digitalisiert werden können"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "f198c2e6-bedb-49bc-9d3e-39c0b7c22dc1",
                                "sense_id": "68a3fe70-e2b4-3bb4-a885-bc84a90b6ab4",
                                "text": "„Für größere Mengen gibt es unterschiedliche Spezialscanner: Entweder wie im Multigerät Flachbettscanner, bei denen die Bilder oder Dias auf eine Glasplatte gelegt und abgetastet werden. Oder Diascanner, bei denen gerahmte Dias oder Filmstreifen (auch Negative) mit einem speziellen Halter von Hand durch den Scanner gezogen werden.“"
                            },
                            {
                                "example_id": "8094fbaf-cee0-4215-8a6f-e1d0370c3b6a",
                                "sense_id": "68a3fe70-e2b4-3bb4-a885-bc84a90b6ab4",
                                "text": "„Jedoch werden seit gut zehn Jahren keine hochwertigen Filmnegativ- und Diascanner mehr hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
