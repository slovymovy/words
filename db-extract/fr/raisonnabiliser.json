                "senses": [
                    {
                        "sense_id": "112fd736-7ace-3aa3-84b0-3bc9ee9b9d71",
                        "entry_id": "14598b9c-41a4-3912-a8c8-8be745a482fc",
                        "glosses": [
                            "Donner un caractère raisonnable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e7bcfc-4245-4394-9be4-de6a3a7b86f2",
                                "sense_id": "112fd736-7ace-3aa3-84b0-3bc9ee9b9d71",
                                "text": "Raisonnabiliser la firme-monde, c’est donc la doter d'un projet de gouvernement durable."
                            },
                            {
                                "example_id": "b9fb79bc-e5fe-4c65-a292-21e6d354e92c",
                                "sense_id": "112fd736-7ace-3aa3-84b0-3bc9ee9b9d71",
                                "text": "L’absolutisme métaphysique à quoi se résigne le silence de la (dé)raison politique conduit à un positivisme de la force : le discours politique ne sert alors qu’à \"raisonnabiliser\" sa victoire, à fournir les raisons accommodantes d’un très chrétien succès."
                            }
                        ]
                    }
