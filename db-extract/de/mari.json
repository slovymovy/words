                                "target_senses": [
                                    {
                                        "sense_id": "299f9d51-eca8-3381-841f-9a3f0e9a9918",
                                        "entry_id": "1c1127f7-67f0-34fd-9563-81be98a4b99d",
                                        "glosses": [
                                            "Langue ouralienne parlée dans la République des Maris en Russie."
                                        ],
                                        "tags": [],
