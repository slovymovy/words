{
    "word_family": [
        "essence",
        "essentially",
        "essentiality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                    "sense_definition": "Completely necessary or extremely important in a particular situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "necessary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water is <w>essential</w> for the survival of all living things.",
                            "target_lang_translations": {
                                "ru": "Вода <w>необходима</w> для выживания всех живых существ.",
                                "tr": "Su, tüm canlıların hayatta kalması için <w>gereklidir</w>.",
                                "zh": "水对于所有生物的生存都是<w>必需的</w>。"
                            }
                        },
                        {
                            "text": "It is <w>essential</w> to read the instructions carefully before starting.",
                            "target_lang_translations": {
                                "ru": "Перед началом работы <w>необходимо</w> внимательно прочитать инструкции.",
                                "tr": "Başlamadan önce talimatları dikkatlice okumak <w>şarttır</w>.",
                                "zh": "开始之前<w>必须</w>仔细阅读说明书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "necessary",
                        "indispensable",
                        "required",
                        "vital",
                        "crucial",
                        "critical"
                    ],
                    "antonyms": [
                        "unnecessary",
                        "unneeded",
                        "non-essential",
                        "unimportant"
                    ],
                    "common_phrases": [
                        "essential for",
                        "essential to",
                        "essential part",
                        "absolutely essential"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно необходимый или чрезвычайно важный в конкретной ситуации.",
                        "tr": "Belli bir durumda tamamen gerekli veya son derece önemli olan.",
                        "zh": "在特定情况下完全必要或极其重要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необходи́мый",
                                "target_lang_sense_clarification": "нужный, обязательный"
                            },
                            {
                                "target_lang_word": "суще́ственный",
                                "target_lang_sense_clarification": "важный, значительный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerekli",
                                "target_lang_sense_clarification": "ihtiyaç duyulan, zorunlu"
                            },
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "asli, olmazsa olmaz"
                            },
                            {
                                "target_lang_word": "şart",
                                "target_lang_sense_clarification": "vazgeçilemez nitelikte"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必要的",
                                "target_lang_sense_clarification": "不可或缺的，必须的"
                            },
                            {
                                "target_lang_word": "至关重要的",
                                "target_lang_sense_clarification": "极其重要的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd46c99f-d0bd-3a87-8938-8458f877b820",
                    "sense_definition": "Relating to the fundamental nature or most important quality of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intrinsic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to address the <w>essential</w> problem rather than just the symptoms.",
                            "target_lang_translations": {
                                "ru": "Нам нужно решать <w>основную</w> проблему, а не просто бороться с симптомами.",
                                "tr": "Sadece semptomlarla ilgilenmek yerine <w>esas</w> sorunu ele almamız gerekiyor.",
                                "zh": "我们需要解决<w>本质</w>问题，而不仅仅是症状。"
                            }
                        },
                        {
                            "text": "Despite the changes, the <w>essential</w> character of the village remained the same.",
                            "target_lang_translations": {
                                "ru": "Несмотря на изменения, <w>основной</w> характер деревни остался прежним.",
                                "tr": "Değişikliklere rağmen, köyün <w>asli</w> karakteri aynı kaldı.",
                                "zh": "尽管发生了变化，这个村庄<w>基本</w>的特征依然如故。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fundamental",
                        "intrinsic",
                        "inherent",
                        "basic",
                        "central"
                    ],
                    "antonyms": [
                        "incidental",
                        "accidental"
                    ],
                    "common_phrases": [
                        "essential nature",
                        "essential character",
                        "essential difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к фундаментальной природе или наиболее важному качеству чего-либо.",
                        "tr": "Bir şeyin temel doğası veya en önemli niteliği ile ilgili olan.",
                        "zh": "与某事物的基本性质或最重要品质相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основно́й",
                                "target_lang_sense_clarification": "фундаментальный, главный"
                            },
                            {
                                "target_lang_word": "суще́ственный",
                                "target_lang_sense_clarification": "относящийся к сущности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asli",
                                "target_lang_sense_clarification": "özüne dair, temel"
                            },
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "ana, en önemli"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基本的",
                                "target_lang_sense_clarification": "构成事物基础的"
                            },
                            {
                                "target_lang_word": "本质的",
                                "target_lang_sense_clarification": "属于事物核心特性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51e30e97-aeaa-31c5-93de-5fde9e358b19",
                    "sense_definition": "Describing a substance, such as a nutrient, that is necessary for survival but must be obtained from the diet because the body cannot produce it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fish and nuts are excellent sources of <w>essential</w> fatty acids.",
                            "target_lang_translations": {
                                "ru": "Рыба и орехи — отличные источники <w>незаменимых</w> жирных кислот.",
                                "tr": "Balık ve kuruyemişler <w>esansiyel</w> yağ asitlerinin mükemmel kaynaklarıdır.",
                                "zh": "鱼类和坚果是<w>必需</w>脂肪酸的极佳来源。"
                            }
                        },
                        {
                            "text": "A balanced diet should provide all the <w>essential</w> amino acids required for health.",
                            "target_lang_translations": {
                                "ru": "Сбалансированная диета должна обеспечивать все <w>незаменимые</w> аминокислоты, необходимые для здоровья.",
                                "tr": "Dengeli bir beslenme, sağlık için gerekli tüm <w>temel</w> amino asitleri sağlamalıdır.",
                                "zh": "均衡的饮食应提供健康所需的全部<w>必需</w>氨基酸。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-essential"
                    ],
                    "common_phrases": [
                        "essential amino acids",
                        "essential fatty acids",
                        "essential nutrients"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает вещество (например, питательное), которое необходимо для жизни, но должно поступать с пищей, так как организм не может его производить.",
                        "tr": "Yaşam için gerekli olan ancak vücut üretemediği için besinler yoluyla alınması gereken madde.",
                        "zh": "描述一种物质（如营养素），它是生存所必需的，但必须从饮食中获取，因为身体无法自行产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незамени́мый",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esansiyel",
                                "target_lang_sense_clarification": "vücudun üretemediği zorunlu besin"
                            },
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "vücut için vazgeçilmez"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必需的",
                                "target_lang_sense_clarification": "生物学上不可替代的营养成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17fcb53f-a310-3a4c-b32f-ea59b29108a9",
                    "sense_definition": "Describing a disease or condition that has no known external cause; idiopathic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor diagnosed the patient with <w>essential</w> hypertension after ruling out other causes.",
                            "target_lang_translations": {
                                "ru": "Врач диагностировал у пациента <w>эссенциальную</w> гипертензию после исключения других причин.",
                                "tr": "Doktor, diğer nedenleri eledikten sonra hastaya <w>esansiyel</w> hipertansiyon teşhisi koydu.",
                                "zh": "医生在排除了其他原因后，诊断该患者患有<w>原发性</w>高血压。"
                            }
                        },
                        {
                            "text": "<w>Essential</w> tremor is a nervous system disorder that causes rhythmic shaking.",
                            "target_lang_translations": {
                                "ru": "<w>Эссенциальный</w> тремор — это расстройство нервной системы, вызывающее ритмичное дрожание.",
                                "tr": "<w>Esansiyel</w> tremor, ritmik titremeye neden olan bir sinir sistemi bozukluğudur.",
                                "zh": "<w>原发性</w>震颤是一种会导致节律性抖动的神经系统疾病。"
                            }
                        }
                    ],
                    "synonyms": [
                        "idiopathic"
                    ],
                    "common_phrases": [
                        "essential hypertension",
                        "essential tremor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает заболевание или состояние, возникающее само по себе, без явной внешней причины; идиопатический.",
                        "tr": "Bilinen harici bir nedeni olmayan hastalık veya durumu tanımlar; idiyopatik.",
                        "zh": "描述一种没有已知外部原因的疾病或状况；特发性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эссенциа́льный",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esansiyel",
                                "target_lang_sense_clarification": "nedeni bilinmeyen tıbbi durum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原发的",
                                "target_lang_sense_clarification": "医学术语，指病因不明的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e78af82-8418-3868-a404-8cbae5dddf4c",
                    "sense_definition": "A basic, indispensable, or necessary thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_basic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We only packed the bare <w>essentials</w> for our camping trip.",
                            "target_lang_translations": {
                                "ru": "Мы взяли в поход только <w>самое необходимое</w>.",
                                "tr": "Kamp gezimiz için sadece en <w>temel ihtiyaçları</w> yanımıza aldık.",
                                "zh": "我们露营只带了最<w>必需品</w>。"
                            }
                        },
                        {
                            "text": "The workshop covers the <w>essentials</w> of digital photography.",
                            "target_lang_translations": {
                                "ru": "Семинар охватывает <w>основы</w> цифровой фотографии.",
                                "tr": "Atölye çalışması, dijital fotoğrafçılığın <w>esaslarını</w> kapsıyor.",
                                "zh": "该研讨会涵盖了数码摄影的<w>基本要素</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "necessity",
                        "requirement",
                        "fundamental",
                        "must-have"
                    ],
                    "antonyms": [
                        "non-essential"
                    ],
                    "common_phrases": [
                        "bare essentials",
                        "the essentials"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовая, незаменимая вещь или предмет первой необходимости.",
                        "tr": "Temel, vazgeçilmez veya gerekli olan şey.",
                        "zh": "基本的、不可或缺的或必要的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предме́ты пе́рвой необходи́мости",
                                "target_lang_sense_clarification": "вещи, без которых нельзя обойтись"
                            },
                            {
                                "target_lang_word": "осно́вы",
                                "target_lang_sense_clarification": "базовые элементы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel ihtiyaçlar",
                                "target_lang_sense_clarification": "vazgeçilmez gereksinimler"
                            },
                            {
                                "target_lang_word": "esaslar",
                                "target_lang_sense_clarification": "bir konunun temelleri"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必需品",
                                "target_lang_sense_clarification": "生活或工作中不可缺少的物品"
                            },
                            {
                                "target_lang_word": "基本要素",
                                "target_lang_sense_clarification": "事物的核心基础"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}