                    "sense_id": "ad9af1e9-e29c-34af-b052-8df11e01445f",
                    "sense_definition": "Personne appelée par la loi ou par testament à recueillir une succession.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a convoqué chaque <w>héritier</w> pour faire la lecture officielle du testament."
                        },
                        {
                            "text": "Comme elle était l'unique <w>héritière</w>, elle a reçu la totalité des biens familiaux."
                        }
                    ],
                    "synonyms": [
                        "légataire",
                        "hoir"
                    ],
                    "common_phrases": [
