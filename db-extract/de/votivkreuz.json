                "senses": [
                    {
                        "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                        "entry_id": "6fea81d5-0823-3a9b-b09b-f981ba6d01ff",
                        "glosses": [
                            "privates, öffentliches Kreuz als Einlösung eines Gelübdes, Versprechens und zum Dank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c2a1cf-4707-4a15-ba0b-0fe9311fd81b",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Votivkreuze: Diese Kreuze sind Aufgrund einem Verlöbnis, aus einem Versprechen oder einem Gelübde aufgestellt worden. In diesen Votivkreuzen begegnet man der Lebens- und Leidgeschichte der Menschen, die zu einer Glaubens- und Dankgeschichte geworden sind.“"
                            },
                            {
                                "example_id": "0bc06744-e0d8-41f0-a532-525ac0d5ba89",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Auf dem Weg zur Heide passiert man am Törchen der Ringmauer ein Votivkreuz von 1738.“"
                            },
                            {
                                "example_id": "82ae37e6-bd1d-4bd6-bac1-3a08d4ae3a51",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Ein typisches Beispiel des Mesener Votivkreuzes ist das Kreuz aus dem Dorf Kosmogorodskaja (Mesener Bezirk, Archangelsker Gebiet), das 1899 am Ufer des Flusses Mesen aufgestellt wurde.“"
                            },
                            {
                                "example_id": "55486ff6-e859-41e6-a034-688d324dbc28",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Diese sog. Votivkreuze wurden nicht selten von einer der zahlreichen geistlichen Bruderschaften, die in dieser Zeit bestanden, gestiftet.“"
                            },
                            {
                                "example_id": "995b8ed1-ee58-490c-bf50-f2428a45f9bb",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Bereits im Juni 2010 setze sich der VVV mit der Denkmalbehörde der Stadt Hennef in Verbindung, da der Christuskorpus von dem Ende des 18. Jahrhunderts stammenden Votivkreuzes in einem erbärmlichen Zustand war.“"
                            },
                            {
                                "example_id": "acfdbc04-6f91-4095-b848-feffedd8cfda",
                                "sense_id": "907426b7-9b02-3594-b979-048d2c388354",
                                "text": "„Das Kreuz wurde 1771 aus rotem Sandstein als Votivkreuz nach der Errettung von Alexander Heen, deshalb \"Lexe\"-Kreuz, aus einer Notlage während eines nächtlichen Ritts mit dem Pferd errichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
