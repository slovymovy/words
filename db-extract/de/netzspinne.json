                ],
                "senses": [
                    {
                        "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                        "entry_id": "cb0395c7-f084-360e-bf72-4681f5b8a539",
                        "glosses": [
                            "Spinne, die Netze baut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7c60bf-2199-4cf7-a2b8-46791bb4ddad",
                                "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                                "text": "„Bei der Netzspinne Argiope aemura entflieht das Männchen nach einer ersten Begattung geschickt den weiblichen Fängen.“"
                            },
                            {
                                "example_id": "f869b5e4-8cd1-4075-865a-62a3205b6e34",
                                "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                                "text": "„Ausser den Netzspinnen gebe es noch Springspinnen und Krabbenspinnen.“"
                            },
                            {
                                "example_id": "03d1ccd8-4042-409c-a92e-0af8c983b0a4",
                                "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                                "text": "„Die Wespenspinne erreicht eine Körperlänge von 15-20 mm (Weibchen) bzw. einschließlich der Beine eine Gesamtkörpergröße von bis zu fünf Zentimetern. Damit ist sie die größte hierzulande natürlich vorkommende Netzspinne.“"
                            },
                            {
                                "example_id": "c86dc8ea-42a9-4905-92f8-def4948c38da",
                                "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                                "text": "„Der Bernsteinklumpen enthielt neben dem ersten fossilen Beleg für den Angriff einer Netzspinne auf ihre Beute noch eine weitere Besonderheit, wie die Forscher berichten.“"
                            },
                            {
                                "example_id": "29a41e1d-285d-4e5b-8b64-8a58ce0b72b0",
                                "sense_id": "2cbca6f7-c845-3ac7-bcb9-f8237bfe167b",
                                "text": "„Ganz unten ist die Streuschicht, in der sich Ameisen tummeln, darüber in der Krautschicht finden Netzspinnen ihren Lebensraum und in den Blüten sorgen Insekten für Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                        "entry_id": "cb0395c7-f084-360e-bf72-4681f5b8a539",
                        "glosses": [
                            "vereinfachtes Liniennetz-Schema"
                        ],
                        "tags": [
                            "especially",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "bc178f32-96d5-4850-b579-c3c136dbbf9b",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„Aussagekräftige Schwarz-Weiß-Photos begleiten die Erklärungen zu den alphabetisch geordneten Stationen der ‚Netzspinne‘.“"
                            },
                            {
                                "example_id": "48a95e5b-a8c9-410e-a025-579027fda0b8",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„Am intensivsten umgemodelt wird die ‚Netzspinne‘ im Osten: Statt der S 6 rollt vom 12. Dezember an die S 2 nach Erding, die Linie S 3 erlebt ihr Comeback zwischen Ebersberg und Nannhofen.“"
                            },
                            {
                                "example_id": "22caebf5-ecd0-4bc2-bee1-cca0fb511788",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„Dann stellt die BVG neue Netzspinnen, Kursbücher, Flyer her.“"
                            },
                            {
                                "example_id": "53c5619a-2bc3-4e5e-aba1-cc077f312e01",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„Etwa 20 Minuten später als üblich wird zur Arbeit kommen. ‚Zum Glück arbeiten wir Gleitzeit‘, sagt sie. Tischler Henrik Stahn flucht und studiert die Netzspinne.“"
                            },
                            {
                                "example_id": "2f62e022-1cde-4b08-8d1e-0c19db340632",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„‚Letztlich könnte bei der Bahn am Ende eine dürre Netzspinne mit sechs oder sieben Strecken im Fernverkehr übrig bleiben‘, sagt er.“"
                            },
                            {
                                "example_id": "bbf41d98-9aa9-48d5-b279-4be728be0f28",
                                "sense_id": "e111a6bc-7c73-3610-bc15-04647fbbe163",
                                "text": "„Dort zeigt eine ‚Netzspinne‘ alle Verbindungen, Abfahrtsminuten und Kontakte auf einen Blick.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
