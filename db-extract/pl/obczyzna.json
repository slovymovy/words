                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "960b544f-5ade-4d37-8d18-1e700a64685f",
                        "source_entry_id": "846276f8-3aee-3f8d-b72e-18991dcb9e9b",
                        "source_sense_id": "9f2722a1-2fca-3292-8204-0bfde5139095",
                        "target_lang_word": "overseas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overseas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b9c3d1-9689-337f-a7a2-d75d7f0f7f60",
                                        "entry_id": "13ba437c-76b6-3658-9d08-a9e73ab32f30",
                                        "glosses": [
                                            "Abroad, especially across the sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d8f789-b4ab-43e1-a493-f03ed24bac35",
                                                "sense_id": "d8b9c3d1-9689-337f-a7a2-d75d7f0f7f60",
                                                "text": "Overseas branches of the company are doing well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d23696-3d57-33db-be6a-ab67d8100f13",
                                        "entry_id": "13ba437c-76b6-3658-9d08-a9e73ab32f30",
                                        "glosses": [
                                            "Used with ethnicities, nationalities, or religious affiliations: living (being resident) in a foreign country."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3fd81c-7676-4fff-8b45-25262e3371f8",
                                                "sense_id": "07d23696-3d57-33db-be6a-ab67d8100f13",
                                                "text": "Overseas Chinese communities exist in North and South America."
                                            },
                                            {
                                                "example_id": "39dcfbec-4b5b-407c-8c25-2ac41c5cb0c5",
                                                "sense_id": "07d23696-3d57-33db-be6a-ab67d8100f13",
                                                "text": "The reputations of our universities and our research base are already under threat because of the fallout from the EU referendum result, which is making the UK an unfriendlier place for overseas scholars and students, as well as cutting off access to an important stream of research funding and to a vibrant and well-developed ecosystem for collaborative work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24731988-e403-3855-bff9-695b1618c6c6",
                                        "entry_id": "13ba437c-76b6-3658-9d08-a9e73ab32f30",
                                        "glosses": [
                                            "Across a sea; to or in an area across a sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8451b7e0-0ec4-4e86-80e2-3b4f6ce958be",
                                                "sense_id": "24731988-e403-3855-bff9-695b1618c6c6",
                                                "text": "Her overseas trip went well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overseas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0b0e36-831b-34d5-8a0d-5b63a2b143ba",
                                        "entry_id": "d9738cd5-92a4-314b-80fd-c5d4ddd1b43a",
                                        "glosses": [
                                            "Abroad."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9fff7b9-c0ec-452a-8826-417bdf4c70ff",
                                                "sense_id": "5d0b0e36-831b-34d5-8a0d-5b63a2b143ba",
                                                "text": "He emigrated and now lives overseas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0255100-2210-3c58-88fc-e7611451db79",
                                        "entry_id": "d9738cd5-92a4-314b-80fd-c5d4ddd1b43a",
                                        "glosses": [
                                            "Across a sea; to an area across a sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d22f5c6-9738-4314-810c-cdbf16ac194b",
                                                "sense_id": "b0255100-2210-3c58-88fc-e7611451db79",
                                                "text": "She travelled overseas."
                                            },
                                            {
                                                "example_id": "84db44cc-51e4-4307-88f2-785570149ffa",
                                                "sense_id": "b0255100-2210-3c58-88fc-e7611451db79",
                                                "text": "(We are agents of the free.) I've had my fun,\nand now it's time to serve\nyour conscience overseas.\nComing in fast, over me..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eaf5418-ce16-48b6-b32e-9760e3dc55c7",
                        "source_entry_id": "846276f8-3aee-3f8d-b72e-18991dcb9e9b",
                        "source_sense_id": "9f2722a1-2fca-3292-8204-0bfde5139095",
                        "target_lang_word": "abroad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abroad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be03866b-be48-3b5b-b21c-eed0a9a0adb7",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "Beyond the bounds of a country; in foreign countries."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247baa02-8b98-4f71-a1ec-9dbc0f12621c",
                                                "sense_id": "be03866b-be48-3b5b-b21c-eed0a9a0adb7",
                                                "text": "A closer look at North Korean history reveals what Pyongyang’s leaders really want their near-farcical belligerence to achieve — a reminder to the world that North Korea exists, and an impression abroad that its leaders are irrational and unpredictable."
                                            },
                                            {
                                                "example_id": "2fe87cd7-82dd-4dd2-b064-d3ddd83fc6ec",
                                                "sense_id": "be03866b-be48-3b5b-b21c-eed0a9a0adb7",
                                                "text": "Another prince, deposed by the Revolution, was living abroad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8673015-0ecb-34ab-b1b2-1f63781fdb36",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "At large; widely; broadly; over a wide space."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70fd347-d50a-4d8d-b5b8-998a2426d814",
                                                "sense_id": "f8673015-0ecb-34ab-b1b2-1f63781fdb36",
                                                "text": "A tree spreads its branches abroad."
                                            },
                                            {
                                                "example_id": "cb1db7d2-2fb5-48e9-a332-216a3a948174",
                                                "sense_id": "f8673015-0ecb-34ab-b1b2-1f63781fdb36",
                                                "text": "\"Faither!\" I cried as I undid the bolt and pushed the leaves of the door abroad, \"Faither, ye are welcome hame!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "Without a certain confine; outside the house; away from one's abode."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bfcdbfa-0ca3-4b38-aac6-88b3ea6c2459",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "I went to St. James', where another was preaching in the court abroad."
                                            },
                                            {
                                                "example_id": "a1a7dcdc-3f96-4f25-932c-7f4e2ae1108e",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "Again: The lonely fox roams far abroad, / On ſecret rapine bent and midnight fraud; […]"
                                            },
                                            {
                                                "example_id": "d25fd73c-bd71-4933-a153-b07100d8df0c",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "She spoke to Strickland in a language of her own, and whenever in her walks abroad she saw things calculated to destroy the peace of Her Majesty the Queen Empress, she returned to her master and gave him information."
                                            },
                                            {
                                                "example_id": "1cb46c4b-7dd3-485d-9d41-5b66180c9d7f",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "Was it so irreconcilable, Warwick wondered, as still to peal out the curfew bell, which at nine o'clock at night had clamorously warned all negroes, slave or free, that it was unlawful for them to be abroad after that hour, under penalty of imprisonment or whipping?"
                                            },
                                            {
                                                "example_id": "cb136f5c-f0ff-4031-b03d-762a8f9cd677",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "But the time was soon over, and before he realized it Tarzan found himself abroad again. Several times De Coude had called, and when he found that Tarzan was anxious for employment of some nature he promised to see what could be done to find a berth for him."
                                            },
                                            {
                                                "example_id": "cbb26da4-ec1c-492c-a734-c8b8f934fbab",
                                                "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                                                "text": "There were very few people abroad and the two men standing quietly under a tree on the opposite side of the boulevard looked out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371e9634-0d66-3683-b32f-d750db80b9c4",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "Before the public at large; throughout society or the world; here and there; moving without restriction."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34773260-a1cd-407d-bac3-43f229ede616",
                                                "sense_id": "371e9634-0d66-3683-b32f-d750db80b9c4",
                                                "text": "This Peece, or Schisme of Suicisme, and Selfishnesse, hath spawned most of the Heresies and Schismes, that are abroad in the World."
                                            },
                                            {
                                                "example_id": "5dd94850-765c-461c-9669-e7f4f7b35b7a",
                                                "sense_id": "371e9634-0d66-3683-b32f-d750db80b9c4",
                                                "text": "But he went out, and beganne to publish it much, and to blase abroad the matter: insomuch that Iesus could no more openly enter into the citie, but was without in desert places: and they came to him from euery quarter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768490ce-dcac-35ed-bcae-1bc3431e2ff8",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "Not on target; astray; in error; confused; dazed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2423f39e-4497-3ded-9935-0a14a6934c16",
                                        "entry_id": "cfcf180b-c742-3997-89d9-43a6638e912c",
                                        "glosses": [
                                            "Played elsewhere than one's home grounds."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abroad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29122081-4a4d-387b-9bfe-7c65d5caa035",
                                        "entry_id": "a9c17b10-f297-3ba8-9ea2-fcbcd777bd01",
                                        "glosses": [
                                            "Countries or lands abroad."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9419bae-5fdb-4a50-b312-7afc5ee2d318",
                                                "sense_id": "29122081-4a4d-387b-9bfe-7c65d5caa035",
                                                "text": "I hate abroad, abroad’s bloody."
                                            },
                                            {
                                                "example_id": "f77fde01-8409-452d-a717-2121d4a9cafc",
                                                "sense_id": "29122081-4a4d-387b-9bfe-7c65d5caa035",
                                                "text": "I am not, however, a xenophobe: obviously, abroad has some good ideas—arranged marriages, violent revolutions and so on."
                                            },
                                            {
                                                "example_id": "2c969e49-2f00-4418-ace6-4b487c658eb7",
                                                "sense_id": "29122081-4a4d-387b-9bfe-7c65d5caa035",
                                                "text": "That is not a xenophobic remark. I am a xenophiliac; I love abroad. I love foreigners. I just do not like the way that they are running the European agricultural policy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abroad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daf8b281-3574-3d0a-8885-28f03981583d",
                                        "entry_id": "e6b7f192-682d-3738-b296-395ecc66b221",
                                        "glosses": [
                                            "Throughout, over."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abroad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                        "entry_id": "e203fef1-47a8-33f7-ab94-385b582e7a2e",
                                        "glosses": [
                                            "International."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4940aa35-f5aa-4c73-a5c8-9fb3ad051780",
                                                "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                                "text": "[...] much shorter than an abroad trip at eight nights although the average spending per person night is only slightly less on a US trip than an abroad trip, $37 compared with $41. Around half of Canadian trips to other countries are to Europe."
                                            },
                                            {
                                                "example_id": "7c3749d5-73da-4de8-ace4-b54f08aa48ac",
                                                "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                                "text": "[...] an abroad trip was going to raise some heat in the town, amongst our relatives. My family has always been the pioneers of middle-classism. My mother has still never owned a diamond."
                                            },
                                            {
                                                "example_id": "721e3550-1a00-4005-85ad-0c3d80342b82",
                                                "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                                "text": "[...] as her father had an abroad trip, he had dropped her mother here."
                                            },
                                            {
                                                "example_id": "54dabe57-8e9d-4124-a6f0-d3fb5c09563e",
                                                "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                                "text": "Sreeja argued with Lalit to reduce his abroad trip and Lalit did listen to her. [...] Sreeja started to feel lonely even when Lalit was around. At certain point Lalit couldn't take it anymore and left for months to an abroad trip."
                                            },
                                            {
                                                "example_id": "e4a24fde-1172-4f31-b1fb-9eacfba1b7fa",
                                                "sense_id": "06783b24-b1e6-3576-9ef2-2099f7b06d93",
                                                "text": "He had contracted the disease during an abroad trip to draw up an agreement for the mass production of low-power engines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a084865c-66b4-4cae-94cf-88adc414abea",
                        "source_entry_id": "846276f8-3aee-3f8d-b72e-18991dcb9e9b",
