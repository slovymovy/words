                "senses": [
                    {
                        "sense_id": "9b5b6a3b-5f55-306f-bf12-e4450d215b4b",
                        "entry_id": "33f3c14d-276c-3912-8b2e-809716fc6a3f",
                        "glosses": [
                            "eine Gaube, ein Aufbau im Dach für die Anbringung senkrecht ausgerichteter Fenster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8ff317-5109-4f6b-b533-437ade59fc41",
                                "sense_id": "9b5b6a3b-5f55-306f-bf12-e4450d215b4b",
                                "text": "Der Raum wurde rechts geteilt durch eine Dachgaube mit einem großen Fenster."
                            },
                            {
                                "example_id": "9d47b78e-3b3d-46b4-b0b1-8337c991407c",
                                "sense_id": "9b5b6a3b-5f55-306f-bf12-e4450d215b4b",
                                "text": "„Jetzt wurde der zweite Stock ausgebaut und mit großen Dachgauben versehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5009aac7-9d93-462f-97a7-daa446f7c9a2",
                        "source_entry_id": "33f3c14d-276c-3912-8b2e-809716fc6a3f",
                        "source_sense_id": "9b5b6a3b-5f55-306f-bf12-e4450d215b4b",
                        "source_sense_description": "Bauwesen: eine Gaube, ein Aufbau im Dach für die Anbringung senkrecht ausgerichteter Fenster",
                        "target_lang_word": "dormer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dormer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9e3555-6d3e-3f6b-a63e-839f326ef87a",
                                        "entry_id": "3927414c-f736-3345-bc02-7661f2161e99",
                                        "glosses": [
                                            "A room-like, roofed projection from a sloping roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97329ea4-3f96-4439-8830-d42030527a52",
                                                "sense_id": "9f9e3555-6d3e-3f6b-a63e-839f326ef87a",
                                                "text": "Then we came to a high white wall that surrounded a large garden, and within it was a long, massive building of some beauty and pretension, with a high, latticed belfry and heavy walls and with arched dormers in the sloping roof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050bfcac-2ae5-3235-8069-66a33a2fb9ff",
                                        "entry_id": "3927414c-f736-3345-bc02-7661f2161e99",
                                        "glosses": [
                                            "Ellipsis of dormer-window."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dormer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc60e3cc-e616-31c1-913a-60a164417a74",
                                        "entry_id": "713a78df-702e-33b1-928c-aa50b9c0fa30",
                                        "glosses": [
                                            "A resident of a dormitory."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b383b7a-02a6-4711-9a6d-ddbb53559e66",
                                                "sense_id": "bc60e3cc-e616-31c1-913a-60a164417a74",
                                                "text": "My dorm mates and I had a little get-together in our room on the second floor. We were just talking and weren't making much noise when we heard a knock on our door. It was a dormer from the room directly below us. She asked if we were cleaning and we told her that we weren't. She left but came back a little while later and asked the same question again. We asked her if our matron wants us to clean up. The dormer said no and left. But after a few minutes, she came up again and again asked if we were cleaning our room because she could hear the noise down in her room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
