                                        "entry_id": "9e0bd867-82bf-3716-bd83-0b4b91125b8e",
                                        "glosses": [
                                            "Someone from Rhodesia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac694654-5852-44a4-b0fd-1247e9cecd40",
                                                "sense_id": "7eeaa990-6565-379b-ad99-6d4705712c1a",
                                                "text": "Six or seven steps were needed to traverse these parking spaces whose white painted boundaries accommodated the large and long vehicles of elite Rhodesians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
