                            {
                                "example_id": "e60915e8-a16b-4cb7-b1e8-18b288dfb2b3",
                                "sense_id": "ae0b0320-b604-34a8-b932-ca953533a373",
                                "text": "Die Überflußgesellschaft überläßt ihnen den Überfluß an entwertetem Gammel und sie entdecken (…) seine zweite Schönheit."
                            },
                            {
                                "example_id": "58133145-bf23-4f1d-86b1-264941e3bea8",
                                "sense_id": "ae0b0320-b604-34a8-b932-ca953533a373",
                                "text": "Lass uns Kühlschrank und Speisekammer aufräumen und allen alten Gammel entsorgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c65ecb8b-2043-3740-be46-ab10342d1b31",
                        "entry_id": "f45d69cb-4cad-3f6a-8e70-54869ed948d5",
                        "glosses": [
                            "nicht verwertbarer Beifang, der zum Beispiel zu Fischmehl verarbeitet wird"
                        ],
                        "tags": [
                            "Berufsfischerei"
                        ],
                        "examples": [
                            {
