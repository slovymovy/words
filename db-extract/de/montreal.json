                                                "example_id": "3b7504a6-570f-43d5-9645-a10d81d5ee6a",
                                                "sense_id": "35e6abef-eebf-3395-8745-86aaa78d47ef",
                                                "text": "J’ai eu pas mal de clients avec le gaz qui a remonté à Montréal les gens vont tinquer aujourd’hui, et toi?"
                                            }
                                        ]
