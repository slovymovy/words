{
    "word_family": [
        "постоянный",
        "постоянство"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2f0bd55f-3c81-3e3b-8191-e77b035fbf3e",
                    "sense_definition": "Всегда, обычно, регулярно; повторяясь через промежутки времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <постоянно> забываю, куда положил свои ключи.",
                            "target_lang_translations": {
                                "en": "I <constantly> forget where I put my keys.",
                                "zh": "我<w>经常</w>忘记把钥匙放在哪儿了。"
                            }
                        },
                        {
                            "text": "Они <постоянно> ходят в этот магазин за свежими продуктами.",
                            "target_lang_translations": {
                                "en": "They <regularly> go to this shop for fresh groceries.",
                                "zh": "他们<w>经常</w>去那家店买新鲜食材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всегда",
                        "обычно",
                        "регулярно",
                        "часто",
                        "неизменно"
                    ],
                    "antonyms": [
                        "редко",
                        "никогда"
                    ],
                    "common_phrases": [
                        "постоянно опаздывать",
                        "постоянно забывать",
                        "постоянно встречаться"
                    ],
                    "target_lang_definitions": {
                        "en": "Always, usually, or regularly; repeating over intervals of time.",
                        "zh": "总是、通常或定期地；在一段时间内重复发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constantly",
                                "target_lang_sense_clarification": "happening repeatedly or all the time"
                            },
                            {
                                "target_lang_word": "all the time",
                                "target_lang_sense_clarification": "very frequently"
                            },
                            {
                                "target_lang_word": "regularly",
                                "target_lang_sense_clarification": "at repeated intervals"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经常",
                                "target_lang_sense_clarification": "表示动作发生的频率高"
                            },
                            {
                                "target_lang_word": "总是",
                                "target_lang_sense_clarification": "表示动作反复出现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70638504-b52f-3759-8514-9f174c0a0bda",
                    "sense_definition": "Непрерывно, не прекращаясь или не прекращая что-либо делать.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <постоянно> говорит о своей новой работе и планах.",
                            "target_lang_translations": {
                                "en": "He <constantly> talks about his new job and plans.",
                                "zh": "他<w>一直</w>在谈论他的新工作和计划。"
                            }
                        },
                        {
                            "text": "В этом регионе осенью <постоянно> идут проливные дожди.",
                            "target_lang_translations": {
                                "en": "In this region, heavy rains fall <continuously> in the autumn.",
                                "zh": "这个地区秋天<w>不断</w>地下着大雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "непрерывно",
                        "вечно",
                        "перманентно"
                    ],
                    "antonyms": [
                        "изредка",
                        "спорадически"
                    ],
                    "common_phrases": [
                        "постоянно думать",
                        "постоянно говорить",
                        "постоянно работать"
                    ],
                    "target_lang_definitions": {
                        "en": "Continuously, without stopping or interruption.",
                        "zh": "连续不断地，没有停止或中断。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continuously",
                                "target_lang_sense_clarification": "without pause or interruption"
                            },
                            {
                                "target_lang_word": "constantly",
                                "target_lang_sense_clarification": "without stopping"
                            },
                            {
                                "target_lang_word": "incessantly",
                                "target_lang_sense_clarification": "without stopping (often implying annoyance)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不断",
                                "target_lang_sense_clarification": "强调动作持续进行"
                            },
                            {
                                "target_lang_word": "一直",
                                "target_lang_sense_clarification": "强调状态或动作持续未停"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a49db2f-fda7-31de-98da-3ebeb4572c29",
                    "sense_definition": "В расчёте на длительный срок, не временно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя семья живёт здесь <постоянно> уже более пяти лет.",
                            "target_lang_translations": {
                                "en": "My family has lived here <permanently> for over five years.",
                                "zh": "我家人在这里<w>长期</w>居住已经超过五年了。"
                            }
                        },
                        {
                            "text": "Этот сотрудник принят в наш штат <постоянно>, а не на сезон.",
                            "target_lang_translations": {
                                "en": "This employee was hired to our staff <permanently>, and not for the season.",
                                "zh": "这位员工是<w>长期</w>聘用的，而不是季节性的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "долгосрочно"
                    ],
                    "antonyms": [
                        "временно"
                    ],
                    "common_phrases": [
                        "жить постоянно",
                        "работать постоянно",
                        "проживать постоянно"
                    ],
                    "target_lang_definitions": {
                        "en": "Intended to last for a long time; not temporarily.",
                        "zh": "打算长期持续，而非暂时。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "permanently",
                                "target_lang_sense_clarification": "for a long time or forever"
                            },
                            {
                                "target_lang_word": "for good",
                                "target_lang_sense_clarification": "forever"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长期",
                                "target_lang_sense_clarification": "指时间跨度长"
                            },
                            {
                                "target_lang_word": "永久",
                                "target_lang_sense_clarification": "指固定不变"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ac53f66-92fe-3e31-a5b7-94f351392c43",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>постоянный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Напряжение в электрической сети было <постоянно> и стабильно.",
                            "target_lang_translations": {
                                "en": "The voltage in the electrical network was <constant> and stable.",
                                "zh": "电网中的电压既<w>恒定</w>又稳定。"
                            }
                        },
                        {
                            "text": "Его внимание к важным деталям было <постоянно> в течение всего дня.",
                            "target_lang_translations": {
                                "en": "His attention to important details was <consistent> throughout the day.",
                                "zh": "他整天对重要细节的关注都保持<w>稳定</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective meaning constant or stable (neuter singular).",
                        "zh": "形容词“恒定”或“稳定”的短形式（中性单数）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "unchanging"
                            },
                            {
                                "target_lang_word": "consistent",
                                "target_lang_sense_clarification": "steady and reliable"
                            },
                            {
                                "target_lang_word": "stable",
                                "target_lang_sense_clarification": "not fluctuating"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恒定",
                                "target_lang_sense_clarification": "指状态保持不变"
                            },
                            {
                                "target_lang_word": "稳定",
                                "target_lang_sense_clarification": "指状态平稳"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}