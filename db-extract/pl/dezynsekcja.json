                                "target_senses": [
                                    {
                                        "sense_id": "a8346878-e5b2-3db6-a828-811434948561",
                                        "entry_id": "8fd5af7f-b630-3009-9eb8-387e4b3f4268",
                                        "glosses": [
                                            "Action de désinsectiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4370999d-db99-4d7a-bc2e-5e0d5c00252b",
                                                "sense_id": "a8346878-e5b2-3db6-a828-811434948561",
                                                "text": "Le domaine principal d’emploi de l’aldrine réside dans la désinsectisation des sols (lutte contre les Taupins, Vers blancs, etc… ^([sic : etc.]))."
                                            },
                                            {
                                                "example_id": "042c3d91-4895-48d4-a676-1df28ff4e5fc",
                                                "sense_id": "a8346878-e5b2-3db6-a828-811434948561",
                                                "text": "Son savoir-faire s’applique à trois domaines de compétences : la lutte contre les rongeurs et les nuisibles volants (dératisation et dépigeonnage), la lutte contre les insectes rampants et volants (désinsectisation), la lutte contre les bactéries (désinfection)."
                                            }
                                        ]
                                    }
                                ]
                            }
