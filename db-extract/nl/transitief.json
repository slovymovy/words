                "senses": [
                    {
                        "sense_id": "9e0880f1-0edf-3c56-b071-6f12be86dd00",
                        "entry_id": "de604f74-8743-31d3-9bad-4315f4789261",
                        "glosses": [
                            "overgankelijk"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba0cb756-8429-30e2-b13f-a50b1adb7d38",
                        "entry_id": "de604f74-8743-31d3-9bad-4315f4789261",
                        "glosses": [
                            "overdraagbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23f16716-3176-4bb0-a734-c7980ca8d1ba",
                                "sense_id": "ba0cb756-8429-30e2-b13f-a50b1adb7d38",
                                "text": "In de wiskunde is een binaire relatie R over een verzameling X transitief, als steeds wanneer een element a gerelateerd is aan een element b en element b op zijn beurt weer gerelateerd is aan een element c, dat dan ook element a gerelateerd is aan element c"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5874b345-0871-4036-867f-90c3b8df559c",
                        "source_entry_id": "de604f74-8743-31d3-9bad-4315f4789261",
                        "target_lang_word": "transitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8beb4b1-453b-39b7-9637-5149764f6d64",
                                        "entry_id": "fec9a04f-75a0-3f5f-95d9-82d0643b190b",
                                        "glosses": [
                                            "ein Akkusativobjekt mit sich ziehend (bei Verben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a03765-1dae-4990-be55-5e1d51d58e88",
                                                "sense_id": "f8beb4b1-453b-39b7-9637-5149764f6d64",
                                                "text": "„Sehen“ ist ein transitives Verb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                        "entry_id": "fec9a04f-75a0-3f5f-95d9-82d0643b190b",
                                        "glosses": [
                                            "eine zweistellige Relation R heißt transitiv, wenn aus a R b und b R c stets a R c folgt."
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6214952e-3bd8-437b-a634-4b18defc5ea7",
                                                "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                                "text": "Typische transitive Relationen sind die Ordnungsrelationen: Aus a > b und b > c etwa folgt immer a > c."
                                            },
                                            {
                                                "example_id": "82673266-a19a-4df2-b5c4-952d6f37bec7",
                                                "sense_id": "2fc421c5-65ea-35cb-8e50-d3a3606d4e58",
                                                "text": "„Die Teilerrelation ist transitiv, ergibt also eine Ordnung auf N.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ae1afb-eb37-48e3-9970-9fa408c65477",
                        "source_entry_id": "de604f74-8743-31d3-9bad-4315f4789261",
                        "target_lang_word": "transitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1358c105-c5df-3b55-9af1-7a51320c2e5c",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Making a transit or passage."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7e8602-6000-4871-8392-8e80c359e954",
                                                "sense_id": "1358c105-c5df-3b55-9af1-7a51320c2e5c",
                                                "text": "For all symbols are fluxional; all language is vehicular and transitive, and is good, as ferries and horses are, for conveyance, not as farms and houses are, for homestead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6fbe86-95f1-34f1-942b-1cd32ba46f22",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Affected by transference of signification."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6381ddb9-2f50-4a41-ac16-b843dd6de226",
                                                "sense_id": "8f6fbe86-95f1-34f1-942b-1cd32ba46f22",
                                                "text": "By far the greater part of the transitive or derivative applications of words depend on casual and unaccountable caprices of the feelings or the fancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23960f06-0918-33bc-aa89-70c0519dd555",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Taking a direct object or objects."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461bd488-257d-4d98-a72a-0c0739ead5d4",
                                                "sense_id": "23960f06-0918-33bc-aa89-70c0519dd555",
                                                "text": "The English verb \"to notice\" is a transitive verb, because we say things like \"She noticed a problem\"."
                                            },
                                            {
                                                "example_id": "3a3dec2b-e274-4cba-90e9-cbea8bec6fe9",
                                                "sense_id": "23960f06-0918-33bc-aa89-70c0519dd555",
                                                "text": "Men have tried to turn \"revolutionise\" from a transitive to an intransitive verb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ece2bb5c-0815-3c75-8dd6-2066f04f817f",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Having the property that if an element a is related to b and b is related to c, then a is necessarily related to c."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa91202b-f55d-42b9-8f76-045f71f51bd9",
                                                "sense_id": "ece2bb5c-0815-3c75-8dd6-2066f04f817f",
                                                "text": "\"Is an ancestor of\" is a transitive relation: if Alice is an ancestor of Bob, and Bob is an ancestor of Carol, then Alice is an ancestor of Carol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fdfc0d-420a-30aa-80e9-fcb02b14d499",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Such that, for any two elements of the acted-upon set, some group element maps the first to the second."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83e6acff-0575-3ff6-a547-8687dc2c2078",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Such that, for any two vertices there exists an automorphism which maps one to the other."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c04a6b5a-82a7-3b90-ad38-71deee98fbec",
                                        "entry_id": "3304c9f7-4b84-3db8-ace8-4ccfd24c9cea",
                                        "glosses": [
                                            "Of a set of dice: not having the intransitive property."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "transitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa99b008-7cee-315e-933e-153ecdc5260b",
                                        "entry_id": "a7743eef-2a8e-37b9-9667-13745738cff7",
                                        "glosses": [
                                            "A transitive verb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2553be59-17b8-4030-8b91-4005bc83e139",
                                                "sense_id": "aa99b008-7cee-315e-933e-153ecdc5260b",
                                                "text": "This means that subcategorization properties do not allow us to distinguish between transitives and intransitives (both types of verbs are allowed, but not obliged, to take a direct object)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c872abb-bc3c-4992-8721-f1adcd9b0622",
                        "source_entry_id": "de604f74-8743-31d3-9bad-4315f4789261",
                        "target_lang_word": "transitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1156ebe-cdd2-3daa-b317-5a3a6a987a1e",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Se dit d’un verbe, ou d’un emploi d’un verbe, qui accepte ou attend un complément d’objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e90cca-35be-4a38-9034-9b70d6837201",
                                                "sense_id": "b1156ebe-cdd2-3daa-b317-5a3a6a987a1e",
                                                "text": "La prédication peut être soit intransitive (Marie chante), soit transitive (Paul abat un arbre)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d8501b-6ea7-34fa-b587-32c7d9762f14",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Se dit d’un verbe, ou d’un emploi d’un verbe, qui accepte ou attend un complément d’objet.",
                                            "Transitif direct si c’est un complément d’objet direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5dd385-2ebd-4a0a-9abc-4ca05963a3dc",
                                                "sense_id": "c9d8501b-6ea7-34fa-b587-32c7d9762f14",
                                                "text": "Dans la phrase « Il mange une pomme. », le verbe manger est transitif direct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f00d50-0b17-3e66-9448-365fce10145f",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Se dit d’un verbe, ou d’un emploi d’un verbe, qui accepte ou attend un complément d’objet.",
                                            "Transitif indirect si c’est un complément d’objet indirect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b15e067b-15d4-4c41-a5a4-718f711857c8",
                                                "sense_id": "73f00d50-0b17-3e66-9448-365fce10145f",
                                                "text": "Dans la phrase « Il rêve qu’il vole, il rêve d’un oiseau. », le verbe rêver est transitif indirect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3e5085-3f4c-3bd9-8c4e-1d83d1be23e5",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Se dit d'une cause ou d'une action exercée par un agent (sujet) sur un objet extérieur produisant une conséquence sur cet objet sans que l'agent ne soit affecté par l'action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70fbf788-a003-387a-8257-6050f5e30318",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Se dit d’une relation qui s’appliquant d’un premier élément à un second et du second à un troisième, s’applique également du premier au troisième. Formellement, la relation ℛ est telle que : si (x ℛ y) et si (y ℛ z), alors (x ℛ z)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68de2b7-b312-4cb5-ad0e-d0c8d4bbd473",
                                                "sense_id": "70fbf788-a003-387a-8257-6050f5e30318",
                                                "text": "L’égalité est une relation transitive car, si x=y et si y=z, alors x=z."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb7e6a39-4e6b-31ef-9055-44f4063ada6d",
                                        "entry_id": "64aa2b73-6c65-39b6-9205-1376fba3b766",
                                        "glosses": [
                                            "Dans les langues inuites et yupikes, se dit d’un verbe dont la conjugaison utilise des désinences impliquant deux actants (biactancielles), se référant généralement à un agent et à un patient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
