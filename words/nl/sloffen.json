                    "sense_id": "c2cc5a19-1d39-341a-941c-279070d69832",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>slof</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "schoeisel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij trekt zijn warme <w>sloffen</w> aan zodra hij thuiskomt van zijn werk.",
                            "target_lang_translations": {
                                "en": "He puts on his warm <w>slippers</w> as soon as he gets home from work."
                            }
                        },
                        {
                            "text": "In de gang staan verschillende paren <w>sloffen</w> klaar voor de gasten.",
                            "target_lang_translations": {
                                "en": "In the hallway, several pairs of <w>slippers</w> are ready for the guests."
                            }
                        }
                    ],
                    "synonyms": [
