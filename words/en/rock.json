                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>rock</w> the baby to sleep in the cradle.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>укачай</w> ребенка в колыбели."
                            }
                        },
                        {
                            "text": "The empty swing <w>rocked</w> back and forth in the gentle wind.",
                            "target_lang_translations": {
                                "ru": "Пустые качели <w>качались</w> взад-вперед на легком ветру."
                            }
                        }
                    ],
                    "synonyms": [
