                                        "glosses": [
                                            "met een zoutgehalte dat tussen zout en zoet in ligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5cf2eb2-9347-4d5a-afb7-cf2e5c4afb86",
                                                "sense_id": "35268331-8fd9-3621-bfa2-78cdf76453ff",
                                                "text": "Die sloot bestaat uit brak water."
                                            },
                                            {
                                                "example_id": "c5b30654-26ea-4e3d-bf6b-57e381107661",
                                                "sense_id": "35268331-8fd9-3621-bfa2-78cdf76453ff",
                                                "text": "Toen het licht uitviel hadden ze op petroleumlampen kunnen overschakelen, en omdat er geen water meer uit de kraan kwam werd er op een oliestel brak water gekookt om koffie te zetten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae94bca3-8383-31d6-9770-0abcd387f296",
                                        "entry_id": "2fbe4a94-e211-3762-a806-11e60d795aaa",
                                        "glosses": [
                                            "braakliggend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "104eac91-f5c7-40a4-9a7e-0ebac8f4127f",
                                                "sense_id": "ae94bca3-8383-31d6-9770-0abcd387f296",
                                                "text": "De brakke grond kon worden gebruikt om huizen op te bouwen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b87a6dd4-b4ae-3bb1-807f-88602802698e",
                                        "entry_id": "2fbe4a94-e211-3762-a806-11e60d795aaa",
                                        "glosses": [
                                            "onprettig voelend, flauw, met een kater"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655c2c5c-4feb-4177-9202-a39525126f12",
                                                "sense_id": "b87a6dd4-b4ae-3bb1-807f-88602802698e",
                                                "text": "Ik heb gisteren te veel gedronken en voel me nu brak."
                                            },
                                            {
                                                "example_id": "0bb6ae92-5fd1-4487-b456-3cd5c6c088a6",
                                                "sense_id": "b87a6dd4-b4ae-3bb1-807f-88602802698e",
                                                "text": "Ik werd brak wakker in een zure lucht van zweetvoeten, ongewassen kleren en halflege pizzadozen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e318347-ce3a-3154-9d1f-fc205babe473",
                                        "entry_id": "e1e82851-e959-313d-8b9c-2e9c9a036492",
                                        "glosses": [
                                            "enkelvoud verleden tijd van breken"
