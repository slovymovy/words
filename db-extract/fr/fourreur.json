                    },
                    {
                        "form_id": "90dff618-3eae-4bce-aef0-a4b429d5d168",
                        "entry_id": "24592ac5-eb4f-3e03-8e3e-0365fec06983",
                        "tags": [
                            "feminine"
                        ],
                        "form": "fourreuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0f0ead0-bc79-3e14-a091-f5d22ef244f9",
                        "entry_id": "24592ac5-eb4f-3e03-8e3e-0365fec06983",
                        "glosses": [
                            "Celui qui travaille les peaux et en fabrique des fourrures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8749019-f4fd-4e7c-88ff-0257c8d42662",
                                "sense_id": "d0f0ead0-bc79-3e14-a091-f5d22ef244f9",
                                "text": "Les fourreurs n'utilisent pas la peau du ventre [de la taupe]"
                            },
                            {
                                "example_id": "aad627d2-fb1c-4e29-9390-4e8bcb4000d6",
                                "sense_id": "d0f0ead0-bc79-3e14-a091-f5d22ef244f9",
                                "text": "Comme on dit à Combray, il n’y a pas de fourreurs qui s’y connaissent aussi bien comme les mites. Elles se mettent toujours dans les meilleures étoffes."
                            }
                        ]
                    },
                    {
                        "sense_id": "df612dca-4c41-3678-a1ad-90bf2900f77f",
                        "entry_id": "24592ac5-eb4f-3e03-8e3e-0365fec06983",
                        "glosses": [
                            "Celui qui vend des fourrures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d991ac-4e38-49a3-9ef1-bec0f4fa4d2e",
                                "sense_id": "df612dca-4c41-3678-a1ad-90bf2900f77f",
                                "text": "Dans le parisien et noble dessein de lui rendre ses hommages, un fourreur célèbre s'était empressé de lui faire don d'un manteau à vous couper la parole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bafd863-5088-44b9-a11f-d512e5f845ae",
                        "source_entry_id": "24592ac5-eb4f-3e03-8e3e-0365fec06983",
                        "target_lang_word": "Pelzhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pelzhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "388d1aba-35c3-3ab7-8c80-624b2611082d",
                                        "entry_id": "abdb33ca-b6c4-3b94-8954-8002600db32e",
                                        "glosses": [
                                            "jemand, der professionell Pelze kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8fba21f-f9bb-42d6-8b43-3b2ccaddad50",
                                                "sense_id": "388d1aba-35c3-3ab7-8c80-624b2611082d",
                                                "text": "Pelzhändler haben oft Probleme mit Tierschützern."
                                            },
                                            {
                                                "example_id": "ae7441f9-7ea3-44f1-aee2-c06c8662a0ca",
                                                "sense_id": "388d1aba-35c3-3ab7-8c80-624b2611082d",
                                                "text": "„Weißfisch dient den Pelzhändlern als Hauptnahrungsmittel.“"
                                            },
                                            {
                                                "example_id": "aaf92a4b-4da6-4ef7-a8b3-657214e4ea9f",
                                                "sense_id": "388d1aba-35c3-3ab7-8c80-624b2611082d",
                                                "text": "„Erst als der Pelzhändler mißtrauisch wurde, gab es Krach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
