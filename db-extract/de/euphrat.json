                    {
                        "sense_id": "b9989dbb-600f-3110-af14-01b44ac65f35",
                        "entry_id": "ff0ab61e-dcb0-3549-9429-650a936d6362",
                        "glosses": [
                            "großer Strom in Vorderasien"
