                "senses": [
                    {
                        "sense_id": "c5da40e1-e02e-3566-bf43-a506a8a4a887",
                        "entry_id": "6d6d0af0-bc17-3144-b409-fbe343d78cd2",
                        "glosses": [
                            "Rendre flou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad1aa21-345e-421b-8e09-83111038b1e6",
                                "sense_id": "c5da40e1-e02e-3566-bf43-a506a8a4a887",
                                "text": "Un voile diaphane \"flouifie\" l'aridité des choses et des êtres qui se dessinent sans violence dans une étrange pureté lumineuse."
                            },
                            {
                                "example_id": "4c1155ff-c96c-4d98-996a-9a98619a3913",
                                "sense_id": "c5da40e1-e02e-3566-bf43-a506a8a4a887",
                                "text": "Pourquoi personne ne veut-il flouifier la logique de jouer du violon ?"
                            },
                            {
                                "example_id": "ecf8284a-34ef-464c-b673-3ca48c09349c",
                                "sense_id": "c5da40e1-e02e-3566-bf43-a506a8a4a887",
                                "text": "J'adore flouifier tout ce qui ne bouge pas!"
                            }
                        ]
                    }
                ],
