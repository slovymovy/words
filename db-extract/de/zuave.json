                "senses": [
                    {
                        "sense_id": "2d830b41-37e3-320d-a952-05c7c978c2a3",
                        "entry_id": "c1004ba3-989e-3053-8712-9ef85961b39a",
                        "glosses": [
                            "in französischen Diensten stehender Soldat, der aus Nordafrika rekrutiert wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "335b9ee4-8d8d-4efc-8a39-4689fd0b0df7",
                                "sense_id": "2d830b41-37e3-320d-a952-05c7c978c2a3",
                                "text": "„Etwa drei Stunden lang verteidigten ungefähr 8.000 Briten ihre Stellung gegen rund 30.000 Russen in erbitterten Kämpfen. Dann griffen französische Zuaven und die Fremdenlegionäre die Russen wiederum in der Flanke an und zwangen diese zum Rückzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61439581-1166-42a5-b7c1-d9a1b76f1be4",
                        "source_entry_id": "c1004ba3-989e-3053-8712-9ef85961b39a",
                        "source_sense_id": "2d830b41-37e3-320d-a952-05c7c978c2a3",
