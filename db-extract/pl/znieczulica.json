                        "target_lang_word": "Gefühllosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefühllosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae71b6c-8521-3a8c-ab1a-bdeae7a31ed5",
                                        "entry_id": "8b2283cd-432b-35ac-8ccc-e31d4ff2daac",
                                        "glosses": [
                                            "Eigenschaft, nichts zu spüren"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6466b3d8-b6e1-39d6-af6e-bd55f4ed2085",
                                        "entry_id": "8b2283cd-432b-35ac-8ccc-e31d4ff2daac",
                                        "glosses": [
                                            "Eigenschaft, gefühllos zu sein, keine Gefühle zu haben/zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8134d54d-6254-46f0-afef-b54e84b84bcb",
                                                "sense_id": "6466b3d8-b6e1-39d6-af6e-bd55f4ed2085",
                                                "text": "„Seine Antworten sind kurz, verärgert, fast immer bis zur Gefühllosigkeit sachlich, nämlich auf seinen eigenen Zustand bezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2094593-5a86-40af-840d-ea89e388fb18",
                        "source_entry_id": "7d915e5f-6b0c-3039-881b-4c5f49c63e25",
                        "source_sense_id": "7509f748-da2b-31ab-bb4c-193af791415b",
                        "target_lang_word": "Unempfindlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unempfindlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c915397f-3ee4-3e2e-96af-7805e682759b",
                                        "entry_id": "c5756d7c-c51c-3b6b-9418-135e73ecb0da",
                                        "glosses": [
                                            "Eigenschaft, nicht empfindlich zu sein, eine gewisse Widerstandsfähigkeit aufzuweisen; nicht leicht zu verletzen, zu beschädigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c061e75-f1ed-4d3e-b119-4c6b5473bdb2",
                                                "sense_id": "c915397f-3ee4-3e2e-96af-7805e682759b",
                                                "text": "„Besonders bemerkenswert ist die weitgehende Unempfindlichkeit gegen schroffen Temperaturwechsel; weißglühende Gefäße können ohne weiteres in Eiswasser geworfen werden.“"
                                            },
                                            {
                                                "example_id": "f84ae82b-5b66-4be4-b350-f544ba840bbc",
                                                "sense_id": "c915397f-3ee4-3e2e-96af-7805e682759b",
                                                "text": "„Die große Unempfindlichkeit gegenüber zum Beispiel Öl, Schmutz, Staub, Feuchte, prädestiniert dieses Messprinzip für Anwendungen in rauer, industrieller Umgebung.“"
                                            },
                                            {
                                                "example_id": "744c5cbe-d664-45ed-bc71-ef9ab5b5739a",
                                                "sense_id": "c915397f-3ee4-3e2e-96af-7805e682759b",
                                                "text": "„Insbesondere haben zahlreiche Männer die Unempfindlichkeit der Häute und Sehnen angegriffen, und noch mehrere verteidigt.“"
                                            },
                                            {
                                                "example_id": "d5020d16-c9aa-4816-b9c8-e4a25c249256",
                                                "sense_id": "c915397f-3ee4-3e2e-96af-7805e682759b",
                                                "text": "„Bei der Unempfindlichkeit findet man entweder vollständige Empfindungslosigkeit bei Berührung oder es ist nur die Schmerzempfindung aufgehoben; man spricht dann von aufgehobener Schmerzempfindlichkeit (Analgesie).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
