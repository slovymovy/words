        "fr-extract.jsonl": [
            {
                "entry_id": "b36c0c4f-be29-3e9f-8f57-52e5c76b10de",
                "word": "feuillée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbf98eef-7beb-4088-948b-7ed45da2df4d",
                        "entry_id": "b36c0c4f-be29-3e9f-8f57-52e5c76b10de",
                        "tags": [
                            "plural"
                        ],
                        "form": "feuillées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                        "entry_id": "b36c0c4f-be29-3e9f-8f57-52e5c76b10de",
                        "glosses": [
                            "Couvert formé de branches d’arbres garnies de feuilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de14419c-8836-4070-bb77-382990830423",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "Comme dormait Jacob, comme dormait Judith,\nBooz, les yeux fermés, gisait sous la feuillée ;\nOr, la porte du ciel s’étant entre-bâillée\nAu-dessus de sa tête, un songe en descendit."
                            },
                            {
                                "example_id": "a253ffea-498c-4bd7-8b55-f4de0b8474c7",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "Ma chaumière aurait, l’été, la feuillée des bois pour parasol, …."
                            },
                            {
                                "example_id": "b69a84da-52d5-45c1-bb0e-310522d47838",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "… ; les oiseaux gazouillaient, gaiement cachés sous la feuillée, tout dans la nature avait repris son air de fête accoutumé."
                            },
                            {
                                "example_id": "b52626ef-7bd1-4dc7-b0ce-7890acfc129c",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "Un rayon de soleil, qui passait à travers la feuillée des tilleuls, jouait sur sa chevelure et en faisait une auréole d’or."
                            },
                            {
                                "example_id": "44a70873-c9c3-46d1-b112-ad1d9b6ab30d",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "Une petite faune effarouchée s'enfuit à leur approche ; des oiseaux éveillés par la brusque lumière piaillaient peureusement dans la feuillée."
                            },
                            {
                                "example_id": "1deb8c1f-d320-40d9-9dd9-724a76a818dc",
                                "sense_id": "e4bf7ab3-985f-343f-9b3c-7581630238f3",
                                "text": "Mais je suis las, mes yeux se troublent, ma main tremble et je vois mon image en ces vieillards d’Homère, que leur faiblesse écartait des combats et qui, assis sur les remparts, élevaient leurs voix comme les cigales dans la feuillée."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a6014ce-030f-309e-8a70-9e8d3fd82378",
                        "entry_id": "b36c0c4f-be29-3e9f-8f57-52e5c76b10de",
                        "glosses": [
                            "Récolte des feuilles vertes des arbres ou des plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9732ec04-a717-4e0f-a20b-66cf6f789233",
                                "sense_id": "9a6014ce-030f-309e-8a70-9e8d3fd82378",
                                "text": "Faire la feuillée pour nourrir les vers à soie."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aec297f-89ea-30ea-b790-af5cab7dee6f",
                        "entry_id": "b36c0c4f-be29-3e9f-8f57-52e5c76b10de",
                        "glosses": [
                            "Petite tranchée qui servait de latrines dans les camps provisoires et les cantonnements."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8e1a2efd-8e97-46fd-b1ee-6e3d83e567ed",
                                "sense_id": "9aec297f-89ea-30ea-b790-af5cab7dee6f",
                                "text": "Les tout-à-l'égout ne fonctionnaient pas, et les soldats logés là avaient installé des feuillées sur les parquets. C'était le cas dans beaucoup de maisons; […]."
                            },
                            {
                                "example_id": "3db5dc71-6468-472f-b42b-b99ba74143fc",
                                "sense_id": "9aec297f-89ea-30ea-b790-af5cab7dee6f",
                                "text": "Et sur un camp installé en province de Liège, un appareil avait été placé pour filmer les jeunes durant leur passage à la feuillée."
                            }
                        ]
                    }
                ],
