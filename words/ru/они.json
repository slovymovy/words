{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "39d991af-a27d-3660-a838-57b1cd2ecb66",
                    "sense_definition": "Личное местоимение третьего лица множественного числа; обозначает группу людей, животных, предметов или явлений, о которых шла речь ранее.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где дети? — <w>Они</w> играют в саду.",
                            "target_lang_translations": {
                                "en": "Where are the children? — <w>They</w> are playing in the garden.",
                                "zh": "孩子们在哪儿？— <w>他们</w>在花园里玩。"
                            }
                        },
                        {
                            "text": "Я купил новые книги, <w>они</w> лежат на столе.",
                            "target_lang_translations": {
                                "en": "I bought new books, <w>they</w> are lying on the table.",
                                "zh": "我买了些新书，<w>它们</w>放在桌子上。"
                            }
                        },
                        {
                            "text": "Вот и <w>они</w>, наши гости!",
                            "target_lang_translations": {
                                "en": "Here <w>they</w> are, our guests!",
                                "zh": "我们的客人<w>他们</w>来了！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вот и они",
                        "где они",
                        "они говорят",
                        "как они"
                    ],
                    "target_lang_definitions": {
                        "en": "Personal pronoun of the third person plural; refers to a group of people, animals, objects, or phenomena mentioned earlier.",
                        "zh": "第三人称复数代词；指代前文提到的一群人、动物、事物或现象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "they",
                                "target_lang_sense_clarification": "personal pronoun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他们",
                                "target_lang_sense_clarification": "指代一群人"
                            },
                            {
                                "target_lang_word": "它们",
                                "target_lang_sense_clarification": "指代动物或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "351cd138-5b45-302e-8878-e8654a923140",
                    "sense_definition": "Употребляется для усиления указания на кого-либо или что-либо, часто в значении «те самые», «именно эти».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Посмотри на эти фотографии, это <w>они</w> самые.",
                            "target_lang_translations": {
                                "en": "Look at these photos, these are <w>the very ones</w>.",
                                "zh": "看看这些照片，<w>就是它们</w>。"
                            }
                        },
                        {
                            "text": "Я сразу понял, что это были <w>они</w>.",
                            "target_lang_translations": {
                                "en": "I immediately realized that it was <w>them</w>.",
                                "zh": "我立刻意识到<w>就是他们</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "те самые"
                    ],
                    "common_phrases": [
                        "они самые"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize the reference to someone or something, often meaning 'the very ones', 'exactly these'.",
                        "zh": "用于强调所指的对象，意为“就是那些”、“正是这些”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "them",
                                "target_lang_sense_clarification": "emphatic identification"
                            },
                            {
                                "target_lang_word": "the very ones",
                                "target_lang_sense_clarification": "emphatic phrase"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "就是他们",
                                "target_lang_sense_clarification": "强调特定的人"
                            },
                            {
                                "target_lang_word": "正是这些",
                                "target_lang_sense_clarification": "强调特定的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8803053-c89f-3947-b3ea-9cd1bb41d136",
                    "sense_definition": "Употребляется по отношению к одному лицу (обычно старшему по возрасту или социальному положению) как знак особого уважения или в просторечии.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка уже старенькая, <w>они</w> плохо слышат.",
                            "target_lang_translations": {
                                "en": "Grandma is already old, <w>she</w> hears poorly.",
                                "zh": "奶奶年纪大了，<w>她</w>听力不太好。"
                            }
                        },
                        {
                            "text": "Хозяин велели передать, что <w>они</w> сейчас заняты.",
                            "target_lang_translations": {
                                "en": "The master ordered to say that <w>he</w> is busy right now.",
                                "zh": "主人吩咐说，<w>他</w>现在正忙。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to refer to a single person (usually older or of higher status) as a mark of special respect or in colloquial speech.",
                        "zh": "用于指代某人（通常是长辈或地位较高者），作为一种尊称或在口语中使用。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "he",
                                "target_lang_sense_clarification": "honorific reference to a male"
                            },
                            {
                                "target_lang_word": "she",
                                "target_lang_sense_clarification": "honorific reference to a female"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他/她",
                                "target_lang_sense_clarification": "尊称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63e5b28a-239a-330c-a071-e6e3f3a28f1d",
                    "sense_definition": "В японской мифологии: человекоподобные демоны-людоеды, обычно изображаемые с рогами и клыками.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "На старинной гравюре был изображен страшный <w>они</w> с дубиной.",
                            "target_lang_translations": {
                                "en": "The old engraving depicted a scary <w>oni</w> with a club.",
                                "zh": "古老的版画上描绘了一个拿着棍棒的可怕<w>鬼</w>。"
                            }
                        },
                        {
                            "text": "В японских сказках герои часто сражаются против злобных <w>они</w>.",
                            "target_lang_translations": {
                                "en": "In Japanese fairy tales, heroes often fight against evil <w>oni</w>.",
                                "zh": "在日本童话中，英雄们经常与邪恶的<w>鬼</w>战斗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "демон",
                        "чёрт"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Япония"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In Japanese mythology: humanoid man-eating demons, usually depicted with horns and fangs.",
                        "zh": "日本神话中的人形食人恶魔，通常被描绘为长有角和獠牙的形象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oni",
                                "target_lang_sense_clarification": "Japanese demon"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鬼",
                                "target_lang_sense_clarification": "日本神话中的恶魔"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}