                "senses": [
                    {
                        "sense_id": "675451d7-e157-3df9-ab3d-384f9b103226",
                        "entry_id": "257a8265-96cd-3b21-af49-8beb925fde93",
                        "glosses": [
                            "Convoiter, faire preuve de convoitise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0089455-726f-431c-80c5-14a012e985e0",
                                "sense_id": "675451d7-e157-3df9-ab3d-384f9b103226",
                                "text": "Celui qui regarde une femme pour la convoitiser, s’est déjà souillé avec elle dans son cœur."
                            },
                            {
                                "example_id": "457670c0-8bbe-4746-80b8-07f45322914f",
                                "sense_id": "675451d7-e157-3df9-ab3d-384f9b103226",
                                "text": "Le public, vois-tu, c'est quatre cents idiots, quatre cents bourgeois qui te convoitisent ensemble."
                            },
                            {
                                "example_id": "4ec5b7e5-4716-45a2-9787-d5ecf51b6f6f",
                                "sense_id": "675451d7-e157-3df9-ab3d-384f9b103226",
                                "text": "Maître Gims m’a convoitisé"
                            },
                            {
                                "example_id": "5a11e27a-e4f7-4a5b-9f52-15251ed5d35a",
                                "sense_id": "675451d7-e157-3df9-ab3d-384f9b103226",
                                "text": "Car, tout ce qui est dans ce monde la convoitise par la chair"
                            }
                        ]
                    }
