{
    "word_family": [
        "crusher",
        "crushable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "830ad942-5e15-3b0f-bdfa-90b063240bbb",
                    "sense_definition": "Present participle and gerund of <w>crush</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is <w>crushing</w> the large rocks into gravel.",
                            "target_lang_translations": {
                                "ru": "Машина <w>дробит</w> большие камни в гравий.",
                                "zh": "机器正在把大块岩石<w>碾碎</w>成碎石。"
                            }
                        },
                        {
                            "text": "She is <w>crushing</w> the garlic cloves to add to the sauce.",
                            "target_lang_translations": {
                                "ru": "Она <w>давит</w> зубчики чеснока, чтобы добавить их в соус.",
                                "zh": "她正在把大蒜瓣<w>捣碎</w>，准备加进酱汁里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола crush.",
                        "zh": "动词 crush 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробя́щий",
                                "target_lang_sense_clarification": "превращающий в мелкие части"
                            },
                            {
                                "target_lang_word": "да́вящий",
                                "target_lang_sense_clarification": "сжимающий с силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压碎",
                                "target_lang_sense_clarification": "使破碎或变形"
                            },
                            {
                                "target_lang_word": "碾碎",
                                "target_lang_sense_clarification": "研磨、碾磨成碎粒"
                            },
                            {
                                "target_lang_word": "捣碎",
                                "target_lang_sense_clarification": "压烂成泥或小碎块"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1b27b40-aeac-324a-8cb8-ca7332f03f7d",
                    "sense_definition": "Strong enough to cause damage or to defeat someone completely; overwhelming.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team suffered a <w>crushing</w> defeat in the final match of the season.",
                            "target_lang_translations": {
                                "ru": "Команда потерпела <w>сокрушительное</w> поражение в финальном матче сезона.",
                                "zh": "球队在赛季最后一场比赛中遭遇了<w>毁灭性的</w>失败。"
                            }
                        },
                        {
                            "text": "He felt the <w>crushing</w> weight of the heavy box on his foot.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>раздавливающую</w> тяжесть тяжелой коробки на своей ноге.",
                                "zh": "他感受到了脚上沉重箱子传来的<w>沉重的</w>压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelming",
                        "devastating"
                    ],
                    "common_phrases": [
                        "crushing defeat",
                        "crushing blow",
                        "crushing weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно сильный, чтобы нанести ущерб или полностью победить кого-либо; ошеломляющий.",
                        "zh": "力量巨大以致造成破坏或彻底击溃的；毁灭性的，沉重的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокруши́тельный",
                                "target_lang_sense_clarification": "разрушительный, уничтожающий (о поражении или ударе)"
                            },
                            {
                                "target_lang_word": "разда́вливающий",
                                "target_lang_sense_clarification": "о физическом весе или давлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毁灭性的",
                                "target_lang_sense_clarification": "形容彻底的打击或失败"
                            },
                            {
                                "target_lang_word": "沉重的",
                                "target_lang_sense_clarification": "形容力量或重量极大"
                            },
                            {
                                "target_lang_word": "压倒性的",
                                "target_lang_sense_clarification": "无法抗拒的，极具破坏力的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b736216-8a16-3408-a86e-d1c3709484c3",
                    "sense_definition": "Causing great sadness, disappointment, or emotional distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>crushing</w> guilt after realizing she had forgotten her friend's birthday.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>давящее</w> чувство вины, осознав, что забыла о дне рождения подруги.",
                                "zh": "意识到自己忘了朋友的生日后，她感到一种<w>沉重的</w>内疚感。"
                            }
                        },
                        {
                            "text": "The news of the cancellation was a <w>crushing</w> disappointment for all the fans.",
                            "target_lang_translations": {
                                "ru": "Новость об отмене стала <w>тяжелейшим</w> разочарованием для всех фанатов.",
                                "zh": "取消的消息对所有粉丝来说都是一次<w>巨大的</w>失望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gutting"
                    ],
                    "common_phrases": [
                        "crushing guilt",
                        "crushing disappointment",
                        "crushing bore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильную грусть, разочарование или душевные страдания.",
                        "zh": "令人极度悲痛、失望或情绪压抑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да́вящий",
                                "target_lang_sense_clarification": "угнетающий, вызывающий чувство тяжести"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "мучительный, трудно переносимый"
                            },
                            {
                                "target_lang_word": "уби́йственный",
                                "target_lang_sense_clarification": "крайне неприятный, невыносимый (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉重的",
                                "target_lang_sense_clarification": "让人心情沉重难受的"
                            },
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "极度的，令人难以承受的（失望、打击等）"
                            },
                            {
                                "target_lang_word": "压抑的",
                                "target_lang_sense_clarification": "精神上感到压迫的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89c7d57c-623e-3921-bbcc-39e5516e8d4f",
                    "sense_definition": "The act of pressing something with force so that it breaks or loses its shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crushing</w> of the grapes is an essential step in traditional wine production.",
                            "target_lang_translations": {
                                "ru": "<w>Дробление</w> винограда — важный этап в традиционном виноделии.",
                                "zh": "<w>压榨</w>葡萄是传统葡萄酒酿造中至关重要的一步。"
                            }
                        },
                        {
                            "text": "Repeated <w>crushing</w> of the stones turned them into fine dust.",
                            "target_lang_translations": {
                                "ru": "Повторное <w>дробление</w> камней превратило их в мелкую пыль.",
                                "zh": "对石头的反复<w>破碎</w>使其变成了细粉。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по сдавливанию чего-либо с силой, приводящее к разрушению или потере формы.",
                        "zh": "用力按压以致某物破碎或变形的行为；压碎，碾碎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробле́ние",
                                "target_lang_sense_clarification": "измельчение твердых материалов"
                            },
                            {
                                "target_lang_word": "разда́вливание",
                                "target_lang_sense_clarification": "сплющивание мягких или хрупких объектов"
                            },
                            {
                                "target_lang_word": "измельче́ние",
                                "target_lang_sense_clarification": "превращение в мелкие частицы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压碎",
                                "target_lang_sense_clarification": "把物体压成碎块的动作"
                            },
                            {
                                "target_lang_word": "压榨",
                                "target_lang_sense_clarification": "榨取液体或挤压的动作"
                            },
                            {
                                "target_lang_word": "破碎",
                                "target_lang_sense_clarification": "工农业中的破碎工序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a59f2e41-d8c7-36e6-abe9-bc34f7830c9b",
                    "sense_definition": "Material that has been crushed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory processes oilseed <w>crushings</w> to create animal feed.",
                            "target_lang_translations": {
                                "ru": "Завод перерабатывает масличные <w>выжимки</w> для создания корма для животных.",
                                "zh": "该工厂加工油籽<w>压榨残渣</w>以制成动物饲料。"
                            }
                        },
                        {
                            "text": "Piles of rock <w>crushings</w> were left near the entrance of the mine.",
                            "target_lang_translations": {
                                "ru": "Груды каменной <w>крошки</w> остались у входа в шахту.",
                                "zh": "矿井入口附近堆着成堆的岩石<w>碎料</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, который был раздроблен или измельчен.",
                        "zh": "被压碎、碾碎的碎料或残渣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кро́шка",
                                "target_lang_sense_clarification": "мелкие частицы камня или другого материала"
                            },
                            {
                                "target_lang_word": "вы́жимки",
                                "target_lang_sense_clarification": "остатки после отжима (например, масличных культур)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碎料",
                                "target_lang_sense_clarification": "压碎后留下的碎末或物料"
                            },
                            {
                                "target_lang_word": "碎石",
                                "target_lang_sense_clarification": "压碎的岩石碎屑"
                            },
                            {
                                "target_lang_word": "压榨残渣",
                                "target_lang_sense_clarification": "榨油或榨汁后剩下的渣滓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea77ec52-49a7-3559-8afe-2fb0a16c9021",
                    "sense_definition": "A former method of execution by placing heavy weights on the victim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, death by <w>crushing</w> was a brutal form of punishment.",
                            "target_lang_translations": {
                                "ru": "В средневековье смерть через <w>раздавливание</w> была жестоким видом наказания.",
                                "zh": "在中世纪，处以<w>压刑</w>是一种极其残忍的刑罚。"
                            }
                        },
                        {
                            "text": "The historian described the horrific practice of <w>crushing</w> used in the past.",
                            "target_lang_translations": {
                                "ru": "Историк описал ужасающую практику <w>раздавливания</w>, применявшуюся в прошлом.",
                                "zh": "历史学家描述了过去使用<w>压刑</w>这一骇人听闻的做法。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "former method of execution"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древний метод казни путем помещения тяжелых грузов на жертву.",
                        "zh": "历史上通过在受害者身上施加重物来进行的压决死刑或酷刑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разда́вливание",
                                "target_lang_sense_clarification": "вид казни или пытки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压刑",
                                "target_lang_sense_clarification": "古代用重物压死受刑者的死刑或酷刑"
                            },
                            {
                                "target_lang_word": "碾压刑",
                                "target_lang_sense_clarification": "压碾致死的刑罚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}