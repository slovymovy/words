                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jonglage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95b04c35-453d-3da4-bc2c-f34fcce194a4",
                                        "entry_id": "60bc8781-d9cb-3195-b77d-10e96deef664",
                                        "glosses": [
                                            "Action de jongler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a031cd-5705-4608-8542-f3181e5cc675",
                                                "sense_id": "95b04c35-453d-3da4-bc2c-f34fcce194a4",
                                                "text": "Nous parlerons des exercices de jonglage ultérieurement, nous essayons ici simplement d’obtenir d’une manière agréable une suite de contractions d’une main tandis que l’autre reste immobile."
                                            },
                                            {
                                                "example_id": "b2db4cda-84f3-4259-9fba-ab356bdf15ae",
                                                "sense_id": "95b04c35-453d-3da4-bc2c-f34fcce194a4",
                                                "text": "On dit jonglerie plutôt que jonglage qui ne figure certes pas dans le dictionnaire mais qui est le mot que les jongleurs utilisent depuis toujours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fff9a7c0-6328-42cf-845f-9f6c0cf08b08",
                        "source_entry_id": "65072d2a-dc75-3766-bc28-943f507aaeeb",
                        "source_sense_description": "moving of objects in an artful manner",
                        "target_lang_word": "jonglerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
