                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cd79775-700f-4932-b9db-cdf3c1a00944",
                        "source_entry_id": "296daaa9-9496-3a31-8068-73ccbe29e4a8",
                        "target_lang_word": "hoek",
