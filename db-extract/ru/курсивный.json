                    },
                    {
                        "translation_id": "f122f304-7517-4ceb-90b6-74c31462e788",
                        "source_entry_id": "67fc2f08-1d91-34b2-9ece-77827fac4363",
                        "source_sense_id": "dbf001ab-c500-3ba9-88cf-bdb2b1227bec",
                        "target_lang_word": "italique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "italique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f32528c9-f051-34e5-9eaf-b2129ab88fa9",
                                        "entry_id": "27242596-8364-3da9-bc1a-d7f63b8f9f6c",
                                        "glosses": [
                                            "Qui appartient à l’Italie ancienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecd17e44-f170-4caa-8dc5-aa20bb4681f5",
                                                "sense_id": "f32528c9-f051-34e5-9eaf-b2129ab88fa9",
                                                "text": "Les peuples italiques (les Italiques) étaient les Latins, les Étrusques, les Samnites, etc."
                                            },
                                            {
                                                "example_id": "35e947a4-d64e-49fe-b6b0-9668ad100518",
                                                "sense_id": "f32528c9-f051-34e5-9eaf-b2129ab88fa9",
                                                "text": "La mythologie italique."
                                            },
                                            {
                                                "example_id": "da8e27d5-f8e4-4921-9eaf-eb65aabae6a7",
                                                "sense_id": "f32528c9-f051-34e5-9eaf-b2129ab88fa9",
                                                "text": "La philosophie italique est celle de Pythagore."
                                            },
                                            {
                                                "example_id": "1e96cd72-a8c7-4e08-868c-4224788a53ab",
                                                "sense_id": "f32528c9-f051-34e5-9eaf-b2129ab88fa9",
                                                "text": "Il se peut même que le loup apprivoisé de saint François d’Assise soit une antique divinité italique, un parent de la louve de Remus et Romulus qui survit ainsi dans la légende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944e0853-27ee-33fa-92a0-7ae69b9d64e3",
                                        "entry_id": "27242596-8364-3da9-bc1a-d7f63b8f9f6c",
                                        "glosses": [
                                            "Qui appartient à un groupe de langues parlées dans l’Italie antique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d435a4-ff05-4d3b-aafd-17505351f9db",
                                                "sense_id": "944e0853-27ee-33fa-92a0-7ae69b9d64e3",
                                                "text": "[…] le latin est une langue de la famille indo-européenne appartenant au groupe des langues italiques, qui comporte également quelques langues moins répandues, comme par exemple l’osque ou l’ombrien, qui ont laissé peu de traces […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ef396c-9428-3259-acf6-11709fd80810",
                                        "entry_id": "27242596-8364-3da9-bc1a-d7f63b8f9f6c",
                                        "glosses": [
                                            "Pour un caractère, écrit d’une façon un peu inclinée vers la droite, comme l’écriture. Il s’emploie aussi comme nom masculin (→ voir italique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4427ea4-242a-40b4-b9cd-7fedc531485f",
                                                "sense_id": "87ef396c-9428-3259-acf6-11709fd80810",
                                                "text": "Dans le Dictionnaire, les exemples sont imprimés en lettres italiques, en caractères italiques."
                                            },
                                            {
                                                "example_id": "3dc79420-c108-4fd8-a8cf-ec1ef153c591",
                                                "sense_id": "87ef396c-9428-3259-acf6-11709fd80810",
                                                "text": "L’aversion des nouveaux typographes pour les lettres italiques les a portés à imprimer ces mêmes mots en caractères ordinaires."
                                            },
                                            {
                                                "example_id": "abc72550-e19e-4dfa-a91e-6bae51358535",
                                                "sense_id": "87ef396c-9428-3259-acf6-11709fd80810",
                                                "text": "Herbin s’exprimait avec une correction parfaite, n’omettait aucun accord. On eût dit que tout en parlant, il barrait exactement les t, plaçait les accents sans en omettre un seul, mettait le point sur les i, n’oubliait aucune cédille, et exposait en italiques les mots importants. Dans ce milieu d’étrangers il triomphait modestement et rougissait un peu, pour marquer le coup, quand Desposoria faisait une faute de français."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "italique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                        "entry_id": "51e72cc1-3b10-3f47-9c14-8d2c481d4f2b",
                                        "glosses": [
                                            "Variante d’un caractère d’une famille, un peu incliné vers la droite, comme l’écriture, par opposition au romain, caractère droit et rond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ccbdb6-9b50-4665-bcb9-853e2299b7f7",
                                                "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                                "text": "On se sert de l’italique pour les mots que l’on veut distinguer du reste du texte."
                                            },
                                            {
                                                "example_id": "a40185a5-3aee-49ac-85b0-c44e05211875",
                                                "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                                "text": "À composer en italique."
                                            },
                                            {
                                                "example_id": "3573edde-2ff8-4459-81e8-1dee0022cdf8",
                                                "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                                "text": "Dans le salon, miss Bell, d’une écriture formée d’après l’italique des Aldes, copiait avec de l’encre d’or, sur une feuille de parchemin, les vers qu’elle avait trouvés dans la nuit."
                                            },
                                            {
                                                "example_id": "f5070c7c-e067-4098-bedc-6c503df2d7de",
                                                "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                                "text": "C’est un superbe Montaigne à grandes marges. Les variantes sont en italiques."
                                            },
                                            {
                                                "example_id": "8b1a2461-6962-401b-a60c-cb6293928622",
                                                "sense_id": "c8e585bd-c841-39d6-98c1-d8d42dbfc534",
                                                "text": "Un autre moyen acceptable consiste à faire composer la partie citée en italique si le texte général est en romain, ou en romain s’il est en italique, ce qui dispense de la mettre entre guillemets."
                                            }
                                        ]
                                    }
                                ]
                            },
