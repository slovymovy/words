                        "entry_id": "6ce5fcf5-edf4-3330-bae6-72f77cc8ef8e",
                        "glosses": [
                            "Geräte, die mit elektrischen Strom angetrieben beziehungsweise betrieben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9bebf0c-26bc-4198-80a5-7a10d995c5d2",
                                "sense_id": "faa0c615-8794-3a67-bc7e-9edf27fdd330",
                                "text": "Elektrogeräte dürfen nicht in den Hausmüll geworfen werden, sondern müssen gesondert zu den entsprechenden Entsorgungsstellen gebracht werden."
                            },
                            {
                                "example_id": "efa0cb8a-2441-4301-ad45-cda1715ef52f",
                                "sense_id": "faa0c615-8794-3a67-bc7e-9edf27fdd330",
                                "text": "Elektrogeräte ohne VDE-Kennzeichnung können eine gefährliche Anschaffung sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
