                    },
                    {
                        "form_id": "7106d5ee-e2f2-4fd8-9166-9cc5ae05ae4d",
                        "entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "améliorative"
                    },
                    {
                        "form_id": "aea77e9e-3c31-4628-86ea-996c671c0379",
                        "entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "amélioratives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfe5ff1d-70f5-3733-ba8a-34ee2becd3f6",
                        "entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                        "glosses": [
                            "Qui améliore, qui apporte une amélioration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f7cafe-8c2a-4b98-9f40-bda137f15735",
                                "sense_id": "cfe5ff1d-70f5-3733-ba8a-34ee2becd3f6",
                                "text": "Dans les affections convulsives les plus développées, l’effet amélioratif se manifeste instantanément, et la guérison vient peu après."
                            },
                            {
                                "example_id": "7ffa009a-b432-422e-b3cc-bc19e976ac9d",
                                "sense_id": "cfe5ff1d-70f5-3733-ba8a-34ee2becd3f6",
                                "text": "M. René Fiquet, conseiller municipal, en donnant acte à l’Administration du sérieux effort amélioratif réalisé en ce sens, serait reconnaissant à M. le Préfet de la Seine et à ses services de l’étude de ce petit problème local."
                            },
                            {
                                "example_id": "a058344c-23c8-47b8-91e2-c63199243bed",
                                "sense_id": "cfe5ff1d-70f5-3733-ba8a-34ee2becd3f6",
                                "text": "Lorsque ce rôle amélioratif est utilisé, il devient facilitateur, car il permet de recruter plus facilement les sujets et d’encourager la participation en diminuant considérablement la résistance à l’évaluation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bac75cfa-dfb4-4935-a63b-6c11169dce13",
                        "source_entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                        "source_sense_id": "cfe5ff1d-70f5-3733-ba8a-34ee2becd3f6",
                        "target_lang_word": "ameliorative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ameliorative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f19936-5cdd-3e39-933f-f936c4349de0",
                                        "entry_id": "c69e110c-a37a-36be-b034-c394969a33c7",
                                        "glosses": [
                                            "Able to repair or ameliorate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6dc106-6db4-43f2-bac4-5f87e69cf8e6",
                                                "sense_id": "f2f19936-5cdd-3e39-933f-f936c4349de0",
                                                "text": "One night while he was moaning on about his sorry existence I said: Do you really want to change it?\nOf course I do, he said, but nothing I’ve tried has been ameliorative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69530eb5-8491-37dd-a047-e3f6d2e4d54c",
                                        "entry_id": "c69e110c-a37a-36be-b034-c394969a33c7",
                                        "glosses": [
                                            "Suggesting or relating to a positive or approving evaluation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da457ecd-1a54-4f04-8156-3ba16eb2c673",
                                                "sense_id": "69530eb5-8491-37dd-a047-e3f6d2e4d54c",
                                                "text": "[…]personal nicknames can generally be divided into positively marked (ameliorative) ones, usually given by family members and friends as a sign of affection and acceptance, and those negatively marked (pejorative or derogatory), whose aim is to mock or ridicule a person[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c6aed59-bdca-3197-8cc1-79bd0f6a0c90",
                                        "entry_id": "c69e110c-a37a-36be-b034-c394969a33c7",
                                        "glosses": [
                                            "Of or relating to conceptual engineering, the normative study of which conceptual demarcation is most conducive to solve the problems the concept is a priori taken to solve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffbcf9b-351e-404e-ad80-c73013ccfa76",
                                                "sense_id": "3c6aed59-bdca-3197-8cc1-79bd0f6a0c90",
                                                "text": "ameliorative inquiry"
                                            },
                                            {
                                                "example_id": "0710d49b-b84d-4c76-8f58-5561d3767afb",
                                                "sense_id": "3c6aed59-bdca-3197-8cc1-79bd0f6a0c90",
                                                "text": "ameliorative analysis"
                                            },
                                            {
                                                "example_id": "0c5c8e7c-f703-4d3d-b393-e99692238eee",
                                                "sense_id": "3c6aed59-bdca-3197-8cc1-79bd0f6a0c90",
                                                "text": "ameliorative project"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ameliorative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                                        "entry_id": "f3685a76-a00f-33ee-af5a-b728f96a6ca9",
                                        "glosses": [
                                            "That which betters or improves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287d9239-9228-4dca-a373-cfd78e349f80",
                                                "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                                                "text": "With such conventional Keynesian amelioratives, the economy normally recovers with output and employment on the rise, and, unfortunately, with inflation picking up too."
                                            },
                                            {
                                                "example_id": "12cbf1db-7a04-4246-9707-c8a4aacbf5e6",
                                                "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                                                "text": "It certainly means the stripping from Parliament of endless debates on niggling parsimonies and trivial amelioratives; the thousand and one unreal fights and distractions which has kept democracy from winning the other half of freedom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f19bf4-248b-3cb1-960a-f95366c8f369",
                                        "entry_id": "f3685a76-a00f-33ee-af5a-b728f96a6ca9",
                                        "glosses": [
                                            "A linguistic unit (such as a word, morpheme) that implies a positive or approving evaluation."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fa956c-e980-4f50-bdbc-c089d0a01f97",
                                                "sense_id": "d5f19bf4-248b-3cb1-960a-f95366c8f369",
                                                "text": "Moreover, diminutives, augmentatives, pejoratives and amelioratives have always been analysed as independent categories, neglecting the possible interrelations among them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
