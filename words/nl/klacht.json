                            "target_lang_translations": {
                                "en": "I want to file a <w>complaint</w> against the airline because of the huge delay."
                            }
                        },
                        {
                            "text": "De klantenservice heeft mijn schriftelijke <w>klacht</w> nog steeds niet beantwoord.",
                            "target_lang_translations": {
                                "en": "Customer service still hasn't answered my written <w>complaint</w>."
                            }
