                                        "glosses": [
                                            "een stoel waarin men gemakkelijk kan liggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860412a8-1d0c-4c59-88d6-0ddd318bfbed",
                                                "sense_id": "7ad82c38-8471-355f-9546-83b6671bd768",
                                                "text": "Ik heb een paar ligstoelen gehuurd voor een dagje aan het strand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1916b8bc-975b-4cb7-ae00-27dcfff1bc25",
                        "source_entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
