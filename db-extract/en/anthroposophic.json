                                "target_word": "anthroposophisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "998ac286-92ba-3b05-a15b-3b93ec5d5e04",
                                        "entry_id": "4a9b4aa3-42b6-378f-a338-5adb3fd9552f",
                                        "glosses": [
                                            "auf der Anthroposophie beruhend, die Grundsätze der Anthroposophie vertretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c0d3b4-aeba-4d70-b5ee-f717c3221b25",
                                                "sense_id": "998ac286-92ba-3b05-a15b-3b93ec5d5e04",
                                                "text": "Steiners anthroposophische Lehre knüpft an die christliche Mystik, das Rosenkreuzertum und die idealistische Philosophie an, übernahm aber in den ersten Jahren auch Elemente der stark von indischer Philosophie geprägten modernen oder anglo-indischen Theosophie."
                                            },
                                            {
                                                "example_id": "53b411fa-a1e4-4277-99ad-4d24403ac407",
                                                "sense_id": "998ac286-92ba-3b05-a15b-3b93ec5d5e04",
                                                "text": "Die anthroposophische Heilkunde wird in eigens dafür geschaffenen Kliniken, aber auch in viele Praxen anthroposophischer Ärzte ausgeübt."
                                            },
                                            {
                                                "example_id": "595be793-9b3b-42e3-87ea-a8b0e0e20adc",
                                                "sense_id": "998ac286-92ba-3b05-a15b-3b93ec5d5e04",
                                                "text": "Anthroposophische HeilpraktikerInnen [sic] versuchen, naturheilkundliche Methoden mit anthroposophischem Gedankengut zu vereinen und entsprechend anzuwenden."
                                            },
                                            {
                                                "example_id": "28ea9492-eea0-42f6-9c98-908183fae4ce",
                                                "sense_id": "998ac286-92ba-3b05-a15b-3b93ec5d5e04",
                                                "text": "Das anthroposophische Menschenbild gründet nicht auf Glaubenswahrheiten, es hat vielmehr den Anspruch rational begründbar und verstehbar zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
