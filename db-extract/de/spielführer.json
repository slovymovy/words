                ],
                "senses": [
                    {
                        "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                        "entry_id": "e1f248ef-4967-3b53-b83e-8968101fb7b7",
                        "glosses": [
                            "Person, welche die Regie auf dem Spielfeld beziehungsweise die Leitung in einem Spiel übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf908106-a920-47a4-9725-71aa9907d03b",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "Fritz Walter war der Spielführer der deutschen Nationalmannschaft bei der Weltmeisterschaft 1954 in der Schweiz."
                            },
                            {
                                "example_id": "422b6a84-fcd2-4695-adc8-23965fa82f1c",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "„So ist es möglich, viele Spiele unter erzieherischen Absichten zu verwenden, zum Beispiel, um dabei einem schüchternen Kind die Möglichkeit zu geben, Spielführer zu werden, […].“"
                            },
                            {
                                "example_id": "9f9dba43-7b81-4e56-8c1e-257593b43a3f",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "„Meist ist der Spielführer auf Grund seines Könnens, seiner Geschicklichkeit und Überlegenheit Anführer, der seine Mannschaft auf den Erfolg hin einsetzt.“"
                            },
                            {
                                "example_id": "c1688f7c-9f8e-4707-a45d-1f965f54f34b",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "„Jede Partei wählt aus ihren Reihen einen Spielführer, den Kaiser, […].“"
                            },
                            {
                                "example_id": "c092cf40-9f54-4775-a4e4-c5042f0e2673",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "„Neben den Spielführern der Nationalmannschaften, den Nationaltrainern und 200 ausgewählten Journalisten dürfen nun auch die Fans abstimmen.“"
                            },
                            {
                                "example_id": "4a065834-ec9e-436c-9a1a-ac558359bf8a",
                                "sense_id": "fc66455c-eac6-3320-ac21-a8a8a3774a54",
                                "text": "„Der Sieger wird in einem Wahlverfahren ermittelt, in dem zu je 50 Prozent Stimmen der Spielführer und Trainer der Nationalteams aus aller Welt sowie die Ergebnisse der öffentlichen Abstimmung unter den Fans und der Eingaben einer ausgewählten Gruppe von über 200 Medienvertretern der sechs Kontinente zählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
