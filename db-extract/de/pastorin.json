                ],
                "senses": [
                    {
                        "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                        "glosses": [
                            "weibliche Person, die Geistliche einer Kirche ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3dec83-de84-4290-a627-6380b211b599",
                                "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                                "text": "„Er meldete sie als vermisst. Und bestellte gleichzeitig eine Pastorin aus Hamburg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                        "glosses": [
                            "Gattin eines evangelischen Geistlichen"
                        ],
                        "tags": [
                            "colloquial",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c2a6c1-f16c-4fb5-84c3-11909e83afe6",
                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                "text": "„Unserer Nebel ältere Schwester ist die aus Goethe’s Dichtung und Wahrheit bekannte Frau Pastorin Griesbach […].“ (Gattin des Predigers und Theologen Johann Jakob Griesbach ^(→ WP))"
                            },
                            {
                                "example_id": "5a2dc2ed-9cef-43e8-bc57-782f667717ce",
                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                "text": "„Die Herren vertieften sich in ein eifriges Gespräch über die politische Lage des Landes. Interessiert folgte die Pastorin ihren Auseinandersetzungen und warf hier und da ein verständnisvolles Wort dazwischen.“ (Novelle: Gattin von Pastor Berger)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
