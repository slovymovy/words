                                "sense_id": "f95fd067-90d5-3254-b589-1842e845cfc0",
                                "text": "Толпа́ увлекла́ дете́й на пло́щадь.",
                                "translation": "人群把孩子们引到了广场。"
                            },
                            {
                                "example_id": "9b163f09-3901-45ce-9c15-a0a2eac22d87",
                                "sense_id": "f95fd067-90d5-3254-b589-1842e845cfc0",
                                "text": "Тече́ние увлекло́ до́ски.",
                                "translation": "水流把木板冲走了。"
                            }
                        ]
                    },
