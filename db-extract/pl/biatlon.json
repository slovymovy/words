                                                "text": "Sven hat schon an fünf Biathlons teilgenommen."
                                            },
                                            {
                                                "example_id": "040b89fa-7209-4660-907d-854723ad64e0",
                                                "sense_id": "b6449a7a-e722-36f2-8c1c-17ea30ef7fd5",
