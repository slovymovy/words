                            {
                                "example_id": "a56471ab-db9f-4bc0-8795-b8efd6fb813d",
                                "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                                "text": "Autour des grandes villes, les maisons rurales abandonnées et les fermettes se feront résidences secondaires."
                            },
                            {
                                "example_id": "3e7f461a-38ee-4fdc-9cf6-8b1884a8c3f4",
                                "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                                "text": "Trop confiant, Georges loue donc sa fermette sans demander de garantie locative."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c603c37-ea6e-39b8-8a58-ab970d7037c4",
                        "entry_id": "89d55bd6-e4d1-35f1-9d4c-306ec1e70157",
                        "glosses": [
