                    {
                        "translation_id": "7c5b1c43-4705-4dc8-86c0-9cddb2af3009",
                        "source_entry_id": "4b4d82ae-fc57-3015-94e3-09306c12912f",
                        "source_sense_id": "80b7c301-d02d-3979-86f1-8ea5deb58dbd",
                        "source_sense_description": "in a frantic manner",
                        "target_lang_word": "éperdument",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éperdument",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f8b3c-8f09-3fdd-9544-0c2c609b0fc5",
                                        "entry_id": "8fa46678-80b7-3c69-a667-896937c58dd9",
                                        "glosses": [
                                            "D’une manière éperdue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939485ee-f97f-475a-a745-3c1454870ee5",
                                                "sense_id": "ad5f8b3c-8f09-3fdd-9544-0c2c609b0fc5",
                                                "text": "Dès le lendemain du crime, je devins éperdument amoureux de Rosalie."
                                            },
                                            {
                                                "example_id": "64ca9be2-f31e-4d1c-ae88-83dfe6e5e1ce",
                                                "sense_id": "ad5f8b3c-8f09-3fdd-9544-0c2c609b0fc5",
                                                "text": "Lui, étouffait, râlait déjà ; tandis qu’elle, la bouche libre, suppliait éperdument qu’on se hâtât, épouvantée, le cœur arraché, à sentir qu’elle le tuait."
                                            },
                                            {
                                                "example_id": "7666be68-9f99-49e8-b915-be9273064732",
                                                "sense_id": "ad5f8b3c-8f09-3fdd-9544-0c2c609b0fc5",
                                                "text": "En tout cas, j’aime mon travail, éperdument!"
                                            },
                                            {
                                                "example_id": "5dcae686-a2cf-414f-b173-58f445a5f93e",
                                                "sense_id": "ad5f8b3c-8f09-3fdd-9544-0c2c609b0fc5",
                                                "text": "Un tel échec n’avait rien changé à mon amour : j’étais toujours aussi éperdument amoureuse de ce pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5ab142f-a9b1-4323-8806-b4acaf69c670",
                        "source_entry_id": "4b4d82ae-fc57-3015-94e3-09306c12912f",
                        "source_sense_id": "80b7c301-d02d-3979-86f1-8ea5deb58dbd",
                        "source_sense_description": "in a frantic manner",
                        "target_lang_word": "frénétiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frénétiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e227148-1383-348a-b664-7a76bd88ed8b",
                                        "entry_id": "ea3eadc9-edba-3744-b9c7-708d49ea8dc6",
                                        "glosses": [
                                            "D’une manière frénétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1be225-7194-46d5-b2b9-5ac48df676f7",
                                                "sense_id": "3e227148-1383-348a-b664-7a76bd88ed8b",
                                                "text": "Gregor sentit ses petites pattes s'agiter frénétiquement, en s'avançant vers la nourriture."
                                            },
                                            {
                                                "example_id": "7eb88346-156d-432e-98c3-3c1be3b5ca09",
                                                "sense_id": "3e227148-1383-348a-b664-7a76bd88ed8b",
                                                "text": "Décrétant réactivement leur absoluité comme l'esclave nietzschéen décrète réactivement sa bonté, elles cherchent frénétiquement à discréditer toutes les autres idées comme « méchantes », parce que susceptibles d'être l'index de leur propre accidentalité."
                                            },
                                            {
                                                "example_id": "bdeaafdb-55af-4322-b40e-c77963764141",
                                                "sense_id": "3e227148-1383-348a-b664-7a76bd88ed8b",
                                                "text": "J’aurais aimé dire quelque chose, trouver une formule exprimant ma reconnaissance et mon admiration, je recherchai frénétiquement une formule pendant les trente secondes qu’il me fallut pour mettre mon manteau, pour marcher jusqu’à la porte ; mais, cette fois encore, les mots me manquèrent."
                                            },
                                            {
                                                "example_id": "bf40bb7e-6cf9-4306-9bd3-cd92533fe6ba",
                                                "sense_id": "3e227148-1383-348a-b664-7a76bd88ed8b",
                                                "text": "Pétrifiée, je suis restée longtemps immobile, les yeux fixés sur la fente sombre, aussi effrayée à l'idée que le papillon surgisse qu'à l'idée de l'avoir tué. Comme il ne ressortait pas, je me suis lavé les mains frénétiquement. Je tremblais. J'avais envie de vomir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
