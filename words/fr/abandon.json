{
    "word_family": [
        "abandonner",
        "abandonnique"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                    "sense_definition": "Action d'abandonner, de délaisser une personne, un animal ou une chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_abandonner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>abandon</w> d'animaux de compagnie augmente souvent pendant les vacances d'été."
                        },
                        {
                            "text": "Le directeur a annoncé l'<w>abandon</w> du projet en raison d'un manque de budget."
                        }
                    ],
                    "synonyms": [
                        "délaissement",
                        "désertion"
                    ],
                    "antonyms": [
                        "adoption",
                        "reprise"
                    ],
                    "common_phrases": [
                        "abandon d'animaux",
                        "abandon du projet"
                    ]
                },
                {
                    "sense_id": "cea576ab-7ee5-34ac-ad66-ab871efc9df0",
                    "sense_definition": "État d'une personne ou d'une chose qui est délaissée, sans soins ni entretien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat_abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le départ des propriétaires, cette maison ancienne est tombée dans un triste état d'<w>abandon</w>."
                        },
                        {
                            "text": "Les fermiers ont décidé de laisser à l'<w>abandon</w> ces terres devenues trop arides."
                        }
                    ],
                    "synonyms": [
                        "négligence"
                    ],
                    "antonyms": [
                        "reprise"
                    ],
                    "common_phrases": [
                        "laisser à l'abandon",
                        "état d'abandon"
                    ]
                },
                {
                    "sense_id": "9316d56a-06cd-3f1f-b734-527874893f20",
                    "sense_definition": "Fait de renoncer à une compétition, à une épreuve sportive ou à une candidature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renonciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une blessure au genou a provoqué l'<w>abandon</w> du coureur à mi-parcours."
                        },
                        {
                            "text": "Ce candidat a confirmé son <w>abandon</w> juste avant le second tour de l'élection."
                        }
                    ],
                    "synonyms": [
                        "désistement",
                        "renonciation"
                    ],
                    "antonyms": [
                        "poursuite"
                    ],
                    "common_phrases": [
                        "abandon de la course"
                    ]
                },
                {
                    "sense_id": "c5229ecd-feee-3db0-80a6-0185ecde974b",
                    "sense_definition": "État de confiance et de détente complète, libre de toute contrainte ou méfiance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_confiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui racontait ses souvenirs d'enfance avec un parfait <w>abandon</w>."
                        },
                        {
                            "text": "Pendant cette longue promenade, les deux amis pouvaient parler avec <w>abandon</w> de leurs secrets."
                        }
                    ],
                    "synonyms": [
                        "confiance",
                        "lâcher-prise"
                    ],
                    "antonyms": [
                        "réticence"
                    ],
                    "common_phrases": [
                        "parler avec abandon"
                    ]
                }
            ]
        }
    ]
}