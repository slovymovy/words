                        "examples": [
                            {
                                "example_id": "9d49529e-9c02-4d69-94e9-80d439ae00a2",
                                "sense_id": "952d2eaa-e92c-3c69-b9a0-5a5323bfb56d",
                                "text": "„Aber generell gibt es bei Tunnelfahrten extreme Druckschwankungen, vor allem bei Gegenverkehr im zweigleisigen Tunnel.“"
                            },
                            {
                                "example_id": "c07973e3-b744-4824-83a9-a1618f20b824",
                                "sense_id": "952d2eaa-e92c-3c69-b9a0-5a5323bfb56d",
                                "text": "„Aufgrund von Druckschwankungen in einem Triebwerk hat SpaceX den für gestern geplanten Start einer Rakete auf heute verschoben.“"
                            },
                            {
                                "example_id": "c2e08a59-e9a0-4d5a-867d-a7ed3c8a3396",
                                "sense_id": "952d2eaa-e92c-3c69-b9a0-5a5323bfb56d",
                                "text": "„Dies passiert häufig, lässt sich jedoch kaum exakt beziffern, da Leckagen, Reparaturen oder Druckschwankungen schwer erfassbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
