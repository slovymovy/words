                "senses": [
                    {
                        "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                        "glosses": [
                            "Lupus érythémateux (maladie auto-immune)."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c05b5593-e9de-4899-8778-6f2c760f7ffb",
                                "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                                "text": "En 2001, une équipe du CNRS découvre qu’un peptide (un fragment de protéine) pourrait soigner le lupus, pathologie frappant le système immunitaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                        "glosses": [
                            "Lupus vulgaris (Ulcère tuberculeux)"
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a666e455-d51d-4982-b3aa-2880d0527529",
                                "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                                "text": "Le lupus peut être considéré comme une tuberculose primitive, et par suite différer de la tuberculose secondaire de la peau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "910e6a8e-42df-44e5-912f-33df124fa7d9",
                        "source_entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                        "target_lang_word": "lupus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
