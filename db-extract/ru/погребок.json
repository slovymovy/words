                    {
                        "translation_id": "1e380d5f-ef89-4a86-9b35-12fcf9633008",
                        "source_entry_id": "5f2f8418-d52d-3c54-a664-e6ccdec7c7d9",
                        "target_lang_word": "Weinschenke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinschenke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0c6855-a1c4-3d37-8b7d-1320b89a2bc7",
                                        "entry_id": "05667253-9d40-3e80-a144-2d4a881ba3c6",
                                        "glosses": [
                                            "Lokal, in dem Wein ausgeschenkt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f42f3cd-b76f-4e62-b853-056ae8adc7dc",
                                                "sense_id": "6a0c6855-a1c4-3d37-8b7d-1320b89a2bc7",
                                                "text": "Gestern haben wir eine sehr schöne Weinschenke in der Altstadt besucht."
                                            },
                                            {
                                                "example_id": "82ae099c-ce26-411c-843d-d74eaad694d9",
                                                "sense_id": "6a0c6855-a1c4-3d37-8b7d-1320b89a2bc7",
                                                "text": "„Nach der Vorstellung ging ich mit ihnen in die Weinschenke, die wir erst verließen, wenn wir betrunken waren, um dann die Nacht in üblen Häusern zuzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f74bf6dc-ebd8-4e48-bff5-4a4db1257283",
                        "source_entry_id": "5f2f8418-d52d-3c54-a664-e6ccdec7c7d9",
                        "target_lang_word": "estaminet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estaminet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb33c1f8-aad6-336c-9f5f-70386bfe73ef",
                                        "entry_id": "1e4beeef-fe7e-3781-b428-1dc27324bbbc",
                                        "glosses": [
                                            "Salle de café où l’on peut fumer en même temps que boire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df60356-76bd-427e-86b9-cd23e3f94612",
                                                "sense_id": "bb33c1f8-aad6-336c-9f5f-70386bfe73ef",
                                                "text": "L’envoyé de Belzébuth s’adressa à un cercle de buveurs assis devant la porte de l’estaminet du Grand-Saint-Laurent, patron des verriers."
                                            },
                                            {
                                                "example_id": "d72fcb91-cbcb-41eb-a9fb-146894c41aa2",
                                                "sense_id": "bb33c1f8-aad6-336c-9f5f-70386bfe73ef",
                                                "text": "Et les buveurs qui fument dans l’estaminet borgne, et la servante de l’hôtellerie qui accroche à la fenêtre un faisan mort."
                                            },
                                            {
                                                "example_id": "e4d79618-a8fa-484e-ab10-a6f5c8e56619",
                                                "sense_id": "bb33c1f8-aad6-336c-9f5f-70386bfe73ef",
                                                "text": "Il ne pouvait suivre aucune carrière, étant absorbé dans les estaminets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e632f83-701c-366b-85ad-55d8839718d3",
                                        "entry_id": "1e4beeef-fe7e-3781-b428-1dc27324bbbc",
                                        "glosses": [
                                            "Petit café restaurant fréquenté par une clientèle populaire."
                                        ],
                                        "tags": [
                                            "Nord-Pas-de-Calais",
                                            "Belgique",
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d2b74c8-1e5a-4768-bcce-aca8a414374d",
                                                "sense_id": "8e632f83-701c-366b-85ad-55d8839718d3",
                                                "text": "Estaminets, brasseries, bar-tabacs, chacun avait son charme. Si je savais rester en retrait, à bonne fortune de bar, je n'étais jamais le dernier à requérir l'assistance du maître des lieux."
                                            },
                                            {
                                                "example_id": "bad5c3da-8dc9-4506-a8b6-be83744add45",
                                                "sense_id": "8e632f83-701c-366b-85ad-55d8839718d3",
                                                "text": "Bien acagnardé contre le zinc à pampres de son estaminet de prédilection, Antonin lantiponait à foison parmi des norias de pieds nickelés en mouillage. Il retrouvait en ces lieux surchauffés des gens de toutes conditions, de toutes extractions […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "957aa78d-ae15-48f1-8a04-225f202b6818",
