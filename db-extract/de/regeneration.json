                "translations": [
                    {
                        "translation_id": "8bfb36ac-00f7-4971-b5d7-c0073a538318",
                        "source_entry_id": "c2366931-5b56-3ed5-9719-4cda5640ded7",
                        "source_sense_id": "1f5f3057-a2f6-3487-9298-c276a5496446",
                        "source_sense_description": "Neubildung, Wiederherstellung",
                        "target_lang_word": "regeneration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regeneration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "Rebuilding or restructuring; large scale repair or renewal; revitalisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf50cd12-d43d-48ea-8404-c6fd596ac3d9",
                                                "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                                "text": "The conversion of so many old industrial buildings into living quarters was a major factor in the regeneration."
                                            },
                                            {
                                                "example_id": "f03f7c66-6092-41cf-98cf-d261ebe2959f",
                                                "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                                "text": "But the key thing that excites Jolliffe about biochar is that it avoids waste and it can actually give something back to the environment. \"The nice thing is that the biochar doesn't just sit there in a heap,\" she says. \"It's used for soil regeneration. You can spread it on the land and it can not only enhance the soil's capacity to manage moisture, but it also acts as a fertiliser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af31a3c-2483-38c4-b1b0-933c475fa565",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "Spiritual rebirth; the change from a carnal or material life to a pious one"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9a27ba2-5843-3439-b6f1-3bcda9cd5304",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The renewal of the world at the second coming of Christ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c1356ef-5a63-3590-bfae-55707c7bb332",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The process by which a water softener flushes out minerals extracted from the water supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The ability to rapidly heal substantial physical damage to one's body, or to spontaneously restore hit points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36bd15cf-87ab-46c3-8a70-cf9f1a2ba801",
                                                "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                                "text": "The standard ring of regeneration restores one point of damage per turn (and will eventually replace lost limbs or organs)."
                                            },
                                            {
                                                "example_id": "74d030c6-e290-4411-a798-58fdfcef044e",
                                                "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                                "text": "2003, Bastion Press, E. W. Morton, Out for Blood\nRegeneration does not restore hit points lost from starvation, thirst, or suffocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab3648f-54e9-3cb9-a1c6-6a11f0fa90c8",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The property of a kind of circuit, much used in radio receivers, that allows an electronic signal to be amplified many times through a feedback loop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
