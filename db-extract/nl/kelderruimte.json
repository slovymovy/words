                "senses": [
                    {
                        "sense_id": "fd047470-325d-317c-b8c6-f4b3510d28be",
                        "entry_id": "fab43513-c543-34df-b46e-422b153f7c1e",
                        "glosses": [
                            "ruimte in het ondergrondse deel van een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061c64b1-bc18-4303-8569-778862650a0a",
                                "sense_id": "fd047470-325d-317c-b8c6-f4b3510d28be",
                                "text": "Tonio maakte een rondgang door de volle kelderruimte, en nam een kijkje in het aanpalende Atrium, waar gedekte tafels stonden."
                            },
                            {
                                "example_id": "d05e1a90-3e5b-467c-ba1f-7a7949410cd5",
                                "sense_id": "fd047470-325d-317c-b8c6-f4b3510d28be",
                                "text": "Het lek ontstond rond het middaguur in de machinekamer van het zwembad, meldt Omroep Brabant. Door nog onbekende oorzaak was een slangetje van een pomp losgeschoten. Zo'n vijf liter vloeistof is daardoor in de kelderruimte van het zwembad weggelekt. Een deel kwam in het riool terecht. Het lek werd binnen een half uur gedicht."
                            },
                            {
                                "example_id": "b4cc1ae1-6287-4ee7-bd9c-7f035d5fe37f",
                                "sense_id": "fd047470-325d-317c-b8c6-f4b3510d28be",
                                "text": "Het clubhuis van de Zweedse radio-amateurzenders in Täby, een voorstad van Stockholm, is een atoombunker, gelegen onder een technische hogeschool. Voorzitter Claes Carneheim geeft een rondleiding en opent de dikke deuren van massief staal. De ontvangers en zenders staan opgesteld in een kelderruimte met laag plafond, betonnen muren en overal steunpilaren. Zoals de rest van de 65.000 schuilkelders in Zweden is ook deze ruimte gebouwd in de jaren 60, tijdens de Koude Oorlog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26934a34-ff57-42a9-a95e-a6259e6e31f5",
                        "source_entry_id": "fab43513-c543-34df-b46e-422b153f7c1e",
                        "source_sense_id": "fd047470-325d-317c-b8c6-f4b3510d28be",
