                ],
                "translations": [
                    {
                        "translation_id": "ff64a098-7ce3-4199-a6a2-584db8b3156e",
                        "source_entry_id": "d1ba82f7-10dc-3b9b-9a4c-47cd5ed124fa",
                        "source_sense_id": "70d9e4a2-1006-3b7c-aeea-1d632f3ae948",
                        "source_sense_description": "Blutdruckmessgerät",
                        "target_lang_word": "Blutdruckmessgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutdruckmessgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                                        "entry_id": "29f2209b-be16-388f-a4db-c8aa1f76ed2f",
                                        "glosses": [
                                            "ein Gerät zur Ermittlung des Blutdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e09c1cbf-65ec-4ea5-a753-2d1fe4243428",
                                                "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                                                "text": "Mit dem Blutdruckmessgerät kann äußerlich, am Oberarm oder am Handgelenk, der arterielle Druck des Menschen gemessen werden."
                                            },
                                            {
                                                "example_id": "06b4026c-d733-4f6e-9ff8-b5c626a68b49",
                                                "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                                                "text": "„Als sie das Blutdruckmessgerät in die Hand nahm, das als Letztes auf dem Band lag, wurde sie plötzlich nachdenklich und schaute meine Schwiegermutter fragend an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d65d5a0a-c3a2-45e9-85cb-7912e225520d",
                        "source_entry_id": "d1ba82f7-10dc-3b9b-9a4c-47cd5ed124fa",
                        "source_sense_id": "70d9e4a2-1006-3b7c-aeea-1d632f3ae948",
                        "source_sense_description": "Blutdruckmessgerät",
                        "target_lang_word": "Sphygmomanometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sphygmomanometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                        "entry_id": "6966e86d-9097-3d32-91c1-57a13244f6bc",
                                        "glosses": [
                                            "Gerät zur Messung des Blutdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331a76de-59ca-4099-8f59-f31db59df30e",
                                                "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                                "text": "Folglich wird es, falls das Herz noch nicht angegriffen ist, nur vom Arzt entdeckt, mit dem Anfang dieses Jahrhunderts von dem italienischen Kinderarzt Scipione Riva Rocci erfundenen Instrument, das den zungenbrecherischen Namen Sphygmomanometer (Sphygmos = Puls) führt."
                                            },
                                            {
                                                "example_id": "db2f432c-c6d0-4894-97eb-576da086d5df",
                                                "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                                "text": "Das Sphygmomanometer von Riva-Rocci besteht aus einer aufblasbaren Gummimanschette, welche um den Oberarm des Patienten gelegt wird und die Brachialarterie zu komprimieren gestattet."
                                            },
                                            {
                                                "example_id": "39760bea-4360-48b9-952f-b015329e7aa4",
                                                "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                                "text": "Bei der Messung mit dem Sphygmomanometer handelt es sich um die klassische Methode der arteriellen Blutdruckmessung."
                                            },
                                            {
                                                "example_id": "d548acdd-7d86-45b6-a5ff-162b5e9dd077",
                                                "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                                "text": "Mittlerweile gibt es auch Sphygmomanometer im Handel, bei denen der analoge Sensor für den Druck durch einen elektronischen Messfühler ersetzt wurde."
                                            },
                                            {
                                                "example_id": "dfb41b78-2fdf-493f-b1f4-dc07afe16552",
                                                "sense_id": "1fef17e6-0cda-307a-904a-01b3075041c3",
                                                "text": "Korotkoff beschrieb 1905 die 5 verschiedenen Tonqualitäten, die über der A. brachialis distal der um den Arm gelegten Manschette auskultiert werden können, wenn der Druck im Sphygmomanometer langsam vermindert wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
