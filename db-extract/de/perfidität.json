                "senses": [
                    {
                        "sense_id": "78298658-3509-39ea-a8cb-b37e2d186ad2",
                        "entry_id": "65702888-56a3-36a6-a3f3-8aaffa866cc5",
                        "glosses": [
                            "Eigenschaft/Handlung, die in deutlichem Maße gemeines und heimtückisches (perfides) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d9a18a-57f2-4620-8f6a-3180cc8dfeda",
                                "sense_id": "78298658-3509-39ea-a8cb-b37e2d186ad2",
                                "text": "„Danach sicherten ihm sein überlegenes Machtbewusstsein, seine Perfidität und seine Brutalität das politische Überleben.“"
                            },
                            {
                                "example_id": "91152c08-491c-4f59-90a6-b87f06da8457",
                                "sense_id": "78298658-3509-39ea-a8cb-b37e2d186ad2",
                                "text": "„Die Leute brauchen für ihre Unredlichkeiten und Nachlässigkeiten, für ihre tausend miserabeln Gewohnheiten, Selbst-Täuschungen und Perfiditäten eine nie ermüdende Nachsicht und Verschwiegenheit.“"
                            },
                            {
                                "example_id": "19209310-0f2d-416f-a667-fa29b4b54fad",
                                "sense_id": "78298658-3509-39ea-a8cb-b37e2d186ad2",
                                "text": "„Es ist ein dumpfes Gebräu, das Jagos Perfidität in Gang setzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
