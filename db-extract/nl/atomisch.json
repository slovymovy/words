                                        ]
                                    },
                                    {
                                        "sense_id": "48feb163-b1d2-30ea-8f4f-8655f2843935",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller."
                                        ],
                                        "tags": [
