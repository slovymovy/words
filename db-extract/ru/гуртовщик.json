                ],
                "senses": [
                    {
                        "sense_id": "79611f8c-23d1-3710-9d3b-d7dc2572ef88",
                        "entry_id": "fcc25aba-7f0c-326c-83b8-acbd65a22a3b",
                        "glosses": [
                            "устар. человек, пасущий гурт, погонщик гурта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef36d44-cc3b-4266-816c-f487c10efd4b",
                                "sense_id": "79611f8c-23d1-3710-9d3b-d7dc2572ef88",
                                "text": "В ту же ночь все лица, сопричастные делу, усажены были на подводы, нанятые гуртовщиком, и отправлены в уездный город; туда поехали также становой и Карякин."
                            }
                        ]
                    },
                    {
                        "sense_id": "882e1f55-8777-33c6-bea4-8c0fb877c627",
                        "entry_id": "fcc25aba-7f0c-326c-83b8-acbd65a22a3b",
                        "glosses": [
                            "устар. владелец гурта; продавец гурта"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98a83dc5-f6b0-4ff5-a874-ea3e6e27575d",
                        "source_entry_id": "fcc25aba-7f0c-326c-83b8-acbd65a22a3b",
                        "source_sense_description": "человек, пасущий гурт, погонщик гурта",
                        "target_lang_word": "berger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39480cd2-951e-4199-af63-b73236395855",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                                            },
                                            {
                                                "example_id": "8cfba72d-129c-478a-95ce-31833a7036c5",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "Les brebis y passaient les mois d'été et les bergers les menaient, le soir, dans des endroits réservés appelés jasses « jassia » où elles se rassemblaient pour la nuit."
                                            },
                                            {
                                                "example_id": "115ac9e2-b1f1-481c-a115-03a51974d32c",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "En arrivant à Normée le berger souffle dans sa corne pour annoncer son retour. Les chiens aboient. Par petits groupes, les bêtes, sans se tromper, rentrent dans leur cour respective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ef2ff8-d340-3335-a073-9822aa48c03d",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau.",
                                            "Pasteur, guide spirituel d’une personne, d’un groupe de personnes."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7949c1fe-db75-45e7-baa1-76f025590206",
                                                "sense_id": "b1ef2ff8-d340-3335-a073-9822aa48c03d",
                                                "text": "Ces bergers qu'on appelle les prêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau.",
                                            "Santon de la crèche qui représente ce gardien."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2de7280-d9f4-4e34-bc5b-44e31f51d011",
                                                "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                                "text": "Faut dire qu'il y a tellement de bergers ! Des bergers debout, des bergers couchés, des bergers qui portent un agneau sur leurs frêles épaules, des bergers accompagnés de leur chien ! En tout, il y en a au moins cent cinquante !"
                                            },
                                            {
                                                "example_id": "b0028394-16bb-465f-b2ef-e6957c0d6401",
                                                "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                                "text": "L'attraction principale était la crèche vivante avec les bergers, les Rois mages, la Vierge Marie, saint Joseph et le petit Jésus. Il y avait aussi les moutons, le bœuf, l'âne, tout. Il ne manquait que le chameau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db48bfcb-d7ce-3b03-8182-e8ad843a781d",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Amant."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461b822e-271d-4db1-973f-59d159eca45e",
                                                "sense_id": "db48bfcb-d7ce-3b03-8182-e8ad843a781d",
                                                "text": "Un berger fidèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418ea4ba-c589-3c96-ae60-e20eee8e2419",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Chien de berger."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77171e49-2142-4279-a457-9aabb8c54fc8",
                                                "sense_id": "418ea4ba-c589-3c96-ae60-e20eee8e2419",
                                                "text": "Pour Josée, les croquettes du vétérinaire et les holistiques n'ont même pas suffis à stopper les diarrhées sévères et les démangeaisons à s'en arracher les poils de son Berger croisé Husky et Golden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51bb0ca6-ba61-4b30-90eb-02179d9857fd",
                        "source_entry_id": "fcc25aba-7f0c-326c-83b8-acbd65a22a3b",
                        "source_sense_description": "человек, пасущий гурт, погонщик гурта",
                        "target_lang_word": "bouvier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouvier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6c9886-3034-3a68-a305-222fcf6e5ee5",
                                        "entry_id": "8f0afb8a-06cb-3ace-a348-8e25aa15f428",
                                        "glosses": [
                                            "Personne qui s’occupe, garde ou conduit des bœufs."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "448d5048-11e0-4799-8cda-beff708ed421",
                                                "sense_id": "1e6c9886-3034-3a68-a305-222fcf6e5ee5",
                                                "text": "Les huit machines étaient rangées dans la cour de la ferme, énormes et tristes, et bergers, charretiers, bouviers, les regardaient d’un air consterné, les bras ballants…"
                                            },
                                            {
                                                "example_id": "4247198d-3090-4dfc-b266-5f7f1bf65c79",
                                                "sense_id": "1e6c9886-3034-3a68-a305-222fcf6e5ee5",
                                                "text": "J’étais bouvier en chef et je participais au pansage de tous les animaux."
                                            },
                                            {
                                                "example_id": "d2777662-8ee2-425a-ba86-7144c76d2b95",
                                                "sense_id": "1e6c9886-3034-3a68-a305-222fcf6e5ee5",
                                                "text": "Il fut un temps où les bouviers venaient désaltérer leurs troupeaux dans ce bassin, aujourd’hui on peut y déjeuner à l’ombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dddaa92-6a6b-33fe-99c7-b47b543823fc",
                                        "entry_id": "8f0afb8a-06cb-3ace-a348-8e25aa15f428",
                                        "glosses": [
                                            "Personnage grossier ou rustre."
                                        ],
                                        "tags": [
                                            "literary",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bf76536-c5e0-4bef-8dfb-05478d180b2b",
                                                "sense_id": "1dddaa92-6a6b-33fe-99c7-b47b543823fc",
                                                "text": "Voyez cette maladroite, cette bouvière, cette butorde."
                                            },
                                            {
                                                "example_id": "c07c8a5f-0f00-42d1-9935-59c03dbe0ad9",
                                                "sense_id": "1dddaa92-6a6b-33fe-99c7-b47b543823fc",
                                                "text": "Il regardait cet homme sale [un médecin …], ce bouvier débraillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b047a104-884b-3927-a7b6-195b76281ff0",
                                        "entry_id": "8f0afb8a-06cb-3ace-a348-8e25aa15f428",
                                        "glosses": [
                                            "Gardien de toute autre chose."
                                        ],
                                        "tags": [
                                            "literary",
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bouvier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2965210-b49b-34cd-8dde-91b73a387f63",
                                        "entry_id": "6f9ccc89-9ca4-3b40-8fdc-74fc5a9e3c7b",
                                        "glosses": [
                                            "Oiseau suivant les bœufs et se nourrissant de leurs parasites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29cdf336-7282-49f5-824f-23b2991b8b1d",
                                                "sense_id": "b2965210-b49b-34cd-8dde-91b73a387f63",
                                                "text": "Le tapir s’appelle aussi vache montagnarde; le bison vache quirira; le gobe-mouche, la lavandière et la bergeronnette, bouvier; la coccinelle , vache à Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10a359d-18d9-3fe4-b8e4-0d882e32eea7",
                                        "entry_id": "6f9ccc89-9ca4-3b40-8fdc-74fc5a9e3c7b",
                                        "glosses": [
                                            "Race de chiens spécialisée dans la garde et la conduite des troupeaux de bovins."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17702241-2579-4d61-be04-4aa45da3b8f0",
                                                "sense_id": "f10a359d-18d9-3fe4-b8e4-0d882e32eea7",
                                                "text": "Chien de famille par excellence, le Bouvier bernois aime partager la vie de ses maîtres et redoute la solitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b26dea50-69d7-4ff5-854f-fd66ded9e7c3",
                        "source_entry_id": "fcc25aba-7f0c-326c-83b8-acbd65a22a3b",
                        "source_sense_description": "человек, пасущий гурт, погонщик гурта",
                        "target_lang_word": "vacher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20cba505-a5c2-32fb-a99b-696502dd1f01",
                                        "entry_id": "ae4945be-f2e8-396f-9551-2c568706d189",
                                        "glosses": [
                                            "Personne qui mène paître les vaches, les bovins, qui les garde, les soigne et s’en occupe."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c8a01c-8ca0-4ff8-bb8f-377a9d9232a0",
                                                "sense_id": "20cba505-a5c2-32fb-a99b-696502dd1f01",
                                                "text": "Au temps jadis, il y avait au village de Saint-Saulve, du côté de Valenciennes, un petit vacher qu’on nommait Jean du Gogué, à cause qu’on ne lui connaissait ni père ni mère […]"
                                            },
                                            {
                                                "example_id": "01fd36c1-794b-4c21-8a17-eb9e4a91b740",
                                                "sense_id": "20cba505-a5c2-32fb-a99b-696502dd1f01",
                                                "text": "Placée comme je l’étais, dans le banc transversal des enfants de Marie groupées autour d’un harmonium essoufflé, je le voyais trop bien, sur ma droite, comme je voyais trop bien, sur ma gauche, assis pour le credo, notre vieux doyen, tout menu, tout chenu, enfoui sous la chasuble verte des interminables dimanches après la Pentecôte et à peine capable de soulever une paupière quand un grumeau sonore, dans la voix de nos vachères, venait troubler leur pieux ronronnement d’écrémeuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7909fff8-032b-3ba9-b82d-df4f8280ee98",
                                        "entry_id": "ae4945be-f2e8-396f-9551-2c568706d189",
                                        "glosses": [
                                            "Responsable technique d’un cheptel de vaches laitières."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90a56b1a-0a39-3dad-b64b-36ba92a4e82a",
                                        "entry_id": "ae4945be-f2e8-396f-9551-2c568706d189",
                                        "glosses": [
                                            "Genre de passereau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcb2e6c-0002-49b1-bc9c-72c74399958a",
                                                "sense_id": "90a56b1a-0a39-3dad-b64b-36ba92a4e82a",
                                                "text": "Nul doute, toutefois, que comme certains oiseaux, tels les vachers ou les sturnelles, la richesse des motifs musicaux doit avoir apporté un avantage évolutif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c028b745-f0c3-32a3-98f8-b45ddae0a7c7",
                                        "entry_id": "ced0a695-bcf9-3ae8-8195-2276d9795ec1",
                                        "glosses": [
                                            "S’attacher."
                                        ],
                                        "tags": [
                                            "Escalade"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf6efb0a-040d-45f9-8404-adb406fad1b0",
                                                "sense_id": "c028b745-f0c3-32a3-98f8-b45ddae0a7c7",
                                                "text": "Un ou deux mousquetons seront utilisés pour vous vacher."
                                            },
                                            {
                                                "example_id": "71484580-a4b6-43e5-a5b5-02e5713aa269",
                                                "sense_id": "c028b745-f0c3-32a3-98f8-b45ddae0a7c7",
                                                "text": "Il permet de s’encorder (directement sur le baudrier en escalade, ou sur un mousqueton en alpinisme), ou de se vacher à un point d’ancrage."
                                            },
                                            {
                                                "example_id": "5e5ddd64-179e-4fb6-bca6-b9905f5b752a",
                                                "sense_id": "c028b745-f0c3-32a3-98f8-b45ddae0a7c7",
                                                "text": "Repos : mousqueton au pontet du baudrier, pour se vacher et s’y laisser choir en cas de fatigue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1981e86-4886-37af-8e72-235c98a8def3",
                                        "entry_id": "ced0a695-bcf9-3ae8-8195-2276d9795ec1",
                                        "glosses": [
                                            "Faire un atterrissage forcé en pleine nature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
