                ],
                "senses": [
                    {
                        "sense_id": "5e39bf17-cd9a-3044-acd1-72ef3ddca998",
                        "entry_id": "ea20380a-d934-3367-8f92-91ce6641ec0c",
                        "glosses": [
                            "so, dass kein Fußballspiel oder -training stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c7c0f4-6473-472b-b10f-d13ef7a201e3",
                                "sense_id": "5e39bf17-cd9a-3044-acd1-72ef3ddca998",
                                "text": "„Während der WM in London, die strategisch geschickt jedes Jahr in der fußballfreien Zeit um Weihnachten und Neujahr liegt, erzielt der Spartensender Sport1 regelmäßig beste Quoten.“"
                            },
                            {
                                "example_id": "7f560e09-8647-4077-ad17-82a3fa02c9be",
                                "sense_id": "5e39bf17-cd9a-3044-acd1-72ef3ddca998",
                                "text": "„Doch nach dieser spektakulären, sagenhaften, ekstatischen englischen Woche, in der wir erfahren durften, was in neun Minuten alles möglich ist, würde uns allen ein zusätzlicher fußballfreier Tag guttun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
