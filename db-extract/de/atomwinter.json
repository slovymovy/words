                "senses": [
                    {
                        "sense_id": "429234eb-cd5f-34d6-9321-41f435cc45d5",
                        "entry_id": "aa89bdd2-7172-39cd-a833-03671ec9db3a",
                        "glosses": [
                            "Phase mit sehr kalten Temperaturen, die durch den Einsatz von Atomwaffen ausgelöst werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64063c48-707f-489e-b1c4-87fead6f6827",
                                "sense_id": "429234eb-cd5f-34d6-9321-41f435cc45d5",
                                "text": "„Selbst ein begrenzter Atomkrieg würde einen Atomwinter auslösen, weltweit - sagen heute übereinstimmend Naturwissenschaftler in den USA und in der Sowjetunion.“"
                            },
                            {
                                "example_id": "64667197-ad4e-478b-941f-e18bf2fb2ce7",
                                "sense_id": "429234eb-cd5f-34d6-9321-41f435cc45d5",
                                "text": "„Ich persönlich bin nie südlicher als bis nach Koge gekommen. Ungefähr fünfzig Kilometer südlich von Kopenhagen. Und weiter werde ich auch nicht kommen, bis der Atomwinter Europa abgekühlt hat.“"
                            },
                            {
                                "example_id": "dbf95025-c0af-413c-9fb1-fd65904e48e0",
                                "sense_id": "429234eb-cd5f-34d6-9321-41f435cc45d5",
                                "text": "„Wenn es zum Schlimmsten käme, nähme die zerbrechliche Ozonschicht der Atmosphäre Schaden, überzöge ein Atomwinter die Erde und brächte Ruin über Land und Leute auch in der Sowjetunion.“"
                            },
                            {
                                "example_id": "37baa9ec-21d8-4998-bfbc-acc11c1f353f",
                                "sense_id": "429234eb-cd5f-34d6-9321-41f435cc45d5",
                                "text": "„Selbst ein begrenzter Atomkrieg würde einen Atomwinter auslösen, weltweit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
