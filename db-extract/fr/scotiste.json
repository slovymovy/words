                    {
                        "sense_id": "0219bc81-8507-3e92-a32b-36303422aceb",
                        "entry_id": "3a531d1c-544d-3cff-8607-a98aca58bed8",
                        "glosses": [
                            "Relatif à la pensée de Jean Duns Scot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f0c4c6-ab5d-4a54-97fe-d987678e4ac7",
                                "sense_id": "0219bc81-8507-3e92-a32b-36303422aceb",
                                "text": "On en discerne clairement la nature [du rationalisme intégral de Boèce] en l’opposant au volontarisme de Duns Scot. Telle qu’elle vient d’être décrite, la doctrine scotiste de la liberté s’attache avant tout à prouver qu’en aucun cas et en aucun sens la raison ne peut être la cause totale de l’acte libre."
                            }
                        ]
                    }
                ],
