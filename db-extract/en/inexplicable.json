                        "form": "more inexplicable"
                    },
                    {
                        "form_id": "fcb815b0-45c8-47e9-85f9-00a306ea83b5",
                        "entry_id": "58bad02e-8c22-37a9-a00b-b69368875a07",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inexplicable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                        "entry_id": "58bad02e-8c22-37a9-a00b-b69368875a07",
                        "glosses": [
                            "Impossible to explain; not easily accounted for."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff51970-8b27-4ed1-b03b-7c59a2eb5aae",
                                "sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                                "text": "The year 1866 was signalised by a remarkable incident, a mysterious and inexplicable phenomenon, which doubtless no one has yet forgotten."
                            },
                            {
                                "example_id": "6dafc148-f8dc-4f2b-aa41-f77ba6a694e4",
                                "sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                                "text": "“No,” replied the girl, “it would not be strange, of course; but for some inexplicable reason I have one of those foolish feminine presentiments that all is not right with Mr. Caldwell. It is the strangest feeling—it is as though I knew that he was not on board the ship.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fee8c3b8-53ca-45aa-8302-fa8db1d2b7ac",
                        "source_entry_id": "58bad02e-8c22-37a9-a00b-b69368875a07",
                        "source_sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                        "source_sense_description": "impossible to explain",
                        "target_lang_word": "nevysvětlitelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nevysvětlitelný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "63b2a3d5-9bf3-317d-97b7-82217bd80fb7",
                                        "entry_id": "0ede47b3-ebb5-3234-a9d1-6c4121734316",
                                        "glosses": [
                                            "takový, který nelze (snadno) vysvětlit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5c0d5c-e222-4525-a13a-75b28cd847ea",
                                                "sense_id": "63b2a3d5-9bf3-317d-97b7-82217bd80fb7",
                                                "text": "Jeho včerejší chování se mi jeví jako naprosto nevysvětlitené."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acedf336-65dd-438b-8627-2031f64301bc",
                        "source_entry_id": "58bad02e-8c22-37a9-a00b-b69368875a07",
                        "source_sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                        "source_sense_description": "impossible to explain",
                        "target_lang_word": "onverklaarbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onverklaarbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e0c142-73cf-3bc7-b170-e55e522951f7",
                                        "entry_id": "1f97ede6-669c-3b72-abec-bda945b46f13",
                                        "glosses": [
                                            "niet te begrijpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbd4963-243d-4b62-ace8-eea079f001b0",
                                                "sense_id": "e9e0c142-73cf-3bc7-b170-e55e522951f7",
                                                "text": "UFO's zijn onverklaarbaar."
                                            },
                                            {
                                                "example_id": "2787e270-891d-4a5c-84c2-9dc637b78090",
                                                "sense_id": "e9e0c142-73cf-3bc7-b170-e55e522951f7",
                                                "text": "De eerste stap op weg naar heiligheid is zaligverklaring. Om zalig te worden is er een wonder nodig. Meestal is dat een wonderbaarlijke genezing, waarbij er diepgravend medisch onderzoek plaatsvindt om uit te zoeken of de genezing echt onverklaarbaar is. De Kerk gaat daarbij niet over één nacht ijs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d1d35bd-c839-4a4b-8fd1-d885f0637e29",
                        "source_entry_id": "58bad02e-8c22-37a9-a00b-b69368875a07",
                        "source_sense_id": "93ad8fae-2493-3b35-ad49-0a21ca349f20",
                        "source_sense_description": "impossible to explain",
                        "target_lang_word": "inexplicable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexplicable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9f2420-d469-33ae-9bd2-c408bf0228bd",
                                        "entry_id": "b484f45a-11c1-342b-b841-236e62a7d69a",
                                        "glosses": [
                                            "Qui ne peut être expliqué ; qui est incompréhensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200823f4-f051-4ccd-b651-7ccc40e0e089",
                                                "sense_id": "ca9f2420-d469-33ae-9bd2-c408bf0228bd",
                                                "text": "Nous sommes si éloignés de connaître tous les agens ^([sic]) de la nature, et leurs divers modes d’action ; qu’il ne serait pas philosophique de nier les phénomènes, uniquement parce qu’ils sont inexplicables dans l’état actuel de nos connaissances."
                                            },
                                            {
                                                "example_id": "ae5897b9-75a4-4715-8e8b-750049bcbff3",
                                                "sense_id": "ca9f2420-d469-33ae-9bd2-c408bf0228bd",
                                                "text": "Et tout le village bientôt, à des degrés variant selon la constitution et la force de résistance de chacun, fut en proie à des malaises étranges, symptômes inexplicables d’empoisonnement."
                                            },
                                            {
                                                "example_id": "647f707e-69ed-49a7-b51b-c608fb03d30e",
                                                "sense_id": "ca9f2420-d469-33ae-9bd2-c408bf0228bd",
                                                "text": "Rappelons qu’aucune des nombreuses missions spatiales américaines n’a rapporté d’inexplicables observations d’ovnis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1f1b21-558c-3d2c-ab1e-718ce3b7899f",
                                        "entry_id": "b484f45a-11c1-342b-b841-236e62a7d69a",
                                        "glosses": [
                                            "Qui est bizarre, étrange, parce qu’on ne peut en rendre compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9828001-f94c-4097-9e7e-dc7860ec95a8",
                                                "sense_id": "2b1f1b21-558c-3d2c-ab1e-718ce3b7899f",
                                                "text": "Au milieu de cet entraînement général vers l’Afrique, l’Asie est négligée d’une manière vraiment inexplicable. Presque tout reste à découvrir dans cet antique berceau du genre humain."
                                            },
                                            {
                                                "example_id": "874762bc-d7bc-4dfa-9920-99cb5927af98",
                                                "sense_id": "2b1f1b21-558c-3d2c-ab1e-718ce3b7899f",
                                                "text": "C’est un homme, un caractère inexplicable. — Sa conduite est inexplicable. — Ces retours de fortune sont inexplicables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inexplicable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59141f6c-d3c0-35c7-8eda-c690a4cc2e7a",
                                        "entry_id": "a29883fb-00aa-3221-9591-1c4291600d8a",
                                        "glosses": [
                                            "Ce qui ne peut pas être expliqué ou compris."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca46ccc-f5c6-41c1-8365-c22a9a18263e",
                                                "sense_id": "59141f6c-d3c0-35c7-8eda-c690a4cc2e7a",
                                                "text": "Les hommes ont forgé des mots pour expliquer cet inexplicable. Ils ont dit : audace, confiance en soi, absence de scrupules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
