                                        "glosses": [
                                            "Neither reflecting nor emitting light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e451ed70-8cdf-46f1-a04f-9422f679d54d",
                                                "sense_id": "40936000-49b5-3a94-9a83-4e56a0941b00",
                                                "text": "We have agreed that heat is energy to begin with. Light is also a form of energy for when absorbed by any opaque substance it turns completely into heat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0ba1051-ffb2-3014-aa06-a822dccc529c",
                                        "entry_id": "836cbfdb-f0aa-37b1-bbef-709429c6c7e0",
                                        "glosses": [
                                            "Allowing little light to pass through, not translucent or transparent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65abf0d1-c4e5-3809-8861-3672b6f63466",
                                        "entry_id": "836cbfdb-f0aa-37b1-bbef-709429c6c7e0",
                                        "glosses": [
                                            "Unclear, unintelligible, hard to get or explain the meaning of."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35bc5d5b-0dbe-35c9-9218-40a75320626b",
                                        "entry_id": "836cbfdb-f0aa-37b1-bbef-709429c6c7e0",
                                        "glosses": [
                                            "Obtuse, stupid."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68b958f3-2b34-3d97-a858-9bd85521bb3b",
                                        "entry_id": "836cbfdb-f0aa-37b1-bbef-709429c6c7e0",
                                        "glosses": [
                                            "Describes a type for which higher-level callers have no knowledge of data values or their representations; all operations are carried out by the type's defined abstract operators."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "opaque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88dcb08b-6623-3856-ace0-5cce6ef8dae8",
                                        "entry_id": "8eb9a3ee-c933-33c9-a1e0-fec64afdc3d0",
                                        "glosses": [
                                            "An area of darkness; a place or region with no light."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "610819d6-270e-4d28-a8f3-74bfb79a5138",
                                                "sense_id": "88dcb08b-6623-3856-ace0-5cce6ef8dae8",
                                                "text": "Through this opaque of Nature and of Soul, / This double night, transmit one pitying ray, / To lighten, and to cheer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f875dab-474f-3b01-ac60-d203af0777de",
                                        "entry_id": "8eb9a3ee-c933-33c9-a1e0-fec64afdc3d0",
                                        "glosses": [
                                            "Something which is opaque rather than translucent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dac5327-ce11-499d-a9f6-b083f627ac30",
                                                "sense_id": "7f875dab-474f-3b01-ac60-d203af0777de",
                                                "text": "They can be obtained in various thicknesses and in many colors, including beautiful imitations of pearl, mother-of-pearl, veins and mottles, stratifications, roll stratifications, imitation corals, and all colors of translucents, transparents and opaques, grained ivory, shell (plain and corrugated mottle), onyx, wood effects, plaids, checks, stripes, metallic, bronze pearl plain, bronze pearl with fancy blocks, bronze pearl in veins and stripes, and what is called “essence pearl.”"
                                            }
                                        ]
                                    }
                                ]
