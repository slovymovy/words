                        ],
                        "examples": [
                            {
                                "example_id": "ca9d3d89-950b-4662-8109-d63bd1640be7",
                                "sense_id": "f35cce50-75d0-373c-a5cc-697f945069d6",
                                "text": "Het resultaat is knalroze en stroperig. ‘Het smaakt naar negen dosissen sacharine, gemengd met twee eetlepels olijfolie’, vertelde Dyer aan The Guardian. Mogelijk is dit de eerste niet-dodelijke en efficiënte oplossing voor de rattenoverbevolking."
                            },
                            {
                                "example_id": "cea27a70-1eef-460d-aa8e-649e9fdecef9",
                                "sense_id": "f35cce50-75d0-373c-a5cc-697f945069d6",
                                "text": "E954 (Sacharine), E 952 (Cyclamaat), E 950 (Acesulfaam-K) en E 955 (Sucralose), afgekort als SAC, CYC, ACE en SUC, kunnen niet door het lichaam worden afgebroken of uit afvalwater gefilterd worden."
                            }
                        ]
                    }
