                "senses": [
                    {
                        "sense_id": "917d8a56-e08e-3e23-a278-fd10a801b89d",
                        "entry_id": "bd9d0a0d-aee5-375e-a808-61e38f93f388",
                        "glosses": [
                            "Enlever ce qui illustrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab95da94-8d07-4e64-bf9d-f992cc4a18f7",
                                "sense_id": "917d8a56-e08e-3e23-a278-fd10a801b89d",
                                "text": "La pose d’étiquettes françaises sur des boîtes qui sont entrées blanches ou qui ont été désillustrées à leur arrivée en France : le même but est atteint, lorsque la boîte étrangère présente des mentions, des noms, des devises françaises avec ou sans l’indication du lieu d’origine ; l’acheteur croit acheter un produit français […]"
                            },
                            {
                                "example_id": "33f0da81-71ae-40d7-bfa0-c4c15a438f7c",
                                "sense_id": "917d8a56-e08e-3e23-a278-fd10a801b89d",
                                "text": "Si l’on vous voit en passe d’illustrer les gares, on ne vous laissera jamais déboulonner la colonne et désillustrer l’Empire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b436db3a-d7e8-3be3-953f-99bc9082004a",
                        "entry_id": "bd9d0a0d-aee5-375e-a808-61e38f93f388",
                        "glosses": [
                            "Faire perdre son caractère illustre à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56007bfc-a81f-40f9-b352-19792b669122",
                                "sense_id": "b436db3a-d7e8-3be3-953f-99bc9082004a",
                                "text": "Cet illustre s’est singulièrement désillustré, même dans un temps où l’on n’y regarde pas de trop près en fait de conduite et de moralité."
                            }
                        ]
                    }
