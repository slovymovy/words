                "senses": [
                    {
                        "sense_id": "62798b3a-8345-303b-99ef-ddbdc888ece3",
                        "entry_id": "2fd7ad1b-26b9-366f-9235-02352558e1a4",
                        "glosses": [
                            "Schrank in einem Badezimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61355fd2-ccea-4f1c-adb0-eacd047b4e8a",
                                "sense_id": "62798b3a-8345-303b-99ef-ddbdc888ece3",
                                "text": "„Diesen hier, versteckt im falschen Unterteil eines scheinbar leeren Badezimmerschrankes, wird er in null Komma nichts offen haben und nur so viel Geld herausnehmen, wie sie brauchen, um nach Chicago zu fliegen.“"
                            },
                            {
                                "example_id": "fb8f2523-99c5-49ae-b0c0-1aac7e5c836d",
                                "sense_id": "62798b3a-8345-303b-99ef-ddbdc888ece3",
                                "text": "„Nach der Pistole ist nichts Interessantes mehr zum Vorschein gekommen - bis Libby auf den Umschlag in einer Schachtel Tampons im Badezimmerschrank unter dem Waschbecken gestoßen ist.“"
                            },
                            {
                                "example_id": "7ef9c7fc-62a4-4016-b641-0e7cb4eafb44",
                                "sense_id": "62798b3a-8345-303b-99ef-ddbdc888ece3",
                                "text": "„Ich suchte im Schmuckkasten, im Badezimmerschrank, in der kleinen Schlüsselschale im Flur, aber am Ende gab ich auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
