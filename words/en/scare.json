                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scarce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Food was <w>scare</w> during the harsh winter months.",
                            "target_lang_translations": {
                                "ru": "Зимой еда была <w>скудной</w>.",
                                "de": "In den harten Wintermonaten war das Essen <w>knapp</w>.",
                                "fr": "La nourriture était <w>rare</w> pendant les mois d'hiver rigoureux.",
                                "nl": "Voedsel was <w>schaars</w> tijdens de strenge wintermaanden."
                            }
                        },
                        {
                            "text": "Resources have become <w>scare</w> in this region.",
                            "target_lang_translations": {
                                "ru": "Ресурсы в этом регионе стали <w>дефицитными</w>.",
                                "de": "Die Ressourcen sind in dieser Region <w>spärlich</w> geworden.",
                                "fr": "Les ressources sont devenues <w>rares</w> dans cette région.",
                                "nl": "Grondstoffen zijn <w>schaars</w> geworden in deze regio."
                            }
                        }
                    ],
