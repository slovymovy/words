                        ],
                        "examples": [
                            {
                                "example_id": "f6ff69f9-0ff6-44b5-9388-bdd933a5ea13",
                                "sense_id": "bd0f51c8-7295-36cd-95be-27ddb1a68212",
                                "text": "He lay back on his pillow, made a faint zzzing sound that ceased, and presently and quite quietly he died — greatly comforted by my assurance."
                            },
                            {
                                "example_id": "0419ee7c-9567-4856-b1a0-055278e60453",
                                "sense_id": "bd0f51c8-7295-36cd-95be-27ddb1a68212",
                                "text": "He zzzed for a long time, bobbing back and forth, and then he let us go, pointing to two empty seats across the aisle and motioning for us to sit down."
                            }
                        ]
                    }
