                    }
                ],
                "senses": [
                    {
                        "sense_id": "503634c4-2199-373b-a089-b6a5a1107063",
                        "entry_id": "2282bbfb-095d-3650-a968-6a440fb12d62",
                        "glosses": [
                            "спорт. в спортивных играх (футбол, баскетбол, хоккей и т. п.) — ограничение действий соперника путём применения блокировок или силовых приёмов в рамках правил"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8938d053-64b8-4346-b51c-ecb247f1e512",
                                "sense_id": "503634c4-2199-373b-a089-b6a5a1107063",
                                "text": "Сценарий встречи на первых минутах угадывался легко: американки включили агрессивный прессинг по всей площадке, и уже в первой четверти довели свое преимущество до 10 очков…"
                            }
                        ]
                    },
                    {
                        "sense_id": "a9c88495-dfd2-388b-9505-7d7bb9b894c4",
                        "entry_id": "2282bbfb-095d-3650-a968-6a440fb12d62",
                        "glosses": [
                            "перен. давление, нажим на кого-либо, что-либо для достижения определенных целей, принуждения к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62274921-8163-4b8e-af14-d8a320e9b3a1",
                                "sense_id": "a9c88495-dfd2-388b-9505-7d7bb9b894c4",
                                "text": "Если бы не советский и фашистский прессинг, капитализм вряд ли сам по себе вырос бы в новый строй."
                            },
                            {
                                "example_id": "cd689b4b-8357-4192-a604-cc4f2214e99c",
                                "sense_id": "a9c88495-dfd2-388b-9505-7d7bb9b894c4",
                                "text": "Современный бизнесмен не выступает против налогового прессинга, он уклоняется от налогов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05a74d3c-4aea-4b3b-ae8b-811bcfa1f1e4",
                        "source_entry_id": "2282bbfb-095d-3650-a968-6a440fb12d62",
                        "source_sense_description": "ограничение действий соперника путём применения блокировок или силовых приёмов в рамках правил",
                        "target_lang_word": "pressing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                        "entry_id": "7b097499-a34b-389f-82fa-a0c21e6bcd7e",
                                        "glosses": [
                                            "Needing urgent attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b7a8b7-2431-4ef0-b3b6-99e66bf9d4a0",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "“I come on business.—Private,” he added, with a glance at the man who stood looking on, “and very pressing business.”"
                                            },
                                            {
                                                "example_id": "4a54df98-5701-420c-b231-197bdd4b18b2",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "The rebuilding of damaged stations is proceeding slowly, on account of the shortage of building materials and the pressing needs of housing, but steady progress is being made."
                                            },
                                            {
                                                "example_id": "81a37a13-0b4c-4248-b1ed-f06f6f6282bc",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "Argentinians support the \"Malvinas\" cause, which is written into the constitution. But they are also worried about pressing economic problems such as inflation, rising crime and corruption."
                                            },
                                            {
                                                "example_id": "12754b6e-fc91-4ac8-b0ae-55f0afec3df1",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "Four Japanese torpedo boats launch an attack on the Suvorov. Despite burning steadily for several hours and now taking a torpedo to the stern, the ship still lashes out at its attackers with a few remaining guns. With no pressing need to continue the attack to closer range, the torpedo boats fall back, noting the position for a night attack if Suvorov survives that long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                        "entry_id": "7b097499-a34b-389f-82fa-a0c21e6bcd7e",
                                        "glosses": [
                                            "Insistent, earnest, or persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1389d6cf-6b19-429a-aa31-dceb88224999",
                                                "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                                "text": "You are very pressing, Basil, but I am afraid I must go."
                                            },
                                            {
                                                "example_id": "d71e5190-35a5-473e-a068-49e76265321c",
                                                "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                                "text": "He was pressing and persuasive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pressing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74bf17f-b948-35e4-ba78-f56f0f9a3eba",
                                        "entry_id": "19dcec7f-2402-3a1d-a17a-baae4d79701f",
