    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                    "sense_definition": "Être en relation avec quelqu'un ou être en mesure d'identifier une personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>connais</w> cette femme depuis plus de dix ans."
                        },
                        {
                            "text": "Est-ce que tu <w>connais</w> bien le nouveau professeur de musique ?"
                        }
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "bien connaître quelqu'un"
                    ]
                },
                {
                    "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                    "sense_definition": "Avoir la notion, le souvenir ou la pratique d'un lieu ou d'une chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "savoir_notion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>connaissons</w> très bien le chemin qui mène au lac."
                        },
                        {
                            "text": "Les élèves doivent <w>connaître</w> par cœur ce poème avant demain."
                        }
                    ],
                    "synonyms": [
                        "savoir"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "connaître par cœur"
                    ]
                },
                {
                    "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                    "sense_definition": "Faire l'expérience de quelque chose, éprouver ou traverser une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "experience_epreuve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise a <w>connu</w> un immense succès auprès des consommateurs."
                        },
                        {
                            "text": "Le pays <w>connaît</w> actuellement une période de transformation économique importante."
                        }
                    ],
                    "common_phrases": [
                        "connaître le succès"
                    ]
                },
                {
                    "sense_id": "32bf2c99-dfa3-3341-9bb1-ec951b2375fe",
                    "sense_definition": "Avoir de solides compétences ou de l'expérience dans un domaine déterminé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "competence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère s'y <w>connaît</w> vraiment bien en mécanique automobile."
                        },
                        {
                            "text": "Si vous avez un problème avec votre ordinateur, elle s'y <w>connaît</w>."
                        }
                    ],
                    "common_phrases": [
                        "s'y connaître"
                    ]
                },
                {
                    "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                    "sense_definition": "Avoir l'autorité juridique pour examiner une affaire et statuer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit_justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tribunal civil a seul le pouvoir de <w>connaître</w> de ce litige."
                        },
                        {
                            "text": "Le magistrat a affirmé qu'il ne pouvait pas légalement <w>connaître</w> de cette affaire."
                        }
                    ],
                    "common_phrases": [
                        "connaître d'un litige"
                    ]
                },
                {
                    "sense_id": "879ecb38-1072-336b-8623-ab139ef66aab",
                    "sense_definition": "Avoir des relations intimes et charnelles avec quelqu'un.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexualite_archaïque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce récit biblique, le patriarche <w>connut</w> sa femme après l'exil."
                        },
                        {
                            "text": "L'auteur classique utilise ce verbe pour rappeler qu'il a <w>connu</w> son premier amour."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi au sens biblique ou littéraire"
                        }
                    ]
                }
            ]
        }
    ]
