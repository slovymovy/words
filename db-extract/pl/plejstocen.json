                        "examples": [
                            {
                                "example_id": "e670f517-7dec-487b-9e60-9ad6cab46727",
                                "sense_id": "085b28a8-0a8d-3fc7-88b0-bede18226679",
                                "text": "Podczas plejstocenu miało miejsce kilka zlodowaceń kontynentalnych."
                            }
