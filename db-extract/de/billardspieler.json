                "senses": [
                    {
                        "sense_id": "23b96634-0f49-352a-9be3-d0dcba555654",
                        "entry_id": "4dd5dfd6-2aa5-3174-9f13-2f83ac4be11e",
                        "glosses": [
                            "Sportler, der das Billardspiel ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83432c8d-9f62-40e3-833a-3a4281a6f95d",
                                "sense_id": "23b96634-0f49-352a-9be3-d0dcba555654",
                                "text": "Er hat lange gebraucht, bis er ein guter Billardspieler wurde."
                            },
                            {
                                "example_id": "d7551fe3-1ea0-4703-aae4-85a0d4e7520d",
                                "sense_id": "23b96634-0f49-352a-9be3-d0dcba555654",
                                "text": "„Da sie an Scherzworten über unsere große Flasche nicht sparten, gerieten wir ins Gespräch, und bald war Paul, der sich bei dieser Gelegenheit auch als geschickter Billardspieler erwies, mit von der Partie.“"
                            },
                            {
                                "example_id": "d7ec4bf1-fda4-40c1-8205-0bdda9140440",
                                "sense_id": "23b96634-0f49-352a-9be3-d0dcba555654",
                                "text": "„Manchmal gab ein Billardspieler im Lokal von McGraw mir ein paar Cents, damit ich ihm ein Sandwich oder eine Zigarre holte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
