                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b69ed06-bbaa-4a75-a1ed-df5b09fc4151",
                                "sense_id": "f9ccc648-29a8-3329-8a99-27086bcb4af7",
                                "text": "Naast de kazemat, weet hij, stond een zoutbak, voor als het glad was."
                            },
                            {
                                "example_id": "47c33860-8bdf-4075-8e51-52b440ae825d",
                                "sense_id": "f9ccc648-29a8-3329-8a99-27086bcb4af7",
                                "text": "De gemeente verspreidde opnieuw een veertigtal bakken met strooizout over de hele gemeente. De zoutbakken staan aan openbare gebouwen, aan scholen en aan wegen waar de strooidiensten moeilijk geraken. Het zout dient om te gebruiken bij sneeuw en ijzel. Elk jaar wordt er een vijftal bakken gestolen."
                            }
                        ]
                    }
