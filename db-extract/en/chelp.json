                        ],
                        "examples": [
                            {
                                "example_id": "32922d82-e911-496e-bc6b-a1b1634abc8e",
                                "sense_id": "be42db50-7dcf-302e-aae5-ea5715aeed71",
                                "text": "He's not here so we are chelping in the staffroom and ignoring the to-do list on the board."
                            },
                            {
                                "example_id": "0534d20b-d171-4ad6-b72a-740bc1b17937",
                                "sense_id": "be42db50-7dcf-302e-aae5-ea5715aeed71",
                                "text": "1820, John Clare, “My Mary” in Poems Descriptive of Rural Life and Scenery, London: Taylor and Hessey, p. 87,\nWho’s laugh’d at too by every whelp,\nFor failings which she cannot help?\nBut silly fools will laugh and chelp,\nMy Mary."
                            }
                        ]
                    },
