                    },
                    {
                        "translation_id": "fa58b3bf-f22d-4afe-92ed-4e4eddaa1f36",
                        "source_entry_id": "9cd2803a-24ce-31b3-96f8-4702dc1a41da",
                        "source_sense_id": "2c03c1c9-e671-3096-bee0-7ca4165bf386",
                        "source_sense_description": "person who disseminates propaganda",
