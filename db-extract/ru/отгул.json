                                                "example_id": "496148d3-ae59-4a93-b58b-b27f1a4d3f61",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Ce député a demandé un congé à la Chambre, pour cause de maladie."
                                            }
                                        ]
                                    },
