{
    "word_family": [
        "harcèlement",
        "harceleur",
        "harceleuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48a310fb-8723-3ed7-ba43-844e81988957",
                    "sense_definition": "Tourmenter une personne de manière répétée et malveillante en lui portant préjudice moralement ou physiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maltraitance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les professeurs veillent à ce qu'aucun élève ne vienne <w>harceler</w> ses camarades pendant la récréation."
                        },
                        {
                            "text": "L'employé a décidé de démissionner après avoir vu son supérieur le <w>harceler</w> sans interruption."
                        }
                    ],
                    "synonyms": [
                        "tourmenter",
                        "tyranniser"
                    ],
                    "antonyms": [
                        "ficher la paix"
                    ],
                    "common_phrases": [
                        "se faire harceler",
                        "harceler un collègue"
                    ]
                },
                {
                    "sense_id": "14e33b17-6fb5-3687-bdc4-060363be9d2f",
                    "sense_definition": "Importuner avec insistance quelqu'un par des demandes, des appels ou des questions incessantes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes continuent de <w>harceler</w> de questions le porte-parole à la sortie du tribunal."
                        },
                        {
                            "text": "Des sociétés commerciales me <w>harcèlent</w> de coups de téléphone depuis le début du mois."
                        }
                    ],
                    "synonyms": [
                        "importuner",
                        "agacer"
                    ],
                    "antonyms": [
                        "ficher la paix"
                    ],
                    "common_phrases": [
                        "harceler de questions",
                        "harceler au téléphone"
                    ]
                },
                {
                    "sense_id": "b9937e8c-15b0-395e-89e2-864c35138b79",
                    "sense_definition": "Attaquer l'adversaire par de fréquentes escarmouches pour l'épuiser et désorganiser ses rangs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les escadrons de cavalerie ont reçu l'ordre de <w>harceler</w> les troupes ennemies pendant leur retraite."
                        },
                        {
                            "text": "Ce groupe de rebelles parvient à <w>harceler</w> les convois militaires tout le long de la frontière."
                        }
                    ],
                    "synonyms": [
                        "talonner",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "harceler les troupes ennemies",
                        "harceler le convoi"
                    ]
                }
            ]
        }
    ]
}