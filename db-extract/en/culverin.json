                "senses": [
                    {
                        "sense_id": "d47e74e4-b659-3c5a-b10c-1f669a8b1bc7",
                        "entry_id": "ff87a037-3b6f-3026-964f-41667103b29e",
                        "glosses": [
                            "Any of a range of early gunpowder-fired guns of various sizes, from firearm to artillery.",
                            "A kind of handgun."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fe2106a2-b26e-382d-92e6-a964b3ec3512",
                        "entry_id": "ff87a037-3b6f-3026-964f-41667103b29e",
                        "glosses": [
                            "Any of a range of early gunpowder-fired guns of various sizes, from firearm to artillery.",
                            "A large cannon."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "eb0289ff-74a4-49b5-9a65-e0597454df23",
                                "sense_id": "fe2106a2-b26e-382d-92e6-a964b3ec3512",
                                "text": "Let Sacars, Culuerings, and Cannons ſound / In honour of their bones, and rock the ground / With all your deafning terrors: for behold / The Balſum for your wounds, are rich mens gold, / Powder the world with wonder, and thus crie, / The Camel now may paſſe the needles eie."
                            },
                            {
                                "example_id": "58c507ba-ada6-4f60-a7c3-4bf70c06ab27",
                                "sense_id": "fe2106a2-b26e-382d-92e6-a964b3ec3512",
                                "text": "This had been discharged from a culverin on the opposite side of the valley."
                            }
                        ]
                    }
                ],
