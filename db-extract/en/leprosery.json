                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdabe773-98cb-406a-9038-addd5a40b6ac",
                                                "sense_id": "03cfe42a-745c-3517-b78a-94997c38f265",
                                                "text": "Chaque matin […] roulait sur ses gonds la porte de la maladrerie, et les lépreux, semblables aux antiques anachorètes, s'enfonçaient tout le jour parmi le désert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5878c680-ab2a-3e63-8479-71c94313c992",
                                        "entry_id": "a59cd9e6-2abc-38d0-b696-b3743245dbf8",
                                        "glosses": [
                                            "Hospice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b62356f-150f-49ec-a4d8-4da6352ca757",
                                                "sense_id": "5878c680-ab2a-3e63-8479-71c94313c992",
                                                "text": "Nous rencontrâmes aussi des maladreries toutes délabrées, pour mettre les pauvres gens en train de mourir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
