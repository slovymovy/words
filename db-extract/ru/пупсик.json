                ],
                "senses": [
                    {
                        "sense_id": "120991f0-9329-3c2f-a144-e71f14ddcf7a",
                        "entry_id": "397a109c-6109-389a-9cdc-cd68521be31e",
                        "glosses": [
                            "кукла маленького ребёнка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2ee6b1-000f-4cec-98c5-80160388ce52",
                                "sense_id": "120991f0-9329-3c2f-a144-e71f14ddcf7a",
                                "text": "В коробке из-под торта лежали пупсики — и советские целлулоидные, и редкие в её детстве немецкие, и привезённые ею не так давно из Франции, которые оказались китайскими."
                            },
                            {
                                "example_id": "e3aa3acb-f05b-4c4e-97b8-ebc77242e3f5",
                                "sense_id": "120991f0-9329-3c2f-a144-e71f14ddcf7a",
                                "text": "А у нас всё было: и фата, и машина с пупсиком, и загс…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3ed0751-bd42-3c24-b9c1-814f6a6e96e0",
                        "entry_id": "397a109c-6109-389a-9cdc-cd68521be31e",
                        "glosses": [
                            "разг., перен. уменьш.-ласк. к сущ. пупс; маленький ребёнок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d2e147-b899-4925-9d6b-4e7af0a8e129",
                                "sense_id": "c3ed0751-bd42-3c24-b9c1-814f6a6e96e0",
                                "text": "Твоя Леночка, твоя кошечка, сварит своему пупсику компотик."
                            },
                            {
                                "example_id": "f56e6871-15df-4c1c-8fdf-2aa3b1634b85",
                                "sense_id": "c3ed0751-bd42-3c24-b9c1-814f6a6e96e0",
                                "text": "Какую Лене бог хозяйку послал! Пупсик, от земли не видно, а гляди, как работает!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce35787f-d1b7-4156-863c-2571111f1548",
                        "source_entry_id": "397a109c-6109-389a-9cdc-cd68521be31e",
                        "source_sense_description": "кукла",
                        "target_lang_word": "kewpie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kewpie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e2d568b-89bb-34bc-8695-e2e034e40e63",
                                        "entry_id": "b7288d61-5490-3dc1-971e-df6e998278f1",
                                        "glosses": [
                                            "A kewpie doll."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbac30e0-a6af-474d-a9e7-6fa4fead71e9",
                                                "sense_id": "7e2d568b-89bb-34bc-8695-e2e034e40e63",
                                                "text": "A fat little kewpie clutching a pink heart place card stood at each cover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdee5aec-ace4-4d89-926c-3984270fd4e3",
                        "source_entry_id": "397a109c-6109-389a-9cdc-cd68521be31e",
                        "source_sense_description": "кукла",
                        "target_lang_word": "kewpie doll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kewpie doll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df81a728-a647-3618-9c18-211979ef6c9a",
                                        "entry_id": "91c44cfa-e240-33c5-9927-56d168732074",
                                        "glosses": [
                                            "A plump doll with a curl of hair on its head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c62ae254-6a85-4719-b6ac-9235e166f306",
                                                "sense_id": "df81a728-a647-3618-9c18-211979ef6c9a",
                                                "text": "He was a low-browed youth of about twenty, very big for his age, swarthy as a Greek, and shaped rather like a kewpie doll, having a rotund pendulous paunch and a distinctly egg-shaped head."
                                            },
                                            {
                                                "example_id": "6cbc75e6-61d6-438d-906c-e361da583733",
                                                "sense_id": "df81a728-a647-3618-9c18-211979ef6c9a",
                                                "text": "The young explorer stood in the crowd, Kewpie doll under his arm […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
