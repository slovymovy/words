                                        "entry_id": "ea680286-1b37-3b2e-b6d1-1649afa0f5e6",
                                        "glosses": [
                                            "Qui est malpropre, qui n’est pas net, en parlant des personnes ou des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3189d1-feca-4abf-8ea7-bf196aea6816",
                                                "sense_id": "2a69ee63-2a0c-32fa-8ca2-5927a72b71a1",
                                                "text": "Sale et productif comme le commerce, ce passage, toujours plein d’allants et de venants, de charrettes, de haquets, est d’un aspect repoussant, et la population qui y grouille est en harmonie avec les choses et les lieux."
                                            },
                                            {
                                                "example_id": "294e48a2-fb25-4d95-90ba-82e8d580dc15",
                                                "sense_id": "2a69ee63-2a0c-32fa-8ca2-5927a72b71a1",
                                                "text": "une goutte entêtée me nargue\ndu robinet à l’amas d’assiettes sales\nqui s’empilent dans l’évier"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5caafed-6a6a-3fe5-9c7b-6f8c830cf338",
                                        "entry_id": "ea680286-1b37-3b2e-b6d1-1649afa0f5e6",
                                        "glosses": [
                                            "Brouillé, confus, fondu, terne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d1f533-6376-4a6e-aed5-0c0efc1f3bd2",
                                                "sense_id": "a5caafed-6a6a-3fe5-9c7b-6f8c830cf338",
                                                "text": "J’avais pu constater, parmi cette cinquantaine de squales presque noirs, la présence d’un énorme requin blanc sale."
                                            },
                                            {
                                                "example_id": "c78e4f2e-7174-4a6f-ac85-83645ead595f",
                                                "sense_id": "a5caafed-6a6a-3fe5-9c7b-6f8c830cf338",
                                                "text": "La couleur de ce tableau est sale."
                                            },
                                            {
                                                "example_id": "5537f22e-a57a-4607-b76f-9abc570dce16",
                                                "sense_id": "a5caafed-6a6a-3fe5-9c7b-6f8c830cf338",
                                                "text": "Ces boiseries sont peintes en gris sale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f46307-0fa8-3770-882c-a26c9bc18208",
                                        "entry_id": "ea680286-1b37-3b2e-b6d1-1649afa0f5e6",
                                        "glosses": [
                                            "Qui est déshonnête, vil, sordide, vicieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
