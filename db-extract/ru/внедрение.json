                                                "example_id": "743ea5af-fbb8-487b-948e-c9cba8ea5d2c",
                                                "sense_id": "46041fc7-b647-3328-8ca7-017b973a462e",
                                                "text": "the introduction of a new product into the market"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a5190c3-75fe-353d-a9b2-b7d1ccb625af",
                                        "entry_id": "c3c00376-53d9-314b-9c8d-b7a54b1191ae",
                                        "glosses": [
                                            "A means, such as a personal letter, of presenting one person to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df3cdd1-912d-4950-9909-f00b06bc2330",
                                                "sense_id": "3a5190c3-75fe-353d-a9b2-b7d1ccb625af",
                                                "text": "David was feeling groggy at his introduction to Sophie, and didn't remember her name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89121ad5-acb6-3e33-bb4c-ade47313ecf9",
                                        "entry_id": "c3c00376-53d9-314b-9c8d-b7a54b1191ae",
                                        "glosses": [
                                            "An initial section of a book or article, which introduces the subject material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe8e0faf-19fc-4f96-8180-5e516c84f5fe",
                                                "sense_id": "89121ad5-acb6-3e33-bb4c-ade47313ecf9",
                                                "text": "This book features a preface by a well-known botanist, and an introduction by the author's mentor at university."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840051d7-99ca-30d7-81d6-fc7c8f93ff3a",
                                        "entry_id": "c3c00376-53d9-314b-9c8d-b7a54b1191ae",
                                        "glosses": [
                                            "A written or oral explanation of what constitutes the basis of an issue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb174fd-a492-4895-9c9e-a364cb29a670",
                                                "sense_id": "840051d7-99ca-30d7-81d6-fc7c8f93ff3a",
                                                "text": "ECON 101: introduction to economics"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e22e5b1e-a2e5-442c-884b-21e8fadf7bfd",
                        "source_entry_id": "613a8e80-8c15-34ca-89c8-b48e6fcb0e75",
                        "source_sense_id": "f4541de4-6a2e-334c-810a-ad8a2bb35018",
                        "target_lang_word": "intrusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233b4926-ce7c-3e60-aa22-07e9075e4eb0",
                                        "entry_id": "bea7b483-aec4-3f0e-a753-9ac1f6ecd64b",
                                        "glosses": [
                                            "The forcible inclusion or entry of an external group or individual; the act of intruding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae3d71b-7bc9-4cb8-a9ac-d69206aaedef",
                                                "sense_id": "233b4926-ce7c-3e60-aa22-07e9075e4eb0",
                                                "text": "She viewed sales calls as an unwelcome intrusion."
                                            },
                                            {
                                                "example_id": "c2e77e7b-ef05-4ea4-a121-c7faf53c2e50",
                                                "sense_id": "233b4926-ce7c-3e60-aa22-07e9075e4eb0",
                                                "text": "Sudden anger rose in him. “What I’m looking for,” he barked, “is to be left in peace.” His voice trembled with a rage far bigger than her intrusion merited, the rage which shocked him whenever it coursed through his nervous system, like a flood."
                                            },
                                            {
                                                "example_id": "cae38c0f-5e3b-4f8e-b484-7d88e6b3a519",
                                                "sense_id": "233b4926-ce7c-3e60-aa22-07e9075e4eb0",
                                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                                            },
                                            {
                                                "example_id": "050b523b-502c-41ed-955b-05be422adfac",
                                                "sense_id": "233b4926-ce7c-3e60-aa22-07e9075e4eb0",
                                                "text": "Electroencephalography (EEG), Electrocardiography (ECG), Galvanic Skin Response (GSR), Respiration Rate Analysis (RR), Skin Temperature Measurements (SKT), Electromyogram (EMG), Electrooculography (EOG), Facial Expressions (FE), Body Posture (BP), and Gesture Analysis (GA) are the main emotion recognition approaches that have been evolved in sensor technology and methods in recent years for affective HCI. Hybrid approaches, multimodal features and even the text that is typed in by users during a game or social media communication can serve as a possible starting point for the affect detection process and sentiment analysis in digital environments. Purpose, cost, intrusion, accuracy, user tolerance, and the computing processing power are the important elements involved in selecting and utilizing the sensing tools in each project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7606fa04-b19f-3086-b56e-362ad45ad3f4",
                                        "entry_id": "bea7b483-aec4-3f0e-a753-9ac1f6ecd64b",
                                        "glosses": [
                                            "Magma forced into other rock formations; the rock formed when such magma solidifies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e61cc25-4c77-3a09-8720-80328d99a73b",
                                        "entry_id": "bea7b483-aec4-3f0e-a753-9ac1f6ecd64b",
                                        "glosses": [
                                            "A structure that lies within a historic district but is nonhistoric and irrelevant to the district."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763653e3-9629-4d6a-8df7-7c56a6551892",
                                                "sense_id": "2e61cc25-4c77-3a09-8720-80328d99a73b",
                                                "text": "This setting is slightly altered by modern intrusion."
                                            },
                                            {
                                                "example_id": "086d3958-0b8f-4060-8df3-2c0bf6c75284",
                                                "sense_id": "2e61cc25-4c77-3a09-8720-80328d99a73b",
                                                "text": "Although there are modern intrusions (a road and communications facilities on the summit), the mountain is important to the Kumeyaay community's belief system."
                                            },
                                            {
                                                "example_id": "dd7735d0-6aa6-4728-919e-a4c044f4e626",
                                                "sense_id": "2e61cc25-4c77-3a09-8720-80328d99a73b",
                                                "text": "In 1844, objection was raised to the Furness Railway's Dalton & Barrow line, when it was revealed that the line would pass directly through Furness Abbey. A re-route was achieved, with the line skirting the abbey ruins instead - although many continued to see the intrusion as a travesty against antiquity and the scenic beauty of the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a81ee21-fc2b-339a-9999-5608a96d7fa9",
                                        "entry_id": "bea7b483-aec4-3f0e-a753-9ac1f6ecd64b",
                                        "glosses": [
                                            "The insertion of a phoneme into the pronunciation of a word despite its absence from the spelling. (e.g. intrusive r)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753fa241-ebb7-4332-94b9-86f5b0ef88e5",
                                                "sense_id": "5a81ee21-fc2b-339a-9999-5608a96d7fa9",
                                                "text": "A current challenge in recent work on Spanish sound structure is to understand the conditions that determine vowel intrusion and the consequences vowel intrusion may have on Spanish phonology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c44564-dc0b-37b0-94d0-05288d703c10",
                                        "entry_id": "bea7b483-aec4-3f0e-a753-9ac1f6ecd64b",
                                        "glosses": [
                                            "An involuntarily arising idea or memory that is nuisant and falsifies an accurate impression of the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92dc174e-bbc2-4680-951e-d121b45993a6",
                                                "sense_id": "15c44564-dc0b-37b0-94d0-05288d703c10",
                                                "text": "In general, intrusion errors tend to occur with greater frequency in individuals whose cognitive capacity is diminished relative to that of young adults. Poor readers, older participants, and neuropsychological patients exhibit more intrusion errors than controls."
                                            },
                                            {
                                                "example_id": "416411bb-608b-4fad-86fe-05300f64e240",
                                                "sense_id": "15c44564-dc0b-37b0-94d0-05288d703c10",
                                                "text": "To our knowledge, there have been no longitudinal studies that have examined the association between semantic intrusion errors and the longitudinal progression of PreMCI to a formal diagnosis of MCI or, conversely, a return to a cognitively normal state over time. Further, the association between semantic intrusion errors and the progression to dementia among those with aMCI has not been examined."
                                            },
                                            {
                                                "example_id": "e2532a7b-3ccf-422a-b0b7-dcc507c8048a",
                                                "sense_id": "15c44564-dc0b-37b0-94d0-05288d703c10",
                                                "text": "Intrusion symptoms (e.g., nightmares) and anhedonia symptoms were associated with significantly lower probability of reporting moderate physical activity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
