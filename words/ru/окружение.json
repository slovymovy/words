                },
                {
                    "sense_id": "bf9db6f1-4f6b-39d3-8329-e984b1914b3d",
                    "sense_definition": "Военное положение, при котором войска отрезаны от основных сил и блокированы противником.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдатам удалось с тяжёлым боем выйти из <w>окружения</w> врага.",
                            "target_lang_translations": {
                                "en": "The soldiers managed to break out of the enemy <w>encirclement</w> after a heavy battle.",
                                "pl": "Żołnierzom udało się po ciężkiej walce wyjść z <w>okrążenia</w> wroga."
                            }
                        },
                        {
                            "text": "Целая дивизия оказалась в плотном <w>окружении</w> без связи и припасов.",
                            "target_lang_translations": {
                                "en": "A whole division ended up in tight <w>encirclement</w> without communication or supplies.",
                                "pl": "Cała dywizja znalazła się w szczelnym <w>okrążeniu</w> bez łączności i zapasów."
                            }
                        }
                    ],
                    "synonyms": [
