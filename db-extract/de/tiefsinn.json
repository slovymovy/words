                "senses": [
                    {
                        "sense_id": "6b7b875a-54b4-30b2-91e7-454789a82ecc",
                        "entry_id": "fb45f7e8-060d-3d1a-948d-2054023a034d",
                        "glosses": [
                            "Hang zu intensivem, grübelndem Nachdenken"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ba840976-33e0-4d63-af8e-3c10839efc17",
                                "sense_id": "6b7b875a-54b4-30b2-91e7-454789a82ecc",
                                "text": "„Verzweiflung ziemt dem kräftigen Menschen nicht; eben so wenig, in stumpfem Tiefsinn die Hände in den Schoos zu legen.“ (1814)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                        "entry_id": "fb45f7e8-060d-3d1a-948d-2054023a034d",
                        "glosses": [
                            "komplexe, schwierig zu begreifende Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16dff246-a843-45d9-b68c-d6a131ccc759",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„Das ist die Stärke dieses Romans, in dem es wenig Action, dafür viel Tiefsinn gibt. Unbedingt lesenswert.“"
                            },
                            {
                                "example_id": "ee2ea28a-89f1-44ea-b97f-e9e830095516",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„Geblieben ist der Ruf und Vorwurf, viele Philosophen würden allzu häufig Unverständlichkeit als Tiefsinn verkaufen.“"
                            },
                            {
                                "example_id": "9983abd7-e429-47bd-8f64-94b351dea847",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„[Karl] Valentins Sprachspielereien sind nicht immer mit Tiefsinn gewürzt, sondern spiegeln häufig harmlose Alltagssituationen wieder - und sind dann mehr oder minder witzig, wie im Dialog \"Vergeßlich\".“"
                            },
                            {
                                "example_id": "9299c81d-9536-414a-ab35-b6d0955dd3c4",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„»Meiner Meinung nach muss die Musik eines Konzerts leicht und brillant und nicht auf Tiefsinn und dramatische Wirkungen bedacht sein …«“"
                            },
                            {
                                "example_id": "f6de23b4-3fb6-4b0e-9df3-33b21dc27394",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„Die entstandenen elf Stücke [Anmerkung: auf CD] sind zweifellos avantgardistisch, aber sie ertrinken zum Glück nicht im Tiefsinn.“"
                            },
                            {
                                "example_id": "584af060-9c12-40c2-bbff-f6e687522636",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„[…] Mozart [hatte] deshalb Erfolg, weil er anders als zuvor Bach und später Beethoven ohne Bekenntnis, Ethos oder Tiefsinn sein Publikum ansprach und statt auf Formengerüste auf Interaktion setzte.“"
                            },
                            {
                                "example_id": "a266b92b-8a7d-4520-99d7-3de8dfe5f69c",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„In einem Balanceakt zwischen Leichtigkeit und Tiefsinn handelt Regisseurin Eileen Schäfer die Themen Flucht, Identität und Solidarität ab.“"
                            },
                            {
                                "example_id": "68d862a9-bc26-4d95-b75a-9b0ac6fe975c",
                                "sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                                "text": "„Das Drehbuch zu Wim Wenders’ Film ist so hanebüchen, als hätte es ein Fünfzehnjähriger mit der Ambition zu äußerstem Tiefsinn verfasst: Trauer, Schuld, Vergebung, Schriftstellerkrise.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e954f3f2-5ade-4b9a-9f3a-da70e066f95c",
                        "source_entry_id": "fb45f7e8-060d-3d1a-948d-2054023a034d",
                        "source_sense_id": "dc1440c4-311f-383e-8ec3-6b1293de3329",
                        "source_sense_description": "komplexe, schwierig zu begreifende Bedeutung",
                        "target_lang_word": "profundity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profundity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5871e7-8b01-370a-8afd-e32d9a01908e",
                                        "entry_id": "9e20612d-cb1b-31e2-a8d6-2a09c29082d1",
                                        "glosses": [
                                            "The state of being profound; magnitude, gravity, or intensity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc61750-7a0b-4da8-a7fc-6f39298b68eb",
                                                "sense_id": "bd5871e7-8b01-370a-8afd-e32d9a01908e",
                                                "text": "The situation's profundity escaped most observers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61f8a8c-1eb0-343b-9290-f67b44a0e12d",
                                        "entry_id": "9e20612d-cb1b-31e2-a8d6-2a09c29082d1",
                                        "glosses": [
                                            "Deep intellect or insight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ad0d97-c666-4de5-b8d8-433da5c9a5d3",
                                                "sense_id": "b61f8a8c-1eb0-343b-9290-f67b44a0e12d",
                                                "text": "Unfortunately, Andrew's colossal ego means people miss his profundity."
                                            },
                                            {
                                                "example_id": "00974160-f05a-476e-a15d-abe5dfa14835",
                                                "sense_id": "b61f8a8c-1eb0-343b-9290-f67b44a0e12d",
                                                "text": "Also, he had legs which seemed to begin almost at his chest—or, rather, at his chin! Yet, for all his air of peacock-like conceit, his clothes sagged a little, and his face wore a sheepish air which might have passed for profundity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a1776b-3858-3ea3-8d89-92076b6f0876",
                                        "entry_id": "9e20612d-cb1b-31e2-a8d6-2a09c29082d1",
                                        "glosses": [
                                            "A great depth; a deep place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93bfb696-f69c-4d1b-9a0c-cd34bd739051",
                                                "sense_id": "83a1776b-3858-3ea3-8d89-92076b6f0876",
                                                "text": "I delved the abyssal profundities of Neptune's realm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "708752db-bcb7-3c9c-bacc-6c36704beedb",
                                        "entry_id": "9e20612d-cb1b-31e2-a8d6-2a09c29082d1",
                                        "glosses": [
                                            "Depth; the state of possessing great downwards extent."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
