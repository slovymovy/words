                        "source_entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "source_sense_description": "tribunal of the Roman Catholic Church",
                        "target_lang_word": "Ketzergericht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
