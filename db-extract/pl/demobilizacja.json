                                "target_senses": [
                                    {
                                        "sense_id": "2af35db6-a1e3-3337-a039-3c9cdee553cc",
                                        "entry_id": "1acf7bc0-150e-3d8b-bdea-534a6579f529",
                                        "glosses": [
                                            "The disorganization or disarming of troops which have previously been mobilized or called into active service; the change from a war footing to a peace footing; the act of demobilizing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d2c8dec-2160-4377-91ea-c4f3b613d239",
                        "source_entry_id": "9ee7b896-bd01-34a1-84c7-1fdaf04db83e",
                        "source_sense_id": "a55adf28-3d44-32a7-9b89-945037e21353",
                        "target_lang_word": "démobilisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démobilisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42d326e9-32f4-3d25-b9c2-bf3f148e25d3",
                                        "entry_id": "0c505165-0325-3a96-a06f-d8aa212528fd",
                                        "glosses": [
                                            "Renvoi chez eux des hommes que l’on a mobilisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05280392-8ca8-4602-9998-c1b1d06d83aa",
                                                "sense_id": "42d326e9-32f4-3d25-b9c2-bf3f148e25d3",
                                                "text": "À partir du jour de la mobilisation jusqu'au jour de la démobilisation."
                                            },
                                            {
                                                "example_id": "7445421a-2495-45b5-a86c-e087473bf351",
                                                "sense_id": "42d326e9-32f4-3d25-b9c2-bf3f148e25d3",
                                                "text": "À la fin de la Deuxième Guerre mondiale, Douglas Abbott — qui avait remplacé Angus L. Macdonald au poste de ministre de la Défense nationale pour la Marine en avril 1945, puis le Général Andrew McNaughton au poste de ministre de la Défense nationale en août—avait pour tâche principale la démobilisation de la plus grande force maritime, terrestre et aérienne de toute l’histoire du Canada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c750ad27-736d-4850-9fd8-991129dee489",
                        "source_entry_id": "9ee7b896-bd01-34a1-84c7-1fdaf04db83e",
                        "source_sense_id": "a55adf28-3d44-32a7-9b89-945037e21353",
                        "target_lang_word": "desmovilización",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desmovilización",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d14c56bf-df68-355c-b579-f3a350efee36",
                                        "entry_id": "3b2b45c7-1d48-37b5-a780-70a234a8c7c9",
