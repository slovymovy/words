                    "sense_definition": "Goods or items that have recently been bought.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I carried three heavy bags of <w>shopping</w> up the stairs.",
                            "target_lang_translations": {
                                "ru": "Я занёс три тяжёлых пакета с <w>покупками</w> вверх по лестнице.",
                                "zh": "我提着三大袋<w>买的东西</w>上了楼。"
                            }
                        },
                        {
                            "text": "Please help me unpack the <w>shopping</w> from the car.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помоги мне выгрузить <w>покупки</w> из машины.",
                                "zh": "请帮我把车里的<w>采购品</w>拿出来。"
                            }
                        }
                    ],
