                        "sense_id": "e6d343bc-5b58-3f03-9ba5-3e69e94d899d",
                        "entry_id": "b375ae19-a80c-39fc-b0f2-03e07b896b0b",
                        "glosses": [
                            "Alternative spelling of medieval."
                        ],
                        "tags": [
                            "Commonwealth",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "86575648-47a1-4e41-9c7d-7a5ff4fd38b3",
                                "sense_id": "e6d343bc-5b58-3f03-9ba5-3e69e94d899d",
                                "text": "Standing on the mountain above Caerphilly, one may reflect upon the gap where once stood Llanbradach Viaduct, and look near at hand upon the restored ruins of Caerphilly Castle; man labours to rebuild the mediaeval whilst he ruthlessly scraps the modern."
                            },
                            {
                                "example_id": "9e71702e-1893-4290-aacf-796bd20e3aad",
                                "sense_id": "e6d343bc-5b58-3f03-9ba5-3e69e94d899d",
                                "text": "The earliest known example of a partial rider is the Talia (meaning scout) which occurs in the Great Chess of Timur. It is a transition piece between the mediaeval alfil and the modern bishop, able to move like the bishop without being blocked by a pawn standing in front of it."
                            }
                        ]
                    }
                ],
