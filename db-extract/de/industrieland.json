                ],
                "senses": [
                    {
                        "sense_id": "1cdf0125-f7b0-388c-9574-dde2dde1876b",
                        "entry_id": "97c91819-2468-3445-b85e-1a6fa812b910",
                        "glosses": [
                            "hoch entwickeltes Land mit viel Industriewirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d20714-3279-4dc5-b7d6-1f898cb04594",
                                "sense_id": "1cdf0125-f7b0-388c-9574-dde2dde1876b",
                                "text": "„In kaum einem anderen Industrieland bestimmen Einkommen und Bildung der Eltern so sehr über die Zukunftschancen von Kindern wie in Deutschland.“"
                            },
                            {
                                "example_id": "7e351a48-f1eb-4557-aa19-99a4e3ee52d2",
                                "sense_id": "1cdf0125-f7b0-388c-9574-dde2dde1876b",
                                "text": "„Man kann darüber streiten, ob die größere Macht der Industrieländer gegenüber den Entwicklungsländern eine Folge der Globalisierung ist.“"
                            },
                            {
                                "example_id": "a27aa82b-3e6e-4685-8b4b-27dfa27b9c7a",
                                "sense_id": "1cdf0125-f7b0-388c-9574-dde2dde1876b",
                                "text": "„In den Industrieländern hat sich die Agrarstruktur in den letzten Jahrzehnten erheblich gewandelt.“"
                            },
                            {
                                "example_id": "be63d9f7-3a56-4cea-8a97-ba031cecca27",
                                "sense_id": "1cdf0125-f7b0-388c-9574-dde2dde1876b",
                                "text": "„In seinem Bestseller „Rückkehr nach Reims“ beschreibt Eribon am Beispiel seiner eigenen Familie die Entfremdung des Proletariats von der politischen Linken und ihre Hinwendung zur extremen Rechten. Eine Entwicklung, die in allen Industrieländern zu beobachten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
