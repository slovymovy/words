        "fr-extract.jsonl": [
            {
                "entry_id": "ddf07bc2-cb4b-3f4b-b005-97a7dbe6b3f4",
                "word": "Géronte",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f52cdb52-b480-3aac-ad1a-a7fe00e47a51",
                        "entry_id": "ddf07bc2-cb4b-3f4b-b005-97a7dbe6b3f4",
                        "glosses": [
                            "Personnage de vieillard dans diverses littératures."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0eba7f17-902b-4cda-8550-d19a50bd7df3",
                                "sense_id": "f52cdb52-b480-3aac-ad1a-a7fe00e47a51",
                                "text": "Ce qui me blesse les yeux, quant à moi, vocifère Coselli, ce qui me blesse les yeux, c'est votre louche nombril, votre ombilic obscène, la peau de tambour moisie de votre bedaine, votre exhibitionnisme sénile, Géronte de la galonnaille, Ratapoil de fête nationale, bubon du chancre militaire."
                            },
                            {
                                "example_id": "ecaf7e46-5399-4831-9196-1e77ac80187f",
                                "sense_id": "f52cdb52-b480-3aac-ad1a-a7fe00e47a51",
                                "text": "La première fois il serait venu demander grâce ; mais la crainte d’un mauvais accueil l’aurait fait sortir avant l’arrivée de Géronte."
                            },
                            {
                                "example_id": "56b966b1-5195-43c2-bf40-b880fadbae92",
                                "sense_id": "f52cdb52-b480-3aac-ad1a-a7fe00e47a51",
                                "text": "Sa gaieté, quand il m’avait vu lui donnant débonnairement une somme si énorme, me parut alors être la joie des valets de théâtre attrapant quelque Géronte."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                "word": "géronte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b35c43e8-ff6c-4f88-91fd-515d7b50b927",
                        "entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                        "tags": [
                            "plural"
                        ],
