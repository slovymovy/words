                    {
                        "sense_id": "096fdfe4-d7a1-3d18-97e1-583ebd260594",
                        "entry_id": "056b4f2b-ac27-340f-a879-801c7b0df988",
                        "glosses": [
                            "Outil à deux faces, servant à la fois de hache ou de cognée, et de pioche ou de pic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90aa39b5-7b57-4dcb-9d5c-e08e62f42f0c",
                                "sense_id": "096fdfe4-d7a1-3d18-97e1-583ebd260594",
                                "text": "La dolabre est sans doute l'outil le plus célèbre du légionnaire romain. A la fois hache et pioche, il sert à l'édification des retranchements, mais peut aussi, occasionnellement, servir d'arme. Une gaine en laiton, articulée et décorée de pendants permet de protéger le tranchant de la lame."
                            },
                            {
                                "example_id": "6eec126b-e5fe-4296-8293-7d6f51d6e287",
                                "sense_id": "096fdfe4-d7a1-3d18-97e1-583ebd260594",
                                "text": "Cet artisan porte une dolabre avec laquelle il aplatit le bois et les métaux."
                            },
                            {
                                "example_id": "ed3589f5-1725-4dc0-bd0a-53092da59298",
                                "sense_id": "096fdfe4-d7a1-3d18-97e1-583ebd260594",
                                "text": "Saint-Médard-des-Prés a fourni aussi à l'archéologue une très belle dolabre, instrument de sacrifice chez les Druides."
                            },
                            {
                                "example_id": "f0caafa1-bae3-4fab-88d5-4ec52ff8460b",
                                "sense_id": "096fdfe4-d7a1-3d18-97e1-583ebd260594",
                                "text": "Une pioche et une bêche ou une dolabre conviennent également à cette tâche."
                            }
                        ]
                    }
                ],
