                "translations": [
                    {
                        "translation_id": "fd529d09-9098-4a98-bfd6-afabd7e231cf",
                        "source_entry_id": "4dcb8a48-6738-3f03-bd95-3f6005ad977b",
                        "source_sense_id": "f1093890-f870-3415-9b3c-4360bd351c76",
                        "source_sense_description": "to make the cry of a deer",
                        "target_lang_word": "bramer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bramer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "262ffbb2-00a3-3d41-b317-33695d5045ba",
                                        "entry_id": "95e3546b-9203-3950-a6ba-33ca5d0a1898",
                                        "glosses": [
                                            "Crier en parlant du cerf, du chevreuil, du daim, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf56a67c-ff84-42d3-b017-71d54d207d4f",
                                                "sense_id": "262ffbb2-00a3-3d41-b317-33695d5045ba",
                                                "text": "Le cerf brame."
                                            },
                                            {
                                                "example_id": "e639f215-3433-4497-8bac-63c3468ad041",
                                                "sense_id": "262ffbb2-00a3-3d41-b317-33695d5045ba",
                                                "text": "La biche brame au clair de lune\nEt pleure à se fondre les yeux"
                                            },
                                            {
                                                "example_id": "ff4c9e04-d919-4d66-b77f-7c4a2b467940",
                                                "sense_id": "262ffbb2-00a3-3d41-b317-33695d5045ba",
                                                "text": "Comme le cerf dompté qui brame dans les rets,\nTu gémis, enlacé d’enchantements magiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24540f4c-793a-318f-8765-2fec5ea68185",
                                        "entry_id": "95e3546b-9203-3950-a6ba-33ca5d0a1898",
                                        "glosses": [
                                            "Crier ; hurler."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54de7b31-4980-4c10-a2e0-e7a1e731b840",
                                                "sense_id": "24540f4c-793a-318f-8765-2fec5ea68185",
                                                "text": "Grognements, soupirs, abois, ronflements, plaintes, sifflements, toux, bêlements, hennissements, murmures bramés, choc de sabots, claquement de mâchoires, sonnailles de clochettes, cliquetis de mors, composaient en sourdine une incessante, profonde et commune rumeur, à demi animale et humaine à demi."
                                            },
                                            {
                                                "example_id": "49f05ca6-161a-4e6a-bdea-222b1dc7b76c",
                                                "sense_id": "24540f4c-793a-318f-8765-2fec5ea68185",
                                                "text": "À l'autre bout de la ligne, le boulanger de Bazoches-les-Gallerandes en rajoute… Il se nomme Capdebosc ! il brame. Depuis sa cagna sous les balles, il hue l'autorité. Il brandit le drapeau noir ! En même temps, il nargue la sifflante."
                                            },
                                            {
                                                "example_id": "e8acb11b-7e3a-4411-b93b-411e0aead60a",
                                                "sense_id": "24540f4c-793a-318f-8765-2fec5ea68185",
                                                "text": "Emploi transitif ː Il tournait sa grosse tête rougeaude vers un Puutz survolté qui bramait des ordres confus,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03476479-7d1d-3481-bf67-3865df3c672d",
                                        "entry_id": "95e3546b-9203-3950-a6ba-33ca5d0a1898",
                                        "glosses": [
                                            "Chanter fort et mal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5069248d-9872-4e37-b0a0-4c235712e8af",
                                                "sense_id": "03476479-7d1d-3481-bf67-3865df3c672d",
                                                "text": "Le chanteur des rues qui brame :\n« À vot’ bon cœur, messieurs-dames »\nParis sera toujours Paname\nEt tout ça ne vaut pas l’amour."
                                            },
                                            {
                                                "example_id": "c9a3cbd7-642c-4235-92cb-b3aa32d44905",
                                                "sense_id": "03476479-7d1d-3481-bf67-3865df3c672d",
                                                "text": "Un opéra, ça finit toujours par un mec qui brame pendant une plombe qu’il est clamsé."
                                            },
                                            {
                                                "example_id": "124c29dc-6f0c-40dc-8128-6c2b3e7160ba",
                                                "sense_id": "03476479-7d1d-3481-bf67-3865df3c672d",
                                                "text": "Ils bramèrent longtemps autour d’une sombre lampe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "008c4f8f-3d80-30fb-94c2-8817cbe6027c",
                                        "entry_id": "95e3546b-9203-3950-a6ba-33ca5d0a1898",
                                        "glosses": [
                                            "Pleurer."
                                        ],
                                        "tags": [
                                            "Occitanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d3f1da-0e37-493e-a632-4711c87632b5",
                                                "sense_id": "008c4f8f-3d80-30fb-94c2-8817cbe6027c",
                                                "text": "Je lui ai dit ses quatre vérités et elle s’est mise à bramer."
                                            },
                                            {
                                                "example_id": "5e68de2f-ed91-4772-87dd-d81921cf9b81",
                                                "sense_id": "008c4f8f-3d80-30fb-94c2-8817cbe6027c",
                                                "text": "Arrête de bramer !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9baa8cd6-c562-4cf7-9346-dfb41275c363",
