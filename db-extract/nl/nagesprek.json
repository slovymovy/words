                "senses": [
                    {
                        "sense_id": "de40742e-a6ed-3073-a773-67d4f77b56d2",
                        "entry_id": "d79c51a4-7aa8-314b-83e1-943d04b25673",
                        "glosses": [
                            "na afloop van een evenement of voorstelling met elkaar praten over wat men gezien en gehoord heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ca0ace-5251-44f0-8e7d-d20fcbfdf5b9",
                                "sense_id": "de40742e-a6ed-3073-a773-67d4f77b56d2",
                                "text": "Waarom niet voor bepaalde diensten een deel van de buurtbewoners persoonlijk uitnodigen? En die buren vragen om een voor- en een nagesprek? Want weten ze eigenlijk wel wat er in de kerkdiensten gebeurt?"
                            },
                            {
                                "example_id": "febb55df-2707-4832-a306-cf01d7bccfe4",
                                "sense_id": "de40742e-a6ed-3073-a773-67d4f77b56d2",
                                "text": "Voor zijn documentaire sprak Alink met mensen die dicht bij hem stonden en kreeg hij de beschikking over niet eerder vertoond filmmateriaal. Zijn documentaire is op het IDFA-festival genomineerd in twee categorieën: Nederlandse documentaires en muziekdocumentaires. Op 12 maart 2017 is de documentaire, inclusief nagesprek met regisseur Alink, te zien in het Filmhuis Oldenzaal."
                            },
                            {
                                "example_id": "2dc136a3-d37d-4387-a62b-cb8f85973a5b",
                                "sense_id": "de40742e-a6ed-3073-a773-67d4f77b56d2",
                                "text": "Mogen jullie zelf bepalen in welk stuk jullie spelen en welke rol jullie kiezen?\", vraagt een man in driedelig pak tijdens een nagesprek na afloop van Husbands and Wives."
                            }
                        ]
                    }
                ],
