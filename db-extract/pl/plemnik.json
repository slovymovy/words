                "translations": [
                    {
                        "translation_id": "e7ad9644-ac46-4e7e-a08a-65824563aafe",
                        "source_entry_id": "bd70af1c-97bc-3a4e-aeab-b190e7e13e57",
                        "source_sense_id": "f1f81984-0b25-39a6-b194-f692f2580327",
                        "target_lang_word": "spermatozoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spermatozoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                        "entry_id": "403feb77-8f44-392b-9f72-8135994ce786",
                                        "glosses": [
                                            "A reproductive cell or gamete of a male, carried in semen, that fertilizes an ovum to produce a zygote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14585a1f-391f-4213-b5af-6cac7a8742d5",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "But let us suppose [...] that one hardy or lucky spermatozoon has reached the waiting egg."
                                            },
                                            {
                                                "example_id": "abf492ab-51a1-413e-b7a9-cddcb0bbcff7",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "A sperm, or spermatozoa, is the microscopic male reproductive cell. Sperms are made up of oval-shaped heads and long tails that they use for mobility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27527b68-f462-43d0-8eec-2b4d04f11ea5",
                        "source_entry_id": "bd70af1c-97bc-3a4e-aeab-b190e7e13e57",
                        "source_sense_id": "f1f81984-0b25-39a6-b194-f692f2580327",
                        "target_lang_word": "sperm cell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sperm cell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f45877b6-bb4c-3ffe-9ddf-63da658af884",
                                        "entry_id": "78e3756e-6b38-334b-8931-3eaa74f6c691",
                                        "glosses": [
                                            "Sperm; spermatozoon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd2f0a03-bfa3-462f-a174-b6d635cdc280",
                        "source_entry_id": "bd70af1c-97bc-3a4e-aeab-b190e7e13e57",
                        "source_sense_id": "f1f81984-0b25-39a6-b194-f692f2580327",
                        "target_lang_word": "spermie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spermie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "502ab887-67ba-3999-b3f0-f5fd4e6eb7dc",
                                        "entry_id": "eec0f39f-8e62-3a60-8faa-e8d7f9835a10",
                                        "glosses": [
                                            "samčí (mužská) pohlavní buňka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda605a9-6140-458b-a22b-3b452720e30c",
                                                "sense_id": "502ab887-67ba-3999-b3f0-f5fd4e6eb7dc",
                                                "text": "Jen jedna spermie oplodní vajíčko – ostatní zahynou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7fce5c7-5549-42b1-b59b-6f1e8a91566a",
                        "source_entry_id": "bd70af1c-97bc-3a4e-aeab-b190e7e13e57",
                        "source_sense_id": "f1f81984-0b25-39a6-b194-f692f2580327",
                        "target_lang_word": "spermatozoïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spermatozoïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66034765-eff8-3832-a112-07a0b4a0d6a7",
                                        "entry_id": "0b2c1f2a-8adf-3ebf-8774-40c2e5a404f5",
                                        "glosses": [
                                            "Cellule haploïde sexuelle produite par le mâle contenant la moitié des chromosomes du futur embryon."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba18447f-bc80-4a24-9959-073ca46a2e67",
                                                "sense_id": "66034765-eff8-3832-a112-07a0b4a0d6a7",
                                                "text": "La multitude fusait en tous sens, évoquant, vue des toits, soit un grouillement mou d’amibes, soit tout un charleston de spermatozoïdes pressés de faire mouche."
                                            },
                                            {
                                                "example_id": "9d1ea55a-92a7-4f96-85fb-205b40cd0b86",
                                                "sense_id": "66034765-eff8-3832-a112-07a0b4a0d6a7",
                                                "text": "C’est d’ailleurs la raison pour laquelle il est tout à fait possible de micro-injecter un spermatozoïde provenant aussi bien du testicule où il aura été prélevé chirurgicalement que de l’éjaculat."
                                            },
                                            {
                                                "example_id": "395446b5-4f70-4f61-a360-19eb7d704c01",
                                                "sense_id": "66034765-eff8-3832-a112-07a0b4a0d6a7",
                                                "text": "Que se passe-t-il lors d’une reproduction sexuée naturelle? Chez l’homme et les mammifères, la reproduction sexuée ordinaire nécessite la rencontre entre deux cellules sexuelles, le gamète mâle ou spermatozoïde, et le gamète femelle, l’ovocyte souvent appelé par abus de langage ovule."
                                            },
                                            {
                                                "example_id": "b7f72284-4fca-4f00-b2a6-1e4d6a642d42",
                                                "sense_id": "66034765-eff8-3832-a112-07a0b4a0d6a7",
                                                "text": "J'ai conservé un peu du tempérament du spermatozoïde que je fus il y a un peu plus de quatre-vingt-sept ans, agité, fébrile, le flagelle toujours en branle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "206aa07e-84d0-4f1c-a24f-6f264a82765f",
                        "source_entry_id": "bd70af1c-97bc-3a4e-aeab-b190e7e13e57",
                        "source_sense_id": "f1f81984-0b25-39a6-b194-f692f2580327",
                        "target_lang_word": "espermatozoide",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espermatozoide",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7e358c-abef-3dfc-84c2-bbc89664cd5a",
                                        "entry_id": "67522cfd-9201-33ff-acbb-adcc7f7a60e7",
                                        "glosses": [
                                            "Célula haploide que constituye la célula sexual masculina que al fusionarse con el óvulo durante la fecundación forma un nuevo individuo. Los espermatozoides se forman en el interior de los testículos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
