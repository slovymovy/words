                                        "entry_id": "6cff4ebb-a84c-342e-bc76-a66674debd7b",
                                        "glosses": [
                                            "Exceptionally great."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ba2823-2245-4e48-9cc7-f179cd43e5c4",
                                                "sense_id": "0d48c0de-026d-33b9-a43a-0173c52a350f",
                                                "text": "Young Dutch keeper Tim Krul saw his value rocket up with a sensational display."
