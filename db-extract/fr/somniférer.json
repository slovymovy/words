                ],
                "senses": [
                    {
                        "sense_id": "ed4b6983-e6f1-3b41-af47-c3c87bd485ea",
                        "entry_id": "af19775b-ed10-3043-8248-27c5eba3699d",
                        "glosses": [
                            "Endormir."
                        ],
                        "tags": [
                            "ironic",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "5295e915-fbca-4715-87a8-475e027d0f79",
                                "sense_id": "ed4b6983-e6f1-3b41-af47-c3c87bd485ea",
                                "text": "Rien de mieux que de mettre en place une commission et une demande de rapport quand on veut «somniférer» des opposants.."
                            },
                            {
                                "example_id": "a1bd9235-af25-49bf-85ac-1f0780158562",
                                "sense_id": "ed4b6983-e6f1-3b41-af47-c3c87bd485ea",
                                "text": "Donc, je commen[s]e par ça, histoire de pas vous somniférer avec des pages et des pages."
                            }
                        ]
                    },
                    {
                        "sense_id": "a741bb0c-7c53-3862-bfa0-518e9b81229c",
                        "entry_id": "af19775b-ed10-3043-8248-27c5eba3699d",
                        "glosses": [
                            "Droguer, faire prendre des somnifères."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "ccb48765-867e-4b31-9119-b6ac0b441526",
                                "sense_id": "a741bb0c-7c53-3862-bfa0-518e9b81229c",
                                "text": "Et Barracuda avec sa trouille des avions et qu’il fallait assommer ou «somniférer» à chaque fois qu’il fallait monter en hélico"
                            },
                            {
                                "example_id": "e596de0d-7304-4b60-8080-8ac52fe9e5e2",
                                "sense_id": "a741bb0c-7c53-3862-bfa0-518e9b81229c",
                                "text": "Tu vas somniférer Julien?? J’espère vraiment que ton instinct va vite reprendre le dessus et que tu vas vite oublier les conneries de ton pédiatre et meme en changer!"
                            }
                        ]
                    },
