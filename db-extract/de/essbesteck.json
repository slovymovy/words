                "senses": [
                    {
                        "sense_id": "f85a8f4d-a1c5-30ac-bfec-e1483b71b465",
                        "entry_id": "6470c928-6512-32cf-acc6-083bde5d20df",
                        "glosses": [
                            "Besteck, das zur Nahrungsaufnahme dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89011d1-d32a-4d80-bf3b-31393ebfc55d",
                                "sense_id": "f85a8f4d-a1c5-30ac-bfec-e1483b71b465",
                                "text": "„Ab dem 18. Jahrhundert wurde das Messer zum wichtigsten Teil des Essbestecks und entwickelte sich im Laufe der Zeit zusätzlich zum Schmuck- und Kunstgegenstand sowie Tauschobjekt und sogar Zahlungsmittel.“"
                            },
                            {
                                "example_id": "98dd033c-22c1-477c-a82e-963152e9ad78",
                                "sense_id": "f85a8f4d-a1c5-30ac-bfec-e1483b71b465",
                                "text": "„Als Essbesteck kommt sie erst in der frühen Neuzeit auf, wo man am französischen Hof gern klebriges Obst aß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
