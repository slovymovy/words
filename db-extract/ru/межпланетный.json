                                    {
                                        "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                        "entry_id": "19bd8e48-ad7e-3973-b739-342d99a6bee8",
                                        "glosses": [
                                            "Existing or occurring between planets."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42d67778-3d8d-4de3-ac90-ea079496f1dd",
                                                "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                                "text": "Humans are just beginning to explore interplanetary travel."
                                            },
                                            {
                                                "example_id": "34dc8298-a1c6-4309-b394-7edee24f5f0e",
                                                "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                                "text": "\"Come, Diana [a dog],\" said he; \"come, my girl! thou whose destiny will be marked in the cynegetic annals; […] thou who art rushing into interplanetary space, and wilt perhaps be the Eve of all Selenite dogs! come, Diana, come here.\""
                                            },
                                            {
                                                "example_id": "dfe754e0-c023-4a2d-818d-b117a55336c8",
                                                "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                                "text": "Him and me, we kind of got to toasting each others good health. Just for cordial interplanetary relations you understand."
                                            },
                                            {
                                                "example_id": "9cb5a8f5-2242-488c-bd91-1c873fe0d11b",
                                                "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                                "text": "Calling occupants of interplanetary craft / Calling occupants of interplanetary / Most extraordinary craft / We've been observing your Earth / And one night we'll make a contact with you"
                                            },
                                            {
                                                "example_id": "168ae6e6-d183-427a-9e77-bafb6eb98a18",
                                                "sense_id": "1f556964-efc6-3c93-83d8-17e6c571dc79",
                                                "text": "This is the return of the space cowboy / Interplanetary good vibe zone"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
