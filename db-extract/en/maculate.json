                    {
                        "translation_id": "091afbfe-726c-4cfa-b3e7-2d9cd4dbb168",
                        "source_entry_id": "29ba9e74-0da6-3c49-8661-69f06854d0d3",
                        "source_sense_description": "Defiled; impure",
                        "target_lang_word": "impur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6cbbab-6834-3412-9aeb-8bdec61d4005",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Qui n’est pas pur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5216660-ed6c-4132-9fe1-400422cceea5",
                                                "sense_id": "9b6cbbab-6834-3412-9aeb-8bdec61d4005",
                                                "text": "La houille est généralement assez impure et contient des pyrites et des matières argileuses qui agissent d'une manière fâcheuse dans plusieurs opérations industrielles."
                                            },
                                            {
                                                "example_id": "b165d6c2-f275-4c03-8cd1-557b392dd7d3",
                                                "sense_id": "9b6cbbab-6834-3412-9aeb-8bdec61d4005",
                                                "text": "Dans son rapport annuel 2016, la Cour des comptes ce système d’huiles impures comptant double, responsable de « fraudes massives »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e7112f7-53f4-3e16-b2d4-c466a4f3605b",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Qui a une impureté religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0236cc65-7b1a-451c-90de-1de4aac53846",
                                                "sense_id": "0e7112f7-53f4-3e16-b2d4-c466a4f3605b",
                                                "text": "Je suis persuadé, selon la doctrine du Seigneur Jésus, que rien n'est impur de soi-même, et qu’il n'est impur qu’à celui qui le croit impur."
                                            },
                                            {
                                                "example_id": "85eb2841-1aa4-42a6-9ea7-8bf909acb658",
                                                "sense_id": "0e7112f7-53f4-3e16-b2d4-c466a4f3605b",
                                                "text": "Mon père, en ce jour solennel,\nDe l’idolâtre impur fuit l’aspect criminel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3dc366e-5250-3ddc-8a38-52a57dcd0182",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Qualifie, selon certaines règles religieuses, une femme lors de ses menstruations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5d1156-8a7c-4303-9645-b5672ecd1ed1",
                                                "sense_id": "e3dc366e-5250-3ddc-8a38-52a57dcd0182",
                                                "text": "– C’est la tradition ici. Chaque mois, quand la femme est impure, son mari la chasse de la maison, pour bien montrer à tous qu’il ne l’a pas approchée ; elle va s’installer dans la rue, sous un appentis, pour une semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "074e51ea-e49d-30b3-be8d-2179f38d694b",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Qui a une impureté morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06f08b1-40e8-452e-b47d-2fa0828920b1",
                                                "sense_id": "074e51ea-e49d-30b3-be8d-2179f38d694b",
                                                "text": "Sion, repaire affreux de reptiles impurs."
                                            },
                                            {
                                                "example_id": "2f8d062b-bbe5-47b0-980b-c0b16695ad13",
                                                "sense_id": "074e51ea-e49d-30b3-be8d-2179f38d694b",
                                                "text": "Reste impur des brigands dont j’ai purgé la terre."
                                            },
                                            {
                                                "example_id": "2f78eecc-d6c1-4010-b081-38dd93d8daac",
                                                "sense_id": "074e51ea-e49d-30b3-be8d-2179f38d694b",
                                                "text": "Quel chemin peut conduire à cette cour impure,à ce séjour de crime où j’ai reçu le jour ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb81735-c8f4-361c-aa4d-9dd0f2461e5e",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Les esprits impurs, les démons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0336b3d8-f464-4810-92f9-1ae875b0e9c4",
                                                "sense_id": "cbb81735-c8f4-361c-aa4d-9dd0f2461e5e",
                                                "text": "Tous ces impurs esprits qui troublent l’univers, Et le feu de la foudre et celui des enfers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da0127d-8bb9-300f-8be8-a6415a804f23",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Il se dit aussi des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190512c6-023e-4ac6-b03c-f59b073e8c13",
                                                "sense_id": "1da0127d-8bb9-300f-8be8-a6415a804f23",
                                                "text": "Le meurtrier du roi respire en ces États,\nEt de son souffle impur infecte nos climats."
                                            },
                                            {
                                                "example_id": "fbfd2984-a06f-41d9-9399-220f4617bef3",
                                                "sense_id": "1da0127d-8bb9-300f-8be8-a6415a804f23",
                                                "text": "Loin de ce médisant infâme,\nQui de l’imposture et du blâme\nEst l’impur et bruyant écho."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b878cbf2-cddd-3212-a2ca-275a9baab668",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Être né d’un sang impur, être né de parents malhonnêtes, déshonorés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6432886-105c-3e14-adb2-135c51b3040a",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "On dit dans le même sens : une race impure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d812aa3c-6be1-4952-bbcb-003176aa7dde",
                                                "sense_id": "c6432886-105c-3e14-adb2-135c51b3040a",
                                                "text": "Cette Esther, l’innocence et la sagesse même,\nDans cette source impure aurait puisé ses jours !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                        "entry_id": "69482047-ff15-3c3d-bab1-0122fdc6cff5",
                                        "glosses": [
                                            "Impudique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ac8013-9647-4eb0-abba-95572cbb2fd1",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Une femme impure."
                                            },
                                            {
                                                "example_id": "2829c4b4-57d2-44db-a2bd-a9dc653adccb",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Pensées impures."
                                            },
                                            {
                                                "example_id": "a750d127-31d7-4c08-be02-72f0126e5d0c",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Des mœurs impures."
                                            },
                                            {
                                                "example_id": "cb0356e6-3ad7-4f35-9449-6ad09050fc43",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Du moindre sens impur la liberté l’outrage, Si la pudeur des mots n’en adoucit l’image."
                                            },
                                            {
                                                "example_id": "05d4c306-ef8c-4645-90c5-547718fb603e",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Pour les fables païennes, une fille sera heureuse de les ignorer toute sa vie, à cause qu’elles sont impures et pleines d’absurdités impies."
                                            },
                                            {
                                                "example_id": "a606d242-ba3b-4f8e-a69d-3e931fbabaab",
                                                "sense_id": "3997eb9f-a6fc-3367-aa58-0aad8587d02d",
                                                "text": "Les étincelles impures qui allumèrent son cœur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62a55eb2-885a-3247-a70f-62e4c2bf80cd",
                                        "entry_id": "8fdfcb1e-6e43-3789-8eb9-49b51f63fe05",
                                        "glosses": [
                                            "Ce qui est moralement impur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd96194d-f859-4783-9dab-b20efd806569",
                                                "sense_id": "62a55eb2-885a-3247-a70f-62e4c2bf80cd",
                                                "text": "Par là de tout l’impur la souillure s'efface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
