                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Depress</w> the button to start the machine.",
                            "target_lang_translations": {
                                "ru": "<w>Нажмите</w> кнопку, чтобы запустить машину.",
                                "nl": "<w>Druk</w> de knop <w>in</w> om de machine te starten.",
                                "pl": "<w>Naciśnij</w> przycisk, aby uruchomić maszynę.",
                                "de": "<w>Drücken</w> Sie den Knopf, um die Maschine zu starten.",
                                "fr": "<w>Appuyez sur</w> le bouton pour démarrer la machine.",
                                "it": "<w>Premi</w> il pulsante per avviare la macchina.",
                                "cs": "Pro spuštění stroje <w>stiskněte</w> tlačítko.",
                                "tr": "Makineyi çalıştırmak için düğmeye <w>basın</w>.",
                                "es": "<w>Presione</w> el botón para encender la máquina.",
                                "zh": "<w>按下</w>按钮即可启动机器。"
                            }
                        },
                        {
                            "text": "You must <w>depress</w> the lever firmly to release the lock.",
                            "target_lang_translations": {
                                "ru": "Вы должны сильно <w>нажать</w> на рычаг, чтобы открыть замок.",
                                "nl": "Je moet de hendel stevig <w>indrukken</w> om het slot te ontgrendelen.",
                                "pl": "Musisz mocno <w>wcisnąć</w> dźwignię, aby zwolnić blokadę.",
                                "de": "Sie müssen den Hebel fest <w>herunterdrücken</w>, um die Sperre zu lösen.",
                                "fr": "Vous devez <w>appuyer fermement sur</w> le levier pour débloquer le verrou.",
                                "it": "Devi <w>abbassare</w> la leva con decisione per sbloccare la serratura.",
                                "cs": "Abyste uvolnili zámek, musíte páku pevně <w>zmáčknout</w>.",
                                "tr": "Kilidi açmak için kola sıkıca <w>bastırmalısınız</w>.",
                                "es": "Debe <w>presionar</w> la palanca firmemente para liberar el seguro.",
                                "zh": "你必须用力<w>压下</w>杠杆才能解开锁。"
                            }
                        }
