{
    "word_family": [
        "недостаточный",
        "недостаточность",
        "недоставать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88dc207f-93c5-3e39-abdb-f52b7aa35dfd",
                    "sense_definition": "Нехватка, отсутствие или слишком малое количество чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы не можем закончить проект вовремя, так как ощущаем острый <w>недостаток</w> времени.",
                            "target_lang_translations": {
                                "en": "We cannot finish the project on time because we feel an acute <w>lack</w> of time.",
                                "de": "Wir können das Projekt nicht rechtzeitig beenden, da wir einen akuten <w>Mangel</w> an Zeit spüren."
                            }
                        },
                        {
                            "text": "Врач сказал, что у пациента наблюдается <w>недостаток</w> железа в крови.",
                            "target_lang_translations": {
                                "en": "The doctor said that the patient has an iron <w>deficiency</w> in their blood.",
                                "de": "Der Arzt sagte, dass der Patient einen Eisen<w>mangel</w> im Blut hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "нехватка",
                        "дефици́т",
                        "отсутствие"
                    ],
                    "antonyms": [
                        "избыток",
                        "достаток"
                    ],
                    "common_phrases": [
                        "недостаток времени",
                        "недостаток средств",
                        "недостаток опыта",
                        "ощущать недостаток",
                        "восполнить недостаток"
                    ],
                    "target_lang_definitions": {
                        "en": "A lack, absence, or insufficient amount of something.",
                        "de": "Ein Mangel, das Fehlen oder eine unzureichende Menge von etwas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lack",
                                "target_lang_sense_clarification": "general absence or insufficiency"
                            },
                            {
                                "target_lang_word": "deficiency",
                                "target_lang_sense_clarification": "medical or nutritional insufficiency"
                            },
                            {
                                "target_lang_word": "shortage",
                                "target_lang_sense_clarification": "insufficient supply of resources"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mangel",
                                "target_lang_sense_clarification": "allgemeines Fehlen oder unzureichende Menge"
                            },
                            {
                                "target_lang_word": "Defizit",
                                "target_lang_sense_clarification": "Fehlbetrag oder Mangel in der Bilanz/Gesundheit"
                            },
                            {
                                "target_lang_word": "Knappheit",
                                "target_lang_sense_clarification": "unzureichendes Angebot an Ressourcen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46075d93-a996-3ecb-b449-48a8ca7c4a26",
                    "sense_definition": "Нежелательное качество, изъян в характере или предмете.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У каждого человека есть свои достоинства и <w>недостатки</w>, которые делают его уникальным.",
                            "target_lang_translations": {
                                "en": "Every person has their virtues and <w>flaws</w>, which make them unique.",
                                "de": "Jeder Mensch hat seine Stärken und <w>Schwächen</w>, die ihn einzigartig machen."
                            }
                        },
                        {
                            "text": "Главный <w>недостаток</w> этой машины — слишком большой расход топлива.",
                            "target_lang_translations": {
                                "en": "The main <w>drawback</w> of this car is the excessive fuel consumption.",
                                "de": "Der Haupt<w>nachteil</w> dieses Autos ist der zu hohe Kraftstoffverbrauch."
                            }
                        }
                    ],
                    "synonyms": [
                        "изъян",
                        "дефект",
                        "порок",
                        "недочёт"
                    ],
                    "antonyms": [
                        "достоинство",
                        "преимущество"
                    ],
                    "common_phrases": [
                        "главный недостаток",
                        "исправить недостатки",
                        "существенный недостаток",
                        "скрытые недостатки"
                    ],
                    "target_lang_definitions": {
                        "en": "An undesirable quality, imperfection, or flaw in a person or object.",
                        "de": "Eine unerwünschte Eigenschaft, ein Makel im Charakter oder an einem Gegenstand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flaw",
                                "target_lang_sense_clarification": "an imperfection or weakness"
                            },
                            {
                                "target_lang_word": "shortcoming",
                                "target_lang_sense_clarification": "a failure to reach a standard; a character defect"
                            },
                            {
                                "target_lang_word": "drawback",
                                "target_lang_sense_clarification": "a disadvantage or negative feature"
                            },
                            {
                                "target_lang_word": "defect",
                                "target_lang_sense_clarification": "a physical imperfection or malfunction"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Nachteil",
                                "target_lang_sense_clarification": "eine negative Eigenschaft oder Auswirkung"
                            },
                            {
                                "target_lang_word": "Schwäche",
                                "target_lang_sense_clarification": "eine Charakterschwäche oder Unzulänglichkeit"
                            },
                            {
                                "target_lang_word": "Mangel",
                                "target_lang_sense_clarification": "ein Fehler oder Defekt an einer Sache"
                            },
                            {
                                "target_lang_word": "Fehler",
                                "target_lang_sense_clarification": "eine Unvollkommenheit oder ein Defekt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
