                "senses": [
                    {
                        "sense_id": "e2118fa0-a810-3da0-94e1-eebb3f859ad9",
                        "entry_id": "16ad721e-9082-3fbd-a82e-e603263cae6d",
                        "glosses": [
                            "отправлять с тайной целью, секретным поручением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2b9613-5dbb-4e66-824a-6d6e1bc7db25",
                                "sense_id": "e2118fa0-a810-3da0-94e1-eebb3f859ad9",
                                "text": "Вы кучера моего подкупаете, девок ко мне с отравой подсылаете ― вы моей смерти добиваетесь."
                            },
                            {
                                "example_id": "03a0931b-dcd2-4275-b1f5-13f6b774cb50",
                                "sense_id": "e2118fa0-a810-3da0-94e1-eebb3f859ad9",
                                "text": "Ты вчера виделся с своей красавицей наедине… ¶ ― А вы почему знаете? ― с жаром начал Александр, ― вы подсылаете смотреть за мной?"
                            },
                            {
                                "example_id": "1aad7ffe-de68-4343-8347-02e022b29225",
                                "sense_id": "e2118fa0-a810-3da0-94e1-eebb3f859ad9",
                                "text": "Эти враги .. подсылают к нам шпионов, чтобы выведать секреты наших вооружений."
                            }
                        ]
                    }
                ],
