                                        "examples": [
                                            {
                                                "example_id": "92d21ead-acb3-4acc-8c68-83808191028c",
                                                "sense_id": "3dda9627-97d1-3955-bc64-ef72175d1b9e",
                                                "text": "I'd started shopping at 2 a.m., and the pod I listened to while shopping was almost through, so had to be 3 damn near."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a684b04-7722-3e5f-b486-68beeffb702a",
                                        "entry_id": "8c038c34-b188-34ac-8cde-34c1dc668b95",
                                        "glosses": [
                                            "A set of commercials to be shown together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1240e2e2-e773-4eda-9c1a-5461fda8193c",
                                                "sense_id": "1a684b04-7722-3e5f-b486-68beeffb702a",
                                                "text": "These ads are shown during commercial breaks when there is no game action. Usually, multiple spots are grouped into a pod of commercials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b988b39-83ff-3b09-a1fb-2cdf686b4b0a",
