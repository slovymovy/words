                "senses": [
                    {
                        "sense_id": "f81696dc-f714-3d48-a265-81a9b9a55e72",
                        "entry_id": "a0312031-8e8d-31f0-9edb-d58862a3ccfd",
                        "glosses": [
                            "Fähigkeit zum Ortswechsel über das eigene Biotop hinaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208e9dbb-842c-4dcd-aa3c-174de5367e95",
                                "sense_id": "f81696dc-f714-3d48-a265-81a9b9a55e72",
                                "text": "„Das gute Flugvermögen erlaubt den meisten Sphingidae eine hohe Vagilität, und zahlreiche Arten können als typische Wanderfalter weite Strecken, in Extremfällen weit über 2000 km, zurücklegen.“"
                            },
                            {
                                "example_id": "4e9830e5-d33e-4146-9933-52ea35fe4eab",
                                "sense_id": "f81696dc-f714-3d48-a265-81a9b9a55e72",
                                "text": "„Mit Recht wird der Vagilität, d. h. der Fähigkeit des Ortswechsels, eine sehr wichtige Rolle bei Ausbildung von Formen zugeschrieben. Denn direct von ihr ist die Möglichkeit der geschlechtlichen Mischung zwischen den Individuen einer Form mit ihren ausgleichenden Wirkungen abhängig. Die Vagilität ist nun bei den verschiedenen Thiergruppen äusserst ungleich entwickelt.“ (1902)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
