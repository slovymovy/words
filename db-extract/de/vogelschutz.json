                        "entry_id": "659cae29-7aec-3e26-a0a8-1152e6faf70e",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen und Normen, die der Erhaltung, Förderung oder Wieder- beziehungsweise Neuansiedlung von Vogelpopulationen dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939aabaa-f887-46af-9537-d289d64df7dd",
                                "sense_id": "9c59739c-58ca-356e-bfef-43cac7fd4365",
                                "text": "„Den »Vogel des Jahres« küren die beiden Naturschutzverbände seit mehr als 50 Jahren, um auf den Vogelschutz aufmerksam zu machen.“"
                            },
                            {
                                "example_id": "b22770e1-e0cc-4799-b814-eefa3545131b",
                                "sense_id": "9c59739c-58ca-356e-bfef-43cac7fd4365",
                                "text": "„Der Hauptbahnhof wurde ebenso wie der BER vom Büro [XY] entworfen. Dieses habe jedoch längst erkannt, dass Vogelschutz bereits bei der Planung berücksichtigt werden müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
