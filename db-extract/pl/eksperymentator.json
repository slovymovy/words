                "translations": [
                    {
                        "translation_id": "adfa6c30-89bd-415d-a945-b8d8ebd5fb3c",
                        "source_entry_id": "e6a0e628-ba1e-3b3c-9f68-762f6813958a",
                        "source_sense_id": "315b0c59-8dff-35d6-b646-9b6a10e744d0",
                        "target_lang_word": "expérimentateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expérimentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d03686d8-b876-3971-a52a-e570641095d2",
                                        "entry_id": "bbceedfa-e228-34ba-b4c4-eecfebb679d7",
                                        "glosses": [
                                            "Celui qui fait des expériences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f637f1-9768-4802-b370-085d3f8fffa4",
                                                "sense_id": "d03686d8-b876-3971-a52a-e570641095d2",
                                                "text": "Cet expérimentateur de la dernière heure a donc eu 5 morts sur 59 malades, ce qui constitue une « léthalité » — mot plus transcendant que mortalité — de 8, 5 p. 100, tandis que ladite léthalité est de 15 à 18 p. 100 dans les épidémies ordinaires de fièvre typhoïde ; […]."
                                            },
                                            {
                                                "example_id": "b37fba9c-0ad8-45ed-8fd9-23fc99cb0062",
                                                "sense_id": "d03686d8-b876-3971-a52a-e570641095d2",
                                                "text": "Sa vie de savant, de chercheur, d’expérimentateur hors ligne était dévorée par les appels, les supplications, les larmes d’une multitude d’infortunés, déjà en route pour les sombres bords, dont il était la seule espérance."
                                            },
                                            {
                                                "example_id": "c1f233ba-ac1d-47d8-a7df-b75c2805345d",
                                                "sense_id": "d03686d8-b876-3971-a52a-e570641095d2",
                                                "text": "Au sein de chaque groupe, tous les participants étaient complices avec l’expérimentateur, sauf un, dénommé le sujet. L'expérience visait à observer comment ce dernier allait réagir au comportement des autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86f67c23-998d-478c-8f6e-87bb24e7af54",
                        "source_entry_id": "e6a0e628-ba1e-3b3c-9f68-762f6813958a",
                        "source_sense_id": "315b0c59-8dff-35d6-b646-9b6a10e744d0",
                        "target_lang_word": "experimentador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6808afae-d3bb-4552-83d4-66d14c858565",
                        "source_entry_id": "e6a0e628-ba1e-3b3c-9f68-762f6813958a",
                        "source_sense_id": "315b0c59-8dff-35d6-b646-9b6a10e744d0",
                        "target_lang_word": "экспериментатор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "экспериментатор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ecd158-8c82-3768-b4db-56d1e6fb1f40",
                                        "entry_id": "fa3b2294-5e74-338e-b39f-ddec00093e57",
                                        "glosses": [
                                            "тот, кто экспериментирует, производит эксперимент, эксперименты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a382149-b26e-4a92-b1ba-7b0e55e39e1c",
                                                "sense_id": "f7ecd158-8c82-3768-b4db-56d1e6fb1f40",
                                                "text": "Напротив, «экспериментатор есть тот, кто в силу более или менее вероятного, но заранее составленного истолкования наблюденных явлений, устраивает опыт таким образом, что в логическом порядке предвидений он добывает результат, служащий проверкой гипотезы или предвзятой идеи»."
                                            },
                                            {
                                                "example_id": "05f718da-5c9f-492a-a037-2d3bb4182175",
                                                "sense_id": "f7ecd158-8c82-3768-b4db-56d1e6fb1f40",
                                                "text": "Художественную манеру Чехова можно уподобить скорей всего приёмам вдумчивого экспериментатора, который делает один за другим различные опыты в целях полнейшего выяснения занимающего его феномена, но является при этом не равнодушным и холодным регистратором жизни, а мыслителем, сердце которого болит и любит, и истекает кровью от сострадания."
                                            },
                                            {
                                                "example_id": "7ec25e15-a6da-409d-9ba3-83607cebad1f",
                                                "sense_id": "f7ecd158-8c82-3768-b4db-56d1e6fb1f40",
                                                "text": "Одновременно с развертыванием таланта Бутлерова как первоклассного экспериментатора пробуждается его гений теоретика."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
