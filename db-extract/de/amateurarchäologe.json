                "senses": [
                    {
                        "sense_id": "a79f14be-7cc1-37f0-aedc-0508e92f5d47",
                        "entry_id": "d263f9ba-cf50-3671-ad5d-6a8e71e0bc5e",
                        "glosses": [
                            "Person, die sich ohne fachliche Ausbildung mit Archäologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21b0cd0-bf79-4699-9cb9-39408894f0bf",
                                "sense_id": "a79f14be-7cc1-37f0-aedc-0508e92f5d47",
                                "text": "„Dem Hügel Hisarcık wandte sich Schliemann nach Hinweisen des englischen Amateurarchäologen Frank Calvert zu.“"
                            },
                            {
                                "example_id": "c9a6c419-73d8-4840-8f37-64354ccb1083",
                                "sense_id": "a79f14be-7cc1-37f0-aedc-0508e92f5d47",
                                "text": "„Der Amateurarchäologe Ian Cooke stellte fest, dass das nördliche Ende der Passage stets zum Sonnenaufgang am Mittsommerstag ausgerichtet ist, und sah darin einen Beleg für das Überleben des megalithischen Sonnenkults in die Zeit der Kelten.“"
                            },
                            {
                                "example_id": "cff47e68-7ff0-4d61-9c33-7e31a22594b9",
                                "sense_id": "a79f14be-7cc1-37f0-aedc-0508e92f5d47",
                                "text": "„Wir haben dann Bernds Papa informiert, der als Amateurarchäologe in Verbindung mit dem Museum in Speyer stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
