                ],
                "senses": [
                    {
                        "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                        "entry_id": "5873861c-e968-3ec3-9b50-c755cc30c91d",
                        "glosses": [
                            "Stelle, an der sich zwei Verkehrswege treffen, von denen nur einer über die Stelle hinaus weitergeführt wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c37cef-19af-4407-8131-3340846a5f22",
                                "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                                "text": "„Die jetzige Sperrung ist notwendig, um auch den Abschnitt der Fernwärmeleitung zu erneuern, der unter der T-Kreuzung mit der Mühlenstraße verläuft.“"
                            },
                            {
                                "example_id": "676f462b-2f10-4f51-bb26-c819604417c1",
                                "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                                "text": "„Die T-Kreuzung der Duisburger Straße mit der Krefelder Straße am Discounter Thomas Philipps ist aktuell eine der meist beachteten in ganz Geldern.“"
                            },
                            {
                                "example_id": "bd17a395-c2e7-4990-8db1-c7123f3d550a",
                                "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                                "text": "„An einer T-Kreuzung (Wegpunkt 4) führt der Hohenwittlingensteig nach rechts und erreicht eine steinerne Hütte (Wegpunkt 5).“"
                            },
                            {
                                "example_id": "d93f7ac6-4f09-4d44-bc3c-e98edfdb4820",
                                "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                                "text": "„An T-Kreuzungen gibt es manchmal einen Radweg auf der Seite, an der keine Straße einmündet.“"
                            },
                            {
                                "example_id": "8d3b5c62-6fbe-454f-831b-235d03544956",
                                "sense_id": "d399c62a-0a47-38f8-a864-d50d823a10b1",
                                "text": "„Noch spannender wird es, wenn die Ausfahrt eines Supermarktes gegenüber der Stelle liegt, wo Autos an einer T-Kreuzung eigentlich nur nach rechts und links abbiegen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
