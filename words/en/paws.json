                    "target_lang_definitions": {
                        "ru": "Аббревиатура, обозначающая постабстинентный синдром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ПАВС",
                                "target_lang_sense_clarification": "постабстинентный синдром"
                            }
                        ]
                    }
                }
            ]
        },
        {
