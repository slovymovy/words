                "senses": [
                    {
                        "sense_id": "c359e3fe-eeed-3927-af7a-62ccba4d29a4",
                        "entry_id": "39750350-2a1e-33b9-abd0-1f72c04daf10",
                        "glosses": [
                            "field of vision, visual field"
                        ],
                        "tags": [
