                    {
                        "sense_id": "c2aa7369-3438-37a4-a6af-6be64ed42d83",
                        "entry_id": "5f9101d6-06b3-3cb5-9027-de20c0f70f18",
                        "glosses": [
                            "Eigenschaft/Haltung, die in deutlichem Maße rohes, grausames (krudes) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db31bf9a-4054-47e7-a6de-3ff627816a02",
                                "sense_id": "c2aa7369-3438-37a4-a6af-6be64ed42d83",
                                "text": "„Die funkelnden Augen des Offiziers erschienen vor ihm im Dämmerlicht, alle Sanftheit darin war nun verschwunden und eine stählerne Krudität hatte ihren Platz eingenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6902587d-370f-3e0d-8bc4-e3743ae68dff",
                        "entry_id": "5f9101d6-06b3-3cb5-9027-de20c0f70f18",
                        "glosses": [
                            "Formulierung/Handlungsweise, die in deutlichem Maße grobe (krude) Züge zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a040b2a-b03b-441a-af33-a387145faa72",
                                "sense_id": "6902587d-370f-3e0d-8bc4-e3743ae68dff",
                                "text": "„Wir sehen aus diesen für den Gründer der Stoa so wichtigen Resten, wie fatal den Stoikern die Derbheiten und Kruditäten des noch halb im Zynismus steckenden jungen Zenon in der Folge waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
