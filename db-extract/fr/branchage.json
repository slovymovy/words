        "fr-extract.jsonl": [
            {
                "entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                "word": "branchage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "47906c15-d410-43f1-b333-26fc3f57a100",
                        "entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "tags": [
                            "plural"
                        ],
                        "form": "branchages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c58faaa0-4273-3734-aa8b-9f4c86694095",
                        "entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "glosses": [
                            "Ensemble des branches d’un arbre ou d'un arbuste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc88e400-5991-41d0-9257-2bfde6b90e34",
                                "sense_id": "c58faaa0-4273-3734-aa8b-9f4c86694095",
                                "text": "La jeune fille apparut comme il descendait les dernières marches du perron, encadrée par les branchages délicats des rosiers et des mimosas."
                            },
                            {
                                "example_id": "9ccaa0d9-3e42-44f8-9573-ccea91f5121c",
                                "sense_id": "c58faaa0-4273-3734-aa8b-9f4c86694095",
                                "text": "La combe enfle son écho mais, du petit bois, ne reviennent que les coups du hachot, les craquements dans les branchages."
                            },
                            {
                                "example_id": "f5225923-bfa7-421a-bc49-b300807e638e",
                                "sense_id": "c58faaa0-4273-3734-aa8b-9f4c86694095",
                                "text": "On a coupé les branchages des chênes, les pies se battent dans les mélèzes et le vent en passant m’a jeté un frisson."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6179c54-56f9-3a98-aabb-5af9612ebe76",
                        "entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "glosses": [
                            "Branches coupées ou tombées de l’arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda4d6f2-a93b-4892-83b1-8e7921592eea",
                                "sense_id": "c6179c54-56f9-3a98-aabb-5af9612ebe76",
                                "text": "On nous apporte des nattes et des tapis, on allume un grand feu de branchages au beau milieu de la salle, et nous parvenons enfin à nous dégeler."
                            },
                            {
                                "example_id": "7f329bf7-e2f2-42e0-b509-df3d73835a5d",
                                "sense_id": "c6179c54-56f9-3a98-aabb-5af9612ebe76",
                                "text": "On verse sur le tas ou dans le composteur tous les déchets végétaux du jardin en évitant le branchage d'un trop gros diamètre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4c6d74f-d66d-3b4c-8179-e1c46a3d8770",
                        "entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "glosses": [
                            "Ramure d’un cervidé mâle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2e2ade42-14e8-44ff-9a56-2c2fafb9cf5e",
                                "sense_id": "c4c6d74f-d66d-3b4c-8179-e1c46a3d8770",
                                "text": "Ce chasseur exhibait fièrement dans son salon le majestueux branchage d’un cerf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbc76a9d-7981-41fa-974d-e494ba03ba9d",
                        "source_entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "target_lang_word": "Astwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aabe7685-c8ce-379e-b913-e1fe0652111e",
                                        "entry_id": "dd37e6f9-b30b-3e65-887a-e27e31faaff5",
                                        "glosses": [
                                            "Gesamtheit der Äste eines Baums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0481e418-63e0-41f4-b841-0fab51baea6c",
                                                "sense_id": "aabe7685-c8ce-379e-b913-e1fe0652111e",
                                                "text": "„Der Zugang zur Höhle des Dagon liegt stets im Dunkeln, da das mächtige Astwerk und das dichte Laub keine Sonnenstrahlen durchlassen, doch an jenem Tag ließ die Finsternis meiner eigenen Seele die Schatten noch unheilvoller und düsterer erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3651c57-e988-48a5-a787-8658e37f1d88",
                        "source_entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "target_lang_word": "Gesweig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2bf44703-a5b5-4d98-b0b8-b8dd91155c50",
                        "source_entry_id": "a65e3312-3112-3b17-8ad5-c59739137776",
                        "target_lang_word": "Reisig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reisig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b56ab742-1516-3708-99d8-210e83f1f495",
                                        "entry_id": "ba20e778-84f8-33f1-b01f-4d55702d6976",
                                        "glosses": [
                                            "dürre, trockene Zweige, die von Bäumen oder Büschen abgefallen sind und häufig als Brennmaterial benutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df8e55f-9b20-4513-b185-d708adc07f95",
                                                "sense_id": "b56ab742-1516-3708-99d8-210e83f1f495",
                                                "text": "Bevor wir das Lagerfeuer anmachen können, müsst ihr Reisig sammeln gehen."
                                            },
                                            {
                                                "example_id": "060fe4e1-d8a7-4a7b-abff-d749e2c4ead8",
                                                "sense_id": "b56ab742-1516-3708-99d8-210e83f1f495",
                                                "text": "„In der Feuerstelle war noch Glut, er legte Reisig darüber, ließ es anglühen, blies es hoch, legte Holz darauf und schob das Feuer zwischen zwei Steine.“"
                                            },
                                            {
                                                "example_id": "938649a8-8a21-49ee-8fb1-3f0314447b3d",
                                                "sense_id": "b56ab742-1516-3708-99d8-210e83f1f495",
                                                "text": "„Fallholz und Reisig gibt es reichlich, man braucht es nur aufzusammeln.“"
                                            },
                                            {
                                                "example_id": "0b2030b4-bba2-4231-85a9-da23713c9b71",
                                                "sense_id": "b56ab742-1516-3708-99d8-210e83f1f495",
                                                "text": "„Ein mächtiges Feuer aus Reisig und Kienäpfeln flammte im Saal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0baf2ad-ce8d-3598-b82e-9a18fc5ffb27",
                                        "entry_id": "ba20e778-84f8-33f1-b01f-4d55702d6976",
                                        "glosses": [
                                            "das Gebüsch, das aus lebenden Ästen und Zweigen besteht"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f03253-aef5-4bce-9fb4-3342ad510845",
                                                "sense_id": "f0baf2ad-ce8d-3598-b82e-9a18fc5ffb27",
                                                "text": "Wir streiften durch das dichte Reisig und suchten unseren Kameraden."
                                            },
                                            {
                                                "example_id": "05201e22-3bd0-4189-89f7-ae0b32116f26",
                                                "sense_id": "f0baf2ad-ce8d-3598-b82e-9a18fc5ffb27",
                                                "text": "„»Ja, es ist schrecklich fatal«, lispelte der Obmann, »und wir haben schon gestern Einladungen zum Siegesfest verschickt und das Bootshaus beflaggt und mit Reisig geschmückt.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aec3df48-43bb-3da0-8ca2-2991897b89f7",
                                        "entry_id": "ba20e778-84f8-33f1-b01f-4d55702d6976",
                                        "glosses": [
                                            "ein Reis (Laubzweig oder Rebe), das bei der Übertragung eines Baumgartens, Waldgrundes oder Weinberges durch Verkauf in den Boden gesteckt oder überreicht wird"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36727b77-65ed-4c7a-b04d-f70f52ae6094",
                                                "sense_id": "aec3df48-43bb-3da0-8ca2-2991897b89f7",
                                                "text": "Der Kauf des Weinbergs ist besiegelt. Das Reisig ist nun übergeben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
