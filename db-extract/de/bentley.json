                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29f7ad84-bf04-3e84-86c6-a5b573828dc0",
                        "entry_id": "abcd4177-c70a-3ac3-9ee1-0c77565bb107",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13420836-3640-4457-b76d-f103ed861565",
                                "sense_id": "29f7ad84-bf04-3e84-86c6-a5b573828dc0",
                                "text": "„Er glaubte nicht, dass er sie jetzt gern besitzen würde, aber zumindest hätte er sie gern gefahren, einen Cord und einen Duesenberg und einen Pierce Arrow und einen Bugatti und einen Lincoln Continental von vor dem Krieg und vielleicht einen der großen alten offenen Bentleys.“"
                            },
                            {
                                "example_id": "135724b2-8670-482a-b368-031505ec3bbe",
                                "sense_id": "29f7ad84-bf04-3e84-86c6-a5b573828dc0",
                                "text": "„Ausgeklügelte und handgefertigte Dinger. Jede einzelne ein Unikat. Wie klassische Bentleys.“"
                            },
                            {
                                "example_id": "182d52a1-a61d-4c35-b6cd-3af8b696559f",
                                "sense_id": "29f7ad84-bf04-3e84-86c6-a5b573828dc0",
                                "text": "„Der viertürige weiße Bentley des Anwalts steht auf dem besten Platz gleich neben dem Aufzug.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
