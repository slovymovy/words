                "senses": [
                    {
                        "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                        "entry_id": "fa4e92d9-17a5-3fb1-889c-660d73167ccf",
                        "glosses": [
                            "Stein mit Inschrift zur Erinnerung an einen Ermordeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f3a599-c991-424c-921e-333b5a27d14b",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Der Unterschied zwischen Sühnestein und Erinnerungsmal ist der: das Sühnemal mußte der Täter setzen, das Erinnerungsmal lassen die Hinterbliebenen aufrichten.“"
                            },
                            {
                                "example_id": "a65fc847-c817-4ac1-814e-93d36d70c544",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Sühnesteine wurden zum Gedenken an ermordete Personen aufgestellt.“"
                            },
                            {
                                "example_id": "99e5c6e4-ea56-41da-8afd-e911baced163",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Unweit der Kirchhofsmauer, nordöstlich der Kirche auf dem Kirchhof in Gustow befindet sich ein Sühnestein, der aus dem Jahr 1510 stammt.“"
                            },
                            {
                                "example_id": "ba406d6d-6c6e-48c8-bd52-59bd15660ad1",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Die älteste Wappendarstellung unserer Familie findet sich auf einem Sühnestein bei Bernstorf in der Nähe von Grevesmühlen im westlichen Mecklenburg.“"
                            },
                            {
                                "example_id": "cb536be2-ae44-4910-85bd-0ef3c762e064",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Im Park des Schlosses südwestlich am Waldrand steht ein Sühnestein von 1359 aus Kalkstein mit Darstellung des gekreuzigten Christus, dem Wappen der Grafen Bernstorf und Schriftbändern.“"
                            },
                            {
                                "example_id": "03dcbf46-7caa-4fed-b946-e069dd4abc43",
                                "sense_id": "9788b9e0-de5e-3571-8b85-f0bf42530286",
                                "text": "„Nördlich von Sülsdorf steht in der Nähe eines Feldweges, der einst eine der wichtigsten Handelsstraßen Norddeutschlands war, ganz dicht am Rande eines Gehölzes ein Sühnestein, auch Mordwange genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
