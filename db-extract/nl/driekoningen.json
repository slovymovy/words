                    },
                    {
                        "translation_id": "b2e7d318-0c06-4294-b3df-c2519f9a3184",
                        "source_entry_id": "4d147835-5be6-3624-bc21-00283001794b",
                        "source_sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                        "target_lang_word": "Dreikönigstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreikönigstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                                        "entry_id": "23d2c0d4-7367-3807-aff9-d1db263af1df",
                                        "glosses": [
                                            "das Fest Erscheinung des Herrn/Epiphanie am 6. Januar"
                                        ],
                                        "tags": [
                                            "Kalender"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39c692fe-6da2-42a2-9740-f7444d054d00",
                                                "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                                                "text": "In Baden-Württemberg ist der Dreikönigstag ein gesetzlicher Feiertag."
                                            },
                                            {
                                                "example_id": "24d9b054-756c-4e62-8273-06f1e7c86a93",
                                                "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                                                "text": "„Der Dreikönigstag ist leider ein Sonntag, daher gilt es dann von Jänner bis Ende März, eine ziemliche Durststrecke zu überwinden - kein Feiertag, geschweige denn Fenstertag in Sicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89a7ebf7-b8e0-41b2-923b-3483d815b6db",
                        "source_entry_id": "4d147835-5be6-3624-bc21-00283001794b",
                        "source_sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                        "target_lang_word": "Heilige Drei Könige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heilige Drei Könige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9140baf2-86d6-3618-bf6c-a47f661b1b8b",
                                        "entry_id": "1f928ead-7fbf-30d8-b0dd-90568098d7c9",
                                        "glosses": [
                                            "Fest am 6. Januar, Tag der Erscheinung des Herrn; regional auch Feiertag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6d2e1d-e44e-4a30-ae4f-4e6c486f7510",
                                                "sense_id": "9140baf2-86d6-3618-bf6c-a47f661b1b8b",
                                                "text": "Am sechsten Januar ist Heilige Drei Könige."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a842d55-bb66-46c0-87e2-f8fbdd6c5536",
                        "source_entry_id": "4d147835-5be6-3624-bc21-00283001794b",
                        "source_sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                        "target_lang_word": "epiphany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epiphany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                        "entry_id": "d4cc15f5-a40e-3d58-9bc9-ab51312fa467",
                                        "glosses": [
                                            "An illuminating realization or discovery, often resulting in a personal feeling of elation, awe, or wonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8656a4ec-f5cb-4b9c-a379-8de1c2204122",
                                                "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                                "text": "It came to her in an epiphany what her life's work was to be."
                                            },
                                            {
                                                "example_id": "baab0293-7c85-42ee-bfbe-50fd775a82ce",
                                                "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                                "text": "Instead of examining institutions and classes, structures of economic production and social control, one had to think about “moments”—moments of love, hate, poetry, frustration, action, surrender, delight, humiliation, justice, cruelty, resignation, surprise, disgust, resentment, self-loathing, pity, fury, peace of mind—those tiny epiphanies, Lefebvre said, in which the absolute possibilities and temporal limits of anyone's existence were revealed."
                                            },
                                            {
                                                "example_id": "2fdd0ba7-ae04-4396-9e0a-051f6099c5c5",
                                                "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                                "text": "But after spending most of my pocket money to get those developed, I had an epiphany: I was never going to be a professional photographer. My pictures were god-awful. I put the camera away."
                                            },
                                            {
                                                "example_id": "5ac9d7a0-9354-4849-8e63-2a960d8a461b",
                                                "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                                "text": "Between the gaps, I was swimming laps / Got close to some epiphany / I'll convince a friend to join deep ends / Have your toes touch the lack of cement"
                                            },
                                            {
                                                "example_id": "27261515-a169-45c5-8008-6c9cb50b3f36",
                                                "sense_id": "1dbccba3-37ad-33b6-b211-3d4e369aed38",
                                                "text": "The logic of the standard biography—a formative event leads to an epiphany that creates the great man—doesn’t quite work when the greatness doesn’t have much to do with the man at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d2be75-02f4-37c7-b863-2559a90aed4a",
                                        "entry_id": "d4cc15f5-a40e-3d58-9bc9-ab51312fa467",
                                        "glosses": [
                                            "A manifestation or appearance of a divine or superhuman being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386799b6-6018-4def-8d9e-3fc03bc4168f",
                                                "sense_id": "58d2be75-02f4-37c7-b863-2559a90aed4a",
                                                "text": "The ithyphallic bird-man is the climactic, ecstatic, instantaneous male principle confronting the enormous, slow, bovine, and enduring principle of the eternal feminine in her epiphany as the bison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "524b760f-81ca-3f78-b268-7e2304f6a423",
                                        "entry_id": "d4cc15f5-a40e-3d58-9bc9-ab51312fa467",
                                        "glosses": [
                                            "Alternative letter-case form of Epiphany."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
