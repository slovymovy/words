    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                "word": "lucidness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                        "entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                        "glosses": [
                            "The property of being lucid; lucidity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a058fe0a-708b-4edd-a75c-005cbac15507",
                                "sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                                "text": "The lucidness of his answers argued against his being insane or confused."
                            },
                            {
                                "example_id": "cbcd3c44-1af9-4ec0-8cbb-c86c1e4a993d",
                                "sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                                "text": "Surprised and rejoiced thus far at the unanticipated newness, and the sweet lucidness and simplicity of Isabel’s narrating, […] Pierre now, in handing the instrument to Isabel, could not entirely restrain something like a look of half-regret, accompanied rather strangely with a half-smile of gentle humor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4e3181e-9737-496a-aaea-18312ce69e19",
