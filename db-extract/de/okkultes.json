                "senses": [
                    {
                        "sense_id": "3b683632-827b-3051-ba1f-5012d2dfba9a",
                        "entry_id": "6b78150e-a0bc-36be-ba6c-cbf91feff5bb",
                        "glosses": [
                            "Gesamtheit dessen, was okkult ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72e60d4-4254-4723-b11f-ec65d9359840",
                                "sense_id": "3b683632-827b-3051-ba1f-5012d2dfba9a",
                                "text": "„Damals gab er plötzlich das Studium der Vergangenheit auf, um sich dem Studium des Okkulten zu widmen.“"
                            },
                            {
                                "example_id": "2630f262-93af-4f68-9f24-f9b83bf779c7",
                                "sense_id": "3b683632-827b-3051-ba1f-5012d2dfba9a",
                                "text": "„Er hat sich intensiv dem Studium des Okkulten gewidmet, und so habe ich ihn auch kennengelernt.“"
                            },
                            {
                                "example_id": "6fda4aa1-6013-46c6-a3fd-5df29a34a9a1",
                                "sense_id": "3b683632-827b-3051-ba1f-5012d2dfba9a",
                                "text": "„Ihr Interesse für das Okkulte und Übernatürliche, das sich auch auf Traumdeutung und Reinkarnation erstreckte, weckte die Neugier der Zeitungsleute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
