            "senses": [
                {
                    "sense_id": "d182f121-0468-38fa-8df3-e63e392f309e",
                    "sense_definition": "Bâtir un édifice, un ouvrage ou un ensemble matériel selon un plan déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "batiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils veulent <w>construire</w> une maison écologique près de la forêt."
                        },
                        {
                            "text": "La ville a <w>construit</w> un nouveau pont pour faciliter la circulation des habitants."
                        }
                    ],
                    "synonyms": [
                        "bâtir",
                        "édifier"
                    ],
                    "antonyms": [
                        "détruire"
                    ],
                    "common_phrases": [
                        "construire une maison",
                        "permis de construire"
                    ]
                },
                {
                    "sense_id": "89b11838-6a78-3545-9639-976622abbf0c",
                    "sense_definition": "Élaborer ou développer progressivement quelque chose d'abstrait de manière cohérente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux partenaires ont réussi à <w>construire</w> une relation solide au fil des années."
