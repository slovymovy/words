                        "entry_id": "71122db2-8fbc-3d19-a00b-73d763a88ba0",
                        "glosses": [
                            "Prüfung, die aus einem theoretischen und einem praktischen Teil besteht und mit der man einen Führerausweis (Führerschein) für das Auto erwirbt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "2514fbc3-ea0a-4c33-a94d-906414f4484c",
                                "sense_id": "6b447b0f-b7cf-396d-864d-08e069856376",
                                "text": "„Zwei Mal schafft Alice die Autoprüfung nicht. Mit neunundfünfzig erhält sie den Führerschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
