                        "examples": [
                            {
                                "example_id": "79a739f3-f616-440c-b273-af46968fd65e",
                                "sense_id": "9059ee99-6bf0-3a01-8998-01faab6cdb38",
                                "text": "De componist van de opera, Huba de Graaff, baseerde het libretto op de menselijke geluiden in pornofilms. Het resultaat is een liefdespel met kleren aan, een muzikaal orgasme. Vorige week ging de opera in première tijdens de Operadagen in Rotterdam, dit najaar volgt een tournee."
                            }
                        ]
