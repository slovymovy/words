                                        "sense_id": "6d173de1-eefb-38b9-ba13-46ff8ed0c99f",
                                        "entry_id": "6c8103b5-769e-3592-af1e-460aab25beef",
                                        "glosses": [
                                            "Having the radicle turned toward the sides of the fruit, as some embryos."
                                        ],
                                        "tags": [
