                "senses": [
                    {
                        "sense_id": "da435a64-fb14-35d5-be81-df033ca31915",
                        "entry_id": "be86b8eb-5d02-377e-9cb9-064cfbb74b7e",
                        "glosses": [
                            "Kraftwerk, das Braunkohle zur Stromerzeugung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3a8303-fa78-4402-9e1c-6a27cb20ab46",
                                "sense_id": "da435a64-fb14-35d5-be81-df033ca31915",
                                "text": "Die Brennstoffversorgung für die deutschen Braunkohlekraftwerke ist noch für viele Jahre gesichert."
                            },
                            {
                                "example_id": "2080fa63-b920-4315-9905-b4220e204ff3",
                                "sense_id": "da435a64-fb14-35d5-be81-df033ca31915",
                                "text": "„Sie hat in dieser Woche in Grevenbroich ausgerechnet ein hochmodernes Braunkohlekraftwerk in Betrieb genommen.“"
                            },
                            {
                                "example_id": "6b5d13ca-a490-40da-ab21-37a48a77d1ba",
                                "sense_id": "da435a64-fb14-35d5-be81-df033ca31915",
                                "text": "„Das Kabinett billigte kürzlich ein Gesetz aus dem Wirtschaftsministerium, wonach eine Reihe von Braunkohlekraftwerken als eine Art Sicherheitsreserve vom Netz genommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
