                ],
                "senses": [
                    {
                        "sense_id": "e1e9b841-a90b-34c2-930a-7aab3c84cbf3",
                        "entry_id": "4b42cf50-e080-36da-ba29-d10e7b38f7e4",
                        "glosses": [
                            "женск. к мастер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664b6102-e17f-44b5-911a-31e3769c0622",
                                "sense_id": "e1e9b841-a90b-34c2-930a-7aab3c84cbf3",
                                "text": "Она была мастерица пересказывать прочитанные книги, да так умно и толково!"
                            },
                            {
                                "example_id": "cf4a3cfc-faf6-4465-9d1a-135b7ee6f72c",
                                "sense_id": "e1e9b841-a90b-34c2-930a-7aab3c84cbf3",
                                "text": "Маруся была великая рукодельница, мастерица вышивки ― на эти вышивки и жила Марусина семья в Киото."
                            },
                            {
                                "example_id": "f684f940-bd29-4e31-9d3a-eb0baedb27ed",
                                "sense_id": "e1e9b841-a90b-34c2-930a-7aab3c84cbf3",
                                "text": "Была моя тетка Лариса Карповна ― замечательная певунья и мастерица шить дамские платья, моя веселая бабушка Матрена Ивановна ― удивительная рассказчица и всепросмешница."
                            }
                        ]
                    }
                ],
