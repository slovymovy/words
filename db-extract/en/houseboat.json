                                "example_id": "7feefd00-88f5-461c-b0cd-03d11fc5215e",
                                "sense_id": "de5b5776-553c-3d4c-ab75-edce8506ce4a",
                                "text": "Graceful old houses stand by the edge of the Great Ouse and gaze down at the houseboats, skiffs and motor-cruisers that moor there."
                            },
                            {
                                "example_id": "2ccd1ec2-d37b-4c1f-88ed-c5a4392705ed",
                                "sense_id": "de5b5776-553c-3d4c-ab75-edce8506ce4a",
                                "text": "Hiro ducks out of Tranny's celebratory dinner rather early, drags Reason off the zodiac and onto the front porch of the houseboat, opens it up and jacks his personal computer into its bios."
                            }
                        ]
                    }
                ],
