                        "source_sense_id": "ab2d8616-aa66-3aed-bd4b-4bb0754ea7f5",
                        "source_sense_description": "ein Spiel, das mit einem Ball gespielt wird",
                        "target_lang_word": "ball game",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ball game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8414e5-7338-349a-b5dc-db03f030dae0",
                                        "entry_id": "60c76d8f-2fc6-3db6-b39a-830cb149e81c",
                                        "glosses": [
                                            "Any game played with a ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b54f1ff5-6338-44c9-8517-433667a15b0b",
                                                "sense_id": "6e8414e5-7338-349a-b5dc-db03f030dae0",
                                                "text": "Basketball, cricket, and football are three kinds of ball game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772ba161-fb2c-31be-a005-64f6f0fc6f22",
                                        "entry_id": "60c76d8f-2fc6-3db6-b39a-830cb149e81c",
                                        "glosses": [
                                            "A specific contest or match between teams playing such a game, in particular a baseball game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08abed6d-8b0d-425d-bfd8-f47ff2c643b1",
                                                "sense_id": "772ba161-fb2c-31be-a005-64f6f0fc6f22",
                                                "text": "George and Harriet went to the stadium to see the ball game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0d89f1-3127-32de-a4ea-af15d94bdd84",
                                        "entry_id": "60c76d8f-2fc6-3db6-b39a-830cb149e81c",
                                        "glosses": [
                                            "A sport played in the Aztec and Mayan civilizations; Mesoamerican ballgame."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aabe3802-9c1a-4976-ae0c-9288c48c6d17",
                                                "sense_id": "af0d89f1-3127-32de-a4ea-af15d94bdd84",
                                                "text": "The ball game was the main sport in Central America before the arrival of the Spanish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95534b6c-1385-389e-8246-92ce664b3fe4",
                                        "entry_id": "60c76d8f-2fc6-3db6-b39a-830cb149e81c",
                                        "glosses": [
                                            "Affair, issue, matter, subject, story, topic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85fb1556-78bc-4465-aa27-3c1c144b4a69",
                                                "sense_id": "95534b6c-1385-389e-8246-92ce664b3fe4",
                                                "text": "Think things over, Callahan. Get with it. It's a whole new ball game these days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b7f394-a13f-37f3-9f22-e8c664127e01",
                                        "entry_id": "60c76d8f-2fc6-3db6-b39a-830cb149e81c",
                                        "glosses": [
                                            "A decisive outcome in regard to some ongoing situation; game over."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd10b246-7369-4588-b12b-44fe2d9f00d1",
                                                "sense_id": "e3b7f394-a13f-37f3-9f22-e8c664127e01",
                                                "text": "If a U.S. presidential candidate receives 270 electoral votes, that's the ball game."
                                            }
                                        ]
                                    }
