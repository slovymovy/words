                        "examples": [
                            {
                                "example_id": "b3d48a4b-ec47-416d-86ed-67355e9ebdf7",
                                "sense_id": "b8a37455-3b97-3d20-ac91-27a3e670f0b3",
                                "text": "Pour soulever un poids si lourd, / Sisyphe, il faudrait ton courage ! / Bien qu’on ait du cœur à l’ouvrage, / L’Art est long et le Temps est court."
                            },
                            {
                                "example_id": "82f44a95-073c-4e75-b05c-61ff1b08bb26",
                                "sense_id": "b8a37455-3b97-3d20-ac91-27a3e670f0b3",
                                "text": "La lutte elle-même vers les sommets suffit a remplir un cœur d'homme. Il faut imaginer Sisyphe heureux."
                            }
                        ]
                    }
                ],
