                ],
                "senses": [
                    {
                        "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                        "entry_id": "f74f5afa-ce07-3170-976b-becef524ffd3",
                        "glosses": [
                            "zeitlich gegliedertes Notizheft (Kalender), wo zu Daten (Terminen) Ereignisse und Planungen festgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50a444d-bf73-46b7-9cfc-479b2e79492f",
                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                "text": "Manche Leute haben einen übervollen Terminkalender."
                            },
                            {
                                "example_id": "364a6c19-51bb-433a-b6b2-ebb114ffd813",
                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                "text": "„Schon als Schülerin hatte ich einen Terminkalender und Stress.“"
                            },
                            {
                                "example_id": "3e42112f-c75b-4df3-808d-5e6dbd958d86",
                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                "text": "„Sein Terminkalender ist rappelvoll.“"
                            },
                            {
                                "example_id": "4d8f7455-de5c-479b-a5b8-28669212add7",
                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                "text": "„Es steht nicht zu vermuten, dass Cook bei einem so vollen Terminkalender noch viel Zeit fand, auszuschlafen, sich an Frau und Kindern zu erfreuen oder in aller Ruhe vor dem Kamin seines Hauses in Mile End zu sitzen.“"
                            },
                            {
                                "example_id": "922d0b29-5f1e-4ab3-9669-52e206646f42",
                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                "text": "„Gudrun hatte mir für die Zeit mit Torben einen detaillierten Terminkalender gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20f91822-7d0d-4051-a7de-72805652c47a",
                        "source_entry_id": "f74f5afa-ce07-3170-976b-becef524ffd3",
                        "source_sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                        "target_lang_word": "diary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A daily log of experiences, especially those of the writer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdafcd69-c59b-4ce2-b509-12f68e141ccf",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "They kept separate diaries. His was on paper and her diary was on her computer's hard drive."
                                            },
                                            {
                                                "example_id": "78d721b7-3796-4a92-babd-b92c0b0b2cc8",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "No, I’m just going over the stuff Tara wrote in my diary.\nShe’s writing your diary? Could you be any lazier?"
                                            },
                                            {
                                                "example_id": "c8ca5c6f-3cdc-44e4-b934-df73ad1829b7",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "Both halves feature lyrics that are so teen-girly they sound like they were written in pink ink in a padlocked diary with hearts and frowny faces for punctuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A personal organizer or appointment diary."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de45354-527f-4e2b-aa84-3015fc48890f",
                                                "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                                "text": "It is recommended that teachers and pupils are issued with homework diaries to help implement and monitor the homework timetable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                        "entry_id": "49caeb2e-8210-3729-b325-596fb918466f",
                                        "glosses": [
                                            "To keep a diary or journal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca82135-ff7c-4342-8407-82e1cc922966",
                                                "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                                "text": "As part of her mindful movement practise, diarying is important to Sarah. \"It gives me a chance to see what is going on, to reflect on my experience.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758e5cc5-5fda-32ba-8299-9739e12f444d",
                                        "entry_id": "e229f690-04d8-3aaa-9659-e61a6730aa7d",
                                        "glosses": [
                                            "Lasting for one day."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5332aa-42e0-4334-b527-7e4ed51bc815",
                                                "sense_id": "758e5cc5-5fda-32ba-8299-9739e12f444d",
                                                "text": "the offer of a usurpation, though it were but as a diary ague"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b126f55-2dca-47a7-91bd-e9306b441c5b",
                        "source_entry_id": "f74f5afa-ce07-3170-976b-becef524ffd3",
                        "source_sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                        "target_lang_word": "agenda",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agenda",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                        "entry_id": "d0aee0f2-5656-3b2e-941d-c5883f9c40b4",
                                        "glosses": [
                                            "Livret sur lequel on note les choses qu’on se propose de faire ainsi que les rendez-vous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31dee758-613c-4b6d-a843-0234744419c0",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Acheter un agenda, des agendas."
                                            },
                                            {
                                                "example_id": "2d183101-7a08-4362-bee9-08a2be2665bd",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Un agenda élégamment relié."
                                            },
                                            {
                                                "example_id": "def40b53-d7a0-4906-adc3-033a603be2a7",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Mettez cela, écrivez cela sur votre agenda."
                                            },
                                            {
                                                "example_id": "49681dad-e5fd-4ffe-8884-10935c21140c",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Pourquoi dit-on « Henriette » et non pas « les Henriettes » ? Pendant des siècles les philosophes se sont posé cette question. Au XXᵉ siècle le centre de la personnalité est l’agenda."
                                            },
                                            {
                                                "example_id": "f0d15d2c-016a-48d1-88da-8ffc423bf82a",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Il fallait éviter les agendas minuscules dont chaque page comportait deux ou trois jours."
                                            },
                                            {
                                                "example_id": "afd84db2-6142-4da8-a44b-f1c88b68e30c",
                                                "sense_id": "36c5f9f8-346b-333c-a3c4-6bf2e8121a00",
                                                "text": "Le fait de noter son sommeil sur un agenda permet cette évaluation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5ced98-5459-306c-8eb6-dfa8fc3ded71",
                                        "entry_id": "d0aee0f2-5656-3b2e-941d-c5883f9c40b4",
                                        "glosses": [
                                            "Emploi du temps."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1647063-3584-4f10-bece-4b077951a313",
                                                "sense_id": "fd5ced98-5459-306c-8eb6-dfa8fc3ded71",
                                                "text": "Un directeur d’administration centrale, le directeur de cabinet d’un Ministre ou d’un Secrétaire d’Etat, un Préfet vivent, comme tous les décideurs, avec un agenda surchargé, des réunions incessantes, des audiences quotidiennes."
                                            },
                                            {
                                                "example_id": "71da2126-0418-466e-96d5-3a22ead7bba1",
                                                "sense_id": "fd5ced98-5459-306c-8eb6-dfa8fc3ded71",
                                                "text": "On ne peut pas espérer reconstituer un agenda complet des concerts auxquels Valéry assista, d’autant moins que de nombreuses notes sur Wagner, bien que certainement inspirées par une audition quelconque, ne font mention ni de l’occasion, ni de l’œuvre dont il est question."
                                            },
                                            {
                                                "example_id": "173c532c-bec4-4a06-9c13-2640ca2e6af8",
                                                "sense_id": "fd5ced98-5459-306c-8eb6-dfa8fc3ded71",
                                                "text": "Pour prendre un exemple, un prêtre, en général, a un agenda « surbooké ». S’il vous le montre, vous pouvez vous demander s’il vaut la peine d’être prêtre pour vivre cette vie-là."
                                            },
                                            {
                                                "example_id": "68cadc58-7228-4753-926b-eed91fed89a1",
                                                "sense_id": "fd5ced98-5459-306c-8eb6-dfa8fc3ded71",
                                                "text": "Il a aussi pour avantage de signaler au client qu’il est face à un « bon tatoueur ». Si son agenda est complet des mois à l’avance, cela signifie qu’il offre un travail de qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d252e47-9eed-3af7-93e6-caccf0d767e6",
                                        "entry_id": "d0aee0f2-5656-3b2e-941d-c5883f9c40b4",
                                        "glosses": [
                                            "Plan d’action ou programme, qu’il soit économique, idéologique, personnel, politique, professionnel, le plus souvent caché ou supposé tel."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f556caf6-df40-423b-b2c4-12fc48b13eeb",
                                                "sense_id": "2d252e47-9eed-3af7-93e6-caccf0d767e6",
                                                "text": "L’inscription des problèmes sur l’agenda politique va évidemment se trouver affectée par la configuration diversifiée de ces demandes initiales."
                                            },
                                            {
                                                "example_id": "3e69476f-320c-4864-a782-7f389c980a22",
                                                "sense_id": "2d252e47-9eed-3af7-93e6-caccf0d767e6",
                                                "text": "Le processus dans lequel s’inscrit la création du mythe est le cheminement d’une demande d’intervention gouvernementale : un groupe d’intérêts tient à ce que sa demande de faveurs s’inscrive à l’agenda gouvernemental au titre de problème politique, de dossier que l’appareil gouvernemental doit traiter."
                                            },
                                            {
                                                "example_id": "d7ad9973-9bde-4297-8da4-6ccc636470d3",
                                                "sense_id": "2d252e47-9eed-3af7-93e6-caccf0d767e6",
                                                "text": "Des polémiques complexes où se mêlent faits, propagande et xénophobie sont débattues entre spécialistes, parfois avec virulence et accusations croisées d'agenda politique."
                                            },
                                            {
                                                "example_id": "82587a41-ad5a-4cb4-8827-233f267fed04",
                                                "sense_id": "2d252e47-9eed-3af7-93e6-caccf0d767e6",
                                                "text": "La désignation de Quim Torra, un nationaliste radical connu pour ses Tweet antiespagnols, ne marque cependant pas l’abandon de l’agenda indépendantiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agenda",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd56eb1b-b447-3f9b-b108-25a3783ce550",
                                        "entry_id": "d5536046-f55c-3b4e-9b5c-20e03ab0f0ef",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de agender."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
