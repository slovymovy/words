                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c50364-9529-44b4-a360-7117bb9cc631",
                                                "sense_id": "68b93a2d-8019-3e83-a8e9-a441df05c77e",
                                                "text": "Θα είμαι εδώ από νωρίς, έλα κι εσύ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde4c183-f16b-30bb-bdbd-f6ed79450a7f",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
                                        "glosses": [
                                            "δηλώνει",
                                            "αντιδιαστολή, σύγκριση, προτίμηση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41df58b6-02ff-4bef-a8fd-7b263c0f0c38",
                                                "sense_id": "bde4c183-f16b-30bb-bdbd-f6ed79450a7f",
                                                "text": "Ο Λευτέρης είναι μεγαλύτερος από τον Μάνθο."
                                            },
                                            {
                                                "example_id": "a1ec3775-70bf-484c-809e-4b17f44c0b1d",
                                                "sense_id": "bde4c183-f16b-30bb-bdbd-f6ed79450a7f",
                                                "text": "Προτιμώ τυρί και ψωμί από κάτι γλυκό."
                                            }
