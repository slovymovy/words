                ],
                "senses": [
                    {
                        "sense_id": "0c4c8e64-8c3d-3ac1-bb78-dee55fdf4717",
                        "entry_id": "6826b4ab-6426-3c7b-b5ac-4a91569c35d1",
                        "glosses": [
                            "die Eigenschaft eines Abbildes habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509e4bf0-aaf9-40bd-8f58-ba2a5b792fec",
                                "sense_id": "0c4c8e64-8c3d-3ac1-bb78-dee55fdf4717",
                                "text": "„Die Zuschauer werden durch verschiedene filmische Mittel eingeladen, an diesem \"Erinnerungstraum\" teilzunehmen, und akzeptieren deswegen auch Bilder, die in einer streng abbildlichen Illusionierung unglaubwürdig und konstruiert gewirkt hätten.“"
                            },
                            {
                                "example_id": "d35a3414-e59c-4160-b1de-54a54b1bd1c6",
                                "sense_id": "0c4c8e64-8c3d-3ac1-bb78-dee55fdf4717",
                                "text": "„Freiheit und Persönlichkeit ist die ursprüngliche Form alles creatürlichen Daseins, denn aus dem unendlichen Geiste kann nur abbildlich ihm verwandtes stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
