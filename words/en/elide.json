                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>elide</w> personal loyalty with national patriotism during his speech."
                        },
                        {
                            "text": "Critics argued that the article <w>elided</w> the important distinction between legal and illegal actions."
                        }
                    ],
                    "synonyms": [
