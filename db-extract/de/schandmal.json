                ],
                "senses": [
                    {
                        "sense_id": "2dc24efd-e35a-3729-9cee-89d45b6278d7",
                        "entry_id": "5538f98f-8719-323b-af81-88086c48aad4",
                        "glosses": [
                            "sichtbares Zeichen (Mal), das jemandem für ein Verbrechen oder Vergehen zur Bestrafung zugefügt oder aufgebrannt wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "061cbc44-546d-4d8a-9d6d-a92104c1c396",
                                "sense_id": "2dc24efd-e35a-3729-9cee-89d45b6278d7",
                                "text": "„Wurde ein Dieb überführt, so schlug man ihm die Hand ab oder verpasste ihm ein Schandmal mit dem glühenden Eisen.“"
                            },
                            {
                                "example_id": "eca5c3d5-8981-4a70-8d02-5e091cf688e4",
                                "sense_id": "2dc24efd-e35a-3729-9cee-89d45b6278d7",
                                "text": "„Doch anders, als bei der Mafia, wo das Abtrennen eines Ohres oder der Nase als Schandmal eingesetzt wurde, wurden bei El Kontaro Abtrünnige gebrandmarkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9b7ee7b6-ba9e-3bed-ac81-bb48e61b988f",
                        "entry_id": "5538f98f-8719-323b-af81-88086c48aad4",
                        "glosses": [
                            "etwas von besonders schlechtem Ansehen"
                        ],
                        "tags": [
                            "figurative",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "81df24f9-c3fe-44aa-8f53-3306122a60d5",
                                "sense_id": "9b7ee7b6-ba9e-3bed-ac81-bb48e61b988f",
                                "text": "„Dieser Saal, der Wartesaal mit all den Leuten, war das Schandmal der Stadt, das Zeichen ihres allgemeinen Elends.“"
                            },
                            {
                                "example_id": "329fd63e-a98c-415b-9905-eb7010cca028",
                                "sense_id": "9b7ee7b6-ba9e-3bed-ac81-bb48e61b988f",
                                "text": "„Er bat um eine Aussprache mit Hitler, da er fürchtete, von Himmlers SS, die seine jüdischen Ahnen als Schandmal und seine Klage gegen die NSDAP als Affront empfanden, ermordet zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
