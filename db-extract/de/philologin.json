                        "translation_id": "497dd3cf-7e60-4029-aaea-29795965fb7d",
                        "source_entry_id": "5498912d-9ab2-3d65-b0ed-dc86474e996c",
                        "source_sense_id": "9e2f1f44-7394-31da-8855-b309dad393c5",
                        "source_sense_description": "eine Frau, die in der Philologie ausgebildet und bewandert ist",
                        "target_lang_word": "филологиня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "филологиня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb61359-1fb2-36a3-a905-cdd22e2d3f06",
                                        "entry_id": "519a9ede-0f8b-35c1-8824-00eefef2903a",
                                        "glosses": [
                                            "разг., шутл. специалистка по филологии или студентка филологического факультета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b45a21-31bc-4c0d-84f7-495e34a1f4f2",
                                                "sense_id": "0cb61359-1fb2-36a3-a905-cdd22e2d3f06",
                                                "text": "Филологини — то же, что и актрисы, народ влюбчивый, изменчивый, неверный, и я не удивился, когда она, увидев своего мужа свалившимся в стельку в намерении дрыхнуть до утра на дощатом полу веранды (мы кутили на чьей-то даче), захотела посмотреть, как я живу."
                                            },
                                            {
                                                "example_id": "2691469c-dc97-4006-9943-33a5967533b5",
                                                "sense_id": "0cb61359-1fb2-36a3-a905-cdd22e2d3f06",
                                                "text": "Это, значит, твоя филологиня звонила?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
