                "senses": [
                    {
                        "sense_id": "add464c9-b2c5-3df9-8336-ed3c5b1ff115",
                        "entry_id": "6be63991-cd88-3edd-a8dd-233832eed089",
                        "glosses": [
                            "Participe présent de boire."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3f271800-d273-489c-a2fd-8b7bf3c3c353",
                                "sense_id": "add464c9-b2c5-3df9-8336-ed3c5b1ff115",
                                "text": "Buvant des Martini à petites gorgées, elles parlaient à mi-voix avec leurs jeunes amants en chemisette, qui fumaient des cigarettes mentholées."
                            },
                            {
                                "example_id": "5ab62d41-c165-4796-9852-815d2ff6c75e",
                                "sense_id": "add464c9-b2c5-3df9-8336-ed3c5b1ff115",
                                "text": "Les hommes s’étaient donné du courage en buvant, ou en fumant, souvent les deux à la fois. Certains d’entre eux étaient surexcités. Fanatiques, ils hurlaient comme des loups en chargeant."
                            }
                        ]
                    }
                ],
