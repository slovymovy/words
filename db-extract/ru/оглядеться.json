                "senses": [
                    {
                        "sense_id": "725008df-e689-38da-8ded-1fc90707ac38",
                        "entry_id": "fc94a697-841d-3c11-9f60-779dedd0efbc",
                        "glosses": [
                            "посмотреть по сторонам, вокруг себя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45849dc9-e994-4524-87fb-4841f002dd5e",
                                "sense_id": "725008df-e689-38da-8ded-1fc90707ac38",
                                "text": "Он подозрительно огляделся вокруг."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae853402-a0ad-361f-b2d4-8b1fa15126be",
                        "entry_id": "fc94a697-841d-3c11-9f60-779dedd0efbc",
                        "glosses": [
                            "узнать окружающую обстановку, привыкнуть к ней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef762f7-fcc6-4398-9e11-33d55b65cf6c",
                                "sense_id": "ae853402-a0ad-361f-b2d4-8b1fa15126be",
                                "text": "Ты пока отдохни, оглядись, а там и за работу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd3c26cc-acc7-4c34-86f8-ac6983a1ce4b",
                        "source_entry_id": "fc94a697-841d-3c11-9f60-779dedd0efbc",
                        "target_lang_word": "look round",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "look round",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42aaa7db-2853-318f-880f-b3370d85ea8d",
                                        "entry_id": "ef05f9c4-2879-326e-aa2f-c73c4f78b928",
                                        "glosses": [
                                            "To inspect a building or area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88847248-3ae4-45a4-a9ab-317ae2eacde6",
                                                "sense_id": "42aaa7db-2853-318f-880f-b3370d85ea8d",
                                                "text": "We're interested in buying this house, can we look round tomorrow?"
                                            },
                                            {
                                                "example_id": "2b34f1d7-d81c-4156-a8de-7201a2845388",
                                                "sense_id": "42aaa7db-2853-318f-880f-b3370d85ea8d",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a0e291c-e301-367c-abfe-1f942f009ab8",
                                        "entry_id": "ef05f9c4-2879-326e-aa2f-c73c4f78b928",
                                        "glosses": [
                                            "To search a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1076c027-5254-4854-9851-0ae9133be21f",
                                                "sense_id": "8a0e291c-e301-367c-abfe-1f942f009ab8",
                                                "text": "I can't find my keys, so I'll look round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b91b09-cd01-3218-84dc-11f8c14986f7",
                                        "entry_id": "ef05f9c4-2879-326e-aa2f-c73c4f78b928",
                                        "glosses": [
                                            "To turn one's head to see what is behind oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cf31fa-d2a4-4f1c-9d7a-149c2a47aa40",
                                                "sense_id": "63b91b09-cd01-3218-84dc-11f8c14986f7",
                                                "text": "He heard a voice and looked round to see a man wearing dark clothes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
