{
    "word_family": [
        "навязывание",
        "навязчивость",
        "навязчивый",
        "навязать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3d1bb41-f880-3162-ad0e-e4d08d32db8a",
                    "sense_definition": "Назойливо предлагать свое общество или услуги, мешая другим.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит <w>навязываться</w> людям, которые явно не хотят с тобой общаться.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>impose yourself</w> on people who clearly don't want to talk to you."
                            }
                        },
                        {
                            "text": "Он постоянно <w>навязывается</w> в компанию, хотя его никто не приглашал.",
                            "target_lang_translations": {
                                "en": "He is constantly <w>pushing himself</w> into the group, even though no one invited him."
                            }
                        }
                    ],
                    "synonyms": [
                        "напрашиваться",
                        "лезть"
                    ],
                    "common_phrases": [
                        "не навязываться"
                    ],
                    "target_lang_definitions": {
                        "en": "To intrusively offer one's company or services, bothering others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to intrude",
                                "target_lang_sense_clarification": "to force oneself into a situation where one is not welcome"
                            },
                            {
                                "target_lang_word": "to impose oneself",
                                "target_lang_sense_clarification": "to force one's company or presence on someone else"
                            },
                            {
                                "target_lang_word": "to push oneself on someone",
                                "target_lang_sense_clarification": "to be overly persistent in seeking someone's attention or company"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f550b7e-6661-35ad-b5f9-5ccb0beaa202",
                    "sense_definition": "Быть привязанным сверху или вокруг чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Веревки <w>навязываются</w> поверх груза для его надежной фиксации.",
                            "target_lang_translations": {
                                "en": "Ropes are <w>tied over</w> the cargo to secure it firmly."
                            }
                        },
                        {
                            "text": "Ленты <w>навязываются</w> вокруг подарка для украшения.",
                            "target_lang_translations": {
                                "en": "Ribbons are <w>tied around</w> the gift for decoration."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be tied or fastened on top of or around something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be tied on",
                                "target_lang_sense_clarification": "to be attached by tying"
                            },
                            {
                                "target_lang_word": "to be fastened around",
                                "target_lang_sense_clarification": "to be secured by wrapping or tying around an object"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}