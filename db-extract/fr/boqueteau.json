        "fr-extract.jsonl": [
            {
                "entry_id": "3792fa28-10ed-338c-9090-9d67d76647a6",
                "word": "boqueteau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0bf20b12-6a58-47ae-9c07-cca1279be326",
                        "entry_id": "3792fa28-10ed-338c-9090-9d67d76647a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "boqueteaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                        "entry_id": "3792fa28-10ed-338c-9090-9d67d76647a6",
                        "glosses": [
                            "Petit bois, groupe d’arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d3eb08-0ed9-4ab3-921d-c611ee2cfdb1",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "On installa la compagnie dans une ferme et je fus posté en sentinelle, tout près de la route, à l’entrée d’un boqueteau, d’où je découvrais la plaine, immense et rase comme une mer."
                            },
                            {
                                "example_id": "23ce165b-38e9-44c3-823f-1b7fc975cd18",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "[…], puis il avait remonté les crêts par un des milles^([sic]) sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                            },
                            {
                                "example_id": "68892fc8-7254-4244-a238-5e219d4c7dab",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "Regardez ce boqueteau : une des entrées des souterrains du manoir y aboutit."
                            },
                            {
                                "example_id": "c6d4378d-b3cd-4589-bdb9-3048f71353bf",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "Nous touchons le fond obscur près d’un boqueteau marin\nOù les poissons de couleur jouent aux oiseaux du latin"
                            },
                            {
                                "example_id": "b1f94f50-7db5-49da-9ddf-571327289a58",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "Un boqueteau de sapins leur servit d’abri et tous deux s’y dissimulèrent. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 80)"
                            },
                            {
                                "example_id": "23b2e2eb-9117-4830-8345-74adb21665b8",
                                "sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                                "text": "Certes des boqueteaux peuvent être rencontrés aux détours de Gollainville avec les bois de Châteaugay, près de Fresnay-les-Chaumes avec les bois de Bel-Ebat tous proches, ou vers Fromonvilliers et Baccon. Mais la tendance reste à la rareté de la végétation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f09efb67-3743-487a-932a-389bb59fe56c",
                        "source_entry_id": "3792fa28-10ed-338c-9090-9d67d76647a6",
                        "source_sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                        "source_sense_description": "Petit bois",
                        "target_lang_word": "Wäldchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäldchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                        "entry_id": "4d2fdbd3-1e28-3c64-8583-c4c500bf9cc0",
                                        "glosses": [
                                            "kleiner Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edc24dd-4070-40a4-b18c-ade49b1abf5e",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "Er lebt in seinem Landhaus neben einem Wäldchen."
                                            },
                                            {
                                                "example_id": "153baa88-e5eb-4246-9931-ff2d9a932c56",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Der Fußgängerweg vorm Wäldchen führte zu einem Spielplatz, der für Babys war.“"
                                            },
                                            {
                                                "example_id": "452dc002-ee5e-4224-9cc1-d9478f596ce9",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Sie führte mich nach einer Premierenfeier in das Wäldchen, das neben ihrem (unbetretbaren) Studentenheim lag.“"
                                            },
                                            {
                                                "example_id": "c6b4bcec-24e7-4862-8354-5bd711e91d85",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Martin kümmerte sich um die Zugpferde, die sie weiter hinten in einem Wäldchen angepflockt hatten.“"
                                            },
                                            {
                                                "example_id": "b1e14731-7acb-4e8d-85dd-4cbaaee5e7e0",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Vor dem Mietshaus führt ein Feldweg in Richtung eines kleinen Wäldchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87195c1d-46b0-411b-a473-4bab666ff62c",
                        "source_entry_id": "3792fa28-10ed-338c-9090-9d67d76647a6",
                        "source_sense_id": "7c328682-54a2-352b-bb99-416524a60696",
                        "source_sense_description": "Petit bois",
                        "target_lang_word": "copse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb9a0e8-85d7-3031-9f95-18665ca96a73",
                                        "entry_id": "c965847a-9f05-397b-943c-ac8abb67ae7e",
                                        "glosses": [
                                            "A coppice: an area of woodland managed by coppicing (periodic cutting near stump level)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                                        "entry_id": "c965847a-9f05-397b-943c-ac8abb67ae7e",
                                        "glosses": [
                                            "Any thicket of small trees or shrubs, coppiced or not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62d5deb-0837-42f1-9049-c990c9ae1ffa",
                                                "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                                                "text": "Agrimonie groweth in places not tylled, in rough stone mountaynes, in hedges and Copses, and by waysides."
                                            },
                                            {
                                                "example_id": "8b0f3566-e71f-4df4-a8fe-035ad76a9ed1",
                                                "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                                                "text": "The day is come when I again repose\nHere, under this dark sycamore, and view\nThese plots of cottage-ground, these orchard tufts,\nWhich at this season, with their unripe fruits,\nAmong the woods and copses lose themselves,"
                                            },
                                            {
                                                "example_id": "60ca4c0e-f227-4ab8-b603-de11d7dd6e01",
                                                "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                                                "text": "Three thundercloven thrones of oldest snow, / Stood sunsetflushed: and, dewed with showery drops, / Upclomb the shadowy pine above the woven copse."
                                            },
                                            {
                                                "example_id": "d118da02-bdff-4e67-837a-90b5e3411a2b",
                                                "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                                                "text": "Striking the highway beyond the little copse she skirted the dark iron palings enclosing Hare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0313a6f6-ed01-32ab-9c10-b49208b60299",
                                        "entry_id": "c965847a-9f05-397b-943c-ac8abb67ae7e",
                                        "glosses": [
                                            "Any woodland or woodlot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
