                        "entry_id": "59679df6-434b-39d2-80aa-c7e573373a72",
                        "glosses": [
                            "jedweder Aufsatz auf einem Dach"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "25923562-9dbe-438c-89db-f417517f6e97",
                                "sense_id": "f61b9f54-5be4-357d-a77f-64f7a453c5a2",
                                "text": "„Mit markantem Dachaufsatz präsentiert sich das Gebäude Mörikeweg ab November.“"
                            },
                            {
                                "example_id": "1b959d5e-05c3-4711-a956-850db86cba17",
                                "sense_id": "f61b9f54-5be4-357d-a77f-64f7a453c5a2",
                                "text": "„Dieses System funktioniert mit einem elektrisch betriebenen Klimakompressor, der im Dachaufsatz integriert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ace802ee-4626-314e-9d43-54f2603ee03e",
                        "entry_id": "59679df6-434b-39d2-80aa-c7e573373a72",
                        "glosses": [
                            "oberer Abschluss eines Raumes/Gebäudes, der zusätzlich auf dem eigentlichen Dach oberhalb des Firsts ausgebildet wird, aus Material wie Glas oder einer Holzkonstruktion besteht und der freien Lüftung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524b7323-8cf0-47a0-a011-1cc7a65f6051",
                                "sense_id": "ace802ee-4626-314e-9d43-54f2603ee03e",
                                "text": "„Querlüftung mit Dachaufsätzen (Dachaufsatzlüftung), wie z. B. Kuppel, Laterne, Deflektor und Öffnungen in einer Außenwand oder gegenüberliegenden Außenwänden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
