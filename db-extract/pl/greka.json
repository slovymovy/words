                "senses": [
                    {
                        "sense_id": "75b2cb75-7781-386e-8ea3-37f89874dcf8",
                        "entry_id": "51190aa6-deab-3645-8d29-6dba60b74721",
                        "glosses": [
                            "język i literatura grecka"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "978670d0-a149-4ae8-bd5b-c07a8b0dd258",
                                "sense_id": "75b2cb75-7781-386e-8ea3-37f89874dcf8",
                                "text": "Słyszałem, że greka jest potwornie trudna: niby są jakieś zasady, ale wszędzie pojawiają się jakieś wyjątki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0a6e5506-aca7-3f83-875a-e40b2b164124",
                        "entry_id": "51190aa6-deab-3645-8d29-6dba60b74721",
                        "glosses": [
                            "lekcja języka greckiego, greki (1.1)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d812eeaf-154f-49d9-97ac-72f0db572857",
                                "sense_id": "0a6e5506-aca7-3f83-875a-e40b2b164124",
                                "text": "Nie lubię chodzić na grekę, nie dość, że sam język popaprany, to jeszcze ten nasz nauczyciel."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
