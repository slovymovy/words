                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf192b6-8030-3172-8742-bf7aadd97002",
                                        "entry_id": "6df961dc-d79a-3115-ac41-47c0a314aa35",
                                        "glosses": [
                                            "Anything that assures a certain outcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d8c4c4-da0b-46a1-ad2d-1a3773ab7fe8",
                                                "sense_id": "bdf192b6-8030-3172-8742-bf7aadd97002",
                                                "text": "Can you give me a guarantee that he will be fit for the match?"
                                            },
                                            {
                                                "example_id": "e1b3f67e-f891-4d0c-a58a-f23af7c0af02",
                                                "sense_id": "bdf192b6-8030-3172-8742-bf7aadd97002",
                                                "text": "After his actions were challenged by foreign governments and Parliament initially tried to put a stop to his action, Denman returned home and argued his case with enough force that, by 1848, the Royal Navy was handed active permission and encouragement to raze every last slave factory they could find to the ground, and full authority to stop any ship, of any flag, that was thought to be a slaver, with a guarantee with^([sic]) no censure from the government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc5ccb2-0deb-3261-9daa-1cba739d7231",
                                        "entry_id": "6df961dc-d79a-3115-ac41-47c0a314aa35",
                                        "glosses": [
                                            "A legal assurance of something, e.g. a security for the fulfillment of an obligation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70844d11-f6dd-3379-85d9-755f9bb6398d",
                                        "entry_id": "6df961dc-d79a-3115-ac41-47c0a314aa35",
                                        "glosses": [
                                            "A written declaration that a certain product will be fit for a purpose and work correctly; a warranty."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78b41f8-1146-4c91-8a10-2b2d83a6e676",
                                                "sense_id": "70844d11-f6dd-3379-85d9-755f9bb6398d",
                                                "text": "The cooker comes with a five-year guarantee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "444ca392-1907-31f8-8785-9ed5f2d319cf",
                                        "entry_id": "6df961dc-d79a-3115-ac41-47c0a314aa35",
                                        "glosses": [
                                            "The person to whom a guarantee is made."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49d59027-cc88-3c18-8d92-55509e5e2bbf",
                                        "entry_id": "6df961dc-d79a-3115-ac41-47c0a314aa35",
                                        "glosses": [
                                            "A person who gives such a guarantee; a guarantor."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f65ec80c-24e6-4385-8a69-ef4d1591b05f",
                                                "sense_id": "49d59027-cc88-3c18-8d92-55509e5e2bbf",
                                                "text": "But God who is the great Guarantee for the Peace , Order , and good behaviour of Mankind"
                                            }
                                        ]
                                    }
                                ]
                            },
