                        "examples": [
                            {
                                "example_id": "ea3c33f3-64ae-4fa0-b799-a4cd2ea51021",
                                "sense_id": "e70a0ba6-a28d-3d41-915a-d0b390aced3a",
                                "text": "Il entre dans le laboratoire, pose sa lanterne sur un baril placé à gauche de la porte d’entrée et procède avec P… au travail du siphonage, manipulation consistant à faire passer le liquide de la chaudière dans des touries, à l’aide d’un tube et par le principe du siphon."
                            },
                            {
                                "example_id": "3591a781-86d5-429d-a48f-50d20bcf2b9f",
                                "sense_id": "e70a0ba6-a28d-3d41-915a-d0b390aced3a",
                                "text": "Elle [une source] est à plus de huit kilomètres de notre ville ; pourrait-on l’amener par siphonage ?"
                            },
                            {
                                "example_id": "c99e4192-a2a8-4b3c-8134-dae763f130ac",
                                "sense_id": "e70a0ba6-a28d-3d41-915a-d0b390aced3a",
                                "text": "Sam a forcé le clapet du réservoir, il a glissé le bout d’arrosoir dedans, il a aspiré un grand coup jusqu’à ce que l’essence monte, et hop, c’était parti pour un gros siphonage en règle."
                            }
                        ]
                    }
