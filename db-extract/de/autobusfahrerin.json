                "senses": [
                    {
                        "sense_id": "f932247a-57e2-3660-a8ed-d3a955d0dd32",
                        "entry_id": "6c9cc6eb-0f2b-3c9c-867e-8996aa38025a",
                        "glosses": [
                            "Fahrerin eines Autobusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbbfbb0c-613e-4b34-8f90-8ab63f443ee7",
                                "sense_id": "f932247a-57e2-3660-a8ed-d3a955d0dd32",
                                "text": "Die Autobusfahrerin verkauft auch Fahrscheine."
                            },
                            {
                                "example_id": "d266a204-c751-4e51-9341-bebc59339301",
                                "sense_id": "f932247a-57e2-3660-a8ed-d3a955d0dd32",
                                "text": "„Wenn man bei einer bekannten Suchmaschine Autobusfahrerin eingibt, wird nachgefragt, ob man nicht Autobusfahrer meinte.“"
                            },
                            {
                                "example_id": "8e03322e-e730-4ccb-ab5d-d2abc97e2f63",
                                "sense_id": "f932247a-57e2-3660-a8ed-d3a955d0dd32",
                                "text": "„Da sich in den Autobussen der Wiener Linien außer der Autobusfahrerin bzw. dem Autobusfahrer in der Regel sonst keine Bediensteten der Wiener Linien aufhalten, oblag die Aufsicht über die Einhaltung der Beförderungsbedingungen in den Autobussen in erster Linie der Autobusfahrerin bzw. dem Autobusfahrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
