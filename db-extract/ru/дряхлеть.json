                        "cross_references": [
                            {
                                "target_word": "tomber en ruine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3041bbe-01b4-35f4-8de7-a06a3a70b2de",
                                        "entry_id": "04b3d12f-978b-3a97-a367-672d302668fd",
                                        "glosses": [
                                            "Être dans un tel état de vétusté, de délabrement qu’il en tombe de temps en temps quelque partie, en parlant d'un édifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda6f514-bc6e-472b-809c-59142561dad9",
                                                "sense_id": "f3041bbe-01b4-35f4-8de7-a06a3a70b2de",
                                                "text": "A Pont-du-Château même, la plupart des maisons réparées et bien entretenues sont celles où logent ces ouvriers ; beaucoup d'autres se délabrent, tombent en ruine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
