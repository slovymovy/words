                                                "sense_id": "3b329528-aa49-3d1d-930f-96b0f537e800",
                                                "text": "Die gefundenen Fingerabdrücke sind keinem der Verdächtigen zuordenbar."
                                            },
                                            {
                                                "example_id": "d08f7edd-358e-45f8-a1f2-864abb1bbd77",
                                                "sense_id": "3b329528-aa49-3d1d-930f-96b0f537e800",
                                                "text": "Die Täter hatten im alkoholisierten Zustand die Opfer wahllos ausgesucht. Die Verhafteten sind dennoch einer bestimmten Szene zuordenbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
