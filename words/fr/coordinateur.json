                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque groupe politique désigne un <w>coordinateur</w> pour négocier les amendements au texte."
                        },
                        {
                            "text": "Le <w>coordinateur</w> parlementaire a défendu la position commune lors du vote en commission."
