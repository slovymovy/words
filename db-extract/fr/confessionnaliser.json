                ],
                "senses": [
                    {
                        "sense_id": "13821522-84a4-30ce-a8c7-b38451f7129b",
                        "entry_id": "1b780a72-5bf5-39d9-9c9c-1f7ed8dab761",
                        "glosses": [
                            "Faire prendre un caractère confessionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b6e4d3-29d8-43f2-998d-bab28b100f64",
                                "sense_id": "13821522-84a4-30ce-a8c7-b38451f7129b",
                                "text": "D'autres souverains essayèrent aussi de « confessionnaliser » leur Université, mais ils ne réussirent que superficiellement, dans la plupart des cas."
                            },
                            {
                                "example_id": "b2559d08-8755-4847-aea3-54fa50836e77",
                                "sense_id": "13821522-84a4-30ce-a8c7-b38451f7129b",
                                "text": "Un Etat bi-confessionnel comme l'Allemagne a tort de vouloir confessionnaliser cette partie importante de la vie scolaire."
                            },
                            {
                                "example_id": "0635fcd4-4a64-4651-a1f4-331ac85b5268",
                                "sense_id": "13821522-84a4-30ce-a8c7-b38451f7129b",
                                "text": "Donc il faut continuer de réfléchir là dessus et ce n'est pas en se réfugiant dans la bondieuserie, dans le confessionnalisme, ce n'est pas en confessionnalisant le juif qu'on peut penser la chose."
                            }
                        ]
                    }
