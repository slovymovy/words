                    {
                        "sense_id": "a312db13-2943-3956-83b6-c6c7f884f5f3",
                        "entry_id": "be03d270-ae8b-31e6-8e83-3800b597349f",
                        "glosses": [
                            "egoïstisch, alles in dienst stellen van het eigen voordeel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38be5ec-3f46-4379-90dd-1dff83780f97",
                                "sense_id": "a312db13-2943-3956-83b6-c6c7f884f5f3",
                                "text": "Het egocentrische kind hield alle snoepjes voor zichzelf en kon niet delen met andere kinderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "665ecddb-dffb-34b8-a974-44d6d03bd186",
                        "entry_id": "be03d270-ae8b-31e6-8e83-3800b597349f",
                        "glosses": [
                            "zichzelf als het middelpunt van alles zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2626b8-2483-47c7-9efc-ea76dcd80a2a",
                                "sense_id": "665ecddb-dffb-34b8-a974-44d6d03bd186",
                                "text": "De egocentrische manager trok alle aandacht naar zichzelf toe in plaats van naar zijn team, dat toch al het werk had gedaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "010ab0d6-5875-42b9-9d42-7f4f9ae768d0",
                        "source_entry_id": "be03d270-ae8b-31e6-8e83-3800b597349f",
                        "source_sense_id": "665ecddb-dffb-34b8-a974-44d6d03bd186",
                        "source_sense_description": "zichzelf als het middelpunt van alles zien",
                        "target_lang_word": "egozentrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egozentrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                        "entry_id": "524b2bd7-57f3-3e19-974e-e23675f4af0a",
                                        "glosses": [
                                            "(nur) an sich denkend; sich selbst im Mittelpunkt sehend; egozentrisch ist eine Person, die alle Ereignisse nur von ihrem Standpunkt aus bewertet"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff0aafab-9a47-4f5f-a0e5-0840f1ab6145",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "Du bist schon immer ein wenig egozentrisch gewesen."
                                            },
                                            {
                                                "example_id": "bdadf3e7-3b9c-4b13-ac5f-8feb39ce9ea6",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Wygotski vertritt die These, daß die egozentrische Sprache ein Selbstgespräch ist, das nicht nur eine Handlungen begleitende, sondern auch eine selbstorientierende Funktion hat.“"
                                            },
                                            {
                                                "example_id": "ccc80b29-42ed-4a88-a2bc-d587f0c20556",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Anders als Piaget versteht Wygotski (1969) die Sprache des Kindes von vornherein als sozial; die egozentrische Sprache entsteht nach ihm erst später und führt zur inneren Sprache, dem sprachlichen Denken.“"
                                            },
                                            {
                                                "example_id": "ea68fac3-e25d-4680-a5a9-1a36543bb79e",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Als Pastorensohn 1853 geboren, war Vincent ein schwieriger Mensch, leidenschaftlich, rechthaberisch, egozentrisch und unangepasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
