                    {
                        "translation_id": "8787c6a5-7613-4543-aa3b-c762f7abca9e",
                        "source_entry_id": "2bdbcbe8-a8d0-3f92-b23a-0ace43fac5e7",
                        "source_sense_id": "55aef580-2626-3930-9f96-f6a58888159b",
