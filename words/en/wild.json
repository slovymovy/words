                                "target_lang_sense_clarification": "труднопроходимые места"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8c5b3bf7-ed00-3d7e-b234-d30e5ae54ca7",
                    "sense_definition": "In an uncontrolled or inaccurate manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball flew <w>wild</w> and ended up breaking a window across the street.",
                            "target_lang_translations": {
                                "ru": "Мяч полетел <w>куда попало</w> и в итоге разбил окно через дорогу."
                            }
                        },
                        {
                            "text": "He swung <w>wild</w> with his arms, trying to keep the attackers away.",
                            "target_lang_translations": {
                                "ru": "Он <w>беспорядочно</w> махал руками, пытаясь отогнать нападавших."
                            }
