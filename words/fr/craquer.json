                    ]
                },
                {
                    "sense_id": "d5b0de8c-92a3-35a1-980c-548a43392a4f",
                    "sense_definition": "Neutraliser ou contourner la sécurité d'un logiciel ou d'un système informatique de manière non autorisée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pirates utilisent des ordinateurs très puissants pour <w>craquer</w> ce mot de passe complexe."
                        },
                        {
                            "text": "Il est illégal de <w>craquer</w> un logiciel payant pour éviter d'acheter une licence."
