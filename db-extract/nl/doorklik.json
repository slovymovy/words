                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A thin wild bank of land splitting two cultivated patches and often linking two hills."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b702a4-e809-4c41-b3bc-1c09a62f7cc1",
                                                "sense_id": "b19615dc-030e-3b66-8db6-a55828e1c2f1",
                                                "text": "They used formerly to live in caves or huts dug into the side of a bank or \"link,\" and lined with heath or straw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
