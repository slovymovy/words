                {
                    "sense_id": "3d32f213-dd95-3cdb-99e1-edffcf458bcb",
                    "sense_definition": "Court récit d'imagination en vers ou en prose, souvent mettant en scène des animaux, et destiné à illustrer une leçon de morale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "litterature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'école élémentaire, les enfants apprennent souvent par cœur une <w>fable</w> de Jean de La Fontaine."
                        },
                        {
                            "text": "Cette célèbre <w>fable</w> met en scène un corbeau vaniteux trompé par un renard flatteur."
                        }
                    ],
                    "synonyms": [
                        "conte"
                    ],
                    "common_phrases": [
                        "fable de La Fontaine",
                        "moralité de la fable"
                    ]
                },
                {
                    "sense_id": "e4eefc33-e1ce-3970-9215-825946d734cf",
                    "sense_definition": "Récit inventé, mensonge ou fausseté sans fondement réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faussete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne crois pas ses explications confuses, toute cette histoire n'est qu'une pure <w>fable</w>."
                        },
                        {
                            "text": "Il a inventé une incroyable <w>fable</w> pour justifier son retard auprès de son employeur."
                        }
                    ],
                    "synonyms": [
                        "fabulation",
                        "histoire"
                    ]
                },
                {
