        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea8fa51d-34eb-3040-a31e-37aae8afd602",
                    "sense_definition": "Wensen of graag zien dat er iets wel of niet gebeurt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>hoopte</w> dat hij zijn proefwerk had gehaald.",
                            "target_lang_translations": {
                                "en": "He <w>hoped</w> that he had passed his test.",
                                "ru": "Он <w>надеялся</w>, что сдал контрольную.",
                                "pl": "Miał <w>nadzieję</w>, że zdał sprawdzian.",
                                "de": "Er <w>hoffte</w>, dass er seine Prüfung bestanden hatte.",
                                "fr": "Il <w>espérait</w> avoir réussi son examen.",
                                "it": "Lui <w>sperava</w> di aver superato il suo esame.",
                                "cs": "<w>Doufal</w>, že zkoušku udělal.",
                                "tr": "Sınavını geçtiğini <w>ummaktaydı</w>.",
                                "es": "Él <w>esperaba</w> haber aprobado su examen.",
                                "zh": "他<w>希望</w>自己考试及格了。"
                            }
                        },
                        {
                            "text": "We <w>hoopten</w> op goed weer tijdens onze vakantie.",
                            "target_lang_translations": {
                                "en": "We <w>hoped</w> for good weather during our vacation.",
                                "ru": "Мы <w>надеялись</w> на хорошую погоду во время нашего отпуска.",
                                "pl": "Mieliśmy <w>nadzieję</w> na dobrą pogodę podczas naszych wakacji.",
                                "de": "Wir <w>hofften</w> auf gutes Wetter während unseres Urlaubs.",
                                "fr": "Nous <w>espérions</w> avoir du beau temps pendant nos vacances.",
                                "it": "Noi <w>speravamo</w> in un bel tempo durante la nostra vacanza.",
                                "cs": "<w>Doufali</w> jsme v hezké počasí během naší dovolené.",
                                "tr": "Tatilimiz boyunca iyi bir hava <w>ümit ediyorduk</w>.",
                                "es": "Nosotros <w>esperábamos</w> buen tiempo durante nuestras vacaciones.",
                                "zh": "我们<w>希望</w>假期里天气能好。"
                            }
                        },
                        {
                            "text": "Ik <w>hoop</w> dat je snel weer beter wordt.",
                            "target_lang_translations": {
                                "en": "I <w>hope</w> you get better soon.",
                                "ru": "Я <w>надеюсь</w>, что ты скоро поправишься.",
                                "pl": "Mam <w>nadzieję</w>, że szybko wyzdrowiejesz.",
                                "de": "Ich <w>hoffe</w>, dass du schnell wieder gesund wirst.",
                                "fr": "J'<w>espère</w> que tu iras mieux bientôt.",
                                "it": "Io <w>spero</w> che tu guarisca presto.",
                                "cs": "<w>Doufám</w>, že se brzy uzdravíš.",
                                "tr": "Yakında tekrar iyileşmeni <w>umuyorum</w>.",
                                "es": "Yo <w>espero</w> que te mejores pronto.",
                                "zh": "我<w>希望</w>你能早日康复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wensen",
                        "verlangen"
                    ],
                    "antonyms": [
                        "vrezen",
                        "wanhopen"
                    ],
                    "common_phrases": [
                        "hopen op",
                        "het is te hopen",
                        "blijven hopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To wish or desire for something to happen or not happen.",
                        "ru": "Желать или хотеть, чтобы что-то произошло или не произошло.",
                        "pl": "Pragnąć lub życzyć sobie, aby coś się wydarzyło lub nie wydarzyło.",
                        "de": "Sich wünschen oder darauf vertrauen, dass etwas eintritt oder nicht eintritt.",
                        "fr": "Souhaiter ou désirer que quelque chose se produise ou ne se produise pas.",
                        "it": "Desiderare o sperare che qualcosa accada o non accada.",
                        "cs": "Přát si nebo chtít, aby se něco stalo nebo nestalo.",
                        "tr": "Bir şeyin gerçekleşmesini veya gerçekleşmemesini istemek veya arzulamak.",
                        "es": "Deseo o anhelo de que algo suceda o no suceda.",
                        "zh": "希望某事发生或不发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hope",
                                "target_lang_sense_clarification": "to want something to happen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "надеяться",
                                "target_lang_sense_clarification": "ожидать исполнения желаемого"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mieć nadzieję",
                                "target_lang_sense_clarification": "oczekiwać spełnienia życzenia"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hoffen",
                                "target_lang_sense_clarification": "zuversichtlich erwarten oder sich etwas wünschen"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "espérer",
                                "target_lang_sense_clarification": "considérer l'objet de son souhait comme réalisable"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sperare",
                                "target_lang_sense_clarification": "avere fiducia che qualcosa di positivo si avveri"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "doufat",
                                "target_lang_sense_clarification": "mít naději, že se něco stane"
