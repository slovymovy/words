                ],
                "senses": [
                    {
                        "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                        "entry_id": "c7108746-3e97-30d0-9bcb-842acb3c26ba",
                        "glosses": [
                            "Orné, paré."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "96a02c08-d1ac-4d53-a2c7-7b87bd885a4e",
                                "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                                "text": "La Sérafina et l’Isabelle lui paraissaient attifées superbement au milieu de ce château sinistre, où tout tombait de vétusté."
                            },
                            {
                                "example_id": "e29354c4-cac0-44eb-bfe3-0a410b25ae08",
                                "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                                "text": "Plus jolie ce soir-là, toute sa mise soigneusement attifée lui donnait un air de coquetterie provocante."
                            },
                            {
                                "example_id": "efdeb4a4-ace7-47a1-9489-07843ec2f637",
                                "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                                "text": "Alors que les parents semblaient vêtus de loques et de trous, les petits étaient attifés avec une espèce d’élégance pathétique."
                            },
                            {
                                "example_id": "5497835b-fb79-4466-99f5-8abe8435cd97",
                                "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                                "text": "Dans l’ennui de la cérémonie et d’un interminable banquet, j’avais tristement conscience de ce que confirment les photos : mal attifée, pataude, j’hésitais avec disgrâce entre la fillette et la femme."
                            },
                            {
                                "example_id": "0f05af47-35dc-481b-91a5-b982547466da",
                                "sense_id": "ed0e753c-8fe7-3e41-92ab-9b298776dec2",
                                "text": "Sa voix battait le tambour des haut-parleurs avec un rire grinçant attifé de haine."
                            }
                        ]
                    }
                ],
