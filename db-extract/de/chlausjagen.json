                    {
                        "sense_id": "12c72301-5241-3e9b-af3a-9c0deba407bf",
                        "entry_id": "1193a19d-fc9b-3e02-a5e5-24e95e8d18b3",
                        "glosses": [
                            "meist in der Nacht zum 6. Dezember stattfindender Umzug, der dem Samichlaus (Nikolaus) gewidmet ist, wobei schellenbehangene jugendliche Knaben verkleidet von Haus zu Haus ziehen"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "4f28fe1e-74e3-490d-a4b1-36b286592b9c",
                                "sense_id": "12c72301-5241-3e9b-af3a-9c0deba407bf",
                                "text": "„Vor zehn Tagen war es in Walchwil wieder Zeit für das Chlausjagen – ein Brauch, der seine Wurzeln im Mittelalter hat und am 5. Dezember jeweils zahlreiche Trychler aus den Häusern lockt.“"
                            },
                            {
                                "example_id": "90c353d2-0c74-48a6-99eb-56e55b66ceae",
                                "sense_id": "12c72301-5241-3e9b-af3a-9c0deba407bf",
                                "text": "„Auch am Freitagabend erlebte ein grosses Publikum das traditionelle Chlausjagen.“"
                            },
                            {
                                "example_id": "ea7d62ae-9b9f-45f4-b9dc-fa058a8a4b18",
                                "sense_id": "12c72301-5241-3e9b-af3a-9c0deba407bf",
                                "text": "„In Hallwil fand wiederum das Chlausjagen statt. Der Wintereinbruch am Abend bot eine perfekte Kulisse dafür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
