                        "glosses": [
                            "Genre d’abeille (Anthidium spp.), il en existe près de 200 espèces dont une trentaine vivent en Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c127299d-5739-46dc-b46e-cdca7857c4ec",
                                "sense_id": "efda8424-8d8c-3bdf-a318-e56851bb01ca",
                                "text": "L’anthidie à manchettes est une abeille « cotonnière » solitaire qui amasse les poils de certaines plantes pour faire son nid et en barricade l’entrée avec des cailloux."
                            },
                            {
                                "example_id": "3ebd6796-e1b0-4248-946c-91fd687c9bbd",
                                "sense_id": "efda8424-8d8c-3bdf-a318-e56851bb01ca",
                                "text": "L’anthidie tachetée est une abeille solitaire dont chaque femelle se reproduit, construisant des loges, qu’elle garnit de réserves alimentaires, avant d’abandonner les larves à leur sort."
                            }
                        ]
                    }
