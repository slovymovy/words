                    "semantic_group_id": "prise_de_vue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe a pris le temps de bien <w>cadrer</w> les mariés devant l'entrée du château."
                        },
                        {
                            "text": "Il faut <w>cadrer</w> la scène d'un peu plus près pour éviter les reflets gênants du soleil."
                        }
