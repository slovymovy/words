                "senses": [
                    {
                        "sense_id": "c72208fd-834e-3bbf-af73-7c2be40293dc",
                        "entry_id": "f826b3a7-d302-3a20-8975-09c84dd9fe8c",
                        "glosses": [
                            "Forme francisée du nom de l'ancienne voiture hippomobile appelée aussi buggy, buggey ou boghei."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767c4c75-c4b7-4d60-ad82-d38d66283c2e",
                                "sense_id": "c72208fd-834e-3bbf-af73-7c2be40293dc",
                                "text": "Nous avions été emmenés en boguet au-delà de Gémenos, dans la vallée de Saint-Pons."
                            },
                            {
                                "example_id": "6587cd44-2b26-4c62-a40e-ff6a5d3808b5",
                                "sense_id": "c72208fd-834e-3bbf-af73-7c2be40293dc",
                                "text": "Je me souviens d’un boguet qui descendait du Panthéon par le milieu de la chaussée et d’un homme que je surpris à prendre au filet deux pigeons dans les jardins du Luxembourg."
                            }
                        ]
                    },
                    {
                        "sense_id": "076447c1-e63f-33b9-b5bd-c89ed25b6f58",
                        "entry_id": "f826b3a7-d302-3a20-8975-09c84dd9fe8c",
                        "glosses": [
                            "Vélomoteur."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "1b778685-4e18-4500-9744-c4668f814d68",
                                "sense_id": "076447c1-e63f-33b9-b5bd-c89ed25b6f58",
                                "text": "Je vais chez Illione en boguet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c7546c0-c5a0-316d-a160-0214ea39f9a1",
                        "entry_id": "f826b3a7-d302-3a20-8975-09c84dd9fe8c",
                        "glosses": [
                            "Sorte d'écope utiliser pour pelleter le sel humide, ou écoper l'eau dans les marais salants."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb05a78-e20c-46b6-b8c7-fa3cedc68f67",
                                "sense_id": "2c7546c0-c5a0-316d-a160-0214ea39f9a1",
                                "text": "… par un orifice prévu, le ruisseau d'écours et en cas de besoin, en vidant les bassins avec sa pelle creuse, le boguet."
                            }
                        ]
                    }
                ],
