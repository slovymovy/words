                                "target_senses": [
                                    {
                                        "sense_id": "ad0d1b54-1637-3681-87a4-43b76c451a10",
                                        "entry_id": "99d7b845-9c83-3782-a4f9-01ab5ab8c374",
                                        "glosses": [
                                            "jongensnaam"
                                        ],
                                        "tags": [
                                            "masculine",
                                            "name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b720190-46b7-4e7a-82ba-68d19dcc261f",
                                                "sense_id": "ad0d1b54-1637-3681-87a4-43b76c451a10",
                                                "text": "De zakenman Ali Boureqat, die in Tazmamart zou belanden, beweerde jaren later dat hij een man in een gevangenis dicht bij Rabat had horen zeggen dat het lichaam van Ben Barka in cement werd gegoten en buiten Parijs begraven, maar dat zijn hoofd door generaal Oufkir in een koffer naar Marokko was gebracht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa1390a-81b8-3fd2-9174-349849426991",
                                        "entry_id": "99d7b845-9c83-3782-a4f9-01ab5ab8c374",
                                        "glosses": [
                                            "meisjesnaam"
                                        ],
                                        "tags": [
                                            "feminine",
                                            "name"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0c520fc-cf9d-4558-9f47-507d1418aea6",
                        "source_entry_id": "a39925c2-e39e-38ff-83cc-cea1085c77a4",
                        "source_sense_description": "male given name from Arabic",
                        "target_lang_word": "Ali",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ali",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11175658-a67d-329f-b268-a1686e4d1dc1",
                                        "entry_id": "927536f7-f01a-38bf-8e30-cc5487c43b0b",
                                        "glosses": [
                                            "Nom de famille. Attesté en France ^([Ins])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20873a3-53f7-4a82-ae69-67c15565832a",
                                                "sense_id": "11175658-a67d-329f-b268-a1686e4d1dc1",
                                                "text": "Un quatrième est en préparation avec Mahershala Ali."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ali",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f46b931c-91e3-3831-9522-4f89f2c4d5ae",
                                        "entry_id": "c61b3815-744e-3425-9282-626bcf31b830",
                                        "glosses": [
                                            "Prénom masculin arabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eacb609-f37d-4c85-8be8-ca56f391aba6",
                                                "sense_id": "f46b931c-91e3-3831-9522-4f89f2c4d5ae",
                                                "text": "Nous reproduisons ici deux textes de notre ami Ali Saad."
                                            },
                                            {
                                                "example_id": "b0243e0a-3d2b-45ca-8995-f37d5561ce7f",
                                                "sense_id": "f46b931c-91e3-3831-9522-4f89f2c4d5ae",
                                                "text": "« Il y aura toujours une plaie qui ne sera jamais vraiment fermée », a néanmoins souligné Ali Charrihi, qui a perdu sa mère, Fatima, dans l’attentat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdacd8ff-2101-3d9d-99e9-83ece93656c7",
                                        "entry_id": "c61b3815-744e-3425-9282-626bcf31b830",
                                        "glosses": [
                                            "Gendre du prophète de l'islam Mahomet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18864ba5-9c82-40ee-b5da-8509292d32e3",
                                                "sense_id": "bdacd8ff-2101-3d9d-99e9-83ece93656c7",
                                                "text": "— Ali, Ali, clama la voix étrange.\nOuroz pensa qu’elle invoquait le gendre du Prophète, le Kalife martyr, aussi vénéré dans les provinces du Nord que Mahomet lui-même. Et il se souvint de la mosquée dont les coupoles d’azur étincelaient en son honneur au milieu de Mazar-Y-Chérif, capitale des steppes. Et il crut voir les essaims merveilleux des pigeons qui par milliers se posaient sur sa tombe."
                                            },
                                            {
                                                "example_id": "1a9631d4-6356-4d6d-b2e7-5e192e0fdc47",
                                                "sense_id": "bdacd8ff-2101-3d9d-99e9-83ece93656c7",
                                                "text": "Ô mon maître, lui dit Zéré, avant la nuit sombre, tu auras pour tes reins une couche digne d’Ali, et pour ta tête un abri digne du Prophète."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ali",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5e7736-a209-37ea-ba46-06209cdebfec",
                                        "entry_id": "a576f07d-2646-3bc2-84dc-ba00f626e560",
                                        "glosses": [
                                            "Diminutif de Alison, prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8a9174-372e-4ac6-868c-56bd01a08c80",
                                                "sense_id": "cd5e7736-a209-37ea-ba46-06209cdebfec",
                                                "text": "Jusque-là, l’Irlandaise Ali Hewson était surtout connue en tant que femme de Bono, homme des grandes causes et des mégatournées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
