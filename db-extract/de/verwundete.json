                    {
                        "sense_id": "e0359421-4bb4-33e8-b9d9-8e708a0bccfa",
                        "entry_id": "d2842896-f37a-3c12-a47c-e51764e9b75f",
                        "glosses": [
                            "weibliche Person, die eine Verwundung erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fe557a-38eb-4c37-a213-e0a51ec2c562",
                                "sense_id": "e0359421-4bb4-33e8-b9d9-8e708a0bccfa",
                                "text": "Die Verwundete wurde umgehend zum Krankenhaus gebracht."
                            },
                            {
                                "example_id": "7adc509e-72b0-4520-bde7-2c12354a2f6b",
                                "sense_id": "e0359421-4bb4-33e8-b9d9-8e708a0bccfa",
                                "text": "„Aus der Kirche heimkehrende Leute zwangen den Mörder von seinem Opfer zu lassen; die Verwundete wurde nach Hause gebracht und nur der schnellen ärztlichen Hülfe ist es zu danken, daß Schmidt ihren Wunden nicht erlag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
