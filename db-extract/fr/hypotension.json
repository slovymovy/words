                                                "sense_id": "657cd592-f358-3b3f-a6a5-7954fbc43a9c",
                                                "text": "Durch Hypotonie kann Müdigkeit, Schwindelgefühl und Ohnmacht hervorgerufen werden."
                                            },
                                            {
                                                "example_id": "0cd2fb83-966d-4171-98c4-5361a94180a4",
                                                "sense_id": "657cd592-f358-3b3f-a6a5-7954fbc43a9c",
                                                "text": "Wenn das Blut in der benötigten Menge nicht schnell genug dorthin gelangt, wo es benötigt wird, spricht man von Hypotonie."
                                            }
                                        ],
