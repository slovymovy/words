                        ],
                        "form": "das Ornat"
                    },
                    {
                        "form_id": "86760f76-0f84-446f-92df-343ef2faa9ee",
                        "entry_id": "f9f0e6c2-d36c-33ef-863c-12280543d25f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ornate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fdaa5b3-54cd-3361-b1c3-2770a7979c38",
                        "entry_id": "f9f0e6c2-d36c-33ef-863c-12280543d25f",
                        "glosses": [
                            "(feierliche) Amtstracht von Geistlichen oder höheren Staatsdienern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7720ab2-f86a-47df-9b7a-8c8dc9dfef0f",
                                "sense_id": "7fdaa5b3-54cd-3361-b1c3-2770a7979c38",
                                "text": "Der Bischof schritt im festlichen Ornat der Prozession voran."
                            },
                            {
                                "example_id": "10b24492-d5dc-4807-be5e-502f46c3f110",
                                "sense_id": "7fdaa5b3-54cd-3361-b1c3-2770a7979c38",
                                "text": "Amaury und sein Amtsnachfolger hatten auch an diesem gewöhnlichen Wochentag jeder ihr volles Ornat angelegt, als wollten sie sich damit gegenseitig übertrumpfen."
                            },
                            {
                                "example_id": "4b603078-9328-49fa-b786-7db91284a0e1",
                                "sense_id": "7fdaa5b3-54cd-3361-b1c3-2770a7979c38",
                                "text": "„Er besänftigte sie mit Geld; dann zog er seinen priesterlichen Ornat an, um seiner Schwester den Teufel auszutreiben und zu sehen, ob sie wirklich den Bösen im Leib habe.“"
                            },
                            {
                                "example_id": "a102d05e-2029-4b9f-a66d-8c82be9255f3",
                                "sense_id": "7fdaa5b3-54cd-3361-b1c3-2770a7979c38",
                                "text": "„Albrecht präsentiert sich in voller Pracht mit Bischofsmütze (darunter lugt noch ein wenig Kardinalsrot hervor), Bischofsstab und juwelenübersätem Ornat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
