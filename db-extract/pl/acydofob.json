                    },
                    {
                        "translation_id": "7246384d-ca1e-4f27-914c-ffd67d31ac75",
                        "source_entry_id": "16887251-e211-331a-a0e4-0362ffa21b71",
                        "source_sense_id": "038b5e65-e1c8-3b74-aed5-a8a139a56934",
                        "source_sense_description": "meist im Plural, Botanik: azidophobe/acidophobe Pflanze, Kalkpflanze, Kalziphyt",
                        "target_lang_word": "acidophob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "beaaea80-2cd1-4a93-9d54-2b151ffe4d6e",
                        "source_entry_id": "16887251-e211-331a-a0e4-0362ffa21b71",
                        "source_sense_id": "038b5e65-e1c8-3b74-aed5-a8a139a56934",
                        "source_sense_description": "meist im Plural, Botanik: azidophobe/acidophobe Pflanze, Kalkpflanze, Kalziphyt",
                        "target_lang_word": "Pflanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflanze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                        "entry_id": "ffc854d5-39d2-3d63-82e6-cd26ab78fbe3",
                                        "glosses": [
                                            "eukaryotischer Organismus, der meist in der Lage ist, Photosynthese zu betreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9d0c58-5595-4aa6-802c-f743c972db5e",
                                                "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                                "text": "Nach heutiger Auffassung sind Pilze keine Pflanzen."
                                            },
                                            {
                                                "example_id": "c6277656-58f9-40e4-afbd-e55853a389a4",
                                                "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                                "text": "„Der Boden ist ein wichtiger Teil der Biosphäre an Land, weil die meisten Pflanzen ihn für ihr Wachstum brauchen.“"
                                            },
                                            {
                                                "example_id": "b514287a-0809-4827-8fe1-0a41a93367fd",
                                                "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                                "text": "„In Wüsten erweckt erst der Regen einige Pflanzen zum Leben. Andere überleben die Dürre, indem sie Wasser in ihren Stängeln oder Wurzeln speichern.“"
                                            },
                                            {
                                                "example_id": "c73afb7d-d8bd-4c0f-a506-625275407e07",
                                                "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                                "text": "„Man kann beispielsweise Pflanzen mittels Gentechnik so manipulieren, dass sie gegen bestimmte Krankheiten immun oder unempfindlich gegen sonst giftige chemische Pflanzenschutzmittel werden.“"
                                            },
                                            {
                                                "example_id": "f8abf133-8c26-4e26-8070-22cb491f9949",
                                                "sense_id": "5d88c512-f436-3274-8a31-d37f3c30c3da",
                                                "text": "„Risiken beim Einsatz gentechnisch veränderter Pflanzen sind neben einer Bedrohung der Artenvielfalt auch Nebeneffekte wie das Auftreten neuer unerwünschter Eigenschaften bei den Pflanzen, aber auch allergische Reaktionen bei den Verbrauchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "319d9ed2-b4b3-301d-bc8d-0af3203624bb",
                                        "entry_id": "ffc854d5-39d2-3d63-82e6-cd26ab78fbe3",
                                        "glosses": [
                                            "eigenartiger, ungeratener Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f235b2c2-f641-461e-9ef3-fb3e60c1e987",
                                                "sense_id": "319d9ed2-b4b3-301d-bc8d-0af3203624bb",
                                                "text": "Sie ist eine seltsame Pflanze."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
