                                        "sense_id": "6f634115-4261-3df7-96d0-fdb45b52f30d",
                                        "entry_id": "0a9c2bba-eacc-3bf5-847e-07e4fd3e5f3c",
                                        "glosses": [
                                            "Ancien nom de Gdańsk, ville de Pologne et port sur la mer Baltique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c447019-db20-493b-bf0e-3e8779e6edc4",
                                                "sense_id": "6f634115-4261-3df7-96d0-fdb45b52f30d",
                                                "text": "Ainsi, tout en la séparant de la Pologne, la nature du sol divisait la Poméranie en deux parties : la Poméranie de l'Oder avec Stettin (Szczecin) pour capitale et la Poméranie vistulienne dont Dantzig était le centre."
                                            }
                                        ]
                                    }
