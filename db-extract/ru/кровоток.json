                                "target_senses": [
                                    {
                                        "sense_id": "68255599-81e6-3a86-9bb1-b30f84429a1f",
                                        "entry_id": "3098d9c5-0e87-3de8-8ef3-a9214ceeb42d",
                                        "glosses": [
                                            "Losing blood."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26160578-a972-41fa-a3ad-415c61efcf15",
                                                "sense_id": "68255599-81e6-3a86-9bb1-b30f84429a1f",
                                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                        "entry_id": "3098d9c5-0e87-3de8-8ef3-a9214ceeb42d",
                                        "glosses": [
                                            "extreme, outright; bloody, blasted."
                                        ],
                                        "tags": [
                                            "UK",
                                            "emphatic",
                                            "intensifier",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f491ffe-d48e-4d1f-be2b-ddcbb9563495",
                                                "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                                "text": "You are a bleeding liar. Truth is of no interest to you at all."
                                            },
                                            {
                                                "example_id": "0becc3a6-9d8c-47ba-b896-aa8fc68920ed",
                                                "sense_id": "9d1991ff-681e-3a2d-b95c-edaaf6c62ffc",
                                                "text": "\"You are a bleeding idiot sometimes, but I love you and\", Harry hands him the first gift Severus ever gave him and says, \"One hundred and sixteen.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleeding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93a37171-9f68-3289-98d3-3f6e87a21abc",
                                        "entry_id": "a228f47d-8b29-3197-938d-fbeff94574ca",
                                        "glosses": [
                                            "used as an intensifier: Extremely."
                                        ],
                                        "tags": [
                                            "British",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "376935b7-14a6-4f8e-be67-27df9432eaf3",
                                                "sense_id": "93a37171-9f68-3289-98d3-3f6e87a21abc",
                                                "text": "His car's motor is bleeding smoking down the motorway."
                                            },
                                            {
                                                "example_id": "b4fa533a-dd38-4dfc-99c1-394a2d96136d",
                                                "sense_id": "93a37171-9f68-3289-98d3-3f6e87a21abc",
                                                "text": "It turns out he was too bleeding cheap to ever drain the oil."
                                            },
                                            {
                                                "example_id": "56b55661-cade-438a-95eb-2f4ed5db084f",
                                                "sense_id": "93a37171-9f68-3289-98d3-3f6e87a21abc",
                                                "text": "It does highlight some of the difficulties, but does not dare state the bleeding obvious, which is that neither are likely to play a major part in delivering a decarbonised agenda on the railways – […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleeding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9725ffb4-895e-3aa3-be91-13b54bf85fee",
                                        "entry_id": "9ae5cf56-8b34-34f8-8848-d80676662d57",
                                        "glosses": [
                                            "The flow or loss of blood from a damaged blood vessel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4de890d4-ed2a-4938-998e-969efb512f8d",
                                                "sense_id": "9725ffb4-895e-3aa3-be91-13b54bf85fee",
                                                "text": "Internal bleeding is often difficult to detect and can lead to death in a short time."
                                            },
                                            {
                                                "example_id": "78463121-ad35-4d57-a74e-51803671e7f4",
                                                "sense_id": "9725ffb4-895e-3aa3-be91-13b54bf85fee",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic […] real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf574f55-1250-3d83-9b37-3b37b6c1213a",
                                        "entry_id": "9ae5cf56-8b34-34f8-8848-d80676662d57",
                                        "glosses": [
                                            "Bloodletting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5991a180-d764-4145-a03d-b4641e71854f",
                                                "sense_id": "cf574f55-1250-3d83-9b37-3b37b6c1213a",
                                                "text": "Notwithstanding the employ of general and local bleeding, blisters, &c., the patient died on the fourth day after entrance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1c3fdb-8308-3064-be20-22349b18d41e",
                                        "entry_id": "9ae5cf56-8b34-34f8-8848-d80676662d57",
                                        "glosses": [
                                            "Depletion of a given resource; draining, sapping, weakening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e48446d-b088-4c49-840a-65b34d8bc715",
                                                "sense_id": "9a1c3fdb-8308-3064-be20-22349b18d41e",
                                                "text": "the bleeding of the budget"
                                            },
                                            {
                                                "example_id": "12c337ed-53ab-4f48-bcb4-8ffe1c282afc",
                                                "sense_id": "9a1c3fdb-8308-3064-be20-22349b18d41e",
