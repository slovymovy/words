{
    "word_family": [
        "passionate",
        "passionately",
        "passionless",
        "impassion"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                    "sense_definition": "A very strong feeling of love, hatred, anger, or enthusiasm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke with great <w>passion</w> about the need for education reform.",
                            "target_lang_translations": {
                                "ru": "Она с большой <w>страстью</w> говорила о необходимости реформы образования.",
                                "tr": "Eğitim reformu ihtiyacı hakkında büyük bir <w>tutkuyla</w> konuştu.",
                                "zh": "她谈到教育改革的必要性时，充满了<w>激情</w>。"
                            }
                        },
                        {
                            "text": "He has a <w>passion</w> for classical music that started in his childhood.",
                            "target_lang_translations": {
                                "ru": "У него <w>страсть</w> к классической музыке, которая началась еще в детстве.",
                                "tr": "Çocukluğunda başlayan klasik müzik <w>tutkusu</w> var.",
                                "zh": "他对古典音乐有着从小就开始的<w>热爱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ardor",
                        "zeal",
                        "enthusiasm",
                        "love"
                    ],
                    "common_phrases": [
                        "with passion",
                        "passion for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильное чувство любви, ненависти, гнева или энтузиазма.",
                        "tr": "Sevgi, nefret, öfke veya heyecan gibi çok güçlü bir duygu.",
                        "zh": "一种非常强烈的爱、恨、愤怒或热情的感受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "сильное чувство"
                            },
                            {
                                "target_lang_word": "пыл",
                                "target_lang_sense_clarification": "горячность, энтузиазм"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tutku",
                                "target_lang_sense_clarification": "güçlü duygu veya heyecan"
                            },
                            {
                                "target_lang_word": "ihtiras",
                                "target_lang_sense_clarification": "aşırı güçlü istek ve duygu"
                            },
                            {
                                "target_lang_word": "coşku",
                                "target_lang_sense_clarification": "büyük heyecan ve şevk"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激情",
                                "target_lang_sense_clarification": "强烈的感情"
                            },
                            {
                                "target_lang_word": "热情",
                                "target_lang_sense_clarification": "热忱、热心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf55df3-e83f-3a74-8d52-7339d6e5cf3b",
                    "sense_definition": "Something that a person is strongly interested in and enjoys doing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardening became her <w>passion</w> after she retired from her job.",
                            "target_lang_translations": {
                                "ru": "Садоводство стало её <w>страстью</w> после того, как она вышла на пенсию.",
                                "tr": "İşinden emekli olduktan sonra bahçecilik onun <w>tutkusu</w> haline geldi.",
                                "zh": "退休后，园艺成了她最大的<w>爱好</w>。"
                            }
                        },
                        {
                            "text": "His collection of vintage cars is his greatest <w>passion</w>.",
                            "target_lang_translations": {
                                "ru": "Коллекция старинных автомобилей — его самая большая <w>страсть</w>.",
                                "tr": "Klasik araba koleksiyonu onun en büyük <w>tutkusudur</w>.",
                                "zh": "收藏老爷车是他最大的<w>热衷之事</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lifelong passion",
                        "pursue a passion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие или предмет, вызывающие сильный интерес и удовольствие.",
                        "tr": "Bir kişinin çok güçlü bir şekilde ilgi duyduğu ve yapmaktan keyif aldığı şey.",
                        "zh": "一个人非常感兴趣并乐于从事的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "сильное увлечение"
                            },
                            {
                                "target_lang_word": "увлечение",
                                "target_lang_sense_clarification": "хобби, интерес"
                            },
                            {
                                "target_lang_word": "пристрастие",
                                "target_lang_sense_clarification": "склонность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tutku",
                                "target_lang_sense_clarification": "büyük ilgi duyulan uğraş"
                            },
                            {
                                "target_lang_word": "merak",
                                "target_lang_sense_clarification": "güçlü ilgi, hobi"
                            },
                            {
                                "target_lang_word": "düşkünlük",
                                "target_lang_sense_clarification": "aşırı sevgi ve ilgi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱好",
                                "target_lang_sense_clarification": "特别喜爱的活动"
                            },
                            {
                                "target_lang_word": "热衷的事",
                                "target_lang_sense_clarification": "投入大量兴趣的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b72ef527-e92a-397f-bd7c-2a0d2642fab6",
                    "sense_definition": "Intense sexual love or desire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their marriage was full of <w>passion</w> but lacked communication.",
                            "target_lang_translations": {
                                "ru": "Их брак был полон <w>страсти</w>, но в нём не хватало общения.",
                                "tr": "Evlilikleri <w>tutku</w> doluydu ama iletişimden yoksundu.",
                                "zh": "他们的婚姻充满了<w>情欲</w>，却缺乏沟通。"
                            }
                        },
                        {
                            "text": "It was described as a crime of <w>passion</w> committed in a moment of fury.",
                            "target_lang_translations": {
                                "ru": "Это было описано как преступление на почве <w>страсти</w>, совершенное в момент ярости.",
                                "tr": "Bir öfke anında işlenmiş bir <w>hiddet</w> suçu olarak tanımlandı.",
                                "zh": "这被描述为在愤怒瞬间犯下的<w>激情</w>犯罪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crime of passion",
                        "night of passion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная чувственная любовь или желание.",
                        "tr": "Yoğun cinsel sevgi veya arzu.",
                        "zh": "强烈的性爱或欲望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "чувственное влечение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tutku",
                                "target_lang_sense_clarification": "güçlü arzu ve aşk"
                            },
                            {
                                "target_lang_word": "ihtiras",
                                "target_lang_sense_clarification": "şehvetli güçlü arzu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情欲",
                                "target_lang_sense_clarification": "感官上的强烈欲望"
                            },
                            {
                                "target_lang_word": "激情",
                                "target_lang_sense_clarification": "指代男女间强烈的爱欲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcb84be7-790a-3064-8691-f77ac0524e38",
                    "sense_definition": "The state of being acted upon by an external force; the opposite of action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this philosophical theory, <w>passion</w> is contrasted directly with action.",
                            "target_lang_translations": {
                                "ru": "В этой философской теории <w>претерпевание</w> прямо противопоставляется действию.",
                                "tr": "Bu felsefi teoride <w>edilgenlik</w>, doğrudan eylemle karşılaştırılır.",
                                "zh": "在这个哲学理论中，<w>被动性</w>与主动行为直接对立。"
                            }
                        },
                        {
                            "text": "The <w>passion</w> of the object under the influence of gravity was calculated.",
                            "target_lang_translations": {
                                "ru": "Было рассчитано <w>претерпевание</w> объекта под воздействием гравитации.",
                                "tr": "Yerçekimi etkisi altındaki nesnenin <w>pasif etkilenimi</w> hesaplandı.",
                                "zh": "计算了物体在重力影响下的<w>受动性</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "action"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "philosophical or scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние подверженности воздействию внешней силы; противоположность действию.",
                        "tr": "Dış bir gücün etkisinde kalma durumu; eylemin karşıtı, edilgenlik.",
                        "zh": "受外力作用的状态；与主动行为相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претерпевание",
                                "target_lang_sense_clarification": "философский термин"
                            },
                            {
                                "target_lang_word": "пассивность",
                                "target_lang_sense_clarification": "отсутствие действия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "edilgenlik",
                                "target_lang_sense_clarification": "felsefi terim, eylemsizlik"
                            },
                            {
                                "target_lang_word": "pasiflik",
                                "target_lang_sense_clarification": "dış etkiye açık olma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被动性",
                                "target_lang_sense_clarification": "哲学或物理学中的受动状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac683b27-0cad-388e-98a8-e43fd54ec09c",
                    "sense_definition": "The sufferings of Jesus Christ during the period leading up to and including his crucifixion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_1",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "The church organizes a play every year to depict the <w>Passion</w>.",
                            "target_lang_translations": {
                                "ru": "Церковь каждый год организует спектакль, изображающий <w>Страсти</w>.",
                                "tr": "Kilise her yıl <w>İsa'nın Çilesi</w>'ni tasvir eden bir oyun düzenler.",
                                "zh": "教会每年都会组织一场戏来描绘耶稣的<w>受难</w>。"
                            }
                        },
                        {
                            "text": "Many classical paintings illustrate scenes from the <w>Passion</w> of Christ.",
                            "target_lang_translations": {
                                "ru": "Многие классические картины иллюстрируют сцены из <w>Страстей</w> Христовых.",
                                "tr": "Birçok klasik tablo İsa'nın <w>Çilesi</w>'nden sahneleri tasvir eder.",
                                "zh": "许多古典绘画都描绘了基督<w>受难</w>的场景。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдания Иисуса Христа в период, предшествующий его распятию, и само распятие.",
                        "tr": "İsa Mesih'in çarmıha gerilme sürecindeki ve öncesindeki acıları.",
                        "zh": "耶稣基督在受难期间所经历的苦难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Страсти",
                                "target_lang_sense_clarification": "религиозное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "İsa'nın Çilesi",
                                "target_lang_sense_clarification": "dini terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受难",
                                "target_lang_sense_clarification": "宗教术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                    "sense_definition": "To suffer pain, sorrow, or strong emotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protagonist <w>passioned</w> wildly over his tragic fate in the play.",
                            "target_lang_translations": {
                                "ru": "Главный герой бурно <w>страдал</w> из-за своей трагической судьбы в пьесе.",
                                "tr": "Ana karakter oyunda trajik kaderi karşısında çılgınca <w>acı çekti</w>.",
                                "zh": "剧中主角为自己的悲惨命运而疯狂地<w>受苦</w>。"
                            }
                        },
                        {
                            "text": "She <w>passioned</w> in silence, unable to share her grief with anyone.",
                            "target_lang_translations": {
                                "ru": "Она <w>страдала</w> молча, не в силах ни с кем поделиться своим горем.",
                                "tr": "Üzüntüsünü kimseyle paylaşamayarak sessizlik içinde <w>ızdırap çekti</w>.",
                                "zh": "她默默地<w>煎熬</w>着，无法与任何人分享她的悲伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suffer",
                        "agonize",
                        "grieve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать боль, горе или сильные эмоции.",
                        "tr": "Acı, keder veya güçlü duygular çekmek.",
                        "zh": "遭受痛苦、悲伤或强烈的负面情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдать",
                                "target_lang_sense_clarification": "испытывать муки"
                            },
                            {
                                "target_lang_word": "сокрушаться",
                                "target_lang_sense_clarification": "сильно горевать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "acı çekmek",
                                "target_lang_sense_clarification": "keder ve ızdırap duymak"
                            },
                            {
                                "target_lang_word": "ızdırap duymak",
                                "target_lang_sense_clarification": "yoğun duygu ve acı yaşamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受苦",
                                "target_lang_sense_clarification": "经历痛苦"
                            },
                            {
                                "target_lang_word": "煎熬",
                                "target_lang_sense_clarification": "内心极度痛苦"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}