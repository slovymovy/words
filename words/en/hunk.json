{
    "word_family": [
        "hunky",
        "hunkiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cdfb325-0466-3c24-a7ed-4e30874727e2",
                    "sense_definition": "A large or dense piece of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cut a thick <w>hunk</w> of bread and spread it with butter.",
                            "target_lang_translations": {
                                "ru": "Он отрезал толстый <w>ломоть</w> хлеба и намазал его маслом.",
                                "zh": "他切下一大<w>块</w>厚面包，在上面抹了黄油。",
                                "es": "Cortó un <w>trozo</w> grueso de pan y lo untó con mantequilla."
                            }
                        },
                        {
                            "text": "The sculptor started with a massive <w>hunk</w> of metal before shaping it.",
                            "target_lang_translations": {
                                "ru": "Скульптор начал с массивной <w>глыбы</w> металла, прежде чем придать ей форму.",
                                "zh": "雕塑家先从一大<w>块</w>金属开始，然后再把它塑形成形。",
                                "es": "El escultor comenzó con un <w>bloque</w> masivo de metal antes de darle forma."
                            }
                        }
                    ],
                    "synonyms": [
                        "chunk",
                        "lump",
                        "piece",
                        "portion",
                        "block"
                    ],
                    "antonyms": [
                        "crumb",
                        "fragment",
                        "scrap"
                    ],
                    "common_phrases": [
                        "hunk of bread",
                        "hunk of cheese",
                        "hunk of meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой или плотный кусок чего-либо.",
                        "zh": "某物的一大块或厚实的一块。",
                        "es": "Un trozo grande o denso de algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "обычно о еде, например, хлебе"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "общий термин для части чего-либо"
                            },
                            {
                                "target_lang_word": "глыба",
                                "target_lang_sense_clarification": "о чем-то массивном, например, металле или камне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "指较大较厚的一块东西，常用于食物、金属等"
                            },
                            {
                                "target_lang_word": "大块",
                                "target_lang_sense_clarification": "强调分量大、块头大"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pedazo",
                                "target_lang_sense_clarification": "término general para una parte o porción de un todo"
                            },
                            {
                                "target_lang_word": "trozo",
                                "target_lang_sense_clarification": "fragmento o parte de algo, muy común para comida"
                            },
                            {
                                "target_lang_word": "bloque",
                                "target_lang_sense_clarification": "referido a algo sólido, grande y pesado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9d23f02-b6a1-312a-89ff-f6d256c1d4aa",
                    "sense_definition": "An attractive man, especially one who is muscular.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attractive person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie star is a total <w>hunk</w> and has fans all over the world.",
                            "target_lang_translations": {
                                "ru": "Эта кинозвезда — настоящий <w>красавец</w>, у него фанаты по всему миру.",
                                "zh": "这位电影明星简直是个<w>帅哥</w>，在全世界都有粉丝。",
                                "es": "La estrella de cine es un <w>guapetón</w> total y tiene fans en todo el mundo."
                            }
                        },
                        {
                            "text": "She described her new boyfriend as a strapping <w>hunk</w> who spends hours at the gym.",
                            "target_lang_translations": {
                                "ru": "Она описала своего нового парня как статного <w>красавчика</w>, который часами пропадает в спортзале.",
                                "zh": "她形容她的新男友是个身材健壮的<w>猛男</w>，每天在健身房待上好几个小时。",
                                "es": "Describió a su nuevo novio como un <w>galán</w> corpulento que pasa horas en el gimnasio."
                            }
                        }
                    ],
                    "synonyms": [
                        "beefcake",
                        "stud",
                        "dreamboat",
                        "stud muffin",
                        "heartthrob"
                    ],
                    "common_phrases": [
                        "strapping hunk",
                        "total hunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательный, мускулистый мужчина.",
                        "zh": "有魅力的男人，尤指身材健壮的。",
                        "es": "Un hombre atractivo, especialmente si es musculoso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красавец",
                                "target_lang_sense_clarification": "очень красивый мужчина"
                            },
                            {
                                "target_lang_word": "красавчик",
                                "target_lang_sense_clarification": "разговорное, часто о привлекательном парне"
                            },
                            {
                                "target_lang_word": "атлет",
                                "target_lang_sense_clarification": "подчеркивает мускулистое телосложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帅哥",
                                "target_lang_sense_clarification": "口语，指长得很有吸引力的男人"
                            },
                            {
                                "target_lang_word": "猛男",
                                "target_lang_sense_clarification": "强调身材健壮、很有男性魅力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "guapetón",
                                "target_lang_sense_clarification": "aumentativo de guapo, usado para hombres muy atractivos"
                            },
                            {
                                "target_lang_word": "galán",
                                "target_lang_sense_clarification": "hombre de buen aspecto y bien proporcionado"
                            },
                            {
                                "target_lang_word": "mino",
                                "target_lang_sense_clarification": "término coloquial en Chile y Argentina para un hombre atractivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c0ddd87-8338-3abd-8aa9-f6264435e717",
                    "sense_definition": "A record of differences between almost contiguous portions of two files, used in software patching.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patch failed because one <w>hunk</w> could not be applied to the source code.",
                            "target_lang_translations": {
                                "ru": "Патч не удалось применить, так как один <w>фрагмент</w> не подошел к исходному коду.",
                                "zh": "补丁失败了，因为其中一个<w>代码块</w>无法应用到源代码中。",
                                "es": "El parche falló porque un <w>fragmento</w> no pudo aplicarse al código fuente."
                            }
                        },
                        {
                            "text": "Each <w>hunk</w> in the diff file shows exactly which lines were changed.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>ханк</w> в файле различий показывает, какие именно строки были изменены.",
                                "zh": "diff 文件中的每个<w>差异块</w>都准确显示了哪些行被改动了。",
                                "es": "Cada <w>bloque</w> en el archivo diff muestra exactamente qué líneas fueron cambiadas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diff hunk",
                        "patch hunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись различий между частями двух файлов, используемая при создании патчей в ПО.",
                        "zh": "软件打补丁时使用的、记录两个文件中相邻部分差异的一个片段。",
                        "es": "Un registro de diferencias entre partes de dos archivos, usado en programación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ханк",
                                "target_lang_sense_clarification": "технический жаргон программистов"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть кода в диффе или патче"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代码块",
                                "target_lang_sense_clarification": "编程中指补丁或 diff 里的一个代码片段单位"
                            },
                            {
                                "target_lang_word": "差异块",
                                "target_lang_sense_clarification": "强调文件比较结果中的一个差异单元"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fragmento",
                                "target_lang_sense_clarification": "parte de código o archivo"
                            },
                            {
                                "target_lang_word": "bloque",
                                "target_lang_sense_clarification": "sección de cambios en un archivo de diferencias"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f493533-c0f4-3896-be98-ade70155c8bd",
                    "sense_definition": "An unrefined or unsophisticated person from the country.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city dwellers looked down on him as just another country <w>hunk</w>.",
                            "target_lang_translations": {
                                "ru": "Городские жители смотрели на него свысока, как на очередную <w>деревенщину</w>.",
                                "zh": "城里人看不起他，只把他当成又一个乡下<w>土包子</w>。",
                                "es": "Los habitantes de la ciudad lo miraban por encima del hombro como a otro <w>paleto</w> de campo."
                            }
                        },
                        {
                            "text": "He was tired of being treated like a <w>hunk</w> just because of his accent.",
                            "target_lang_translations": {
                                "ru": "Он устал от того, что с ним обращаются как с <w>деревенщиной</w> только из-за его акцента.",
                                "zh": "他厌倦了别人仅仅因为他的口音就把他当成<w>乡巴佬</w>。",
                                "es": "Estaba cansado de que lo trataran como a un <w>cateto</w> solo por su acento."
                            }
                        }
                    ],
                    "synonyms": [
                        "hick",
                        "yokel",
                        "rube",
                        "hayseed",
                        "country bumpkin"
                    ],
                    "antonyms": [
                        "sophisticate"
                    ],
                    "common_phrases": [
                        "country hunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or specific slang"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотесанный или простоватый деревенский житель.",
                        "zh": "指来自乡下、举止粗俗或不够世故的人。",
                        "es": "Una persona del campo, considerada poco refinada o rústica."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "пренебрежительное о жителе деревни"
                            },
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "неотесанный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乡巴佬",
                                "target_lang_sense_clarification": "贬义，指没见过世面的乡下人"
                            },
                            {
                                "target_lang_word": "土包子",
                                "target_lang_sense_clarification": "贬义，指粗俗、不够老练的人"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "paleto",
                                "target_lang_sense_clarification": "término despectivo para alguien rústico o sin educación"
                            },
                            {
                                "target_lang_word": "cateto",
                                "target_lang_sense_clarification": "persona de campo con modales poco refinados"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad03c359-c358-3953-b9dd-474aa00d53a1",
                    "sense_definition": "A goal or base in children's games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran toward the <w>hunk</w> to stay safe from the seeker.",
                            "target_lang_translations": {
                                "ru": "Дети побежали к <w>базе</w>, чтобы спастись от водящего.",
                                "zh": "孩子们朝着<w>安全区</w>跑去，好躲开抓人的人。",
                                "es": "Los niños corrieron hacia la <w>base</w> para estar a salvo del que busca."
                            }
                        },
                        {
                            "text": "In this game, once you touch the <w>hunk</w>, you are home free.",
                            "target_lang_translations": {
                                "ru": "В этой игре, как только ты касаешься <w>дома</w>, ты в безопасности.",
                                "zh": "在这个游戏里，你一碰到<w>基地</w>就安全了。",
                                "es": "En este juego, una vez que tocas la <w>casa</w>, estás a salvo."
                            }
                        }
                    ],
                    "synonyms": [
                        "base",
                        "goal",
                        "home"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to certain dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель или база в детских играх.",
                        "zh": "儿童游戏中的目标点或安全基地。",
                        "es": "Una base o punto de seguridad en juegos infantiles."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "безопасное место в игре"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "конечная точка в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安全区",
                                "target_lang_sense_clarification": "儿童游戏中碰到后就安全的地方"
                            },
                            {
                                "target_lang_word": "基地",
                                "target_lang_sense_clarification": "游戏中的基地或保命点"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "base",
                                "target_lang_sense_clarification": "lugar seguro en un juego"
                            },
                            {
                                "target_lang_word": "casa",
                                "target_lang_sense_clarification": "punto de llegada o refugio en juegos infantiles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}