                ],
                "senses": [
                    {
                        "sense_id": "74fbbe2d-3a58-35af-bf6a-07d97d8e2b00",
                        "entry_id": "0dd6e226-e4e6-3edd-845f-ba48aeba7b71",
                        "glosses": [
                            "Überzug aus Stoff für Bettdecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2248423d-8494-4027-9bfd-1e557b10004b",
                                "sense_id": "74fbbe2d-3a58-35af-bf6a-07d97d8e2b00",
                                "text": "„Die gewerblichen Großbügelmaschinen, sogenannte Heißmangeln mit einem Durchlauf in der Breite von Bettbezügen, wurden früher häufig auch in eigenen Betrieben zur Selbstbedienung zur Verfügung gestellt.“"
                            },
                            {
                                "example_id": "d2d8134c-1c77-429a-8ff1-8435c843f9b2",
                                "sense_id": "74fbbe2d-3a58-35af-bf6a-07d97d8e2b00",
                                "text": "„Auf gestickte Monogramme sollte man ebenfalls verzichten, denn künftige Lebensabschnittsgefährten schlafen nicht gerne in Bettbezügen mit den Initialen ihrer Vorgänger.“"
                            },
                            {
                                "example_id": "538933c4-d054-4ed8-8f03-a7275b5e82d4",
                                "sense_id": "74fbbe2d-3a58-35af-bf6a-07d97d8e2b00",
                                "text": "„Und die Krönung: Das Paket, in dem das alles verpackt ist und geliefert wird, ist gleichzeitig ein Kinderbett mit Matratze und Bettbezug.“"
                            },
                            {
                                "example_id": "60dc3b40-e84c-4066-b62b-9e116d5107a1",
                                "sense_id": "74fbbe2d-3a58-35af-bf6a-07d97d8e2b00",
                                "text": "„Der weiße Bettbezug mit Blumenstickereien lag eng an ihrem Körper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
