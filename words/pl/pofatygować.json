    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4966de94-0076-31b8-b0c3-112807273603",
                    "sense_definition": "sprawić komuś kłopot lub zakłócić spokój",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kłopot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie chciałem <w>pofatygować</w> sąsiadów późnym wieczorem.",
                            "target_lang_translations": {
                                "ru": "Я не хотел <w>беспокоить</w> соседей поздним вечером."
                            }
                        },
                        {
                            "text": "Czy mogę cię o coś <w>pofatygować</w> w wolnej chwili?",
                            "target_lang_translations": {
                                "ru": "Могу я <w>побеспокоить</w> тебя кое-чем в свободную минуту?"
                            }
                        }
                    ],
                    "synonyms": [
                        "kłopotać",
                        "niepokoić",
                        "absorbować"
                    ],
                    "target_lang_definitions": {
                        "ru": "доставить кому-либо неудобство или потревожить чей-либо покой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "причинять неудобство, отвлекать"
                            },
                            {
                                "target_lang_word": "утруждать",
                                "target_lang_sense_clarification": "заставлять кого-то делать что-то обременительное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07558eb4-19ca-3274-84ca-b4dc9bd761cf",
                    "sense_definition": "zadać sobie trud zrobienia czegoś lub przyjścia gdzieś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie musisz się <w>pofatygować</w> osobiście, wystarczy telefon.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужно <w>удосуживаться</w> приходить лично, достаточно позвонить."
                            }
                        },
                        {
                            "text": "Dziękuję, że <w>pofatygowałeś</w> się, aby nam pomóc.",
                            "target_lang_translations": {
                                "ru": "Спасибо, что <w>потрудился</w> прийти, чтобы нам помочь."
                            }
                        }
                    ],
                    "synonyms": [
                        "trudzić się",
                        "wysilać się"
                    ],
                    "common_phrases": [
                        "pofatygować się osobiście"
                    ],
                    "target_lang_definitions": {
                        "ru": "взять на себя труд сделать что-либо или прийти куда-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удосужиться",
                                "target_lang_sense_clarification": "найти время или желание сделать что-то"
                            },
                            {
                                "target_lang_word": "потрудиться",
                                "target_lang_sense_clarification": "приложить усилия для выполнения действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
