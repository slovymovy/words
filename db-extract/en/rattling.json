                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e0ad8c2-41ef-4e56-b90a-935cef84047a",
                        "source_entry_id": "8f285ae5-b043-3cbf-926d-855751aa895e",
                        "source_sense_id": "9d818f1a-4836-30ca-8c9f-b225091a4628",
                        "source_sense_description": "a sound made by loose object shaking against one another",
                        "target_lang_word": "Klappern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
