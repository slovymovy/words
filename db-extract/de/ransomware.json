                ],
                "senses": [
                    {
                        "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                        "entry_id": "5daef05f-8e55-3123-b230-f093168202d7",
                        "glosses": [
                            "Schadsoftware, die Daten auf fremden Computern verschlüsselt und nur gegen eine Zahlung von Geld oder Internetwährungen wieder entschlüsselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4348ee9b-cfb9-4f25-b0dc-b7c435e0318d",
                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                "text": "„Wahrscheinlich gelangte die Ransomware über eine infizierte E-Mail in das Netzwerk der Polizeistation von Midlothian, sagte der mit dem Fall befasste IT-Fachmann Calvin Harden der amerikanischen Zeitung.“"
                            },
                            {
                                "example_id": "eab9c85e-3a8b-446e-aaa1-3f46391ff019",
                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                "text": "„Kaspersky Lab ist es gelungen, die Verschlüsselung der Ransomware CryptXXX zu knacken.“"
                            },
                            {
                                "example_id": "141ffff3-f9d2-4177-b023-4603bb05886e",
                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                "text": "„Inzwischen gibt es bei einigen Ransomwares Lösungen, wie man die Daten auch ohne das Bezahlen des Lösegelds wieder entschlüsselt bekommt.“"
                            },
                            {
                                "example_id": "001b2fd0-98c1-496c-aca7-f82301f1d366",
                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                "text": "„Bereits drei Mal in diesem Jahr haben Ransomwares wie ‚Locky‘, ‚Fanton‘ oder ‚Stampado‘ Schlagzeilen gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fcde651-219b-4efd-8de5-c9b0ecc5c4ff",
                        "source_entry_id": "5daef05f-8e55-3123-b230-f093168202d7",
                        "source_sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                        "target_lang_word": "ransomware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ransomware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                        "entry_id": "a1d8764a-c318-3f11-a2a7-b88609e38082",
                                        "glosses": [
                                            "Malware that holds the data of a computer user for ransom, usually requiring or claiming to require payment to restore access."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e219417-865c-4d7a-bfd9-e1c3bb8d4c45",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "The amount of money generated by ransomware schemes would appear to be quite small given their lack of popularity and the asking price in ransom notes […]"
                                            },
                                            {
                                                "example_id": "cc907eb9-0a12-49c3-87a9-86b7fd827dc6",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Garmin has been forced to shut down its call centres, website and some other online services after a ransomware attack encrypted the smartwatch maker’s internal network and some production systems."
                                            },
                                            {
                                                "example_id": "b8f585de-1333-419b-a500-636b7a2efe53",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Last March, Trenitalia, the Italian state-owned railway, suffered a major ransomware attack on its ticketing system, which disrupted sales at stations as well as passenger information screens."
                                            },
                                            {
                                                "example_id": "a25f70cf-66f0-4fa4-b7bd-2bb70686328d",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Cybersecurity firm Semperis found that 86% of surveyed organizations in the United States, United Kingdom, France and Germany that faced ransomware attacks were targeted on a holiday or weekend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "660d1b73-ae30-3e56-a084-376b09b33650",
                                        "entry_id": "a1d8764a-c318-3f11-a2a7-b88609e38082",
                                        "glosses": [
                                            "Software that is released as open source only in exchange for payment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294cce85-6f3c-4dcf-bd01-371ea9114056",
                                                "sense_id": "660d1b73-ae30-3e56-a084-376b09b33650",
                                                "text": "[I]n some situations, the source code of COTS may be escrowed and released under a free software or open source license when the original developer (or supplier) no longer continues to develop that software or if stipulated fundraising conditions are met. This model is referred to as the ransom model of software publishing and the software is known as ransomware."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d26a7f1-436d-4fa3-ac93-d07159849370",
                        "source_entry_id": "5daef05f-8e55-3123-b230-f093168202d7",
                        "source_sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                        "target_lang_word": "rançongiciel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rançongiciel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                        "entry_id": "e0b042b1-d9e6-34e2-b83d-cf5d842cb6e5",
                                        "glosses": [
                                            "Logiciel malveillant qui chiffre des données personnelles puis exige au propriétaire d’envoyer de l’argent en échange de la clé de déchiffrement."
                                        ],
                                        "tags": [
                                            "Sécurité informatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e69967-57fe-46c0-a7f7-09682c75e40e",
                                                "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                                "text": "Le groupe cybercriminel, spécialisé dans le rançongiciel – ces virus conçus pour paralyser des réseaux d’ordinateurs et demander une rançon aux victimes – s’était positionné, en quelques années, parmi les gangs les plus actifs de ce milieu."
                                            },
                                            {
                                                "example_id": "560aa5ec-5fc6-40c5-a4b4-db487109d791",
                                                "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                                "text": "Le cyberspace regorge de redoutables et insidieux prédateurs : bots, chevaux de Troie, logiciels espions, rançongiciels et autres amateurs de phishing, de pharming, d’attaging et d’usurpation d’identité."
                                            },
                                            {
                                                "example_id": "8d467511-02f9-449d-8759-6dfbe3f7cfd3",
                                                "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                                "text": "« Oups, vos fichiers ont été encodés », signale l’écran parasite, qui exige le paiement de 300 dollars (275 euros) sous peine d’effacement des contenus. Selon le NHS, qui a ouvert une enquête, l’attaquant a utilisé WannaCry, un virus de type « ransomware » (« rançongiciel ») qui se diffuse par le biais des courriels mais qui n’aurait pas pu accéder aux données personnelles des patients."
                                            },
                                            {
                                                "example_id": "d96c0414-c979-4bb3-b6ef-9499f76fd036",
                                                "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                                "text": "Les autorités américaines ont annoncé, jeudi, avoir démantelé le réseau de rançongiciel Hive."
                                            },
                                            {
                                                "example_id": "41751ea8-8918-449b-b3aa-48b415464af3",
                                                "sense_id": "e8c8f203-3fcb-36f8-986b-89068d7579d0",
                                                "text": "Nous devons également redoubler d’efforts pour protéger la sécurité de nos systèmes de santé, qui sont de plus en plus la cible de cyberattaques et d’attaques par rançongiciels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a08e950a-e98f-4d29-b58e-438949d71b0a",
                        "source_entry_id": "5daef05f-8e55-3123-b230-f093168202d7",
                        "source_sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
