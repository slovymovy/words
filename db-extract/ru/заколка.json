                                        "glosses": [
                                            "A clasp or clip for gathering and holding the hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c7c715-3415-4d0b-8e02-a025c7fad0a5",
                                                "sense_id": "23ca0bf5-e9f2-3bc0-8f82-27841a19fdef",
                                                "text": "Growing sleepy, Rabbit stops before midnight at a roadside café for coffee. Somehow, though he can't put his finger on the difference, he is unlike the other customers. They sense it too, and look at him with hard eyes, eyes like little metal studs pinned into the white faces of young men sitting in zippered jackets in booths three to a girl, the girls with orange hair hanging like wiggly seaweed or loosely bound with gold barrettes like pirate treasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad3ca2ce-9bed-3c60-a4ae-a23527866722",
                                        "entry_id": "96c52609-bfc7-30b2-9e4e-6f4db7299bbe",
                                        "glosses": [
                                            "A bar used to mount medals of chivalric orders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dace0c5-7471-368c-a201-150e82ba74a8",
                                        "entry_id": "96c52609-bfc7-30b2-9e4e-6f4db7299bbe",
                                        "glosses": [
                                            "Synonym of katepimeron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "barrette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0833ebf0-b468-3136-87f0-d02e8bbfa9a1",
                                        "entry_id": "e435e01a-f7a7-3a6e-b422-08473e007799",
                                        "glosses": [
                                            "To put (hair) into a barrette."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dae8088-15fe-4e04-b430-2c42c9c0f75c",
                                                "sense_id": "0833ebf0-b468-3136-87f0-d02e8bbfa9a1",
                                                "text": "The standing woman is overweight, with scraped-back and barretted bleach- blond hair and a jowly face of detonated capillaries."
                                            },
                                            {
                                                "example_id": "421f6cc7-ae2c-4e7f-a35c-845a096859af",
                                                "sense_id": "0833ebf0-b468-3136-87f0-d02e8bbfa9a1",
                                                "text": "With her barretted white hair, blue eyes, and deep green sweater, Victoria is as perfectly put together as ever."
                                            },
                                            {
                                                "example_id": "4c7e67da-3223-4768-8d82-7d9ca9d53006",
                                                "sense_id": "0833ebf0-b468-3136-87f0-d02e8bbfa9a1",
                                                "text": "She pulled her long hair up and barretted it so that her long exotic earrings put the finishing touch to her exquisite appearance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
