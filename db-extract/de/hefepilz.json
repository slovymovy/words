                            {
                                "example_id": "cecc1c73-eb9f-45e1-a557-e945db972207",
                                "sense_id": "947a57e3-3aa3-365b-a2e0-f6aab41bf020",
                                "text": "Gärung ist nur in Gegenwart von Hefepilzen möglich."
