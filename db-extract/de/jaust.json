                        "sense_id": "58e6fd47-f18c-3950-9b12-f9146c3db91c",
                        "entry_id": "d4decfa1-ba3e-37ef-8031-c7baad341288",
                        "glosses": [
                            "(ungezogenes, freches) männliches Kind"
                        ],
                        "tags": [
