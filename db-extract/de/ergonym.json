                "senses": [
                    {
                        "sense_id": "c2a2b416-3044-3f17-b3a9-b11d9ba84257",
                        "entry_id": "4a9160f0-a1c4-3b62-8c5c-201523dc0993",
                        "glosses": [
                            "Bezeichnung für Gegenstände, die der Mensch geschaffen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da48ddb-e38c-43de-b9cf-17347a862125",
                                "sense_id": "c2a2b416-3044-3f17-b3a9-b11d9ba84257",
                                "text": "Zu den Ergonymen zählen Namen für Produkte."
                            },
                            {
                                "example_id": "692ea75d-f9c4-415f-aeb2-2f3cec98058c",
                                "sense_id": "c2a2b416-3044-3f17-b3a9-b11d9ba84257",
                                "text": "Platen betont, dass der Begriff Ergonym Kommerzielles anspricht und eine heterogene Menge von Dingen bezeichnet."
                            },
                            {
                                "example_id": "e00f28e4-d7cd-48a5-9bef-53d0bb7b415a",
                                "sense_id": "c2a2b416-3044-3f17-b3a9-b11d9ba84257",
                                "text": "„Ein wichtiges Kriterium macht auch die Bildung eines neuen Terminus nach einem bestimmten schon existierenden Modell aus, indem der systematische Charakter der onomastischen Termini berücksichtigt werden sollte, z. B. Anthroponym (gr. anthropos 'Mensch' + -onym), Toponym (gr. topos 'Ort' + -onym), Ergonym (gr. ergon 'Arbeit, Tätigkeit' + -onym) usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
