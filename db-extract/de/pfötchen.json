                        "target_lang_word": "papatte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papatte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "425ad925-5ee3-3a41-8929-460e1720767d",
                                        "entry_id": "7d37b282-c2c2-3c13-b6ae-d48aa8362960",
                                        "glosses": [
                                            "Diminutif de patte, utilisé en particulier pour parler à un chien."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a21d50-e7b4-4831-8332-ae565b9c2dda",
                                                "sense_id": "425ad925-5ee3-3a41-8929-460e1720767d",
                                                "text": "Écoute-moi ces esthètes à papattes d’épaule brailler leur grande musique avec du chocolat fourré dans la bouche, les vraies victoires ont le goût du praliné c’est bien connu […]."
                                            },
                                            {
                                                "example_id": "22572bba-edf9-463a-b8c2-4c9c120d234e",
                                                "sense_id": "425ad925-5ee3-3a41-8929-460e1720767d",
                                                "text": "Donne la papatte ! Donne !"
                                            },
                                            {
                                                "example_id": "c2427836-ff76-4e4a-a892-7131477ac8ad",
                                                "sense_id": "425ad925-5ee3-3a41-8929-460e1720767d",
                                                "text": "15 novembre 1940 – On ne va pas à la Pagode parce que le chien est malheureux quand on le laisse tout seul ; et il faut lui essuyer les papattes quand il pleut ou lui mettre ses bottes ridicules qui ne tiennent pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
