                "senses": [
                    {
                        "sense_id": "660c985f-b474-3087-a3d8-0e26f9d85be0",
                        "entry_id": "2b972147-e5d3-367f-9409-40e406682eaa",
                        "glosses": [
                            "Raffiner de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb9bf8b-57de-44b1-ab91-f60754dc9b3b",
                                "sense_id": "660c985f-b474-3087-a3d8-0e26f9d85be0",
                                "text": "On distingue, non pour se donner le luxe efféminé de surraffiner, d’être pour ainsi dire plus précieux que les précieux, mais pour se faire comprendre sans ambiguïté."
                            },
                            {
                                "example_id": "cd186e4b-efa9-4fe2-96ec-529a8d9d73cb",
                                "sense_id": "660c985f-b474-3087-a3d8-0e26f9d85be0",
                                "text": "Ils deviennent des mécaniques intellectuelles qui raffinent et surraffinent un produit indigent."
                            },
                            {
                                "example_id": "9d4ae469-3ede-4870-837f-84bce5e13121",
                                "sense_id": "660c985f-b474-3087-a3d8-0e26f9d85be0",
                                "text": "Ces propriétés pourtant primordiales ont été pour ainsi dire oubliées dans notre monde surtechnicisé, surdigitalisé, surraffiné etc."
                            }
                        ]
                    }
