                {
                    "sense_id": "aaf7f61d-c589-3cda-85ba-dd6009384025",
                    "sense_definition": "Een informele term voor koffie, vaak gebruikt in de regio Rotterdam.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dranken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we even een bakkie <w>pleur</w> gaan doen bij dat nieuwe tentje? ",
                            "target_lang_translations": {
                                "en": "Shall we go grab a cup of <w>coffee</w> at that new place?"
                            }
                        },
                        {
                            "text": "Na een lange dag werken gaat een bakkie <w>pleur</w> er altijd wel in.",
                            "target_lang_translations": {
                                "en": "After a long day of work, a cup of <w>joe</w> always hits the spot."
                            }
                        }
                    ],
                    "synonyms": [
                        "koffie",
                        "bakkie"
                    ],
                    "common_phrases": [
                        "bakkie pleur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Rotterdam"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal term for coffee, frequently used in the Rotterdam region."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coffee",
                                "target_lang_sense_clarification": "general term"
                            },
                            {
                                "target_lang_word": "cup of joe",
                                "target_lang_sense_clarification": "informal idiom"
                            },
                            {
                                "target_lang_word": "brew",
                                "target_lang_sense_clarification": "slang for coffee"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02670d19-90f5-34a2-b131-702a9c56f0cd",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>pleuren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>pleur</w> die oude kranten morgen wel bij het oud papier.",
                            "target_lang_translations": {
                                "en": "I'll <w>chuck</w> those old newspapers with the paper waste tomorrow."
                            }
                        },
                        {
                            "text": "Als ik niet uitkijk, <w>pleur</w> ik zo van mijn fiets af.",
                            "target_lang_translations": {
                                "en": "If I'm not careful, I'll <w>fall</w> right off my bike."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        },
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of the verb 'pleuren' (to throw, to fall)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "to toss something"
                            },
                            {
                                "target_lang_word": "chuck",
                                "target_lang_sense_clarification": "informal for throwing"
                            },
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "to tumble down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e54f702-4310-3db3-ba98-c2d2da3e23a0",
                    "sense_definition": "De gebiedende wijs van <w>pleuren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pleur</w> dat afval toch gewoon in de prullenbak in plaats van op straat!",
                            "target_lang_translations": {
                                "en": "Just <w>throw</w> that trash in the bin instead of on the street!"
                            }
                        },
                        {
                            "text": "<w>Pleur</w> op en laat me nu eindelijk eens met rust.",
                            "target_lang_translations": {
                                "en": "<w>Get lost</w> and finally leave me alone."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pleur op"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        },
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative mood of the verb 'pleuren' (to throw, to go away)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "command to toss"
                            },
                            {
                                "target_lang_word": "get lost",
                                "target_lang_sense_clarification": "command to leave (pleur op)"
                            },
                            {
                                "target_lang_word": "piss off",
                                "target_lang_sense_clarification": "vulgar command to leave"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "016c62e4-1e9c-3aa4-add3-957758834970",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>pleuren</w> bij inversie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pleur</w> je die oude troep nu eindelijk eens een keer weg?",
                            "target_lang_translations": {
                                "en": "Are you finally going to <w>dump</w> that old junk?"
                            }
                        },
                        {
                            "text": "Waarom <w>pleur</w> je dat zomaar op de grond?",
                            "target_lang_translations": {
                                "en": "Why are you just <w>throwing</w> that on the ground?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        },
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second-person singular present tense of 'pleuren' used in inversion (questions)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "to toss something"
                            },
                            {
                                "target_lang_word": "dump",
                                "target_lang_sense_clarification": "to discard carelessly"
                            }
                        ]
                    }
                }
            ]
