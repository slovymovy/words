                    "sense_id": "1725da1c-8d86-3480-8fcf-937e85aef026",
                    "sense_definition": "Iemand welkom heten of gedag zeggen met woorden of een gebaar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <groette> mij direct toen ik zijn huis binnenkwam.",
                            "target_lang_translations": {
                                "en": "He <greeted> me immediately when I entered his house.",
                                "ru": "Он сразу <поприветствовал> меня, когда я вошел в его дом.",
                                "pl": "Od razu mnie <przywitał>, gdy wszedłem do jego domu.",
                                "de": "Er <grüßte> mich sofort, als ich sein Haus betrat.",
                                "fr": "Il m'a <salué> immédiatement quand je suis entré dans sa maison.",
                                "it": "Mi ha <salutato> subito quando sono entrato in casa sua.",
                                "cs": "Okamžitě mě <pozdravil>, když jsem vešel do jeho domu.",
                                "tr": "Eve girdiğimde beni hemen <selamladı>.",
                                "es": "Él me <saludó> inmediatamente cuando entré en su casa.",
                                "zh": "我走进他家时，他立刻向我<w>问候</w>。"
                            }
                        },
                        {
                            "text": "Ik <groet> de buren altijd vriendelijk als ik ze op straat zie.",
                            "target_lang_translations": {
                                "en": "I always <greet> the neighbors kindly when I see them on the street.",
                                "ru": "Я всегда дружелюбно <здороваюсь> с соседями, когда вижу их на улице.",
                                "pl": "Zawsze przyjaźnie <witam> sąsiadów, gdy widzę ich na ulicy.",
                                "de": "Ich <grüße> die Nachbarn immer freundlich, wenn ich sie auf der Straße sehe.",
                                "fr": "Je <salue> toujours les voisins amicalement quand je les vois dans la rue.",
                                "it": "Saluto sempre i vicini gentilmente quando li vedo per strada.",
                                "cs": "Vždycky přátelsky <pozdravím> sousedy, když je vidím na ulici.",
                                "tr": "Komşuları sokakta gördüğümde her zaman nazikçe <selamlarım>.",
                                "es": "Siempre <saludo> amablemente a los vecinos cuando los veo en la calle.",
                                "zh": "我在街上见到邻居时，总是友好地跟他们<w>打招呼</w>。"
                            }
                        }
