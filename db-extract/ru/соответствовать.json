                    },
                    {
                        "form_id": "c200d8bf-10b6-4aa7-a12c-8d1cb6d9dcfd",
                        "entry_id": "77dcdb4f-b224-349b-9755-48c04a1e9b2d",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… соотве́тствовать"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bd41b61-8ae4-359f-a8d5-89141eb13510",
                        "entry_id": "77dcdb4f-b224-349b-9755-48c04a1e9b2d",
                        "glosses": [
                            "быть, находиться в соответствии с кем-либо, чем-либо; заключать в себе соответствие с кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40672a7a-8705-4514-9440-ccf888ed3c53",
                                "sense_id": "8bd41b61-8ae4-359f-a8d5-89141eb13510",
                                "text": "Успех, который он имел, очень долго, до смешного, не соответствовал его заслугам."
                            },
                            {
                                "example_id": "6bf6bac0-5a13-4a13-bc0e-e9010756bbb0",
                                "sense_id": "8bd41b61-8ae4-359f-a8d5-89141eb13510",
                                "text": "Рана проникающая… Произведена она режущим орудием и, как видно из собранных предварительных сведений, кинжалом, ширина которого вполне соответствовала величине раны."
                            },
                            {
                                "example_id": "fe6e3c16-f32c-469f-ab51-06c62c3f9d9f",
                                "sense_id": "8bd41b61-8ae4-359f-a8d5-89141eb13510",
                                "text": "Округ соответствует целой большой стране, губерния ― маленькой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce8ba257-dd80-4ccf-a021-03870358f39a",
                        "source_entry_id": "77dcdb4f-b224-349b-9755-48c04a1e9b2d",
                        "source_sense_id": "8bd41b61-8ae4-359f-a8d5-89141eb13510",
                        "target_lang_word": "correspond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correspond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1abab2cd-68c3-3ec6-ad63-bb301fc4ec02",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To be equivalent or similar in character, quantity, quality, origin, structure, function etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cda26be-b1fe-34ef-b19d-4cc8b9828c7c",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To exchange messages, especially by postal letter, over a period of time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb27d2c-cc39-4148-9f10-0f2b5d457d8d",
                                                "sense_id": "6cda26be-b1fe-34ef-b19d-4cc8b9828c7c",
                                                "text": "I've been corresponding with my German pen pal for three years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To have sex with."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c613ae-4ea1-488d-8bf8-55f359b304e9",
                                                "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                                "text": "He pleaded guilty to the charge, so far as acknowledging that he had corresponded with other women lately, in order to get the better of his affection for me, but the experiment had failed, and he found that he should be for ever miserable."
                                            },
                                            {
                                                "example_id": "b44ee733-b766-417d-90a7-6aa6082bbbf0",
                                                "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                                "text": "When a Babylonian and his wife had a mind to correspond, they always first lit up the fuming pan, imagining it improved the passion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "260578a2-3d62-4d32-ab3a-723b6105cba4",
