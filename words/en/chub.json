        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "387c126d-01ba-311c-9992-8d26dfe1ed26",
                    "sense_definition": "To delay or prevent the passage of a legislative bill through procedural tactics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minority party decided to <w>chub</w> the controversial bill to prevent it from reaching a vote.",
                            "target_lang_translations": {
                                "fr": "Le parti minoritaire a décidé de <w>faire de l'obstruction</w> sur le projet de loi controversé pour l'empêcher d'être soumis au vote."
                            }
                        },
                        {
                            "text": "Legislators often <w>chub</w> bills when they lack the votes to defeat them directly.",
                            "target_lang_translations": {
                                "fr": "Les législateurs font souvent de l'<w>obstruction</w> sur les projets de loi lorsqu'ils n'ont pas les voix nécessaires pour les rejeter directement."
                            }
                        }
                    ],
                    "synonyms": [
                        "filibuster"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the context of Texas politics."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Retarder ou empêcher le passage d'un projet de loi par des tactiques procédurales."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire de l'obstruction",
                                "target_lang_sense_clarification": "terme politique courant"
                            },
                            {
                                "target_lang_word": "filibuster",
                                "target_lang_sense_clarification": "terme technique emprunté à l'anglais"
                            }
                        ]
