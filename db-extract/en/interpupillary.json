                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0a36b94-033d-4b85-9c78-1ce5594e994e",
                                "sense_id": "877cf545-a82d-3cdc-be30-b7b756cfa59f",
                                "text": "The eyepiece tubes are adjusted for the correct interpupillary distance, that is, the distance between the pupils of one's eyes."
                            },
                            {
                                "example_id": "181cb183-ab04-40e9-ac0d-293fb89331e7",
                                "sense_id": "877cf545-a82d-3cdc-be30-b7b756cfa59f",
                                "text": "In connexion with a somewhat extensive research into the state of refraction, visual acuity, and interpupillary distance in the girls of a school in Heidelberg, Beselin (Arch. f. Augenh., xiv. 2) gives the following results with reference to the dynamic relations of the muscles […]"
                            },
                            {
                                "example_id": "03e742ba-bf90-4816-9580-ef14d1598bf0",
                                "sense_id": "877cf545-a82d-3cdc-be30-b7b756cfa59f",
                                "text": "I use a Bausch and Lomb Interpupillary Distance Gauge, which will give give^([sic]) the correct interpupillary distances for distance, intermediate, and close visions."
                            }
                        ]
                    }
