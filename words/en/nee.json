            "senses": [
                {
                    "sense_id": "6cbbdb89-808c-3cc7-8a05-b0d085fc48a1",
                    "sense_definition": "Born; originally called (used to indicate a woman's maiden name); alternative spelling of <w>née</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding announcement introduced Jane Miller, <w>nee</w> Smith, to the community.",
                            "target_lang_translations": {
                                "cs": "Svatební oznámení představilo komunitě Jane Millerovou, <w>rozenou</w> Smithovou."
                            }
                        },
                        {
                            "text": "Her grandmother was listed as Mary Evans, <w>nee</w> Davies, in the family records.",
                            "target_lang_translations": {
                                "cs": "V rodinných záznamech byla její babička uvedena jako Mary Evansová, <w>rozená</w> Daviesová."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozená; dříve jmenovaná (používá se k označení rodného příjmení ženy); alternativní pravopis slova née."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozená",
                                "target_lang_sense_clarification": "rodné příjmení ženy"
                            }
                        ]
                    }
                }
            ]
        },
        {
