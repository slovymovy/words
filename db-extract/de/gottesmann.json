                ],
                "senses": [
                    {
                        "sense_id": "6ccc59eb-4683-3b88-9e8d-75145ffdfd2b",
                        "entry_id": "b67b6744-3462-346c-ae44-828bca1d290a",
                        "glosses": [
                            "Geistlicher als Vertreter einer Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e8070b-6a58-4d31-acb8-9067c2024a5b",
                                "sense_id": "6ccc59eb-4683-3b88-9e8d-75145ffdfd2b",
                                "text": "„Vor allem aber sollten die Gottesmänner die Indigenen bekehren und zivilisieren.“"
                            },
                            {
                                "example_id": "aa830638-2d70-415a-b9df-2c1926c5ed47",
                                "sense_id": "6ccc59eb-4683-3b88-9e8d-75145ffdfd2b",
                                "text": "„Sie verstummen jedoch angesichts der Drohungen mit höheren Steuern und dem Verbot neuer Missionen, die der König gegenüber leitenden Gottesmännern dezent fallen lässt; und sie verhallen weitgehend ungehört – übertönt von königlicher Propaganda.“"
                            },
                            {
                                "example_id": "99712cd7-fd44-406c-8047-97a0913e9b6a",
                                "sense_id": "6ccc59eb-4683-3b88-9e8d-75145ffdfd2b",
                                "text": "„Als die Morgensonne langsam über die Wipfel der Eukalyptusbäume klettert, erzählt der Gottesmann, was es mit der Quelle unterhalb seiner Kirche auf sich hat.“"
                            },
                            {
                                "example_id": "7378850d-a92c-459d-96d4-31ec190cfce9",
                                "sense_id": "6ccc59eb-4683-3b88-9e8d-75145ffdfd2b",
                                "text": "„Der Protestant hat nur eine Kapelle, nüchterne Wände, einfache Fenster, und jetzt steht er neben dem katholischen Gottesmann wie ein armer Verwandter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
