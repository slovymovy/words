                ],
                "senses": [
                    {
                        "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                        "entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "glosses": [
                            "Gesetztheit und Würde ausstrahlende ältere Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a434733-630e-4a2c-8034-f5ce6f89c482",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„Otilia versucht ein Hotelzimmer zu mieten. In den Hotelrezeptionen thronen die kommunistischen Matronen, jede eine Rosa Luxemburg im Hausmeisterformat, und schütteln die Köpfe, bis sie durch Zigaretten bestochen werden.“"
                            },
                            {
                                "example_id": "941da815-fedb-4bba-814f-a4139ead0c8e",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„Sie ist die Matrone dieser Show, reif und redselig, und soll - so will es das Script - etwas mit Fidel und etwas mit Che gehabt haben: Eine nettes Gespräch?“"
                            },
                            {
                                "example_id": "98377918-f7a9-44bb-a5ba-dc3872d3d8f9",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„Nach seinem Eintritt machte er beim Anblick der Matrone vier Verbeugungen.“"
                            },
                            {
                                "example_id": "4ddd2397-3a98-411f-9998-0b0ce1ad3e9e",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„Die Teilnehmer setzten sich aus Männern und Matronen der älteren Behördenschaft zusammen, die mehr oder weniger maßgebliche Funktionen als Büroreferenten, Sachbearbeiter, Protokollführer und dergleichen ausübten.“"
                            },
                            {
                                "example_id": "f1223528-62b3-48d1-be82-c27ddae02f71",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„Die »Göttin Caiva« zählen die Religionswissenschaftler zu den Matronen.“"
                            },
                            {
                                "example_id": "660d3855-fcab-4f7d-9bf5-e868cf6fd67f",
                                "sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                                "text": "„ Unter seinem Giebeldach sitzen drei Matronen auf einer Bank, eine jüngere in der Mitte, zwei ältere, die sie flankieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f1019b51-b7c5-334f-a29d-a02066c36faa",
                        "entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "glosses": [
                            "ältere, füllige Frau"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e85d20d2-2637-435e-b5e9-25ddf53d2264",
                                "sense_id": "f1019b51-b7c5-334f-a29d-a02066c36faa",
                                "text": "„Es kommt verflixt heiß, mit mehr als 40 Grad, aus der Erde. Durchs Frauenbecken schreiten junge Mädchen im Bikini, Matronen ziehen ihre wadenlangen Baumwollhemden im Wasser hinter sich her wie Schleppen. Eine Stunde darf man hier verweilen.“"
                            },
                            {
                                "example_id": "e44ff190-49e5-42ee-a186-43e4e44deeca",
                                "sense_id": "f1019b51-b7c5-334f-a29d-a02066c36faa",
                                "text": "„Der Mann, das von der ehewütigen Matrone gejagte Wild, hudelt also hündisch vor Hürchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a6a92b38-3e4e-3221-930c-6ad6d5c81197",
                        "entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "glosses": [
                            "eine in Europa verehrte Muttergottheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a64bf6-e6ca-43b5-ac12-38336bec6df1",
                                "sense_id": "a6a92b38-3e4e-3221-930c-6ad6d5c81197",
                                "text": "„Eine Matrone (v. lat.: matrona: Frau von Stand, Familienmutter, ehrbare Ehefrau, vornehme Dame, Herrin und Gebieterin), selten auch Matres oder Matrae (für Mater als Schöpferin der Natur und aller Dinge sowie Urheberin, Quelle, Ursprung, Wurzel und Grund) genannt, öfter auch Dea oder Deae ist eine umfassende Muttergottheit, welcher zwischen dem ersten und fünften Jahrhundert in Europa von Angehörigen der in römischen Diensten stehenden Oberschicht Votivsteine und Altäre errichtet wurden. Die älteste bisher gefundene Inschrift lässt sich auf die Zeit zwischen 70 und 89 nach Christus datieren, die letzten 240 nach Christus.“"
                            },
                            {
                                "example_id": "34be686e-2fef-4079-a90c-334acc0e5e32",
                                "sense_id": "a6a92b38-3e4e-3221-930c-6ad6d5c81197",
                                "text": "„ Unter seinem Giebeldach sitzen drei Matronen auf einer Bank, eine jüngere in der Mitte, zwei ältere, die sie flankieren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2003d7e7-4195-424f-83df-c9241c3010cb",
                        "source_entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "source_sense_id": "da32846b-f49f-3c27-a5c9-895e14e39843",
                        "source_sense_description": "Gesetztheit und Würde ausstrahlende ältere Frau",
                        "target_lang_word": "dame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4946c4ef-65ca-364f-a692-7fff2dab840a",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "Usually capitalized as Dame: a title equivalent to Sir for a female knight."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13084578-e320-4f3a-abb1-a730db8ab2f8",
                                                "sense_id": "4946c4ef-65ca-364f-a692-7fff2dab840a",
                                                "text": "Dame Edith Sitwell"
                                            },
                                            {
                                                "example_id": "997cb448-4ecb-40d1-b6ff-4b98bf7c5f84",
                                                "sense_id": "4946c4ef-65ca-364f-a692-7fff2dab840a",
                                                "text": "The cover of the modern cd, issued by EMI Classics with Dame Janet Baker and Sir John Barbirolli in 1965, carries a portrait of Dame Janet wearing a long coral necklace in reference to the song 'Where the Corals lie' to words by Richard Garnett (1835–1906)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2faaad7f-8567-3ecd-9ade-7b6477997c2e",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "A matron at a school, especially Eton College."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594d3b9a-3f02-43ca-8f35-ee46ae23340f",
                                                "sense_id": "2faaad7f-8567-3ecd-9ade-7b6477997c2e",
                                                "text": "Even though the dames’ houses were being gradually phased out at Eton, [John Henry] Newman was enthusiastic about the arrangement since it met one of the promoters’ key demands; besides, he had experienced something similar as a boy at Ealing School, where the boarding houses were also under the jurisdiction of dames. The Ealing dames ensured that boys were properly dressed and cared for them when sick, and they also ran the tuck shops."
                                            },
                                            {
                                                "example_id": "adc02c3a-bb13-4d2d-a634-d64875673c2a",
                                                "sense_id": "2faaad7f-8567-3ecd-9ade-7b6477997c2e",
                                                "text": "As he [Fréderic Guyaz] worked for Topham [Beauclerk] while he was at Eton, it is likely that Topham was a day-boarder there, living at home in Windsor. His Eton \"dame\" was Mrs. Bland; day-boarders were allocated to a dame at whose house they took their meals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d795a8e-bdd6-3891-8cf9-4a4733c8b045",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "In traditional pantomime: a melodramatic female often played by a man in drag."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9536aaa-76aa-4997-a8cc-b69c7020921e",
                                                "sense_id": "2d795a8e-bdd6-3891-8cf9-4a4733c8b045",
                                                "text": "[page 73, column 2] Mother Goose was produced on the 29th of December; Simmons playing the Old Dame; […] [page 74, column 1] Bugle condemns her to the ducking-stool, a sentence opposed by Colin, who espouses the cause of the Old Dame, who, escaping from her persecutors, puts an end to the wedding festivities by raising the ghost of the Squire's first wife."
                                            },
                                            {
                                                "example_id": "4af36400-d17c-4f3d-a7a5-69de18c16695",
                                                "sense_id": "2d795a8e-bdd6-3891-8cf9-4a4733c8b045",
                                                "text": "The Dame in a Panto is generally a large, gregarious and out-going man who plays the part of a large, gregarious and out-going woman. […] Every successful actor who plays the part of Dame in Panto knows that the secret of his success is that it should be obvious that it is a man playing a part, for this is not a Drag act; the intention is not to be as womanly as possible, but always to be 'a feller in a frock'. […] Oh how everyone loves the Panto Dame for she is Panto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b626c59-f669-3d4f-abb7-409164ca055b",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "A woman."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbd67c0-732b-4e23-8a0b-f4d7a8d42c87",
                                                "sense_id": "5b626c59-f669-3d4f-abb7-409164ca055b",
                                                "text": "I can see that would be the kind of a chap that the dames would stand for everlastingly."
                                            },
                                            {
                                                "example_id": "1641dc8f-a4da-4b3e-8a96-8f6aab26923b",
                                                "sense_id": "5b626c59-f669-3d4f-abb7-409164ca055b",
                                                "text": "There is nothin' like a dame / Nothin' in the world. / There is nothin' you can name / That is anythin' like a dame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "A lady, a woman."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7557e8d8-7aed-45be-8edf-ec9746a76f06",
                                                "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                                "text": "Now, thou, deare dame, that workſte theſe ſweete effectes in mee, / Vouchsafe my zeale, that onely ſeeke to ſerve and honour thee."
                                            },
                                            {
                                                "example_id": "ab98f57f-82fa-414d-8c40-e20ecf7f4e81",
                                                "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                                "text": "[T]hough they were first-form'd dames of Earth, / And in whose sparcklinge and refulgent eyes / The glorious sonne did still delight to rise; […]"
                                            },
                                            {
                                                "example_id": "35d54aa8-e9c8-43c1-8a7f-7d0ff3e24f2f",
                                                "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                                "text": "And do you think my Dame Dobſon don't know a little better than you? She tells you, you need ſay no more, and 'tis an affront to her Art not to believe her; and I'le not ſee my Dame affronted."
                                            },
                                            {
                                                "example_id": "79da9a74-dc5d-4b49-90c4-7d8d6e5bae63",
                                                "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                                "text": "[H]e pointed his staff at a female figure on the path, in whom goodman Brown recognized a very pious and exemplary dame, who had taught him his catechism, in youth, and was still his moral and spiritual adviser, jointly with the minister and deacon Gookin."
                                            },
                                            {
                                                "example_id": "6207e99b-03b3-4298-be9d-0887c24f33c4",
                                                "sense_id": "13d4d90b-2ca7-3b44-ac8a-4d31db153629",
                                                "text": "The poetical relation between the pagan warrior and his celestial bride changed, in course of time, to that between the Christian knight and his ladye-bright, who also was not always an earthly dame, but the holy Virgin or some saint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a796d36e-269b-3807-a969-7d3b42573667",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "The hereditary feudal ruler (seigneur) of Sark, when the title is held by a woman in her own right."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "344defad-484a-33f8-9605-0454b8bb8df9",
                                        "entry_id": "bd83763e-e495-31ba-a248-1d9cc9e751db",
                                        "glosses": [
                                            "A queen."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                        "entry_id": "839ad855-66bf-36c3-a106-e783218e1451",
                                        "glosses": [
                                            "To make a dame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36dffa8-2990-4726-89af-b7fe6babb66c",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "The French call simply Pawn, “la Dame qui n’est point Damée, et l’on n’appelle Dame proprement dite, que le Pion qui est Damé, et couvert d’un autre Pion,” which means “the Draught or Pawn which is not damed, and which is only termed Dame or Queen, when the Pawn which is damed, is covered with another Pawn.”"
                                            },
                                            {
                                                "example_id": "a3f81074-7c25-471d-96be-7eb47dbded71",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "Jonathan’s first edition of Calais was signed by Dame Agatha [Christie]. Not as Dame Agatha, just plain Agatha. She got Damed later."
                                            },
                                            {
                                                "example_id": "7b70e074-058f-4458-b4d9-2c343fe23936",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "[…]Joanna Lumley, both pros in their respective fields, and both Brits in their respective hearts, are now both newly knighted (damed, in Lumley’s case) by England’s Queen Lizzy."
                                            },
                                            {
                                                "example_id": "4cd16f7c-b2da-4390-83a5-49653bf21cf5",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "Edna [Everage] was damed spontaneously, on camera, by the Socialist Australian prime minister Gough Whitlam."
                                            },
                                            {
                                                "example_id": "5a8b2716-665b-4fe6-8060-52f3c4704aa9",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "Peter Bradley, deputy leader of the Labour group, scoffed that she [Shirley Porter] had been ‘Damed with faint praise’ and further observed that every pantomime needs a Dame."
                                            },
                                            {
                                                "example_id": "15bb648b-924c-4328-8aed-fc17d392ba40",
                                                "sense_id": "e554a6cd-3af9-308d-a88a-1a153091558e",
                                                "text": "And then, of course, there was the dame-ing. It didn’t take much to be made a dame in the ’70s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d824ffb-7977-4df2-b47d-f7ef33826cd8",
                        "source_entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "source_sense_id": "f1019b51-b7c5-334f-a29d-a02066c36faa",
                        "source_sense_description": "abwertend: ältere, füllige Frau",
                        "target_lang_word": "matrone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matrone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4265f52-0f05-34da-8f75-ea011d99abc7",
                                        "entry_id": "dba2fac5-636f-3afb-a124-dea9628624dd",
                                        "glosses": [
                                            "Nom donné autrefois par les tribunaux aux sages-femmes qu’ils désignaient, dans certains procès, pour visiter des femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbd77ee-1c7e-4cd9-bcc5-59f34ac7c1ac",
                                                "sense_id": "e4265f52-0f05-34da-8f75-ea011d99abc7",
                                                "text": "Quant à moi, […], je souhaiterais que des châtiments vraiment effrayants frappassent ceux qui, médecins ou matrones, pour de l’argent, se font les instruments de tels crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e64293b-8eaa-3d47-b9cb-ac92153f842d",
                                        "entry_id": "dba2fac5-636f-3afb-a124-dea9628624dd",
                                        "glosses": [
                                            "Nom donné aux accoucheuses traditionnelles, notamment dans les pays où il n’existe pas de formation de sage-femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4a43f0-79c8-4a35-a6a9-8b1aabfb83fc",
                                                "sense_id": "3e64293b-8eaa-3d47-b9cb-ac92153f842d",
                                                "text": "Belle époque où l'on pouvait prolonger les gardes à vue au-delà du délai réglementaire, détourner les lignes téléphoniques de généralistes et répondre aux patientes en se faisant passer pour leurs assistants, puiser dans le stock sans fond des dénonciations de voisinage, enfoncer un coin dans les différends familiaux, les rivalités professionnelles, les jalousies, et ratisser large, de la matrone à l'herboriste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b726399-5602-30c5-aeb9-e804edc3f42e",
                                        "entry_id": "dba2fac5-636f-3afb-a124-dea9628624dd",
                                        "glosses": [
                                            "Dames romaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4bb057-e0e2-4136-a7fd-65daea795ca3",
                                                "sense_id": "6b726399-5602-30c5-aeb9-e804edc3f42e",
                                                "text": "Les vierges et les matrones."
                                            },
                                            {
                                                "example_id": "5dce7cfa-1c78-45f9-87b6-26be59ce9cb4",
                                                "sense_id": "6b726399-5602-30c5-aeb9-e804edc3f42e",
                                                "text": "La solennité de l’antique me séduit et aussi son côté salle de bains. Je pense au genre Messaline, aux matrones dévergondées. — (Michel Leiris, L’âge d’homme, 1939, collection Folio, page 55.)\n#* (Par analogie) — Lorsqu’ils furent entrés, ils se trouvèrent en présence d’une vingtaine de matrones et de jeunes filles de nobles familles saxonnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810f82b1-0cca-3a7b-aca9-1200017c4263",
                                        "entry_id": "dba2fac5-636f-3afb-a124-dea9628624dd",
                                        "glosses": [
                                            "Femme corpulente d’un certain âge, d’une certaine gravité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf1e284-f5e9-47e3-a5b5-14df7b79ddfb",
                                                "sense_id": "810f82b1-0cca-3a7b-aca9-1200017c4263",
                                                "text": "Il y a des engueulades qui rougissent les yeux, bleuissent les joues, crispent les poings, arrachent les cheveux, cassent les œufs, renversent les éventaires, dépoitraillent les matrones, et me remplissent d’une joie pure."
                                            },
                                            {
                                                "example_id": "1d01594b-4d8e-499c-a004-ede72643fd1b",
                                                "sense_id": "810f82b1-0cca-3a7b-aca9-1200017c4263",
                                                "text": "Une plantureuse matrone se coiffe avec majesté d’un tarbouche à glands d’or, orné sur le devant d’un croissant de cuivre."
                                            },
                                            {
                                                "example_id": "251b7211-c21a-44bb-babc-42442f2cced5",
                                                "sense_id": "810f82b1-0cca-3a7b-aca9-1200017c4263",
                                                "text": "Je compris que Zaza avait eu besoin de solitude, de sensations violentes, et peut-être aussi d’une purification après ce gluant après-midi et je me rassérénai : elle n’était pas encore prête à se laisser couler dans le sommeil satisfait des matrones."
                                            },
                                            {
                                                "example_id": "995632e9-0e60-49a0-85cd-db83f09cd7e2",
                                                "sense_id": "810f82b1-0cca-3a7b-aca9-1200017c4263",
                                                "text": "[…], mais la brave matrone ne se tient point rigueur d'avoir laissé ses propres enfants pousser comme du chiendent, dès lors qu’elle est restée fidèle à son époux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "391a67ab-3e7f-44d5-ba98-4b722fbcebec",
                        "source_entry_id": "340f6be5-55db-34b1-8b02-742355b73c8e",
                        "source_sense_id": "a6a92b38-3e4e-3221-930c-6ad6d5c81197",
                        "source_sense_description": "Geschichte: eine in Europa verehrte Muttergottheit",
                        "target_lang_word": "matrone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matrone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4265f52-0f05-34da-8f75-ea011d99abc7",
                                        "entry_id": "dba2fac5-636f-3afb-a124-dea9628624dd",
                                        "glosses": [
                                            "Nom donné autrefois par les tribunaux aux sages-femmes qu’ils désignaient, dans certains procès, pour visiter des femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbd77ee-1c7e-4cd9-bcc5-59f34ac7c1ac",
                                                "sense_id": "e4265f52-0f05-34da-8f75-ea011d99abc7",
                                                "text": "Quant à moi, […], je souhaiterais que des châtiments vraiment effrayants frappassent ceux qui, médecins ou matrones, pour de l’argent, se font les instruments de tels crimes."
                                            }
                                        ]
                                    },
