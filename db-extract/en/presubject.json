                "senses": [
                    {
                        "sense_id": "bb650f78-53e6-39fd-9de4-d9876d76370f",
                        "entry_id": "c479bdbc-bc6f-36e9-8922-dac358a177e7",
                        "glosses": [
                            "Occurring before the subject in a sentence or expression."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f8e655e-eeae-4808-9345-1622f3400b0f",
                                "sense_id": "bb650f78-53e6-39fd-9de4-d9876d76370f",
                                "text": "Presubject elements may be conjunctions, prepositional groups, nonfinite clauses, or whole dependent clauses that precede the grammatical subject of the main clause."
                            },
                            {
                                "example_id": "26b627fa-fa82-4767-a0bd-3ed486793cf4",
                                "sense_id": "bb650f78-53e6-39fd-9de4-d9876d76370f",
                                "text": "Tense/aspect/mood (tam) particles furnish a broad range of conjugation patterns (i.e. patterns in which verb stem can appear) and can be subdivided into two positional classes of preverbal and presubject particles."
                            },
                            {
                                "example_id": "14f4ba26-b916-492b-8610-08df3f488f97",
                                "sense_id": "bb650f78-53e6-39fd-9de4-d9876d76370f",
                                "text": "These may occur in presubject position, prepredicate position, within the verb phrase, preceding equated attributives, and final to the clause."
                            }
                        ]
                    }
