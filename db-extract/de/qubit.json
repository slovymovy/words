                "senses": [
                    {
                        "sense_id": "625fd3c9-d748-3713-bcc9-7b3dbd1c0c53",
                        "entry_id": "02fe9740-2a26-393b-b358-1dc0a70fce3c",
                        "glosses": [
                            "Maßeinheit für die kleinste auf Quantencomputern darstellbare Informationseinheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3aa554d-a696-4742-99bd-63a75edc951c",
                                "sense_id": "625fd3c9-d748-3713-bcc9-7b3dbd1c0c53",
                                "text": "„Die dort agierenden Quantenbits, die ‚Qubits‘ genannt wurden, agierten bei einer Temperatur von rund -273 Grad Celsius, also nahe dem absoluten Nullpunkt.“"
                            },
                            {
                                "example_id": "145de644-0ac8-47d4-aa96-222a18e6d2fd",
                                "sense_id": "625fd3c9-d748-3713-bcc9-7b3dbd1c0c53",
                                "text": "„Quantencomputer dagegen arbeiten mit Qubits, sie können 0 und 1 zugleich darstellen, genauso wie sich in der Quantenwelt ein Elektron an zwei Orten gleichzeitig befinden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
