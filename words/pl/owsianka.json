{
    "word_family": [
        "owies",
        "owsiany"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21b3281e-93f3-3ef8-9524-c628e5041f65",
                    "sense_definition": "potrawa z płatków owsianych gotowanych na mleku lub wodzie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na śniadanie zjadłem ciepłą <w>owsiankę</w> z owocami.",
                            "target_lang_translations": {
                                "ru": "На завтрак я съел теплую <w>овсянку</w> с фруктами."
                            }
                        },
                        {
                            "text": "Moja mama przygotowuje pyszną <w>owsiankę</w> każdego ranka.",
                            "target_lang_translations": {
                                "ru": "Моя мама готовит вкусную <w>овсянку</w> каждое утро."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zdrowa owsianka",
                        "gorąca owsianka"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо из овсяных хлопьев, сваренных на молоке или воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овсянка",
                                "target_lang_sense_clarification": "каша из овсяных хлопьев"
                            },
                            {
                                "target_lang_word": "овсяная каша",
                                "target_lang_sense_clarification": "полное название блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f520fd7-1864-3963-8cfa-033876c2bf0b",
                    "sense_definition": "gatunek małej ryby słodkowodnej z rodziny karpiowatych",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "zwierzęta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W czystym stawie można spotkać małą rybę, którą jest <w>owsianka</w>.",
                            "target_lang_translations": {
                                "ru": "В чистом пруду можно встретить маленькую рыбу — <w>верховку</w>."
                            }
                        },
                        {
                            "text": "Wędkarze rzadko łowią <w>owsiankę</w> ze względu na jej niewielkie rozmiary.",
                            "target_lang_translations": {
                                "ru": "Рыбаки редко ловят <w>верховку</w> из-за её небольших размеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "słonecznica",
                        "słonecznica pospolita",
                        "wierzchówka"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид мелкой пресноводной рыбы семейства карповых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верховка",
                                "target_lang_sense_clarification": "название мелкой рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "995dcb2a-746a-3a97-94ed-5ee679bd3a70",
                    "sense_definition": "pasza dla zwierząt gospodarskich przygotowana z owsa lub słomy owsianej",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik przygotował dla koni świeżą <w>owsiankę</w> na zimę.",
                            "target_lang_translations": {
                                "ru": "Фермер приготовил для лошадей свежий <w>овсяный корм</w> на зиму."
                            }
                        },
                        {
                            "text": "W dawnych gospodarstwach <w>owsianka</w> była powszechnie stosowana jako karma dla bydła.",
                            "target_lang_translations": {
                                "ru": "В старых хозяйствах <w>овсяный корм</w> широко использовался как корм для скота."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корм для сельскохозяйственных животных, приготовленный из овса или овсяной соломы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овсяный корм",
                                "target_lang_sense_clarification": "корм для скота на основе овса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}