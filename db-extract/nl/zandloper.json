                "translations": [
                    {
                        "translation_id": "c15e6789-212b-41d9-9cc6-bfaaed359967",
                        "source_entry_id": "39183607-8276-34f8-92ac-aece06e0819d",
                        "source_sense_id": "01da3017-7daf-3ba4-a27c-006c09b79227",
                        "source_sense_description": "toestel waarmee de tijd wordt gemeten door zand uit het bovenste reservoir via een smalle doorgang naar het onderste reservoir te laten lopen",
                        "target_lang_word": "Sanduhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanduhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                        "entry_id": "79965d08-57ba-303f-a222-13692ee9e1d3",
                                        "glosses": [
                                            "Zeitmessgerät, in dem feiner Sand in einem festgelegten Intervall von einem oberen in ein unteres Gefäß rieselt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39516f8-4a95-44d2-ac56-2322937c7d2d",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "Im Mittelalter gab es außer den Turmuhren nur Sanduhren."
                                            },
                                            {
                                                "example_id": "1526b34a-1c36-42b0-9b96-9bdcf5f01e6b",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "„Er stand auf, nahm die Sanduhr vom Kaminsims, und drehte sie um.“"
                                            },
                                            {
                                                "example_id": "538507a4-043d-48cb-b47e-99aa9e8232b1",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "„Bei Henlein zerrann die Zeit nicht mehr in Sanduhren und noch nicht in Taschenuhren, sondern in Dosen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ac8d64-3b7d-4543-848d-66dde6ea4da7",
                        "source_entry_id": "39183607-8276-34f8-92ac-aece06e0819d",
                        "source_sense_id": "01da3017-7daf-3ba4-a27c-006c09b79227",
                        "source_sense_description": "toestel waarmee de tijd wordt gemeten door zand uit het bovenste reservoir via een smalle doorgang naar het onderste reservoir te laten lopen",
                        "target_lang_word": "hourglass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hourglass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "457c3ff3-1751-3edd-acd2-dd8effdd85eb",
                                        "entry_id": "78505353-389f-3d78-9c3d-49dfe73fe29d",
                                        "glosses": [
                                            "A clock made of two glass vessels connected by a narrow passage through which sand flows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822c0260-28be-4ae3-b27b-954994f2f518",
                                                "sense_id": "457c3ff3-1751-3edd-acd2-dd8effdd85eb",
                                                "text": "After each game turn, invert the hourglass to reset the time limit for the next player."
                                            },
                                            {
                                                "example_id": "65b68107-7df3-4feb-9a6a-b472beb5bf6c",
                                                "sense_id": "457c3ff3-1751-3edd-acd2-dd8effdd85eb",
                                                "text": "The sands of thy short life are spent this hour, / And no hand in the universe can turn / Thy hourglass, if these gummed leaves be burnt / Ere thou canst mount up these immortal steps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f400c83f-6ca9-3a28-bb7c-9568bd6248b8",
                                        "entry_id": "78505353-389f-3d78-9c3d-49dfe73fe29d",
                                        "glosses": [
                                            "A cursor, often shaped like an hourglass, indicating that the computer is busy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1ff77e-c817-47af-ac17-8a0162e13e2f",
                                                "sense_id": "f400c83f-6ca9-3a28-bb7c-9568bd6248b8",
                                                "text": "When I right click the desktop display to check Display Properties, it hangs and shows me only the hourglass instead of the display menu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hourglass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6a5e3a-e5c1-3d53-9b9d-68c588abec1b",
                                        "entry_id": "a89cee83-5cda-3125-ba07-5831006a80d8",
                                        "glosses": [
                                            "To display the cursor as an hourglass to indicate that the computer is busy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda1e704-fd9b-44a3-a747-c60fce23320c",
                                                "sense_id": "8d6a5e3a-e5c1-3d53-9b9d-68c588abec1b",
                                                "text": "I have an ADP that I use for reporting that I have used for about a year. I only use it every 3 months, and it has worked up until now. This morning I tried using it, but after trying to open the report, it hourglassed and then showed a \"Timeout expired\" error. I searched this message and found out how to set the timeout limit, and set it to 300 seconds. Still the same message."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49faa622-5f1f-4a77-a355-2ce9f132b07c",
                        "source_entry_id": "39183607-8276-34f8-92ac-aece06e0819d",
                        "source_sense_id": "01da3017-7daf-3ba4-a27c-006c09b79227",
                        "source_sense_description": "toestel waarmee de tijd wordt gemeten door zand uit het bovenste reservoir via een smalle doorgang naar het onderste reservoir te laten lopen",
                        "target_lang_word": "sandglass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandglass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0816b9cb-883c-32a5-a34c-92993ed4f7b4",
                                        "entry_id": "d3ae359e-137d-3fbf-af60-e66bc9083a07",
                                        "glosses": [
                                            "An instrument for measuring the passage of time by the passage of sand through a narrow opening."
                                        ],
