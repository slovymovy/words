                ],
                "senses": [
                    {
                        "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                        "entry_id": "469bd345-0827-3b57-95fa-370a611c1108",
                        "glosses": [
                            "Geruchswahrnehmung, die von Oliven stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3591e8-3eed-4020-853a-40016ab912c8",
                                "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                                "text": "„Der intensive Olivengeruch in der Ölmühle wird nun von einer Geschmacksexplosion in meinem Mund glatt überspült.“"
                            },
                            {
                                "example_id": "8a9ef47a-4d8d-48bc-95fa-63239b2c71e1",
                                "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                                "text": "„Ein leichter Olivengeruch lag in der Luft, als die Pflücker auf den Feldern unter der Burg im Schatten der Bäume ihr Mittagessen verzehrten.“"
                            },
                            {
                                "example_id": "96d65732-410e-4984-999a-efd993fd7564",
                                "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                                "text": "„Unser Olivenöl ist kaltgepresst, aus erster Pressung, ist von leuchtender grün-goldener Farbe und zeichnet sich durch seinen frisch-fruchtigen, charakteristischen Olivengeruch und Geschmack aus.“"
                            },
                            {
                                "example_id": "7bc6386b-f40a-4a16-9c97-c52209d1e9e6",
                                "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                                "text": "„Das säurearme Olivenöl zeichnet sich durch seinen ausgewogenen, harmonischen und frischen Geschmack und einen exquisiten Olivengeruch aus.“"
                            },
                            {
                                "example_id": "9f68a9b7-31dc-454b-8fee-7ad507ca9209",
                                "sense_id": "3cf984c3-7fd4-3ad9-b614-96f1c93a674f",
                                "text": "„Sehr gutes Olivenöl (das beste Öl ist bekannt ermaßen das von der Insel Kreta) riecht leicht nach Gras, hat also nicht den penetranten Olivengeruch, es enthält 94% ungesättigter Fettsäuren und hat eine Peroxydzahl von 19 (die Peroxydzahl ist das Maß für den Gehalt an aktivem Sauerstoff).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
