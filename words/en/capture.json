                                "target_lang_word": "录制",
                                "target_lang_sense_clarification": "用于音频或视频"
                            },
                            {
                                "target_lang_word": "采集",
                                "target_lang_sense_clarification": "用于数据或信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9597c0b4-663f-3a36-a096-ff947a02af2b",
                    "sense_definition": "To represent or describe the character or atmosphere of something accurately in art or speech.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting really <w>captures</w> the beauty of the sunset.",
                            "target_lang_translations": {
                                "ru": "Картина действительно <w>передает</w> красоту заката.",
                                "tr": "Tablo gün batımının güzelliğini gerçekten <w>yansıtıyor</w>.",
                                "zh": "这幅画真正<w>表现</w>出了日落的美感。"
                            }
                        },
                        {
                            "text": "Her novel <w>captured</w> the spirit of life in the 1920s.",
                            "target_lang_translations": {
                                "ru": "Ее роман <w>отразил</w> дух жизни 1920-х годов.",
                                "tr": "Romanı 1920'lerdeki yaşamın ruhunu <w>yakalamıştı</w>.",
                                "zh": "她的小说<w>反映</w>了20世纪20年代的生活精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catch"
                    ],
                    "common_phrases": [
                        "capture the essence",
                        "capture the spirit",
                        "capture the mood"
                    ],
                    "target_lang_definitions": {
