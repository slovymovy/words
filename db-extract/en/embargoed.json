                "senses": [
                    {
                        "sense_id": "a73ee06d-3c56-3649-acea-52d0e197bcfd",
                        "entry_id": "2a7b33e6-050c-359e-887c-6c7cc35e2407",
                        "glosses": [
                            "Having had an embargo imposed, preventing access to or trade with."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb58207e-52f9-418b-b865-9e6ca028a52a",
                                "sense_id": "a73ee06d-3c56-3649-acea-52d0e197bcfd",
                                "text": "Verified access is also required to access most embargoed papers."
                            },
                            {
                                "example_id": "86ee2ffb-4e44-410d-9f6d-bfdf95b1d14f",
                                "sense_id": "a73ee06d-3c56-3649-acea-52d0e197bcfd",
                                "text": "We became the most embargoed state on earth."
                            },
                            {
                                "example_id": "0b4df282-e84b-4eb8-8280-90a1062b4062",
                                "sense_id": "a73ee06d-3c56-3649-acea-52d0e197bcfd",
                                "text": "And other journalists suggested that the article should have been run sooner if it was based on independent reporting rather than the embargoed announcement by the journal,"
                            },
                            {
                                "example_id": "ce4892f8-825e-487d-82fa-298f54e621b4",
                                "sense_id": "a73ee06d-3c56-3649-acea-52d0e197bcfd",
                                "text": "An embargo is a restriction upon the transfer of specified goods, usually arms or petroleum products, to the embargoed State. It could also include a bar upon specific individuals or categories of persons (e.g. mercenaries) entering the embargoed State."
                            }
                        ]
                    }
