                "senses": [
                    {
                        "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                        "entry_id": "fd8f785c-e009-308a-a798-95f18167b5d0",
                        "glosses": [
                            "Art von Witz, dessen Hauptakteure Kannibalen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f906fe71-aa2b-46c6-b1cc-241a9cda2252",
                                "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                                "text": "„Unser Riesen-Neger Sitty-Smile mußte alle erdenkbaren Kannibalenwitze über sich ergehen lassen.“"
                            },
                            {
                                "example_id": "06dba7c4-533a-4ae8-b9b5-75edbe192019",
                                "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                                "text": "„Inbegriff des makabren Witzes ist der Kannibalenwitz.“"
                            },
                            {
                                "example_id": "7b883bcf-4141-47d6-91d1-e0402bb43b06",
                                "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                                "text": "„Es beginnt wie ein Kannibalenwitz: „pater fernando endete karfreitag in einem kessel“ und setzt sich fort mit der Andeutung weiterer Todesfälle.“"
                            },
                            {
                                "example_id": "44553fcf-ef74-4551-a5d8-835df42cbe8b",
                                "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                                "text": "„Noch in den siebziger Jahren waren Kannibalenwitze in populären Zeitschriften all-gegenwärtig.“"
                            },
                            {
                                "example_id": "51fbe838-72be-4e81-a3b8-e27c0aa6a08b",
                                "sense_id": "c7fbb699-eebe-3de0-92d7-d4738b65b610",
                                "text": "„Kannibalenwitze gibt es auch unabhängig vom Rassismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
