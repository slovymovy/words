                        ],
                        "form": "die Prahlhänse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0251dbc-e2f2-31f8-ba6e-713ffcf3834f",
                        "entry_id": "139d5c42-c04c-3f91-a7d3-17b227ee2a67",
                        "glosses": [
                            "jemand, der auf sein Können oder seinen Besitz öffentlich in übertriebener Weise aufmerksam macht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "527974ad-311b-4159-ada1-72d665d0577c",
                                "sense_id": "f0251dbc-e2f2-31f8-ba6e-713ffcf3834f",
                                "text": "„Er brüstete sich als Retter des Weltfriedens, aber zwei Jahre später wurde er als Prahlhans und Schwächling gestürzt.“"
                            },
                            {
                                "example_id": "6ba4a517-7e50-4d0b-a9fa-56e1c50a1d76",
                                "sense_id": "f0251dbc-e2f2-31f8-ba6e-713ffcf3834f",
                                "text": "„Sie müssen das sehen, den großen Aufbruch im Sommer. Da laden die Leute Möbel, Küchengeräte, Kronleuchter und Fernseher auf ihre Autos und fahren unter großem Gejohle davon, eine Prozession der Prahlhänse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37faeeaa-c4db-4aba-b773-5d817a4ae402",
                        "source_entry_id": "139d5c42-c04c-3f91-a7d3-17b227ee2a67",
                        "source_sense_id": "f0251dbc-e2f2-31f8-ba6e-713ffcf3834f",
                        "target_lang_word": "braggard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99446fa6-de55-3521-b250-5050b036546a",
                                        "entry_id": "3b42748b-1c0c-35a2-aa6a-9023e89848b1",
                                        "glosses": [
                                            "Uncommon form of braggart."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9704dd1b-a799-497c-9e89-93210d3919b7",
                                                "sense_id": "99446fa6-de55-3521-b250-5050b036546a",
                                                "text": "He was a bit of a braggard and a bore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "333da207-fc63-4601-b9ef-97e7a7684723",
                        "source_entry_id": "139d5c42-c04c-3f91-a7d3-17b227ee2a67",
                        "source_sense_id": "f0251dbc-e2f2-31f8-ba6e-713ffcf3834f",
                        "target_lang_word": "хвастун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хвастун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4eff692f-4ea7-3fd9-b4b5-5ce60378923d",
                                        "entry_id": "6dfdf200-5dd0-389b-a170-5b605f5cb9d2",
                                        "glosses": [
                                            "хвастливый человек; тот, кто любит хвастать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299f9ee8-e120-453b-8fd1-cf25228b7c93",
                                                "sense_id": "4eff692f-4ea7-3fd9-b4b5-5ce60378923d",
                                                "text": "Хвастун давай ему вперебой расписывать про свое хозяйство, какое оно превосходное…"
                                            },
                                            {
                                                "example_id": "ff9dc576-7561-4b36-ae39-3ea735f01da1",
                                                "sense_id": "4eff692f-4ea7-3fd9-b4b5-5ce60378923d",
                                                "text": "Бахвал из бахвалов, хвастун из хвастунов! Я сам люблю иногда похвастать, но даже в минуты самой большой запальчивости я не обещал остановить ход великого светила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
