                        "entry_id": "92db30ac-6130-37a4-ae1e-8e79dc8a509e",
                        "glosses": [
                            "The North and South American tree Genipa americana of the family Rubiaceae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c510166-2227-47c7-aa02-6a66a021e615",
                                "sense_id": "e9be8940-e701-359c-b035-14dc1383df00",
                                "text": "Genipap is wild and cultivated in many parts of the Amazon, especially on floodplains, from the river's mouth to the Andean foothills in Bolivia, Peru, Ecuador, and Colombia."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b579344-8f17-3c45-8978-4d6e3cd1b01f",
                        "entry_id": "92db30ac-6130-37a4-ae1e-8e79dc8a509e",
                        "glosses": [
                            "The fruit of this tree, oval in shape, as a large as a small orange, of a pale greenish color, and with dark purple juice, traditionally used as a colorant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a4a9d0-e9b6-4971-bb1a-8383e02cc2e5",
                                "sense_id": "7b579344-8f17-3c45-8978-4d6e3cd1b01f",
                                "text": "Unripe genipap fruits are widely used by indigenous tribes to extract the blue pigment, exposing the inside part of the fruit to the air."
                            }
                        ]
                    }
                ],
