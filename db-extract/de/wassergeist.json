                "senses": [
                    {
                        "sense_id": "4b0eb479-c803-30c8-b6ae-05d46d5b5b04",
                        "entry_id": "82f9eaf1-b2d2-3607-9ed2-8597547dfd15",
                        "glosses": [
                            "geisterhaftes Wesen, das im Wasser lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45f8959-a77a-448b-828e-74cfd9c9f7fe",
                                "sense_id": "4b0eb479-c803-30c8-b6ae-05d46d5b5b04",
                                "text": "„Der Lehrer in der Sonntagsschule im Bethaus Bethania hatte mal gesagt, diejenigen, die den Nöck gesehen hätten, könnten damit rechnen, dass ihnen die Augen aus dem Kopf faulen; Hjartvard hatte also vermutlich den Nöck gesehen, diesen hässlichen Wassergeist.“"
                            },
                            {
                                "example_id": "3710e1d1-f833-45a8-bbf0-7781542a0158",
                                "sense_id": "4b0eb479-c803-30c8-b6ae-05d46d5b5b04",
                                "text": "„Sie hieß mit Vornamen Undine und es schien ihr, als hätte sie ihr Leben lang auf diese meergrüne Seide gewartet – ihr vorbestimmt durch die Namensweihe auf einen Wassergeist vor 36 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
