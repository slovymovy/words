                "senses": [
                    {
                        "sense_id": "e7bdb138-3407-3c50-bc6b-49ee9a3bd17b",
                        "entry_id": "c3b4acc9-ab16-314f-881b-0e3432436ce7",
                        "glosses": [
                            "Passer au four à micro-ondes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54789668-bfd4-4a6f-8807-3415ff46948d",
                                "sense_id": "e7bdb138-3407-3c50-bc6b-49ee9a3bd17b",
                                "text": "J'avais un livre qui en a été envahi et j'ai voulu le microonder, ben 30 secondes de microonde ne tue pas les poux..."
                            },
                            {
                                "example_id": "04a5a80c-c96b-40d0-b6a1-005344abe921",
                                "sense_id": "e7bdb138-3407-3c50-bc6b-49ee9a3bd17b",
                                "text": "Cela confirme donc l'importance de tout \"microonder\"!"
                            },
                            {
                                "example_id": "9b0091ab-8a7b-4568-b73b-08374e363c67",
                                "sense_id": "e7bdb138-3407-3c50-bc6b-49ee9a3bd17b",
                                "text": "L'heure de microonder un plat de crevette curry/coco au riz parfumé"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58d55df1-56a9-4b00-a8b5-1b538f86b232",
