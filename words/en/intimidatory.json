                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий качеством запугивания или угрозы, особенно с целью заставить кого-либо сделать то, что от него требуют."
                    },
                    "translations": {
                        "ru": [
                            {
