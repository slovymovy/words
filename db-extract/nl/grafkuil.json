                                        "glosses": [
                                            "Serious, in a negative sense; important, formidable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9423bef8-dca1-4e4c-9277-387381585a54",
                                                "sense_id": "eb4dbefa-de62-3b8b-b9f4-ee896e4c205c",
                                                "text": "Israel’s behaviour is doing grave damage to the Palestinian people and to any hope for peace."
                                            },
                                            {
                                                "example_id": "551a5f02-eb15-4c0f-b70b-f82bf65ad3db",
                                                "sense_id": "eb4dbefa-de62-3b8b-b9f4-ee896e4c205c",
                                                "text": "Khrushchev made a grave miscalculation when he failed to appreciate the growing opposition to his power and overestimated the support of his bureaucracy."
                                            }
                                        ]
                                    },
