                                "target_senses": [
                                    {
                                        "sense_id": "474efc87-c762-34bd-b72e-eb8afcd49200",
                                        "entry_id": "0932f697-d1c8-3bb8-b922-2e678199ca63",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see Christmas, present."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77cba3e-60ed-4b03-8a80-48cb08d3cf5a",
                                                "sense_id": "474efc87-c762-34bd-b72e-eb8afcd49200",
                                                "text": "Children believe that Santa Claus comes down the chimney to bring them Christmas presents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Christmas present",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f4a346-5564-3962-891d-a690c18a2493",
                                        "entry_id": "ec0f330a-ee9c-395b-8037-d758d0746e09",
                                        "glosses": [
                                            "A contemporary Christmas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae643d0b-ab8f-4a16-9013-fd0bd1e9261e",
                                                "sense_id": "63f4a346-5564-3962-891d-a690c18a2493",
                                                "text": "Christmas past becomes Christmas present."
                                            },
                                            {
                                                "example_id": "55ca4d0f-722c-4d76-b059-6d3d860841b2",
                                                "sense_id": "63f4a346-5564-3962-891d-a690c18a2493",
                                                "text": "Anita had been relieved to unload the burden of her Christmases Past following her Process but she certainly hasn't told Max any of the details of the Christmases present she'd be spending with John."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
