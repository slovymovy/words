            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19fefbbc-873f-3054-a78f-7b3e39cfa2d3",
                    "sense_definition": "Brotscheiben oder anderes Gebäck durch Hitze, meist im Toaster, anrösten und knusprig machen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "kochen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgens kocht er zuerst den Kaffee, bevor er sein Weißbrot <w>toastet</w>."
                        },
                        {
                            "text": "Du kannst das alte Brot noch essen, wenn du es vorher kurz <w>toastest</w>."
                        }
                    ],
                    "synonyms": [
                        "rösten",
                        "anrösten"
                    ],
                    "common_phrases": [
                        "Brot toasten",
                        "Weißbrot toasten"
                    ]
                },
                {
                    "sense_id": "07632125-8791-32b0-87e2-7967433f089d",
                    "sense_definition": "einen Trinkspruch aussprechen oder zu Ehren von jemandem das Glas erheben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trinkspruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Gäste erhoben ihre Gläser und <w>toasteten</w> feierlich auf das Brautpaar."
                        },
                        {
                            "text": "Bei dem festlichen Abendessen <w>toastete</w> der Gastgeber herzlich auf den Ehrengast."
                        }
                    ],
                    "synonyms": [
                        "anstoßen",
                        "zuprosten"
                    ],
                    "common_phrases": [
                        "auf jemanden toasten"
                    ]
                }
            ]
        },
        {
