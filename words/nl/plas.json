                {
                    "sense_id": "10afe4b8-5d20-3ca9-a59a-55dd66edabf8",
                    "sense_definition": "Een kleine hoeveelheid vloeistof die op de grond ligt, vaak regenwater",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "water_accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de zware regenbui lag er een grote <w>plas</w> voor de deur.",
                            "target_lang_translations": {
                                "en": "After the heavy rain shower, there was a large <w>puddle</w> in front of the door.",
                                "ru": "После сильного ливня перед дверью была большая <w>лужа</w>.",
                                "pl": "Po ulewnym deszczu przed drzwiami leżała wielka <w>kałuża</w>.",
                                "de": "Nach dem starken Regenschauer lag eine große <w>Pfütze</w> vor der Tür.",
                                "fr": "Après la forte averse, il y avait une grande <w>flaque</w> devant la porte.",
                                "it": "Dopo il forte acquazzone c'era una grande <w>pozzanghera</w> davanti alla porta.",
                                "cs": "Po silném dešti ležela před dveřmi velká <w>louže</w>.",
                                "tr": "Şiddetli yağmurdan sonra kapının önünde büyük bir <w>su birikintisi</w> vardı.",
                                "es": "Después de la fuerte lluvia, había un gran <w>charco</w> frente a la puerta.",
                                "zh": "大雨过后，门口有一大滩<w>水洼</w>。"
                            }
                        },
                        {
                            "text": "Het kind stampte vrolijk met zijn laarzen in de <w>plas</w>.",
                            "target_lang_translations": {
                                "en": "The child stamped happily with his boots in the <w>puddle</w>.",
                                "ru": "Ребенок весело топал сапогами по <w>луже</w>.",
                                "pl": "Dziecko radośnie tupało kaloszami w <w>kałuży</w>.",
                                "de": "Das Kind stampfte fröhlich mit seinen Stiefeln in die <w>Pfütze</w>.",
                                "fr": "L'enfant sautait joyeusement avec ses bottes dans la <w>flaque</w>.",
                                "it": "Il bambino saltava allegramente con gli stivali nella <w>pozzanghera</w>.",
                                "cs": "Dítě vesele dupalo svými holínkami v <w>louži</w>.",
                                "tr": "Çocuk neşeyle çizmeleriyle <w>su birikintisine</w> bastı.",
                                "es": "El niño pisaba alegremente con sus botas en el <w>charco</w>.",
                                "zh": "孩子穿着靴子在<w>水洼</w>里快乐地踩水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poel"
                    ],
                    "common_phrases": [
                        "in een plas stampen",
                        "een plas water",
                        "een plas bloed"
                    ],
                    "target_lang_definitions": {
                        "en": "A small amount of liquid lying on the ground, often rainwater",
                        "ru": "Небольшое количество жидкости на земле, часто дождевой воды",
                        "pl": "Niewielka ilość płynu leżąca na ziemi, często woda deszczowa.",
                        "de": "Eine kleine Menge Flüssigkeit, die auf dem Boden liegt, oft Regenwasser",
                        "fr": "Une petite quantité de liquide sur le sol, souvent de l'eau de pluie.",
                        "it": "Una piccola quantità di liquido che si trova sul terreno, spesso acqua piovana.",
                        "cs": "Malé množství tekutiny na zemi, často dešťová voda.",
                        "tr": "Yerde bulunan az miktarda sıvı, genellikle yağmur suyu",
                        "es": "Una pequeña cantidad de líquido que se encuentra en el suelo, a menudo agua de lluvia.",
                        "zh": "地面上的一小滩液体，通常指雨水"
