                },
                {
                    "sense_id": "b931d17f-5a54-3033-97a3-a53c98b1a0f3",
                    "sense_definition": "Comparative form of <w>early</w>: occurring nearer to the beginning of a period or schedule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She requested an <w>earlier</w> appointment because she was in pain.",
                            "target_lang_translations": {
                                "es": "Pidió una cita <w>más temprana</w> porque le dolía mucho.",
                                "fr": "Elle a demandé un rendez-vous <w>plus tôt</w> parce qu'elle souffrait."
                            }
                        },
                        {
                            "text": "Could we schedule our meeting for an <w>earlier</w> time?",
                            "target_lang_translations": {
                                "es": "¿Podríamos programar nuestra reunión para una hora <w>más temprana</w>?",
                                "fr": "Pourrions-nous planifier notre réunion à une heure plus <w>avancée</w> ?"
                            }
                        }
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "common_phrases": [
                        "earlier flight",
                        "earlier time",
                        "earlier date"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma comparativa de «early»: situado más cerca del inicio de un período u horario.",
                        "fr": "Comparatif de 'early' : fixé ou situé à une heure ou une date plus avancée, plus proche du début."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "más temprano",
                                "target_lang_sense_clarification": "programado a una hora anterior"
                            },
                            {
                                "target_lang_word": "anterior",
                                "target_lang_sense_clarification": "de un horario previo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plus tôt",
                                "target_lang_sense_clarification": "à un horaire antérieur"
                            },
                            {
                                "target_lang_word": "avancé",
                                "target_lang_sense_clarification": "déplacé vers un horaire antérieur"
                            }
                        ]
                    }
                }
            ]
        }
    ]
