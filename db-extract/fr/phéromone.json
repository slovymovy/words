                ],
                "senses": [
                    {
                        "sense_id": "4161aa8f-b09f-320b-8825-f48aa397caae",
                        "entry_id": "e4c75aa9-93af-3b53-b9aa-69eb4c95132f",
                        "glosses": [
                            "Substance chimique qui, émise à dose infime dans le milieu extérieur par un animal ou une plante, provoque chez des individus de la même espèce des comportements spécifiques telle l’attraction sexuelle, en agissant par l’odorat et en étant détectée par les antennes chez les insectes et par l’organe voméronasal chez les mammifères et les reptiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7493cd3d-2798-4c54-b8f8-c972cd2863d6",
                                "sense_id": "4161aa8f-b09f-320b-8825-f48aa397caae",
                                "text": "[…] substance royale, phéromone de glande mandibulaire […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd43a703-d75c-44d0-87b4-12e54def8201",
                        "source_entry_id": "e4c75aa9-93af-3b53-b9aa-69eb4c95132f",
                        "source_sense_id": "4161aa8f-b09f-320b-8825-f48aa397caae",
