                    {
                        "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                        "entry_id": "f013ec0f-dac7-3943-9c1a-8a68d18b8f84",
                        "glosses": [
                            "Urin"
                        ],
                        "tags": [
                            "kindersprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "42203f06-ae07-41da-8720-ded317b651cf",
                                "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                                "text": "Mama, ich muss mal Pipi!"
                            },
                            {
                                "example_id": "49bb9531-dbff-4108-8423-648d98b30424",
                                "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                                "text": "Im Badezimmer fand sich eine Lache aus Pipi."
                            },
                            {
                                "example_id": "c0630a7e-3bed-4725-af84-75afb9add6a4",
                                "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                                "text": "Jetzt hat die kleine Marlene schon wieder Pipi in der Hose."
                            },
                            {
                                "example_id": "b46fe77b-4bbb-4865-9171-88e27f479591",
                                "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                                "text": "Pipi ist kein Name und auch kein Getränk. | Mancher muss schon rennen, wenn er nur an Pipi denkt. (Marius Müller-Westernhagen)"
                            },
                            {
                                "example_id": "ce51a345-b265-47b4-8fa2-a976d0ecc7be",
                                "sense_id": "d9a79e50-8c19-3a9b-bedc-61a3feb6fd5b",
                                "text": "„Sie erklärte ihm, dass das Spargel sei und dass sein Pipi danach komisch riechen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
