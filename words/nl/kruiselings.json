    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d608cfb-bdb0-3e97-a99e-949436bccace",
                    "sense_definition": "in de vorm van een kruis, waarbij lijnen of voorwerpen elkaar snijden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bond de touwen <w>kruiselings</w> vast om de doos extra stevig te sluiten.",
                            "target_lang_translations": {
                                "en": "He tied the ropes <w>crosswise</w> to seal the box extra securely."
                            }
                        },
                        {
                            "text": "Op het verkeersbord stonden twee rode lijnen <w>kruiselings</w> over elkaar afgebeeld.",
                            "target_lang_translations": {
                                "en": "Two red lines crossing <w>crisscross</w> were depicted on the traffic sign."
                            }
                        }
                    ],
                    "synonyms": [
                        "kruislings",
                        "kruisgewijs"
                    ],
                    "common_phrases": [
                        "kruiselings over elkaar"
                    ],
                    "target_lang_definitions": {
                        "en": "in the shape of a cross, where lines or objects intersect"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crosswise",
                                "target_lang_sense_clarification": "crossing each other or in the shape of a cross"
                            },
                            {
                                "target_lang_word": "crisscross",
                                "target_lang_sense_clarification": "intersecting in a cross pattern"
                            },
                            {
                                "target_lang_word": "cross-wise",
                                "target_lang_sense_clarification": "alternative spelling of crosswise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95965b27-a9fc-34c3-8624-95f1838c3a22",
                    "sense_definition": "over en weer tussen twee of meer partijen; wederzijds",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wederzijds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee buurlanden besloten tot <w>kruiselingse</w> inspecties van elkaars grenscontroles.",
                            "target_lang_translations": {
                                "en": "The two neighboring countries decided on <w>reciprocal</w> inspections of each other's border controls."
                            }
                        },
                        {
                            "text": "Er ontstonden <w>kruiselingse</w> belangen tussen de verschillende aandeelhouders van het bedrijf.",
                            "target_lang_translations": {
                                "en": "<w>Cross-cutting</w> interests arose between the different shareholders of the company."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kruiselingse inspecties"
                    ],
                    "target_lang_definitions": {
                        "en": "back and forth between two or more parties; reciprocal or cross-cutting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reciprocal",
                                "target_lang_sense_clarification": "done or experienced mutually by both sides"
                            },
                            {
                                "target_lang_word": "cross-",
                                "target_lang_sense_clarification": "involving two parties or fields mutually (e.g. cross-holdings, cross-inspections)"
                            },
                            {
                                "target_lang_word": "mutual",
                                "target_lang_sense_clarification": "shared between two or more parties"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}