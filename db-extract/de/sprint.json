                ],
                "senses": [
                    {
                        "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                        "entry_id": "3be702eb-8791-3705-9b72-ab9c554b64dc",
                        "glosses": [
                            "das Zurücklegen einer Kurzstrecke in der größtmöglichen Geschwindigkeit (in verschiedenen Bereichen des Sports, z. B. in der Leichtathletik, im Radsport, im Schwimmen, im Eisschnelllauf oder im Skilanglauf)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc04ccb-4775-4a06-a7c2-d60b816c5536",
                                "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                                "text": "Höhepunkt des Leichtathletik-Meetings war der Sprint der Männer über 100 Meter."
                            },
                            {
                                "example_id": "535dac2b-02fa-430b-8cb4-29db421c9ca8",
                                "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                                "text": "[Radsport: ] „Mit einem veritablen Sprint raste er auf die Zielgerade in Harrogate und setzte sich mit einem deutlichen Vorsprung von 46.07 Sekunden vor dem Zweitplatzierten Filippo Ganna aus Italien an die Spitze des WM-Rennens.“"
                            },
                            {
                                "example_id": "6d436170-0556-498a-a7db-a12a639fd157",
                                "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                                "text": "„Pascal Ackermann setzt sich auf der 1. Etappe der Deutschland-Tour im Sprint durch […]“"
                            },
                            {
                                "example_id": "38d2989d-8c0c-4543-a6e8-2697bac41b8e",
                                "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                                "text": "„[…] nach einem Sprint hat Rashica nicht mehr die Kraft für einen guten Schuss, trifft mit links den Ball auch nicht richtig.“"
                            },
                            {
                                "example_id": "9b862cdb-f1e2-408e-8cb6-df4bc7b2fb8f",
                                "sense_id": "407e9e74-5e54-3f22-ba51-4cea75b6dec0",
                                "text": "„Mein Atem ging schwer, meine Schultern hoben und senkten sich wie nach einem Sprint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
