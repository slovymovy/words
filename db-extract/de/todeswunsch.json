                "translations": [
                    {
                        "translation_id": "da7b7c4d-6f16-4d5e-80b5-85319e17582b",
                        "source_entry_id": "45f4d709-67a7-327d-9bdc-bbc212e5e714",
                        "source_sense_id": "46b0326e-c9d0-3edd-9655-fffff079a7bc",
                        "source_sense_description": "Wunsch, tot zu sein",
                        "target_lang_word": "death wish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death wish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                        "entry_id": "e6fd797b-9178-34a0-a8f2-24f1606dd767",
                                        "glosses": [
                                            "A desire, especially subconscious, for the death of oneself or of someone else."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b1bd07-8054-4f74-a790-ae10b43eb6b9",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Does Trump suffer from some kind of political death wish? If so, we must hope his fall comes quickly. It is hard to think of any precedent for such a calamitous display of insensitivity, historical ignorance and uncomprehending political stupidity."
                                            },
                                            {
                                                "example_id": "da71d143-757d-48a2-bab5-47f62beccc3a",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "Wait, Kris! What the HELL was that!??!?! Why would NOELLE?? Ask ME?? To do HOMEWORK?? With HER?!?? Deathwish much? Does she WANNA fail?"
                                            },
                                            {
                                                "example_id": "d4320d09-9ccf-47ce-ac95-ca38115e7929",
                                                "sense_id": "dd97b1c4-5dbe-3a66-9043-44308a57f368",
                                                "text": "\"I reiterate: outside is death.\" Brenda squeezed her hand. \"You won't make it far by yourself.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf9fc14e-6678-4f0d-aed4-fbe4fa8df078",
                        "source_entry_id": "45f4d709-67a7-327d-9bdc-bbc212e5e714",
                        "source_sense_id": "46b0326e-c9d0-3edd-9655-fffff079a7bc",
                        "source_sense_description": "Wunsch, tot zu sein",
                        "target_lang_word": "pulsion de mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulsion de mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55053f0d-bd4f-3108-a5af-34863cdda59c",
                                        "entry_id": "875c2abf-354e-3862-843a-575f6898d1a1",
                                        "glosses": [
                                            "Désir relativement conscient de voir une personne mourir ou une chose détruite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb1e24f-d5e4-42e0-8e46-221643a610c7",
                                                "sense_id": "55053f0d-bd4f-3108-a5af-34863cdda59c",
                                                "text": "La pulsion de mort a pu se déchaîner à l’ombre du progrès scientifique et technique, tandis que la pulsion de vie s’exprimait dans la soif d’invention et de conquête et lui assurait ainsi un camouflage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
