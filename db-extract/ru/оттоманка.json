                "senses": [
                    {
                        "sense_id": "c287cdc9-2fe4-3fa1-a036-abffc8a4e580",
                        "entry_id": "652176a1-2297-3753-970c-8011c6b7d97c",
                        "glosses": [
                            "мягкий диван, не имеющий спинки и подлокотников"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8efd097-69fc-4f3c-ad0a-f16f4b95eba5",
                                "sense_id": "c287cdc9-2fe4-3fa1-a036-abffc8a4e580",
                                "text": "Много места занимала низкая оттоманка с цветастыми подушками."
                            },
                            {
                                "example_id": "5711c950-8346-499f-b187-7d4e124f0e8d",
                                "sense_id": "c287cdc9-2fe4-3fa1-a036-abffc8a4e580",
                                "text": "Стерлинг Харлоу залез на оттоманку и встал на цыпочки, чтобы выглянуть из окна гостиной."
                            }
                        ]
                    },
