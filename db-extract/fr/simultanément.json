                                                "sense_id": "4b2c463c-0182-3750-b644-b01892911a85",
                                                "text": "Kochał ją i nienawidził jednocześnie."
                                            },
                                            {
                                                "example_id": "aa91de71-ebc1-45e3-b87f-d60b188f9f6e",
                                                "sense_id": "4b2c463c-0182-3750-b644-b01892911a85",
