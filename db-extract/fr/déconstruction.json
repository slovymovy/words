                                                "sense_id": "919f5171-65ac-3510-a641-7390b625892f",
                                                "text": "Auf den Verkauf der veralteten Fabrik erfolgte der komplette Abbau. Die Einzelteile wurden später nach China verkauft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
