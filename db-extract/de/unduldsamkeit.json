                "senses": [
                    {
                        "sense_id": "c9d96f96-078b-3442-bbd4-73520bd74f6d",
                        "entry_id": "cb9b3259-9b78-3649-8b8a-cc0cbcd4849d",
                        "glosses": [
                            "Intoleranz gegenüber einer anderen Meinung, Haltung oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0558d8e5-9b77-423d-b7c4-296133ede7bc",
                                "sense_id": "c9d96f96-078b-3442-bbd4-73520bd74f6d",
                                "text": "„Was die negativen anlangt, so beschränke ich sie auf einen einzigen, die Unduldsamkeit.“"
                            },
                            {
                                "example_id": "63ebed47-da05-414b-acc7-427d3116b44b",
                                "sense_id": "c9d96f96-078b-3442-bbd4-73520bd74f6d",
                                "text": "„Wir sollen nur darauf hinweisen, daß es im Journalismus auch eine verlogene Unduldsamkeit, einen unechten Fanatismus gibt.“"
                            },
                            {
                                "example_id": "f5614840-6ab2-4830-9644-1639f8634331",
                                "sense_id": "c9d96f96-078b-3442-bbd4-73520bd74f6d",
                                "text": "„Wir wehren uns gegen die Unduldsamkeit, die in der Enzyklika des Papstes hervorgetreten ist, wir wehren uns gegen die geistige Knebelung, die zu dem Modernisteneid geführt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
