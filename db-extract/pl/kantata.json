                    },
                    {
                        "translation_id": "2f4f15dc-adf6-46c6-b09b-2d2f0587ecc5",
                        "source_entry_id": "cd5f79bc-fb58-3594-9fd2-d24926b02bc9",
                        "source_sense_id": "88aace5c-029e-30ce-9e26-98368e9cdcb4",
                        "target_lang_word": "kantáta",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantáta",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "77664f44-023c-394d-8a7d-695545d10b6a",
                                        "entry_id": "3cba5dc8-4258-3b99-9f36-c062bd48788e",
                                        "glosses": [
                                            "skladba pro sóla, sbor a orchestr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70311e42-933a-4c5b-ba2d-3c43fe6984bf",
                                                "sense_id": "77664f44-023c-394d-8a7d-695545d10b6a",
                                                "text": "Ku slavnosti kladení základního kamene k Národnímu divadlu v Praze složil Karel Šebor kantátu, která byla poctěna první cenou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90801959-b5cc-4122-a931-9a05527c35ea",
                        "source_entry_id": "cd5f79bc-fb58-3594-9fd2-d24926b02bc9",
                        "source_sense_id": "88aace5c-029e-30ce-9e26-98368e9cdcb4",
                        "target_lang_word": "Kantate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kantate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                        "entry_id": "428cf472-bb1b-3c17-b4af-8e783085323a",
                                        "glosses": [
                                            "„Formenfamilie von mehrsätzigen Werken für eine oder mehrere Gesangsstimmen und Instrumentalbegleitung“"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d427748-e7de-40dc-8895-96d85c0ef6f8",
                                                "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                                "text": "„Im Mittelalter nannte man auch ein Werk religiösen und auch andern Inhalts Kantate zum Gegensaß von Sonate (von sonare), die nur für Instrumente geschaffen war.“"
                                            },
                                            {
                                                "example_id": "c2d15649-4d0e-43ef-8285-e32d731b06f2",
                                                "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                                "text": "„Die zehnteilige Kantate ‚O luce etterna‘, ein Auftragswerk des Ravenna Festivals, basiert auf ins Ukrainische übersetzten Versen aus Dantes ‚Paradiso‘ und einem Gedicht von Taras Schewtschenko, dem ukrainischen Nationaldichter des neunzehnten Jahrhunderts.“"
                                            },
                                            {
                                                "example_id": "3aab1252-df23-426b-ad87-7bfd1c34293a",
                                                "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                                "text": "„Die eine oder andere Kantate klingt an, aber zunächst nur als bloßes Geräusch; die Tradition scheint inzwischen ihrer Klangfülle und frommen Bedeutung beraubt.“"
                                            },
                                            {
                                                "example_id": "719ae7fb-5697-4600-a5cb-74d461c34623",
                                                "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                                "text": "„Wenn ich in einer Schlange warte, höre ich Musikfetzen; manchmal eine Goldberg-Variation, manchmal eine Kantate oder ein Brandenburgisches Konzert, das wie ein Band in meinem Kopf abgespult wird.“"
                                            },
                                            {
                                                "example_id": "dfba5ea6-59a2-4094-8f37-bb6e1849d956",
                                                "sense_id": "36100e1c-677c-3f57-8b09-a63294f9062f",
                                                "text": "„Daher muss, wer nun wieder in den Gottesdienst geht, vielerorts stumm bleiben – selbst am vergangenen fünften Sonntag der Osterzeit, der nach dem Beginn seines Eröffnungpsalms ‚Kantate‘ – also ‚Singt!‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kantate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d435864-6fbd-3ff7-a210-5a496e7e094e",
                                        "entry_id": "b4a3c160-8fba-3143-a4db-6a151f3e81e8",
                                        "glosses": [
                                            "vierter Sonntag, der nach Ostern folgt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kantate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32108bd3-de63-3200-9c1a-66255e32a7ff",
                                        "entry_id": "475555cc-7168-3601-b100-02ff3260337e",
                                        "glosses": [
                                            "jährliches Treffen von deutschen Buchhändlern am Sonntag Kantate"
                                        ],
                                        "tags": [],
