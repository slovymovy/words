                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9baf7ec7-0005-41f3-b3dd-2daec0a5d3e0",
                                "sense_id": "9c6fc91d-3c5c-3758-914e-2d0092f24673",
                                "text": "Or la marginalité qui enrichit encore culturellement les enfants que leur famille a déjà richement dotés, va sous-prolétariser les fils d’ouvriers."
                            },
                            {
                                "example_id": "6e52d15b-78e0-48a7-a8c6-1bf304f9d320",
                                "sense_id": "9c6fc91d-3c5c-3758-914e-2d0092f24673",
                                "text": "La dévaluation aboutit à sous-prolétariser davantage encore les travailleurs étrangers, donc à élargir le fossé qui les sépare de leurs camarades français."
                            }
                        ]
