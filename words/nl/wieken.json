                    "sense_definition": "Een buurtschap in de gemeente Oude IJsselstreek, in de Nederlandse provincie Gelderland.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Mijn grootouders wonen al hun hele leven in het rustige <w>Wieken</w>.",
                            "target_lang_translations": {
                                "en": "My grandparents have lived in the quiet <w>Wieken</w> their whole lives."
                            }
                        },
                        {
                            "text": "Tijdens onze fietstocht door Gelderland kwamen we langs het gehucht <w>Wieken</w>.",
                            "target_lang_translations": {
                                "en": "During our bike ride through Gelderland, we passed the hamlet of <w>Wieken</w>."
