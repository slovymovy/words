{
    "word_family": [
        "copycat",
        "copyist",
        "copyright",
        "copywriter",
        "photocopy",
        "hardcopy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                    "sense_definition": "An identical or nearly identical duplicate of an original object or document.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "duplicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please bring me at least 200 <w>copies</w> of this report for the meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, принесите мне как минимум 200 <w>копий</w> этого отчета для собрания."
                            }
                        },
                        {
                            "text": "I can forward the email to you so that you have your own <w>copy</w> of the file.",
                            "target_lang_translations": {
                                "ru": "Я могу переслать вам письмо, чтобы у вас была собственная <w>копия</w> файла."
                            }
                        }
                    ],
                    "synonyms": [
                        "duplicate",
                        "facsimile",
                        "reproduction"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "common_phrases": [
                        "hard copy",
                        "digital copy",
                        "signed copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идентичный или почти идентичный дубликат оригинального объекта или документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "точный дубликат документа или предмета"
                            },
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "второй экземпляр документа, имеющий ту же силу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30fb6daa-bf49-3466-8746-dbec918e3521",
                    "sense_definition": "A single instance or printed version of a specific book or publication.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our town's public library has several <w>copies</w> of the Bible in different editions.",
                            "target_lang_translations": {
                                "ru": "В публичной библиотеке нашего города есть несколько <w>экземпляров</w> Библии в разных изданиях."
                            }
                        },
                        {
                            "text": "I finally managed to find a rare <w>copy</w> of my favorite childhood book.",
                            "target_lang_translations": {
                                "ru": "Мне наконец-то удалось найти редкий <w>экземпляр</w> моей любимой детской книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduction"
                    ],
                    "common_phrases": [
                        "free copy",
                        "printed copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночный экземпляр или печатная версия конкретной книги или издания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экземпляр",
                                "target_lang_sense_clarification": "отдельный предмет из тиража книг"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "отдельная книга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34de4da-a9eb-31d4-acab-087e4251c022",
                    "sense_definition": "A single instance of a specific issue of a magazine or newspaper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you seen the latest <w>copy</w> of Newsweek yet?",
                            "target_lang_translations": {
                                "ru": "Вы уже видели свежий <w>номер</w> Newsweek?"
                            }
                        },
                        {
                            "text": "He bought a <w>copy</w> of the daily newspaper at the train station.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>экземпляр</w> ежедневной газеты на вокзале."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latest copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночный экземпляр конкретного выпуска журнала или газеты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "конкретный выпуск периодического издания"
                            },
                            {
                                "target_lang_word": "экземпляр",
                                "target_lang_sense_clarification": "отдельная газета или журнал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93de3ed6-04cc-38a7-b8ba-0c3e5fb71b2a",
                    "sense_definition": "An imitation of something, often of lower quality than the original.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duplicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That designer handbag is just a cheap <w>copy</w> from the street market.",
                            "target_lang_translations": {
                                "ru": "Эта дизайнерская сумка — всего лишь дешевая <w>подделка</w> с уличного рынка."
                            }
                        },
                        {
                            "text": "You can tell it is a <w>copy</w> because the buckle is made of plastic.",
                            "target_lang_translations": {
                                "ru": "Можно понять, что это <w>копия</w>, потому что пряжка сделана из пластика."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "phony",
                        "sham"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "common_phrases": [
                        "cheap copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитация чего-либо, часто более низкого качества, чем оригинал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "неоригинальная вещь, имитация"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "воспроизведение оригинала, часто дешевое"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "качественная копия брендовой вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "749c0492-dc81-33c7-b841-20be687be231",
                    "sense_definition": "Text or content that is prepared for printing, broadcasting, or advertising.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor asked the journalist to submit all <w>copy</w> by five o'clock.",
                            "target_lang_translations": {
                                "ru": "Редактор попросил журналиста сдать весь <w>материал</w> к пяти часам."
                            }
                        },
                        {
                            "text": "This organization doesn't publish any <w>copy</w> that hasn't been edited thoroughly.",
                            "target_lang_translations": {
                                "ru": "Эта организация не публикует никакие <w>тексты</w>, которые не прошли тщательную редактуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "advertising copy",
                        "final copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текст или контент, подготовленный для печати, трансляции или рекламы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материал",
                                "target_lang_sense_clarification": "текст для публикации или эфира"
                            },
                            {
                                "target_lang_word": "рукопись",
                                "target_lang_sense_clarification": "авторский текст до публикации"
                            },
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "рекламный или информационный контент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "633e3fbb-891a-36c7-82f2-a588ce1de803",
                    "sense_definition": "A notebook or workbook used by students for schoolwork.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tim got in trouble for forgetting his maths <w>copy</w> at home.",
                            "target_lang_translations": {
                                "ru": "У Тима были неприятности из-за того, что он забыл свою <w>тетрадь</w> по математике дома."
                            }
                        },
                        {
                            "text": "The teacher collected every student's <w>copy</w> to grade the homework.",
                            "target_lang_translations": {
                                "ru": "Учитель собрал <w>тетради</w> всех учеников, чтобы проверить домашнее задание."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тетрадь или рабочая тетрадь, используемая учениками для школьных работ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тетрадь",
                                "target_lang_sense_clarification": "ученическая тетрадь для упражнений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9ea1569-756a-3574-b8bc-452050d627e6",
                    "sense_definition": "A pattern, model, or example that is intended to be imitated or followed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His many virtues are an excellent <w>copy</w> for imitation by the youth.",
                            "target_lang_translations": {
                                "ru": "Его многочисленные добродетели — отличный <w>образец</w> для подражания молодежи."
                            }
                        },
                        {
                            "text": "The student practiced writing each letter after a <w>copy</w> provided by the tutor.",
                            "target_lang_translations": {
                                "ru": "Ученик тренировался писать каждую букву по <w>образцу</w>, предоставленному репетитором."
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness",
                        "simulacrum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образец, модель или пример, предназначенный для подражания или следования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "пример для подражания"
                            },
                            {
                                "target_lang_word": "модель",
                                "target_lang_sense_clarification": "эталон для копирования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f9a090c-5a24-306d-a308-1da290f87ffe",
                    "sense_definition": "The result of gene or chromosomal duplication within a cell.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "duplicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every cell in this organism contains a <w>copy</w> of each specific gene.",
                            "target_lang_translations": {
                                "ru": "Каждая клетка этого организма содержит <w>копию</w> каждого конкретного гена."
                            }
                        },
                        {
                            "text": "The researchers studied how an extra <w>copy</w> of the chromosome affected development.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучали, как лишняя <w>копия</w> хромосомы влияет на развитие."
                            }
                        }
                    ],
                    "synonyms": [
                        "replication"
                    ],
                    "common_phrases": [
                        "gene copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат дупликации гена или хромосомы внутри клетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "дубликат генетического материала"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                    "sense_definition": "To produce an object or document that is identical to an existing one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reproduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>copy</w> these reports for me before the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>отксерокопируйте</w> мне эти отчеты до начала собрания."
                            }
                        },
                        {
                            "text": "The artist spent hours <w>copying</w> the famous painting to learn the technique.",
                            "target_lang_translations": {
                                "ru": "Художник часами <w>копировал</w> знаменитую картину, чтобы изучить технику."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduce",
                        "replicate",
                        "duplicate"
                    ],
                    "antonyms": [
                        "miscopy"
                    ],
                    "common_phrases": [
                        "copy a file",
                        "copy and paste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать объект или документ, идентичный существующему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "делать дубликат документа или картины"
                            },
                            {
                                "target_lang_word": "размножать",
                                "target_lang_sense_clarification": "делать много копий"
                            },
                            {
                                "target_lang_word": "отксерокопировать",
                                "target_lang_sense_clarification": "сделать бумажную копию на аппарате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                    "sense_definition": "To behave in the same way as someone else; to imitate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>copying</w> me and find your own way to dance!",
                            "target_lang_translations": {
                                "ru": "Хватит <w>подражать</w> мне, найди свой собственный стиль танца!"
                            }
                        },
                        {
                            "text": "Children often <w>copy</w> the behavior of their parents without realizing it.",
                            "target_lang_translations": {
                                "ru": "Дети часто <w>копируют</w> поведение своих родителей, сами того не осознавая."
                            }
                        }
                    ],
                    "synonyms": [
                        "clone"
                    ],
                    "common_phrases": [
                        "copy someone's style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя так же, как кто-то другой; подражать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подражать",
                                "target_lang_sense_clarification": "следовать чьему-то примеру или манерам"
                            },
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "повторять чьи-то действия или стиль"
                            },
                            {
                                "target_lang_word": "обезьянничать",
                                "target_lang_sense_clarification": "неосознанно или шутливо повторять за кем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b959b08-baf4-3240-90be-05af46d8f76b",
                    "sense_definition": "To store data in a temporary memory area so it can be moved or duplicated elsewhere.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reproduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "First <w>copy</w> the files, and then paste them in another directory.",
                            "target_lang_translations": {
                                "ru": "Сначала <w>скопируйте</w> файлы, а затем вставьте их в другую папку."
                            }
                        },
                        {
                            "text": "You can <w>copy</w> the text by pressing the shortcut on your keyboard.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>скопировать</w> текст, нажав комбинацию клавиш на клавиатуре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "copy and paste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять данные во временной области памяти для последующего перемещения или дублирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "помещать данные в буфер обмена"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b048936-97a6-34eb-a90b-f2d64ffc4e7e",
                    "sense_definition": "To send a duplicate of a message or email to an additional recipient.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you <w>copy</w> me on that important memo to the boss.",
                            "target_lang_translations": {
                                "ru": "Обязательно <w>поставь меня в копию</w> в той важной служебной записке боссу."
                            }
                        },
                        {
                            "text": "I will <w>copy</w> the manager on my reply so everyone stays informed.",
                            "target_lang_translations": {
                                "ru": "Я <w>поставлю в копию</w> менеджера в своем ответе, чтобы все были в курсе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "copy someone in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять дубликат сообщения или электронного письма дополнительному получателю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в копию",
                                "target_lang_sense_clarification": "добавлять получателя в поле CC письма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0442825e-0ca5-3ab6-9233-7c1558bd26e0",
                    "sense_definition": "To hear and understand a radio transmission.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hear you loud and clear; do you <w>copy</w>?",
                            "target_lang_translations": {
                                "ru": "Слышу вас громко и четко; как <w>слышно</w>?"
                            }
                        },
                        {
                            "text": "The pilot confirmed that he <w>copied</w> the instructions from the tower.",
                            "target_lang_translations": {
                                "ru": "Пилот подтвердил, что <w>принял</w> инструкции с вышки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do you copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слышать и понимать радиопередачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "слышать сигнал по радиосвязи"
                            },
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "разбирать смысл сообщения"
                            },
                            {
                                "target_lang_word": "принято",
                                "target_lang_sense_clarification": "подтверждение получения информации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}