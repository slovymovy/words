                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a gagné une <w>gentille</w> somme au loto le mois dernier."
                        },
                        {
                            "text": "Elle a hérité d'une <w>gentille</w> fortune après la mort de sa tante."
                        }
                    ],
                    "common_phrases": [
                        "une gentille somme",
                        "une gentille somme d'argent"
                    ]
