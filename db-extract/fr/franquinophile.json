                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c4c344-5182-4fe1-9c44-15d6daf1dcef",
                                "sense_id": "d8d464dd-0dc9-38cd-9894-587b2ec9e86d",
                                "text": "Le tout fait de cet album truffé d’infos un très bel objet qui satisfera autant les franquinophiles aguerris que les spirouphiles débutants !"
                            },
                            {
                                "example_id": "df68ce2c-77b8-457b-9af2-8535b85fdeac",
                                "sense_id": "d8d464dd-0dc9-38cd-9894-587b2ec9e86d",
                                "text": "José-Louis Bocquet, maître d’œuvre de ce livre et franquinophile émérite, s’est apparemment laissé bluffer par le talent de Batem, digne héritier du maître."
                            },
                            {
                                "example_id": "69643c20-c73f-403e-b454-3f5592b282a4",
                                "sense_id": "d8d464dd-0dc9-38cd-9894-587b2ec9e86d",
                                "text": "Pourtant, l’exposition ­ la plus grosse jamais consacrée à la bande dessinée ­ promet un plus-de-jouir aux franquinophiles enragés."
                            }
                        ]
