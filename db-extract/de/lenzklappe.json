                "senses": [
                    {
                        "sense_id": "1cc8c090-040d-3489-a139-9760ed1abc79",
                        "entry_id": "53acfc7f-f32a-35f1-9874-3ee965784bc8",
                        "glosses": [
                            "in der Regel manuell zu bedienendes, unter der Wasserlinie liegendes Öffnungsventil, mit dessen Hilfe kleinere Sportboote eingedrungenes Wasser wieder über Bord schaffen"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "d6550e62-e476-427c-8e03-9746840e1ef0",
                                "sense_id": "1cc8c090-040d-3489-a139-9760ed1abc79",
                                "text": "„Leider gab es noch kein Waschbord, keine Lenzklappen, kein Rollschwert, all das war längstnoch nicht erfunden.“"
                            },
                            {
                                "example_id": "b3cb2acc-cf3b-4069-b7bb-03ff4ede1c07",
                                "sense_id": "1cc8c090-040d-3489-a139-9760ed1abc79",
                                "text": "„Wir haben jedoch 2 sehr gute Lenzklappen so, dass das Boot immer wieder schnell leer war.“"
                            },
                            {
                                "example_id": "fdc399e8-90da-42bd-9e2a-957b530fde71",
                                "sense_id": "1cc8c090-040d-3489-a139-9760ed1abc79",
                                "text": "„Der Basti hätt uns keine zehn Sekunden später los schicken dürfen. Wenn ich nur wüsste, welcher Volldepp bei so einem Sturm die Lenzklappen verstopft hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
