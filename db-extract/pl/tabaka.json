                                    }
                                ]
                            },
                            {
                                "target_word": "snuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                        "entry_id": "48f7ca47-818e-3c4d-8a1d-29164d9c5e3a",
                                        "glosses": [
                                            "To inhale through the nose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9941c44-ebf1-44bb-a2aa-be6bf76df549",
                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "He snuffs the wind, his heels the sand excite."
                                            },
                                            {
                                                "example_id": "df06f4da-51fd-4e36-9059-a78a3b7ddf56",
                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "Earl Walter winds his bugle horn; / To horſe, to horſe, halloo, halloo! / His fiery courſer ſnuffs the morn, / And thronging ſerfs their Lord purſue."
                                            },
                                            {
                                                "example_id": "20675df8-8798-4692-b6fb-dbd92b58099d",
                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "Napoleon paced to and fro in silence, occasionally snuffing at the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36cdb09b-96e0-3aff-9a4d-a95000bdc154",
                                        "entry_id": "48f7ca47-818e-3c4d-8a1d-29164d9c5e3a",
                                        "glosses": [
                                            "To turn up the nose and inhale air, as an expression of contempt; hence, to take offence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7268297-d323-4284-960f-703bcc851d49",
                                                "sense_id": "36cdb09b-96e0-3aff-9a4d-a95000bdc154",
                                                "text": "January 29, 1625, Joseph Hall, Public thanksgiving for the wonderful mitigation of the late morality\nDo the enemies of the church rage and snuff?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8255ac2-f664-3400-b9f9-613ec813c944",
                                        "entry_id": "48f7ca47-818e-3c4d-8a1d-29164d9c5e3a",
                                        "glosses": [
                                            "To drug (a person) with a mixture of snuff and beer."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad56bfb-422e-33ef-9879-33d7f18ec686",
                                        "entry_id": "8f8b571f-a3d3-34de-98f3-e2f5f854d925",
                                        "glosses": [
                                            "The burning part of a candle wick, or the black, burnt remains of a wick (which must be periodically removed)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6880de-c655-48e3-8327-5f1fc174cdd3",
                                                "sense_id": "dad56bfb-422e-33ef-9879-33d7f18ec686",
                                                "text": "his memory stinks like the snuff of a candle when it is put out […]"
                                            },
                                            {
                                                "example_id": "878ea04f-91af-4e69-adbf-31d518ab66d2",
                                                "sense_id": "dad56bfb-422e-33ef-9879-33d7f18ec686",
                                                "text": "If the burning snuff happens to get out of the snuffers, you have a chance that it may fall into a dish of soup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e10f6a8-1fe3-3b9e-86a2-4246aab9b49b",
                                        "entry_id": "8f8b571f-a3d3-34de-98f3-e2f5f854d925",
                                        "glosses": [
                                            "Leavings in a glass after drinking; heeltaps."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1015e49e-f9dc-3429-8488-e8ecddd0b465",
                                        "entry_id": "8f8b571f-a3d3-34de-98f3-e2f5f854d925",
                                        "glosses": [
                                            "A murder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf6584a-2ae4-4ae3-8bb7-db3b94acd83c",
                                                "sense_id": "1015e49e-f9dc-3429-8488-e8ecddd0b465",
                                                "text": "The cops are chasing their own asses on the St Christopher case, so how about a “Are You St Christopher's Next Slaying?” piece? Profiles of all the snuffs to date and reconstructions of the victims' last minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "700c22c0-950f-3a35-a673-fa4bee1cd14e",
                                        "entry_id": "8f8b571f-a3d3-34de-98f3-e2f5f854d925",
                                        "glosses": [
                                            "A film or video clip which involves a real non-acted murder."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                                        "entry_id": "006b0685-1971-339a-a1ab-bf5cb102bbbb",
                                        "glosses": [
                                            "To extinguish a candle or oil-lamp flame by covering the burning end of the wick until the flame is suffocated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5141dd9b-89f7-4560-a3a0-9a666b06bb51",
                                                "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                                                "text": "If you like snuff stories, Mr. Witomski's computer will send you information about the Gladiator newsletter. And if you happen to prefer killing sexual partners of the opposite sex — no problem, the computer will alter the pronouns."
                                            },
                                            {
                                                "example_id": "ae432f01-f614-4df8-b860-743fb31dd839",
                                                "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                                                "text": "insane woman voice: no i’m not into snuff or gore I just like when pretty femmes get their heads chopped off"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81956c8-14df-33db-85c1-2b315ed506d6",
                                        "entry_id": "006b0685-1971-339a-a1ab-bf5cb102bbbb",
                                        "glosses": [
                                            "To trim the burnt part of a candle wick."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c240f6c-1408-4438-8d75-6b1581f5186b",
                                                "sense_id": "e81956c8-14df-33db-85c1-2b315ed506d6",
                                                "text": "The dimness of the light her candle emitted made her turn to it in alarm; but there was no danger of its sudden extinction, it had yet some hours to burn; and that she might not have any greater difficulty in distinguishing the writing than what its ancient date might occasion, she hastily snuffed it. Alas! it was snuffed and extinguished in one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                                        "entry_id": "006b0685-1971-339a-a1ab-bf5cb102bbbb",
                                        "glosses": [
                                            "To snuff out; to extinguish; to put out; to kill."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1592d9f-7fdd-4a7c-bc3e-7b84f989ecc0",
                                                "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                                                "text": "Too much of a coward to snuff myself\nGuess I'll just have to suffer myself"
                                            },
                                            {
                                                "example_id": "98f04d22-c714-42ad-9a2f-65d6c12374d1",
                                                "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                                                "text": "A court yesterday rejected a challenge to the constitutionality of prohibiting same-sex marriage, snuffing hopes for marriage equality proponents to shortcut stalled legislative efforts."
                                            }
