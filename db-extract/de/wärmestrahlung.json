                ],
                "senses": [
                    {
                        "sense_id": "4d614fe0-2e81-3808-834b-8d0802dc53e0",
                        "entry_id": "9d47ecd5-0c41-309d-ba7f-ef3c5fe3a442",
                        "glosses": [
                            "elektromagnetische Wellen im Bereich zwischen sichtbarem Licht und der Terahertzstrahlung (mit einer Wellenlänge zwischen 1 mm und 780 nm)"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "ac61b501-61d8-4f9c-ac9f-4696769b3288",
                                "sense_id": "4d614fe0-2e81-3808-834b-8d0802dc53e0",
                                "text": "„Die heiße Wärmestrahlung von einst hat heute Frequenzen, die im Bereich der Mikrowellen liegen, und ihre Temperatur beträgt nur noch knapp drei Kelvin. Als Hintergrundstrahlung erfüllt sie gleichmäßig das gesamte Universum.“"
                            },
                            {
                                "example_id": "d8419b3e-c4d0-4c29-97fd-613cda7a5c92",
                                "sense_id": "4d614fe0-2e81-3808-834b-8d0802dc53e0",
                                "text": "„Kurzwellige Sonnenstrahlung dringt von außen durch die Erdatmosphäre ein und wandelt sich in langwelligere Wärmestrahlung um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
