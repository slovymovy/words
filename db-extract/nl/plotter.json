                            {
                                "example_id": "2c74c84b-3fc5-43b3-a245-770966892ce9",
                                "sense_id": "ae2881b1-bb1a-32fa-974f-e66a4d3901a7",
                                "text": "Gaat Honders met het mousselineglas terug in de tijd en doen de ontwerpen inderdaad ouderwets aan, hij gebruikt bij het vervaardigen van 'zijn' figuren wel de modernste hulpmiddelen. \"Voorheen werd gebruikt gemaakt van zinken mallen. Ik heb de figuren opnieuw in de computer moeten tekenen en heb ze toen ingescand\", vertelt Honders, die de afbeeldingen vervolgens naar een plotter (computergestuurde tekenmachine) heeft gestuurd. Die draait de figuren uit."
                            },
                            {
                                "example_id": "fb7b3f73-69d9-4f0a-b98e-d04d89a9c33f",
                                "sense_id": "ae2881b1-bb1a-32fa-974f-e66a4d3901a7",
                                "text": "Het dashboard op de stuurconsole is zo groot, dat je er een 11 inch plotter op kwijt zou kunnen."
                            }
                        ]
                    }
