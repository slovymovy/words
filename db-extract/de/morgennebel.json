                "senses": [
                    {
                        "sense_id": "0fd6c740-1e22-349e-8bee-cba19d9d82ee",
                        "entry_id": "04ba4afb-1ab0-3945-8ec6-712cd28351ed",
                        "glosses": [
                            "Nebel am frühen Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c8f363-aa01-420e-aee6-a5e1f24b4d1f",
                                "sense_id": "0fd6c740-1e22-349e-8bee-cba19d9d82ee",
                                "text": "Sie fuhr wegen des Morgennebels sehr langsam."
                            },
                            {
                                "example_id": "40621bbb-b488-45cb-93da-0480182f4305",
                                "sense_id": "0fd6c740-1e22-349e-8bee-cba19d9d82ee",
                                "text": "„Der Eingang war im Morgennebel nur verschwommen zu erkennen.“"
                            },
                            {
                                "example_id": "f03b74f9-0078-4fc8-9eb0-7ec8d319cbd5",
                                "sense_id": "0fd6c740-1e22-349e-8bee-cba19d9d82ee",
                                "text": "„Nach einiger Zeit sahen die Siedler die ganze Washington-Bai vor sich liegen, das 40 km entfernte Krallenkap verschwamm aber noch im Morgennebel, es schien, als hinge es halb in der Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
