                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f45e493-8bcf-3a09-92e4-3fcd4d62a8df",
                        "entry_id": "8f3eee4a-1c79-3dc1-829a-df23abac410c",
                        "glosses": [
                            "Outil pour enfoncer les clous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8836a72-aa37-46ab-bf8e-9234d7a7dd1d",
                                "sense_id": "4f45e493-8bcf-3a09-92e4-3fcd4d62a8df",
                                "text": "Dans la gamme de ses cloueurs pneumatiques utilisant de vraies pointes à tête ronde, la Société Agrafvit vient de lancer le modèle « IN. 123 », actuellement unique en son genre […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5c8ffcc-5083-3ff9-8e47-988516bf475c",
                        "entry_id": "8f3eee4a-1c79-3dc1-829a-df23abac410c",
                        "glosses": [
                            "Personne qui plante des clous."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "243c650b-64ed-4240-9f05-6d1a5691091e",
                                "sense_id": "c5c8ffcc-5083-3ff9-8e47-988516bf475c",
                                "text": "L’officier cloué se retire et va se faire panser. Lorsqu’il est guéri, il vient trouver l’officier cloueur et lui demande raison ;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5f3bd45-a829-4c26-b659-2b91bf61bd4a",
                        "source_entry_id": "8f3eee4a-1c79-3dc1-829a-df23abac410c",
                        "source_sense_description": "Outil",
                        "target_lang_word": "Druckluftnagler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druckluftnagler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                        "entry_id": "7003f111-fbb3-3afc-8f29-fd4552b270c1",
                                        "glosses": [
                                            "mit Druckluft angetriebenes Gerät zum Nageln von Holzplatten, Latten, Bohlen, bei dem Nägel aus einem Magazin mit großer Kraft in das Material getrieben werden; Druckluftnagler arbeiten meist mithilfe eines (meist langen) Schlauchs und eines Kompressors; Druckluftnagler ermöglichen eine hohe Arbeitsgeschwindigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a9651b6-6b44-4c31-9569-9221a0436d28",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Der klassische Druckluftnagler wird in erster Linie beim Hausbau eingesetzt und erzielt gute Ergebnisse bei Dachlatten, Vollholzplatten oder Leisten. Er ist sehr robust.“"
                                            },
                                            {
                                                "example_id": "d93ec6e4-cf83-472b-8088-5cc191cad746",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Ein Druckluftnagler schießt Nägel rasend schnell in Bretter und Leisten.“"
                                            },
                                            {
                                                "example_id": "6a45aa95-7588-4911-a874-ea792526a72c",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Wer im Bereich Holzbearbeitung tätig ist, kann sich das Leben mit einem Druckluftnagler […] erheblich erleichtern.“"
                                            },
                                            {
                                                "example_id": "ce9ffb06-4b79-41b3-a389-68a50f47d80a",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Die Nägel befinden sich […] in einem Magazin. Daraus zieht der Druckluftnagler die Nägel nacheinander ein und schießt sie dann in Bretter oder Leisten, und zwar in Sekundenschnelle. Mit einem Hammer würde diese Arbeit wesentlich länger dauern.“"
                                            },
                                            {
                                                "example_id": "e5c08935-102f-4ff8-b689-1842820858b0",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Damit ein Druckluftnagler funktioniert, benötigt er Druckluft – entweder aus einem Kompressor oder einer Kartusche.“"
                                            },
                                            {
                                                "example_id": "43bca86f-514c-4f9a-ae31-37df6e83f789",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Die Druckluftnagler funktionieren mithilfe eines Kompressors, der per Schlauch mit dem Gerät verbunden wird.“"
                                            },
                                            {
                                                "example_id": "7130fbe5-779f-4b2a-9b97-349d2e44451e",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Am besten eignen sich Druckluftnagler, um schnell Vollholzbretter, Sockelleisten oder Gipskartonplatten zu befestigen.“"
                                            },
                                            {
                                                "example_id": "47015e0e-f126-499f-b5fb-346d4834717c",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Wenn Sie den Druckluftnagler bei Dachlatten anwenden möchten, so empfehlen wir Nägel mit einer Größe von 50 mm.“"
                                            },
                                            {
                                                "example_id": "7ef473be-b61a-4977-9b7e-5518712228af",
                                                "sense_id": "f62e12cd-a0ca-3c35-950c-1972b9a0d771",
                                                "text": "„Nach dem Vorbild eines in den USA hergestellten Geräts entwickelte und vermarktete BeA in den 1950er Jahren den ersten eigenen Druckluftnagler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
