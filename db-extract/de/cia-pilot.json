                "senses": [
                    {
                        "sense_id": "cec0699d-82f0-3041-a85f-74bd43225db7",
                        "entry_id": "b3da7a61-d137-3cf1-9d5d-a04cd791fb08",
                        "glosses": [
                            "Pilot, der im Auftrag des US-amerikanischen Auslandsnachrichtendienstes CIA fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61490309-88da-4c03-80da-4948ede133ea",
                                "sense_id": "cec0699d-82f0-3041-a85f-74bd43225db7",
                                "text": "„Am 19. April 1958 begannen die CIA-Piloten mit der Bombardierung und dem Beschuss der vorgelagerten indonesischen Inseln.“"
                            },
                            {
                                "example_id": "9f551d2a-6c2e-4f40-89d4-211467afa078",
                                "sense_id": "cec0699d-82f0-3041-a85f-74bd43225db7",
                                "text": "„Wenn ein früherer CIA-Pilot ins Plaudern kommt, hört man von dubiosen Geheimdienstaktionen.“"
                            },
                            {
                                "example_id": "1c3df26b-09a5-4ec4-8b10-4db55129bb99",
                                "sense_id": "cec0699d-82f0-3041-a85f-74bd43225db7",
                                "text": "„Fallschirmspringer der regulären Sukarno-Truppen sammelten die vielen Kisten wieder ein, die die CIA-Piloten zuvor abgeworfen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
