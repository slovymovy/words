                    "synonyms": [
                        "chancy",
                        "risky"
                    ],
                    "antonyms": [
                        "safe",
                        "secure"
                    ],
                    "common_phrases": [
                        "dodgy area",
                        "dodgy situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe situations that feel unsafe or uncertain."
                        }
