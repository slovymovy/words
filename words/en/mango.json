                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9bfdfc2-45c6-3b93-896d-f52e3e16cf84",
                    "sense_definition": "A language spoken in parts of China or Chad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "languages",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The researcher traveled to the region to study the local <w>Mango</w> dialect.",
                            "target_lang_translations": {
                                "ru": "Исследователь отправился в регион, чтобы изучить местный диалект <w>манго</w>."
                            }
