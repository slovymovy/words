                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c6c6b15f-4cdd-376a-841f-222a7a20f0bd",
                        "entry_id": "4c3151ae-cca5-3604-ba74-501312658190",
                        "glosses": [
                            "mający kolor ciemnozielony, taki jak kolor szklanej butelki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1749dc-3b0b-4449-b7ba-fcf999315ff5",
                                "sense_id": "c6c6b15f-4cdd-376a-841f-222a7a20f0bd",
                                "text": "Jesień świetnie wygląda w ciepłych zieleniach, od groszkowej, przez oliwkową, do butelkowej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "bb990972-692e-3c3d-bfae-e53d8748a5d8",
                        "entry_id": "4c3151ae-cca5-3604-ba74-501312658190",
                        "glosses": [
                            "przypominający kształtem butelkę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a85306-c067-4a4c-9883-c65acc0e7415",
                                "sense_id": "bb990972-692e-3c3d-bfae-e53d8748a5d8",
                                "text": "Zdołał nawet wypatrzeć w pobliżu toru kolejowego sławne drzewo butelkowe o wypukłym pniu w kształcie flaszki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
