                                    {
                                        "sense_id": "8fb2eb5b-ace2-346e-b63e-0d4ef1d9530f",
                                        "entry_id": "28820ba4-6b0a-3615-b897-8e3b016118d0",
                                        "glosses": [
                                            "Formular oder schriftlicher Nachweis für [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1908f7d9-79b8-4951-963c-0a3c0ca5d647",
                                                "sense_id": "8fb2eb5b-ace2-346e-b63e-0d4ef1d9530f",
                                                "text": "Zeigen Sie Ihre Anmeldung dem Beamten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c93639e8-d94d-38fc-bc4c-f6e70f57a901",
                                        "entry_id": "28820ba4-6b0a-3615-b897-8e3b016118d0",
                                        "glosses": [
