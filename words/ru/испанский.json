                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Spaans",
                                "target_lang_sense_clarification": "gebruikt om eigenschappen of culturele uitingen te beschrijven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e00ac03-4288-3da5-b335-43b80c78cc1f",
                    "sense_definition": "Принадлежащий Испании или испанцам.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отношение к Испании",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>испанский</w> паспорт.",
                            "target_lang_translations": {
                                "nl": "Dit is een <w>Spaans</w> paspoort."
                            }
                        },
                        {
                            "text": "На столе лежал <w>испанский</w> флаг.",
                            "target_lang_translations": {
                                "nl": "Op tafel lag een <w>Spaanse</w> vlag."
                            }
                        }
                    ],
                    "target_lang_definitions": {
