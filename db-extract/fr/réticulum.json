                        "entry_id": "bca8de04-a81a-3c14-a71c-0e976b09416a",
                        "glosses": [
                            "Organite présent dans les cellules eucaryotes, élément essentiel du réseau membranaire interne des cellules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae80154-4da0-4000-95ff-c2448cf03540",
                                "sense_id": "e327deea-b67c-3135-87e8-4f690750d56e",
                                "text": "Le réticulum sarcoplasmique est le nom donné au réticulum endoplasmique lisse des cellules musculaires striées squelettiques."
                            },
                            {
                                "example_id": "39cdd879-de7a-481c-98fa-6188d242a204",
                                "sense_id": "e327deea-b67c-3135-87e8-4f690750d56e",
                                "text": "La face externe de la membrane du réticulum est en contact avec le cytoplasme, la face interne avec le contenu du réticulum."
                            }
                        ]
                    }
                ],
