                "senses": [
                    {
                        "sense_id": "23837af1-ca26-3ec9-b64b-f9c88acdd0e4",
                        "entry_id": "9fc2e328-ed7a-311b-9a26-2bcf29a6ffd0",
                        "glosses": [
                            "in einer Entscheidungssituation einander widersprechende Wertvorstellungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a05469-281c-4dfe-9cc1-5c621ceaf7f5",
                                "sense_id": "23837af1-ca26-3ec9-b64b-f9c88acdd0e4",
                                "text": "„Im Kaukasus durchlitt sie aber einen echten Gewissenskonflikt.“"
                            },
                            {
                                "example_id": "1c39280c-24a3-4758-a19f-80e51b9c7f22",
                                "sense_id": "23837af1-ca26-3ec9-b64b-f9c88acdd0e4",
                                "text": "„Davon abgesehen würde er Kanther in einen heftigen Gewissenskonflikt stürzen.“"
                            },
                            {
                                "example_id": "eed39bfe-cd6a-4e3b-bf08-39a8846cc11a",
                                "sense_id": "23837af1-ca26-3ec9-b64b-f9c88acdd0e4",
                                "text": "„Womöglich ließ er diesen Gedanken nicht zu oder verdrängte ihn, um nicht in Gewissenskonflikte zu geraten – und in Gefahr, denn alleine der Verdacht, dass ein deutscher Soldat mit jemandem aus der Résistance befreundet war, reichte, um vors Kriegsgericht gestellt und zum Tode verurteilt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
