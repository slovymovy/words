                "senses": [
                    {
                        "sense_id": "4ab27840-9774-314a-8eb8-72be1c6b3a6f",
                        "entry_id": "2b4d7f01-bca3-3607-86af-7470edf886f9",
                        "glosses": [
                            "действие по значению гл. скатывать, скатываться; качение, перемещение вниз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01732e1-b989-4041-a1bb-f340ec22955b",
                                "sense_id": "4ab27840-9774-314a-8eb8-72be1c6b3a6f",
                                "text": "Известны случаи скатывания камней более ста тонн весом."
                            },
                            {
                                "example_id": "d79572bb-e9db-41f8-afde-08d4f1bf4cc9",
                                "sense_id": "4ab27840-9774-314a-8eb8-72be1c6b3a6f",
                                "text": "Эта же конфигурация схожа с детской горкой, обитой жестью для круглогодичного скатывания."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b4b6dd1-7ff8-3256-9b61-1b383d7b81de",
                        "entry_id": "2b4d7f01-bca3-3607-86af-7470edf886f9",
                        "glosses": [
                            "перен. отказ от чего-либо передового, прогрессивного, переход от более высокого, желательного уровня, состояния чего-либо к более низкому, худшему"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881d65ca-8514-4294-9a07-90063d9520ef",
                                "sense_id": "3b4b6dd1-7ff8-3256-9b61-1b383d7b81de",
                                "text": "Таким образом Банк Японии пытается предотвратить скатывание национальной экономики к дефляции."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7705f1a1-a0b4-4914-a458-b6354ed66826",
                        "source_entry_id": "2b4d7f01-bca3-3607-86af-7470edf886f9",
                        "source_sense_description": "качение, перемещение вниз",
                        "target_lang_word": "dévalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86dea164-83ff-3901-8729-df311a6e2b0b",
                                        "entry_id": "0ea6a46d-5048-312f-878c-22401a006724",
                                        "glosses": [
                                            "Action de dévaler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740cd823-e304-4e18-9a53-a8741831959e",
                                                "sense_id": "86dea164-83ff-3901-8729-df311a6e2b0b",
                                                "text": "A mesure que la voiture, dans un dévalement forcené, plongeait vers la plaine, j’avais moins l’impression de descendre que plutôt de sentir monter à moi la fournaise."
                                            },
                                            {
                                                "example_id": "b7ca8f4a-8ab5-4dea-8642-8c8bd6eec19a",
                                                "sense_id": "86dea164-83ff-3901-8729-df311a6e2b0b",
                                                "text": "Le chemin ne se décidait pas à redescendre et courait sur la crête de la colline, d’ailleurs très large, presque un plateau ondulé et qui s’enracinait de droite et de gauche dans les dévalements en pente douce de collines plus hautes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
