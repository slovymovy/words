                                                "sense_id": "723cffad-8bc5-36f4-993c-81e66e034034",
                                                "text": "Sie waren im Nu wieder zurück."
                                            },
                                            {
                                                "example_id": "982201e9-3973-4dd0-8c04-64ee0d588f08",
                                                "sense_id": "723cffad-8bc5-36f4-993c-81e66e034034",
                                                "text": "Die Ferien vergingen im Nu."
                                            },
                                            {
                                                "example_id": "22807bcf-7dfe-4448-a497-d73a94a20f4f",
                                                "sense_id": "723cffad-8bc5-36f4-993c-81e66e034034",
                                                "text": "„Doch die Regenzeit stand kurz bevor, und wenn die Straße unasphaltiert blieb, würde die ganze Arbeit im Nu weggespült werden.“"
                                            }
                                        ],
