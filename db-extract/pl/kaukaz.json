                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4773be87-a44c-4d4b-8397-8071d97d277e",
                        "source_entry_id": "1b42b1f9-433e-38e2-b00e-be1e322992af",
                        "source_sense_id": "36012268-a9e9-392f-940d-36029977dfc4",
                        "target_lang_word": "Кавказ",
                        "target_lang_code": "ru",
