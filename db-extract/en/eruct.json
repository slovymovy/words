                ],
                "senses": [
                    {
                        "sense_id": "bbcf2f5b-05a9-3465-a11a-600f9cd334be",
                        "entry_id": "25a72a04-61a8-378c-9963-aa3006d77591",
                        "glosses": [
                            "To burp or belch."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1f94f153-d1d2-454f-b6bc-e7e17f31437d",
                                "sense_id": "bbcf2f5b-05a9-3465-a11a-600f9cd334be",
                                "text": "He ate voraciously, smacking his lips, breathing hard, now and then eructing with frank energy and satisfaction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "639718db-7f42-4603-ab29-492d4bb324a9",
                        "source_entry_id": "25a72a04-61a8-378c-9963-aa3006d77591",
                        "source_sense_id": "bbcf2f5b-05a9-3465-a11a-600f9cd334be",
                        "source_sense_description": "to burp or belch — see also eructate",
                        "target_lang_word": "éructer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éructer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd5990e-5bb7-3e3f-b524-5290e656d061",
                                        "entry_id": "8b501ee9-5b26-3494-a195-c0de93545ec0",
                                        "glosses": [
                                            "Rendre bruyamment par la bouche les gaz contenus dans l’estomac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af212c7-a8b0-40c7-9953-af3a518d3c2d",
                                                "sense_id": "2bd5990e-5bb7-3e3f-b524-5290e656d061",
                                                "text": "Il buvait beaucoup, selon l’usage des pays de l’Est. Cela m’effrayait à cause d’un accident possible en repartant sur l’autoroute mais ne me répugnait pas. Même s’il lui arrivait de tituber, ou d’éructer en m’embrassant. Au contraire, j’étais heureuse d’être unie à lui dans un début d’abjection."
                                            },
                                            {
                                                "example_id": "5e8b9885-152d-4c92-8393-071771ab44e5",
                                                "sense_id": "2bd5990e-5bb7-3e3f-b524-5290e656d061",
                                                "text": "Si les éleveurs ne peuvent pas empêcher les vaches d’éructer, certains agroindustriels cherchent à dépolluer cette filière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8b0c2c5-6d30-3119-8600-d4fc86fe5362",
                                        "entry_id": "8b501ee9-5b26-3494-a195-c0de93545ec0",
                                        "glosses": [
                                            "Sortir d’un conduit, en parlant d’un gaz, de vapeur, de fumée, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7f23b9e-85df-4501-b6f5-1387767ebbd0",
                                                "sense_id": "a8b0c2c5-6d30-3119-8600-d4fc86fe5362",
                                                "text": "Les navires marchands, les bateaux à vapeur, dont les cheminées éructent de la vapeur bicolore, s’approchent davantage du bord à cause de leur plus faible tonnage et forment les premiers plans de ce grand tableau naval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "022da057-a424-30fa-988e-a14328b5af6a",
                                        "entry_id": "8b501ee9-5b26-3494-a195-c0de93545ec0",
                                        "glosses": [
                                            "Communiquer verbalement (menaces, insultes, etc.)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b37547-5e9b-4a62-818d-3228d397b0ef",
                                                "sense_id": "022da057-a424-30fa-988e-a14328b5af6a",
                                                "text": "Il éructa un monologue pointillé et haché par une série de soubresauts et de hoquets."
                                            },
                                            {
                                                "example_id": "21620761-9c83-4efd-bdf4-66a81307ff92",
                                                "sense_id": "022da057-a424-30fa-988e-a14328b5af6a",
                                                "text": "Dans ce « oh ! », éructé du fin fond de la gorge, un monde de haine tenait."
                                            },
                                            {
                                                "example_id": "17ac48ec-72ef-4b64-bfd0-b83d0215076d",
                                                "sense_id": "022da057-a424-30fa-988e-a14328b5af6a",
                                                "text": "Amir Attaran, dont on parle beaucoup ces jours-ci, n’est pas vraiment intéressant en lui-même. Il éructe, il insulte, il fait tourner en boucle les quelques étiquettes qu’il croit devoir coller au Québec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
