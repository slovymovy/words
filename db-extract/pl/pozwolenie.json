                                "target_senses": [
                                    {
                                        "sense_id": "0268ca06-51e4-3eb7-b537-ba86309bcb0a",
                                        "entry_id": "0281c1b5-f5d1-348f-aa5f-301b9144d1c2",
                                        "glosses": [
                                            "Acción o efecto de autorizar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62292913-4cab-4561-9745-d4ec47e81b21",
                                                "sense_id": "0268ca06-51e4-3eb7-b537-ba86309bcb0a",
                                                "text": "«Pruébase con el documento número dos, en donde están probadas las astucias y cavilaciones de los mismos acusadores actuadas por mi antecesor, el teniente coronel don Juan Fernández de Bobadilla, en que está inclusa una certificación del Gobernador […], y aunque dicho documento se halla sin la autorización correspondiente, están los originales en el Supremo Tribunal de la real Audiencia de este reino […]»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ffbdaf4-a224-3544-b0fd-c589882254a0",
                                        "entry_id": "0281c1b5-f5d1-348f-aa5f-301b9144d1c2",
                                        "glosses": [
                                            "Permiso o poder otorgado por una autoridad (autorización administrativa)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "312ec1ab-93a8-4fe2-8bb8-a4f5f581669f",
                        "source_entry_id": "5820910a-a7ee-30f5-ba3a-bd5e2ef88776",
                        "source_sense_id": "a79c48c0-1de2-3b82-8149-cb228724f186",
                        "target_lang_word": "Erlaubnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erlaubnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                        "entry_id": "2eb55e3e-4176-3ef7-8352-fb5bbca9c6b2",
                                        "glosses": [
                                            "Genehmigung von etwas, Einverständnis mit etwas; Bestätigung, dass etwas Bestimmtes getan werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3769c44-02c6-4318-80d7-76d8a4d087a2",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "„Niemand darf das ohne gräfliche Erlaubnis. Sie aber haben eine solche Erlaubnis nicht oder haben sie wenigstens nicht vorgezeigt.“"
                                            },
                                            {
                                                "example_id": "1f5dfbf3-ff75-42be-892e-b885b8bd4b40",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "„Aber wir dürfen es nicht, wir müssen auf den Befehl oder wenigstens die Erlaubnis zum Treck warten, die ein bestempeltes Papier ausweist.“"
                                            },
                                            {
                                                "example_id": "e97a4de4-bec5-488c-ada2-8f44819621a9",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "„Die Erlaubnis für Außenlandungen von Motorseglern und Segelflugzeugen, die sich auf einem Überlandflug befinden, gilt als erteilt.“"
                                            },
                                            {
                                                "example_id": "edcca3dd-b4ff-44b5-b0fd-07492002bd64",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "„Wir begannen wieder zu tanzen, bis schließlich die Erlaubnis zum Fandango kam, zu dem ich mit meiner Partnerin antrat, die ihn wunderbar tanzte und erstaunt war, daß ein Fremder ihn so gut beherrschte.“"
                                            },
                                            {
                                                "example_id": "f1073569-6940-4d7b-9203-98537a37713a",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "Der Eigentümer des Ackers gab uns die Erlaubnis, unser Kunstwerk dort aufzustellen."
                                            },
                                            {
                                                "example_id": "00c515be-861f-4d8a-b900-41e489980966",
                                                "sense_id": "46e9c450-4ae5-3a79-ac42-6d13a9335ec2",
                                                "text": "Lizzy kann mitkommen nach Rom. Sie hat die Erlaubnis ihrer Mutter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f67025d-8ff4-3740-8ae6-90b151affa05",
                                        "entry_id": "2eb55e3e-4176-3ef7-8352-fb5bbca9c6b2",
                                        "glosses": [
                                            "Verwaltungsakt, mit dem dem Bürger unter einem präventiven Verbot mit Erlaubnisvorbehalt stehende Vorhaben und Betätigungen gestattet werden, ohne bestimmte Vorhaben oder Betätigungen per se zu verbieten, sondern nur, um der Behörde im jeweiligen Einzelfall die Prüfung darüber zu ermöglichen, ob das Vorhaben oder die Betätigung gegen materielles Recht verstößt"
                                        ],
                                        "tags": [
                                            "Verwaltungsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf3baaa-e036-42ad-ba1d-8526eb320c22",
                                                "sense_id": "0f67025d-8ff4-3740-8ae6-90b151affa05",
                                                "text": "Bei Vorliegen der Genehmigungsvoraussetzungen besteht auf die Baugenehmigung, die eine Erlaubnis ist, ein Anspruch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
