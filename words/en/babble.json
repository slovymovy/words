{
    "word_family": [
        "babbler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                    "sense_definition": "Inarticulate speech or constant, confused murmuring sounds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>babble</w> of the young children filled the room with noise.",
                            "target_lang_translations": {
                                "zh": "孩子们<w>咿呀</w>的吵闹声充斥了整个房间。"
                            }
                        },
                        {
                            "text": "I could only hear the constant <w>babble</w> of voices from the crowded hallway.",
                            "target_lang_translations": {
                                "zh": "我只能听到走廊里传来一阵阵<w>嘈杂</w>的人声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "constant babble"
                    ],
                    "target_lang_definitions": {
                        "zh": "含糊不清的说话声或持续不断的嘈杂声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘈杂声",
                                "target_lang_sense_clarification": "指混乱且难以辨认的说话声。"
                            },
                            {
                                "target_lang_word": "咿呀声",
                                "target_lang_sense_clarification": "特指幼儿发出的含糊声音。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                    "sense_definition": "Idle, senseless, or foolish talk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ignore his political <w>babble</w> as it makes no sense at all.",
                            "target_lang_translations": {
                                "zh": "别理会他的政治<w>废话</w>，那根本毫无意义。"
                            }
                        },
                        {
                            "text": "The meeting was just a lot of empty <w>babble</w> without any real plans.",
                            "target_lang_translations": {
                                "zh": "会议上尽是些没有实际计划的<w>空谈</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gabble",
                        "twaddle"
                    ],
                    "common_phrases": [
                        "empty babble"
                    ],
                    "target_lang_definitions": {
                        "zh": "无意义的、愚蠢的或空洞的废话。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "指没有实际意义或价值的言论。"
                            },
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "指说话逻辑混乱或毫无根据。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                    "sense_definition": "A sound like that of water flowing gently over stones.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat by the river and listened to the soft <w>babble</w> of the water.",
                            "target_lang_translations": {
                                "zh": "我们坐在河边，听着水流<w>潺潺</w>的声音。"
                            }
                        },
                        {
                            "text": "The gentle <w>babble</w> of the stream helped me fall asleep quickly.",
                            "target_lang_translations": {
                                "zh": "小溪<w>潺潺</w>的流水声让我很快入睡了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "babble of the stream"
                    ],
                    "target_lang_definitions": {
                        "zh": "水流过石头时发出的轻柔潺潺声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潺潺声",
                                "target_lang_sense_clarification": "形容流水发出的轻柔声音。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                    "sense_definition": "To speak in an unclear, unintelligible, or childish way.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby began to <w>babble</w> happily in its crib.",
                            "target_lang_translations": {
                                "zh": "婴儿在摇篮里开心地<w>咿呀学语</w>。"
                            }
                        },
                        {
                            "text": "He could only <w>babble</w> incoherently after the accident.",
                            "target_lang_translations": {
                                "zh": "事故之后，他只能<w>含糊不清地说</w>些前后不搭的话。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以含糊、难以理解或幼稚的方式说话。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咿呀学语",
                                "target_lang_sense_clarification": "形容婴儿发出含糊的声音。"
                            },
                            {
                                "target_lang_word": "含糊不清地说",
                                "target_lang_sense_clarification": "指说话不清晰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                    "sense_definition": "To talk too much or chatter aimlessly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>babble</w> on for hours about her favorite television shows.",
                            "target_lang_translations": {
                                "zh": "她总是<w>喋喋不休</w>地聊上几个小时她最喜欢的电视节目。"
                            }
                        },
                        {
                            "text": "Please stop <w>babbling</w> and tell me the important news.",
                            "target_lang_translations": {
                                "zh": "请别再<w>唠叨</w>了，快告诉我重要的消息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gabble"
                    ],
                    "common_phrases": [
                        "babble on"
                    ],
                    "target_lang_definitions": {
                        "zh": "喋喋不休或漫无目的地闲聊。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喋喋不休",
                                "target_lang_sense_clarification": "形容说话没完没了。"
                            },
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "指琐碎且重复地说话。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                    "sense_definition": "To make a continuous murmuring noise, like shallow water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small creek continued to <w>babble</w> through the quiet forest.",
                            "target_lang_translations": {
                                "zh": "小溪在寂静的森林中<w>潺潺</w>流过。"
                            }
                        },
                        {
                            "text": "I love to hear the water <w>babble</w> over the rocks in the garden.",
                            "target_lang_translations": {
                                "zh": "我喜欢听花园里水流过岩石时发出的<w>潺潺</w>声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "water babble"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出像浅水流过时那样的持续潺潺声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潺潺作响",
                                "target_lang_sense_clarification": "形容水流发出的声音。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d682684-06b9-39d9-b933-f540bdd3f16a",
                    "sense_definition": "To accidentally reveal a secret.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not mean to <w>babble</w> the surprise to everyone.",
                            "target_lang_translations": {
                                "zh": "他不是故意<w>说漏嘴</w>把惊喜告诉大家的。"
                            }
                        },
                        {
                            "text": "She was so nervous that she started to <w>babble</w> the truth.",
                            "target_lang_translations": {
                                "zh": "她太紧张了，以至于<w>说漏嘴</w>讲出了真相。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因紧张或不小心而说漏嘴，泄露秘密。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "说漏嘴",
                                "target_lang_sense_clarification": "指无意中泄露了不该说的话。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}