                                        "glosses": [
                                            "Bezeichnung des europäischen Wildapfels Malus sylvestris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eff43db-148d-43b7-bbab-e76bb042b6f4",
                                                "sense_id": "d12f0f75-3b47-3255-ab9b-d370501a8754",
                                                "text": "„Die Germanen kannten als einzige Obstsorten nur die wild wachsenden Holzäpfel und Holzbirnen.“"
                                            },
                                            {
                                                "example_id": "9dff0e29-0c5e-47f4-96c2-b7175d46c208",
                                                "sense_id": "d12f0f75-3b47-3255-ab9b-d370501a8754",
                                                "text": "„Selbst mehr als 150 Jahre, nachdem die Bewohner von europäischen Kolonisten zwangsumgesiedelt wurden, lassen sich diese »Waldgärten«, so der Terminus der Forschenden, am Reichtum von Haselnüssen, Moosbeeren, Hagedorn und Holzäpfeln erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36b3b97c-5cd4-38bf-93a0-c1d8fe8c8658",
