    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62c8b591-fb3e-3540-a0ae-7695a37c6fc2",
                    "sense_definition": "zacząć istnieć, rozwinąć się lub pojawić w wyniku określonych działań bądź procesów",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "istnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszym mieście niedawno <w>powstała</w> nowa galeria handlowa.",
                            "target_lang_translations": {
                                "en": "A new shopping mall recently <w>opened</w> in our town."
                            }
                        },
                        {
                            "text": "Ten ciekawy projekt <w>powstał</w> dzięki owocnej współpracy kilku młodych artystów.",
                            "target_lang_translations": {
                                "en": "This interesting project <w>came into being</w> thanks to the fruitful collaboration of several young artists."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powstać z popiołów",
                        "powstał nowy budynek"
                    ],
                    "target_lang_definitions": {
                        "en": "to come into existence, to be created, or to emerge as a result of certain actions or processes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come into being",
                                "target_lang_sense_clarification": "to begin to exist"
                            },
                            {
                                "target_lang_word": "be created",
                                "target_lang_sense_clarification": "to be established or produced"
                            },
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to originate or come about"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "to become apparent or form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1035c568-2910-3695-aa97-99a7f6a434fe",
                    "sense_definition": "podnieść się z pozycji siedzącej lub leżącej do pozycji stojącej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy sędzia wszedł na salę, wszyscy zebrani <w>powstali</w> ze swoich miejsc.",
                            "target_lang_translations": {
                                "en": "When the judge entered the courtroom, everyone gathered <w>rose</w> from their seats."
                            }
                        },
                        {
                            "text": "Nauczyciel poprosił, aby uczniowie <w>powstali</w> na powitanie gości.",
                            "target_lang_translations": {
                                "en": "The teacher asked the students to <w>stand</w> to welcome the guests."
                            }
                        }
                    ],
                    "synonyms": [
                        "wstać"
                    ],
                    "common_phrases": [
                        "powstać z miejsc",
                        "powstać z kolan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "częściej używane w podniosłym lub oficjalnym rejestrze"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to stand up or rise from a sitting or lying position (often formal or solemn)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "formal; to stand up"
                            },
                            {
                                "target_lang_word": "stand up",
                                "target_lang_sense_clarification": "to get on one's feet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3637ee87-7d32-3d78-93cd-999a198d60b5",
                    "sense_definition": "chwycić za broń i zbuntować się przeciwko władzy lub ciemiężycielowi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieszkańcy stolicy <w>powstali</w> przeciwko okupantowi, walcząc o wolność swojego kraju.",
                            "target_lang_translations": {
                                "en": "The residents of the capital <w>rose up</w> against the occupier, fighting for the freedom of their country."
                            }
                        },
                        {
                            "text": "Cały naród <w>powstał</w> do walki z niesprawiedliwym tyranem.",
                            "target_lang_translations": {
                                "en": "The whole nation <w>rose</w> to fight against the unjust tyrant."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powstać przeciwko władzy",
                        "powstać do walki"
                    ],
                    "target_lang_definitions": {
                        "en": "to take up arms and revolt against an authority, oppressor, or occupier"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise up",
                                "target_lang_sense_clarification": "to revolt or rebel"
                            },
                            {
                                "target_lang_word": "revolt",
                                "target_lang_sense_clarification": "to stage an armed rebellion"
                            },
                            {
                                "target_lang_word": "rebel",
                                "target_lang_sense_clarification": "to take up arms against authority"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f26b4f1-aa74-3482-98af-64943ceb3fa3",
                    "sense_definition": "stanowczo wyrazić sprzeciw, zaprotestować przeciwko czemuś w dyskusji lub sporze",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu radnych ostro <w>powstało</w> przeciwko planowanym cięciom w budżecie edukacji.",
                            "target_lang_translations": {
                                "en": "Many councillors strongly <w>spoke out against</w> the planned cuts to the education budget."
                            }
                        },
                        {
                            "text": "Krytycy natychmiast <w>powstali</w> przeciwko nowej propozycji rządu dotyczącej podatków.",
                            "target_lang_translations": {
                                "en": "Critics immediately <w>rose up against</w> the government's new tax proposal."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprzeciwić się"
                    ],
                    "common_phrases": [
                        "powstać przeciw projektowi"
                    ],
                    "target_lang_definitions": {
                        "en": "to firmly speak out or protest against something in a debate or dispute"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise up against",
                                "target_lang_sense_clarification": "to speak out forcefully against"
                            },
                            {
                                "target_lang_word": "speak out against",
                                "target_lang_sense_clarification": "to strongly object to something"
                            },
                            {
                                "target_lang_word": "oppose",
                                "target_lang_sense_clarification": "to firmly dissent or resist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "618d9cd9-7783-3121-99b3-d1e13991e257",
                    "sense_definition": "podnieść się, ulec podwyższeniu lub wypiętrzeniu w odniesieniu do terenu lub poziomu wód",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na skutek gwałtownych ruchów tektonicznych ten łańcuch górski <w>powstał</w> miliony lat temu.",
                            "target_lang_translations": {
                                "en": "As a result of violent tectonic movements, this mountain range <w>was formed</w> millions of years ago."
                            }
                        },
                        {
                            "text": "Po ulewnych opadach deszczu woda w korycie rzeki nagle <w>powstała</w> i zalała pobliskie łąki.",
                            "target_lang_translations": {
                                "en": "After heavy rains, the water in the riverbed suddenly <w>rose</w> and flooded the nearby meadows."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane w kontekście ukształtowania terenu lub wód"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be uplifted or elevated in reference to landforms or bodies of water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be formed",
                                "target_lang_sense_clarification": "of geological formations"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "of waters or land elevation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
