                    {
                        "sense_id": "f2a93e19-4cb2-3708-a0b3-3a97a01c285f",
                        "entry_id": "75aa4eac-41c8-3ba4-8214-4ca6cdb7ec5e",
                        "glosses": [
                            "Zurückhaltung"
                        ],
                        "tags": [],
                        "examples": [],
