                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2704993-52cc-3f35-b752-3925d6f14272",
                        "entry_id": "99971a27-0256-33da-91f4-edb971a6ac54",
                        "glosses": [
                            "A department of Hauts-de-France, France. Capital: Laon (INSEE code 02)."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b0c28f97-5271-39b5-8e92-bb09e086b5c8",
                        "entry_id": "99971a27-0256-33da-91f4-edb971a6ac54",
                        "glosses": [
                            "A left tributary of the Oise, flowing through the departments of Meuse, Marne, Ardennes, Aisne and Oise, in northeastern France."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a6555c8-0709-4102-ba1e-e725d55d6fa1",
                        "source_entry_id": "99971a27-0256-33da-91f4-edb971a6ac54",
                        "source_sense_description": "department",
                        "target_lang_word": "Aisne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aisne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e07b9de6-3742-3557-ad5c-ff6021e9267d",
                                        "entry_id": "8b283338-cfa9-39f5-9bf0-8eac14876fe0",
                                        "glosses": [
                                            "Rivière du nord de la France, affluent de l’Oise."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98dc36bf-61ef-42c9-82be-f2dc1b1caa61",
                                                "sense_id": "e07b9de6-3742-3557-ad5c-ff6021e9267d",
                                                "text": "La Dormoise (rive gauche; 17 kilomètres, dont 2 dans le département), qui a sa source à Tahure (Marne), sert de limite aux Ardennes sur un parcours de près de 3 kilomètres, et se jette dans l’Aisne à 1 kilomètre au nord de Condé-lès-Autry."
                                            },
                                            {
                                                "example_id": "f630bad4-d836-4cbb-b886-b5c4bb184290",
                                                "sense_id": "e07b9de6-3742-3557-ad5c-ff6021e9267d",
                                                "text": "Les plus belles prairies naturelles du département sont celles de la vallée de l’Aisne ; elles se distinguent par leur magnifique verdure […]."
                                            },
                                            {
                                                "example_id": "56b16b22-d23e-49c9-8329-15d0ac0a6a68",
                                                "sense_id": "e07b9de6-3742-3557-ad5c-ff6021e9267d",
                                                "text": "Le gros du corps d’armée, formé en deux colonnes, franchissait l’Aisne à Semuy (34ᵉ division) et à Voncq (33ᵉ division), puis prenait une formation d'attente dans la région de Chuffilly."
                                            },
                                            {
                                                "example_id": "34439330-acf6-4a4d-af3d-b1ab19e3a000",
                                                "sense_id": "e07b9de6-3742-3557-ad5c-ff6021e9267d",
                                                "text": "Le ruisseau des Barres naît à Sévigny-Waleppe sur la craie marneuse et aboutit à l’Aisne en aval de Balham. Il coule aussi sur la craie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e633768-92be-3eaa-8584-86458f3709cf",
                                        "entry_id": "8b283338-cfa9-39f5-9bf0-8eac14876fe0",
                                        "glosses": [
                                            "Petite rivière française du département de la Mayenne, affluent de la Mayenne."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e7c9cfc-366f-3ca2-908b-e184437e62b7",
                                        "entry_id": "8b283338-cfa9-39f5-9bf0-8eac14876fe0",
                                        "glosses": [
                                            "Rivière de Belgique, affluent de l’Ourthe."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96b10a28-3777-35ce-95ea-a025cfe0af5d",
                                        "entry_id": "8b283338-cfa9-39f5-9bf0-8eac14876fe0",
                                        "glosses": [
                                            "Département français de la région administrative des Hauts-de-France, auquel est attribué le numéro 02."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e650ab59-90ec-4bae-87e8-798003c8b46d",
                                                "sense_id": "96b10a28-3777-35ce-95ea-a025cfe0af5d",
                                                "text": "Des spécialistes, comme Philippe Duchaufour ou Marcel Jamagne, qui a contribué à l'élaboration de la carte des sols de l’Aisne, notent que cette dégradation peut aussi avoir des origines anthropiques."
                                            },
                                            {
                                                "example_id": "010574f4-11b7-46b4-b9c8-fbe049dc801c",
                                                "sense_id": "96b10a28-3777-35ce-95ea-a025cfe0af5d",
                                                "text": "Un exemple : le département de l’Aisne analyse très précisément dix bourgs-centres de ce département."
                                            },
                                            {
                                                "example_id": "e30226e9-c679-4f2c-aed0-fed087b80307",
                                                "sense_id": "96b10a28-3777-35ce-95ea-a025cfe0af5d",
                                                "text": "Peut-être que certains se sont précipités, car le compte n’y est pas, prévient Julien Dive, député LR de l’Aisne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
