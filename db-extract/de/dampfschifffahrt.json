                ],
                "senses": [
                    {
                        "sense_id": "daa21c93-0835-369a-873f-ee3bca007900",
                        "entry_id": "a755cf65-db89-3418-aa82-db7844b84a3e",
                        "glosses": [
                            "Schifffahrt mit Dampfschiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97028a9f-9b9e-472e-ac82-43d6d70d630a",
                                "sense_id": "daa21c93-0835-369a-873f-ee3bca007900",
                                "text": "„Als hinderlich bei solchen Vorhaben, das Dampfschiff mehrmals zu verlassen, erwies sich jedoch die Handhabung des Gepäcks, wie auch dessen Beaufsichtigung bei Dampfschifffahrten generell als lästig bezeichnet wird.“"
                            },
                            {
                                "example_id": "e3fa4b70-dd6f-4e73-a80a-45d0e413d935",
                                "sense_id": "daa21c93-0835-369a-873f-ee3bca007900",
                                "text": "Die Dampfschifffahrt ist inzwischen weitgehend eingestellt."
                            },
                            {
                                "example_id": "7d0e0ba2-b520-4ed2-b447-923a16527880",
                                "sense_id": "daa21c93-0835-369a-873f-ee3bca007900",
                                "text": "„Infolge technischer Verbesserungen erfährt die Dampfschifffahrt ab der Mitte des 19. Jahrhunderts rasante Fortschritte.“"
                            },
                            {
                                "example_id": "6ea0bca5-0a9f-4c4b-916c-e5abfef59977",
                                "sense_id": "daa21c93-0835-369a-873f-ee3bca007900",
                                "text": "„Diese zweite Ausbildung hatte Samuel gerade abgeschlossen, als der amerikanische Bürgerkrieg ausbrach und zuallererst der Dampfschifffahrt auf dem Mississippi den Garaus machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
