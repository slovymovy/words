                "translations": [
                    {
                        "translation_id": "59f31487-4934-40fe-bb08-1cfae8e58037",
                        "source_entry_id": "3d723653-0fc5-3848-92ee-4ea9f2fd5b8c",
                        "source_sense_id": "46d7eee9-1eb4-3731-bad0-c80e81b18833",
                        "source_sense_description": "een lading ter grootte van die van een volbeladen kar",
                        "target_lang_word": "Fuhre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuhre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                        "entry_id": "53571ab6-d3d5-3c04-8508-06ae65602ce7",
                                        "glosses": [
                                            "die Ladung eines (rollenden) Transportmittels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb437b02-5a7a-44a7-a814-a7c0ddc2169b",
                                                "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                                "text": "Er griff zur Schubkarre und brachte eine Fuhre Sand."
                                            },
                                            {
                                                "example_id": "37be3434-1306-4748-9cf5-48ece1758bad",
                                                "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                                "text": "„Er war wie ein angeschirrtes Pferd, das mit einer Fuhre bergabläuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                        "entry_id": "53571ab6-d3d5-3c04-8508-06ae65602ce7",
                                        "glosses": [
                                            "die dem Transport dienende Fahrt (mit einem Wagen)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a092c5-d554-4413-84b8-d3e472fcc07d",
                                                "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                                "text": "Kannst du diese Fuhre übernehmen?"
                                            },
                                            {
                                                "example_id": "57f7da16-8383-4c26-b437-5272ba0491a8",
                                                "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                                "text": "„Währenddessen erledigte Markowitz seinen Auftrag, es soll seine letzte Fuhre sein, danach, so sein Plan, will er sich zur wohlverdienten Ruhe setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "833a6b08-1db1-4f75-84b0-9f2c07de7620",
                        "source_entry_id": "3d723653-0fc5-3848-92ee-4ea9f2fd5b8c",
                        "source_sense_id": "46d7eee9-1eb4-3731-bad0-c80e81b18833",
                        "source_sense_description": "een lading ter grootte van die van een volbeladen kar",
                        "target_lang_word": "Ladung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55432daf-4df6-3237-8b9c-f7f9d047db73",
                                        "entry_id": "4cec5f1d-0b0f-3187-ba5c-5ebcc4da2039",
                                        "glosses": [
                                            "Last, die auf ein Transportmittel gebracht wird"
                                        ],
                                        "tags": [
                                            "Transportwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce617974-2569-42f8-8661-e6c5191a9ad6",
                                                "sense_id": "55432daf-4df6-3237-8b9c-f7f9d047db73",
                                                "text": "Ein Tanklastzug mit Salpetersäure war bei einem Unfall auf regennasser Straße schwer beschädigt worden und verlor 9000 Liter seiner gefährlichen Ladung."
                                            },
                                            {
                                                "example_id": "e54a019f-529c-4a98-a79f-d2f23cff492f",
                                                "sense_id": "55432daf-4df6-3237-8b9c-f7f9d047db73",
                                                "text": "In der jetzigen Krise übernehmen die klammen Kreditinstitute diese [Akkreditive] seltener; oftmals bleibt so die Ladung in den Häfen Brasiliens oder Australiens liegen."
                                            },
                                            {
                                                "example_id": "936e38fb-e0e8-45a0-8c37-b721cdccbf05",
                                                "sense_id": "55432daf-4df6-3237-8b9c-f7f9d047db73",
                                                "text": "Ein mit 400 Tonnen beladener Lastwagen schafft den Teersand aus der Grube. Die Ladung enthält 23000 Liter Rohöl."
                                            },
                                            {
                                                "example_id": "84360e9a-fc7d-4042-bed4-ba7f1e905200",
                                                "sense_id": "55432daf-4df6-3237-8b9c-f7f9d047db73",
                                                "text": "„Eine einzige Ladung konnte Tausende Posten enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04a9738f-128b-3aa0-9d6b-b7a2dc70f467",
                                        "entry_id": "4cec5f1d-0b0f-3187-ba5c-5ebcc4da2039",
                                        "glosses": [
                                            "definierte Menge an Munition oder Sprengstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ce5706-5184-4115-bcb9-6fb7baf4c2ee",
                                                "sense_id": "04a9738f-128b-3aa0-9d6b-b7a2dc70f467",
                                                "text": "Die dann folgende Szene, die Detonation der gesamten Ladung, ist auf dem Video nicht zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10ab7074-aedf-3499-b9fa-e4e6cd2b7db8",
                                        "entry_id": "4cec5f1d-0b0f-3187-ba5c-5ebcc4da2039",
                                        "glosses": [
                                            "die Eigenschaft von Teilchen oder Objekten, mit einem elektromagnetischen Feld in Wechselwirkung zu treten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c9c484-ae96-4952-80e0-a1377f4ee881",
                                                "sense_id": "10ab7074-aedf-3499-b9fa-e4e6cd2b7db8",
                                                "text": "Wesentlich deutlicher wird der Effekt, wenn man Halbleitermaterialien einsetzt. Bei einem Temperaturgefälle bewegt sich darin elektrische Ladung – Strom fließt."
                                            },
                                            {
                                                "example_id": "f7b2cae9-c6ea-41c9-b984-ba0d4979f9e8",
                                                "sense_id": "10ab7074-aedf-3499-b9fa-e4e6cd2b7db8",
                                                "text": "„Nach dem Kern-Hülle-Modell von RUTHERFORD enthalten die winzigen Atomkerne die positive Ladung des Atoms und über 99,9 % der Atommasse.“"
                                            },
                                            {
                                                "example_id": "5ca1e91e-2918-4387-8298-a08878956f8e",
                                                "sense_id": "10ab7074-aedf-3499-b9fa-e4e6cd2b7db8",
                                                "text": "Symmetrieüberlegungen führten Albert Einstein 1905 zu seiner Relativitätstheorie und animierten 1928 den Theoretiker Paul Dirac, neben der gewöhnlichen Materie noch eine »Antimaterie« zu postulieren – Teilchen mit derselben Masse, aber umgekehrter Ladung wie die gewöhnlichen irdischen Partikel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d3cd997a-8bf2-3fe9-b7b1-8fae6456c793",
                                        "entry_id": "4cec5f1d-0b0f-3187-ba5c-5ebcc4da2039",
                                        "glosses": [
                                            "Vorladung vor ein Gericht oder eine Behörde"
                                        ],
                                        "tags": [
                                            "Jurisdiktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87109d22-03b9-40db-af33-e60f64ba774b",
                                                "sense_id": "d3cd997a-8bf2-3fe9-b7b1-8fae6456c793",
                                                "text": "Und wer es wagen mochte, der Ladung dieser Gerichte und ihrem Königsbanne zu trotzen, der war keinen Tag sicher, ob ihn nicht die vernichtende Wucht der über ihn ausgesprochnen Acht treffen möge."
                                            },
                                            {
                                                "example_id": "c2339c9e-86ee-48a5-8a56-7d910cf7ffa4",
                                                "sense_id": "d3cd997a-8bf2-3fe9-b7b1-8fae6456c793",
                                                "text": "Die Ladung blieb erfolglos."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1540494d-c50e-3738-8797-a0f35a868f1a",
                                        "entry_id": "4cec5f1d-0b0f-3187-ba5c-5ebcc4da2039",
                                        "glosses": [
                                            "eine größere Menge"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a18e55-4b6d-4ed2-8a3b-3e8d8d85c54f",
                                                "sense_id": "1540494d-c50e-3738-8797-a0f35a868f1a",
                                                "text": "In diesem Moment landet eine Ladung Wodka direkt vor den Füßen des Reiseleiters."
                                            },
                                            {
                                                "example_id": "adb7e1d9-3fde-4401-be5a-25f90952d5f5",
                                                "sense_id": "1540494d-c50e-3738-8797-a0f35a868f1a",
                                                "text": "Schneller aber, als er die Zeltwände auseinanderschob, ließ er diese wieder zusammenschlagen, als ihm durch die Türöffnung eine ganze Ladung Schnee entgegenfiel."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
