    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71cba5c0-1b69-3f4a-8419-b4f176962d31",
                    "sense_definition": "wygięty w łuk fragment biegu rzeki",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "krzywizna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wioska leży w malowniczym <w>zakolu</w> rzeki otoczonym gęstym lasem.",
                            "target_lang_translations": {
                                "ru": "Деревня лежит в живописной <w>излучине</w> реки, окружённой густым лесом."
                            }
                        },
                        {
                            "text": "Kajakarze musieli bardzo uważać na silny prąd w głębokim <w>zakolu</w>.",
                            "target_lang_translations": {
                                "ru": "Байдарочникам приходилось быть очень осторожными из-за сильного течения в крутом <w>изгибе</w> реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "meander"
                    ],
                    "common_phrases": [
                        "zakole rzeki"
                    ],
                    "target_lang_definitions": {
                        "ru": "дугообразный изгиб русла реки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излучина",
                                "target_lang_sense_clarification": "реки"
                            },
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "реки"
                            },
                            {
                                "target_lang_word": "закрут",
                                "target_lang_sense_clarification": "поворот русла"
                            },
                            {
                                "target_lang_word": "меандр",
                                "target_lang_sense_clarification": "географический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb37edf7-bb99-33c6-a27e-a9d8f584f7c5",
                    "sense_definition": "miejsce nad czołem pozbawione włosów, będące początkiem łysienia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ciało",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój starszy brat zauważył u siebie pierwsze <w>zakola</w> po trzydziestce.",
                            "target_lang_translations": {
                                "ru": "Мой старший брат заметил у себя первые <w>залысины</w> после тридцати."
                            }
                        },
                        {
                            "text": "Mężczyzna próbował ukryć głębokie <w>zakola</w> nową fryzurą.",
                            "target_lang_translations": {
                                "ru": "Мужчина пытался скрыть глубокие <w>залысины</w> новой причёской."
                            }
                        }
                    ],
                    "common_phrases": [
                        "głębokie zakola",
                        "mieć zakola"
                    ],
                    "target_lang_definitions": {
                        "ru": "облысевший участок надо лбом или у висков, признак начала облысения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залысина",
                                "target_lang_sense_clarification": "на голове у висков или надо лбом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d5dc7fa-a3e8-3950-81b7-38d23fb82302",
                    "sense_definition": "łagodny, szeroki skręt drogi biegnący łukiem",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "krzywizna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca znacznie zwolnił przed ostrym <w>zakolem</w> górskiej szosy.",
                            "target_lang_translations": {
                                "ru": "Водитель значительно притормозил перед крутым <w>поворотом</w> горного шоссе."
                            }
                        },
                        {
                            "text": "Za kolejnym <w>zakolem</w> drogi niespodziewanie ukazał się wspaniały widok na dolinę.",
                            "target_lang_translations": {
                                "ru": "За очередным <w>изгибом</w> дороги неожиданно открылся великолепный вид на долину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zakole drogi"
                    ],
                    "target_lang_definitions": {
                        "ru": "плавный дугообразный поворот дороги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "дороги"
                            },
                            {
                                "target_lang_word": "поворот",
                                "target_lang_sense_clarification": "плавный, дугообразный поворот дороги"
                            },
                            {
                                "target_lang_word": "закрут",
                                "target_lang_sense_clarification": "дороги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
