                        "entry_id": "2d42e70c-8ffb-3bb1-bd6c-9ffa7f3a9b85",
                        "glosses": [
                            "Petite échelle.",
                            "Instrument utilisé pour faciliter la lecture et le report des dessins dans les ateliers de tapisserie."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
