        "fr-extract.jsonl": [
            {
                "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                "word": "cavalcade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d845ac94-6b11-4a0b-9322-84aac1bbbb2d",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "tags": [
                            "plural"
                        ],
                        "form": "cavalcades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee9821f9-7966-3b7e-8259-a91688527e4e",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "glosses": [
                            "Défilé festif de gens à cheval ou de chars dans une fête publique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f0a0f3-6e68-4b9d-a824-17bbdc4f4b35",
                                "sense_id": "ee9821f9-7966-3b7e-8259-a91688527e4e",
                                "text": "À dix heures, on entendit sonner les trompettes : les portes du château s’ouvrirent, et une riche cavalcade en sortit ; …."
                            },
                            {
                                "example_id": "62a4c1e3-086a-4d02-97dd-47b34b2a023f",
                                "sense_id": "ee9821f9-7966-3b7e-8259-a91688527e4e",
                                "text": "De Chantilly, de Compiègne et de Senlis accouraient de joyeuses cavalcades qui prenaient place dans le cortège rustique des compagnies de l’arc."
                            },
                            {
                                "example_id": "d3840a86-7f0c-4b57-8b83-1c37393179ed",
                                "sense_id": "ee9821f9-7966-3b7e-8259-a91688527e4e",
                                "text": "Un si beau spectacle avait mis sur pied un bon tiers de la population de la ville-lumière et, à l’approche de la cavalcade, les badauds qui encombraient la chaussée refluaient sur les trottoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "03cc77d2-f72b-36e3-af9d-1234596e47d9",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "glosses": [
                            "Promenade que plusieurs personnes réunies font à cheval."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8e63e79e-b062-4620-901b-34fb6ef7917d",
                                "sense_id": "03cc77d2-f72b-36e3-af9d-1234596e47d9",
                                "text": "Nous fîmes une cavalcade au bois de Boulogne."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e3ad774-3391-390e-bcae-f2eb1d302d4b",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "glosses": [
                            "Ces personnes."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "39702eaa-6779-4a50-9021-f5a3a0a4c8ea",
                                "sense_id": "5e3ad774-3391-390e-bcae-f2eb1d302d4b",
                                "text": "[…] deux moines de son ordre, d’une position inférieure, chevauchaient ensemble à l’arrière en riant et conversant, sans paraître se soucier aucunement des autres membres de la cavalcade."
                            },
                            {
                                "example_id": "74c17c4d-753f-417e-bff8-c771ed4dcaa7",
                                "sense_id": "5e3ad774-3391-390e-bcae-f2eb1d302d4b",
                                "text": "Dès l'aube, tout le monde était prêt, et la petite cavalcade se mettait en route."
                            }
                        ]
                    },
                    {
                        "sense_id": "0011ecda-da2e-302d-85cc-5dfbe45bb366",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "glosses": [
                            "Chevauchée, généralement animée ; course bruyante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5433de3-29e5-4080-950d-f802f53b5e52",
                                "sense_id": "0011ecda-da2e-302d-85cc-5dfbe45bb366",
                                "text": "On a couru pour leur échapper, quelle cavalcade!"
                            },
                            {
                                "example_id": "c18fe52e-787b-4670-94a1-cc02776d6b25",
                                "sense_id": "0011ecda-da2e-302d-85cc-5dfbe45bb366",
                                "text": "Il alla prévenir tous les patriotes de la localité et des environs qu'il avait chez lui, le général de division Marbot. Puis ce monsieur revint, triomphant, dans son castel, où nous vîmes arriver une heure après une cavalcade composée des plus chauds patriotes de Cavaillon."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dbcea1c-06bb-31dd-a4f5-946c8c0657df",
                        "entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "glosses": [
                            "Déplacement rapide."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6d2fbb9f-360e-4d02-bc73-52ba39921ecb",
                                "sense_id": "9dbcea1c-06bb-31dd-a4f5-946c8c0657df",
                                "text": "[…], et ce qui sauvait du désespoir, c’était seulement la farouche splendeur des aubes et des couchants, des torrents tourbillonnants, de la cavalcade des nuages, et de l’infinie solitude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1758f3c4-6cab-47bf-add6-8e88e3121f1d",
                        "source_entry_id": "5a71aa51-f0cc-324a-a838-dc7bbf9e6487",
                        "target_lang_word": "cavalcade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cavalcade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45049002-1511-3ac8-8425-85faf9c2efb6",
                                        "entry_id": "29c41fdf-ed0c-3dcb-895c-ddeeb693044e",
                                        "glosses": [
                                            "A procession of riders, vehicles, ships, etc."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bd418a1-c305-4d44-84ed-9ee0284b9bae",
                                                "sense_id": "45049002-1511-3ac8-8425-85faf9c2efb6",
                                                "text": "To the onlooker, and particularly to those whose memories go back to pre-grouping days, the modern cavalcade of \"V2s\" and \"B1s\" is apt to become a little monotonous; but to any running man the general utility characteristics of these two classes are a perfect godsend at times of exceptional pressure, when it is often a case of \"first in—first out\" with locomotive allocations at sheds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ad2275-bd9d-3e34-833c-d5e9bfdd4f4c",
                                        "entry_id": "29c41fdf-ed0c-3dcb-895c-ddeeb693044e",
                                        "glosses": [
                                            "A ceremonial parade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f2e24f-9c69-4683-9f5f-7cb3445caeb9",
                                                "sense_id": "57ad2275-bd9d-3e34-833c-d5e9bfdd4f4c",
                                                "text": "For the first three hours all went as well as could be expected, and then an accident happened that nearly lost us the pleasure of the company of our venerable friend Billali, whose litter was leading the cavalcade."
                                            },
                                            {
                                                "example_id": "fdf541f1-75ec-4bfa-ac03-2a7d31e14ed5",
                                                "sense_id": "57ad2275-bd9d-3e34-833c-d5e9bfdd4f4c",
                                                "text": "In the second row of the cavalcade were Francie, Fanny's god-daughter, now thirteen years old and already elegant in long frilled pantalettes, tartan skirts, and a leghorn hat with streamers, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ab00dc-7fc5-31e3-9e83-605d9045b171",
                                        "entry_id": "29c41fdf-ed0c-3dcb-895c-ddeeb693044e",
                                        "glosses": [
                                            "A trail ride, usually more than one day long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "365d9202-2c1c-4625-b54a-0a9f0f534507",
                                                "sense_id": "98ab00dc-7fc5-31e3-9e83-605d9045b171",
                                                "text": "Stranleigh found no difficulty in getting a cavalcade together at Bleacher’s station, an amazingly long distance west of New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab30b700-0f42-3111-bbb1-58a25a5a8a29",
                                        "entry_id": "29c41fdf-ed0c-3dcb-895c-ddeeb693044e",
                                        "glosses": [
                                            "An often dramatic series or chain of events or things."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee2640b-2b50-4688-a5bc-6c5715ce93e9",
                                                "sense_id": "ab30b700-0f42-3111-bbb1-58a25a5a8a29",
                                                "text": "As soon as I visited this website, a cavalcade of dialog boxes started to appear on my screen; that's when I realized my computer was infected with a virus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cavalcade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae10398-4f1e-37bc-b97e-45dd9d937c3c",
                                        "entry_id": "4ffe18e6-043a-3b02-a5ad-4ba10e7f8f21",
                                        "glosses": [
                                            "To move as part of a series or group, such as marchers in a parade or snow in an avalanche, especially in large numbers or in a chaotic or dangerous fashion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44bc7430-9d27-4e6f-8a70-9452aa9715d3",
                                                "sense_id": "8ae10398-4f1e-37bc-b97e-45dd9d937c3c",
                                                "text": "Great numbers of horse were still cavalcading, but […]"
                                            },
                                            {
                                                "example_id": "cf757475-7486-405e-b44d-b3a0bd5de994",
                                                "sense_id": "8ae10398-4f1e-37bc-b97e-45dd9d937c3c",
                                                "text": "[…] although for the most part he believed the devil was too good a general to let his soldiers waste their time in cavalcading about on broom-sticks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
