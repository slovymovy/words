    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                "word": "flapper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9270a2f0-d6f5-408b-91f2-c541d72cb1a5",
                        "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "flappers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b54ca0bb-3634-33d5-a7f0-a6db5a5322b7",
                        "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                        "glosses": [
                            "A young girl usually between the ages of 15 and 18, especially one not \\\"out\\\" socially."
                        ],
                        "tags": [
                            "colloquial",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0fd0ecf5-a7dd-4bb4-9707-fefe27e0efc4",
                                "sense_id": "b54ca0bb-3634-33d5-a7f0-a6db5a5322b7",
                                "text": "Stud's eyes roved. Plenty of girls, most of them young flappers, Loretta's age. Only a couple of years ago they were kids."
                            }
                        ]
                    },
                    {
                        "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                        "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                        "glosses": [
                            "A young woman, especially when unconventional or without decorum or displaying daring freedom or boldness; now particularly associated with the Jazz Age of the 1920s."
                        ],
                        "tags": [
                            "colloquial",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee07403-dc28-4882-8c52-84e390d9eea3",
                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                "text": "I paid violent and unusual attention to a flapper all through the meal in order to make you jealous. She's probably in her cabin writing reams about me to a fellow-flapper at this very moment."
                            },
                            {
                                "example_id": "2aa1f08e-0e50-4d5a-90d3-bc6b16b81cd2",
                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                "text": "\"Now,\" said the young man cheerfully to Ardita, who had witnessed this last scene in withering silence, \"if you will swear on your honor as a flapper—which probably isn't worth much—that you'll keep that spoiled little mouth of yours tight shut for forty-eight hours, you can row yourself ashore in our rowboat.\""
                            },
                            {
                                "example_id": "444175df-f11e-42bf-8eeb-3222bfde3c68",
                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                "text": "Concern—and consternation—about the flapper are general. She disports herself flagrantly in the public eye, and there is no keeping her out of grown-up company or conversation."
                            },
                            {
                                "example_id": "1e712b7b-7bd2-45d0-bd07-abb192cfcc40",
                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                "text": "F. Scott Fitzgerald is best known as a chronicler of the 1920s and as the writer who, more than any other, identified, delineated, and popularized the female representative of that era, the flapper. Though it is an overstatement to say that Fitzgerald created the flapper, he did, with considerable assistance from his wife Zelda, offer the public an image of a young woman who was spoiled, sexually liberated, self-centered, fun-loving, and magnetic. […] Although she is often seen now as a mere fashion of the bygone Jazz Age, the flapper should be regarded as one of the great authentic characters in American history."
                            },
                            {
                                "example_id": "0fb7a6a0-5c17-470c-b898-689999288f92",
                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                "text": "Among McPherson's most passionate and visible advocates were Southern California's young flappers, who turned out in droves to cheer on the evangelist. While most fundamentalists vehemently criticized flappers, viewing them as symbols of moral decay and the decline of Victorian gender identities, McPherson had embraced them. Critics of her Bible college identified the young female ministers with whom she surrounded herself not as holdouts to Victorianism, but as outright flappers. The press even dubbed one of McPherson's most successful young protégés the flapper evangelist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b9fb9ce-ca2f-4503-ab9a-b9253b2f973a",
                        "source_entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                        "source_sense_description": "young unconventional woman",
                        "target_lang_word": "garçonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garçonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                        "entry_id": "91d49bac-f1cb-31f7-aa44-64217bc06c74",
                                        "glosses": [
                                            "Type d’idéal féminin des années 1920, revendiquant l’égalité entre les hommes et les femmes, et le droit pour les femmes de jouir de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f3beeb-2c3a-493f-8a56-ea8acfdb5c42",
                                                "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                                "text": "La chambre à coucher avait un grand lit, une commode à ventre, des fauteuils ; sur la cheminée, une ancienne pendule et des flambeaux de cuivre ; sur les murs, une belle photographie d’un Botticelli du musée de Berlin : une Vierge dolente et robuste, ménagère et contrite, entourée d’anges figurés par de languissants jeunes hommes, tenant des cierges aux cires enroulées comme des câbles, des garçonnes coquettes, aux longs cheveux piqués de fleurs, de dangereux pages, mourant de désirs devant l’Enfant Jésus qui bénit, debout, près de la Vierge."
                                            },
                                            {
                                                "example_id": "fd174eea-595b-48b5-91e2-cb49a91495ff",
                                                "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                                "text": "Ici, ce sont les poitrines anguleuses des garçonnes, les petites cloques perlées d’une goutte de vin rose, les mignonnes ampoules percées de pointes naines."
                                            },
                                            {
                                                "example_id": "c96df09a-561d-46f6-b94e-6fe81b5843c3",
                                                "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                                "text": "Suprême nouveauté, elles [les femmes] s’étaient fait couper les cheveux, elles les portaient à la garçonne, ou à la Jeanne d’Arc, ce qui nous valut une rengaine :\nElle s’était fait couper les ch'veux\nParce que c’est la mode, commode…"
                                            },
                                            {
                                                "example_id": "a26a9904-7736-43c1-a676-f13bcad9cf82",
                                                "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                                "text": "La garçonne résume, à elle seule, la perte de repères dans le monde de l’après-guerre et devient la métaphore de la \"ruine de la civilisation\". La dissolution de l’amour conjugal, l’augmentation du nombre des divorces, le déclin de la natalité et le danger vénérien..."
                                            },
                                            {
                                                "example_id": "5dae040e-1e1f-4add-930d-6920eb55809c",
                                                "sense_id": "19660325-2c65-3caf-bccf-fd22e3f0e189",
                                                "text": "Les années 20 ont inventé une nouvelle image de la femme : la garçonne. Ses partis pris vestimentaires comme la liberté de ses gestes et de sa conduite provoquent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ecc1ef4-2dc5-327a-8b53-7ddfe6252418",
                                        "entry_id": "91d49bac-f1cb-31f7-aa44-64217bc06c74",
                                        "glosses": [
                                            "Garçon manqué, fille qui se comporte à la manière d’un garçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "102555f2-58dd-48b1-a9e3-a6bb19db57ad",
                                                "sense_id": "9ecc1ef4-2dc5-327a-8b53-7ddfe6252418",
                                                "text": "Je me répétais sans arrêt : Je suis une garçonne, je suis une garçonne, et j’imitais les allures des hommes. Je marchais à grandes enjambées, j’adoptais leur manque de pudeur en m’assayant dans le tram les genoux bien écartés, […]."
                                            },
                                            {
                                                "example_id": "d0ad1cb5-903f-4a9d-ac75-77c3df927b7d",
                                                "sense_id": "9ecc1ef4-2dc5-327a-8b53-7ddfe6252418",
                                                "text": "J’ai toujours été une garçonne pour ne pas dire un garçon manqué. Enfant, je ne faisais que des jeux de garçons, je n’ai jamais vraiment joué avec les nombreuses poupées que m’ont achetées mes parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2cb93f-eec9-342c-b2f5-8f840dfb2148",
                                        "entry_id": "91d49bac-f1cb-31f7-aa44-64217bc06c74",
                                        "glosses": [
                                            "Lesbienne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "727e0002-7519-4277-b158-12cfc211ad7c",
                                                "sense_id": "9c2cb93f-eec9-342c-b2f5-8f840dfb2148",
                                                "text": "En relisant Ehrel et Leguay (1977,125-149), auteurs de la recherche la plus complète sur les femmes détenues pendant les années 1970, on mesure la distance qui nous sépare d’une époque où l’on faisait encore la chasse aux « garçonnes » (d’où le fameux « groupe G », regroupant les femmes se prostituant et celles qu’on soupçonnait d’être homosexuelles, à Fleury-Mérogis, qui fut transformé en 1974 en « groupe S », pour la Sécurité, montrant le changement des préoccupations de l’Administration pénitentiaire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d2a678-5739-387f-994d-f4a0f809a6d2",
                                        "entry_id": "91d49bac-f1cb-31f7-aa44-64217bc06c74",
                                        "glosses": [
                                            "Shorty, culotte garçonne."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
