                "senses": [
                    {
                        "sense_id": "cb08d4b4-1835-370d-b4cd-55251cece58f",
                        "entry_id": "ced45c5b-0981-39dd-ae7b-bda7acf76240",
                        "glosses": [
                            "анат. связанный, соотносящийся по значению с существительным влагалище; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af46528f-fdb9-49ae-a78b-f33978015d72",
                                "sense_id": "cb08d4b4-1835-370d-b4cd-55251cece58f",
                                "text": "Стенки влагалища, охватывая влагалищную часть шейки матки, образуют вокруг неё куполообразное углубление, называемое сводом влагалища."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25b32d94-c083-4aca-aa3f-15745a25afad",
                        "source_entry_id": "ced45c5b-0981-39dd-ae7b-bda7acf76240",
                        "source_sense_id": "cb08d4b4-1835-370d-b4cd-55251cece58f",
                        "target_lang_word": "vaginal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaginal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d982a32-b71f-30b8-8b53-46a99bafb9ca",
                                        "entry_id": "34332f8b-0f9d-3e41-9dea-0c425232b4e0",
                                        "glosses": [
                                            "Of, relating to, or affecting the vagina."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0415b55-e5cb-4539-ad4e-236a3204f830",
                                                "sense_id": "8d982a32-b71f-30b8-8b53-46a99bafb9ca",
                                                "text": "You may have a vaginal birth, C-section or surrogacy; it's up to you."
                                            },
                                            {
                                                "example_id": "dd2ec66c-0448-490a-a8dc-edbeb1a75266",
                                                "sense_id": "8d982a32-b71f-30b8-8b53-46a99bafb9ca",
                                                "text": "A non-hormonal birth control capsule that women can insert just before sex. A rape kit that gives victims more agency and streamlines the evidence collection process. An overhauled design for a 150-year-old tool used in postpartum vaginal tearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc735e58-9bed-3695-86db-57465862273b",
                                        "entry_id": "34332f8b-0f9d-3e41-9dea-0c425232b4e0",
