                "senses": [
                    {
                        "sense_id": "04ac2f87-64f4-3bd0-87f0-82a0e15fc436",
                        "entry_id": "74f7cf19-171c-3471-9daf-79b94cc5bb4f",
                        "glosses": [
                            "Séquencer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb83791-32e0-4c0c-853a-822e6a734019",
                                "sense_id": "04ac2f87-64f4-3bd0-87f0-82a0e15fc436",
                                "text": "Cette S technologie permet de reséquencer simultanément, en une seule hybridation, la séquence complète de plusieurs gènes."
                            },
                            {
                                "example_id": "472ea95e-6447-4cea-a629-d5f72b931aeb",
                                "sense_id": "04ac2f87-64f4-3bd0-87f0-82a0e15fc436",
                                "text": "La façon la plus directe consiste à choisir des amorces afin d'amplifier un fragment d'une demi-kilobase renfermant le SNP, et de reséquencer le fragment dans un échantillon de 10 individus au moins (et de préférence jusqu'à 100 individus) issus de populations différentes."
                            }
                        ]
                    }
