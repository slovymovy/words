                                "target_senses": [
                                    {
                                        "sense_id": "83fbabb6-b2b0-3a2f-9429-f18a809ab9d7",
                                        "entry_id": "22234897-f951-3225-8cbc-8d96c1569151",
                                        "glosses": [
                                            "lying underneath"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689b61aa-d140-42c1-af10-a05f4fb3ce9f",
                                                "sense_id": "83fbabb6-b2b0-3a2f-9429-f18a809ab9d7",
                                                "text": "We dug down to the underlying rock."
                                            },
                                            {
                                                "example_id": "7215b3b5-eb88-4779-9f40-70e71a8ad7da",
                                                "sense_id": "83fbabb6-b2b0-3a2f-9429-f18a809ab9d7",
                                                "text": "Old Yew, which graspest at the stones\n⁠That name the under-lying dead,\n⁠Thy fibres net the dreamless head,\nThy roots are wrapt about the bones."
                                            },
                                            {
                                                "example_id": "d3976f62-9236-4e77-a43c-9f7619f939c3",
                                                "sense_id": "83fbabb6-b2b0-3a2f-9429-f18a809ab9d7",
                                                "text": "During the track renewals, advantage was taken to redrain the area and the old spent ballast was removed down to the underlying rock, new ballast and drains being provided throughout."
                                            },
                                            {
                                                "example_id": "95cded36-3b0e-4537-a5de-c6b0ec107326",
                                                "sense_id": "83fbabb6-b2b0-3a2f-9429-f18a809ab9d7",
                                                "text": "Sometimes, the underlying layers are exposed by erosion, revealing the story of the rocks like an open book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f1181a-4687-3982-bb1e-b386c9a71a27",
                                        "entry_id": "22234897-f951-3225-8cbc-8d96c1569151",
                                        "glosses": [
                                            "basic or fundamental"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac66647-0800-4137-839d-a7121c7b5350",
                                                "sense_id": "e1f1181a-4687-3982-bb1e-b386c9a71a27",
                                                "text": "Points and straight lines are underlying elements of geometry."
                                            },
                                            {
                                                "example_id": "9ec896f2-bfce-42b1-9703-93ae5db62574",
                                                "sense_id": "e1f1181a-4687-3982-bb1e-b386c9a71a27",
                                                "text": "Finding a successful treatment for Alzheimer’s faces two major hurdles: the first being we still don’t know enough about the disease’s underlying biology."
                                            },
                                            {
                                                "example_id": "2560a5fb-21b9-49e7-9364-fe86e6ad6ced",
                                                "sense_id": "e1f1181a-4687-3982-bb1e-b386c9a71a27",
                                                "text": "The underlying problem with transport policy is that there no coherent strategy. Ministers have tended to encourage greater use of motor vehicles through both transport and (particularly) planning policies, while simultaneously warning of the terrible consequences of unfettered growth of road use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63fb626-ecd2-337f-b640-4650b0eb7153",
                                        "entry_id": "22234897-f951-3225-8cbc-8d96c1569151",
                                        "glosses": [
                                            "implicit"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bdcef26-3bc6-4142-b282-07732a6e698f",
                                                "sense_id": "a63fb626-ecd2-337f-b640-4650b0eb7153",
                                                "text": "Many nursery rhymes have an underlying meaning."
                                            }
                                        ]
                                    }
