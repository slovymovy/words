{
    "word_family": [
        "faulty",
        "faultless",
        "default",
        "faultiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                    "sense_definition": "Responsibility for a mistake, failure, or blameworthy event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not my <w>fault</w> that the train was delayed this morning.",
                            "target_lang_translations": {
                                "ru": "Это не моя <w>вина</w>, что поезд сегодня утром задержался.",
                                "zh": "今天早上火车晚点不是我的<w>过错</w>。"
                            }
                        },
                        {
                            "text": "The driver admitted that the accident was entirely his <w>fault</w>.",
                            "target_lang_translations": {
                                "ru": "Водитель признал, что авария произошла полностью по его <w>вине</w>.",
                                "zh": "司机承认这次事故完全是他的<w>责任</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "my fault",
                        "at fault",
                        "find fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответственность за ошибку, неудачу или предосудительное событие.",
                        "zh": "对错误、失败或应受谴责的事件所负的责任。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вина́",
                                "target_lang_sense_clarification": "ответственность за проступок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过错",
                                "target_lang_sense_clarification": "应承担的责任"
                            },
                            {
                                "target_lang_word": "责任",
                                "target_lang_sense_clarification": "对某事应负的过失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52e85356-8f77-3192-90c8-066c7793661e",
                    "sense_definition": "A defect, imperfection, or weakness in someone's character or in an object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite all her <w>faults</w>, she is a very loyal and kind friend.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все её <w>недостатки</w>, она очень верный и добрый друг.",
                                "zh": "尽管她有很多<w>缺点</w>，但她是一个非常忠诚和善良的朋友。"
                            }
                        },
                        {
                            "text": "The technician found a minor <w>fault</w> in the electrical wiring of the house.",
                            "target_lang_translations": {
                                "ru": "Техник обнаружил небольшую <w>неисправность</w> в электропроводке дома.",
                                "zh": "技术员在房子的电线中发现了一个小<w>故障</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vulnerability"
                    ],
                    "common_phrases": [
                        "character fault",
                        "technical fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект, несовершенство или слабость в характере человека или в предмете.",
                        "zh": "人性格上的缺点，或物体上的瑕疵、缺陷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоста́ток",
                                "target_lang_sense_clarification": "несовершенство характера или вещи"
                            },
                            {
                                "target_lang_word": "изъя́н",
                                "target_lang_sense_clarification": "скрытый или явный дефект"
                            },
                            {
                                "target_lang_word": "дефе́кт",
                                "target_lang_sense_clarification": "техническая неисправность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺点",
                                "target_lang_sense_clarification": "性格或行为上的不足"
                            },
                            {
                                "target_lang_word": "缺陷",
                                "target_lang_sense_clarification": "物体或系统上的瑕疵"
                            },
                            {
                                "target_lang_word": "故障",
                                "target_lang_sense_clarification": "机器或设备的运行问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b60f276-23c8-3e9a-85e8-9c208fe5f48a",
                    "sense_definition": "An illegal serve or a mistake in sports like tennis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player served a double <w>fault</w> and lost the important point.",
                            "target_lang_translations": {
                                "ru": "Игрок допустил двойную <w>ошибку</w> на подаче и проиграл важное очко.",
                                "zh": "选手发球双<w>失误</w>，丢掉了关键的一分。"
                            }
                        },
                        {
                            "text": "If the ball hits the net during a serve, it is called a <w>fault</w>.",
                            "target_lang_translations": {
                                "ru": "Если мяч касается сетки во время подачи, это считается <w>ошибкой</w>.",
                                "zh": "如果发球时球触网，这被称为<w>违例</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "double fault",
                        "service fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправильная подача или ошибка в таких видах спорта, как теннис.",
                        "zh": "网球等运动中发球违例或犯规。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оши́бка",
                                "target_lang_sense_clarification": "при подаче в спорте"
                            },
                            {
                                "target_lang_word": "фол",
                                "target_lang_sense_clarification": "нарушение правил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "运动中的技术性错误"
                            },
                            {
                                "target_lang_word": "违例",
                                "target_lang_sense_clarification": "违反比赛规则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad242450-7817-323d-8c47-5083be5de764",
                    "sense_definition": "A fracture in a rock formation where there has been significant displacement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is built near a major <w>fault</w> line, making it prone to earthquakes.",
                            "target_lang_translations": {
                                "ru": "Город построен рядом с крупным <w>разломом</w>, что делает его подверженным землетрясениям.",
                                "zh": "这座城市建在一条主要<w>断层</w>带附近，因此容易发生地震。"
                            }
                        },
                        {
                            "text": "Geologists are studying the <w>fault</w> to predict future seismic activity.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают <w>разлом</w>, чтобы предсказать будущую сейсмическую активность.",
                                "zh": "地质学家正在研究这个<w>断层</w>以预测未来的地震活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fault line",
                        "geological fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрыв в горных породах, сопровождающийся значительным смещением.",
                        "zh": "岩层中发生显著位移的断裂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разло́м",
                                "target_lang_sense_clarification": "тектонический сдвиг"
                            },
                            {
                                "target_lang_word": "сброс",
                                "target_lang_sense_clarification": "геологическое смещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "断层",
                                "target_lang_sense_clarification": "地质学上的岩层断裂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beabd423-4302-3c1e-a602-d3a5cefc3352",
                    "sense_definition": "An undesirable variation or contamination in food or drink, especially wine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sommelier noticed a <w>fault</w> in the wine that made it smell like wet cardboard.",
                            "target_lang_translations": {
                                "ru": "Сомелье заметил <w>порок</w> в вине, из-за которого оно пахло мокрым картоном.",
                                "zh": "侍酒师注意到这瓶酒有<w>瑕疵</w>，闻起来像湿纸板。"
                            }
                        },
                        {
                            "text": "Cork taint is one of the most common wine <w>faults</w> found in restaurants.",
                            "target_lang_translations": {
                                "ru": "Пробковая болезнь — один из самых распространенных <w>дефектов</w> вина, встречающихся в ресторанах.",
                                "zh": "软木塞污染是餐厅里最常见的葡萄酒<w>缺陷</w>之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежелательное изменение или порча еды или напитков, особенно вина.",
                        "zh": "食物或饮料（尤其是葡萄酒）中不理想的变质或污染。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поро́к",
                                "target_lang_sense_clarification": "дефект вкуса или запаха вина"
                            },
                            {
                                "target_lang_word": "дефе́кт",
                                "target_lang_sense_clarification": "порча продукта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑕疵",
                                "target_lang_sense_clarification": "酒类品质上的缺陷"
                            },
                            {
                                "target_lang_word": "变质",
                                "target_lang_sense_clarification": "食物或饮料的品质受损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e09d4e-b877-3414-94a9-4e113a1fb432",
                    "sense_definition": "A penalty point assessed in equestrian events for mistakes like knocking down a rail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider finished the course with four <w>faults</w> after the horse refused a jump.",
                            "target_lang_translations": {
                                "ru": "Всадник закончил дистанцию с четырьмя <w>штрафными очками</w> после того, как лошадь отказалась прыгать.",
                                "zh": "由于马匹拒绝跳跃，骑手以四次<w>罚分</w>结束了比赛。"
                            }
                        },
                        {
                            "text": "To win the competition, she needs a clear round without any <w>faults</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы выиграть соревнование, ей нужно пройти раунд чисто, без <w>штрафов</w>.",
                                "zh": "为了赢得比赛，她需要零<w>罚分</w>完成比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "time fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Штрафное очко в конном спорте за такие ошибки, как сбитое препятствие.",
                        "zh": "马术比赛中因犯错（如碰落横杆）而被扣的分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штрафно́е очко́",
                                "target_lang_sense_clarification": "в конном спорте"
                            },
                            {
                                "target_lang_word": "штраф",
                                "target_lang_sense_clarification": "наказание за ошибку на дистанции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罚分",
                                "target_lang_sense_clarification": "比赛中的惩罚性扣分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3228115d-1827-30d6-8948-d2c0bb18ffa8",
                    "sense_definition": "The absence or lack of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>fault</w> of a better alternative, we decided to stay at the local hostel.",
                            "target_lang_translations": {
                                "ru": "За <w>отсутствием</w> лучшей альтернативы мы решили остановиться в местном хостеле.",
                                "zh": "由于<w>缺乏</w>更好的选择，我们决定住在当地的旅舍。"
                            }
                        },
                        {
                            "text": "The project failed for <w>fault</w> of sufficient funding and resources.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за <w>нехватки</w> достаточного финансирования и ресурсов.",
                                "zh": "该项目因<w>缺乏</w>足够的资金和资源而失败。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "for fault of"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in specific literary or old-fashioned contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие или нехватка чего-либо.",
                        "zh": "某物的缺失或不足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсу́тствие",
                                "target_lang_sense_clarification": "нехватка чего-либо"
                            },
                            {
                                "target_lang_word": "недоста́ток",
                                "target_lang_sense_clarification": "дефицит ресурсов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺乏",
                                "target_lang_sense_clarification": "资源或条件的不足"
                            },
                            {
                                "target_lang_word": "缺失",
                                "target_lang_sense_clarification": "某物的完全不存在"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "558e4478-7002-3438-a6bc-5bdf2e3dd8ae",
                    "sense_definition": "To criticize or find a reason to complain about someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot <w>fault</w> his dedication to the project even if the results were poor.",
                            "target_lang_translations": {
                                "ru": "Его нельзя <w>упрекнуть</w> в отсутствии преданности проекту, даже если результаты были плохими.",
                                "zh": "即使结果不佳，你也不能<w>指责</w>他对项目的投入。"
                            }
                        },
                        {
                            "text": "The judges could not <w>fault</w> her performance as it was technically perfect.",
                            "target_lang_translations": {
                                "ru": "Судьи не смогли <w>придраться</w> к её выступлению, так как оно было технически безупречным.",
                                "zh": "评委们无法对她的表演进行<w>挑剔</w>，因为其技术上非常完美。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hard to fault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать или находить причину для жалоб на кого-либо или что-либо.",
                        "zh": "批评或寻找理由抱怨某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винить",
                                "target_lang_sense_clarification": "возлагать вину"
                            },
                            {
                                "target_lang_word": "придира́ться",
                                "target_lang_sense_clarification": "находить недостатки"
                            },
                            {
                                "target_lang_word": "упрека́ть",
                                "target_lang_sense_clarification": "высказывать недовольство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指责",
                                "target_lang_sense_clarification": "对某人提出批评"
                            },
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "过分寻找缺点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b152e41-5c8d-3de6-88b7-f1fb26e70238",
                    "sense_definition": "To undergo a fracture or displacement in a rock formation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rock layers began to <w>fault</w> under the extreme pressure of the tectonic plates.",
                            "target_lang_translations": {
                                "ru": "Слои породы начали <w>смещаться</w> под экстремальным давлением тектонических плит.",
                                "zh": "在构造板块的极端压力下，岩层开始<w>断裂</w>。"
                            }
                        },
                        {
                            "text": "The area has <w>faulted</w> several times over millions of years.",
                            "target_lang_translations": {
                                "ru": "В этой области несколько раз происходили <w>разломы</w> на протяжении миллионов лет.",
                                "zh": "在数百万年的时间里，该地区已经多次发生<w>断裂</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Претерпевать разрыв или смещение в горной породе.",
                        "zh": "岩层发生断裂或位移。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образо́вывать разло́м",
                                "target_lang_sense_clarification": "о горных породах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "断裂",
                                "target_lang_sense_clarification": "岩层受力产生位移"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}