                "senses": [
                    {
                        "sense_id": "4345870c-c488-350f-bcc2-e73027b57816",
                        "entry_id": "b154d1e0-caf8-3425-b549-765a1a927dd0",
                        "glosses": [
                            "een vertelling waarin meerdere afzonderlijke verhalen worden verteld; verhaal dat dient als omlijsting van meerdere andere verhalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26be711a-d22a-4b12-9f7f-02406de89686",
                                "sense_id": "4345870c-c488-350f-bcc2-e73027b57816",
                                "text": "De raamvertelling ging over een jonge vrouw die door verschillende toevalligheden helemaal buiten haar schuld om in het vizier van de schandaalpers verzeild raakte, wier hele leven verwoest werd door deze ergste vorm van journalistiek."
                            },
                            {
                                "example_id": "90f4ce97-484f-4882-9931-43e9d7c0ea73",
                                "sense_id": "4345870c-c488-350f-bcc2-e73027b57816",
                                "text": "Het Westen leerde het verhaal, over een bedelaar die een magische lamp vindt, kennen in de vertaling van de Arabische raamvertelling 1001 nacht. Samen met Sinbad de Zeeman en Ali Baba ontketende het in Europa een 'turkomanie' die eeuwenlang het clichébeeld van het Midden-Oosten zou bepalen. De complexe origine van het verhaal ging daarbij verloren."
                            }
                        ]
                    }
