                                "example_id": "fde5bd93-4bb6-4453-a786-03282cdc5c5c",
                                "sense_id": "15652d77-f4a7-3d38-aabe-2036123265e7",
                                "text": "„Wer eingestünde, dass er in den 1980ern mit Jeans und Stulpen auf der Piste war, diskreditierte sich im Grunde als Betrachter des Buches ‚The Stylish Life Skiing‘.“"
                            },
                            {
                                "example_id": "ba2c545b-444d-4480-a8a0-da42b95cd5f2",
                                "sense_id": "15652d77-f4a7-3d38-aabe-2036123265e7",
                                "text": "„Eine Kugel prallt auf dem Stulpen seines Stiefels auf, und der Dichter kommt noch ziemlich billig mit einer leichten Prellung davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
