                "senses": [
                    {
                        "sense_id": "2dd336b6-513e-3eab-bd40-e9dd988d7b07",
                        "entry_id": "6a1454bd-f445-3fec-a37c-e62f447f4d2c",
                        "glosses": [
                            "in einem an Ochsenblut erinnernden Rotton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc413e34-0b78-49f8-b403-1ab4cf9a628f",
                                "sense_id": "2dd336b6-513e-3eab-bd40-e9dd988d7b07",
                                "text": "„Ja, du hasst dein Haar und seine komische, ochsenblutrote Farbe, obwohl alle anderen, Männer wie Frauen, es scheinbar faszinierend finden.“"
                            },
                            {
                                "example_id": "b83e196b-20f8-4335-90fa-706c26db659c",
                                "sense_id": "2dd336b6-513e-3eab-bd40-e9dd988d7b07",
                                "text": "„Vom neuen Schuh dehnte sich ein ochsenblutroter Fleck über die weiße Socke.“"
                            }
                        ],
