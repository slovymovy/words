                "senses": [
                    {
                        "sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                        "entry_id": "844b61cd-39df-3b32-bd04-9ec947d805f2",
                        "glosses": [
                            "Mädchen, das zur Schule geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62fe0d62-5e74-42fd-a1db-402be88fd8d1",
                                "sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                                "text": "„Sie ist eine kleine Person, sieht im weißen leichten Kleidchen mit bloßen Armen wie ein Schulmädchen aus, hat sanfte, langsame Bewegungen, ist unmerklich gleich neben ihm.“"
                            },
                            {
                                "example_id": "4bb25016-c7c9-48d7-96dd-24aa2145151e",
                                "sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                                "text": "„Sie sitzt still da, bleich wie ein Schulmädchen.“"
                            },
                            {
                                "example_id": "c364d61e-1b80-489b-abd5-b80358d5cdf2",
                                "sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                                "text": "„Neben uns stehen zwei Schulmädchen und ein Junge, sonst herrscht wenig Betrieb.“"
                            },
                            {
                                "example_id": "2944462a-2574-4630-a554-dd0762f050d6",
                                "sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                                "text": "„Sylvia bemühte sich, ruhig und geschäftsmäßig zu klingen, obwohl sie sich wie ein Schulmädchen fühlte, das am liebsten aus dem Haus gerannt und die Straße heruntergehüpft wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc6461bf-a670-4500-904f-231c7b6a6367",
                        "source_entry_id": "844b61cd-39df-3b32-bd04-9ec947d805f2",
                        "source_sense_id": "e246b7ff-93f4-35e6-bc1c-51fdd7c83806",
                        "source_sense_description": "Mädchen, das zur Schule geht",
                        "target_lang_word": "schoolgirl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolgirl",
