{
    "word_family": [
        "jakiś",
        "jakoś",
        "jako",
        "jakiśkolwiek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94140c02-46c9-3e35-be35-2441bbac531e",
                    "sense_definition": "używany w pytaniach o sposób, stan lub stopień",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jak</w> masz na imię?",
                            "target_lang_translations": {
                                "en": "<w>What</w> is your name?"
                            }
                        },
                        {
                            "text": "<w>Jak</w> się dzisiaj czujesz?",
                            "target_lang_translations": {
                                "en": "<w>How</w> are you feeling today?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jak się masz"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in questions about manner, state, or degree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "Used to ask about the state or condition of someone or something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "787b7040-15b3-31db-96b3-8078fffacd1b",
                    "sense_definition": "używany w pytaniach o sposób lub stan",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jak</w> dojechać do centrum?",
                            "target_lang_translations": {
                                "en": "<w>How</w> do I get to the center?"
                            }
                        },
                        {
                            "text": "<w>Jak</w> to naprawić?",
                            "target_lang_translations": {
                                "en": "<w>How</w> do I fix this?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used in questions about manner or state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "Used to ask about the manner or method of doing something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "619dc244-4ccc-3fed-a266-75c5fae33612",
                    "sense_definition": "w sposób lub w stopniu takim samym jak ktoś lub coś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "porównanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego ojciec jest silny <w>jak</w> wół.",
                            "target_lang_translations": {
                                "en": "His father is strong <w>as</w> an ox."
                            }
                        },
                        {
                            "text": "<w>Jak</w> widać, jeszcze nie skończyłam.",
                            "target_lang_translations": {
                                "en": "<w>As</w> you can see, I haven't finished yet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silny jak wół"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner or to a degree the same as someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "Used to introduce a comparison of manner or degree."
                            },
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "Used to indicate similarity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a8c7085-d87f-3fcf-8ef4-821b901ad132",
                    "sense_definition": "spójnik wprowadzający czas trwania czynności, synonim <w>kiedy</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jak</w> byłem w lesie, to widziałem niedźwiedzia.",
                            "target_lang_translations": {
                                "en": "<w>When</w> I was in the forest, I saw a bear."
                            }
                        },
                        {
                            "text": "<w>Jak</w> wrócę do domu, to zadzwonię.",
                            "target_lang_translations": {
                                "en": "<w>When</w> I return home, I will call."
                            }
                        }
                    ],
                    "synonyms": [
                        "kiedy /gdy"
                    ],
                    "target_lang_definitions": {
                        "en": "Conjunction introducing the duration of an action, synonym for 'when'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "Used to indicate an action happening at the same time as another."
                            },
                            {
                                "target_lang_word": "when",
                                "target_lang_sense_clarification": "Used to indicate the time at which an action occurs."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "745c6453-bbc8-377f-a26b-931819a5e948",
                    "sense_definition": "spójnik wprowadzający warunek, synonim <w>jeżeli</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "warunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jak</w> będziesz dalej tak robiła, to w końcu cię rzuci.",
                            "target_lang_translations": {
                                "en": "<w>If</w> you keep doing that, he will eventually dump you."
                            }
                        },
                        {
                            "text": "<w>Jak</w> nie chcesz pracować, to nie dostaniesz zapłaty.",
                            "target_lang_translations": {
                                "en": "<w>If</w> you don't want to work, you won't get paid."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeżeli",
                        "jeśli"
                    ],
                    "target_lang_definitions": {
                        "en": "Conjunction introducing a condition, synonym for 'if'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "Used to introduce a conditional clause."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb6d022-9a38-3e90-b8f4-08f16e9cbc47",
                    "sense_definition": "w sposób sugerujący podobieństwo, jak gdyby",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "porównanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wyglądasz <w>jak</w> obcokrajowiec.",
                            "target_lang_translations": {
                                "en": "You look <w>like</w> a foreigner."
                            }
                        },
                        {
                            "text": "Zachowuje się, <w>jak</w>by był właścicielem tej firmy.",
                            "target_lang_translations": {
                                "en": "He behaves <w>as if</w> he were the owner of this company."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner suggesting similarity, as if."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "Used to suggest similarity or appearance."
                            },
                            {
                                "target_lang_word": "as if",
                                "target_lang_sense_clarification": "Used to describe a hypothetical state or manner."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdfead7d-de15-3c19-8e7f-5b063298c818",
                    "sense_definition": "używany w porównaniach w znaczeniu <w>niż</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "porównanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Typ nie miał więcej <w>jak</w> metr sześćdziesiąt.",
                            "target_lang_translations": {
                                "en": "The guy wasn't more <w>than</w> one meter sixty."
                            }
                        },
                        {
                            "text": "Jacek jest wyższy <w>jak</w> Ada.",
                            "target_lang_translations": {
                                "en": "Jacek is taller <w>than</w> Ada."
                            }
                        }
                    ],
                    "synonyms": [
                        "niż"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in comparisons in the sense of 'than'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "than",
                                "target_lang_sense_clarification": "Used to introduce the second element in a comparison."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b2d94cd-437c-3811-8f5d-c8a190d3d827",
                    "sense_definition": "używany w konstrukcjach z przymiotnikami w stopniu najwyższym",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stopniowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zrobię to <w>jak</w> najszybciej.",
                            "target_lang_translations": {
                                "en": "I will do it <w>as</w> soon <w>as</w> possible."
                            }
                        },
                        {
                            "text": "Proszę przyjść <w>jak</w> najwcześniej.",
                            "target_lang_translations": {
                                "en": "Please come <w>as</w> early <w>as</w> possible."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jak najszybciej"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in constructions with adjectives in the superlative degree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as ... as possible",
                                "target_lang_sense_clarification": "Used to express the highest possible degree."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91dcb643-b95a-3ce9-8195-ec92cefb1138",
                    "sense_definition": "duży ssak z rodziny pustorożców zamieszkujący góry Azji",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zwierzę",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Udomowione <w>jaki</w> są zwierzętami jucznymi, poza tym dają mleko i wełnę.",
                            "target_lang_translations": {
                                "en": "Domesticated <w>yaks</w> are pack animals; besides that, they provide milk and wool."
                            }
                        },
                        {
                            "text": "W wysokich partiach Himalajów spotyka się dzikie <w>jaki</w>.",
                            "target_lang_translations": {
                                "en": "In the high parts of the Himalayas, one can encounter wild <w>yaks</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wół tybetański"
                    ],
                    "target_lang_definitions": {
                        "en": "A large mammal of the bovid family inhabiting the mountains of Asia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yak",
                                "target_lang_sense_clarification": "A long-haired bovid native to the Himalayas."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776aa3fd-f2fd-3fc7-b535-3f201d7d76c6",
                    "sense_definition": "radziecki samolot wojskowy konstrukcji Jakowlewa",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technika",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Podczas pokazu lotniczego zaprezentowano zabytkowy samolot <w>Jak</w>.",
                            "target_lang_translations": {
                                "en": "During the air show, a vintage <w>Yak</w> plane was presented."
                            }
                        },
                        {
                            "text": "Piloci szkolili się na maszynach typu <w>Jak</w>.",
                            "target_lang_translations": {
                                "en": "Pilots trained on <w>Yak</w>-type machines."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A Soviet military aircraft designed by Yakovlev."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Yak",
                                "target_lang_sense_clarification": "A type of Soviet aircraft."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}