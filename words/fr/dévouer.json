    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f900375-a6a0-3966-8808-66b1865da9db",
                    "sense_definition": "Consacrer entièrement ses forces, son temps ou son existence à une personne, une cause ou une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consécration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médecin a <w>dévoué</w> sa vie à soigner les plus démunis dans les régions isolées."
                        },
                        {
                            "text": "Les bénévoles se <w>dévouent</w> sans compter pour aider les familles en difficulté financière."
                        }
                    ],
                    "synonyms": [
                        "consacrer"
                    ],
                    "common_phrases": [
                        "dévouer sa vie",
                        "se dévouer corps et âme"
                    ]
                },
                {
                    "sense_id": "6b4f5338-7837-33f5-be88-bcb19338fe08",
                    "sense_definition": "S'exposer délibérément à un danger ou assumer volontairement une tâche pénible par abnégation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sacrifice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'incendie, un pompier s'est <w>dévoué</w> au péril de sa vie pour évacuer les habitants."
                        },
                        {
                            "text": "Puisque personne ne veut accomplir cette corvée désagréable, je me <w>dévoue</w> volontiers."
                        }
                    ],
                    "common_phrases": [
                        "se dévouer pour les autres"
                    ]
                },
                {
                    "sense_id": "5b47e5de-778a-3302-8c3f-4caeb42af42e",
                    "sense_definition": "Témoigner un profond attachement ou se mettre à l'entière disposition d'une personne par courtoisie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courtoisie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Disposez de mes services selon vos souhaits car je vous suis tout <w>dévoué</w>."
                        },
                        {
                            "text": "Dans sa correspondance officielle, il rappelait au ministre combien il lui était <w>dévoué</w>."
                        }
                    ],
                    "common_phrases": [
                        "être tout dévoué"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formule de déférence classique"
                        }
                    ]
                }
            ]
        }
    ]
