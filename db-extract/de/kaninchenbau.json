                ],
                "senses": [
                    {
                        "sense_id": "b769f16a-3a2d-3bc2-89e1-e2daeff6c50d",
                        "entry_id": "cd8b19f6-f325-3a58-a7cf-090e569d40c0",
                        "glosses": [
                            "der Bau eines Kaninchens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6efd353f-6a0d-40a3-b1f0-5555d7dff688",
                                "sense_id": "b769f16a-3a2d-3bc2-89e1-e2daeff6c50d",
                                "text": "Hinten im Garten ist ein Kaninchenbau."
                            },
                            {
                                "example_id": "1010d4dc-e4c2-449c-9c80-ef66214391b6",
                                "sense_id": "b769f16a-3a2d-3bc2-89e1-e2daeff6c50d",
                                "text": "„Die Geschichte ist ein Klassiker: Die kleine Alice fällt in einen Kaninchenbau und findet einen Durchgang in eine ebenso surrealistische wie komische Welt.“"
                            },
                            {
                                "example_id": "83bbb430-ac17-4701-ae2b-52d8fee67276",
                                "sense_id": "b769f16a-3a2d-3bc2-89e1-e2daeff6c50d",
                                "text": "„Vor dem Kaninchenbau hatten sie Fallen aufgestellt, Tag für Tag brachten sie Kaninchen mit nach Hause, so daß Nab kaum mit dem Zubereiten und Einpökeln nachkam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "513a50a4-d0e7-4312-ace5-ac8c1b824c95",
                        "source_entry_id": "cd8b19f6-f325-3a58-a7cf-090e569d40c0",
                        "source_sense_id": "b769f16a-3a2d-3bc2-89e1-e2daeff6c50d",
                        "source_sense_description": "der Bau eines Kaninchens",
                        "target_lang_word": "rabbit hole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabbit hole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d560b490-e541-39a5-a2f6-fa1c1accea9e",
                                        "entry_id": "5e456ba1-ca00-33cf-9ffd-0a1eef658141",
                                        "glosses": [
                                            "A bizarre world, where everyday rules do not apply."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3708fa6-3ed6-351a-af4d-427fa895a1a8",
                                        "entry_id": "5e456ba1-ca00-33cf-9ffd-0a1eef658141",
                                        "glosses": [
                                            "A way into such a world."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e83bff2-1836-43d8-8ab9-a3ec71262d1d",
                                                "sense_id": "a3708fa6-3ed6-351a-af4d-427fa895a1a8",
                                                "text": "These mushrooms will take you down the rabbit hole, man."
                                            },
                                            {
                                                "example_id": "33859959-4549-4d0f-b5cb-024c31166c6c",
                                                "sense_id": "a3708fa6-3ed6-351a-af4d-427fa895a1a8",
                                                "text": "You take the blue pill, the story ends, you wake up in your bed and believe whatever you want to believe. You take the red pill, you stay in Wonderland, and I show you how deep the rabbit hole goes."
                                            },
                                            {
                                                "example_id": "dbe6259f-738a-4bb2-9d1e-1c1d3ada3e7d",
                                                "sense_id": "a3708fa6-3ed6-351a-af4d-427fa895a1a8",
                                                "text": "Tumbling down the rabbit hole, she encountered a whole new level of existence where the laws of physics were turned upside down, shaken inside out and taken to the cleaners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                        "entry_id": "5e456ba1-ca00-33cf-9ffd-0a1eef658141",
                                        "glosses": [
                                            "A time-consuming tangent or detour, often one from which it is difficult to extricate oneself."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02add93c-1cb8-4590-8e26-e3a92aa0c867",
                                                "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                                "text": "Near-synonym: rabbit trail (regiolectic)"
                                            },
                                            {
                                                "example_id": "b88b40b5-6ea3-4640-ba9a-c0c3acde9b44",
                                                "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                                "text": "I'm also a fan of a really obscure book series, but that's a rabbit hole that we won't get into."
                                            },
                                            {
                                                "example_id": "5961f4f8-c4aa-4188-b6d1-92b53465a274",
                                                "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                                "text": "While writing my paper, my research went down several rabbit holes that were only marginally related and wasted a lot of my time."
                                            },
                                            {
                                                "example_id": "bf80273e-6776-4a05-9def-3e7f444ad670",
                                                "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                                "text": "My point is not to go down the rabbit hole of deconstructing the term documentary, […]"
                                            },
                                            {
                                                "example_id": "fa3ec999-345c-4eb0-b70b-7a3f5025da3a",
                                                "sense_id": "27da047d-ecf5-30ed-868f-6645fdf86114",
                                                "text": "I felt pretty strongly that non-food supplements would be a complicated, expensive rabbit hole that rarely cure children fully of anxiety / autism / etc. (especially in the absence of enough nourishing food)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9fc327-70c8-3978-8c17-bc11c745493c",
                                        "entry_id": "5e456ba1-ca00-33cf-9ffd-0a1eef658141",
                                        "glosses": [
                                            "The initial clue that leads to an alternate reality game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd49a5e6-7e82-3264-a729-79bcc4b87276",
                                        "entry_id": "5e456ba1-ca00-33cf-9ffd-0a1eef658141",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see rabbit, hole. The entrance to a rabbit warren or burrow; the whole warren or burrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db78f32-c624-409f-b732-a2dff139774a",
                                                "sense_id": "fd49a5e6-7e82-3264-a729-79bcc4b87276",
                                                "text": "The rabbit-hole went straight on like a tunnel for some way, and then dipped suddenly down, so suddenly that Alice had not a moment to think about stopping herself before she found herself falling down what seemed to be a very deep well."
                                            },
                                            {
                                                "example_id": "21be9bc3-98c1-4dd2-9b78-552e3d160d66",
                                                "sense_id": "fd49a5e6-7e82-3264-a729-79bcc4b87276",
                                                "text": "As the limber gunners went to the rear, his horse trod in a rabbit-hole and came down, throwing him into a depression of the ground."
                                            },
                                            {
                                                "example_id": "18c5fb7e-a584-463f-be2c-d505211f3eca",
                                                "sense_id": "fd49a5e6-7e82-3264-a729-79bcc4b87276",
                                                "text": "There are two platforms (that on the down side is a island) but they are weed-grown, with many rabbit-holes, and there is no cover of any kind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
