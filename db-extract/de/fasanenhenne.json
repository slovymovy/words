                ],
                "senses": [
                    {
                        "sense_id": "2259db68-6946-3ff1-a1eb-5fc465b0d969",
                        "entry_id": "0a2b0014-57a7-3b1e-bfca-fc5591068952",
                        "glosses": [
                            "Fasan weiblichen Geschlechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc7c3cb-e4bf-4261-b2b6-028f98f98321",
                                "sense_id": "2259db68-6946-3ff1-a1eb-5fc465b0d969",
                                "text": "„Ich habe wiederholt Gelegenheit gehabt, schnellfüßige Jagdhunde hinter einer scheinbar gelähmten Fasanenhenne rennen zu sehen, und jedesmal über die riesige Geschicklichkeit der Mutter staunen müssen, wie sie das Zufassen zu verhindern wußte.“"
                            },
                            {
                                "example_id": "4ec89f13-b055-4252-9d84-8e2311906e7a",
                                "sense_id": "2259db68-6946-3ff1-a1eb-5fc465b0d969",
                                "text": "„[…] Nun hat er ihn vor sich; ganz deutlich sieht er ihn. Unterwärts ist er schwarzblau, wie ein Birkhahn, auch die Kopfbildung schlägt dahin, aber das Obergefieder ähnelt dem der Fasanenhenne, und der Stoß ist so lang wie beim Fasanenhahne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
