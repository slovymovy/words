    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "f4e7050a-60ac-3ffc-a29b-8f92293b7d9c",
                    "sense_definition": "и тот, и другой; каждый из двух",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <оба> очень любим читать книги.",
                            "target_lang_translations": {
                                "en": "We <both> love reading books very much.",
                                "zh": "我们<w>都</w>非常喜欢读书。"
                            }
                        },
                        {
                            "text": "В <обоих> случаях результат был одинаковым.",
                            "target_lang_translations": {
                                "en": "In <both> cases the result was the same.",
                                "zh": "在<w>双方</w>的情况下结果都是一样的。"
                            }
                        },
                        {
                            "text": "У меня замёрзли <обе> руки.",
                            "target_lang_translations": {
                                "en": "<Both> my hands are frozen.",
                                "zh": "我的两只手<w>都</w>冻僵了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "никто"
                    ],
                    "common_phrases": [
                        "мы оба",
                        "они оба",
                        "в обоих случаях",
                        "смотреть в оба"
                    ],
                    "target_lang_definitions": {
                        "en": "one and the other; each of the two",
                        "zh": "指两个中的每一个，两者都"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "both",
                                "target_lang_sense_clarification": "referring to two people or things"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "都",
                                "target_lang_sense_clarification": "用于强调两者皆是"
                            },
                            {
                                "target_lang_word": "双方",
                                "target_lang_sense_clarification": "指两个方面或两个人"
                            }
                        ]
                    }
                }
            ]
        },
        {
