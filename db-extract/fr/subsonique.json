                                                "sense_id": "9d22261b-3024-3dda-8ba6-6d59bd5b3b20",
                                                "text": "The noise of the ship was all around her. The faint subsonic rumble of the reactor and drive. (Leviathan Wakes, James S. A. Corey)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b90a5df-dad3-3f67-83fc-936d9f23e7fd",
                                        "entry_id": "582a1dac-1930-3388-8edb-391b003c2fd6",
                                        "glosses": [
                                            "(aviation) less than the speed of sound (in the same medium, and at the same temperature and pressure)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fde76b1-2823-4dd6-8a44-c740a65ab1b1",
                                                "sense_id": "1b90a5df-dad3-3f67-83fc-936d9f23e7fd",
                                                "text": "But British Airways Flight 112 made the trek in under five hours, setting a new record for the fastest subsonic commercial flight across the Atlantic Ocean."
                                            }
