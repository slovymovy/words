                        "sense_id": "2e3f8868-74d7-30da-92ce-99c15f1f9f0a",
                        "entry_id": "2544b757-b03d-3de6-b535-6046b7060b5a",
                        "glosses": [
                            "Donner un caractère révolutionnaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d08fd55-48c1-4ce8-913e-00e6045cfdf1",
                                "sense_id": "2e3f8868-74d7-30da-92ce-99c15f1f9f0a",
                                "text": "Il fallait « révolutionnariser » les citadins, les « purifier » en les envoyant travailler dans les campagnes."
                            },
                            {
                                "example_id": "9bc56fc4-ade3-44fb-9553-e2e7def54533",
                                "sense_id": "2e3f8868-74d7-30da-92ce-99c15f1f9f0a",
                                "text": "Fort de la ligne directrice ainsi dégagée, chaque citoyen, à quelque niveau qu’il se trouve, doit entreprendre de révolutionnariser son secteur d’activité."
                            }
                        ]
                    }
