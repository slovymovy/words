{
    "word_family": [
        "drift",
        "driftigheid",
        "driftkop"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7091821c-9bc5-3460-9a74-63541b0b13d3",
                    "sense_definition": "snel boos worden of gemakkelijk geirriteerd raken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar werd <w>driftig</w> toen de leerlingen niet wilden luisteren naar zijn uitleg.",
                            "target_lang_translations": {
                                "en": "The teacher became <w>angry</w> when the students would not listen to his explanation."
                            }
                        },
                        {
                            "text": "Hij is een <w>driftig</w> mannetje dat om het kleinste dingetje begint te schreeuwen.",
                            "target_lang_translations": {
                                "en": "He is a <w>short-tempered</w> little man who starts shouting at the slightest thing."
                            }
                        }
                    ],
                    "synonyms": [
                        "cholerisch",
                        "opbruisend"
                    ],
                    "antonyms": [
                        "kalm",
                        "rustig",
                        "geduldig"
                    ],
                    "common_phrases": [
                        "een driftig mannetje",
                        "driftig worden"
                    ],
                    "target_lang_definitions": {
                        "en": "becoming angry quickly or easily irritated"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hot-tempered",
                                "target_lang_sense_clarification": "easily angered"
                            },
                            {
                                "target_lang_word": "irascible",
                                "target_lang_sense_clarification": "formal term for quick-tempered"
                            },
                            {
                                "target_lang_word": "short-tempered",
                                "target_lang_sense_clarification": "losing patience quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "226e2e6c-5494-3446-b4f3-4f0094985620",
                    "sense_definition": "met veel passie, overgave of innerlijke drang",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hield een <w>driftig</w> pleidooi voor de bescherming van het lokale bos.",
                            "target_lang_translations": {
                                "en": "She made a <w>passionate</w> plea for the protection of the local forest."
                            }
                        },
                        {
                            "text": "Met <w>driftige</w> gebaren probeerde de dirigent het orkest tot grotere hoogten te stuwen.",
                            "target_lang_translations": {
                                "en": "With <w>vehement</w> gestures, the conductor tried to push the orchestra to greater heights."
                            }
                        }
                    ],
                    "antonyms": [
                        "onverschillig",
                        "mat"
                    ],
                    "common_phrases": [
                        "een driftig pleidooi"
                    ],
                    "target_lang_definitions": {
                        "en": "with great passion, dedication, or inner drive"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passionate",
                                "target_lang_sense_clarification": "showing strong feelings"
                            },
                            {
                                "target_lang_word": "vehement",
                                "target_lang_sense_clarification": "showing strong and often angry feelings"
                            },
                            {
                                "target_lang_word": "fervent",
                                "target_lang_sense_clarification": "having or displaying a passionate intensity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "06830888-79c0-3139-8634-1b0649509ff1",
                    "sense_definition": "op een zeer drukke, snelle of verwoede manier",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was <w>driftig</w> aan het rekenen of hij wel genoeg verdiend had om op vakantie te kunnen gaan.",
                            "target_lang_translations": {
                                "en": "He was <w>feverishly</w> calculating whether he had earned enough to be able to go on holiday."
                            }
                        },
                        {
                            "text": "De secretaresse was <w>driftig</w> aan het typen om de deadline vanmiddag nog te halen.",
                            "target_lang_translations": {
                                "en": "The secretary was <w>furiously</w> typing to meet the deadline this afternoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "opbruisend",
                        "cholerisch"
                    ],
                    "antonyms": [
                        "langzaam",
                        "rustig"
                    ],
                    "common_phrases": [
                        "driftig aan het rekenen",
                        "driftig typen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a very busy, fast, or frantic manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feverishly",
                                "target_lang_sense_clarification": "in a way that shows great excitement or energy"
                            },
                            {
                                "target_lang_word": "furiously",
                                "target_lang_sense_clarification": "with great energy, speed, or intensity"
                            },
                            {
                                "target_lang_word": "busily",
                                "target_lang_sense_clarification": "in a way that involves a lot of activity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}