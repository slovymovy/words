                        "sense_id": "ba066789-9103-32b6-8bb3-911d5ce2153f",
                        "entry_id": "5618178a-b3c1-352f-a678-689dbaa5ab89",
                        "glosses": [
                            "Personne qui exténue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71c8634-968d-4334-89da-28f5646dd529",
                                "sense_id": "ba066789-9103-32b6-8bb3-911d5ce2153f",
                                "text": "…, ils sont des exténuateurs de notre histoire, ils ont déchanté notre humanité."
                            },
                            {
                                "example_id": "4e7fcdba-9b1e-4aa2-ae92-738409fc92ab",
                                "sense_id": "ba066789-9103-32b6-8bb3-911d5ce2153f",
                                "text": "Chaque fois qu’on a affaire à une grande erreur (grande non seulement par la gravité, mais aussi par le courage, la signification, et la consistance logique), on trouve naturellement des atténuateurs ou exténuateurs subtils, intelligents et érudits, qui estiment que la simple déclaration de ce qui est manque d’élégance, et exagère. — (Jacques Maritain, La philosophie morale, 1960)"
                            }
                        ]
                    }
