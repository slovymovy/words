                    {
                        "sense_id": "e7d793ba-9692-3f68-a0c5-c284deddc92a",
                        "entry_id": "a33eaa39-5e9b-3433-a6cf-2b4875f297a6",
                        "glosses": [
                            "Artisane qui fabrique ou vend des cordes."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "e5c93ed1-bb26-4e33-95d3-203d538abfa7",
                                "sense_id": "e7d793ba-9692-3f68-a0c5-c284deddc92a",
                                "text": "Le cimetière est plein de marchands qui négocient entre les tombes, de femmes cordières, cirières, qui étalent, sur les mausolées, des étuis divers, des bijoux de deuil."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6b894bd-ec62-37c0-994e-bc5c5330fed6",
                        "entry_id": "a33eaa39-5e9b-3433-a6cf-2b4875f297a6",
                        "glosses": [
                            "Épouse d’un cordier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cf7af69c-a819-4d66-a607-9cf2475342d2",
                                "sense_id": "b6b894bd-ec62-37c0-994e-bc5c5330fed6",
                                "text": "En 1542, d’après notre chronologie, la cordière aurait eu vingt ans, et cet âge ne concorde pas avec celui qu’elle se donne (pas encore seize ans) lors de sa première aventure amoureuse."
                            }
                        ]
                    }
                ],
