                "translations": [
                    {
                        "translation_id": "b5220def-7734-409e-b97b-dff4dd333f69",
                        "source_entry_id": "dc118088-4529-3b0c-be0b-a95a146df3b4",
                        "source_sense_id": "a64745b0-5493-34b8-83e3-5d2a4cfc1d8c",
                        "source_sense_description": "Person, die unentgeltlich ein Ehrenamt ausübt",
                        "target_lang_word": "volunteer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volunteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into, or offers themselves for, any service of their own free will, especially when done without pay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c8e9c7-6592-4364-8aec-e2caa7d68e8e",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The volunteers at the nature reserve meet up ever other Sunday to help its upkeep."
                                            },
                                            {
                                                "example_id": "971daf69-1465-4881-8149-de214d9f6e98",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The largest age group for volunteers was 35-44, the CNCS survey said, and volunteers were most likely to be parents with children under 18. The typical volunteer may live in Utah, which ranked first in the percentage of people who said they volunteered among all 50 states and Washington, DC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ac4b41-903c-3822-b1eb-9a9e5bcf42ac",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into military service voluntarily (but who, when in service, is subject to discipline and regulations like other soldiers), as opposed to a conscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A voluntary member of the organized militia of a country, as distinguished from a regular or member of the standing army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846ff25a-7fc4-4e65-818e-7accadd7a9fe",
                                                "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                                "text": "That summer and fall the Army organized twenty-five regiments of volunteers, including two black regiments, which would have all-black captains and lieutenants. All officers were to be selected from regulars and volunteers who had distinguished themselves[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e4831d-46f2-3884-8284-884730b9d549",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A person who acts out of their own will without a legal obligation, such as a donor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4397e770-550c-3958-be77-27fed251fc77",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A plant that grows spontaneously, without being cultivated on purpose; see volunteer plant in Wikipedia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b29511e6-d3d9-33cf-a52c-212d369d3aee",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A native or resident of the American state of Tennessee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "volunteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad62bf61-fd3b-3f35-b658-6825a83de8ee",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To enlist oneself as a volunteer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To do or offer to do something voluntarily."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ac2bc5-8b99-4b6e-9d92-86f76e6e5555",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "to volunteer for doing the dishes"
                                            },
                                            {
                                                "example_id": "19ac49e6-90e9-48b7-b7a6-c62e93b394d3",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "Miranda: No good. Both routes are blocked. See these doors? The only way past is to get someone to open them from the other side.\nShepard: It's not a fortress; there's got to be something. Here, maybe we can send someone in through this ventilation shaft.\nJacob: Practically a suicide mission. I volunteer.\nMiranda: I appreciate the thought, Jacob, but you couldn't shut down the security systems in time. We need to send a tech expert."
                                            },
                                            {
                                                "example_id": "124b2515-fbdc-44e6-9f8b-15b935ca1164",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "The typical volunteer may live in Utah, which ranked first in the percentage of people who said they volunteered among all 50 states and Washington, DC. […] The median amount of time per year spent volunteering was 52 hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13060a47-7c38-3d51-a37d-e1fb96a86d2e",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To offer, usually unprompted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc082df-d212-489b-af40-3236010f22b5",
                                                "sense_id": "13060a47-7c38-3d51-a37d-e1fb96a86d2e",
                                                "text": "to volunteer an explanation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07718a7-d134-3ff9-8c2f-a7d2a8468ba0",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To offer the services of (someone else) to do something."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3942b67-fef8-4ed9-945b-49880d228969",
                                                "sense_id": "a07718a7-d134-3ff9-8c2f-a7d2a8468ba0",
                                                "text": "My sister volunteered me to do the dishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "586e7b64-a1b8-39f1-9c6f-4720528df248",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To grow without human sowing or intentional cultivation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
