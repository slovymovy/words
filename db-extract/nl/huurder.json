                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "86eb7127-d695-46ba-b4ef-e04934d2120e",
                                "sense_id": "2da7a8a1-8f70-3e7e-b201-035587d9b175",
                                "text": "De huurder van de auto bracht hem na het weekend terug.",
                                "translation": "The hirer of the car returned it after the weekend.",
                                "english": "The hirer of the car returned it after the weekend."
                            },
                            {
                                "example_id": "83f0ef0c-e5e7-4317-8de0-055b5ff12810",
                                "sense_id": "2da7a8a1-8f70-3e7e-b201-035587d9b175",
                                "text": "De filmproductiebedrijf zocht een huurder voor hun apparatuur.",
                                "translation": "The film production company was looking for a renter for their equipment.",
                                "english": "The film production company was looking for a renter for their equipment."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a64c382-df30-3e30-841a-63858add6cc0",
                        "entry_id": "514a57a6-a158-386b-9170-97f6fa4dd68a",
                        "glosses": [
                            "tenant (of real estate, notably a home or room or apartment)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4c6e90fd-72ff-4105-ac76-b9c901f6d760",
                                "sense_id": "5a64c382-df30-3e30-841a-63858add6cc0",
                                "text": "De nieuwe wet beschermt de rechten van de huurders in deze stad.",
                                "translation": "The new law protects the rights of the tenants in this city.",
                                "english": "The new law protects the rights of the tenants in this city."
                            },
                            {
                                "example_id": "7d9ea07a-eab2-4375-8efa-e1c81a7aa08a",
                                "sense_id": "5a64c382-df30-3e30-841a-63858add6cc0",
                                "text": "De huurder van het appartement had een klacht over de lekkende kraan.",
                                "translation": "The tenant of the apartment had a complaint about the leaking faucet.",
                                "english": "The tenant of the apartment had a complaint about the leaking faucet."
                            }
                        ]
                    }
