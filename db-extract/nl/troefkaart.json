                                            {
                                                "example_id": "f2c8c989-b74b-473e-b257-8692e78e6c00",
                                                "sense_id": "667a9580-730a-3eb6-9931-78084cf1937f",
                                                "text": "And without warning me, as he lay there, he suddenly trumped next to me in bed."
                                            },
                                            {
