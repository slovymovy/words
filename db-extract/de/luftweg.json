                                "target_senses": [
                                    {
                                        "sense_id": "ca1856d2-848c-347d-b705-0d6e6a3e4cf0",
                                        "entry_id": "ebfe3c57-e81a-3881-b198-d03a8cdba13f",
                                        "glosses": [
                                            "Ensemble des organes; naseaux, nez, larynx, trachée artère et poumons; dans lequel circule l'air respiré."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b770e3-80a2-4d42-a7c6-20c85763e260",
                                                "sense_id": "ca1856d2-848c-347d-b705-0d6e6a3e4cf0",
                                                "text": "La poussière constitue un risque pour les voies respiratoires, d'autant qu'une majorité de salariés ne porte pas de masque ou porte un masque insuffisamment protecteur ou encombrant : […]."
                                            },
                                            {
                                                "example_id": "a13825ca-cce6-483e-8520-e7028d9e1948",
                                                "sense_id": "ca1856d2-848c-347d-b705-0d6e6a3e4cf0",
                                                "text": "Le professeur Léon Schwartzenberg vient d’annoncer que le célèbre imitateur souffre d'un cancer des voies respiratoires et que le traitement chimiothérapique l'oblige à annuler son spectacle au palais des Congrès, qui devait débuter la semaine prochaine à guichets fermés."
                                            }
                                        ]
