                    {
                        "sense_id": "7bbd767e-6950-31c9-b8a7-93dfa18d3455",
                        "entry_id": "c26d049d-ed37-3d16-973a-ef47b45a0148",
                        "glosses": [
                            "A mark or symbol worn on the forehead by Hindus, ornamentally or as an indication of status."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51428e8-d52b-4daa-b8b7-9713a7caf444",
                                "sense_id": "7bbd767e-6950-31c9-b8a7-93dfa18d3455",
                                "text": "I wore these spots of shine and silver like tilaks, the marks of colour that we Hindus wear on our foreheads as symbols of the divine."
                            },
                            {
                                "example_id": "fb64a4ad-aa0f-408e-a555-964902dd53a9",
                                "sense_id": "7bbd767e-6950-31c9-b8a7-93dfa18d3455",
                                "text": "He dressed in a dhoti, had a wispy white beard that trailed down to his waist, and regularly smeared across his forehead a tilaka, a pitchfork-shaped design that signifies enlightenment."
                            }
                        ]
                    }
                ],
