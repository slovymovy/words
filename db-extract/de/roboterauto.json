                "senses": [
                    {
                        "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                        "entry_id": "a73d0ace-605c-312e-9515-2fd443531d3d",
                        "glosses": [
                            "Auto, das in der Lage ist, ohne einen menschlichen Fahrer zu fahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51da3aca-4ce5-42d4-b40b-2dcc2be0f5a1",
                                "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                                "text": "„Die Google-Schwester ist seit 2009 auf der Straße, ihre Roboterautos haben Millionen an Kilometern ohne gröbere Zwischenfälle auf der Straße und Milliarden Kilometer in Computersimulationen abgespult.“"
                            },
                            {
                                "example_id": "f75e7d86-fac8-4390-92a8-04d4ab077291",
                                "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                                "text": "„Erste großflächige Tests mit Roboterautos zeigen: Ohne lenkende Maßnahmen nimmt der Verkehr eher zu.“"
                            },
                            {
                                "example_id": "432be718-ac7f-4fd6-82ef-b3bd14df014e",
                                "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                                "text": "„Die Österreichische Post tüftelt ja mit Experten der TU Graz intensiv an Drohnen und Roboterautos, wie man im Juli verriet.“"
                            },
                            {
                                "example_id": "d2dba1c1-bb09-476a-8542-1fd3e939fa0f",
                                "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                                "text": "„Es kam zur Kollision, in deren Folge das Roboterauto auf die Seite kippte.“"
                            },
                            {
                                "example_id": "33371b71-d79f-4ce2-b0f1-718951f1a013",
                                "sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                                "text": "„Die US-Tech-Firmen preschen beim Roboterauto vor, Audi, BMW und Co. sind eher zögerlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28535f33-0a3c-4164-8ca8-24a757338a94",
                        "source_entry_id": "a73d0ace-605c-312e-9515-2fd443531d3d",
                        "source_sense_id": "c9114e7e-5a0b-3b66-9c05-c8d96ec8226c",
                        "source_sense_description": "Auto, das in der Lage ist, ohne einen menschlichen Fahrer zu fahren",
                        "target_lang_word": "voiture autonome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiture autonome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2af8c0f4-3e0d-3bde-a66e-f10627b9e58d",
                                        "entry_id": "0a841a1f-f4f9-3062-babd-230951db1031",
                                        "glosses": [
                                            "Voiture apte à rouler, sur route ouverte, en conduite autonome, sans intervention d’un conducteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f920b9a-77c0-499f-b00d-55aeb5dd4d2f",
                                                "sense_id": "2af8c0f4-3e0d-3bde-a66e-f10627b9e58d",
                                                "text": "Au-delà de l’aspect purement technique, l’apparition de la voiture autonome dans nos sociétés touche le problème de la responsabilité, et donc la réglementation."
                                            },
                                            {
                                                "example_id": "b1023e96-6006-4e53-bf55-348de0a53326",
                                                "sense_id": "2af8c0f4-3e0d-3bde-a66e-f10627b9e58d",
                                                "text": "Il y a une différence entre l’usage commun des mots et la signification précise que leur donnent les scientifiques. Ainsi, […] ce qu’on appelle communément « voiture autonome » devrait à proprement parler s’appeler « voiture automatique » au sens où de telles voitures se meuvent d’elles-mêmes, ou « robot automobile »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
