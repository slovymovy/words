                "senses": [
                    {
                        "sense_id": "4166701a-3cf4-37b5-aa63-caf5e4f7ba19",
                        "entry_id": "d7f2cded-07f1-3d7d-bd81-8f94a73d4db6",
                        "glosses": [
                            "Vereinbarung, die die Bewaffnung einer Armee betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcd0638-ca8e-4c82-af54-f738e1ce1607",
                                "sense_id": "4166701a-3cf4-37b5-aa63-caf5e4f7ba19",
                                "text": "„Es wird ein Generalstabsausschuß eingesetzt, um den Sicherheitsrat in allen Fragen zu beraten und zu unterstützen, die dessen militärische Bedürfnisse zur Wahrung des Weltfriedens und der internationalen Sicherheit, den Einsatz und die Führung der dem Sicherheitsrat zur Verfügung gestellten Streitkräfte, die Rüstungsregelung und eine etwaige Abrüstung betreffen.“"
                            },
                            {
                                "example_id": "4f86456e-5995-407a-b74b-2727893de3f6",
                                "sense_id": "4166701a-3cf4-37b5-aa63-caf5e4f7ba19",
                                "text": "„Die Zugehörigkeit der vollständigen nuklearen Abrüstung zur Rüstungsregelung ist nicht verbindlich bestimmt“"
                            },
                            {
                                "example_id": "230491b2-7418-4b83-8bd5-2800b47b7990",
                                "sense_id": "4166701a-3cf4-37b5-aa63-caf5e4f7ba19",
                                "text": "„Sie kann sich mithin auch mit Fragen der Wahrung des Weltfriedens und der internationalen Sicherheit sowie den Grundsätzen für die Abrüstung und Rüstungsregelungen befassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
