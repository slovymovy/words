                "senses": [
                    {
                        "sense_id": "d650e5c9-fdab-3a54-8a98-4da1fdbcc875",
                        "entry_id": "87126159-24b0-3b60-b2d3-3c8460dced43",
                        "glosses": [
                            "In a correct or proper way; conventionally; correctly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b364e5-4e4a-4dd9-874f-6bba8f10b18f",
                                "sense_id": "d650e5c9-fdab-3a54-8a98-4da1fdbcc875",
                                "text": "if, after a season of thoughtlessness, you perceive your understanding on a sudden lively to discern, and your will vigorous to pursue heavenly things, you may orthodoxly conclude there has been an effusion, not that there is one now."
                            },
                            {
                                "example_id": "efd54841-3383-4a89-b751-95e0ab1f644a",
                                "sense_id": "d650e5c9-fdab-3a54-8a98-4da1fdbcc875",
                                "text": "Biology is orthodoxly the part of science that deals directly with the phenomena of living matter."
                            },
                            {
                                "example_id": "598e4835-d860-43ba-a842-fa8d46533826",
                                "sense_id": "d650e5c9-fdab-3a54-8a98-4da1fdbcc875",
                                "text": "So great was Ariel’s success and that of the similar Disraeli that readers might have expected Maurois to treat Shelley's friend and fellow-poet in the same style. But no miniature in enamel is this orthodoxly lengthy, appendixed, annotated biography of Byron."
                            }
                        ]
                    },
                    {
                        "sense_id": "66723205-49a9-3ca6-ac70-2ca76d7c7cb8",
                        "entry_id": "87126159-24b0-3b60-b2d3-3c8460dced43",
                        "glosses": [
                            "In a religiously orthodox way; in accordance with accepted religious doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970fdad6-41cf-46ac-9b56-e684b812b0e6",
                                "sense_id": "66723205-49a9-3ca6-ac70-2ca76d7c7cb8",
                                "text": "He wears a turban, he puts on his sandal mark every morning, he bathes and eats and marries and dies orthodoxly; he probably begets children orthodoxly."
                            },
                            {
                                "example_id": "0f7a9208-5834-4eef-a608-9056f6d46d6d",
                                "sense_id": "66723205-49a9-3ca6-ac70-2ca76d7c7cb8",
                                "text": "The teaching here is orthodoxly Islamic, the preoccupation with assessing the relation of works to faith is very much of the European fifteenth century."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9d2d60e-d6e5-48ad-bfa4-e51c6ebc1615",
