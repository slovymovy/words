{
    "word_family": [
        "baggage",
        "baggy",
        "bagging",
        "handbag",
        "schoolbag",
        "sandbag",
        "beanbag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3102ed20-23fe-3eb3-8e33-592620494577",
                    "sense_definition": "A soft container made out of cloth, paper, thin plastic, etc. and open at the top, used to hold food, commodities, and other goods.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put the groceries into a large paper <w>bag</w>.",
                            "target_lang_translations": {
                                "ru": "Она сложила продукты в большой бумажный <w>пакет</w>."
                            }
                        },
                        {
                            "text": "Please put the trash in a plastic <w>bag</w> before taking it outside.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи мусор в пластиковый <w>пакет</w>, прежде чем выносить его."
                            }
                        }
                    ],
                    "synonyms": [
                        "sack"
                    ],
                    "common_phrases": [
                        "paper bag",
                        "plastic bag",
                        "shopping bag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий контейнер из ткани, бумаги, тонкого пластика и т. п., открытый сверху, используемый для хранения продуктов и других товаров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паке́т",
                                "target_lang_sense_clarification": "бумажный или пластиковый"
                            },
                            {
                                "target_lang_word": "мешо́к",
                                "target_lang_sense_clarification": "из ткани или бумаги"
                            },
                            {
                                "target_lang_word": "кулёк",
                                "target_lang_sense_clarification": "небольшой бумажный или пластиковый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7a3504b-d3e3-3387-a141-b32582049ce7",
                    "sense_definition": "A container made of leather, plastic, or other material, usually with a handle or handles, in which you carry personal items, or clothes or other things that you need for travelling.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He packed his <w>bag</w> and left for the airport early in the morning.",
                            "target_lang_translations": {
                                "ru": "Он собрал <w>сумку</w> и уехал в аэропорт рано утром."
                            }
                        },
                        {
                            "text": "I left my <w>bag</w> on the bus and had to call the station.",
                            "target_lang_translations": {
                                "ru": "Я оставил свою <w>сумку</w> в автобусе, и мне пришлось звонить на станцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "tote"
                    ],
                    "common_phrases": [
                        "travel bag",
                        "shoulder bag",
                        "pack a bag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер из кожи, пластика или другого материала, обычно с ручкой или ручками, в котором носят личные вещи, одежду или другие предметы для путешествий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "су́мка",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "чемода́н",
                                "target_lang_sense_clarification": "для путешествий"
                            },
                            {
                                "target_lang_word": "бага́ж",
                                "target_lang_sense_clarification": "собирательное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58d1e0be-3c69-3727-9689-77f8c8f2cc8f",
                    "sense_definition": "A dark circle or puffy area under the eye, often caused by lack of sleep.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had deep <w>bags</w> under his eyes after staying up all night studying.",
                            "target_lang_translations": {
                                "ru": "У него были глубокие <w>мешки</w> под глазами после того, как он всю ночь готовился к занятиям."
                            }
                        },
                        {
                            "text": "You look tired and have <w>bags</w> under your eyes today.",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь уставшим, и у тебя сегодня <w>мешки</w> под глазами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bags under eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный круг или припухлость под глазом, часто вызванные недостатком сна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешо́к",
                                "target_lang_sense_clarification": "под глазами"
                            },
                            {
                                "target_lang_word": "отёк",
                                "target_lang_sense_clarification": "припухлость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57532e94-e965-3f52-a510-b0fa5a658cd9",
                    "sense_definition": "One's particular interest, preference, or area of expertise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Classical music is not really my <w>bag</w> as I prefer jazz.",
                            "target_lang_translations": {
                                "ru": "Классическая музыка — это не совсем моя <w>тема</w>, я предпочитаю джаз."
                            }
                        },
                        {
                            "text": "Cooking was never her <w>bag</w> so she usually ordered takeout.",
                            "target_lang_translations": {
                                "ru": "Готовка никогда не была её <w>стихией</w>, поэтому она обычно заказывала еду на дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "thing",
                        "preference",
                        "cup of tea"
                    ],
                    "common_phrases": [
                        "not my bag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the negative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чей-то особый интерес, предпочтение или область знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "те́ма",
                                "target_lang_sense_clarification": "сленг, область интересов"
                            },
                            {
                                "target_lang_word": "стихи́я",
                                "target_lang_sense_clarification": "привычная область деятельности"
                            },
                            {
                                "target_lang_word": "конёк",
                                "target_lang_sense_clarification": "любимая тема или занятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26f996ac-666f-37f9-bf75-efbea6418e3c",
                    "sense_definition": "An insulting term for a woman, especially one who is considered ugly or unpleasant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbor was a grumpy old <w>bag</w> who always complained about the noise.",
                            "target_lang_translations": {
                                "ru": "Соседка была ворчливой старой <w>каргой</w>, которая вечно жаловалась на шум."
                            }
                        },
                        {
                            "text": "He was being rude and called the woman an ugly <w>bag</w>.",
                            "target_lang_translations": {
                                "ru": "Он вел себя грубо и назвал женщину страшилищем (букв. уродливой <w>кикиморой</w>)."
                            }
                        }
                    ],
                    "synonyms": [
                        "hag"
                    ],
                    "common_phrases": [
                        "old bag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительный термин для женщины, особенно той, которую считают некрасивой или неприятной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кики́мора",
                                "target_lang_sense_clarification": "неприятная женщина"
                            },
                            {
                                "target_lang_word": "уро́дина",
                                "target_lang_sense_clarification": "некрасивая женщина"
                            },
                            {
                                "target_lang_word": "ста́рая карга́",
                                "target_lang_sense_clarification": "о неприятной пожилой женщине"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf763d35-af4a-3e0b-b20f-ee1c0272fed0",
                    "sense_definition": "To put items into a bag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier will <w>bag</w> your groceries for you at the counter.",
                            "target_lang_translations": {
                                "ru": "Кассир <w>упакует</w> ваши продукты в пакеты прямо на кассе."
                            }
                        },
                        {
                            "text": "I need to <w>bag</w> these leaves before the garbage truck arrives.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>разложить</w> эти листья по мешкам до приезда мусоровоза."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bag the groceries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть вещи в сумку или пакет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упако́вывать",
                                "target_lang_sense_clarification": "в пакет или сумку"
                            },
                            {
                                "target_lang_word": "скла́дывать",
                                "target_lang_sense_clarification": "в сумку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b185643-c3bf-3a8c-9a30-cb7973b0493d",
                    "sense_definition": "To succeed in securing, winning, or claiming something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>bag</w> a great seat right at the front of the theater.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>отхватить</w> отличное место в самом первом ряду театра."
                            }
                        },
                        {
                            "text": "The company hopes to <w>bag</w> a major contract this year.",
                            "target_lang_translations": {
                                "ru": "Компания надеется <w>заполучить</w> крупный контракт в этом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "secure",
                        "gain"
                    ],
                    "common_phrases": [
                        "bag a bargain"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for winning or getting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно заполучить, выиграть или занять что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урва́ть",
                                "target_lang_sense_clarification": "разг., получить что-то выгодное"
                            },
                            {
                                "target_lang_word": "заполучи́ть",
                                "target_lang_sense_clarification": "добиться обладания"
                            },
                            {
                                "target_lang_word": "отхвати́ть",
                                "target_lang_sense_clarification": "разг., быстро получить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0f2ba5b-605f-38a5-9093-8521eb5a08ca",
                    "sense_definition": "To catch or kill an animal, especially while hunting or fishing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters managed to <w>bag</w> two deer during their trip.",
                            "target_lang_translations": {
                                "ru": "Охотникам удалось <w>добыть</w> двух оленей во время поездки."
                            }
                        },
                        {
                            "text": "He was proud to <w>bag</w> a trophy fish on his first day.",
                            "target_lang_translations": {
                                "ru": "Он гордился тем, что <w>поймал</w> трофейную рыбу в свой первый же день."
                            }
                        }
                    ],
                    "synonyms": [
                        "catch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать или убить животное, особенно во время охоты или рыбалки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстрели́ть",
                                "target_lang_sense_clarification": "на охоте"
                            },
                            {
                                "target_lang_word": "добы́ть",
                                "target_lang_sense_clarification": "трофей"
                            },
                            {
                                "target_lang_word": "завали́ть",
                                "target_lang_sense_clarification": "жарг., убить зверя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35da7c4a-8418-33ca-bce5-c364cda1e7b5",
                    "sense_definition": "To decide not to do something; to quit, ignore, or abandon a plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was raining so hard we decided to <w>bag</w> the hike and stay home.",
                            "target_lang_translations": {
                                "ru": "Шел такой сильный дождь, что мы решили <w>забить</w> на поход и остаться дома."
                            }
                        },
                        {
                            "text": "If the project gets too difficult, we might just <w>bag</w> it.",
                            "target_lang_translations": {
                                "ru": "Если проект станет слишком сложным, мы можем просто его <w>бросить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "ditch"
                    ],
                    "common_phrases": [
                        "bag it"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Решить не делать чего-либо; бросить, проигнорировать или отказаться от плана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заби́ть",
                                "target_lang_sense_clarification": "сленг, отказаться от дела"
                            },
                            {
                                "target_lang_word": "бро́сить",
                                "target_lang_sense_clarification": "прекратить занятие"
                            },
                            {
                                "target_lang_word": "похе́рить",
                                "target_lang_sense_clarification": "разг., испортить или отменить план"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}