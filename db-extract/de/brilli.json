                                "example_id": "8f3d0327-ef69-4279-b977-5ce16ff73e60",
                                "sense_id": "aa45caea-5e94-3497-abc1-4bbec2bc5a6f",
                                "text": "Er trägt einen Brilli im Ohr."
                            },
                            {
                                "example_id": "224f20f2-8dd5-4008-8266-a0d996ef5366",
                                "sense_id": "aa45caea-5e94-3497-abc1-4bbec2bc5a6f",
                                "text": "Zur Verlobung bekam sie einen Brilli."
                            },
                            {
                                "example_id": "d70240d9-7684-4227-9e13-b3cd38b618f1",
                                "sense_id": "aa45caea-5e94-3497-abc1-4bbec2bc5a6f",
                                "text": "Sie trägt jetzt einen Brilli im Bauchnabel."
                            },
                            {
                                "example_id": "48930e35-2db1-4934-bace-304a176fcbaa",
                                "sense_id": "aa45caea-5e94-3497-abc1-4bbec2bc5a6f",
                                "text": "Auf dem Empfang blitzen an den Händen der Damen unzählige Brillis."
                            },
