                "senses": [
                    {
                        "sense_id": "e6c92bbc-172a-3756-b67f-b61dad9403cc",
                        "entry_id": "2b35b21a-5021-331a-9330-996a51b0a252",
                        "glosses": [
                            "Strahlung im Mikrowellenbereich, die etwa 380.000 Jahre nach dem Urknall entstanden ist und das gesamte Universum erfüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77599394-055c-401e-be68-afc94c56d195",
                                "sense_id": "e6c92bbc-172a-3756-b67f-b61dad9403cc",
                                "text": "„Auf das Licht vom Beginn der Zeit waren Astrophysiker erstmals in den sechziger Jahren gestoßen. Mit Hilfe ihrer Radioteleskope entdeckten sie damals eine Hintergrundstrahlung im Mikrowellenbereich, die gleichmäßig aus allen Richtungen empfangen wurde.“"
                            },
                            {
                                "example_id": "ff4ee2f3-dab7-457f-b6af-68fcdbddc850",
                                "sense_id": "e6c92bbc-172a-3756-b67f-b61dad9403cc",
                                "text": "„Die heiße Wärmestrahlung von einst hat heute Frequenzen, die im Bereich der Mikrowellen liegen, und ihre Temperatur beträgt nur noch knapp drei Kelvin. Als Hintergrundstrahlung erfüllt sie gleichmäßig das gesamte Universum.“"
                            },
                            {
                                "example_id": "19da3bee-e6c7-446f-9099-47045a6bff86",
                                "sense_id": "e6c92bbc-172a-3756-b67f-b61dad9403cc",
                                "text": "„Erst als sich die ersten Wasserstoffatome bildeten und das Universum auf etwa 3000 Grad abkühlte, begann sich der Kosmos allmählich zu lichten und wurde durchsichtig. Die Photonen, die mit den entstehenden Atomen weniger stark wechselwirkten als mit den Elektronen, konnten sich fortan ungestört ausbreiten. Sie sind noch heute als Hintergrundstrahlung zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6929a3f7-6db3-45c2-823c-22337fc7149d",
