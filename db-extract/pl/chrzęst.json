                    },
                    {
                        "translation_id": "477de595-0e4e-44bf-8fd0-ccb050fec05b",
                        "source_entry_id": "aadd8883-9185-3b12-b347-6a2a50be8cf3",
                        "source_sense_id": "681a740b-cba5-33bd-b2fc-2e57e1f55cc0",
                        "target_lang_word": "хруст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хруст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db95ca33-cf46-399a-8cf7-57a7c07f8c95",
                                        "entry_id": "033a5e7d-95f8-3bef-91b9-c0fb36b77534",
                                        "glosses": [
                                            "сухой треск от чего-либо ломающегося, раздробляемого и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce55d9b-c28c-4593-8e35-81839b7b6613",
                                                "sense_id": "db95ca33-cf46-399a-8cf7-57a7c07f8c95",
                                                "text": "Пробовали они и на комиссию закупы разного товара делать, и тут оказались провинности: купит негоциант щетины да для коммерческого оборота в неё песочку подсыплет, а не то хлебца такого поставит, чтоб хрусту побольше ощущалось — отказали и тут."
                                            },
                                            {
                                                "example_id": "0d738f07-7106-45b4-a663-fd8db0552a03",
                                                "sense_id": "db95ca33-cf46-399a-8cf7-57a7c07f8c95",
                                                "text": "Сучья отчётливо трещали, по-видимому, под чьей-то лёгкой ногой, и этот хруст всё приближался."
                                            },
                                            {
                                                "example_id": "9409834f-a22e-46db-8781-9966f25d4535",
                                                "sense_id": "db95ca33-cf46-399a-8cf7-57a7c07f8c95",
                                                "text": "Воза шли теперь по плотине, под огромным сводом снежных ветел, и уже был слышен хруст снега, визжание полозьев и дыхание лошадей."
                                            },
                                            {
                                                "example_id": "2b1a66c8-b617-476c-98db-6e1055eeedce",
                                                "sense_id": "db95ca33-cf46-399a-8cf7-57a7c07f8c95",
                                                "text": "Ночь напролёт, закроют лишь, // Конца не слышно хрусту: // Как сыр, залезет в масло мышь, // А то нырнёт в капусту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01bc0cb4-b542-3be5-921a-0fe94ff4e857",
                                        "entry_id": "033a5e7d-95f8-3bef-91b9-c0fb36b77534",
                                        "glosses": [
                                            "крим. жарг. рублёвая купюра"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
