    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                "word": "underwrapped",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d65e4902-6b88-40f0-91c8-7a715ecc3692",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more underwrapped"
                    },
                    {
                        "form_id": "b4c1ef27-7b8a-4678-a7b1-27cc03cbabbc",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most underwrapped"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3936fab1-0079-3996-8209-d4548de1b116",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Insufficiently desolvated."
                        ],
                        "tags": [
                            "of a protein"
                        ],
                        "examples": [
                            {
                                "example_id": "986d8ce4-32b9-4051-83c6-ded20445cc6e",
                                "sense_id": "3936fab1-0079-3996-8209-d4548de1b116",
                                "text": "Although about 3% of the backbone hydrogen bonds in hemoglobin are underwrapped, nearly 50% of those of the cellular prion protein are underwrapped."
                            },
                            {
                                "example_id": "e06baac4-367b-42c3-bef7-0b7f1025a9d0",
                                "sense_id": "3936fab1-0079-3996-8209-d4548de1b116",
                                "text": "Intramolecular hydrogen bonds that are accessible to water are called dehydrons and constitute structural vulnerabilities. Therefore, the more underwrapped proteins are, the more reliant on their interactive context they are in order to maintain structural integrity."
                            },
                            {
                                "example_id": "bc6e3f1e-61bb-4b28-9d3d-d92c1f87cfbe",
                                "sense_id": "3936fab1-0079-3996-8209-d4548de1b116",
                                "text": "Highly underwrapped proteins are structurally unstable because the backbone hydrogen bonds that determine the structural integrity of the protein may be dissolved through solvent hydration of the polar groups."
                            }
                        ]
                    },
                    {
                        "sense_id": "893f6c74-5c58-3392-9e06-049861a3548c",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Wrapped such that the wrapping does not go all the way to the edge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5986408-6c5b-4239-a0da-cd338dcf9a75",
                                "sense_id": "893f6c74-5c58-3392-9e06-049861a3548c",
                                "text": "The tape is slightly underwrapped over the head surface to generate hydrodynamic lift during read-write operations."
                            },
                            {
                                "example_id": "b202945b-657b-4c8d-91d9-ccaf5962f845",
                                "sense_id": "893f6c74-5c58-3392-9e06-049861a3548c",
                                "text": "In fact, the tape should be slightly underwrapped roughly by half a degree or less to minimize edge contact."
                            },
                            {
                                "example_id": "679cf8dd-1991-457e-8739-400a0611e9f5",
                                "sense_id": "893f6c74-5c58-3392-9e06-049861a3548c",
                                "text": "The tape is slightly underwrapped over the head surface to generate hydrodynamic lift during readwrite operations."
                            }
                        ]
                    },
                    {
                        "sense_id": "b91715ad-de54-3032-84d1-3339d81ca75c",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Having an underwrap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d1fc10-cc39-4f1d-93ee-02eacb311400",
                                "sense_id": "b91715ad-de54-3032-84d1-3339d81ca75c",
                                "text": "All Mariner rods have large underwrapped aluminum-oxide guides, cushioned foam grips and graphite reel seats with stainlesssteel hoods."
                            },
                            {
                                "example_id": "957eaa10-d146-427e-97c9-dd0bf04af07e",
                                "sense_id": "b91715ad-de54-3032-84d1-3339d81ca75c",
                                "text": "All Power Graph models feature fully underwrapped guides and a multi-coat, deep epoxy finish for years of beauty and maintenance-free performance."
                            },
                            {
                                "example_id": "cc7630f9-f674-4fbc-949a-5d4348fb675d",
                                "sense_id": "b91715ad-de54-3032-84d1-3339d81ca75c",
                                "text": "If you like the appearance of an underwrapped guide but do not want the bulk or the stiffening effect on a light rod, let me suggest what I call “false underwraps.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f51567d5-cce1-3d34-a384-a2063bf4da86",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Having an inner wrapping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d50e12-2280-4bfc-9617-256dfbdb3164",
                                "sense_id": "f51567d5-cce1-3d34-a384-a2063bf4da86",
                                "text": "The method requires the hook shank to be underwrapped and, ideally, the wire should be so malleable that it turns about the shank tightly and easily, using the dressing technique that leaves two inches of the starting end of the tying wire protruding to the rear when first binding the hook shank."
                            },
                            {
                                "example_id": "12c06870-0fd5-4d44-bd60-4c0cafbe07c4",
                                "sense_id": "f51567d5-cce1-3d34-a384-a2063bf4da86",
                                "text": "When the weather is hot and the fish are deep, you can fish the deeper water along a dam by using one or more weighted sinking flies (underwrapped with lead wire)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6678eb36-9112-3789-9f6d-08dad82a2e6c",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Having an end that protrudes underneath."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94843b39-9a2f-4ec7-a8de-7a250d93f637",
                                "sense_id": "6678eb36-9112-3789-9f6d-08dad82a2e6c",
                                "text": "Floor joints are underwrapped at the point of entry into the brickwork to afford complete protection."
                            },
                            {
                                "example_id": "4edfe244-85b7-45ad-bcba-f1cfa25c48ad",
                                "sense_id": "6678eb36-9112-3789-9f6d-08dad82a2e6c",
                                "text": "Here, however, individual joist ends are underwrapped."
                            },
                            {
                                "example_id": "17478c1a-110f-428f-9bbf-927e0ed99854",
                                "sense_id": "6678eb36-9112-3789-9f6d-08dad82a2e6c",
                                "text": "The placement of the drag drum in front of the hoist drum or vice versa and whether the ropes are overwrapped or underwrapped on the drums varies between manufacturers and/or machine models."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c2db62f-a436-3256-a675-c4bdb493332b",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Having insufficient clothes or blankets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96015368-5552-4a3c-b847-7ff3940567e7",
                                "sense_id": "2c2db62f-a436-3256-a675-c4bdb493332b",
                                "text": "Make sure the baby's not overwrapped and hot. When in doubt, babies should be underwrapped rather than overwrapped."
                            },
                            {
                                "example_id": "97a964d1-b726-4342-970c-96a84794f9eb",
                                "sense_id": "2c2db62f-a436-3256-a675-c4bdb493332b",
                                "text": "Make sure your child is clothed appropriately for the room temperature and is neither overdressed nor underwrapped."
                            },
                            {
                                "example_id": "f6e1f3fc-3d5c-49d2-836f-48c17b35f89b",
                                "sense_id": "2c2db62f-a436-3256-a675-c4bdb493332b",
                                "text": "As a result, your toddler might fall on her face, your infant might eat dirty sand, and your overwrapped or underwrapped newborn might wail unnoticed in the stroller."
                            }
                        ]
                    },
                    {
                        "sense_id": "109b9a59-17a7-3352-888c-664c5ffd8c67",
                        "entry_id": "80337d0e-c2b5-3bc5-9418-0b6b8b9bbfff",
                        "glosses": [
                            "Secret; under wraps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0ff182-853e-41b8-ae60-143a1748ab68",
                                "sense_id": "109b9a59-17a7-3352-888c-664c5ffd8c67",
                                "text": "I suspected as well that so long as it did, I would go no further than I already had; it was something the family kept tight, and underwrapped, like the crazy uncle locked in the attic room—though whatever it was, was considerably more useful than that."
                            }
                        ]
                    }
