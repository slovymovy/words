                        "examples": [
                            {
                                "example_id": "de6cbf28-adf2-4ccb-a8e7-5acbf1ef5fd7",
                                "sense_id": "b2d4cb01-d215-346a-9c30-8273eea376fd",
                                "text": "A person is \"peltered\" when he is subjected to a shower of stones, a shower of hail-stones, or a shower of anything. \"Naay, gi'e ower peltering — one at a time! that's enew.\""
                            },
                            {
                                "example_id": "2f39c2d3-b790-4c2e-9f7b-8df8c3c07533",
                                "sense_id": "b2d4cb01-d215-346a-9c30-8273eea376fd",
                                "text": "Suddenly Iliin's machine-gun started rattling, peltering the columns, and a second machine-gun followed suit, whilst the Cossacks opened a continuous fire from all sides, seconded by the third, fith and second squadrons."
                            },
                            {
                                "example_id": "6d956ff2-d46b-4976-ac00-ed93f2ee59dd",
                                "sense_id": "b2d4cb01-d215-346a-9c30-8273eea376fd",
                                "text": "Chips as big as dinner plates were flying across the lawn and peltering the house like a gang of boys stoning telephone insulators."
                            }
                        ]
                    }
