                {
                    "sense_id": "744d39de-c3a6-3d70-9a15-464114c3852e",
                    "sense_definition": "The contents of the present document or legal writing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Know all men by these <w>presents</w> that the contract is valid.",
                            "target_lang_translations": {
                                "ru": "Да будет известно всем через <w>настоящий документ</w>, что контракт действителен.",
                                "zh": "特此立<w>本文件</w>为据，证明该合同有效。"
                            }
                        },
                        {
                            "text": "The ownership is transferred by these <w>presents</w> to the new holder.",
                            "target_lang_translations": {
                                "ru": "Право собственности передается посредством <w>настоящего документа</w> новому владельцу.",
                                "zh": "所有权通过<w>本文件</w>转让给新的所有人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "by these presents"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "legal formula"
                        }
                    ],
                    "target_lang_definitions": {
