                                "target_senses": [
                                    {
                                        "sense_id": "882ae93f-83b1-3389-83bb-525b1bbde075",
                                        "entry_id": "bb628801-9455-39d1-88a6-9fd6e5db253d",
                                        "glosses": [
                                            "вводить кого-либо в заблуждение, говорить неправду, поступать нечестно, мошенничать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146a5380-86f4-4ea2-9288-dad89f4278eb",
                                                "sense_id": "882ae93f-83b1-3389-83bb-525b1bbde075",
                                                "text": "Жил-был газетчик и жил-был читатель. Газетчик был обманщик — всё обманывал, а читатель был легковерный — всему верил. ❬…❭ Что больше обманывает газетчик, то больше богатеет (а обманщику чего же другого и нужно!); а читатель, что больше его обманывают, то больше пятаков газетчику несёт."
                                            },
                                            {
                                                "example_id": "4ff7d69f-cab3-488f-9230-8a24bf303b13",
                                                "sense_id": "882ae93f-83b1-3389-83bb-525b1bbde075",
                                                "text": "При жизни Голубева не было в России такого правительства, которое не обманывало бы его, выполняло бы свои обещания: Николай II, Львов, Керенский, Ленин, Сталин, Хрущёв, Брежнев, Андропов, Горбачёв."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0836b52-e5a1-375c-9efc-5a1d508fada6",
                                        "entry_id": "bb628801-9455-39d1-88a6-9fd6e5db253d",
                                        "glosses": [
                                            "нарушать обещание, клятву, долг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cff34e2-09db-4401-9a26-cccb47b6e52e",
                                                "sense_id": "f0836b52-e5a1-375c-9efc-5a1d508fada6",
                                                "text": "Нельзя обманывать доверие друзей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
