                "senses": [
                    {
                        "sense_id": "88daba47-14a2-3739-9452-f8e7f02d1a41",
                        "entry_id": "3fbfc371-6c77-3154-99ab-effb6de4c53b",
                        "glosses": [
                            "die Verteilung von Landfläche nach bestimmten Kriterien an neue Grundeigentümer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eccf74bc-9121-460d-8676-8895008184bc",
                                "sense_id": "88daba47-14a2-3739-9452-f8e7f02d1a41",
                                "text": "„Dorfbehörden wollen aber häufig nicht die Zuständigkeit für die Landzuteilung an die Zentralregierung abgeben und verlängern Verträge nur kurzfristig.“"
                            },
                            {
                                "example_id": "e251751f-44a5-45d2-8eaf-4a98f5febc0f",
                                "sense_id": "88daba47-14a2-3739-9452-f8e7f02d1a41",
                                "text": "„Staatliche Unternehmen haben leichteren Zugang zu zinsgünstigen Krediten der staatlich geführten Finanzinstitutionen und werden oft bei der Landzuteilung begünstigt.“"
                            },
                            {
                                "example_id": "6a8934a9-f55d-45e1-9044-260eac81a149",
                                "sense_id": "88daba47-14a2-3739-9452-f8e7f02d1a41",
                                "text": "„Das vom Delhi-Sultanat übernommene System der Landzuteilung (iqta) fügte er in eine neue Rangordnung ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b7b09d50-386f-346c-a73b-ef8e67f23561",
                        "entry_id": "3fbfc371-6c77-3154-99ab-effb6de4c53b",
                        "glosses": [
                            "der so zugeteilte Grund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c0b966-dbf9-4c6b-a465-79ac4e019610",
                                "sense_id": "b7b09d50-386f-346c-a73b-ef8e67f23561",
                                "text": "„Siedler erhielten große Landzuteilungen und bekamen staatliche Hilfeleistungen und Steuerfreiheit.“"
                            },
                            {
                                "example_id": "ca8ae936-ba00-43ae-9752-6fc2c088a4d0",
                                "sense_id": "b7b09d50-386f-346c-a73b-ef8e67f23561",
                                "text": "„Für den Bau der Anlagen erhalten Investoren vom Staat kostenlose Landzuteilungen und Stromabnahmegarantien zu einem vertraglich vereinbarten Festpreis.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
