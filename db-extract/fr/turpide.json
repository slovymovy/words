                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0c2598d9-566f-43fb-8c37-d3ebaad472fa",
                        "entry_id": "e9f3fa96-a74c-317c-9618-a11e086e7e6b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "turpides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                        "entry_id": "e9f3fa96-a74c-317c-9618-a11e086e7e6b",
                        "glosses": [
                            "Laid pour ce qui est de la morale, méprisable, écœurant, fangeux, hideux, honteux, ignoble, infâme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6faefa0b-52e5-4b41-b97b-8015701ce6e2",
                                "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                                "text": "Les prêtres ont toujours croupi dans une ignorance turpide."
                            },
                            {
                                "example_id": "ce576354-12a8-4d56-bf41-bf84286313c7",
                                "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                                "text": "Il s’affala, désespéré, sur une chaise […] assailli par des rappels turpides, dégoûté de lui-même."
                            },
                            {
                                "example_id": "acc58fd3-7c78-4c85-a079-1de75f74bd57",
                                "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                                "text": "Plus avides, les mâles fourragent les baisers sur les lèvres qui passent, et, presque sans choisir, errent de femme en femme, sans jamais assouvir leur turpide désir."
                            },
                            {
                                "example_id": "9ce25d88-9a1e-4dea-9af5-d269a6855eca",
                                "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                                "text": "Mais je me demande si les hommes ont jamais connu cette contagion de l'ennui, cette lèpre ? Un désespoir avorté, une forme turpide du désespoir, qui est sans doute comme la fermentation d'un christianisme décomposé."
                            },
                            {
                                "example_id": "dd4e532b-ff19-46a8-a415-ecf4d3e4bd50",
                                "sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                                "text": "On se casse la gueule à tout instant, on replonge dans la merde, la connerie, les appétits les plus louches, les jouissances les plus veules, les veuleries les plus turpides, les turpitudes les plus basses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8476e533-ec46-4ce9-9ccb-5016dce11ce8",
                        "source_entry_id": "e9f3fa96-a74c-317c-9618-a11e086e7e6b",
                        "source_sense_id": "1fabb497-2d3c-3535-8f64-2d18f4a55668",
                        "target_lang_word": "turpid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turpid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a9548e-caab-317a-bcf6-8664cb471c3c",
                                        "entry_id": "e5ea19f6-cbc7-3141-8e78-0b9a3bf36c75",
                                        "glosses": [
                                            "Foul; base; wicked; morally depraved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4657ffb0-5948-4ccc-ac27-9b55343b9dc4",
                                                "sense_id": "38a9548e-caab-317a-bcf6-8664cb471c3c",
                                                "text": "[...] things absurd in themselves, and completely opposed, moreover, to all physical laws, which prove to us, by the way, that priests have always wallowed in turpid ignorance, in which they would fain engulf the people with them."
                                            },
                                            {
                                                "example_id": "9a655c81-8907-4a56-b9b2-27fb2370faa5",
                                                "sense_id": "38a9548e-caab-317a-bcf6-8664cb471c3c",
                                                "text": "I loved you. I was a pentapod monster, but I loved you. I was despicable and brutal, and turpid, and everything, mais je t'aimais, je t'aimais!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
