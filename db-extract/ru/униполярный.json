                                        "glosses": [
                                            "Not both depressive and manic; not bipolar."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495ddd70-2f2d-4b18-8c79-13267ca182a3",
                                                "sense_id": "34301517-470a-3bde-9c6b-70b9d9256b79",
                                                "text": "Most studies have tended to find somewhat higher suicide rates in unipolar depression than in bipolar disorder"
                                            }
                                        ]
                                    },
