    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ee584f6-2429-33ef-be9e-77e378fbcd9b",
                    "sense_definition": "Nombre de fois qu'un événement se produit dans une période donnée ou caractère de ce qui se répète souvent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a conseillé de réduire la <w>fréquence</w> de mes entraînements sportifs pour éviter les blessures."
                        },
                        {
                            "text": "La <w>fréquence</w> des bus diminue fortement en soirée et pendant les week-ends."
                        }
                    ],
                    "synonyms": [
                        "périodicité",
                        "régularité"
                    ],
                    "antonyms": [
                        "infréquence"
                    ],
                    "common_phrases": [
                        "avec fréquence",
                        "augmenter la fréquence",
                        "diminuer la fréquence"
                    ]
                },
                {
                    "sense_id": "d19c6ac8-2e83-3778-8861-4f97b4d52959",
                    "sense_definition": "Rythme ou nombre de battements ou de cycles par minute, en parlant du cœur ou de la respiration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>fréquence</w> cardiaque a augmenté rapidement dès qu'il a commencé à courir en montée."
                        },
                        {
                            "text": "L'infirmière contrôle régulièrement la <w>fréquence</w> respiratoire du patient après l'opération."
                        }
                    ],
                    "synonyms": [
                        "rythme"
                    ],
                    "common_phrases": [
                        "fréquence cardiaque",
                        "fréquence respiratoire"
                    ]
                },
                {
                    "sense_id": "9a526c97-daf3-3f3a-8531-cffe11c5344d",
                    "sense_definition": "Gamme ou canal d'ondes électromagnétiques utilisé pour la diffusion et les télécommunications.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "telecom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons trouver la bonne <w>fréquence</w> pour écouter le match à la radio dans la voiture."
                        },
                        {
                            "text": "Le pilote a changé de <w>fréquence</w> afin de contacter la tour de contrôle."
                        }
                    ],
                    "synonyms": [
                        "canal"
                    ],
                    "common_phrases": [
                        "changer de fréquence",
                        "fréquence radio"
                    ]
                },
                {
                    "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                    "sense_definition": "Nombre d'oscillations ou de cycles complets d'un phénomène périodique par unité de temps, généralement exprimé en hertz.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'oreille humaine ne perçoit pas les sons émis à une <w>fréquence</w> trop basse."
                        },
                        {
                            "text": "Ces appareils utilisent des ultrasons d'une <w>fréquence</w> très élevée pour nettoyer les pièces mécaniques."
                        }
                    ],
                    "common_phrases": [
                        "haute fréquence",
                        "basse fréquence"
                    ]
                },
                {
                    "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                    "sense_definition": "Rapport entre le nombre de fois où un phénomène se produit et le nombre total d'observations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étude montre une <w>fréquence</w> accrue de cette maladie chez les personnes âgées."
                        },
                        {
                            "text": "Les chercheurs analysent la <w>fréquence</w> des mutations génétiques dans cette population isolée."
                        }
                    ],
                    "synonyms": [
                        "proportion",
                        "taux"
                    ],
                    "common_phrases": [
                        "fréquence d'apparition"
                    ]
                }
            ]
        }
    ]
