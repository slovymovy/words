                        "glosses": [
                            "Pratique du vélo en tant que loisir, moyen de locomotion pour promenades et voyages, sans esprit de compétition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e408714-3190-4bb9-af32-850eed7d4556",
                                "sense_id": "24ea7a08-08ba-3b8c-b73f-6635a63c7b28",
                                "text": "L’alpinisme et le cyclotourisme sont appréciés pour le contact avec la nature et l’air pur qu’ils impliquent, pour le bien-être et l’exercice qu’ils proposent au corps, pour l’effort qu’ils demandent, et enfin pour l’affrontement avec l’obstacle et la joie de vaincre la difficulté qu’ils fournissent."
                            }
                        ]
