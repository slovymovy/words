                    }
                ],
                "senses": [
                    {
                        "sense_id": "f773b21a-a323-3777-81c4-731f5ae56010",
                        "entry_id": "c6e80d1b-6f94-363a-89ae-495a64a7e834",
                        "glosses": [
                            "пластмассовый диск с записью звучащей речи, музыки, воспроизводимой с помощью специальных аппаратов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a48dd8fe-ff36-47a8-bcdb-6c965a399939",
                        "source_entry_id": "c6e80d1b-6f94-363a-89ae-495a64a7e834",
                        "source_sense_id": "f773b21a-a323-3777-81c4-731f5ae56010",
                        "target_lang_word": "disque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53c545ef-ba31-3a92-8217-c9f4b70bb5a5",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Palet circulaire utilisé pour le lancer du disque."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee6b914-b49e-477e-9e09-9d660065a95a",
                                                "sense_id": "53c545ef-ba31-3a92-8217-c9f4b70bb5a5",
                                                "text": "Le lancer du disque s’exécute grâce à un élan en « tourbillon »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e9d516-5ee0-3597-adf5-02c40db15177",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Disque intervertébral. Cartilage entre deux vertèbres."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae99d023-9b2d-46ae-8f9b-29d001e70eb8",
                                                "sense_id": "33e9d516-5ee0-3597-adf5-02c40db15177",
                                                "text": "Les discopathies peuvent toucher un ou plusieurs disques. Le disque le plus sujet à cette dégénérescence est le disque situé à la jonction lombo-sacrée entre les vertèbres L5 et S1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfc2d28-a25f-31da-995a-185a8b1756f5",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Surface délimitée par un cercle."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa6333d2-bf59-4959-bf8b-48d43017c1b8",
                                                "sense_id": "abfc2d28-a25f-31da-995a-185a8b1756f5",
                                                "text": "Il me fait d’abord un cours de géographie, et j’apprends que la terre est un disque dont l’Arabie occupe le centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9956439-7cbe-3199-8482-d7100427619c",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Surface visible des grands astres, qui, à nos yeux, paraissent ronds et plats."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2f6da5-40b4-4330-b16c-00aad42d6d36",
                                                "sense_id": "d9956439-7cbe-3199-8482-d7100427619c",
                                                "text": "Le nuage était en plein sur le disque. Je ne pouvais faire un pas sans risquer de me précipiter dans l’abîme."
                                            },
                                            {
                                                "example_id": "77248ff9-0e82-441a-93a4-66713547cd3e",
                                                "sense_id": "d9956439-7cbe-3199-8482-d7100427619c",
                                                "text": "Quelques étoiles à présent perçaient la voûte bleue, et dans l’est le disque de la lune apparut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a6c205-acde-387a-9239-7488d2969f3a",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Partie des fleurs radiées qui en occupe le centre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ce7e8e-15d4-42e7-9f81-e8dc2200fdc7",
                                                "sense_id": "d7a6c205-acde-387a-9239-7488d2969f3a",
                                                "text": "La pollinisation est le plus souvent entomophile [chez les Astérides]. Mais le disque nectarifère ─ manque chez le genre Plantago où la pollinisation est anémophile, et le genre Callitriche chez lequel la pollinisation est hydrophile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e04292b0-e79f-3f02-969a-c8ce73ed3283",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Partie élargie et membraneuse d’une feuille."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69bfb533-1682-4b85-807f-f609add0158c",
                                                "sense_id": "e04292b0-e79f-3f02-969a-c8ce73ed3283",
                                                "text": "La feuille présente deux parties ordinairement distinctes, le pétiole et le disque."
                                            },
                                            {
                                                "example_id": "2d64dd28-672c-456d-9173-d38f933d8824",
                                                "sense_id": "e04292b0-e79f-3f02-969a-c8ce73ed3283",
                                                "text": "Les ramifications du pétiole sur le disque de la feuille portent le nom de nervure."
                                            },
                                            {
                                                "example_id": "7e37de10-d873-47d5-9165-9b7c0a7052bb",
                                                "sense_id": "e04292b0-e79f-3f02-969a-c8ce73ed3283",
                                                "text": "En dépit donc de leur système sensoriel primitif, les chenilles sont capables de s’orienter par l’addition de sucres, ou sur la consommation de disques foliaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f3e08f1-4483-3acf-a3b6-c200807b0578",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Signal commandant une marche à vue suivie d’un arrêt avant le premier appareil de voie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "616d1c65-05c3-4ac9-8e28-b3761f289f16",
                                                "sense_id": "9f3e08f1-4483-3acf-a3b6-c200807b0578",
                                                "text": "En signalisation lumineuse, le disque est présenté sous forme d'un feu jaune et d'un feu rouge, alignés verticalement ou horizontalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ba3aab-09cf-3371-8674-6fe25aa28d20",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Pièce sur laquelle se fait, par frottement, la déperdition de chaleur liée au freinage."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c390ac-758f-4427-85e6-44859f4effe6",
                                                "sense_id": "a7ba3aab-09cf-3371-8674-6fe25aa28d20",
                                                "text": "Frein à disque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09313fff-e367-3f37-b2d0-03d3e603c551",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Pièce rotative, et coupante ou abrasive, utilisée sur une meuleuse, un disque abrasif, un disque à tronçonner, un disque diamant"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Support d’enregistrement musical de la forme d’un très mince cylindre."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11950934-b0ba-42a2-a967-9f7271204a05",
                                                "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                                "text": "Je leur fis voir des photographies de ma croisière, mes trophées de tennis et jouai en leur honneur sur le gramophone quelque disques de Granados."
                                            },
                                            {
                                                "example_id": "46e8c8c1-bff7-4de6-8196-0b1af629c54d",
                                                "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                                "text": "Depuis l’Argonne de 1914, le chant d’abeilles des balles s’est inscrit dans mes circonvolutions cérébrales comme, dans la cire d’un disque, un refrain prêt à jouer dès le premier tour de manivelle."
                                            },
                                            {
                                                "example_id": "2ad66234-93ca-488f-8bdb-e2d0062c6b8f",
                                                "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                                "text": "Pendant ce temps, nous roulons les tapis sous les pattes des fauteuils et Marie, sans vergogne, passe au peigne fin la réserve de disques de Monsieur l’Ambassadeur et endosse le rôle de DJ."
                                            },
                                            {
                                                "example_id": "01ba2f80-5128-409d-ab15-9adcf1e7bc5d",
                                                "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                                "text": "On les savait très drôles et ultraconvaincants sur scène, on a également découvert les Français de Naïve New Beaters brillants songwriters, maîtres dans l’art de composer des tubes — Wallace est un disque bluffant et fourmillant d’influences, entre groove pop et phrasé hip-hop."
                                            },
                                            {
                                                "example_id": "3357759e-c96f-4178-b691-a7eb08add81e",
                                                "sense_id": "ede5d831-aa7a-3ca3-995d-a4f73ec1c0da",
                                                "text": "Aux séances d’enregistrement on gravait directement sur la cire des disques mais on ne pouvait pas entendre le résultat immédiatement car ces gravures devenait des matrices qui servaient à la fabrication des exemplaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47658f7-0aa5-3158-8875-b895655169e4",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Cultivateur-tasseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059ac919-8832-4d5c-8679-63df1b261971",
                                                "sense_id": "d47658f7-0aa5-3158-8875-b895655169e4",
                                                "text": "Aujourd'hui, je suis en train de passer le disque pour détruire les mauvaises herbes , semées, il faut le dire, par la moissonneuse-batteuse."
                                            },
                                            {
                                                "example_id": "893dc2de-4340-4c36-880c-9d807e2d8d97",
                                                "sense_id": "d47658f7-0aa5-3158-8875-b895655169e4",
                                                "text": "Tiens, Laborde est en retard pour son maïs, Justin a oublié de tailler ses haies ; à Lahargue, le métayer ferait bien de passer le disque dans la vigne, l'herbe monte à l'assaut des ceps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4644531c-c2f8-34d9-a80e-6e17f5be6bf0",
                                        "entry_id": "dc592dce-ed67-3919-b2e2-d3ee82ace24d",
                                        "glosses": [
                                            "Situation ou propos qui se répète de façon lassante ; rengaine."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccf769f-3d6d-4f17-9d52-6051b382199a",
                                                "sense_id": "4644531c-c2f8-34d9-a80e-6e17f5be6bf0",
                                                "text": "Change de disque !"
                                            },
                                            {
                                                "example_id": "5db3e56a-7fa2-4705-b698-126a2add37d2",
                                                "sense_id": "4644531c-c2f8-34d9-a80e-6e17f5be6bf0",
                                                "text": "— Bon. Tout ça, c’est un très vieux disque, je l’ai joué pour Clotilde, ma pauvre femme qu’est à Bagneux au frais, la veine qu’elle a par un mois d’août pareil."
                                            }
                                        ]
                                    }
                                ]
