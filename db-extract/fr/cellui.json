                "senses": [
                    {
                        "sense_id": "43edbb11-4d1e-31c8-84c1-53e433fb81ae",
                        "entry_id": "bf495a80-7ce9-3d9a-938e-3dcf2b15d729",
                        "glosses": [
                            "Utilisé pour remplacer la personne au genre indéterminé dont on parle"
                        ],
                        "tags": [],
                        "note": "Il est toujours suivi par une proposition relative ou par un syntagme prépositionnel",
                        "examples": [
                            {
                                "example_id": "2bb98fcb-45dd-4a1d-85c8-f23451224928",
                                "sense_id": "43edbb11-4d1e-31c8-84c1-53e433fb81ae",
                                "text": "Alors que top c’est lea dominant.e, cellui qui a confiance en ellui"
                            },
                            {
                                "example_id": "898ded5b-6e1f-4e82-aa9a-3327138e0557",
                                "sense_id": "43edbb11-4d1e-31c8-84c1-53e433fb81ae",
                                "text": "À gagner, toute notre considération et un p'tit mot de remerciement pour cellui qui en aura trouvé le plus !"
                            },
                            {
                                "example_id": "7d9b9579-777e-419c-81d7-00c57136e739",
                                "sense_id": "43edbb11-4d1e-31c8-84c1-53e433fb81ae",
                                "text": "L’expertise s’organise selon un principe tautologique : est expert·e cellui qui est reconnu·e comme tel·le parce qu’iel fait preuve d’expertise, laquelle est reconnue parce que cellui qui parle… est un·e expert·e.."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8762004-caf8-3df1-b4f9-dc3ac9a5401d",
                        "entry_id": "bf495a80-7ce9-3d9a-938e-3dcf2b15d729",
                        "glosses": [
                            "Utilisé pour remplacer la personne non-binaire dont on parle"
                        ],
                        "tags": [],
                        "note": "Il est toujours suivi par une proposition relative ou par un syntagme prépositionnel",
                        "examples": [
                            {
                                "example_id": "b09be1c4-8a14-49d5-bd76-f4a3a6e261ea",
                                "sense_id": "f8762004-caf8-3df1-b4f9-dc3ac9a5401d",
                                "text": "Est-ce que celle/celui/cellui à qui j'ai brièvement parlé hier va bien ? Iel avait l'air être désorienté, j'ai pas bien su quoi lui dire"
                            },
                            {
                                "example_id": "fd3d553c-bb96-487e-abcd-6cde4032f7d6",
                                "sense_id": "f8762004-caf8-3df1-b4f9-dc3ac9a5401d",
                                "text": "Cellui-ci écarta les bras, s’éleva dans les airs de quelques centimètre et pivota sur ellui-même pour s’installer correctement sur le canapé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75f2834d-091c-4a6e-a17f-24da65f600c1",
                        "source_entry_id": "bf495a80-7ce9-3d9a-938e-3dcf2b15d729",
                        "target_lang_word": "the one",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "the one",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                        "entry_id": "050d8a18-d615-3dcc-a74c-2924124088c3",
                                        "glosses": [
                                            "A particularly special or compatible person or thing."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7915fed1-226a-4589-8bf9-5224419e116e",
                                                "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                                "text": "I knew as soon I met him that John was the one for me and we were married within a month."
                                            },
                                            {
                                                "example_id": "0ab6d6b3-ca62-41f8-83d5-ee04eddd77f0",
                                                "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                                "text": "That car's the one — I'll buy it."
                                            },
                                            {
                                                "example_id": "b88b41a8-fc94-4d25-8b9f-df06ec586bb6",
                                                "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                                "text": "I, I got a new life / You would hardly recognize me, I'm so glad / How could a person like me care for you / Why do I bother / When you're not the one for me / Oo-oo-oo-oo-ooh, is enough, enough"
                                            },
                                            {
                                                "example_id": "c926085b-45e5-48f8-9686-ea0a16a230d7",
                                                "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                                "text": "When you love a woman then tell her / That she's really wanted / When you love a woman then tell her that she's the one / 'Cause she needs somebody to tell her / That it's gonna last forever"
                                            },
                                            {
                                                "example_id": "e43389f5-63a6-4473-8d5b-616e26c60d13",
                                                "sense_id": "e3124eb9-903b-3523-a1cf-7b843511c8c7",
                                                "text": "Got a girl with California eyes / And I thought that she could really be the one this time / But I never got the chance to make her mine / Because she fell in love with little thin white lines"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8168c4a-18af-312d-a463-62ce84cc709e",
                                        "entry_id": "050d8a18-d615-3dcc-a74c-2924124088c3",
                                        "glosses": [
                                            "A particularly special or compatible person or thing.",
                                            "A particular person destined to save the universe or world; the chosen one."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e545d399-d16a-43e4-920b-22deb9f26a94",
                                                "sense_id": "a8168c4a-18af-312d-a463-62ce84cc709e",
                                                "text": "Jesus Christ is the One, the savior."
                                            },
                                            {
                                                "example_id": "b9655056-1dbc-4a0c-9b53-58f241dacb50",
                                                "sense_id": "a8168c4a-18af-312d-a463-62ce84cc709e",
                                                "text": "He (Neo) is the One."
                                            },
                                            {
                                                "example_id": "cdf8c852-bd8f-45a2-a4b5-b1f588f662c7",
                                                "sense_id": "a8168c4a-18af-312d-a463-62ce84cc709e",
                                                "text": "They, like me, believe him (Anakin Skywalker) to be The One."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "the one",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72825a9-aa08-3f2f-989c-f6c4532211f7",
                                        "entry_id": "e61583b0-dd6e-3e93-a249-122fd9b68dc4",
                                        "glosses": [
                                            "The person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceea9222-ded2-46c6-a74c-06470b940db5",
                                                "sense_id": "f72825a9-aa08-3f2f-989c-f6c4532211f7",
                                                "text": "Here is the one I want to buy."
                                            },
                                            {
                                                "example_id": "39d3ccc2-ae19-49c2-8bf8-1a2db2504817",
                                                "sense_id": "f72825a9-aa08-3f2f-989c-f6c4532211f7",
                                                "text": "In formal contexts, we can use 'that' and 'those' as substitutes meaning ‘the one(s)’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
