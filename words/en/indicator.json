{
    "word_family": [
        "indicate",
        "indication",
        "indicative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                    "sense_definition": "A sign, pointer, or index that shows the condition, existence, or direction of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sign_or_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A high fever is often an <w>indicator</w> of a serious infection.",
                            "target_lang_translations": {
                                "ru": "Высокая температура часто является <w>признаком</w> серьезной инфекции.",
                                "zh": "高烧往往是严重感染的一个<w>指标</w>。"
                            }
                        },
                        {
                            "text": "The test results serve as a reliable <w>indicator</w> of the student's progress.",
                            "target_lang_translations": {
                                "ru": "Результаты тестов служат надежным <w>показателем</w> успеваемости студента.",
                                "zh": "测试结果是衡量学生进步情况的可靠<w>指标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reliable indicator",
                        "clear indicator",
                        "visual indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак, стрелка или индекс, показывающие состояние, наличие или направление чего-либо.",
                        "zh": "一种显示某事物状况、存在或方向的迹象、指针或索引。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "мера, свидетельство чего-либо"
                            },
                            {
                                "target_lang_word": "признак",
                                "target_lang_sense_clarification": "симптом или знак наличия"
                            },
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "формальный или технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指标",
                                "target_lang_sense_clarification": "衡量事物状况的标志"
                            },
                            {
                                "target_lang_word": "迹象",
                                "target_lang_sense_clarification": "显示某事存在的征兆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd9cac03-d4bf-3812-a1b1-f93ad5759c29",
                    "sense_definition": "A statistical measure, such as the unemployment rate, used to analyze or predict economic trends.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "sign_or_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Analysts are waiting for the latest economic <w>indicators</w> before making forecasts.",
                            "target_lang_translations": {
                                "ru": "Аналитики ждут последних экономических <w>показателей</w>, прежде чем делать прогнозы.",
                                "zh": "分析师们在做出预测前正等待最新的经济<w>指标</w>。"
                            }
                        },
                        {
                            "text": "Housing starts are considered a key <w>indicator</w> of the country's financial health.",
                            "target_lang_translations": {
                                "ru": "Начало строительства жилья считается ключевым <w>индикатором</w> финансового здоровья страны.",
                                "zh": "新屋开工率被认为是衡量国家财政健康状况的关键<w>指标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic indicator",
                        "key indicator",
                        "performance indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Статистическая величина, используемая для анализа или прогнозирования экономических тенденций.",
                        "zh": "用于分析或预测经济趋势的统计量，如失业率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "статистическая величина"
                            },
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "экономический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指标",
                                "target_lang_sense_clarification": "经济统计数据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03cc5784-5948-3226-b6d1-e0523606cf61",
                    "sense_definition": "A flashing light on a vehicle that shows the driver intends to turn or change lanes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must use your <w>indicator</w> to signal before you turn left.",
                            "target_lang_translations": {
                                "ru": "Вы должны включить <w>поворотник</w>, чтобы подать сигнал перед поворотом налево.",
                                "zh": "左转前你必须打<w>转向灯</w>示意。"
                            }
                        },
                        {
                            "text": "The driver forgot to turn off his <w>indicator</w> after changing lanes on the highway.",
                            "target_lang_translations": {
                                "ru": "Водитель забыл выключить <w>поворотник</w> после смены полосы на шоссе.",
                                "zh": "司机在高速公路上变道后忘了关<w>转向灯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "turn signal",
                        "blinker",
                        "turn indicator",
                        "directional signal"
                    ],
                    "common_phrases": [
                        "left indicator",
                        "right indicator",
                        "indicator light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мигающий сигнал на транспортном средстве, показывающий намерение водителя повернуть или перестроиться.",
                        "zh": "车辆上的闪烁灯，用于向其他驾驶员示意转弯或变道意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворотник",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "указатель поворота",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转向灯",
                                "target_lang_sense_clarification": "车辆上的信号灯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53cb403c-3f1c-3057-ab9d-09efb2cb68cb",
                    "sense_definition": "A meter, gauge, or dial on a machine that displays a measurement or status.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fuel <w>indicator</w> on the dashboard showed that the tank was nearly empty.",
                            "target_lang_translations": {
                                "ru": "<w>Индикатор</w> уровня топлива на приборной панели показывал, что бак почти пуст.",
                                "zh": "仪表盘上的燃油<w>指示器</w>显示油箱快空了。"
                            }
                        },
                        {
                            "text": "Keep an eye on the pressure <w>indicator</w> to ensure the machine operates safely.",
                            "target_lang_translations": {
                                "ru": "Следите за <w>индикатором</w> давления, чтобы обеспечить безопасную работу машины.",
                                "zh": "请留意压力<w>仪表</w>以确保机器安全运行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speed indicator",
                        "level indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибор, датчик или шкала на механизме, отображающие измерение или статус.",
                        "zh": "机器上显示测量值或状态的仪表、量规或刻度盘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "световой сигнал или табло"
                            },
                            {
                                "target_lang_word": "датчик",
                                "target_lang_sense_clarification": "измерительный прибор"
                            },
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "стрелочный прибор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指示器",
                                "target_lang_sense_clarification": "显示状态的装置"
                            },
                            {
                                "target_lang_word": "仪表",
                                "target_lang_sense_clarification": "测量显示设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f738b20f-dd78-3e01-be5e-3240f7e77404",
                    "sense_definition": "A substance, such as litmus, that changes color to show the concentration of a chemical or the degree of a reaction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We added a few drops of the <w>indicator</w> to the solution to test its acidity.",
                            "target_lang_translations": {
                                "ru": "Мы добавили несколько капель <w>индикатора</w> в раствор, чтобы проверить его кислотность.",
                                "zh": "我们在溶液中滴了几滴<w>指示剂</w>来测试其酸碱度。"
                            }
                        },
                        {
                            "text": "Litmus paper is a common <w>indicator</w> used in chemistry experiments.",
                            "target_lang_translations": {
                                "ru": "Лакмусовая бумажка — распространенный <w>индикатор</w>, используемый в химических экспериментах.",
                                "zh": "石蕊试纸是化学实验中常用的一种<w>指示剂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pH indicator",
                        "chemical indicator",
                        "universal indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, меняющее цвет для отображения концентрации химического вещества или степени реакции.",
                        "zh": "一种通过变色来显示化学物质浓度或反应程度的物质，如石蕊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "химический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指示剂",
                                "target_lang_sense_clarification": "化学实验用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9646b4fb-7840-39f2-9265-b191a10d6cc6",
                    "sense_definition": "A plant or animal species whose presence suggests specific environmental conditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lichens are often used as an <w>indicator</w> of air quality in urban areas.",
                            "target_lang_translations": {
                                "ru": "Лишайники часто используются как <w>индикатор</w> качества воздуха в городских районах.",
                                "zh": "地衣常被用作城市地区空气质量的<w>指示物种</w>。"
                            }
                        },
                        {
                            "text": "The presence of this fish is a good <w>indicator</w> of clean water.",
                            "target_lang_translations": {
                                "ru": "Присутствие этой рыбы является хорошим <w>показателем</w> чистой воды.",
                                "zh": "这种鱼的存在是水质清洁的良好<w>指示物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "indicator species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид растений или животных, чье присутствие указывает на определенные условия окружающей среды.",
                        "zh": "其存在暗示特定环境条件的植物或动物物种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "биологический"
                            },
                            {
                                "target_lang_word": "биоиндикатор",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指示物种",
                                "target_lang_sense_clarification": "生物学用语"
                            },
                            {
                                "target_lang_word": "生物指示物",
                                "target_lang_sense_clarification": "环境监测用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19cc47b0-8ada-3df9-b5fd-14927bff3a25",
                    "sense_definition": "A word in a cryptic crossword clue that tells the solver how to treat other words to find the answer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistic_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this clue, the word 'broken' acts as an anagram <w>indicator</w>.",
                            "target_lang_translations": {
                                "ru": "В этой подсказке слово \"broken\" действует как <w>индикатор</w> анаграммы.",
                                "zh": "在这条线索中，“broken”一词充当了变位词的<w>提示词</w>。"
                            }
                        },
                        {
                            "text": "You need to identify the reversal <w>indicator</w> to solve this puzzle correctly.",
                            "target_lang_translations": {
                                "ru": "Вам нужно определить <w>индикатор</w> разворота, чтобы правильно решить эту головоломку.",
                                "zh": "你需要找出反转<w>提示词</w>才能正确解开这个谜题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anagram indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово в ключе к кроссворду, указывающее, как нужно интерпретировать другие слова для получения ответа.",
                        "zh": "填字游戏线索中指示如何处理其他词语以找到答案的词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "в криптограммах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提示词",
                                "target_lang_sense_clarification": "解谜用语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}