                "senses": [
                    {
                        "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                        "entry_id": "28763e7e-673f-348c-b20a-b4f5839fbff0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df1033e-62df-4bfc-a89c-83377187a552",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Frau Stratemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "174d375a-43ef-4543-8103-de862b597c4f",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Herr Stratemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d9308f13-d335-4fd8-a881-19e9a1ec88e8",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Die Stratemanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4b065021-533a-4de7-a731-9e74e3b17875",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Der Stratemann trägt nie die Schals, die die Stratemann ihm strickt."
                            },
                            {
                                "example_id": "55306744-a40d-4de7-b514-6379a307ecd2",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stratemann kommt, geht der Herr Stratemann.“"
                            },
                            {
                                "example_id": "923aef94-261f-4b3c-8547-a17f4d843da8",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Stratemann kommt und geht."
                            },
                            {
                                "example_id": "add4380a-0bb3-4d3d-befc-935ea6f43a3b",
                                "sense_id": "900eb6dc-f9d1-3106-a978-3f4f92e8c519",
                                "text": "Stratemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
