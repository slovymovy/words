                "senses": [
                    {
                        "sense_id": "6381e057-1114-3246-ae56-1cf13b6bf1fd",
                        "entry_id": "5608082d-c770-35ca-aebc-4cfc286a9f1a",
                        "glosses": [
                            "Wunsch, dessen Erfüllung jemandem besonders am Herzen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48842f18-e37b-48fa-b071-5ab1db1b8ebe",
                                "sense_id": "6381e057-1114-3246-ae56-1cf13b6bf1fd",
                                "text": "„Nur wer den Mitarbeiter zum Mittelpunkt der Geschäftsstrategie macht, wird von motivierten und erfolgsorientierten Angestellten profitieren – für langfristigen Erfolg muss der Mitarbeiter zur Herzenssache werden.“"
                            },
                            {
                                "example_id": "a9cd369a-cf13-474a-ad7a-239c732c6b38",
                                "sense_id": "6381e057-1114-3246-ae56-1cf13b6bf1fd",
                                "text": "„Sie hat es sich zur Herzenssache gemacht, ihren Schützlingen den Übergang an eine weiterführende Schule zu ermöglichen.“"
                            },
                            {
                                "example_id": "fd80a0f6-7f38-4cef-99bc-d71c775a8bfc",
                                "sense_id": "6381e057-1114-3246-ae56-1cf13b6bf1fd",
                                "text": "„Machen Sie sich den starken Wunsch nach Individualität zur Herzenssache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
