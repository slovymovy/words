                    "sense_id": "9945657a-d052-33f6-8654-2c35b6af4a21",
                    "sense_definition": "betrekking hebbend op een koning of koningin, of behorend tot hun familie of ambt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "monarchie",
                    "name_type": "no",
                    "examples": [
