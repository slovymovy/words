                    {
                        "translation_id": "60d67526-ab9e-4495-b431-39f1926d8cea",
                        "source_entry_id": "34d0c82b-9c84-3f06-86fa-65149838c970",
                        "source_sense_id": "313ff2f5-3db6-35a9-99eb-7ce1364a37a5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Betrüger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrüger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                        "entry_id": "6852de93-c45d-3abc-b0e9-ecc31583301d",
                                        "glosses": [
                                            "Person, die andere täuscht, um sich einen Vorteil zu verschaffen; jemand, der betrügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5803090b-ae7e-4323-b9d5-05a4a105d52f",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "Er wurde als Betrüger entlarvt."
                                            },
                                            {
                                                "example_id": "9b1f094e-6dd9-4f7d-b9a2-321bddb5f434",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Per E-Mail stellte ein Betrüger hohe Gewinne in Aussicht - lediglich eine kleine Anzahlung sei zu leisten.“"
                                            },
                                            {
                                                "example_id": "5582df47-cfc3-4e76-9b4c-b3215a517286",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Als die an der Nase herumgeführten Betrüger sich erneut am Telefon meldeten, rief die 85-Jährige die echte Polizei.“"
                                            },
                                            {
                                                "example_id": "5440c2f9-3000-4a80-b292-a65eee9ad55d",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Darüber hinaus schufen sie zahlreiche satirische Romane und Komödien auf Jiddisch, in deren Handlung chassidische Figuren als frömmelnde Fanatiker, Heuchler und intrigante Betrüger dargestellt und entlarvt werden.“"
                                            },
                                            {
                                                "example_id": "e0fa56a5-2507-46fc-99f6-7f585f5a757c",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Er ist ein Betrüger und ein Halunke, das ist klar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "563aec48-6137-4738-ab18-a6f1462eae28",
                        "source_entry_id": "34d0c82b-9c84-3f06-86fa-65149838c970",
                        "source_sense_id": "313ff2f5-3db6-35a9-99eb-7ce1364a37a5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Betrügerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                        "entry_id": "6bffc13e-7bfe-35fe-a997-9686ebde0f97",
                                        "glosses": [
                                            "weiblicher Betrüger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1cad21-e02e-4758-baea-b6b55a61d4df",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "Du solltest ihr nicht trauen, dieser Betrügerin!"
                                            },
                                            {
                                                "example_id": "e1fa5fc4-e952-4eaa-82b2-627007b32f9d",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Am 5. April 2001 erhob der Bezirksanwalt Anklage, nannte Christina Maria Kurmann aus Adliswil eine Urkundenfälscherin und Betrügerin.“"
                                            },
                                            {
                                                "example_id": "684aae1f-6f34-48fd-a58e-4bfcef887d35",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Da ich etwas unternehmen mußte, um die Absichten der beiden Betrügerinnen zu vereiteln, verließ ich sie wortlos und schloß mich mit Madame d'Urfé ein, um das Orakel über die Operation zu befragen, die zu ihrem Glück führen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee75ff5a-8303-4029-a1d8-68385be0f451",
                        "source_entry_id": "34d0c82b-9c84-3f06-86fa-65149838c970",
                        "source_sense_id": "313ff2f5-3db6-35a9-99eb-7ce1364a37a5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Defraudant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
