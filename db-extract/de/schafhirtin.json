                                "target_senses": [
                                    {
                                        "sense_id": "817addf9-9849-3909-93ce-4eba941dcf1b",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A person who tends sheep, especially a grazing flock."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e066e6a-a86f-40b3-9547-8c5993bfce4f",
                                                "sense_id": "817addf9-9849-3909-93ce-4eba941dcf1b",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48614c9-cb0b-33c1-840d-a552f60beb71",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A person who tends sheep, especially a grazing flock.",
                                            "A male sheep tender"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf187aa-3d58-3e7f-9343-02a63a8b5ec4",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "Someone who watches over, looks after, or guides somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6279921c-7ed5-407d-a785-327a55171319",
                                                "sense_id": "bcf187aa-3d58-3e7f-9343-02a63a8b5ec4",
                                                "text": "The Lord is my shepherd; I shall not want."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03feb72f-5817-3cdc-8bcf-8e185c630175",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "Someone who watches over, looks after, or guides somebody.",
                                            "A male watcher/guardian/guider/leader"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e98ee45-149a-3380-a439-855b5014a7cd",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "The pastor of a church; one who guides others in religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ade9f136-1844-3c22-abfa-4e62d832e55d",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "The pastor of a church; one who guides others in religion.",
                                            "A male pastor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d99cea2-5e83-3dde-97de-ad8293bd3b3f",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A swain; a rustic male lover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58599226-89a8-3852-99fc-27846434d964",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A German Shepherd."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5f790c-3f7c-4f5c-91cd-16a855268337",
                                                "sense_id": "58599226-89a8-3852-99fc-27846434d964",
                                                "text": "The dirt floor, low ceiling and unfinished stone walls were barely illuminated by candles and a dim string of green decorative lights. A nervous shepherd mix barked at me as a woman tried to calm it. When my eyes adjusted, I saw people in corners."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shepherd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                        "entry_id": "a821673e-321a-3ba6-8527-9ef0bfe7c401",
                                        "glosses": [
                                            "To watch over; to guide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64f8aa3-a87c-4732-9452-fefc4859e280",
                                                "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                                "text": "For me has Pain, the sentinel, / Been vigilant / To pace my plot and dwell / Within my tent; / Oft in the night with small alarms / Has stirred me out of rest, / Alert, oppressed, / Till shepherded within thine arms / And on thy breast, / O loving Lady, in the curse of Pain / I have been blest— / […]"
                                            },
                                            {
                                                "example_id": "eff93736-23f5-438d-9e50-a98ddba35951",
                                                "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                                "text": "Each entry in this volume was assigned to a different preeminent scholar who was responsible for shepherding that specific entry, and that specific entry alone, into being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae865d7-b37b-3e52-96e0-703afb3b1c77",
                                        "entry_id": "a821673e-321a-3ba6-8527-9ef0bfe7c401",
                                        "glosses": [
                                            "To obstruct an opponent from getting to the ball, either when a teammate has it or is going for it, or if the ball is about to bounce through the goal or out of bounds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9766e57-1cba-4a41-9273-69b671e1b8ce",
                        "source_entry_id": "4fd83a85-415d-37d6-ba6f-683aef21016b",
                        "source_sense_id": "74ba8b6c-b716-3b47-b5ae-ccf4eed696bc",
                        "source_sense_description": "Frau, die eine Schafherde hütet",
                        "target_lang_word": "bergère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a757c7ca-8cd3-380b-b275-382978d04c31",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Gardienne de troupeau."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dc27adf-c1e0-4724-922d-d5e6b1bb05fb",
                                                "sense_id": "a757c7ca-8cd3-380b-b275-382978d04c31",
                                                "text": "Il pleut, il pleut, bergère, rentre tes blancs moutons !"
                                            },
                                            {
                                                "example_id": "dc4731f9-db83-4b25-95aa-2820c4d45149",
                                                "sense_id": "a757c7ca-8cd3-380b-b275-382978d04c31",
                                                "text": "Vous que j’aimai sous les grands houx,\nAux soirs de bohême champêtre,\nBergère, à la mode champêtre,\nDe ces soirs vous souvenez-vous ?\nVous étiez l’astre à ma fenêtre\nEt l’étoile d’or dans les houx."
                                            },
                                            {
                                                "example_id": "83ab497c-52af-451d-aa69-69f0f3abfc12",
                                                "sense_id": "a757c7ca-8cd3-380b-b275-382978d04c31",
                                                "text": "Margoton, la jeune bergère,\nTrouvant dans l’herbe un petit chat\nQui venait de perdre sa mère,\nL’adopta…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Fauteuil plus large et plus profond que les fauteuils ordinaires et garni d’un coussin sur lequel on s’assied, avec des accotoirs pleins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637396f5-d6b8-4d57-a89d-668a7567d91a",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "Mlle de La Mole était le centre d'un petit groupe qui se formait presque tous les soirs derrière l'immense bergère de la marquise."
                                            },
                                            {
                                                "example_id": "1e02a756-fd9e-48d3-9bbd-3c724782f6bf",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "Le général était assis, ou, pour mieux dire, enseveli dans une haute et spacieuse bergère, au coin de la cheminée, où brillait un feu nourri."
                                            },
                                            {
                                                "example_id": "707543f5-aa38-4247-9194-9570e0b82a87",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "Enfin elle s’installe dans une bergère où elle s’enfonce doucement en se demandant comment elle s’en relèvera jamais."
                                            },
                                            {
                                                "example_id": "10fb5a3e-1219-43f1-9347-07e1f99de73f",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "Lui-même s'enfonça dans une ample bergère qui garnissait un des coins du salon de feu Mr Gardner."
                                            },
                                            {
                                                "example_id": "8e8afd7d-a4af-42c2-8718-c14634836214",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "Ridicule je l’étais certainement quand, prié à dîner chez mademoiselle Préfère, je m’assis dans une bergère (c’était bien une bergère) à la droite de cette inquiétante personne."
                                            },
                                            {
                                                "example_id": "a15acc22-bfb8-4bf0-b1b3-b618181a710f",
                                                "sense_id": "685e9ac5-ff0e-3dc5-a3e1-f9e44fa6bb7c",
                                                "text": "(...) il avait laissé choir le vieux prêtre sur la bergère du vestibule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacbbc3f-f24a-3357-8421-4e368c807f31",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Coiffure de femme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3406c5b-4c8a-362d-b653-601004c10f98",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Femme, en général."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a956dd-c3a4-4dbe-ab72-908655c0a551",
                                                "sense_id": "b3406c5b-4c8a-362d-b653-601004c10f98",
                                                "text": "… il me faudrait une petite chignole commak pour balader certaines bergères de ma connaissance dans les bois ombreux de l’Ile-de-France !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17dabba5-68a3-3ee6-b5bd-b4145774fa05",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Épouse, compagne régulière."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d489dc9-0943-4ff6-a17c-27870af3c22a",
                                                "sense_id": "17dabba5-68a3-3ee6-b5bd-b4145774fa05",
                                                "text": "Chez lui, sa bergère mettait l’embargo sur la pagouze et lui octroyait généreusement cinquante louis pour sa nicotine mensuelle et ses apéros"
                                            },
                                            {
                                                "example_id": "f7ae68f0-3216-4158-93f5-3e07b095c1e2",
                                                "sense_id": "17dabba5-68a3-3ee6-b5bd-b4145774fa05",
                                                "text": "— Chapeau, mon pote, chapeau. Seulement, faut que je garde ça pour moi sans ça Nicolette – c’est ma bergère, Nicolette – elle me dira que c’est pas moi qui ferais ça pour elle."
                                            },
                                            {
                                                "example_id": "1ef63b93-cb9c-4fb1-8d88-898a2af68b11",
                                                "sense_id": "17dabba5-68a3-3ee6-b5bd-b4145774fa05",
                                                "text": "Ma bergère s’est envolée\nen vache elle m’a plaqué\nelle a fait la malle\nen loucedé\navec mon pote Fernand\net le mobilier."
                                            },
                                            {
                                                "example_id": "3a906bb6-cb7b-4769-8c26-bf0434fd98d0",
                                                "sense_id": "17dabba5-68a3-3ee6-b5bd-b4145774fa05",
                                                "text": "- Laisse, Alfred, tu vois bien qu’il est soûl ! lui lâcha sa bergère, pleine de bon sens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bbae438-85ff-3840-a3cf-ed248fd8b6b8",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Chienne de berger, femelle du berger."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a4bb7e-86f8-31ac-8c06-14c256afa5ea",
                                        "entry_id": "39e3d1fb-c140-3f2d-ad93-8bd988b93b6d",
                                        "glosses": [
                                            "Amante."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d901c33-0245-4754-9062-bcb210bfbb3b",
                                                "sense_id": "f7a4bb7e-86f8-31ac-8c06-14c256afa5ea",
                                                "text": "Une bergère inconstante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
