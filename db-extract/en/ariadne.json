                "translations": [
                    {
                        "translation_id": "18b8433a-633f-41d9-a76e-1ff1f6efd399",
                        "source_entry_id": "f8f589a7-1d53-318b-af4d-78d7a009184e",
                        "source_sense_description": "daughter of King Minos",
                        "target_lang_word": "Ariane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ariane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9af92f93-a330-3e7d-907a-5619d8f3b556",
                                        "entry_id": "ee371063-58c0-3025-83cb-58553a886b99",
                                        "glosses": [
                                            "Fille de Minos qui aida Thésée à vaincre le Minotaure et à sortir du labyrinthe."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a39588-b6ad-4301-8cea-e0275781e31e",
                                                "sense_id": "9af92f93-a330-3e7d-907a-5619d8f3b556",
                                                "text": "Ariane, ma sœur, de quel amour blessée\nVous mourûtes aux bords où vous fûtes laissée !"
                                            },
                                            {
                                                "example_id": "fd77b5b9-6747-43ff-b3a8-3b6b323b2a97",
                                                "sense_id": "9af92f93-a330-3e7d-907a-5619d8f3b556",
                                                "text": "Dédale observait d’un air amusé Ariane qui, les sourcils froncés, le regard vert bronze, essayait de résoudre le problème de la configuration du Labyrinthe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e894cad-a6f8-36a6-80e7-df48c6b3e2e5",
                                        "entry_id": "ee371063-58c0-3025-83cb-58553a886b99",
                                        "glosses": [
                                            "Nom de fusées lanceuses de satellites développées par l’Agence spatiale européenne."
                                        ],
                                        "tags": [
                                            "Propulsion spatiale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852e7c74-bbe7-4767-9043-6afbe6b80e09",
                                                "sense_id": "3e894cad-a6f8-36a6-80e7-df48c6b3e2e5",
                                                "text": "Comme nous l’avons vu, la première fusée Ariane sera lancée le 24 décembre 1979."
                                            },
                                            {
                                                "example_id": "7a3a2649-269b-4ce7-8e01-280d90427247",
                                                "sense_id": "3e894cad-a6f8-36a6-80e7-df48c6b3e2e5",
                                                "text": "La fusée Ariane s’arrache à la pesanteur équatoriale de la Guyane. C’est le premier lancement réussi de la fusée européenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32325bfd-0e42-3fed-825c-65dba79f21a2",
                                        "entry_id": "ee371063-58c0-3025-83cb-58553a886b99",
                                        "glosses": [
                                            "Nom donné par la marque automobile Simca à un modèle de berline familiale, produit de 1957 à 1963."
                                        ],
                                        "tags": [
                                            "Marque commerciale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "410ca6e4-ae12-43f3-b3e5-eaae6e9e35a3",
                                                "sense_id": "32325bfd-0e42-3fed-825c-65dba79f21a2",
                                                "text": "L’Ariane est une Vedette Trianon, c’est à dire le bas de gamme jusque là, avec un moteur Flash qui équipe l’Aronde 1300. Peu gourmand comparé au V8, ce moteur est aussi très peu performant."
                                            },
                                            {
                                                "example_id": "4df8c301-7997-48df-ab5e-b492ce087dd6",
                                                "sense_id": "32325bfd-0e42-3fed-825c-65dba79f21a2",
                                                "text": "Saviez-vous que Simca avait imaginé une forme de downsizing avant l’heure lorsqu’elle lança l’Ariane pour faire face à la crise de Suez de 1956 en plaçant un petit moteur 4 cylindres dans la carrosserie de ses Vedettes dotées jusque là d’un V8 ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6df420-4d59-3e44-b00c-9fd8a597870f",
                                        "entry_id": "ee371063-58c0-3025-83cb-58553a886b99",
                                        "glosses": [
                                            "(43) Ariane, internationalement (43) Ariadne, planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "511bfdfd-0cd5-37ed-b571-216565c02902",
                                        "entry_id": "ee371063-58c0-3025-83cb-58553a886b99",
                                        "glosses": [
                                            "(1225) Ariane, planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Ariane",
