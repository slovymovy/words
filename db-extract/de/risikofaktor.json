                    },
                    {
                        "form_id": "38ffa0eb-d76a-4e1b-981c-ce7d798533d3",
                        "entry_id": "1494ef04-fa65-34a4-b730-176c81f0ca5f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Risikofaktoren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                        "entry_id": "1494ef04-fa65-34a4-b730-176c81f0ca5f",
                        "glosses": [
                            "Moment, das eine Gefährdung darstellt, von dem man aber (noch) nicht weiß, ob und wie es im Einzelfall zum Tragen kommt; Darstellung des Risikos als Ziffer (Faktor)"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "174c2662-9ad4-44e0-a514-0fd9a3a2e665",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "Fettreiche Ernährung ist ein Risikofaktor, das Risiko für eine Herz-Kreislauf-Erkrankung steigt."
                            },
                            {
                                "example_id": "4e5c0d10-a94e-4f5b-969e-8f4242ed718f",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "Armut stellt einen Risikofaktor für die Entwicklung von Kindern und Jugendlichen dar."
                            },
                            {
                                "example_id": "3225112f-5d85-4ee0-96e4-277a0a2ad8e0",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "„Die Dobutamin-Stressechokardiographie wies im Fall von mehr als 3 klinischen Risikofaktoren und bei Nachweis einer Myokardischämie eine 5-fach höhere kardiale Komplikationsrate aus – auch unter wirksamer b-Blockertherapie.“"
                            },
                            {
                                "example_id": "640fc00f-2203-491e-b696-76544a806415",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "„Einer geringen Gefahrenwarnstufe laut Lawinenlagebericht wird ein Risikofaktor von 2 zugewiesen, eine mäßige enthält den Faktor 4, eine erhebliche den Faktor 8 und eine große theoretisch den Faktor 16.“"
                            },
                            {
                                "example_id": "b5e8984b-f73c-4887-9f3e-7c4bfe6094a5",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "„Doch nun müssen die Machthaber in Peking ihre strategische Toleranz gegenüber Nordkorea mit einem neuen Risikofaktor abwägen: Trump.“"
                            },
                            {
                                "example_id": "5d462b28-4f13-4feb-a311-9d55c332d290",
                                "sense_id": "fbe20968-4b39-3459-b903-fa2d12968d27",
                                "text": "„Es ging uns lediglich darum, zu zeigen, wie man Risikofaktoren (die Gefährlichkeit schlagender Ehemänner) und den Anteil von Schlägern unter den Ehemännern ermitteln kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
