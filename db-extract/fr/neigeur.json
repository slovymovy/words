                    {
                        "sense_id": "4cda971f-058a-3609-8281-8c71729f690a",
                        "entry_id": "0014dfd6-4eb9-3816-b381-804056ce1099",
                        "glosses": [
                            "Caractère de ce qui est propre à la neige, ou ressemble à la neige."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "7f22c598-f050-4250-a093-b5379bdf002a",
                                "sense_id": "4cda971f-058a-3609-8281-8c71729f690a",
                                "text": "Je t’y élèverais en l’admiration de ta neigeur, en le respect de ta beauté."
                            },
                            {
                                "example_id": "43058a0d-0399-4bd3-8139-ca20ae356533",
                                "sense_id": "4cda971f-058a-3609-8281-8c71729f690a",
                                "text": "Dans le troublance et la neigeur que tu distilles."
                            },
                            {
                                "example_id": "6430b262-5c41-44d8-beea-ec7b1b01e6c1",
                                "sense_id": "4cda971f-058a-3609-8281-8c71729f690a",
                                "text": "Si tu me parles de décembre et de ses roses, — de sa Rose, — il ne m’est point nécessaire d’aller sur le pas de la porte pour palper la neigeur : je crois, je sais que les effluves de l’ellébore noir endorment des paysages qui ne vivent qu’en moi-même"
                            },
                            {
                                "example_id": "e533bd39-c9c0-4fd5-a107-abde32c31563",
                                "sense_id": "4cda971f-058a-3609-8281-8c71729f690a",
                                "text": "[…] gonflements, failles, escarpements, sinuosités, ses monts aux reflets bleus de glaciers, surmontés d’une calotte grenue, sombre dans toute cette neigeur ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "4436c16d-c988-39d8-8dd7-cb2541599f23",
                        "entry_id": "0014dfd6-4eb9-3816-b381-804056ce1099",
                        "glosses": [
                            "Touffe de poils blancs sur la robe d’un cheval."
                        ],
                        "tags": [],
                        "note": "Le genre n’a pas pu être défini avec les attestations disponibles",
                        "examples": [
                            {
                                "example_id": "a4cebf77-9ff3-4f26-a698-0e24cdf5309f",
                                "sense_id": "4436c16d-c988-39d8-8dd7-cb2541599f23",
                                "text": "Sont exclus du standard, les animaux présentant […] une robe aux crins roux ou aubérisée (poils blancs visibles depuis le jury) ou des neigeurs (touffes de poils blancs) […]"
                            }
                        ]
                    }
