                        "target_lang_word": "Traubenkartätsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f5a47a94-1734-4514-a80d-adcc98bc1531",
                        "source_entry_id": "57a48bcb-57d5-3f28-9905-06d410298524",
                        "source_sense_id": "ef747e6f-c36d-31e0-a479-8112b3e2fc0e",
                        "source_sense_description": "type of shot",
                        "target_lang_word": "Kartätsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartätsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a7f438b-8e27-3a16-86c6-a98ea854dab3",
                                        "entry_id": "c47da352-c1bf-3a6e-b182-d43afba8956e",
                                        "glosses": [
                                            "ein veraltetes Artilleriegeschoss"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9004ebe7-864b-461f-97ab-caa64613eb7c",
                                                "sense_id": "2a7f438b-8e27-3a16-86c6-a98ea854dab3",
                                                "text": "„Die Erfindung ist freilich so leicht und so natürlich, daß von der Kugel zur Kartätsche kein anderer Uebergang ist, als von der Einheit zur Mehrheit;…“"
                                            },
                                            {
                                                "example_id": "1efecb0f-dd65-49f6-8474-a1ecc21491a0",
                                                "sense_id": "2a7f438b-8e27-3a16-86c6-a98ea854dab3",
                                                "text": "„Schon war ich wieder draußen und sauste die Treppe hinauf an Deck - und konnte mich gerade noch rechtzeitig der Länge nach zu Boden werfen, als ein gewaltiger Donnerschlag die Planken erzittern ließ, und eine Kartätsche über mich hinwegfegte.“"
                                            },
                                            {
                                                "example_id": "9f153ce7-f03c-4b49-a16e-79721547e8bf",
                                                "sense_id": "2a7f438b-8e27-3a16-86c6-a98ea854dab3",
                                                "text": "„Tote bedeckten die Planken der Decks, zerrissen vom Blei der Kartätschen, erschlagen von stürzenden Masten, verbrannt vom Feuer.“"
                                            },
                                            {
                                                "example_id": "e42e81a7-bcfb-4634-bdd1-afa71be8ec60",
                                                "sense_id": "2a7f438b-8e27-3a16-86c6-a98ea854dab3",
                                                "text": "„Sobald wir das Ufer sahen, legten wir ein paar Kartätschen nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e852937-bb7d-3239-af7e-dbed3dc3eaff",
                                        "entry_id": "c47da352-c1bf-3a6e-b182-d43afba8956e",
                                        "glosses": [
                                            "ein Brett mit einem Handgriff zum Glattstreichen des Verputzes"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002be4ce-9cf6-48c6-b37d-24b4ce3cb677",
                                                "sense_id": "9e852937-bb7d-3239-af7e-dbed3dc3eaff",
                                                "text": "„Um bei einer großen Wand eine plane Fläche zu erzielen, benutzen Sie am besten eine Kartätsche aus Holz oder Aluminium, um damit den frischen Wandglätterauftrag abziehen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
