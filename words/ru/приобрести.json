{
    "word_family": [
        "приобретать",
        "приобретение",
        "приобретатель"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c28d903c-9b06-38f8-9f29-94f1d35dd487",
                    "sense_definition": "Купить, получить что-либо в собственность (часто используется в официальном контексте).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acquisition_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы планируем <w>приобрести</w> новую мебель для гостиной в следующем месяце.",
                            "target_lang_translations": {
                                "en": "We plan to <w>purchase</w> new furniture for the living room next month.",
                                "it": "Abbiamo in programma di <w>acquistare</w> nuovi mobili per il soggiorno il mese prossimo."
                            }
                        },
                        {
                            "text": "В кассе театра можно <w>приобрести</w> билеты на вечерний спектакль.",
                            "target_lang_translations": {
                                "en": "You can <w>purchase</w> tickets for the evening performance at the theater box office.",
                                "it": "Alla biglietteria del teatro è possibile <w>acquistare</w> i biglietti per lo spettacolo serale."
                            }
                        }
                    ],
                    "synonyms": [
                        "купить",
                        "обзавестись"
                    ],
                    "antonyms": [
                        "потерять",
                        "утратить"
                    ],
                    "common_phrases": [
                        "приобрести недвижимость",
                        "приобрести билет",
                        "приобрести товар",
                        "приобрести жильё"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "официальное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To buy or obtain something into ownership (often formal).",
                        "it": "Comprare o ottenere qualcosa in proprietà (spesso usato in contesti formali)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purchase",
                                "target_lang_sense_clarification": "formal, especially for goods or property"
                            },
                            {
                                "target_lang_word": "acquire",
                                "target_lang_sense_clarification": "formal, for assets or property"
                            },
                            {
                                "target_lang_word": "buy",
                                "target_lang_sense_clarification": "general"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "acquistare",
                                "target_lang_sense_clarification": "formale, per beni o proprietà"
                            },
                            {
                                "target_lang_word": "comprare",
                                "target_lang_sense_clarification": "generico, uso quotidiano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba00577-c09d-3a3b-bf8f-4558c6efe20c",
                    "sense_definition": "Стать обладателем какого-либо свойства, качества, навыка или внешнего вида.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "acquisition_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За годы работы в компании он успел <w>приобрести</w> бесценный опыт.",
                            "target_lang_translations": {
                                "en": "Over the years of working at the company, he managed to <w>gain</w> invaluable experience.",
                                "it": "Negli anni di lavoro in azienda è riuscito ad <w>acquisire</w> un'esperienza inestimabile."
                            }
                        },
                        {
                            "text": "После долгой стирки белая рубашка может <w>приобрести</w> серый оттенок.",
                            "target_lang_translations": {
                                "en": "After a long wash, a white shirt may <w>acquire</w> a grey tint.",
                                "it": "Dopo molti lavaggi, una camicia bianca può <w>assumere</w> una tonalità grigiastra."
                            }
                        }
                    ],
                    "synonyms": [
                        "обрести"
                    ],
                    "antonyms": [
                        "утратить",
                        "потерять"
                    ],
                    "common_phrases": [
                        "приобрести опыт",
                        "приобрести знания",
                        "приобрести форму",
                        "приобрести значение",
                        "приобрести вид"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop or obtain a quality, skill, or appearance.",
                        "it": "Sviluppare o ottenere una qualità, un'abilità, un aspetto o una caratteristica."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acquire",
                                "target_lang_sense_clarification": "for skills, habits, or qualities"
                            },
                            {
                                "target_lang_word": "gain",
                                "target_lang_sense_clarification": "for experience or knowledge"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "acquisire",
                                "target_lang_sense_clarification": "per abilità, conoscenze o qualità"
                            },
                            {
                                "target_lang_word": "guadagnare",
                                "target_lang_sense_clarification": "per esperienza o vantaggi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0917489f-e196-3061-b6a4-94f1598817a4",
                    "sense_definition": "Завести круг общения, найти новых знакомых или друзей.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В летнем лагере ребёнку будет легко <w>приобрести</w> новых друзей.",
                            "target_lang_translations": {
                                "en": "In summer camp, it will be easy for a child to <w>make</w> new friends.",
                                "it": "Al campo estivo sarà facile per il bambino <w>farsi</w> nuovi amici."
                            }
                        },
                        {
                            "text": "Переезд в другой город помог ему <w>приобрести</w> интересные знакомства.",
                            "target_lang_translations": {
                                "en": "Moving to another city helped him <w>make</w> interesting acquaintances.",
                                "it": "Trasferirsi in un'altra città lo ha aiutato a <w>stringere</w> interessanti conoscenze."
                            }
                        }
                    ],
                    "synonyms": [
                        "обзавестись"
                    ],
                    "antonyms": [
                        "потерять"
                    ],
                    "common_phrases": [
                        "приобрести друзей",
                        "приобрести знакомых",
                        "приобрести связи"
                    ],
                    "target_lang_definitions": {
                        "en": "To start social relationships or find new friends.",
                        "it": "Iniziare relazioni sociali o trovare nuovi amici e conoscenti."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "specifically for friends"
                            },
                            {
                                "target_lang_word": "acquire",
                                "target_lang_sense_clarification": "formal, for connections or acquaintances"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "farsi",
                                "target_lang_sense_clarification": "usato specificamente per amici"
                            },
                            {
                                "target_lang_word": "stringere",
                                "target_lang_sense_clarification": "per amicizie o conoscenze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79a5cc10-bf80-303b-9d02-6d13ff2270ce",
                    "sense_definition": "Заслужить отношение к себе, добиться репутации или славы своими действиями.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acquisition_reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Своим честным трудом он сумел <w>приобрести</w> уважение всех коллег.",
                            "target_lang_translations": {
                                "en": "Through his honest work, he managed to <w>earn</w> the respect of all his colleagues.",
                                "it": "Con il suo lavoro onesto è riuscito a <w>guadagnarsi</w> il rispetto di tutti i colleghi."
                            }
                        },
                        {
                            "text": "Необдуманными поступками политик рискует <w>приобрести</w> дурную славу.",
                            "target_lang_translations": {
                                "en": "With thoughtless actions, the politician risks <w>acquiring</w> a bad reputation.",
                                "it": "Con azioni sconsiderate, il politico rischia di <w>farsi</w> una cattiva reputazione."
                            }
                        }
                    ],
                    "synonyms": [
                        "заслужить",
                        "снискать",
                        "завоевать",
                        "стяжать"
                    ],
                    "antonyms": [
                        "потерять"
                    ],
                    "common_phrases": [
                        "приобрести уважение",
                        "приобрести известность",
                        "приобрести репутацию",
                        "приобрести славу",
                        "приобрести авторитет"
                    ],
                    "target_lang_definitions": {
                        "en": "To earn a reputation or respect through one's actions.",
                        "it": "Guadagnarsi una reputazione, rispetto o fama attraverso le proprie azioni."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gain",
                                "target_lang_sense_clarification": "for respect, fame, or reputation"
                            },
                            {
                                "target_lang_word": "earn",
                                "target_lang_sense_clarification": "for respect or trust"
                            },
                            {
                                "target_lang_word": "acquire",
                                "target_lang_sense_clarification": "for reputation or fame"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "guadagnarsi",
                                "target_lang_sense_clarification": "per rispetto o fiducia"
                            },
                            {
                                "target_lang_word": "conquistare",
                                "target_lang_sense_clarification": "per fama o reputazione"
                            },
                            {
                                "target_lang_word": "farsi",
                                "target_lang_sense_clarification": "usato in espressioni come 'farsi una reputazione'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}