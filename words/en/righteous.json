{
    "word_family": [
        "righteousness",
        "righteously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3cde36d-7b02-3466-8a2b-f10704e92c04",
                    "sense_definition": "Free from sin or guilt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>righteous</w> person seeks to live a life of purity and truth.",
                            "target_lang_translations": {
                                "de": "Der <w>gerechte</w> Mensch versucht, ein Leben in Reinheit und Wahrheit zu führen.",
                                "es": "La persona <w>justa</w> busca vivir una vida de pureza y verdad."
                            }
                        },
                        {
                            "text": "Many ancient texts describe the path of the <w>righteous</w> as one of peace.",
                            "target_lang_translations": {
                                "de": "Viele alte Texte beschreiben den Weg der <w>Rechtschaffenen</w> als einen des Friedens.",
                                "es": "Muchos textos antiguos describen el camino de los <w>justos</w> como un camino de paz."
                            }
                        }
                    ],
                    "synonyms": [
                        "virtuous",
                        "sinless",
                        "blameless"
                    ],
                    "antonyms": [
                        "wicked",
                        "sinful"
                    ],
                    "common_phrases": [
                        "righteous person"
                    ],
                    "target_lang_definitions": {
                        "de": "Frei von Sünde, Schuld oder Makel; moralisch rein.",
                        "es": "Libre de pecado, culpa o mancha moral; recto según la fe o la moral."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gerecht",
                                "target_lang_sense_clarification": "im religiösen oder biblischen Sinn; frei von Schuld"
                            },
                            {
                                "target_lang_word": "rechtschaffen",
                                "target_lang_sense_clarification": "moralisch untadelig und ehrlich"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "justo",
                                "target_lang_sense_clarification": "en sentido bíblico o moral; libre de culpa"
                            },
                            {
                                "target_lang_word": "inmaculado",
                                "target_lang_sense_clarification": "sin mancha moral o pecado"
                            },
                            {
                                "target_lang_word": "recto",
                                "target_lang_sense_clarification": "de conducta intachable e íntegra"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb4edcb8-e058-3f3b-9d1c-8f33c8c77a16",
                    "sense_definition": "Moral and virtuous, sometimes in a way that feels superior or self-important.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>righteous</w> pride in her hard work and dedication to the community.",
                            "target_lang_translations": {
                                "de": "Sie empfand einen <w>tugendhaften</w> Stolz auf ihre harte Arbeit und ihren Einsatz für die Gemeinschaft.",
                                "es": "Sentía un <w>legítimo</w> orgullo por su arduo trabajo y dedicación a la comunidad."
                            }
                        },
                        {
                            "text": "His <w>righteous</w> attitude often made others feel judged rather than supported.",
                            "target_lang_translations": {
                                "de": "Seine <w>selbstgerechte</w> Haltung gab anderen oft das Gefühl, verurteilt statt unterstützt zu werden.",
                                "es": "Su actitud <w>santurrona</w> a menudo hacía que los demás se sintieran juzgados en vez de apoyados."
                            }
                        }
                    ],
                    "synonyms": [
                        "virtuous",
                        "moral",
                        "upright"
                    ],
                    "antonyms": [
                        "immoral"
                    ],
                    "common_phrases": [
                        "righteous path"
                    ],
                    "target_lang_definitions": {
                        "de": "Moralisch einwandfrei und tugendhaft, zuweilen auf selbstgerechte oder herablassende Art.",
                        "es": "Moral y virtuoso, a menudo con una actitud de superioridad moral o engreimiento."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rechtschaffen",
                                "target_lang_sense_clarification": "anständig und tugendhaft"
                            },
                            {
                                "target_lang_word": "tugendhaft",
                                "target_lang_sense_clarification": "hohen moralischen Ansprüchen folgend"
                            },
                            {
                                "target_lang_word": "selbstgerecht",
                                "target_lang_sense_clarification": "von der eigenen moralischen Überlegenheit überzeugt"
                            },
                            {
                                "target_lang_word": "redlich",
                                "target_lang_sense_clarification": "aufrichtig und ehrlich"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "recto",
                                "target_lang_sense_clarification": "que procede con estricta moralidad e integridad"
                            },
                            {
                                "target_lang_word": "honrado",
                                "target_lang_sense_clarification": "virtuoso y de conducta intachable"
                            },
                            {
                                "target_lang_word": "santurrón",
                                "target_lang_sense_clarification": "que presume de moralidad con aire de superioridad"
                            },
                            {
                                "target_lang_word": "beato",
                                "target_lang_sense_clarification": "con tono despectivo; exageradamente mojigato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd67c08e-41c9-30f0-ba9e-b6133779e7e7",
                    "sense_definition": "Justified or reasonable, especially regarding anger or feelings.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "justified",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers felt <w>righteous</w> indignation after the company cut their pay without warning.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter empfanden <w>gerechte</w> Empörung, nachdem das Unternehmen ihre Löhne ohne Vorwarnung gekürzt hatte.",
                                "es": "Los trabajadores sintieron una <w>justa</w> indignación después de que la empresa les redujera el sueldo sin previo aviso."
                            }
                        },
                        {
                            "text": "She had a <w>righteous</w> cause to demand an apology for the unfair treatment.",
                            "target_lang_translations": {
                                "de": "Sie hatte einen <w>berechtigten</w> Grund, eine Entschuldigung für die ungerechte Behandlung zu verlangen.",
                                "es": "Tenía una causa <w>justificada</w> para exigir una disculpa por el trato injusto."
                            }
                        }
                    ],
                    "synonyms": [
                        "justified",
                        "warranted",
                        "legitimate"
                    ],
                    "antonyms": [
                        "unjustified"
                    ],
                    "common_phrases": [
                        "righteous indignation"
                    ],
                    "target_lang_definitions": {
                        "de": "Berechtigt, verständlich oder moralisch begründet (insbesondere bei Gefühlen wie Wut).",
                        "es": "Justificado, legítimo o comprensible, especialmente respecto a emociones como la ira."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gerecht",
                                "target_lang_sense_clarification": "angemessen oder durch die Umstände begründet"
                            },
                            {
                                "target_lang_word": "gerechtfertigt",
                                "target_lang_sense_clarification": "eine nachvollziehbare Berechtigung habend"
                            },
                            {
                                "target_lang_word": "berechtigt",
                                "target_lang_sense_clarification": "völlig verständlich und nachvollziehbar"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "justificado",
                                "target_lang_sense_clarification": "que tiene un fundamento legítimo o comprensible"
                            },
                            {
                                "target_lang_word": "justo",
                                "target_lang_sense_clarification": "merecido, legítimo y fundado en la razón"
                            },
                            {
                                "target_lang_word": "legítimo",
                                "target_lang_sense_clarification": "válido y moralmente razonable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415fa64a-5ecb-35a9-8e83-c94157a3cb6a",
                    "sense_definition": "Very large, significant, or impressive in size or amount.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He faced a <w>righteous</w> amount of paperwork after the project was finished.",
                            "target_lang_translations": {
                                "de": "Nach Abschluss des Projekts stand ihm ein <w>gehöriger</w> Berg an Papierkram bevor.",
                                "es": "Tuvo que afrontar una <w>tremenda</w> cantidad de papeleo una vez terminado el proyecto."
                            }
                        },
                        {
                            "text": "The storm caused a <w>righteous</w> mess in the garden that took all day to clean.",
                            "target_lang_translations": {
                                "de": "Der Sturm hinterließ ein <w>ordentliches</w> Chaos im Garten, dessen Beseitigung den ganzen Tag dauerte.",
                                "es": "La tormenta causó un desastre <w>monumental</w> en el jardín que llevó todo el día limpiar."
                            }
                        }
                    ],
                    "synonyms": [
                        "huge",
                        "massive",
                        "considerable"
                    ],
                    "common_phrases": [
                        "righteous mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to emphasize size."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sehr groß, beträchtlich oder gehörig an Umfang oder Ausmaß.",
                        "es": "Muy grande, considerable o impresionante en tamaño o cantidad (coloquial)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gehörig",
                                "target_lang_sense_clarification": "beträchtlich, ordentlich"
                            },
                            {
                                "target_lang_word": "ordentlich",
                                "target_lang_sense_clarification": "ziemlich viel, gewaltig"
                            },
                            {
                                "target_lang_word": "redlich",
                                "target_lang_sense_clarification": "umgangssprachlich: tüchtig, sehr groß"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tremendo",
                                "target_lang_sense_clarification": "muy grande o impresionante; descomunal"
                            },
                            {
                                "target_lang_word": "monumental",
                                "target_lang_sense_clarification": "de proporciones enormes"
                            },
                            {
                                "target_lang_word": "buen",
                                "target_lang_sense_clarification": "de tamaño o cantidad considerable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06c6da20-22fe-3174-ba21-e0ba0ebb86db",
                    "sense_definition": "Excellent, great, or very good.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>righteous</w> concert; the band played perfectly all night.",
                            "target_lang_translations": {
                                "de": "Das war ein <w>abgefahrenes</w> Konzert; die Band spielte den ganzen Abend über perfekt.",
                                "es": "Ese fue un concierto <w>genial</w>; la banda tocó a la perfección toda la noche."
                            }
                        },
                        {
                            "text": "He is a <w>righteous</w> guy who always helps his friends when they are in trouble.",
                            "target_lang_translations": {
                                "de": "Er ist ein <w>klasse</w> Kerl, der seinen Freunden immer hilft, wenn sie in Schwierigkeiten sind.",
                                "es": "Es un tipo <w>fenomenal</w> que siempre ayuda a sus amigos cuando están en problemas."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "awesome",
                        "great"
                    ],
                    "antonyms": [
                        "terrible"
                    ],
                    "common_phrases": [
                        "righteous dude"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in 1980s and 1990s youth culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Großartig, spitze oder erstklassig (Slang/Umgangssprache).",
                        "es": "Excelente, genial o formidable (jerga)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abgefahren",
                                "target_lang_sense_clarification": "umgangssprachlich: fantastisch, cool"
                            },
                            {
                                "target_lang_word": "echt spitze",
                                "target_lang_sense_clarification": "umgangssprachlich für großartig"
                            },
                            {
                                "target_lang_word": "klasse",
                                "target_lang_sense_clarification": "sehr gut, super"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "genial",
                                "target_lang_sense_clarification": "fantástico, excelente"
                            },
                            {
                                "target_lang_word": "chido",
                                "target_lang_sense_clarification": "excelente o muy bueno (México)"
                            },
                            {
                                "target_lang_word": "guay",
                                "target_lang_sense_clarification": "estupendo, genial (España)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3841d594-8556-34fc-8247-f0bc9ea4a931",
                    "sense_definition": "To make <w>righteous</w>; to justify or absolve from sin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theology suggests that faith is the only way to be <w>righteoused</w> before God.",
                            "target_lang_translations": {
                                "de": "Die Theologie legt nahe, dass der Glaube der einzige Weg ist, um vor Gott <w>gerechtfertigt zu werden</w>.",
                                "es": "La teología sugiere que la fe es la única manera de ser <w>justificado</w> ante Dios."
                            }
                        },
                        {
                            "text": "He sought to be <w>righteoused</w> through his acts of charity and prayer.",
                            "target_lang_translations": {
                                "de": "Er suchte durch seine Taten der Barmherzigkeit und des Gebets <w>Rechtfertigung</w> zu erlangen.",
                                "es": "Buscaba ser <w>absuelto</w> a través de sus actos de caridad y la oración."
                            }
                        }
                    ],
                    "synonyms": [
                        "justify",
                        "absolve",
                        "vindicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Gerecht machen; von Sünde freisprechen oder vor Gott rechtfertigen.",
                        "es": "Hacer justo a alguien; justificar o absolver de pecado (arcano/teológico)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rechtfertigen",
                                "target_lang_sense_clarification": "theologisch: vor Gott als gerecht erklären"
                            },
                            {
                                "target_lang_word": "lossprechen",
                                "target_lang_sense_clarification": "von Sünde oder Schuld befreien"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "justificar",
                                "target_lang_sense_clarification": "hacer justo o declarar libre de culpa ante Dios"
                            },
                            {
                                "target_lang_word": "absolver",
                                "target_lang_sense_clarification": "liberar de culpa o pecado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}