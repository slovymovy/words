                        "glosses": [
                            "Forêt ou bois de mélèzes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4eda4d-7590-4ce7-9a56-d411719965e7",
                                "sense_id": "f30897a2-32dd-332f-b9a3-b66fa4548dc0",
                                "text": "Les mélèzeins ou mélézins, sont des bois clairs, aérés, lumineux, qui contrastent avec l’ambiance sombre et un peu étouffante des forêts de sapins ou d’épicéas, deux autres habitués des régions de montagne."
                            },
                            {
                                "example_id": "ab16503d-24bd-42e8-afda-9d5afa2d66cc",
                                "sense_id": "f30897a2-32dd-332f-b9a3-b66fa4548dc0",
                                "text": "Les semis colonisent surtout les terrains nus ou décapés. Or, la lumière pénètre bien sous les mélézins et la végétation y est souvent abondante."
                            }
                        ]
                    }
                ],
