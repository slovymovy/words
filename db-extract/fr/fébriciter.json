                        "glosses": [
                            "Devenir fiévreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5633ae37-470e-412e-ab27-c478ea2fa900",
                                "sense_id": "f43663ad-2876-35f2-875d-5d335661ebb9",
                                "text": "En Afrique, quand le dégagement des miasmes est encore faible, l’Arabe se porte bien, tandis que le Français nouvellement débarqué commence à fébriciter."
                            },
                            {
                                "example_id": "e04ca190-0b30-4c28-a8a9-3b5470e88201",
                                "sense_id": "f43663ad-2876-35f2-875d-5d335661ebb9",
                                "text": "Fébriciter est la manière de réagir du paludéen (B.-Féraud) ; un trauma, le froid, le chaud réveilleront la fièvre."
                            }
                        ]
                    }
