                    },
                    {
                        "translation_id": "2e0b12b7-a102-4764-a9f8-f530fe404880",
                        "source_entry_id": "c7507a6b-71bb-3980-a6a0-46f124db10eb",
                        "source_sense_id": "cf9da183-a6da-3375-993f-3f1e1f1e8f18",
                        "source_sense_description": "Frau, die jemanden peinigt",
                        "target_lang_word": "bourrelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourrelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c135b9a-6df8-3f18-886b-415c7feed6df",
                                        "entry_id": "93958a51-d780-31ab-bce4-bdab8a273fc3",
                                        "glosses": [
                                            "Celle qui est chargée de l’exécution des peines."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87360519-d371-42e3-8544-4eebe75dad26",
                                                "sense_id": "2c135b9a-6df8-3f18-886b-415c7feed6df",
                                                "text": "… la faim, logée dans mon ventre, y tire — la bourelle ! — une corde qui m’étrangle comme un pendu !"
                                            },
                                            {
                                                "example_id": "a140c28d-2b45-41b6-82f4-f063b9367e1d",
                                                "sense_id": "2c135b9a-6df8-3f18-886b-415c7feed6df",
                                                "text": "La bourrelle était à l’origine de ce secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6110bf9-ede3-3606-932c-404ffdafeda8",
                                        "entry_id": "93958a51-d780-31ab-bce4-bdab8a273fc3",
                                        "glosses": [
                                            "Se dit d’une mère qui traite ses enfants avec une dureté excessive ou de toute femme tyrannique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d57c7b-6326-4645-be75-e3e38d40addc",
                                                "sense_id": "c6110bf9-ede3-3606-932c-404ffdafeda8",
                                                "text": "Quitter ma bourrelle et bénéficier de l’aisance matérielle, jouir du farniente à perpétuité avec pour seule condition de vivre en compagnie d’un garçon charmant, qui eût hésité ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6f9026e-a2bf-3240-8f6c-991077c60b84",
                                        "entry_id": "93958a51-d780-31ab-bce4-bdab8a273fc3",
                                        "glosses": [
                                            "Épouse d’un bourreau."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb9191d-aa3d-4723-9e82-6d24dfaa936e",
                                                "sense_id": "b6f9026e-a2bf-3240-8f6c-991077c60b84",
                                                "text": "Puis apparut la charrette des hautes-œuvres attelée d'un grand mulet noir amenant le condamné, un certain Jehan Grospiron, garçon jovial assis entre le bourreau et la bourrelle, celle-ci fort occupée à savonner la cravate de chanvre dont allait bientôt s'orner le col du mauvais bougre."
                                            },
                                            {
                                                "example_id": "e795d49e-21c5-4005-8b91-5c689c0e6b2d",
                                                "sense_id": "b6f9026e-a2bf-3240-8f6c-991077c60b84",
                                                "text": "Elle sait que si le bourreau épouse une condamnée, on la gracie. Mais elle sait aussi qu’être « bourrelle » est un affreux destin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bourrelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
