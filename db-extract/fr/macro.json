        "fr-extract.jsonl": [
            {
                "entry_id": "6a3965fd-d103-353d-92c9-60b0b09fa037",
                "word": "macro",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "51a6b0ff-2363-3fe9-beaa-f9a8c68cd90c",
                        "entry_id": "6a3965fd-d103-353d-92c9-60b0b09fa037",
                        "glosses": [
                            "En rapport avec la macrophotographie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d41a8ebc-e1c9-4b04-b6bc-19207af18e81",
                                "sense_id": "51a6b0ff-2363-3fe9-beaa-f9a8c68cd90c",
                                "text": "De nombreux objectifs sont capables de réaliser des mises au point rapprochées, mais seul un véritable objectif macro peut offrir un agrandissement grandeur nature ou avec un rapport d'au moins 1:1."
                            },
                            {
                                "example_id": "1712f89a-84de-49af-8457-f0f595c59353",
                                "sense_id": "51a6b0ff-2363-3fe9-beaa-f9a8c68cd90c",
                                "text": "Mettant l’accent sur le détail, les motifs et les textures, la photo macro peut offrir des résultats intéressants et uniques."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                "word": "macro",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f421d341-326e-4d5a-b6c1-532257beff6d",
                        "entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "macros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5157911-b06f-311a-ad38-9c8aad42eff1",
                        "entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                        "glosses": [
                            "Instruction destinée à un préprocesseur, pour lui permettre d’inclure sur commande d’autres instructions dans la source d’un programme de manière paramétrée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "75e6b236-5099-3d0a-b404-7a954ee90287",
                        "entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                        "glosses": [
                            "Petite routine informatique permettant dans certains logiciels d’automatiser une tâche répétitive."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2f199277-0294-4c39-9110-129865640021",
                                "sense_id": "75e6b236-5099-3d0a-b404-7a954ee90287",
                                "text": "Est-ce une nouvelle étape de votre carrière professionnelle où, n’étant pas informaticien, vous êtes amené à programmer des macros ou des scripts complexes ?"
                            },
                            {
                                "example_id": "507f1f03-7c91-425a-981a-09231bfdbc38",
                                "sense_id": "75e6b236-5099-3d0a-b404-7a954ee90287",
                                "text": "Sur mon logiciel Microsoft Excel, lorsque j’exécute cette macro, mon document est mis en page de manière automatique."
                            },
                            {
                                "example_id": "95390c01-2f3d-4121-8611-6a18eecb8c26",
                                "sense_id": "75e6b236-5099-3d0a-b404-7a954ee90287",
                                "text": "Cette macro redimensionne toutes les feuilles de mon document, et insère le logo de mon entreprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4af7551-4768-39c6-936f-5dd43addcdfb",
                        "entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                        "glosses": [
                            "Macrophotographie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7a82b3b3-f881-4a2c-953e-e866a605e1b2",
                                "sense_id": "c4af7551-4768-39c6-936f-5dd43addcdfb",
                                "text": "Le choix de l'ouverture affecte la profondeur de champ, c'est-à-dire la netteté du sujet de votre macro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "925cf7b7-f4ca-4837-96be-ad211fce1728",
                        "source_entry_id": "42ab1d40-50b8-30f5-9fc3-486db6c797b3",
                        "target_lang_word": "macro",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10a41c28-b5d8-327b-871f-3492d484bf65",
                                        "entry_id": "558ef3c2-7be3-3525-8467-d7a014b26fd2",
                                        "glosses": [
                                            "Very large in scope or scale."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c729f65-f0f8-4559-9fc2-869936651ab0",
                                                "sense_id": "10a41c28-b5d8-327b-871f-3492d484bf65",
                                                "text": "Crumb's sexual fixation on gigantic women's legs became a major feature of his most celebrated images. Despite the common themes among macrophiles, Ed Lundt believes that no two macro fantasies are quite alike […]"
                                            },
                                            {
                                                "example_id": "22706f67-3c17-40b2-9d13-415350fd4c90",
                                                "sense_id": "10a41c28-b5d8-327b-871f-3492d484bf65",
                                                "text": "But simply turning off iCloud backups was an incomplete solution. The macro problem, I wrote in my column last year, is that people have sacrificed ownership and control of their data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48769017-1083-3e3c-93a9-4b7ef72d0bf2",
                                        "entry_id": "558ef3c2-7be3-3525-8467-d7a014b26fd2",
                                        "glosses": [
                                            "Clipping of macrobiotic."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33d3e9e-b23b-4753-98b6-284a50355a67",
                                                "sense_id": "48769017-1083-3e3c-93a9-4b7ef72d0bf2",
                                                "text": "While there are many aspects to this way of living, the actual “diet” focuses on whole foods, consumed in traditional methods. A typical macro bowl includes grains, beans, steamed veggies, sea vegetables, and fermented foods."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "macro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be3cea2-30a0-314a-919e-9f38896e0f12",
                                        "entry_id": "972ec9c9-9155-31af-88b9-ef72d71cab0e",
                                        "glosses": [
                                            "Clipping of macronutrient."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "countable",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da90937-b346-4c5e-8a1b-f61664192595",
                                                "sense_id": "7be3cea2-30a0-314a-919e-9f38896e0f12",
                                                "text": "Don't be afraid to include some “unhealthy” foods in your diet. The overarching rule about foods is if it fits your macros (IIFYM), then you can eat it. That means you can eat chocolate, ice cream, and many other indulgences […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26411f64-4b7e-3c26-810b-96f4134eef9e",
                                        "entry_id": "972ec9c9-9155-31af-88b9-ef72d71cab0e",
                                        "glosses": [
                                            "Clipping of macroeconomics."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26b3d059-5279-499e-b987-f4864255db71",
                                                "sense_id": "26411f64-4b7e-3c26-810b-96f4134eef9e",
                                                "text": "On Monday, chipmaker Nvidia (NVDA) cut its sales outlook for the fourth quarter, citing “deteriorating macroeconomic conditions, particularly in China.” Last week, Intel’s (INTC) CEO also noted that “trade and macro concerns, especially in China, have intensified.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c67f2c-0cbf-37a3-bb05-26e35cf1f7c7",
                                        "entry_id": "972ec9c9-9155-31af-88b9-ef72d71cab0e",
                                        "glosses": [
                                            "Ellipsis of macro lens."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "colloquial",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c83ed99-68fc-4335-a9db-75164626a014",
                                                "sense_id": "e6c67f2c-0cbf-37a3-bb05-26e35cf1f7c7",
                                                "text": "Most macros are made by camera manufacturers to fit their cameras"
                                            },
                                            {
                                                "example_id": "951e1395-21f5-4a12-9aa3-1333e86d7d8d",
                                                "sense_id": "e6c67f2c-0cbf-37a3-bb05-26e35cf1f7c7",
                                                "text": "The lens was a macro, capable of everything from an “infinity shot” to a close-up in which a single fingerprint filled the entire frame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "macro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                        "entry_id": "0c8c17af-1596-3587-822d-383b3a7570aa",
                                        "glosses": [
                                            "A comparatively human-friendly abbreviation of complex input to a computer program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a09acac-3731-418d-8de0-73ac1e0af086",
                                                "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                                "text": "The preprocessor expands any embedded macros into source code before it is compiled."
                                            },
                                            {
                                                "example_id": "aa31d3cb-069d-40c1-b329-6cda237b6331",
                                                "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                                "text": "There's also a spam filter in the code now, so if someone attempts to flood people's screens with macros or a bot, everything after the first few lines is thrown away."
                                            },
                                            {
                                                "example_id": "67749f56-d19d-49cf-80b6-2da2dd96861d",
                                                "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                                "text": "A recurring theme in this book is to record an Excel macro and then show how to adapt the recorded code."
                                            },
                                            {
                                                "example_id": "f442fb3c-68eb-48ee-a032-46ee812482f3",
                                                "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                                "text": "Languages belonging to the Lisp family make use of macros to provide support for compile-time metaprogramming."
                                            },
                                            {
                                                "example_id": "bd2ac02a-b4af-42e9-9827-43fbee4be68d",
                                                "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                                                "text": "This should make intuitive sense because the purpose of the macro system is to transform code from one valid form to a final form, such as inserting logic automatically that would otherwise have been written explicitly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "macro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "959c56c4-3bd1-3eba-b4b0-9ade64370108",
                                        "entry_id": "0705f636-c936-3af0-b16b-849ab4b5d285",
                                        "glosses": [
                                            "Short for macromanagement."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
