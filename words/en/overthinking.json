                            }
                        },
                        {
                            "text": "Constant <w>overthinking</w> can lead to unnecessary stress and anxiety.",
                            "target_lang_translations": {
                                "pl": "Ciągłe <w>nadmierne analizowanie</w> może prowadzić do niepotrzebnego stresu i niepokoju."
                            }
