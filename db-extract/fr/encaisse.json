        "fr-extract.jsonl": [
            {
                "entry_id": "37fe1cdb-5b8e-37c9-a540-95c8252fa4e6",
                "word": "encaisse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5acb849c-5d2d-4bd1-b8db-832878f4496a",
                        "entry_id": "37fe1cdb-5b8e-37c9-a540-95c8252fa4e6",
                        "tags": [
