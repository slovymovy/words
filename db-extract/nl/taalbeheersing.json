                ],
                "senses": [
                    {
                        "sense_id": "cdaa1bb6-a797-32c4-9fdd-94839293039b",
                        "entry_id": "46eb9714-f414-3212-908a-79c3bebe0ca2",
                        "glosses": [
                            "vermogen zich te kunnen uitdrukken in een of meer talen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d232184e-705a-4c97-a93f-e21fe4814511",
                                "sense_id": "cdaa1bb6-a797-32c4-9fdd-94839293039b",
                                "text": "Een goede taalbeheersing bezitten."
                            },
                            {
                                "example_id": "7fb37f86-4417-4f8a-a5ce-377bb33585b3",
                                "sense_id": "cdaa1bb6-a797-32c4-9fdd-94839293039b",
                                "text": "De dichter zat bepaald niet in een ivoren toren; hij beoefende een kunst die iedereen verstond, alleen was hij de uitblinker. Hij kon met zijn toehoorders spelen, appelleren aan hun kennis en interesses; de keus van zijn onderwerpen hoefde bepaald niet origineel, niet nieuw te zijn en de vorm waarin hij ze goot lag zelfs traditioneel vast; nee, hij moest voornamelijk opvallen door een persoonlijke behandeling van bekende stof en knappe taalbeheersing."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2f38c7b-f953-3edf-bde0-d0c6d1567453",
                        "entry_id": "46eb9714-f414-3212-908a-79c3bebe0ca2",
                        "glosses": [
                            "studie van de juiste aanwending van taal (als vak)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b45407-4b93-4e22-8f16-9994a4ff43eb",
                                "sense_id": "f2f38c7b-f953-3edf-bde0-d0c6d1567453",
                                "text": "Taalbeheersing als vak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d9f5521-a2ee-43d1-b779-15c4fb00f731",
                        "source_entry_id": "46eb9714-f414-3212-908a-79c3bebe0ca2",
                        "source_sense_id": "cdaa1bb6-a797-32c4-9fdd-94839293039b",
                        "source_sense_description": "het vermogen zich te kunnen uitdrukken in een of meer talen",
                        "target_lang_word": "Sprachbeherrschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachbeherrschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                        "entry_id": "25b56b7f-687d-3de0-86af-9e4835080a12",
                                        "glosses": [
                                            "Fähigkeit, eine Sprache angemessen zu verwenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee24ddff-4a37-461c-9855-a4b006950834",
                                                "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                                "text": "„Viele solcher Register (mit ihren jeweils besonderen strukturellen Präferenzen und ihrem manchmal speziellen Wortschatz) gehören zur Sprachbeherrschung, und keineswegs alle fallen unter die Literatur-, Schrift-, Alltags- oder gehobene Umgangssprache, keineswegs alle sind in den großen Grammatiken beschrieben.“"
                                            },
                                            {
                                                "example_id": "e6ef7246-7fa3-4daf-ac5c-c488d44ee28d",
                                                "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                                "text": "„Die Unterschiede im Bewußtsein und in der Sprachbeherrschung der Kommunikationspartner bilden also einerseits - wenn sie ein bestimmtes Maß überschreiten - ein Hemmnis für die Verständigung, andererseits stellen sie einen wichtigen Faktor für das Zustandekommen und für die Gestaltung von Kommunikationsprozessen dar.“"
                                            },
                                            {
                                                "example_id": "c17f218e-082d-4d42-a677-ab3d0369b30d",
                                                "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                                "text": "„Die sprachlichen Repertoires der Bielerinnen und Bieler sind geprägt durch unterschiedliche Erwerbszeitpunkte und Erwerbsarten, die zu unterschiedlichen Sprachbeherrschungen führen.“"
                                            },
                                            {
                                                "example_id": "23f2bb90-086a-4513-ab9c-f76f1021795c",
                                                "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                                "text": "„Auch im Sprachlichen kann die Anzahl von Sprachbeherrschungen nicht die Einwurzelung in einer Muttersprache ersetzen.“"
                                            },
                                            {
                                                "example_id": "6ae7404c-1f8f-4288-8af8-2ca66e6f2d19",
                                                "sense_id": "186de751-f206-3194-a771-faf21c80f3b6",
                                                "text": "„Insulation setzt die Beherrschung von bikulturellen Repertoires, im sprachlichen Bereich von zumindest zwei „Registern\" (Sprachbeherrschungen) voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
