                "senses": [
                    {
                        "sense_id": "b7264b6f-cd2e-3df2-869f-3ab4b348ac60",
                        "entry_id": "18119afd-3607-3a5d-97db-c82c72b6fb4e",
                        "glosses": [
                            "The characteristic or state of being perfunctory."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a852f9c5-70aa-4e13-8d54-ba7f84f4489e",
                                "sense_id": "b7264b6f-cd2e-3df2-869f-3ab4b348ac60",
                                "text": "When at dusk she reached the Melchester station her husband was there to meet her, but in his perfunctoriness and her preoccupation they did not see each other, and she went out of the station alone."
                            },
                            {
                                "example_id": "7cb69dcc-826a-4849-b2c9-2ec0c7da6dc0",
                                "sense_id": "b7264b6f-cd2e-3df2-869f-3ab4b348ac60",
                                "text": "Claudia accomplished some shopping in the spirit of perfunctoriness that robs even new bonnets of their bloom."
                            },
                            {
                                "example_id": "262f4e7e-c6bb-466d-8429-2c970fd0a419",
                                "sense_id": "b7264b6f-cd2e-3df2-869f-3ab4b348ac60",
                                "text": "His hard-core images are delivered with a ho-hum perfunctoriness that often enervates his surfaces. . . . [H]is orgies are inert."
                            }
                        ]
                    }
                ],
