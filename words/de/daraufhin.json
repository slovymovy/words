            "senses": [
                {
                    "sense_id": "9cb81d9d-56c8-3940-9a99-116d5f4351a0",
                    "sense_definition": "in direktem zeitlichen Anschluss; unmittelbar nach einem Ereignis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitliche_folge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich zeigte ihm meine Ideen und <w>daraufhin</w> schlug er mir ein Geschäft vor."
                        },
                        {
                            "text": "Der Minister beendete seine Rede, <w>daraufhin</w> verließen die Journalisten den Saal."
                        }
                    ],
                    "synonyms": [
                        "danach",
                        "im Anschluss"
                    ],
                    "antonyms": [
                        "davor",
                        "zuvor"
                    ]
                },
                {
                    "sense_id": "c884e568-280e-3da0-aac1-6e16cec6c943",
                    "sense_definition": "als Folge oder Konsequenz von etwas; aus diesem Anlass",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kausale_folge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Firma machte große Verluste und <w>daraufhin</w> verloren viele Angestellte ihre Arbeit."
                        },
                        {
                            "text": "Er hatte starke Schmerzen und rief <w>daraufhin</w> sofort einen Notarzt."
                        }
