                        "glosses": [
                            "Tourner en de petits ronds, en de nombreux va-et-vient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76431a14-d99b-4a7f-935a-3bed912dfbbc",
                                "sense_id": "c254de42-a843-3b36-b82c-4d48ac90ef6b",
                                "text": "Déjà on a failli s’emmouscailler sur le banc de Podensac, alors, par là-haut, quand ça commencera à tournicailler, putain de moine ! on risque de s’esbougner les berles !"
                            },
                            {
                                "example_id": "b79ab47c-948a-40b5-a124-d66c9c303aa3",
                                "sense_id": "c254de42-a843-3b36-b82c-4d48ac90ef6b",
                                "text": "Parce que ça tournicaille un peu dans ma tête."
                            }
                        ]
                    }
