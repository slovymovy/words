                ],
                "senses": [
                    {
                        "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                        "entry_id": "4d46cfb4-ad9f-3368-9fd6-85c8fe5e7895",
                        "glosses": [
                            "fehlende Stelle (= Loch) in einer Mauer/Wand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb12fec5-4469-40c7-9598-12279e6683d3",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "Rotkehlchen: „Im Frühling sucht der Vogel ein geeignetes Brutrevier in Bodennähe. Das Nest muss gut versteckt sein, in dichtem Gestrüpp oder in einem Mauerloch.“"
                            },
                            {
                                "example_id": "e95eef1c-92a4-465e-8291-68066c79d2af",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "Rotkehlchen: „Das kleine Kerlchen mit der charakteristisch orange-rot gefärbten Kehle ist ein Frühaufsteher und nistet gern in bodennahen Höhlen oder Mauerlöchern.“"
                            },
                            {
                                "example_id": "51ffb0fd-7bca-4776-8831-145b9fd2874f",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "„Der Mauersegler ist ein weit verbreiteter Brutvogel in Deutschland. Er brütet in Städten und Dörfern unter Dächern und in Mauerlöchern, seltener auch in ausgedehnten Waldgebieten in Baumhöhlen.“"
                            },
                            {
                                "example_id": "955826a8-63d5-4376-920c-3a579698b231",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "„Moderne Hochhausbauten weisen meist zu wenig Mauerlöcher und Höhlungen auf, um dem Turmfalken als Nistmöglichkeit zu dienen.“"
                            },
                            {
                                "example_id": "406beca9-9c4a-4557-af85-965af5a78adb",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "„Der Hausrotschwanz zum Beispiel, der als Höhlenbrüter in hohlen Bäumen lebt, weicht in der Stadt auf Bretterverschalungen, Fassadenlöcher oder Mauerlöcher aus.“"
                            },
                            {
                                "example_id": "fb99993e-e515-48ef-b590-1578e4f0727c",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "„Auch in Baden-Württemberg sieht es schlecht aus für die Vögel, die ihre Jungen in Baumhöhlen oder Mauerlöchern aufziehen. Gerade bei Kohl- und Blaumeisen gibt es in Baden-Württemberg einen Rückgang von über 40 Prozent.“"
                            },
                            {
                                "example_id": "9d3be919-2a8a-4660-b9c0-8aa191c24937",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "[Schlingnattern:] „Wenn die Nächte dann kälter werden zieht sie sich in ein Loch zurück, das ca. 80 Zentimeter tief ist. Das können Mauerlöcher, Felsspalten oder Mauslöcher sein.“"
                            },
                            {
                                "example_id": "40789e02-f705-4267-9d8c-b4cbbbc70efe",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "[Ein Junge versucht,] „durch ein Mauerloch aus dem Ghetto von Warschau zu fliehen. Mit dem Kopf ist er bereits draußen, als die Bewacher ihn erwischen.“"
                            },
                            {
                                "example_id": "e7002133-0701-4c69-b1b7-8537e93fba62",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "„Auf der anderen Straßenseite wird ein Hochhaus entkernt, aus grauen Mauerlöchern quillt Presslufthammerlärm,“ […]."
                            },
                            {
                                "example_id": "3605f7d1-be67-4cb1-a208-af5ae3634b5b",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "[Schlagzeile:] „Diebe drangen durch Mauerloch ein“"
                            },
                            {
                                "example_id": "5b8e0457-536d-4e60-a1aa-11e863123b6a",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "Geocaching: „Die Beute, genannt Cache (\"Käsch\"), kann überall verborgen sein: im Mauerloch einer Burgruine, in einem hohlen Baumstumpf, unter einem Stein.“"
                            },
                            {
                                "example_id": "36049033-b823-4c9f-9ee1-76fd2246fb8e",
                                "sense_id": "6ea9a055-1e55-327c-a56a-ca1b0eb0a31f",
                                "text": "[Berliner Mauer am 24.12.1989:] „Seit dem 12. November, als sich Momper und Krack am frisch aufgebrochenen Mauerloch am Potsdamer Platz die Hände schüttelten, haben sich die beiden Bürgermeister mehrfach getroffen“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
