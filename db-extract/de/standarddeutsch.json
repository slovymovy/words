                ],
                "senses": [
                    {
                        "sense_id": "dba30d7c-0b23-3bca-a22a-b243c5650c34",
                        "entry_id": "dcfe63cd-fdc8-3200-90e8-6b4c9f9b4a1e",
                        "glosses": [
                            "die Sprachformen des Deutschen, die zu keinem Dialekt, zu keiner Fachsprache und nicht zur Umgangssprache gehören; die Standardsprache des Deutschen"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "0f26bd92-fe34-4cba-99f3-01b19afa01cb",
                                "sense_id": "dba30d7c-0b23-3bca-a22a-b243c5650c34",
                                "text": "„Der Sprecher entstammt einer sprachlich gemischten Familie, in welcher der Vater nur Niederdeutsch, die Mutter nur Standarddeutsch sprach.“"
                            },
                            {
                                "example_id": "3d609e41-1681-44dc-aa20-f510eda0e8aa",
                                "sense_id": "dba30d7c-0b23-3bca-a22a-b243c5650c34",
                                "text": "„Die Mischung berechtigt dazu, von einer für das geschriebene Standarddeutsche repräsentativen Textmenge zu sprechen.“"
                            },
                            {
                                "example_id": "809261c0-86d5-4501-84bb-ded4f2636da0",
                                "sense_id": "dba30d7c-0b23-3bca-a22a-b243c5650c34",
                                "text": "„Mit dem in Abschnitt 1.3 charakterisierten Berichtskorpus B ist der Anspruch verbunden, Aussagen über Zahl und Status von Anglizismen im geschriebenen Standarddeutschen zu ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
