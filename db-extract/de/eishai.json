                        "sense_id": "e8d8f837-2b7d-327c-b947-7edb93f49df7",
                        "entry_id": "d173c08c-28a0-3e10-8a6f-21d36ccf509e",
                        "glosses": [
                            "langlebige Haiart, die vor allem in den arktischen Gewässern des Nordatlantiks vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd83bd2-be27-4900-9581-a8edef8561d7",
                                "sense_id": "e8d8f837-2b7d-327c-b947-7edb93f49df7",
                                "text": "„Der Grönlandhai oder Eishai (Somniosus microcephalus) lebt im Nordatlantik und im Nordpolarmeer und erreicht eine Größe von weit über fünf Metern.“"
                            },
                            {
                                "example_id": "0e300f3f-278d-4734-b7a9-5261f8ab5345",
                                "sense_id": "e8d8f837-2b7d-327c-b947-7edb93f49df7",
                                "text": "„Eishaie können bis zu acht Meter lang werden, womit sie die größten Fische in arktischen Gewässern sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
