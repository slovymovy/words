                    {
                        "sense_id": "11366d4c-8bcd-3a3b-9d30-3cd4a0028c19",
                        "entry_id": "ca7e9f65-1e44-3e02-a3e2-0a578111c4fe",
                        "glosses": [
                            "Ébouriffé, échevelé."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "873ba39f-63f8-42ad-9228-c6602e4e3354",
                                "sense_id": "11366d4c-8bcd-3a3b-9d30-3cd4a0028c19",
                                "text": "Je devais ressembler à un poulet mal déplumé enrobé de Shake’n Bake au calcium et à la neige sale. Les cheveux couettés droits sur la tête comme une crête de coq."
                            },
                            {
                                "example_id": "13752cf9-d240-4d2e-920a-ea4de5bab01a",
                                "sense_id": "11366d4c-8bcd-3a3b-9d30-3cd4a0028c19",
                                "text": "J’étais toute couettée, j’étais pas belle. Après ça, j’avais tout le temps du vieux linge quétaine... les bas bruns. Tsé. Toutes sortes de cochonneries."
                            },
                            {
                                "example_id": "a5784161-2f4c-4735-b1cb-16b7c4b80a8b",
                                "sense_id": "11366d4c-8bcd-3a3b-9d30-3cd4a0028c19",
                                "text": "C’est ce sentiment de se lever un matin, couetté de la veille, encore dans ton lit un peu décriss et réaliser que ce serait le fun avoir une personne à tes côtés pour passer ton surplus d’amour non réclamé."
                            }
                        ]
                    }
