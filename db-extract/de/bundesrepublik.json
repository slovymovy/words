                ],
                "senses": [
                    {
                        "sense_id": "a78a4134-8bfe-3692-b9fc-2ce4b228321c",
                        "entry_id": "597ebf6b-53fc-3239-8b7e-994440ececcc",
                        "glosses": [
                            "Regierungsform, die auf einen Zusammenschluss teilsouveräner Staaten beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e5aeb0-092b-4780-86a7-b4b0d8430f06",
                                "sense_id": "a78a4134-8bfe-3692-b9fc-2ce4b228321c",
                                "text": "Typische Bundesrepubliken sind Deutschland, Österreich und die USA."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                        "entry_id": "597ebf6b-53fc-3239-8b7e-994440ececcc",
                        "glosses": [
                            "Bundesrepublik Deutschland"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "8182af95-3849-4758-a5f7-ac5a5e323199",
                                "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                                "text": "Die Bundesrepublik wird sich nicht am Krieg beteiligen."
                            },
                            {
                                "example_id": "bfcab7ca-9478-4512-8816-e3e8cc8914bc",
                                "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                                "text": "„Am 1. November […] hatte die DDR wieder visafreie Reisen in die ČSSR zugelassen; zwei Tage später hatte sie der Öffnung der tschechoslowakischen Grenze zur Bundesrepublik für Bürger der DDR zugestimmt.“"
                            },
                            {
                                "example_id": "a7f73262-8bd7-4432-894d-525dfc9f7acf",
                                "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                                "text": "„Er sollte auf den Straßen und Plätzen der Bundesrepublik zu großen spontanen Kundgebungen der jungen Menschen und des offenen Bürgertums für einen Neubeginn der verkrusteten Gesellschaft der Bundesrepublik führen.“"
                            },
                            {
                                "example_id": "de85d87d-6e6b-4d41-b164-38a3d879d37e",
                                "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                                "text": "„Ich versöhnte mich mit der Bundesrepublik, sie war nun einmal mein Land.“"
                            },
                            {
                                "example_id": "f6f772fe-6ed9-4855-b9b9-0ab6b6d9232e",
                                "sense_id": "d7b7032c-a0f7-3ff1-bb45-46629bffcb26",
                                "text": "„Aber es gab nun mal das deutsche Preußen, von dessen historischen Umfängen heute nur noch ein kleiner Teil zur Bundesrepublik gehört.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
