                    {
                        "translation_id": "5c775d25-7a47-4189-8f35-cd8a85440f93",
                        "source_entry_id": "c48fe5ff-5125-3e9a-aa1e-586282922926",
                        "source_sense_id": "a8234604-abbf-3b27-bf49-8abb8deeb890",
