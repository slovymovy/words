                        "examples": [
                            {
                                "example_id": "eea77b5c-84d9-4786-9cd0-4fac2848b03c",
                                "sense_id": "70a8cce1-c82b-3a14-8507-900220d1fe00",
                                "text": "Vous voulez bonjourer vos amis en arrivant par la vieille voie..."
                            },
                            {
                                "example_id": "d2966d04-c548-457e-ab71-7baa43642ff7",
                                "sense_id": "70a8cce1-c82b-3a14-8507-900220d1fe00",
                                "text": "En l’apercevant, ils cessèrent de causer, et ils le bonjourèrent avec courtoisie."
                            },
                            {
                                "example_id": "ff771379-49cd-407c-9f14-eb7382958122",
                                "sense_id": "70a8cce1-c82b-3a14-8507-900220d1fe00",
                                "text": "Il bonjoura gracieusement l’invitante, qui répondit par un grand sourire, et il s’installa devant son bol où France versa le café."
                            }
                        ]
                    }
