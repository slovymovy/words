                "senses": [
                    {
                        "sense_id": "33658555-b394-375c-a202-7449d5419288",
                        "entry_id": "41d256ec-863b-3e02-a6f0-b52a188842aa",
                        "glosses": [
                            "Gerät zum Bräunen der Haut mithilfe von UV-Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1ed953-23e1-4713-9af7-3cafb7e7a713",
                                "sense_id": "33658555-b394-375c-a202-7449d5419288",
                                "text": "„Der wichtigste äußere Faktor bei der Hautalterung ist die Einwirkung von UV-Strahlung, auch als Lichtalterung bezeichnet. […] Vor allem ausgiebige Sonnenbäder und Besuche im Solarium verstärken diese Form des Alterns.“"
                            },
                            {
                                "example_id": "e3ba6fe0-b90f-4567-84ab-d269c6171c84",
                                "sense_id": "33658555-b394-375c-a202-7449d5419288",
                                "text": "„Das ultraviolette Licht eines eingeschalteten Solariums spaltet kleine Mengen Sauerstoff der atmosphärischen Luft und bildet das instabile Ozon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
