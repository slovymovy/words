                        "examples": [
                            {
                                "example_id": "73134ebe-4869-4a12-84ec-80034475891a",
                                "sense_id": "e5fc7a44-46b2-3933-a242-71260e1431d8",
                                "text": "Er selbst wohnt in dem Haus, gemeinsam mit seiner Freundin, den Schwiegergeschwistern und der Schwiegermutter in spe.",
                                "translation": "He himself lives in the building, together with his girlfriend and the prospective siblings-in-law and mother-in-law.",
                                "english": "He himself lives in the building, together with his girlfriend and the prospective siblings-in-law and mother-in-law."
                            },
                            {
                                "example_id": "23495a1f-8d2e-42b8-8e54-e67479494b05",
                                "sense_id": "e5fc7a44-46b2-3933-a242-71260e1431d8",
                                "text": "2013, Lexikon des internationalen Films – Filmjahr 2012,\nDie Hochzeitsplaner des Schiffs denken an Scheidung, ein geheilter Krebspatient gönnt sich und seiner Frau eine Traumreise, zwei Schwiegergeschwister entdecken ihre Liebe füreinander.",
                                "translation": "The ship’s wedding planners are considering divorce, a cured cancer patient treats himself and his wife with a dream trip, two siblings-in-law discover their love for each other.",
                                "english": "The ship’s wedding planners are considering divorce, a cured cancer patient treats himself and his wife with a dream trip, two siblings-in-law discover their love for each other."
                            },
                            {
                                "example_id": "446b017f-a0fe-47e3-8437-6f626721dab0",
                                "sense_id": "e5fc7a44-46b2-3933-a242-71260e1431d8",
                                "text": "Unter „Großfamilie“ werden eventuell auch Tanten, Onkel, Cousins, Neffen, Nichten und Schwiegergeschwister verstanden.",
                                "translation": "Members of the extended family may include aunts, uncles, cousins, nephews, nieces, and siblings-in-law.",
                                "english": "Members of the extended family may include aunts, uncles, cousins, nephews, nieces, and siblings-in-law."
                            }
                        ]
