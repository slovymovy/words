                                "target_lang_word": "没劲",
                                "target_lang_sense_clarification": "俚语：无聊或令人失望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3c8373c-c759-33ce-9a2e-2f06129d993e",
                    "sense_definition": "Showing low activity or falling prices in a market or economy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The housing market is <w>weak</w> right now due to high interest rates.",
                            "target_lang_translations": {
                                "ru": "Рынок жилья сейчас <w>слаб</w> из-за высоких процентных ставок.",
                                "zh": "由于利率高，目前的房地产市场很<w>疲软</w>。"
                            }
                        },
                        {
                            "text": "Sales have been <w>weak</w> this quarter compared to last year.",
                            "target_lang_translations": {
                                "ru": "Продажи в этом квартале были <w>слабыми</w> по сравнению с прошлым годом.",
                                "zh": "与去年相比，本季度的销售额表现<w>低迷</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "strong"
                    ],
                    "common_phrases": [
                        "weak market",
                        "weak demand",
                        "weak currency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся низкой активностью или падением цен на рынке.",
                        "zh": "指市场或经济中活动低迷或价格下跌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о валюте, показателях"
                            },
                            {
                                "target_lang_word": "вялый",
                                "target_lang_sense_clarification": "о рынке, спросе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疲软",
                                "target_lang_sense_clarification": "经济或市场低迷"
                            },
                            {
                                "target_lang_word": "低迷",
                                "target_lang_sense_clarification": "行情不好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a2a313d-fd97-3f17-b2a5-e7ef52a1c7cf",
                    "sense_definition": "Not ionizing completely in a solution.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vinegar contains acetic acid, which is a <w>weak</w> acid.",
                            "target_lang_translations": {
                                "ru": "Уксус содержит уксусную кислоту, которая является <w>слабой</w> кислотой.",
                                "zh": "醋里含有乙酸，这是一种<w>弱</w>酸。"
                            }
                        },
                        {
                            "text": "A <w>weak</w> base does not fully dissociate in water.",
                            "target_lang_translations": {
                                "ru": "<w>Слабое</w> основание не полностью диссоциирует в воде.",
                                "zh": "<w>弱</w>碱在水中不能完全电离。"
                            }
                        }
                    ],
                    "antonyms": [
                        "strong"
                    ],
                    "common_phrases": [
                        "weak acid",
                        "weak base"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не полностью ионизирующийся в растворе (химия).",
                        "zh": "指在溶液中不能完全电离（化学）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "термин: слабая кислота/основание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弱",
                                "target_lang_sense_clarification": "化学术语：弱酸/弱碱"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}