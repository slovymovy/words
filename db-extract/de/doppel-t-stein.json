                "senses": [
                    {
                        "sense_id": "13de8c35-21f4-34fe-a384-3d8e036fddb2",
                        "entry_id": "b0c41b51-0f7f-3d9d-abd6-b0588f2b252c",
                        "glosses": [
                            "a kind of paving stone which is based on a cuboid form with a slim belly, like two letters T facing each other."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a0487981-9bcb-44b7-afba-f6b1c5ccaf3a",
                                "sense_id": "13de8c35-21f4-34fe-a384-3d8e036fddb2",
                                "text": "Von der Rechtsprechung anerkannt ist dies für Straßen, eine Makadamdecke auf einem Tankstellengelände, eine Hofpflasterung aus Betonformsteinen auf einem Schotterbett und einem Hofbelag aus Doppel-T-Steinen auf einer Kiestragschicht (vgl. BGH LM § 638 BGB Nr. 7; OLG Schleswig BauR 91, 463; BGH BauR 92, 502 und BGH NJW-RR 93, 592)."
                            }
                        ]
                    }
