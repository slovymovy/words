{
    "word_family": [
        "machinery",
        "machinist",
        "machinable",
        "machination",
        "mechanic",
        "mechanical",
        "mechanism",
        "mechanize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f41f8529-b5e4-395c-8aab-e7c5095cbb91",
                    "sense_definition": "A device that directs and controls energy, often in the form of movement or electricity, to produce a certain effect.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mechanical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory installed a new <w>machine</w> to speed up the production of car parts.",
                            "target_lang_translations": {
                                "ru": "Завод установил новую <w>машину</w>, чтобы ускорить производство автозапчастей."
                            }
                        },
                        {
                            "text": "Please do not leave the <w>washing</w> <w>machine</w> running while you are out of the house.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не оставляйте стиральную <w>машину</w> включенной, когда уходите из дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "engine"
                    ],
                    "common_phrases": [
                        "washing machine",
                        "vending machine",
                        "sewing machine",
                        "coffee machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, которое направляет и контролирует энергию, часто в форме движения или электричества, для получения определенного эффекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "механизм",
                                "target_lang_sense_clarification": "система деталей"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "техническое приспособление"
                            },
                            {
                                "target_lang_word": "станок",
                                "target_lang_sense_clarification": "промышленное оборудование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5827e8d7-77be-3bfa-a1a9-1aac473b62ba",
                    "sense_definition": "A computer or a specific piece of computing hardware.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to restart my <w>machine</w> because the software update requires a reboot.",
                            "target_lang_translations": {
                                "ru": "Мне нужно перезагрузить свою <w>машину</w>, так как обновление ПО требует перезапуска."
                            }
                        },
                        {
                            "text": "The developers are testing the new game on a high-end <w>gaming</w> <w>machine</w>.",
                            "target_lang_translations": {
                                "ru": "Разработчики тестируют новую игру на мощной игровой <w>машине</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gaming machine",
                        "virtual machine",
                        "local machine",
                        "search machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютер или конкретное вычислительное оборудование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "разговорное о компьютере"
                            },
                            {
                                "target_lang_word": "компьютер",
                                "target_lang_sense_clarification": "вычислительное устройство"
                            },
                            {
                                "target_lang_word": "ЭВМ",
                                "target_lang_sense_clarification": "электронно-вычислительная машина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2853f8f9-af45-3208-8ea7-729db1ebc7aa",
                    "sense_definition": "A person or organization that acts with extreme efficiency, single-mindedness, or lack of emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_efficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete trained so hard that he became a <w>running</w> <w>machine</w>.",
                            "target_lang_translations": {
                                "ru": "Атлет тренировался так усердно, что превратился в беговую <w>машину</w>."
                            }
                        },
                        {
                            "text": "The corporate office has turned into a cold <w>money-making</w> <w>machine</w> over the years.",
                            "target_lang_translations": {
                                "ru": "За эти годы корпоративный офис превратился в холодную <w>машину</w> по зарабатыванию денег."
                            }
                        }
                    ],
                    "common_phrases": [
                        "money-making machine",
                        "killing machine",
                        "well-oiled machine",
                        "political machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, действующие с предельной эффективностью, целеустремленностью или отсутствием эмоций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "переносное значение об эффективности"
                            },
                            {
                                "target_lang_word": "автомат",
                                "target_lang_sense_clarification": "о человеке, действующем механически"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b641ce0-7fe0-363a-a191-ca6b37ab4d7a",
                    "sense_definition": "An answering machine or a voicemail system.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to call her several times, but I just kept getting the <w>machine</w>.",
                            "target_lang_translations": {
                                "ru": "Я пытался дозвониться ей несколько раз, но постоянно попадал на <w>автоответчик</w>."
                            }
                        },
                        {
                            "text": "Please <w>leave</w> <w>a</w> <w>message</w> on the <w>machine</w> and I will call you back later.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте сообщение на <w>автоответчике</w>, и я перезвоню вам позже."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answering machine",
                        "leave a message"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to physical answering machines which are now largely replaced by digital voicemail."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоответчик или система голосовой почты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоответчик",
                                "target_lang_sense_clarification": "устройство для записи сообщений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                    "sense_definition": "A vehicle operated mechanically, such as a car, motorcycle, or airplane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot climbed into the cockpit of his <w>flying</w> <w>machine</w> and prepared for takeoff.",
                            "target_lang_translations": {
                                "ru": "Пилот забрался в кабину своего летательного <w>аппарата</w> и приготовился к взлету."
                            }
                        },
                        {
                            "text": "He spent the whole weekend in the garage working on his <w>machine</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные в гараже, работая над своей <w>машиной</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flying machine"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Common in early 20th-century literature to refer to cars or planes."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство с механическим управлением, такое как автомобиль, мотоцикл или самолет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "автомобиль"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "летательный или технический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fa9bc3b-cb6a-3a67-a922-c945e588e26b",
                    "sense_definition": "The organized group or system of special interests that controls a political party.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate struggled to win the primary without the support of the local <w>party</w> <w>machine</w>.",
                            "target_lang_translations": {
                                "ru": "Кандидату было трудно выиграть праймериз без поддержки местного партийного <w>аппарата</w>."
                            }
                        },
                        {
                            "text": "He was a veteran <w>machine</w> <w>politician</w> who knew exactly how to get the votes he needed.",
                            "target_lang_translations": {
                                "ru": "Он был опытным <w>партийным</w> политиком, который точно знал, как получить нужные голоса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political machine",
                        "party machine",
                        "machine politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная группа или система интересов, контролирующая политическую партию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "политическая или бюрократическая система"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "партийный или государственный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8868fd54-0666-3d9e-b302-f026cf079366",
                    "sense_definition": "A supernatural agency or being introduced into a literary work to resolve a plot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author used a divine <w>machine</w> to save the hero at the very last moment.",
                            "target_lang_translations": {
                                "ru": "Автор использовал божественную <w>машину</w>, чтобы спасти героя в самый последний момент."
                            }
                        },
                        {
                            "text": "Critics often dislike the use of a <w>deus</w> <w>ex</w> <w>machina</w> because it feels like a lazy resolution.",
                            "target_lang_translations": {
                                "ru": "Критикам часто не нравится использование приема «бог из <w>машины</w>», потому что это кажется ленивым решением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deus ex machina"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in classical literary criticism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверхъестественная сила или существо, вводимое в литературное произведение для разрешения сюжета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "в составе термина 'бог из машины'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1afb9cbd-b470-3612-a69d-970e79a8b743",
                    "sense_definition": "To shape, finish, or cut a material (especially metal) using machine-controlled tools.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician had to <w>machine</w> the steel block to very precise dimensions.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>обработать</w> стальной блок на станке до очень точных размеров."
                            }
                        },
                        {
                            "text": "It is difficult to <w>machine</w> <w>parts</w> made from such a hard titanium alloy.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вытачивать</w> детали из такого твердого титанового сплава."
                            }
                        }
                    ],
                    "common_phrases": [
                        "machine parts",
                        "precision machining"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать форму, отделывать или резать материал (особенно металл) с помощью станков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрабатывать на станке",
                                "target_lang_sense_clarification": "механическая обработка"
                            },
                            {
                                "target_lang_word": "вытачивать",
                                "target_lang_sense_clarification": "с помощью резца"
                            },
                            {
                                "target_lang_word": "фрезеровать",
                                "target_lang_sense_clarification": "с помощью фрезы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "014ac45c-ed58-3734-8a98-c5757c24a098",
                    "sense_definition": "To produce or manufacture something using machinery rather than by hand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These textiles are <w>machined</w> in large quantities to keep the costs low for consumers.",
                            "target_lang_translations": {
                                "ru": "Этот текстиль <w>изготавливается</w> машинным способом в больших количествах, чтобы снизить затраты для потребителей."
                            }
                        },
                        {
                            "text": "The company decided to <w>machine</w> the components in-house to ensure better quality control.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>производить</w> компоненты на собственном оборудовании, чтобы обеспечить лучший контроль качества."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить или изготавливать что-либо с помощью оборудования, а не вручную."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изготавливать машинным способом",
                                "target_lang_sense_clarification": "промышленное производство"
                            },
                            {
                                "target_lang_word": "шить на машинке",
                                "target_lang_sense_clarification": "о текстиле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}