                "senses": [
                    {
                        "sense_id": "dc7639fc-a8ce-3abd-828e-d597dbf11644",
                        "entry_id": "aa99b9ff-96f7-3f22-abf1-171dc9eeb80e",
                        "glosses": [
                            "Accompagné à droite, décalé à dextre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023ce2a6-5349-4652-9757-d4befe4f17ee",
                                "sense_id": "dc7639fc-a8ce-3abd-828e-d597dbf11644",
                                "text": "Adextré : nᵒ 1 ce terme s’emploie des figures qui en ont une ou plusieurs autres à leur côté dextre ; — nᵒ 2 nom d’une section héraldique excessivement rare qui produit un pal s’unissant au flanc dextre de l’écu (I, 31) (v. Senestré)."
                            },
                            {
                                "example_id": "0fd9f1d6-3daa-49b2-b21c-7b3d104f9ac1",
                                "sense_id": "dc7639fc-a8ce-3abd-828e-d597dbf11644",
                                "text": "Bost (du) d’Esch — Luxemb. D’or à un chêne de sin., englanté d’or, adextré d’une hure de sanglier de sa., mouv. du fût."
                            },
                            {
                                "example_id": "c00de719-4e56-47f8-9e10-ef1c44365b33",
                                "sense_id": "dc7639fc-a8ce-3abd-828e-d597dbf11644",
                                "text": "Amira — Bav. (An. 13 août 1810). D’azur, adextré de gu. ; l’azur ch. d’une gerbe d’arg., liée du même, accostée de deux épées d’or, posées en chev. et touchant la gerbe."
                            },
                            {
                                "example_id": "666794a9-2cb0-4741-9db9-d1b5e4641456",
                                "sense_id": "dc7639fc-a8ce-3abd-828e-d597dbf11644",
                                "text": "À partir du XVᵉ siècle, l’abbaye usa d’un sceau commun où était dessiné saint Ghislain, tenant une croix de la main gauche, adextré d’une aigle déployée et senestré d’un ours."
                            }
                        ]
                    }
