        "fr-extract.jsonl": [
            {
                "entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                "word": "sionisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fc4ecf38-0d2c-4b59-ab50-6c01ef628514",
                        "entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                        "tags": [
                            "plural"
                        ],
                        "form": "sionismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                        "entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                        "glosses": [
                            "Mouvement pour la fondation d’un centre spirituel, territorial ou étatique juif en Palestine, idéologie politique nationaliste apparue au XIXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10096f9f-510d-4462-a79c-35f5d062e10d",
                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                "text": "Comprendre le sionisme est devenu indispensable, non seulement à qui s'interroge sur la présence du peuple juif au cœur de l’histoire du XXᵉ siècle, mais pour éclairer les enjeux peut-être les plus décisifs du monde contemporain."
                            },
                            {
                                "example_id": "e36bbcc9-abc7-4a63-a886-13b22c71e8d6",
                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                "text": "La fin du XIXᵉ siècle, Théodore Herzl donne son sens précis à un mouvement politique et à une idéologie naissants : le sionisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "001fc6df-b96d-494e-9979-0bc144193304",
                        "source_entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                        "source_sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                        "target_lang_word": "Zionism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zionism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "492fb9ff-f379-3a42-a281-15cb1d2057d9",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "Jewish nationalism, the movement which supported first the establishment of a Jewish homeland and now supports the continuation of a Jewish state in the region of Palestine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07339c24-37fa-4158-99c8-d7d61696691d",
                                                "sense_id": "492fb9ff-f379-3a42-a281-15cb1d2057d9",
                                                "text": "These investigations indicate that although a large proportion of American Jews call themselves Zionists, their meanings of Zionism are closer to what some investigators have called pro-Israelism. According to the still common Israeli definition of a Zionist as one who views the Diaspora negatively and considers the settlement of Jews in Israel as essential, the vast majority of American Jews would not be considered Zionists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff13fcfc-be63-384f-b59c-c47f7f355a1f",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "A religion practiced throughout sub-Saharan Africa and most popular in Swaziland, consisting of a mixture of Protestantism and animism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aa4efdd-fc23-38ec-97b7-99c9e3740709",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "A Christian eschatological concept that links the migration of Jews to Palestine with apocalyptic events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06736346-9711-4133-8cda-dd2552619e2f",
                        "source_entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
