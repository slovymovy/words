                "senses": [
                    {
                        "sense_id": "16229f8e-91cc-31f1-a9cb-2b3c2303b1b0",
                        "entry_id": "c1c98cfb-ae30-3e91-9e6e-efa299ac73e0",
                        "glosses": [
                            "Donner un caractère rappelant YouTube, ou adapté à YouTube."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ebb8024-ece9-4f03-931d-3edd5dc09ebf",
                                "sense_id": "16229f8e-91cc-31f1-a9cb-2b3c2303b1b0",
                                "text": "Je préparerai bientôt un didacticiel pour « youtubiser » vos vidéos dans « Aide au forum »."
                            },
                            {
                                "example_id": "52d3e2f8-0ea3-40ce-8b6f-980b0c92772a",
                                "sense_id": "16229f8e-91cc-31f1-a9cb-2b3c2303b1b0",
                                "text": "L’industrie de l’audio-visuel s’est fait « youtubiser » et finalement « netflixiser »."
                            },
                            {
                                "example_id": "73fd267b-be9c-41e9-bdbd-5d28e6bd871f",
                                "sense_id": "16229f8e-91cc-31f1-a9cb-2b3c2303b1b0",
                                "text": "Ou comment youtubiser les Monty Python."
                            },
                            {
                                "example_id": "48e3fcea-d981-4138-8cdf-fa76d107df60",
                                "sense_id": "16229f8e-91cc-31f1-a9cb-2b3c2303b1b0",
                                "text": "Alors d’abord on se gamekultise, et maintenant on doit se youtubiser."
                            }
                        ]
                    }
