                "senses": [
                    {
                        "sense_id": "98da933d-9925-3826-a7ed-b62ebad09d93",
                        "entry_id": "66575882-8935-3e6a-ba86-215280f13c38",
                        "glosses": [
                            "Gruppe von Brauereien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c3905b-7dba-4714-a259-00b0f880534a",
                                "sense_id": "98da933d-9925-3826-a7ed-b62ebad09d93",
                                "text": "„Zuletzt hatte Karl Büche, der am 1. Oktober als Chef der Brau Union und als Vorstand bei Heineken abtritt, gegenüber der APA erklärt, er hätte sich doch eine etwas andere Übergabe an seinen holländischen Nachfolger am Ruder der Biergruppe vorgestellt.“"
                            },
                            {
                                "example_id": "ed437bf1-624f-4d1e-8fc4-99529c0ae978",
                                "sense_id": "98da933d-9925-3826-a7ed-b62ebad09d93",
                                "text": "„Mit der Stillegung der Berliner Kindl-Brauerei in Berlin und der Brinkhoff's-Brauerei in Dortmund sowie dem Abbau von 450 der insgesamt 5500 Arbeitsplätze will die größte deutsche Biergruppe die Zukunftsfähigkeit der anderen Betriebe an ihren 11 Braustandorten stärken.“"
                            },
                            {
                                "example_id": "e4498d21-4822-42fb-9a70-db2fef0133c1",
                                "sense_id": "98da933d-9925-3826-a7ed-b62ebad09d93",
                                "text": "„Nun ging die Bremer Traditionsfirma Beck & Co. für knapp 3,5 Milliarden Mark an die belgische Biergruppe Interbrew, weltweit die Nummer zwei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
