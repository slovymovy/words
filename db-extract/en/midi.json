                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e2d5b1de-84f2-44ea-94c6-40786f077662",
                                "sense_id": "1dfd7eed-cb8d-3de9-a655-e3994be71f31",
                                "text": "MIDI channel number 10 is reserved for percussion."
                            },
                            {
                                "example_id": "55cee87f-cc6f-45b0-ade1-522979dd5100",
                                "sense_id": "1dfd7eed-cb8d-3de9-a655-e3994be71f31",
                                "text": "The podules Acorn plans to release include network cards (for Econet and Ethernet), ROM cards containing application software, a MIDI (musical instrument digital interface) sound card, an extended I/O card, […]"
                            }
                        ]
                    }
                ],
                "translations": [],
