                    },
                    {
                        "translation_id": "a5d5fd2f-b902-4efd-9d9d-295232883aa1",
                        "source_entry_id": "9ed048fa-587e-389b-9a8d-75c8fea486ae",
                        "source_sense_id": "1cc35ab9-c34f-3b47-b515-668f83052f0d",
