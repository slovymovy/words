                ],
                "senses": [
                    {
                        "sense_id": "47092d96-93f4-365f-bb80-19a0b75ac7d8",
                        "entry_id": "d3f94ef1-9081-3a43-9395-b49206be9ffc",
                        "glosses": [
                            "medizinische Einrichtung zur längerfristigen Behandlung von Kranken/Süchtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77cc61a-7fac-4f04-9f5b-bb1047cbda55",
                                "sense_id": "47092d96-93f4-365f-bb80-19a0b75ac7d8",
                                "text": "„Wir beschließen, ihn sofort in eine Heilanstalt zu überführen.“"
                            },
                            {
                                "example_id": "31251ca1-b42a-4611-8931-26f4ea6637ec",
                                "sense_id": "47092d96-93f4-365f-bb80-19a0b75ac7d8",
                                "text": "„Die Heilanstalt war im Jahr 1844 von dem aus Linz am Rhein stammenden Psychiater Dr. Franz Richarz gegründet worden.“"
                            },
                            {
                                "example_id": "ec8213a7-24bd-480b-8e0b-7b8a4a038ae1",
                                "sense_id": "47092d96-93f4-365f-bb80-19a0b75ac7d8",
                                "text": "„Die Antipsychiater wandten sich nicht nur gegen Missstände in den Heil- und Pflegeanstalten und gegen die dortigen hierarchischen Strukturen, sie zielten vielmehr auf die medizinischen und psychopathologischen Konzeptionen der Psychiatrie, letztlich auf das psychisch Kranksein an sich ab.“"
                            },
                            {
                                "example_id": "b415e2ff-905f-4cd5-ad56-86e8b65980c1",
                                "sense_id": "47092d96-93f4-365f-bb80-19a0b75ac7d8",
                                "text": "„Dem Direktor einer Heilanstalt fällt auf, daß in letzter Zeit immer mehr Patienten nach ihren Ausgangsstunden mit gebrochenen Armen, Beinen und Schädeln eingeliefert werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
