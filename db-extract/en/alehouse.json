                ],
                "senses": [
                    {
                        "sense_id": "c8e0ee26-69c5-3fd9-ac19-c099e1f4b563",
                        "entry_id": "7ed9ea1e-d9f0-3966-8118-7546145cb32d",
                        "glosses": [
                            "A business, such as an inn or tavern, where ale is sold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7350248b-190e-436b-a92e-8e46e9db6b77",
                                "sense_id": "c8e0ee26-69c5-3fd9-ac19-c099e1f4b563",
                                "text": "Find him in a pulpit but twiſe in the yeare,\nAnd Ile find him fortie times in the ale-houſe taſting ſtrong beare."
                            },
                            {
                                "example_id": "3429b70f-e7cb-4b4e-8d0c-9d34de31dcfb",
                                "sense_id": "c8e0ee26-69c5-3fd9-ac19-c099e1f4b563",
                                "text": "But go to—carry thy roisterers elsewhere—to the alehouse if they list, and there are crowns to pay your charges—make out the day’s madness without doing more mischief, and be wise men to-morrow—and hereafter learn to serve a good cause better than by acting like ruffians."
                            },
                            {
                                "example_id": "7abbb49f-4919-411f-b4d8-9b655c7b4fb2",
                                "sense_id": "c8e0ee26-69c5-3fd9-ac19-c099e1f4b563",
                                "text": "Mention has been already made more than once, of a certain Dragon who swung and creaked complainingly before the village ale-house door."
                            }
                        ]
                    }
                ],
