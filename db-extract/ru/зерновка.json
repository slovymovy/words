                                "target_senses": [
                                    {
                                        "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                        "entry_id": "7c6e83f5-fb9d-3813-8737-41c03fe6112b",
                                        "glosses": [
                                            "Fruit sec typique des graminées, indéhiscent, dans lequel le péricarpe est soudé à l'unique graine qu'il contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d5d593-dcaf-467b-b32b-2d4146e9a667",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Les caryopses de blé et de maïs sont généralement appellés grains."
                                            },
                                            {
                                                "example_id": "ee35d047-717b-4ca8-84f7-2a77f9d7153b",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Tel est le cas de l’akène qui est un péricarpe non soudé aux téguments de la graine, et du caryopse qui est un péricarpe soudé aux téguments de la graine."
                                            },
                                            {
                                                "example_id": "f49a82e7-c931-4522-a90c-b797e166c14d",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Le grain des céréales est un caryopse nu ou vêtu de ses glumelles. Le blé, le maïs, le sorgho, le seigle et le triticale appartiennent au premier groupe; l’orge et l’avoine font partie du second."
                                            }
                                        ]
                                    }
