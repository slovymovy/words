                                        "glosses": [
                                            "A trainee, especially in a skilled trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2936ff0-95a2-41e3-afaf-6a0cd43e5dc6",
                                                "sense_id": "3dafdd5a-a2d8-31b5-981b-9c5c53f3f5d8",
                                                "text": "To this end a well-equipped and keenly-run apprentice training school has been in operation at Eastleigh since 1958 and here apprentices are given a good grounding in a number of trades, followed by a thorough training in the trade to which they become allocated."
                                            },
                                            {
                                                "example_id": "56313e36-e1c2-4490-af8a-86a0e31fd26e",
                                                "sense_id": "3dafdd5a-a2d8-31b5-981b-9c5c53f3f5d8",
                                                "text": "Scottish rail suppliers have told the Government that they can only reach their target of employing 500 apprentices if they are given a clear pipeline of work, rather than having to endure the current stop-go programme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24dbde39-b474-3e2e-9e55-1bff61988fad",
                                        "entry_id": "d09504d4-6f0d-3e77-8079-b5603155a3bf",
                                        "glosses": [
                                            "One who is bound by indentures or by legal agreement to serve a tradesperson, or other person, for a certain time, with a view to learn the art, or trade, in which his master is bound to instruct him."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff7c1d29-c7ca-3a34-a9a8-b9d7f9ae87b5",
                                        "entry_id": "d09504d4-6f0d-3e77-8079-b5603155a3bf",
                                        "glosses": [
                                            "One not well versed in a subject; a tyro or newbie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "apprentice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de2b2353-a2a7-3262-ac31-08513e1ac675",
                                        "entry_id": "0eaa0ed0-06ac-359e-ac48-c6f876970b25",
                                        "glosses": [
                                            "To put under the care and supervision of a master, for the purpose of instruction in a trade or business."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231873a2-12a5-4a43-99f8-bf3970dfb86e",
                                                "sense_id": "de2b2353-a2a7-3262-ac31-08513e1ac675",
                                                "text": "His father had apprenticed him to a silk merchant."
                                            },
                                            {
                                                "example_id": "222dda94-c325-4cd6-9016-5e89b2a80678",
                                                "sense_id": "de2b2353-a2a7-3262-ac31-08513e1ac675",
                                                "text": "He was apprenticed to a local employer."
                                            },
                                            {
                                                "example_id": "75d80ae6-8f16-4f9d-9e51-4e76afa98e1f",
                                                "sense_id": "de2b2353-a2a7-3262-ac31-08513e1ac675",
                                                "text": "Early in his career, Trump apprenticed himself to Roy Cohn, an unprincipled lawyer who taught the young Trump how to gain wealth and influence through ruthless bullying, profane braggadocio, opportunistic bigotry, baseless lawsuits, lying, and more lying.\nYet as Trump’s “fixer” with politicians, judges and mob bosses, Cohn remained utterly loyal to Trump and his father, Fred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d1e6a5-7b8b-3b32-bc6d-b6c212a4daaa",
                                        "entry_id": "0eaa0ed0-06ac-359e-ac48-c6f876970b25",
                                        "glosses": [
                                            "To be an apprentice to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b64a1f-5e00-404b-ab59-5831e8b27682",
                                                "sense_id": "c7d1e6a5-7b8b-3b32-bc6d-b6c212a4daaa",
                                                "text": "Joe apprenticed three different photographers before setting up his own studio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cad8aa5f-0b3e-4754-8333-049ea903f18b",
                        "source_entry_id": "9c4243ce-5480-30ab-a971-d551c2f375ee",
