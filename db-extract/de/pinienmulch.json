                ],
                "senses": [
                    {
                        "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                        "entry_id": "7a58ff90-bf52-3f27-9731-d8abd8baa1ba",
                        "glosses": [
                            "Substrat aus zerkleinerter Rinde des Pinienbaumes, das zur Bodenabdeckung genutzt wird"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "39545c6d-b386-4c8f-bf25-cefb0d303d0f",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Egal ob Stroh, Vlies, Kieselsteine, Muscheln oder Zeitungspapier: Pinienmulch bringt Mittelmeerflair in die Töpfe.“"
                            },
                            {
                                "example_id": "400012c6-f040-4ceb-9467-c99b765c2f36",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Als er seinen Umhang zurückschlug, strich eine kühle Brise über ihre Wangen, und der erdige Geruch nach Pinienmulch und Blumen umgab sie.“"
                            },
                            {
                                "example_id": "fdbadf6d-41ab-44bc-aa3a-3e613070f3f9",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Es war eine alte, aber sehr gepflegte Stallanlage; die Wände waren weiß verputzt, auf dem Kopfsteinpflaster lag Pinienmulch.“"
                            },
                            {
                                "example_id": "8a4816ef-70c1-4e65-9ab9-974ec430eac0",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Eine Dränage aus Blähton sowie das Abdecken mit Kokos-, Kakaoschalen-, Pinienmulch oder Strohhäcksel helfen, die Feuchtigkeit zu regulieren.“"
                            },
                            {
                                "example_id": "ccc666b4-f3b0-4eb8-8dfc-2f86b9896db1",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Darüber hinaus gibt es in der Ausstellung ein stilisiertes Birkenwäldchen, dessen Stämme ebenso, wie die Kiesaufschüttung oder der Pinienmulch haptische Erlebnisse garantieren, sowie Modelle, Fotos und Materialstudien.“"
                            },
                            {
                                "example_id": "df3c8fd6-a569-4774-a600-3ecbe8fe84dd",
                                "sense_id": "b739949c-b731-3096-8e18-2814984f9b2b",
                                "text": "„Insbesondere da, wo viel Laub hinfällt oder wo etwa Grasflächen mit Pinienmulch abgedeckt sind, brennt es hervorragend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
