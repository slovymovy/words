                ],
                "senses": [
                    {
                        "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                        "entry_id": "c94b7b4e-e91a-3c61-96bc-f847685a8e32",
                        "glosses": [
                            "messbarer Effekt eines Spielers oder einer Spielmannschaft, der aus dem Können und der Einsatzbereitschaft erwächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d796c8-9d1f-4e11-abce-863d2d66bb2c",
                                "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                                "text": "„Didaktische Spiele begünstigen die Entwicklung der Gemeinschaftsfähigkeit, sie zwingen zum gemeinsamen Spiel, auch zur Kontrolle des Spielverlaufs und der Spielleistungen der einzelnen Kinder, […].“"
                            },
                            {
                                "example_id": "189596e3-38f2-4179-b253-594e66aeaf4c",
                                "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                                "text": "„Besonders beliebt sind die Vitalitätsspiele, bei denen die Spielleistung von einem ununterbrochenen, rasend schnellen Betätigen des Joysticks abhängig ist.“"
                            },
                            {
                                "example_id": "c306a7d7-1500-4d3b-82e1-d1f664ed9ef3",
                                "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                                "text": "„Während Spielleistungen sowohl vom Lehrer als auch vom Schüler schwieriger zu beurteilen sind, […] sind die meß- und wertbaren Leistungen in den vorhin genannten Übungsbereichen allgemein verständlich und leicht zu klassifizieren.“"
                            },
                            {
                                "example_id": "23d9f830-112f-42ad-8d4d-fc9813a2ac12",
                                "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                                "text": "„Das animiert zu guten Trainingsleistungen und aktuell auch zu guten Spielleistungen - und damit zu guten Ergebnissen.“"
                            },
                            {
                                "example_id": "1469afa4-7062-417c-bdb2-4cc4ea2ddbbc",
                                "sense_id": "4a1fe581-7d31-3009-943f-f8178af587d2",
                                "text": "„Anlage- und entwicklungsbedingt akzentuiert sich die komplexe Spielleistung bei den einzelnen Spielern in spielgestaltender, in spielergänzender oder in kämpferischer Hinsicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
