                        "sense_id": "1531e06d-6477-30ba-9ac3-4c638cce8fcc",
                        "entry_id": "478637f8-7cb3-36e9-af07-19bf9369a883",
                        "glosses": [
                            "naturalna zdolność do posiadania potomstwa, zdolność do zajścia w ciążę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069fe352-24c2-4365-a770-973c33fd2712",
                                "sense_id": "1531e06d-6477-30ba-9ac3-4c638cce8fcc",
                                "text": "Poetka nigdy nie zaszła w ciążę, nie widziała siebie w roli matki. Biologiczną płodność przeciwstawiała płodności twórczej, którą o wiele bardziej ceniła"
