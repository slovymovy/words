                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6cfa551-2d57-47bb-9be2-0e95f4ebc45f",
                                "sense_id": "5c11e807-35c4-3cb5-bacf-e8a7afa5322a",
                                "text": "Cette somme…. promise à mon fils et à moi, sur quoi nous avons été si vilainement trompés par La Jarie"
                            },
                            {
                                "example_id": "b5d69940-425c-4f7f-aa7d-7852646e8915",
                                "sense_id": "5c11e807-35c4-3cb5-bacf-e8a7afa5322a",
                                "text": "Longepierre, avec tout son art, montra vilainement la corde, et se fit honteusement chasser"
                            },
                            {
                                "example_id": "595fde1a-5f69-41d0-9b31-32d662f1dff2",
                                "sense_id": "5c11e807-35c4-3cb5-bacf-e8a7afa5322a",
                                "text": "Sa peau, qui est tendue sur l’ossature comme une peau de tambour, n’est point blanche, mais vilainement jaune."
                            }
                        ]
                    }
