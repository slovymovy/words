                        "glosses": [
                            "A person who is not an immigrant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f89274-a8fb-4a48-8c66-4578ab42776d",
                                "sense_id": "20f87902-b2a8-315b-8b09-1cce57146441",
                                "text": "14 June 2018, 115th Congress 2D session\nBeginning on the date that is 5 years after an alien becomes a contingent nonimmigrant, if that alien retains status as a contingent nonimmigrant, then in applying section 245 of the Immigration and Nationality Act (8 U.S.C. 1255(a)) to the alien - (1) such alien shall be deemed to have been inspected and admitted into the United States"
                            },
                            {
                                "example_id": "7b764e1b-794a-4f68-a664-240f25fda771",
                                "sense_id": "20f87902-b2a8-315b-8b09-1cce57146441",
                                "text": "The administration’s actions, White wrote, “uniformly wreaked havoc not only on the lives of Plaintiffs here but on similarly situated F-1 nonimmigrants across the United States and continues do so.”"
                            },
                            {
                                "example_id": "6c905b1c-8440-4261-ae3f-486a6dcf11f5",
                                "sense_id": "20f87902-b2a8-315b-8b09-1cce57146441",
                                "text": "The State Department has required visa applicants to provide social media identifiers on immigrant and nonimmigrant visa application forms since 2019, a spokesperson said."
                            }
                        ]
                    }
