                        "sense_id": "02746d37-b51b-37df-90c4-1150b82981ad",
                        "entry_id": "36e74967-70b9-3547-9723-44a194893180",
                        "glosses": [
                            "Coup de pied en demi-volée par lequel un joueur de rugby tente d’envoyer le ballon par-dessus la barre horizontale du but de l’équipe adverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "804c9c67-2caa-440f-95ce-7ecc538cf07f",
                                "sense_id": "02746d37-b51b-37df-90c4-1150b82981ad",
                                "text": "Il a donné la victoire à son équipe en passant un drop à la dernière minute."
                            },
                            {
                                "example_id": "4337a68e-a777-402f-8267-5c0b6560efe7",
                                "sense_id": "02746d37-b51b-37df-90c4-1150b82981ad",
                                "text": "Jean Farré considéré comme un des demis d’ouverture les plus talentueux de sa génération, sa feinte de passe et son drop dominical sont devenus légendaires, qui ne sera malheureusement jamais sélectionné en équipe de France."
                            }
                        ]
                    }
                ],
