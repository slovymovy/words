    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9f4659f0-9a25-3e28-979e-930e0b3f7e62",
                    "sense_definition": "Een uitroep die wordt gebruikt om frustratie of teleurstelling uit te drukken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verdikke</w>, ik ben mijn sleutels alweer vergeten in de auto.",
                            "target_lang_translations": {
                                "fr": "<w>Zut</w>, j'ai encore oublié mes clés dans la voiture."
                            }
                        },
                        {
                            "text": "Het regent nu al de hele dag, <w>verdikke</w> nog aan toe.",
                            "target_lang_translations": {
                                "fr": "Il pleut depuis toute la journée, <w>mince alors</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verduiveld",
                        "drommels",
                        "verdraaid",
                        "verdikkeme"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une interjection utilisée pour exprimer la frustration, l'agacement ou la déception."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "zut",
                                "target_lang_sense_clarification": "Interjection courante et légère pour exprimer le mécontentement."
                            },
                            {
                                "target_lang_word": "mince",
                                "target_lang_sense_clarification": "Expression familière pour marquer une contrariété."
                            },
                            {
                                "target_lang_word": "diantre",
                                "target_lang_sense_clarification": "Interjection un peu désuète ou humoristique pour exprimer la surprise ou l'agacement."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22a07567-10ef-381f-95fe-98e763bdcd3a",
                    "sense_definition": "Enkelvoudige aanvoegende wijs van <w>verdikken</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
