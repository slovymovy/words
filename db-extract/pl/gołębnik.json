                                        "entry_id": "f524430a-8cf0-3017-99d4-f42d6ee696d8",
                                        "glosses": [
                                            "příbytek chovaných holubů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4781304-c856-40ed-9be8-640d66be6edd",
                                                "sense_id": "89db2428-84bf-3e01-865a-c6c43575ea81",
                                                "text": "Na dvoře stál bíle natřený holubník."
                                            },
                                            {
                                                "example_id": "067ce0d5-2783-4ddc-a50a-bfe2fc270555",
                                                "sense_id": "89db2428-84bf-3e01-865a-c6c43575ea81",
                                                "text": "Regulace holubů v holubníku probíhá tak, že holubům je část vajec odebírána a měněna za umělá."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3434f6dd-f2b8-3998-9dcf-632608d50526",
                                        "entry_id": "f524430a-8cf0-3017-99d4-f42d6ee696d8",
                                        "glosses": [
                                            "nepořádek, zpravidla týkající se nedodržování časového řádu, smluvených časů apod."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40a1a3ad-a407-4cd3-ae93-12b368b61bca",
                                                "sense_id": "3434f6dd-f2b8-3998-9dcf-632608d50526",
                                                "text": "Pan řídící zdvihl hlavu od novin: „Á, Kája! Kdepak jsi chodil, co? Myslíš, že je škola holubník, aby sis vyletěl, kdy se ti zlíbí? […]“"
                                            }
                                        ]
                                    }
                                ]
