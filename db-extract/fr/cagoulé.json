                                                "sense_id": "c034b9b7-dbc7-39a4-a1c8-2709364f5bff",
                                                "text": "Zur Party sollten alle maskiert erscheinen."
                                            },
                                            {
                                                "example_id": "3cc24c1d-2710-4bb4-87f5-1953c64c9009",
                                                "sense_id": "c034b9b7-dbc7-39a4-a1c8-2709364f5bff",
                                                "text": "Eine maskierte Person überfiel gestern Abend die Tankstelle."
                                            },
                                            {
                                                "example_id": "a0951d2b-cd84-41e4-9ed7-714ced419f04",
                                                "sense_id": "c034b9b7-dbc7-39a4-a1c8-2709364f5bff",
                                                "text": "Auch auf den Straßen sieht man von Tag zu Tag mehr freiwillig maskierte Menschen – der Mund- und Nasenschutz wird uns wohl länger begleiten."
                                            },
                                            {
                                                "example_id": "764f5e0f-0c18-4d1f-8b96-a99ab9e6398a",
                                                "sense_id": "c034b9b7-dbc7-39a4-a1c8-2709364f5bff",
                                                "text": "Am vergangenem Sonntag feierten kleine und große maskierte Narren im Gasthaus Zum Kirchenwirt in Altenmarkt bei Fürstenfeld den Fasching."
                                            },
                                            {
                                                "example_id": "e5a2f365-6c6b-46cd-a0c2-98629382d2a5",
                                                "sense_id": "c034b9b7-dbc7-39a4-a1c8-2709364f5bff",
                                                "text": "Der maskierte Schauspieler und die von ihm gespielte Figur des Ödipus scheinen sich gegenseitig zu kommentieren."
                                            }
