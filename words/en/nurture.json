{
    "word_family": [
        "nurturer",
        "nurturance",
        "nurturing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb122d22-1794-3c00-971f-82d85d0e9bd9",
                    "sense_definition": "The environmental influences that contribute to a person’s development, as opposed to hereditary factors (nature).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "development_influences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Psychologists often debate the relative importance of nature versus <w>nurture</w> in shaping human personality.",
                            "target_lang_translations": {
                                "ru": "Психологи часто спорят об относительной важности природы и <w>воспитания</w> в формировании человеческой личности."
                            }
                        },
                        {
                            "text": "Her artistic talent was a result of both genetic nature and a supportive <w>nurture</w> during her childhood.",
                            "target_lang_translations": {
                                "ru": "Ее художественный талант был результатом как генетической природы, так и поддерживающего <w>воспитания</w> в детстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "upbringing",
                        "raising",
                        "education"
                    ],
                    "common_phrases": [
                        "nature versus nurture",
                        "nature and nurture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влияние окружающей среды и воспитания на развитие человека, в противоположность наследственности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспитание",
                                "target_lang_sense_clarification": "влияние среды и заботы в противовес генам"
                            },
                            {
                                "target_lang_word": "влияние среды",
                                "target_lang_sense_clarification": "внешние факторы развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d6b0a2-8554-3784-9ecf-cfca6605fc16",
                    "sense_definition": "The act or process of encouraging the growth, development, or progress of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "care_and_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization is dedicated to the <w>nurture</w> of young musical talent across the country.",
                            "target_lang_translations": {
                                "ru": "Организация посвятила себя <w>взращиванию</w> молодых музыкальных талантов по всей стране."
                            }
                        },
                        {
                            "text": "Proper <w>nurture</w> of new ideas is essential for innovation within any business.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>развитие</w> новых идей имеет важное значение для инноваций в любом бизнесе."
                            }
                        }
                    ],
                    "synonyms": [
                        "training",
                        "education"
                    ],
                    "common_phrases": [
                        "nurture of talent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс содействия росту, развитию или прогрессу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взращивание",
                                "target_lang_sense_clarification": "таланта, идей или способностей"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "поддержка роста и прогресса"
                            },
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "содействие развитию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ac1ac2-c483-3793-ab3f-73a640f35449",
                    "sense_definition": "The act of nourishing, nursing, or providing tender care.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "care_and_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infant thrived under the constant, loving <w>nurture</w> of his mother.",
                            "target_lang_translations": {
                                "ru": "Младенец рос здоровым под постоянной, любящей <w>заботой</w> своей матери."
                            }
                        },
                        {
                            "text": "Without proper physical <w>nurture</w>, the young plants quickly withered and died.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего физического <w>ухода</w> молодые растения быстро завяли и погибли."
                            }
                        }
                    ],
                    "synonyms": [
                        "raising"
                    ],
                    "common_phrases": [
                        "loving nurture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забота, уход или выхаживание кого-либо с любовью и вниманием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "нежный уход и внимание"
                            },
                            {
                                "target_lang_word": "выхаживание",
                                "target_lang_sense_clarification": "заботливый уход за слабым или младенцем"
                            },
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "заботливое покровительство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0e654e7-34bc-3988-9e7d-141b240d432f",
                    "sense_definition": "That which nourishes; food or diet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers found wholesome <w>nurture</w> at the small village inn.",
                            "target_lang_translations": {
                                "ru": "Путешественники нашли здоровую <w>пищу</w> в небольшой деревенской гостинице."
                            }
                        },
                        {
                            "text": "They lacked meet <w>nurture</w> and suffered from severe malnutrition during the winter.",
                            "target_lang_translations": {
                                "ru": "Им не хватало подходящего <w>пропитания</w>, и зимой они страдали от сильного недоедания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of food or sustenance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что питает; пища, пропитание (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пища",
                                "target_lang_sense_clarification": "пропитание, еда"
                            },
                            {
                                "target_lang_word": "пропитание",
                                "target_lang_sense_clarification": "средства к существованию, пища"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfb93feb-49a0-3a2b-919e-f51a6c22a925",
                    "sense_definition": "To encourage, support, or foster the growth, development, or progress of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "foster_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good teacher knows how to <w>nurture</w> a student's natural curiosity.",
                            "target_lang_translations": {
                                "ru": "Хороший учитель знает, как <w>развивать</w> естественное любопытство ученика."
                            }
                        },
                        {
                            "text": "The government aims to <w>nurture</w> economic growth through strategic investments.",
                            "target_lang_translations": {
                                "ru": "Правительство стремится <w>стимулировать</w> экономический рост с помощью стратегических инвестиций."
                            }
                        }
                    ],
                    "synonyms": [
                        "foster",
                        "encourage",
                        "promote"
                    ],
                    "antonyms": [
                        "hinder",
                        "destroy"
                    ],
                    "common_phrases": [
                        "nurture growth",
                        "nurture talent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поощрять, поддерживать или способствовать росту, развитию или прогрессу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взращивать",
                                "target_lang_sense_clarification": "способствовать развитию таланта, интереса"
                            },
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "поддерживать рост или прогресс"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "поощрять экономический рост или идеи"
                            },
                            {
                                "target_lang_word": "лелеять",
                                "target_lang_sense_clarification": "бережно поддерживать надежду, мечту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9620e46d-01ed-382d-b41f-576aadc1464d",
                    "sense_definition": "To feed, nourish, or care for a young person, animal, or plant during its growth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foster_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully <w>nurtured</w> the delicate seedlings until they were strong enough to be planted outside.",
                            "target_lang_translations": {
                                "ru": "Она бережно <w>выхаживала</w> нежную рассаду, пока та не окрепла достаточно для высадки в грунт."
                            }
                        },
                        {
                            "text": "The mother bird will <w>nurture</w> her chicks until they are ready to fly.",
                            "target_lang_translations": {
                                "ru": "Птица-мать будет <w>выкармливать</w> своих птенцов, пока они не будут готовы к полету."
                            }
                        }
                    ],
                    "synonyms": [
                        "feed",
                        "grow",
                        "raise"
                    ],
                    "common_phrases": [
                        "nurture seedlings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормить, питать или заботиться о молодом человеке, животном или растении в период их роста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выхаживать",
                                "target_lang_sense_clarification": "заботиться о слабых растениях или детенышах"
                            },
                            {
                                "target_lang_word": "выращивать",
                                "target_lang_sense_clarification": "заботиться в процессе роста"
                            },
                            {
                                "target_lang_word": "вскармливать",
                                "target_lang_sense_clarification": "питать и растить детенышей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}