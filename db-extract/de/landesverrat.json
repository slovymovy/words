                "senses": [
                    {
                        "sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                        "entry_id": "b3f18f1e-45fc-3ed2-89c1-9c52c9b8ab2d",
                        "glosses": [
                            "Verbrechen, das sich gegen den Bestand des Staates richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c643dc-0cb8-4f95-a463-9a5dad903d5c",
                                "sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                                "text": "Er wurde wegen Weitergabe von Staatsgeheimnissen des Landesverrats verurteilt."
                            },
                            {
                                "example_id": "7829d8b1-d40e-4cb6-b4b9-62831395077e",
                                "sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                                "text": "Der US-Soldat soll der Enthüllungsplattform Wikileaks Geheimdokumente in großem Stil zugespielt haben, für seine Gegner ein Abgrund von Landesverrat."
                            },
                            {
                                "example_id": "587470a0-25e1-4604-a9ae-7af7e26cc438",
                                "sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                                "text": "„Mit dem Feind zu schlafen galt in den Augen der Franzosen nicht nur als schlimme Form von Landesverrat, sondern beinahe als Todsünde.“"
                            },
                            {
                                "example_id": "71cab224-f424-4112-aae3-d8003e656bc2",
                                "sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                                "text": "„Carl von Ossietzky, Herausgeber der »Weltbühne«, wegen angeblichen Landesverrats in Gefängnishaft, wurde daraufhin erneut angeklagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74c0ce31-eb63-4a1a-9b1c-8aa949b5d22b",
                        "source_entry_id": "b3f18f1e-45fc-3ed2-89c1-9c52c9b8ab2d",
                        "source_sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                        "source_sense_description": "Verbrechen, das sich gegen den Bestand des Staates richtet",
                        "target_lang_word": "treason",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treason",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9db7b9e5-1dd1-3ab4-a782-86dd643eb0e9",
                                        "entry_id": "082937ed-ca24-3bd6-9baa-8e5c05ab9dce",
                                        "glosses": [
                                            "The crime of betraying one’s own country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26e92cb-c38a-449f-9341-a1fe73d11d2d",
                                                "sense_id": "9db7b9e5-1dd1-3ab4-a782-86dd643eb0e9",
                                                "text": "Treaſon doth never [pro]ſper: what's the reaſon? / For yf yt [pro]ſper none dare call yt treaſon"
                                            },
                                            {
                                                "example_id": "b8a0fdf6-1484-4d1a-9106-80198bc0a467",
                                                "sense_id": "9db7b9e5-1dd1-3ab4-a782-86dd643eb0e9",
                                                "text": "Treason against the United States, shall consist only in levying War against them, or in adhering to their Enemies, giving them Aid and Comfort. No Person shall be convicted of Treason unleſs on the Testimony of two Witneſses to the same overt Act, or on Confeſsion in open Court."
                                            },
                                            {
                                                "example_id": "6fae402c-9f0b-4bbf-8dc5-958c5cc6c14e",
                                                "sense_id": "9db7b9e5-1dd1-3ab4-a782-86dd643eb0e9",
                                                "text": "If for every error and every act of incompetence one can substitute an act of treason, many points of fascinating interpretation are open to the paranoid imagination: treason in high places can be found at almost every turning."
                                            },
                                            {
                                                "example_id": "96842da8-fa3f-4235-96ba-77731983f198",
                                                "sense_id": "9db7b9e5-1dd1-3ab4-a782-86dd643eb0e9",
                                                "text": "M. Vonel: 'Your involvement with a group calling themselves THE ORDER OF THE EZIC STAR has been uncovered. […] At least one EZIC member has confessed to receiving your help. This represents treason of the highest order. Goodbye inspector.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d745db41-536c-30b3-bd9c-104bb7f503af",
                                        "entry_id": "082937ed-ca24-3bd6-9baa-8e5c05ab9dce",
                                        "glosses": [
                                            "An act of treachery, betrayal of trust or confidence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57a4f503-592e-4e77-971a-e8b3b45fd9e4",
                        "source_entry_id": "b3f18f1e-45fc-3ed2-89c1-9c52c9b8ab2d",
                        "source_sense_id": "ef96a4af-2628-309f-aef8-681bd5ef37a5",
                        "source_sense_description": "Verbrechen, das sich gegen den Bestand des Staates richtet",
                        "target_lang_word": "trahison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trahison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca00bc7d-2ecf-3450-ac59-06d98514dff6",
                                        "entry_id": "63fa76fc-7f00-398d-b6ac-4f8980bb205c",
                                        "glosses": [
                                            "Action d’une personne qui trahit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69d34e3-b03c-4b3d-ab7e-303d0fe4a6bf",
                                                "sense_id": "ca00bc7d-2ecf-3450-ac59-06d98514dff6",
                                                "text": "Gaubertin crut à quelque trahison de Soudry, comme Lupin et Soudry se crurent joués par Gaubertin ; mais la déclaration de command les réconcilia."
                                            },
                                            {
                                                "example_id": "c40ba988-1ddd-4cca-adb5-edb2b8312ff4",
                                                "sense_id": "ca00bc7d-2ecf-3450-ac59-06d98514dff6",
                                                "text": "Cette trahison se colore de grands mots. Aimer son pays c’est toujours, selon l’opinion régnante, aimer la gloire, la richesse, et le pouvoir."
                                            },
                                            {
                                                "example_id": "9594faa3-6ae9-4f93-be21-1b2f35024f43",
                                                "sense_id": "ca00bc7d-2ecf-3450-ac59-06d98514dff6",
                                                "text": "Les violences sexuelles sont une trahison. Le plus souvent, l’agresseur est un proche de l’enfant, il est adulte et jouit de la confiance des parents de l’enfant s’il n’est pas lui-même parent de l’enfant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
