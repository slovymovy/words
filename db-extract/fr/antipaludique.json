                    {
                        "sense_id": "e50cfed2-d80a-34d0-87d6-e209c1ce5eb7",
                        "entry_id": "6dc40564-2753-30b2-b8ed-1461e971152b",
                        "glosses": [
                            "Qui vise à limiter ou éradiquer le paludisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a74d6d47-5259-4ffc-aa4e-0466e8af9e82",
                                "sense_id": "e50cfed2-d80a-34d0-87d6-e209c1ce5eb7",
                                "text": "L'emploi des chocolatines au tannate de quinine (modèle de Celli) a marqué une amélioration notable dans les techniques du service antipaludique algérien pour le traitement préventif ou curatif des jeunes enfants."
                            },
                            {
                                "example_id": "803ade94-e1fa-4596-95c9-e458ff3f4783",
                                "sense_id": "e50cfed2-d80a-34d0-87d6-e209c1ce5eb7",
                                "text": "Le composant antipaludique actif de l’écorce de Cinchona a été identifié sous la forme de l’alcaloïde quinine."
                            },
                            {
                                "example_id": "8217f097-deb9-486a-8282-da2fa665098e",
                                "sense_id": "e50cfed2-d80a-34d0-87d6-e209c1ce5eb7",
                                "text": "UN PREMIER VACCIN ANTIPALUDIQUE"
                            }
                        ]
