                ],
                "senses": [
                    {
                        "sense_id": "67d8c3b2-894e-359d-84bc-8ded49ba1817",
                        "entry_id": "b00d72fd-15fc-3f25-a521-9ab1a69331b9",
                        "glosses": [
                            "церк. молитвенные стихи и песнопения в честь какого-либо праздника или святого"
                        ],
                        "tags": [
                            "в православном богослужении"
                        ],
                        "examples": [
                            {
                                "example_id": "77f31fe7-058f-458d-9252-0de8be196ed9",
                                "sense_id": "67d8c3b2-894e-359d-84bc-8ded49ba1817",
                                "text": "Два совершенно разных по происхождению праздника слились настолько, что уже в наше время православная церковь проводит в это время благословение хлебов, при котором трижды поётся тропарь рождеству Богородицы."
                            },
                            {
                                "example_id": "7cb01b9e-88b1-49a9-aea3-44cd34b37e09",
                                "sense_id": "67d8c3b2-894e-359d-84bc-8ded49ba1817",
                                "text": "И сходное восклицание в другом тропаре на тот же день, более подробном, и где речь с большею несомненностью идёт о Магдалине."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc8f2ca9-3075-496b-a57c-7672bc02ce70",
                        "source_entry_id": "b00d72fd-15fc-3f25-a521-9ab1a69331b9",
                        "source_sense_id": "67d8c3b2-894e-359d-84bc-8ded49ba1817",
                        "target_lang_word": "troparion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troparion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44edc94e-0f85-30fe-8f67-d104f1aa2c2c",
                                        "entry_id": "e1e2b187-cf54-3a7f-8700-081aadc3e0d0",
                                        "glosses": [
                                            "A short hymn of one stanza, or organised in more complex forms as a series of stanzas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c08eedc-d5d7-4509-bd40-80639deaaddb",
                                                "sense_id": "44edc94e-0f85-30fe-8f67-d104f1aa2c2c",
                                                "text": "When awakened, Kyr Avram sits in bed and, as if out of fear, sings troparia and contakia in honor of his ancestors, whom the Serbian church has declared saints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
