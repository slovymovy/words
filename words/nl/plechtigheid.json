                },
                {
                    "sense_id": "e1325ea3-07a9-3c5e-aab6-7cd19b8a4660",
                    "sense_definition": "De eigenschap van het plechtig of ernstig zijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stilte in de zaal droeg bij aan de <w>plechtigheid</w> van het moment.",
                            "target_lang_translations": {
                                "en": "The silence in the hall contributed to the <w>solemnity</w> of the moment."
                            }
                        },
                        {
                            "text": "Zijn stem miste de nodige <w>plechtigheid</w> om werkelijk indruk te maken.",
                            "target_lang_translations": {
                                "en": "His voice lacked the necessary <w>solemnity</w> to make a real impression."
                            }
                        }
                    ],
                    "target_lang_definitions": {
