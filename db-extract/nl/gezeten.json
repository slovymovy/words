                        "examples": [
                            {
                                "example_id": "2e6db782-eec4-4192-8744-3a0585531a75",
                                "sense_id": "6f029ef0-00b4-36e9-8935-9abda3a50c10",
                                "text": "De terreur van de rechtervleugel was grotendeels gericht tegen diegenen die in 1934 achter het geweld tegen priesters en fabriekseigenaren hadden gezeten - vakbondsleiders, prominente antiklerikalen, een aantal republikeinse burgemeesters."
                            },
                            {
                                "example_id": "6f653b38-ba53-40b3-9c90-c1d5a1626588",
                                "sense_id": "6f029ef0-00b4-36e9-8935-9abda3a50c10",
                                "text": "Hij kon erg geestig en beeldend vertellen en beschreef hoe hij twintig jaar geleden in Londen zwaar in de ‘underground acid dance scene’ had gezeten, op illegale feesten in verlaten pakhuizen die soms wel drie dagen duurden."
                            }
                        ]
                    }
