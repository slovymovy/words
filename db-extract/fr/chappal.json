                        "glosses": [
                            "Sorte de sandale élémentaire, proche des tongs, courante en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d4cc4c-f0eb-4b73-a90d-66c3f7bf6b2d",
                                "sense_id": "c328c57c-17c1-3a02-9de8-5b9370a266d9",
                                "text": "Au bout d’un moment, quelqu’un fit halte devant Dukhi, se débarrassa de son chappal droit, et indiqua de son gros orteil les lanières cassées."
                            },
                            {
                                "example_id": "3f50d2de-dc99-4248-b9bf-af4c65763134",
                                "sense_id": "c328c57c-17c1-3a02-9de8-5b9370a266d9",
                                "text": "Elle porte un sari bleu et des chappals en caoutchouc assortis. Chamdi sait toujours dans quelle pièce de l’orphelinat elle se trouve à cause du flip-flop que font ses chappals."
                            },
                            {
                                "example_id": "58ff2184-d4b9-413d-9699-105240083964",
                                "sense_id": "c328c57c-17c1-3a02-9de8-5b9370a266d9",
                                "text": "Les chappal, simples nu-pieds, s’avèrent beaucoup mieux adaptés."
                            }
                        ]
                    }
                ],
