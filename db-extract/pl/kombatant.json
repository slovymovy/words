                "senses": [
                    {
                        "sense_id": "c3e32134-52ce-329c-8882-61e1a3cb9c99",
                        "entry_id": "2acf9525-ca3f-3e00-b04d-80f1fdf0b11d",
                        "glosses": [
                            "emerytowany żołnierz i były uczestnik wojny"
                        ],
                        "tags": [],
