                "senses": [
                    {
                        "sense_id": "8d230715-02d3-3282-b840-4ad625ba5f0d",
                        "entry_id": "07f02c44-5049-32bf-98a2-5adc8701c5c9",
                        "glosses": [
                            "Variante expressive, diminutive ou péjorative, de trotter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9061e6-ea6b-412d-a5de-64d6d4dfee38",
                                "sense_id": "8d230715-02d3-3282-b840-4ad625ba5f0d",
                                "text": "J’avais un guide séparé pour ne pas tant trottailler, et je revins par où nous étions venus."
                            },
                            {
                                "example_id": "f36659fb-913e-42b6-874d-6cf7864514bf",
                                "sense_id": "8d230715-02d3-3282-b840-4ad625ba5f0d",
                                "text": "Il fallait les voir trottailler le long des colonnes sur leurs chevaux barbes, escalader les mamelons, plonger dans les ravins, s’enfoncer entre les jujubiers."
                            }
                        ]
                    }
