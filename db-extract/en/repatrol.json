                        "sense_id": "5988c5bf-5397-35d2-8729-00c02a8a7a8e",
                        "entry_id": "51179dae-702b-3364-aa6f-210ccfc43b1b",
                        "glosses": [
                            "To patrol again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121cf660-2ea9-4413-a9bb-5b422c8434f2",
                                "sense_id": "5988c5bf-5397-35d2-8729-00c02a8a7a8e",
                                "text": "There is, however, some solid ground in this area that need not presently be repatrolled."
                            },
                            {
                                "example_id": "bc80d71a-8873-4b31-8bf4-a35f32318045",
                                "sense_id": "5988c5bf-5397-35d2-8729-00c02a8a7a8e",
                                "text": "Three visits were made and, in view of Isabi's low population (P.D.S. 1979 - 68 Residents) it was decided not to repatrol yet again."
                            },
                            {
                                "example_id": "0f06adc3-fab1-4469-b4d0-2091da8c897c",
                                "sense_id": "5988c5bf-5397-35d2-8729-00c02a8a7a8e",
                                "text": "There were no fixed targets, no objectives, no highways to take—it was patrol and repatrol, search and destroy."
                            }
                        ]
                    }
