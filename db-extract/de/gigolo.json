                    },
                    {
                        "translation_id": "a2a96bf2-a60d-4251-ac46-1d7fa1cac241",
                        "source_entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                        "source_sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                        "target_lang_word": "womanizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womanizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                        "entry_id": "22e85a65-8c36-3384-a08e-88fe858d2f19",
                                        "glosses": [
                                            "A man who habitually flirts with and seduces, or attempts to seduce, women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607858f5-b55a-4552-b886-435584250e60",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Getting back into the dating game after a painful divorce is never easy, and the proliferation of womanizers looking to take advantage of your vulnerability only makes things worse."
                                            },
                                            {
                                                "example_id": "32c9d901-64f0-4af0-933d-8db786a6bb40",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "A couple of months ago, in a piece about the language of self-involvement, I quoted a girlfriend of Woody Allen as having described the actor as “very much of a womanizer, very self-involved”."
                                            },
                                            {
                                                "example_id": "6c2a1058-de31-42a4-b874-d2e5d47d71f5",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Sometimes the stereotype is framed as light and cheeky—think the “boys will be boys” mentality exemplified by sitcom womanizers such as How I Met Your Mothers Barney Stinson or '''Two and a Half Mens Charlie Harper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e22cbc96-3b14-451a-8d4e-3d7e945e5eea",
                        "source_entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                        "source_sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                        "target_lang_word": "coureur de filles",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coureur de filles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed64ea51-f61c-31e2-9343-0c9791aabd59",
                                        "entry_id": "4168e4c1-3ec0-33fe-86ed-8bb546355eef",
                                        "glosses": [
                                            "Celui qui aime à séduire de nombreuses femmes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c49330-4b81-4aeb-ba7c-63ff024ba2c1",
                                                "sense_id": "ed64ea51-f61c-31e2-9343-0c9791aabd59",
                                                "text": "Son mari était un brasseur d'affaires et un coureur de filles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7aed9a4-ca39-4643-9350-f677009a15ba",
                        "source_entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                        "source_sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                        "target_lang_word": "homme à femmes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme à femmes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d4e64a0-e2eb-3095-85ac-cb1dc3a4f01a",
                                        "entry_id": "e8159ccf-ec47-381e-a7a5-d8b38f8f7645",
                                        "glosses": [
                                            "Homme qui aime à séduire les femmes, à les suborner."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d90a20-db36-4aa4-b439-824983768643",
                                                "sense_id": "8d4e64a0-e2eb-3095-85ac-cb1dc3a4f01a",
                                                "text": "C’étaient de petites actrices, ou des maitresses d’amis à mon père, ou des amies à mon père, très homme à femmes."
                                            },
                                            {
                                                "example_id": "623a3b06-bd94-4b23-86dd-d5840a57942f",
                                                "sense_id": "8d4e64a0-e2eb-3095-85ac-cb1dc3a4f01a",
                                                "text": "On ne comprend bien Don Juan qu’en se référant toujours à ce qu’il symbolise vulgairement : le séducteur ordinaire et l’homme à femmes."
                                            },
                                            {
                                                "example_id": "cd33eac0-fd7c-4819-adf5-dc524e43f55b",
                                                "sense_id": "8d4e64a0-e2eb-3095-85ac-cb1dc3a4f01a",
                                                "text": "On me prend pour le type même de l’homme à femmes ; j’en ai effectivement rendu heureuses ou malheureuses une demi-douzaine, ennuyé, agacé ou fait jouir quatre ou cinq douzaines d’autres, dont une bonne partie faisait tout simplement en se donnant leur métier de putain."
                                            },
                                            {
                                                "example_id": "e707041d-aece-4c69-8ad3-506bfc8075cc",
                                                "sense_id": "8d4e64a0-e2eb-3095-85ac-cb1dc3a4f01a",
                                                "text": "La réputation d'homme à femmes de Charbonneau tient à sa polygamie active comme au fait de collectionner des calumets dont les fourneaux de pierre rouge sculptés représentent des individus aux poses érotiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6343820e-87f2-4957-8399-e4f54f117f24",
                        "source_entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                        "source_sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                        "target_lang_word": "femellier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femellier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce774c16-8a54-3c8f-b299-b29a702df547",
                                        "entry_id": "076c8e93-ed0c-3610-aceb-7afaeaf27799",
                                        "glosses": [
                                            "Homme qui coure les femmes pour ses satisfactions sexuelles."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaead12e-98d2-473c-a6f0-7d5b60b3d150",
                                                "sense_id": "ce774c16-8a54-3c8f-b299-b29a702df547",
                                                "text": "Tu as le toupet de me le demander, grand dégoûtant, sale femellier ! Qu’est-ce que ma fille va devenir maintenant que tu nous l’as emplie ?"
                                            },
                                            {
                                                "example_id": "051c2a91-d52c-4952-8df8-8f87064540c3",
                                                "sense_id": "ce774c16-8a54-3c8f-b299-b29a702df547",
                                                "text": "T'es qu'un coureur de jupes, un vrai femellier, toujours à liquoter après les femmes des autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
