    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c7c2fdc-a297-358f-bfe9-6f80c0249746",
                    "sense_definition": "Mit den Lippen eine Person oder Sache berühren, um Zuneigung, Liebe oder Verehrung auszudrücken.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kuss_geben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Mutter will ihr Kind vor dem Einschlafen liebevoll auf die Stirn <w>küssen</w>."
                        },
                        {
                            "text": "Er beugte sich zu ihr hinunter und <w>küsste</w> sie zärtlich auf die Wange."
                        }
                    ],
                    "common_phrases": [
                        "auf die Wange küssen",
                        "zum Abschied küssen"
                    ]
                },
                {
                    "sense_id": "0399964a-80af-3477-9f3e-e216a8112319",
                    "sense_definition": "Sich gegenseitig wiederholt oder leidenschaftlich Küsse geben.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "kuss_geben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die beiden Verliebten standen im Regen an der Haltestelle und <w>küssten</w> sich."
                        },
                        {
                            "text": "Sie gingen am Abend im Park spazieren und fingen plötzlich an, sich zu <w>küssen</w>."
                        }
                    ],
                    "synonyms": [
                        "knutschen"
                    ],
                    "common_phrases": [
                        "sich leidenschaftlich küssen",
                        "sich heimlich küssen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ff444a7-d4f7-3297-ac20-db3117860065",
                    "sense_definition": "Dativ Plural des Substantivs <w>Kuss</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "form_kuss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kleine Kind wurde von den glücklichen Großeltern mit vielen warmen <w>Küssen</w> empfangen."
                        },
                        {
                            "text": "Nach all den langen <w>Küssen</w> verabschiedete er sich schließlich am Bahnsteig von seiner Freundin."
                        }
                    ],
                    "common_phrases": [
                        "mit zärtlichen Küssen"
