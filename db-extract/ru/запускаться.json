                            "future"
                        ],
                        "form": "буду/будешь… запуска́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fd8f15e-1c3a-3603-8174-89b343be9284",
                        "entry_id": "5d2d41eb-a8c8-398b-896f-64bd82c4c47b",
                        "glosses": [
                            "страд. к запускать I (заставлять что либо подняться, взлететь)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "3fc294f3-a7b9-4f6b-83d7-f495385c410c",
                                "sense_id": "9fd8f15e-1c3a-3603-8174-89b343be9284",
                                "text": "Отсюда запускаются в небо шары с измерительной аппаратурой, отсюда за ними следит локатор."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d02bd5c-e3d3-319e-b6e3-cb76a8dc78b2",
                        "entry_id": "5d2d41eb-a8c8-398b-896f-64bd82c4c47b",
                        "glosses": [
                            "страд. к запускать I (приводить что либо в движение, в действие)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "57569d0f-9e20-4f74-810c-6af557571596",
                                "sense_id": "2d02bd5c-e3d3-319e-b6e3-cb76a8dc78b2",
                                "text": "Секундомер на каждом из пунктов запускается в момент появления отблеска и останавливается в момент прихода звука выстрела к наблюдателю."
                            },
                            {
                                "example_id": "23d4d597-fe2b-4c67-a461-b1e56f678ea6",
                                "sense_id": "2d02bd5c-e3d3-319e-b6e3-cb76a8dc78b2",
                                "text": "Много раз просматривал он свечи, промывал их, заменял новыми, но мотор не запускался."
                            }
                        ]
                    }
                ],
