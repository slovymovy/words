                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "I looked across the table into her shining eyes, which were golden in the candlelight, with my fingers round the stem of my own glass, ready for the toast."
                                            },
                                            {
                                                "example_id": "a94de985-eff4-4ec7-a720-d5ac40c8bf0c",
                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "Cradled in the arms of Night, the gleam of moon and candlelight bring images alive from days gone by."
                                            },
                                            {
                                                "example_id": "d6e988be-752a-4920-8516-511adfee04bd",
                                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                                "text": "Using survey data gathered from social media users who participated in the candlelight vigils, he explores the prevalence of social media use during the protests, how it differs in terms of individual-level demographic and socioeconomic characteristics, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                                        "glosses": [
                                            "The evening, when darkness falls and it is time to light candles."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c5c652-912a-4f2a-8fe6-e85770babd20",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "Morning dress is that which is worn during business hours or at any time in any place, where semiformal dress is not required until candlelight or seven o'clock in the evening ."
                                            },
                                            {
                                                "example_id": "f3bd84d7-b95e-444c-af7c-cb0890092af4",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "The attack finally ceased Monday morning, but \"soon after candlelight, came on a most terrible bombardment and cannonade, on both sides, as if heaven and earth were engaged.\""
                                            },
                                            {
                                                "example_id": "66e4bd24-8061-4a87-b5e7-7556d948c2c2",
                                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                                "text": "As Marie glances at the window, she sees that the day has gone; it is almost candlelight."
                                            }
                                        ]
