                    {
                        "translation_id": "6d4e0cf4-814b-4b39-8ed1-cb8e224cd2d7",
                        "source_entry_id": "8015a5e8-cdcf-371b-b5e3-8928f5800606",
                        "source_sense_id": "90d1485b-e441-3dc5-be50-4f2fc0dab1c4",
                        "source_sense_description": "een klier die speeksel produceert en naar de mondholte afscheidt",
                        "target_lang_word": "glande salivaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glande salivaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "420ec608-818c-3ecf-ab5f-66f17abce2a6",
                                        "entry_id": "b271c824-866d-32b1-a2c4-5a93da293c3d",
                                        "glosses": [
                                            "Glande exocrine située autour de la bouche et qui produisent de la salive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebb4f98c-a521-4763-b311-8fe650b70031",
                                                "sense_id": "420ec608-818c-3ecf-ab5f-66f17abce2a6",
                                                "text": "La propriété de saccharifier l’empois appartient à une zymose spéciale; et cette zymose est le fruit de la fonction des microzymas propres des glandes salivaires, […]."
                                            },
                                            {
                                                "example_id": "713b2ac7-2188-4360-9ab4-fea3247c7de7",
                                                "sense_id": "420ec608-818c-3ecf-ab5f-66f17abce2a6",
                                                "text": "L'atteinte des glandes salivaires est plus rare et concerne principalement la parotide qui est dure, saillante et douloureuse à la pression."
                                            },
                                            {
                                                "example_id": "895fe8d0-526f-42b5-b0c9-ea22e6cd6273",
                                                "sense_id": "420ec608-818c-3ecf-ab5f-66f17abce2a6",
                                                "text": "Histologiquement, la structure des glandes salivaires est simple. Chaque tube est formé d'un assemblage de quatre files cellulaires, enveloppé d'une fine enveloppe chitineuse, avec au centre un canal d'environ 2 µ de diamètre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
