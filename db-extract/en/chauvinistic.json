                        "glosses": [
                            "Of or pertaining to chauvinism or chauvinists."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "cb7d73aa-af2e-4dd7-a021-581abe26dc76",
                                "sense_id": "e545dc40-f110-3d62-85cc-25e732c94407",
                                "text": "It would be smallmindedly chauvinistic to pretend that Scotland was other than a strong participant in the furthering of British Imperial ambitions."
                            }
