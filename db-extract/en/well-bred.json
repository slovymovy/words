                        "sense_id": "5d1a205a-0fea-3dab-abef-cd1d25448a03",
                        "entry_id": "c9005a91-0e63-327d-bc6d-ac92df4388c4",
                        "glosses": [
                            "Well-mannered and refined because of a good upbringing and education."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f150ffd6-d44f-4d00-9410-726f6260d791",
                                "sense_id": "5d1a205a-0fea-3dab-abef-cd1d25448a03",
                                "text": "Ideally you should relax—though well-bred English people do no feel entirely at ease in a room full of naked strangers beating one another."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eaa7498-9f8b-41e2-8195-3943a428aa61",
