                                        "entry_id": "d55d2908-eb79-3ae2-9ed8-4caf822ebf55",
                                        "glosses": [
                                            "iconisch Amerikaans koekje bestaande uit twee donkere, ronde cacaobiscuits met een zoete, witte vanillecrèmevulling ertussen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3ce89e-4936-43ce-ba51-40f0a7561833",
                                                "sense_id": "a17589f8-3532-3af8-9586-5cc3fd0e0c64",
                                                "text": "Het populairste koekje wereldwijd is trouwens de Oreo, dat net als de nummer twee – chocoladekoekje Chips Ahoy – door het Amerikaanse Mondelez wordt geproduceerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
