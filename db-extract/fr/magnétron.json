            {
                "entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                "word": "magnétron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "60e45ba2-ea44-4ff3-9f68-d11ba9bf0ac9",
                        "entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnétrons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7851292e-61b5-3650-b8d1-03e2f00d7a75",
                        "entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "glosses": [
                            "Dispositif qui transforme l'énergie électrique en énergie électromagnétique, sous forme de micro-ondes."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "079481be-f1ce-4099-8274-253c1581aba6",
                                "sense_id": "7851292e-61b5-3650-b8d1-03e2f00d7a75",
                                "text": "Rappel des théories et des expériences concernant le magnétron à l’état bloqué."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c931bf0-b92a-3859-b2f3-5372f117e571",
                        "entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "glosses": [
                            "Dispositif de déposition de couches minces par pulvérisation cathodique, où des aimants établissent un champ magnétique sur la cible (matière à déposer), ce qui permet une forte augmentation de l’efficacité de la déposition et une meilleure qualité des couches."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c6f3dd-17fd-4958-8835-7a40ab8864cf",
                                "sense_id": "1c931bf0-b92a-3859-b2f3-5372f117e571",
                                "text": "Apparu dans les années 1970, le magnétron a permis l’industrialisation à large échelle de la pulvérisation cathodique."
                            },
                            {
                                "example_id": "501c5bba-7bd5-4848-96cd-8cc6f3620f69",
                                "sense_id": "1c931bf0-b92a-3859-b2f3-5372f117e571",
                                "text": "On reconnaît tout de suite un magnétron en fonctionnement à l’anneau caractéristique que forme le plasma sur la cible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b540ff65-239b-40f9-a7d8-f7b60c49804c",
                        "source_entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "source_sense_id": "7851292e-61b5-3650-b8d1-03e2f00d7a75",
                        "source_sense_description": "Générateur de micro-ondes",
                        "target_lang_word": "Magnetron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnetron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5366bd-2ba5-3447-ac7f-580f8d003a55",
                                        "entry_id": "56caa37c-964b-39ba-8584-84528c8be2c9",
                                        "glosses": [
                                            "Elektronenröhre, die elektromagnetische Strahlung im Mikrowellenbereich erzeugen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1169b612-8b37-4635-a68f-cf0f358a2e04",
                                                "sense_id": "5c5366bd-2ba5-3447-ac7f-580f8d003a55",
                                                "text": "„Um den gewünschten Effekte zu erzielen, hat Eliyahu Jerby von der Universität von Tel Aviv ein handelsübliches Mikrowellengerät ausgeschlachtet. Dessen Herzstück, das so genannte Magnetron, hat er anschließend mit einem Koaxialkabel verbunden, das in ähnlicher Form als Antennenkabel im Haushalt verwendet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "630d4a28-1f8b-4996-97a5-bb17ad1cdc6f",
                        "source_entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "source_sense_id": "7851292e-61b5-3650-b8d1-03e2f00d7a75",
                        "source_sense_description": "Générateur de micro-ondes",
                        "target_lang_word": "magnetron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c72ac6e3-90d6-355a-849b-6edb6842864c",
                                        "entry_id": "4e7e5384-0585-3088-9c01-a255befe215b",
                                        "glosses": [
                                            "A device in which electrons are made to resonate in a specially shaped chamber and thus produce microwave radiation; used in radar, and in microwave ovens"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af6b7424-35b2-4eed-8cf9-35475c255ae1",
                        "source_entry_id": "da237ec0-6bae-33ff-b198-e22e15e9d1e4",
                        "source_sense_id": "7851292e-61b5-3650-b8d1-03e2f00d7a75",
                        "source_sense_description": "Générateur de micro-ondes",
                        "target_lang_word": "magnetrón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetrón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a7874d-f450-316b-87bc-17aa58e63cd2",
                                        "entry_id": "3f1331bd-edce-39a6-91bb-c4e7e4e57aaa",
                                        "glosses": [
                                            "Dispositivo que transforma la energía eléctrica en energía electromagnética en forma de microonda."
                                        ],
                                        "tags": [
                                            "física"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbea1053-1dfa-47f4-8166-140ecec89799",
                                                "sense_id": "d2a7874d-f450-316b-87bc-17aa58e63cd2",
                                                "text": "Para evitar dañar el magnetrón si se refleja demasiada energía, los microondas que se comercializan actualmente vienen equipados con un sistema automático de apagado"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60dc59ae-c5e7-4649-8889-ea5ba6c391ce",
