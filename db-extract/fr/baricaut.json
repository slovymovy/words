                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8c2168-3a3d-4618-9856-acbe10620ea5",
                                "sense_id": "300cf5f1-01b5-3677-8198-29e33b07302d",
                                "text": "Et personne ne peut trouver à redire si, de temps en temps, il lui faut aller au baricaut qui se trouve à l’arrière de la charrette, pour se donner des jambes."
                            },
                            {
                                "example_id": "d541c0be-0a4b-4b4f-b179-31201d86637f",
                                "sense_id": "300cf5f1-01b5-3677-8198-29e33b07302d",
                                "text": "Salé, fumé ou séché, en caques, en pipes, barils ou baricauts, ce poisson, péché dans les mers étroites, à l’ouvert de la Manche, ou devant les pointes de Cornouaille, formait le fret de retour des vins gascons."
                            }
                        ]
