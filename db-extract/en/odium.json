                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33c79c0f-7b26-4bd9-a086-4030e0ce2315",
                        "entry_id": "11da9cb3-ee7b-3e84-a93b-48f299448649",
                        "tags": [
                            "plural"
                        ],
                        "form": "odiums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                        "entry_id": "11da9cb3-ee7b-3e84-a93b-48f299448649",
                        "glosses": [
                            "Hatred; dislike."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d767af-cf7f-4a2b-81c3-24f678828213",
                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                "text": "His conduct brought him into odium, or, brought odium upon him."
                            },
                            {
                                "example_id": "3470403e-d6a5-4ced-a3fe-dbdbb8965c64",
                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                "text": "And it gives to ambitious, corrupted, or deluded citizens, (who devote themselves to the favorite nation,) facility to betray or sacrifice the interests of their own country, without odium, sometimes even with popularity; gilding, with the appearances of a virtuous sense of obligation, a commendable deference for public opinion, or a laudable zeal for public good, the base or foolish compliances of ambition, corruption, or infatuation."
                            },
                            {
                                "example_id": "7720b502-ecee-4971-8ac4-148d9494f4f0",
                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                "text": "‘I warned you, if you give evidence against your husband, you will be shunned. You will be held in odium. You will be alone.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "88d2ffda-2818-3d05-853d-dba1b259e6d5",
                        "entry_id": "11da9cb3-ee7b-3e84-a93b-48f299448649",
                        "glosses": [
                            "The quality that provokes hatred; offensiveness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "564c8d60-27e7-4d16-925a-492d554170e3",
                                "sense_id": "88d2ffda-2818-3d05-853d-dba1b259e6d5",
                                "text": "She threw the odium of the fact on me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
