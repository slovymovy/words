{
    "word_family": [
        "intervention",
        "interventional",
        "interventionist",
        "intervener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d65fd4dc-9fec-32ff-b365-9aa9b6a53435",
                    "sense_definition": "To become involved in a situation, so as to alter or prevent an action.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had to be called to <w>intervene</w> in the fight before anyone got hurt.",
                            "target_lang_translations": {
                                "ru": "Пришлось вызвать полицию, чтобы <w>вмешаться</w> в драку, пока никто не пострадал."
                            }
                        },
                        {
                            "text": "The government decided to <w>intervene</w> in the crisis to stabilize the economy.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>вмешаться</w> в кризис, чтобы стабилизировать экономику."
                            }
                        }
                    ],
                    "synonyms": [
                        "step in"
                    ],
                    "antonyms": [
                        "ignore",
                        "avoid"
                    ],
                    "common_phrases": [
                        "intervene in the dispute",
                        "intervene in the conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вмешиваться в ситуацию, чтобы изменить её или предотвратить какое-либо действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в ситуацию или конфликт"
                            },
                            {
                                "target_lang_word": "вмешаться",
                                "target_lang_sense_clarification": "совершить акт вмешательства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5824155c-063c-38b6-85d7-5e6f96c720bf",
                    "sense_definition": "To say something in the middle of a conversation or discussion between other people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>intervene</w> to clarify the misunderstanding during the meeting.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>вступить</w> в разговор, чтобы прояснить недопонимание во время встречи."
                            }
                        },
                        {
                            "text": "I am sorry to <w>intervene</w> in your conversation, but I have an important update.",
                            "target_lang_translations": {
                                "ru": "Простите, что <w>вмешиваюсь</w> в ваш разговор, но у меня есть важные новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrupt"
                    ],
                    "common_phrases": [
                        "intervene in the conversation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать что-либо посреди разговора или дискуссии между другими людьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в разговор"
                            },
                            {
                                "target_lang_word": "вступить",
                                "target_lang_sense_clarification": "в разговор или дискуссию"
                            },
                            {
                                "target_lang_word": "вставить слово",
                                "target_lang_sense_clarification": "в беседу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13471a29-f498-3ae4-804b-4f220eb79984",
                    "sense_definition": "To occur, fall, or come between specific points of time or events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_and_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many years had <w>intervened</w> since they last spoke to each other.",
                            "target_lang_translations": {
                                "ru": "Много лет <w>прошло</w> с тех пор, как они в последний раз разговаривали друг с другом."
                            }
                        },
                        {
                            "text": "She counted the days that must <w>intervene</w> before their invitation could be sent.",
                            "target_lang_translations": {
                                "ru": "Она считала дни, которые должны <w>пройти</w>, прежде чем можно будет отправить приглашение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intervening years",
                        "intervening period"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или проходить между определенными моментами времени или событиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пройти",
                                "target_lang_sense_clarification": "о времени между событиями"
                            },
                            {
                                "target_lang_word": "пролечь",
                                "target_lang_sense_clarification": "о периоде времени"
                            },
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "о времени между двумя датами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af7a1ce1-8205-36ed-9fee-f652898c2133",
                    "sense_definition": "To be located or situated between persons or things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_and_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Mediterranean Sea <w>intervenes</w> between the continents of Europe and Africa.",
                            "target_lang_translations": {
                                "ru": "Средиземное море <w>пролегает</w> между континентами Европы и Африки."
                            }
                        },
                        {
                            "text": "He looked at the <w>intervening</w> furniture and planned his exit from the room.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел на <w>стоящую между</w> ним и дверью мебель и спланировал свой выход из комнаты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intervening space",
                        "intervening distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться или располагаться между людьми или предметами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "находиться между объектами"
                            },
                            {
                                "target_lang_word": "пролегать",
                                "target_lang_sense_clarification": "о пространстве или море"
                            },
                            {
                                "target_lang_word": "находиться между",
                                "target_lang_sense_clarification": "о расположении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c1af69b-90f0-35a5-ac00-35ff71fab240",
                    "sense_definition": "To occur or act as an obstacle, delay, or interruption that prevents something from happening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They planned to travel abroad, but then a sudden illness <w>intervened</w>.",
                            "target_lang_translations": {
                                "ru": "Они планировали поехать за границу, но внезапная болезнь <w>помешала</w> их планам."
                            }
                        },
                        {
                            "text": "I told her I would return soon, but life <w>intervened</w> and I stayed away for years.",
                            "target_lang_translations": {
                                "ru": "Я сказал ей, что скоро вернусь, но жизнь <w>распорядилась иначе</w>, и я отсутствовал годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "interfere"
                    ],
                    "common_phrases": [
                        "unless something intervenes",
                        "circumstances intervene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникать или действовать как препятствие или задержка, мешающая чему-либо произойти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помешать",
                                "target_lang_sense_clarification": "стать препятствием"
                            },
                            {
                                "target_lang_word": "воспрепятствовать",
                                "target_lang_sense_clarification": "о непредвиденных обстоятельствах"
                            },
                            {
                                "target_lang_word": "вмешаться",
                                "target_lang_sense_clarification": "о судьбе или обстоятельствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e237e94f-9ea8-35bf-b50a-cff1d0188bfe",
                    "sense_definition": "In a legal suit, to formally enter a case to protect one's own interests.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company filed an application for leave to <w>intervene</w> in the ongoing lawsuit.",
                            "target_lang_translations": {
                                "ru": "Компания подала заявление о разрешении <w>вступить в дело</w> в рамках текущего судебного процесса."
                            }
                        },
                        {
                            "text": "The third party sought to <w>intervene</w> to protect their intellectual property rights.",
                            "target_lang_translations": {
                                "ru": "Третья сторона стремилась <w>вмешаться</w> в процесс, чтобы защитить свои права на интеллектуальную собственность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leave to intervene",
                        "right to intervene"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В судебном процессе — официально вступить в дело для защиты собственных интересов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступить в дело",
                                "target_lang_sense_clarification": "в качестве третьего лица"
                            },
                            {
                                "target_lang_word": "вмешаться",
                                "target_lang_sense_clarification": "в судебный процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}