        "fr-extract.jsonl": [
            {
                "entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
                "word": "chorégraphe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "543a9855-0504-4a2e-b82f-2b28ca23574c",
                        "entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "chorégraphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                        "entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
                        "glosses": [
                            "Celui, celle qui pratique la chorégraphie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50c4ef4-6d1c-4508-ab7f-3714eb196737",
                                "sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                                "text": "Un désespéré, précise le chorégraphe, un héros romantique, dont « Nina » est la planche de salut, ne l’oublie jamais !"
                            },
                            {
                                "example_id": "f7de0420-ff4f-45a5-8140-13f6fdfa0d6d",
                                "sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                                "text": "Surtout, elle rencontre la crème des chorégraphes du XXᵉ siècle en la personne de Maurice Béjart, Rudolf Noureev ou Carolyn Carlson qui devient une amie, « ma grande sœur »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29063280-dd90-4607-bbe3-0b91a7f25424",
                        "source_entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
                        "source_sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                        "target_lang_word": "Choreograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Choreograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca48229-0687-3829-b896-29a5925bbd67",
                                        "entry_id": "4a58dcf9-1b54-3d9e-9dbb-ddf1621e0e13",
                                        "glosses": [
                                            "der kreative Gestalter, der die Choreografie, die Beschreibung der Tanzfolgen, in einen konkreten Tanz umsetzt oder umsetzen lässt"
                                        ],
                                        "tags": [
                                            "Tanz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8e9f97-7a2e-4a3c-84ee-6b1bf6c56f53",
                                                "sense_id": "7ca48229-0687-3829-b896-29a5925bbd67",
                                                "text": "„Der New Yorker Choreograf Trajan Harrell hat für sein Werk \"Caen Amour\" zahlreiche Inspirationen miteinander verbunden. Samstag, 20 Uhr, Kampnagel, Jarrestraße 20.“"
                                            },
                                            {
                                                "example_id": "2ce3c3da-8bed-42dd-9e01-1c342ccc536b",
                                                "sense_id": "7ca48229-0687-3829-b896-29a5925bbd67",
                                                "text": "„In Oper, Schauspiel und Musical arbeitet der Choreograf meist mit übergeordneten Regisseuren zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c217ccdc-64be-43c8-91f1-a5acf35b4154",
                        "source_entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
                        "source_sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                        "target_lang_word": "choreographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choreographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                        "entry_id": "60ef6ad3-2abf-30e1-8ea2-19ce2e5bc70d",
                                        "glosses": [
                                            "A person who choreographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6aad138-3361-47da-983c-2a8d2361ad95",
                                                "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                                "text": "\"More and more, the shrewdest thinkers and artists are precocious archeologists of ... ruins-in-the-making, indignant or stoical diagnosticians of defeat, enigmatic choreographers of the complex spiritual movements useful for individual survival in an era or permanent apocalypse.\""
                                            },
                                            {
                                                "example_id": "fd52c3fa-94c0-4338-a6a4-e873a2165376",
                                                "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                                "text": "Chandralekha, a choreographer from Madras, India, has been described as a counterculturalist who draws on elements of classical Indian dance like Bharata Natyam and on Western modern dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce4010df-ee07-4056-a042-6a85d4b8e767",
                        "source_entry_id": "9626a7f6-e283-3dc9-860c-8e28bf4b6fd1",
