            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e17951bb-da36-32c5-88cd-491a8ebff8bf",
                    "sense_definition": "To make something more noticeable or prominent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright colors <w>accentuate</w> the beauty of the garden."
                        },
                        {
                            "text": "Her simple dress was designed to <w>accentuate</w> her natural elegance."
                        }
                    ],
                    "common_phrases": [
                        "accentuate the positive"
                    ]
                },
                {
                    "sense_id": "e8b31d29-abda-3dc0-895b-b93b064b87fb",
                    "sense_definition": "To pronounce a word or syllable with vocal stress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphasize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>accentuate</w> the second syllable of that word."
                        },
                        {
                            "text": "It is difficult to <w>accentuate</w> the correct sounds in a foreign language."
                        }
                    ],
                    "synonyms": [
                        "accent"
                    ]
                },
                {
                    "sense_id": "099bcbd8-bb87-3669-b00d-476db51a38a2",
                    "sense_definition": "To add a written accent mark to a letter or word.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emphasize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remember to <w>accentuate</w> the vowels when writing in French."
