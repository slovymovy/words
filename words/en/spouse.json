                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince <w>spoused</w> the noble lady in a private ceremony.",
                            "target_lang_translations": {
                                "ru": "Принц <w>взял в жёны</w> благородную даму на частной церемонии.",
                                "de": "Der Prinz <w>heiratete</w> die adlige Dame in einer privaten Zeremonie."
                            }
                        },
                        {
                            "text": "She was <w>spoused</w> to him against her family's wishes.",
