                                "zh": "语言学家研究<w>马托尔语</w>，以了解这一地区的历史。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маторский язык (самодийский язык).",
                        "zh": "马托尔语，一种萨莫耶德语支语言的别名形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маторский",
                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马托尔语",
                                "target_lang_sense_clarification": "该已灭绝的萨莫耶德语支语言名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
