                    "frequency": "Low",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le légionnaire romain s'avançait vers l'ennemi en tenant fermement son <w>glaive</w>."
                        },
                        {
                            "text": "Dans ce musée antique, plusieurs <w>glaives</w> de bronze sont exposés au public."
                        }
                    ],
