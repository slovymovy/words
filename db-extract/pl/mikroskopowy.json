                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea5061a2-702f-4c0e-9f72-b324e9d8bfb1",
                        "source_entry_id": "c8e17fad-0cbd-34c1-98cd-4ae5935758bc",
                        "source_sense_id": "f193b4e0-975e-3e65-9971-5da4cafb5a01",
                        "target_lang_word": "microscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                        "entry_id": "02980d77-a8f5-31b9-a306-14cedbfcd823",
                                        "glosses": [
                                            "An optical instrument used for observing small objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba06e09-bbb3-446f-9bce-e474fae47046",
                                                "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                                "text": "That he might ascertain whether any of the cloths of ancient Egypt were made of hemp, M. Dutrochet has examined with the microscope the weavable filaments of this last vegetable."
                                            },
                                            {
                                                "example_id": "f8e6e85b-3a9f-4b66-b707-bcd8a85cade6",
                                                "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                                "text": "Elsewhere, professionals could enthuse over new precision instruments capable, for instance, of measuring weights down to a tenth of a milligram, or over a host of self-registering thermometers and barometers, microscopes, typewriters, calculators and all sorts of technical and musical devices, including automatic concertinas, edeophones, auto-harps, bigophones and other long-forgotten objects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1368e42-46e2-3dbc-b23e-d32c30cd1680",
                                        "entry_id": "02980d77-a8f5-31b9-a306-14cedbfcd823",
                                        "glosses": [
                                            "Any instrument for imaging very small objects (such as an electron microscope)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "microscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                        "entry_id": "3222fb2a-7b08-3dee-be7b-b46b8e20f60a",
                                        "glosses": [
                                            "To examine with a microscope, to put under a microscope (literally or figuratively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dee191b-7ca8-416b-87a5-9a1d19712c2c",
                                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                                "text": "It has a strong germicidal action, as can be verified by staining and microscoping the pus, the characteristic micro-organisms disappearing rapidly under its use."
                                            },
                                            {
                                                "example_id": "d10c47b7-3d4a-4db2-b57d-2b999ced9a49",
                                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                                "text": "Wright (1959), using the standard and less laborious technique of microscoping the centrifuged deposit of a sample of urine, found that 21.6% of males attending life insurance examinations had more than 10 red blood cells per high power field (rbc/hpf)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d950252a-e107-405a-a278-ffc480030062",
                        "source_entry_id": "c8e17fad-0cbd-34c1-98cd-4ae5935758bc",
                        "source_sense_id": "f193b4e0-975e-3e65-9971-5da4cafb5a01",
                        "target_lang_word": "microscopic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscopic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Of, or relating to microscopes or microscopy; microscopal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdbe038-ca09-4757-8fc1-5e75e1f8adef",
                                                "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                                "text": "We supply all microscopic stains and other materials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "So small that it can only be seen with the aid of a microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90017d6-39bc-46b9-b68d-1cc362b36218",
                                                "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                                "text": "The water was full of microscopic organisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Very small; minute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c68045-f407-4b1f-959b-41a80e3c0319",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "Compared to the galaxy, we are microscopic in scale."
                                            },
                                            {
                                                "example_id": "d8d8bb97-ef8c-4f46-ab3e-447b8eb42cbd",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "By wholesale omission of connections and by the use of a microscopic scale of photographic reproduction which makes some of the most important tables difficult to read, the size has been cut down from last winter's 580 to 520 pages only."
                                            },
                                            {
                                                "example_id": "8f8a6644-9b19-44cf-a3c4-a6e8a2358018",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "... the notion of the microscopic was often used in the foundations of quantum theory right from the start, to indicate the realm in which quantum theory is required in order to explain phenomena when classical theory cannot do so; quantum theory was generally considered in those years to apply only to situations involving atoms and smaller “microscopic” entities..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Carried out with great attention to detail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d51ad7-0eb7-4a4b-935b-7ecc3bb795b4",
                                                "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                                "text": "The police carried out a microscopic search of the crime scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Able to see extremely minute objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3565db4-64fc-4788-83aa-3ec9bcde9d73",
                                                "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                                "text": "Why has not man a microscopic eye?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cf4aacd-28d5-4411-a2f5-ee3436bd0353",
                        "source_entry_id": "c8e17fad-0cbd-34c1-98cd-4ae5935758bc",
                        "source_sense_id": "f193b4e0-975e-3e65-9971-5da4cafb5a01",
