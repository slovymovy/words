{
    "word_family": [
        "łuska",
        "łuskacz",
        "łuszczarka",
        "łuszczarnia",
        "łuszczyca"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31bf0c04-3def-3033-91c0-e373dcb45fa9",
                    "sense_definition": "usuwać łupinę lub zewnętrzną warstwę z nasion, owoców lub warzyw",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obróbka_żywności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trzeba <w>łuszczyć</w> groch przed gotowaniem zupy.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>лущить</w> горох перед приготовлением супа."
                            }
                        },
                        {
                            "text": "Dzieci pomagają <w>łuszczyć</w> fasolę w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Дети помогают <w>лущить</w> фасоль в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "łuskać"
                    ],
                    "common_phrases": [
                        "łuszczyć groch",
                        "łuszczyć fasolę"
                    ],
                    "target_lang_definitions": {
                        "ru": "удалять шелуху или внешнюю оболочку с семян, плодов или овощей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лущить",
                                "target_lang_sense_clarification": "очищать от шелухи или стручков"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "снимать внешнюю оболочку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e83960f0-1a05-3b93-97e5-8e5f227b0532",
                    "sense_definition": "odrywać się płatami od powierzchni, np. o skórze lub farbie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "odpadanie_warstw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po opalaniu skóra na plecach zaczęła mi się <w>łuszczyć</w>.",
                            "target_lang_translations": {
                                "ru": "После загара кожа на спине начала у меня <w>шелушиться</w>."
                            }
                        },
                        {
                            "text": "Stara farba na ścianie zaczyna <w>łuszczyć</w> się pod wpływem wilgoci.",
                            "target_lang_translations": {
                                "ru": "Старая краска на стене начинает <w>отслаиваться</w> под воздействием влаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "odłupywać się"
                    ],
                    "common_phrases": [
                        "skóra łuszczy się",
                        "farba łuszczy się"
                    ],
                    "target_lang_definitions": {
                        "ru": "отслаиваться чешуйками или пластами от поверхности (о коже, краске)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелушиться",
                                "target_lang_sense_clarification": "о коже, покрывающейся чешуйками"
                            },
                            {
                                "target_lang_word": "отслаиваться",
                                "target_lang_sense_clarification": "о краске или покрытии, отделяющемся пластами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}