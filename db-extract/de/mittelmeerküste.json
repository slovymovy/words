                "senses": [
                    {
                        "sense_id": "74c2301e-e933-32bc-9508-9a726d7ab5f2",
                        "entry_id": "12c76cb2-ed85-3060-9426-fe40e39d47e9",
                        "glosses": [
                            "Küste, die am Mittelmeer liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7839ed7c-d312-4a9e-befe-137056e735f1",
                                "sense_id": "74c2301e-e933-32bc-9508-9a726d7ab5f2",
                                "text": "„Kräftig zulegen konnten auch Kreta mit dem Zielflughafen Heraklion, und auch Antalya feiert Wiederauferstehung nach dem steilen Abfall: Elf Prozent der Reisebürobuchungen ex Österreich hatten die Stadt an der türkischen Mittelmeerküste zum Ziel.“"
                            },
                            {
                                "example_id": "5c4b0be3-f9d2-4ca7-a542-3fb0443ff3f7",
                                "sense_id": "74c2301e-e933-32bc-9508-9a726d7ab5f2",
                                "text": "„Doch von Pinien eingerahmte Meeresbuchten sind nach wie vor ein Markenzeichen dieses Teils der Mittelmeerküste.“"
                            },
                            {
                                "example_id": "c1c5db74-4ba0-4aa1-8716-30ab4290a6bd",
                                "sense_id": "74c2301e-e933-32bc-9508-9a726d7ab5f2",
                                "text": "„Einsame Strände und unberührte Natur? Das gibt es sogar an Spaniens Mittelmeerküste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
