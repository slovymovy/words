                "senses": [
                    {
                        "sense_id": "9aea627d-8be0-3ac0-a132-b1903bba4ef9",
                        "entry_id": "de04185c-2abf-38c6-84e5-476e2d01689d",
                        "glosses": [
                            "Lécher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e02d8ae-6bf6-4c46-94e4-02e38bcf9156",
                                "sense_id": "9aea627d-8be0-3ac0-a132-b1903bba4ef9",
                                "text": "J’avais insulté les fayots de Collège ; il paraît que les haricots sont meilleurs dans ce pays-ci, car j’en avale des platées et je lèche et relèche l’assiette."
                            },
                            {
                                "example_id": "e5a5798d-949c-4fcf-bfb0-9f3e84f7b512",
                                "sense_id": "9aea627d-8be0-3ac0-a132-b1903bba4ef9",
                                "text": "Qu’importait que Caminade eût omis de remplir sa terrine de beurre afin d’améliorer le petit déjeuner, que Mégret se fût rappelé trop tard sa boîte de lait vide, léchée et reléchée…"
                            }
                        ]
                    },
                    {
                        "sense_id": "6f414ba6-ccc3-3e12-b461-e9f660818366",
                        "entry_id": "de04185c-2abf-38c6-84e5-476e2d01689d",
                        "glosses": [
                            "Embrasser avec la langue."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8634297e-2db8-4a31-8737-e3794e652015",
                                "sense_id": "6f414ba6-ccc3-3e12-b461-e9f660818366",
                                "text": "Autrefois, les signes extérieurs d’affection n’étaient pas aussi développés qu’aujourd’hui où l’on se relèche pour un oui ou pour un non […]."
                            }
                        ]
                    }
