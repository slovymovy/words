                    {
                        "sense_id": "806b37fb-101b-349c-944e-39eb0457ec05",
                        "entry_id": "e499e9d8-04b4-3c30-b8fc-0f3374580847",
                        "glosses": [
                            "metalen schijf, in het bijzonder als onderscheidingsteken na bepaalde prestaties, zoals bij sporters en militairen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ec4af58-bf1d-40f5-8554-735d547f05c1",
                        "source_entry_id": "e499e9d8-04b4-3c30-b8fc-0f3374580847",
                        "source_sense_id": "806b37fb-101b-349c-944e-39eb0457ec05",
                        "source_sense_description": "metalen schijf, in het bijzonder als onderscheidingsteken na bepaalde prestaties",
                        "target_lang_word": "Medaille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Medaille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                        "entry_id": "e4e6061c-6085-3fb2-bc3c-aac38661c312",
                                        "glosses": [
                                            "nicht zur Zahlung bestimmte Münze, welche entweder an eine Persönlichkeit oder an ein bestimmtes Ereignis erinnern soll; es ist kein Nennwert aufgedruckt oder eingeprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3470d6d-f375-44f7-bc5a-72ddf55748e3",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Im Gegensatz zu einer Plakette weist eine Medaille auf beiden Seiten Schriftzüge oder ein Bildmotiv auf."
                                            },
                                            {
                                                "example_id": "db8568da-6a1d-43ec-8c1f-326d04a7b9c7",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Friedrich Schiller wurde auf zahlreichen Medaillen geehrt."
                                            },
                                            {
                                                "example_id": "1e2da0fd-a6d3-4668-8594-d09d655d4ada",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Zu Ehren des ersten bemannten Weltraumflugs wurden mehrere Medaillen herausgegeben."
                                            },
                                            {
                                                "example_id": "8ac869e5-2340-40d7-908d-221c05a91106",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Sportler kämpfen oft um Medaillen."
                                            },
                                            {
                                                "example_id": "08ca1154-4192-4cae-b929-7589bb554993",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Die Gäste erhalten goldene Medaillen zur Erinnerung an das Ereignis.“"
                                            },
                                            {
                                                "example_id": "7c9c3210-1f35-4625-bf66-0d44a91b661c",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Im ersten Saal waren die Edelleute in ihren Uniformen, im zweiten die Kaufmannschaft, Leute mit langen Bärten, in blaue Kaftans gekleidet, Medaillen auf der Brust.“"
                                            },
                                            {
                                                "example_id": "12781651-5262-47ed-9c9e-90eb750ddbba",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Der Legionär mit den vielen Medaillen drang bei mir ein.“"
                                            },
                                            {
                                                "example_id": "0a207b5b-358c-4185-b0c9-7b1fecd732ac",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Sie wurden auf Gedenkmünzen und Medaillen geprägt, gern mit Melanchthon auf der Hinterseite, auf Holztäfelchen gepinselt und in großformatige Bilder gemalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf94ce7a-13a1-4876-b9e4-a100ef10f3f3",
                        "source_entry_id": "e499e9d8-04b4-3c30-b8fc-0f3374580847",
                        "source_sense_id": "806b37fb-101b-349c-944e-39eb0457ec05",
                        "source_sense_description": "metalen schijf, in het bijzonder als onderscheidingsteken na bepaalde prestaties",
                        "target_lang_word": "medal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c163271-9be9-3ff6-abbd-dda971008f74",
                                        "entry_id": "417e052d-a799-3daa-b88c-556969f8248e",
                                        "glosses": [
                                            "A stamped metal disc used as a personal ornament, a charm, or a religious object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c5dfe9-0e3f-4900-86ad-186a6116c1ec",
                                                "sense_id": "2c163271-9be9-3ff6-abbd-dda971008f74",
                                                "text": "Whether their images, shrines, relics, consecrated things, holy water, medals, benedictions, those divine amulets, holy exorcisms, and the sign of the cross, be available in this disease?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16d38c7d-e433-3f9f-ab91-d4edc7f364ea",
                                        "entry_id": "417e052d-a799-3daa-b88c-556969f8248e",
                                        "glosses": [
                                            "A stamped or cast metal object (usually a disc), particularly one awarded as a prize or reward."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "medal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                        "entry_id": "664658c8-704b-3399-b357-3b7354cc48b9",
                                        "glosses": [
                                            "To win a medal."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "059abbde-a8ff-4175-a7c1-4c313e139d6b",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "He medalled twice at the Olympics."
                                            },
                                            {
                                                "example_id": "96e0c08d-61df-4d13-8ffb-9cf692fe2ea2",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "I dashed into the mall; bought a gift; raced to the card store, snapped up a two-fer gift-bag special and was back in my car in 26 minutes. I could medal in power shopping."
                                            },
                                            {
                                                "example_id": "baaac166-ca30-4da0-a258-4156a0f08945",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "Vocab-wise, medalling and PB-ing are now totally part-and-parcelled, and most experts in South Korea believe podiumed, finalled and all-comered are not far off lexiconing."
                                            },
                                            {
                                                "example_id": "af7376af-3b0f-4f49-bc34-847838ffa76b",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "I wanted to medal. I was pregnant and I wanted to medal."
                                            },
                                            {
                                                "example_id": "2b3a5563-dd33-4316-9ece-2965d12a4893",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "In 2008, after being passed over yet again for USA Basketball’s Beijing Olympics team, San Antonio Stars all-star Becky Hammon signed a four-year, $2m contract with CSKA Moscow that included a six-figure bonus for becoming a naturalised citizen and medaling at the Games."
                                            },
                                            {
                                                "example_id": "b2a5bded-5577-4433-9404-cc3e7a1c9a39",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "Rebecca Romero medaled in rowing and track cycling in 2004 and 2008, joining East German swimmer-turned-handball player Roswitha Krause and several swimmers/divers as two-sport medalists."
                                            },
                                            {
                                                "example_id": "29f7063a-0f6c-4477-bf4e-27c2d5eb0715",
                                                "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                                                "text": "Though she never medalled at the Olympics, she did win a pair of golds at the Central American and Caribbean Games in San Salvador in 2002."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f8d918-b08c-3982-836f-e20b62c890d1",
                                        "entry_id": "664658c8-704b-3399-b357-3b7354cc48b9",
                                        "glosses": [
                                            "To award a medal to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd48eaf5-60de-40d5-bcdd-0055de3c30db",
                        "source_entry_id": "e499e9d8-04b4-3c30-b8fc-0f3374580847",
                        "source_sense_id": "806b37fb-101b-349c-944e-39eb0457ec05",
                        "source_sense_description": "metalen schijf, in het bijzonder als onderscheidingsteken na bepaalde prestaties",
                        "target_lang_word": "médaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d84e278e-9926-3492-96af-4183b7f1f0d9",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de monnaie antique, ainsi désignée par les collectionneurs à partir de la Renaissance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30e7aff-d346-4dce-88b0-2adb0038e083",
                                                "sense_id": "d84e278e-9926-3492-96af-4183b7f1f0d9",
                                                "text": "Médaille antique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de métal frappée ou fondue en l’honneur d’une personne illustre, ou pour conserver le souvenir d’une action mémorable, d’un événement, d’une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5574afd9-dafe-4a31-bc2c-b74bd322f452",
                                                "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                                "text": "Ton frère est mort écrasé, mais on lui a apporté la médaille sur son lit de mort. Si des fois tu causes avec des collègues, même avec des chefs, tu peux dire comme ça : « Mon frère a reçu la médaille. » Ça montre, tu comprends, ça montre. »"
                                            },
                                            {
                                                "example_id": "8a341d5a-2758-4936-bfb2-4c72362d82eb",
                                                "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                                "text": "Fils sentit sa bouche se dessécher alors qu'il regardait Valerian mâcher un morceau de jambon, son profil de médaille satisfait, appréciant même le goût qui lui remplissait la bouche bien qu'il ait pu renvoyer d'un simple mouvement de doigts des gens dont le sucre et le cacao lui avaient permis de vieillir dans un confort de roi ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af79d8f9-241f-3189-ab57-5470ab6f4d04",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce d’or, d’argent, ou de cuivre, généralement bénite, qui représente un sujet de dévotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3a692e-b95f-4b1a-8193-7550695a5a51",
                                                "sense_id": "af79d8f9-241f-3189-ab57-5470ab6f4d04",
                                                "text": "Il a plusieurs médailles suspendues à son chapelet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d83e8a0-0faf-36a4-b137-29ee657ec961",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce d’or, d’argent, ou de cuivre qu’on décerne aux sportifs ayant gagné des compétitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7f6473-6d99-496d-b01d-e2b38c90b00f",
                                                "sense_id": "2d83e8a0-0faf-36a4-b137-29ee657ec961",
                                                "text": "Il a eu la médaille d’or de curling aux jeux olympiques"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5116bc94-c0ab-3963-9490-d42c221a499c",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Prix qu’on décerne aux poètes, aux orateurs, aux artistes, aux industriels qui ont obtenu les premiers rangs dans les concours ouverts par les académies ou par le gouvernement, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Décoration qu’on décerne aux militaires ou aux civils pour hauts faits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3ea941-ebbe-4c5d-8753-2edf5c91f133",
                                                "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                                "text": "On le sait, les médailles sont faites pour décorer les guerres terminées ou à venir : le tee-shirt en sueur est pour celle qu’on mène sous les bombardements immédiats ou contre un maigre salaire."
                                            },
                                            {
                                                "example_id": "3b15bc6e-f410-48d9-8c33-f276a7b0e561",
                                                "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                                "text": "La médaille militaire. instituée en 1852 en faveur des sous-officiers et soldats les plus méritants et qu’on donne également aux généraux en récompense de services éclatants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869dfd0b-ec20-30e7-af46-944f4050ee38",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Plaque de métal numérotée que portent les commissionnaires, les porteurs des gares de chemins de fer, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "858d1979-bd7f-3da8-a684-e32636faba80",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de métal attribuée aux membres de certaines corporations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f14ac16-c9e5-4b3b-a721-924f5b0633f9",
                                                "sense_id": "858d1979-bd7f-3da8-a684-e32636faba80",
                                                "text": "Médaille de député."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a6c8f3-1cb3-3783-9568-aafe57c98a24",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Défaut dans une vitre, c'est une tache blanchâtre et opaque."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bca6f99-43df-4a28-88ca-227f32ad715d",
                                                "sense_id": "21a6c8f3-1cb3-3783-9568-aafe57c98a24",
                                                "text": "Le verre soit ordinaire, dit d'Alsace, soit en verre blanc, sera toujours d'une épaisseur égale, d'une teinte pure, non rayé, sans gauche, piqûre, bouillon, médaille ou autres défauts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4401e6e5-9926-3aa9-85c9-f46ded5ccd50",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Récompense."
