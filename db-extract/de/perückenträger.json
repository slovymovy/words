                "senses": [
                    {
                        "sense_id": "e2049c39-4266-3290-865a-60847f1e8786",
                        "entry_id": "988e17c2-9114-3e0a-bea3-4c50c4555a22",
                        "glosses": [
                            "jemand, der (regelmäßig) eine Perücke trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75860adb-3b71-4cd7-bfc8-d960266b96b1",
                                "sense_id": "e2049c39-4266-3290-865a-60847f1e8786",
                                "text": "„Theoretisch könnten Perückenträger täglich ihre Frisur ändern, doch nur die wenigsten machen das auch.“"
                            },
                            {
                                "example_id": "d128ec12-fca6-4f9f-9feb-be1b71c249a0",
                                "sense_id": "e2049c39-4266-3290-865a-60847f1e8786",
                                "text": "„Männliche Perückenträger sind nicht immer Kahlköpfige, die es leid sind, sich mit miesen Toupets herumzuärgern, die fast nie ‚unsichtbar‘ sind – was sie sein sollten.“"
                            },
                            {
                                "example_id": "61d512de-8e5c-4190-9656-7a2a254a504c",
                                "sense_id": "e2049c39-4266-3290-865a-60847f1e8786",
                                "text": "„[…] Die Reformer und ihre Anhänger – Adelige wie Kleist, Stein, Novalis, Arnim, de la Motte-Fouqué, Bürgerliche wie Tieck, Brentano, die Schlegels, E.T.A. Hoffmann und Rahel Levin – schauten mit Abscheu auf die parfümierten Perückenträger am Hof, die nicht mehr Schritt halten konnten mit dem Vormarsch der jungen Ideen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
