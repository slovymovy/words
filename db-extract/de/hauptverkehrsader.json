                    {
                        "sense_id": "6b14c40b-58bf-305d-a4c5-bc27a7a4f8d6",
                        "entry_id": "2c82b295-05be-3e13-b9a3-3da667b1de23",
                        "glosses": [
                            "besonders wichtiger, viel genutzter Verkehrsweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943d8d5f-7bf5-433a-8cec-4f07532c4e03",
                                "sense_id": "6b14c40b-58bf-305d-a4c5-bc27a7a4f8d6",
                                "text": "„Sklaven, Waffen, Stoffe, Eisen, Gold und Glas reisten entlang dieser Hauptverkehrsader der Eisenzeit quer durch Europa – direkt am Oppidum entlang.“"
                            },
                            {
                                "example_id": "ccfd2e5b-d8ef-4d72-9d1a-28d5cbcaf24b",
                                "sense_id": "6b14c40b-58bf-305d-a4c5-bc27a7a4f8d6",
                                "text": "„Und so marschierte Thomas denn eilig hinab zu den engen, winkeligen Straßen am Meer und wieder empor zu den steil ansteigenden Hauptverkehrsadern, benützte Durchgänge und Arkaden, bog unerwartet um Ecken, sorgte jedoch stets dafür, daß er dem Major nichts Übermenschliches zumutete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
