                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e0655b-d9f2-493a-934c-b779f231f8ad",
                                "sense_id": "7938b637-0d81-3d65-9706-018af8f10347",
                                "text": "Der Postmann hat ein Päckchen für dich gebracht."
                            },
                            {
                                "example_id": "b6744b0f-a8c4-4ac7-ac46-44a5af4848b2",
                                "sense_id": "7938b637-0d81-3d65-9706-018af8f10347",
                                "text": "„Wenn der Postmann zweimal laut pfiff, rannte ihm Johann Georg, der ihn längst entdeckt hatte, schnell entgegen, um keine Nachricht zu versäumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
