                                            {
                                                "example_id": "fa36e402-6b76-4920-8e30-4a71dcb21a2d",
                                                "sense_id": "ee91857b-e8d3-316c-b487-1a6444527496",
                                                "text": "ha detto che è perfida pur credendo che poi lei gli chiederà aiuto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d48d4f9-3095-39be-834c-e321568d8b9b",
                                        "entry_id": "38da193c-5def-311b-9b6a-dd44199b6741",
                                        "glosses": [
                                            "persona che non considera qualcuno che è nella condizione di dover attendere una sua risposta, un suo cenno positivo, un'accettazione o un consenso, in genere in questioni di cuore"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1229be5-484d-4a7f-97de-9167c2ce8ddf",
                                                "sense_id": "8d48d4f9-3095-39be-834c-e321568d8b9b",
                                                "text": "Quando vide che il compagno di classe non l'assecondava, la ragazza innamorata sospirò silenziosamente: \"Perfido... Vedremo tra un anno se non ti avrò!\""
                                            }
                                        ]
