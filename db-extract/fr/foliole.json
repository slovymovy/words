                ],
                "senses": [
                    {
                        "sense_id": "4633a40d-ebd1-3211-93fc-9c9bff1ff331",
                        "entry_id": "1643bc56-4287-356f-aa8c-8671404d2779",
                        "glosses": [
                            "Chacune des petites feuilles qui forment une feuille composée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60151fa-cfef-437c-a9d5-94884255a299",
                                "sense_id": "4633a40d-ebd1-3211-93fc-9c9bff1ff331",
                                "text": "Sibbaldie, […]. Ce genre , qui est figuré pl. 221 des Illustrations de Lamarck, renferme des herbes à feuilles ternées, à folioles simples, dentées et découpées; à fleurs axillaires et terminales, quelquefois décagynes."
                            }
                        ]
                    },
                    {
                        "sense_id": "815c015f-3c15-37ab-ab1f-a97a3faf87fd",
                        "entry_id": "1643bc56-4287-356f-aa8c-8671404d2779",
                        "glosses": [
                            "Chaque pièce d’un calice ou d’un involucre."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "21d92b5a-6038-4713-a8db-4f9b368bc96c",
                                "sense_id": "815c015f-3c15-37ab-ab1f-a97a3faf87fd",
                                "text": "Les folioles de l'artichaut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cea2425f-94eb-4b7d-831a-00f12d5600fa",
                        "source_entry_id": "1643bc56-4287-356f-aa8c-8671404d2779",
                        "source_sense_description": "1",
                        "target_lang_word": "Blättchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blättchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b004eee1-a194-3016-b5b3-99a13320bc66",
                                        "entry_id": "f787e888-f416-33a6-8aa4-8bdddce3078b",
                                        "glosses": [
                                            "ein kleines Blatt (Bedeutungen siehe dort)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0574315d-36dd-433c-b2fc-4b67dca25c95",
                                                "sense_id": "b004eee1-a194-3016-b5b3-99a13320bc66",
                                                "text": "„Die mit klebrigen grünen Blättchen ganz übersäten Birken standen regungslos da; aus dem vorjährigen Laube am Boden kamen, das welke Laub in die Höhe hebend, violette Blüten und junges grünes Gras hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7eee8ea5-2d8e-3168-a805-55688d48e699",
                                        "entry_id": "f787e888-f416-33a6-8aa4-8bdddce3078b",
                                        "glosses": [
                                            "Blattteile von gefiederten oder gefingerten Laubblättern"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "25641214-2771-336b-8a5b-d38039ea279c",
                                        "entry_id": "f787e888-f416-33a6-8aa4-8bdddce3078b",
                                        "glosses": [
                                            "das dünne Papier, das den Tabak einer (insbesondere selbstgedrehten) Zigarette umgibt; das Papier für einen Joint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84058116-4684-4874-8dfb-8db2195f8081",
                                                "sense_id": "25641214-2771-336b-8a5b-d38039ea279c",
                                                "text": "Den Tabak habe ich mitgebracht, aber die Blättchen sind alle."
                                            },
                                            {
                                                "example_id": "5d0451ca-f0df-4004-b99c-6061e899a38a",
                                                "sense_id": "25641214-2771-336b-8a5b-d38039ea279c",
                                                "text": "„Der fremde Mann setzte sich inzwischen an seinen Tisch, legte Papier vor sich hin, packte Bleistifte und andre kleine Geräthschaften aus, sah aufmerksam umher, schrieb etwas, wie es mir schien […] Und nun sah ich auf dem kleinen Blättchen die ganze Schulstube vor meinen Augen entstehen; das hatte ich mir nie als möglich gedacht!“"
                                            },
                                            {
                                                "example_id": "e1796c52-e2f8-4892-9d73-697b179f4adc",
                                                "sense_id": "25641214-2771-336b-8a5b-d38039ea279c",
                                                "text": "„Frank legte das Blättchen auf den Tisch und fing an, es mit Tabak zu füllen, dann fuhr er mit der Zunge über das Papier und rollte es zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e2777ffc-2a9e-3ceb-8ab6-962403ccc37f",
                                        "entry_id": "f787e888-f416-33a6-8aa4-8bdddce3078b",
                                        "glosses": [
                                            "Teil einer analogen Schachuhr (siehe Fallblättchen)"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f98ca392-e17e-43d7-805f-c17c65c55e55",
                                                "sense_id": "e2777ffc-2a9e-3ceb-8ab6-962403ccc37f",
                                                "text": "Er muss jetzt schneller spielen, denn sein Blättchen fällt gleich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2463233c-8218-42c1-949b-355be27405eb",
