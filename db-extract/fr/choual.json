                "senses": [
                    {
                        "sense_id": "3f46c715-b682-3dc8-a262-5b7af05ccf88",
                        "entry_id": "0a2dd4b7-551d-3512-9ea1-1b961184dc76",
                        "glosses": [
                            "Dixième mois hégirien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6dbd950-f85a-4fca-b4a7-4ea6ce20b86e",
                                "sense_id": "3f46c715-b682-3dc8-a262-5b7af05ccf88",
                                "text": "La date répondant au 1ᵉʳ choual 1277 étant le 468e jour après le 1ᵉʳ janvier 1860 se trouve dans l’année 1861 et comme 1860 est bissextile, on retranche 366 du 1ᵉʳ résultat. On obtient 468 — 366 = 102 ; dans le tableau V, on trouve : 102 = 12 avril ; d’où : 1ᵉʳ choual 1277 -12 avril 1861."
                            },
                            {
                                "example_id": "ee31160d-a7f1-401c-a0af-77362385fbe9",
                                "sense_id": "3f46c715-b682-3dc8-a262-5b7af05ccf88",
                                "text": "Le 3 de choual 1089, commença à Tunis une fête qui dura sept jours et sept nuits."
                            },
                            {
                                "example_id": "1f2559a1-6d65-4191-b5ea-476a979f432b",
                                "sense_id": "3f46c715-b682-3dc8-a262-5b7af05ccf88",
                                "text": "La lune du mois de Choual sera vue notamment, précise le secrétariat, à partir des pays de l’Amérique latine et l’Amérique du Nord, ainsi qu’une partie des pays de l’Afrique de l'Ouest et l’Afrique centrale."
                            }
                        ]
                    }
                ],
