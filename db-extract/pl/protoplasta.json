                "senses": [
                    {
                        "sense_id": "2af3402d-a148-3802-a0f2-136f7bd5b665",
                        "entry_id": "11e81210-c44f-30a8-b57a-e706603e1055",
                        "glosses": [
                            "protoplast; progenitor, forefather, Adam (founder of a lineage)"
                        ],
                        "tags": [
                            "literary",
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b7765f-fb9f-4c4a-965e-6960b9be68be",
                                "sense_id": "2af3402d-a148-3802-a0f2-136f7bd5b665",
                                "text": "protoplasta dynastii",
                                "translation": "protoplast of a dynasty",
                                "english": "protoplast of a dynasty"
                            },
                            {
                                "example_id": "b60a90d1-e6dc-45ed-a6eb-3a1c41f30fb5",
                                "sense_id": "2af3402d-a148-3802-a0f2-136f7bd5b665",
                                "text": "A że Przybytkiem Krolewskim: dla tego przystáło áby uprzedźiwszy Protoplástá upadek, wolne zostawáło od pierworodnego ćiężaru.",
                                "translation": "And that the Royal Tabernacle: therefore it is fitting that, having anticipated the Protoplast's fall, it should remain free from the first-born burden.",
                                "english": "And that the Royal Tabernacle: therefore it is fitting that, having anticipated the Protoplast's fall, it should remain free from the first-born burden."
                            },
                            {
                                "example_id": "accb53ab-bf00-454c-87a0-35c43ce52b08",
                                "sense_id": "2af3402d-a148-3802-a0f2-136f7bd5b665",
                                "text": "Nasz Protoplasta / Jednym żebrem bogatszy, gdyby mu niewiasta / Nie była dana Ewa; pono by był prosił / BOGA, aby dzień skrocił, by tey nie ponosił / Tęsknoty tak długi czas.",
                                "translation": "Our Adam / One rib richer, if a woman / Had not been given to him Eve; supposedly would have asked / GOD to shorten the day, that he might not have borne this / Longing so long.",
                                "english": "Our Adam / One rib richer, if a woman / Had not been given to him Eve; supposedly would have asked / GOD to shorten the day, that he might not have borne this / Longing so long."
                            }
                        ]
                    },
