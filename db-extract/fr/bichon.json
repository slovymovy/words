                    },
                    {
                        "form_id": "a4005dfa-67d8-4a56-b1ad-8e0cf7c0f794",
                        "entry_id": "f25908d5-3c15-3f44-9d46-f43d86802fa9",
                        "tags": [
                            "feminine"
                        ],
                        "form": "bichonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6128a1e6-e95f-3a2d-ba07-0b80474ce66b",
                        "entry_id": "f25908d5-3c15-3f44-9d46-f43d86802fa9",
                        "glosses": [
                            "Petit chien de compagnie, au nez court, aux oreilles tombantes, à queue recourbée sur le dos, et au poil long, soyeux, bouclé et ondoyant."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0bfeb075-df1e-4e65-9940-cd64e8c780ae",
                                "sense_id": "6128a1e6-e95f-3a2d-ba07-0b80474ce66b",
                                "text": "Trois bichons la suivent en jappant."
                            },
                            {
                                "example_id": "6b39a2bf-bca7-4498-8e51-3fc74c78ae80",
                                "sense_id": "6128a1e6-e95f-3a2d-ba07-0b80474ce66b",
                                "text": "Elle se chauffait, contente, comme une aïeule, au coin de cette cheminée de pur style Louis XVI, qui convenait à sa beauté de vieille dame indulgente. Il ne lui manquait que son bichon."
                            },
                            {
                                "example_id": "f0bf2a7c-a93a-4e6e-b6d3-208f4d75e6f0",
                                "sense_id": "6128a1e6-e95f-3a2d-ba07-0b80474ce66b",
                                "text": "Il ne fallait pas lésiner là-dessus, avait tranché Marylin, à laquelle Franz était de plus en plus soumis, ça en devenait curieux, il la suivait partout, de pièce en pièce, comme un bichon, quand elle passait ses coups de fil."
                            }
                        ]
                    },
                    {
                        "sense_id": "839e9a11-0cda-3653-813f-721a6c62eb04",
                        "entry_id": "f25908d5-3c15-3f44-9d46-f43d86802fa9",
                        "glosses": [
                            "Se dit affectueusement d’un enfant ou à un enfant."
                        ],
                        "tags": [
                            "Affectueux"
                        ],
                        "examples": [
                            {
                                "example_id": "bed5352a-b66e-4891-89a6-62b1171e7201",
                                "sense_id": "839e9a11-0cda-3653-813f-721a6c62eb04",
                                "text": "Mais qu’est-ce que tu as à pleurer, mon bichon ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4cdfd52-a449-3b91-aa0f-705c76380df1",
                        "entry_id": "f25908d5-3c15-3f44-9d46-f43d86802fa9",
                        "glosses": [
                            "Coussinet de velours utilisé pour redonner du lustre aux chapeaux haut-de-forme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d46a54e6-a7b2-4643-a97e-203162d862ad",
                                "sense_id": "d4cdfd52-a449-3b91-aa0f-705c76380df1",
                                "text": "— Vous regarderez si vos claques fonctionnent, si les ressorts ne sont pas faussés et si l’étoffe n’a pas besoin du bichon."
                            }
                        ]
                    }
