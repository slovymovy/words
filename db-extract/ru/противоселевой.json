                "senses": [
                    {
                        "sense_id": "8eaf4eb4-7dd0-34e5-8693-7bb52f990d44",
                        "entry_id": "ec714235-4c8b-3c73-809a-19f437974f4c",
                        "glosses": [
                            "предназначенный для защиты от селей, предупреждения их"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5200e0c0-28dc-4b14-ad76-d3e122d69edf",
                                "sense_id": "8eaf4eb4-7dd0-34e5-8693-7bb52f990d44",
                                "text": "Она позволит накопить в котловане воду и вместе с тем явится противоселевой дамбой, которая надёжно защитит нижележащие селения, тысячи гектаров плодородных колхозных и совхозных земель."
                            },
                            {
                                "example_id": "d71f5783-afa4-4cb8-a1c8-c137cdae94d9",
                                "sense_id": "8eaf4eb4-7dd0-34e5-8693-7bb52f990d44",
                                "text": "Проблема противоселевой защиты в Казахской ССР приобрела государственное значение."
                            }
                        ]
                    }
