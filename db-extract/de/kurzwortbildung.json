                "senses": [
                    {
                        "sense_id": "d441b4a1-1df7-39de-94df-9b6fe7536cb8",
                        "entry_id": "2582d3a7-b6fb-31f2-962f-276a7ae00009",
                        "glosses": [
                            "Bildung von Kurzwörtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6363052-ae3f-4d71-8adc-db601c993dfe",
                                "sense_id": "d441b4a1-1df7-39de-94df-9b6fe7536cb8",
                                "text": "„Allerdings bringt auch die Werbesprache gegenwärtig Wortschöpfungen hervor, soweit nicht verschiedene Verfahren der Kurzwortbildung genutzt werden…“"
                            },
                            {
                                "example_id": "cf2beb7a-e6f8-437a-815b-9118905b0e22",
                                "sense_id": "d441b4a1-1df7-39de-94df-9b6fe7536cb8",
                                "text": "„Grenzfälle in der Zuordnung zur Kurzwortbildung sind Schwanzwörter…, Kopfwörter…, Klammerformen…“"
                            },
                            {
                                "example_id": "c70c5d4a-82b1-4119-ab8d-58b1b0cdb25e",
                                "sense_id": "d441b4a1-1df7-39de-94df-9b6fe7536cb8",
                                "text": "„Nahezu ganz auf das Substantiv konzentriert sind schließlich auch die verschiedenen Arten der Kurzwortbildung (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
