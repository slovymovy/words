                "senses": [
                    {
                        "sense_id": "4ce66174-7486-3869-9323-337faf5c89ee",
                        "entry_id": "5050340e-0127-3c0d-b978-ce5aa2c13273",
                        "glosses": [
                            "pisarz kancelaryjny, niższy urzędnik kancelarii"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a8063bda-aefb-46eb-bef7-f946aa87b7e1",
                                "sense_id": "4ce66174-7486-3869-9323-337faf5c89ee",
                                "text": "Każde pismo kancelista sygnował swoim nazwiskiem, był bowiem odpowiedzialny za wykonaną pracę"
                            },
                            {
                                "example_id": "f06b8857-1b8d-44ec-8005-52e42230f71e",
                                "sense_id": "4ce66174-7486-3869-9323-337faf5c89ee",
                                "text": "Posłuchaj pan, panie podróżny, co się zdarzyło na Próżnej: / mieszkała tam Jagna dobra i czysta i chodził do niej Jan kancelista"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6af96de-ab0b-4e2e-9a18-82b6722aa94c",
                        "source_entry_id": "5050340e-0127-3c0d-b978-ce5aa2c13273",
                        "source_sense_id": "4ce66174-7486-3869-9323-337faf5c89ee",
                        "target_lang_word": "greffier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greffier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8d7383-fb7b-3f25-a260-5f001461b4e2",
                                        "entry_id": "4d70c00b-428c-3049-ac47-21b8468594f3",
                                        "glosses": [
                                            "Officier public préposé au greffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f450ea-eb7e-48db-91f0-59770d9070cc",
                                                "sense_id": "bb8d7383-fb7b-3f25-a260-5f001461b4e2",
                                                "text": "Le greffier d’une juridiction qui rend une décision impliquant l’obligation pour une personne de s’immatriculer doit notifier cette décision au greffier du tribunal de commerce dans le ressort duquel l’intéressé a son siège ou son établissement principal."
                                            },
                                            {
                                                "example_id": "d4ff52bb-aadd-442c-91a5-fd5a1df5d071",
                                                "sense_id": "bb8d7383-fb7b-3f25-a260-5f001461b4e2",
                                                "text": "Le greffier est la personne responsable des services administratifs d'un tribunal. À ce titre, il remplit principalement des fonctions administratives qui vont de la préparation des audiences à la planification des agendas de la cour, la transcription des témoignages et la formation des jurés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2a158f-6604-3973-862e-abb605b36127",
                                        "entry_id": "4d70c00b-428c-3049-ac47-21b8468594f3",
                                        "glosses": [
                                            "Celui qui prend note et tient le registre de ses notes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e557272-4e54-4b20-a721-bd1ce3d5f1a7",
                                                "sense_id": "1b2a158f-6604-3973-862e-abb605b36127",
                                                "text": "L’Académie […] était partagée intellectuellement, comme elle l’a toujours été, entre la pensée de n’être que le greffier de l’usage, qui est sa pensée maîtresse, et un certain désir sourd d’en être un peu le guide, ce qui est, à mon avis, parfaitement légitime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "greffier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "048c7bac-06b5-3979-bec5-428ac930318a",
                                        "entry_id": "68ec90cd-c810-36a9-aab8-c22c45d46571",
                                        "glosses": [
                                            "Chat."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd771ca-6e8c-4c1e-b1da-f91726535240",
                                                "sense_id": "048c7bac-06b5-3979-bec5-428ac930318a",
                                                "text": "Et là, c’est juste la grimace\nD’un matou sénile et pelé\nMais ses yeux sont tellement zarbis\nEt son agonie si tranquille\nQue même les greffiers, par ici,\nDonnent l’impression d’être en exil."
                                            },
                                            {
                                                "example_id": "7691124d-b4bd-4b59-92c5-25a581e58111",
                                                "sense_id": "048c7bac-06b5-3979-bec5-428ac930318a",
                                                "text": "Dans le quartier même le mois le plus doux\nTu ne risques pas d’entendre miaou\nDes greffiers mignons y en a plus bezef\nIls sont tous devenus terrine du chef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a424588-3aa8-34bd-829e-7eb6a44e36bf",
                                        "entry_id": "68ec90cd-c810-36a9-aab8-c22c45d46571",
                                        "glosses": [
                                            "Sexe de la femme, minou, chatte, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23dc775e-21a5-489f-858b-9db12b7c9566",
                                                "sense_id": "7a424588-3aa8-34bd-829e-7eb6a44e36bf",
                                                "text": "Elle avait pas tellement le choix, faut dire, question homme pour se faire encore régaler à son âge avec sa patte folle. Depuis qu'Albert faisait la fête à son greffier, elle s'efforçait de réparer l'outrage des ans sur sa frime...… toute la panoplie séductrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae4c7bf8-a08f-3306-bb6c-581013282756",
                                        "entry_id": "68ec90cd-c810-36a9-aab8-c22c45d46571",
                                        "glosses": [
                                            "Poisson-chat commun (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
