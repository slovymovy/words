                    },
                    {
                        "translation_id": "3e0c39d4-e880-41c8-a794-50335fb2f0c2",
                        "source_entry_id": "d414aa3c-199f-3b52-85b4-f5227f3dff4c",
                        "source_sense_id": "d6b7ca59-04c7-3164-a73a-432c8344fdfb",
                        "source_sense_description": "de vijfentwintigste letter van het alfabet",
                        "target_lang_word": "y",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "y",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8549ab-f716-32c2-aecf-1214312b62e5",
                                        "entry_id": "2cb9d8dd-88bc-3232-9d91-87f58c95544d",
                                        "glosses": [
                                            "Vingt-cinquième lettre et sixième voyelle de l’alphabet (minuscule). Appelé i grec pour distinguer de l’i."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f72f12a-8f1d-448a-bdf6-40420431394c",
                                                "sense_id": "4c8549ab-f716-32c2-aecf-1214312b62e5",
                                                "text": "[…], d’Ablancourt supprimait énergiquement les lettres doubles et mettait i pour y à peu près partout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "y",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46e753d2-c890-33d2-a553-7a55fecdd61c",
                                        "entry_id": "2f012a34-527a-3415-9f37-0d3d970cea1a",
                                        "glosses": [
                                            "(Remplace un COI inanimé introduit par à) À ceci, à cela, à ça."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "736ac7ff-83e4-4b10-b598-0a996b9a2752",
                                                "sense_id": "46e753d2-c890-33d2-a553-7a55fecdd61c",
                                                "text": "Comme la nuit se refermait sur tout le bocage, le triste cocher n’y voyait guère pour parcourir la faible distance qui le menait désormais au bourg d’Arquian."
                                            },
                                            {
                                                "example_id": "335490f6-e1a4-4451-9698-3a25ce94a441",
                                                "sense_id": "46e753d2-c890-33d2-a553-7a55fecdd61c",
                                                "text": "II est établi dans la Commune un emplacement particulier, affecté spécialement à l’abattis des porcs, et mis à la disposition du public pour cet usage, en se conformant aux règlements y relatifs."
                                            },
                                            {
                                                "example_id": "5e982fcb-d489-43e5-86ae-a6775382791f",
                                                "sense_id": "46e753d2-c890-33d2-a553-7a55fecdd61c",
                                                "text": "Et, comme cela n’était pas suffisant, Vallese a augmenté la dose du Twin Cam en y greffant des pistons Wiseco portant la cylindrée à 1 550 cc (au lieu de 1 450 cc) […]."
                                            },
                                            {
                                                "example_id": "23923818-25a4-4b7e-9460-ecb06ba639c8",
                                                "sense_id": "46e753d2-c890-33d2-a553-7a55fecdd61c",
                                                "text": "Ne vous y fiez pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272dcabd-5458-39e6-b961-e21f466e8087",
                                        "entry_id": "2f012a34-527a-3415-9f37-0d3d970cea1a",
                                        "glosses": [
                                            "Ça (comme COD)."
                                        ],
                                        "tags": [
                                            "Auvergne-Rhône-Alpes",
                                            "Bourgogne",
                                            "Suisse",
                                            "Parler gaga"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77cdaf4d-87f9-408c-9caa-1918c26ab5aa",
                                                "sense_id": "272dcabd-5458-39e6-b961-e21f466e8087",
                                                "text": "Contrairement au français standard où « y » est uniquement pronom indirect (« j’y pense souvent ) ou adverbe complément de lieu (« n’y allez pas ») le gaga actuel connaît aussi l’utilisation du « y » comme pronom neutre (démonstratif ou anaphorique) complément direct du verbe (« J’y aime pas. J’y ai fait. J’y dis. »). Dans ce cas, il peut remplacer le « le/l’ » du français standard mais seulement dans un contexte de neutre."
                                            },
                                            {
                                                "example_id": "024b021b-7ff6-4e37-b19a-af9d4d172d89",
                                                "sense_id": "272dcabd-5458-39e6-b961-e21f466e8087",
                                                "text": "T’y sais pas, ce qui lui est arrivé ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                        "entry_id": "2f012a34-527a-3415-9f37-0d3d970cea1a",
                                        "glosses": [
                                            "Lui (à lui, à elle) (comme COI animé). référence nécessaire (résoudre le problème)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b34eab-0947-41bb-a173-c9d9e25fec20",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "— Tu viens ? j’y dis."
                                            },
                                            {
                                                "example_id": "80e87d09-95de-4c07-b7d7-e4f13153fa34",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "Vous la tueriez, vous n’y feriez pas dire pourquoi on l’a frappée."
                                            },
                                            {
                                                "example_id": "e92e5be3-b800-466e-9a37-b550bc90ede5",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "– Et figurez-vous, madame la directrice, que j’y ai promis, quand elle aurait la croix, d’y payer le concert ou un jupon de laine : elle choisira."
                                            },
                                            {
                                                "example_id": "022f137e-61e2-4f65-ad0d-2530efbe510c",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "J’y ai dit d’aller voir dans la cuisine."
                                            },
                                            {
                                                "example_id": "01593060-1cda-4004-a6fd-161a1d1d2015",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "Alle avait eun’ robe d’ reps noir, / L’ matin ça y servait d’ peignoir, / La nuit ça y servait d’ limace, / À Montpernasse."
                                            },
                                            {
                                                "example_id": "d3460170-4626-4386-a3ad-c4bced7a2525",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "Alors t’y dit qu’s’y sont pas contents, on les emmerde !"
                                            },
                                            {
                                                "example_id": "25725465-213a-43a3-b636-e58e7846569c",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "— Il m’a dit : « Est-ce que tu as des oies ? » J’y ai dit : « Oui, j’ai des oies ; ça dépend. » – « Va m’en chercher une. » J’y dis : « Sont pas très grasses », mais il a insisté, alors j’y ai dit : « Eh bien, venez. » On a fait le tour du hangar et j’y ai attrapé une oie."
                                            },
                                            {
                                                "example_id": "a6444271-f80b-460a-a8c6-4862b9643ff8",
                                                "sense_id": "ccf239f7-18e4-3ee6-a37a-9c7512241090",
                                                "text": "Non, j’y ai dit que j’allais appeler quelqu’un pour lui, mais c’est tout, à lui de conclure l’accord qu’y veut."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "y",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                        "entry_id": "86d7ad9a-1587-3b57-8ff1-a8100c603ff0",
                                        "glosses": [
                                            "Contraction de il ou ils, dans le langage parlé. Cette forme retranscrit la prononciation courante qui a tendance à effacer devant consonne le L de il et ils."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a0c757-c4c9-4047-b3b3-61a7bedef61a",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "Y fait beau aujourd’hui."
                                            },
                                            {
                                                "example_id": "b72c76d7-8933-4625-9f44-7ba7471a5a96",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "— Si vous voulez que je vous aide à porter votre panier.\n— C’est pas de refus, y pèse rud’ment. »"
                                            },
                                            {
                                                "example_id": "7d6d1084-af13-423a-a7de-e391a339edeb",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "Pour moi, le plus fort, c’est le père Floconnet, le commandant qu’on avait en Champagne. Y passait son temps à faire la chasse aux colombins."
                                            },
                                            {
                                                "example_id": "c9370e49-a505-4994-b6b1-4e80e842614b",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "À tinquer comme y tinque, on savait bien qu’y en arriverait là un jour!"
                                            },
                                            {
                                                "example_id": "e7c0494f-1915-4f0a-9f19-f4b6d5cfb2dd",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "Y ne peut pas être loin… si toutefois, sa rossinante ne s’est pas clamsée en chemin !…"
                                            },
                                            {
                                                "example_id": "aa6b17e6-0c1f-43af-b328-a54727b2968d",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "— Y fait mieux que dormir, le pôvre, il est tombé en pâmoison."
                                            },
                                            {
                                                "example_id": "2f605137-e8fd-4737-a55b-f6c3da0622c1",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "Y s’embringue dans une histoire avec sa secrétaire parce qu’il travaille tard le soir au boulot, et alors sa femme se figure qu’il pieute avec elle, ou quelque chose dans ce goût-là."
                                            },
                                            {
                                                "example_id": "293c1459-4205-4814-9abb-d8e7ca3c8031",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "Que dalle, fit René, s’il en reveut, y repaye…"
                                            },
                                            {
                                                "example_id": "8ce86b26-b5db-4648-bd32-9e71183fc4f8",
                                                "sense_id": "9b8a4698-e0e9-34cb-ad12-bd132b50e6da",
                                                "text": "— C’est un putain d’Anglais, y s’appelle Sir John Scott Kockott ! Y comprend que dalle à c’que tu lui dis…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "y",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25163210-d8fe-3e2a-a7e1-7d0d183369cf",
                                        "entry_id": "6a4253e9-3d5d-3528-9b22-b2a948b1d8ef",
                                        "glosses": [
                                            "Ici, là, à cet endroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01bf4265-1c54-474a-984d-0c4937cc6fd1",
                                                "sense_id": "25163210-d8fe-3e2a-a7e1-7d0d183369cf",
                                                "text": "Après avoir situé le monde russe sur le planisphère, entrons-y pour en déterminer les caractères physiques."
                                            },
                                            {
                                                "example_id": "e71f7aa9-c8dd-4082-acb6-60e765552262",
                                                "sense_id": "25163210-d8fe-3e2a-a7e1-7d0d183369cf",
                                                "text": "Allo !… Y’a quelqu’un là-dedans ?"
                                            },
                                            {
                                                "example_id": "93cf939b-049a-4308-8594-504cf53f6a6e",
                                                "sense_id": "25163210-d8fe-3e2a-a7e1-7d0d183369cf",
                                                "text": "Déjà, les chambres de commerce applaudissent l’idée de servir ceux ayant été vaccinés, alors que ceux qui attendent encore leur dose chez eux y resteront."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "y",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45dfafa4-a9be-37bd-8c82-a7c60255ea7c",
                                        "entry_id": "48814114-2494-3a01-9364-ce810ea9c0da",
                                        "glosses": [
                                            "Variante orthographique de ti après un t."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79363e0b-18ad-4b4e-ab86-d1c7613c9f24",
                                                "sense_id": "45dfafa4-a9be-37bd-8c82-a7c60255ea7c",
                                                "text": "Cinquante quoi ? Est-il bête ! est-il bête ! Si je te donnais cinquante taloches, ça te ferait-y cinquante francs ?"
                                            },
                                            {
                                                "example_id": "745fbb4a-51ef-412d-8e34-f7ca774b386c",
                                                "sense_id": "45dfafa4-a9be-37bd-8c82-a7c60255ea7c",
                                                "text": "C’est-y vrai, Thomas ? Tu n’es donc pas connaisseur ?"
                                            },
                                            {
                                                "example_id": "ac5c9adc-9872-4d74-acc8-3815fc6cee30",
                                                "sense_id": "45dfafa4-a9be-37bd-8c82-a7c60255ea7c",
                                                "text": "Et puis Rousseau paiera la goutte, par-dessus le marché… C’est-y convenu comme ça ?"
                                            },
                                            {
