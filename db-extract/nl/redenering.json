                ],
                "translations": [
                    {
                        "translation_id": "1a455502-47da-48d0-a688-13de616d8938",
                        "source_entry_id": "3ef875df-2579-338a-b779-45ebcc0271bf",
                        "source_sense_id": "0b4a5e8d-4043-37bf-8b5e-e3e046bb1d25",
                        "source_sense_description": "het proces waarmee men van een aantal argumenten, premissen of axioma's tot een standpunt of conclusie komt",
                        "target_lang_word": "Argumentation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Argumentation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21abedb5-17b2-33ba-84e0-285efaa18825",
                                        "entry_id": "97782543-9dde-3bb5-b4bf-2381921702a0",
                                        "glosses": [
                                            "eine Darlegung der Argumente zur Untermauerung der These, eine Begründung, Beweisführung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d572e1f-7062-44ed-8375-71d990b23465",
                                                "sense_id": "21abedb5-17b2-33ba-84e0-285efaa18825",
                                                "text": "„Nun wurden Details aus Bergdahls fünfjähriger Geiselhaft an die Presse lanciert - und diese Einblicke könnten die Argumentation von US-Präsident Barack Obama stützen.“"
                                            },
                                            {
                                                "example_id": "466f9c5a-5916-407d-a4a8-06e9f78ea55c",
                                                "sense_id": "21abedb5-17b2-33ba-84e0-285efaa18825",
                                                "text": "„Das wird Lenins innere Argumentation gewesen sein.“"
                                            },
                                            {
                                                "example_id": "fd7241c7-968b-4876-ac04-f96cc2449ef0",
                                                "sense_id": "21abedb5-17b2-33ba-84e0-285efaa18825",
                                                "text": "„So nachvollziehbar Huizinga die spielfeindlichen Einflüsse industrieller Marktförmigkeit auf Kunst und Literatur auch aufdeckt, verbirgt sich in seiner Argumentation doch ein innerer Widerspruch: […].“"
                                            },
                                            {
                                                "example_id": "f49103f3-54eb-46de-870c-9cb236ec0248",
                                                "sense_id": "21abedb5-17b2-33ba-84e0-285efaa18825",
                                                "text": "„Allerdings, legt man diese Argumentation ihrerseits unter die kritische Lupe, enthüllt sich folgender Tatbestand: ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d44c57d9-0bed-4b4c-80fa-48e53e2167d6",
                        "source_entry_id": "3ef875df-2579-338a-b779-45ebcc0271bf",
                        "source_sense_id": "0b4a5e8d-4043-37bf-8b5e-e3e046bb1d25",
                        "source_sense_description": "het proces waarmee men van een aantal argumenten, premissen of axioma's tot een standpunt of conclusie komt",
                        "target_lang_word": "reasoning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reasoning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9989b871-50c0-3842-b4b9-4e491aeddc26",
                                        "entry_id": "24c56359-aad6-341b-ad45-30dcb8ae1b54",
                                        "glosses": [
                                            "The deduction of inferences or interpretations from premises, abstract thought, ratiocination; (countable) any instance of this, especially as a process leading to an action, motive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b909b5-1f91-4b8f-a475-b8ed3dee7474",
                                                "sense_id": "9989b871-50c0-3842-b4b9-4e491aeddc26",
                                                "text": "Her reasoning was clear and logical."
                                            },
                                            {
                                                "example_id": "6a45dff7-900b-4830-ac65-9e6454f11042",
                                                "sense_id": "9989b871-50c0-3842-b4b9-4e491aeddc26",
                                                "text": "I don’t follow your reasoning on this issue."
                                            },
                                            {
                                                "example_id": "d7bf2798-64b9-4831-adc9-b23817308ddf",
                                                "sense_id": "9989b871-50c0-3842-b4b9-4e491aeddc26",
                                                "text": "Good reasoning helps solve complex problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe38bf9-0232-3e3e-947f-25a5d7448965",
                                        "entry_id": "24c56359-aad6-341b-ad45-30dcb8ae1b54",
                                        "glosses": [
                                            "A Rastafari meeting held for the purposes of chanting, prayer and discussion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
