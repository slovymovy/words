                        "entry_id": "5aa8b522-9648-3ec2-8022-60323c5e5e7b",
                        "glosses": [
                            "Not suspecting; without any suspicion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e918dcbe-d634-4bb3-b17b-5c9b7738bbb3",
                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                "text": "He easily shot the unsuspecting target."
                            },
                            {
                                "example_id": "fc9c52f1-0998-4fe0-a7dd-0e63b2bc1f37",
                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                "text": "One by one grotesque forms emerged from the jungle to creep stealthily upon the unsuspecting woman."
                            },
                            {
                                "example_id": "6523ecdb-205a-4de9-b182-dbe4b5680f05",
                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                "text": "To unsuspecting eyes these mongoose relatives can seem eminently pettable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17843cb6-776c-48ca-a9b0-5e6ade816094",
                        "source_entry_id": "5aa8b522-9648-3ec2-8022-60323c5e5e7b",
                        "source_sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
