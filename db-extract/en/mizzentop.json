                        "glosses": [
                            "A framework and platform at the top of the lower mizzenmast of a sailing ship"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9e7e1e-17f7-49a8-860d-d466c6699d4f",
                                "sense_id": "d40671da-a09d-3405-b511-e24255b31bf6",
                                "text": "1761, Richard Owen Cambridge, An Account of the War in India Between the English and the French on the Coast of Coromandel, from the Year 1750 to the Year 1761, Second edition, London: T. Jefferys, 1762, p. 178, https://books.google.ca/books?id=XJybUabhbGgC&printsec=frontcover#v=onepage&q&f=false\n[…] the Compte de Provence, the enemies leading ship, put before the wind, having cut away her mizen-mast on account of taking fire in the mizen top."
                            },
                            {
                                "example_id": "e7f01ee2-6533-48f4-913f-aad4c6b25f36",
                                "sense_id": "d40671da-a09d-3405-b511-e24255b31bf6",
                                "text": "The naval action in front of the pedestal exhibits the situation of the fleet towards the conclusion of the battle, when the hero was mortally wounded by a shot from the mizen-top of a seventy-four, with which ship the Victory appears to be closely engaged."
                            },
                            {
                                "example_id": "d0e2d725-77b2-4631-b456-63d5596b2071",
                                "sense_id": "d40671da-a09d-3405-b511-e24255b31bf6",
                                "text": "[…] he had thought of recommending him to the executive officer for promotion to a place that would more frequently bring him under his own observation, namely, the captaincy of the mizzentop […]"
                            },
                            {
                                "example_id": "97e6acd8-26d6-42a9-bad7-c44489ac2933",
                                "sense_id": "d40671da-a09d-3405-b511-e24255b31bf6",
                                "text": "Hornblower […] turned away to go aloft so as to brood over the question in the solitude of the mizzen-top."
                            }
                        ]
                    }
