                                    {
                                        "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                                        "entry_id": "29529c01-d5c0-39e9-941e-d2a168e340d2",
                                        "glosses": [
                                            "хим. продукт дистилляции"
