    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                "word": "individualistic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d134118b-b6ab-4818-99b5-709ff91b97b4",
                        "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more individualistic"
                    },
                    {
                        "form_id": "383152f3-a0c8-4867-9db9-429c36f5cdb6",
                        "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most individualistic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a74e6ed-f3cf-315a-a9f5-f7e73606fb6a",
                        "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                        "glosses": [
                            "More interested in individual people than in society as a whole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e3a7ef-021d-4de9-8fb6-0e92beda3cd9",
                                "sense_id": "8a74e6ed-f3cf-315a-a9f5-f7e73606fb6a",
                                "text": "It is, then, as a treatise of social forces, individualistic and collectivistic, in German literature that Francke's work must be tested, not as a history of the artistic form and content of that literature."
                            },
                            {
                                "example_id": "5511c651-14ff-4833-9190-6c0ab682100b",
                                "sense_id": "8a74e6ed-f3cf-315a-a9f5-f7e73606fb6a",
                                "text": "People in individualistic cultures may be more concerned with distributive justice than people in collectivistic cultures because they have such clear-cut notions of individual equity."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff45cfd5-426b-3ffd-b856-e114aa6bf5b8",
                        "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                        "glosses": [
                            "Interested in oneself rather than others; egocentric."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f6a71c-14c1-4265-bc34-c1f194e65599",
                                "sense_id": "ff45cfd5-426b-3ffd-b856-e114aa6bf5b8",
                                "text": "A few examples will demonstrate the cultural basis of individualistic, greedy, and anticooperative behavior."
                            },
                            {
                                "example_id": "88a592e6-75c2-4564-83fd-e078c5e6562a",
                                "sense_id": "ff45cfd5-426b-3ffd-b856-e114aa6bf5b8",
                                "text": "The researchers posit that something they call the “hipster effect” asserts itself in human populations no matter how individualistic we imagine ourselves to be, because it’s individuality itself that sparks conformity."
                            }
                        ]
                    },
                    {
                        "sense_id": "08e42dcd-bf43-3e2d-8970-f1b11d7c0164",
                        "entry_id": "d2d9d903-141a-3e9c-8586-e8fb91f68b5b",
                        "glosses": [
                            "Having idiosyncratic behaviour or ideas."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
