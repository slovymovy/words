{
    "word_family": [
        "appartenance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                    "sense_definition": "Être la propriété de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre <w>appartient</w> à ma sœur depuis des années."
                        },
                        {
                            "text": "Cette vieille maison n'<w>appartient</w> plus à notre famille."
                        }
                    ],
                    "synonyms": [
                        "être à"
                    ],
                    "common_phrases": [
                        "appartenir à quelqu'un"
                    ]
                },
                {
                    "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                    "sense_definition": "Faire partie d'un ensemble, d'une collectivité ou d'une catégorie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musicien talentueux <w>appartient</w> à un orchestre symphonique réputé."
                        },
                        {
                            "text": "Plusieurs pays d'Europe <w>appartiennent</w> à cette organisation internationale."
                        }
                    ],
                    "synonyms": [
                        "faire partie de"
                    ],
                    "common_phrases": [
                        "appartenir à un groupe"
                    ]
                },
                {
                    "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                    "sense_definition": "Incomber à quelqu'un, relever de sa responsabilité ou de son devoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>appartient</w> aux juges d'examiner attentivement toutes les preuves."
                        },
                        {
                            "text": "Il vous <w>appartient</w> de prendre cette décision importante pour l'équipe."
                        }
                    ],
                    "synonyms": [
                        "incomber",
                        "revenir"
                    ],
                    "common_phrases": [
                        "il appartient à"
                    ]
                },
                {
                    "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                    "sense_definition": "Être le propre, la prérogative ou le caractère exclusif de quelqu'un ou de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "propre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le droit de grâce suprême <w>appartient</w> traditionnellement au chef de l'État."
                        },
                        {
                            "text": "Cette subtilité d'expression n'<w>appartient</w> qu'aux plus grands écrivains."
                        }
                    ]
                }
            ]
        }
    ]
}