                ],
                "senses": [
                    {
                        "sense_id": "49c5ac30-7b9c-3228-95bc-50990329a2d8",
                        "entry_id": "38d008e4-a27c-3744-9041-536cb01f6974",
                        "glosses": [
                            "Rendre plus déluré, plus malin, plus vif d’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4140d45-dee2-4b39-9cde-1a4827e00967",
                                "sense_id": "49c5ac30-7b9c-3228-95bc-50990329a2d8",
                                "text": "Son séjour à l'étranger l'a délurée, elle a appris à se débrouiller seule."
                            }
                        ]
                    },
                    {
                        "sense_id": "07a6989f-1928-361b-afb5-e2091b2b3bd3",
                        "entry_id": "38d008e4-a27c-3744-9041-536cb01f6974",
                        "glosses": [
                            "Rendre plus libre de mœurs, déniaiser, dévergonder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023e8225-35ac-4dc0-8d8d-766b20e1f3b8",
                                "sense_id": "07a6989f-1928-361b-afb5-e2091b2b3bd3",
                                "text": "Elle prend un malin plaisir à délurer ses copines."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ae31338-1c7f-379a-9db1-852df97a26e0",
                        "entry_id": "38d008e4-a27c-3744-9041-536cb01f6974",
                        "glosses": [
                            "Devenir plus déluré, plus malin, plus vif d'esprit."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "77c3b8c8-46b0-42ca-b093-b5f19fe95f05",
                                "sense_id": "5ae31338-1c7f-379a-9db1-852df97a26e0",
                                "text": "Il s'est déluré depuis qu'il va à l'école."
                            },
                            {
                                "example_id": "1bea6a10-6f95-42c5-938f-7fbb50233e3a",
                                "sense_id": "5ae31338-1c7f-379a-9db1-852df97a26e0",
                                "text": "« On s’est moqué de toi, mon garçon ! Ah ! tu ne t’es pas plus déluré que ça dans ton Paris ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "d73bc07e-4742-306f-81c5-c156e1db99c9",
                        "entry_id": "38d008e4-a27c-3744-9041-536cb01f6974",
                        "glosses": [
                            "Devenir plus libre de mœurs, se déniaiser, se dévergonder."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "71343926-7f5f-43a6-b9fe-6a50d91f54df",
                                "sense_id": "d73bc07e-4742-306f-81c5-c156e1db99c9",
                                "text": "Ma soeur s'est délurée en peu de temps, elle sort en mini-jupe!"
                            }
                        ]
                    }
