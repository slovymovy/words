                    }
                ],
                "senses": [
                    {
                        "sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                        "entry_id": "2a4995c2-cf1c-3dc2-8d4b-be20d91578e2",
                        "glosses": [
                            "eine Beförderung fort von einem Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893cca6a-98cf-4061-a250-4fb4b2d3d8f8",
                                "sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                                "text": "Der Abtransport der Waren verzögert sich noch um mindestens eine halbe Stunde."
                            },
                            {
                                "example_id": "d6f18905-0f80-43fe-a505-ce72641f7027",
                                "sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                                "text": "„Wenn man sich bei der zuständigen Miliz meldet und für den Abtransport registrieren läßt, dann wird alles seinen ordentlichen, geregelten Gang gehen.“"
                            },
                            {
                                "example_id": "c8d0d439-2a0e-4b31-b7fa-14f8633759f6",
                                "sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                                "text": "„Man wisse nie, meinte er grämlich, wie lange der Aufenthalt währe und in welchen Augenblick hinein das Horn ertöne und wem das Zeichen für den Abtransport gelte.“"
                            },
                            {
                                "example_id": "74b2aa4f-ebde-4480-9d64-a95f3e4dd072",
                                "sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                                "text": "„Die zweite Verfügung definierte die Art der Registrierung und des Abtransports.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94b16bf1-58d2-451c-9b9e-5c9f398baf1a",
                        "source_entry_id": "2a4995c2-cf1c-3dc2-8d4b-be20d91578e2",
                        "source_sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                        "source_sense_description": "eine Beförderung fort von einem Ort",
                        "target_lang_word": "transportation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transportation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96832bb3-27e2-3436-ae83-69458bb5e4c0",
                                        "entry_id": "1fe2ce3f-e40c-39ba-9de8-44503612f9b0",
                                        "glosses": [
                                            "The act of transporting, or the state of being transported; conveyance, often of people, goods etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f5fea10-ea17-4089-bd2c-f0779b7ff07e",
                                                "sense_id": "96832bb3-27e2-3436-ae83-69458bb5e4c0",
                                                "text": "We have to get people out of their cars and encourage them to use alternative forms of transportation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8d29e8-1554-33be-b484-f35299671192",
                                        "entry_id": "1fe2ce3f-e40c-39ba-9de8-44503612f9b0",
                                        "glosses": [
                                            "Deportation to a penal colony."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b53b35-88e8-4eb3-ba8d-7a1976b25ec8",
                                                "sense_id": "cb8d29e8-1554-33be-b484-f35299671192",
                                                "text": "Mulligan's sentence was commuted from death to transportation."
                                            },
                                            {
                                                "example_id": "f3f6824a-d2b4-4bae-a0e7-79f3c53f3527",
                                                "sense_id": "cb8d29e8-1554-33be-b484-f35299671192",
                                                "text": "Redpath was sentenced to transportation for life, and his assets, amounting to over £25,000, went to reduce the sum that the Great Northern had to find."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa31a813-692b-3ee5-bb6e-e792bd6eefbc",
                                        "entry_id": "1fe2ce3f-e40c-39ba-9de8-44503612f9b0",
                                        "glosses": [
                                            "A means of conveyance."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15cd6b2a-66ca-4fc2-9f1c-d74768dbc772",
                                                "sense_id": "fa31a813-692b-3ee5-bb6e-e792bd6eefbc",
                                                "text": "Nice transportation, dude, but your brake lights are busted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a258af1-57b4-389f-afcd-67afb0f00983",
                                        "entry_id": "1fe2ce3f-e40c-39ba-9de8-44503612f9b0",
                                        "glosses": [
                                            "A ticket or fare."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955f4e86-cd3d-4618-9beb-1474e7494a35",
                                                "sense_id": "7a258af1-57b4-389f-afcd-67afb0f00983",
                                                "text": "Sybil: [..] That reminds me, I haven't got my passes yet! Have you the transportation here from Cheyenne to San Francisco for Mrs. S. Johnston?\"\n(Agent looks grave, goes back and fumbles at the papers on his desk, returns to the window with a slip of paper in his hand.)\nAgent: \"We had transportation here made out for such a person, but it was called for several hours ago.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae3987bd-2530-418b-805b-0d10ea3898fc",
                        "source_entry_id": "2a4995c2-cf1c-3dc2-8d4b-be20d91578e2",
                        "source_sense_id": "500d3f7b-866e-3df8-891e-c2fce6dedfcd",
                        "source_sense_description": "eine Beförderung fort von einem Ort",
                        "target_lang_word": "évacuation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évacuation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Action d’évacuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ed6429-30df-45eb-91ed-12c6d339fa7f",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "1ae12b29-986b-433e-bef9-13b7c7fdafba",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "Les mâchefers doivent être traités avant évacuation. Il faut les refroidir, les broyer, les déferrailler."
                                            },
                                            {
                                                "example_id": "4f877f83-9347-4c37-949c-5484f555ea41",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "Le groupement de Cayenne, avec son hélicoptère et sa vedette de haute mer, concourt aussi à la protection civile, intervenant en cas de sinistre, pour les recherches, le secours et les évacuations sanitaires les plus urgentes."
                                            },
                                            {
                                                "example_id": "9a51847a-6430-49f6-b88a-3dc343a51da3",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "J'auscultais le réservoir et le petit placard. Il ne contenait que des serviettes. La poubelle : des cotons-tiges. Les tuyaux d’évacuation refoulaient du goulot. C'était intenable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Décharge, sortie d’humeurs, d’excréments, ou de matières viciées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2ca8f1-f3a7-4004-af1d-80872ad63407",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "Il se produisit une évacuation qui le sauva."
                                            },
                                            {
                                                "example_id": "2ecd9ff1-5cfd-42fe-9c7c-14daac51618e",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "à la suite d’une légère évacuation, il se trouva un peu mieux."
                                            },
                                            {
                                                "example_id": "b65dfcd4-f533-4302-97ea-f1023d1ef46a",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "Évacuation par haut et par bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Matières évacuées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16c5141-15e7-4ee3-9427-018add935518",
                                                "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                                "text": "Le médecin, en voyant les évacuations, jugea que le malade était beaucoup mieux."
                                            },
                                            {
                                                "example_id": "bdea0044-a3c5-4c11-bb05-f5fe96321f19",
                                                "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                                "text": "Seul avec cette enfant de deux mois à peine, qu’il va scrupuleusement voir matin et soir, assistant à son bain, s’informant de ses biberons et de ses évacuations, mais qui n’est encore qu’un petit animal que le cours des événements a mis entre ses mains, et qu’il n’y a pas déjà de raisons d’aimer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Action d’évacuer un pays, une place de guerre, en conséquence d’un traité, d’une capitulation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5d939c-f55b-4f05-9637-184c5a6a26cf",
                                                "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                                "text": "Quelques gardes nationaux s'efforçaient de calmer l'effervescence populaire, et parlementaient, en vain, avec la troupe, pour obtenir l'évacuation du poste."
                                            },
                                            {
                                                "example_id": "b2a9080b-bbae-4558-8879-f8dbec81b512",
                                                "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                                "text": "Il était dit par le traité qu’après l’évacuation de la place, de la province, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88723acf-79fd-30ba-895e-6d81bbc688f1",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Toute sortie en masse produite par nécessité, par ordre ou par des mesures de force."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c05426-cf76-46fe-ac64-ae4e8d139409",
                                                "sense_id": "88723acf-79fd-30ba-895e-6d81bbc688f1",
                                                "text": "La RATP veut à tout prix éviter les évacuations (lire encadré), qui génèrent des surincidents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
