                        "examples": [
                            {
                                "example_id": "1a0f3858-2bd9-4be3-8dd7-427f3b7b27c4",
                                "sense_id": "0a6dbd2c-cd16-3a9f-963d-7b7719b26883",
                                "text": "Beaucoup de Podencos de l'an passé ont été sauvés par des ong étrangères et qui sait si elles ne devront pas en resauver d'autres devant les manquements de la Municipalité."
                            },
                            {
                                "example_id": "a2dea7f6-403a-435d-8952-b009daba2042",
                                "sense_id": "0a6dbd2c-cd16-3a9f-963d-7b7719b26883",
                                "text": "Et mon petit Rayden ? qui va le resauver ?"
                            },
                            {
                                "example_id": "6754d40b-d003-4e1b-a5db-1efab18db6f4",
                                "sense_id": "0a6dbd2c-cd16-3a9f-963d-7b7719b26883",
                                "text": "Il il m’a resauvé, le docteur."
                            }
                        ]
                    }
