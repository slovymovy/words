                ],
                "senses": [
                    {
                        "sense_id": "230754ce-8daa-3c0c-81c8-4b92e010e6b4",
                        "entry_id": "91d1cb6e-fdc9-34e2-9d5e-94054232176f",
                        "glosses": [
                            "niet gezellig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e48a4c-dda4-4d51-be2d-f15cdd86a2c5",
                                "sense_id": "230754ce-8daa-3c0c-81c8-4b92e010e6b4",
                                "text": "De alleenstaande man woonde in een heel ongezellig en kaal huis."
                            },
                            {
                                "example_id": "bfe8ca02-8afd-4c25-b686-105b6cc34a64",
                                "sense_id": "230754ce-8daa-3c0c-81c8-4b92e010e6b4",
                                "text": "De meeste vakantiegangers nemen de Autoroute du Soleil, een ongezellige snelweg met irritante tolpoorten en karakterloze wegrestaurants."
                            },
                            {
                                "example_id": "3fc2f14a-6c32-4a8a-ad5f-12fa8105d26a",
                                "sense_id": "230754ce-8daa-3c0c-81c8-4b92e010e6b4",
                                "text": "Op dit moment zorgt Wijnveld met zijn collega's voor het uitrollen van de anderhalvemetereconomie in negen steden in ons land: \"Halsema zei bij Op1 dat ze zondag toch onrustig werd, normaal ga je bij twijfel voor de zekerheid toch voorbereidingen inzetten, zorg je dat afzettingen klaar staan, of led-schermen om mensen er op te wijzen dat het vol is. Dat is niet gebeurd. Dan kun je ook niet meer ingrijpen, zonder dat het ongezellig wordt.\""
                            }
                        ]
                    }
                ],
