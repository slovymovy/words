                        "examples": [
                            {
                                "example_id": "765aeafb-915a-4baa-a052-47f9cdfdf10d",
                                "sense_id": "9e23894c-2ceb-3cb8-b853-323ae9ebcc03",
                                "text": "Les premières font rousses, & contiennent une moëlle verte , à peu près du goût des pignolats ; elles pendent en grappes, au bout des branches de l'arbre."
                            },
                            {
                                "example_id": "8090b081-fd8f-404d-9cf0-b05d2c1ee5c7",
                                "sense_id": "9e23894c-2ceb-3cb8-b853-323ae9ebcc03",
                                "text": "La tige des dicotylédones est composée de trois organes distincts : la moëlle, le corps ligneux et l’écorce."
                            },
                            {
                                "example_id": "81fc43cd-4a25-4361-b2ba-a61031957f20",
                                "sense_id": "9e23894c-2ceb-3cb8-b853-323ae9ebcc03",
                                "text": "Le nombre de cernes de croissance mesurés, de la moëlle à la limite du duramen/aubier, approche donc l’âge réel des arbres utilisés."
                            }
                        ]
                    }
