                ],
                "senses": [
                    {
                        "sense_id": "f0ddecc5-40dc-33bc-8b1a-0f551ec9f194",
                        "entry_id": "badc2174-b4db-35be-a7b4-4f215fb60447",
                        "glosses": [
                            "Vermögen, mit den Sinnen/Sinnesorganen körperliche (sensuelle) Reize aufnehmen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c934a0-2bc2-46d8-ae10-56ff1c59788b",
                                "sense_id": "f0ddecc5-40dc-33bc-8b1a-0f551ec9f194",
                                "text": "„Die Sensualität wird durch die Sinnesorgane vermittelt. Wir finden nämlich im menschlichen Organismus eigene Organe, welche besonders qualificirt sind, um Eindrücke bestimmter Art zu empfangen.“ (1858)"
                            },
                            {
                                "example_id": "e29861ac-2585-4fae-bc6e-91432ce79f07",
                                "sense_id": "f0ddecc5-40dc-33bc-8b1a-0f551ec9f194",
                                "text": "„Solche Repräsentationen der Begegnung mit dem Anderen unter dem dominierenden Vorzeichen von Sinnlichkeit und Sexualität bestimmen auch die Imagination des Orients, der grundsätzlich mit gesteigerter Sensualität assoziiert wurde.“"
                            },
                            {
                                "example_id": "68e9ed2b-34da-4400-9399-8dd16b562e50",
                                "sense_id": "f0ddecc5-40dc-33bc-8b1a-0f551ec9f194",
                                "text": "„Auch ist nicht mit einem Wochenende Tantra automatisch alles besser im Leben und die Sensualität sofort ekstatischer. Das ist Unsinn. Es ist nicht so einfach, eine neue Qualität in die Liebe und Sinnlichkeit hinein zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
