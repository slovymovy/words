                        "entry_id": "f75333c2-3ab1-32bf-8d4a-7e4fb7e0dcbb",
                        "glosses": [
                            "Capable d'agir sur le diamètre des vaisseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2969812f-1522-4e6b-a13a-19c77d0ea379",
                                "sense_id": "45479f3b-f46a-3df7-a612-47d1baadfc01",
                                "text": "Les vasoconstricteurs et les vasodilatateurs sont des produits vasoactifs."
                            },
                            {
                                "example_id": "4d6d2ab2-8416-4c45-a54f-b5a434930a91",
                                "sense_id": "45479f3b-f46a-3df7-a612-47d1baadfc01",
                                "text": "Les chercheurs ont également découvert que le taux de peptide intestinal vasoactif, une petite protéine essentielle au fonctionnement de l'horloge interne du cerveau, était plus élevé chez les souris où le répresseur 4E-BP1 est absent."
                            }
                        ]
