                "senses": [
                    {
                        "sense_id": "0d15ba2e-e732-342c-904d-13bc820bf03f",
                        "entry_id": "bf124962-bccb-36d5-a0fa-452e4f7025d7",
                        "glosses": [
                            "to discipline (to subject to sanction or discipline, to punish)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "188e9dae-c0ae-412f-afa9-250c4265ba37",
                                "sense_id": "0d15ba2e-e732-342c-904d-13bc820bf03f",
                                "text": "De veldheer disciplineerde het gevluchte peloton met strafcorvee.",
                                "translation": "The general punished the deserted platoon with corvee labour.",
                                "english": "The general punished the deserted platoon with corvee labour."
                            }
                        ]
                    },
                    {
                        "sense_id": "bde4138c-9325-39c7-9fb7-b6e276240e92",
                        "entry_id": "bf124962-bccb-36d5-a0fa-452e4f7025d7",
                        "glosses": [
                            "to discipline (to instill discipline, to make conform to discipline)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2194a9f2-0770-4c80-a1f5-7254c2a809df",
                                "sense_id": "bde4138c-9325-39c7-9fb7-b6e276240e92",
                                "text": "De nieuwe rekruten werden snel gedisciplineerd.",
                                "translation": "The new recrutes were quickly instilled discipline",
                                "english": "The new recrutes were quickly instilled discipline"
                            }
                        ]
                    }
