    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc0224d0-09e9-3884-8cdd-18842d7f6375",
                    "sense_definition": "The side of a road or path.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "roadside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many beautiful wildflowers grew along the <w>wayside</w> during the spring.",
                            "target_lang_translations": {
                                "pl": "Wiosną wzdłuż <w>pobocza</w> rosło wiele pięknych polnych kwiatów."
                            }
                        },
                        {
                            "text": "The traveler rested on the <w>wayside</w> to catch his breath.",
                            "target_lang_translations": {
                                "pl": "Podróżny odpoczął na <w>poboczu</w>, żeby złapać oddech."
                            }
                        }
                    ],
                    "synonyms": [
                        "roadside"
                    ],
                    "common_phrases": [
                        "by the wayside"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pobocze drogi lub ścieżki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pobocze",
                                "target_lang_sense_clarification": "pas terenu wzdłuż drogi"
                            },
                            {
                                "target_lang_word": "przydroże",
                                "target_lang_sense_clarification": "teren bezpośrednio przy drodze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b71a32b-8631-3fce-be2b-5e771fc951db",
                    "sense_definition": "A rest area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "roadside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pulled into a quiet <w>wayside</w> to eat our lunch.",
                            "target_lang_translations": {
                                "pl": "Zjechaliśmy na ciche <w>miejsce postojowe</w>, żeby zjeść lunch."
                            }
                        },
                        {
                            "text": "The highway map showed a <w>wayside</w> just a few miles ahead.",
                            "target_lang_translations": {
                                "pl": "Mapa autostradowa pokazywała <w>miejsce postojowe</w> zaledwie kilka mil dalej."
                            }
                        }
                    ],
                    "synonyms": [
                        "rest stop"
                    ],
                    "target_lang_definitions": {
                        "pl": "Miejsce postojowe przy drodze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "miejsce postojowe",
                                "target_lang_sense_clarification": "wyznaczone miejsce do zatrzymania się"
                            },
                            {
                                "target_lang_word": "parking przydrożny",
                                "target_lang_sense_clarification": "miejsce do odpoczynku przy trasie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "085cf53b-0b7c-3783-a79c-68abda7f67af",
                    "sense_definition": "Situated near the side of a road or path.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "roadside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stopped for a quick drink at a small <w>wayside</w> inn.",
                            "target_lang_translations": {
                                "pl": "Zatrzymali się na szybki napój w małej <w>przydrożnej</w> karczmie."
                            }
                        },
                        {
                            "text": "The old man sold fresh fruit at a <w>wayside</w> stand.",
                            "target_lang_translations": {
                                "pl": "Starszy mężczyzna sprzedawał świeże owoce na <w>przydrożnym</w> straganie."
                            }
                        }
                    ],
                    "synonyms": [
