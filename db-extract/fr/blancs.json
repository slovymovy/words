                                        "entry_id": "fe14ad07-504e-3dce-9d64-fc08fa702fd7",
                                        "glosses": [
                                            "Alternative letter-case form of white (“European”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7897cfc2-03dc-48b8-8386-8f585e33bf94",
                                                "sense_id": "0914df38-6ede-3b23-8a23-c903d80b7261",
                                                "text": "The Whites on the mission were a special kind of white person, special in the way that my grandmother had explained to me, for they were holy."
                                            },
                                            {
                                                "example_id": "96283f1a-6dc6-4fe9-b4f3-0aa25df452ec",
                                                "sense_id": "0914df38-6ede-3b23-8a23-c903d80b7261",
                                                "text": "To add insult to injury, not only do Whites shame each other but every other race joins in because they are also educated to believe Whites have somehow screwed them over and are still screwing them over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c085c75-141e-38db-96cd-d44b0e711ad4",
                                        "entry_id": "fe14ad07-504e-3dce-9d64-fc08fa702fd7",
                                        "glosses": [
                                            "An anticommunist who fought against the Reds during the Russian Civil War; the term is mostly associated with monarchist forces."
                                        ],
