            "senses": [
                {
                    "sense_id": "096b36e6-0f67-3d1a-9e5c-f6367092342e",
                    "sense_definition": "Feeling anguish; experiencing extreme discomfort, pain, or mental distress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distressed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She let out an <w>anguished</w> cry when she heard the devastating news.",
                            "target_lang_translations": {
                                "ru": "Она издала <w>полный страданий</w> крик, когда услышала эту ужасную новость."
                            }
                        },
                        {
                            "text": "His <w>anguished</w> look showed how much he was suffering after the loss.",
                            "target_lang_translations": {
                                "ru": "Его <w>мучительный</w> взгляд показывал, как сильно он страдал после утраты."
                            }
                        }
                    ],
                    "synonyms": [
                        "distressed",
                        "tormented",
                        "agonized"
                    ],
                    "antonyms": [
                        "joyful",
                        "contented"
                    ],
                    "common_phrases": [
                        "anguished cry",
                        "anguished look",
                        "anguished scream"
                    ],
                    "target_lang_definitions": {
