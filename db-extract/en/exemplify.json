                    {
                        "sense_id": "cc23e8a2-cf9b-37ae-8552-2df4b3c71345",
                        "entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "glosses": [
                            "To show or illustrate by example."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8e01de6f-9d70-3e76-9ccb-ce4b853faa1a",
                        "entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "glosses": [
                            "To be an instance of or serve as an example."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "947f9fe3-4b1e-41cc-887f-92484a95de92",
                                "sense_id": "8e01de6f-9d70-3e76-9ccb-ce4b853faa1a",
                                "text": "[T]he pleasure of writing on wax with a stylus is exemplified by the fine, flowing hand of a Roman scribe who made out the birth certificate of Herennia Gemella, born March 128 AD."
                            },
                            {
                                "example_id": "1a782188-0b1c-4c4a-abce-d74923516dd4",
                                "sense_id": "8e01de6f-9d70-3e76-9ccb-ce4b853faa1a",
                                "text": "Of course, closure of the West station took away the hotel's raison d'être. In May 2012, the local newspaper reported that this historic hotel, by then rated the town's worst (exemplified by its final review: \"Please avoid at all costs\"), was to be converted into 31 first-time-buyer one-bedroom flats."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2066eaf-d6d4-3654-9cde-c1cd81bc50dd",
                        "entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "glosses": [
                            "To make an attested copy or transcript of (a document) under seal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c41d379-0310-332f-896f-6a983cea1209",
                        "entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "glosses": [
                            "To prove by such an attested copy or transcript."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9145820d-2c4d-4659-a91b-38f864901687",
                        "source_entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "source_sense_description": "to show or illustrate by example",
                        "target_lang_word": "exemplifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exemplifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e593349-c2c3-3e97-b7a6-42782567be7b",
                                        "entry_id": "e1e6e026-947e-37b5-b89d-f0ba9e332f4c",
                                        "glosses": [
                                            "Illustrer par des exemples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb6850b-7ead-48ae-9832-b1bc35724181",
                                                "sense_id": "0e593349-c2c3-3e97-b7a6-42782567be7b",
                                                "text": "Le style d’Octave Pirmez pourrait servir à exemplifier la distance souvent énorme entre la culture d’un homme et son écriture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfcb34e4-7d46-4d3e-a43c-86abf25f42a1",
                        "source_entry_id": "0285021b-185c-3346-a30c-1e8ddeb4eb8d",
                        "source_sense_description": "to show or illustrate by example",
                        "target_lang_word": "illustrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1280c3c6-558a-3c15-993e-82f4702b2ebb",
                                        "entry_id": "902c88f3-74f8-336f-802f-a2156e3ec98d",
                                        "glosses": [
                                            "Rendre illustre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ec4a42-532f-42a1-bce7-7b617d7ecb6e",
                                                "sense_id": "1280c3c6-558a-3c15-993e-82f4702b2ebb",
                                                "text": "En effet, en dehors des tossafistes, qui illustrèrent le rabbinat français au XIIᵉ et XIIIᵉ siècle, la famille de Raschi a fourni au judaïsme maintes célébrités."
                                            },
                                            {
                                                "example_id": "f37c7685-aafb-4127-af1b-3882f9dbbcda",
                                                "sense_id": "1280c3c6-558a-3c15-993e-82f4702b2ebb",
                                                "text": "La conquête facile de la Mandchourie et de la Corée constituait le point de départ de la grande aventure qui devait s'illustrer par l'effondrement des États-Unis d'Amérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bb1b61e-eafd-33e7-93df-52a70baff77c",
                                        "entry_id": "902c88f3-74f8-336f-802f-a2156e3ec98d",
                                        "glosses": [
                                            "Orner de gravures et de dessins un livre, un journal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4210208d-dc27-499f-912b-f3d01c71d4cc",
                                                "sense_id": "4bb1b61e-eafd-33e7-93df-52a70baff77c",
                                                "text": "On préfère construire un roman, qu'on déroule à sa guise, au rythme que l'on choisit, on l’illustre d'images d'Épinal aux coloriages grossiers, aux violentes couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6cbc6a-2630-3496-8f5a-24de695aadfc",
                                        "entry_id": "902c88f3-74f8-336f-802f-a2156e3ec98d",
                                        "glosses": [
                                            "Rendre une idée saisissante par un exemple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "306540ce-9db0-4677-a620-42351a31b43e",
                                                "sense_id": "8c6cbc6a-2630-3496-8f5a-24de695aadfc",
                                                "text": "La défaite d’Annibal illustre la faute commise après Cannes."
                                            },
                                            {
                                                "example_id": "1f420f65-ae09-4092-af8d-0ae3b711dd42",
                                                "sense_id": "8c6cbc6a-2630-3496-8f5a-24de695aadfc",
                                                "text": "Les citations illustrent le propos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd0b4aa-6cb4-4dcb-a9e8-9785f0501197",
