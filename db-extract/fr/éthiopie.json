                "word": "Éthiopie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c49858f6-5bc1-3005-9eb5-fa2258c4512d",
                        "entry_id": "0df0b4bc-77d5-3bb4-99e0-3fc4b9e81304",
                        "glosses": [
                            "Äthiopien"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5e0b9f4-0474-4327-835f-b8f0f882e119",
                        "source_entry_id": "0df0b4bc-77d5-3bb4-99e0-3fc4b9e81304",
                        "source_sense_id": "c49858f6-5bc1-3005-9eb5-fa2258c4512d",
                        "source_sense_description": "Äthiopien",
                        "target_lang_word": "Äthiopien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äthiopien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                        "entry_id": "6017f804-ab13-3b06-8569-8e00abf1d9b5",
                                        "glosses": [
                                            "Staat in Ostafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb197064-f27c-4687-a8fc-5b3e26811a37",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "Ich komme aus Äthiopien."
                                            },
                                            {
                                                "example_id": "074f6ecf-7a08-44b7-b149-0fcd05357b61",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "Addis Abeba ist die Hauptstadt von Äthiopien."
                                            },
                                            {
                                                "example_id": "db265004-f3b4-4cd4-97d3-29ba1ccdbde8",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Der Außenhandel Äthiopiens besteht im Wesentlichen aus dem Export von Kaffee.“"
                                            },
                                            {
                                                "example_id": "0d2ae632-3c2b-4f35-84e2-340f3eb482f2",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Bekanntlich gibt es für mein Heimatland zwei Bezeichnungen. Die heute geläufige, Äthiopien, stammt aus dem Griechischen: »das Land der gebrannten Gesichter«. Die andere, Abessinien, leitet sich von dem arabischen Wort habesch ab, »Land der gemischten Rassen«.“"
                                            },
                                            {
                                                "example_id": "7dc78078-9b18-4bea-b365-8b0ec1d2428f",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Das christliche Äthiopien zerreibt sich fortan im Kampf gegen muslimische Nachbarn.“"
                                            },
                                            {
                                                "example_id": "0400c88c-2105-4cf0-973f-2138e108f54d",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Verstanden habe ich Äthiopien immer noch nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
