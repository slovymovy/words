                                    {
                                        "sense_id": "8641ee6b-a582-30a9-861d-dcd17edbadd7",
                                        "entry_id": "5b430a6e-0857-3b83-81b5-ea3df00eab97",
                                        "glosses": [
                                            "An electromagnetic wave having a wavelength between approximately 10 and 100 meters, corresponding to frequencies between 3 and 30 MHz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3a75f5-6c72-42fa-8076-c208f489b88e",
                                                "sense_id": "8641ee6b-a582-30a9-861d-dcd17edbadd7",
                                                "text": "Shortwaves are longer than microwaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe060cff-9641-3403-a1b6-d1b4a34de8ff",
                                        "entry_id": "5b430a6e-0857-3b83-81b5-ea3df00eab97",
                                        "glosses": [
                                            "Any frequency in this range, especially when used in broadcasting."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ad8032-7003-48be-98a0-9f8aebe7b490",
                                                "sense_id": "fe060cff-9641-3403-a1b6-d1b4a34de8ff",
                                                "text": "Many stations broadcast on shortwaves."
                                            },
                                            {
                                                "example_id": "5fbb9e40-cda7-4504-8633-133a2cace59e",
                                                "sense_id": "fe060cff-9641-3403-a1b6-d1b4a34de8ff",
                                                "text": "The fun of listening to shortwave while in a car or boat is diminished by spark-plug noise created while the engine is running."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8ffd25-0803-3ed7-b110-ddc3e143b8a5",
                                        "entry_id": "5b430a6e-0857-3b83-81b5-ea3df00eab97",
                                        "glosses": [
                                            "Downward radiation entering the earth's atmosphere that is in the shortwave frequency range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15a0f26-7f0e-4c9d-80a4-71d1c6d34a2c",
                                                "sense_id": "0e8ffd25-0803-3ed7-b110-ddc3e143b8a5",
                                                "text": "Some doubt is cast on the quality of the shortwave fadeout data during the early part of the period considered."
                                            },
                                            {
                                                "example_id": "ced08010-2984-469e-a2af-ee1ae758a93f",
                                                "sense_id": "0e8ffd25-0803-3ed7-b110-ddc3e143b8a5",
                                                "text": "A concise review is presented for the algorithm that has been tentatively selected to produce simulated net shortwave surface fluxes from measured TOA radiances."
                                            },
                                            {
                                                "example_id": "e7f806fc-5a16-4ab2-adfa-94cdfacc015c",
                                                "sense_id": "0e8ffd25-0803-3ed7-b110-ddc3e143b8a5",
                                                "text": "Shortwave radiative fluxes that reach the earth's surface are key factors that influence atmospheric and oceanic circulations as well as surface climate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
