                        "examples": [
                            {
                                "example_id": "161c5912-c925-4c8d-88f0-2d2734e63c0a",
                                "sense_id": "71a742e9-9f5b-3154-87a2-d600c579ba1e",
                                "text": "Она, скрепясь, дрожащей ручкой оперлась (на лапу медведя)."
                            },
                            {
                                "example_id": "065cb106-7ca1-421d-ad8b-dc29901cbbf2",
                                "sense_id": "71a742e9-9f5b-3154-87a2-d600c579ba1e",
                                "text": "Скрепясь духом и сердцем, решился он служить по примеру прочих."
                            }
                        ]
