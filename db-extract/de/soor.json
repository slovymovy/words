                                        "glosses": [
                                            "Any of numerous species of songbirds of the cosmopolitan family Turdidae, such as the song thrush, mistle thrush, bluebird, and American robin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da764e38-5dc3-4024-aba8-39e807b273f4",
                                                "sense_id": "0cab67cd-00f8-3ab1-a7ba-4d13da8c84a2",
                                                "text": "I felt comforted by the song of the redbreast, and I thought I felt less lonely and deserted as long as I heard the merry notes of the thrush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38fa81be-9bf1-3f3d-a690-a6c0490b442d",
