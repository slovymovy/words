                                "sense_id": "124ff75a-2792-3637-a11f-1dc254b4e1e9",
                                "text": "Rekonstrukcja rządu powoli zamienia się w farsę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
