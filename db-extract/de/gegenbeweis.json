                "senses": [
                    {
                        "sense_id": "773ab913-6b38-3a6b-96ed-7f44bc6165f2",
                        "entry_id": "f985ac5a-a17c-321a-ada9-b6771c8738f2",
                        "glosses": [
                            "Beweis des Gegenteils von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9396bf9e-c557-416b-80f2-b3ec92fc6d75",
                                "sense_id": "773ab913-6b38-3a6b-96ed-7f44bc6165f2",
                                "text": "Wird nicht-p bewiesen, so ist dies ein Gegenbeweis zu p."
                            },
                            {
                                "example_id": "fbd05b4f-87c6-4205-b8c3-139ff7238c27",
                                "sense_id": "773ab913-6b38-3a6b-96ed-7f44bc6165f2",
                                "text": "„Dies allein wäre natürlich noch kein Gegenbeweis gegen eine solche Worterklärung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6c22303-b72b-4213-ae99-a8b4ae981e3a",
                        "source_entry_id": "f985ac5a-a17c-321a-ada9-b6771c8738f2",
                        "source_sense_id": "773ab913-6b38-3a6b-96ed-7f44bc6165f2",
                        "source_sense_description": "Beweis des Gegenteils von etwas",
                        "target_lang_word": "counterevidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterevidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc8991a-449c-3442-a31f-ebaafafeaadd",
                                        "entry_id": "53503dc6-10d6-39e0-8e38-4eb6ac5d849c",
                                        "glosses": [
                                            "Evidence which tends to disprove a claim or hypothesis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b50901-2317-4ee7-8c3a-1808b19a51a8",
                                                "sense_id": "dfc8991a-449c-3442-a31f-ebaafafeaadd",
                                                "text": "Having been strongly pressed to do so, I gave counter-evidence, and I believe, in the opinion of the Commission, demolished the Doctor a second time."
                                            },
                                            {
                                                "example_id": "4f1a0278-9609-4bc0-8b43-ff5d7c2eaf3b",
                                                "sense_id": "dfc8991a-449c-3442-a31f-ebaafafeaadd",
                                                "text": "As the alternative norms and counterevidences are uncovered, it is the evaluator's task to determine inconsistency, contradiction, and subterfuge, and then to render his own verdict."
                                            },
                                            {
                                                "example_id": "b650b233-445a-4e7e-bade-98a7f88f86f1",
                                                "sense_id": "dfc8991a-449c-3442-a31f-ebaafafeaadd",
                                                "text": "People persevere in asserting all sorts of things in the face of apparent counterevidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
