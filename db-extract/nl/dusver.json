                "senses": [
                    {
                        "sense_id": "3eb27750-2caf-3193-9248-a1c45e44b601",
                        "entry_id": "2c52ac37-3d9c-3e61-9b01-3091826cf704",
                        "glosses": [
                            "tot ~: tot op dit moment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3315061c-7803-411e-9b71-bc519b0bf3f5",
                                "sense_id": "3eb27750-2caf-3193-9248-a1c45e44b601",
                                "text": "Hij heeft dat tot dusver altijd ontkend."
                            },
                            {
                                "example_id": "e825ae43-5999-4bcd-b91d-20553436df64",
                                "sense_id": "3eb27750-2caf-3193-9248-a1c45e44b601",
                                "text": "Tot dusver zijn er nog geen problemen."
                            },
                            {
                                "example_id": "22677683-b627-4c0e-9816-e931a9231bb6",
                                "sense_id": "3eb27750-2caf-3193-9248-a1c45e44b601",
                                "text": "De geluiden in de natuur waren veel meer gelaagd dan ik tot dusver had ervaren."
                            },
                            {
                                "example_id": "bc4346b4-1c10-4ce5-86b6-bc414aea21e7",
                                "sense_id": "3eb27750-2caf-3193-9248-a1c45e44b601",
                                "text": "Van levensbelang: \"De omvang en reikwijdte van de hittestress is schokkend\", zegt zeebioloog Melanie McEnfield tegen persbureau Reuters. \"Sommige riffen hadden er tot dusver geen last van en wij dachten dat ze veerkrachtig waren, dat ze het gedeeltelijk afsterven te boven zouden komen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
