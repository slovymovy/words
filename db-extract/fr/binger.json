                "senses": [
                    {
                        "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                        "entry_id": "91532d6e-41fd-3fbd-8457-a3ef74d10f81",
                        "glosses": [
                            "Regarder à la suite tous les épisodes d’une série télévisée ou d’un groupe de films."
                        ],
                        "tags": [
                            "Anglicism",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a211a9d9-fa31-4910-9f35-64fdee6cb556",
                                "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                                "text": "Quand on est médecin, on se fait qualifier d’alarmiste, ou d’enfermiste, c’est au choix, par des types qui n’ont jamais vu de malades depuis qu’ils ont cessé de binger Dr House."
                            },
                            {
                                "example_id": "ce929578-7248-4222-9c82-93c72fd15275",
                                "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                                "text": "Côté séries, elle nourrit une éternelle affection pour The Handmaid’s Tale et, malgré le manque de temps, a quand même bingé Polar Park et D’argent et de sang."
                            },
                            {
                                "example_id": "ae2c39aa-8f70-4400-b1db-00d15a7e37b8",
                                "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                                "text": "7 séries à binger sans culpabilité cet hiver"
                            },
                            {
                                "example_id": "ff720e8b-fc84-42db-be08-5535d61550ed",
                                "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                                "text": "Il y a donc plusieurs façons de «binger» les séries."
                            },
                            {
                                "example_id": "23e666af-2e0f-4b4a-82c3-aac17395a0b9",
                                "sense_id": "41a533bb-c6b7-38d6-904d-4c243b329ec5",
                                "text": "The OA : la série Netflix à binger de toute urgence !"
                            }
                        ]
                    }
