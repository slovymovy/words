                "senses": [
                    {
                        "sense_id": "ca798ed2-13cd-3299-9325-f6e3215606be",
                        "entry_id": "88a6d3ce-8df8-32d2-b359-b4280f4b9299",
                        "glosses": [
                            "Monter ou descendre en tournant (un escalier en colimaçon, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "439e1d20-5bb0-4994-89bc-56d7b06acde8",
                                "sense_id": "ca798ed2-13cd-3299-9325-f6e3215606be",
                                "text": "Tu habites Rue de la Madone\nUne maison qui se déhanche\nUne maison qui se tirebouchonne\nEt qui pleure à grosses planches\nL'escalier colimaçonne\nC'est pas grand, non…"
                            },
                            {
                                "example_id": "b072f8df-c7a5-4617-8eff-c88595762fde",
                                "sense_id": "ca798ed2-13cd-3299-9325-f6e3215606be",
                                "text": "Dans le fond de cette deuxième pièce, un petit escadrin colimaçonne jusqu’au toit."
                            }
                        ]
