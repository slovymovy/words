{
    "word_family": [
        "fluent",
        "fluid",
        "fluency",
        "influence",
        "affluent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e3135c1-3040-3c38-bef8-e54081e3a7b9",
                    "sense_definition": "The place where two rivers or streams meet and become one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was built at the <w>confluence</w> of two major rivers.",
                            "target_lang_translations": {
                                "ru": "Город был построен на <w>слиянии</w> двух крупных рек."
                            }
                        },
                        {
                            "text": "We watched the water flow together at the <w>confluence</w> of the stream and the river.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как соединяются воды в месте <w>слияния</w> ручья и реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "conflux",
                        "watersmeet"
                    ],
                    "antonyms": [
                        "fork",
                        "branch"
                    ],
                    "common_phrases": [
                        "river confluence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где две реки или ручья сходятся и объединяются в один поток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слияние",
                                "target_lang_sense_clarification": "место соединения рек или потоков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb07453e-b463-3f2d-b573-815ffc9e670a",
                    "sense_definition": "A coming together or combination of different things, people, or events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The success of the project was due to a <w>confluence</w> of talent and hard work.",
                            "target_lang_translations": {
                                "ru": "Успех проекта был обусловлен <w>сочетанием</w> таланта и упорного труда."
                            }
                        },
                        {
                            "text": "A <w>confluence</w> of economic factors led to the sudden change in the market.",
                            "target_lang_translations": {
                                "ru": "<w>Стечение</w> экономических факторов привело к внезапному изменению на рынке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "confluence of events"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединение, совпадение или сочетание различных явлений, людей или обстоятельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стечение",
                                "target_lang_sense_clarification": "обычно об обстоятельствах"
                            },
                            {
                                "target_lang_word": "слияние",
                                "target_lang_sense_clarification": "сочетание или объединение факторов"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "комбинация факторов или условий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f81be2-f9ac-373c-9d38-fe20ae0ca8ce",
                    "sense_definition": "The proportion of cells in a culture that are touching each other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cells reached full <w>confluence</w> after three days of growth.",
                            "target_lang_translations": {
                                "ru": "Клетки достигли полной <w>конфлюэнтности</w> через три дня культивирования."
                            }
                        },
                        {
                            "text": "We must passage the cells before they reach 100 percent <w>confluence</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны рассеять клетки до того, как они достигнут 100-процентной <w>конфлюэнтности</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень или доля покрытия культуральной поверхности клетками (в биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфлюэнтность",
                                "target_lang_sense_clarification": "в клеточной биологии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0dda89cc-674d-30e6-9f02-b0c67bf0bf70",
                    "sense_definition": "To flow or join together into one stream.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small creeks <w>confluence</w> to form a larger river downstream.",
                            "target_lang_translations": {
                                "ru": "Небольшие ручьи <w>сливаются</w>, образуя ниже по течению более крупную реку."
                            }
                        },
                        {
                            "text": "These two pipes <w>confluence</w> at the main junction of the drainage system.",
                            "target_lang_translations": {
                                "ru": "Эти две трубы <w>соединяются</w> в главном узле дренажной системы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сливаться, соединяться в единый поток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "о реках, потоках или трубах"
                            },
                            {
                                "target_lang_word": "соединяться",
                                "target_lang_sense_clarification": "сходиться в одной точке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}