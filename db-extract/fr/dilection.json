                                "target_senses": [
                                    {
                                        "sense_id": "b19686e8-0553-3dab-849a-76ee67ed1153",
                                        "entry_id": "5dd2bdc0-8abd-3adc-9d09-74ece3ac25be",
                                        "glosses": [
                                            "Voluntad honesta, amor reflexivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a200f96-31f7-4319-baa4-88671825cd8d",
                                                "sense_id": "b19686e8-0553-3dab-849a-76ee67ed1153",
                                                "text": "«No es ni mucho menos la conmiseración, sino mi dilección por la desaparecida cantante —que engrandecida por su final habrá de permanecer incólume en mi memoria— lo que me impulsa a este humilde tributo a la Janis Joplin del “gypsy-rock”»."
                                            }
                                        ],
