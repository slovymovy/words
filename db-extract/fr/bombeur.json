                                "target_senses": [
                                    {
                                        "sense_id": "114372e9-fe6f-37a5-b8c3-c9c956482d7f",
                                        "entry_id": "a5e090e2-e412-35e2-9794-8ce76944aa5f",
                                        "glosses": [
                                            "A graffiti artist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900b7efa-9011-4ce3-9f2c-111108129dc5",
                                                "sense_id": "114372e9-fe6f-37a5-b8c3-c9c956482d7f",
                                                "text": "ANDRÉ SARAIVA, the slight 35-year-old graffitist and night-life entrepreneur, showed up at the Emmanuel Perrotin gallery in the Marais on a recent Saturday night in his trademark impossibly skinny jeans and a navy Thom Browne peacoat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b4b3bf9-3359-40af-869a-300e3b5f989b",
                        "source_entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "source_sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
