                                    {
                                        "sense_id": "ebe40a81-46c2-32b3-91df-65ccca9cebe9",
                                        "entry_id": "5069b653-3053-3e9e-bda4-2417e143d27c",
                                        "glosses": [
                                            "Tiempo gramatical que describe una acción que ha tenido lugar en el pasado antes de otros eventos en el pasado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832ebe68-8cf3-46bd-aff0-864419f33b82",
                                                "sense_id": "ebe40a81-46c2-32b3-91df-65ccca9cebe9",
