                "senses": [
                    {
                        "sense_id": "02e841a1-d1ed-378b-b4b1-8e5096cb85cb",
                        "entry_id": "325b1221-9f6b-3ff5-9b07-dd925e9cb7fa",
                        "glosses": [
                            "hoes die om iets of iemand wordt aangebracht ter bescherming tegen schadelijke, uitwendige invloeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ac80ae-1b66-485c-bd73-3bc3f8b9d64f",
                                "sense_id": "02e841a1-d1ed-378b-b4b1-8e5096cb85cb",
                                "text": "Omdat we van tevoren niet wisten met hoeveel opspattend water we aan boord te maken zouden krijgen, had Mirjam Tonio toch de plastic beschermhoes omgebonden, die luguber ritselde op de wind."
                            },
                            {
                                "example_id": "5561b93a-c940-41fd-b750-2b1223ef6b20",
                                "sense_id": "02e841a1-d1ed-378b-b4b1-8e5096cb85cb",
                                "text": "Het terughangen was geen eenvoudige operatie. Het doek werd eerst in een houten frame gezet. Daaromheen zat een beschermhoes. Die hoes is ontwikkeld door Philips en bestaat uit een stalen frame van 300 kilo, een isolatielaag van speciaal schuim en een beschermdeken. In de hoes zijn verschillende sensoren aangebracht die temperatuur, luchtvochtigheid en schokken kunnen meten."
                            }
                        ]
                    }
