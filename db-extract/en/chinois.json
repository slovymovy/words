                        "glosses": [
                            "A fine-meshed conical strainer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8b55a3-7fcc-46d3-86f5-63d2e60a8923",
                                "sense_id": "b037e133-4b07-3168-999b-7a771f427c40",
                                "text": "Strain through a chinois or fine-meshed sieve to remove any lumps of yolk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b937bbd-2a4d-43a1-9bf6-84f432c6c089",
                        "source_entry_id": "7184e645-be38-3454-a553-b7d7e0eb5898",
