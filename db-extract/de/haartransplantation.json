                                        "sense_id": "00198291-ce8f-367f-977f-e04fab9d68c4",
                                        "entry_id": "051e9060-de92-3eff-af29-d7051f30b1ec",
                                        "glosses": [
                                            "een chirurgische ingreep om haren te verplaatsen van het ene naar het andere deel van het lichaam; met name als behandeling van kaalheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8c6fb8-f16b-4770-a03e-64a524b1c08b",
                                                "sense_id": "00198291-ce8f-367f-977f-e04fab9d68c4",
                                                "text": "Grote klinieken die haartransplantaties uitvoeren krijgen flink meer aanmeldingen sinds het begin van de coronacrisis. Een aantal van hen heeft inmiddels lange wachtlijsten."
                                            },
                                            {
                                                "example_id": "1080816f-dd05-4d45-81b4-d071739f74f5",
                                                "sense_id": "00198291-ce8f-367f-977f-e04fab9d68c4",
                                                "text": "Muzikant Dominique grijpt de lockdown aan voor een haartransplantatie. Hij kan niet optreden en zit veel binnen. Daarom is dit een populair moment voor veel mannen. Ze werken thuis en hebben geld over omdat ze niet op vakantie kunnen."
                                            }
                                        ]
                                    }
