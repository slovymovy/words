                        "examples": [
                            {
                                "example_id": "6de35687-70c6-4dcf-b5b3-bc0525b23a25",
                                "sense_id": "05ca6c29-777c-31b9-80fb-d4e6fbbca064",
                                "text": "„Alte Fabriken, Panzer und andere Fahrzeuge wurden ausgeschlachtet, Strom- und Telefonmasten abgeschlagen, um an das Eisen zu kommen, das dann an Stahlfabriken in Lahore verkauft wurden.“"
                            },
                            {
                                "example_id": "7e617913-3257-4136-ac1c-14b59e66f521",
                                "sense_id": "05ca6c29-777c-31b9-80fb-d4e6fbbca064",
                                "text": "„Das reichte, damit Doc wusste, dass er für ihn das Tor zur alten Stahlfabrik offen lassen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
