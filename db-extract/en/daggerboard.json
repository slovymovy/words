                        "entry_id": "2b0a7c76-4c96-33fe-84c4-070222494a31",
                        "glosses": [
                            "A retractable centreboard that slides out to act as a keel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9af602e-7df7-4f3c-9475-e1381e52fa43",
                                "sense_id": "2f2d0821-c2eb-3a1b-96f3-41a7c344fcba",
                                "text": "Route the bitter end of the cunningham through the hole in the daggerboard and secure it with a figure 8 knot. This keeps the daggerboard in the hull in case of a capsize."
                            },
                            {
                                "example_id": "07379737-b568-4d67-b7c1-f30e8752ec67",
                                "sense_id": "2f2d0821-c2eb-3a1b-96f3-41a7c344fcba",
                                "text": "Push the boat the rest of the way into the water and insert the daggerboard."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd7b2909-a99e-3fa3-b865-20138a3bcacc",
                        "entry_id": "2b0a7c76-4c96-33fe-84c4-070222494a31",
                        "glosses": [
                            "One of many decorative boards that form a valance for a canopy, particularly on older railway stations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3580cea-f418-4e10-888c-50d0c54c938e",
                                "sense_id": "bd7b2909-a99e-3fa3-b865-20138a3bcacc",
                                "text": "It will also have examples of its composite canopy daggerboards, which use CNC technology to produce replicas of historic designs - and which have been deployed as modern alternatives to traditional daggerboards in sensitive surroundings such as at Bath Spa."
                            }
                        ]
                    }
