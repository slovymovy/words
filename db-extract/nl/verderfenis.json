                        "examples": [
                            {
                                "example_id": "43974971-5a54-44c0-ac46-7e2f2259aef2",
                                "sense_id": "7ae3df15-f5b6-361a-88e2-83f6859cf5ac",
                                "text": "Wederom kruip je in de huid van de overleden doler Talion, die bij de slag om de Zwarte Poort van Mordor om het leven kwam. Door magie is hij tot leven gewekt door de elfgeest Celebrimbor, die als smid de originele Ringen van Macht heeft gesmeden. Daaronder de beruchte ring ‘om allen te beheersen’, waarmee Sauron in een voorgaand tijdperk doem en verderfenis over Midden-Aarde uitstortte."
                            }
                        ]
                    }
