                                                "sense_id": "0e3cc30b-506e-3071-aa44-42cb6bd0ce5f",
                                                "text": "De diapositieven (dia's) van de vakantie werden getoond op groot scherm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63a7dd9-d798-3504-863f-1e32639e3c39",
