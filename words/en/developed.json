                    "sense_definition": "Simple past and past participle of <w>develop</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm <w>developed</w> quickly over the ocean.",
                            "target_lang_translations": {
                                "ru": "Шторм быстро <w>образовался</w> над океаном.",
                                "nl": "De storm <w>ontwikkelde</w> zich snel boven de oceaan."
                            }
                        },
                        {
                            "text": "Scientists have <w>developed</w> a new way to store energy.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>разработали</w> новый способ хранения энергии.",
                                "nl": "Wetenschappers hebben een nieuwe manier <w>ontwikkeld</w> om energie op te slaan."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>develop</w>.",
                        "nl": "Verleden tijd en voltooid deelwoord van het werkwoord 'ontwikkelen'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "расти, совершенствоваться"
