{
    "word_family": [
        "deterrence",
        "deterrent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9ee7bf9-31b7-34d1-adb7-57852e2c0793",
                    "sense_definition": "To persuade someone not to do something; to discourage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high price of the tickets <w>deterred</w> many people from attending the concert.",
                            "target_lang_translations": {
                                "pl": "Wysoka cena biletów <w>odstraszyła</w> wiele osób od udziału w koncercie."
                            }
                        },
                        {
                            "text": "Strict laws are intended to <w>deter</w> criminals from committing serious crimes.",
                            "target_lang_translations": {
                                "pl": "Surowe prawo ma na celu <w>odstraszenie</w> przestępców od popełniania poważnych zbrodni."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissuade"
                    ],
                    "common_phrases": [
                        "deter from"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przekonać kogoś, by czegoś nie robił; zniechęcić."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odstraszać",
                                "target_lang_sense_clarification": "zniechęcać kogoś do podjęcia jakiegoś działania"
                            },
                            {
                                "target_lang_word": "zniechęcać",
                                "target_lang_sense_clarification": "powodować utratę chęci do zrobienia czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38c8bf32-8854-3428-96f4-8727e578473f",
                    "sense_definition": "To prevent something from happening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presence of security cameras helps to <w>deter</w> theft in the store.",
                            "target_lang_translations": {
                                "pl": "Obecność kamer bezpieczeństwa pomaga <w>powstrzymać</w> kradzieże w sklepie."
                            }
                        },
                        {
                            "text": "Strong border defenses were built to <w>deter</w> any potential invasion.",
                            "target_lang_translations": {
                                "pl": "Zbudowano silną obronę granic, aby <w>zapobiec</w> jakiejkolwiek potencjalnej inwazji."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zapobiegać wystąpieniu czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powstrzymywać",
                                "target_lang_sense_clarification": "zatrzymywać proces lub zdarzenie przed wystąpieniem"
                            },
                            {
                                "target_lang_word": "zapobiegać",
                                "target_lang_sense_clarification": "działać tak, aby coś nie doszło do skutku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd44f455-9b3c-3a25-b980-9c2f28a5c49e",
                    "sense_definition": "To distract someone from something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant noise <w>deterred</w> the student from focusing on the difficult task.",
                            "target_lang_translations": {
                                "pl": "Ciągły hałas <w>odciągał</w> ucznia od skupienia się na trudnym zadaniu."
                            }
                        },
                        {
                            "text": "Uncertainty often <w>deters</w> researchers from exploring new and complex theories.",
                            "target_lang_translations": {
                                "pl": "Niepewność często <w>zniechęca</w> badaczy do zgłębiania nowych i złożonych teorii."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Odwracać czyjąś uwagę od czegoś (użycie przestarzałe lub literackie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odciągać",
                                "target_lang_sense_clarification": "kierować uwagę w inną stronę"
                            },
                            {
                                "target_lang_word": "rozpraszać",
                                "target_lang_sense_clarification": "uniemożliwiać skupienie się na zadaniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c3da9805-221d-36d0-83c4-f7d094f75e66",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Deters</w> family moved to the city last year.",
                            "target_lang_translations": {
                                "pl": "Rodzina <w>Deters</w> przeprowadziła się do miasta w zeszłym roku."
                            }
                        },
                        {
                            "text": "Mr. <w>Deters</w> is a well-known professor at the university.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Deters</w> jest znanym profesorem na uniwersytecie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko pochodzenia niemieckiego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Deters",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}