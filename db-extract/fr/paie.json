                    }
                ],
                "senses": [
                    {
                        "sense_id": "a55b7879-b1a0-3194-af84-a77343bf9cf9",
                        "entry_id": "9bb568da-6855-33e6-907f-9c4079fae5b9",
                        "glosses": [
                            "Action de payer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f569dea-533f-41d8-9f74-5f0999d2f8bf",
                                "sense_id": "a55b7879-b1a0-3194-af84-a77343bf9cf9",
                                "text": "Donner la paie aux troupes."
                            },
                            {
                                "example_id": "d77a903a-f9e6-42df-b552-2455991fdbe0",
                                "sense_id": "a55b7879-b1a0-3194-af84-a77343bf9cf9",
                                "text": "C’est aujourd’hui jour de paie."
                            },
                            {
                                "example_id": "c849cb9f-af49-439e-bf3c-a7bfec100890",
                                "sense_id": "a55b7879-b1a0-3194-af84-a77343bf9cf9",
                                "text": "Il est parti après avoir touché sa paie."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb77edb5-ffb3-3c92-afa9-346b89deea66",
                        "entry_id": "9bb568da-6855-33e6-907f-9c4079fae5b9",
                        "glosses": [
                            "Salaire ou rémunération d’un travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa6c5993-20f5-4261-9e29-8e70faf853be",
                                "sense_id": "cb77edb5-ffb3-3c92-afa9-346b89deea66",
                                "text": "Il touchait sa paie chaque soir pour la porter à sa mère."
                            },
                            {
                                "example_id": "0a357fc3-b26f-42c0-b708-420a6c3259b8",
                                "sense_id": "cb77edb5-ffb3-3c92-afa9-346b89deea66",
                                "text": "Chez les femmes cadres, au contraire, les inégalités de revenu salarial ont diminué sous l’action simultanée de la baisse des inégalités de salaire journalier et de durée de paie."
                            },
                            {
                                "example_id": "f2db7363-52e1-4f9c-b856-fe63ef685ad6",
                                "sense_id": "cb77edb5-ffb3-3c92-afa9-346b89deea66",
                                "text": "J'ai un autre travail pour vous. Voyage bref, double paie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b529b1e3-e13a-366e-a727-02e210a95217",
                        "entry_id": "9bb568da-6855-33e6-907f-9c4079fae5b9",
                        "glosses": [
                            "Celui qui paie."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "251656b8-063b-4e4c-a831-9806e71b1641",
                                "sense_id": "b529b1e3-e13a-366e-a727-02e210a95217",
                                "text": "C’est une bonne paie, une mauvaise paie."
                            }
                        ]
                    },
