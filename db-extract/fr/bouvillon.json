                                "target_senses": [
                                    {
                                        "sense_id": "90c85ba7-d472-3fe3-9477-b1ddadb773bc",
                                        "entry_id": "e091e2f6-4dd8-3e0d-bc8d-bf34b7411882",
                                        "glosses": [
                                            "A young bull."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f53b289-55d0-4610-8863-14ab7b2c9194",
                                                "sense_id": "90c85ba7-d472-3fe3-9477-b1ddadb773bc",
                                                "text": "And he brought the bullock for the sin offering: and Aaron and his sons laid their hands upon the head of the bullock for the sin offering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d56592-a6b8-3637-80b0-e2eadba64b2e",
                                        "entry_id": "e091e2f6-4dd8-3e0d-bc8d-bf34b7411882",
                                        "glosses": [
                                            "A castrated bull; an ox."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bullock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b38986d-c0ed-37db-8f89-8b694acb07ea",
                                        "entry_id": "6c148ce2-7847-357b-a7ad-8da482eaca04",
                                        "glosses": [
                                            "To bully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eaea1fe-4061-484c-a995-c78c3dca0e29",
                                                "sense_id": "2b38986d-c0ed-37db-8f89-8b694acb07ea",
                                                "text": "Yes, you villain, you have defiled my own bed, you have; and then you have charged me with bullocking you into owning the truth."
                                            },
                                            {
                                                "example_id": "fcf1a061-1bf6-4534-bb18-85e2f02e43e3",
                                                "sense_id": "2b38986d-c0ed-37db-8f89-8b694acb07ea",
                                                "text": "So you never knew when you were gonna fall foul of a furious bullocking. So it became a case of bullocking management, basically. You know, how can I stave off the stress and the bullying for another few days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
