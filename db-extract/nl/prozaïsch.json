                    },
                    {
                        "form_id": "547cd5ee-b9b9-452d-83a0-4685d2634aff",
                        "entry_id": "1782d713-d4ed-32c0-bc06-cecc7ca042dc",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "prozaïschers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eaf7edbd-fa55-38af-b66d-0c9aad8442e2",
                        "entry_id": "1782d713-d4ed-32c0-bc06-cecc7ca042dc",
                        "glosses": [
                            "niet dichterlijk, in gewone taal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2884f84-0514-4e53-baff-758c3a89f1f0",
                                "sense_id": "eaf7edbd-fa55-38af-b66d-0c9aad8442e2",
                                "text": "Zijn prozaïsche beschrijving was des te overtuigender in haar eenvoud."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2125bf1-bcaa-3812-b841-e156f417dbcc",
                        "entry_id": "1782d713-d4ed-32c0-bc06-cecc7ca042dc",
                        "glosses": [
                            "weinig opmerkelijk, saai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c529e0-2c43-4239-a03d-56c6837db4f2",
                                "sense_id": "b2125bf1-bcaa-3812-b841-e156f417dbcc",
                                "text": "Haar leventje was tot dan toe vrij prozaïsch geweest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c61ab986-c5b7-4a50-b02d-1db4c7959179",
                        "source_entry_id": "1782d713-d4ed-32c0-bc06-cecc7ca042dc",
                        "source_sense_id": "eaf7edbd-fa55-38af-b66d-0c9aad8442e2",
                        "source_sense_description": "niet dichterlijk, in gewone taal",
                        "target_lang_word": "prosaic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0cd5f1-cd68-3e2c-80e0-87cb3e4c14e6",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Pertaining to or having the characteristics of prose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0df8d60-5274-4163-a3ef-7642887e9c39",
                                                "sense_id": "ed0cd5f1-cd68-3e2c-80e0-87cb3e4c14e6",
                                                "text": "The tenor of Eliot's prosaic work differs greatly from that of his poetry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1309d57-7207-3499-8f82-3051f036fcbf",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Straightforward; matter-of-fact; lacking the feeling or elegance of poetry."
                                        ],
                                        "tags": [
                                            "of writing or speaking"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25745c2e-c3a8-424f-a9c5-6493a9d3bec2",
                                                "sense_id": "a1309d57-7207-3499-8f82-3051f036fcbf",
                                                "text": "I was simply making the prosaic point that we are running late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Overly plain, simple or commonplace, to the point of being boring."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d259c5c2-8b97-4d08-a211-480c3cae4247",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "His account of the incident was so prosaic that I nodded off while reading it."
                                            },
                                            {
                                                "example_id": "397def79-b6b3-4313-9983-1746f002b9cf",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "She lived a prosaic life."
                                            },
                                            {
                                                "example_id": "094d55b4-35c2-427e-aed6-73b02fd2008e",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Our people are the most prosaic in the world, but the most faithful; and with curious reverence we keep up and transmit, from generation to generation, the superstition of what we call the education of a gentleman."
                                            },
                                            {
                                                "example_id": "61b3923a-5ee9-4d46-8817-84d58059100e",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Their steepness and abruptness were even greater than I had imagined from hearsay, and suggested nothing in common with the prosaic objective world we know."
                                            },
                                            {
                                                "example_id": "ba5e928a-7258-43f8-b0a9-800d74ce790c",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Ultimately, though, the more prosaic goals carried the greater significance in this contest. Madrid have managed only one clean sheet on their way to winning this competition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
