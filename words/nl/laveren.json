                    "sense_definition": "Onvast en zwalkend lopen, vaak door dronkenschap.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man kwam na het feestje <w>laverend</w> uit de kroeg naar buiten."
                        },
                        {
                            "text": "Hij <w>laveerde</w> over het trottoir omdat hij te veel gedronken had."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt vaak gebruikt om een dronken gang te beschrijven."
