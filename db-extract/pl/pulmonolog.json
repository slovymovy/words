                    {
                        "sense_id": "538923ba-9043-3486-9b6b-a3e33e2e052a",
                        "entry_id": "4b05cd0c-361d-3961-9d04-6ae35f6d4739",
                        "glosses": [
                            "lekarz specjalista zajmujący się rozpoznawaniem, profilaktyką i leczeniem chorób układu oddechowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78b35b8-a79d-4744-b9fd-3495b9da6611",
                                "sense_id": "538923ba-9043-3486-9b6b-a3e33e2e052a",
                                "text": "Pulmonolodzy zajmują się takimi schorzeniami, jak astma oskrzelowa, gruźlica płuc, mukowiscydoza i sarkoidoza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ee13393-df19-4bdd-b8ea-3fa2b37e1aa7",
