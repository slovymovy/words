                                "target_senses": [
                                    {
                                        "sense_id": "363c232a-816d-3a88-acf2-ed5d8b3ab9e0",
                                        "entry_id": "c9067964-af8f-3899-a15f-6be670a07069",
                                        "glosses": [
                                            "Characteristic of a sponge; spongy"
                                        ],
