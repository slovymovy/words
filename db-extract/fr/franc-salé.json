                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32248931-728f-4a5d-907d-333d206ca682",
                                "sense_id": "fb09e414-b69d-3469-a7ca-4e15c3ed7b02",
                                "text": "Nous voulons et entendons qu’il [l’hôtel des Invalides] jouisse de franc-salé, pour le sel nécessaire à la provision d’icelui."
                            },
                            {
                                "example_id": "e4e9a99c-48cf-4b4e-a3de-26a23f574f46",
                                "sense_id": "fb09e414-b69d-3469-a7ca-4e15c3ed7b02",
                                "text": "Le parlement enregistra la suppression du dixième, de beaucoup de francs-salés et d’autres articles."
                            },
                            {
                                "example_id": "e343debd-9a55-4ab9-882f-63c713838005",
                                "sense_id": "fb09e414-b69d-3469-a7ca-4e15c3ed7b02",
                                "text": "[…] : les gens de cour, les favoris recevaient des distributions gratuites de sel, des francs-salés. La taille était une flétrissure pour le misérable, le franc-salé un honneur pour le noble."
                            }
                        ]
