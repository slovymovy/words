                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f1a4b0-6b04-4912-811f-0dab181b0a73",
                                                "sense_id": "7aab8dc3-db49-3fca-87a6-8d1aa5c82ee1",
                                                "text": "Servez-moi une pression bien fraiche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b1c4ed-37cf-3c36-bd86-1c67d248c678",
