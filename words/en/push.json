                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "baskı yapmak"
                            },
                            {
                                "target_lang_word": "teşvik etmek",
                                "target_lang_sense_clarification": "cesaretlendirmek"
                            },
                            {
                                "target_lang_word": "sıkıştırmak",
                                "target_lang_sense_clarification": "acele ettirmek, baskı kurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a593b69-b65a-3c14-b402-a592f53057bd",
                    "sense_definition": "To continually exert oneself in order to achieve a goal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>push</w> yourself if you want to succeed.",
