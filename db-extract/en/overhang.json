                                        "glosses": [
                                            "situace, kdy nabídka a poptávka jsou rozdílné"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27df2cd-6184-4f7b-af9c-94db7d97f4ad",
