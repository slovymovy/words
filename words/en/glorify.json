{
    "word_family": [
        "glory",
        "glorification",
        "glorious",
        "gloriously",
        "inglorious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22d96ed4-3668-3a97-81c0-85b8f6445f4d",
                    "sense_definition": "To make something appear more attractive, noble, or glorious than it actually is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_or_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many critics argue that these action films <w>glorify</w> violence and criminal lifestyles."
                        },
                        {
                            "text": "The novel tends to <w>glorify</w> war without depicting any of its grim realities."
                        }
                    ],
                    "synonyms": [
                        "mythify"
                    ],
                    "antonyms": [
                        "vilify",
                        "slander"
                    ],
                    "common_phrases": [
                        "glorify violence",
                        "glorify war"
                    ]
                },
                {
                    "sense_id": "35d5f3f4-8a36-35d8-ac21-0bbf62f38da0",
                    "sense_definition": "To praise or honor someone or something, especially God or a deity, with worship and devotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_or_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang ancient hymns designed to <w>glorify</w> God and uplift the congregation."
                        },
                        {
                            "text": "The monument was constructed to <w>glorify</w> the brave deeds of national heroes."
                        }
                    ],
                    "synonyms": [
                        "exalt",
                        "transfigure"
                    ],
                    "antonyms": [
                        "vilify"
                    ],
                    "common_phrases": [
                        "glorify God"
                    ]
                }
            ]
        }
    ]
}