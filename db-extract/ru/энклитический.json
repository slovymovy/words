                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b77dc5a-91ec-437d-a832-49ec29d098ca",
                        "source_entry_id": "98905bc4-0327-3c99-9046-d1055278cdad",
                        "source_sense_id": "90cdaebf-b4a6-35ae-8d18-17260637c516",
                        "target_lang_word": "enklitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enklitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                        "entry_id": "e4a04426-5442-3f4d-986e-873c128901e9",
                                        "glosses": [
                                            "in der Form einer Enklise an ein Wort angehängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81388d98-88ff-4682-9711-529db2e75eb5",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Diese beiden Suffixe werden entweder der Grundform als eigenes Wort nachgesetzt oder sie werden enklitisch suffigiert.“"
                                            },
                                            {
                                                "example_id": "e38e2016-aaad-46bb-8ab1-1b433ec74ab6",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Diese sind jedoch drastisch vereinfacht worden, das heißt die alte Kongruenzflexion etwa beim enklitischen Artikel ist, kaum daß sie längere Zeit richtig in Gebrauch gewesen ist, schon seit Jahrhunderten (wieder) verschwunden.“"
                                            },
                                            {
                                                "example_id": "41c5a4ab-8b24-41bd-947b-6d31c12d93b7",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Treffen ein vokalisch auslautendes Stützwort und ein vokalisch anlautendes enklitisches Element aufeinander, so treten ebenfalls Assimilationserscheinungen auf, um den entstehenden Hiat zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
