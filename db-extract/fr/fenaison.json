                    },
                    {
                        "translation_id": "1dd60f99-6627-4f04-a450-4fcb4762a27a",
                        "source_entry_id": "3edfa5ad-5f48-3f60-b3a5-fd6e6b9d050a",
                        "source_sense_description": "époque du fanage",
                        "target_lang_word": "hooioogst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hooioogst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                        "entry_id": "5865f3c3-04da-392a-9fd7-f7a53d4432ca",
                                        "glosses": [
                                            "het door maaien van gras winnen van hooi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f44dc4-9207-404e-9bd2-a1706ea0630e",
                                                "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                                "text": "Toen Levin het beheer van het landgoed op zich nam en de hooioogst taxeerde, zag hij dat deze meer waard was, en hij had daarom de prijs op vijf en twintig roebel per desjatine gesteld."
                                            },
                                            {
                                                "example_id": "905d8fa4-e853-4cd1-8888-81069b1657cf",
                                                "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                                "text": "Bosnië-Herzegovina beleeft de ergste droogte sinds 48 jaren. Waar de pluviometers normaal 230 liter per vierkante meter slikken, werd dit jaar slechts 90 liter opgetekend. De maïs-, aardappel en hooioogst in het Kroatisch-moslimgedeelte van het land daalde met 30 tot 40 procent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "270af73a-2402-4b26-9e93-84895e72b1f3",
                        "source_entry_id": "3edfa5ad-5f48-3f60-b3a5-fd6e6b9d050a",
                        "source_sense_description": "époque du fanage",
                        "target_lang_word": "сенокос",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сенокос",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88efe5e4-51eb-3ef8-aa0b-407740773619",
                                        "entry_id": "01d56ecd-6a21-3807-aef2-8cfb37e93f70",
                                        "glosses": [
                                            "косьба травы на сено, сенокошение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b770afa-7d5b-4832-b662-df1bdef081b4",
                                                "sense_id": "88efe5e4-51eb-3ef8-aa0b-407740773619",
                                                "text": "Нарядить поголовно на сенокос: да смотри, рыжая бестия, чтоб у меня к Ильину дню все сено было в копнах."
                                            },
                                            {
                                                "example_id": "0173d9b9-9ed6-433b-ab6f-17e8727e210f",
                                                "sense_id": "88efe5e4-51eb-3ef8-aa0b-407740773619",
                                                "text": "Теперь идет сенокос, потом бабы рожь жать начнут, потом паровое поле под озимь двоить будут, потом сев, яровое жать, снопы возить, молотить."
                                            },
                                            {
                                                "example_id": "e0f91a96-b7ea-40de-98b7-4ef07e023dcf",
                                                "sense_id": "88efe5e4-51eb-3ef8-aa0b-407740773619",
                                                "text": "Если б была другая работа, вроде пахоты, например, он, конечно, в такой жар на сенокос людей не послал бы, но в начале июля, кроме косьбы, и в поле выходить незачем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94b95d0-4f97-381d-ae56-7906776333f6",
                                        "entry_id": "01d56ecd-6a21-3807-aef2-8cfb37e93f70",
                                        "glosses": [
                                            "время косьбы травы на сено"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3813689d-612d-4ed8-bf11-27c5612e8b3e",
                                                "sense_id": "a94b95d0-4f97-381d-ae56-7906776333f6",
                                                "text": "Я, надо вам сказать, попал туда как раз на сенокос, а на Украйне сенокос самое поэтическое время."
                                            },
                                            {
                                                "example_id": "2cf8d69c-fcb1-4d10-84ba-0454b97604e9",
                                                "sense_id": "a94b95d0-4f97-381d-ae56-7906776333f6",
                                                "text": "Во время сенокоса у меня с непривычки болело всё тело; сидя вечером на террасе со своими и разговаривая, я вдруг засыпал, и надо мною громко смеялись."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08bffe6-6a79-318f-8d4a-388fd65b3088",
                                        "entry_id": "01d56ecd-6a21-3807-aef2-8cfb37e93f70",
                                        "glosses": [
                                            "предназначенный для косьбы травы луг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56f9073-dd31-4616-baf1-3f9cfe95ebbf",
                                                "sense_id": "b08bffe6-6a79-318f-8d4a-388fd65b3088",
                                                "text": "Впрочем, шераминские мужики не особенно тужат об исчезнувших лесах, потому что на месте этих лесов теперь зеленеют бесконечные хлебные поля, сенокосы, и только часть остается под пустошами, куда выгоняют скот."
                                            },
                                            {
                                                "example_id": "bedda031-28ae-4051-a917-5a7aaa252c38",
                                                "sense_id": "b08bffe6-6a79-318f-8d4a-388fd65b3088",
                                                "text": "Ведь слободские сенокосы и пахотная земля находятся в пользовании не у всех хозяев, а лишь у некоторых."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
