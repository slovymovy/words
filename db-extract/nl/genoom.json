                "senses": [
                    {
                        "sense_id": "12e534d3-1787-34e7-9e80-da3172c8c4ee",
                        "entry_id": "13d2768a-b683-349e-b2f5-d28d074f0acc",
                        "glosses": [
                            "een verzameling van alle genen van de chromosomen van een organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1154ef75-1ab6-4eb7-b06b-0b2dbe5fe016",
                                "sense_id": "12e534d3-1787-34e7-9e80-da3172c8c4ee",
                                "text": "In de bijles kreeg hij uitgelegd wat een genoom is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "568a9032-54cf-43ee-a5d6-51940e86ea74",
                        "source_entry_id": "13d2768a-b683-349e-b2f5-d28d074f0acc",
                        "source_sense_id": "12e534d3-1787-34e7-9e80-da3172c8c4ee",
                        "source_sense_description": "een verzameling van alle genen van de chromosomen van een organisme",
                        "target_lang_word": "Genom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d26dff6-255b-3662-ad10-ac633c04fd58",
                                        "entry_id": "f64be5f9-ef70-3f5c-9754-f4c06350cb61",
                                        "glosses": [
                                            "die Gesamtheit der verschiedenen, nichtredundanten DNA-Sequenzen (bei manchen Viren auch RNA-Sequenzen) eines Organismus oder Zellorganells"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caba28c0-da30-4589-a7b4-e800192090b5",
                                                "sense_id": "0d26dff6-255b-3662-ad10-ac633c04fd58",
                                                "text": "Über 13 Jahre hat man das Genom des Menschen untersucht und entschlüsselt."
                                            },
                                            {
                                                "example_id": "7d3d1843-fa32-4dcb-b38a-ac130a571807",
                                                "sense_id": "0d26dff6-255b-3662-ad10-ac633c04fd58",
                                                "text": "Die Methode, die die Forscher angewendet haben, hat die Bezeichnung CRISPR. Damit können komplexe Genome verändert werden. Über die Gene des Embryos kann in das Erbgut sämtlicher Körperzellen eingegriffen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "018543e1-41e5-3d7e-a334-4a94ff1ddb8e",
                                        "entry_id": "f64be5f9-ef70-3f5c-9754-f4c06350cb61",
                                        "glosses": [
                                            "die Gesamtheit der Gene eines Organismus oder Zellorganells"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271c0259-d780-46f2-84ef-7e09a6635a52",
                                                "sense_id": "018543e1-41e5-3d7e-a334-4a94ff1ddb8e",
                                                "text": "Das Genom der Taufliege Drosophila melanogaster umfasst rund 13.000 Gene."
                                            },
                                            {
                                                "example_id": "887a5fec-d4d4-4be6-b2f6-38cc8a91abd9",
                                                "sense_id": "018543e1-41e5-3d7e-a334-4a94ff1ddb8e",
                                                "text": "Ein Mensch, ein Genom. Dieser Lehrsatz ist 15 Jahre nach der ersten Genom-Entzifferung nicht mehr haltbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a506b3d-fffd-4a16-9215-1234746a2929",
                        "source_entry_id": "13d2768a-b683-349e-b2f5-d28d074f0acc",
                        "source_sense_id": "12e534d3-1787-34e7-9e80-da3172c8c4ee",
                        "source_sense_description": "een verzameling van alle genen van de chromosomen van een organisme",
                        "target_lang_word": "genome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                        "entry_id": "c1d89cbe-20be-3444-b69e-eb72f1eabbcb",
                                        "glosses": [
                                            "The complete genetic information (either DNA or, in some viruses, RNA) of an organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc08b6dd-c90b-4e1f-b6e0-dca73445c425",
                                                "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, just as having the human genome has made it possible to ask new questions about cellular and molecular systems."
                                            },
                                            {
                                                "example_id": "fa4c79ad-2c17-4a41-bb04-8b20c931d88b",
                                                "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                                "text": "Because of her significant testing, Avery had had DNA sequencing of her “exome,” the part of her genome that makes proteins in the body, said Dr. Michael Wangler, a researcher at the Jan and Dan Duncan Neurological Research Institute at Texas Children’s Hospital."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34507157-8bd3-429a-96e4-45cbc0651d07",
                        "source_entry_id": "13d2768a-b683-349e-b2f5-d28d074f0acc",
                        "source_sense_id": "12e534d3-1787-34e7-9e80-da3172c8c4ee",
                        "source_sense_description": "een verzameling van alle genen van de chromosomen van een organisme",
                        "target_lang_word": "génome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                        "entry_id": "8a348b61-4309-3fcd-88e6-40012c9cba31",
                                        "glosses": [
                                            "Ensemble du matériel héréditaire composé d’acides nucléiques (ADN ou ARN) d’un organite cellulaire, d’un organisme ou d’une espèce."
                                        ],
                                        "tags": [
                                            "Génétique",
                                            "Bioinformatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad114cf-b2ec-4810-8233-1d50a7ea3210",
                                                "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                                "text": "Selon cette vue transitionniste, exposée en 1997, la variation n’est intrinsèquement ni gradualiste, ni saltationniste, elle passe d’une modalité à l'autre selon la complexification des génomes et des processus."
                                            },
                                            {
                                                "example_id": "66773950-1135-4230-ac2c-86bdfacd4d26",
                                                "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                                "text": "D’autre part, il apparaît que même dans les génomes les plus réduits, chez les holoparasites, la région répétée inversée qui porte presque exclusivement des gènes domestiques est la mieux conservée."
                                            },
                                            {
                                                "example_id": "fb6b6344-ce67-4b59-bb19-4e6835aa8fbf",
                                                "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                                "text": "Eh bien, cette mégarencontre de manipulateurs d’ADN, la semaine dernière à Boston, a dépassé tout ce que j'imaginais. « Oufissime », comme dirait notre Arthur. Croyez-moi, les biohackers californiens sont loin d'être les seuls à jouer au Lego avec le génome des microorganismes."
                                            },
                                            {
                                                "example_id": "b03cc154-7a2e-487a-9697-96058d36ef89",
                                                "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                                "text": "Trente fois la taille du génome humain. C’est la dimension vertigineuse du génome du dipneuste sud-américain, séquencé par une équipe internationale, qui a publié ses résultats le 14 août dans la revue scientifique Nature."
                                            },
                                            {
                                                "example_id": "2d1d7bd7-f2f6-4afd-89a6-a4bd8765c605",
                                                "sense_id": "3ab1e567-348e-3fc6-80bb-4c351308d949",
                                                "text": "Le terme Gattaca fait en fait référence aux quatre nucléotides. Guanine, Cytosine, Adénine et Thymine. Un nucléotide étant l'élément de base de l'ADN. D'autre part, la séquence GATTACA apparaît plusieurs fois dans le génome humain. Dans les génériques (de début comme de fin), les lettres G, A, T et C apparaissent avant les autres, également en référence aux 4 nucléotides, composants de l'ADN."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f79dcdf3-97c3-4a96-8dbc-3c584063dab6",
                        "source_entry_id": "13d2768a-b683-349e-b2f5-d28d074f0acc",
