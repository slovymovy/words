                                                "sense_id": "701174cb-24fe-34c7-96c5-bb07bff74a59",
                                                "text": "Profesor z góry wiedział, że student nic nie umie i to się potwierdziło, gdy zadał pierwsze pytanie."
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
