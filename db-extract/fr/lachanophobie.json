                ],
                "translations": [
                    {
                        "translation_id": "045fce9f-e67d-4209-b01c-d412922b6faa",
                        "source_entry_id": "0099e998-4b96-3c77-9f49-336bcebdc003",
                        "source_sense_id": "d6f3077b-77d3-38ec-a058-fdb480e43589",
                        "target_lang_word": "lachanophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lachanophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b407f08c-75db-3570-a99c-2c742a6d3578",
                                        "entry_id": "db868d1a-0acf-3ec1-81b1-a0bf1ec5b844",
                                        "glosses": [
                                            "An irrational fear of vegetables."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d84bf5d-7d14-4ca2-9dd4-e7c51bc4ca80",
                                                "sense_id": "b407f08c-75db-3570-a99c-2c742a6d3578",
                                                "text": "All in all, I'd like to state that it was lachanophobia that sparked this."
                                            },
                                            {
                                                "example_id": "3430b750-ed11-4604-8d75-a40234a413b7",
                                                "sense_id": "b407f08c-75db-3570-a99c-2c742a6d3578",
                                                "text": "“I thought recovered memories were traumatic. What's traumatic about citrus fruit?”\n“Lachanophobia,” he says. “That's the fear of vegetables. It stands to reason that there's one for the rest of the food pyramid, too.”"
                                            },
                                            {
                                                "example_id": "2bba5f62-de63-4baa-9be1-a60a4da4a51a",
                                                "sense_id": "b407f08c-75db-3570-a99c-2c742a6d3578",
                                                "text": "She suffers from a fear known as lachanophobia, which leaves her sweating and stricken with panic attacks at the merest sight of a sprout or a pea."
                                            },
                                            {
                                                "example_id": "b62d0772-3c2d-473c-8e6b-020085e7fbda",
                                                "sense_id": "b407f08c-75db-3570-a99c-2c742a6d3578",
                                                "text": "“[…] ‘lachanophobia,’ which appears to be an irrational fear of vegetables.” He leaned forward conspiratorially. “I must confess that, on occasion, I have used it as a way to avoid broccoli.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
