                        ],
                        "form": "toevluchtsoorden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                        "entry_id": "48010c60-c106-3400-a31f-8eb9f9a26fe4",
                        "glosses": [
                            "een plaats waar je in tijden van schaarste en bedreiging naar toe kunt gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d76f5e-3e31-430f-afc3-3faca26db000",
                                "sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                                "text": "Na de storm diende de sporthal als toevluchtsoord voor alle mensen die dakloos waren geworden."
                            },
                            {
                                "example_id": "5447a255-94f2-40a0-8807-a161794705f8",
                                "sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                                "text": "Het ouderlijk huis is ook voor volwassen kinderen nog steeds een toevluchtsoord als ze een warm bed, een hete douche en een warme maaltijd willen hebben."
                            },
                            {
                                "example_id": "9c106f2e-f1b1-486f-b731-c7727d92248b",
                                "sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                                "text": "\"Onderzoekers zijn hier welkom\": Macron was vandaag kritisch over het beleid van zijn Amerikaanse collega. \"Wie had ooit kunnen denken dat zo'n grote democratie, met een economie die juist steunt op vrije wetenschap, zo'n grote fout zou maken\", zei Macron. Amerikaanse onderzoekers zijn hier welkom, voegde hij eraan toe. En om ze op te vangen heeft Parijs 100 miljoen euro beschikbaar. \"Europa moet een toevluchtsoord zijn voor wetenschappers die worden bedreigd.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbeb80d1-af97-4041-ab35-30ae02b6a044",
                        "source_entry_id": "48010c60-c106-3400-a31f-8eb9f9a26fe4",
                        "source_sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                        "target_lang_word": "abri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Lieu où on peut se mettre à couvert, se protéger des intempéries ou d'un danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a6558b-a00e-4487-ba15-dd9f87958897",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Pourquoi construire d’inconfortables maisons en planches et en tôle ondulée quand le feuillage des cocotiers peut vous fournir des abris toujours frais?"
                                            },
                                            {
                                                "example_id": "0d3af13a-f8a5-4570-8733-65d71bf182cd",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Si misérable que soit l’abri dont on dispose, il est encore préférable à la bise glacée."
                                            },
                                            {
                                                "example_id": "2ba663a2-d552-42f4-a552-df2c71f6caa3",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Le bruit du bombardement au-dessus de l’abri devient formidable. Les obus tombent sur la Chancellerie avec une précision inquiétante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9953aedd-2581-3edf-92cf-33a5c1113dbb",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Construction équipée d’un toit qui protège les utilisateurs de transports en commun, le matériel sensible…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a599e882-8a2c-41dc-b865-4e101b8a881b",
                                                "sense_id": "9953aedd-2581-3edf-92cf-33a5c1113dbb",
                                                "text": "Rejoignons l’abri pour attendre l’autobus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Ce qui préserve de l’adversité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8a3f44-e731-44ab-8d6c-606e9fb14128",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Ce coin perdu de Jan-Mayen n’est pas à l’abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            },
                                            {
                                                "example_id": "cdbdb99d-b3e6-4057-a599-93909cd91870",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                                            },
                                            {
                                                "example_id": "f1da56ba-ee02-41b3-b461-a9a6ce2cfc55",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Se mettre à l’abri. — Être à l’abri du besoin. — Nul n’est à l’abri d’un accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Tout ce qui sert à garantir, soit de l’action désastreuse des vents, soit de la trop grande ardeur du soleil, soit du gel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a20f8c9-d60c-4f89-b1a7-4b20565d0e47",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Les abris sont ou naturels, comme les montagnes, les forêts, les plantations en lignes et les haies; ou artificiels, comme les murs et les paillassons."
                                            },
                                            {
                                                "example_id": "e8339c2c-3640-448e-86bb-ee939c6201f6",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Sylvius, tant que le cornouiller au tronc noir restera debout, nos âmes vivront dans cet abri de verdure où nous nous sommes aimés, elles fleuriront avec les roses et se pencheront sur les bordures épaisses des buis."
                                            },
                                            {
                                                "example_id": "974dc9b1-5cbc-474e-9437-e9adcce12e57",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Depuis fort longtemps, on recommande le maintien d’un abri […] lors des toutes premières années d’installation du jeune hêtre, prenant appui sur son comportement d’essence d’ombre, et sur les « classiques » difficultés de renouvellement rencontrées en plein découvert (coups de chaleur estivale, gels tardifs, forme défavorable). En régénération naturelle comme en plantation sous abri, la mise en pleine lumière intervient ensuite souvent rapidement, dans un délai proche d’une dizaine d’années, parfois moins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a60c2b-881e-3547-a0ac-68ab1176d46c",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Installation destinée à protéger des projectiles ennemis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f4ed83-a806-4ec1-8bbb-0817d3e72cd6",
                                                "sense_id": "77a60c2b-881e-3547-a0ac-68ab1176d46c",
                                                "text": "Vers 15 heures, alors que le défilé de la débâcle continuait, un bruit d'avions inquiéta la population. Trois ou quatre chasseurs bombardiers survolaient la ville, et les habitants gagnèrent en hâte les abris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66716b7-02c7-351a-a432-1e4ff1e1ad3f",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Enceinte en forme de caissette montée sur socle, exposée au nord, et contenant divers appareils de mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e46e2f9-b788-4e83-b402-c4768cf2d93f",
                                                "sense_id": "b66716b7-02c7-351a-a432-1e4ff1e1ad3f",
                                                "text": "Le 29 avril, j'ai installé un second poste d’ozonoscopie à la rampe de notre belvédère, à 20 mètres au-dessus du poste établi dans l’abri des thermomètres qui servent aux observations météorologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbbcf9d6-7418-41c1-a362-915f879e085a",
                        "source_entry_id": "48010c60-c106-3400-a31f-8eb9f9a26fe4",
                        "source_sense_id": "6ee9d5b6-2527-3375-ba12-ad42f34e0359",
                        "target_lang_word": "refuge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e095f87-238d-3904-a95b-31d815430de0",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Asile ; retraite ; lieu où l’on cherche un abri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dfb3bd4-177b-471b-8aae-75a8fa7abef6",
                                                "sense_id": "9e095f87-238d-3904-a95b-31d815430de0",
                                                "text": "Il avait pris le maquis un an plus tôt : arrêté par les gendarmes d’Alès, en avril 1943, pour ses activités politiques, il s’était évadé et avait trouvé refuge chez les francs-tireurs et partisans (FTP)."
                                            },
                                            {
                                                "example_id": "a9dbb04b-804f-43fd-bb66-c202567e46af",
                                                "sense_id": "9e095f87-238d-3904-a95b-31d815430de0",
                                                "text": "Carcassonne était la place centrale des opérations entreprises contre l’armée aragonaise et un refuge assuré en cas d’échec."
                                            },
                                            {
                                                "example_id": "f54b66ea-e4fa-4c32-b4d2-3c72308266c6",
                                                "sense_id": "9e095f87-238d-3904-a95b-31d815430de0",
                                                "text": "Cuba n'était pas encore colonisée et servait de refuge aux malheureux Indiens que le désespoir chassait d’Hispaniola ; les forêts en étaient remplies, et plus d'une fois ils attaquèrent les naufragés."
                                            },
                                            {
                                                "example_id": "17b2b7b0-751d-430b-afb1-5a2563fc36fa",
                                                "sense_id": "9e095f87-238d-3904-a95b-31d815430de0",
                                                "text": "Notons pour terminer l’importance que prennent les formations glaciaires dans la haute vallée de la Lanterne, où les étangs et les tourbières constituent autant de « refuges » pour bon nombre d’espèces boréales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6206d41-3c13-3c7a-86a7-494da1febba1",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Ensemble des pays dans lesquels se sont installés les Huguenots qui ont fui la France pendant les persécutions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c142270-c396-421a-9f66-3a4a598e4561",
                                                "sense_id": "e6206d41-3c13-3c7a-86a7-494da1febba1",
                                                "text": "Quelques personnalités importantes, dans les pays du Refuge, descendent de huguenots. Lothar de Maizière, qui fut l’un des principaux ministres d’Angela Merkel, a des ancêtres huguenots. Pieter Botha (1916-2006), qui fut premier ministre et président de l’Afrique du Sud dans les années 1980, était très fier de ses origines huguenotes. Aux Pays-Bas, cette identité huguenote est même suffisamment vivace pour qu’on continue de célébrer quelques cultes en français dans ce qu’on nomme les « Eglises wallonnes »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd2f52d6-cedd-3133-b7c8-401f16af8b42",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Centre d’accueil et de protection destiné à recueillir les animaux trouvés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309a8dd0-e38c-4fb1-8c32-cdaa54090dcd",
                                                "sense_id": "fd2f52d6-cedd-3133-b7c8-401f16af8b42",
                                                "text": "Il avait également un chien – un bâtard de deux ans, qu’il était allé chercher le jour de Noël au refuge SPA de Montargis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c53ae66-a30e-323e-b0b0-3a66b114aba9",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Habitat de montagne pour les alpinistes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aee89a1-9fbb-43d5-9bec-d521a4f9c2c6",
                                                "sense_id": "2c53ae66-a30e-323e-b0b0-3a66b114aba9",
                                                "text": "Les refuges sont faits pour abriter les alpinistes avant ou après la course, et non pour servir d’auberges ou de buts de promenade aux simples badauds…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c76fb0-74f2-355d-bd1c-5ca273960686",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Terre-plein au milieu de la voie publique où les piétons peuvent se garer des voitures."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3091c22a-fe13-4597-ae40-c1f364ba0183",
                                                "sense_id": "49c76fb0-74f2-355d-bd1c-5ca273960686",
                                                "text": "Il avait réussi à prendre quelques photos : des CRS à moitié endormis, bottés et casqués, le Mauser lance-grenades à la bretelle, rencognés, non loin du CHU et de la fac de droit, comme une poignée d’oiseaux mouillés, sous les grimaces provocatrices et vengeresses des masques de pierre du vieil hôtel de Cerisy ; un garde-mobile ronflant la bouche ouverte, le visage grotesquement déformé par la vitre du car Berliet le long duquel sa joue s’était ventousée comme une limace ; un gradé en civil, arrogant et sec, juché sur le refuge central du carrefour des Palomières comme un coq sur son fumier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107393e4-2495-3a8f-b546-67af42ea7631",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Bienfaiteur dont on attend, dont on implore la protection, le secours."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac2fbf8-143c-41f8-a386-cba5f7074e6a",
                                                "sense_id": "107393e4-2495-3a8f-b546-67af42ea7631",
                                                "text": "Les lois sont le refuge du faible."
                                            },
                                            {
                                                "example_id": "7dc191be-3a28-4d35-896a-f9cd470c9c8e",
                                                "sense_id": "107393e4-2495-3a8f-b546-67af42ea7631",
                                                "text": "Vous êtes mon seul refuge, Il est le refuge des misérables."
                                            },
                                            {
                                                "example_id": "a5e019cb-882f-4595-a768-6c950cc06296",
                                                "sense_id": "107393e4-2495-3a8f-b546-67af42ea7631",
                                                "text": "Voilà mon dernier refuge."
                                            },
                                            {
                                                "example_id": "9991890c-e03f-4014-b8a9-d6c405ec5d7b",
                                                "sense_id": "107393e4-2495-3a8f-b546-67af42ea7631",
                                                "text": "Dieu est mon unique refuge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02d3001f-c5da-361f-9806-5914db05bc74",
                                        "entry_id": "0ba772dc-f107-3fe2-a359-ef2832856b2f",
                                        "glosses": [
                                            "Prétexte, raisons apparentes sous lesquelles l’erreur ou la mauvaise foi cherche à se mettre à couvert."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ffcad65-474a-4782-8ff9-0d1c2e1f85a7",
                                                "sense_id": "02d3001f-c5da-361f-9806-5914db05bc74",
                                                "text": "Quel misérable refuge que ce prétexte!"
                                            },
                                            {
                                                "example_id": "a5ff2344-378e-4c35-824c-f52c465f0dd6",
                                                "sense_id": "02d3001f-c5da-361f-9806-5914db05bc74",
                                                "text": "La dénégation est son refuge ordinaire."
                                            },
                                            {
                                                "example_id": "d0fae0fa-f9db-4b89-bf36-ab4723b0c3c4",
                                                "sense_id": "02d3001f-c5da-361f-9806-5914db05bc74",
                                                "text": "On l’a poursuivi dans tous ses refuges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f00451-c052-4dc5-abdd-969436f73b25",
