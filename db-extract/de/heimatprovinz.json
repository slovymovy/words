                "senses": [
                    {
                        "sense_id": "396087b1-87b3-3f37-891c-025246c4b060",
                        "entry_id": "025f91ec-25b1-3b75-bf36-948a81858012",
                        "glosses": [
                            "Provinz, in der jemand geboren oder aufgewachsen ist und sie daher als seine Heimat betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37fb31bb-9575-43c9-823d-d0fbb89932b5",
                                "sense_id": "396087b1-87b3-3f37-891c-025246c4b060",
                                "text": "„Mmangagwa galt als gewaltbereiter und ruchloser Politiker, der in seiner Heimatprovinz, den Midlands, jeden Rivalen oder politischen Gegner mit allen, meist illegalen, Mitteln bekämpfte.“"
                            },
                            {
                                "example_id": "9f80af3c-e8a5-4e62-b482-5f7279598574",
                                "sense_id": "396087b1-87b3-3f37-891c-025246c4b060",
                                "text": "„Ein paar Kritiker beharrten sogar darauf, meine Bezüge auf die Folklore und lokalen Sitten, die so unverschämt detailiert seien, würden Karikaturen ihrer diversen Heimatprovinzen darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
