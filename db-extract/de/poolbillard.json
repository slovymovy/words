                    {
                        "sense_id": "1fffa356-8a3d-31c1-ad5a-440017cd646d",
                        "entry_id": "4ab5add9-7e53-3f82-8fa2-33079e31367a",
                        "glosses": [
                            "Variante des Billards, bei der es darum geht, mit einem weißen Spielball farbige Objektbälle nach bestimmten Regeln in sechs Taschen zu spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442bc74c-467a-4d71-82b5-2288a6d39fb7",
                                "sense_id": "1fffa356-8a3d-31c1-ad5a-440017cd646d",
                                "text": "„›Spielen Sie Poolbillard?‹“"
                            },
                            {
                                "example_id": "e06aabf8-64a8-4d7e-8350-f63644e4d994",
                                "sense_id": "1fffa356-8a3d-31c1-ad5a-440017cd646d",
                                "text": "„Verschiedene Schilder an den Wänden warben für Budweiser, den König der Biere, Redman-Kautabak, Coca-Cola, Poolbillard und Sandwiches.“"
                            },
                            {
                                "example_id": "5fcb37a2-2557-4372-aaac-4ed761fbb9ed",
                                "sense_id": "1fffa356-8a3d-31c1-ad5a-440017cd646d",
                                "text": "„Wir spielten Dart und Poolbillard - er gewann haushoch, meine Finger schmerzten zwar nicht mehr, waren aber noch angeschwollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2405db6-60ff-46c3-b05b-5d4f54946ea9",
                        "source_entry_id": "4ab5add9-7e53-3f82-8fa2-33079e31367a",
                        "source_sense_id": "1fffa356-8a3d-31c1-ad5a-440017cd646d",
                        "source_sense_description": "Variante des Billards",
                        "target_lang_word": "pool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
