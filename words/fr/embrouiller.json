                {
                    "sense_id": "cef9f626-d222-3bfd-9a81-54b986840de7",
                    "sense_definition": "Perdre la clarté dans ses pensées, son discours ou ses actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confusion_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le coup du stress, le candidat s'<w>embrouille</w> dans ses explications devant le jury.",
                            "target_lang_translations": {
                                "en": "Under stress, the candidate <w>gets confused</w> when giving his explanations to the jury.",
                                "ru": "Из-за стресса кандидат <w>путается</w> в своих объяснениях перед жюри.",
                                "de": "Unter dem Stress <w>verhaspelt</w> <w>sich</w> der Kandidat in seinen Erklärungen vor der Jury.",
                                "es": "Bajo el estrés, el candidato se <w>confunde</w> al dar sus explicaciones ante el jurado.",
                                "zh": "在压力之下，这位候选人在评委面前做解释时思路<w>混乱</w>了。"
                            }
                        },
                        {
                            "text": "Je m'<w>embrouille</w> souvent quand je dois effectuer des opérations mathématiques complexes.",
                            "target_lang_translations": {
                                "en": "I often <w>get confused</w> when I have to do complex mathematical operations.",
                                "ru": "Я часто <w>путаюсь</w>, когда приходится выполнять сложные математические действия.",
                                "de": "Wenn ich komplexe Rechenoperationen durchführen muss, <w>komme</w> ich oft <w>durcheinander</w>.",
                                "es": "Me <w>confundo</w> a menudo cuando tengo que hacer operaciones matemáticas complejas.",
                                "zh": "我一做复杂的数学运算就常常<w>搞混</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "se prendre les pieds dans le tapis",
                        "s'emmêler les crayons",
                        "s'emmêler les pinceaux"
                    ],
                    "common_phrases": [
                        "s'embrouiller dans ses explications",
                        "s'embrouiller dans ses calculs"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose clarity in one's thoughts, speech or actions.",
                        "ru": "Терять ясность мыслей, речи или действий.",
                        "de": "Die Klarheit seiner Gedanken, seiner Rede oder seines Handelns verlieren.",
                        "es": "Perder la claridad en los pensamientos, en el discurso o en los actos.",
                        "zh": "思路、言语或行动变得不清楚、不条理。"
                    },
