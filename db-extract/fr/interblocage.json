        "fr-extract.jsonl": [
            {
                "entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                "word": "interblocage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5866335a-88c9-4c2c-ba7c-6359f209f1bd",
                        "entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "tags": [
                            "plural"
                        ],
                        "form": "interblocages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                        "entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "glosses": [
                            "Situation dans laquelle deux processus ou tâches ne progressent pas et conséquemment demeurent bloqués indéfiniment. Ils peuvent s’attendre mutuellement, dans le cas d'un interblocage passif, ou prendre des actions contradictoires, dans le cas d'un interblocage actif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26c85d2-c652-416c-90f6-9438268256ea",
                                "sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                                "text": "Il existe bel et bien un cycle qui correspond à un interblocage."
                            },
                            {
                                "example_id": "5dfa93e9-9f5e-40b1-92b4-a63683c0cc87",
                                "sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                                "text": "Une mauvaise programmation de la gestion de verrous dans un logiciel multi-utilisateur entraîne fréquemment des interblocages aléatoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "509bba97-b4c4-40b7-8bb0-e31de87221b2",
                        "source_entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "source_sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                        "target_lang_word": "deadlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d021c688-6583-33dc-b1fc-e6bb8b51eeb6",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "A standstill resulting from the opposition of two evenly matched forces; a stalemate or impasse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09da409e-4b92-461d-8a07-13fedfbbf4ef",
                                                "sense_id": "d021c688-6583-33dc-b1fc-e6bb8b51eeb6",
                                                "text": "The negotiation ended in deadlock, with neither party willing to compromise on the price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7cea60a-f459-34f4-8891-ca4e5bf3ca54",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "An inability to continue due to two programs or devices each requiring a response from the other before completing an operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fce886a-56e3-40e9-b85e-8063024abea4",
                                                "sense_id": "a7cea60a-f459-34f4-8891-ca4e5bf3ca54",
                                                "text": "If synchronization is always performed in least-first order with respect to object tags, then situations can never arise in which one thread has the synchronization lock for x while waiting for y and another has the lock for y while waiting for x. Instead, they will both obtain the locks in the same order, thus avoiding this form of deadlock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f260094-cdc3-3f4d-960c-8adb9f4c7082",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "Synonym of deadbolt (“type of lock”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deadlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                        "entry_id": "ccd65300-1d5a-35e9-a0d3-a82d4fcfd9e7",
                                        "glosses": [
                                            "To cause or come to a deadlock."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b079828-b187-4ae0-a3f9-4fc689f8d704",
                                                "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                                "text": "A suspect was arrested on November 30 and charged with attempted murder. The evidence against him consisted of two jailhouse informers and an eyewitness who picked him out of a lineup after having identified a different man in an initial photo array. A jury ultimately convicted the suspect of assault after deadlocking twice in three days of deliberation."
                                            },
                                            {
                                                "example_id": "48c8cca9-1c46-4347-9b47-5c96d056588e",
                                                "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                                "text": "Since we cannot solve this problem completely, it may sometimes be better to use explicit locks and risk deadlock if a thread exits unexpectedly. It may be better to have a deadlocked system than to have a corrupted system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d521004e-d19c-4a4c-ab56-b58ccd033c1a",
                        "source_entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "source_sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                        "target_lang_word": "livelock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livelock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68df9bf3-ef50-3e62-8d4e-256950a8e551",
                                        "entry_id": "9a1eea8c-405a-3785-aeea-662a73dc7544",
                                        "glosses": [
                                            "A state resembling deadlock in which various computational processes are constantly changing but never reach a point where any of them can proceed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90261f8e-1c61-4488-9104-6b9acbd26d1f",
                                                "sense_id": "68df9bf3-ef50-3e62-8d4e-256950a8e551",
                                                "text": "However, this can lead to livelock—the optimistic analog of indefinite blocking in which methods continuously spin without making any further progress."
                                            },
                                            {
                                                "example_id": "3e687d1e-349b-4603-aa44-934351c576a1",
                                                "sense_id": "68df9bf3-ef50-3e62-8d4e-256950a8e551",
                                                "text": "A process is considered to be in a state of livelock when thread code is still executing, but two or more threads are in a never-ending cycle with each other and no useful work is being done."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "livelock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e86dab1-a729-3032-8149-260168973469",
                                        "entry_id": "c9040c21-08f7-337d-9ef5-b79f19cb0bd0",
                                        "glosses": [
                                            "To enter a state of livelock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb7cc192-d67e-42f9-87b0-dd7d681991a5",
                        "source_entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "source_sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                        "target_lang_word": "deadly embrace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadly embrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3039748-6615-3bb3-9025-5111ffbf751d",
                                        "entry_id": "3d7e6bcf-127f-3238-9cec-24b5f6a0e1f7",
                                        "glosses": [
                                            "deadlock"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3357b0f9-dcc0-494a-9633-0bc561f15959",
                        "source_entry_id": "9fc49c04-7b0a-3507-80b5-35e4884d9dfe",
                        "source_sense_id": "543ad1ae-8a08-369e-ace5-8f14cf783a2d",
                        "target_lang_word": "knot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1a3b8f3-a5aa-3ad8-8364-0b0848cc6912",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A looping of a piece of string or of any other long, flexible material that cannot be untangled without passing one or both ends of the material through its loops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4efbb15-0582-45ea-9d3a-b2816369a7ed",
                                                "sense_id": "c1a3b8f3-a5aa-3ad8-8364-0b0848cc6912",
                                                "text": "Climbers must make sure that all knots are both secure and of types that will not weaken the rope."
                                            },
                                            {
                                                "example_id": "e1fcfa12-72bd-483c-bf9d-d3daada3001a",
                                                "sense_id": "c1a3b8f3-a5aa-3ad8-8364-0b0848cc6912",
                                                "text": "The obstructive tendency attributed to the knot in spiritual matters appears in a Swiss superstition that if, in sewing a corpse into its shroud, you make a knot on the thread, it will hinder the soul of the deceased on its passage to eternity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df96ea1-d2a5-3993-a2b9-129e5f3e6540",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A tangled clump of hair or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922ecd49-d7fe-4368-9ea7-39ceb41ec288",
                                                "sense_id": "6df96ea1-d2a5-3993-a2b9-129e5f3e6540",
                                                "text": "The nurse was brushing knots from the protesting child's hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609f995c-be47-3c2a-98b1-fbf971f2a3e1",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A maze-like pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170751a1-3ece-488b-8db8-48bb3fad4902",
                                                "sense_id": "609f995c-be47-3c2a-98b1-fbf971f2a3e1",
                                                "text": "Flowers worthy of paradise, which, not nice art / In beds and curious knots, but nature boon / Poured forth profuse on hill, and dale, and plain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "738e7da5-9d4e-33f2-8adf-56b6d4337703",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A non-self-intersecting closed curve in (e.g., three-dimensional) space that is an abstraction of a knot (in sense 1 above)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f668dec4-8fcc-4657-a384-56e1b21b8b53",
                                                "sense_id": "738e7da5-9d4e-33f2-8adf-56b6d4337703",
                                                "text": "A knot can be defined as a non-self-intersecting broken line whose endpoints coincide: when such a knot is constrained to lie in a plane, then it is simply a polygon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a37e2f-9e7e-3696-a004-aef75a362b29",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A difficult situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf779f6-e3ca-4679-96e6-38ba38c6eec6",
                                                "sense_id": "d3a37e2f-9e7e-3696-a004-aef75a362b29",
                                                "text": "I got into a knot when I inadvertently insulted a policeman."
                                            },
                                            {
                                                "example_id": "b8d640a9-b28e-45a6-b561-afac3960c754",
                                                "sense_id": "d3a37e2f-9e7e-3696-a004-aef75a362b29",
                                                "text": "A man shall be perplexed with knots, and problems of business, and contrary affairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d52ff2fe-b097-3e65-9f15-c7d453f7a8da",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "The whorl left in lumber by the base of a branch growing out of the tree's trunk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f229af6a-e068-43a9-b42f-2b7ddd109d6c",
                                                "sense_id": "d52ff2fe-b097-3e65-9f15-c7d453f7a8da",
                                                "text": "When preparing to tell stories at a campfire, I like to set aside a pile of pine logs with lots of knots, since they burn brighter and make dramatic pops and cracks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112fabdf-8521-325b-b58a-4fad3af9e7b7",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "Local swelling in a tissue area, especially skin, often due to injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "742a4c58-7b7f-4e04-8bbd-860e1c8421e7",
                                                "sense_id": "112fabdf-8521-325b-b58a-4fad3af9e7b7",
                                                "text": "Jeremy had a knot on his head where he had bumped it on the bedframe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f8c5a1-f28e-30ee-b4ee-b3162c8ad439",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A tightened and contracted part of a muscle that feels like a hard lump under the skin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9107bb82-1710-3da3-952d-0dd9d1fcce4b",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A protuberant joint in a plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf0bc2a4-9d49-30a5-b91b-b63922dbcc4c",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "Any knob, lump, swelling, or protuberance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8026a6ce-df52-4896-a5e5-fed0bd400d37",
                                                "sense_id": "cf0bc2a4-9d49-30a5-b91b-b63922dbcc4c",
                                                "text": "[T]he Queen who sat / With lips severely placid, felt the knot / Climb in her throat, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd026e59-1bf8-37f3-88e4-be40642c6b51",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "The swelling of the bulbus glandis in members of the dog family, Canidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe86193d-3b81-3f03-bd83-416714bb3e89",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "The point on which the action of a story depends; the gist of a matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662aab8b-3d39-403b-824f-a69cf0ca34a6",
                                                "sense_id": "fe86193d-3b81-3f03-bd83-416714bb3e89",
                                                "text": "the knot of the tale"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c22599ed-1171-38f2-a619-172d4741df31",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A node (point at which the lines of a funicular machine meet from different angular directions)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38e130b0-2ca4-313e-90b2-ea3f5d1003f4",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A kind of epaulet; a shoulder knot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A group of people or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99436273-7009-4c5a-961d-bdb907b72043",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "his ancient knot of dangerous adversarie"
                                            },
                                            {
                                                "example_id": "2b7b2663-875a-4b6e-b10c-2ad4d40a86e0",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "As they sat together in small, separate knots, they discussed doctrinal and metaphysical points of belief."
                                            },
                                            {
                                                "example_id": "2bd8ae2c-a2d4-4073-82f4-51facbaeb98d",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "When, for instance, he saw a knot of the ruffians on the prairie, discussing, of course, the single topic which then occupied their minds, he would, perhaps, take his compass and one of his sons, and proceed to run an imaginary line right through the very spot on which that conclave had assembled, and when he came up to them, he would naturally pause and have some talk with them, learning their news, and, at last, all their plans perfectly; and having thus completed his real survey he would resume his imaginary one, and run on his line till he was out of sight."
                                            },
                                            {
                                                "example_id": "51515c6b-7344-4c5c-a5bf-c2e5f93d46c9",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "The garden was bounded by a three-foot brick wall with a fringe of wood rails upon the top, and against this wall was leaning a stalwart police constable, surrounded by a small knot of loafers, who craned their necks and strained their eyes in the vain hope of catching some glimpse of the proceedings within."
                                            },
                                            {
                                                "example_id": "d10894f3-20a4-44b4-b835-e4d45147b348",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "At corners, under the lights, near drugstores, small knots of white, bright, chattering people showed teeth to each other, pawed each other, whistled for taxis, were whirled away in them, vanished through the doors of drugstores or into the blackness of side streets."
                                            },
                                            {
                                                "example_id": "fd37fd5e-22bc-4d5f-ad28-81ee4bea5462",
                                                "sense_id": "86998fab-bf5d-3c6e-9132-d14bdabc61f6",
                                                "text": "1968, Bryce Walton, Harpoon Gunner, Thomas Y. Crowell Company, NY, (1968), page 20,\nHe pushed through knots of whalemen grouped with their families and friends, and surrounded by piles of luggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08abd220-59e8-3101-9373-6f71614226a7",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A bond of union; a connection; a tie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662bf2a6-12ad-4e93-a833-cfe63a14a1e0",
                                                "sense_id": "08abd220-59e8-3101-9373-6f71614226a7",
                                                "text": "[I come] to crave a league of amity,\nAnd lastly, to confirm that amity\nWith nuptial knot […]"
                                            },
                                            {
                                                "example_id": "bc087b66-322a-426c-99ff-df7664f512bb",
                                                "sense_id": "08abd220-59e8-3101-9373-6f71614226a7",
                                                "text": "[I]t were very fit, […] to observe carefully this previous betrothing of ourselves, ere we knit the knot that can never be loosed."
                                            },
                                            {
                                                "example_id": "e0713a1f-cd8b-47e0-8a38-f6eed072b7ff",
                                                "sense_id": "08abd220-59e8-3101-9373-6f71614226a7",
                                                "text": "Indeed I would advise every ſingle lady, if poſſible, to attend her inamorato, pretty frequently at the card table; […] if he is haſty or pettiſh with any one else in company, she may depend on the ſame fate when once the knot is tied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb1a2171-bf7e-3f7d-ad7c-169b43b10274",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A unit of speed, equal to one nautical mile per hour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b5d62a-49c6-4b4d-9e1a-717759c107b5",
                                                "sense_id": "fb1a2171-bf7e-3f7d-ad7c-169b43b10274",
                                                "text": "Cedric claimed his old yacht could make 12 knots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725c73aa-6a68-3cf2-8bfd-8150a704d582",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A unit of indicated airspeed, calibrated airspeed, or equivalent airspeed, which varies in its relation to the unit of speed so as to compensate for the effects of different ambient atmospheric conditions on aircraft performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d80dff-5dfa-4398-8a50-b939719538e3",
                                                "sense_id": "725c73aa-6a68-3cf2-8bfd-8150a704d582",
                                                "text": "In the early stages of reentry, due to the extremely-rarefied air at these altitudes, the space shuttle flew at only one to a few knots equivalent airspeed, even when its actual speed was many thousands of knots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f08fc82-cb3f-3d88-93f1-bb404351456d",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "A nautical mile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccee7b24-4314-3242-b654-551a35008a15",
                                        "entry_id": "d35f2d12-c55d-3da1-aa90-7750a96f0849",
                                        "glosses": [
                                            "The bulbus glandis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "832ef8b5-45eb-3474-a9e9-6411dbadba7b",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To form into a knot; to tie with a knot or knots."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2455c48-b81d-4a80-968f-8d9180bcafd0",
                                                "sense_id": "832ef8b5-45eb-3474-a9e9-6411dbadba7b",
                                                "text": "We knotted the ends of the rope to keep it from unravelling."
                                            },
                                            {
                                                "example_id": "25828749-1d1c-457b-b87f-394079b9f51e",
                                                "sense_id": "832ef8b5-45eb-3474-a9e9-6411dbadba7b",
                                                "text": "For many weeks about my loins I wore / The rope that haled the buckets from the well, / Twisted as tight as I could knot the noose, / And spake not of it to a single soul, / And spake not of it to a single soul, / Until the ulcer, eating through my skin, / Betray'd my secret penance, so that all / My brethren marvell'd greatly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e73ff65-f158-3d73-9606-696226fcd643",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To form wrinkles in the forehead, as a sign of concentration, concern, surprise, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b40396d-3ceb-40cb-a2ce-dc574902627f",
                                                "sense_id": "4e73ff65-f158-3d73-9606-696226fcd643",
                                                "text": "She knotted her brow in concentration while attempting to unravel the tangled strands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166283b6-c68e-3f38-878b-d33d868518f1",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To unite closely; to knit together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e21b6c1d-508b-401f-8160-d2c7b3b5d7ca",
                                                "sense_id": "166283b6-c68e-3f38-878b-d33d868518f1",
                                                "text": "The party of the papists in England are become more knotted, both in dependence towards Spain, and amongst themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e3703e-a698-3f72-8a37-e4e9b307cdca",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To entangle or perplex; to puzzle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5f52dc2-bb76-3bcc-b947-fb2d7f9db7e1",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To form knots."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f29107a-03e6-3bec-a020-3479964290d0",
                                        "entry_id": "1be56887-b55a-3488-85f9-b61ab47c4150",
                                        "glosses": [
                                            "To knit knots for a fringe."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25edc565-44fa-3343-a9bb-b9ee444d02cf",
                                        "entry_id": "0c128351-9701-3880-b366-32fc142ef2e1",
                                        "glosses": [
                                            "One of a variety of shore birds; red-breasted sandpiper (variously Calidris canutus or Tringa canutus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf32bb76-617a-4e6d-a91b-207c8c55ae76",
                                                "sense_id": "25edc565-44fa-3343-a9bb-b9ee444d02cf",
                                                "text": "My foot-boy shall eat pheasants, calvered salmons, / Knots, godwits, lampreys: I myself will have / The beards of barbels, served instead of salads […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
