                "senses": [
                    {
                        "sense_id": "495b5c4a-c315-3602-b350-7df3b53f77b5",
                        "entry_id": "a8da20ca-4198-353a-b971-a2deb5ef2c12",
                        "glosses": [
                            "enge Mütze aus Gummi, die man beim Schwimmen trägt, um die Haare zusammenzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cdbd6d9-28d4-4ecc-87a2-9f7af6ddc7d7",
                                "sense_id": "495b5c4a-c315-3602-b350-7df3b53f77b5",
                                "text": "„Sie trug einen blauen, einteiligen Badeanzug und eine gleichfarbige Badehaube mit vielen blauen Tüllblüten.“"
                            },
                            {
                                "example_id": "d6c2c586-ced2-488d-8d35-1afb6d271f0d",
                                "sense_id": "495b5c4a-c315-3602-b350-7df3b53f77b5",
                                "text": "„Bahnen zu schwimmen war etwas für Frauen mit geblümten Badehauben und Männer mit Falten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
