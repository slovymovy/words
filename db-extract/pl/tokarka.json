                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drehmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a72ab82-213b-36cb-8762-d2b086576808",
                                        "entry_id": "079640e7-28fe-3132-818a-354458144b6d",
                                        "glosses": [
                                            "Werkzeugmaschine, bei der ein rotierendes Werkstück durch Spanen mittels eines scharfen Werkzeugs bearbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403b935a-0697-4b90-baca-97f928bfb367",
                                                "sense_id": "5a72ab82-213b-36cb-8762-d2b086576808",
                                                "text": "Der Zerspanungsmechaniker dreht an der Drehmaschine ein rundes Passstück."
                                            },
                                            {
                                                "example_id": "978d0aea-5881-4109-a248-46a80da01130",
                                                "sense_id": "5a72ab82-213b-36cb-8762-d2b086576808",
                                                "text": "„Die Drehmaschine bei der Berufsinformationsmesse hat mich viel mehr fasziniert als nur in die Schule zu gehen.“"
                                            },
                                            {
                                                "example_id": "5145a529-ef5f-4ba0-9b44-62ddb6147953",
                                                "sense_id": "5a72ab82-213b-36cb-8762-d2b086576808",
                                                "text": "„Eine Werkbank, eine Fräs- und eine Drehmaschine stehen im Raum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
