                    }
                ],
                "senses": [
                    {
                        "sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                        "entry_id": "2564ea85-231b-37b6-a3cc-51edcac5cc62",
                        "glosses": [
                            "Papio, een aap van het geslacht Papio (bavianen) binnen de familie Cercopithecidae met een korte staart en een vooruitstekende snuit"
                        ],
                        "tags": [
                            "primaten"
                        ],
                        "examples": [
                            {
                                "example_id": "9c9974a2-c453-49a4-9108-b395c36bba2e",
                                "sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                                "text": "In de dierentuin waren verschillende soorten bavianen te bezichtigen."
                            },
                            {
                                "example_id": "7cbb9c50-23fe-4ea9-9ed5-4d9e371b4c6a",
                                "sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                                "text": "De aandelenmarkt was natuurlijk de andere. Twee jaar geleden steeg de aandelenindex met 57 procent, vorig jaar met 65 procent en de prognose voor dit jaar lag tussen de 82 en 85 procent. Zelfs een baviaan die pijltjes gooide naar de aandelenlijst kon niet mislukken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebfd1e5e-d5ef-4483-9abd-b0d2980b61bb",
                        "source_entry_id": "2564ea85-231b-37b6-a3cc-51edcac5cc62",
                        "source_sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                        "source_sense_description": "een aap met een korte staart en een vooruitstekende snuit",
                        "target_lang_word": "Pavian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pavian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                        "entry_id": "a5cd66cc-a636-36cc-948f-6f6a9e712ed3",
                                        "glosses": [
                                            "eine Primatengattung aus der Familie der Meerkatzenverwandten"
                                        ],
                                        "tags": [
                                            "Papio"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ffd0bf-e661-4a10-8340-682e05d2f396",
                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "Im alten Ägypten galten Paviane als heilige Tiere."
                                            },
                                            {
                                                "example_id": "4c656f25-d3a7-4d94-90ac-30754be09a4e",
                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "„Eigentlich interessiere ich mich nicht für Tiere, aber eine Kollegin aus der Bürogemeinschaft muss einmal gehört haben, wie ich sagte, dass ich Paviane lustig finde.“"
                                            },
                                            {
                                                "example_id": "8232a177-b438-4471-b23b-bdcfc6180516",
                                                "sense_id": "28e21871-f3a2-39b8-98b5-6979cc28273a",
                                                "text": "„Orang-Utans seien auch nicht so wild wie Paviane, nicht so dumm wie Meerkatzen, nicht so schmutzig wie Springaffen, nicht so ungeduldig und triebhaft wie Hundsaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76b3f6e7-1ffa-46f7-9634-a3b6093195db",
                        "source_entry_id": "2564ea85-231b-37b6-a3cc-51edcac5cc62",
                        "source_sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                        "source_sense_description": "een aap met een korte staart en een vooruitstekende snuit",
                        "target_lang_word": "baboon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baboon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                        "entry_id": "41d19c0b-7f64-3557-bf9a-1d39fb06c4de",
                                        "glosses": [
                                            "An Old World monkey of the genus Papio, having dog-like muzzles and large canine teeth, cheek pouches, a short tail, and naked callosities on the buttocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fe9cc6-8c4e-4da0-a215-956d0b67a4fa",
                                                "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                                "text": "Mix swallowed the comment he wanted to make, that the council hall stank like a congress of baboons. But he was in no position to insult his host, nor should he. The man was only expressing the attitude of his time."
                                            },
                                            {
                                                "example_id": "9a4aa934-81c7-4b8b-93d9-98418b922da1",
                                                "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1959102-6fe3-3062-8975-7dbbbaebb073",
                                        "entry_id": "41d19c0b-7f64-3557-bf9a-1d39fb06c4de",
                                        "glosses": [
                                            "A foolish or boorish person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dcfccb9-d379-49ab-b29f-103e71c3f369",
                        "source_entry_id": "2564ea85-231b-37b6-a3cc-51edcac5cc62",
                        "source_sense_id": "06f3c468-79d9-3fa0-8ee9-2319cc5cf305",
                        "source_sense_description": "een aap met een korte staart en een vooruitstekende snuit",
                        "target_lang_word": "babouin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babouin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3a3ac8-c096-37c4-8f9e-3afc07265092",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Espèce de singe de la sous-famille des cercopithécinés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27340a97-89aa-45c6-80fd-510e38b9957e",
                                                "sense_id": "1e3a3ac8-c096-37c4-8f9e-3afc07265092",
                                                "text": "Bien que tous les babouins puissent parfois se tenir debout, leur mode normal de progression est à quatre pattes, ce qui est d’ailleurs beaucoup plus naturel pour des créatures ayant abandonné la vie en forêt pour la vie en plaine ^([2])."
                                            },
                                            {
                                                "example_id": "3f64613b-c181-4d76-94ac-4be169c7dc4e",
                                                "sense_id": "1e3a3ac8-c096-37c4-8f9e-3afc07265092",
                                                "text": "De même, dans un documentaire saisissant, on voit un léopard poursuivre et tuer une mère babouin."
                                            },
                                            {
                                                "example_id": "dd871601-ea25-460c-afb7-2a4f3c4ab608",
                                                "sense_id": "1e3a3ac8-c096-37c4-8f9e-3afc07265092",
                                                "text": "Ces babouins, qui forment de véritables troupes, ont des mœurs des plus étonnantes : ils adoptent par exemple des chiens qui leur servent de chiens de garde !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13cbc7ce-28b2-3447-ab2a-504fca5ff9d6",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Vieillard laid et ridicule."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee796bd-db8c-401a-a21a-346913e4504a",
                                                "sense_id": "13cbc7ce-28b2-3447-ab2a-504fca5ff9d6",
                                                "text": "C’est un vieux babouin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336a646a-04a3-35ab-85bd-63539098912a",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Figure grotesque des corps-de-garde, que l'on faisait baiser aux soldats par punition ^([3])."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0d79d01-4a58-3884-ae91-4e6ef17f92ae",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Petit bouton qui vient aux lèvres après avoir bu dans un verre malpropre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ba147f-8199-4660-a568-3068ec447c5b",
                                                "sense_id": "c0d79d01-4a58-3884-ae91-4e6ef17f92ae",
                                                "text": "Sa gueule est juteuse, elle est pleine de babouins"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70534435-ea86-32c3-b707-d5d4a22d086d",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Enfant étourdi et mal élevé."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e6a940-5426-4617-a2dc-7c1b20bff08b",
                                                "sense_id": "70534435-ea86-32c3-b707-d5d4a22d086d",
                                                "text": "C’est un petit babouin."
                                            },
                                            {
                                                "example_id": "0fd02ac7-e3c4-4191-ae65-ce4171371760",
                                                "sense_id": "70534435-ea86-32c3-b707-d5d4a22d086d",
                                                "text": "Faites taire ces petites babouines."
                                            },
                                            {
                                                "example_id": "9bdb7523-fedf-4932-92d3-f2836a4ac589",
                                                "sense_id": "70534435-ea86-32c3-b707-d5d4a22d086d",
                                                "text": "Allons donc, petit babouin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15be2b1f-3245-3325-bf08-e13adb3fbbb9",
                                        "entry_id": "042d9f3a-0e06-3bdf-ba77-c51f0ea796cd",
                                        "glosses": [
                                            "Lèvres, bouche ^([3])."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
