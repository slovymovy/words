{
    "word_family": [
        "struikgewas",
        "struikrover",
        "struikheide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9aeef27a-38a9-3668-b737-5fb26880e57e",
                    "sense_definition": "Meervoud van <w>struik</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen verstopten zich tijdens het spel diep in de <w>struiken</w>.",
                            "target_lang_translations": {
                                "en": "The children hid deep in the <w>bushes</w> during the game.",
                                "ru": "Во время игры дети спрятались глубоко в <w>кустах</w>.",
                                "pl": "Podczas zabawy dzieci schowały się głęboko w <w>krzakach</w>."
                            }
                        },
                        {
                            "text": "Langs het wandelpad groeien verschillende soorten <w>struiken</w> en bomen.",
                            "target_lang_translations": {
                                "en": "Various types of <w>shrubs</w> and trees grow along the hiking path.",
                                "ru": "Вдоль тропинки растут различные виды <w>кустарников</w> и деревьев.",
                                "pl": "Wzdłuż ścieżki spacerowej rosną różne rodzaje <w>krzewów</w> i drzew."
                            }
                        }
                    ],
                    "synonyms": [
                        "heesters",
                        "bosjes"
                    ],
                    "common_phrases": [
                        "in de struiken",
                        "tussen de struiken",
                        "snoeien van struiken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'struik' (bush).",
                        "ru": "Множественное число от слова \"struik\" (куст).",
                        "pl": "Liczba mnoga od słowa 'struik' (krzew)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bushes",
                                "target_lang_sense_clarification": "woody plants smaller than trees"
                            },
                            {
                                "target_lang_word": "shrubs",
                                "target_lang_sense_clarification": "horticultural term for bushes"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кусты",
                                "target_lang_sense_clarification": "общий термин для древесных растений меньше деревьев"
                            },
                            {
                                "target_lang_word": "кустарники",
                                "target_lang_sense_clarification": "ботанический термин или собирательное значение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "krzewy",
                                "target_lang_sense_clarification": "ogólny termin dla roślin zdrewniałych mniejszych od drzew"
                            },
                            {
                                "target_lang_word": "krzaki",
                                "target_lang_sense_clarification": "potoczne określenie roślin krzewiastych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9fa1f3b-0525-3050-951c-f63c9faa0b7d",
                    "sense_definition": "Zich ontwikkelen tot een struik; dicht bij de grond vertakken en breed uitgroeien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het warme weer begon het gewas al vroeg in het seizoen te <w>struiken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the warm weather, the crop began to <w>bush out</w> early in the season.",
                                "ru": "Из-за теплой погоды посевы начали <w>куститься</w> уже в начале сезона.",
                                "pl": "Dzięki ciepłej pogodzie uprawy zaczęły <w>krzewić się</w> już wcześnie w sezonie."
                            }
                        },
                        {
                            "text": "Je moet deze plant toppen zodat hij mooi gaat <w>struiken</w>.",
                            "target_lang_translations": {
                                "en": "You need to top this plant so it will <w>branch out</w> nicely.",
                                "ru": "Нужно прищипнуть это растение, чтобы оно начало красиво <w>куститься</w>.",
                                "pl": "Musisz przyciąć tę roślinę, aby ładnie się <w>krzewiła</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop into a bush; to branch out close to the ground and grow wide.",
                        "ru": "Развиваться в куст; ветвиться у земли и разрастаться вширь.",
                        "pl": "Rozwijać się w krzew; rozgałęziać się blisko ziemi i rozrastać na szerokość."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to bush out",
                                "target_lang_sense_clarification": "to grow thick and bushy"
                            },
                            {
                                "target_lang_word": "to branch out",
                                "target_lang_sense_clarification": "to spread branches low to the ground"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "куститься",
                                "target_lang_sense_clarification": "образовывать боковые побеги у основания (о растениях)"
                            },
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "становиться густым и широким"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "krzewić się",
                                "target_lang_sense_clarification": "wypuszczać pędy boczne u podstawy rośliny"
                            },
                            {
                                "target_lang_word": "rozrastać się",
                                "target_lang_sense_clarification": "stawać się gęstym i szerokim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7949817-8190-3e26-879d-b2c144492e9e",
                    "sense_definition": "Struikelen of zijn evenwicht verliezen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geen mens is zo wijs, of hij <w>struikt</w> wel eens op het gladde ijs.",
                            "target_lang_translations": {
                                "en": "No man is so wise that he doesn't <w>stumble</w> on slippery ice sometimes.",
                                "ru": "Нет такого мудреца, который никогда не <w>споткнулся</w> бы на скользком льду.",
                                "pl": "Nie ma tak mądrego człowieka, który by czasem nie <w>potknął się</w> na śliskim lodzie."
                            }
                        },
                        {
                            "text": "De oude man <w>struikte</w> over een uitstekende boomwortel.",
                            "target_lang_translations": {
                                "en": "The old man <w>tripped</w> over a protruding tree root.",
                                "ru": "Старик <w>споткнулся</w> о выступающий корень дерева.",
                                "pl": "Starszy mężczyzna <w>potknął się</w> o wystający korzeń drzewa."
                            }
                        }
                    ],
                    "synonyms": [
                        "struikelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stumble or lose one's balance.",
                        "ru": "Спотыкаться или терять равновесие.",
                        "pl": "Potknąć się lub stracić równowagę (użycie przestarzałe lub dialektalne)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stumble",
                                "target_lang_sense_clarification": "archaic or dialectal usage"
                            },
                            {
                                "target_lang_word": "to trip",
                                "target_lang_sense_clarification": "archaic or dialectal usage"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спотыкаться",
                                "target_lang_sense_clarification": "устаревшее или диалектное употребление"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "potykać się",
                                "target_lang_sense_clarification": "użycie przestarzałe lub gwarowe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}