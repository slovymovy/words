                        "glosses": [
                            "Kraftwerk, mit dem aus der Bewegungsenergie der natürlichen Meeresströmung Elektrizität erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a013fef4-c86f-43ff-ba5e-cff1b9ea3346",
                                "sense_id": "1c995b49-e8f5-3e6d-9cd3-59ec52dc5965",
                                "text": "„Vor der Küste Großbritanniens entstand das erste Meeresströmungskraftwerk der Welt.“"
                            },
                            {
                                "example_id": "cddf3326-3ac0-43f8-bdbb-a2d4ae1fef50",
                                "sense_id": "1c995b49-e8f5-3e6d-9cd3-59ec52dc5965",
                                "text": "„Meeresströmungen sind verlässliche Energielieferanten. Deshalb rechnen Experten mit zweistelligen Zuwachsraten für Meeresströmungskraftwerke bis 2020. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
