                            {
                                "example_id": "e0fd1856-f5f8-41f7-aab6-c810e5be783f",
                                "sense_id": "54c77f29-3a11-378c-96d3-e931c49d3886",
                                "text": "Ik stapte naar binnen bij de meest exclusieve herenmodezaak die ik kon vinden, en koos een zwart pak van Armani."
                            },
                            {
                                "example_id": "6bad6d9e-1995-4c3f-8cf1-c2dc415aa5ee",
                                "sense_id": "54c77f29-3a11-378c-96d3-e931c49d3886",
                                "text": "\"Ze gaan mijn pand slopen.\" Ronald Nordemann zegt het op de dag dat zijn winkel en woning zijn uitgebrand. Dit jaar moest een kroonjaar worden voor zijn bedrijf. Herenmodezaak Spaander aan de Langestraat in Alkmaar bestaat in maart een eeuw."
                            }
