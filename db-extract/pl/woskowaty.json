                ],
                "senses": [
                    {
                        "sense_id": "2a174d49-a146-3929-a0f1-76642b47ad21",
                        "entry_id": "5192a2f8-9866-3277-bfb9-773a21703352",
                        "glosses": [
                            "waxy, waxlike, coated with wax"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f53d970-a5ad-427f-93e8-4001d1423003",
                                "sense_id": "2a174d49-a146-3929-a0f1-76642b47ad21",
                                "text": "Owocnik zwykle duży i dość gruby, woskowaty [...]",
                                "translation": "The fruiting body [is] usually large and rather thick, waxy …",
                                "english": "The fruiting body [is] usually large and rather thick, waxy …"
                            },
                            {
                                "example_id": "e010c495-b179-496b-9a64-63e83b1d979f",
                                "sense_id": "2a174d49-a146-3929-a0f1-76642b47ad21",
                                "text": "Wkrótce znaleźli czwartego węża, mokasyna ‒ był woskowaty, żółty jak wątroba, nie dłuższy niż miedzianki, ale grubszy niż ręka Harriet.",
                                "translation": "Soon they found a fourth snake, a moccasin ‒ it was waxy, liver-yellow, no longer than a smooth snake, but thicker than Harriet's hand.",
                                "english": "Soon they found a fourth snake, a moccasin ‒ it was waxy, liver-yellow, no longer than a smooth snake, but thicker than Harriet's hand."
                            },
                            {
                                "example_id": "572b7190-eec9-4c7e-8489-ed1dc72e5a0a",
                                "sense_id": "2a174d49-a146-3929-a0f1-76642b47ad21",
                                "text": "Później zobaczyła matkę dopiero w szpitalu. Ale wtedy jej policzek był zimny. Woskowaty, jak u lalki.",
                                "translation": "Later she only saw her mother in the hospital. But then her cheek was cold. Waxy, like on a doll.",
                                "english": "Later she only saw her mother in the hospital. But then her cheek was cold. Waxy, like on a doll."
                            }
                        ]
                    }
