                    },
                    {
                        "translation_id": "9132608e-1278-4660-969e-f70d8463356f",
                        "source_entry_id": "325bc1ae-c3e7-35a2-8094-c95b7c900c15",
                        "source_sense_id": "77d1123b-6083-3005-8270-f898584051c7",
