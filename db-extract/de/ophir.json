                                "target_senses": [
                                    {
                                        "sense_id": "c2ac7c4e-b826-38eb-8d65-b1b82e346409",
                                        "entry_id": "8b11552b-b221-3d62-b306-f32f0c8996ec",
                                        "glosses": [
                                            "A city or region mentioned in the Bible, famous for its gold."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a51ddf-efa6-4965-a4ae-57aad8e71fa0",
                                                "sense_id": "c2ac7c4e-b826-38eb-8d65-b1b82e346409",
                                                "text": "However, September came, and with it my second brother; and his companion for the shooting season was the young, handsome, and lively Henry O'Byrne, descended from kings whose crown was old enough to have been made of the gold of Ophir."
                                            },
                                            {
                                                "example_id": "f2ecf5af-128c-4d8f-8e24-7511b59842bd",
                                                "sense_id": "c2ac7c4e-b826-38eb-8d65-b1b82e346409",
                                                "text": "Rosetime, rosetime, rosetime in gardens,\nPink cascades of beauty flowing down the wall,\nRed drops of heart's blood spilt among the grasses,\nFabled Gold of Ophir raining over all."
                                            }
                                        ]
                                    },
