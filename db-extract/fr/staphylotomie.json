                "senses": [
                    {
                        "sense_id": "a7d278a9-0f22-3449-ac72-13b1da98f304",
                        "entry_id": "bc594f12-9491-3f9e-9a5c-0f551d5b28b4",
                        "glosses": [
                            "Ablation de la luette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd84afc6-5ed4-4a80-9187-cb720abc5bf1",
                                "sense_id": "a7d278a9-0f22-3449-ac72-13b1da98f304",
                                "text": "La staphylotomie libératrice doit séparer les muscles glosso et pharyngostaphylins dans le sens des fibres musculaires et dégager entièrement le pôle supérieur, « qui vient montrer sa tête ». C’est là un point capital de l’opération."
                            }
                        ]
                    },
                    {
                        "sense_id": "2878d4e8-2eda-3382-8a89-310ca7b8b5e7",
                        "entry_id": "bc594f12-9491-3f9e-9a5c-0f551d5b28b4",
                        "glosses": [
                            "Incision du staphylome opaque cornéen ou irido-cornéen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd345b8f-0073-4083-8ba8-4d5e96c67bfc",
                                "sense_id": "2878d4e8-2eda-3382-8a89-310ca7b8b5e7",
                                "text": "Nous insistons donc sur la nécessité qu’il y a de pratiquer la staphylotomie, de telle manière que la prothèse oculaire soit rendue possible."
                            }
                        ]
                    }
                ],
