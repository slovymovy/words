    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                    "sense_definition": "To make weaker or less strong.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction_of_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal did <w>weaken</w> his authority significantly.",
                            "target_lang_translations": {
                                "ru": "Скандал действительно значительно <w>ослабил</w> его авторитет.",
                                "zh": "这起丑闻确实显著地<w>削弱</w>了他的权威。",
                                "es": "El escándalo <w>debilitó</w> significativamente su autoridad."
                            }
                        },
                        {
                            "text": "Lack of exercise can <w>weaken</w> your muscles over time.",
                            "target_lang_translations": {
                                "ru": "Недостаток физических упражнений может со временем <w>ослабить</w> ваши мышцы.",
                                "zh": "长期缺乏锻炼会<w>削弱</w>你的肌肉力量。",
                                "es": "La falta de ejercicio puede <w>debilitar</w> tus músculos con el tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "attenuate",
                        "dilute",
                        "blunt",
                        "undermine",
                        "diminish"
                    ],
                    "common_phrases": [
                        "weaken the economy",
                        "weaken the immune system",
                        "weaken resolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать слабее или менее сильным.",
                        "zh": "使某事物变得更弱或力量减小。",
                        "es": "Hacer que algo o alguien sea menos fuerte o pierda vigor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "делать менее сильным (несов. вид)"
                            },
                            {
                                "target_lang_word": "ослабить",
                                "target_lang_sense_clarification": "сделать менее сильным (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "削弱",
                                "target_lang_sense_clarification": "指使力量、势力或影响减弱"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指使程度或强度降低"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "debilitar",
                                "target_lang_sense_clarification": "hacer más débil o reducir la fuerza de algo"
                            },
                            {
                                "target_lang_word": "atenuar",
                                "target_lang_sense_clarification": "hacer menos intenso o fuerte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                    "sense_definition": "To become weaker or less strong.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction_of_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm is expected to <w>weaken</w> overnight.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что шторм <w>ослабнет</w> за ночь.",
                                "zh": "预计这场风暴会在夜间<w>减弱</w>。",
                                "es": "Se espera que la tormenta se <w>debilite</w> durante la noche."
                            }
                        },
                        {
                            "text": "His pulse began to <w>weaken</w> rapidly after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии его пульс начал быстро <w>слабеть</w>.",
                                "zh": "事故发生后，他的脉搏开始迅速<w>变弱</w>。",
                                "es": "Su pulso comenzó a <w>debilitarse</w> rápidamente después del accidente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weaken over time",
                        "weaken significantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться слабее или терять силу.",
                        "zh": "变得更弱或失去力量。",
                        "es": "Volverse menos fuerte o perder energía y vigor."
                    },
                    "translations": {
                        "ru": [
                            {
