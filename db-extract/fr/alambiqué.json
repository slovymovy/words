                                                "sense_id": "c6604b7d-f3fe-3b1e-8e19-cf094d9c50ec",
                                                "text": "Hij viel over een krukje in die duistere gang."
                                            },
                                            {
                                                "example_id": "82dd82eb-af32-4536-a2c3-87ecbe6dbb16",
                                                "sense_id": "c6604b7d-f3fe-3b1e-8e19-cf094d9c50ec",
                                                "text": "‘Dit is het,’ fluisterde ik opgewonden in het duister."
                                            }
