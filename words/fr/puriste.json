    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73714ec2-07d2-3d7a-ba43-472b1e396cbc",
                    "sense_definition": "Personne qui respecte rigoureusement la tradition, les règles ou les principes originels d'une discipline ou d'un art.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef cuisinier est un <w>puriste</w> qui refuse de modifier les recettes traditionnelles italiennes."
                        },
                        {
                            "text": "Pour les <w>puristes</w> de la musique rock, rien ne remplace le son authentique d'un disque vinyle."
                        }
                    ],
                    "synonyms": [
                        "traditionaliste",
                        "rigoriste"
                    ],
                    "antonyms": [
                        "laxiste"
                    ],
                    "common_phrases": [
                        "réservé aux puristes"
                    ]
                },
                {
                    "sense_id": "918dd3e7-15cd-3441-9da4-bd45009f676e",
                    "sense_definition": "Personne qui veille scrupuleusement au respect absolu des règles de la langue et du style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur est un <w>puriste</w> qui ne tolère aucun anglicisme dans les copies de ses étudiants."
                        },
                        {
                            "text": "Certains <w>puristes</w> refusent d'adopter les nouvelles simplifications orthographiques recommandées par les linguistes contemporains."
                        }
                    ],
                    "common_phrases": [
                        "un puriste de la langue"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb755790-4b83-30b1-8f5c-5084cc077556",
                    "sense_definition": "Qui a un souci très strict de la correction du langage ou du style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur adopte une attitude <w>puriste</w> et choisit chaque mot avec une immense précision."
                        },
                        {
                            "text": "Sa vision <w>puriste</w> de la grammaire le pousse à corriger systématiquement les fautes de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "scrupuleux",
                        "rigoriste"
                    ],
                    "antonyms": [
                        "relâché"
                    ],
                    "common_phrases": [
                        "une approche puriste",
                        "un esprit puriste"
                    ]
                },
                {
                    "sense_id": "dbe96d10-9527-36b6-a3d9-390f8edf8072",
                    "sense_definition": "Qui manifeste un attachement rigoureux aux principes originels ou à la pureté esthétique et morale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce peintre contemporain défend une démarche artistique résolument <w>puriste</w> qui refuse tout artifice commercial."
                        },
                        {
                            "text": "Les critiques ont vivement salué l'interprétation <w>puriste</w> de cet orchestre jouant sur des instruments anciens."
                        }
                    ],
                    "synonyms": [
                        "orthodoxe"
                    ],
                    "antonyms": [
                        "éclectique"
                    ],
                    "common_phrases": [
                        "une démarche puriste"
                    ]
                }
            ]
        }
    ]
