        "de-extract.jsonl": [
            {
                "entry_id": "24d1b1ed-94c0-30ed-9d85-56e566893a92",
                "word": "Brazil",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ddf974b1-d45a-329c-99fb-12ce52bb51fd",
                        "entry_id": "24d1b1ed-94c0-30ed-9d85-56e566893a92",
                        "glosses": [
                            "Brasilien"
                        ],
                        "tags": [],
