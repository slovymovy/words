                        "entry_id": "ce626d76-21bf-3c9a-9745-45a8f749c562",
                        "glosses": [
                            "A writer of annals; a chronicler; a historian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff982a31-bb9d-45ac-be1a-fbb1c76a7ac8",
                                "sense_id": "8d72ec04-fd72-389e-b8d3-3a67706e37b4",
                                "text": "The monks […] were the only annalists during those ages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef94a301-91f2-4977-b22e-e8a8f69590c1",
                        "source_entry_id": "ce626d76-21bf-3c9a-9745-45a8f749c562",
