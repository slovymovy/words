                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "person with dementia",
                                "target_lang_sense_clarification": "a person suffering from cognitive decline"
                            },
                            {
                                "target_lang_word": "mentally disabled person",
                                "target_lang_sense_clarification": "a person with an intellectual disability"
                            }
                        ]
                    }
                }
            ]
        }
    ]
