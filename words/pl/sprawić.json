{
    "word_family": [
        "sprawca",
        "sprawczyni",
        "sprawczy",
        "sprawiedliwy",
        "sprawiedliwość"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33a70782-6481-3361-bd9e-59807f31019c",
                    "sense_definition": "powodować, że coś się dzieje lub zaistnieje",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr <w>sprawił</w>, że drzewo przewróciło się na drogę.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>вызвал</w> падение дерева на дорогу.",
                                "en": "The strong wind <w>caused</w> the tree to fall onto the road."
                            }
                        },
                        {
                            "text": "Jej obecność <w>sprawiła</w>, że wszyscy poczuli się lepiej.",
                            "target_lang_translations": {
                                "ru": "Её присутствие <w>сделало</w> так, что все почувствовали себя лучше.",
                                "en": "Her presence <w>made</w> everyone feel better."
                            }
                        }
                    ],
                    "synonyms": [
                        "spowodować"
                    ],
                    "common_phrases": [
                        "sprawić że"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать появление чего-либо или приводить к какому-либо результату",
                        "en": "to cause something to happen or exist"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "привести к какому-либо событию или состоянию"
                            },
                            {
                                "target_lang_word": "сделать так, чтобы",
                                "target_lang_sense_clarification": "конструкция для описания причины действия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to cause something to happen or become"
                            },
                            {
                                "target_lang_word": "cause",
                                "target_lang_sense_clarification": "to make something occur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9edab3-4d95-3268-bacc-b5b09ab5b4bb",
                    "sense_definition": "wywoływać u kogoś określone odczucia lub stan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten prezent <w>sprawił</w> jej ogromną radość.",
                            "target_lang_translations": {
                                "ru": "Этот подарок <w>доставил</w> ей огромную радость.",
                                "en": "This gift <w>brought</w> her tremendous joy."
                            }
                        },
                        {
                            "text": "Jego słowa <w>sprawiły</w> mi wielki ból.",
                            "target_lang_translations": {
                                "ru": "Его слова <w>причинили</w> мне большую боль.",
                                "en": "His words <w>caused</w> me great pain."
                            }
                        }
                    ],
                    "synonyms": [
                        "wywołać"
                    ],
                    "common_phrases": [
                        "sprawić radość",
                        "sprawić kłopot",
                        "sprawić przyjemność",
                        "sprawić przykrość"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать у кого-либо определенные чувства или состояние",
                        "en": "to evoke a particular feeling, emotion, or state in someone"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставить",
                                "target_lang_sense_clarification": "о чувствах, например, доставить радость"
                            },
                            {
                                "target_lang_word": "причинить",
                                "target_lang_sense_clarification": "о негативных чувствах, например, причинить боль"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "as in give pleasure, joy, or trouble"
                            },
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "as in bring joy or happiness"
                            },
                            {
                                "target_lang_word": "cause",
                                "target_lang_sense_clarification": "as in cause pain or trouble"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18fd0002-edf6-342f-9ab2-52bd68eda95d",
                    "sense_definition": "kupić coś dla siebie lub kogoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakupy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę w końcu <w>sprawić</w> sobie nowy telefon.",
                            "target_lang_translations": {
                                "ru": "Мне нужно наконец <w>купить</w> себе новый телефон.",
                                "en": "I finally need to <w>get</w> myself a new phone."
                            }
                        },
                        {
                            "text": "Rodzice chcieli <w>sprawić</w> dziecku wymarzony rower na urodziny.",
                            "target_lang_translations": {
                                "ru": "Родители хотели <w>купить</w> ребенку велосипед, о котором он мечтал, на день рождения.",
                                "en": "The parents wanted to <w>buy</w> their child the dream bicycle for their birthday."
                            }
                        }
                    ],
                    "synonyms": [
                        "kupić"
                    ],
                    "common_phrases": [
                        "sprawić sobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "приобрести что-либо для себя или для кого-то другого",
                        "en": "to buy or get something for oneself or someone else"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купить",
                                "target_lang_sense_clarification": "приобрести за деньги"
                            },
                            {
                                "target_lang_word": "приобрести",
                                "target_lang_sense_clarification": "более формальный вариант покупки"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "treat oneself to",
                                "target_lang_sense_clarification": "when buying something nice for oneself (sprawić sobie)"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to purchase or obtain for oneself or someone"
                            },
                            {
                                "target_lang_word": "buy",
                                "target_lang_sense_clarification": "to purchase"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253e7d2e-f443-3e69-9fbb-64daaf2b5b10",
                    "sense_definition": "poradzić sobie w trudnej sytuacji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zarządzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo wielu przeszkód nowy kierownik całkiem dobrze się <w>sprawił</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на многочисленные препятствия, новый руководитель весьма неплохо <w>справился</w>.",
                                "en": "Despite many obstacles, the new manager <w>did</w> quite <w>well</w>."
                            }
                        },
                        {
                            "text": "Nie wiedziałem, czy <w>sprawię</w> się z tym zadaniem na czas.",
                            "target_lang_translations": {
                                "ru": "Я не знал, <w>справлюсь</w> ли я с этим заданием вовремя.",
                                "en": "I didn't know if I would <w>manage</w> this task on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "poradzić sobie",
                        "spisać się"
                    ],
                    "common_phrases": [
                        "dobrze się sprawić"
                    ],
                    "target_lang_definitions": {
                        "ru": "справиться с трудной ситуацией или задачей",
                        "en": "to do well, cope, or handle a difficult situation (sprawić się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "успешно выполнить задачу"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "do well",
                                "target_lang_sense_clarification": "to perform or manage adequately"
                            },
                            {
                                "target_lang_word": "cope",
                                "target_lang_sense_clarification": "to manage in a challenging situation"
                            },
                            {
                                "target_lang_word": "prove oneself",
                                "target_lang_sense_clarification": "to demonstrate capability"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d0854fd-faf2-355a-b4b3-423b78299bad",
                    "sense_definition": "aspekt dokonany od <w>sprawiać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy możesz <w>sprawić</w>, aby twój kolega poszedł do domu?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>сделать</w> так, чтобы твой коллега пошел домой?",
                                "en": "Can you <w>make</w> your friend go home?"
                            }
                        },
                        {
                            "text": "Boże, <w>spraw</w>, żeby tak było.",
                            "target_lang_translations": {
                                "ru": "Боже, <w>сделай</w> так, чтобы это было правдой.",
                                "en": "God <w>grant</w> that it be so."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола sprawiać",
                        "en": "perfective aspect of sprawiać; to arrange or see to it that something happens"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "в значении побуждения к действию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to arrange or cause something to happen"
                            },
                            {
                                "target_lang_word": "see to it that",
                                "target_lang_sense_clarification": "to ensure an outcome"
                            },
                            {
                                "target_lang_word": "grant",
                                "target_lang_sense_clarification": "used in prayers/wishes (e.g. God grant)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}