                        "glosses": [
                            "To burn more brightly than; outshine."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cda8cdc8-1cb1-48b5-b47d-e82631764d9f",
                                "sense_id": "169f5803-5b11-3562-9e44-b4a9dc9b667a",
                                "text": "The banners outflame the blazing morn, / O'er billows of bayonet, sword, and spear."
                            },
                            {
                                "example_id": "c0ff713a-0a0d-4d1f-b4e1-fb03cfe900be",
                                "sense_id": "169f5803-5b11-3562-9e44-b4a9dc9b667a",
                                "text": "It shall outflame the dying flare / Of all worlds, and survive the final glare."
                            }
                        ]
                    }
