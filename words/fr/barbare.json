                    "frequency": "Middle",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les invasions <w>barbares</w> ont profondément transformé les structures politiques de l'Europe occidentale."
                        },
                        {
                            "text": "L'Empire romain tentait d'assimiler les tribus <w>barbares</w> établies le long de ses frontières."
                        }
                    ],
                    "common_phrases": [
                        "les invasions barbares",
