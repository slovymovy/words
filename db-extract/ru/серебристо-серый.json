                ],
                "senses": [
                    {
                        "sense_id": "285727c8-1b6b-3753-8c95-8b61a69e667b",
                        "entry_id": "e6ab4cb7-765b-34c3-859b-505a0d2efe46",
                        "glosses": [
                            "silver-grey"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b69531-5160-436f-828f-5fbb28e3d854",
                                "sense_id": "285727c8-1b6b-3753-8c95-8b61a69e667b",
                                "text": "Он ло́вко управля́л конём, и конь, серебрѝсто-се́рой ма́сти, то взвива́лся на дыбы́, то шёл, красу́ясь, ро́вным ша́гом и ржал навстре́чу неприя́телю.",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            },
                            {
                                "example_id": "b88bd8a7-cb85-4336-8b3e-4277d2071249",
                                "sense_id": "285727c8-1b6b-3753-8c95-8b61a69e667b",
                                "text": "К ваго́ну подходи́ла краса́вица де́вушка в грома́дной чёрной шля́пе и серебрѝсто-се́ром шёлковом пальто́, волочи́вшемся за ней шле́йфом."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
