                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4487d4f5-b521-40b4-9a12-842b948880bc",
                                "sense_id": "0cb90e06-8a9c-38c8-af99-6d1d73eac919",
                                "text": "чай вдвоём",
                                "translation": "tea for two",
                                "english": "tea for two"
                            },
                            {
                                "example_id": "31bd0213-6d3a-4213-bc8e-d2b0d82787e4",
                                "sense_id": "0cb90e06-8a9c-38c8-af99-6d1d73eac919",
                                "text": "Друзья, люблю я Ленинские горы,\nТам хорошо встречать рассвет вдвоём,\n[…]",
                                "translation": "Friends, I love the Lenin Hills,\nThere, tt's good to meet the dawn together,\n […]",
                                "english": "Friends, I love the Lenin Hills,\nThere, tt's good to meet the dawn together,\n […]"
                            }
                        ]
                    }
                ],
                "translations": [],
