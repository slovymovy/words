                    {
                        "translation_id": "42ae718b-4d43-4ec9-a1b6-402526e39de0",
                        "source_entry_id": "f162b4dd-cbba-3317-97cd-630fe2a02a55",
                        "source_sense_description": "female knight",
                        "target_lang_word": "Ritterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
