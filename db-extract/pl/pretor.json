                                        "entry_id": "3aa7bebe-7dbd-3b4c-b89f-44534c472738",
                                        "glosses": [
                                            "A high civic or administrative official, especially a chief magistrate or mayor. Sometimes used as a title."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
