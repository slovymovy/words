                                "target_senses": [
                                    {
                                        "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Lacking strength; weak; languid; inclined to lose consciousness"
                                        ],
                                        "tags": [
                                            "of a being"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0debfb51-4f43-4444-a049-48e4b78235f4",
                                                "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                                "text": "I felt faint after my fifth gin and tonic."
                                            },
                                            {
                                                "example_id": "cdfd5d34-f618-41e5-9181-abadbf6459d9",
                                                "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                                "text": "He almost fell faint due to the hot climate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53563a5f-1ea6-30f9-8941-52b28b8812e8",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Lacking courage, spirit, or energy; cowardly; dejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4716ada-7a4d-4045-a42e-237229c1ca3c",
                                                "sense_id": "53563a5f-1ea6-30f9-8941-52b28b8812e8",
                                                "text": "Faint heart ne'er won fair lady."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa33356b-7f8c-394d-81f5-68b7f65120e0",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Barely perceptible; not bright, or loud, or sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f5df67-ed17-4a0e-85a9-9ad65b89f6ff",
                                                "sense_id": "aa33356b-7f8c-394d-81f5-68b7f65120e0",
                                                "text": "There was a faint red light in the distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f47e17c-10bd-3ebf-a71d-a889052e7618",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Performed, done, or acted, weakly; not exhibiting vigor, strength, or energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032b6e7b-aaf6-4f9b-857a-8e2500be40f3",
                                                "sense_id": "7f47e17c-10bd-3ebf-a71d-a889052e7618",
                                                "text": "faint efforts"
                                            },
                                            {
                                                "example_id": "475dde11-27bc-47d6-b1fb-18d23ec750b4",
                                                "sense_id": "7f47e17c-10bd-3ebf-a71d-a889052e7618",
                                                "text": "faint resistance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae68c68-a222-3426-9c79-5a6d025b8ade",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Slight; minimal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e82801c9-a0ce-444d-aafe-f45e503b12bb",
                                                "sense_id": "1ae68c68-a222-3426-9c79-5a6d025b8ade",
                                                "text": "do you have the faintest understanding of what they mean?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a02c5a-0cf7-3a69-bde6-482521b729d9",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Sickly, so as to make a person feel faint."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d009f9c-9073-4d02-9330-6726313daf18",
                                                "sense_id": "29a02c5a-0cf7-3a69-bde6-482521b729d9",
                                                "text": "Happening to pass a fruiterer’s on their way; the door of which was open, though the shop was by this time shut; one of them remarked how faint the peaches smelled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "faint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c6a5a58-8b52-3b48-bd9b-44c9da04c36c",
                                        "entry_id": "8da9525c-e902-359a-9695-0d9d7010ef66",
                                        "glosses": [
                                            "The act of fainting, syncope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "013422cf-915d-4860-b340-9fef1433075d",
                                                "sense_id": "9c6a5a58-8b52-3b48-bd9b-44c9da04c36c",
                                                "text": "She suffered another faint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22c41a4-d44b-38ae-aaea-4cf76f57acf8",
                                        "entry_id": "8da9525c-e902-359a-9695-0d9d7010ef66",
                                        "glosses": [
                                            "The state of one who has fainted; a swoon."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "faint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "956c9ada-de8e-31e0-98ee-cb6a3d571195",
                                        "entry_id": "192de9eb-2dfb-3b0a-973f-138a8584ae7e",
                                        "glosses": [
                                            "To lose consciousness through a lack of oxygen or nutrients to the brain, usually as a result of suddenly reduced blood flow (may be caused by emotional trauma, loss of blood or various medical conditions)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb80774-22bd-414f-bc7b-d292e919addc",
                                                "sense_id": "956c9ada-de8e-31e0-98ee-cb6a3d571195",
                                                "text": "If I send them away fasting […] they will faint by the way."
                                            },
                                            {
                                                "example_id": "f8255845-27eb-4911-8318-43f3c8676513",
                                                "sense_id": "956c9ada-de8e-31e0-98ee-cb6a3d571195",
                                                "text": "But upon hearing the Honour which he intended her , she fainted away , and fell down as Dead at his Feet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639b7462-c641-3f52-96b6-b3fbad316408",
                                        "entry_id": "192de9eb-2dfb-3b0a-973f-138a8584ae7e",
                                        "glosses": [
                                            "To lose courage or spirit; to become depressed or despondent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d403e3-c3ad-481c-bfca-035cf771b293",
                                                "sense_id": "639b7462-c641-3f52-96b6-b3fbad316408",
                                                "text": "If thou faint in the day of adversity, thy strength is small."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46b001d-a6ad-38f9-baf9-de7735bbc0f9",
                                        "entry_id": "192de9eb-2dfb-3b0a-973f-138a8584ae7e",
                                        "glosses": [
                                            "To decay; to disappear; to vanish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9916b9-f9da-4711-b9c5-11301c21bc3e",
                                                "sense_id": "f46b001d-a6ad-38f9-baf9-de7735bbc0f9",
                                                "text": "November 12, 1711, Alexander Pope, letter to Henry Cromwell\nGilded clouds, while we gaze upon them, faint before the eye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
