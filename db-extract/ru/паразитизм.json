                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad88eb9-6863-488c-9c79-2e04bfc7b8f8",
                        "source_entry_id": "3c7788d4-e6eb-3b3c-9eef-cea4c8ab3b22",
                        "source_sense_id": "bcd9adc9-02be-3442-9bfb-54350361c142",
