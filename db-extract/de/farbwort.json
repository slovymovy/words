                ],
                "senses": [
                    {
                        "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                        "entry_id": "6460d552-ba98-3489-b01d-3654cb08a0f6",
                        "glosses": [
                            "Wort, das eine Farbe bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6ba715-078a-4549-8e13-842731827ab3",
                                "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                                "text": "„Die Ergebnisse, wie oft jedes Farbwort in jedem Zeitabschnitt genannt wurde, publizieren die Autoren in Form einer (unnötig umfangreichen) Liste.“"
                            },
                            {
                                "example_id": "af7867f4-474e-4573-a9a5-bde5d60ff827",
                                "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                                "text": "„Sprachlich betrachtet, bilden wir Farbwörter, indem wir für die einzelnen Farbbegriffe Eigenschaftswörter bilden, das sind im Deutschen und umliegenden Sprachen Adjektive.“"
                            },
                            {
                                "example_id": "5b935f10-8c70-4ee9-b0e5-60c19d682a4d",
                                "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                                "text": "„Es liegt auf der Hand, daß normalerweise nie das Bedürfnis besteht, diese riesige Fülle unterscheidbarer Farbtöne sprachlich mit Farbwörtern zu erfassen.“"
                            },
                            {
                                "example_id": "aca499dd-f36a-4c2b-a22c-7756089fd022",
                                "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                                "text": "„Aber auch dieses Farbwort kann abstrakt gebraucht werden, wie die Möglichkeit seiner Anwendung auf Blumen, Flüssigkeiten, Wolken, Papier und anderes erkennen läßt.“"
                            },
                            {
                                "example_id": "c34fcfe5-5409-4426-b003-fca2a97261ff",
                                "sense_id": "ce5d3973-09e1-31f6-813f-986e90d17226",
                                "text": "„Wenn ich nicht gelernt habe, daß »rot« in Opposition zu »grün« steht und daß »grün« seinen Platz zwischen »blau« und »gelb« hat, kann ich diese Farbwörter nicht richtig anwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
