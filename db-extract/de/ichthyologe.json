                        "glosses": [
                            "Wissenschaftler/Experte auf dem Gebiet der Fischkunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e705752-7a07-4204-8790-9f79e0c5cf86",
                                "sense_id": "ec3daa14-00c4-31c4-8024-2eed81f22435",
                                "text": "„Der Ichthyologe Pouchet, Freund von Gustave Flaubert, ist einer der ersten Franzosen, die in den dreißiger Jahren in Berlin studiert haben.“"
                            },
                            {
                                "example_id": "dd73dca3-8603-4a9e-b36e-18f4adf3ec92",
                                "sense_id": "ec3daa14-00c4-31c4-8024-2eed81f22435",
                                "text": "„Prosanta Chakrabarty ist Ichthyologe und Evolutionsbiologe an der Louisiana State University.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
