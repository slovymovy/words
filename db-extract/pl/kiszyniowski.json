                "senses": [
                    {
                        "sense_id": "a4af0419-d477-396b-8d35-3c7d7a586b7a",
                        "entry_id": "b7b097f2-c746-3d6b-91ca-bef52f2426e9",
                        "glosses": [
                            "odnoszący się do miasta Kiszyniów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f69fb7-b27b-45a4-8b36-8040970c679d",
                                "sense_id": "a4af0419-d477-396b-8d35-3c7d7a586b7a",
                                "text": "Wystarczy wspomnieć, że w czasie najcięższych walk w 1992 roku Mołdawianie zostawili w zupełnym spokoju kiszyniowskich Rosjan, którzy stanowią połowę ludności miasta"
                            },
                            {
                                "example_id": "b49fc3f2-5411-41f5-84d4-51865b0981c2",
                                "sense_id": "a4af0419-d477-396b-8d35-3c7d7a586b7a",
                                "text": "Kamień z Coşauţi jest szeroko znany i ceniony w Mołdawii - posłużył do wzniesienia fortecy w pobliskich Sorokach, cerkwi Trzech Hierarchów w Jassach czy kiszyniowskiego Łuku Triumfalnego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
