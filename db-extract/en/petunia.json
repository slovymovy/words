                    }
                ],
                "senses": [
                    {
                        "sense_id": "41516656-02b5-301c-8e87-31f0dd8485f5",
                        "entry_id": "16269437-e6b9-3729-8aab-b85db78feca6",
                        "glosses": [
                            "Any of the flowering plants of genus Petunia, of which most garden varieties are hybrids."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53d1bf1-6905-460f-91ed-5f429a2879b8",
                                "sense_id": "41516656-02b5-301c-8e87-31f0dd8485f5",
                                "text": "Usually petunias are quite pest free, but aphids are occasional problems."
                            },
                            {
                                "example_id": "84a6b2a1-7f93-4b3a-b549-69ab81433b65",
                                "sense_id": "41516656-02b5-301c-8e87-31f0dd8485f5",
                                "text": "The small purple petunias are produced in profusion and without ceasing during the entire season."
                            },
                            {
                                "example_id": "30511970-6155-4bc5-a4a7-49bb6a71b819",
                                "sense_id": "41516656-02b5-301c-8e87-31f0dd8485f5",
                                "text": "Closely related calibrachoas, often called miniature petunias, offer dainty petunia-like blossoms that are perfect for planting in pots.\nNo matter what type of petunias you choose, they all prefer plenty of sun."
                            }
                        ]
                    },
