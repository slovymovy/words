                                "de": "Ihre Karriere als Journalistin <w>begann</w> in einer kleinen Stadt.",
                                "fr": "Sa carrière de journaliste a <w>débuté</w> dans une petite ville.",
                                "it": "La sua carriera di giornalista è <w>iniziata</w> in una piccola città.",
                                "cs": "Její kariéra novinářky <w>začala</w> v malém městě.",
                                "tr": "Gazetecilik kariyeri küçük bir kasabada <w>başladı</w>.",
                                "es": "Su carrera como periodista <w>comenzó</w> en un pueblo pequeño."
                            }
