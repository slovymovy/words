                ],
                "senses": [
                    {
                        "sense_id": "c0a0e91c-f7c8-3f77-8c84-eba06838fce1",
                        "entry_id": "f63b68be-f54a-33da-abb3-d2179977e838",
                        "glosses": [
                            "Staatsangehöriger der Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1ca128-d00f-4c46-b925-a8f89b0aa6a9",
                                "sense_id": "c0a0e91c-f7c8-3f77-8c84-eba06838fce1",
                                "text": "„Eine große Mehrheit der Bundesbürger gibt indessen wenig auf die Zusage von Union und SPD, nicht an der Steuerschraube drehen zu wollen.“"
                            },
                            {
                                "example_id": "a7306f48-9d2a-4c0f-9257-cd6f0a5f7f44",
                                "sense_id": "c0a0e91c-f7c8-3f77-8c84-eba06838fce1",
                                "text": "„Fragt man beispielsweise einen Bundesbürger, wie viele Morde seiner Meinung nach pro Jahr in Deutschland verübt werden und ob die Mordrate zu- oder abnehmend sei, so liegt die Antwort meist bei weit über tausend Opfern, Tendenz steigend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
