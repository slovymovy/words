                                                "example_id": "378cb644-3cf6-4191-9213-86487f8946c7",
                                                "sense_id": "6a0fe3cc-3880-30dc-8740-6b6999b7c64d",
                                                "text": "„Die Tischtücher werden der Breite nach vierfach gefalten[.]“"
                                            }
                                        ],
