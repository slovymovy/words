                "senses": [
                    {
                        "sense_id": "3626d2a9-1419-33e5-898a-9bab23c54562",
                        "entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "glosses": [
                            "Consisting of scraps; fragmentary; lacking unity or consistency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef77429-f47e-4c12-813f-2c4ff9163405",
                                "sense_id": "3626d2a9-1419-33e5-898a-9bab23c54562",
                                "text": "That was a scrappy lecture."
                            }
                        ]
                    },
                    {
                        "sense_id": "11be0320-0b27-3fb2-b9a3-7ec51791b2b8",
                        "entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "glosses": [
                            "Having an aggressive spirit; inclined to fight or strive."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "faa62138-947a-4dcc-b6e4-0e713f91eec0",
                                "sense_id": "11be0320-0b27-3fb2-b9a3-7ec51791b2b8",
                                "text": "He's a scrappy dog and will charge at you if you taunt him."
                            },
                            {
                                "example_id": "6b699d04-4813-471d-9991-60c2a3fbf50c",
                                "sense_id": "11be0320-0b27-3fb2-b9a3-7ec51791b2b8",
                                "text": "In those days PGS [Portsmouth Grammar School] was full of sadistic staff and scrappy boys called things like Smudger, Muzz and Titch."
                            },
                            {
                                "example_id": "f1cc8dad-5080-4644-9390-4db8aa7d17cc",
                                "sense_id": "11be0320-0b27-3fb2-b9a3-7ec51791b2b8",
                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e85d33f-2168-3c14-a13a-b85a62984619",
                        "entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "glosses": [
                            "(Of a fight) characterised by lots of ungainly or wild punches, grabs, wrestling, etc."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "44651db1-319f-3594-8752-1171daa68a94",
                        "entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "glosses": [
                            "(Of a sports match) characterised by awkward or clumsy play."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02437270-401a-4224-a67d-848291b5aad7",
                        "source_entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "source_sense_description": "consisting of scraps; fragmentary; lacking unity or consistency",
                        "target_lang_word": "désordonné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Où il n’y a pas d’ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d896e4de-f4c6-43d4-9607-9196a6595c00",
                                                "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                                "text": "Je vais essayer d'écrire, en me cramponnant à mon bureau, mais je crains que les mouvements désordonnés du bateau ne le permettent pas."
                                            },
                                            {
                                                "example_id": "d3629159-5a51-4145-8a85-4b8635979ef2",
                                                "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                                "text": "De sa grande cuisine désordonnée, tandis qu’elle préparait un cottage pie ou une salade de poires au Stilton, Arabella chantait divinement faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Qui manque d’ordre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4845a375-87b0-480f-b2ef-3d780e813c05",
                                                "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                                "text": "[…], nous menions une vie désordonnée, parce que nous étions toujours sur le qui-vive, prêts à prendre notre essor le lendemain matin."
                                            },
                                            {
                                                "example_id": "5420cdbf-27f2-42e6-a92a-11bb609a222f",
                                                "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                                "text": "Que cet enfant est désordonné!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Qui n’est pas conforme à la règle, à l’ordre moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3f1e38-38b5-4040-a6c2-949016f01723",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "Vie, conduite désordonnée."
                                            },
                                            {
                                                "example_id": "6d6fb584-e8af-4e25-b3b7-19e97186ca39",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "— Femme désordonnée."
                                            },
                                            {
                                                "example_id": "6c4fdd36-d8c0-42d9-923f-32b2fb0ba470",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "— Une faim désordonnée. - Une passion désordonnée pour la chasse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aad4465-a04a-3c23-a8e9-2b09a76cc4b3",
                                        "entry_id": "9ac90f93-2a1d-3e83-87fe-5aad4d7ccb95",
                                        "glosses": [
                                            "Personne qui n’est pas ordonnée, pas organisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14de8c55-46fc-41de-bf62-3d1a0e2fede3",
                                                "sense_id": "8aad4465-a04a-3c23-a8e9-2b09a76cc4b3",
                                                "text": "Surtout qu’un désordonné respecte rarement les affaires des autres, les empruntant sans façon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7dc68e-e737-3089-a64d-38cd6ebfd611",
                                        "entry_id": "9ac90f93-2a1d-3e83-87fe-5aad4d7ccb95",
                                        "glosses": [
                                            "Personne qui manque d’ordre mental, spirituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6fe3046-de0b-489c-be58-0bb3e0983d2e",
                                                "sense_id": "aa7dc68e-e737-3089-a64d-38cd6ebfd611",
                                                "text": "Ce modéré, ce libéral, ce faiseur de chartes, ce méthodique, est un désordonné du sentiment, un chercheur d'émotions réelles ou fictives, un amateur de risques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c7612f-5268-3d0c-bf6a-93a46df6b7b9",
                                        "entry_id": "e79339c0-9c0a-3cd7-8a34-0fa4067e664a",
                                        "glosses": [
                                            "Participe passé masculin singulier de désordonner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4548591a-3302-47df-b11e-b439a88b094e",
                        "source_entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "source_sense_description": "consisting of scraps; fragmentary; lacking unity or consistency",
                        "target_lang_word": "lückenhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lückenhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                        "entry_id": "e68b8e42-5a8a-33dd-89be-f83c8b368227",
                                        "glosses": [
                                            "Lücken enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdb5ced-6d99-48df-a2bc-0beb80e37a09",
                                                "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                                "text": "„Aber vielleicht sollte man ja bei einem Ausflug nach Heldra nicht nur den leiblichen Gelüsten frönen, sondern sein lückenhaftes Wissen um diese beiden Persönlichkeiten durch einen Besuch im Dorfmuseum auffrischen.“"
                                            },
                                            {
                                                "example_id": "7ea9fa0f-751c-4ac4-b606-91c05846f921",
                                                "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                                "text": "„Allerdings war das Wissen über die korrekte Anwendung von Antibiotika äußerst lückenhaft: So glauben 65 Prozent, dass Antibiotika gegen Erkältungen und Schnupfen helfen - dabei richten solche Medikamente gegen Viruserkrankungen nichts aus und helfen nur gegen bakterielle Infektionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58b53195-dfa7-4070-8b34-c0d27d23d0d6",
                        "source_entry_id": "a3c9f352-f2a6-3f84-9f52-76d67c62c81f",
                        "source_sense_description": "consisting of scraps; fragmentary; lacking unity or consistency",
                        "target_lang_word": "bruchstückhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruchstückhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69646c88-d575-3d50-a977-6a192ecdc51f",
                                        "entry_id": "87b4dc20-401b-3b83-a09a-843504752103",
                                        "glosses": [
                                            "nur in Fragmenten vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c19186-e04d-424c-a65e-08dcafdfcca5",
                                                "sense_id": "69646c88-d575-3d50-a977-6a192ecdc51f",
                                                "text": "„Die Geruchswahrnehmung ist ein sehr komplexer Mechanismus, der bisher nur bruchstückhaft erforscht ist.“"
                                            },
                                            {
                                                "example_id": "33bdd3b5-12d8-44a3-bd23-2b599396dc99",
                                                "sense_id": "69646c88-d575-3d50-a977-6a192ecdc51f",
                                                "text": "„Da Pflanzen-Fossilien in der Regel nur bruchstückhaft erhalten sind, werden in der Paläobotanik meist nur bestimmte Pflanzenorgane (Blätter, Holz, Wurzeln, Blüten, Samen, Pollen usw.) oder sogar nur bestimmte Erhaltungszustände […] mit einem Artnamen versehen (\"Organart\", \"Organgattung\"; Organgattung).“"
                                            },
                                            {
                                                "example_id": "50e57e56-e6b7-4f62-856e-43f63c6c0d05",
                                                "sense_id": "69646c88-d575-3d50-a977-6a192ecdc51f",
                                                "text": "„Die wenigen, meist bruchstückhaften Quellen, die Hinweise auf Tutanchamuns Herkunft liefern, legen Ägyptologen bis heute unterschiedlich aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
