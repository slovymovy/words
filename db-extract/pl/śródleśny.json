                "senses": [
                    {
                        "sense_id": "231fb1c1-0481-34dc-9edd-4d83e2e4f29e",
                        "entry_id": "2388ccc6-83c2-3ad1-b358-3750bac86803",
                        "glosses": [
                            "taki, który przebiega wśród lasów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a5f4db-e7dc-4cda-b801-56b8880d41cb",
                                "sense_id": "231fb1c1-0481-34dc-9edd-4d83e2e4f29e",
                                "text": "– Ponadto uprawiamy 9 ha pól oraz łąk śródleśnych – mówi Józef Grygorcewicz. – Prowadzimy racjonalną gospodarkę łowiecką i współpracujemy z władzami, nadleśnictwami oraz rolnikami"
                            },
                            {
                                "example_id": "41666d85-8605-46db-8f12-6de3468b6a6a",
                                "sense_id": "231fb1c1-0481-34dc-9edd-4d83e2e4f29e",
                                "text": "Słuchałem ciszy śródleśnej, trzepotu listków osiki, oddechu strzelistych sosen, ostrzegawczego skrzeczenia kraski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
