                        "examples": [
                            {
                                "example_id": "795835bb-a613-4830-b0c8-22eaeb0136ca",
                                "sense_id": "d0ff8843-0250-3dcf-bafb-3d6c74ffa66a",
                                "text": "O, pan naczelnik! – wykrzyknęła trochę zbyt głośno pani Małgosia, poprawiając odruchowo nieco zmierzwioną blond grzywkę, do której rozczochrania przyczyniła się przed chwilą wprawna ręka Waldka."
                            },
                            {
                                "example_id": "99c1677b-bb1a-4981-a1a2-9a5707e8034a",
                                "sense_id": "d0ff8843-0250-3dcf-bafb-3d6c74ffa66a",
                                "text": "Zapytaj Waldka, czy mi się da przejechać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
