                        ],
                        "form": "den Flitter"
                    },
                    {
                        "form_id": "a21d8dc0-b514-480a-a818-3387b9cf27a4",
                        "entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flitter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "343aecc3-c543-38f3-ab3c-1448c0129df2",
                        "entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                        "glosses": [
                            "ausgestanzte Form aus dünnem Metallblech oder Kunststoff, die der Dekoration dient"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "c16b911f-3539-4ed3-8efc-f54eb1720e33",
                                "sense_id": "343aecc3-c543-38f3-ab3c-1448c0129df2",
                                "text": "Sein Zylinder war mit unzähligen Flittern geschmückt!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                        "entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                        "glosses": [
                            "etwas Schmückendes, das glänzt, aber nutz- und wertlos ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d929fb97-bfa8-4536-8a25-2a536dc3bf04",
                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                "text": "All der Flitter in diesem Haus machte ihn rasend. Er warf ihn hinaus und lebte von da an bescheiden und einfach."
                            },
                            {
                                "example_id": "e571d841-e5c9-40ff-a8ae-115aa27aa978",
                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                "text": "„Von Guste, die er für seine Taufpatin hielt, erbte Janosch die Vorliebe für Gold und Flitter.“"
                            },
                            {
                                "example_id": "6c7cbbe0-a68e-4e0a-b5b4-2604151192a5",
                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                "text": "„Ihren Flitter hatte sie abgelegt.“"
                            },
                            {
                                "example_id": "6e48b5bb-0d5b-4a50-b61f-a2fc9b165c4c",
                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                "text": "„Äußerer Flitter ist ein ausgezeichnetes Gegengewicht gegen ein so schlechtes Geschenk der Natur.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d0508d1-77d7-4287-bcfa-9db3a684e510",
                        "source_entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                        "source_sense_id": "343aecc3-c543-38f3-ab3c-1448c0129df2",
                        "source_sense_description": "meist Plural: ausgestanzte Form aus dünnem Metallblech oder Kunststoff, die der Dekoration dient",
                        "target_lang_word": "flitr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "934b0462-a596-4e95-95eb-796b227db61b",
                        "source_entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                        "source_sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                        "source_sense_description": "übertragen: etwas Schmückendes, das glänzt, aber nutz- und wertlos ist",
                        "target_lang_word": "frippery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frippery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35c7a013-f2b1-3557-9126-bbb21801d5ff",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "Ostentation, as in fancy clothing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0589a5-1bfd-45fd-a9e8-9b31be8f9ebb",
                                                "sense_id": "35c7a013-f2b1-3557-9126-bbb21801d5ff",
                                                "text": "Young women of such birth, living in a quiet country-house, and attending a village church hardly larger than a parlor, naturally regarded frippery as the ambition of a huckster’s daughter."
                                            },
                                            {
                                                "example_id": "369228e4-e2b6-45d9-b9ef-6f86b1014853",
                                                "sense_id": "35c7a013-f2b1-3557-9126-bbb21801d5ff",
                                                "text": "Well, we were probably never going to mistake Gordon Brown for a rococo dandy. Out go Thomas Gainsborough and George Romney with all their 18th century frills and fripperies, like aristocrats deported on the tumbril."
                                            },
                                            {
                                                "example_id": "ca53f67f-25f6-45d3-aadc-be8d8601d7a8",
                                                "sense_id": "35c7a013-f2b1-3557-9126-bbb21801d5ff",
                                                "text": "The frippery-filled world of fashion confounded its critics yesterday when it became sombre and serious in the wake of the terrorist attacks in the US."
                                            },
                                            {
                                                "example_id": "079477e7-1ac7-4c08-ab0e-6e78a00f0b93",
                                                "sense_id": "35c7a013-f2b1-3557-9126-bbb21801d5ff",
                                                "text": "And so frippery and force combine to make a political position – support for the monarchy – seem like the natural, sacred default."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c8d749-1b26-32d6-afc3-16c6d3d18d5e",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "Useless things; trifles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6460a45-9dfa-4087-8f38-a85d6fbca595",
                                                "sense_id": "01c8d749-1b26-32d6-afc3-16c6d3d18d5e",
                                                "text": "[Olmsted reiterated his insistence that in Chicago] simplicity and reserve will be practiced and petty effects and frippery avoided."
                                            },
                                            {
                                                "example_id": "22db515d-aae8-4167-81df-99188c8350e5",
                                                "sense_id": "01c8d749-1b26-32d6-afc3-16c6d3d18d5e",
                                                "text": "“At any rate you see me still unmarried. I have found no time to palter with the fripperies of women.”"
                                            },
                                            {
                                                "example_id": "f38ffdfe-fd7b-43b5-8b51-84e55a4e2003",
                                                "sense_id": "01c8d749-1b26-32d6-afc3-16c6d3d18d5e",
                                                "text": "[Oscar] Pistorius's punishment for killing her [Reeva Steenkamp] that night is but a frippery when set against the burden that her bereft parents, June and Barry, must carry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5094d39c-f8d1-337e-a81f-743491d7b123",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "Cast-off clothes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c385b71-79e4-4e7e-ab80-bbabbfe70df0",
                                                "sense_id": "5094d39c-f8d1-337e-a81f-743491d7b123",
                                                "text": "If thou doſt, come ouer, and but ſee our fripperie: change an olde ſhirt, for a whole ſmocke, with vs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f45ad7-64a1-38b7-b578-307d0929ac37",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "The trade or traffic in old clothes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0c832c8-e223-3f63-857b-ae3e2b6c08ce",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "The place where old clothes are sold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb2f958-8465-43cc-9910-df4874e148ee",
                                                "sense_id": "e0c832c8-e223-3f63-857b-ae3e2b6c08ce",
                                                "text": "Oh, ho, Monſter: wee know what belongs to a frippery, O King Stephano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bb5c1d-ba6e-399a-87f9-3d62fd6934b7",
                                        "entry_id": "7a4defdd-d449-3dd6-a551-cb41b2c3de55",
                                        "glosses": [
                                            "Hence: secondhand finery; cheap and tawdry decoration; affected elegance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d042142a-0538-47c2-876b-e8b80a66cd40",
                                                "sense_id": "e0bb5c1d-ba6e-399a-87f9-3d62fd6934b7",
                                                "text": "There's my pretty darling Kate; the faſhions of the times have almoſt infected her too. By living a year or two in town, ſhe is as fond of gauze, and French frippery, as the beſt of them."
                                            },
                                            {
                                                "example_id": "fde517c1-ac4a-4db2-8305-96cd617951f3",
                                                "sense_id": "e0bb5c1d-ba6e-399a-87f9-3d62fd6934b7",
                                                "text": "[…] but consider I was born in the land of talisman and spell, and my childhood lulled by tales which you can only enjoy through the gauzy frippery of a French translation."
                                            },
                                            {
                                                "example_id": "76e4cdac-2360-48fb-8960-5d7385fb7b85",
                                                "sense_id": "e0bb5c1d-ba6e-399a-87f9-3d62fd6934b7",
                                                "text": "But, there were preparations for a Festa; the pillars of stately marble were swathed in some impertinent frippery of red and yellow[…]"
                                            },
                                            {
                                                "example_id": "d39190da-2491-4983-90f9-9160ef0e20a0",
                                                "sense_id": "e0bb5c1d-ba6e-399a-87f9-3d62fd6934b7",
                                                "text": "We detest the affectation and effeminate frippery which is but too frequent in the modern novel"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
