                                "sense_id": "bf808a83-1dd4-38ce-b639-a046008e0d8d",
                                "text": "Dat was volkomen onaanvaardbaar."
                            },
                            {
                                "example_id": "b38a8d0b-02a2-488a-a030-66bd0a4066e7",
                                "sense_id": "bf808a83-1dd4-38ce-b639-a046008e0d8d",
                                "text": "Toen ik antwoordde dat ik die benaming ook nog nooit had gehoord tot ik in Engeland kwam, keek ze me volkomen uitdrukkingsloos aan."
                            },
                            {
                                "example_id": "ab232a50-9114-45b3-9be1-429125e97798",
                                "sense_id": "bf808a83-1dd4-38ce-b639-a046008e0d8d",
                                "text": "Ik geloofde mijn ogen niet, dit was volkomen bizar: een apparaat met adhd."
                            },
                            {
                                "example_id": "b0ecd74d-295d-4822-965a-e69f266868a2",
                                "sense_id": "bf808a83-1dd4-38ce-b639-a046008e0d8d",
                                "text": "Hij was gek op geweren en voelde zich volkomen thuis in de natuur."
                            }
                        ]
                    }
                ],
