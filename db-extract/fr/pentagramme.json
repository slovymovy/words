                "senses": [
                    {
                        "sense_id": "459baa96-59db-3bdf-b5ad-7a61de38b0b9",
                        "entry_id": "a0410588-7e75-3cfb-a52b-84e3526d74e5",
                        "glosses": [
                            "Forme géométrique en forme d’étoile à cinq branches ; quelquefois avec une connotation magique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f2cb8502-e1cb-3eeb-a614-2607a51be6dc",
                        "entry_id": "a0410588-7e75-3cfb-a52b-84e3526d74e5",
                        "glosses": [
                            "Séquence de cinq lettres ou groupe de cinq symboles formant une unité, un phonème ou un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e926b53b-6239-4227-a0e7-315e3119106c",
                                "sense_id": "f2cb8502-e1cb-3eeb-a614-2607a51be6dc",
                                "text": "Le mot chantaient a donc deux syllabes, dix graphèmes, deux digrammes (ch et an), un pentagramme (aient) et quatre phonèmes: [ʃã‚tε]."
                            },
                            {
                                "example_id": "e428c7aa-ef5a-41b4-a184-6ea0dde0e1d8",
                                "sense_id": "f2cb8502-e1cb-3eeb-a614-2607a51be6dc",
                                "text": "Un module de prédiction basé sur un pentagramme de lettres […] permet ainsi de présenter la lettre attendue dans les trois premières positions en moyenne (2,7 pour le français, 3 pour l’allemand)."
                            },
                            {
                                "example_id": "955fa388-8f02-4de4-9a91-066fa56f9683",
                                "sense_id": "f2cb8502-e1cb-3eeb-a614-2607a51be6dc",
                                "text": "Ensuite, dans œufs, il y a une ligature (ou digramme soudé…) œ, mais il y a aussi un pentagramme…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd1701f2-5029-48c2-aef3-39d232c04d35",
                        "source_entry_id": "a0410588-7e75-3cfb-a52b-84e3526d74e5",
                        "source_sense_description": "forme géométrique en forme d’étoile à cinq branches",
                        "target_lang_word": "Pentagramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pentagramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "689250ce-9420-3fe1-bbae-30dc4ec1b8ca",
                                        "entry_id": "4c0b5b08-86db-384f-a6ab-9756f06ca479",
                                        "glosses": [
                                            "fünfeckiger Stern, der in einem Zug gezeichnet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed06bf03-9fbc-4c15-84b9-93d6b15f3ebd",
                                                "sense_id": "689250ce-9420-3fe1-bbae-30dc4ec1b8ca",
                                                "text": "Das Pentagramm hält laut Volksglauben das Böse fern."
                                            },
                                            {
                                                "example_id": "6f7945c2-f0ec-429f-903a-713f27696eb2",
                                                "sense_id": "689250ce-9420-3fe1-bbae-30dc4ec1b8ca",
                                                "text": "„Das Pentagramm war das Erkennungszeichen der Pythagoräer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a69df71f-8e9c-4cc9-b444-1f8ef954eb7b",
                        "source_entry_id": "a0410588-7e75-3cfb-a52b-84e3526d74e5",
                        "source_sense_description": "forme géométrique en forme d’étoile à cinq branches",
                        "target_lang_word": "pentagram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentagram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                        "entry_id": "47383d6e-50c1-3307-8096-e3fb32832c66",
                                        "glosses": [
                                            "The shape of a five-pointed star constructed of five intersecting lines meeting at the vertices, such that a central pentagon and five surrounding isosceles triangles are formed; often with magical connotations; a 5/2 (or 5/3) star polygon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268ef499-10ea-4007-8368-01a8bead3b7f",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "Prove that the circles so belonging to the 6 pentagrams formed by 6 lines meet in a point, and so on; the series of theorems being interminable."
                                            },
                                            {
                                                "example_id": "4d057fa8-b2ec-49d8-a423-9d04a6a11c22",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "The passive pentagrams of spirit are drawn first in the quarters of the passive elements—water and earth—and likewise followed by the appropriate traditional elemental pentagram."
                                            },
                                            {
                                                "example_id": "d4b130c2-8d2b-4adb-a83d-58f3a4380799",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "Four figures involve 12 pentagrams arranged as in the faces of a dodecahedron with their vertices touching."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
