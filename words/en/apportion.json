                        "apportion resources"
                    ]
                },
                {
                    "sense_id": "62e2be3f-ce2f-3867-8f39-2cb32f58f21a",
                    "sense_definition": "To divide and distribute portions of a whole or assign parts of an area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>apportioned</w> the voting districts to reflect the recent changes in the population."
                        },
                        {
                            "text": "They decided to <w>apportion</w> the remaining budget across all pending research projects."
                        }
                    ],
                    "synonyms": [
