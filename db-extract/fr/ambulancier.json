                                        "entry_id": "3609d103-1bbf-3140-8421-4fae3002c36e",
                                        "glosses": [
                                            "eine für den Rettungsdienst, die Notfallrettung und den qualifizierten Krankentransport ausgebildete Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443a6752-7387-4bc8-9cd7-21bcb577af66",
                                                "sense_id": "5c4f8d03-37a0-337e-ae91-5d0ce2dd875c",
                                                "text": "Der Rettungssanitäter fährt den Rettungswagen."
                                            },
                                            {
                                                "example_id": "94aa2281-df57-4856-a5a2-14812c151b11",
                                                "sense_id": "5c4f8d03-37a0-337e-ae91-5d0ce2dd875c",
                                                "text": "„Zunächst versorgt ein Rettungssanitäter nach seiner Ausbildung Kranke und Verletzte und hilft bei ihrem Transport.“"
                                            },
                                            {
                                                "example_id": "2265cbe0-fcd4-44e9-acdd-481d237097ee",
                                                "sense_id": "5c4f8d03-37a0-337e-ae91-5d0ce2dd875c",
                                                "text": "„Oft genug stehen Rettungssanitäter vor einer schweren Entscheidung: Sollen sie dem Patienten ein Medikament verabreichen, das ihm helfen würde - oder sollen sie auf den Notarzt warten, der nach dem Buchstaben des Gesetzes als Einziger dazu berechtigt ist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
