                        "entry_id": "fd7fb6b9-6903-311d-9d6f-85a638689619",
                        "glosses": [
                            "Pflanze der Gattung Nepeta aus der Familie der Lippenblütler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d95af1-b7bd-49a3-905e-262a770b4e5b",
                                "sense_id": "e7f3b588-f30a-3db1-b443-332979a18ca9",
