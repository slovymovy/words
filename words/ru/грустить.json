        "погрустить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71ed50b0-5b6e-316e-8a4e-07715bb1cfcb",
                    "sense_definition": "Испытывать чувство грусти, печали; находиться в унынии.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "испытывать грусть",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она часто сидела у окна и продолжала тихо <w>грустить</w> о прошедшем лете.",
                            "target_lang_translations": {
                                "en": "She often sat by the window and continued to quietly <w>grieve</w> for the past summer."
                            }
                        },
                        {
                            "text": "Не надо <w>грустить</w> без причины, ведь жизнь прекрасна и полна приятных сюрпризов.",
                            "target_lang_translations": {
                                "en": "There is no need to <w>be sad</w> without a reason, because life is beautiful and full of pleasant surprises."
                            }
                        }
                    ],
                    "synonyms": [
                        "тосковать",
                        "унывать",
                        "печалиться"
                    ],
                    "antonyms": [
                        "веселиться",
                        "радоваться"
                    ],
                    "common_phrases": [
                        "тихо грустить",
                        "грустить без причины"
                    ],
                    "target_lang_definitions": {
                        "en": "To feel sad, sorrowful, or downcast; to be in a state of melancholy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be sad",
                                "target_lang_sense_clarification": "to feel sorrow or unhappiness"
                            },
                            {
                                "target_lang_word": "grieve",
                                "target_lang_sense_clarification": "to feel intense sorrow"
                            },
                            {
                                "target_lang_word": "feel blue",
                                "target_lang_sense_clarification": "to feel slightly depressed or sad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65636633-ac08-3856-b51d-e916905c74df",
                    "sense_definition": "Вспоминать о ком-либо или о чём-либо с грустью, тосковать по кому-либо или чему-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "испытывать грусть",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто не будет так <w>грустить</w> о ней, как её старый верный друг.",
                            "target_lang_translations": {
                                "en": "No one will <w>miss</w> her as much as her old faithful friend."
                            }
                        },
                        {
                            "text": "Уехав в другую страну, он продолжал <w>грустить</w> о родине.",
                            "target_lang_translations": {
                                "en": "Having left for another country, he continued to <w>yearn</w> for his homeland."
                            }
                        }
                    ],
                    "synonyms": [
                        "тосковать",
                        "тужить"
                    ],
                    "common_phrases": [
                        "грустить о родине",
                        "грустить о прошлом"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "устаревающее управление с предлогом 'о'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To remember someone or something with sadness; to yearn or pine for someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "to feel sad because of the absence of someone or something"
                            },
                            {
                                "target_lang_word": "yearn",
                                "target_lang_sense_clarification": "to have an intense feeling of longing for something, typically something that one has lost"
                            },
                            {
                                "target_lang_word": "pine",
                                "target_lang_sense_clarification": "to suffer a mental and physical decline, especially because of a broken heart or longing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}