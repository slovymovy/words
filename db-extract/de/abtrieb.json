                ],
                "senses": [
                    {
                        "sense_id": "192dc095-62fa-31ce-b83a-38f28ad5ae3d",
                        "entry_id": "32478b76-b59e-30df-a9f6-5d6d8f4c23c3",
                        "glosses": [
                            "Abgabe von Kraft auf eine Welle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abdba44a-60fe-43c6-8f21-d1f449e52de9",
                                "sense_id": "192dc095-62fa-31ce-b83a-38f28ad5ae3d",
                                "text": "„Von zwei gleichgearteten Ölpumpen (Abb. 28) dient die eine als Generator (Antrieb), die andere als Motor (Abtrieb).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "981f2f0e-534e-31a6-9946-0883b9a158ed",
                        "entry_id": "32478b76-b59e-30df-a9f6-5d6d8f4c23c3",
                        "glosses": [
                            "Rückholung des Viehs von der (höhergelegenen) Weide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703c5ec6-4a71-45c1-bca4-bc414fe82bf7",
                                "sense_id": "981f2f0e-534e-31a6-9946-0883b9a158ed",
                                "text": "Der Abtrieb der Kühe von der Oberalm steht an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c544801c-961d-38c0-83de-9b46c4367f53",
                        "entry_id": "32478b76-b59e-30df-a9f6-5d6d8f4c23c3",
                        "glosses": [
                            "aufgeschlagene Masse aus Butter und Eiern"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "872ee7a4-1fb0-4765-8a18-eef252fd154f",
                                "sense_id": "c544801c-961d-38c0-83de-9b46c4367f53",
                                "text": "Butter und Eier schaumig schlagen und dann die Zitronenschale unter den Abtrieb heben."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "5df72a85-dc7c-3d84-bae1-13c00afb7113",
                        "entry_id": "32478b76-b59e-30df-a9f6-5d6d8f4c23c3",
                        "glosses": [
                            "Abholzen von Bäumen"
                        ],
                        "tags": [
                            "Holzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "2e60f4d6-b89d-4b1c-9b03-5877c599a2a2",
                                "sense_id": "5df72a85-dc7c-3d84-bae1-13c00afb7113",
                                "text": "„Ist ein schon starker Baum nicht geradezu im Wege, so verzichte man lieber auf den Abtrieb; ist er aber überflüssig oder störend durch seine Höhe, so muß man es wagen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d3d02b49-1de0-309f-9444-82904fd711d7",
                        "entry_id": "32478b76-b59e-30df-a9f6-5d6d8f4c23c3",
                        "glosses": [
                            "Entfernen von chemischen Stoffen, zersetzter Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2af48f-c4a3-420c-a332-89ea0f07e91d",
                                "sense_id": "d3d02b49-1de0-309f-9444-82904fd711d7",
                                "text": "„Um den Abtrieb zu beginnen, füllt man die Retorte mit dem zu behandelnden Rohgute und lässt den Dampf einströmen.“"
                            },
                            {
                                "example_id": "a5fdfe60-5688-4b61-9608-9167d532a2c1",
                                "sense_id": "d3d02b49-1de0-309f-9444-82904fd711d7",
                                "text": "„Die Kohle E K II bildet in der Hitze viel Abtrieb und ist aus diesem Grund weniger zu empfehlen.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
