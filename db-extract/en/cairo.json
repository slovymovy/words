                    {
                        "translation_id": "5d15c943-35dd-44ea-9e9a-4372e40a807f",
                        "source_entry_id": "b25f2de8-234a-332a-ba59-796a7a877b3a",
                        "source_sense_description": "capital of Egypt — see also Fustat",
                        "target_lang_word": "Le Caire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Le Caire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2059076-b26a-3a9d-aae3-f2bd5bdcdd0f",
                                        "entry_id": "f2e9c16d-4ace-3448-b992-4bbc8d70097c",
                                        "glosses": [
                                            "Ville égyptienne, capitale de l’Égypte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d896e7d-82a8-4719-b378-dd8d19aa4931",
                                                "sense_id": "f2059076-b26a-3a9d-aae3-f2bd5bdcdd0f",
                                                "text": "Gasbieha et sa mère passaient le printemps au Caire, l’été à Alexandrie, et suivaient fréquemment le Pacha à Hélouan, où il soignait ses rhumatismes."
                                            },
                                            {
                                                "example_id": "da8acd95-c683-4061-9aeb-259e99d463e5",
                                                "sense_id": "f2059076-b26a-3a9d-aae3-f2bd5bdcdd0f",
                                                "text": "Un des plus célèbres chanteurs du Caire, Abdul-Haï, promis qu’il viendrait de bonne heure se faire entendre, accompagné par ces instruments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c15f9ce8-18ea-3acf-abb4-2bc3ec0e8cca",
                                        "entry_id": "f2e9c16d-4ace-3448-b992-4bbc8d70097c",
                                        "glosses": [
                                            "Le gouvernement égyptien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d942666-ae91-4c53-9b21-386748d0bb8e",
                                                "sense_id": "c15f9ce8-18ea-3acf-abb4-2bc3ec0e8cca",
                                                "text": "Le 17 octobre, seulement, Le Caire comprit que les Israéliens continuaient à renforcer leur tête de pont ; à cette date, un pont flottant était déjà en place et une division au grand complet avait pu traverser."
                                            },
                                            {
                                                "example_id": "4ca727e7-9f20-4a65-b5d1-2c46f71c4a94",
                                                "sense_id": "c15f9ce8-18ea-3acf-abb4-2bc3ec0e8cca",
                                                "text": "Briller à Paris pour emmouscailler Riyad et Le Caire, ce n’est plus foot, c’est du billard !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Le Caire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99ba2b95-55d0-3951-b7dc-e525cd2494db",
                                        "entry_id": "2811a0c8-bf67-3a49-acc4-803407774571",
                                        "glosses": [
                                            "Commune française, située dans le département des Alpes-de-Haute-Provence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fdf91d8-ca7e-42de-b768-2d0e61cb6cad",
                        "source_entry_id": "b25f2de8-234a-332a-ba59-796a7a877b3a",
                        "source_sense_description": "capital of Egypt — see also Fustat",
                        "target_lang_word": "Kairo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kairo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                        "entry_id": "5ffca672-fc32-32fd-8379-7c8bf01f44a3",
                                        "glosses": [
                                            "die Hauptstadt Ägyptens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3142e3-66ad-47bf-95ee-f629c236af6f",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "Wir fahren nach Kairo."
                                            },
                                            {
                                                "example_id": "84bfe835-3209-4135-a8c6-774de34a16d4",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "Das Kairo der heutigen Zeit ist durch viele Stadtviertel geprägt, in denen Landflüchtlinge illegal leben."
                                            },
                                            {
                                                "example_id": "03ccb8a6-46a4-4f8d-88a6-df9f893afe99",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Viel Whisky-Cola und ein Tablett mit Ecstasy-Pillen: Wild sind die Partynächte in Teheran, Kairo und Damaskus - aber auch gefährlich.“"
                                            },
                                            {
                                                "example_id": "5af34b9a-1c80-4d67-bf5c-898013c9d38a",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Gestützt auf seine doppelte Rolle als erster Unterzeichner eines Friedensvertrags mit Israel (1979) und als Vorreiter des arabischen Nationalismus - und als solcher über jeden Verdacht erhaben, die Interessen der Palästinenser zu verschachern -, konnte Kairo im israelisch-arabischen Friedensprozess eine wichtige Funktion übernehmen.“"
                                            },
                                            {
                                                "example_id": "fbf2281f-85a5-4141-9008-6a20b4d790da",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Im Streit um einen Kirchenbau in Kairo ist bei Zusammenstößen zwischen Christen und der Polizei am Mittwoch ein Mensch ums Leben gekommen.“"
                                            },
                                            {
                                                "example_id": "4c12c255-4bb2-45af-862c-798de1273d48",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Im Januar war in Marseille ein Gemälde von Edgar Degas im Wert von 800 000 Euro verschwunden, im August schnappten sich Diebe in Kairo van Goghs Gemälde ‚Mohnblumen‘ - 40 Millionen Euro wert.“"
                                            },
                                            {
                                                "example_id": "6edfc67a-91b1-4e2b-bd63-192ce167d2e1",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Demonstranten in Kairo und Alexandria riefen ‚Gestern Tunis, heute Kairo‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
