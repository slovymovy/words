                ],
                "senses": [
                    {
                        "sense_id": "9365ab7d-b42e-3cc9-a90e-aa5fa010cca8",
                        "entry_id": "e6678d49-ac3a-38e0-ac30-2f79f0a7b04f",
                        "glosses": [
                            "заглушить своим криком другие голоса, звуки"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcfeaea2-6330-4798-be30-b8ddb1f5e1b1",
                        "source_entry_id": "e6678d49-ac3a-38e0-ac30-2f79f0a7b04f",
                        "source_sense_id": "9365ab7d-b42e-3cc9-a90e-aa5fa010cca8",
                        "target_lang_word": "crier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1026f9b5-dc26-3836-a60f-07a7f224126d",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Jeter un ou plusieurs cris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abe7188-a8b0-4c97-b295-107b9632d8a1",
                                                "sense_id": "1026f9b5-dc26-3836-a60f-07a7f224126d",
                                                "text": "L’élan des grands manèges soulevant le cœur et faisant crier d’effroi les adolescentes dans la nuit bleue ne s'écarte qu’en apparence des loteries pauvrettes et des tirettes aux peluches à deux sous."
                                            },
                                            {
                                                "example_id": "d7ed2bd7-eb78-48eb-890d-20992bc39af2",
                                                "sense_id": "1026f9b5-dc26-3836-a60f-07a7f224126d",
                                                "text": "Il crie de toute sa force. — Un chien qui crie parce qu’on le bat. — On entendait crier les hiboux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f78d521-a4d8-36ca-9cf4-bb4d26b4dd84",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Élever très haut la voix dans la conversation, dans une discussion, dans un blâme, dans une gronderie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db599f23-5ce5-4c49-949b-21207f77e29e",
                                                "sense_id": "5f78d521-a4d8-36ca-9cf4-bb4d26b4dd84",
                                                "text": "L’épouse devient rouge et le poète devient pâle. Ils crient très fort. Le visage rouge devient pâle, la face pâle passe au rouge. Avec les mots, on en voit de toutes les couleurs."
                                            },
                                            {
                                                "example_id": "b503668e-5c71-47a0-bbdb-777cf30f2385",
                                                "sense_id": "5f78d521-a4d8-36ca-9cf4-bb4d26b4dd84",
                                                "text": "Il est tellement sourd qu’il faut crier pour se faire entendre de lui. — Il crie comme un sourd. — Il ne saurait discuter sans crier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4e6777-2552-3b15-b517-fc694499e549",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Forcer trop sa voix en chantant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2e75bb-69a0-48cc-9b38-7a84ecf0963a",
                                                "sense_id": "bc4e6777-2552-3b15-b517-fc694499e549",
                                                "text": "Cette femme ne chante pas, elle crie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482f7c77-66a6-3fcd-8634-42532b16ff85",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Grincer ; produire un bruit aigre, en se frottant rudement contre d’autres ou en se cassant, en parlant des choses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df2a159-df0b-4bd9-93dc-a60fbb073e8f",
                                                "sense_id": "482f7c77-66a6-3fcd-8634-42532b16ff85",
                                                "text": "Les sables sont les matières que l’on mélange le plus habituellement à la chaux pour former les mortiers ; ils doivent être rudes au toucher et crier quand on les serre dans la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581d5f85-66cf-3042-b668-8846b8f857a6",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Proclamer, annoncer une chose au nom de l’autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd589481-e72a-4506-9ed8-ff53d82339b1",
                                                "sense_id": "581d5f85-66cf-3042-b668-8846b8f857a6",
                                                "text": "On a crié à son de trompe que chacun eût à rendre ses armes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5adea6-e945-34cf-a09a-c960f35bce8f",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Avertir souvent quelqu’un d’une chose, la lui conseiller fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d0237b-d5f7-4244-beb1-6acac3731beb",
                                                "sense_id": "5d5adea6-e945-34cf-a09a-c960f35bce8f",
                                                "text": "Il y a longtemps que je lui crie d’être sage, de prendre garde à lui."
                                            },
                                            {
                                                "example_id": "6bf4e5a6-5bb4-4ed1-9d02-92fd21a12eb6",
                                                "sense_id": "5d5adea6-e945-34cf-a09a-c960f35bce8f",
                                                "text": "La conscience, une voix intérieure nous crie qu’une telle action ne saurait être juste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Prononcer, à propos d’une personne ou d’une chose, un ou plusieurs mots d’un ton de voix très élevé avec le même effort que si l’on poussait un cri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8281471-0cc2-44a0-819a-5485ab2b9082",
                                                "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                                "text": "Le bon Piqueur doit sçauoir bien parler en cris, & langages plaisans aux chiens, crier, hucher, & houpper ses compagnons, forhuer en mots longs, & sonner de la trompe."
                                            },
                                            {
                                                "example_id": "0a66220d-c708-40de-b31d-8ea18b19c605",
                                                "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                                "text": "« J’ai eu la cholérine comme tout le monde, dit l’homme. On pose culotte deux ou trois fois au lieu d’une : un point c’est tout. De celle-ci on en meurt un peu, paraît-il. C’est simplement le temps qui met les bouchées doubles. Il n’y a pas de quoi crier au voleur. »"
                                            },
                                            {
                                                "example_id": "80cbf531-e77d-4a5c-8589-c1f767ae6362",
                                                "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                                "text": "J’ai beau lui crier de se détourner, il ne m’entend pas."
                                            },
                                            {
                                                "example_id": "1e2ca6dc-6245-4b7d-abb7-498a3239c917",
                                                "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                                "text": "Crier aux armes.— Crier à l’aide, au secours, à la garde. — Crier au meurtre, au voleur, au feu."
                                            },
                                            {
                                                "example_id": "ff52f423-bc24-45ab-aaef-dc2f61e38570",
                                                "sense_id": "3f4f5c5b-9dfb-3d32-a286-0a9d58422309",
                                                "text": "Crier gare. — Crier miséricorde. — Crier merci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d390b4-89c3-3036-a750-7b857346db49",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Exprimer fortement, même sous forme écrite, un avis, une opinion, souvent sous forme de protestation."
                                        ],
                                        "tags": [],
                                        "note": "Le verbe est souvent construit avec la préposition à",
                                        "examples": [
                                            {
                                                "example_id": "5c9ae5b5-fa06-49a0-b058-fbec6caacdf5",
                                                "sense_id": "27d390b4-89c3-3036-a750-7b857346db49",
                                                "text": "Bien sûr, le « Vatican » égyptien (la mosquée et université Al-Azhar) a dit non, crié à l’atteinte aux valeurs, à l’insulte faite à Dieu, à la mécréance qui autorise qu’on vous tue."
                                            },
                                            {
                                                "example_id": "08e52efe-c9ce-420c-9d46-e3998e3b5808",
                                                "sense_id": "27d390b4-89c3-3036-a750-7b857346db49",
                                                "text": "Sur son compte Instagram, l’ancien Niçois a crié à l’injustice concernant cette mise à l’écart, en reprenant une célèbre citation de Martin Luther King."
                                            },
                                            {
                                                "example_id": "c1f2edbe-ed71-4994-8974-769573e704cb",
                                                "sense_id": "27d390b4-89c3-3036-a750-7b857346db49",
                                                "text": "Crier au génie."
                                            },
                                            {
                                                "example_id": "1da5b9c5-bc5b-4ca0-9146-c94d395a3701",
                                                "sense_id": "27d390b4-89c3-3036-a750-7b857346db49",
                                                "text": "🗣️ Youri Tielemans : \"C'est injuste de crier à la démission du coach.\" Le capitaine des Diables Rouges a pris la défense du sélectionneur national. Le public du stade Roi Baudouin avait scandé \"Domenico Tedesco démission\" à la fin du duel contre la France en Ligue des nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24295b1-9a11-331c-939b-06038f63d634",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Mettre à l’enchère des biens, inviter à les enchérir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7fa11de-015b-411b-9c08-2dd3a7aebe64",
                                                "sense_id": "b24295b1-9a11-331c-939b-06038f63d634",
                                                "text": "Crier des meubles, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dcb6680-4a7f-3e0b-9307-ffd5e3b2e335",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Attirer le chaland par ses cris ; vendre à la criée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b894e0d-ddda-42ca-9859-be9e12e5af65",
                                                "sense_id": "6dcb6680-4a7f-3e0b-9307-ffd5e3b2e335",
                                                "text": "Bellegarde tirait de la poche veston un étui en argent, dont il allait extirper une savoureuse abdullah, lorsqu’il se vit tout à coup environné par une bande de camelots qui criaient la troisième édition d’un journal du soir."
                                            },
                                            {
                                                "example_id": "3b5ffd81-e4c3-499e-88e6-46e515be217a",
                                                "sense_id": "6dcb6680-4a7f-3e0b-9307-ffd5e3b2e335",
                                                "text": "On criait les journaux étrangers. […] un homme qui, disait-on, avait crié les journaux dans les rues"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad9b797-59f2-399e-a312-6be1b74afab0",
                                        "entry_id": "3af91c3a-b9c7-37eb-82c9-f3f0f0fdd4a2",
                                        "glosses": [
                                            "Dire une chose hautement ou la répéter avec importunité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e727da75-91fb-4764-b5e3-bb3a671ec637",
                                                "sense_id": "3ad9b797-59f2-399e-a312-6be1b74afab0",
                                                "text": "Il ira crier cela partout. — Il ne cesse de crier que tout est perdu."
                                            },
                                            {
                                                "example_id": "e8df6624-7d0d-45d5-aaf9-44c0c20d17bd",
                                                "sense_id": "3ad9b797-59f2-399e-a312-6be1b74afab0",
                                                "text": "Il crie aux oreilles de tout le monde qu’on lui a fait une injustice. — Ils m’ont trompé, je le crierai sur les toits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93f76d80-8ae7-4ae8-8da5-1ae5582be867",
                        "source_entry_id": "e6678d49-ac3a-38e0-ac30-2f79f0a7b04f",
                        "source_sense_id": "9365ab7d-b42e-3cc9-a90e-aa5fa010cca8",
                        "target_lang_word": "huer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ad1290-ac4f-31cb-82c3-4c5b053a0409",
                                        "entry_id": "b3b51e09-2371-3432-9be1-aa2fc347da19",
                                        "glosses": [
                                            "Poursuivre le loup avec des huées."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb26c07-3a06-447e-86b9-719d9d6853a3",
                                                "sense_id": "f9ad1290-ac4f-31cb-82c3-4c5b053a0409",
                                                "text": "Huer le loup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde2c56f-c2a7-32f8-bd64-f9fa88c5c054",
                                        "entry_id": "b3b51e09-2371-3432-9be1-aa2fc347da19",
                                        "glosses": [
                                            "Émettre des cris de dérision à l’encontre de quelqu’un pour marquer son opposition, son mécontentement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5412bf1f-c3a6-4abe-be1b-d39451df7b33",
                                                "sense_id": "bde2c56f-c2a7-32f8-bd64-f9fa88c5c054",
                                                "text": "Il est à voir comment à Paris le pilori des grandes halles est artistement disposé pour contraindre le pilorié à montrer sa face à la foule, accourue pour le huer, l’injurier, remplir le vœu de la loi."
                                            },
                                            {
                                                "example_id": "4a6a5c1e-e939-4665-a818-4be08dfc6f51",
                                                "sense_id": "bde2c56f-c2a7-32f8-bd64-f9fa88c5c054",
                                                "text": "Son parent, M. de Valqueyras, lui ayant défendu d’introduire des affiliés dans son hôtel, il avait choisi le salon jaune de Félicité. D’ailleurs, il ne tarda pas à trouver dans Pierre un aide précieux. Il ne pouvait aller prêcher lui-même la cause de la légitimité aux petits détaillants et aux ouvriers du vieux quartier ; on l’aurait hué."
                                            },
                                            {
                                                "example_id": "73011efc-d16e-4539-b2be-ad0dd4c729aa",
                                                "sense_id": "bde2c56f-c2a7-32f8-bd64-f9fa88c5c054",
                                                "text": "Ce message rabat-joie fut hué par une partie de la foule mais tempéra quelque peu l'enthousiasme général."
                                            },
                                            {
                                                "example_id": "f4e6e0b3-f080-4194-8600-61dc618f2ffd",
                                                "sense_id": "bde2c56f-c2a7-32f8-bd64-f9fa88c5c054",
                                                "text": "À l'autre bout de la ligne, le boulanger de Bazoches-les-Gallerandes en rajoute... Il se nomme Capdebosc ! il brame. Depuis sa cagna sous les balles, il hue l'autorité. Il brandit le drapeau noir ! En même temps, il nargue la sifflante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3646c74-052e-3ed3-b2dc-ede71d9869a8",
                                        "entry_id": "b3b51e09-2371-3432-9be1-aa2fc347da19",
                                        "glosses": [
                                            "Pousser leur cri, en parlant de certains oiseaux, en particulier le héron, la chouette et le hibou."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d600dafc-f9e3-4c9e-b4ec-090c33270a8c",
                                                "sense_id": "d3646c74-052e-3ed3-b2dc-ede71d9869a8",
                                                "text": "Il n'y a plus qu'une bande plus claire à l'horizon : deux chevêches chuintent aux deux bouts de l'invisible, se répondent de minute en minute, relayées par un hibou plus proche qui hue dans un peuplier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
