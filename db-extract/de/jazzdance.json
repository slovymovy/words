                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd92094e-ed91-4d24-83f3-fc8f8e45dad8",
                                                "sense_id": "5736b4f5-c261-3735-8e34-0ff7ba89ff37",
                                                "text": "Twenty-four black men jazzed madly as trumpets exploded her eardrums in tom-tom time. Ebony orgasm flooded her with creme."
                                            },
                                            {
                                                "example_id": "c08b2ad0-587b-4efa-bca1-76bd14aa80b7",
