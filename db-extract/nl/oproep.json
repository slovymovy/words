                "senses": [
                    {
                        "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                        "entry_id": "8d130289-5652-332e-a11b-26b42315d978",
                        "glosses": [
                            "een dringende vraag om iets te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7207629b-fc24-42d6-b4b5-fa9bf7ff49c2",
                                "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                                "text": "De actie is dan ook niet bedoeld als schoonmaakactie, maar als oproep om de plastic filters te verbieden, zegt de organisatie in een persbericht."
                            },
                            {
                                "example_id": "bfb81b26-5016-45c0-a8f1-e849649bdc78",
                                "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                                "text": "De uitspraak van vandaag versterkt de oproep tot hervormingen."
                            },
                            {
                                "example_id": "1afa96ca-531f-4a00-846c-7c0bad655f7d",
                                "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                                "text": "De uitspraak van vandaag versterkt de oproep tot hervormingen."
                            },
                            {
                                "example_id": "7a7f8efb-fac1-4dc0-8115-757ed67da8eb",
                                "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                                "text": "Als de ambulancedienst een oproep krijgt, moet zij snel reageren."
                            },
                            {
                                "example_id": "94425123-a3b1-46a1-85e8-9aad366aeaff",
                                "sense_id": "ebe71415-1755-38b6-87a0-6924252289df",
                                "text": "\"VU, hef niet je aardwetenschappen-afdeling op!\", schrijft hoofdgeoloog van de Geologische Dienst Nederland, Michiel van der Meulen van TNO, in een oproep op LinkedIn. \"Als ze dit besluit doorzetten, keren ze hun rug naar de samenleving en de toekomst\", gaat hij verder. \"Of het nou voor een beter milieu is, meer welvaart of grotere autonomie - voor Nederland, Europa of de wereld: aardwetenschappers leveren een essentiële bijdrage.\""
                            }
                        ]
                    }
