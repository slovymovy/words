                ],
                "senses": [
                    {
                        "sense_id": "fabf9af2-5cee-3414-af35-1cea04ce2c44",
                        "entry_id": "7406b8da-b58d-32ef-bd22-bdf7f58745cd",
                        "glosses": [
                            "Laut, der phonetisch gesehen weder den Vokalen noch den Konsonanten eindeutig zugeordnet werden kann und nicht in silbentragender Position, also nicht als Silbenkern verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a3797c-9a57-456e-9e8d-3b9456fdb677",
                                "sense_id": "fabf9af2-5cee-3414-af35-1cea04ce2c44",
                                "text": "Der Begriff Halbkonsonant ist offenbar weniger gebräuchlich als \"Halbvokal\"."
                            },
                            {
                                "example_id": "d7a8bf45-c9f1-4620-9d60-9682bffd0bd0",
                                "sense_id": "fabf9af2-5cee-3414-af35-1cea04ce2c44",
                                "text": "Die wichtigsten Halbkonsonanten im Deutschen sind die Laute [i̯, ʊ̯]."
                            },
                            {
                                "example_id": "c123cad8-5df1-4ac4-b8e5-5bfa90b98293",
                                "sense_id": "fabf9af2-5cee-3414-af35-1cea04ce2c44",
                                "text": "In dem Wort \"Nation\" ([na'ʦi̯oːn]) steht der Buchstabe \"i\" nicht für einen Vokal in silbentragender Position, da der Laut [oː] diese Funktion innehat. Damit befindet sich das \"i\" in der Position des Silbenrandes und ist ein Halbkonsonant. Dieser Halbkonsonant wird meist mit [i̯], manchmal aber auch mit [j] transkribiert, da seine Aussprache der des palatalen Frikativs [j] (wie in \"jung\" = [jʊŋ]) entspricht."
                            },
                            {
                                "example_id": "3deb0f33-291d-4c29-a597-3e824f44bcb4",
                                "sense_id": "fabf9af2-5cee-3414-af35-1cea04ce2c44",
                                "text": "Laut Crystal (1993: 152 f.) handelt es sich dagegen phonetisch gesehen um Vokale, phonologisch um Konsonanten. Die Bezeichnung Halbvokal, seltener Halbkonsonant, behebt das Dilemma terminologisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
