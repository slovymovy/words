            "senses": [
                {
                    "sense_id": "787b4d3d-322e-362b-b799-0530efd3ee2b",
                    "sense_definition": "Rendre obscur en diminuant ou en interceptant la lumière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'épais nuages noirs commencent à <w>obscurcir</w> le ciel au-dessus de la vallée."
                        },
                        {
                            "text": "La fumée de l'incendie a fini par <w>obscurcir</w> le soleil pendant plusieurs heures."
                        }
                    ],
                    "synonyms": [
                        "enténébrer"
                    ],
                    "antonyms": [
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "obscurcir le ciel",
                        "obscurcir la vue"
                    ]
                },
                {
                    "sense_id": "88d65b40-3c54-3fbb-a393-90aeb2c8e94a",
                    "sense_definition": "Perdre sa clarté ou sa luminosité, devenir sombre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En fin d'après-midi, le ciel s'<w>obscurcit</w> rapidement et le vent commence à souffler."
                        },
                        {
                            "text": "Dès que l'orage approche de la côte, l'horizon s'<w>obscurcit</w> à perte de vue."
                        }
                    ],
                    "antonyms": [
                        "éclaircir"
                    ]
                },
                {
                    "sense_id": "049aa13b-3477-3821-960c-a93068da1af5",
                    "sense_definition": "Rendre confus, difficile à comprendre ou moins intelligible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La colère et la fatigue risquent d'<w>obscurcir</w> son jugement au moment de décider."
                        },
                        {
                            "text": "Toutes ces explications contradictoires ne font qu'<w>obscurcir</w> le débat au lieu de l'aider."
                        }
                    ],
                    "antonyms": [
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "obscurcir le jugement",
                        "obscurcir le débat"
                    ]
                }
            ]
        }
