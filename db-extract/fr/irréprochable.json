        "fr-extract.jsonl": [
            {
                "entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                "word": "irréprochable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c84b6dce-e5f8-4737-b34d-ea20f0112f6a",
                        "entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "irréprochables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "glosses": [
                            "Qui ne mérite pas de reproche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4101d614-cadf-4262-9f4c-15e849c52dea",
                                "sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                                "text": "Elle imagina qu’en devenant irréprochable, catholiquement parlant, elle arriverait à un tel état de sainteté, que Dieu l’écouterait et accomplirait ses désirs."
                            },
                            {
                                "example_id": "9300d941-c502-4ec1-9664-c5f5bc326f86",
                                "sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                                "text": "L’un d’eux, M. Hanson, nous invite à souper. Nous entrons dans une confortable maison danoise, d’une irréprochable propreté ; […]."
                            },
                            {
                                "example_id": "c0bfa462-5807-472e-8f02-a505b2507c72",
                                "sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                                "text": "On voit que la moralité des armateurs et des gros négociants n’était pas toujours irréprochable et que l’amour ancillaire avait, à Saint-Malo, de chauds pratiquants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bf0b6ea-c02b-4424-9fdb-46d79edaf1ec",
                        "source_entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "source_sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "target_lang_word": "irreproachable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
