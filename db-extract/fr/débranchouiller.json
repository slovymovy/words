                "senses": [
                    {
                        "sense_id": "d378b226-0a92-3ab8-bbfb-21f567bdb14a",
                        "entry_id": "07d7a7cc-ef2c-3fd7-a673-62a48b4f90db",
                        "glosses": [
                            "Faire perdre son caractère branchouille à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ffcd77c-52f7-4df8-8a68-b0733bf24674",
                                "sense_id": "d378b226-0a92-3ab8-bbfb-21f567bdb14a",
                                "text": "Le problème pour lui, c’est que quand on va le débranchouiller, on va le crucifier."
                            },
                            {
                                "example_id": "892450d9-beb8-464c-8b93-0c17452edc72",
                                "sense_id": "d378b226-0a92-3ab8-bbfb-21f567bdb14a",
                                "text": "Comme tu as l’art de nous \"débranchouiller\" ce qui l’est un peu trop, c’est pour nous un plaisir de te suivre dans les expos que tu visites."
                            }
                        ]
                    },
                    {
                        "sense_id": "be16b89b-0c5f-3850-a721-3d6c79d083b5",
                        "entry_id": "07d7a7cc-ef2c-3fd7-a673-62a48b4f90db",
                        "glosses": [
                            "Couper les branches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57f845d-6856-4002-9b9f-939bfde8ac4d",
                                "sense_id": "be16b89b-0c5f-3850-a721-3d6c79d083b5",
                                "text": "J’ai continué à débranchouiller à la grosse cisaille, autour de la maison."
                            }
                        ]
                    }
                ],
