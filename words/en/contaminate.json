{
    "word_family": [
        "contamination",
        "contaminant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ff3d40e-bc06-34fd-ac65-f14f1fdac532",
                    "sense_definition": "To make something dangerous or toxic by introducing impurities or foreign matter.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "pollution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory waste will <w>contaminate</w> the local river.",
                            "target_lang_translations": {
                                "ru": "Заводские отходы <w>загрязнят</w> местную реку."
                            }
                        },
                        {
                            "text": "Chemical spills can <w>contaminate</w> the soil for many years.",
                            "target_lang_translations": {
                                "ru": "Химические разливы могут <w>загрязнять</w> почву на долгие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "pollute",
                        "taint"
                    ],
                    "antonyms": [
                        "purify",
                        "cleanse"
                    ],
                    "common_phrases": [
                        "contaminate water",
                        "contaminate food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо опасным или токсичным путем внесения примесей или посторонних веществ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязня́ть",
                                "target_lang_sense_clarification": "процесс внесения примесей в окружающую среду или материалы"
                            },
                            {
                                "target_lang_word": "загрязни́ть",
                                "target_lang_sense_clarification": "результат внесения примесей или нежелательных компонентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1bc9de7-a900-301f-acf6-fea4a42dc2ca",
                    "sense_definition": "To make unfit for use by the introduction of unwholesome or undesirable elements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pollution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>contaminate</w> the clean sample with your dirty gloves.",
                            "target_lang_translations": {
                                "ru": "Не <w>загрязняйте</w> чистый образец своими грязными перчатками."
                            }
                        },
                        {
                            "text": "The spilled oil began to <w>contaminate</w> the entire supply of fresh water.",
                            "target_lang_translations": {
                                "ru": "Разлившаяся нефть начала <w>загрязнять</w> весь запас пресной воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoil",
                        "corrupt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать непригодным для использования из-за внесения нежелательных элементов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испо́ртить",
                                "target_lang_sense_clarification": "сделать непригодным для использования"
                            },
                            {
                                "target_lang_word": "загрязни́ть",
                                "target_lang_sense_clarification": "сделать непригодным через внесение примесей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5559dac-3615-3433-84fe-2028bfe43cb7",
                    "sense_definition": "To soil, stain, corrupt, or infect by contact or association.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He feared that his reputation would <w>contaminate</w> the project.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его репутация <w>осквернит</w> проект."
                            }
                        },
                        {
                            "text": "Scandals often <w>contaminate</w> the integrity of public institutions.",
                            "target_lang_translations": {
                                "ru": "Скандалы часто <w>порочат</w> честность государственных институтов."
                            }
                        }
                    ],
                    "synonyms": [
                        "taint",
                        "tarnish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осквернять, порочить или негативно влиять на что-либо через контакт или ассоциацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскверни́ть",
                                "target_lang_sense_clarification": "в контексте репутации или моральных ценностей"
                            },
                            {
                                "target_lang_word": "поро́чить",
                                "target_lang_sense_clarification": "в контексте подрыва чести или репутации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ce7bfc-ecb8-3e9e-b308-9c9c3ce66145",
                    "sense_definition": "To infect, usually of a deadly virus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus can <w>contaminate</w> the blood supply if not screened properly.",
                            "target_lang_translations": {
                                "ru": "Вирус может <w>заразить</w> запас донорской крови, если его не проверять должным образом."
                            }
                        },
                        {
                            "text": "Medical staff must take precautions so they do not <w>contaminate</w> other patients.",
                            "target_lang_translations": {
                                "ru": "Медицинский персонал должен принимать меры предосторожности, чтобы не <w>заразить</w> других пациентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "infect",
                        "transmit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заражать, обычно опасным вирусом или инфекцией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарази́ть",
                                "target_lang_sense_clarification": "в контексте передачи инфекции или вируса"
                            },
                            {
                                "target_lang_word": "инфици́ровать",
                                "target_lang_sense_clarification": "медицинский термин для передачи инфекции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6418b8a0-df70-3f6c-a9a3-da96124a42ae",
                    "sense_definition": "A <w>contaminated</w> state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pollution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes the soul as being <w>contaminate</w> by worldly desires.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает душу как <w>оскверненную</w> мирскими желаниями."
                            }
                        },
                        {
                            "text": "His speech was <w>contaminate</w> with archaic and confusing metaphors.",
                            "target_lang_translations": {
                                "ru": "Его речь была <w>загрязнена</w> архаичными и запутанными метафорами."
                            }
                        }
                    ],
                    "synonyms": [
                        "impure",
                        "tainted"
                    ],
                    "antonyms": [
                        "pure",
                        "untainted"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние загрязненности или оскверненности (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязне́нный",
                                "target_lang_sense_clarification": "состояние чего-либо, подвергшегося загрязнению"
                            },
                            {
                                "target_lang_word": "осквернённый",
                                "target_lang_sense_clarification": "литературный вариант для моральной или духовной нечистоты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}