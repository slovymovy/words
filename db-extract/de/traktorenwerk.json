                "senses": [
                    {
                        "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                        "entry_id": "1eaa9a61-9a8f-30e3-a39a-c2530c4cf6fe",
                        "glosses": [
                            "Gebäude(komplex), in dem in großer Stückzahl Traktoren gefertigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49959df-78b0-41ef-b25b-466acad5dcc2",
                                "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                                "text": "„Der Ministerrat der UdSSR verabschiedete im Mai 1929 einen Beschluss zum Bau eines Traktorenwerks im südlichen Ural.“"
                            },
                            {
                                "example_id": "d2a2d9fe-c7ab-4f5b-9b51-7792ffde119d",
                                "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                                "text": "Wir haben diese Arbeiten abgeschlossen und haben das Deutz-Fahr-Land, bestehend aus neuem Traktorenwerk sowie dem Besucher- und Schulungszentrum, der sogenannten Deutz-Fahr-Arena, dieser Tage offiziell eingeweiht."
                            },
                            {
                                "example_id": "14dc73b2-cc24-48a8-9533-99cf938eff6a",
                                "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                                "text": "Dieses Unternehmen hatte Ende der 1980er Jahre einen Umsatz von etwa 1.200 Millionen DDR-Mark und etwa 7.300 Beschäftigte, davon 4.600 im Traktorenwerk, 2.300 im Dieselmotorenwerk sowie 400 in verschiedenen Betriebsteilen."
                            },
                            {
                                "example_id": "f2a5a841-2923-4c38-950e-295aa8e0dafa",
                                "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                                "text": "Der aktuelle Umsatz des Traktorenwerks im Tiroler Unterland belief sich im Jahr 2016/2017 auf 72,5 Mio. Euro."
                            },
                            {
                                "example_id": "5065901a-f644-44c2-a6fd-fc31d010cb98",
                                "sense_id": "ed47dfcb-c504-34ff-87bc-56ebe238cf2b",
                                "text": "Die Kŭmsŏng General Tractor Factory oder vereinfacht Kŭmsŏng-Traktorenwerk ist ein Unternehmen in der Stadt Kŭmsŏng."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
