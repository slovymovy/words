            {
                "entry_id": "ce4b0edf-7d99-3969-bbf5-f513bcf45c44",
                "word": "shroff",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b674298-5ea2-405e-b2ef-4f8890a21bfe",
                        "entry_id": "ce4b0edf-7d99-3969-bbf5-f513bcf45c44",
                        "tags": [
                            "plural"
                        ],
                        "form": "shroffs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbd9db44-05f2-38ce-88f3-ae070cfc5ed8",
                        "entry_id": "ce4b0edf-7d99-3969-bbf5-f513bcf45c44",
                        "glosses": [
                            "A provider of financial services, especially a small-scale independent banker or money changer or (historical) a local expert at detecting bad coin."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "712ea093-6e04-4f10-b0d8-77bf8f96ff8c",
                                "sense_id": "fbd9db44-05f2-38ce-88f3-ae070cfc5ed8",
                                "text": "The sheraffs are poore and begerly."
                            },
                            {
                                "example_id": "97b52888-bf7f-44bb-87b5-9ea09aaa879c",
                                "sense_id": "fbd9db44-05f2-38ce-88f3-ae070cfc5ed8",
                                "text": "Amongſt whom were Shroffs, or Money-changers."
                            },
                            {
                                "example_id": "ee8e535d-2435-439a-9266-b7792f007500",
                                "sense_id": "fbd9db44-05f2-38ce-88f3-ae070cfc5ed8",
                                "text": "The breakfast soon dispatch'd, they're off,\nTo borrow money from a shroff."
                            },
                            {
                                "example_id": "bad909f8-d37c-45b7-9c47-bb72f987d072",
                                "sense_id": "fbd9db44-05f2-38ce-88f3-ae070cfc5ed8",
                                "text": "Racing leads to the shroff quicker than anything else."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3aba224-7d45-3a94-b257-bc35a1005cbb",
                        "entry_id": "ce4b0edf-7d99-3969-bbf5-f513bcf45c44",
                        "glosses": [
                            "A cashier, especially for a car park."
                        ],
                        "tags": [
                            "Hong-Kong"
                        ],
                        "examples": [
                            {
                                "example_id": "75a591df-11d5-4d7e-9a83-8578e3118fa3",
                                "sense_id": "e3aba224-7d45-3a94-b257-bc35a1005cbb",
                                "text": "An assistant shroff of the Queen Mary Hospital faced Mr. J. Reynolds at Central yesterday charged with the larceny of $10."
                            },
                            {
                                "example_id": "3023956b-eb80-423c-a9f4-a072b14187e1",
                                "sense_id": "e3aba224-7d45-3a94-b257-bc35a1005cbb",
                                "text": "It is a source of endless fascination to newcomers to Hong Kong to observe types of employment in the city rarely seen in other parts of the world. Where, away from here, would you come across a shroff, for example?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1a6a87f-2cc6-377e-8a76-b0bd139acdf9",
                        "entry_id": "ce4b0edf-7d99-3969-bbf5-f513bcf45c44",
                        "glosses": [
                            "The office of such a cashier at a car park etc."
                        ],
                        "tags": [
                            "Hong-Kong"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
