                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sehr geehrte <w>Damen</w> und Herren, ich begrüße Sie ganz herzlich zu unserem Treffen."
                        },
                        {
                            "text": "An der Haltestelle half der Schüler einer älteren <w>Dame</w> beim Einsteigen in den Bus."
                        }
                    ],
                    "antonyms": [
