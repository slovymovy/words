                                "example_id": "329fd4bb-cf72-42af-b889-1d0d9b4b083a",
                                "sense_id": "5564dda6-d210-3ddd-91a4-c5f58a0f0b69",
                                "text": "„Als er die Treppe hinabging, ließen ihn andere Klavierklänge stillstehen: Arpeggien, Dezimen überspannend, sonore Bass-Oktaven, wechselnde Harmoniefolgen.“"
                            },
                            {
                                "example_id": "9909c133-0fa5-44eb-823b-17a10814b4c3",
                                "sense_id": "5564dda6-d210-3ddd-91a4-c5f58a0f0b69",
                                "text": "„Ich ging so leise ich konnte auf das Haus zu, aus dem Aufenthaltsraum hörte ich Klavierklänge.“"
                            }
