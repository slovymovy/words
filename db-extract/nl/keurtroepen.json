                "entry_id": "4e985aed-9707-387c-840d-5f1f2140484d",
                "word": "keurtroepen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b2d0cc55-5e0b-4cf0-953b-4ba08fbf6944",
                        "entry_id": "4e985aed-9707-387c-840d-5f1f2140484d",
                        "tags": [
