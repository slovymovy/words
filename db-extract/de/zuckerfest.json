                                    {
                                        "sense_id": "a1b39c5b-03ed-3a32-9392-01ae59dea4ed",
                                        "entry_id": "fad8ca5b-fe5e-3473-90ae-0901ab6ea649",
                                        "glosses": [
                                            "een islamitisch feest waarop het einde van de ramadan gevierd wordt"
                                        ],
                                        "tags": [
                                            "feest"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cdf7bf6-8da6-4059-9638-0f311f8297dc",
                                                "sense_id": "a1b39c5b-03ed-3a32-9392-01ae59dea4ed",
                                                "text": "De beteekenis van het vasten leert ons het best de Ramadan (de vastenmaand). Het is verre, dat deze vastenmaand iets pijnlijks en onaangenaams zou zijn. neen, deze vasten met de daarbij behoorende gewoonten, heeft iets van de heerlijkheid en van het betooverde van den Engelschen Kersttijd. En deze vastentijd wordt besloten door drie feestdagen, die dikwijls het „suikerfeest” worden genoemd, naar de algemeene gewoonte om aan alle bezoekers kandy aan te bieden."
                                            }
                                        ]
                                    }
                                ]
                            }
