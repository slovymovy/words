                "senses": [
                    {
                        "sense_id": "9d23d11d-22ea-3ab3-a71e-1a7b61b6691a",
                        "entry_id": "103dfcd4-688c-3bbc-a14d-6bdaea81fb00",
                        "glosses": [
                            "сделать чистым, очистить какую-либо поверхность от чего-либо (от пыли, грязи, каких-либо наслоений)"
                        ],
                        "tags": [
                            "кого., что., и от чего. или без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "e31159a5-de42-4018-a02b-b26aec2cd74d",
                                "sense_id": "9d23d11d-22ea-3ab3-a71e-1a7b61b6691a",
                                "text": "До сих пор она довольно кротко и молчаливо исполняла свои нехитрые обязанности: вычистит сапоги, принесёт кипятку, а теперь позовёшь её — войдёт, вытаращит глаза и как будто бы старается не понимать, что говоришь."
                            },
                            {
                                "example_id": "933f9ab4-d95a-4ab4-b88f-798d9bd3ffc9",
                                "sense_id": "9d23d11d-22ea-3ab3-a71e-1a7b61b6691a",
                                "text": "Вычистить платье, обувь, самовар"
                            },
                            {
                                "example_id": "8247db0a-12c6-43c9-aa9b-d60fae344031",
                                "sense_id": "9d23d11d-22ea-3ab3-a71e-1a7b61b6691a",
                                "text": "Вычистить коня"
                            },
                            {
                                "example_id": "aac84f74-6d1f-47fe-8420-b82480f18f54",
                                "sense_id": "9d23d11d-22ea-3ab3-a71e-1a7b61b6691a",
                                "text": "Вычистить зубы"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a2045bb-03bd-3532-9529-fbf1c578e15b",
                        "entry_id": "103dfcd4-688c-3bbc-a14d-6bdaea81fb00",
                        "glosses": [
                            "освободить какое-либо пространство, объём от чего-либо накопившегося, загрязняющего"
                        ],
                        "tags": [
                            "что."
                        ],
                        "examples": [
                            {
                                "example_id": "8bcd25bc-c444-4819-be9f-474a7c731381",
                                "sense_id": "9a2045bb-03bd-3532-9529-fbf1c578e15b",
                                "text": "Вычистить сад, дорожки, пруд"
                            }
                        ]
                    },
                    {
                        "sense_id": "beae8a19-9b4f-3f56-b2d3-f43354b1e01b",
                        "entry_id": "103dfcd4-688c-3bbc-a14d-6bdaea81fb00",
                        "glosses": [
                            "удалить то, что засоряет, загрязняет, загромождает"
                        ],
                        "tags": [
                            "что."
                        ],
                        "examples": [
                            {
                                "example_id": "b71fb9cf-15a4-40d3-aaf9-740405213503",
                                "sense_id": "beae8a19-9b4f-3f56-b2d3-f43354b1e01b",
                                "text": "Вычистить весь снег на путях"
                            },
                            {
                                "example_id": "cd0bec66-d4e5-4905-b594-f711dbcdb11a",
                                "sense_id": "beae8a19-9b4f-3f56-b2d3-f43354b1e01b",
                                "text": "Вычистить завалы"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0bb1065-80fe-3f05-9fae-ae5625a89881",
                        "entry_id": "103dfcd4-688c-3bbc-a14d-6bdaea81fb00",
                        "glosses": [
                            "; приготовляя в пищу, освободить от кожуры, чешуи, оболочки, косточек; начистить в каком-либо количестве"
                        ],
                        "tags": [
                            "что., чего."
                        ],
