{
    "word_family": [
        "dark",
        "darken",
        "darkly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                    "sense_definition": "The state of having no light or very little light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden power cut plunged the entire house into absolute <w>darkness</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапное отключение электричества погрузило весь дом в полную <w>темноту</w>.",
                                "zh": "突然停电使整个房子陷入了绝对的<w>黑暗</w>。"
                            }
                        },
                        {
                            "text": "Her eyes took a few moments to adjust to the <w>darkness</w> of the cinema.",
                            "target_lang_translations": {
                                "ru": "Её глазам потребовалось несколько мгновений, чтобы привыкнуть к <w>темноте</w> кинотеатра.",
                                "zh": "她的眼睛花了几分钟才适应电影院里的<w>黑暗</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dark",
                        "blackness"
                    ],
                    "antonyms": [
                        "light"
                    ],
                    "common_phrases": [
                        "total darkness",
                        "pitch darkness",
                        "in the darkness",
                        "cover of darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние отсутствия или недостатка света",
                        "zh": "缺乏光线或光线极少的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темнота",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "тьма",
                                "target_lang_sense_clarification": "густая, непроглядная темнота"
                            },
                            {
                                "target_lang_word": "мрак",
                                "target_lang_sense_clarification": "полное отсутствие света"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑暗",
                                "target_lang_sense_clarification": "指光线不足或完全没有光线"
                            },
                            {
                                "target_lang_word": "漆黑",
                                "target_lang_sense_clarification": "形容非常黑暗，常用于形容环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                    "sense_definition": "Evil, wickedness, or a feeling of gloom and despair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel explores the <w>darkness</w> that lies within the human heart.",
                            "target_lang_translations": {
                                "ru": "Роман исследует <w>тьму</w>, скрытую в человеческом сердце.",
                                "zh": "这部小说探讨了潜藏在人心深处的<w>阴暗</w>。"
                            }
                        },
                        {
                            "text": "He fought hard to overcome the <w>darkness</w> of his depression.",
                            "target_lang_translations": {
                                "ru": "Он упорно боролся, чтобы преодолеть <w>мрак</w> своей депрессии.",
                                "zh": "他努力抗争，试图克服抑郁带来的<w>阴霾</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "light"
                    ],
                    "common_phrases": [
                        "powers of darkness",
                        "heart of darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зло, порочность или чувство уныния и отчаяния",
                        "zh": "指邪恶、罪恶，或一种忧郁、绝望的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тьма",
                                "target_lang_sense_clarification": "зло, порочность"
                            },
                            {
                                "target_lang_word": "мрак",
                                "target_lang_sense_clarification": "уныние, безнадёжность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴暗",
                                "target_lang_sense_clarification": "指心理或性格上的邪恶与消极"
                            },
                            {
                                "target_lang_word": "阴霾",
                                "target_lang_sense_clarification": "比喻笼罩在心头的忧郁或绝望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                    "sense_definition": "The quality of being dark in color or shade.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>darkness</w> of the storm clouds worried the sailors.",
                            "target_lang_translations": {
                                "ru": "<w>Темнота</w> грозовых туч беспокоила моряков.",
                                "zh": "乌云的<w>深色</w>让水手们感到担忧。"
                            }
                        },
                        {
                            "text": "She chose the fabric for the richness and <w>darkness</w> of its blue tone.",
                            "target_lang_translations": {
                                "ru": "Она выбрала ткань за насыщенность и <w>темноту</w> её синего оттенка.",
                                "zh": "她选择这种布料是因为其蓝色调的浓郁和<w>深色</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lightness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть тёмным по цвету или оттенку",
                        "zh": "颜色或色调深暗的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темнота",
                                "target_lang_sense_clarification": "насыщенность тёмного цвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深色",
                                "target_lang_sense_clarification": "指颜色浓重、深沉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                    "sense_definition": "A lack of knowledge, understanding, or clarity about something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are still in <w>darkness</w> regarding the true motives of the crime.",
                            "target_lang_translations": {
                                "ru": "Мы всё ещё пребываем в <w>неведении</w> относительно истинных мотивов преступления.",
                                "zh": "关于这起犯罪的真实动机，我们依然处于<w>不了解</w>的状态。"
                            }
                        },
                        {
                            "text": "Education is the only way to banish the <w>darkness</w> of ignorance.",
                            "target_lang_translations": {
                                "ru": "Образование — единственный способ изгнать <w>тьму</w> невежества.",
                                "zh": "教育是驱散<w>无知</w>的唯一途径。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток знаний, понимания или ясности в чём-либо",
                        "zh": "对某事缺乏了解、理解或清晰的认识。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неизвестность",
                                "target_lang_sense_clarification": "отсутствие информации"
                            },
                            {
                                "target_lang_word": "тьма",
                                "target_lang_sense_clarification": "невежество"
                            },
                            {
                                "target_lang_word": "неведение",
                                "target_lang_sense_clarification": "отсутствие осведомлённости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无知",
                                "target_lang_sense_clarification": "指缺乏知识或教育"
                            },
                            {
                                "target_lang_word": "不了解",
                                "target_lang_sense_clarification": "指对某事缺乏信息或认知"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}