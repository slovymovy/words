                "senses": [
                    {
                        "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                        "entry_id": "cc52154d-38ff-37fd-94d7-a3405c815d55",
                        "glosses": [
                            "Langue comorienne bantoue parlée à Mayotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e09c9c-fbd5-4b6c-8447-12fe7e42af36",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "Les actions sont menées aussi bien en français qu’en shimaoré."
                            },
                            {
                                "example_id": "fb0c3b4a-584c-439e-a5bd-f691211e9ab4",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "Le shimaoré est un parler bantou proche du swahili. Comme ce dernier, il est caractérisé par les classes nominales."
                            },
                            {
                                "example_id": "0a07084a-7119-41fb-8e01-1a9c8fcc7725",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "… Elle est chef du pôle enfance de l'association Tama — en shimaoré, la langue mahoraise, ce mot signifie « espoir »."
                            },
                            {
                                "example_id": "45aa18a4-0cb7-4770-bab6-1e9383c1018f",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "Un tel consensus mettrait un terme à près de 30 ans de discussions sur le statut, la pratique et l’avenir du shimaoré."
                            },
                            {
                                "example_id": "fccbd801-3e7c-4796-af8a-f34ce336748f",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "C’est pour cela qu’une jeune fille ne peut concourir si elle ne parle pas le shimaoré ou le kibushi."
                            },
                            {
                                "example_id": "80d625ec-2fdb-46e0-a028-11a1ba656cc5",
                                "sense_id": "ae716530-8d76-3bc7-a0fd-9b594010f737",
                                "text": "Le français n'est pas la langue maternelle des Mahorais, c'est le shimaoré."
                            }
                        ]
                    }
                ],
