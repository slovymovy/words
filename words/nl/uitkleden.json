                    "semantic_group_id": "ontkleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had zich net <w>uitgekleed</w> om naar bed te gaan.",
                            "target_lang_translations": {
                                "en": "He had just <w>undressed</w> to go to bed.",
                                "ru": "Он как раз <w>разделся</w>, чтобы лечь спать.",
                                "pl": "Właśnie się <w>rozebrał</w>, żeby pójść spać.",
                                "de": "Er hatte sich gerade <w>ausgezogen</w>, um ins Bett zu gehen.",
                                "fr": "Il venait de se <w>déshabiller</w> pour aller se coucher.",
                                "it": "Si era appena <w>spogliato</w> per andare a letto.",
                                "cs": "Právě se <w>svlékl</w>, aby šel spát.",
                                "tr": "Yatmak için tam yeni <w>soyunmuştu</w>.",
                                "es": "Se acababa de <w>desvestir</w> para irse a la cama."
                            }
                        },
                        {
                            "text": "Voordat je gaat douchen, moet je je eerst <w>uitkleden</w>.",
                            "target_lang_translations": {
                                "en": "Before you take a shower, you must first <w>undress</w>.",
                                "ru": "Перед тем как идти в душ, нужно сначала <w>раздеться</w>.",
                                "pl": "Zanim weźmiesz prysznic, musisz się najpierw <w>rozebrać</w>.",
                                "de": "Bevor du duschen gehst, musst du dich zuerst <w>ausziehen</w>.",
                                "fr": "Avant de prendre une douche, tu dois d'abord te <w>déshabiller</w>.",
                                "it": "Prima di fare la doccia, devi prima <w>spogliarti</w>.",
                                "cs": "Před sprchováním se musíš nejprve <w>svléknout</w>.",
                                "tr": "Duş almadan önce ilk olarak <w>soyunmalısın</w>.",
                                "es": "Antes de ducharte, primero tienes que <w>desvestirte</w>."
                            }
                        }
                    ],
