                        "form": "es ist unbildbar"
                    },
                    {
                        "form_id": "79029552-e1b1-4d87-87f5-4243f4d15df3",
                        "entry_id": "08dd401c-44dd-3a30-a2b0-b480297da248",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbildbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
                        "entry_id": "08dd401c-44dd-3a30-a2b0-b480297da248",
                        "glosses": [
                            "so, dass es nicht gebildet, geformt werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "920ccb6c-d502-4847-8b72-c18264b70c22",
                                "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
                                "text": "„Halte deinen Bruder für gut, und er ist es; vertraue dem Halbguten, und er wird gut! mute deinem Zöglinge Fähigkeiten zu, und er wird sie entwickeln, – halte ihn für unbildbar – und er wird es bleiben.“"
                            },
                            {
                                "example_id": "48ad3bc0-034b-489d-917a-1aa724eb655c",
                                "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
                                "text": "„Überhaupt ist ihre Meinung von uns, wir wüßten alles, was Andere wissen, aber wenig aus uns selbst, unser Geschmack sei ganz unbildbar, unsere Sprache zu rauh für die Dichtkunst.“"
                            },
                            {
                                "example_id": "440d84b9-7cd0-4fa5-969f-cba1a1873b00",
                                "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
                                "text": "„[Werner] ist daher von vorn an absolut unbildbar, und gibt den ästhetischen Menschen Preis. Doch vermag er auch vom Einzelnen zum Allgemeinen fortzugehen und sein Gewerbe mit einer gewissen Erhebung der Seele zu betrachten.“"
                            },
                            {
                                "example_id": "e08d4eed-fa0e-411b-b203-51a30da2c711",
                                "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
                                "text": "„Goethe stellt uns aber andere Persönlichkeiten dar, welche der Unfertigkeit Wilhelm's gegenüber entweder als absolut fertig oder absolut unbildbar erscheinen.“"
                            },
                            {
                                "example_id": "c782b9e7-55ca-436c-9029-15b6ae1785f3",
                                "sense_id": "6f5ee32d-43d2-310a-94fd-e3124cd8a5a9",
