                    {
                        "translation_id": "623abebf-60f6-4879-8702-a8a3c58ff09f",
                        "source_entry_id": "2292752d-629a-3184-b55f-7ebb28a2026d",
                        "target_lang_word": "obersorbisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obersorbisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a3c548e-7ab8-3756-a5da-a31591ed127f",
                                        "entry_id": "94af0d8b-a164-37fe-9010-ae097fe6f8ff",
                                        "glosses": [
                                            "sich auf den Oberlausitzer Teil der Sorben beziehend"
                                        ],
                                        "tags": [
                                            "Ethnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4400b4a2-1a9d-4550-ac80-abdb35fd98aa",
                                                "sense_id": "0a3c548e-7ab8-3756-a5da-a31591ed127f",
                                                "text": "„Die Sorben dieses Gebiets haben zum überwiegenden Teil ein obersorbisches Sprach– und Nationalbewusstsein.“"
                                            },
                                            {
                                                "example_id": "d7572ac8-d876-4dce-b0c2-8fcee21905b0",
                                                "sense_id": "0a3c548e-7ab8-3756-a5da-a31591ed127f",
                                                "text": "„Dies geht einerseits auf die Ergebnisse der deutschen Interferenz, andererseits aber auch auf die Bestrebungen der obersorbischen Intelligenz zurück, ihre Sprache zu slavisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69549086-c33b-3668-adfe-dcf97a34b40b",
                                        "entry_id": "94af0d8b-a164-37fe-9010-ae097fe6f8ff",
                                        "glosses": [
                                            "sich auf die slawische obersorbische Sprache beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3f4c7b3-1446-4cdf-ac4e-9308103e1047",
                                                "sense_id": "69549086-c33b-3668-adfe-dcf97a34b40b",
                                                "text": "„Die Sorben dieses Gebiets haben zum überwiegenden Teil ein obersorbisches Sprach– und Nationalbewusstsein.“"
                                            },
                                            {
                                                "example_id": "84ba53e3-4d16-40ab-9035-4720d1c25d8f",
                                                "sense_id": "69549086-c33b-3668-adfe-dcf97a34b40b",
                                                "text": "„In der Lausitz haben sich schließlich zwei Schriftsprachen herausgebildet: eine niedersorbische und eine obersorbische.“"
                                            },
                                            {
                                                "example_id": "182eb9f7-8bad-4bd9-b51e-9c843976c7e5",
                                                "sense_id": "69549086-c33b-3668-adfe-dcf97a34b40b",
                                                "text": "„Die Syntax der obersorbischen Volkssprache bildet einen stärkeren Gegensatz zu den anderen slavischen Sprachen als die der Schriftsprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
