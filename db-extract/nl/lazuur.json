                            {
                                "example_id": "bf8f5dc3-9bf4-4d62-8541-4ab3bdda4c8b",
                                "sense_id": "57f07157-2132-3b1f-96a8-03403a7be3d3",
                                "text": "Heet dit gesteente \"lazuur\"?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b446c17-9c57-391e-84a0-0f97c3f19b00",
                        "entry_id": "0a6e4e58-8d8e-373a-8f2e-7558b1096d0e",
                        "glosses": [
                            "bepaalde indringend blauwe kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7084273-7f05-4b72-9403-ab5b1142f9fd",
                                "sense_id": "5b446c17-9c57-391e-84a0-0f97c3f19b00",
                                "text": "Mijn lievelingskleur is lazuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d860b51-565f-335b-a55c-8e3dc2925acf",
                        "entry_id": "0a6e4e58-8d8e-373a-8f2e-7558b1096d0e",
                        "glosses": [
                            "blauw"
                        ],
                        "tags": [
                            "gebruikt als kleur in een wapenschild"
                        ],
                        "examples": [
                            {
                                "example_id": "6a50d9ae-3082-4fda-bce6-5ae0e454ac41",
                                "sense_id": "8d860b51-565f-335b-a55c-8e3dc2925acf",
                                "text": "In 1825 had de Hoge Raad van Adel officieel vastgesteld dat het Sittardse stadswapen zou bestaan uit acht slangenkoppen van goud, gerangschikt in kruisvorm op een schild van lazuur, met gouden kroon."
                            }
                        ]
                    },
                    {
                        "sense_id": "02a64940-dae5-34cd-a220-5499ddfdabb0",
                        "entry_id": "0a6e4e58-8d8e-373a-8f2e-7558b1096d0e",
                        "glosses": [
                            "transparante verflaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8176ff-d743-4f3d-abc6-c0d356f84529",
                                "sense_id": "02a64940-dae5-34cd-a220-5499ddfdabb0",
                                "text": "De kleurloze lazuur is enkel bedoeld voor de renovatie van hout dat al gelazuurd of gekleurd is of om andere kleuren lichter te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "c537f239-e88e-3bba-b976-7f8e60296c1d",
                        "entry_id": "0a6e4e58-8d8e-373a-8f2e-7558b1096d0e",
                        "glosses": [
                            "transparante verf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58cafd0b-d974-4bef-8ba5-9d40161ba8e2",
                                "sense_id": "c537f239-e88e-3bba-b976-7f8e60296c1d",
                                "text": "Voor een duurzaam en makkelijk te onderhouden oppervlak, adviseren wij dit te behandelen met olie, was, lak, verf of lazuur."
                            }
                        ]
                    }
                ],
