                    {
                        "translation_id": "43b05b0d-6a3e-43fb-b8e5-6c3390431f1e",
                        "source_entry_id": "a5bb2685-7d78-3fdf-b0e8-e325cc0b1450",
                        "source_sense_id": "4b39912c-faf6-38dc-8f66-5f7942fb3b2b",
                        "source_sense_description": "gleichbedeutend mit Nomen appellativum; lateinische Bezeichnung für Gattungsname",
                        "target_lang_word": "appellatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appellatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04865620-d051-3089-84ff-ab542bc69ad6",
                                        "entry_id": "0f8e43b1-43b0-39f7-9890-f35299e811db",
                                        "glosses": [
                                            "Qualifie un nom commun à toute une espèce, ou à tout un genre, par opposition à nom propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e305387-2517-46b2-a6ff-38b9c0177d4e",
                                                "sense_id": "04865620-d051-3089-84ff-ab542bc69ad6",
                                                "text": "Homme, arbre sont des noms appellatifs."
                                            },
                                            {
                                                "example_id": "7a3eb3e8-fa5a-48f9-8455-7d4f0d70e452",
                                                "sense_id": "04865620-d051-3089-84ff-ab542bc69ad6",
                                                "text": "Le nom commun ou appellatif est celui qui convient à tout un genre, à toute une espèce; ainsi le mot arbre est un nom appellatif, parce qu’il comprend la classe des végétaux pourvus de qualités semblables qui les ont fait ranger sous cette dénomination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a528f1b9-3bd1-3d64-8d14-d7f5c665235b",
                                        "entry_id": "0f8e43b1-43b0-39f7-9890-f35299e811db",
                                        "glosses": [
                                            "Se dit de sons qui se marient bien ensemble, entre lesquels il semble y avoir une affinité"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "appellatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a35257-5173-31f1-b52b-11bc0b712cd4",
                                        "entry_id": "dcef02c5-e706-3135-becc-618f912ac246",
                                        "glosses": [
                                            "Terme qui adresse ou réfère à une personne, en particulier pour appeler ou interpeller les allocutaires, comme « papa », « monsieur » ou tout terme d’adresse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48b7f310-12fd-3f6e-94e6-71b8f525db9b",
                                        "entry_id": "dcef02c5-e706-3135-becc-618f912ac246",
                                        "glosses": [
                                            "Fonction vocative ; fonction énonciative (ou fonction syntaxique) d’appel de l’allocutaire remplie par un terme d’adresse (un appellatif au sens précédent)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d31a370-fb91-355d-a769-17ffd38924b0",
                                        "entry_id": "dcef02c5-e706-3135-becc-618f912ac246",
                                        "glosses": [
                                            "Mot-outil de type déterminant ou pronom personnel qui, dans certaines langues, désigne la position sociale d’une personne par rapport à soi lorsque l’on s’adresse à elle, à la manière d’une particule ou d’un titre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70410618-d127-4e15-ac5f-505d91a89abc",
                                                "sense_id": "9d31a370-fb91-355d-a769-17ffd38924b0",
                                                "text": "On trouve pā comme appellatif appliqué au garçon."
                                            },
                                            {
                                                "example_id": "22e1b8b1-2a6f-4a4a-bb61-e20edb46b9e4",
                                                "sense_id": "9d31a370-fb91-355d-a769-17ffd38924b0",
                                                "text": "Je connais M. Đại (il s’arrête sur la manière de prononcer le nom Đại, le vietnamien étant une langue à tons, et ajoute devant l’appellatif anh, anh Đại, qui indique la marque de l’aînesse et signifie « grand frère »), mais les communistes l’ont obligé à partir après."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c42dd12f-77c9-3f8b-b356-7e00287804c6",
                                        "entry_id": "dcef02c5-e706-3135-becc-618f912ac246",
                                        "glosses": [
                                            "Substantif servant à désigner toute une classe d'individus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0f7a51-8d0f-4ce1-987b-729aa30f2b50",
                                                "sense_id": "c42dd12f-77c9-3f8b-b356-7e00287804c6",
                                                "text": "Les Parisii, peuple gaulois, ont donné leur nom à la ville de Paris qui a fourni l'appellatif Parisiens pour désigner ses habitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
