                {
                    "sense_id": "2e95e809-7355-3647-89e4-274b108e10d3",
                    "sense_definition": "A method of starting or restarting play in field hockey in which two opposing players tap their sticks together before attempting to hit the ball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee signaled for a <w>bully</w> to restart the game after the injury.",
                            "target_lang_translations": {
                                "ru": "Судья назначил <w>спорный мяч</w>, чтобы возобновить игру после травмы.",
                                "nl": "De scheidsrechter floot voor een <w>bully</w> om het spel na de blessure te hervatten.",
                                "de": "Der Schiedsrichter pfiff nach der Verletzungspause einen <w>Bully</w>, um das Spiel fortzusetzen."
                            }
                        },
                        {
                            "text": "Players must stand squarely during the <w>bully</w>.",
                            "target_lang_translations": {
                                "ru": "Игроки должны стоять прямо во время <w>розыгрыша спорного мяча</w>.",
                                "nl": "Spelers moeten recht tegenover elkaar staan tijdens de <w>bully</w>.",
                                "de": "Die Spieler müssen während des <w>Bullys</w> direkt gegenüberstehen."
                            }
