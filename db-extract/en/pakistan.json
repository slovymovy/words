                        "cross_references": [
                            {
                                "target_word": "Pakistan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dbad2080-b6eb-3e3d-bc55-d189db24fd07",
                                        "entry_id": "69154a42-b50e-3c7a-b5a7-60004c7bd15a",
                                        "glosses": [
                                            "een land in het zuiden van Azië grenzend aan India, Afghanistan, Iran en China. De officiële naam is de Islamitische Republiek Pakistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be01028-3a17-4a8c-82b3-2e5cb23981ae",
                                                "sense_id": "dbad2080-b6eb-3e3d-bc55-d189db24fd07",
                                                "text": "Tijdens het lopen beluisterde ik veel audioboeken en ik was erg geïnspireerd geraakt door het verhaal van Malala, het 13-jarige meisje uit Pakistan waarin ze het lot beschrijft van meisjes die van het Taliban-regime niet naar school mogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d7557ba-8c13-4429-af23-4403cb599350",
                        "source_entry_id": "86c7d40d-ac26-399c-9b26-cbc756a356b1",
                        "source_sense_id": "3d38b989-3a9e-3aea-9e95-2ed75c0697c8",
                        "source_sense_description": "country in South Asia",
                        "target_lang_word": "Pakistan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pakistan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7182a0-9f8c-3188-aff1-f5f3cf74c8cc",
                                        "entry_id": "e4fd1476-b2cd-3ebf-bea9-9599af8812ea",
                                        "glosses": [
                                            "Pays asiatique entouré par l’Iran, l’Afghanistan, la Chine, l’Inde et la mer d’Oman, dont la capitale est Islamabad."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8a66e64-0c5e-40f6-a449-9124e635b996",
                                                "sense_id": "fd7182a0-9f8c-3188-aff1-f5f3cf74c8cc",
                                                "text": "En 1947, l'Empire des Indes a été divisé pour donner naissance, à la suite d'une partition sanglante, à deux États, l'Inde et le Pakistan, celui-ci rassemblant deux territoires situés de part et d'autre de l'Inde. La partie orientale s'est détachée du Pakistan occidental en 1971, en créant le Bangladesh."
                                            },
                                            {
                                                "example_id": "1761969c-b719-4ae1-a107-4bde78aedd7b",
                                                "sense_id": "fd7182a0-9f8c-3188-aff1-f5f3cf74c8cc",
                                                "text": "Seuls les passagers des avions en provenance de l’ouest sont soumis au flytoxage. Les avions venant d’Extrême-Orient ne sont jamais désinfectés. Le Pakistan ne craint que les miasmes occidentaux."
                                            },
                                            {
                                                "example_id": "58c9843e-db41-49e6-a5e9-190f8fe37185",
                                                "sense_id": "fd7182a0-9f8c-3188-aff1-f5f3cf74c8cc",
                                                "text": "C’est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s’allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c63f03a1-930c-4903-baa9-ed5874c7b1bb",
                        "source_entry_id": "86c7d40d-ac26-399c-9b26-cbc756a356b1",
                        "source_sense_id": "3d38b989-3a9e-3aea-9e95-2ed75c0697c8",
