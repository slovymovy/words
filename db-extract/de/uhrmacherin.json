                                        "sense_id": "190314cc-96b2-3f9f-90b2-50cd3a738eb7",
                                        "entry_id": "eeabd76e-f2d4-367b-bbf0-58ff45e75c7f",
                                        "glosses": [
                                            "A craftsperson or company who makes and/or maintains clocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603ad2ea-d6f4-4514-95e7-d74b3b5144be",
                                                "sense_id": "190314cc-96b2-3f9f-90b2-50cd3a738eb7",
                                                "text": "There were hundreds of clockmakers in London during that era."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b230ea-bbde-330b-afb7-c72d96973f15",
                                        "entry_id": "eeabd76e-f2d4-367b-bbf0-58ff45e75c7f",
                                        "glosses": [
                                            "God in His role as the creator of the clockwork universe."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc00fcb-f35a-4e1f-9a17-6a1d9a678ff0",
                                                "sense_id": "d8b230ea-bbde-330b-afb7-c72d96973f15",
                                                "text": "Near-synonym: watchmaker"
                                            },
                                            {
                                                "example_id": "829f8693-0143-4be7-9612-c2505a86cb6d",
                                                "sense_id": "d8b230ea-bbde-330b-afb7-c72d96973f15",
                                                "text": "We have the great clockmaker to thank for these glorious sunrises and sunsets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae1d41fc-ce75-4d65-8add-1e7bd94bc51e",
                        "source_entry_id": "3fada2c6-d7b7-3369-94c7-309a14101128",
                        "source_sense_id": "8f346d7c-e809-39fd-b611-cf50377a7090",
                        "target_lang_word": "horlogère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horlogère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                        "entry_id": "d53aca33-0129-3ad2-b774-a577602d371e",
                                        "glosses": [
                                            "Celle qui crée, vend et répare les horloges, les pendules et les montres."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671624da-a9a0-4a0e-bf37-018eb6825aea",
                                                "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                                "text": "Puis il fait parler l’horlogère en fureur, avec les mesmes paroles que Virgile donne à Didon parlant à Enée."
                                            },
                                            {
                                                "example_id": "04986fda-8cad-44f3-b04c-653394be5589",
                                                "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                                "text": "Il travaillait avec ses deux vieilles filles de sœurs, horlogères d'ailleurs accomplies, qui vivaient la loupe à l'orbite et ne sortaient que le samedi pour venir impasse Vandamme et passer la soirée dans les joies saugrenues d'une « banque » dont l'enjeu était de haricots blancs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b53331-804e-3ef2-93e4-abe60b78fb7d",
                                        "entry_id": "d53aca33-0129-3ad2-b774-a577602d371e",
                                        "glosses": [
                                            "Épouse d’un horloger."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4618aba4-98d7-484a-be48-e20c25263558",
                                                "sense_id": "33b53331-804e-3ef2-93e4-abe60b78fb7d",
                                                "text": "L’horlogère met encore son corsage d’il y a deux ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horlogère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e725b9bd-6f64-3a63-8ff8-ff8128d583e7",
                                        "entry_id": "2cd56126-74e5-361f-94e1-eeaa57eacd89",
                                        "glosses": [
                                            "Féminin singulier de horloger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b8f8e9-9764-4d39-832e-0341a9401350",
                                                "sense_id": "e725b9bd-6f64-3a63-8ff8-ff8128d583e7",
                                                "text": "Un ouvrage de référence, faisant état de l’ensemble des connaissances actuelles de la discipline, s’imposait : ce Traité de construction horlogère, sans équivalent et rédigé par des spécialistes de l’enseignement."
                                            }
                                        ]
                                    }
                                ]
