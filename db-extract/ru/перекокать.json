                        "target_lang_word": "zerschlagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "635d41df-e580-39cc-8391-b00c36addf4c",
                                        "entry_id": "44a6fff9-1e61-3273-90d6-353131a053e9",
                                        "glosses": [
                                            "etwas mit einem oder mehreren kräftigen Hieben zerstören"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bf2516-8df5-49cc-a3d1-1638f80914ad",
                                                "sense_id": "635d41df-e580-39cc-8391-b00c36addf4c",
                                                "text": "Wir könnten den Schrank zerschlagen und verbrennen."
                                            },
                                            {
                                                "example_id": "c4e799ea-2a73-4259-bff9-9eb5e3261029",
                                                "sense_id": "635d41df-e580-39cc-8391-b00c36addf4c",
                                                "text": "„Die silberne Kaffeekanne ist umgefallen und hat ihren Inhalt über das Tischtuch ergossen und einen Frühstücksteller zerschlagen.“"
                                            },
                                            {
                                                "example_id": "e079c836-8c70-4f24-ad9a-946dc2b70be1",
                                                "sense_id": "635d41df-e580-39cc-8391-b00c36addf4c",
                                                "text": "„In einer Zeremonie zerstören sie die Trophäen, brechen die Schwerter entzwei und zerschlagen die Schilde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "effce6f6-73a0-3cfd-8809-0cefe53099dd",
                                        "entry_id": "44a6fff9-1e61-3273-90d6-353131a053e9",
                                        "glosses": [
                                            "eine gegnerische Gruppe von Menschen unschädlich machen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a853933f-b7f9-4889-b800-d16bbe89ea31",
                                                "sense_id": "effce6f6-73a0-3cfd-8809-0cefe53099dd",
                                                "text": "Die Polizei hat einen Drogendealerring zerschlagen."
                                            },
                                            {
                                                "example_id": "0b9ff2e4-a317-4623-b73c-6cb20341784f",
                                                "sense_id": "effce6f6-73a0-3cfd-8809-0cefe53099dd",
                                                "text": "Die gegnerischen Truppen wurden zerschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d81aa541-29e6-36c0-bae0-4395d61c8249",
                                        "entry_id": "44a6fff9-1e61-3273-90d6-353131a053e9",
                                        "glosses": [
                                            "etwas in kleinere Einheiten aufteilen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206211f5-b953-4663-925f-b4e2461d7616",
                                                "sense_id": "d81aa541-29e6-36c0-bae0-4395d61c8249",
                                                "text": "Der Investor will die Firma zerschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fb0994c2-f4f7-31c7-880f-1b520858b92b",
                                        "entry_id": "44a6fff9-1e61-3273-90d6-353131a053e9",
                                        "glosses": [
                                            "scheitern, nicht zum Erfolg führen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffc9596-e071-4df9-bd8c-72ad77995ec8",
                                                "sense_id": "fb0994c2-f4f7-31c7-880f-1b520858b92b",
                                                "text": "Alle Hoffnungen auf einen schnellen Friedensprozess haben sich zerschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
