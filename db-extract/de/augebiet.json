                "senses": [
                    {
                        "sense_id": "66b62a10-1cab-3c48-b9a3-9a1bc7e4e1ff",
                        "entry_id": "84aed234-48a8-34b3-b6b6-3057215c10a0",
                        "glosses": [
                            "von Bäumen bestandene feuchte Flusslandschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887ed88d-8bd4-40c1-ba86-4adc19a473c8",
                                "sense_id": "66b62a10-1cab-3c48-b9a3-9a1bc7e4e1ff",
                                "text": "„Heute bedeckt der Bezirk das Gebiet zwischen Alser Straße und Donaukanal, wobei ein Steilrand zwischen Währinger Straße und Liechtensteinstraße das tiefer gelegene einstige Augebiet von einem Höhenrücken trennt, der seinerseits wieder von Bachbetten (die inzwischen überwölbt wurden, jedoch in den Straßenzügen kenntlich geblieben sind) durchfurcht wird […]“"
                            },
                            {
                                "example_id": "eda8c585-4bd4-4639-99cb-e834db3cfcc6",
                                "sense_id": "66b62a10-1cab-3c48-b9a3-9a1bc7e4e1ff",
                                "text": "„Der Bürgermeister bezog sich da auf einige Bewohner einer überschwemmten Siedlung, die aufgefordert worden waren, das Augebiet zu verlassen – das aber ignorierten, um schließlich unter teilweise lebensgefährlichen Umständen geborgen zu werden.“"
                            },
                            {
                                "example_id": "6050aebc-c320-4025-8f8a-69795e809202",
                                "sense_id": "66b62a10-1cab-3c48-b9a3-9a1bc7e4e1ff",
                                "text": "„Gerade im Bereich von Orth, wo das Augebiet seine größte Ausdehnung hat, wurde durch die Verbindung von Altarmen mit der Donau eine ungeahnte Dynamik in das Ökosystem der Au gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
