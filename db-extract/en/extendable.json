                        "glosses": [
                            "Capable of being extended."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d139db2-95aa-4081-b91c-0a6cb2f19f05",
                                "sense_id": "5ebe0c7f-a81a-3628-a5b0-39e7d873dc76",
                                "text": "The extendable boom of the arm is designed to reach out 10 feet and have a lateral range of 120 degrees."
                            }
                        ]
