                        "examples": [
                            {
                                "example_id": "600d2a70-9a6f-4b5c-8e16-5d24945c18c9",
                                "sense_id": "d0abd301-a936-3a3d-9685-ef0ce82e8010",
                                "text": "„Unnachgiebig zwar mit ihrem Mündchen, war sie doch mit den Füßchen rasch auf dem Sprunge.“"
                            },
                            {
                                "example_id": "a7da345b-d4f1-4b69-99ff-566ea907a810",
                                "sense_id": "d0abd301-a936-3a3d-9685-ef0ce82e8010",
                                "text": "„Bergier spitzte sein rosiges Mündchen, als wollte er pfeifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
