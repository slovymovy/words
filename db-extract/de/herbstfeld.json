                        "glosses": [
                            "Feld im Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78605aba-0f50-4b2b-91bb-c733ad691a32",
                                "sense_id": "76268cbb-e617-3a08-8a4a-bd7ce27dc28f",
                                "text": "„Der Kesselflicker hörte es noch lange die Straße hinab. Hörte es fern hinter den kalten dunstenden Herbstfeldern, hinter dem Geräusch seiner Schüsseln, die durch die Nacht klirrten wie Bojen vor einer düsteren öden Küste, hörte es abklingen, hörte es schließlich verstummen, verloren wie der Schrei von Seevögeln in ihren weiten salzschwarzen Einsamkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
