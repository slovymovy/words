                        "examples": [
                            {
                                "example_id": "63570b03-4baf-4dfc-b65d-6b157c14ec76",
                                "sense_id": "ffd1ee8c-316d-3ad3-8433-136a6363d14d",
                                "text": "Buitenwerk: Algemene benaming voor delen van een vesting welke vóór de hoofdwal doch binnen de bedekte weg respectievelijk het glacis zijn gelegen; bij voorbeeld: contregarde, couvre-face, halve maan, hoornwerk, kroonwerk, ravelijn, tenaille, enz.; niet te verwarren met voorwerk."
                            }
                        ]
