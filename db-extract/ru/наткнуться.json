                    },
                    {
                        "sense_id": "003a19d4-a6d1-315b-917d-b4bbc6fd9afa",
                        "entry_id": "cac6c34b-f5bc-3929-b76d-0ade1072e237",
                        "glosses": [
                            "to stumble upon, to come across, to encounter by chance"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660ceb4a-a621-417a-b9a9-9de04886c0a1",
                                "sense_id": "003a19d4-a6d1-315b-917d-b4bbc6fd9afa",
                                "text": "Я́ неда́вно наткну́лся на но́вую статью́, кото́рая хорошо́ объясня́ет всю́ э́ту ситуа́цию.",
                                "translation": "I recently came across a new article that explains this whole situation very well.",
                                "english": "I recently came across a new article that explains this whole situation very well."
                            }
                        ]
