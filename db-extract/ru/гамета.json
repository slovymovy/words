                    {
                        "translation_id": "dd87b886-68a7-420c-bca8-952226f3ae4f",
                        "source_entry_id": "4a1dbe94-26ee-33ff-a743-b08da3cd1c77",
                        "source_sense_id": "8057b947-c798-3340-ba5c-e83080c27449",
                        "target_lang_word": "Gamet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gamet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9c7b83-9c87-39bd-b51c-036c035c7ba0",
                                        "entry_id": "3e77d462-d65a-30b9-9545-c8019d557db8",
                                        "glosses": [
                                            "Zelle, die bei Menschen, Tieren und Pflanzen der geschlechtlichen Fortpflanzung dient (haploide Eizelle und haploide Samenzelle)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39a0401-4110-4185-a47d-e429ba44e19c",
                                                "sense_id": "fc9c7b83-9c87-39bd-b51c-036c035c7ba0",
                                                "text": "Bei den meisten einzelligen Flagellaten sind beide Gameten (weiblich, männlich oder +, -) meist gleich groß: Isogamie. Bei primitiven Mehrzellern ist eine Tendenz zur Produktion ungleich großer Geschlechtszellen (beweglichen Gameten) festzustellen. Die weiblichen Gameten sind größer als die.männlichen: Heterogamie oder Anisogamie."
                                            },
                                            {
                                                "example_id": "e71947fd-2271-446f-aa02-1a87d65176b7",
                                                "sense_id": "fc9c7b83-9c87-39bd-b51c-036c035c7ba0",
                                                "text": "Ja, es kann sogar sein, dass in der zweiten Hälfte des 21. Jahrhunderts viele Menschen bei Eintritt der Sexualreife einige Gameten einfrieren und sich dann sterilisieren lassen werden, bevor sie auf jene Gameten zum Zwecke der Fortpflanzung zurückgreifen; sie werden dahingehend argumentieren, die Qualität der Gene in jugendlichen Gameten sei besser."
                                            },
                                            {
                                                "example_id": "2a4cb921-db76-4217-80fe-b439c718a55f",
                                                "sense_id": "fc9c7b83-9c87-39bd-b51c-036c035c7ba0",
                                                "text": "In der nassen Umgebung schlüpfen aus den Sporen kleine begeißelte Zellen, die Gameten. Sie schlängeln sich mit ihrem winzigen Schwanz durch den Wald auf der Suche nach Geschlechtspartnern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
