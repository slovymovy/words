    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                "word": "railwayman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eeb9efb3-c9ad-4912-9c8b-14b9dfd806e1",
                        "entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "tags": [
                            "plural"
                        ],
                        "form": "railwaymen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
                        "entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "glosses": [
                            "A man who works on a railway."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d961d9b5-9a80-44e6-a7c3-782cd78c165b",
                                "sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
                                "text": "The spirit of the local railwaymen in this emergency is shown by the Helensburgh fireman who heard the news at 8 a.m. on his radio and immediately went to the depot of his own accord to see what help he could give."
                            },
                            {
                                "example_id": "9939b6e7-3846-4f98-b5f1-928556fe75f0",
                                "sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
                                "text": "Nizan was, of course, Marxist and he did use his Marxist intelligence—although, thank God, never the jargon—to show the [economic] and emotional cost of the life of Antoine Bloye, a [working‐class] railwayman who made the painful rise to become a railway functionary and a member of the petit bourgeoisie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "251c96d1-0c9f-4431-be91-b89b0f3662e8",
                        "source_entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "source_sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
                        "source_sense_description": "man who works on a railway",
                        "target_lang_word": "spoorwegman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoorwegman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                        "entry_id": "7013974d-dd8e-3407-a653-18257d2c1038",
                                        "glosses": [
                                            "iemand die werk bij een spoorwegbedrijf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d5a72be-f9d6-4fb4-977e-a9b2b1205751",
                                                "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                                "text": "Langs het treinstel drentelde inderdaad een spoorwegman in uniform die de wagons in het oog hield."
                                            },
                                            {
                                                "example_id": "a417fa09-7bb1-4235-8111-dd27524f4581",
                                                "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                                "text": "De ontsnapping was gelukt, maar hoe moest het verder? \"Ik ging naar een spoorwegman toe met de vraag of hij me kon helpen. Maar hij zei 'nee' en holde weg. Gek hé, dat beeld vergeet ik nooit.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bb7765d-69a4-4107-af2d-38a3fe928747",
                        "source_entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "source_sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
                        "source_sense_description": "man who works on a railway",
                        "target_lang_word": "cheminot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2ed191-78da-3922-a67b-0692b8b51361",
                                        "entry_id": "e31c5528-c45f-327a-a3bb-f8ab06a3556d",
                                        "glosses": [
                                            "Relatif aux chemins de fer, aux employés des chemins de fer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9dc97b-6dfb-412e-8e8f-2792a6109efd",
                                                "sense_id": "3d2ed191-78da-3922-a67b-0692b8b51361",
                                                "text": "Il dit surtout tenir compte de l’échec des deux dernières grandes mobilisations cheminotes, en avril 2010 (sur des revendications internes) et, cet automne, contre les retraites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                        "entry_id": "34a2ebb0-3623-3df3-8773-23c8f4fe33c4",
                                        "glosses": [
                                            "Employé des chemins de fer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9899bd2-c44f-4564-a8e9-e169b8121f8b",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Lorsque Pizarro, le mécanicien de l’Aquila Azteca, immobilise sa locomotive à la verticale du signal rouge, il est stupéfait de voir surgir sur le marchepied gauche un cheminot en salopette, le visage barbouillé de cambouis."
                                            },
                                            {
                                                "example_id": "9c56363c-e582-4d8a-82f2-c2a4e4d01c5b",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Il oppose les « anciens », les T5 (conducteurs de grandes lignes ou « tégévistes ») et autres « sénateurs du rail », syndiqués dans leur grande majorité à la CGT ou à la FGAAC (Fédération générale autonome des agents de conduite), aux T4 (conducteurs de banlieue), plus jeunes et dotés d'une culture distincte de celle de la corporation traditionnelle des cheminots."
                                            },
                                            {
                                                "example_id": "fbfbbdcd-ad92-4620-9207-45aae1a1dc94",
                                                "sense_id": "572f3bcc-b9ff-3c1d-8382-f173cac8824b",
                                                "text": "Dans les cortèges qui défilent aux quatre coins du pays se mêlent employés de banque, contrôleurs aériens, cheminots, enseignants et travailleurs de la santé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheminot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "122698b8-9560-30b1-8704-d428647c97ca",
                                        "entry_id": "0c7c46e0-b532-3306-a889-537c09c9f9c1",
                                        "glosses": [
                                            "Autre orthographe de chemineau"
                                        ],
                                        "tags": [
                                            "Rouen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5a05309-ad19-4771-be1b-f8a518c9d211",
                                                "sense_id": "122698b8-9560-30b1-8704-d428647c97ca",
                                                "text": "A Rouen, on consommait des cheminots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b05186-d2d0-49be-b202-872de027ee85",
                        "source_entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "source_sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
