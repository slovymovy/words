                    },
                    {
                        "form_id": "6d44877b-c9e2-43b8-b4be-cdac66439be0",
                        "entry_id": "833dca28-29c1-3caa-9d9b-1febbd144f20",
                        "tags": [],
                        "form": "mougik"
                    },
                    {
                        "form_id": "184e9629-173e-486b-a68d-3b43c5e5675c",
                        "entry_id": "833dca28-29c1-3caa-9d9b-1febbd144f20",
                        "tags": [],
                        "form": "moujick"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                        "entry_id": "833dca28-29c1-3caa-9d9b-1febbd144f20",
                        "glosses": [
                            "Nom des paysans dans la Russie impériale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f25039-31cc-4daa-a3c0-e0c10f33af08",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "Croyez-vous, s’écrie-t-il, croyez-vous qu’il m’a demandé un pourboire, cet ivrogne de moujik !"
                            },
                            {
                                "example_id": "713b12e6-b93b-4ba6-a393-9b4b8e4e48d2",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "Les « bourreurs de crâne » n’auraient pas eu de peine, sans doute, à surhommiser des milliers de braves et pauvres moujiks."
                            },
                            {
                                "example_id": "c06498e9-3484-47d9-ae7d-32f664937993",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "Le tumulte attira enfin les paysans d’un village heureusement voisin. Pareils spectacles sont pour notre moujik une vraie bénédiction ; il y court comme les étrangers se précipitent au club ou sur les gazettes."
                            },
                            {
                                "example_id": "83174782-5013-42b4-8a45-ad72d217f282",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "Les déplorables événements que nous traversons suffiraient-ils donc à transformer un prince en moujik sous le rapport de la plus élémentaire politesse ?"
                            },
                            {
                                "example_id": "3d6cd7e3-fdb2-4c55-a083-f816298da43a",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "« Tout est à Madame, aussi loin que vous regardiez ! » ne manque jamais de proclamer Duberc tout le long de la route, avec son étrange orgueil de moujik…"
                            },
                            {
                                "example_id": "02c00440-9ae0-4bd5-8817-e8d9af7a160c",
                                "sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                                "text": "On faisait venir les enfants des métayers pour jouer avec elle. « Qué diz à mamizelle ? » Ils lui étaient soumis comme les petits moujiks aux petits boyards du temps du servage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b315ef43-1297-432a-9afb-7221fccb576c",
                        "source_entry_id": "833dca28-29c1-3caa-9d9b-1febbd144f20",
                        "source_sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                        "source_sense_description": "Paysan russe de l’époque impériale",
                        "target_lang_word": "Muschik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muschik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45655037-ac49-3337-8989-37ffb8bce5eb",
                                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                                        "glosses": [
                                            "ein einfacher russischer Bauer im zaristischen Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88b1055-d95c-4d32-a56c-ba2e03bc381b",
                                                "sense_id": "45655037-ac49-3337-8989-37ffb8bce5eb",
                                                "text": "„Während der Jahre der Revolution, 1905-07, betrachtete Lenin es als wichtig, vom russischen Muschik zu lernen.“ (Tony Cliff, „Lenin 1“, 11. Der Muschik im Aufstand)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fff182eb-a46a-347e-a1e3-b80a8dc88244",
                                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                                        "glosses": [
                                            "ein russischer Mann oder Alter (bei der Anrede)"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2a285a22-89e8-3c15-b782-cfc10b0bb46a",
                                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                                        "glosses": [
                                            "ein russischer Soldat"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95bde0e9-5e7e-4457-8cf8-b0857197f9b0",
                                                "sense_id": "2a285a22-89e8-3c15-b782-cfc10b0bb46a",
                                                "text": "„Und wie anders sollte ein russischer Muschik, der auf dem Vormarsch gesehen hatte, den Aufruf Schukows verstehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f797d5d0-9fb3-3381-8755-2ad92b473823",
                                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                                        "glosses": [
                                            "ein Häftling im Hochsicherheitstrakt eines russischen Gefängnisses"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7580ffa-a382-4f2c-8771-980d0d41f4e6",
                        "source_entry_id": "833dca28-29c1-3caa-9d9b-1febbd144f20",
                        "source_sense_id": "2c76032f-0c8f-3c3b-8629-20b01a80214c",
                        "source_sense_description": "Paysan russe de l’époque impériale",
                        "target_lang_word": "mujik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mujik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b09d4bf3-faee-3b3d-9d0d-8f5ed62f8cbd",
                                        "entry_id": "3f6ca652-20a0-39ea-b79c-c51a6d39f5c2",
                                        "glosses": [
                                            "A Russian (male) peasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad800ecd-1f45-46d8-ac02-078b7e4db1dc",
                                                "sense_id": "b09d4bf3-faee-3b3d-9d0d-8f5ed62f8cbd",
                                                "text": "Since she had last looked at a newspaper, it appeared that the Russians had become heroes and magnificent fighters. They were no longer a rabble of ill-equipped moujiks fleeing before the Nazi hordes."
                                            },
                                            {
                                                "example_id": "9f6faf3c-4aa9-467d-8145-e64289ae158f",
                                                "sense_id": "b09d4bf3-faee-3b3d-9d0d-8f5ed62f8cbd",
                                                "text": "[A] few days later [I] had rented for the month of August what looked in the snapshots they sent me like a cross between a mujik's izba and Refuge Z, but it had a tiled bathroom and cost dearer than my Appalachian castle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
