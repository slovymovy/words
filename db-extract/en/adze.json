                        "glosses": [
                            "A cutting tool that has a curved blade set at a right angle to the handle and is used in shaping wood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a05199e-3716-4b09-99d3-c061b6a2ee09",
                                "sense_id": "7f7dfb0c-1fc7-394a-a9ac-8abe0bf087e2",
                                "text": "...if I wanted a board, I had no other way but to cut down a tree, set it on an edge before me, and hew it flat on either side with my axe, till I brought it to be thin as a plank, and then dub it smooth with my adze."
                            }
                        ]
