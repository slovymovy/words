                },
                {
                    "sense_id": "8c3d86f8-e5e2-3b99-80b3-3e00a3c319fc",
                    "sense_definition": "A small amount of liquid or material that falls; a droplet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small <w>droppings</w> of rain began to splatter against the windowpane.",
                            "target_lang_translations": {
                                "ru": "Мелкие <w>капли</w> дождя начали стучать по оконному стеклу.",
                                "pl": "Małe <w>krople</w> deszczu zaczęły uderzać o szybę."
                            }
                        },
                        {
                            "text": "The <w>droppings</w> from the leaky roof collected in a bucket.",
                            "target_lang_translations": {
                                "ru": "<w>Капли</w> с протекающей крыши собирались в ведро.",
                                "pl": "<w>Krople</w> z przeciekającego dachu zbierały się w wiadrze."
                            }
                        }
                    ],
                    "synonyms": [
                        "droplet",
                        "drip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество падающей жидкости или материала; капля.",
                        "pl": "Niewielka ilość spadającej cieczy lub materiału; kropelka."
                    },
                    "translations": {
