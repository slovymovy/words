                    {
                        "sense_id": "adeafdf9-7733-3c80-ba3c-2ed43bf5e2a2",
                        "entry_id": "c7e787d0-c47e-382d-9fa9-563d4b81aa0d",
                        "glosses": [
                            "odebranie życia człowiekowi lub zwierzęciu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2bc964-b68a-4c78-b932-1ca2d59ce6db",
                                "sense_id": "adeafdf9-7733-3c80-ba3c-2ed43bf5e2a2",
                                "text": "Matka pójdzie do więzienia na 11 i pół roku za zabicie swojego dziecka."
                            }
                        ],
