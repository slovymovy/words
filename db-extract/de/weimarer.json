            {
                "entry_id": "e85abb67-1440-37fb-a38b-c37644278d71",
                "word": "Weimarer",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "6797d1da-554e-4031-a580-63c9038d34bc",
                        "entry_id": "e85abb67-1440-37fb-a38b-c37644278d71",
                        "tags": [
                            "positive"
                        ],
                        "form": "Weimarer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72833baf-4312-3add-803a-54ccb749a586",
                        "entry_id": "e85abb67-1440-37fb-a38b-c37644278d71",
                        "glosses": [
                            "zu Weimar gehörig, aus ihm kommend oder es betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d2bb83-f508-4478-aa11-6ccbc6de279a",
                                "sense_id": "72833baf-4312-3add-803a-54ccb749a586",
                                "text": "„Die Hochschule für Kunst, Design und Architektur entstand durch den Zusammenschluss der Weimarer Hochschule für Bildende Kunst mit den Resten der 1915 aufgelösten Weimarer Kunstgewerbeschule von Henry van de Velde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b090f21-9d60-3c4f-987a-988e3ebbe837",
                        "entry_id": "e85abb67-1440-37fb-a38b-c37644278d71",
                        "glosses": [
                            "die Weimarer Republik betreffend, zu ihr gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3678823-fa86-4214-b4b7-b3c9da8cae69",
                                "sense_id": "6b090f21-9d60-3c4f-987a-988e3ebbe837",
                                "text": "„Die Weimarer Reichsverfassung trat mit der Unterzeichnung durch Reichspräsident Friedrich Ebert (1871–1925) am 11. August 1919 in Kraft.“"
                            },
                            {
                                "example_id": "8e49e2ea-64e1-4f28-9546-a4e981e18813",
                                "sense_id": "6b090f21-9d60-3c4f-987a-988e3ebbe837",
                                "text": "„Am 27. März 1930 zerbrach die letzte parlamentarisch legitimierte Regierung der Weimarer Zeit an der Frage der Erhöhung der Beiträge für die Arbeitslosenversicherung um ein halbes Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
