                "senses": [
                    {
                        "sense_id": "1e9c77b3-5e4f-3703-a927-830ab8020f8c",
                        "entry_id": "da16cc68-fb7c-3307-a975-2210140cbfa1",
                        "glosses": [
                            "schrankartiges Möbel mit Schreibplatte und -utensilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc52de36-99e4-42b8-858e-3b0d6994bc19",
                                "sense_id": "1e9c77b3-5e4f-3703-a927-830ab8020f8c",
                                "text": "„Dann holte er aus einem Schreibschrank, den er aufgeklappt ließ, einen in Leder gebundenen abgegriffenen Band hervor, den er vor Robert ausbreitete.“"
                            },
                            {
                                "example_id": "043f99b0-17b3-4ea2-a63f-bc7e51bc01d0",
                                "sense_id": "1e9c77b3-5e4f-3703-a927-830ab8020f8c",
                                "text": "„Ich bestellte den Acker, von dem ich aß, aber ich sah auch die dazugehörigen schriftlichen Dokumente und sonstigen Papiere im Schreibschranke meines armen närrischen Schwiegervaters nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03c192d2-58b9-4848-895e-4416abfbab2a",
                        "source_entry_id": "da16cc68-fb7c-3307-a975-2210140cbfa1",
                        "source_sense_id": "1e9c77b3-5e4f-3703-a927-830ab8020f8c",
                        "source_sense_description": "schrankartiges Möbel mit Schreibplatte und -utensilien",
                        "target_lang_word": "secrétaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secrétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd9001c-ee96-38f2-853c-4b63dba96424",
                                        "entry_id": "19ce1caf-f5cf-365f-8a98-8e63d6332627",
                                        "glosses": [
                                            "Personne de confiance qui détient les secrets de l’entreprise où elle travaille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "729754d6-6b39-30d1-b6c6-4d76eb197629",
                                        "entry_id": "19ce1caf-f5cf-365f-8a98-8e63d6332627",
                                        "glosses": [
                                            "Celui, celle dont l’emploi est de rédiger et d’écrire des lettres, des dépêches « importantes » pour une autre personne qui souvent engage la société pour laquelle elle travaille."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c514708-7cdb-43fd-98a8-471e9e90a595",
                                                "sense_id": "729754d6-6b39-30d1-b6c6-4d76eb197629",
                                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d’un poitrinaire devenu cent kilos, d’un bilieux devenu poupin."
                                            },
                                            {
                                                "example_id": "5be54566-d4aa-4b45-9476-39d92cef11b2",
                                                "sense_id": "729754d6-6b39-30d1-b6c6-4d76eb197629",
                                                "text": "Ce soudain branle-bas de combat gagna jusqu’à l’intendance. On vit des secrétaires, cuisiniers et autres non-combattants entourer les instructeurs pour s’initier rapidement au maniement du bazooka et du mortier de tranchée, et apprendre l’art de poser une mine."
                                            },
                                            {
                                                "example_id": "ed881529-0151-4c3d-8adc-6b968ef7cc39",
                                                "sense_id": "729754d6-6b39-30d1-b6c6-4d76eb197629",
                                                "text": "Le chef se serait-il inquiété autant, ou plus, si sa plante verte avait été déplacée ? Certes, elle ne savait pas prendre en notes, mais il avait pour elle des soins presque tendres qui lui permettaient de soutenir la comparaison avec une secrétaire transparente."
                                            },
                                            {
                                                "example_id": "87b0721b-0ded-4f41-8d03-a84a346c70cd",
                                                "sense_id": "729754d6-6b39-30d1-b6c6-4d76eb197629",
                                                "text": "Il incarne l’Église charitable, mais aussi Emmaüs : le grand public a ainsi pu découvrir récemment l’existence pourtant fondamentale de sa secrétaire Lucie Coutaz, au détour d’un film qui, pour une fois, l’avait un peu mise en avant. Ses autres bras droits sont d’anciens repris de justice, de modestes compagnons ou des notables si hauts placés et affairés qu’ils lui laissent l’affiche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650f0294-e883-3bcc-bf0e-74e5b3210e9d",
                                        "entry_id": "19ce1caf-f5cf-365f-8a98-8e63d6332627",
                                        "glosses": [
                                            "Personne qui tient registre des délibérations d’une assemblée ou qui rédige les lettres expédiées au nom de cette assemblée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcc31333-db30-435f-9a01-3443b6e232b7",
                                                "sense_id": "650f0294-e883-3bcc-bf0e-74e5b3210e9d",
                                                "text": "Après des discussions très prolongées — elles durèrent quelque six mois — l’Académie, très partagée, pour se tirer d’affaire, s’en remit purement et simplement à son secrétaire perpétuel, M. Joseph Thoulier, abbé d’Olivet."
                                            },
                                            {
                                                "example_id": "49043c97-fb1d-4e34-a44b-f297a286091d",
                                                "sense_id": "650f0294-e883-3bcc-bf0e-74e5b3210e9d",
                                                "text": "Les secrétaires de la Chambre des députés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secrétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                        "entry_id": "59cb3499-01c4-3742-a3d5-88ae95eaca16",
                                        "glosses": [
                                            "Bureau sur lequel on écrit et où l’on renferme des papiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc0efa9-90d1-420c-b2c6-978263b41187",
                                                "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                                "text": "Il a tout bonnement un secrétaire en acajou, auquel j’ai toujours vu la clef."
                                            },
                                            {
                                                "example_id": "71c75b7b-7d0d-4342-9442-900ae7926fb0",
                                                "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                                "text": "Il serra précieusement dans son secrétaire l’agenda mystérieux et l’épitre du domino blanc, ses armes pour entrer en campagne."
                                            },
                                            {
                                                "example_id": "310c5e7c-361e-4fd7-921f-d7ccf041bb9f",
                                                "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                                "text": "Un secrétaire à rideau encombré de papiers, de plumiers, s’accompagnerait d’un petit fauteuil canné."
                                            },
                                            {
                                                "example_id": "6c6381dc-d219-41ae-babb-4d0516134d61",
                                                "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                                "text": "Je me suis souvenu qu’entre les deux fenêtres, à proximité des étagères de livres, il y avait un secrétaire dont j’explorais les tiroirs lorsque j’habitais cette chambre."
                                            },
                                            {
                                                "example_id": "7586335d-5474-4d07-b3cc-b25edce9bcb7",
                                                "sense_id": "2021024d-1ff3-3bab-9f25-74a82c712954",
                                                "text": "En chêne ton ébène, ce meuble-bar a un abattant comme un secrétaire et un support pour les verres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96db2dd2-f917-3e04-9cd8-b71d3459e1e0",
                                        "entry_id": "59cb3499-01c4-3742-a3d5-88ae95eaca16",
                                        "glosses": [
                                            "Autre nom du messager sagittaire ou serpentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5823fb5c-5128-474c-a14e-d183cc0ab746",
                                                "sense_id": "96db2dd2-f917-3e04-9cd8-b71d3459e1e0",
                                                "text": "— serpentaire, appelé également secrétaire ou messager (sagittarius serpentarius), falconiforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
