        "fr-extract.jsonl": [
            {
                "entry_id": "d98720b1-5af2-3c78-837d-4bf6d4019284",
                "word": "taquinerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5429b883-36b2-49f0-ab46-9b70cc5d43f6",
                        "entry_id": "d98720b1-5af2-3c78-837d-4bf6d4019284",
                        "tags": [
                            "plural"
