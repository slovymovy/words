                        "target_lang_word": "rêve éveillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rêve éveillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1df364d-3f2e-362d-80ec-8368b870ff7b",
                                        "entry_id": "6ab02846-e94c-3d06-9310-b4f2dc110d1a",
                                        "glosses": [
                                            "État de conscience modifiée, entre la rêverie et le rêve nocturne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9950b72e-db14-4fe8-83b9-bfc543fd51ef",
                                                "sense_id": "e1df364d-3f2e-362d-80ec-8368b870ff7b",
                                                "text": "Son visage avait pris l’expression du rêve éveillé et son intonation, la chantante cadence des fables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
