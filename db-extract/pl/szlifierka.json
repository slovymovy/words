                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9aa3687-9d33-314a-822a-0235b94272de",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
