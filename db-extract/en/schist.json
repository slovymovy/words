                        "target_lang_word": "Glimmerschiefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glimmerschiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                        "entry_id": "6ef6e919-1740-3e9e-a836-4c4fc67d1afc",
                                        "glosses": [
                                            "metamorphes Gestein mit schiefriger Struktur und Glimmer und Quarz als den wesentlichen Bestandteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d718eccb-6636-4aac-8f34-6e9da406aa81",
                                                "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                                "text": "„Geringerer Gehalt an Feldspat bei gleichzeitiger Zunahme des Glimmers und der schieferigen Struktur zeichnet die Glimmerschiefer aus.“"
                                            },
                                            {
                                                "example_id": "ff472742-7a91-45e6-9dca-cb1424f13168",
                                                "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                                "text": "„Der Turmalin, der in Prismen von oft makroskopischer Sichtbarkeit in allen Glimmerschiefern auftritt, ist ein sehr kompliziert zusammengesetztes Tonerde‑Borsäuresilikat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
