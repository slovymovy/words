                                "example_id": "56ed177d-872c-4400-9111-6f15d129d1d2",
                                "sense_id": "ad35effb-ae0e-38a4-9bb3-469d19442e8b",
                                "text": "C’est la première fois que je rencontre un adepte de la domination des femmes, un dégénéré de misogyne, un phallocrate à p’tite bite."
                            },
                            {
                                "example_id": "18fa21da-be0e-49d1-8a3b-5c5b8b973053",
                                "sense_id": "ad35effb-ae0e-38a4-9bb3-469d19442e8b",
                                "text": "Il n’y a pas énormément de différences entre un pervers narcissique et le macho moyen, le phallocrate moyen."
                            }
                        ]
