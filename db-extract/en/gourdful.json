                        "entry_id": "614619ef-363d-355f-89b7-0da40fac118e",
                        "glosses": [
                            "As much as a gourd wili carry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a56d6f6-b1ac-422e-82cb-6fe02cf86c96",
                                "sense_id": "6877b0e9-d799-3dfd-a0ce-104ebb46364c",
                                "text": "Mother, make Harry bring me a gourdful fresh from the spring."
                            },
                            {
                                "example_id": "60b39471-5d01-427f-9784-e8c262f4f786",
                                "sense_id": "6877b0e9-d799-3dfd-a0ce-104ebb46364c",
                                "text": "She had been milked only a few hours before, and so he got only a gourdful from her."
                            },
                            {
                                "example_id": "4bfee60d-c992-4b33-a4a6-a3e8b9037668",
                                "sense_id": "6877b0e9-d799-3dfd-a0ce-104ebb46364c",
                                "text": "Cephas got a gourdful of water from the pail in the sink, and carried it carefully over to the table."
                            },
                            {
                                "example_id": "ea320515-178a-4226-b8e2-775bbab55d69",
                                "sense_id": "6877b0e9-d799-3dfd-a0ce-104ebb46364c",
                                "text": "I had a grim sense of amusement on finding that the old woman was not deaf, for she went out, and presently came back with a gourdful, which I eagerly drank."
                            }
                        ]
                    }
