                ],
                "senses": [
                    {
                        "sense_id": "47a714e6-9b03-370d-b0dd-8ddf8052bec4",
                        "entry_id": "1f1d21f1-adcd-35e5-949f-09edfc7c8152",
                        "glosses": [
                            "Synonym of diplomat."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "769ef398-20be-46dd-96a0-c36cd668e01d",
                                "sense_id": "47a714e6-9b03-370d-b0dd-8ddf8052bec4",
                                "text": "It was not so easy to penetrate the motives of the Pawnees. Calm, dignified, and yet far from repulsive, they set an example of courtesy, blended with reserve, that many a diplomatist of the most polished court might have strove in vain to imitate."
                            },
                            {
                                "example_id": "37336105-06b5-4a5d-9039-3a4dac5c20a9",
                                "sense_id": "47a714e6-9b03-370d-b0dd-8ddf8052bec4",
                                "text": "She flung back the fortnight on his hands as if he had been an idler indifferent to dates, instead of an active young diplomatist who, to respond to her call, had had to hew his way through a very jungle of engagements!"
                            },
                            {
                                "example_id": "fe1bf494-a7a3-4838-ba9e-222abe452550",
                                "sense_id": "47a714e6-9b03-370d-b0dd-8ddf8052bec4",
                                "text": "Diplomatists have no right to complain of mere lies; it is their own fault, if, educated as they are, the lies deceive them; but they complain bitterly of traps."
                            }
                        ]
                    },
                    {
                        "sense_id": "92da74c0-fdbb-37b7-a547-2f167b6871fb",
                        "entry_id": "1f1d21f1-adcd-35e5-949f-09edfc7c8152",
                        "glosses": [
                            "A person trained in diplomatics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84d153f-d4e6-495e-83ef-640d86384d96",
                                "sense_id": "92da74c0-fdbb-37b7-a547-2f167b6871fb",
                                "text": "Paleography might teach men to read documents, diplomatics to date them and to test their authenticity; but the full significance of an ancient deed might easily escape the most exact paleographer and the most accomplished diplomatist, for the want of that finished sense for legal technicality which is the natural fruit of a conveyancing practice."
                            }
                        ]
                    }
                ],
