                        "glosses": [
                            "Variante de devanteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ae1212-efa5-45e9-a0dc-fef615682297",
                                "sense_id": "87cdbac7-47ba-3c98-82e9-652d01f6eee5",
                                "text": "Habits de gala aux rois et reines de la fête, fleurs d’or ou d’argent au velours des chapeaux masculins, aux corsages bien bombés ; gilets brodés, devantiaux de soie et de dentelle."
                            },
                            {
                                "example_id": "9bc73c83-c7de-4ebd-a439-ea704c912bb5",
                                "sense_id": "87cdbac7-47ba-3c98-82e9-652d01f6eee5",
                                "text": "Oh ! que nenni! je m’passerons ben volontiers du devantiau d’soie, d’la canipette neuve, et des anneaux d’oreilles... plutôt que de vous causer du souci, j’aime ben mieux me conjoindre telle que me v’là, en bonnet de coton."
                            },
                            {
                                "example_id": "3fdf4980-9622-4a7a-907e-4f0e0d0bacaf",
                                "sense_id": "87cdbac7-47ba-3c98-82e9-652d01f6eee5",
                                "text": "Liane s'était contentée d'un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s'appelle une canipette."
                            }
                        ]
                    }
