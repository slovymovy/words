    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c78507a9-dd79-3fdc-ace5-7f1e66bbccc0",
                "word": "extemporaneous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0c6f03cb-3059-4edc-830b-7b992b4e22ad",
                        "entry_id": "c78507a9-dd79-3fdc-ace5-7f1e66bbccc0",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more extemporaneous"
                    },
                    {
                        "form_id": "689f4891-8d00-439c-a74f-ea6611039333",
                        "entry_id": "c78507a9-dd79-3fdc-ace5-7f1e66bbccc0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most extemporaneous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0aab7e7-11b9-3bd2-85a9-4662254e489b",
                        "entry_id": "c78507a9-dd79-3fdc-ace5-7f1e66bbccc0",
                        "glosses": [
                            "With inadequate preparation or without advance thought; offhand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9ecd2f-1bd5-4502-89f9-87ff436ae264",
                                "sense_id": "f0aab7e7-11b9-3bd2-85a9-4662254e489b",
                                "text": "My speeches in Great Britain were wholly extemporaneous, and I may not always have been so guarded in my expressions, as I otherwise should have been. I was ten years younger then than now, and only seven years from slavery."
                            },
                            {
                                "example_id": "bbf52dbb-4482-4224-8c00-7bea7c208d03",
                                "sense_id": "f0aab7e7-11b9-3bd2-85a9-4662254e489b",
                                "text": "“Who the devil is there in Ramilly County,” muttered Amory aloud, “who would deliver Verlaine in an extemporaneous tune to a soaking haystack?”"
                            },
                            {
                                "example_id": "d9d837f2-81d5-4714-86ce-736568a18c11",
                                "sense_id": "f0aab7e7-11b9-3bd2-85a9-4662254e489b",
                                "text": "The lovely words of a prepared speech, however, cannot erase extemporaneous words and deeds, thousands of them, that have run contrary to those aspirations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61b5116e-a3f6-4d4e-aeac-db3bb9d80870",
                        "source_entry_id": "c78507a9-dd79-3fdc-ace5-7f1e66bbccc0",
                        "source_sense_id": "f0aab7e7-11b9-3bd2-85a9-4662254e489b",
