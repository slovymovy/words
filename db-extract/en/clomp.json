                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stampfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd35ed98-6364-3cf4-bd9f-f535330ac852",
                                        "entry_id": "79a5f4f8-3f1f-3051-afdc-d80d10b67c8c",
                                        "glosses": [
                                            "von oben mit seinem Gewicht nach unten, auf den Boden einwirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4df2c1c-492c-4620-9bb4-ed1273856c1a",
                                                "sense_id": "dd35ed98-6364-3cf4-bd9f-f535330ac852",
                                                "text": "Er stampfte mit den Füßen auf den Boden."
                                            },
                                            {
                                                "example_id": "457da07b-0149-44ac-ba3a-118e8726b6b6",
                                                "sense_id": "dd35ed98-6364-3cf4-bd9f-f535330ac852",
                                                "text": "Sie stampfte Kartoffeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01a22f84-1daa-3934-80b4-014b9e50c0dd",
                                        "entry_id": "79a5f4f8-3f1f-3051-afdc-d80d10b67c8c",
                                        "glosses": [
                                            "Metall mit einer Hohlform bearbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529ddb30-0eef-4566-869e-09517a48035d",
                                                "sense_id": "01a22f84-1daa-3934-80b4-014b9e50c0dd",
                                                "text": "Das Blech wird in eine Form gestampft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ba9331c5-5ad0-3014-9bbf-f1d188a6248f",
                                        "entry_id": "79a5f4f8-3f1f-3051-afdc-d80d10b67c8c",
                                        "glosses": [
                                            "querseitige Auf- und Ab-Bewegung eines Schiffes oder Boots bei Wellengang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659f2076-215b-4e88-8bae-da6ebbe4a39e",
                                                "sense_id": "ba9331c5-5ad0-3014-9bbf-f1d188a6248f",
                                                "text": "Das Schiff stampft bei hohem Seegang."
                                            },
                                            {
                                                "example_id": "fb1ba77e-c511-4137-a050-a5706bf269e8",
                                                "sense_id": "ba9331c5-5ad0-3014-9bbf-f1d188a6248f",
                                                "text": "„Allein in rabenschwarzer Finsternis, mußte Saltash alle Schläge erleiden, die See und Sturm auszuteilen vermochten: sie stampfte, schlingerte und arbeitete verzweifelt.“"
                                            },
                                            {
                                                "example_id": "2ad94f82-ff6b-46f5-895a-4a30ac1db7ea",
                                                "sense_id": "ba9331c5-5ad0-3014-9bbf-f1d188a6248f",
                                                "text": "„Sie stampfte leicht und rollte so heftig, dass die meisten Sträflinge seekrank wurden und in die Kojen flüchteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
