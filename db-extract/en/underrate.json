                                        "entry_id": "d4d638c5-b692-373f-91cf-668c794ac4c4",
                                        "glosses": [
                                            "etwas in seinem Ausmaße kleiner, unwichtiger und/oder harmloser einschätzen, als es tatsächlich ist"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1a60f7-d9ec-4eb6-b9aa-648b1709b7b7",
                                                "sense_id": "873f22e8-8645-34f5-bdd7-52893fde0a23",
                                                "text": "Unterschätz ihn nicht!"
                                            },
                                            {
                                                "example_id": "dae6dbb6-73d0-48dd-8d6e-e68c20b8850e",
                                                "sense_id": "873f22e8-8645-34f5-bdd7-52893fde0a23",
                                                "text": "Sie unterschätzte die Wucht des Aufpralles."
                                            },
                                            {
                                                "example_id": "b66f7590-3f8c-4029-9edf-4b20719751b6",
                                                "sense_id": "873f22e8-8645-34f5-bdd7-52893fde0a23",
                                                "text": "Er unterschätzt dieses Problem."
