                    "sense_id": "292f6101-e0fd-32c7-9e47-a3cb2b04dbf5",
                    "sense_definition": "Met veel lucht erin, niet zwaar of compact, vooral gezegd van voedsel of gebak.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "textuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok klopt de eiwitten stijf om een <w>luchtige</w> mousse te maken.",
                            "target_lang_translations": {
                                "en": "The chef beats the egg whites until stiff to make an <w>airy</w> mousse.",
                                "ru": "Повар взбивает яичные белки до густой пены, чтобы приготовить <w>воздушный</w> мусс.",
                                "fr": "Le cuisinier monte les blancs d'œufs en neige pour préparer une mousse <w>aérienne</w>."
                            }
                        },
                        {
                            "text": "Dit <w>luchtige</w> baksel is erg lekker bij de koffie.",
                            "target_lang_translations": {
                                "en": "This <w>fluffy</w> pastry is very tasty with coffee.",
                                "ru": "Эта <w>пышная</w> выпечка очень хороша к кофе.",
                                "fr": "Cette pâtisserie <w>légère</w> est délicieuse avec le café."
                            }
                        }
                    ],
                    "synonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "luchtig baksel",
                        "luchtige textuur",
                        "luchtig deeg"
                    ],
                    "target_lang_definitions": {
