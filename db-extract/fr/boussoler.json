                "senses": [
                    {
                        "sense_id": "d773bbed-f296-3e90-bf86-c4167c5fa6ad",
                        "entry_id": "659e954a-81e6-301f-9818-4b2d6a66c2ea",
                        "glosses": [
                            "Orienter avec une boussole."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bc2b5532-002a-3058-b5a9-f85efdd163ea",
                        "entry_id": "659e954a-81e6-301f-9818-4b2d6a66c2ea",
                        "glosses": [
                            "Guider."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21c17dca-7d16-47ca-8cd7-b75d86507b05",
                                "sense_id": "bc2b5532-002a-3058-b5a9-f85efdd163ea",
                                "text": "Il faut hisser très haut ses voiles, “boussoler” son regard et vaincre son intrépidité."
                            },
                            {
                                "example_id": "87288c54-afb0-4056-90c1-9d72d18f55fd",
                                "sense_id": "bc2b5532-002a-3058-b5a9-f85efdd163ea",
                                "text": "Lui seul peut, dit le prêtre en levant le doigt, lui seul peut équilibrer… boussoler la vie !"
                            },
                            {
                                "example_id": "9fa05570-0816-40d4-b75d-cdce3858ca8b",
                                "sense_id": "bc2b5532-002a-3058-b5a9-f85efdd163ea",
                                "text": "Suis-je bien boussolé ? Est-ce que je me trompe, comme le font presque tous ceux qui croient être dans le vrai ?"
                            }
                        ]
                    }
                ],
