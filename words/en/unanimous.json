{
    "word_family": [
        "unanimity",
        "unanimously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                    "sense_definition": "Formed or supported by the complete agreement of everyone involved.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "agreement_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reached a <w>unanimous</w> decision after a short discussion.",
                            "target_lang_translations": {
                                "ru": "Комитет принял <w>единогласное</w> решение после короткого обсуждения.",
                                "tr": "Komite kısa bir tartışmanın ardından <w>oy birliğiyle</w> bir karara vardı.",
                                "zh": "经过简短讨论后，委员会作出了<w>一致的</w>决定。"
                            }
                        },
                        {
                            "text": "There was <w>unanimous</w> support for the new policy among the staff.",
                            "target_lang_translations": {
                                "ru": "Среди сотрудников была <w>единодушная</w> поддержка новой политики.",
                                "tr": "Personel arasında yeni politika için <w>ittifakla</w> destek vardı.",
                                "zh": "全体员工对新政策表示了<w>一致的</w>支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "united"
                    ],
                    "antonyms": [
                        "divided",
                        "split"
                    ],
                    "common_phrases": [
                        "unanimous decision",
                        "unanimous vote",
                        "unanimous support",
                        "unanimous verdict",
                        "unanimous agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принятый или поддержанный при полном согласии всех участников",
                        "tr": "Herkesin tam mutabakatı ile oluşturulmuş veya desteklenmiş.",
                        "zh": "（决定、投票或支持等）全体一致的，毫无异议的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единогласный",
                                "target_lang_sense_clarification": "о решении, голосовании"
                            },
                            {
                                "target_lang_word": "единодушный",
                                "target_lang_sense_clarification": "о поддержке, одобрении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oy birliğiyle",
                                "target_lang_sense_clarification": "karar veya oylama için"
                            },
                            {
                                "target_lang_word": "ittifakla",
                                "target_lang_sense_clarification": "genel destek veya onay için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一致的",
                                "target_lang_sense_clarification": "指决定、看法或行动等全体赞同"
                            },
                            {
                                "target_lang_word": "毫无异议的",
                                "target_lang_sense_clarification": "强调全体成员均无反对意见"
                            },
                            {
                                "target_lang_word": "全票通过的",
                                "target_lang_sense_clarification": "常用于指投票或决议的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb18559-350f-3d45-a7c9-3dcc0cd4cf87",
                    "sense_definition": "Sharing the same opinion or view as everyone else in a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judges were <w>unanimous</w> in their praise for the young performer.",
                            "target_lang_translations": {
                                "ru": "Судьи были <w>единодушны</w> в своей похвале молодому исполнителю.",
                                "tr": "Jüri üyeleri genç sanatçıyı övme konusunda <w>hemfikirdi</w>.",
                                "zh": "评委们对这位年轻表演者的赞美之词<w>意见一致</w>。"
                            }
                        },
                        {
                            "text": "We are <w>unanimous</w> regarding the need for immediate action.",
                            "target_lang_translations": {
                                "ru": "Мы <w>единодушны</w> относительно необходимости немедленных действий.",
                                "tr": "Acil eylem gerekliliği konusunda <w>görüş birliği içindeyiz</w>.",
                                "zh": "对于需要立即采取行动这一点，我们大家<w>意见一致</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "united",
                        "agreed",
                        "like-minded"
                    ],
                    "antonyms": [
                        "disagreeing",
                        "divided"
                    ],
                    "common_phrases": [
                        "unanimous in",
                        "unanimous regarding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придерживающийся единого мнения с остальными членами группы",
                        "tr": "Bir gruptaki diğer herkesle aynı görüşü veya düşünceyi paylaşan.",
                        "zh": "（群体中的人）意见一致的，持相同看法的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единодушный",
                                "target_lang_sense_clarification": "о группе людей, мнении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hemfikir",
                                "target_lang_sense_clarification": "aynı görüşü paylaşan kişiler için"
                            },
                            {
                                "target_lang_word": "görüş birliği içinde",
                                "target_lang_sense_clarification": "bir konuda ortak düşünceye sahip olma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见一致",
                                "target_lang_sense_clarification": "指所有人的想法完全相同"
                            },
                            {
                                "target_lang_word": "看法一致",
                                "target_lang_sense_clarification": "指在某件事上的评价或观点没有分歧"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}