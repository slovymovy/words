                "senses": [
                    {
                        "sense_id": "8fe753e5-7991-32c1-8783-bdf5a5e22b3c",
                        "entry_id": "644989b0-41e9-3c20-a6de-92e172476f12",
                        "glosses": [
                            "wyolbrzymione przedstawianie czegoś, pojmowanie czegoś z nadmierną afektacją, nienaturalność"
                        ],
                        "tags": [],
