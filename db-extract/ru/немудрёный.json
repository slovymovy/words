    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "1a0a6e42-b8db-3970-85ce-f385de20a6ce",
                "word": "немудрёный",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c07524dd-6232-32a9-9aae-7dbd7ee037c4",
                        "entry_id": "1a0a6e42-b8db-3970-85ce-f385de20a6ce",
                        "glosses": [
                            "разг. незамысловатый, незатейливый"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fd08e53f-09f8-3503-ad02-4fb9c9502e4b",
                        "entry_id": "1a0a6e42-b8db-3970-85ce-f385de20a6ce",
                        "glosses": [
                            "разг. бесхитростный, простой (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7edf36d-2639-4148-b4cd-d5773903c126",
                                "sense_id": "fd08e53f-09f8-3503-ad02-4fb9c9502e4b",
                                "text": "По профессии он стекольщик. Человек сам немудрёный. И с бородой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c67f8ccd-9e8f-476e-8cc9-29cf0f530984",
                        "source_entry_id": "1a0a6e42-b8db-3970-85ce-f385de20a6ce",
                        "target_lang_word": "simple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ceea18e-caf2-36d5-ad00-ab7cd0f7235b",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Uncomplicated; lacking complexity; taken by itself, with nothing added."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca12efa-5e3b-453b-b1fe-93280e83241c",
                                                "sense_id": "9ceea18e-caf2-36d5-ad00-ab7cd0f7235b",
                                                "text": "We are engaged in a great work, a treatise on our river fortifications, perhaps? But since when did army officers afford the luxury of amanuenses in this simple republic?"
                                            },
                                            {
                                                "example_id": "47eb8cba-5646-40a1-84a9-7803a9acfd90",
                                                "sense_id": "9ceea18e-caf2-36d5-ad00-ab7cd0f7235b",
                                                "text": "Primitive people, colossally ignorant of the cause of disease and of curative processes, attributed to supernatural agencies any causes and effects for which their simple minds could give no natural explanations."
                                            },
                                            {
                                                "example_id": "423d48f4-30f4-4f98-8550-5cfbf5418464",
                                                "sense_id": "9ceea18e-caf2-36d5-ad00-ab7cd0f7235b",
                                                "text": "The simplest soliton is the domain wall with co-dimension one, and the next simplest is the vortex with co-dimension two, whereas the co-dimension three (four) soliton is called monopole (instanton)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ed9cdc-d60e-3990-a4d7-acbd6ccf1015",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Easy; not difficult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b763e3ee-e25b-42b1-a81b-999396ea1467",
                                                "sense_id": "43ed9cdc-d60e-3990-a4d7-acbd6ccf1015",
                                                "text": "There is no simple way to define precisely a complex arrangement of parts, however homely the object may appear to be."
                                            },
                                            {
                                                "example_id": "34b7e846-b339-47dd-b691-a65fbbd17b24",
                                                "sense_id": "43ed9cdc-d60e-3990-a4d7-acbd6ccf1015",
                                                "text": "Point-free coding is a byproduct of adopting declarative programming. You can use point-free coding without FP. But because point-free is all about improving the readability of code at a glance and making it simpler to parse, having the guarantees imposed by FP furthers this cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ea6f95-4db0-333b-94da-e5f473c7ea7a",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Without ornamentation; plain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ae18983-3f47-3233-8799-d89ee081811a",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Free from duplicity; guileless, innocent, straightforward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dcc26bd-407c-4fa3-9adc-db0cc08b77f4",
                                                "sense_id": "3ae18983-3f47-3233-8799-d89ee081811a",
                                                "text": "Full many fine men go upon my score, as simple as I stand here, and I trust them."
                                            },
                                            {
                                                "example_id": "4eb78c5a-98fe-401d-9b87-7f20a9010373",
                                                "sense_id": "3ae18983-3f47-3233-8799-d89ee081811a",
                                                "text": "Must thou trust Tradition's simple tongue?"
                                            },
                                            {
                                                "example_id": "bef8afc7-ec94-45ba-844c-c335f67b3ccc",
                                                "sense_id": "3ae18983-3f47-3233-8799-d89ee081811a",
                                                "text": "Nothing is more simple than greatness; indeed, to be simple is to be great. The vision of genius comes by renouncing the too officious activity of the understanding, and giving leave and amplest privilege to the spontaneous sentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d44fdc-9cf9-34c9-985a-c8d7c13990ea",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Undistinguished in social condition; of no special rank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce2e978-5ae0-45b4-84df-c8692b655de2",
                                                "sense_id": "72d44fdc-9cf9-34c9-985a-c8d7c13990ea",
                                                "text": "Garak: Who would want to kill me, a simple tailor? / Odo: A simple tailor? A simple tailor who used to be an agent of the Obsidian Order!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d40e934-8a5f-3bdf-88ae-664883fdec57",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Trivial; insignificant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974cfca2-5bd9-49b8-a6f8-923d6f9c1022",
                                                "sense_id": "1d40e934-8a5f-3bdf-88ae-664883fdec57",
                                                "text": "‘That was a symple cause,’ seyde Sir Trystram, ‘for to sle a good knyght for seyynge well by his maystir.’",
                                                "translation": "‘That was a simple cause,’ said Sir Tristram, ‘for to slay a good knight for to say well by his master.’",
                                                "english": "‘That was a simple cause,’ said Sir Tristram, ‘for to slay a good knight for to say well by his master.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "252e3f92-6416-30f1-9240-fe9db723ba87",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Feeble-minded; foolish."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d38de07-443c-3db7-ac74-503b96c73f76",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Consisting of one single substance; uncompounded."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b66d3c84-3ab7-367e-b03c-970671da2e8e",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-trivial, and admitting no proper non-trivial quotients.",
                                            "Being non-trivial, and having no proper non-trivial normal subgroups (equivalently, no proper non-trivial quotient groups)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24d18481-0b60-3d56-aac4-4a22cbae22a1",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-trivial, and admitting no proper non-trivial quotients.",
                                            "Being non-trivial, and having no proper non-trivial submodules (equivalently, no proper non-trivial quotient modules)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a303d6d7-09a9-3cce-82b1-3bffe3312738",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-trivial, and admitting no proper non-trivial quotients.",
                                            "Being non-zero, and having no proper non-zero two-sided ideals (equivalently, no proper non-trivial quotient rings). For commutative rings, this definition coincides with that of a field."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62e9461e-57fa-3285-9940-8ad436fd9892",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-trivial, and admitting no proper non-trivial quotients.",
                                            "Containing more than one element, and such that the only congruences on the structure are the diagonal relation (the equivalence relation a≡b⟺a=b) and the universal relation (the equivalence relation such that a≡b for all a,b). Equivalently, containing more than one element and having no proper non-trivial quotient algebras."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "universal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcd39ff0-ba72-368d-b0b9-e4f14efc42b7",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-trivial, and admitting no proper non-trivial quotients.",
                                            "Being non-isomorphic to the terminal object, and such that its only quotient objects (up to isomorphism) are the terminal object and itself."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c09ee611-f6a2-3c0e-81d6-11f84475461d",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Being non-abelian and having no proper non-zero ideals. (Note that this is non-equivalent to the usual algebra sense; in particular, the abelian Lie algebra of dimension 1 over any given field is non-trivial and has no proper non-zero ideals, but is by convention not considered simple.)"
                                        ],
                                        "tags": [
                                            "of a Lie algebra"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9216bd62-c7d5-3aed-8a50-207873ee4659",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Equal to a finite linear combination of indicator functions on measurable sets."
                                        ],
                                        "tags": [
                                            "of a real-valued function"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72a296e4-2e65-36f0-b9b3-10d791feb438",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Not compound, but possibly lobed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf5941c6-23d8-3536-8696-38384244609f",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Using steam only once in its cylinders, in contrast to a compound engine, where steam is used more than once in high-pressure and low-pressure cylinders. (of a steam engine)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82944d8d-2c45-4f77-9852-f3667ebfff51",
                                                "sense_id": "cf5941c6-23d8-3536-8696-38384244609f",
                                                "text": "Chesapeake & Ohio turned to simple articulateds, for instance, simply because its Alleghany tunnels would not accommodate the low-pressure forward cylinders of larger compounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cff1d34-2eee-3c12-b055-3a4a139bfef2",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Consisting of a single individual or zooid; not compound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650534a3-49d1-4cb8-a2fe-65d3e1d11a4b",
                                                "sense_id": "0cff1d34-2eee-3c12-b055-3a4a139bfef2",
                                                "text": "a simple ascidian"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a1ffcc-7c20-3c12-97ca-5ee90265c771",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Structurally uncomplicated.",
                                            "Homogenous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23534d5f-23fc-3848-a0c0-06aaa85d591a",
                                        "entry_id": "e7e31bc3-df24-3d6e-a3ce-1f00fd7dc7f2",
                                        "glosses": [
                                            "Mere; not other than; being only."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "304f2be7-b905-4ac1-b32d-6cdb157ec011",
                                                "sense_id": "23534d5f-23fc-3848-a0c0-06aaa85d591a",
                                                "text": "A medicine […] whose simple touch / Is powerful to araise King Pepin."
                                            },
                                            {
                                                "example_id": "ac54f461-e607-4269-bd63-60fc93da14ca",
                                                "sense_id": "23534d5f-23fc-3848-a0c0-06aaa85d591a",
                                                "text": "\"Yes; as well versed in the art of intrigue, I should think, as if she had been brought up in attendance in a court, instead of being a simple butler's daughter, in a gloomy old pile like this!\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "simple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "A herbal preparation made from one plant, as opposed to something made from more than one plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3fc487-2193-4d5e-8eb0-4b1636d9e339",
                                                "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                                "text": "Dere is some simples in my closet, dat I vill not for the varld I shall leave behind."
                                            },
                                            {
                                                "example_id": "cca499f2-444e-4478-935c-c44f990cef8d",
                                                "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                                "text": "I know there are some simples, which in operation are moistening and some drying."
                                            },
                                            {
                                                "example_id": "327bda8b-1db6-4846-af0b-97b65706d97c",
                                                "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                                "text": "[W]hat Virtue there is in this Remedy lies in the naked Simple it ſelf, as it comes over from the Indies, and in the Choice of that which is leaſt dried, or periſhed by the Voyage."
                                            },
                                            {
                                                "example_id": "cf3b88a5-e48e-4f42-8e17-b2bfba6084ac",
                                                "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                                "text": "The first fellow that picked an herb to cure himself had a bit of pluck. Simples. Want to be careful."
                                            },
                                            {
                                                "example_id": "b160e170-1514-4e3a-af73-11b9059da8c7",
                                                "sense_id": "1873285d-bd03-311e-bfec-654dc1697e4c",
                                                "text": "The venerable carryall, formerly brimming with all manner of esoteric pamphlets and witch's simples, now overflowed with a cascade of soft toys, juice bottles, tissues, linen books for infants, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765c200f-b35f-351c-9bec-3e14f3a437a6",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "A physician."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2beae5ce-8baf-3925-b086-b6ba65ff5257",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "A simple or atomic proposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0c7e47-bcae-435d-a23f-e2fe1e22ea3f",
                                                "sense_id": "2beae5ce-8baf-3925-b086-b6ba65ff5257",
                                                "text": "Peter van Inwagen, for example, believes that there are no ordinary objects, no chairs or shirts or shoes. Right here there are just some simples — atoms or whatever — arranged shoe-wise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a7ed33-a9bc-3dd6-ada0-75477eafa4d6",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "Something not mixed or compounded."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "847319c8-0730-4114-bb99-b0f45d1d000e",
                                                "sense_id": "e4a7ed33-a9bc-3dd6-ada0-75477eafa4d6",
                                                "text": "But it is a melancholy of mine own, compounded of many simples, extracted from many objects, and indeed the sundry contemplation of my travels"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0d951f-9792-3e57-943f-6ae6948c59d4",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "A drawloom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d19a3a0-5aa0-31d7-8c32-92cf54b9300e",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "Part of the apparatus for raising the heddles of a drawloom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b6dcd93-9fb0-3083-bd1f-57e229044172",
                                        "entry_id": "867b8291-4991-394c-9e51-d26ce37a6715",
                                        "glosses": [
                                            "A feast which is not a double or a semidouble."
                                        ],
