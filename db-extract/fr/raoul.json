        "fr-extract.jsonl": [
            {
                "entry_id": "d4acc6eb-c2b8-32c1-8e22-ead7517a7d4d",
                "word": "Raoul",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                        "entry_id": "d4acc6eb-c2b8-32c1-8e22-ead7517a7d4d",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38c9161b-208c-45ce-ba78-2b73950f02fd",
                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                "text": "– Arsène Lupin ou Raoul d’Andrésy, qu’importe ! L’essentiel, c’est de réussir."
                            },
                            {
                                "example_id": "569e0298-8ece-48ad-95de-3005d7f471cc",
                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                "text": "Raoul n’était pas un Lovelace. Bien des sentiments de probité et de délicatesse s’opposaient en lui au déchaînement d’instincts et d’appétits dont il connaissait la violence excessive."
                            },
                            {
                                "example_id": "664ff3e9-3f0d-426d-8e63-0a979d6c6ed5",
                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                "text": "Résultat : ils n’en auront pas ! Nous les mangerons nous deux, Raoul…"
                            },
                            {
                                "example_id": "40131e95-dd0f-4857-9e40-8bcc46ddb4a9",
                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                "text": "La glose est définitoire, ce qui autorise Raoul de Presles à ne pas redéfinir ou regloser le terme dans la deuxième occurrence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c456d88f-0cb0-46ce-9b96-747bce4f5a9e",
                        "source_entry_id": "d4acc6eb-c2b8-32c1-8e22-ead7517a7d4d",
                        "source_sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                        "source_sense_description": "prénom",
                        "target_lang_word": "Ralf",
