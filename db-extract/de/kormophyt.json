                        "sense_id": "59e6c3a6-1c62-30d5-bf70-1c099e817fd4",
                        "entry_id": "acfed19a-9fcb-34bc-926f-1aba859ca43f",
                        "glosses": [
                            "Vertreter der höheren Pflanzen, deren Kormus (Vegetationskörper) stets in die Grundorgane Wurzel, Sprossachse und Blatt/Blätter gegliedert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b28328-66cc-49e7-836a-5da8a32c95ab",
                                "sense_id": "59e6c3a6-1c62-30d5-bf70-1c099e817fd4",
                                "text": "«Im Gegensatz zu den Thallophyten weisen Kormophyten eine Epidermis (…), Leitbündel und Festigungsgewebe auf; […]»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecd2e802-b6c7-47c8-9955-5cd6f3028e33",
                        "source_entry_id": "acfed19a-9fcb-34bc-926f-1aba859ca43f",
                        "source_sense_id": "59e6c3a6-1c62-30d5-bf70-1c099e817fd4",
                        "source_sense_description": "Vertreter der höheren Pflanzen, deren Kormus stets in die Grundorgane Wurzel, Sprossachse und Blatt/Blätter gegliedert ist",
                        "target_lang_word": "cormophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cormophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f0b4c0-c41c-337d-8a78-60dcde16615c",
                                        "entry_id": "b59c516f-986c-3faf-b8b6-7a788202ee6c",
                                        "glosses": [
                                            "Any plant having a proper stem or axis of growth, which is distinct from its leaves, phyllophyte"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fe9118-e5c0-4ec2-b13f-967545ed1ca8",
                                                "sense_id": "b6f0b4c0-c41c-337d-8a78-60dcde16615c",
                                                "text": "Very careful developmental or anatomical investigation may be required to show that the variously-constructed organs of many cormophytes are derived by the metamorphosis of the three primary organs, root, stem, and leaf, and to ascertain with which of these any particular structure is really homologous."
                                            },
                                            {
                                                "example_id": "0985c7de-e623-469a-9e03-f24bfd75a1e4",
                                                "sense_id": "b6f0b4c0-c41c-337d-8a78-60dcde16615c",
                                                "text": "Botany used to recognize, if vaguely, these two kinds of plant, namely the thallophyte which grew and absorbed superficially, and the cormophyte, which is the root-shoot system with internal accommodation."
                                            },
                                            {
                                                "example_id": "ce544e91-bdb7-40ad-8700-6479d2986b15",
                                                "sense_id": "b6f0b4c0-c41c-337d-8a78-60dcde16615c",
                                                "text": "The morphology of cormophytes exhibits considerable variations in size, appearance of the various parts, and duration of the life cycle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
