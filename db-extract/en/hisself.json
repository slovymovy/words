                "senses": [
                    {
                        "sense_id": "be17852c-420c-37ea-9ce3-efaeecdc9a8f",
                        "entry_id": "d2515450-5c1c-3a80-9e3b-0813aeab4f20",
                        "glosses": [
                            "Himself."
                        ],
                        "tags": [
                            "dialectal",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ba09c0-fc87-4f4f-922f-964b822ae28b",
                                "sense_id": "be17852c-420c-37ea-9ce3-efaeecdc9a8f",
                                "text": "Among those who seemed disposed to join in this opinion was the Jehu of the Warwickshire coach, who expressed his conviction to our hero, that \"he wos a young gent as had much himproved hisself since he tooled him up to the 'Varsity with his guvnor.\""
                            },
                            {
                                "example_id": "05b2cc6c-85ff-4771-923e-2d2d4edda107",
                                "sense_id": "be17852c-420c-37ea-9ce3-efaeecdc9a8f",
                                "text": "Then when he had finally got through he sat down and luk'd as tho' he hisself would die of grief if they brought in a verdict of guilty."
                            },
                            {
                                "example_id": "3265a147-7cf7-49ea-97dc-e7b4da492314",
                                "sense_id": "be17852c-420c-37ea-9ce3-efaeecdc9a8f",
                                "text": "I sure hope he don't get hisself hurt one of these days, running his mouth thataway."
                            },
                            {
                                "example_id": "114d03a1-7c33-4851-8d25-ceacbb863e81",
                                "sense_id": "be17852c-420c-37ea-9ce3-efaeecdc9a8f",
                                "text": "‘Charles ain't exactly got his feet on the ground. Last week he swore to me that he was spending his nights in New Orleans manwhoring hisself.[…]’"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
