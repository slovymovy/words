                "senses": [
                    {
                        "sense_id": "fded2e64-9eec-3529-a35b-04420ebb0a9b",
                        "entry_id": "854fa1e9-ab93-3d41-9916-bae3c50a7ec2",
                        "glosses": [
                            "Creme mit Vanillegeschmack"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601ea7cb-30e0-48c5-a9af-571380793baa",
                                "sense_id": "fded2e64-9eec-3529-a35b-04420ebb0a9b",
                                "text": "„Angeekelt schleppt er den Körper hinter sich her und schreit jedes Mal auf, wenn er auf einer Lache aus Karamell oder Vanillecreme ausrutscht.“"
                            },
                            {
                                "example_id": "9a02e9d5-32b9-408e-86bc-082e0abf2d2a",
                                "sense_id": "fded2e64-9eec-3529-a35b-04420ebb0a9b",
                                "text": "„Ihre Finger fanden das Objekt ihrer Suche, und sie zog ein mit Vanillecreme beschmiertes Feuerzeug aus dem klebrigen Morast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
