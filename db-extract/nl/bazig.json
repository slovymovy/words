            {
                "entry_id": "9d030a40-7930-3bca-826c-43cf54c196a7",
                "word": "bazig",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f97749d8-5441-395c-a80e-90a1638412ab",
                        "entry_id": "9d030a40-7930-3bca-826c-43cf54c196a7",
                        "glosses": [
                            "in a bossy way"
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "15c9be42-689d-404e-9436-6ce6a77e7dc4",
                                "sense_id": "f97749d8-5441-395c-a80e-90a1638412ab",
                                "text": "Ze commandeerde haar medewerkers bazig rond.",
                                "translation": "She bossed her employees around in a bossy way.",
                                "english": "She bossed her employees around in a bossy way."
                            },
                            {
                                "example_id": "be040f56-462f-4a6e-8e3e-fc5bae7f7a73",
                                "sense_id": "f97749d8-5441-395c-a80e-90a1638412ab",
                                "text": "Hij gedroeg zich bazig en wilde altijd de controle hebben.",
                                "translation": "He behaved in a bossy way and always wanted to be in control.",
                                "english": "He behaved in a bossy way and always wanted to be in control."
                            }
                        ]
                    },
                    {
                        "sense_id": "e57b862a-4dde-35dc-b85c-d9910749ca68",
                        "entry_id": "9d030a40-7930-3bca-826c-43cf54c196a7",
                        "glosses": [
                            "firmly, soundly, in good measure (or more)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c4e89c-7c1a-47c9-b63f-2c477eb553d2",
                                "sense_id": "e57b862a-4dde-35dc-b85c-d9910749ca68",
                                "text": "Hij hield zijn standpunt bazig vast en gaf niet toe aan kritiek.",
                                "translation": "He firmly held his position and didn't give in to criticism.",
                                "english": "He firmly held his position and didn't give in to criticism."
                            },
                            {
                                "example_id": "17075f5e-7855-415e-bb99-86c227842fa1",
                                "sense_id": "e57b862a-4dde-35dc-b85c-d9910749ca68",
                                "text": "Ze sloot de deur bazig achter zich en liep weg.",
                                "translation": "She firmly closed the door behind her and walked away.",
                                "english": "She firmly closed the door behind her and walked away."
                            }
                        ]
                    }
                ],
