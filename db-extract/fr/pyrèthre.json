                                        "entry_id": "acc23749-485d-3917-bf76-928b21f994c6",
                                        "glosses": [
                                            "Any of several daisy-like perennial African plants of the genus Tanacetum, especially Tanacetum cinerariifolium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2e68a1-5850-4542-ab49-ee859b73a546",
                                                "sense_id": "f5437d68-dd36-3ca0-830e-7ed64cbb535a",
                                                "text": "A common beverage credited with aphrodisiac virtue was old wine containing the pungent root of the plant pyrethrum or pellitory."
                                            },
                                            {
                                                "example_id": "b439bdc2-01d9-462d-bc85-798435907f41",
                                                "sense_id": "f5437d68-dd36-3ca0-830e-7ed64cbb535a",
                                                "text": "We children would re-tell the stories the following day to other children who worked in the fields picking the pyrethrum flowers, tea-leaves or coffee beans of our European and African landlords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ef4d44-3b2a-36ce-8b20-833b497adb26",
                                        "entry_id": "acc23749-485d-3917-bf76-928b21f994c6",
                                        "glosses": [
