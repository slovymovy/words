    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99a83e7f-d7af-318b-b795-87416a93b5e7",
                    "sense_definition": "Full of heart; cordial; sincere and warm",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cordial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host gave us a <w>heartly</w> welcome when we arrived at his home.",
                            "target_lang_translations": {
                                "tr": "Ev sahibi, evine vardığımızda bizi <w>içten bir şekilde</w> karşıladı."
                            }
                        },
                        {
                            "text": "She offered her <w>heartly</w> thanks for all the support during the difficult time.",
                            "target_lang_translations": {
                                "tr": "Zor zamanlardaki tüm destekleri için <w>içten</w> teşekkürlerini sundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "cordial",
                        "sincere",
                        "warm"
                    ],
                    "antonyms": [
                        "insincere",
                        "cold"
                    ],
                    "common_phrases": [
                        "heartly welcome",
                        "heartly thanks"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is largely replaced by 'hearty' in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İçten, samimi, candan ve sıcak duygularla dolu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "içten",
                                "target_lang_sense_clarification": "Samimi ve yürekten gelen duygular için kullanılır."
                            },
                            {
                                "target_lang_word": "candan",
                                "target_lang_sense_clarification": "İçtenlik ve sıcaklık belirten davranışlar için kullanılır."
                            },
                            {
                                "target_lang_word": "samimi",
                                "target_lang_sense_clarification": "İçten ve yapmacıksız olan durumlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a3e0ccd4-3421-39e6-940a-95e06a8c7425",
                    "sense_definition": "In a sincere, warm, or cordial manner",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cordial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They laughed <w>heartly</w> at the funny story told by their old friend.",
                            "target_lang_translations": {
                                "tr": "Eski arkadaşlarının anlattığı komik hikayeye <w>içtenlikle</w> güldüler."
                            }
                        },
                        {
                            "text": "He greeted his guests <w>heartly</w> as they walked through the front door.",
                            "target_lang_translations": {
                                "tr": "Misafirleri ön kapıdan içeri girdiklerinde onları <w>candan</w> selamladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "cordially",
                        "sincerely"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is largely replaced by 'heartily' in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İçten, samimi veya candan bir şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "içtenlikle",
                                "target_lang_sense_clarification": "Bir eylemin samimi bir şekilde yapıldığını belirtir."
                            },
                            {
                                "target_lang_word": "candan",
                                "target_lang_sense_clarification": "Bir eylemin sıcak ve samimi bir tavırla yapıldığını belirtir."
                            }
                        ]
                    }
                }
            ]
        }
    ]
