                "senses": [
                    {
                        "sense_id": "df8c9b65-fdaf-3bd9-a0e7-0d24f2adb297",
                        "entry_id": "7d92737d-533f-31eb-b940-826103a43a50",
                        "glosses": [
                            "verdickte Stellen an Stielen oder am Blattgrund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12c8a1e-12d6-4782-a535-99c2fced36bb",
                                "sense_id": "df8c9b65-fdaf-3bd9-a0e7-0d24f2adb297",
                                "text": "„Schief gegenständige Knospen und ausgeprägte Blattkissen verleihen den Zweigen ein knotiges Aussehen.“"
                            },
                            {
                                "example_id": "0ae835c6-469e-40b5-b9b4-3e8ae8bcf63f",
                                "sense_id": "df8c9b65-fdaf-3bd9-a0e7-0d24f2adb297",
                                "text": "„Generell für Tsuga: Nadeln deutlich gestielt, Stielchen dem Zweig angliegend und auf deutlichen Blattkissen sitzend.“"
                            },
                            {
                                "example_id": "d1f0625f-8f2d-46b0-91e8-0f60ed95148f",
                                "sense_id": "df8c9b65-fdaf-3bd9-a0e7-0d24f2adb297",
                                "text": "„Bei der Stieleiche sitzen die Knospen auf großen Blattkissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "165d6df8-d40b-3efb-9bf5-1a035228d466",
                        "entry_id": "7d92737d-533f-31eb-b940-826103a43a50",
                        "glosses": [
                            "Auf ein Brett genageltes Kissen aus Schafleder, auf welchem Blattgold und Blattsilber geschnitten wird"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "438da3b5-073a-4aa4-8e19-e5ff1451b0db",
                                "sense_id": "165d6df8-d40b-3efb-9bf5-1a035228d466",
                                "text": "„Blattkissen, Schneidekissen heißt das ausgestopfte mit zartem Schaafleder überzogene Kissen der Goldschläger, auf welchem sie ihre Gold- und Silberblätter zu der gehörigen Größe schneiden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
