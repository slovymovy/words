                        "sense_id": "f1825a7f-4679-3000-9448-17bc6df8c505",
                        "entry_id": "014c1cb9-2308-38eb-b87a-f621f4217a00",
                        "glosses": [
                            "een middel dat aan water wordt toegevoegd om het vriespunt van het mengsel te verlagen en zo schade door bevriezing te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b4cac3-c002-4f33-9433-587dbc45c2b5",
                                "sense_id": "f1825a7f-4679-3000-9448-17bc6df8c505",
                                "text": "FlevOnice ging in mei van dit jaar failliet. Niet lang daarna kwam naar buiten dat er meer dan een kwart van al het antivriesmiddel uit het koelleidingsysteem was weggelekt. Het laatste onderzoek naar de ontstane milieuschade zal over ongeveer twee weken klaar zijn."
                            },
                            {
                                "example_id": "fec866c4-a8a4-4336-b32c-d90f8b9ff9bd",
                                "sense_id": "f1825a7f-4679-3000-9448-17bc6df8c505",
                                "text": "Als je doodverklaard bent, moet je lichaam binnen een paar uur al gekoeld worden. Daarna wordt je bloed vervangen door glycerol, een soort antivriesmiddel, om te voorkomen dat weefsel beschadigt door bevriezing. Dan begint het koelen tot een temperatuur onder de -130 graden."
                            }
                        ]
                    }
