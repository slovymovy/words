                "senses": [
                    {
                        "sense_id": "5136be94-3a02-33ff-ae52-37628b8b91ad",
                        "entry_id": "d52020f5-2752-3009-a109-de37b5a2a1f3",
                        "glosses": [
                            "L'un de l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c49bd2b-c86d-4cb0-97fd-6448e22b1e0d",
                                "sense_id": "5136be94-3a02-33ff-ae52-37628b8b91ad",
                                "text": "Unsere Verfassung schützt und gibt Rechte, sie legt Pflichten auf, die von jedem und jeder erfüllt werden müssen. Beides kann man nicht voneinander trennen.",
                                "translation": "Notre Constitution protège et donne des droits, elle impose des devoirs qui doivent être remplis par chacun et chacune. Les deux sont indissociables."
                            },
                            {
                                "example_id": "094cae49-ff32-4b78-89ef-81513a095e5e",
                                "sense_id": "5136be94-3a02-33ff-ae52-37628b8b91ad",
                                "text": "Die Fähigkeit zu fliegen hat sich in der Evolution gleich viermal unabhängig voneinander entwickelt.",
                                "translation": "La capacité de voler s’est développée indépendamment à quatre reprises au cours de l’évolution."
                            }
                        ]
                    }
                ],
