            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ac5a4c1-8003-387f-a793-a9f2981cfa66",
                    "sense_definition": "Ein helles, wiederholtes Geräusch mit einer Glocke oder Klingel erzeugen oder von sich geben.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "akustisches_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du ankommst, musst du bitte laut an der Tür <w>klingeln</w>."
                        },
                        {
                            "text": "Jeden Morgen um sechs Uhr <w>klingelt</w> mein Wecker auf dem Nachttisch."
                        }
                    ],
                    "synonyms": [
                        "läuten",
                        "bimmeln",
                        "schellen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "an der Tür klingeln",
                        "der Wecker klingelt",
                        "das Telefon klingelt"
                    ]
                },
                {
                    "sense_id": "88eb5543-202b-320c-9cb3-b44ea75bfc46",
                    "sense_definition": "Bei jemandem eine Erinnerung wecken oder eine Erkenntnis auslösen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedaechtnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein Gesicht kenne ich gut, aber bei dem Namen <w>klingelt</w> es bei mir gar nicht."
                        },
                        {
                            "text": "Erst als sie das alte Foto sah, <w>klingelte</w> es endlich bei ihr."
                        }
                    ],
                    "common_phrases": [
                        "bei jemandem klingeln"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                },
                {
                    "sense_id": "c64ab235-0af6-3acb-ac56-0ea7ead48ecf",
                    "sense_definition": "Ein anhaltendes Geräusch oder Pfeifen im Gehörgang wahrnehmen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "koerperwahrnehmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem lauten Konzert hat es noch den ganzen Abend in meinen Ohren <w>geklingelt</w>."
                        },
                        {
                            "text": "Wegen der starken Erkältung beginnt es manchmal unangenehm in den Ohren zu <w>klingeln</w>."
                        }
                    ],
                    "common_phrases": [
                        "in den Ohren klingeln"
                    ]
                },
                {
                    "sense_id": "254dd9c1-c83d-3383-a211-fd9eb3cb296d",
                    "sense_definition": "Ein unregelmäßiges, metallisch klopfendes Geräusch durch fehlerhafte Verbrennung im Motor erzeugen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn der Zündzeitpunkt falsch eingestellt ist, kann der Motor beim starken Beschleunigen hörbar <w>klingeln</w>."
                        },
                        {
                            "text": "Wegen des minderwertigen Benzins <w>klingelte</w> das alte Fahrzeug bei jeder Bergauffahrt."
                        }
                    ]
                }
            ]
        },
