                    {
                        "sense_id": "51c04f30-162c-3d4d-a4cd-7802149da3bf",
                        "entry_id": "644d5dec-2b0f-3866-9a97-02fe8f201df1",
                        "glosses": [
                            "Celui qui travaille dans un four à chaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a29b16e6-2355-4606-98ce-43536f12d0d0",
                                "sense_id": "51c04f30-162c-3d4d-a4cd-7802149da3bf",
                                "text": "C’est pour m’assurer de ce fait que je fis ramasser autour du four à chaux une grande quantité de ces pierres que les chaufourniers appellent du biscuit, & qu’ils jettent, comme n’étant pas assez calcinées : en effet quand on les met dans l’eau, elles ne font point d’effervescence & ne se dissolvent pas."
                            },
                            {
                                "example_id": "e82e0d3d-7fc0-4758-8d4e-628130450a33",
                                "sense_id": "51c04f30-162c-3d4d-a4cd-7802149da3bf",
                                "text": "Les enfants du chaufournier, reprit-elle, auront l’air de mendiants."
                            }
                        ]
                    },
