                "senses": [
                    {
                        "sense_id": "ad749dd8-d85f-3246-8c1d-fcc32ed5e3d1",
                        "entry_id": "01075b0e-9656-34f4-a8f0-d8d3a42429ec",
                        "glosses": [
                            "kamień półszlachetny, odmiana chalcedonu o równoległym ułożeniu warstewek, na przemian białej i czarnej lub ciemnobrunatnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e93dd2-3fcf-469b-8203-72f9f000f744",
                                "sense_id": "ad749dd8-d85f-3246-8c1d-fcc32ed5e3d1",
                                "text": "To była prosta formuła: idź gdzie płynie rzeka Bdelion i gdzie rodzi się kamień onychin. Onychin znaczy onyks. Z onyksu zbudowany jest tron Najwyższego i obramienie trybunału Sądu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29c273e9-80fd-4e8a-ad71-43f2a0ef9735",
                        "source_entry_id": "01075b0e-9656-34f4-a8f0-d8d3a42429ec",
                        "source_sense_id": "ad749dd8-d85f-3246-8c1d-fcc32ed5e3d1",
                        "target_lang_word": "onyx",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onyx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f16266cb-7d40-3fc7-b89c-ea8f30787303",
                                        "entry_id": "f1ccf2b9-111a-3abd-b867-93ebb8a14237",
                                        "glosses": [
                                            "A banded variety of chalcedony, a cryptocrystalline form of quartz."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80142330-26e6-4a68-9f7c-6a626deb4d35",
                                                "sense_id": "f16266cb-7d40-3fc7-b89c-ea8f30787303",
                                                "text": "People talk about using marble in the bathrooms. Marble wasn't good enough for use—we have onyx!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353c3063-3873-34cd-8652-4c3cf6171dec",
                                        "entry_id": "f1ccf2b9-111a-3abd-b867-93ebb8a14237",
                                        "glosses": [
                                            "A jet-black color, named after the gemstone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff0c1d81-ac9c-38ba-ba0e-ee6eb665e2f8",
                                        "entry_id": "f1ccf2b9-111a-3abd-b867-93ebb8a14237",
                                        "glosses": [
                                            "Any of various lycaenid butterflies of the genus Horaga."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "onyx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e589d198-dc9f-3412-a0ab-55dfefdcff18",
                                        "entry_id": "6747a157-166f-3a3e-8504-bfa89c73cd95",
                                        "glosses": [
                                            "jet-black"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b4f2da2-92a4-4367-ad62-b7545fe44ede",
                                                "sense_id": "e589d198-dc9f-3412-a0ab-55dfefdcff18",
                                                "text": "And the gold of that land is good: there is bdellium and the onyx stone."
                                            },
                                            {
                                                "example_id": "a3a0887a-2b29-4de0-b018-de11bf66ff95",
                                                "sense_id": "e589d198-dc9f-3412-a0ab-55dfefdcff18",
                                                "text": "There was no moon, only stars set brilliantly in the soft black onyx of the sky : a black night and very silent on Cimiez ; and a black and silent prospect from the verandah […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ee266a-49f4-4801-944e-79e77f817d45",
                        "source_entry_id": "01075b0e-9656-34f4-a8f0-d8d3a42429ec",
                        "source_sense_id": "ad749dd8-d85f-3246-8c1d-fcc32ed5e3d1",
                        "target_lang_word": "ónice",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ónice",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "95aace9b-ef17-3ee7-a2fb-3032e92f84a6",
                                        "entry_id": "b5983ebf-52fe-3f06-8455-862256e75eba",
                                        "glosses": [
                                            "Mineral del grupo IV (óxidos), según la clasificación de Strunz, considerado como piedra semipreciosa. Está compuesto de sílice (óxido de silicio, SiO₂). Tiene un origen volcánico, originada por la acumulación de gases volcánicos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56ba5b0-1146-4a4f-a92d-f2f091749fed",
                                                "sense_id": "95aace9b-ef17-3ee7-a2fb-3032e92f84a6",
                                                "text": "«Cuando uno se arriesgaba a denunciar la llegada de cargamentos de droga, que se aprehendían, se ponían las medallas, y se quedaban con el sobre, sin justificar ante nadie, que supuestamente tendría que ir al pago de esa confidencia, pero que a lo mejor se quedó en el baño de ónice que aquel marmolista portugués de Navalcarnero le instaló al señor Roldán en su casa de la calle Platerías»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9df99df5-0327-47d7-a6c3-84568085e9bf",
                        "source_entry_id": "01075b0e-9656-34f4-a8f0-d8d3a42429ec",
                        "source_sense_id": "ad749dd8-d85f-3246-8c1d-fcc32ed5e3d1",
                        "target_lang_word": "Onyx",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onyx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3479522e-e646-3d13-91ce-b93fa88c76b4",
                                        "entry_id": "e5782f03-c360-3625-bd56-45ab26ec87bf",
                                        "glosses": [
                                            "ein undurchsichtiger, meist schwarz-weiß gestreifter Halbedelstein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aa266b7-10b0-40e9-aa3a-406c42d32ff8",
                                                "sense_id": "3479522e-e646-3d13-91ce-b93fa88c76b4",
                                                "text": "Onyx wird nur zu Schmuckstücken verarbeitet."
                                            },
                                            {
                                                "example_id": "5e60fc37-fa71-4c97-bc1d-536797917ddd",
                                                "sense_id": "3479522e-e646-3d13-91ce-b93fa88c76b4",
                                                "text": "„Mein lieber Bruder Giovanni machte mir einen herrlichen Onyx zum Geschenk, eine Gemme mit dem Basrelief einer schwimmenden Venus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
