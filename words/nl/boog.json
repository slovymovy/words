            "pos": "noun",
            "senses": [
                {
                    "sense_id": "390d8453-93c6-38d2-87b5-1361b74b6b0c",
                    "sense_definition": "een wapen waarmee een pijl weggeschoten kan worden",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "wapens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager gebruikte een houten <w>boog</w> om op herten te jagen in het bos.",
                            "target_lang_translations": {
                                "en": "The hunter used a wooden <w>bow</w> to hunt deer in the forest.",
                                "ru": "Охотник использовал деревянный <w>лук</w>, чтобы охотиться на оленей в лесу."
                            }
                        },
                        {
                            "text": "In de film heeft de heldin een prachtige <w>boog</w> die ze altijd bij zich draagt.",
                            "target_lang_translations": {
                                "en": "In the movie, the heroine has a beautiful <w>bow</w> that she always carries with her.",
                                "ru": "В фильме у героини есть прекрасный <w>лук</w>, который она всегда носит с собой."
                            }
                        }
                    ],
                    "synonyms": [
                        "handboog"
                    ],
                    "common_phrases": [
                        "pijl en boog"
                    ],
                    "target_lang_definitions": {
                        "en": "a weapon used to shoot an arrow",
                        "ru": "оружие, из которого можно стрелять стрелами"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bow",
                                "target_lang_sense_clarification": "weapon for arrows"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лук",
                                "target_lang_sense_clarification": "оружие для стрельбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221bfe09-f6c7-3f3a-a9ea-f7f9ecb532ab",
                    "sense_definition": "een deel van een bouwwerk in een ronde vorm waar men onderdoor kan gaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude brug heeft een prachtige stenen <w>boog</w> over het water.",
                            "target_lang_translations": {
                                "en": "The old bridge has a beautiful stone <w>arch</w> over the water.",
                                "ru": "У старого моста есть красивая каменная <w>арка</w> над водой."
                            }
                        },
                        {
                            "text": "We liepen onder de <w>boog</w> van de poort door om de stad te betreden.",
                            "target_lang_translations": {
                                "en": "We walked under the <w>arch</w> of the gate to enter the city.",
                                "ru": "Мы прошли под <w>аркой</w> ворот, чтобы войти в город."
                            }
                        }
                    ],
                    "common_phrases": [
                        "triomfboog"
                    ],
                    "target_lang_definitions": {
                        "en": "a part of a building in a round shape that one can pass under",
                        "ru": "часть строения округлой формы, под которой можно пройти"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arch",
                                "target_lang_sense_clarification": "architectural structure"
                            },
                            {
                                "target_lang_word": "archway",
                                "target_lang_sense_clarification": "passage under an arch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "арка",
                                "target_lang_sense_clarification": "архитектурное сооружение"
                            },
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "перекрытие в виде дуги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7145dd6-73b4-345f-b757-88ed8e1b3354",
                    "sense_definition": "een gekromde lijn of vorm, zoals een deel van een cirkel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bal vloog met een hoge <w>boog</w> over het hek heen.",
                            "target_lang_translations": {
                                "en": "The ball flew over the fence in a high <w>arc</w>.",
                                "ru": "Мяч перелетел через забор по высокой <w>дуге</w>."
                            }
                        },
                        {
                            "text": "De zon beschrijft elke dag een <w>boog</w> langs de hemel.",
                            "target_lang_translations": {
                                "en": "The sun describes an <w>arc</w> across the sky every day.",
                                "ru": "Солнце каждый день описывает <w>дугу</w> по небу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met een grote boog"
                    ],
                    "target_lang_definitions": {
                        "en": "a curved line or shape, such as part of a circle",
                        "ru": "изогнутая линия или форма, например, часть круга"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arc",
                                "target_lang_sense_clarification": "curved path or line"
                            },
                            {
                                "target_lang_word": "curve",
                                "target_lang_sense_clarification": "bent shape"
                            },
                            {
                                "target_lang_word": "bow",
                                "target_lang_sense_clarification": "curved shape"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дуга",
                                "target_lang_sense_clarification": "кривая линия"
                            },
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "кривизна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7676a0b4-3a77-3126-8c25-4c41787eb83c",
                    "sense_definition": "het holle, gewelfde gedeelte aan de onderkant van de menselijke voet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goede schoenen moeten de <w>boog</w> van je voet voldoende ondersteunen.",
                            "target_lang_translations": {
                                "en": "Good shoes should provide enough support for the <w>arch</w> of your foot.",
                                "ru": "Хорошая обувь должна достаточно поддерживать <w>свод</w> стопы."
                            }
                        },
                        {
                            "text": "Hij heeft last van zijn voeten omdat de <w>boog</w> een beetje is doorgezakt.",
                            "target_lang_translations": {
                                "en": "His feet are bothering him because the <w>arch</w> has collapsed a bit.",
                                "ru": "У него болят ноги, потому что <w>свод</w> стопы немного опустился."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the hollow, curved part on the bottom of the human foot",
                        "ru": "вогнутая, сводчатая часть нижней стороны человеческой стопы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arch",
                                "target_lang_sense_clarification": "part of the foot"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "часть стопы"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "изгиб стопы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da2cda48-53ac-35b4-bca6-8ab5eb5fa9ad",
                    "sense_definition": "enkelvoud verleden tijd van <w>buigen</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>boog</w> diep voor de koningin tijdens de officiële ceremonie.",
                            "target_lang_translations": {
                                "en": "He <w>bowed</w> deeply to the queen during the official ceremony.",
                                "ru": "Он низко <w>поклонился</w> королеве во время официальной церемонии."
                            }
                        },
                        {
                            "text": "Ik <w>boog</w> me voorover om mijn veters goed vast te strikken.",
                            "target_lang_translations": {
                                "en": "I <w>bent</w> over to tie my laces properly.",
                                "ru": "Я <w>наклонился</w> вперед, чтобы хорошенько завязать шнурки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boog voorover"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular past tense of 'to bend'",
                        "ru": "форма единственного числа прошедшего времени глагола 'buigen' (кланяться, гнуться)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bent",
                                "target_lang_sense_clarification": "past tense of bend"
                            },
                            {
                                "target_lang_word": "bowed",
                                "target_lang_sense_clarification": "past tense of bow (gesture)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "поклонился",
                                "target_lang_sense_clarification": "сделал поклон"
                            },
                            {
                                "target_lang_word": "наклонился",
                                "target_lang_sense_clarification": "согнулся вперед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255206ff-5aa3-3574-be59-32f0d56f0a6f",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>bogen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>boog</w> op mijn jarenlange ervaring in dit vakgebied.",
                            "target_lang_translations": {
                                "en": "I <w>boast</w> of my years of experience in this field.",
                                "ru": "Я <w>горжусь</w> своим многолетним опытом в этой области."
                            }
                        },
                        {
                            "text": "Hoewel ik niet graag opschep, <w>boog</w> ik soms op mijn successen.",
                            "target_lang_translations": {
                                "en": "Although I don't like to brag, I sometimes <w>pride myself</w> on my successes.",
                                "ru": "Хотя я не люблю хвастаться, иногда я <w>горжусь</w> своими успехами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bogen op"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present tense singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to boast' or 'to pride oneself on'",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'bogen' (гордиться чем-либо)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "to take pride in"
                            },
                            {
                                "target_lang_word": "pride myself",
                                "target_lang_sense_clarification": "to be proud of"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "горжусь",
                                "target_lang_sense_clarification": "хвастаюсь достижениями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
