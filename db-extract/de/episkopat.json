                    }
                ],
                "translations": [
                    {
                        "translation_id": "59a97b2b-4d74-482b-9214-e9e444218b70",
                        "source_entry_id": "95ddaaaf-34ee-3244-99f6-81a9988e2233",
                        "source_sense_id": "4fa4f4ac-83d7-3032-8b83-ad809012c656",
                        "source_sense_description": "Bischofsamt",
                        "target_lang_word": "épiscopat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épiscopat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43318f6f-5e32-33fb-83a2-e90a03e900e5",
                                        "entry_id": "f9ecc6eb-9358-33e8-aadb-b195b8d46f15",
                                        "glosses": [
                                            "Dignité d’évêque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f933f6ab-6ab0-4d97-a4d5-9f210df8e16e",
                                                "sense_id": "43318f6f-5e32-33fb-83a2-e90a03e900e5",
                                                "text": "Le jour où l’abbé Le Tilloy des Mofflaines fut promu à l’épiscopat, il supplia Gévresin de le suivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1cf255-36e5-31e7-a912-7110be12e677",
                                        "entry_id": "f9ecc6eb-9358-33e8-aadb-b195b8d46f15",
                                        "glosses": [
                                            "Corps des évêques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a2c80b9-a69b-4bf2-8624-6aab90685ae7",
                                                "sense_id": "ea1cf255-36e5-31e7-a912-7110be12e677",
                                                "text": "« Rien n'est prévu pour le moment », a déclaré un porte-parole de l’épiscopat argentin, le prêtre Jorge Oesterheld."
                                            },
                                            {
                                                "example_id": "5613f284-9c6f-4b13-8ca9-cf08d8a9e1e0",
                                                "sense_id": "ea1cf255-36e5-31e7-a912-7110be12e677",
                                                "text": "Avant même l'assemblée de Winnipeg, l'Église du Canada donnait des signes de division, parmi ses communautés locales mais aussi au sein de la hiérarchie. Ainsi, en mai dernier, dans une lettre au clergé et aux fidèles, l’épiscopat émettait une réserve quant à cette « bénédiction », déjà acceptée à Vancouver et à Toronto."
                                            },
                                            {
                                                "example_id": "ece8367c-79b4-4d05-acdb-e1e96aadb0d9",
                                                "sense_id": "ea1cf255-36e5-31e7-a912-7110be12e677",
                                                "text": "Les conciles généraux par contre, sont ceux auxquels est largement représenté l’épiscopat des diverses parties de la chrétienneté, mais auxquels n'a pas été reconnu le caractère de l’œcuménicité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd209856-c933-350d-819b-6f9bd8d83a5a",
                                        "entry_id": "f9ecc6eb-9358-33e8-aadb-b195b8d46f15",
                                        "glosses": [
                                            "Temps pendant lequel un évêque a occupé son siège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cfb0151-1fa9-4414-af4f-c56639b0be64",
                                                "sense_id": "fd209856-c933-350d-819b-6f9bd8d83a5a",
                                                "text": "Le chœur, le transept et les chapelles ont été élevés sous l’épiscopat de Pierre de Roquefort, de 1300 à 1320."
                                            },
                                            {
                                                "example_id": "9cc38e44-7145-4287-8666-f05bf5b459cc",
                                                "sense_id": "fd209856-c933-350d-819b-6f9bd8d83a5a",
                                                "text": "Après la mort de l'évêque Éracle de Liège dont l'épiscopat avait été agité, Notger est nommé pour le remplacer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eacde88-4606-4718-9568-26bab5242ccb",
                        "source_entry_id": "95ddaaaf-34ee-3244-99f6-81a9988e2233",
