                    },
                    {
                        "translation_id": "92d03063-7e82-4fb4-bc33-de3c42fe88d0",
                        "source_entry_id": "e7e0622f-0a7c-3f23-aac1-1ea0ef551425",
                        "source_sense_id": "1f8c71e2-bf5a-32e4-bb2f-dac7a2de4b31",
