                        "entry_id": "77f5bf80-2552-3252-9f0c-5737afc6f189",
                        "glosses": [
                            "Ancienne orthographe de saligaud."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ee2c76ae-0ef6-4c7e-a62b-70f8e606fc5a",
                                "sense_id": "df881d16-172b-3a47-8301-84030d37db43",
                                "text": "Oh! alors, quelles femmes! − Jamais de saligotes, princesse, mais des femmes. — (Goncourt, Journal)"
                            },
                            {
                                "example_id": "0e0d6eef-8b2b-4218-8edf-2d2cc7d0d973",
                                "sense_id": "df881d16-172b-3a47-8301-84030d37db43",
                                "text": "… vous n'eussiez jamais été qu'un capuchon à pitance, un saligot défroqué, …"
                            },
                            {
                                "example_id": "d582ac8e-8ed7-41cf-8f76-21f7b6fabf77",
                                "sense_id": "df881d16-172b-3a47-8301-84030d37db43",
                                "text": "— J’espère que tu seras bien sage demain ; si tu n’es pas sage, je te fouetterai. Donnez-donc de jolies choses à ce saligot, pour qu’il les abîme. »"
                            },
                            {
                                "example_id": "639f2316-4abf-4415-920d-b21f72a30d28",
                                "sense_id": "df881d16-172b-3a47-8301-84030d37db43",
                                "text": "Je ne sais pas, Monsieur, votre fils Hippolyte, Avec tous ses grands airs bigots et ses mines de carmélite, est bien le roi des saligots !"
                            }
                        ]
                    }
