    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6393c622-cf0d-36b5-9ea9-473ce8e05d4f",
                    "sense_definition": "Qui fait preuve d'une exactitude méthodique et d'une stricte précision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exactitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chercheur applique une méthode particulièrement <w>rigoureuse</w> pour valider ses résultats."
                        },
                        {
                            "text": "Ce protocole exige un suivi <w>rigoureux</w> de chaque étape de fabrication."
                        }
                    ],
                    "synonyms": [
                        "méticuleux",
                        "précis",
                        "strict"
                    ],
                    "antonyms": [
                        "approximatif",
                        "laxiste",
                        "négligent"
                    ],
                    "common_phrases": [
                        "contrôle rigoureux",
                        "méthode rigoureuse",
                        "analyse rigoureuse"
                    ]
                },
                {
                    "sense_id": "3c519997-9d58-374f-9bf3-bca0b0e55464",
                    "sense_definition": "Qui est particulièrement rude, très froid et difficile à supporter, en parlant du climat ou d'une saison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "climat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants de cette région de montagne doivent affronter un hiver particulièrement <w>rigoureux</w>."
                        },
                        {
                            "text": "Malgré les températures négatives d'une saison <w>rigoureuse</w>, les animaux trouvent refuge dans les granges."
                        }
                    ],
                    "synonyms": [
                        "rude",
                        "âpre",
                        "glacial"
                    ],
                    "antonyms": [
                        "doux",
                        "clément"
                    ],
                    "common_phrases": [
                        "hiver rigoureux",
                        "climat rigoureux"
                    ]
                },
                {
                    "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                    "sense_definition": "Qui fait preuve d'une sévérité inflexible et ne tolère aucun manquement, en parlant d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "severite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur <w>rigoureux</w> n'accepte aucun retard dans le rendu des devoirs."
                        },
                        {
                            "text": "Même s'il est exigeant et très <w>rigoureux</w> avec ses employés, le directeur reste juste."
                        }
                    ],
                    "synonyms": [
                        "sévère",
                        "inflexible",
                        "intransigeant"
                    ],
                    "antonyms": [
                        "indulgent",
                        "clément",
                        "tolérant"
                    ],
                    "common_phrases": [
                        "professeur rigoureux",
                        "juge rigoureux"
                    ]
                },
                {
                    "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                    "sense_definition": "Qui est dur, strict ou contraignant, en parlant d'une règle, d'une mesure ou d'un cadre imposé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "severite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'établissement a mis en place une discipline particulièrement <w>rigoureuse</w> pour garantir le calme."
                        },
                        {
                            "text": "Les athlètes doivent respecter un entraînement <w>rigoureux</w> avant les compétitions internationales."
                        }
                    ],
                    "synonyms": [
                        "strict",
                        "drastique",
                        "contraignant"
                    ],
                    "antonyms": [
                        "souple",
                        "permissif"
                    ],
                    "common_phrases": [
                        "discipline rigoureuse",
                        "règlement rigoureux"
                    ]
                }
            ]
        }
    ]
