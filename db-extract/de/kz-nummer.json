                "senses": [
                    {
                        "sense_id": "a2981e63-4d29-3be2-89b8-a4023db92ae5",
                        "entry_id": "3da4bd7c-87fc-3a59-8e6a-6f75ca44664a",
                        "glosses": [
                            "Registriernummer für einen KZ-Häftling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56686aa-3f28-4763-92f5-e9616d8168db",
                                "sense_id": "a2981e63-4d29-3be2-89b8-a4023db92ae5",
                                "text": "„Ich wollte der Frau sagen, wie es mich schmerzte, ihre KZ-Nummer zu sehen, aber ich wagte es nicht, sie darauf anzusprechen.“"
                            },
                            {
                                "example_id": "c1a9261a-c599-4865-ba97-6e7e4cf33ca0",
                                "sense_id": "a2981e63-4d29-3be2-89b8-a4023db92ae5",
                                "text": "„Und weil sie ihnen das alles nicht so gut erklären kann, und weil die Kinder nicht glauben können, daß das alles geschehen ist, klebt sie ein Heftpflaster über die KZ-Nummer auf ihrem Arm und schweigt.“"
                            },
                            {
                                "example_id": "6d12af14-abfe-486e-827d-7853703b5671",
                                "sense_id": "a2981e63-4d29-3be2-89b8-a4023db92ae5",
                                "text": "„Ich kriegte meine KZ-Nummer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
