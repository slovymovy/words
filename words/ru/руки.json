                    "sense_definition": "Форма именительного или винительного падежа множественного числа существительного <w>рука</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед едой нужно обязательно мыть <w>руки</w> с мылом.",
                            "target_lang_translations": {
