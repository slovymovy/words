                        "glosses": [
                            "Digne du faste et des débauches de l'empereur romain Héliogabale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e7b3e77-f31f-4a72-88ca-cd07a5b7b895",
                                "sense_id": "4dc65aa7-f287-3044-a2bc-82dd184d6280",
                                "text": "Ô charmant éphèbe, au contour\nHéliogabalesque,\nTu mériterais, pour ce tour,\nQu'on te knoutât — ou presque !"
                            },
                            {
                                "example_id": "52f824e9-774b-4c63-a5b0-def53a35db0f",
                                "sense_id": "4dc65aa7-f287-3044-a2bc-82dd184d6280",
                                "text": "Il obtint, grâce à elle [une obole], les faveurs de la giletière à l’issue d’un héliogabalesque festin, pris sous la tonnelle fleurie d’une gargote banlieusarde."
                            }
                        ]
                    }
