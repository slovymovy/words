    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                    "sense_definition": "A drop of clear, salty liquid produced from the eyes by crying or irritation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "crying_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Big <w>tears</w> streamed from her eyes as she watched the sad movie.",
                            "target_lang_translations": {
                                "ru": "Крупные <w>слёзы</w> текли из её глаз, пока она смотрела грустный фильм.",
                                "fr": "De grosses <w>larmes</w> coulaient de ses yeux alors qu'elle regardait le film triste.",
                                "it": "Grandi <w>lacrime</w> le rigavano il volto mentre guardava il film triste.",
                                "cs": "Velké <w>slzy</w> jí stékaly z očí, když se dívala na ten smutný film."
                            }
                        },
                        {
                            "text": "He wiped a <w>tear</w> from his cheek.",
                            "target_lang_translations": {
                                "ru": "Он смахнул <w>слезу</w> со своей щеки.",
                                "fr": "Il a essuyé une <w>larme</w> sur sa joue.",
                                "it": "Si asciugò una <w>lacrima</w> dalla guancia.",
                                "cs": "Otřel si <w>slzu</w> z tváře."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burst into tears",
                        "in tears",
                        "shed a tear",
                        "wipe away a tear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Капля прозрачной соленой жидкости, выделяемая из глаз при плаче или раздражении.",
                        "fr": "Goutte de liquide clair et salé produite par les yeux lors de pleurs ou d'une irritation.",
                        "it": "Una goccia di liquido trasparente e salato prodotta dagli occhi a causa del pianto o di un'irritazione.",
                        "cs": "Kapka čiré, slané tekutiny, která se tvoří v očích při pláči nebo podráždění."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слеза",
                                "target_lang_sense_clarification": "капля жидкости из глаз"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "larme",
                                "target_lang_sense_clarification": "goutte de liquide sécrétée par les yeux"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lacrima",
                                "target_lang_sense_clarification": "goccia di liquido che fuoriesce dall'occhio"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "slza",
                                "target_lang_sense_clarification": "kapka tekutiny z oka"
                            }
                        ]
                    }
                },
                {
