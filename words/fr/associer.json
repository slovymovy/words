                        "associer les compétences"
                    ]
                },
                {
                    "sense_id": "ee0d4836-7f02-3664-8205-6aca508cc1ca",
                    "sense_definition": "Prendre quelqu'un pour collaborateur, partenaire ou compagnon dans une activité ou une fonction.",
