                "senses": [
                    {
                        "sense_id": "de4986c5-de3e-3cb8-9fe9-0a5eb73c5d26",
                        "entry_id": "ca2a6b8a-e68e-3f9c-b730-162a3a54ebcb",
                        "glosses": [
                            "вынуть, выбить вон (вколоченное)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe34323-497f-433a-9abc-5227e155930f",
                                "sense_id": "de4986c5-de3e-3cb8-9fe9-0a5eb73c5d26",
                                "text": "Выколотить забитый клин."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aac643b-7147-33d3-a329-67a6a598117e",
                        "entry_id": "ca2a6b8a-e68e-3f9c-b730-162a3a54ebcb",
                        "glosses": [
                            "колотя, выбить из чего-нибудь что-нибудь (пепел, пыль); колотя, очистить что-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97af1e1b-922e-4f4c-87f3-85ce3fbdf841",
                                "sense_id": "6aac643b-7147-33d3-a329-67a6a598117e",
                                "text": "Выколотить пыль из одежды. Выколотить пепел из трубки. Выколотить шубу. Выколотить трубку."
                            }
                        ]
                    },
                    {
                        "sense_id": "896a0918-ac78-3ae0-bcb2-4cb68ebb4b47",
                        "entry_id": "ca2a6b8a-e68e-3f9c-b730-162a3a54ebcb",
                        "glosses": [
                            "(в сапожном деле) колотя, размять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f3d5bd-83e4-4b2d-a5e6-789b01a8b416",
                                "sense_id": "896a0918-ac78-3ae0-bcb2-4cb68ebb4b47",
                                "text": "Выколотить кожу."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dd7ada6-4f75-30af-b147-867b9babc90a",
                        "entry_id": "ca2a6b8a-e68e-3f9c-b730-162a3a54ebcb",
                        "glosses": [
                            "перен. разг. получить насильно, с принуждением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d8f0c6-d996-4ead-a1c7-e1e997cfe540",
                                "sense_id": "3dd7ada6-4f75-30af-b147-867b9babc90a",
                                "text": "Но хоть его арестовали, как и всех ему подобных, чекистам не удалось выколотить из него признания, и он вернулся домой, побитый, но столь же состоятельный, как до ареста."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e25177a-580b-3e2e-9ec6-396e422ac08d",
                        "entry_id": "ca2a6b8a-e68e-3f9c-b730-162a3a54ebcb",
                        "glosses": [
                            "перен. разг. вульг. заработать, затратив много труда, усилий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a02813-260a-404e-9e35-32fa999e05af",
                                "sense_id": "7e25177a-580b-3e2e-9ec6-396e422ac08d",
                                "text": "Выколотить сто рублей в месяц."
                            }
                        ]
                    }
                ],
