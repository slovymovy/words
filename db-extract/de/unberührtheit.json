                "senses": [
                    {
                        "sense_id": "1c4f2241-0ba3-344f-8e91-94815cec5917",
                        "entry_id": "22e22857-026f-31fd-820b-80ee6fe17635",
                        "glosses": [
                            "natürlicher, nicht vom Menschen beeinflusster Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cabe59e-fb61-4d80-8ad0-a9574876c30d",
                                "sense_id": "1c4f2241-0ba3-344f-8e91-94815cec5917",
                                "text": "„In der Abenteuer- und Kolonialliteratur erscheinen die afrikanischen Landschaften als ein vom Zauber der Unberührtheit aufgeladener, verlockender Raum der Leere.“"
                            },
                            {
                                "example_id": "7ada0e14-4386-4c67-b4be-d45c550b4801",
                                "sense_id": "1c4f2241-0ba3-344f-8e91-94815cec5917",
                                "text": "„Der sensible Gipfelsammler erlebt bisweilen das, was der Religiöse befürchtet, eine Profanisierung, eine Entweihung des heiligen Berges, den Verlust der Unberührtheit und damit der magischen Ausstrahlung.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a184776f-6731-3ed0-859f-bdc37c353052",
                        "entry_id": "22e22857-026f-31fd-820b-80ee6fe17635",
                        "glosses": [
                            "sexuelle Unerfahrenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f577f0d-68af-4082-893e-712ef6bc5ebc",
                                "sense_id": "a184776f-6731-3ed0-859f-bdc37c353052",
                                "text": "Die Unberührtheit der Braut war ein hohes Gut."
                            },
                            {
                                "example_id": "8ef5aeae-ed95-4dc5-b64a-0cd800766834",
                                "sense_id": "a184776f-6731-3ed0-859f-bdc37c353052",
                                "text": "„Sie war eine blutjunge Prostituierte, die ihm von der Mutter, einer Bordellbesitzerin, mit allen Garantien der Unberührtheit angeboten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e9f3bf9a-d588-3efb-8a8f-0ca2cc21f313",
                        "entry_id": "22e22857-026f-31fd-820b-80ee6fe17635",
