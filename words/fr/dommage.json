                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est vraiment <w>dommage</w> que tu ne puisses pas venir à notre fête ce soir."
                        },
                        {
                            "text": "C'est un grand <w>dommage</w> d'abandonner ce beau projet après tant de travail."
                        }
                    ],
                    "common_phrases": [
