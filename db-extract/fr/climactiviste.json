                ],
                "senses": [
                    {
                        "sense_id": "6152c76d-7e24-35ea-94c4-8bb86a2d0185",
                        "entry_id": "b96beabc-1745-3563-98db-9e60317fe3bf",
                        "glosses": [
                            "Activiste luttant contre le réchauffement climatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e816ad-ab77-415b-8b8c-d4eb6c9d3954",
                                "sense_id": "6152c76d-7e24-35ea-94c4-8bb86a2d0185",
                                "text": "On peut se désoler devant la hausse des températures ou créer une tribu de climactivistes. On peut fulminer devant l’inaction politique ou se former au lobbying. On peut disserter sur l’absurdité du monde ou partir joyeusement au combat !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64f8a3d7-6ff6-4d45-b390-cab6c67b15fc",
                        "source_entry_id": "b96beabc-1745-3563-98db-9e60317fe3bf",
                        "source_sense_id": "6152c76d-7e24-35ea-94c4-8bb86a2d0185",
                        "target_lang_word": "Klimaaktivist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaaktivist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                        "entry_id": "82f993b7-3132-31ba-8a58-2ceb4e6a13eb",
                                        "glosses": [
                                            "(männliche^☆) Person, die sich für den Klimaschutz einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f69375-8730-4cfc-81ce-8feb363d08fd",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Der nigerianische Klimaaktivist und Träger des Alternativen Nobelpreis, Nnimmo Bassey, kämpft seit Jahrzehnten gegen die fortschreitende Umweltverschmutzung in seiner Heimat.“"
                                            },
                                            {
                                                "example_id": "027d29f3-5506-4da1-9796-1240ae46cda5",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Wegen versuchten Widerstands gegen die Staatsgewalt hat sich am Montag ein junger Klimaaktivist am Wiener Landesgericht verantworten müssen.“"
                                            },
                                            {
                                                "example_id": "1228fecd-231b-4aff-8e6f-391daedc76da",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Bürgerliche kritisieren, dass sich unter die Klimaaktivisten Vertreter von kommunistischen und sozialistischen Ideen mischen.“"
                                            },
                                            {
                                                "example_id": "58fb730e-9d5c-44a0-92b2-8a1fd716603a",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Den Angaben der Klimaaktivisten zufolge war der Forderungskatalog in bundesweiten Arbeitsgruppen in Abstimmung mit Wissenschaftlern ausgearbeitet worden.“"
                                            },
                                            {
                                                "example_id": "e7ae9e56-3096-4fb7-993c-788b2c372197",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Seit mehr als drei Monaten hält ein einsamer Klimaaktivist die Stellung in der russischen Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "f08ca233-c5fe-4dff-ae2d-0475fca43c63",
                                                "sense_id": "51ad72c3-7533-36f4-965a-bb279d6b0c05",
                                                "text": "„Die beiden sollen erst nach Thailand und von dort weiter nach Bali geflogen sein. Mehrere Tonnen CO2 verursacht solch ein Langstreckenflug, was die beiden Klimaaktivisten offenbar in Kauf nahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c1af06-1cfe-4c80-b7ca-72a0422cacc5",
                        "source_entry_id": "b96beabc-1745-3563-98db-9e60317fe3bf",
                        "source_sense_id": "6152c76d-7e24-35ea-94c4-8bb86a2d0185",
                        "target_lang_word": "Klimaaktivistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaaktivistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                        "entry_id": "2c5e5b77-7194-3f74-ae32-5ba47d31b9c8",
                                        "glosses": [
                                            "weibliche Person, die sich für den Klimaschutz einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26991530-a7a4-4ce6-9d90-8d9ef9242e48",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Klimaaktivistin Greta Thunberg will bei ihrer US-Reise keine Zeit mit einem Treffen mit Präsident Donald Trump verschwenden.“"
                                            },
                                            {
                                                "example_id": "fe76558f-8f41-499d-93b3-b28356496800",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Die schwedische Klimaaktivistin Greta Thunberg will sich nach dem Abschluss der neunten Klasse ganz auf ihren Kampf gegen die Klimakrise konzentrieren.“"
                                            },
                                            {
                                                "example_id": "1d675fb3-fc3f-420f-8be1-9dd8bfd5f439",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Die schwedische Klimaaktivistin Greta Thunberg hat Mitstreiter dazu aufgerufen, weiter für den Klimaschutz zu protestieren.“"
                                            },
                                            {
                                                "example_id": "64659777-b575-470f-80da-cd8fcd501753",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Parteimitglieder wie Luisa Neubauer, eine der Klimaaktivistinnen, gehören nicht zu den Angepassten.“"
                                            },
                                            {
                                                "example_id": "40f17620-8bfc-4992-aa40-078ff280e747",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Klimaaktivistinnen und -aktivisten haben am Dienstagmorgen mit einer spektakulären Aktion auf ihr Anliegen aufmerksam gemacht.“"
                                            },
                                            {
                                                "example_id": "68a7f1e8-9f5f-4ffb-acff-4331197cd45d",
                                                "sense_id": "2690dde4-fd78-3795-a73c-5949d0e6e3e8",
                                                "text": "„Wer mit einer ‚maximalen Störung der öffentlichen Ordnung‘ droht, hat den Boden der Demokratie verlassen. In dieselbe bedenkliche Richtung weist die Aussage der Klimaaktivistin Luisa Neubauer: ‚Die Wahl zwischen Zeit und Demokratie, die haben wir nicht.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
