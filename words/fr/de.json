                    ],
                    "common_phrases": [
                        "robe de soie",
                        "maison de briques",
                        "salle de bain",
                        "chien de garde"
                    ]
                },
                {
                    "sense_id": "f54e7ee6-867f-356a-8321-5a20fbf457ac",
                    "sense_definition": "Indique la cause, le motif ou le moyen d'une action ou d'un état affectif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants tremblaient <w>de</w> froid en attendant le bus sous la neige."
                        },
                        {
                            "text": "Le vieil homme sautait <w>de</w> joie après avoir appris l'heureuse nouvelle."
                        }
                    ],
                    "common_phrases": [
                        "mourir de faim",
                        "pleurer de joie",
                        "rougir de honte",
                        "trembler de peur"
                    ]
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "2e651af7-c9e6-3e49-889a-253e7a4260dc",
                    "sense_definition": "Substitut de l'article indéfini ou partitif en contexte de négation absolue devant un complément d'objet direct.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne vous inquiétez surtout pas, il n'y a pas <w>de</w> problème pour ce rendez-vous."
