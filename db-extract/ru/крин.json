                                    {
                                        "sense_id": "f1bb20c1-c4ef-3da5-81c4-70d4f6c833c0",
                                        "entry_id": "05208270-0b95-397e-b80b-e1d2b169a4ff",
                                        "glosses": [
                                            "Any of several flowers in the genus Lilium of the family Liliaceae, which includes a great many ornamental species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9c4894-418f-4eff-a418-de1aebca7962",
                                                "sense_id": "f1bb20c1-c4ef-3da5-81c4-70d4f6c833c0",
                                                "text": "The engagement photos were set in a leafy bower festooned with pink and white roses, anemones, lilies and delphinium, like something straight out of an enchanted garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96a8f5b-8015-3d58-8197-aa3eaecd0a1d",
                                        "entry_id": "05208270-0b95-397e-b80b-e1d2b169a4ff",
                                        "glosses": [
                                            "Any of several species of herbaceous flower which may or may not resemble the genus Lilium in some way, and which are not closely related to it or each other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "128dd483-7042-360c-8635-ae8cf7bcc138",
                                        "entry_id": "05208270-0b95-397e-b80b-e1d2b169a4ff",
                                        "glosses": [
                                            "The flower used as a heraldic charge; also commonly used to describe the fleur-de-lis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebbdb847-d94e-38a7-9c35-65fdcf38f39b",
                                        "entry_id": "05208270-0b95-397e-b80b-e1d2b169a4ff",
                                        "glosses": [
                                            "The end of a compass needle that should point north, traditionally often ornamented with the figure of a lily or fleur-de-lis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe19922-140a-4b41-bbac-4929246f1085",
                                                "sense_id": "ebbdb847-d94e-38a7-9c35-65fdcf38f39b",
                                                "text": "But sailing further, it veers its lily to the west."
                                            }
                                        ]
                                    },
