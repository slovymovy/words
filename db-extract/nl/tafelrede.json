                                "target_senses": [
                                    {
                                        "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                        "entry_id": "c506efff-520e-34f2-8ea5-fc2998edc33a",
                                        "glosses": [
                                            "Proposition de boire à la santé de quelqu’un, à l’accomplissement d’un vœu, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e48190-a292-4588-93a2-b815fda85162",
                                                "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                                "text": "Puis arrivèrent les toasts insidieux, les forfanteries, les défis."
                                            },
                                            {
                                                "example_id": "682d2dee-d736-47aa-89c0-a63f09419ed4",
                                                "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                                "text": "Eh ! laissez ces enfants, marquise, reprit le vieillard qui avait porté le toast."
                                            },
                                            {
                                                "example_id": "4b5e9e93-bd5e-4605-8fe7-472eb99e8e3c",
                                                "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                                "text": "Votre toast, je peux vous le rendre."
                                            },
                                            {
                                                "example_id": "392f4d0e-eabf-49e7-9e54-bbbef02b7bd1",
                                                "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                                "text": "La tante alla prendre Gaspard dans son berceau pour le faire participer au toast que l’on portait en son honneur."
                                            },
                                            {
                                                "example_id": "fd4388bd-e154-4ccd-b7f4-5a583d65b9d2",
                                                "sense_id": "40b4dcb2-c7e5-350e-9670-1a585aede9ce",
                                                "text": "Lorsque tous les nouveaux membres eurent bu, Bendix leva le calice pour porter un toast.\n— Ils ont goûté au Feu de l'Illumination ! Bienvenue parmi les Péithologiens, nouveaux Poètes et Aventuriers !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4b0baa-9f84-3e26-9e56-7f2cc5621ddf",
                                        "entry_id": "c506efff-520e-34f2-8ea5-fc2998edc33a",
                                        "glosses": [
                                            "Tranche de pain grillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd555ae-651c-493c-a7aa-4ff82cebfce1",
                                                "sense_id": "0d4b0baa-9f84-3e26-9e56-7f2cc5621ddf",
                                                "text": "Toasts au foie gras."
                                            },
                                            {
                                                "example_id": "16618f29-97f3-407c-a55c-f1654fe968a2",
                                                "sense_id": "0d4b0baa-9f84-3e26-9e56-7f2cc5621ddf",
                                                "text": "On la commençait sous les effluves d’une toast au beurre d’arachide."
                                            },
                                            {
                                                "example_id": "e7f4841b-8f94-4a67-9dd8-264c3e27d2e5",
                                                "sense_id": "0d4b0baa-9f84-3e26-9e56-7f2cc5621ddf",
                                                "text": "Ailleurs, le grand Joe Nieuwendyk a toujours mangé deux toasts au beurre d’arachide avant chaque match."
                                            }
                                        ]
                                    },
