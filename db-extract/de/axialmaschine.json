                "senses": [
                    {
                        "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                        "entry_id": "7f1368b3-a195-3e57-959a-f0fc4ab8f7bb",
                        "glosses": [
                            "axiale Strömungsmaschine, deren Schaufeln achsparallel durchströmt werden und rotieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c4164d-2f41-4f76-9bf7-b2fd0052e764",
                                "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                                "text": "„Im Gegensatz dazu werden diese Teile bei der Axialmaschine (b) in Richtung der Wellenachse durchflutet.“"
                            },
                            {
                                "example_id": "6383a3a0-7e14-4e7c-8b6c-85bbce2940f9",
                                "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                                "text": "„Im Gegensatz zu den meisten Axialmaschinen sind die als Radialmaschinen ausgelegten Verdichter- und Turbinenräder von Turboladern integrale Bauteile.“"
                            },
                            {
                                "example_id": "52ee9334-13aa-45a9-9248-dc0330375f4f",
                                "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                                "text": "„Das ist insbesondere beim Propeller eine gute Näherung, der meist nur 2-3 Blätter hat, aber auch bei Axialmaschinen mit wenigen Schaufeln.“"
                            },
                            {
                                "example_id": "db537f82-aaa4-4800-baf0-775532021d72",
                                "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                                "text": "„Die Turbine von Stolze war dadurch bemerkenswert, daß er sowohl die Turbine wie auch den Kompressor als vielstufige Axialmaschine ausführte.“"
                            },
                            {
                                "example_id": "c5d74d49-9614-406c-8e02-65e8ae88479c",
                                "sense_id": "eef318f0-0023-380d-9054-6124152be6dc",
                                "text": "„Auch der konstruktive Aufbau als mehrstufige Axialmaschine ist bei großen Leistungen der gleiche wie bei den Dampfturbinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
