                                            {
                                                "example_id": "e52bd812-63d9-4145-b551-f716b3e4fa65",
                                                "sense_id": "621f2d49-b7a1-37ae-9b33-a696352e15d3",
                                                "text": "Het bestand werd gesloten onder auspiciën van de VN."
