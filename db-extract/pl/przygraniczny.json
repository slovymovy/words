                                "sense_id": "c346fc85-7f52-3464-8db0-caef13a766ef",
                                "text": "Debata dotyczyła ruchu przygranicznego."
                            },
                            {
                                "example_id": "0e37cdee-56f7-4bd0-9cb0-e1508c6fb42e",
                                "sense_id": "c346fc85-7f52-3464-8db0-caef13a766ef",
                                "text": "Wiele północnoniemieckich miast takich jak przygraniczny Flensburg ma wyraźne duńskie ślady kulturowe i historyczne."
                            }
                        ],
