    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                    "sense_definition": "В качестве возмещения или в обмен на что-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я помогу тебе с ремонтом, а ты <w>взамен</w> отвезёшь меня на вокзал.",
                            "target_lang_translations": {
                                "en": "I will help you with the repairs, and <w>in return</w> you will take me to the station.",
                                "de": "Ich helfe dir bei der Renovierung, und du bringst mich <w>im Gegenzug</w> zum Bahnhof."
                            }
                        },
                        {
                            "text": "Он сделал доброе дело и ничего не попросил <w>взамен</w>.",
                            "target_lang_translations": {
                                "en": "He did a good deed and asked for nothing <w>in return</w>.",
                                "de": "Er tat eine gute Tat und verlangte nichts <w>dafür</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "в обмен"
                    ],
                    "common_phrases": [
                        "получить взамен",
                        "дать взамен",
                        "предложить взамен",
                        "ничего взамен"
                    ],
                    "target_lang_definitions": {
                        "en": "As compensation or in exchange for something.",
                        "de": "Als Entschädigung oder im Austausch für etwas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in return",
                                "target_lang_sense_clarification": "reciprocating an action or favor"
                            },
                            {
                                "target_lang_word": "in exchange",
                                "target_lang_sense_clarification": "giving or receiving something as an equivalent"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "im Gegenzug",
                                "target_lang_sense_clarification": "als Reaktion auf eine Gefälligkeit oder Handlung"
                            },
                            {
                                "target_lang_word": "dafür",
                                "target_lang_sense_clarification": "als Gegenleistung"
                            },
                            {
                                "target_lang_word": "als Gegenleistung",
                                "target_lang_sense_clarification": "für eine erbrachte Leistung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                    "sense_definition": "Вместо кого-либо или чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вам выдадут временное удостоверение <w>взамен</w> утерянного паспорта.",
                            "target_lang_translations": {
                                "en": "You will be issued a temporary ID <w>in place of</w> the lost passport.",
                                "de": "Ihnen wird ein vorläufiger Ausweis <w>als Ersatz für</w> den verlorenen Reisepass ausgestellt."
                            }
                        },
                        {
                            "text": "Мы предложили покупателю другую модель <w>взамен</w> отсутствующей на складе.",
                            "target_lang_translations": {
                                "en": "We offered the buyer another model <w>instead of</w> the one missing from stock.",
                                "de": "Wir haben dem Käufer ein anderes Modell <w>anstelle des</w> auf Lager fehlenden angeboten."
                            }
                        }
                    ],
                    "synonyms": [
                        "вместо"
                    ],
                    "common_phrases": [
                        "взамен старого",
                        "взамен утраченного",
                        "взамен испорченного"
                    ],
                    "target_lang_definitions": {
                        "en": "In place of someone or something.",
                        "de": "Anstelle von jemandem oder etwas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "instead of",
                                "target_lang_sense_clarification": "as a substitute for"
                            },
                            {
                                "target_lang_word": "in place of",
                                "target_lang_sense_clarification": "formal substitution"
                            },
                            {
                                "target_lang_word": "in exchange for",
                                "target_lang_sense_clarification": "trading for something else"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anstelle von",
                                "target_lang_sense_clarification": "als Ersatz für etwas oder jemanden"
                            },
                            {
                                "target_lang_word": "statt",
                                "target_lang_sense_clarification": "als Alternative oder Ersatz"
                            },
                            {
                                "target_lang_word": "als Ersatz für",
                                "target_lang_sense_clarification": "zum Austausch gegen ein anderes Objekt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
