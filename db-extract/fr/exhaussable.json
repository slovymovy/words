                        "examples": [
                            {
                                "example_id": "043608f0-8a92-48dd-b032-16ad681e92d2",
                                "sense_id": "cd591ff2-f94b-3883-b24f-1d77a8755bac",
                                "text": "D’abord, le statif est livré vertical, monté sur un pied non articulé; dans son ensemble, l’appareil est assez élevé et, pour l’observation, il faut ou le poser sur une table basse ou avoir à sa disposition un siège exhaussé ou exhaussable."
                            },
                            {
                                "example_id": "9f55c393-0de4-4866-88d4-142212d3c8fb",
                                "sense_id": "cd591ff2-f94b-3883-b24f-1d77a8755bac",
                                "text": "Le chapeau supportant les poutrelles sur ce ponton repose sur un chevalet ; il est exhaussable par des vérins, pour suivre l’enfoncement du bac."
                            },
                            {
                                "example_id": "5357e7fa-46e9-4974-a6f6-e8769d3d69fc",
                                "sense_id": "cd591ff2-f94b-3883-b24f-1d77a8755bac",
                                "text": "Cette bouche à clé carrée auto exhaussable est utilisée pour l’adduction d’eau pour commander l’ouverture et la fermeture d’une canalisation enterrée."
                            }
                        ]
                    }
