                                        "entry_id": "00336ae1-50c0-37d1-8ff2-08db7d9794f6",
                                        "glosses": [
                                            "Relating to ethnicity and race."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9905f300-1c7b-4af9-9ebc-a77e3c08b767",
                                                "sense_id": "d9e0f3d8-c7d3-304c-af79-23bdc2dd8b23",
                                                "text": "Indeed, split white trash in two again and read the meanings of each: white now appears as an ethnoracial signifier, and trash, a signifier of abject class status."
                                            }
                                        ]
