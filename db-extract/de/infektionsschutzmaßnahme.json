                "senses": [
                    {
                        "sense_id": "29acf1c3-276c-3ebc-a40d-db049d9a7bbe",
                        "entry_id": "bf9f346a-5f3b-33ef-8796-6993f22007a6",
                        "glosses": [
                            "Vorkehrung, die vor der Infizierung mit einem Erreger bewahren soll (zum Beispiel nach dem Einsetzen eines künstlichen Gelenks oder auch im Rahmen der Pandemiebekämpfung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472fbbc0-0269-447e-985b-82f2583d0742",
                                "sense_id": "29acf1c3-276c-3ebc-a40d-db049d9a7bbe",
                                "text": "„Maßnahmen zur Vorbeugung von Infektionen werden als Infektionsschutzmaßnahmen bezeichnet. Diese Maßnahmen können prä-, peri- sowie postoperativ erfolgen.“"
                            },
                            {
                                "example_id": "9c1b9b86-f837-4dc6-9d46-96818fd9f541",
                                "sense_id": "29acf1c3-276c-3ebc-a40d-db049d9a7bbe",
                                "text": "Zu den empfohlenen Infektionsschutzmaßnahmen gehören das Abstandhalten, das Einhalten von Husten- und Niesregeln und das Tragen von Masken (AHA-Regel)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
