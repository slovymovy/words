                ],
                "translations": [
                    {
                        "translation_id": "fdebce58-fb2b-4620-adb3-c217e02c12b2",
                        "source_entry_id": "08ee37c7-978a-3829-982e-4cd66dd72b55",
                        "source_sense_id": "e3bf0bca-d106-313f-a29c-5e05a60765c2",
                        "target_lang_word": "Konturenstift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konturenstift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                        "entry_id": "60812879-3f5a-37f7-a355-f4f58cef3e33",
                                        "glosses": [
                                            "Stift, mit dem die äußere Form der Lippen nachgezeichnet wird"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e15c5e-ba63-4d07-ae65-e99299b31e12",
                                                "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                                "text": "„Jeder Konturenstift ist nur so gut wie seine Spitze.“"
                                            },
                                            {
                                                "example_id": "6bb1cf13-6ecc-419d-83c5-8019cc77cf2e",
                                                "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                                "text": "„Der Konturenstift darf eine Nuance dunkler sein, als die Lippenfarbe.“"
                                            },
                                            {
                                                "example_id": "c59d2ec7-be5f-46e9-af0c-bd0d1202c091",
                                                "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                                "text": "„Ihr Lippenstift oder Lipgloss hält länger, wenn Sie die Lippen mit Konturenstift umranden und ausmalen, bevor Sie die Lippenfarbe auftragen.“"
                                            },
                                            {
                                                "example_id": "e8bee366-acf0-4518-abcd-a1f1cd319ce8",
                                                "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                                "text": "„[…] Sie müssen den Konturenstift immer wieder leicht abtupfen, damit die Lippenstiftfarbe nicht den Stift verschmiert.“"
                                            },
                                            {
                                                "example_id": "c851b9d6-80e0-4059-a564-7dbfda0f8f30",
                                                "sense_id": "9b728359-3b09-31b5-97a5-ee2a6e9551c9",
                                                "text": "„Die zierliche Arzthelferin aus Köpenick hat blauen Lidschatten aufgelegt, und so sorgfältig wie ihr Mund mit Konturenstift umrandet ist, so genau wählt sie ihre Worte […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
