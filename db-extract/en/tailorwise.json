                "senses": [
                    {
                        "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                        "entry_id": "e5df8d65-7b8f-3c47-8865-d39ba2b988d8",
                        "glosses": [
                            "With the legs crossed in front of one and the ankles on the ground."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c082be46-978d-4bd8-9b2c-01eec72cfd5c",
                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                "text": "While sitting on a chair or bench there is no difficulty in holding the trunk erect, because now the hamstring muscles are not only relaxed but further slackened at the lower end by flexion of the knee; the hips will flex several degrees farther here and also in sitting on the floor if the knees are flexed, tailorwise."
                            },
                            {
                                "example_id": "cd36759f-5318-4482-a66d-87744d7240e4",
                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                "text": "His shoes off, and his bare feet tucked under his legs, he sat tailorwise and peered up at the giant."
                            },
                            {
                                "example_id": "9618af8a-94fd-4109-86fe-38d84c5306a7",
                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                "text": "Perched tailorwise on the bed, I myself stared like an owl into the gloom."
                            }
                        ]
                    }
