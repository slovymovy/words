                "senses": [
                    {
                        "sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                        "entry_id": "98cebaaa-f780-3b7e-a738-37cca210f4b5",
                        "glosses": [
                            "het minder ruim maken, worden, of zijn van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96bb414-25a9-4180-a611-0c47d1b58bc9",
                                "sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                                "text": "De oorzaken van uiterlijke veroudering door roken zijn al langer bekend. Zo zorgt nicotine voor vernauwing van bloedvaten in de bovenste huidlagen, terwijl de chemicaliën in tabak funest zijn voor stoffen zoals collageen en elastine die de huid soepel houden."
                            },
                            {
                                "example_id": "8fc2e312-306b-4b06-9e9f-66f629702f36",
                                "sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                                "text": "Stuur een stroom door een vernauwing in een chip en magnetische golven gedragen zich als licht bij de rand van een zwart gat. Over twee jaar in een lab, denkt Rembert Duine."
                            },
                            {
                                "example_id": "f0656623-8d0d-4658-bf58-8f01a173cfb5",
                                "sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                                "text": "Wie zijn leefstijl na een dotterbehandeling niet verandert, loopt grote kans op vernauwing op een andere plek."
                            }
                        ]
                    },
                    {
                        "sense_id": "c28b4881-0da2-366b-96c3-07ad945f3119",
                        "entry_id": "98cebaaa-f780-3b7e-a738-37cca210f4b5",
                        "glosses": [
                            "de relatie met iemand hechter maken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab83410a-6b48-4609-862d-5ac9afff99c7",
                        "source_entry_id": "98cebaaa-f780-3b7e-a738-37cca210f4b5",
                        "source_sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                        "target_lang_word": "narrowing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab23589-609f-395c-8b8f-96a8575a7988",
                                        "entry_id": "aadec04b-2f04-35f1-b939-d9c5ec3fa2b9",
                                        "glosses": [
                                            "Present participle and gerund of narrow."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3a5b50-b8e9-4023-864c-ca2f4d632fa7",
                                                "sense_id": "0ab23589-609f-395c-8b8f-96a8575a7988",
                                                "text": "All three parallel valleys of the Llynvi, Garw and Ogmore are much the same in physical character: the lower reaches are wooded and not unattractive, but as the railway climbs on ever-steepening grades, the hills on either hand grow barer and closer together, while in all respects the scene becomes more sombre, with the terraced, slate-roofed colliery towns and the road, railway and river all struggling for space in the narrowing defiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "narrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb922996-a184-3f86-93e6-bf145f7d1f91",
                                        "entry_id": "22d855c2-c885-3ee2-a83f-746095c0a92a",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "narrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40181242-c33c-353d-b1c5-cc935ff5acbf",
                                        "entry_id": "b120b110-a9f4-3188-8659-01dcd4dc9a99",
                                        "glosses": [
                                            "The process of becoming narrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2176340c-c3e1-41c5-bb33-6235d2e8d220",
                                                "sense_id": "40181242-c33c-353d-b1c5-cc935ff5acbf",
                                                "text": "narrowings of the road"
                                            },
                                            {
                                                "example_id": "72768ff6-83bd-4502-90cb-1a0bce3a77ba",
                                                "sense_id": "40181242-c33c-353d-b1c5-cc935ff5acbf",
                                                "text": "Owing to the war, it was not thought advisable to carry out repairs to this pier, as this would have involved the temporary narrowing of the channel, and it was not until 1919 that it was decided to proceed with the construction of a steel-pile coffer dam round the south pier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f39b1c-1d1d-367a-a6ec-aa9e08cb4aa0",
                                        "entry_id": "b120b110-a9f4-3188-8659-01dcd4dc9a99",
                                        "glosses": [
                                            "The part of a stocking that is narrowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66b5d17-25a8-4ecf-8af4-fb0af263c86c",
                                                "sense_id": "57f39b1c-1d1d-367a-a6ec-aa9e08cb4aa0",
                                                "text": "It may be observed, as a general rule, that the length of a stocking, before the narrowings, should be, at the least, equal to twice the width of the top..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd0f42ea-3b5e-41e3-8738-b42ab06e61d5",
                        "source_entry_id": "98cebaaa-f780-3b7e-a738-37cca210f4b5",
                        "source_sense_id": "ae42789a-b8bb-3581-bf2c-83c266e96fd0",
                        "target_lang_word": "stricture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stricture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "A rule restricting behaviour or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740aee93-18ac-415c-9ea4-db63fc03cacc",
                                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                                "text": "To his eyes it had no attraction; it savoured of simony, and was likely to bring down upon him harder and more deserved strictures than any he had yet received: he positively declined to become vicar of Puddingdale under any circumstances."
                                            },
                                            {
                                                "example_id": "c4641e49-113d-48fd-b6ad-11c8e4ddb270",
                                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                                "text": "1931 Edgar Wallace: Again Sanders\n\"That is a matter for you to discuss with the Government,\" said Sanders, in his iciest tone. \"I am only authorized to collect twenty-eight thousand.\nI will note your strictures and report them to Whitehall.\"\n\"I'm passing no strictures said the Major, hastily.\nHe had been warned against Sanders..."
                                            },
                                            {
                                                "example_id": "36f0ba28-59ae-47ae-83ca-f04d51c12752",
                                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                                "text": "Even venerable print publications seem to accept that old strictures no longer apply when they move online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "A general state of restrictiveness on behavior, action, or ideology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8af0824-c4de-4cb1-a134-64a65f140748",
                                                "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                                                "text": "I just couldn't take the stricture of that place a single day more."
                                            },
                                            {
                                                "example_id": "41b9f60a-f94e-4602-9ea4-80c817df3252",
                                                "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                                                "text": "For many young people throughout Britain in the 1970s, Northern Soul became a truly alternative lifestyle with the rites and values of the scene replacing many of the traditional strictures of society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e87e60a7-d071-36e3-998e-bb76e481ff2c",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "A sternly critical remark or review."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc4496e-db45-4e75-98e4-03ee2d2d406a",
                                                "sense_id": "e87e60a7-d071-36e3-998e-bb76e481ff2c",
                                                "text": "When he read the poem to his parents, upon its conclusion, both were much impressed by it, though his father made severe strictures upon its lack of polish, its terminal inconcision, and its vagueness of thought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aa32909-cffb-3e04-8174-c0442516381a",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "Abnormal narrowing of a canal or duct in the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f4812b-e2c2-4aab-ad44-bd0a79c923c0",
                                                "sense_id": "0aa32909-cffb-3e04-8174-c0442516381a",
                                                "text": "Even in the brief moment of his entrance into the magnificence of Anthony Harding's home he had felt a strange little stricture of the throat—a choking, half-suffocating sensation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "Strictness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de87b34e-9147-4e14-a9d7-edaf749c90ab",
                                                "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                                                "text": "a man of stricture and firm abstinence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49fb412-5fe8-3db2-b923-04154508690f",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "A stroke; a glance; a touch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e1bfc2-cd3e-47c7-8550-c4fadcb84e90",
                                                "sense_id": "d49fb412-5fe8-3db2-b923-04154508690f",
                                                "text": "But whatever may be said of other matters , certainly the first draughts and strictures of Natural Religion and Morality are naturally in the Mind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3b5119-8628-3306-98d9-83b8ef4ab65c",
                                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                                        "glosses": [
                                            "The degree of contact, in consonants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
