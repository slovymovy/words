                                        "sense_id": "75fbaa4b-2cf7-3737-9e4d-1cd7df4cb508",
                                        "entry_id": "af1a17db-dd6a-3b5e-a3ea-eb9aa684aab6",
                                        "glosses": [
                                            "The total number of something sold or delivered to the clients."
                                        ],
