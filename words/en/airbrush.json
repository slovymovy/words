                    "frequency": "Middle",
                    "semantic_group_id": "painting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The model artist used an <w>airbrush</w> to apply smooth, even coats of paint."
                        },
                        {
                            "text": "She cleaned the nozzle of her <w>airbrush</w> before switching to another color."
                        }
                    ],
                    "common_phrases": [
                        "dual-action airbrush"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f531b691-2b3a-3f09-91f0-c8e1474c47b0",
                    "sense_definition": "To digitally alter or touch up a photograph to make the subject look more attractive or flawless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alter_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Magazines often <w>airbrush</w> models to remove wrinkles and blemishes."
                        },
                        {
                            "text": "The photographer chose to <w>airbrush</w> the portraits before delivering them to the client."
                        }
                    ],
                    "synonyms": [
                        "photoshop",
                        "doctor"
                    ],
                    "common_phrases": [
                        "airbrush out flaws",
                        "heavily airbrushed"
                    ]
                },
                {
                    "sense_id": "d970a922-d17b-376f-8d0b-c025434a59fe",
                    "sense_definition": "To alter, censor, or present facts or memories in a way that makes them seem better or less unpleasant.",
