            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c621465-1408-3344-a212-de0cfa4cc3b5",
                    "sense_definition": "etwas intensiver, gründlicher oder umfangreicher machen oder werden; bestehende Verbindungen oder Inhalte ausbauen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensivieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Sprachkurs möchte er vor allem seine Grammatikkenntnisse <w>vertiefen</w>."
                        },
                        {
                            "text": "Die beiden Nachbarländer wollen ihre wirtschaftliche Zusammenarbeit weiter <w>vertiefen</w>."
                        }
                    ],
                    "synonyms": [
                        "ausbauen",
                        "intensivieren",
                        "verstärken"
                    ],
                    "antonyms": [
                        "abflachen",
                        "verflachen"
                    ],
                    "common_phrases": [
                        "Kenntnisse vertiefen",
                        "Beziehungen vertiefen",
                        "Zusammenarbeit vertiefen"
                    ]
                },
                {
                    "sense_id": "94e8145c-a19d-3bab-89a5-1bc22890db86",
                    "sense_definition": "sich ganz und gar auf eine Beschäftigung oder Lektüre konzentrieren und die Umgebung vergessen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konzentrieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie saß stundenlang am Schreibtisch und <w>vertiefte</w> sich völlig in ihre Arbeit."
                        },
                        {
                            "text": "Wenn er liest, <w>vertieft</w> er sich so sehr in das Buch, dass er nichts mehr hört."
                        }
                    ],
                    "synonyms": [
                        "versinken",
                        "versenken"
                    ],
                    "common_phrases": [
                        "sich in ein Buch vertiefen",
                        "sich in die Arbeit vertiefen",
                        "in Gedanken vertieft sein"
                    ]
                },
                {
                    "sense_id": "585b7472-49d3-3fe0-9ed0-a7a565b6acc2",
                    "sense_definition": "eine Vertiefung oder Aushöhlung noch tiefer machen, indem Material entfernt wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ausgraben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Arbeiter müssen den Graben vor dem Haus noch um einen halben Meter <w>vertiefen</w>."
                        },
                        {
                            "text": "Die Fahrrinne des Flusses wurde <w>vertieft</w>, damit größere Schiffe passieren können."
                        }
                    ],
                    "synonyms": [
                        "ausbaggern",
                        "ausgraben"
                    ],
                    "antonyms": [
                        "einebnen",
                        "abflachen"
                    ],
                    "common_phrases": [
                        "den Graben vertiefen",
                        "die Fahrrinne vertiefen"
                    ]
                },
                {
                    "sense_id": "c1fa2e52-2a3e-321b-8f80-2e8990f1430e",
                    "sense_definition": "einen Ausschnitt an einem Kleidungsstück weiter nach unten verlegen",
