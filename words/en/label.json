{
    "word_family": [
        "labeler",
        "labeling",
        "labeller",
        "labelling",
        "label-stop",
        "relabel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63ff2689-a316-3275-8ba6-51a572c7dd6b",
                    "sense_definition": "A small piece of paper, fabric, or plastic attached to an object to provide information about it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>label</w> says this silk scarf should not be washed in the machine.",
                            "target_lang_translations": {
                                "ru": "На <w>этикетке</w> написано, что этот шелковый шарф нельзя стирать в машине."
                            }
                        },
                        {
                            "text": "We laughed at her because the price <w>label</w> was still on her new sweater.",
                            "target_lang_translations": {
                                "ru": "Мы смеялись над ней, потому что на её новом свитере всё ещё висел <w>ценник</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tag",
                        "ticket"
                    ],
                    "common_phrases": [
                        "price label",
                        "clothing label",
                        "address label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусок бумаги, ткани или пластика, прикрепленный к предмету для предоставления информации о нем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этикетка",
                                "target_lang_sense_clarification": "наклейка на товаре с информацией"
                            },
                            {
                                "target_lang_word": "ярлык",
                                "target_lang_sense_clarification": "бирка или ценник на изделии"
                            },
                            {
                                "target_lang_word": "бирка",
                                "target_lang_sense_clarification": "подвесной ярлычок на багаже или одежде"
                            },
                            {
                                "target_lang_word": "наклейка",
                                "target_lang_sense_clarification": "самоклеящийся элемент с информацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dc85d6a-9f35-3caf-9386-9fc007a4ee0c",
                    "sense_definition": "A company that produces and sells recorded music.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The record <w>label</w> signed the band after hearing their demo tape.",
                            "target_lang_translations": {
                                "ru": "Звукозаписывающий <w>лейбл</w> подписал контракт с группой после прослушивания их демо-записи."
                            }
                        },
                        {
                            "text": "She decided to release her new album under an independent <w>label</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила выпустить свой новый альбом на независимом <w>лейбле</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "record label"
                    ],
                    "common_phrases": [
                        "independent label",
                        "major label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компания, которая производит и продает музыкальные записи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лейбл",
                                "target_lang_sense_clarification": "звукозаписывающая компания"
                            },
                            {
                                "target_lang_word": "рекорд-лейбл",
                                "target_lang_sense_clarification": "музыкальное издательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56a091c4-12b4-3919-95db-79bf91931577",
                    "sense_definition": "A word or phrase used to describe or categorize a person or group, often unfairly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "categorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard to lose the <w>label</w> of being a lazy student.",
                            "target_lang_translations": {
                                "ru": "Он много работал, чтобы избавиться от <w>ярлыка</w> ленивого студента."
                            }
                        },
                        {
                            "text": "Society often attaches a negative <w>label</w> to people who do not follow traditions.",
                            "target_lang_translations": {
                                "ru": "Общество часто вешает негативный <w>ярлык</w> на людей, которые не следуют традициям."
                            }
                        }
                    ],
                    "synonyms": [
                        "category",
                        "pigeonhole"
                    ],
                    "common_phrases": [
                        "negative label",
                        "social label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово или фраза, используемые для описания или классификации человека или группы, часто несправедливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярлык",
                                "target_lang_sense_clarification": "стереотипное определение человека"
                            },
                            {
                                "target_lang_word": "клеймо",
                                "target_lang_sense_clarification": "негативная характеристика, от которой трудно избавиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a5a0e53-8379-3008-9aac-e9308cf79f89",
                    "sense_definition": "In computing, a text element in a user interface that identifies another component.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>label</w> for the text box should clearly indicate what information is required.",
                            "target_lang_translations": {
                                "ru": "<w>Метка</w> текстового поля должна четко указывать, какая информация требуется."
                            }
                        },
                        {
                            "text": "Click on the <w>label</w> to select the corresponding input field.",
                            "target_lang_translations": {
                                "ru": "Нажмите на <w>подпись</w>, чтобы выбрать соответствующее поле ввода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "input label",
                        "text label"
                    ],
                    "target_lang_definitions": {
                        "ru": "В вычислительной технике — текстовый элемент пользовательского интерфейса, идентифицирующий другой компонент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метка",
                                "target_lang_sense_clarification": "текстовое описание поля ввода"
                            },
                            {
                                "target_lang_word": "подпись",
                                "target_lang_sense_clarification": "название элемента интерфейса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7960a659-3f37-361c-a39d-e7dbbe0725d9",
                    "sense_definition": "A user-defined name assigned to a specific piece of data or hardware for easy identification.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Storage devices can be identified by their volume <w>label</w> or unique ID.",
                            "target_lang_translations": {
                                "ru": "Устройства хранения можно идентифицировать по их <w>метке</w> тома или уникальному идентификатору."
                            }
                        },
                        {
                            "text": "You should assign a descriptive <w>label</w> to each partition on the hard drive.",
                            "target_lang_translations": {
                                "ru": "Следует присвоить описательное <w>название</w> каждому разделу жесткого диска."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volume label",
                        "disk label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определяемое пользователем имя, присвоенное конкретному фрагменту данных или оборудованию для легкой идентификации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метка",
                                "target_lang_sense_clarification": "имя тома или диска"
                            },
                            {
                                "target_lang_word": "название",
                                "target_lang_sense_clarification": "идентификатор раздела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f34de842-6c2e-31f6-be63-62f8227e6210",
                    "sense_definition": "A name given to a specific line or section in computer code so that the program can jump to it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer used a <w>label</w> to mark the start of the error-handling routine.",
                            "target_lang_translations": {
                                "ru": "Программист использовал <w>метку</w>, чтобы отметить начало подпрограммы обработки ошибок."
                            }
                        },
                        {
                            "text": "Avoid using a GOTO statement to jump to a <w>label</w> as it makes code hard to read.",
                            "target_lang_translations": {
                                "ru": "Избегайте использования оператора GOTO для перехода к <w>метке</w>, так как это затрудняет чтение кода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "code label",
                        "jump label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя, присвоенное определенной строке или разделу в компьютерном коде, чтобы программа могла перейти к нему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метка",
                                "target_lang_sense_clarification": "идентификатор строки кода для перехода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd2a141b-6483-3024-8e63-20280a0064e0",
                    "sense_definition": "A decorative molding over a door or window in medieval architecture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect pointed out the intricate carvings on the stone <w>label</w> above the archway.",
                            "target_lang_translations": {
                                "ru": "Архитектор указал на замысловатую резьбу на каменном <w>сандрике</w> над аркой."
                            }
                        },
                        {
                            "text": "Sculptured ends of <w>labels</w> are technically referred to as label-stops.",
                            "target_lang_translations": {
                                "ru": "Скульптурные концы <w>сандриков</w> технически называются консолями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "label stop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный карниз над дверью или окном в средневековой архитектуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сандрик",
                                "target_lang_sense_clarification": "декоративный выступ над проемом"
                            },
                            {
                                "target_lang_word": "слезник",
                                "target_lang_sense_clarification": "архитектурный элемент для отвода воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ee8d5e4-3d7e-3513-9a82-ea0c59e883a1",
                    "sense_definition": "A horizontal bar with several pendants used as a mark of cadency in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eldest son's coat of arms is distinguished by a <w>label</w> of three points.",
                            "target_lang_translations": {
                                "ru": "Герб старшего сына отличается <w>ламбелем</w> с тремя зубцами."
                            }
                        },
                        {
                            "text": "The heraldic <w>label</w> was painted in a contrasting color to the rest of the shield.",
                            "target_lang_translations": {
                                "ru": "Геральдический <w>титло</w> был окрашен в контрастный цвет по отношению к остальной части щита."
                            }
                        }
                    ],
                    "synonyms": [
                        "lambel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальная полоса с несколькими подвесками, используемая как знак младшего поколения в геральдике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "титульный воротник",
                                "target_lang_sense_clarification": "геральдическая фигура ламбель"
                            },
                            {
                                "target_lang_word": "ламбель",
                                "target_lang_sense_clarification": "знак отличия старшего сына в гербе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41c4c52a-c077-3fd0-9e42-4d91ab376c2c",
                    "sense_definition": "To attach a piece of paper or other material to something to identify it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop assistant <w>labeled</w> all the products with their new prices.",
                            "target_lang_translations": {
                                "ru": "Продавец <w>промаркировал</w> все товары новыми ценами."
                            }
                        },
                        {
                            "text": "Please <w>label</w> clearly each box so we know what is inside when we move.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, четко <w>подпишите</w> каждую коробку, чтобы мы знали, что внутри при переезде."
                            }
                        }
                    ],
                    "synonyms": [
                        "tag",
                        "price"
                    ],
                    "common_phrases": [
                        "label clearly",
                        "label a box"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрепить кусок бумаги или другого материала к чему-либо для идентификации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркировать",
                                "target_lang_sense_clarification": "наносить пометки или этикетки"
                            },
                            {
                                "target_lang_word": "наклеивать ярлыки",
                                "target_lang_sense_clarification": "снабжать товар информацией"
                            },
                            {
                                "target_lang_word": "помечать",
                                "target_lang_sense_clarification": "делать опознавательную надпись"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d687195-35c4-3762-ac25-c20c68b8f70e",
                    "sense_definition": "To describe someone or something using a specific word or category, often in a limiting way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "categorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He's been unfairly <w>labeled</w> as a cheat just because of one mistake.",
                            "target_lang_translations": {
                                "ru": "На него несправедливо <w>повесили ярлык</w> обманщика всего лишь из-за одной ошибки."
                            }
                        },
                        {
                            "text": "It is wrong to <w>label</w> people based on their appearance alone.",
                            "target_lang_translations": {
                                "ru": "Неправильно <w>классифицировать</w> людей, основываясь только на их внешности."
                            }
                        }
                    ],
                    "synonyms": [
                        "categorise",
                        "classify",
                        "pigeonhole"
                    ],
                    "common_phrases": [
                        "label as",
                        "unfairly labeled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описать кого-то или что-то, используя определенное слово или категорию, часто ограничивающим образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вешать ярлыки",
                                "target_lang_sense_clarification": "давать предвзятую оценку человеку"
                            },
                            {
                                "target_lang_word": "клеймить",
                                "target_lang_sense_clarification": "публично осуждать или категоризировать"
                            },
                            {
                                "target_lang_word": "классифицировать",
                                "target_lang_sense_clarification": "относить к определенной группе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d130ec96-851f-3599-977e-fc9275a4f8a6",
                    "sense_definition": "To add a detectable substance to a biological sample to track its movement or presence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists <w>label</w> and image a protein to see how it moves through the cell.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>метят</w> белок и визуализируют его, чтобы увидеть, как он перемещается по клетке."
                            }
                        },
                        {
                            "text": "The antibodies were <w>labeled</w> with a fluorescent dye for better visibility.",
                            "target_lang_translations": {
                                "ru": "Антитела были <w>помечены</w> флуоресцентным красителем для лучшей видимости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fluorescently label",
                        "radioactively label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавить обнаруживаемое вещество в биологический образец для отслеживания его перемещения или присутствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метить",
                                "target_lang_sense_clarification": "вводить маркер в биоматериал"
                            },
                            {
                                "target_lang_word": "маркировать",
                                "target_lang_sense_clarification": "использовать индикатор для отслеживания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d022f6f-781d-3ae7-bfe2-86d244e245e1",
                    "sense_definition": "To replace atoms in a molecule with isotopes to track them during a chemical reaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By <w>labeling</w> the carbon atoms, researchers could map the entire metabolic pathway.",
                            "target_lang_translations": {
                                "ru": "<w>Пометив</w> атомы углерода, исследователи смогли составить карту всего метаболического пути."
                            }
                        },
                        {
                            "text": "The molecule was <w>labeled</w> with tritium to monitor its distribution in the tissue.",
                            "target_lang_translations": {
                                "ru": "Молекула была <w>мечена</w> тритием для мониторинга её распределения в ткани."
                            }
                        }
                    ],
                    "common_phrases": [
                        "isotopically label"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить атомы в молекуле изотопами для их отслеживания во время химической реакции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метить",
                                "target_lang_sense_clarification": "вводить изотопную метку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1074c459-4da1-3636-a432-4f78a783db11",
                    "sense_definition": "A language spoken in Papua New Guinea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The researcher traveled to Papua New Guinea to study the <w>Label</w> language.",
                            "target_lang_translations": {
                                "ru": "Исследователь отправился в Папуа-Новую Гвинею для изучения языка <w>лабел</w>."
                            }
                        },
                        {
                            "text": "Few people outside the region are familiar with the <w>Label</w> dialect.",
                            "target_lang_translations": {
                                "ru": "Немногие за пределами региона знакомы с диалектом <w>лабел</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык, на котором говорят в Папуа-Новой Гвинее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабел",
                                "target_lang_sense_clarification": "название языка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}