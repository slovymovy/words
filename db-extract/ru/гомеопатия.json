                    },
                    {
                        "sense_id": "7c4fdea3-48e4-3e46-9ac1-63847c88b3a2",
                        "entry_id": "0fed0ae5-24b1-395f-a8ec-dbb2b513fa5e",
                        "glosses": [
                            "разг. лекарственные препараты, применяемые при таком методе лечения"
                        ],
                        "tags": [],
