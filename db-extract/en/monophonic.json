                "forms": [],
                "senses": [
                    {
                        "sense_id": "e75c24df-1037-3dba-bc20-018e0173b379",
                        "entry_id": "b31c50e6-91df-39c3-8eeb-7ba9d9cfa3e6",
                        "glosses": [
                            "having a single channel"
                        ],
                        "tags": [
                            "of sound reproduction"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ae547055-0602-3688-9d87-f236cabc4c79",
                        "entry_id": "b31c50e6-91df-39c3-8eeb-7ba9d9cfa3e6",
                        "glosses": [
                            "Having a single melodic line and no harmony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c225d5-0cfd-49c7-b12c-7d4ffef9fdd0",
                                "sense_id": "ae547055-0602-3688-9d87-f236cabc4c79",
                                "text": "Near-synonym: monodic"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e41eba7-bc8c-3894-8fcf-ee3ef7870cf3",
                        "entry_id": "b31c50e6-91df-39c3-8eeb-7ba9d9cfa3e6",
                        "glosses": [
                            "having simple one-to-one mapping between letters and phonemes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae4952c-f0e6-4daf-9fbd-13be3cc71851",
                                "sense_id": "4e41eba7-bc8c-3894-8fcf-ee3ef7870cf3",
                                "text": "From a similar selection, says M. Remusat, the Coreans have made a monophonic alphabet of nine vowels and fifteen consonants, with which they write their language."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f690392b-6aa2-40dc-b310-8661931174ec",
                        "source_entry_id": "b31c50e6-91df-39c3-8eeb-7ba9d9cfa3e6",
                        "source_sense_description": "having a single channel",
                        "target_lang_word": "monophonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monophonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "961519b6-91ac-3a2f-9e94-b2318cdf1c92",
                                        "entry_id": "4c764244-f289-3623-8f99-be05f683d8a8",
                                        "glosses": [
                                            "Diffusé sur un seul canal en parlant d'un son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135e7a10-7945-419c-b71f-b91af26d9010",
                                                "sense_id": "961519b6-91ac-3a2f-9e94-b2318cdf1c92",
                                                "text": "Dans la deuxième moitié du vingtième siècle, le son stéréophonique a progressivement remplacé le son monophonique pour la reproduction musicale. Néanmoins, le son mono domine toujours les réseaux téléphoniques filaires et cellulaires. (Wikipédia, Monophonique)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1ec61f-c0ba-3e55-b89d-3755bb1b22e5",
                                        "entry_id": "4c764244-f289-3623-8f99-be05f683d8a8",
                                        "glosses": [
                                            "Monodique, en parlant d’un instrument de musique qui ne peut jouer qu'une seule note de musique à la fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f45d6e-7c98-417a-be6f-3cf95ae327ee",
                                                "sense_id": "ad1ec61f-c0ba-3e55-b89d-3755bb1b22e5",
                                                "text": "Un instrument monophonique."
                                            },
                                            {
                                                "example_id": "2fe3a627-504c-491a-8fa1-cca392c93288",
                                                "sense_id": "ad1ec61f-c0ba-3e55-b89d-3755bb1b22e5",
                                                "text": "La musique byzantine traditionnelle, héritée de la musique grecque antique et ayant connu son apogée au temps de l’Empire théocratique de Byzance, est monotonique et exclusivement vocale. Par conséquent,le chant byzantin est monophonique, unidimensionnel pourrait-on dire, et aussi austère qu’une icône byzantine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
