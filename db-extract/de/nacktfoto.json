                ],
                "senses": [
                    {
                        "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                        "entry_id": "aa7296a0-1f51-3e76-8930-b3515da88d64",
                        "glosses": [
                            "bildliche, durch Ablichtung gewonnene Darstellung, die eine männliche oder weibliche Person vollkommen unbekleidet zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ccabc48-7bc6-4002-81b4-d1f081d9ec7a",
                                "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                                "text": "Diese Zeitung besteht fast nur aus Nacktfotos."
                            },
                            {
                                "example_id": "0f7e36f1-2f69-4449-8fbf-cc5289f5f353",
                                "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                                "text": "„Um Gustav zu erschrecken, sprang ich ihm auf den Schoß, wobei ich sah, daß er innen in dem aufgeklappten Lexikon eine Zeitschrift mit Nacktfotos liegen hatte.“"
                            },
                            {
                                "example_id": "526f0839-2375-4976-a495-5a8bb3c8fe11",
                                "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                                "text": "„Ich habe für Nacktfotos nicht die entsprechende Figur, aber um mit der Freiheit umzugehen, hoffentlich genug Format.“"
                            },
                            {
                                "example_id": "9c2df33f-5dfd-4dbc-9e23-5c88eecefd8b",
                                "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                                "text": "„Die beiden Nacktfotos, die der Negus von ihm veröffentlicht hatte, trieben ihn in den Wahnsinn.“"
                            },
                            {
                                "example_id": "05e5bca0-23c5-43e0-b29c-721d310ada69",
                                "sense_id": "6219a7b8-ef80-34b2-a3a0-6616bee6172f",
                                "text": "„Eine ganze Serie bestand aus Nacktfotos der beiden, splitternackt und lächelnd in die Kamera blickend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
