                "senses": [
                    {
                        "sense_id": "77e8f5e1-b9ba-3b3a-b550-16a531ee07b1",
                        "entry_id": "1658f3c8-2602-3844-9602-ecf0b901262a",
                        "glosses": [
                            "Someone who predicts doom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88accbf-f424-46f5-b234-0b44a45fdc3b",
                                "sense_id": "77e8f5e1-b9ba-3b3a-b550-16a531ee07b1",
                                "text": "Breathe not, hid Heart: cease silently, / And though thy birth-hour beckons thee, / Sleep the long sleep: / The Doomsters heap / Travails and teens around us here, / And Time-wraiths turn our songsingings to fear."
                            },
                            {
                                "example_id": "c06d0455-035b-4065-bce1-f3668c09cad7",
                                "sense_id": "77e8f5e1-b9ba-3b3a-b550-16a531ee07b1",
                                "text": "Chase and Pleasant may have been innocents, but they were smarter than the doomsters who predicted that Chase would lose her fortune, for their New York company, the Ballet Theatre (later the American Ballet Theatre), got off to a phenomenally successful start."
                            },
                            {
                                "example_id": "418b305d-5fb2-4f5e-921c-9023c6821301",
                                "sense_id": "77e8f5e1-b9ba-3b3a-b550-16a531ee07b1",
                                "text": "The Tory leadership candidate Rishi Sunak has rejected accusations from his successor as chancellor of being a “doomster” on the economy, as he pushed his plan to cut income tax by 20% by the end of the decade."
                            },
                            {
                                "example_id": "438b20b9-ece0-4807-a68a-859a4bdc19b4",
                                "sense_id": "77e8f5e1-b9ba-3b3a-b550-16a531ee07b1",
                                "text": "\"We have to demonstrate to the doomsters at the Treasury that we can manage this properly,\" Steer warns."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a7a337e-d74e-30e0-9687-6415490923fc",
                        "entry_id": "1658f3c8-2602-3844-9602-ecf0b901262a",
                        "glosses": [
                            "A judge; a deemster."
                        ],
                        "tags": [
                            "Scotland",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "94293192-6a9f-4380-ad25-41d7546d64c7",
                                "sense_id": "8a7a337e-d74e-30e0-9687-6415490923fc",
                                "text": "You are of opinion that the justice of an execution consists, not in the extent of the sufferer's crime, or in his having merited punishment, or in the wholesome and salutary effect which that example is likely to produce upon other evil-doers, but hold that it rests solely in the robe of the judge, the height of the bench, and the voice of the doomster?"
                            }
                        ]
                    }
