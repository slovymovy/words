{
    "word_family": [
        "что-то",
        "что-нибудь",
        "что-либо",
        "ничто",
        "нечто",
        "кое-что",
        "чтобы",
        "потому что"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "19fa6769-cf75-319e-a257-a3429a34c9c4",
                    "sense_definition": "Вопросительное слово, используемое для получения информации о предмете, явлении, действии или состоянии.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogative_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Что</w> ты делаешь сегодня вечером?",
                            "target_lang_translations": {
                                "en": "<w>What</w> are you doing tonight?",
                                "zh": "你今天晚上做<w>什么</w>？"
                            }
                        },
                        {
                            "text": "Я не понимаю, <w>что</w> здесь написано.",
                            "target_lang_translations": {
                                "en": "I don't understand <w>what</w> is written here.",
                                "zh": "我不明白这里写了<w>什么</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ничто"
                    ],
                    "common_phrases": [
                        "что это",
                        "что случилось",
                        "что делать",
                        "что нового"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to ask questions about things, actions, or events.",
                        "zh": "用于询问事物、动作或事件的疑问代词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "interrogative pronoun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什么",
                                "target_lang_sense_clarification": "疑问代词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a0ac47c-2ebf-3a47-a6eb-56d22a902252",
                    "sense_definition": "Союзное слово, которое связывает главное предложение с придаточным и указывает на предмет или явление, упомянутое ранее.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relative_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Книга, <w>что</w> лежит на столе, очень интересная.",
                            "target_lang_translations": {
                                "en": "The book <w>that</w> is lying on the table is very interesting.",
                                "zh": "桌子上放<w>的</w>那本书很有趣。"
                            }
                        },
                        {
                            "text": "Вот дом, <w>что</w> построил Джек.",
                            "target_lang_translations": {
                                "en": "Here is the house <w>that</w> Jack built.",
                                "zh": "这就是杰克盖<w>的</w>房子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кото́рый"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce a clause that describes a noun mentioned earlier.",
                        "zh": "用于引导定语从句，修饰先行词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "relative pronoun"
                            },
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "relative pronoun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "……的",
                                "target_lang_sense_clarification": "关系代词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "921b4641-722e-3431-9192-ab8fdbbfef9b",
                    "sense_definition": "Используется в разговорной речи в значении «почему» или «зачем» для вопроса о причине или цели.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adverbial_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Что</w> ты на меня так смотришь?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> are you looking at me like that?",
                                "zh": "你<w>干嘛</w>一直盯着我看？"
                            }
                        },
                        {
                            "text": "<w>Что</w> ж ты раньше мне не сказал?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> didn't you tell me earlier?",
                                "zh": "你<w>为什么</w>不早点告诉我？"
                            }
                        }
                    ],
                    "synonyms": [
                        "почему",
                        "зачем"
                    ],
                    "common_phrases": [
                        "а что",
                        "что так"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used instead of 'почему' or 'зачем'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used colloquially to ask about the reason or purpose.",
                        "zh": "口语中用于询问原因或目的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "colloquial"
                            },
                            {
                                "target_lang_word": "what for",
                                "target_lang_sense_clarification": "colloquial"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干嘛",
                                "target_lang_sense_clarification": "口语，询问原因或目的"
                            },
                            {
                                "target_lang_word": "为什么",
                                "target_lang_sense_clarification": "询问原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdc32406-34e7-39c6-ab50-a534759d7308",
                    "sense_definition": "Обозначает неопределённый предмет или явление; используется в значении «что-то», «что-нибудь».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indefinite_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если <w>что</w> случится, сразу звони мне.",
                            "target_lang_translations": {
                                "en": "If <w>anything</w> happens, call me immediately.",
                                "zh": "如果发生<w>什么</w>事，立刻给我打电话。"
                            }
                        },
                        {
                            "text": "Есть ли <w>что</w> поесть в холодильнике?",
                            "target_lang_translations": {
                                "en": "Is there <w>anything</w> to eat in the fridge?",
                                "zh": "冰箱里有<w>什么</w>吃的吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "что-то"
                    ],
                    "common_phrases": [
                        "если что",
                        "мало ли что"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for 'что-то' or 'что-нибудь'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Refers to an unspecified thing or event.",
                        "zh": "指代不确定的事物或事件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "something",
                                "target_lang_sense_clarification": "indefinite pronoun"
                            },
                            {
                                "target_lang_word": "anything",
                                "target_lang_sense_clarification": "indefinite pronoun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什么",
                                "target_lang_sense_clarification": "不定代词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "eafeb2ef-1958-3bd3-87f7-dc3e08a2ccb4",
                    "sense_definition": "Служебное слово, соединяющее части сложного предложения; вводит придаточные предложения, разъясняющие или дополняющие главное.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conjunction_that",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я думаю, <w>что</w> он скоро придёт домой.",
                            "target_lang_translations": {
                                "en": "I think <w>that</w> he will come home soon.",
                                "zh": "我<w>觉得</w>他很快就会回家。"
                            }
                        },
                        {
                            "text": "Она сказала, <w>что</w> любит читать книги.",
                            "target_lang_translations": {
                                "en": "She said <w>that</w> she loves reading books.",
                                "zh": "她<w>说</w>她喜欢看书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "потому что",
                        "так что",
                        "разве что"
                    ],
                    "target_lang_definitions": {
                        "en": "Connects a main clause to a subordinate clause that explains or completes it.",
                        "zh": "连接主句与从句，起补充说明作用。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说",
                                "target_lang_sense_clarification": "连接从句的动词"
                            },
                            {
                                "target_lang_word": "觉得",
                                "target_lang_sense_clarification": "连接从句的动词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ce98d9d-a8f4-358b-a718-fee71eacde55",
                    "sense_definition": "Употребляется для присоединения сравнительных оборотов; имеет значение «как», «словно».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjunction_comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Её голос звучал чисто, <w>что</w> ручеёк в лесу.",
                            "target_lang_translations": {
                                "en": "Her voice sounded pure, <w>like</w> a stream in the forest.",
                                "zh": "她的声音很清脆，<w>像</w>森林里的小溪。"
                            }
                        },
                        {
                            "text": "Голова у него — <w>что</w> решето, ничего не помнит.",
                            "target_lang_translations": {
                                "en": "His head is <w>like</w> a sieve, he remembers nothing.",
                                "zh": "他的脑子<w>像</w>筛子一样，什么都记不住。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "folk or poetic style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to make a comparison.",
                        "zh": "用于进行比较，具有“像”的意思。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "archaic or poetic comparison"
                            },
                            {
                                "target_lang_word": "as if",
                                "target_lang_sense_clarification": "archaic or poetic comparison"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像",
                                "target_lang_sense_clarification": "比喻"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "424fe446-8bf9-3300-966d-2f65a00422b6",
                    "sense_definition": "Вопросительный отклик на обращение или просьба повторить то, что не было услышано.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "particle_response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Иван! — <w>Что</w>? Я здесь.",
                            "target_lang_translations": {
                                "en": "— Ivan! — <w>What</w>? I'm here.",
                                "zh": "— 伊万！— <w>什么</w>？我在这儿。"
                            }
                        },
                        {
                            "text": "— Ты слышал новость? — <w>Что</w>? Повтори, пожалуйста.",
                            "target_lang_translations": {
                                "en": "— Did you hear the news? — <w>What</w>? Please repeat.",
                                "zh": "— 你听到那个新闻了吗？— <w>啊</w>？请再说一遍。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ну что"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to ask someone to repeat what they said.",
                        "zh": "用于回应呼唤或请求对方重复刚才的话。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "request for repetition"
                            },
                            {
                                "target_lang_word": "pardon",
                                "target_lang_sense_clarification": "polite request for repetition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什么",
                                "target_lang_sense_clarification": "回应呼唤"
                            },
                            {
                                "target_lang_word": "啊",
                                "target_lang_sense_clarification": "请求重复"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f7bae9-bef0-3aba-962c-257d562e4b40",
                    "sense_definition": "Употребляется для усиления вопроса, выражения удивления, негодования или призыва к ответу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "particle_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Что</w>, мы сегодня никуда не пойдём?",
                            "target_lang_translations": {
                                "en": "<w>What</w>, are we not going anywhere today?",
                                "zh": "<w>怎么</w>，我们今天哪儿也不去了吗？"
                            }
                        },
                        {
                            "text": "Ну <w>что</w>, ты готов ехать?",
                            "target_lang_translations": {
                                "en": "<w>Well</w>, are you ready to go?",
                                "zh": "<w>那么</w>，你准备好出发了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "чё"
                    ],
                    "common_phrases": [
                        "что за"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express surprise, indignation, or to emphasize a question.",
                        "zh": "用于加强语气，表达惊讶、不满或催促。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "expression of surprise or indignation"
                            },
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "particle for emphasis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怎么",
                                "target_lang_sense_clarification": "表达惊讶"
                            },
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "语气助词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}