                "translations": [
                    {
                        "translation_id": "82c0b0ff-24b2-476f-bd02-3d636397d7db",
                        "source_entry_id": "6c9d800c-762c-3a17-b926-552f59160c36",
                        "source_sense_id": "75a96663-cd9e-3cc7-af9e-1d0d0e12e9ef",
                        "target_lang_word": "fractal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fractal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d36497c1-58d1-383d-aff6-e6d4fd4cf2e0",
                                        "entry_id": "ae1323d8-6070-3247-836f-6aefcbf11662",
                                        "glosses": [
                                            "A mathematical set that has a non-integer and constant Hausdorff dimension, corresponding to a geometric figure or object that is self-similar at arbitrarily small scales and thus has infinite complexity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "681e44d1-0f88-3cbc-b8e7-961aec21e31c",
                                        "entry_id": "ae1323d8-6070-3247-836f-6aefcbf11662",
                                        "glosses": [
                                            "An object, system, or idea that exhibits a fractal-like property, such as the property of self-similarity at numerous but not infinitely many scales."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3525fcbb-2efc-420e-a931-5f3add53396d",
                                                "sense_id": "681e44d1-0f88-3cbc-b8e7-961aec21e31c",
                                                "text": "In essence, you are assuming that each segment of a company is a fractal of the whole[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fractal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5efd58-5156-324c-a6fc-3e915c6ea79c",
                                        "entry_id": "370aa9c3-20ed-3d1a-be9c-9fde403e794f",
                                        "glosses": [
                                            "Having the form of a fractal; having to do with fractals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e95fc0-b9e9-4166-a65a-deb7df84d73a",
                                                "sense_id": "9e5efd58-5156-324c-a6fc-3e915c6ea79c",
                                                "text": "Romanesco was my gateway cauli and I've never stopped growing it. Not a variety as much as its own thing, Romanesco is a cauliflower to the French, a calabrese to the Italians. […] Visually, it may be the most remarkable thing you can grow: it is made up of lime-green mini-spirals that coil around themselves in fractal formation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e71b8a-0b76-3c51-a0ac-d79a0c17a3d3",
                                        "entry_id": "370aa9c3-20ed-3d1a-be9c-9fde403e794f",
                                        "glosses": [
                                            "Exhibiting a fractal-like property."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "not-comparable",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be2c787-ed98-4d11-9faa-1de64e90c61f",
                                                "sense_id": "18e71b8a-0b76-3c51-a0ac-d79a0c17a3d3",
                                                "text": "A fractal situation emerges in this way then: the consequences of Ulysses' decision to abandon Calypso are not entirely predictable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
