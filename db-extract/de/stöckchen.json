                ],
                "senses": [
                    {
                        "sense_id": "915b9bca-0c1b-360a-b55e-f86ff21c54f4",
                        "entry_id": "41700835-ae84-3090-b029-bfc25bb3a2bb",
                        "glosses": [
                            "kurzes, zylindrisches Stück Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea4b0d6-2e47-4831-8f06-40572296abd0",
                                "sense_id": "915b9bca-0c1b-360a-b55e-f86ff21c54f4",
                                "text": "Mein Hund holt gerade sein Stöckchen aus dem Wasser."
                            },
                            {
                                "example_id": "17d30361-8173-4fe1-8a4e-4aa6fed13fca",
                                "sense_id": "915b9bca-0c1b-360a-b55e-f86ff21c54f4",
                                "text": "„Der Jagdflieger Schnell ist ebenfalls nach Escoublac gekommen, rauchte mit seinem abgeschossenen Kollegen James M. Ferguson, dem B-17-Piloten, eine Zigarette und setzte sich dann mit ihm zusammen in den Sand, um dort mit einem Stöckchen nachzuzeichnen, wie es zu dem Abschuss kam.“"
                            },
                            {
                                "example_id": "72cacd59-adb2-4d56-83f8-95742b457d28",
                                "sense_id": "915b9bca-0c1b-360a-b55e-f86ff21c54f4",
                                "text": "„Im Übrigen war er in seinen Sinnesäußerungen viel vitaler als mancher Stöckchen schwingende ältere Herr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
