                        "entry_id": "1df7e3bf-579d-36f8-a983-030691615471",
                        "glosses": [
                            "Appareil servant à embosser la chair dans un boyau."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "ce38f56c-851c-4835-adab-cd66d30536c1",
                                "sense_id": "7c2bfc72-de23-347a-9c50-94c53682c504",
                                "text": "Les poussoirs ou embossoirs à saucisses \"poussent\" la chair à saucisse dans les boyaux en enlevant l'air et sont plus pratiques et plus rapides que l'embossage avec un hachoir à viande."
                            },
                            {
                                "example_id": "9db1caec-e8b6-430b-85bc-3a7eaf8d62c0",
                                "sense_id": "7c2bfc72-de23-347a-9c50-94c53682c504",
                                "text": "Va chercher l’'embossoir pour faire les saucisses."
                            }
                        ]
                    }
