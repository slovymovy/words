                "translations": [
                    {
                        "translation_id": "4997b723-2318-4c80-9f41-a2de179482f7",
                        "source_entry_id": "534c1f81-9343-3016-b70d-c054be387f2f",
                        "source_sense_id": "dbaa1935-c435-3d1d-b4fb-f6f373c88aeb",
                        "target_lang_word": "photovoltaic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photovoltaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf1a9f8b-b6bf-394c-9913-f74ec0692bb2",
                                        "entry_id": "b68117a7-5515-3eeb-8512-b79023781166",
                                        "glosses": [
                                            "Producing a voltage when exposed to light."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ab0104-04bf-4a0e-9244-09da8e80196a",
                                                "sense_id": "bf1a9f8b-b6bf-394c-9913-f74ec0692bb2",
                                                "text": "But the truly impressive part of this entry is the photovoltaic film that has been applied to the platform and entrance roofs (all 272 square metres of it). It is a UK first for the railway, and is expected to generate 36kW of electricity to meet the needs of the station itself and to feed the surplus back to the grid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0f9146b-f21c-46fa-a467-5f890b790e09",
                        "source_entry_id": "534c1f81-9343-3016-b70d-c054be387f2f",
                        "source_sense_id": "dbaa1935-c435-3d1d-b4fb-f6f373c88aeb",
                        "target_lang_word": "fotovoltaický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2564556-f5e3-4844-9a80-36ec7b7843fd",
                        "source_entry_id": "534c1f81-9343-3016-b70d-c054be387f2f",
                        "source_sense_id": "dbaa1935-c435-3d1d-b4fb-f6f373c88aeb",
                        "target_lang_word": "photovoltaïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photovoltaïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02b45a5e-62d5-38e6-b39f-3401b1199ed4",
                                        "entry_id": "0902a9c5-0e0d-3917-8ed5-0ab2757c60e7",
                                        "glosses": [
                                            "Relatif à la production d’électricité à partir de l’énergie lumineuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631cc83d-9729-4d11-b92e-698e0ca0ab32",
                                                "sense_id": "02b45a5e-62d5-38e6-b39f-3401b1199ed4",
                                                "text": "La ministre de l’Écologie Delphine Batho a annoncé, lors de sa visite à l’entreprise MPO, en Mayenne, le 7 janvier, une série de mesures destinées à aider la filière photovoltaïque."
                                            },
                                            {
                                                "example_id": "2022b948-1ed9-4327-8655-ce545c7facfd",
                                                "sense_id": "02b45a5e-62d5-38e6-b39f-3401b1199ed4",
                                                "text": "L'effet photovoltaïque se manifeste lorsqu'un semi-conducteur absorbe de la lumière. En acceptant l'énergie des photons, les électrons de la bande de valence des semi-conducteurs passent dans la bande de conduction et créent ainsi des paires électron-trou."
                                            },
                                            {
                                                "example_id": "3267642d-6633-48c3-97f3-d3b067cc40fc",
                                                "sense_id": "02b45a5e-62d5-38e6-b39f-3401b1199ed4",
                                                "text": "Les besoins en énergie de Tériya Bugu sont couverts en partie par le solaire thermique et photovoltaïque ainsi que le biogaz mais la plus grande part de l’électricité est produite par des groupes électrogènes fonctionnant au gasoil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "photovoltaïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aae577f-f610-3d98-b656-4a6b65bf4649",
                                        "entry_id": "5eb99c36-afa3-3790-affa-2db74ad37792",
                                        "glosses": [
                                            "Mode de production d’électricité utilisant des cellules photovoltaïques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9b6579-c6ce-4e93-8592-b0e19764a1b7",
                                                "sense_id": "8aae577f-f610-3d98-b656-4a6b65bf4649",
                                                "text": "Kosciusko-Morizet relance le photovoltaïque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
