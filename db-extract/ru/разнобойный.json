                "senses": [
                    {
                        "sense_id": "ccfc2d09-59fa-36ae-a19e-630fa076aee3",
                        "entry_id": "9d1786a3-b74a-3d8f-9426-559eec898235",
                        "glosses": [
                            "разг. происходящий вразнобой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cae9c3a-77d4-4943-b092-d2c7148dd23f",
                                "sense_id": "ccfc2d09-59fa-36ae-a19e-630fa076aee3",
                                "text": "Начался какой-то разнобойный разговор, и никак нельзя было уловить его стержня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d51fefe6-6f96-4647-acb3-bf088bb102ab",
                        "source_entry_id": "9d1786a3-b74a-3d8f-9426-559eec898235",
                        "source_sense_id": "ccfc2d09-59fa-36ae-a19e-630fa076aee3",
                        "target_lang_word": "heterogeneous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heterogeneous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Diverse in kind or nature; composed of diverse parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984df843-f9c1-4990-ad16-ce013c74e2a2",
                                                "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                                "text": "He had a large and heterogeneous collection of books."
                                            },
                                            {
                                                "example_id": "42393dbf-d686-4b5e-81c7-a8c6683ca7c1",
                                                "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                                "text": "With a vague curiosity I began to trace the outline of some of the heterogeneous impressions, trying meanwhile to curb the flights of macabre fancy which the place and its memories suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0e2710c-c75f-3d10-a081-0cb6331014c9",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Incommensurable because of different kinds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bffacdb-1649-388e-a63c-0d7b4c23451e",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Having more than one phase (solid, liquid, gas) present in a system or process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61322d13-2f1e-36d1-8ccd-bcac8dcb064d",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Visibly consisting of different components."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "560b5b6a-b848-3f6b-a7da-ad9b9d5a8ce3",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Of a network comprising different types of computers, potentially with vastly differing memory sizes, processing power and even basic underlying architecture; alternatively, of a data resource with multiple types of formats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b81be99a-df15-4b37-964d-3962decf616b",
                        "source_entry_id": "9d1786a3-b74a-3d8f-9426-559eec898235",
                        "source_sense_id": "ccfc2d09-59fa-36ae-a19e-630fa076aee3",
                        "target_lang_word": "abwechslungsreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abwechslungsreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                        "entry_id": "a55d0f7e-39ba-3f45-8d28-ae23e0dace6b",
                                        "glosses": [
                                            "durch Abwechslung gekennzeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008349ad-df90-42c6-a364-f03627f21edb",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Er hat ein abwechslungsreiches Leben geführt."
                                            },
                                            {
                                                "example_id": "fef69553-feae-48ca-86ab-2a2bb872ab6b",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Der Arzt riet ihm eine abwechslungsreiche Ernährung."
                                            },
                                            {
                                                "example_id": "1d9da67f-b268-4805-b80f-decef4876796",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Das Fußballspiel verlief sehr abwechslungsreich."
                                            },
                                            {
                                                "example_id": "94d3c988-550b-4756-ad0f-2be8b2050395",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "„Seine Musik ist so abwechslungsreich und ausdrucksstark,“ sagt Assistant Principal Hornist Bennert Ohlson."
                                            },
                                            {
                                                "example_id": "bba2df77-c7bc-44bb-ac03-814e613abded",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "In seinem wunderbar abwechslungsreich illustrierten Jugendbuch vermittelt der Welterklärer Richard Dawkins den aktuellen Wissensstand über den Urknall, den Aufbau der Materie sowie die Entstehung der Arten."
                                            },
                                            {
                                                "example_id": "0925691b-9d81-4db3-982f-3085ca5d9f9a",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "„Die Luft war herrlich, die Landschaft abwechslungsreich, nirgendwo konnte Otto sich die drei Jahre Gefangenschaft besser aus dem Leib laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20a17ffd-4c40-48ff-b785-a2c23d0aa6b5",
                        "source_entry_id": "9d1786a3-b74a-3d8f-9426-559eec898235",
                        "source_sense_id": "ccfc2d09-59fa-36ae-a19e-630fa076aee3",
