                                        "sense_id": "a8ff1d00-431e-33ca-aaf4-c8e09a9b75f1",
                                        "entry_id": "5b9f7f04-b844-308d-a8e3-896d9bddb885",
                                        "glosses": [
                                            "Mélanger des ingrédients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4240e097-45b5-4aac-9141-ccd400d63b32",
                                                "sense_id": "a8ff1d00-431e-33ca-aaf4-c8e09a9b75f1",
                                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab471953-2e19-35af-ab57-9b5b75d805c0",
                                        "entry_id": "5b9f7f04-b844-308d-a8e3-896d9bddb885",
                                        "glosses": [
                                            "Recomposer une musique, une chanson, à partir de fragments d’autres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87fe56fd-c5a0-3d23-b140-3febb4c37855",
                                        "entry_id": "5b9f7f04-b844-308d-a8e3-896d9bddb885",
                                        "glosses": [
                                            "Enchaîner des morceaux de musique, éventuellement en les déformant (changement du tempo, filtrage audio, bouclage, etc.) ou en les superposant, d'une façon qui évite une interruption de la musique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220b1c4e-1d4b-4a26-8feb-0132d1a491b0",
                                                "sense_id": "87fe56fd-c5a0-3d23-b140-3febb4c37855",
                                                "text": "Ce disque est une compilation mixée des tubes de l'année."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mixer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611781b8-8af8-39a2-9f51-1f84d3c4fc97",
                                        "entry_id": "bad42528-73ed-35ed-b615-e7354e8d329f",
                                        "glosses": [
                                            "Variante de mixeur."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810f5def-ecc0-4a8e-8c8b-e9b9b56414ed",
                                                "sense_id": "611781b8-8af8-39a2-9f51-1f84d3c4fc97",
                                                "text": "Ayant posé pour des photos publicitaires d’appareils ménagers, elle avait reçu en prime un « mixer » électrique à usages multiples."
                                            },
                                            {
                                                "example_id": "6eb038ab-2fe7-443b-94f6-0bc79b92a880",
                                                "sense_id": "611781b8-8af8-39a2-9f51-1f84d3c4fc97",
                                                "text": "Le mixer est rangé dans l’armoire à côté de l’évier, le sucre est dans le placard à provisions et le reste, dans le frigo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
