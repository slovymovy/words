                "senses": [
                    {
                        "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                        "entry_id": "36d1652b-96b9-3d85-8e53-579a6f7d8447",
                        "glosses": [
                            "Anfang einer Entwicklung, bei der etwas entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d612fd-5ab0-4c7c-85c0-18694c52ac7b",
                                "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                                "text": "„Das Keimen, als erster Bildungsbeginn, findet nur im Dunkeln Statt.“"
                            },
                            {
                                "example_id": "a5253db1-9b2b-4d70-a5c4-874f53a7f86a",
                                "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                                "text": "„Die Fahnen zeigen den Bildungsbeginn eines ersten Streifens an.“"
                            },
                            {
                                "example_id": "7ad0f903-86a0-478a-a864-59cb00a12a12",
                                "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                                "text": "„Der Bildungsbeginn aus Nb₂Oₛ und K₂CO₃ liegt bei 400°C, […].“"
                            },
                            {
                                "example_id": "dc657630-b08e-49a3-a955-e44d228ae614",
                                "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                                "text": "„Der Humus in Steppenböden ist über lange Zeiträume relativ stabil, so daß die Altersbestimmung mit *C angewendet werden kann, um den Bildungsbeginn und den Ablauf der Humusakkumulation in Tschernosemen zu rekonstruieren.“"
                            },
                            {
                                "example_id": "cb0f9a93-6dad-4939-a928-57a4955269c2",
                                "sense_id": "6c4d9ee6-95ed-3eb3-8c3e-17347fb12f9f",
                                "text": "„Eine allgemeine Angabe über den Zeitpunkt des Bildungsbeginnes scheitert an der Unzulänglichkeit der Zeitmaßmethoden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
