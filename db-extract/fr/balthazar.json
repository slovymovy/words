            {
                "entry_id": "a8ab1da6-41e5-39a7-a27d-5efd62b026b8",
                "word": "Balthazar",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83a3552b-9dcf-3814-90b2-e45f966dba87",
                        "entry_id": "a8ab1da6-41e5-39a7-a27d-5efd62b026b8",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575e89e3-c143-466e-a9df-de50425e7237",
                                "sense_id": "83a3552b-9dcf-3814-90b2-e45f966dba87",
                                "text": "Donc, Balthazar, Melchior et Gaspar, les Rois Mages,\nChargés de nefs d’argent, de vermeil et d’émaux\nEt suivis d’un très long cortège de chameaux,\nS’avancent, tels qu’ils sont dans les vieilles images."
                            },
                            {
                                "example_id": "416812b2-24d3-41b4-b344-0584d79b7871",
                                "sense_id": "83a3552b-9dcf-3814-90b2-e45f966dba87",
                                "text": "Licencié de la Société de tir sportif de Guéret (Creuse), le Sostranien Balthazar Almeida, 15 ans, participera samedi 17 février aux championnats de France de tir sportif à Tarbes. Son objectif ? Le top 10."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "080b9f54-9a13-48ab-b6b0-a312e177dea8",
                        "source_entry_id": "a8ab1da6-41e5-39a7-a27d-5efd62b026b8",
                        "source_sense_id": "83a3552b-9dcf-3814-90b2-e45f966dba87",
                        "target_lang_word": "Balthasar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balthasar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b44942a1-4fdd-3470-9924-e7022a467e20",
