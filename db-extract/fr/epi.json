                                "target_senses": [
                                    {
                                        "sense_id": "ef2f225a-3297-3ceb-8fad-37fde332f47f",
                                        "entry_id": "5cacd063-1425-34aa-8a45-f835c3fce2da",
                                        "glosses": [
                                            "Initialism of personal protective equipment."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a5edb6-8bb8-48da-9af8-57f0d02abedc",
                                                "sense_id": "ef2f225a-3297-3ceb-8fad-37fde332f47f",
                                                "text": "Any time you turn on a power tool, use a saw to cut wood, or get on the roof of your house to make a roof repair, PPE can help protect you."
                                            },
                                            {
                                                "example_id": "6ec074de-68da-4b17-8028-6844ac1d6633",
                                                "sense_id": "ef2f225a-3297-3ceb-8fad-37fde332f47f",
                                                "text": "The home secretary has said she is sorry if people feel there has been a failure to supply sufficient personal protective equipment (PPE) to NHS staff, as it was revealed that 19 UK health workers had died after contracting coronavirus."
                                            },
                                            {
                                                "example_id": "4714d03f-4998-458b-a3de-a40091a46bcd",
                                                "sense_id": "ef2f225a-3297-3ceb-8fad-37fde332f47f",
                                                "text": "In addition, there are basic PPE principles and practices that must be understood to protect the health and safety of everyone involved in handling a pesticide."
                                            },
                                            {
                                                "example_id": "4da9e80c-25f1-4b1e-8417-5b110636c4bf",
                                                "sense_id": "ef2f225a-3297-3ceb-8fad-37fde332f47f",
                                                "text": "Having donned our PPE, we walk through the site to the prefab that controls access to the tunnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e0c40ad-8fcc-3ec5-8b73-1911ff37730e",
                                        "entry_id": "5cacd063-1425-34aa-8a45-f835c3fce2da",
                                        "glosses": [
                                            "Initialism of property, plant, and equipment."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bfd690a-fb4d-33d6-8f0d-68c66c250dfc",
                                        "entry_id": "5cacd063-1425-34aa-8a45-f835c3fce2da",
                                        "glosses": [
                                            "Initialism of philosophy, politics and economics, a university degree course."
                                        ],
                                        "tags": [
                                            "UK",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
