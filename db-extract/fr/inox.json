                                "target_senses": [
                                    {
                                        "sense_id": "a41fa3df-9410-3a42-a28a-cbf3380d1f4d",
                                        "entry_id": "1ab548e9-aaec-3026-bcb8-c3279def1032",
                                        "glosses": [
                                            "uit roestvast staal vervaardigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0747e88c-126a-4283-bdad-aec94c74f82c",
                                                "sense_id": "a41fa3df-9410-3a42-a28a-cbf3380d1f4d",
                                                "text": "Zo ontwierp hij voor het Deense Georg Jensen een redelijk betaalbare, metalen olieschenker en een rvs suikerpot."
                                            }
