                                    {
                                        "sense_id": "aeb3fa40-4ee6-381c-9b20-ad21d0a318cb",
                                        "entry_id": "a3b9a4aa-77b0-3a17-886f-917b5a272966",
                                        "glosses": [
                                            "En parlant d'un navire, couler bas en plongeant d’abord son avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6f3aa2e-5a16-4264-ba02-b614e9547817",
                                                "sense_id": "aeb3fa40-4ee6-381c-9b20-ad21d0a318cb",
                                                "text": "Notre chaloupe faisait eau de toutes parts, elle était usée jusqu'à la corde et chaque fois qu'un orage éclatait … nous craignions de sancir."
                                            },
                                            {
                                                "example_id": "7bbc64ce-4d87-486b-a7ed-4a50eb5b06cb",
                                                "sense_id": "aeb3fa40-4ee6-381c-9b20-ad21d0a318cb",
                                                "text": "Sancir. Chavirer par l'avant cul par-dessus tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d42bfb3a-5bf0-49de-a7e2-5f79dbb28854",
                        "source_entry_id": "ba7b50b2-c79e-31c5-8e8f-10b99d667f92",
                        "source_sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
                        "source_sense_description": "capsize end over end",
                        "target_lang_word": "überschlagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e197d266-cb2c-366c-b553-cca5b98c1c66",
                                        "entry_id": "5231ee4d-9bbf-32f2-b1ce-cc8f5d243043",
                                        "glosses": [
                                            "regional: zwischen kalt und warm, lauwarm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6622d31-f058-4961-9ab7-37c47b33f3f5",
                                                "sense_id": "e197d266-cb2c-366c-b553-cca5b98c1c66",
                                                "text": "„So war der Raum leicht überschlagen und morgens lag Glut im Herd.“"
                                            },
                                            {
                                                "example_id": "c1cdea12-2025-4641-8bab-37bdf698350c",
                                                "sense_id": "e197d266-cb2c-366c-b553-cca5b98c1c66",
                                                "text": "„Man ist nun einmal gewohnt dem Kranken kein anderes, als sogenanntes überschlagenes Wasser zu reichen.“"
                                            },
                                            {
                                                "example_id": "9625ae7b-71a9-4174-b6ac-a9fc403bb923",
                                                "sense_id": "e197d266-cb2c-366c-b553-cca5b98c1c66",
                                                "text": "„Es war aber auch frisches Wasser, nachdem es nur in Etwas durch Stehenlassen im Zimmer überschlagen war, Allen das liebste Getränk, das stets von Neuem begehrte Labungsmittel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "972d4095-18b6-3f0e-926f-1c9b02d6baee",
                                        "entry_id": "5231ee4d-9bbf-32f2-b1ce-cc8f5d243043",
                                        "glosses": [
                                            "(von einem Polygon) mit nicht-zusammenhängenden Inneren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a5a4583-621a-4678-967c-1b3e346277e6",
                                                "sense_id": "972d4095-18b6-3f0e-926f-1c9b02d6baee",
                                                "text": "„Schneiden (berühren) sich die Kanten nicht nur in den Eckpunkten, bezeichnet man das Polygon als überschlagen.“"
                                            },
                                            {
                                                "example_id": "e756c739-42a7-435f-aa72-a65f4b59b174",
                                                "sense_id": "972d4095-18b6-3f0e-926f-1c9b02d6baee",
                                                "text": "„□ABCD sei ein nicht überschlagenes Sehnenviereck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca93d24-458d-3b94-8431-c6cf6bb629f9",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "durch Drehung um die eigene Achse Ober- und Unterseite vertauschen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb0f466-51df-4028-af92-ae76248065bd",
                                                "sense_id": "0ca93d24-458d-3b94-8431-c6cf6bb629f9",
                                                "text": "„In der Schule sage ich stolz: »Mein Vater hatte schon mal ein Loch im Kopf«, denn mein Vater hat sich einmal mit dem Auto überschlagen.“"
                                            },
                                            {
                                                "example_id": "61d84a44-c2f6-4824-8fff-bc57f5caf733",
                                                "sense_id": "0ca93d24-458d-3b94-8431-c6cf6bb629f9",
                                                "text": "„Das Auto kollidierte mit zwei Verkehrszeichen sowie mehreren Leitpfosten und überschlug sich.“"
                                            },
                                            {
                                                "example_id": "fe408058-5e3e-4172-b5f4-0f9164e20d68",
                                                "sense_id": "0ca93d24-458d-3b94-8431-c6cf6bb629f9",
                                                "text": "„Dadurch werden die Wellenberge höher, die Wellen überschlagen sich: es entsteht die typische Strandbrandung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfa4e186-aa88-3eaf-9119-17e2e0ee7c57",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "schnell oder übertrieben dicht aufeinanderfolgen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3237335-cbfc-44a1-983d-ef6dc57bb77a",
                                                "sense_id": "bfa4e186-aa88-3eaf-9119-17e2e0ee7c57",
                                                "text": "„Die zeitgenössischen Printmedien überschlugen sich vor der Eröffnung der Skihalle mit Lobpreisungen über das neue Wundermittel.“"
                                            },
                                            {
                                                "example_id": "eabef0ec-16b3-4345-b82d-0b4744d3c628",
                                                "sense_id": "bfa4e186-aa88-3eaf-9119-17e2e0ee7c57",
                                                "text": "„In den USA hat er es schon auf Platz eins der Charts geschafft, und die Kritiker überschlagen sich fast, wie cool, wie treffsicher und smart hier der Regisseur Fincher und der Topschreiber Sorkin den Zeitgeist gebannt, das Epos der Stunde gedreht, ach was - die ganze Epoche auf den Punkt gebracht haben.“"
                                            },
                                            {
                                                "example_id": "cd4e166b-bc64-4692-b113-ce8c29a75b98",
                                                "sense_id": "bfa4e186-aa88-3eaf-9119-17e2e0ee7c57",
                                                "text": "„Aber weil sich die Ereignisse so überschlagen hatten, wollte sie noch ein, zwei Wochen länger am See bleiben und ihrem Freund dann folgen.“"
                                            },
                                            {
                                                "example_id": "9db6af4c-39db-4ea2-876a-2ae64624aeae",
                                                "sense_id": "bfa4e186-aa88-3eaf-9119-17e2e0ee7c57",
                                                "text": "„Auch wenn die sagre (regionale Spezialitätenfeste) sich im Herbst förmlich überschlagen, gibt es eigentlich nie eine unpassende Zeit, um in Italien das Besteck hervorzuholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab4a62fe-0020-3261-9274-55d6a56e8c15",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "blitzartig in eine höhere Tonlage wechseln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73628f8a-2f8b-4ab8-908a-da34e8cf246f",
                                                "sense_id": "ab4a62fe-0020-3261-9274-55d6a56e8c15",
                                                "text": "„Meine Stimme überschlägt sich ein wenig, doch ich habe mir fest vorgenommen, nicht zu weinen.“"
                                            },
                                            {
                                                "example_id": "aa0207fc-d57f-49a3-9865-8deaf6a99a84",
                                                "sense_id": "ab4a62fe-0020-3261-9274-55d6a56e8c15",
                                                "text": "„‚So ploppplopp‘, bestätigt Olaf schnell, wobei sich seine Stimme überschlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4fdc8bd4-c05c-3509-8c5e-7319d46f9a47",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "nicht lesen/benutzen/verwenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1ea379-adda-47bb-bed6-152c17a710cb",
                                                "sense_id": "4fdc8bd4-c05c-3509-8c5e-7319d46f9a47",
                                                "text": "„Zunächst kann er ein paar Seiten überschlagen, worum ich ihn selbst bitte, denn ich schreibe drauf los, und was ich schreibe, ist vielleicht schon im Jahre 1835 langweilig, wie viel mehr also im Jahre 1880!“"
                                            },
                                            {
                                                "example_id": "bb8eb800-eb97-408b-b1bd-afaa51069bf8",
                                                "sense_id": "4fdc8bd4-c05c-3509-8c5e-7319d46f9a47",
                                                "text": "„An Überschriften als Unterbrechung des Zeilenflusses musste man sich im 16. Jahrhundert erst gewöhnen, doch bei dickeren Werken lernte man sie zu schätzen, wurde es doch nun ermöglicht, springend zu lesen und auch etwas zu überschlagen.“"
                                            },
                                            {
                                                "example_id": "2119ec13-1eef-4d2e-850f-f6d7033168d5",
                                                "sense_id": "4fdc8bd4-c05c-3509-8c5e-7319d46f9a47",
                                                "text": "„Wem die Festkörperthermodynamik vertraut ist, kann dieses einführende Kapitel überschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "85a86d31-1ea3-3c2a-888c-864e796b4ccc",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "grob abschätzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6894848-e7e5-499c-9680-743d49e558c3",
                                                "sense_id": "85a86d31-1ea3-3c2a-888c-864e796b4ccc",
                                                "text": "„Wenn dann der Preis für eine Seite ausgehandelt ist (mit der Agentur bzw. dem Team) können Sie zumindest grob die Kosten überschlagen.“"
                                            },
                                            {
                                                "example_id": "cc15f469-0c90-4245-a50c-d298d4ca8546",
                                                "sense_id": "85a86d31-1ea3-3c2a-888c-864e796b4ccc",
                                                "text": "„Jemand fragte sie: Hast du die Kosten überschlagen, als du beschlossest, eine Christin zu werden?“",
                                                "translation": "[(5), (6)] „Instinktiv überschlagen sie: Wenn unser Starren in Fauchen überginge, in Kratzen, in einen Kampf, wer würde dann gewinnen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1dfaa4c6-a056-3d05-948e-e2bc181d0a8f",
                                        "entry_id": "af5cc83d-8f7e-3de4-bc4f-05ba553e3519",
                                        "glosses": [
                                            "sich eine Alternative oder vergangene Situation vorstellen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "996684a3-7df9-3ad7-898c-9631ea889562",
                                        "entry_id": "e9f1cc8f-557f-335d-9b97-595dde932998",
                                        "glosses": [
                                            "eine kurze Strecke durch Gas oder Vakuum leitend überwinden"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4835df2-bed9-447a-859a-ff833c1d5646",
                                                "sense_id": "996684a3-7df9-3ad7-898c-9631ea889562",
                                                "text": "„Ein Funke schlägt über, und das Feld bricht zusammen.“"
                                            },
                                            {
                                                "example_id": "341e574b-c361-4eb7-ae66-b64441e17a2a",
                                                "sense_id": "996684a3-7df9-3ad7-898c-9631ea889562",
                                                "text": "„Der Zauber Elektras schweigt, kein Funke schlägt über.“"
                                            },
                                            {
                                                "example_id": "e5fff851-79cc-4c9c-b60c-c220cab81dd4",
                                                "sense_id": "996684a3-7df9-3ad7-898c-9631ea889562",
                                                "text": "„Wissenschaftlich geprüft, aber auf derart hohem Niveau, dass unsere Begeisterung überschlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37be7f3f-0c1d-3515-8dd7-d5a7e5675272",
                                        "entry_id": "e9f1cc8f-557f-335d-9b97-595dde932998",
                                        "glosses": [
                                            "die Beine sitzend übereinander legen"
                                        ],
                                        "tags": [
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2504463a-3305-4ab6-a107-d3c5916f635a",
                                                "sense_id": "37be7f3f-0c1d-3515-8dd7-d5a7e5675272",
                                                "text": "„Er saß, die dünnen Beine elegant übergeschlagen, und ich konnte deutlich das große Loch in seiner Schuhsohle erkennen.“"
                                            },
                                            {
                                                "example_id": "145fccc7-2767-46bc-87d3-b29886c91cd3",
                                                "sense_id": "37be7f3f-0c1d-3515-8dd7-d5a7e5675272",
                                                "text": "„Er gähnt verlegen und streckt sich, schlägt die Beine über und stützt die Ellbogen auf die Lehne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ada1aef-25ac-35d8-91e4-8a95f17c8708",
                                        "entry_id": "e9f1cc8f-557f-335d-9b97-595dde932998",
                                        "glosses": [
                                            "sich ins Gegenteil verwandeln"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f40df5-8835-470f-868d-ff6f3b769aad",
                                                "sense_id": "0ada1aef-25ac-35d8-91e4-8a95f17c8708",
                                                "text": "„Die Schalkhaftigkeit, die die Verfasserin auch sonst an den Tag legen will, hat sich hier überpurzelt und schlägt ins Gegenteil über; auch Unrichtigkeiten sind der Verfasserin unterlaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "73f5200b-e0c9-38d1-a722-799bd00a436b",
                                        "entry_id": "e9f1cc8f-557f-335d-9b97-595dde932998",
                                        "glosses": [
                                            "die Stimme blitzartig in eine höhere Tonlage wechseln"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9712803-5a3f-4664-b91d-81a1353b3d24",
                                                "sense_id": "73f5200b-e0c9-38d1-a722-799bd00a436b",
                                                "text": "„Natürlich weiß jeder, wann er ärgerlich ist – man zittert, man kocht, die Stimme schlägt über.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
