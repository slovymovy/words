                "senses": [
                    {
                        "sense_id": "664975d0-96fb-3968-8522-674020bf9659",
                        "entry_id": "f0ded9ef-8047-37a3-b0b3-de504f60e220",
                        "glosses": [
                            "Jungtier eines Löwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f622c8-2f5a-4e45-bd92-dc2cb9771aab",
                                "sense_id": "664975d0-96fb-3968-8522-674020bf9659",
                                "text": "„Der Mörder hätte ihn rasch umbringen können, aber stattdessen hatte er sich alle Zeit der Welt gelassen, hatte die lebenswichtigen Organe umkreist und mit Chu gespielt wie ein Löwenjunges mit einem verletzten Eichhörnchen.“"
                            },
                            {
                                "example_id": "c02ab3c7-02d1-4b56-ad5a-ae1500b092ac",
                                "sense_id": "664975d0-96fb-3968-8522-674020bf9659",
                                "text": "„Zwei von der Mutter vernachlässigte Löwenjunge sind nun eingeschläfert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
