                "senses": [
                    {
                        "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                        "entry_id": "5a680db9-f3ce-3093-9282-b57b21fbd8e8",
                        "glosses": [
                            "Autobus, der von einem Elektromotor angetrieben wird"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e093fa-69e5-4b51-abeb-25c003ff2a93",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Der Wiener „Öffi“-Betrieb stellt heute die ersten beiden Linien auf E-Busse um, bis 2025 folgen sieben weitere.“"
                            },
                            {
                                "example_id": "76f7ea69-8983-4f36-b7ca-55ef4cf9dd87",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Bis im Jahr 2027 will die BVB die gesamte Flotte auf E-Busse umstellen.“"
                            },
                            {
                                "example_id": "8b16e758-2d37-4807-b7be-148f85d537bc",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Im Januar 2023 gab die Kasseler Verkehrs-Gesellschaft die Bestellung von 12 E-Bussen bei Solaris bekannt.“"
                            },
                            {
                                "example_id": "4c15552b-0308-4005-8bce-1e3962203c79",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Bis 2025 werden insgesamt 60 E- sowie zehn Wasserstoffbusse auf den Straßen Wiens unterwegs sein.“"
                            },
                            {
                                "example_id": "37cca59b-2ff4-4013-9037-3ee16c9b8e4b",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Geladen, gewartet und repariert werden die E-Busse im neuen Kompetenzzentrum für E-Mobilität, das heute eröffnet wurde.“"
                            },
                            {
                                "example_id": "54aabffa-3d68-4762-948f-4539f684fe74",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Der Kauf der E-Busse und die Errichtung von Schnellladestationen werden aus Mitteln der EU, des Klimaschutzministeriums, der Stadt sowie der Wiener Linien finanziert.“"
                            },
                            {
                                "example_id": "107505fc-0d7b-4b82-a6d9-8bec15557651",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Gegen 600 Millionen wollen die Freiburger ÖV-Betriebe in E-Busse investieren.“"
                            },
                            {
                                "example_id": "e6421420-eba5-453f-9307-8246ffc9c11c",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "Ein E-Bus „ist doppelt so teuer wie ein normaler.“"
                            },
                            {
                                "example_id": "b89e58fb-a813-48cd-bc12-1f941585c484",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Die Anschaffung der E-Busse wird vom Bundesverkehrsministerium gefördert. 2022 erhielt die OVA in Aalen die Förderzusage über 6 Millionen Euro für 20 E-Busse.“"
                            },
                            {
                                "example_id": "94f5fc5f-f7e0-4b05-b7d7-c2338458436a",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„Der 12 Meter lange E-Bus ist seit Mitte Oktober in den Hauptverkehrszeiten auf den Linien 33 und 42 im Einsatz.“"
                            },
                            {
                                "example_id": "5dfd900f-2fc6-4e4a-a57e-1530d3eeaab8",
                                "sense_id": "1d0fffa0-1c34-374f-8ffd-3c8daa458227",
                                "text": "„2014 ist der erste E-Bus in Betrieb gegangen. Mittlerweile sind etwa 100 E-Busse auf den VHH-Linien in Hamburg und Schleswig-Holstein unterwegs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
