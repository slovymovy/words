                        "glosses": [
                            "groep muzikanten die hiphopmuziek maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ed2102-6dbc-4bc4-b7a2-e3fcc06bd716",
                                "sense_id": "30153c9d-e76e-3c7a-ada6-7edc2efc7ae9",
                                "text": "Forbes begon zijn muziekcarrière als lid van de hiphopgroep Entity. Nadat de groep in 2006 stopte, begon hij een solocarrière. Hij scoorde hits met onder andere Lemons (Lemonade), All Eyes on Me en Fela In Versace."
                            },
                            {
                                "example_id": "a313c955-62ae-455d-9e58-65dd8c1ca096",
                                "sense_id": "30153c9d-e76e-3c7a-ada6-7edc2efc7ae9",
                                "text": "Kaapverdië stond zaterdagavond in de kwartfinales van de Afrika Cup. Reden voor hiphopgroep Broederliefde om er in Rotterdam een Kaapverdisch feestje van te maken. DJ Edson César neemt ons mee."
                            },
                            {
                                "example_id": "3060d6b1-9342-4b88-a372-f9e49d9fb23b",
                                "sense_id": "30153c9d-e76e-3c7a-ada6-7edc2efc7ae9",
                                "text": "Rapper Brother Marquis van 2 Live Crew is overleden. Dat heeft de Amerikaanse hiphopgroep gisteren bekendgemaakt op Instagram en is vandaag ook bevestigd door hun manager. De rapper, die in het echt Mark D. Ross heette, was 58 jaar. Over de doodsoorzaak is niets bekendgemaakt."
                            }
                        ]
                    }
