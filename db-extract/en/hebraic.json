                        "examples": [
                            {
                                "example_id": "2d5705e2-a633-4c15-9061-5d5714bca5d8",
                                "sense_id": "d3c0e2e1-e0c7-3e3c-9b7c-59ee921b4446",
                                "text": "Note that in Hebraic legend and in occultism Asmodeus is the King of the Demons."
                            }
                        ]
