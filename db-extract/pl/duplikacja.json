                    {
                        "translation_id": "2eae5081-a618-42d2-8efd-6577e1147447",
                        "source_entry_id": "8b7c8a01-3892-3eb1-a176-14656fafc035",
                        "source_sense_id": "043799ac-1bbc-35ae-a4a7-e875f41755d9",
