                    {
                        "translation_id": "95bda4db-2337-44d4-9211-2678a25ae5cd",
                        "source_entry_id": "29354e07-bd62-3952-8c21-561614cd919f",
                        "source_sense_id": "46b5e664-c98a-3bc5-ad6e-e0088b27fc6d",
                        "target_lang_word": "Dreiflächner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ddfd86e1-01f1-4745-832e-ba8c83d4df24",
                        "source_entry_id": "29354e07-bd62-3952-8c21-561614cd919f",
                        "source_sense_id": "46b5e664-c98a-3bc5-ad6e-e0088b27fc6d",
                        "target_lang_word": "Dreibein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreibein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7758b990-29fd-3372-a6c8-085b9f4302f4",
                                        "entry_id": "4a1eec88-61d9-3ea6-8b63-516ecdff4453",
                                        "glosses": [
                                            "Möbelstück oder Gerät mit drei Beinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ac39ae-ca7b-4482-9b11-7baafd49ba90",
                                                "sense_id": "7758b990-29fd-3372-a6c8-085b9f4302f4",
                                                "text": "„Alle paar Minuten steht er auf, um sich in der Schüssel, die auf dem Dreibein steht, die Hände zu waschen.“"
                                            },
                                            {
                                                "example_id": "e3f1f4c5-7785-4e22-a157-2cf481ac4b60",
                                                "sense_id": "7758b990-29fd-3372-a6c8-085b9f4302f4",
                                                "text": "„Ich hab rumgebuddelt und das Ding schließlich samt Dreibein freigekriegt, und dann hab ich weitergegraben und die Munitionskiste rausgeholt, und dann bin ich dort hinter dem Mauerrest in Stellung gegangen, hab den Spannschieber zurückgezogen und entsichert, und schon ging’s los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aecd9b75-e192-4dd0-af2d-d5b6a14e2cc5",
                        "source_entry_id": "29354e07-bd62-3952-8c21-561614cd919f",
                        "source_sense_id": "46b5e664-c98a-3bc5-ad6e-e0088b27fc6d",
