                ],
                "senses": [
                    {
                        "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                        "entry_id": "4ffc7882-f5ef-3027-ab1d-f640de2383f1",
                        "glosses": [
                            "zusätzliche Bezahlung (= Zulage) aufgrund schwieriger Bedingungen (= Erschwernis) der zu verrichtenden Arbeit, beispielsweise für Arbeiten über Kopf, bei Hitze/Kälte/Nässe/Lärm, bei Gefährdungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524f0b43-d238-4485-b2eb-70229191d2db",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„John Loderer erhielt eine Erschwerniszulage von 1.000 Dollar, weil ihm seine Rolle abverlangte, sich seine Haare abrasieren zu lassen.“"
                            },
                            {
                                "example_id": "8759c3c3-c70f-47d7-9af1-174830921006",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Für die Aufgabenerfüllung sieht die Bundesbesoldungsordnung eine Erschwerniszulage von monatlich 150,00 Euro vor.“"
                            },
                            {
                                "example_id": "4de40eaa-9bd6-41f2-8318-4b8445eee472",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Die Personenbegleiter Luft erhalten“ […] „eine Erschwerniszulage differenziert nach inner- und außereuropäischen Rückführungen.“"
                            },
                            {
                                "example_id": "299fcd8c-39a9-4b13-b96c-6fa2388aeb1c",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„»Die Bezahlung muss den Mindestlohn plus alle Zulagen enthalten, also das 13. Monatsgehalt, Erschwerniszulagen, Kältezulagen, kurz: Die ausländischen Arbeiter müssen finanziell den nationalen Arbeitern gleichgestellt werden.«“"
                            },
                            {
                                "example_id": "df954d8d-540f-4a5e-b1c8-b0eb43baacc5",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„»Die Erschwerniszulagen müssten meiner Ansicht nach deutlich erhöht werden.«“"
                            },
                            {
                                "example_id": "ea3cedd7-401a-4680-84aa-6b27679cb27f",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "[Tarifverhandlungen:] „»Wir haben daraufhin eine stark vereinfachte Formulierung zurückgeschickt und auf die Erschwerniszulagen gepocht«, schildert Neunhöffer das Vorgehen der Gewerkschaft.“"
                            },
                            {
                                "example_id": "589278f8-6551-4976-a25d-67828d47dcc2",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Schleswig-Holsteins Landesregierung will die Erschwerniszulagen für Polizisten mit besonderen Aufgaben und für Verfassungsschützer erhöhen.“"
                            },
                            {
                                "example_id": "59b83475-16ef-41a6-b442-23c2f3e88538",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Sofern Angestellte unter nachhaltigen Erschwernissen arbeiten, erhalten sie eine angemessene Erschwerniszulage für die Dauer der Erschwernis.“"
                            },
                            {
                                "example_id": "02191c61-2d07-496a-9002-4dce9f4ac3d3",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Die Gewährung der Erschwerniszulage unterliegt der Vereinbarung zuwischen Betriebsleitung und Betriebsrat.“"
                            },
                            {
                                "example_id": "8189dd4c-14dd-47c1-82ad-6f3cb067faae",
                                "sense_id": "15916d24-d41a-3b89-bddc-7bb8cab872a7",
                                "text": "„Ein Anspruch besteht nur dann, wenn eine Erschwerniszulage tarifvertraglich, durch Betriebsvereinbarung oder einzelvertraglich vereinbart ist;“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
