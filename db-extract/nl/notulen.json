                        "source_sense_id": "b202965e-80a7-3b5c-b2b7-1950045ab03c",
                        "source_sense_description": "een verslag van een bijeenkomst",
                        "target_lang_word": "Protokoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
