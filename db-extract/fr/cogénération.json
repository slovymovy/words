                    {
                        "translation_id": "8993a4f0-c364-497a-b5fb-36ee29f43107",
                        "source_entry_id": "dace70a2-28e0-3b5d-8cee-a18119380cf4",
                        "source_sense_id": "87170b37-0885-3802-a4d0-eff1776ac764",
