                    "sense_id": "1c86f733-387d-378c-b947-32814945a012",
                    "sense_definition": "robić coś, wykonywać jakąś czynność",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "działanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uczeń szybko <w>czyni</w> postępy w nauce języka obcego.",
                            "target_lang_translations": {
                                "en": "The student is rapidly <w>making</w> progress in learning a foreign language."
                            }
                        },
                        {
                            "text": "Wszyscy uczestnicy <w>czynili</w> przygotowania do nadchodzącego wyjazdu.",
                            "target_lang_translations": {
                                "en": "All the participants were <w>making</w> preparations for the upcoming trip."
                            }
                        }
                    ],
                    "common_phrases": [
                        "czynić postępy",
                        "czynić przygotowania"
                    ],
                    "target_lang_definitions": {
                        "en": "to perform an activity, carry out an action, or make preparations/progress"
                    },
                    "translations": {
                        "en": [
