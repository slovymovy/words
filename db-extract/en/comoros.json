                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda873ea-404c-4db0-b0b0-8f1188ee0b38",
                                                "sense_id": "5622dadc-eb4f-3695-a077-65c6d79d9897",
                                                "text": "Die Komoren sind Vulkaninseln, einige der Vulkane sind heute noch aktiv."
                                            },
                                            {
                                                "example_id": "251ffa9e-ab2f-4f2c-a9dd-ea1aeed2487d",
                                                "sense_id": "5622dadc-eb4f-3695-a077-65c6d79d9897",
                                                "text": "Moroni ist die Hauptstadt der Komoren."
                                            }
