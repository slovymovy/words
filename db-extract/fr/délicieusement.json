        "fr-extract.jsonl": [
            {
                "entry_id": "0099733a-0f94-3bc1-b706-5fc5d7f2a782",
                "word": "délicieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b07b56b-1c43-3a5a-8bcd-2325fc167942",
                        "entry_id": "0099733a-0f94-3bc1-b706-5fc5d7f2a782",
                        "glosses": [
                            "Avec délices, d’une manière délicieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c75d00bb-3cc8-492d-8cbb-8b1981bfa35f",
                                "sense_id": "6b07b56b-1c43-3a5a-8bcd-2325fc167942",
                                "text": "Pour qu’un homme vive délicieusement, il faut que cent autres travaillent sans relâche."
                            },
                            {
                                "example_id": "d77e9d9a-bf5e-4fd2-925b-46d115ed99c2",
                                "sense_id": "6b07b56b-1c43-3a5a-8bcd-2325fc167942",
                                "text": "Je ne crois pas avoir été de mes jours plus vivement, plus délicieusement ému ; je mouillai de pleurs la main bienfaisante de mon amie, et si je ne fus pas vaincu dès cet instant même, je fus extrêmement ébranlé."
                            },
                            {
                                "example_id": "f787b7e6-c5ce-4229-930a-2d575d1beaa5",
                                "sense_id": "6b07b56b-1c43-3a5a-8bcd-2325fc167942",
                                "text": "Le lendemain, dès l’aube, elle rêva délicieusement dans son lit à cette journée qu’elle allait enfin vivre avec impatience et bonheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "05535f84-64a3-31cd-9fb1-056675e0729a",
                        "entry_id": "0099733a-0f94-3bc1-b706-5fc5d7f2a782",
                        "glosses": [
                            "D’une manière charmante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758f9f02-44c2-4c63-85f1-a55093f15690",
                                "sense_id": "05535f84-64a3-31cd-9fb1-056675e0729a",
                                "text": "Fiez-vous à nous : il est impossible d’écrire plus délicieusement."
                            },
                            {
                                "example_id": "5fc02d84-a34c-4880-afed-e64d6a6acfca",
                                "sense_id": "05535f84-64a3-31cd-9fb1-056675e0729a",
                                "text": "Ces vagabondages dans les hauts lieux littéraires de Moscou avaient un caractère délicieusement chaotique. Dans l’ancienne ruelle Hendrikov, ils pénétraient à l’intérieur de la cour de l’immeuble où, croyaient-ils à tort, Maïakovski s’était suicidé, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26d8ba13-0cb4-4a0c-aff9-e194b7125e1e",
                        "source_entry_id": "0099733a-0f94-3bc1-b706-5fc5d7f2a782",
                        "target_lang_word": "deliciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
