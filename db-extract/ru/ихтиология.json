                                "target_senses": [
                                    {
                                        "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                        "entry_id": "d81babd2-0011-3a22-bfae-8db1a3ab2e37",
                                        "glosses": [
                                            "wissenschaftliche Lehre von und die Beschäftigung mit den Fischen; Erforschung der Biologie der Fische unter natürlichen und künstlichen Lebensbedingungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0360841-1380-4a5b-98c7-4b05367e1308",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„So wie die Entwicklungen in der nordamerikanischen Fischkunde normalerweise vornehmlich für nordamerikanische Fischkundler von Interesse sind, interessieren sich für die Kunst Südafrikas vornehmlich südafrikanische Künstler.“"
                                            },
                                            {
                                                "example_id": "0b9e4f01-9f0a-44e2-903c-c3074663385e",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„Als Fachtierarzt für Fischkunde ist er seit 2004 Betreiber des viereinhalb Hektar großen Angelsees, von dem selbst im Winter ein kleiner Teil zugänglich ist, weil es keine Schonzeiten einzuhalten gilt.“"
                                            },
                                            {
                                                "example_id": "87baa592-5f9c-4deb-8dbc-69ebedbb1c7d",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„Jäckels Thätigkeit auf zoologischem Gebiete umfasst in erster Linie die Vogel-, Säugetier- und Fischkunde seines Heimatlandes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
