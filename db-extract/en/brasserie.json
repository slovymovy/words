                    },
                    {
                        "translation_id": "2f4363e0-415d-4315-b50f-3978631ac937",
                        "source_entry_id": "c5adc221-c89c-3e6b-b602-ae162421393b",
                        "source_sense_id": "6fec05f3-5339-3bbd-a61c-5f37547b98e2",
                        "source_sense_description": "type of restaurant",
                        "target_lang_word": "Lokal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lokal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                        "entry_id": "e365aba8-a82f-3ea6-acec-87323765bc60",
                                        "glosses": [
                                            "öffentliche Gaststätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d314ad32-84d5-4cf8-91a7-931dc153aed2",
                                                "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                                "text": "Wir gehen gerne in Lokale."
                                            },
                                            {
                                                "example_id": "9495f080-196b-44da-823d-590726c845a4",
                                                "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                                "text": "„Er führte mich zu einem Lokal, wo ich mich erleichtert an einem der Tische niederließ.“"
                                            },
                                            {
                                                "example_id": "db6708e9-118f-4033-b27c-cf12023b2f51",
                                                "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                                "text": "„Die Band klappert alle Lokale ab, die dem Tanz und dem triumphierenden Jazz geweiht sind.“"
                                            },
                                            {
                                                "example_id": "bbc79a45-fa52-463a-8fdb-ad78d9af838a",
                                                "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                                "text": "„Neben uns war auch ein kleines Lokal und danach wieder eins.“"
                                            },
                                            {
                                                "example_id": "0d1f2278-5dee-4210-993f-7455b44928c6",
                                                "sense_id": "4078ee37-e4fc-3d70-bfff-690a132d6161",
                                                "text": "„Lucien verließ das Lokal so hastig, wie er es betreten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcaaf29a-5656-33c6-8eb8-a11513fc4b4b",
                                        "entry_id": "e365aba8-a82f-3ea6-acec-87323765bc60",
                                        "glosses": [
                                            "Ort für Zusammenkünfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ded707-14fd-429f-b67b-67e2efe03336",
                                                "sense_id": "dcaaf29a-5656-33c6-8eb8-a11513fc4b4b",
                                                "text": "„Das Lokal darf nicht zu Wohnzwecken verwendet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21bc6344-311a-4be2-83c8-90d60884e0f2",
                        "source_entry_id": "c5adc221-c89c-3e6b-b602-ae162421393b",
