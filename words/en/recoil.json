{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78c737bc-9d0f-3efe-8452-ea2203556d37",
                    "sense_definition": "To suddenly spring back or flinch in horror, disgust, or surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>recoiled</w> in horror when she saw the huge spider on her desk.",
                            "target_lang_translations": {
                                "tr": "Masasındaki dev örümceği görünce dehşet içinde <w>irkildi</w>."
                            }
                        },
                        {
                            "text": "He <w>recoiled</w> in disgust from the foul smell coming out of the basement.",
                            "target_lang_translations": {
                                "tr": "Bodrumdan gelen pis kokudan iğrenerek <w>geri çekildi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil in horror",
                        "recoil in disgust",
                        "recoil in fear"
                    ],
                    "target_lang_definitions": {
                        "tr": "Korku, tiksinti veya şaşkınlıkla aniden geriye doğru sıçramak veya irkilmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "irkilmek",
                                "target_lang_sense_clarification": "korku veya tiksintiyle gerilemek"
                            },
                            {
                                "target_lang_word": "geri çekilmek",
                                "target_lang_sense_clarification": "aniden geriye gitmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5497016a-cfe5-385a-98e2-52b98ef2ed0b",
                    "sense_definition": "Of a firearm, to suddenly move backward upon firing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rifle <w>recoiled</w> sharply against his shoulder when he pulled the trigger.",
                            "target_lang_translations": {
                                "tr": "Tetiği çektiğinde ağır tüfek omzuna doğru sertçe <w>tepti</w>."
                            }
                        },
                        {
                            "text": "A gun will <w>recoil</w> violently if it is not held firmly.",
                            "target_lang_translations": {
                                "tr": "Sıkıca tutulmazsa bir silah şiddetle <w>teper</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil violently"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir ateşli silahın ateşlendiğinde aniden geriye doğru tepmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tepmek",
                                "target_lang_sense_clarification": "silahın geriye doğru hareketi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "817fb6d6-5d3e-3002-9f32-0b71d3324325",
                    "sense_definition": "To return or bounce back onto oneself, such as bad actions or consequences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He feared that his harsh words would <w>recoil</w> upon his own reputation.",
                            "target_lang_translations": {
                                "tr": "Sert sözlerinin kendi itibarına <w>ters tepmesinden</w> korkuyordu."
                            }
                        },
                        {
                            "text": "The plan was so poorly thought out that it was bound to <w>recoil</w> on them.",
                            "target_lang_translations": {
                                "tr": "Plan o kadar kötü düşünülmüştü ki kendi aleyhlerine <w>ters tepmesi</w> kaçınılmazdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil upon"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kötü eylemlerin veya sonuçların kişinin kendisine geri dönmesi, ters tepmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ters tepmek",
                                "target_lang_sense_clarification": "olumsuz bir sonucun dönüp kendisini vurması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7e9c4d5-f362-3ed3-b6cc-0d5cb2c43a90",
                    "sense_definition": "To retreat or withdraw from an opponent or danger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>recoil</w> before the advancing army.",
                            "target_lang_translations": {
                                "tr": "Askerler ilerleyen ordu karşısında <w>gerilemeye</w> başladı."
                            }
                        },
                        {
                            "text": "They refused to <w>recoil</w> in the face of intense enemy pressure.",
                            "target_lang_translations": {
                                "tr": "Yoğun düşman baskısı karşısında <w>geri çekilmeyi</w> reddettiler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil before"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir düşman veya tehlike karşısında gerilemek veya geri çekilmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gerilemek",
                                "target_lang_sense_clarification": "düşman karşısında geri çekilmek"
                            },
                            {
                                "target_lang_word": "geri çekilmek",
                                "target_lang_sense_clarification": "tehlikeden uzaklaşmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cb08a4e-13b7-3cf4-9778-65f232330fc5",
                    "sense_definition": "The sudden backward movement or kick of a gun when it is fired.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rifle had a powerful <w>recoil</w> that bruised his shoulder.",
                            "target_lang_translations": {
                                "tr": "Ağır tüfeğin omzunu morartan güçlü bir <w>geri tepmesi</w> vardı."
                            }
                        },
                        {
                            "text": "Hold the gun tight to absorb the heavy <w>recoil</w>.",
                            "target_lang_translations": {
                                "tr": "Ağır <w>geri tepmeyi</w> emmek için silahı sıkı tutun."
                            }
                        }
                    ],
                    "synonyms": [
                        "kick"
                    ],
                    "common_phrases": [
                        "heavy recoil",
                        "felt the recoil"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir silahın ateşlendiğinde yaptığı ani geri tepme hareketi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geri tepme",
                                "target_lang_sense_clarification": "silahın tepme kuvveti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46a28e3c-2f99-321d-bb99-9b3e25dbe0cd",
                    "sense_definition": "A psychological movement or sudden feeling of shrinking back in fear, surprise, or distaste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sudden <w>recoil</w> showed how much she disliked his presence.",
                            "target_lang_translations": {
                                "tr": "Onun varlığından ne kadar hoşlanmadığını ani <w>irkilmesi</w> gösteriyordu."
                            }
                        },
                        {
                            "text": "He felt a natural <w>recoil</w> from the idea of working on weekends.",
                            "target_lang_translations": {
                                "tr": "Hafta sonları çalışma fikrine karşı doğal bir <w>irkilme</w> hissetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sudden recoil"
                    ],
                    "target_lang_definitions": {
                        "tr": "Korku, şaşkınlık veya hoşnutsuzlukla aniden geriye çekilme hissi veya tepkisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "irkilme",
                                "target_lang_sense_clarification": "ani irkilme hareketi veya hissi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f44c99-5c81-3ae9-8f20-5e092e68f001",
                    "sense_definition": "A strong reaction or backlash against an idea, trend, or movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political change was a sharp <w>recoil</w> from strict government regulations.",
                            "target_lang_translations": {
                                "tr": "Siyasi değişim, katı hükümet düzenlemelerine karşı keskin bir <w>tepkiydi</w>."
                            }
                        },
                        {
                            "text": "There was a broad cultural <w>recoil</w> against modern technology.",
                            "target_lang_translations": {
                                "tr": "Modern teknolojiye karşı geniş çaplı kültürel bir <w>tepki</w> vardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil from"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir fikre, akıma veya harekete karşı gösterilen güçlü tepki veya olumsuz geri dönüş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tepki",
                                "target_lang_sense_clarification": "bir fikre veya akıma karşı tepki"
                            },
                            {
                                "target_lang_word": "ters tepki",
                                "target_lang_sense_clarification": "karşı tepki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e168599-c287-323b-8b1a-22c6e1d72657",
                    "sense_definition": "A mechanism in clockwork that causes the gear wheel to reverse slightly after each beat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The watchmaker carefully adjusted the <w>recoil</w> mechanism in the old grandfather clock.",
                            "target_lang_translations": {
                                "tr": "Saatçi, eski ayaklı saatteki <w>geri kaçma</w> mekanizmasını dikkatlice ayarladı."
                            }
                        },
                        {
                            "text": "An antique clock often uses a traditional <w>recoil</w> escapement.",
                            "target_lang_translations": {
                                "tr": "Antika bir saat genellikle geleneksel bir <w>geri kaçmalı</w> maşa kullanır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recoil escapement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in horology"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Saat mekanizmasında çarkın her vuruştan sonra hafifçe ters yöne dönmesini sağlayan mekanizma."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geri kaçma",
                                "target_lang_sense_clarification": "saatçilikte geri kaçma maşası/mekanizması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}