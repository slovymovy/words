                ],
                "senses": [
                    {
                        "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                        "entry_id": "b141989f-23b6-338e-a077-544c81da373f",
                        "glosses": [
                            "Geschwindigkeit, in der sich etwas dreht, rotiert; Maß dafür, mit welcher Schnelligkeit sich der Winkel um eine Achse in einem bestimmten Zeitabschnitt ändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6982b497-3824-4eb9-8c98-42f2f008636e",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Hier wird die beobachtete Rotationsgeschwindigkeit für verschiedene Entfernungen vom Zentrum der Galaxie aufgetragen.“"
                            },
                            {
                                "example_id": "433a6c3d-5b05-49f5-96a3-3824d8f626be",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Das sei misslich, denn je größer die Entfernung des Startpunkts vom Äquator, desto geringer die gleichsam natürliche Rotationsgeschwindigkeit, desto weniger Last könne man den Raketen aufladen.“"
                            },
                            {
                                "example_id": "a4fb0967-ca6e-4a9e-b5b2-75955fe2d750",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Stattdessen verliert der Neutronenstern nun Energie in Form von elektromagnetischer Strahlung, was seine Rotationsgeschwindigkeit rasch verlangsamt.“"
                            },
                            {
                                "example_id": "3362ce04-fa8d-41ca-964f-d20d268c9643",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Sogenannte Millisekundenpulsare bringen es auf mehrere hundert Umdrehungen pro Sekunde, was einer Rotationsgeschwindigkeit von immerhin bis zu sechzig Prozent der Lichtgeschwindigkeit entspricht.“"
                            },
                            {
                                "example_id": "63957725-2cfe-4918-85ca-cca008f49ebc",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Mit Hilfe eines optischen Effekts ist es amerikanischen Forschern erstmals gelungen, die Rotationsgeschwindigkeit eines Schwarzen Loches mit rund 200 Millionen Sonnenmassen im Zentrum einer weit entfernten aktiven Galaxie zu bestimmen.“"
                            },
                            {
                                "example_id": "a0938ba2-9cc7-4438-91dd-adb99cd9ad49",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Klar, daß man bei einer solchen Rotationsgeschwindigkeit nicht auch noch ein wirklich bedeutender Fußballehrer werden kann.“"
                            },
                            {
                                "example_id": "0ff90d6e-fbdb-4079-ad09-9bffb1bbf484",
                                "sense_id": "95eaddff-7708-3ba5-843e-fb473c40fcde",
                                "text": "„Will man einen Asteroiden aus der Bahn lenken, etwa indem man ihm einen kräftigen Schubs gibt oder seine Rotationsgeschwindigkeit verringert, damit die Sonne ihn von einer Seite mehr erwärmt, ist es entscheidend, wie fest oder porös er ist und wie viel Wärme seine Oberfläche absorbiert, wenn sie länger als üblich der Sonneneinstrahlung ausgesetzt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
