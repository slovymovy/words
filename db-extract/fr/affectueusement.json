        "fr-extract.jsonl": [
            {
                "entry_id": "9fa52398-6052-37f3-8ee9-82c1eea9b4a6",
                "word": "affectueusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                        "entry_id": "9fa52398-6052-37f3-8ee9-82c1eea9b4a6",
                        "glosses": [
                            "D’une manière affectueuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c1d850-f974-41c3-baf1-ef9494f3214a",
                                "sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                                "text": "Ne te tourmente pas de cela, mon gars, lui dit-il affectueusement, et puisque tu le veux, opère de ton côté, pendant que je travaillerai d'une autre façon."
                            },
                            {
                                "example_id": "590d5031-1079-485c-bf2e-c9d76488ec84",
                                "sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                                "text": "C’est par le sentiment et l’impression de ce désir du salut que le saint roi David s'écriait si souvent et disait si affectueusement à Dieu…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75114751-4bc7-43d6-aa01-95863305ae9b",
                        "source_entry_id": "9fa52398-6052-37f3-8ee9-82c1eea9b4a6",
                        "source_sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                        "target_lang_word": "affectionately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affectionately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb864c8e-7e4f-3324-a8f7-b34dd4257644",
                                        "entry_id": "4e20071b-faee-3b85-915c-be84113cde9d",
                                        "glosses": [
                                            "In an affectionate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f213245-7f2b-4171-87bd-c09044ab330f",
                                                "sense_id": "cb864c8e-7e4f-3324-a8f7-b34dd4257644",
                                                "text": "Catherine is affectionately known as \"Kit Kat\" to her friends."
                                            },
                                            {
                                                "example_id": "1d09966e-e224-4f2e-9592-335788d85e73",
                                                "sense_id": "cb864c8e-7e4f-3324-a8f7-b34dd4257644",
                                                "text": "The couple were touching each other affectionately."
                                            },
                                            {
                                                "example_id": "31f35c54-f922-4164-8bf9-5d8451ba9c93",
                                                "sense_id": "cb864c8e-7e4f-3324-a8f7-b34dd4257644",
                                                "text": "After riding high for two decades, the company that makes the hulky bikes that devoted riders affectionately call Hogs is sputtering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac736abd-54a8-422d-acbe-5218049c90f5",
                        "source_entry_id": "9fa52398-6052-37f3-8ee9-82c1eea9b4a6",
                        "source_sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                        "target_lang_word": "clingingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clingingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "263ffe39-6d1b-3312-92ff-b0b545fd60e7",
                                        "entry_id": "5e0113a3-856e-3a35-9d21-9ccd1a97727e",
                                        "glosses": [
                                            "In a clinging manner; tenaciously or possessively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85af65b-16e8-4f91-8ee5-719e2a3e4622",
                                                "sense_id": "263ffe39-6d1b-3312-92ff-b0b545fd60e7",
                                                "text": "But how happy can the ending be when two desperate people live clingingly ever after, mostly because they are tired of the lives they have been leading and not because they find each other appealing and want actively to change their lives?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd7b21c8-55a8-4e01-8763-21bc8385b304",
                        "source_entry_id": "9fa52398-6052-37f3-8ee9-82c1eea9b4a6",
                        "source_sense_id": "9fd2f70f-d3c2-3e6c-9bfa-c695b335de40",
                        "target_lang_word": "fondly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5977759e-0993-3bab-95d6-1aa7dfa54f96",
                                        "entry_id": "690bed1e-231b-34f3-9b96-6b89c5f6235e",
                                        "glosses": [
                                            "In a fond manner; affectionately; tenderly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba4165-9bb3-4dd2-a907-1217a2cd3fa0",
                                                "sense_id": "5977759e-0993-3bab-95d6-1aa7dfa54f96",
                                                "text": "He looked fondly at the pictures of his high-school friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f295968-be04-3977-997d-c61865a27745",
                                        "entry_id": "690bed1e-231b-34f3-9b96-6b89c5f6235e",
                                        "glosses": [
                                            "Foolishly."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d48e266-990f-41a2-955b-1ec3a116a185",
                                                "sense_id": "8f295968-be04-3977-997d-c61865a27745",
                                                "text": "\"Doth God exact day-labour, light denied?\" / I fondly ask..."
                                            },
                                            {
                                                "example_id": "0b41e9bf-5e8d-4520-81ad-c0dddae0f608",
                                                "sense_id": "8f295968-be04-3977-997d-c61865a27745",
                                                "text": "[…] she fondly believes that ten millions of the free people of the Union will allow her and her seceding brethren to open and shut the portals of this mighty region at their pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
