        "fr-extract.jsonl": [
            {
                "entry_id": "f1609bc0-2d5b-3b40-9bc2-ff307b8e158c",
                "word": "dadais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bab233cc-a550-48fd-95f4-5ffc12e96328",
                        "entry_id": "f1609bc0-2d5b-3b40-9bc2-ff307b8e158c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "dadaise"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                        "entry_id": "f1609bc0-2d5b-3b40-9bc2-ff307b8e158c",
                        "glosses": [
                            "Homme niais, nigaud ou maladroit."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "note": "Se dit surtout d’un jeune homme",
                        "examples": [
                            {
                                "example_id": "c71f3c98-26b9-40fd-8b41-3efb14320a68",
                                "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                                "text": "— Décidément l'ami Baptiste est un gaillard heureux ! — fit maître Chapelle en riant et en frappant joyeusement sur l'épaule du dadais."
                            },
                            {
                                "example_id": "c0e1f3e1-f9a4-4950-ba0d-930653bb6e2b",
                                "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                                "text": "— Ce n’est pas avec ce grand dadais de valet de chambre que vous allez vous marier, au moins ? continua Sainte-Austreberthe."
                            },
                            {
                                "example_id": "98759ad2-694a-4dbc-9469-5d10c3c754af",
                                "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                                "text": "Le cousin ! répondit la Normande d’une voie aiguë, vous croyez au cousin, vous !… Quelque amoureux, ce grand dadais."
                            },
                            {
                                "example_id": "2c5fd55d-7231-4b26-8d09-cc313f27fdff",
                                "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                                "text": "Je restais là comme un dadais\nElle était belle comme un cygne\nEt moi j'avais une de ces guignes\nÇa n'était pas ce que je croyais."
                            },
                            {
                                "example_id": "fb4ad56e-dd75-47e5-a43f-c6feb8d737c6",
                                "sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
                                "text": "Vos gueules ! les pisse-tiède, grands dadais aux poches pleines. Ah, qu'à voir vous faites peine, imbéciles de père en fils, rien, jamais, ne vous suffit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b68e4c7-c6b2-4c22-b46a-21d8d9b95544",
                        "source_entry_id": "f1609bc0-2d5b-3b40-9bc2-ff307b8e158c",
                        "source_sense_id": "490a3ea5-ddb8-371d-bd96-35811011bae2",
