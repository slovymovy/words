                "senses": [
                    {
                        "sense_id": "44e19e56-8807-3c17-b32f-b435df8183a6",
                        "entry_id": "4c50d801-84e1-3cfe-92b5-37d7cbbcd1b6",
                        "glosses": [
                            "Zustand der Angespanntheit und Aufgeregtheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae368748-749a-431b-b2ec-098813b5b66a",
                                "sense_id": "44e19e56-8807-3c17-b32f-b435df8183a6",
                                "text": "\"Wie der Ruhe von «Die Kinder vom Napf» die Rastlosigkeit von Wyss gegenübersteht, so bestimmen auch, thematisch bedingt, ganz unterschiedliche dokumentarische Arbeitsweisen die Form der beiden Filme.\""
                            },
                            {
                                "example_id": "470a3589-9a32-4781-ae60-0ce73e489460",
                                "sense_id": "44e19e56-8807-3c17-b32f-b435df8183a6",
                                "text": "„Angesichts dieser alarmierenden Entwicklung muss daher dringend empfohlen werden, die gewohnte Rastlosigkeit auch in den Feiertagen fortzusetzen, um die Rückkehr ins Berufsleben nicht unnötig zu erschweren.“"
                            },
                            {
                                "example_id": "de3f1049-a221-4eaa-8ebc-8ff3deb4d557",
                                "sense_id": "44e19e56-8807-3c17-b32f-b435df8183a6",
                                "text": "„Meistens begleitete Adrienne Sylvia nach Les Déserts, aber etwas in ihr war angesichts all der Rastlosigkeit und Bedürftigkeit auch aufgeblüht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
