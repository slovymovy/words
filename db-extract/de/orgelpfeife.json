                ],
                "senses": [
                    {
                        "sense_id": "fd9555f1-6bd1-3b06-9b2f-aabdc8de5ef8",
                        "entry_id": "7b908c55-6c4d-3417-bc61-4642921904e9",
                        "glosses": [
                            "Pfeife als Bestandteil einer Orgel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bd8507-08ef-49d8-a58f-0c552cd07c2a",
                                "sense_id": "fd9555f1-6bd1-3b06-9b2f-aabdc8de5ef8",
                                "text": "„Der ernste Moment wurde akustisch begleitet vom Raunen der betenden Frau, und von den Klängen des Bora, der wie aus Orgelpfeifen durch das Gemäuer heulte.“"
                            },
                            {
                                "example_id": "bb74c1d8-4ea4-4a93-bde7-c02a5d44b69d",
                                "sense_id": "fd9555f1-6bd1-3b06-9b2f-aabdc8de5ef8",
                                "text": "„Für die Orgelpfeifen gab es weder eine automatische Luftzufuhr noch einen Blasebalg zum Treten.“"
                            },
                            {
                                "example_id": "9b4de8c3-dcc6-44cf-8802-d1f310c8d7f9",
                                "sense_id": "fd9555f1-6bd1-3b06-9b2f-aabdc8de5ef8",
                                "text": "„Dabei harmonierten Orgelpfeifen und Menschenstimmen eher selten.“"
                            },
                            {
                                "example_id": "46841199-e874-49e3-90fa-9be1bfe3da31",
                                "sense_id": "fd9555f1-6bd1-3b06-9b2f-aabdc8de5ef8",
                                "text": "„Die war von einem klassischen Konzert inspiriert, das er besucht hatte, stand im Programm, und sollte Orgelpfeifen darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
