                "senses": [
                    {
                        "sense_id": "289a12b3-e14e-3ce1-9e98-38cd63f4604d",
                        "entry_id": "8a5997d4-0c7a-323e-ac9c-c862403e8852",
                        "glosses": [
                            "medizinische Untersuchung (Studie), mit einem Aufbau, der sicherstellen soll, dass die teilnehmenden Personen in Unkenntnis sind, ob sie ein wirksames Präparat oder ein Placebo verabreichen (Arzt) oder bekommen (Patient)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af68af26-cc39-4a1d-b505-cc9361f97b13",
                                "sense_id": "289a12b3-e14e-3ce1-9e98-38cd63f4604d",
                                "text": "„Bei einer Doppelblindstudie (doubleblind) wissen auch die Forscher nicht, zu welcher Gruppe die Teilnehmer gehören. Durch diese Maßnahmen soll die Untersuchung von Erwartungen und durch sie geprägte Verhaltensweisen frei gehalten werden.“"
                            },
                            {
                                "example_id": "81dffc3d-7e91-488e-bb91-8ec10e33c01d",
                                "sense_id": "289a12b3-e14e-3ce1-9e98-38cd63f4604d",
                                "text": "In einer placebo-kontrollierten Doppelblindstudie für hochdosierte Baldrianextraktpräparate konnte eine leichte schlafinduzierende Wirkung nachgewiesen werden."
                            },
                            {
                                "example_id": "d1b21f49-2046-4ade-917d-53951db59733",
                                "sense_id": "289a12b3-e14e-3ce1-9e98-38cd63f4604d",
                                "text": "Es wurde eine randomisierte, placebo-kontrollierte Doppelblindstudie durchgeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
