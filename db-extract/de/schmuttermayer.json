                "senses": [
                    {
                        "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                        "entry_id": "8aef087e-ad69-371e-a82d-2519d3c7223b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab93c30-c76a-4810-837b-e330394800f0",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Frau Schmuttermayer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b8846cc2-a315-45fe-a20f-3f771a053cac",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Herr Schmuttermayer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "95a8af67-d48e-4e87-b896-68957a27b606",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Die Schmuttermayers fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "4a10fc67-8037-4c94-b9dd-e92f7a282b73",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Der Schmuttermayer trägt nie die Pullover, die die Schmuttermayer ihm strickt."
                            },
                            {
                                "example_id": "3c57ec55-b20e-4d4a-bb61-6ea9dd2f356a",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmuttermayer kommt, geht der Herr Schmuttermayer.“"
                            },
                            {
                                "example_id": "67dc9f4e-79a4-4e9c-b087-10c8554d334c",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Schmuttermayer kommt und geht."
                            },
                            {
                                "example_id": "2fe29232-f14f-44f4-b498-d3c82f6bc4e8",
                                "sense_id": "859cd5c6-b77d-357f-90b8-355b70a1a043",
                                "text": "Schmuttermayers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
