                                        "sense_id": "48c4138f-0499-3dd3-b3d1-fd0d6a3c8cee",
                                        "entry_id": "29f78197-903d-3eec-be67-db1ff78ca0e9",
                                        "glosses": [
                                            "Effeminate, flamboyant or otherwise obviously gay."
                                        ],
