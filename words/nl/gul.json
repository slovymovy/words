{
    "word_family": [
        "gulheid",
        "gullen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc9c6ee0-1780-3533-81ad-fe0be31edde0",
                    "sense_definition": "bereid om veel te geven aan anderen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vrijgevigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ook dit jaar was deze donateur weer heel <w>gul</w> met zijn bijdrage.",
                            "target_lang_translations": {
                                "en": "This year too, this donor was very <w>generous</w> with his contribution.",
                                "zh": "今年这位捐赠者依然非常<w>慷慨</w>地提供了捐款。"
                            }
                        },
                        {
                            "text": "Zij is een <w>gulle</w> gever die altijd geld aan goede doelen schenkt.",
                            "target_lang_translations": {
                                "en": "She is a <w>generous</w> giver who always donates money to charities.",
                                "zh": "她是一位<w>大方</w>的捐赠者，总是向慈善机构捐款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "genereus",
                        "goedgeefs",
                        "vrijgevig",
                        "royaal"
                    ],
                    "antonyms": [
                        "gierig"
                    ],
                    "common_phrases": [
                        "gulle gever",
                        "gul met geld"
                    ],
                    "target_lang_definitions": {
                        "en": "willing to give a lot to others",
                        "zh": "乐于给予他人，慷慨大方"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "generous",
                                "target_lang_sense_clarification": "willing to give and share unsparingly"
                            },
                            {
                                "target_lang_word": "liberal",
                                "target_lang_sense_clarification": "giving freely"
                            },
                            {
                                "target_lang_word": "bountiful",
                                "target_lang_sense_clarification": "giving in large amounts"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慷慨",
                                "target_lang_sense_clarification": "乐于给予，不吝啬"
                            },
                            {
                                "target_lang_word": "大方",
                                "target_lang_sense_clarification": "在财物上不计较，乐于助人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffd63bca-0ad8-335a-82f5-4006d81ff7b2",
                    "sense_definition": "op een hartelijke en oprechte manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vriendelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij lachte <w>gul</w> toen hij de grappige grap van zijn vriend hoorde.",
                            "target_lang_translations": {
                                "en": "He laughed <w>heartily</w> when he heard his friend's funny joke.",
                                "zh": "听到朋友讲的笑话，他<w>爽朗</w>地笑了。"
                            }
                        },
                        {
                            "text": "De gastheer toonde een <w>gulle</w> lach bij het verwelkomen van de gasten.",
                            "target_lang_translations": {
                                "en": "The host showed a <w>broad</w> smile while welcoming the guests.",
                                "zh": "主人在迎接客人时露出了<w>爽朗</w>的笑容。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gulle lach"
                    ],
                    "target_lang_definitions": {
                        "en": "in a hearty and sincere manner",
                        "zh": "以热诚、真挚的方式"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hearty",
                                "target_lang_sense_clarification": "loud, cheerful, and energetic"
                            },
                            {
                                "target_lang_word": "broad",
                                "target_lang_sense_clarification": "wide and full, usually of a smile"
                            },
                            {
                                "target_lang_word": "genial",
                                "target_lang_sense_clarification": "friendly and cheerful"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爽朗",
                                "target_lang_sense_clarification": "形容笑声或性格开朗、直率"
                            },
                            {
                                "target_lang_word": "热诚",
                                "target_lang_sense_clarification": "热心而诚恳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "659d5b45-55c5-3984-bac0-177f047effad",
                    "sense_definition": "in grote hoeveelheden aanwezig of gegeven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overvloed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zon scheen <w>gul</w> over het prachtige landschap tijdens onze vakantie.",
                            "target_lang_translations": {
                                "en": "The sun shone <w>generously</w> over the beautiful landscape during our holiday.",
                                "zh": "假期里，阳光<w>充沛</w>地洒在美丽的风景上。"
                            }
                        },
                        {
                            "text": "Er werd <w>gul</w> geschonken tijdens het feestelijke diner van de vereniging.",
                            "target_lang_translations": {
                                "en": "Drinks were <w>lavishly</w> poured during the association's festive dinner.",
                                "zh": "在协会的节日晚宴上，酒水供应十分<w>丰厚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "royaal"
                    ],
                    "common_phrases": [
                        "gul schenken"
                    ],
                    "target_lang_definitions": {
                        "en": "present or given in large quantities",
                        "zh": "数量充足或给予得很多"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "generous",
                                "target_lang_sense_clarification": "large or more than ample"
                            },
                            {
                                "target_lang_word": "lavish",
                                "target_lang_sense_clarification": "sumptuous or given in great amounts"
                            },
                            {
                                "target_lang_word": "copious",
                                "target_lang_sense_clarification": "abundant in supply or quantity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充沛",
                                "target_lang_sense_clarification": "充足而旺盛"
                            },
                            {
                                "target_lang_word": "丰厚",
                                "target_lang_sense_clarification": "丰富、充足"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20f31dd8-67de-3102-8d0a-0dccb0d6d182",
                    "sense_definition": "een jonge kabeljauw tot een lengte van ongeveer zestig centimeter",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser was blij omdat hij een kleine <w>gul</w> had gevangen.",
                            "target_lang_translations": {
                                "en": "The fisherman was happy because he had caught a small <w>codling</w>.",
                                "zh": "渔夫很高兴，因为他捕到了一条<w>小鳕鱼</w>。"
                            }
                        },
                        {
                            "text": "Ik heb een <w>gulletje</w> gevangen tijdens het vissen aan de kust.",
                            "target_lang_translations": {
                                "en": "I caught a little <w>codling</w> while fishing on the coast.",
                                "zh": "我在海岸边钓鱼时钓到了一条<w>小鳕鱼</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a young cod up to a length of about sixty centimeters",
                        "zh": "体长约六十厘米以下的幼年鳕鱼"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "codling",
                                "target_lang_sense_clarification": "a small or young cod"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小鳕鱼",
                                "target_lang_sense_clarification": "指未成年的鳕鱼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b0da048-d011-3b81-b212-9a8cc0fe6995",
                    "sense_definition": "vorm van het werkwoord <w>gullen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gul</w> de vis terwijl ik op de boot sta te werken.",
                            "target_lang_translations": {
                                "en": "I <w>gut</w> the fish while I am working on the boat.",
                                "zh": "我在船上工作时会顺手把鱼的<w>内脏去掉</w>。"
                            }
                        },
                        {
                            "text": "<w>Gul</w> je de vangst direct nadat je de vissen uit het water haalt?",
                            "target_lang_translations": {
                                "en": "Do you <w>gut</w> the catch immediately after taking the fish out of the water?",
                                "zh": "你把鱼从水里捞出来后，会立刻<w>去内脏</w>吗？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "form of the verb 'gullen' (to gut fish)",
                        "zh": "动词“gullen”的变位，意为清理鱼的内脏"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "to remove the internal organs of a fish"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "去内脏",
                                "target_lang_sense_clarification": "指处理鱼类，去除内脏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}