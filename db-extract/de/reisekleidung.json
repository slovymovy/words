                "senses": [
                    {
                        "sense_id": "020f2834-5c47-3b7c-a028-415f9550bfd4",
                        "entry_id": "6ae96db0-cdfd-38f3-9da3-8ba0f953a112",
                        "glosses": [
                            "Zusammenstellung von Kleidungsstücken, die für eine bestimmte Reise benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d390d80a-64e6-4ce8-936b-823c57afcb97",
                                "sense_id": "020f2834-5c47-3b7c-a028-415f9550bfd4",
                                "text": "„So stellt man sich die perfekte Reisekleidung für Island vor.“"
                            },
                            {
                                "example_id": "5c25f55c-0d7c-4f8d-b893-fd3c10e0a349",
                                "sense_id": "020f2834-5c47-3b7c-a028-415f9550bfd4",
                                "text": "„Herein tritt ein Mann meines Alters, sehr gut gewachsen, in Reisekleidung und ein wenig schmächtig.“"
                            },
                            {
                                "example_id": "12dc5b73-3afa-406f-8d4d-50593f95c8f9",
                                "sense_id": "020f2834-5c47-3b7c-a028-415f9550bfd4",
                                "text": "„Der Großteil meiner Reisekleidung lagerte noch irgendwo bei Bens Eltern, das beschränkte meine Auswahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
