                "senses": [
                    {
                        "sense_id": "832d9065-4745-3e37-a184-4e6181cbd8b7",
                        "entry_id": "e9038089-9610-341a-8b7c-37c2cf1feae0",
                        "glosses": [
                            "Servante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb54e411-d90b-46eb-b86e-9472c3aa8e48",
                                "sense_id": "832d9065-4745-3e37-a184-4e6181cbd8b7",
                                "text": "Dans les réglements et statuts qu’elle fit pour ses religieuses, elle ne se qualifie que du nom du sœur Colette, petite et humble, ensuite, indigne serviteresse de Notre-Seigneur, pauvre et inutile religieuse de l’ordre de Sainte-Claire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44ac21fa-b3bd-449b-b581-59ec89bcd822",
                        "source_entry_id": "e9038089-9610-341a-8b7c-37c2cf1feae0",
                        "source_sense_id": "832d9065-4745-3e37-a184-4e6181cbd8b7",
                        "target_lang_word": "Dienerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dienerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                        "entry_id": "addaba31-885a-36c9-b794-c8a37695da70",
                                        "glosses": [
                                            "weibliche Person, die für jemanden bestimmte Pflichten erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5261afb2-8919-4b3b-b11d-f09e80a91a3c",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                                            },
                                            {
                                                "example_id": "23e0e027-b2f0-4402-9912-cae80d315623",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Dienerin brachte Simen Tjing eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "19c03b3c-f5c9-42f2-accf-3776148569b3",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            },
                                            {
                                                "example_id": "3cb7f09d-34c2-4e01-9463-ee038ab8cf68",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die alte Dienerin knickste, die Patronin legte den Deckel auf die Suppenschüssel und winkte leicht mit der Hand, der Patron, dessen Schnurrbart noch schwärzer als vordem glänzte, warf einen prüfenden Blick über Tisch und Gast, wobei er das Tischtuch andeutend zurechtzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab8b8248-9a99-39ce-aa85-f86c7522aa23",
                                        "entry_id": "addaba31-885a-36c9-b794-c8a37695da70",
                                        "glosses": [
                                            "weibliche Person, die sich von sich aus für jemanden oder etwas einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9910135b-5f9e-4df9-a7d8-9d2db846294a",
                        "source_entry_id": "e9038089-9610-341a-8b7c-37c2cf1feae0",
                        "source_sense_id": "832d9065-4745-3e37-a184-4e6181cbd8b7",
                        "target_lang_word": "servant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who is hired to perform regular household or other duties, and receives compensation. As opposed to a slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa167449-f294-4b8f-85c0-49b7f4e9ab53",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "There are three servants in the household, the butler and two maids."
                                            },
                                            {
                                                "example_id": "02fcd083-c8b4-4ab2-8e64-44bb20c92184",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "In the great houses, servants out of livery help to the different plats, servants in livery holding the dishes, sauces, etc., and changing the plates."
                                            },
                                            {
                                                "example_id": "b5fca4fb-e3e2-45c4-9973-42512bba6b44",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who serves another, providing help in some manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13abde63-d56e-4485-8524-42183901b6eb",
                                                "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                                "text": "She is quite the humble servant, the poor in this city owe much to her but she expects nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44bde33a-0c90-3c7a-957e-4119b5234ad1",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A person who dedicates themselves to God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2feac311-ed3b-3625-b817-a70128c46a45",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
