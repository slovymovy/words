                "forms": [],
                "senses": [
                    {
                        "sense_id": "81e06e34-93c2-3888-a820-c845bcc9c621",
                        "entry_id": "8b78edce-d420-3310-bad9-280f5b662868",
                        "glosses": [
                            "Région du nord-est de l’Allemagne, située aux confins de la Pologne (Silésie) et de la République tchèque (Bohême), à l’est de la Saxe et au sud du Brandebourg."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "6be25386-31f9-49a0-80b8-11515c92a6bf",
                                "sense_id": "81e06e34-93c2-3888-a820-c845bcc9c621",
                                "text": "Frido Mětšk écrit une page de l’histoire des relations culturelles entre Lusace et Lituanie, touchant le poème Gais yr’ tylējims (Die Rest ist Schweigen) de Georg Sauerwein (qui sorabisait son nom en Juro Surowin et le lituanisait en Girēnas), mis en musique par K. A. Kocor (ZslPh, XXX1, p. 300-315)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b35e9179-d6b6-4546-a807-eaf1b5d9b784",
                        "source_entry_id": "8b78edce-d420-3310-bad9-280f5b662868",
                        "source_sense_id": "81e06e34-93c2-3888-a820-c845bcc9c621",
                        "target_lang_word": "Lausitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lausitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                        "entry_id": "bc32f6ed-7ad4-331b-a930-1fb167cc7305",
                                        "glosses": [
                                            "Region in Sachsen und Brandenburg, im Osten Deutschlands, historisch auch Teile davon in Polen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf307637-3d4a-4fad-98e4-b412a36bba2c",
                                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                                "text": "Die Lausitz ist die Heimat der Sorben."
                                            },
                                            {
                                                "example_id": "87242445-953d-49ad-8b19-465e2796d06e",
                                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                                "text": "Beide Lausitzen teilten jahrhundertelang eine gemeinsame Geschichte."
                                            },
                                            {
                                                "example_id": "99960b26-3f69-4f42-a62a-1d22fcb60c1b",
                                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                                "text": "„Die Lausitz ist seit dem beschlossenen Kohleausstieg spätestens im Jahr 2038 in den Fokus der Öffentlichkeit geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
