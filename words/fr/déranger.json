                    "frequency": "High",
                    "semantic_group_id": "personne_gene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pardonnez-moi de vous <w>déranger</w> pendant votre pause déjeuner."
                        },
                        {
                            "text": "Veuillez ne pas <w>déranger</w> les élèves pendant l'examen de mathématiques."
                        }
