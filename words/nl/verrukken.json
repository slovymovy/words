{
    "word_family": [
        "verrukking",
        "verrukkelijk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25bc0786-13d7-3de6-ac57-6837f40745d0",
                    "sense_definition": "in grote blijdschap of vervoering brengen; buitengewoon bekoren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het prachtige concert wist het hele publiek diep te <w>verrukken</w>.",
                            "target_lang_translations": {
                                "en": "The magnificent concert managed to deeply <w>delight</w> the entire audience."
                            }
                        },
                        {
                            "text": "Haar zoete stem <w>verrukte</w> iedereen die in de zaal aanwezig was.",
                            "target_lang_translations": {
                                "en": "Her sweet voice <w>enchanted</w> everyone present in the hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekoren",
                        "betoveren",
                        "vervoeren"
                    ],
                    "antonyms": [
                        "ontgoochelen",
                        "teleurstellen"
                    ],
                    "common_phrases": [
                        "het publiek verrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring great joy, ecstasy, or delight; to charm intensely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delight",
                                "target_lang_sense_clarification": "to give great pleasure or joy to"
                            },
                            {
                                "target_lang_word": "enchant",
                                "target_lang_sense_clarification": "to charm or captivate deeply"
                            },
                            {
                                "target_lang_word": "rapture",
                                "target_lang_sense_clarification": "to fill with overwhelming emotion or ecstasy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa91a3b9-20bb-3c33-8b73-724d63d1c6b4",
                    "sense_definition": "van de ene naar de andere plaats verplaatsen of verschuiven",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude kronieken werd verteld hoe men de grensstenen stiekem probeerde te <w>verrukken</w>.",
                            "target_lang_translations": {
                                "en": "In the ancient chronicles, it was recounted how people secretly attempted to <w>shift</w> the boundary stones."
                            }
                        },
                        {
                            "text": "De werklieden <w>verrukten</w> het zware houten obstakel met behulp van hefbomen.",
                            "target_lang_translations": {
                                "en": "The workmen <w>displaced</w> the heavy wooden obstacle using levers."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplaatsen",
                        "verschuiven"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "niet meer gebruikelijk in hedendaags Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to move or shift from one place to another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "displace",
                                "target_lang_sense_clarification": "to move something from its proper or customary place"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to move or transfer physically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b3cbf8-40b3-3022-a319-0525bd955046",
                    "sense_definition": "wegnemen of wegleiden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wegnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rovers <w>verrukten</w> de kostbare schatten heimelijk uit het verlaten klooster.",
                            "target_lang_translations": {
                                "en": "The robbers stealthily <w>carried off</w> the precious treasures from the abandoned monastery."
                            }
                        },
                        {
                            "text": "Volgens de legende probeerde de vijand het heilige reliek te <w>verrukken</w>.",
                            "target_lang_translations": {
                                "en": "According to the legend, the enemy tried to <w>snatch away</w> the sacred relic."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontvoeren",
                        "wegnemen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to take away, abduct, or carry off"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snatch away",
                                "target_lang_sense_clarification": "to take or steal away"
                            },
                            {
                                "target_lang_word": "carry off",
                                "target_lang_sense_clarification": "to take away secretly or forcefully"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}