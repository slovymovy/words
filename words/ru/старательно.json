    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6917ac88-3de4-32fe-988d-922ecabdba8f",
                    "sense_definition": "С особым усердием, прилежанием и тщательностью.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик <w>старательно</w> переписывал сложный текст в тетрадь без единой ошибки.",
                            "target_lang_translations": {
                                "it": "L'alunno ricopiava <w>diligentemente</w> il testo difficile sul quaderno senza un solo errore."
                            }
                        },
                        {
                            "text": "Она <w>старательно</w> готовилась к вступительным экзаменам на протяжении всего года.",
                            "target_lang_translations": {
                                "it": "Si è preparata <w>con impegno</w> per gli esami di ammissione durante tutto l'anno."
                            }
                        }
                    ],
                    "synonyms": [
                        "прилежно",
                        "усидчиво",
                        "усердно"
                    ],
                    "antonyms": [
                        "небрежно",
                        "шаляй-валяй"
                    ],
                    "common_phrases": [
                        "старательно учиться",
                        "старательно скрывать",
                        "старательно избегать"
                    ],
                    "target_lang_definitions": {
                        "it": "Con particolare impegno, cura, diligenza e attenzione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "diligentemente",
                                "target_lang_sense_clarification": "con diligenza, assiduità e precisione"
                            },
                            {
                                "target_lang_word": "con impegno",
                                "target_lang_sense_clarification": "mettendoci sforzo e dedizione"
                            },
                            {
                                "target_lang_word": "con cura",
                                "target_lang_sense_clarification": "in modo accurato, meticoloso"
                            },
                            {
                                "target_lang_word": "zelantemente",
                                "target_lang_sense_clarification": "con zelo e fervore"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2699d872-fc60-36fd-8785-58a3911976f6",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>старательный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это молодое животное очень любопытно и крайне <w>старательно</w> в играх.",
                            "target_lang_translations": {
                                "it": "Questo giovane animale è molto curioso ed estremamente <w>scrupoloso</w> nei giochi."
                            }
                        },
                        {
                            "text": "Дитя было необычайно послушно и <w>старательно</w> во всём, что касалось учёбы.",
                            "target_lang_translations": {
                                "it": "Il bambino era straordinariamente ubbidiente e <w>diligente</w> in tutto ciò che riguardava lo studio."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma breve neutra singolare dell'aggettivo 'старательный' (diligente, premuroso, scrupoloso)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "diligente",
                                "target_lang_sense_clarification": "che si applica con attenzione e costanza"
                            },
                            {
                                "target_lang_word": "premuroso",
                                "target_lang_sense_clarification": "sollecito, accurato"
                            }
                        ]
                    }
                }
            ]
        }
    ]
