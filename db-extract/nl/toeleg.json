                                "target_senses": [
                                    {
                                        "sense_id": "bfe00aa4-2069-3a72-8a41-620caff3982d",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "The denotation, referent, or idea connected with a word, expression, or symbol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bac232-3773-4072-9905-5f443ecd7898",
                                                "sense_id": "bfe00aa4-2069-3a72-8a41-620caff3982d",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea43bc7-b82c-3aaf-b624-f6127631c984",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "The connotation associated with a word, expression, or symbol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "The purpose, value, or significance (of something) beyond the fact of that thing's existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff8a4a0-86b3-4292-b29d-8a862ac5d024",
                                                "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                                "text": "the meaning of life"
                                            },
                                            {
                                                "example_id": "2774dce5-d339-4ea8-83a5-ee6293818ca4",
                                                "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                                "text": "The number of persons attending the vigil had a lot of meaning to the families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "Intention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "487d5859-9d00-424e-b951-83ce0cb0eb63",
                                                "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                                "text": "It was their meaning to take what they needed by strong hand."
                                            },
                                            {
                                                "example_id": "bd47323b-8fa6-43bb-ba80-ae8e5e978733",
                                                "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                                "text": "[…] there was nothing in the house, what there was, was broken, the last people must have lived like pigs, what could the meaning of the landlord be?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meaning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59677821-06be-3e7c-812a-6e9af940f615",
                                        "entry_id": "ad67e982-82aa-30b3-a4e3-aaf101ab76ca",
                                        "glosses": [
                                            "present participle and gerund of mean"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "200c1476-c4e2-4703-88c6-50646afa7693",
                                                "sense_id": "59677821-06be-3e7c-812a-6e9af940f615",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meaning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d67a0d37-b9e9-3985-b971-7fdaff765210",
                                        "entry_id": "283da895-b3da-3860-a3ff-e5f59f0cb766",
                                        "glosses": [
                                            "Having a (specified) intention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e509b976-c842-40a7-871b-1517944bbe54",
                                                "sense_id": "d67a0d37-b9e9-3985-b971-7fdaff765210",
                                                "text": "Well/ill meaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b01ba2-22c9-394d-8834-fc5152eae82d",
                                        "entry_id": "283da895-b3da-3860-a3ff-e5f59f0cb766",
                                        "glosses": [
                                            "Expressing some intention or significance; meaningful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe480e9-3087-422a-a8c2-234b5c577c61",
                                                "sense_id": "e1b01ba2-22c9-394d-8834-fc5152eae82d",
                                                "text": "I might, to-day, have been a better, and thus a happier man, had I less frequently rejected the counsels embodied in those meaning whispers which I then but too cordially hated and too bitterly despised."
                                            },
                                            {
                                                "example_id": "6c928064-f87b-412f-8994-c039b8cf4cef",
                                                "sense_id": "e1b01ba2-22c9-394d-8834-fc5152eae82d",
                                                "text": "There was a meaning pause, broken by old Stein again clapping his hands."
                                            },
                                            {
                                                "example_id": "6ba4cf98-048d-40e6-bdaf-2e5b8ae689a8",
                                                "sense_id": "e1b01ba2-22c9-394d-8834-fc5152eae82d",
                                                "text": "[T]he new friends […] knew nothing and did not particularly care to hear about the beautiful mother with her long, meaning looks and liquid dresses and distant smile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff46e335-7667-4ce9-9bc7-4a813d5bea30",
                        "source_entry_id": "66e39f05-e767-320b-aadb-8a198d384241",
