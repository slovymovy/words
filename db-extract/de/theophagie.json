                "senses": [
                    {
                        "sense_id": "b3f29df8-4e00-3f14-9d19-93970a171bc7",
                        "entry_id": "21096bfb-941a-3f84-ac06-fbe0458de239",
                        "glosses": [
                            "das Verspeisen einer Gottheit"
                        ],
                        "tags": [
                            "Religionswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "2b15ad97-2e0e-4960-aa13-d371d72ea5a4",
                                "sense_id": "b3f29df8-4e00-3f14-9d19-93970a171bc7",
                                "text": "„Man versteht es als Einladung zu kultischer Anthropophagie (Verzehren eines Menschen), wenn nicht gleich zur Theophagie (Verzehren einer Gottheit).“"
                            },
                            {
                                "example_id": "8b92e60a-e74c-4b88-86f9-7f19a0a18dd4",
                                "sense_id": "b3f29df8-4e00-3f14-9d19-93970a171bc7",
                                "text": "„Für die Frage nach dem religionsgeschichtlichen Hintergrund des Herrenmahls ist es bedeutsam, dass im Kult des Dionysos sowohl Weinassoziationen als auch die Vorstellung einer blutigen Theophagie eine Rolle spielen.“"
                            },
                            {
                                "example_id": "c8f402a9-f2bf-4038-98e9-29897c934eed",
                                "sense_id": "b3f29df8-4e00-3f14-9d19-93970a171bc7",
                                "text": "„Höchstform der Hochsprache ist im Unendlichen Theophagie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
