                "senses": [
                    {
                        "sense_id": "9f6abde9-f46a-325a-b991-6d4f3f1e0f03",
                        "entry_id": "4e150de8-d407-38cb-abae-3fba40bfb72f",
                        "glosses": [
                            "Donner un caractère d’objet à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "469f38fe-749b-4d32-86fc-8d23121fab23",
                                "sense_id": "9f6abde9-f46a-325a-b991-6d4f3f1e0f03",
                                "text": "Le travail de l’école est de désincorporer l’objet, de l’objectaliser, de poser l’objet dans son extériorité pour qu’on puisse en parler et exercer sur l’objet un regard critique, discuter sur cet objet."
                            },
                            {
                                "example_id": "ade0afd7-4285-40e7-8f8e-3ff337eb088d",
                                "sense_id": "9f6abde9-f46a-325a-b991-6d4f3f1e0f03",
                                "text": "De ce fait, pour beaucoup de futures mères, celui-ci commence ainsi à s’objectaliser dans leur psyché."
                            }
                        ]
                    }
                ],
