                                    {
                                        "sense_id": "2f5518b0-178e-31dd-956a-9b6498b5d6a5",
                                        "entry_id": "4dcdd5b1-73fd-3f08-9a48-18004efffb43",
                                        "glosses": [
                                            "Loyal; adhering firmly to person or cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c42e9e-b5b0-49a1-9fa5-e63c026202a7",
                                                "sense_id": "2f5518b0-178e-31dd-956a-9b6498b5d6a5",
                                                "text": "My dog is very faithful: he doesn't like to be petted by anybody else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c16338f-0be5-3da8-b9cb-e05af2422e93",
                                        "entry_id": "4dcdd5b1-73fd-3f08-9a48-18004efffb43",
                                        "glosses": [
                                            "Having faith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389cae80-6b72-45fc-aad3-ae55641a840b",
                                                "sense_id": "2c16338f-0be5-3da8-b9cb-e05af2422e93",
                                                "text": "The application of the old discipline, say the conservatives, would probably produce a smaller but more faithful Church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96f3521-bfc2-398b-a991-10af47a56a9b",
                                        "entry_id": "4dcdd5b1-73fd-3f08-9a48-18004efffb43",
                                        "glosses": [
                                            "Reliable; worthy of trust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cb0371-6c49-4c8b-af16-086116dbde28",
                                                "sense_id": "c96f3521-bfc2-398b-a991-10af47a56a9b",
                                                "text": "My servant is very faithful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a19da7-3ae2-34c9-b3b8-bd3ad1a59ee7",
                                        "entry_id": "4dcdd5b1-73fd-3f08-9a48-18004efffb43",
                                        "glosses": [
                                            "Consistent with reality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f5bde7-d1d5-429f-ab62-95fa200f18b0",
                                                "sense_id": "12a19da7-3ae2-34c9-b3b8-bd3ad1a59ee7",
                                                "text": "I would consider that a very faithful reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "735fafbe-9845-3946-b700-5fb76435f67c",
                                        "entry_id": "4dcdd5b1-73fd-3f08-9a48-18004efffb43",
                                        "glosses": [
                                            "Engaging in sexual relations only with one's spouse or long-term sexual partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61bb1594-4409-4074-a31c-49a774631d07",
                                                "sense_id": "735fafbe-9845-3946-b700-5fb76435f67c",
                                                "text": "They had been faithful to each other all of their married life."
                                            },
                                            {
                                                "example_id": "18975472-b7d5-4d9c-8ed3-35b14e0e1474",
                                                "sense_id": "735fafbe-9845-3946-b700-5fb76435f67c",
                                                "text": "She wanted to be free to explore casual affairs, but her man had to be faithful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a97e77c-91e4-35ca-9a80-6126262ed24c",
