                ],
                "senses": [
                    {
                        "sense_id": "e1f368cb-f554-3d90-968a-cf7cd37a77dc",
                        "entry_id": "8d2e2128-9e29-3e16-8be5-18df6c15d240",
                        "glosses": [
                            "astrakhan"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca2cf50-8501-47fc-8009-7aae7a914abc",
                                "sense_id": "e1f368cb-f554-3d90-968a-cf7cd37a77dc",
                                "text": "Лю́ди ро́ты бы́ли оде́ты в чёрные мунди́ры ру́сского образца́ с кра́сными пого́нами, в чёрные же шарова́ры с кра́сным ка́нтом и высо́кие сапоги́. Головны́м убо́ром служи́ла чёрная мерлу́шковая ша́пка, та́кже отча́сти ру́сского пехо́тного образца́."
                            }
                        ]
                    }
                ],
