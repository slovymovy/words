                ],
                "senses": [
                    {
                        "sense_id": "401e0e4b-b0c7-33d5-b644-c2443d439d3c",
                        "entry_id": "eb87b311-4c34-3aa0-b37f-ce9946c084e7",
                        "glosses": [
                            "Inhaberschuldverschreibung (Anleihe, Bond) mit den Staaten Europas als (gemeinschaftlichem) gesamtschuldnerischen Herausgeber"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "fac78130-d419-4a68-85fc-5c3d6d1949e2",
                                "sense_id": "401e0e4b-b0c7-33d5-b644-c2443d439d3c",
                                "text": "„Beim Eurobond haften alle Mitgliedstaaten der europäischen Währungsunion gemeinsam für den Kredit, den der einzelne Staat aufnimmt. Der Name Eurobond ist daher irreführend. Er suggeriert, dass es sich um Anleihen in Euro handelt, während tatsächlich die Gruppenhaftung aller Staaten für Staatsschulden der Eurozone eingeführt werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "335525a8-2a72-3e8d-a0f5-bb6ddb96c38a",
                        "entry_id": "eb87b311-4c34-3aa0-b37f-ce9946c084e7",
                        "glosses": [
                            "in Europa auf den Markt gebrachte und dort gehandelte Anleihe mit einer anderen Währung als Euro"
                        ],
                        "tags": [
                            "Börse"
                        ],
                        "examples": [
                            {
                                "example_id": "0b9902b9-bae5-4eb8-b54b-b33fb0e6eca3",
                                "sense_id": "335525a8-2a72-3e8d-a0f5-bb6ddb96c38a",
                                "text": "„Betrachtet man das Volumen aller ausstehenden Eurobonds, so nahmen 1998 DEM-Eurobonds den zweiten Platz direkt hinter USD-Eurobonds ein.“"
                            },
                            {
                                "example_id": "de7a5670-6c2c-4c88-b60b-7133e50846b5",
                                "sense_id": "335525a8-2a72-3e8d-a0f5-bb6ddb96c38a",
                                "text": "„Eine Dollar-denominierte Anleihe, die von einem US-Unternehmen in Europa verkauft wird, ist ein Eurobond.“"
                            },
                            {
                                "example_id": "df56560a-4c26-4aca-ac35-ffe6cd008627",
                                "sense_id": "335525a8-2a72-3e8d-a0f5-bb6ddb96c38a",
                                "text": "„Kommt es letztlich doch zu einer einheitlichen Zinsbesteuerung in Euroland, dürfen Anleger bestenfalls auf eine Ausnahmeregelung für Eurobonds hoffen, also für Anleihen des Schuldners außerhalb des EU-Raumes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a7cde737-e811-38e7-8543-ed56c88b0ea9",
                        "entry_id": "eb87b311-4c34-3aa0-b37f-ce9946c084e7",
                        "glosses": [
                            "in der Währung Euro denominierte Anleihe"
                        ],
                        "tags": [
                            "Börse",
                            "ab 1999 mögliche"
                        ],
                        "examples": [
                            {
                                "example_id": "0090c0bd-0500-47ea-ba55-495a0b67a7e1",
                                "sense_id": "a7cde737-e811-38e7-8543-ed56c88b0ea9",
                                "text": "1999 wurden alle ECU-Bonds in Eurobonds umgestellt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
