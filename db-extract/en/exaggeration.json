                        "entry_id": "fc5dc73e-542e-3e90-84d6-bbfbafad4465",
                        "glosses": [
                            "The act of exaggerating; the act of doing or representing in an excessive manner; a going beyond the bounds of truth, reason, or justice; a hyperbolical representation; hyperbole; overstatement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7a3c8582-1383-4d2c-8de0-893fa75393aa",
                                "sense_id": "dc4b7404-5672-3a94-95f0-4e4551c88636",
                                "text": "They say he's a millionnaire, but that's a massive exaggeration."
                            }
                        ]
                    },
                    {
                        "sense_id": "57b5989e-ed0e-3bf1-8a02-9e60d9c74065",
                        "entry_id": "fc5dc73e-542e-3e90-84d6-bbfbafad4465",
                        "glosses": [
                            "A representation of things beyond natural life, in expression, beauty, power, vigor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
