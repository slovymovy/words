                    "frequency": "Middle",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine a décidé d'<w>ancrer</w> le navire près de la côte avant la tombée de la nuit."
                        },
                        {
                            "text": "Ils trouvèrent un endroit calme et y <w>ancrèrent</w> leur voilier pour passer la nuit."
                        }
                    ],
                    "synonyms": [
