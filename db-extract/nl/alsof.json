                        "target_lang_word": "come se",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "21713aeb-907a-4338-920f-f8ac10149fa1",
                        "source_entry_id": "b7c23626-db51-3c8f-a319-82d7e9d24759",
                        "source_sense_id": "4d8ad239-47b9-36b8-9fb8-ad1b61d6f3a0",
                        "source_sense_description": "luidt een vergelijking in",
                        "target_lang_word": "jakby",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jakby",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b09c9a2-30ce-3d1a-9e96-8d9c655e5df3",
                                        "entry_id": "8bc17ebf-1590-373a-aa2f-b3b3ed66a5d5",
                                        "glosses": [
                                            "…oznaczająca, że wyrażony w zdaniu pogląd może nie jest prawdziwy, ale jest bliski prawdy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98252f60-c4f5-4e82-aec9-51b4561169c5",
                                                "sense_id": "7b09c9a2-30ce-3d1a-9e96-8d9c655e5df3",
                                                "text": "– Okłamałeś go? – No… tak jakby."
                                            },
                                            {
                                                "example_id": "245ed9de-931d-4e70-a8e1-3d6fda502511",
                                                "sense_id": "7b09c9a2-30ce-3d1a-9e96-8d9c655e5df3",
                                                "text": "Na koniec, jakby ślepym chciał uderzyć ciosem, / Zasłonił oczy ręką i rzekł mocnym głosem: / „Jam jest Jacek Soplica…”"
                                            },
                                            {
                                                "example_id": "c3294fc5-9b3d-46de-9c0b-824f9ac4894f",
                                                "sense_id": "7b09c9a2-30ce-3d1a-9e96-8d9c655e5df3",
                                                "text": "Czytając tę książkę, doznałem jakby olśnienia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "jakby",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "5241c0f5-71a1-3d2a-9025-4bab2ab8c486",
                                        "entry_id": "5a6f104c-1e83-3da8-b598-a7f4080f3fd2",
                                        "glosses": [
                                            "…określający sytuację, która mogłaby mieć miejsce, biorąc pod uwagę resztę wypowiedzi, ale tak naprawdę jest nieprawdziwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d6cd8a-ff00-490f-b817-e96d3c135140",
                                                "sense_id": "5241c0f5-71a1-3d2a-9025-4bab2ab8c486",
                                                "text": "Oczy miał podkrążone, jakby całą noc nie spał."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "c8916fcc-644a-3dc7-8c6b-75d8b6bb92cb",
                                        "entry_id": "5a6f104c-1e83-3da8-b598-a7f4080f3fd2",
                                        "glosses": [
                                            "oznaczający, że warunek występujący w zdaniu podrzędnym może się spełnić"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75e2b72-0e5b-4592-a477-755c6af75cc7",
                                                "sense_id": "c8916fcc-644a-3dc7-8c6b-75d8b6bb92cb",
                                                "text": "Byłoby bardzo miło, jakby oddzwonił."
                                            },
                                            {
                                                "example_id": "e7ef39e6-921b-4b10-9a22-7ed5abd3868f",
                                                "sense_id": "c8916fcc-644a-3dc7-8c6b-75d8b6bb92cb",
                                                "text": "Daj znać, jakbyś znalazł tę płytę."
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    },
                                    {
                                        "sense_id": "610be9a6-20e9-3285-a1ec-7af37ff9ed30",
