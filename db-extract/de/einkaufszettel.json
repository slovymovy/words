                                        "glosses": [
                                            "A list, written on e.g. a piece of paper, of items that need to be bought."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40d1d161-1044-3b09-84aa-96f3d8892a91",
                                        "entry_id": "b8f9c434-01d7-3745-ad68-3c0adc2b1a61",
                                        "glosses": [
                                            "A list of related items; especially, a list of desired items."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db61a9cb-2937-4013-9cd8-108e9f3ce4eb",
                                                "sense_id": "40d1d161-1044-3b09-84aa-96f3d8892a91",
                                                "text": "This is no place for shopping list of my likes/dislikes/accomplishments, but if you're really special, & unattached, let's meet."
                                            },
                                            {
                                                "example_id": "383ecfca-93e3-43c3-8432-357a6e5d6321",
                                                "sense_id": "40d1d161-1044-3b09-84aa-96f3d8892a91",
                                                "text": "WMRE [West Midlands Rail Executive] would also go further, with other lines on its shopping list for upgrade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99da9e6a-2a40-467d-8f5e-5492b098c143",
                        "source_entry_id": "5c745f06-b588-37c2-90a7-a6ede78d04b2",
                        "source_sense_id": "7e81285e-a2c2-3209-a733-773a0473ef5d",
