                    {
                        "sense_id": "6695dd5e-1919-364b-9538-d585037cc9e0",
                        "entry_id": "bbcaf5d7-3a39-361f-953e-ef6894cbe9e6",
                        "glosses": [
                            "Bahn(e)n aus Bast zum Abdecken von Öffnungen in einem Innenraum oder zum Abteilen von Raumbereichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8cb1e21-3a53-4db8-baf2-019aa92edae3",
                                "sense_id": "6695dd5e-1919-364b-9538-d585037cc9e0",
                                "text": "„Dann verschwand ich wieder hinter dem Bastvorhang in den Vorratsraum, wo ich auf dem Boden meine Barbies zum Schlafen nebeneinandergelegt hatte.“"
                            },
                            {
                                "example_id": "cd98698f-91e5-4d50-a0bc-ca774f3a0f2b",
                                "sense_id": "6695dd5e-1919-364b-9538-d585037cc9e0",
                                "text": "„Für die meisten der Fotografien, die folgen, hat ein Bastvorhang die Hohlkehle des Fotostudios simuliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
