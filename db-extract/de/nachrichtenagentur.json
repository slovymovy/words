                "senses": [
                    {
                        "sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                        "entry_id": "853769ae-1c2c-3a7e-8e87-5e557e6a593d",
                        "glosses": [
                            "Unternehmen, das Informationen über aktuelle Ereignisse für Massenmedien sammelt und aufbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02652a67-8f21-4440-b890-35961f455e66",
                                "sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                                "text": "„Rettungsmannschaften versuchten, im Meer treibende Menschen zu bergen, sagte ein örtlicher Polizeivertreter der Nachrichtenagentur AFP.“"
                            },
                            {
                                "example_id": "6b701b65-0993-4eed-80ae-c4a3bd96b86c",
                                "sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                                "text": "„Siemens plant einem Medienbericht zufolge den Abbau von 11.600 Stellen. Dies habe Konzernchef Joe Kaeser in einer Webcast-Konferenz am Mittwoch gesagt, meldete die Nachrichtenagentur Bloomberg am Freitag.\""
                            },
                            {
                                "example_id": "9f7e3f47-236f-4b1b-910c-bb1c67b62f0f",
                                "sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                                "text": "„Ein Jahr später wurde die neue Rechtschreibung auch vom Großteil der Zeitungen und Zeitschriften und den Nachrichtenagenturen übernommen.“"
                            },
                            {
                                "example_id": "845414a1-4d56-49de-b733-45788f9b9b68",
                                "sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                                "text": "„Seine Karriere begann er noch während des Studiums bei einer Berliner Nachrichtenagentur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
