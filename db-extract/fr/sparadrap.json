                                    {
                                        "sense_id": "c4174859-1cd7-3a45-820a-fd87dd757125",
                                        "entry_id": "6cabd5c2-3c90-35d7-8959-c5820ebc0177",
                                        "glosses": [
                                            "Cloth coated with wax so that it is waterproof, used for covering the dead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "019153e8-bff9-4ec9-ae39-1afedd6d2b65",
                                                "sense_id": "c4174859-1cd7-3a45-820a-fd87dd757125",
                                                "text": "’Twere damnation\nTo think so base a thought; it were too gross\nTo rib her cerecloth in the obscure grave."
                                            }
