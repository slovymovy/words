                        ]
                    },
                    {
                        "translation_id": "fdc57fa3-9388-49aa-8192-2178ffe7ff4e",
                        "source_entry_id": "7a033494-a9b4-38bc-afad-feffa105c083",
                        "source_sense_id": "76a59763-fc34-3053-8484-8750b7750c87",
                        "target_lang_word": "victual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "victual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                        "entry_id": "bfe3edd7-bf27-3dd0-ba81-50bb1d265fb9",
                                        "glosses": [
                                            "Food fit for human (or occasionally animal) consumption."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d21a5c-116e-491b-8675-730ee51c04df",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "Shift bore (for il aire) as best ye do thinke, / and twise a day giue him fresh vittle and drinke: […]"
                                            },
                                            {
                                                "example_id": "dc407644-050c-47b3-a8c4-1fb54c93a42f",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "[T]hough the Cameleon Loue can feed on the ayre, I am one that am nouriſh'd by my victuals; and would faine have meate: [...]"
                                            },
                                            {
                                                "example_id": "23f39def-4ab6-46f0-8063-fac42b4a8afb",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "[T]he Making of Things Inalimentall, to become Alimentall, may be an Experiment of great Profit, for Making new Victuall."
                                            },
                                            {
                                                "example_id": "88abded4-6017-4bd1-9137-1d93e0603cf9",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "For as the Teeth in Beasts of Prey / Are Swords, with which they fight in Fray. / So Swords in Men of War, are Teeth, / Which they do eat their Vittle with."
                                            },
                                            {
                                                "example_id": "09c94e08-2387-44a8-a718-04746c7b22cd",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "Friday told me, ſuch a Boat would do very well, and would carry much enough Vittle, Drink, Bread, that was his Way of Talking."
                                            },
                                            {
                                                "example_id": "5d8d51d0-0d90-4d3f-8d69-3215bd14f478",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "I must confess your wine and vittle / I was too hard upon a little: / Your table neat, your linen fine; / And though in miniature, you shine: […]"
                                            },
                                            {
                                                "example_id": "aa7bb469-ed2e-45aa-b259-5670cd5924f6",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "He [Samuel Keimer] was usually a great glutton, and I promised myself some diversion in half starving him. He agreed to try the practice, if I would keep him company. I did so, and we held it for three months. We had our victuals dress'd, and brought to us regularly by a woman in the neighborhood, who had from me a list of forty dishes, to be prepar'd for us at different times, in all which there was neither fish, flesh, nor fowl, and the whim suited me the better at this time from the cheapness of it, not costing us above eighteen pence sterling each per week."
                                            },
                                            {
                                                "example_id": "e01a03c0-481a-4813-bfe9-235bb822f640",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "Robin promis'd me / A' my winter vittle; / Fient haet he had but three / Goos feathers and whittle."
                                            },
                                            {
                                                "example_id": "50c11ec0-ac50-4035-8866-18bd08cf6f7f",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "Man is not what one calls a happy animal; his appetite for sweet victual is so enormous."
                                            },
                                            {
                                                "example_id": "979056ed-8130-43b8-964b-f66183c0bd48",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "[D]inner was announced by Bailey junior in these terms: \"The wittles is up!\""
                                            },
                                            {
                                                "example_id": "d16fb541-4c8e-4850-ab70-8c9cfa83a025",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "And down a rocky pathway from the place / There came a fair-hair'd youth, that in his hand / Bare victual for the mowers: […]"
                                            },
                                            {
                                                "example_id": "19d401e3-747a-405f-8a0e-dc5933f87e93",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "[H]is motto was, \"Meat first, and spoon vittles to top off on.\""
                                            },
                                            {
                                                "example_id": "01939b17-db42-4ad9-975b-5ed7a17f1177",
                                                "sense_id": "b3370553-d425-3230-b31a-31b58d861914",
                                                "text": "'Terence, this is stupid stuff: / You eat your victuals fast enough; / There can't be much amiss, 't is clear, / To see the rate you drink your beer.[']"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c502c8-15cc-3458-af9e-32114e91065b",
                                        "entry_id": "bfe3edd7-bf27-3dd0-ba81-50bb1d265fb9",
                                        "glosses": [
                                            "Food supplies; provisions."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "540fccf1-9139-47b1-a3ca-e6f777bf4d21",
                                                "sense_id": "d0c502c8-15cc-3458-af9e-32114e91065b",
                                                "text": "It is good to make prouiſion, for peraduenture wee ſhall lacke victuals and wee lie in campe on Blacke Heath long."
                                            },
                                            {
                                                "example_id": "8dad48b0-64cc-4c5a-9264-aa347e33b433",
                                                "sense_id": "d0c502c8-15cc-3458-af9e-32114e91065b",
                                                "text": "The citie was thus taken, many of the Turks fled into the caſtell, the reſt were put vnto the ſword, man, woman, and child; and amongſt them alſo many of the Chriſtians, the furious ſouldiers taking of them no knowledge. Great wealth was there found, but ſmall ſtore of victuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1ee0ef-ed4b-3951-91ae-ed3b425ac9c0",
                                        "entry_id": "bfe3edd7-bf27-3dd0-ba81-50bb1d265fb9",
                                        "glosses": [
                                            "Edible plants."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1b51c6-63c0-436f-8bd9-6dfcd1d4f1cb",
                                                "sense_id": "fc1ee0ef-ed4b-3951-91ae-ed3b425ac9c0",
                                                "text": "[C]onſider, what Victuall or Eſculent Things there are, which grow ſpeedily, and within the yeere, As Parſnips, Carrets, Turnips, Onions, Radiſh, Artichokes of Hieruſalem, Maiz, and the like. […] The Victuall in Plantations, ought to be expanded, almoſt as in a Beſieged Towne; That is, with certaine Allowance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061eda6a-04aa-3b17-aadd-d84fd4378cab",
                                        "entry_id": "bfe3edd7-bf27-3dd0-ba81-50bb1d265fb9",
                                        "glosses": [
                                            "Grain of any kind."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3def064c-f498-41ed-ba57-5e65833b46bc",
                                                "sense_id": "061eda6a-04aa-3b17-aadd-d84fd4378cab",
                                                "text": "But if the beast and branks be spar'd / Till kye be gaun without the herd, / An' a' the vittel in the yard, / An' theckit right, / I mean your ingle-side to guard / Ae winter night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "victual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                        "entry_id": "00edd829-c6a8-39d6-ac94-382a1360faaf",
                                        "glosses": [
                                            "To provide (military troops, a place, a ship, etc., or oneself) with a stock of victuals or food; to provision."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f554a1-7f07-496c-a3cb-a25f95241f47",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "[T]hy louing voyage / Is but for two moneths victuall’d: […]"
                                            },
                                            {
                                                "example_id": "e1cf3062-449c-4283-8c53-28fe2568543e",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "Spinola [Ambrogio Spinola, 1st Marquess of Los Balbases] continueth in his trenches before Breda, and victualeth and strengtheneth Breda, which being done, it is thought he will besiege Bergen op Zoom."
                                            },
                                            {
                                                "example_id": "414c7cee-007b-4d01-a920-6772df0acbcb",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "He victualleth his soldiers during the time they are upon the guard, either about the palace or abroad in the wars: whereas it is contrary in the King's country; for the Cingalese soldiers bear their own expenses."
                                            },
                                            {
                                                "example_id": "0d543789-7aca-43dc-bd08-ea6701a1fd5c",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "I could here ſet down the very number of Acres that would bear Bread and Drink, Corn, together with Fleſh, Butter, and Cheeſe, ſufficient to Victual nine Millions of Perſons, as they are Victualled in Ships and regular Families; but I ſhall only ſay in general that 12,000,00. will do it, […]"
                                            },
                                            {
                                                "example_id": "affcccf7-12c7-4fc6-8d51-e17e56b0e85d",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "It was then, among other proof to the ſame purpoſe, given in evidence by a Virginia merchant, that in March, 1763, he had victualled his ſhips for twenty-four or twenty-five ſhillings the hundred weight of beef, which he conſidered as the ordinary price; […]"
                                            },
                                            {
                                                "example_id": "022c48f6-bb77-4594-a714-33894b372678",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "These veterans were commissioned to defend the place to the last extremity; and, as due time had been given for preparation, the town was victualled for fifteen months' provisions, and even the crops growing in the vega had been garnered before their prime, to save them from the hands of the enemy."
                                            },
                                            {
                                                "example_id": "89f91690-dd33-4d6a-bbdb-68d3a4fda8ec",
                                                "sense_id": "052ab3cb-947b-321d-844d-b4f4c4d7c5f8",
                                                "text": "In 1512 an agreement was made between him [Henry VIII] and his admiral, Sir Edward Howard, which affords an interesting view of the manner in which fleets of war were then maintained. […] It was also stipulated that, \"forasmuch as our Sovereign lord at his costs and charges victualeth the said army and navy, the said admiral shall therefore reserve for the king the one-half of all gains and winnings of the war,[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e745fb-4b12-361e-b1a7-fe09f30cb022",
                                        "entry_id": "00edd829-c6a8-39d6-ac94-382a1360faaf",
                                        "glosses": [
                                            "To lay in or procure food supplies."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e47f57f5-37cf-4ebf-817c-5b449ab08890",
                                                "sense_id": "b6e745fb-4b12-361e-b1a7-fe09f30cb022",
                                                "text": "[Letter from Sir William Drury to Sir William Cecil, 3d April 1568 (Julian calendar).] The Lord Fleming [i.e., John Fleming, 5th Lord Fleming], notwithstanding he still victualleth and maketh provision, he hath offered three personages of as great livehood as himself to enter caution and surety unto the [James Stewart, 1st] Earl of Moray, that he shall only hold the place at the devotion and service of the young King, and to no other."
                                            },
                                            {
                                                "example_id": "0b92333d-b5a5-494f-94a2-8a394decf348",
                                                "sense_id": "b6e745fb-4b12-361e-b1a7-fe09f30cb022",
                                                "text": "For though we took a little Flower hard by, yet the ſame Guide which told us of that Ship would have conducted us where we might had ſtore of Beef and Maiz: but inſtead thereof we lost both our time and the opportunity of providing our ſelves, and ſo were forced to be victualling when we ſhould have been cruizing off Cape Corrientes in expectation of the Manila Ship."
                                            },
                                            {
                                                "example_id": "c78e91d9-8bac-4863-8431-ea3c0308ba0a",
                                                "sense_id": "b6e745fb-4b12-361e-b1a7-fe09f30cb022",
                                                "text": "A letter from Lt.-Gen. [John] Burgoyne to Maj.-Gen. [William] Heath, Jan. 24. 1778. […] [T]he fleet was fully victualled for four months, for the whole of the land-army and ſeamen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611dff64-5839-3847-9eae-aa3b311472d9",
                                        "entry_id": "00edd829-c6a8-39d6-ac94-382a1360faaf",
                                        "glosses": [
                                            "To eat."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d140b0c-135a-4cab-b071-b85adf13480e",
                                                "sense_id": "611dff64-5839-3847-9eae-aa3b311472d9",
                                                "text": "I have Drank and Victual’d at Sir Humphrey’s for a Months Famine I am to endure here—I am hung round with Bottles and ſtuft full of Proviſion; will you eat a Pullet?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8337591a-faed-4533-8bf8-2fbc0a3c94d9",
                        "source_entry_id": "7a033494-a9b4-38bc-afad-feffa105c083",
                        "source_sense_id": "76a59763-fc34-3053-8484-8750b7750c87",
                        "target_lang_word": "Proviant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proviant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                        "entry_id": "b33eb035-52ce-31b6-ad3f-3560075161c5",
                                        "glosses": [
                                            "mitgeführter Nahrungsvorrat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b0cb34-7603-4e4b-984c-48fd97527487",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Wir verheimlichten so gut wie möglich, daß wir Gold und Perlen hatten, und verkauften deshalb drei, vier Ballen Chinaseide und indischen Kaliko, um das nötige Geld zu haben, Kamele zu erwerben, den Zoll zu bezahlen, der an mehreren Stellen erhoben wurde, und uns für die Wüste mit Proviant auszurüsten.“"
                                            },
                                            {
                                                "example_id": "724cd24c-ab9e-456c-ba38-578c84736088",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Wir hielten irgendwo auf dem Feld an, packten unseren Proviant aus und ließen den kleinen Banditen nach Belieben sich den Bauch vollschlagen.“"
                                            },
                                            {
                                                "example_id": "aad2b2fd-1bc7-49fe-8fbe-2f18375f87e4",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Proviant für zwei Monate lagert unter Deck, neben 174 Kanonen und 82000 Kanonenkugeln.“"
                                            },
                                            {
                                                "example_id": "3d591bec-bfd1-495b-8925-5bfe41a7090f",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Diese Gesellschaft betrieb nicht nur den Kanal, sondern auch die Geschäfte, in denen Proviant zum Selbstkostenpreis gekauft werden konnte.“"
                                            },
                                            {
                                                "example_id": "2f786441-b650-4c12-a1bd-6fa464921123",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Eigentlich war Reinhold Messner allein zur finalen Etappe in die Todeszone aufgebrochen, ohne Seil, ohne Zelt, ohne Proviant; er wollte zum Gipfel und so schnell wie möglich wieder zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6afd6bbf-90c0-4434-a99b-bd4b0b08a1e0",
                        "source_entry_id": "7a033494-a9b4-38bc-afad-feffa105c083",
