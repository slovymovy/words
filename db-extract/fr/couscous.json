                    {
                        "translation_id": "7f038d72-d96a-4163-8b75-813d3476e106",
                        "source_entry_id": "49dbebd0-24ad-39b8-bada-a783e5f92c5b",
                        "source_sense_description": "Plat à base de semoule",
