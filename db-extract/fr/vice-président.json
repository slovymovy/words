                    },
                    {
                        "form_id": "59a91a9c-f68b-4464-bf58-fe4433eff4e0",
                        "entry_id": "311c5979-df4d-399c-b4f3-4832feab8cf2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "vice-présidente"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee25703a-42b4-344f-a5e3-39d8e3605b21",
                        "entry_id": "311c5979-df4d-399c-b4f3-4832feab8cf2",
                        "glosses": [
                            "Celui qui exerce la fonction du président (ou de la présidente) en son absence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cff1384-d71c-4341-a1b6-b16ebc889db8",
                                "sense_id": "ee25703a-42b4-344f-a5e3-39d8e3605b21",
                                "text": "On jouait beaucoup alors à la royauté, comme on joue aujourd’hui à la Chambre en créant une foule de sociétés à présidents, vice-présidents et secrétaires : Société linière, vinicole, séricicole, agricole, de l’industrie, etc."
                            },
                            {
                                "example_id": "3821eb9e-af1a-491a-9053-622362fb3aeb",
                                "sense_id": "ee25703a-42b4-344f-a5e3-39d8e3605b21",
                                "text": "« On ne peut plus continuer cette gabegie », affirme Nour Durand-Raucher, le vice-président du groupe."
                            },
                            {
                                "example_id": "99f1f6b6-e651-4a64-8001-87dc964c7568",
                                "sense_id": "ee25703a-42b4-344f-a5e3-39d8e3605b21",
                                "text": "David Belliard, adjoint EELV à la Mairie de Paris et vice-président d’IDFM, livre son sentiment sur cette situation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f333953-fe9a-483e-acc5-8214aaa17c5e",
                        "source_entry_id": "311c5979-df4d-399c-b4f3-4832feab8cf2",
                        "source_sense_id": "ee25703a-42b4-344f-a5e3-39d8e3605b21",
                        "target_lang_word": "Vizepräsident",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vizepräsident",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36d4861c-a5bd-35ff-a8db-a7467fc6309f",
                                        "entry_id": "80877da9-51c8-3e88-811a-af78a9894081",
                                        "glosses": [
                                            "Stellvertreter eines Präsidenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b04f1e-c005-4c97-85e3-710f779fe355",
                                                "sense_id": "36d4861c-a5bd-35ff-a8db-a7467fc6309f",
                                                "text": "Schon vier Stunden nach dem Attentat auf John F. Kennedy trat der Vizepräsident Lyndon B. Johnson seine Nachfolge an."
                                            },
                                            {
                                                "example_id": "e4bb692a-3602-4318-9487-043a6936d25c",
                                                "sense_id": "36d4861c-a5bd-35ff-a8db-a7467fc6309f",
                                                "text": "„Es gelang ihm, alle wichtigen Leute zu treffen, vom Vizepräsidenten der Burenrepublik Transvaal über den Sultan von Sansibar bis zum Khediven von Ägypten.“"
                                            },
                                            {
                                                "example_id": "e52efd1b-3709-41d0-9e2e-db2c8ab1a4ce",
                                                "sense_id": "36d4861c-a5bd-35ff-a8db-a7467fc6309f",
                                                "text": "„Er war offenbar ein ziemlich unbedarfter, ungebildeter, um nicht zu sagen dummer Vizepräsident und tat sich durch Lübke-ähnliche Dummbeuteleien hervor, die bei dem jungen Mann nicht auf Vergreisung und Alzheimer-Symptome zurückzuführen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
