                "senses": [
                    {
                        "sense_id": "bc44bae7-5370-36fb-8243-c18d82eb32c8",
                        "entry_id": "e611692e-7422-39f9-9fa5-2380ba661293",
                        "glosses": [
                            "Album (vor allem eines Kindes, einer Jugendlichen), in dem sich auf ihre Bitte hin Bekannte, Freunde und Verwandte mit - oft literarischen - Texten und Bildern verewigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da897a7-8385-4e77-8239-d34a4ca6d4e3",
                                "sense_id": "bc44bae7-5370-36fb-8243-c18d82eb32c8",
                                "text": "„Renate las vor, was Oma ihr ins Poesiealbum geschrieben hatte.“"
                            },
                            {
                                "example_id": "3b648757-ffbc-4bf0-927f-2e7f8a4b9933",
                                "sense_id": "bc44bae7-5370-36fb-8243-c18d82eb32c8",
                                "text": "„Er wusste sich mit dem Grafen über wirtschaftliche Gegenstände, mit der Gräfin und Natascha über Toilettenfragen und mit Sonja über Poesiealben und Stickmuster zu unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
