                ],
                "senses": [
                    {
                        "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                        "entry_id": "8bf3f603-65b9-38fe-a640-3268ea2d5ebb",
                        "glosses": [
                            "Emission/Ausstoß von klimaschädlichen Gasen (beispielsweise CO₂, Methan, Ammoniak) in die Umwelt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "3e4bea2c-66f7-4900-bf6c-f2c8e7fafeef",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Erzeugt ein Arbeitstag im Homeoffice weniger Treibhausgasemissionen als im Büro?“"
                            },
                            {
                                "example_id": "17499fd7-291f-4f69-8791-ab91a642780f",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Deutschlands Energiesektor muss bis zum Ende des Jahrzehnts seine jährlichen Treibhausgasemissionen auf 108 Millionen Tonnen reduzieren.“"
                            },
                            {
                                "example_id": "d29a4298-4b9e-406f-a5af-32346e6e2c9b",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "[Die Staaten vereinbarten] „im Kyoto-Protokoll (1997) und dem Übereinkommen von Paris (2015) die Begrenzung und Minderung ihrer Treibhausgasemissionen.“"
                            },
                            {
                                "example_id": "05e13e1e-14c6-4303-8a11-4f017dd40719",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Über mehrere Jahre betrachtet sinken die Treibhausgasemissionen in 31 der 57 erhobenen Länder, doch weltweit steigen sie noch.“"
                            },
                            {
                                "example_id": "bec0ae4d-f790-4f4e-92b3-b90331922662",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Obgleich Afrika gerade vier Prozent der globalen Treibhausgasemissionen verursacht, schlagen die Folgen des Klimawandels hier unverhältnismäßig stark zu.“"
                            },
                            {
                                "example_id": "b185c27f-d100-4d13-a962-f93957fe8bec",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Das Global Carbon Project rechnet damit, dass die Treibhausgasemissionen 2022 deutlich ansteigen.“"
                            },
                            {
                                "example_id": "4a87cb60-5552-4462-a1ea-a6f40a133169",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Zehn Prozent der Treibhausgasemissionen sind auf“ […] „Lebensmittelverschwendung zurückführen.“"
                            },
                            {
                                "example_id": "ad2adf1a-d5dd-4c17-a008-893fa31d1413",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Selbst bei einer Verringerung der Treibhausgasemission wird der Meeresspiegel bis zum Jahr 2300 zwischen eineinhalb und vier Meter ansteigen, so Stefan Rahmstorf.“"
                            },
                            {
                                "example_id": "3f8eefcd-caf4-4581-8abe-7cda63b48b5c",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Seit Jahren prognostizieren Klimamodelle, dass die Ozeane immer wärmer werden, wenn die Treibhausgasemissionen weiter steigen. Im Großen und Ganzen lagen sie damit bislang auch richtig.“"
                            },
                            {
                                "example_id": "7c23dd86-cee8-40c4-b347-5c742341b3ad",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Durch die Klimakrise, die die Menschheit durch ihre Treibhausgasemissionen ausgelöst hat, sind Starkregenereignisse grundsätzlich wahrscheinlicher geworden, auch wenn es sie natürlich auch zuvor schon gegeben hat.“"
                            },
                            {
                                "example_id": "9e872b16-0c55-47d8-8fd9-1a7f1497b037",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„»Die Reduzierung der Treibhausgasemissionen auf Netto-Null ist unsere größte Hoffnung für den Erhalt der Antarktis«, sagt Siegert.“"
                            },
                            {
                                "example_id": "169b843c-cd67-4b4d-8987-ae934135b898",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Die Treibhausgasemissionen sind seit 23 Jahren stabil.“"
                            },
                            {
                                "example_id": "89f27104-af74-4bfa-a9ab-7ae2a7e4b228",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Drei Viertel aller Treibhausgasemissionen aus der Landwirtschaft stammen aus der Rindviehhaltung.“"
                            },
                            {
                                "example_id": "bd41af9f-ec60-4ded-9a5c-c747dd8987d7",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Allein die ständig neue Produktion von Plastik trägt zu fast 3,5 Prozent der globalen Treibhausgasemissionen bei.“"
                            },
                            {
                                "example_id": "19aece4f-69ce-426b-9e3f-b56aa92d6c0a",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Pro 460 Tonnen Treibhausgasemissionen wird Ende des Jahrhunderts eine zusätzliche Person der beispiellosen Jahresmitteltemperatur von mehr als 29 Grad ausgesetzt sein.“"
                            },
                            {
                                "example_id": "b7dd6e33-d01b-4087-aafb-8c86fc7726fc",
                                "sense_id": "de458a64-d8b5-3d2f-b84c-dda533f2b796",
                                "text": "„Höhner geht zwar davon aus, dass sich die globalen Treibhausgasemission ungefähr bis zum Jahr 2030 stabilisieren lassen, wenn die Maßnahmen entsprechend umgesetzt werden. Um das 1,5-Grad-Ziel zu erreichen, müssten unsere Emissionen jedoch halbiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
