                                    {
                                        "sense_id": "3a5d68d0-22f4-3da0-8ab8-6061b67feb4b",
                                        "entry_id": "6a5dcea1-4c98-3803-bd4f-ec352e2648ec",
                                        "glosses": [
                                            "A worldview that centrally places conspiracy theories in the unfolding of history."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cabd337-ef8c-42ae-9e92-234babe5668a",
                                                "sense_id": "3a5d68d0-22f4-3da0-8ab8-6061b67feb4b",
                                                "text": "Antielite conspiracism has deep roots in U.S. political culture."
                                            },
                                            {
                                                "example_id": "4aad154a-db2a-441d-a99d-5f69b7f26406",
                                                "sense_id": "3a5d68d0-22f4-3da0-8ab8-6061b67feb4b",
                                                "text": "[Robert F. Kennedy Jr.] has leaned into a medical conspiracism[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
