                        ],
                        "form": "die Waldwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                        "entry_id": "26b04b39-2dcb-3805-9a24-76c4358f1cdc",
                        "glosses": [
                            "in/durch den Wald führender Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6d9421-44e8-4674-8579-2a823818e13c",
                                "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                                "text": "Endlich fanden sie einen Plan aller Waldwege, und merkten, dass sie sich verirrt hatten."
                            },
                            {
                                "example_id": "a953af1b-15d1-44e8-a097-f6588f04a2a7",
                                "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                                "text": "„Er hatte diesen Feldweg, Waldweg befahrbarer in Erinnerung gehabt.“"
                            },
                            {
                                "example_id": "9346b4ee-fdab-405a-af53-4777659c21e7",
                                "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                                "text": "„Der Wagen setzte sich in Bewegung, rumpelte den Waldweg entlang, aber er entfernte sich nicht von dieser unglaublichen Nachricht, sondern nahm sie mit.“"
                            },
                            {
                                "example_id": "9a10c6e9-e5fb-439a-aec8-20c4eee733d7",
                                "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                                "text": "„Unter diesem Gespräche, das sich weiterspann, hatten unsere drei Freunde den Punkt erreicht, wo der Waldweg wieder in den Hauptweg einbog, auf dem, im selben Augenblicke fast, wo sie denselben betraten, ein Hauderer oder Personenwagen, mit dem Anhaltiner Wappen am Wappenschlage, vorüberollte.“"
                            },
                            {
                                "example_id": "d2788e55-c2d4-4149-9c41-c5e985ab7bf6",
                                "sense_id": "6f73f6b4-fb5b-3680-b012-1325864572b3",
                                "text": "„Und wer danach links den breit ausgebauten Waldweg weitergeht, stellt fest, dass das gesamte Plateau des Kultbezirks mit steil abfallenden Klippen endet, die von Höhlen und gehauenen Gängen durchzogen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
