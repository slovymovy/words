                ],
                "senses": [
                    {
                        "sense_id": "ac6a38e1-274e-3cc1-9e6c-17ba08c7f393",
                        "entry_id": "b29ab27f-fa70-3ae2-a6f3-dc9048667614",
                        "glosses": [
                            "The steroid precursor of vitamin D₂. It is found in cell membranes of fungi, and is their functional equivalent of cholesterol. It is also found in the membranes of some protists."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4faa3e05-13a4-429c-b31e-8df61a56e8ea",
                                "sense_id": "ac6a38e1-274e-3cc1-9e6c-17ba08c7f393",
                                "text": "Terbinafine has a unique mechanism of action among the antifugal agents (Petranyi et al, 1984; Balfour and Faulds, 1992), inhibiting the synthesis of ergosterol, a key sterol component in the plasma membrane of the fungal cell."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b38a369-c708-4b3c-948d-60d657414615",
                        "source_entry_id": "b29ab27f-fa70-3ae2-a6f3-dc9048667614",
                        "source_sense_id": "ac6a38e1-274e-3cc1-9e6c-17ba08c7f393",
                        "source_sense_description": "steroid precursor of vitamin D2",
                        "target_lang_word": "ergostérol",
