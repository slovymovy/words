                            {
                                "example_id": "e3c2a17d-53ab-4935-99eb-9b16174980f0",
                                "sense_id": "1078b577-353f-3748-87b8-64f65aa58b91",
                                "text": "Onze afzuigkap was door het frituurvet helemaal verstopt geraakt."
