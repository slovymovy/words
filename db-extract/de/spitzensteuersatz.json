                ],
                "senses": [
                    {
                        "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                        "entry_id": "17a2cf61-0ee8-3dcb-8172-6bd1a0724c36",
                        "glosses": [
                            "höchster Prozentsatz eines im Verhältnis zur Bemessungsgrundlage (beispielsweise dem Einkommen) sich verändernder Steuertarif; der Spitzensteuersatz wird normalerweise als Prozentzahl ausgedrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162b33bd-baf2-430e-867e-913f92c2fc50",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Der Spitzensteuersatz ist der höchste reguläre Steuersatz. In Deutschland liegt er derzeit bei 42 Prozent (ohne Solidaritätszuschlag und Reichensteuer).“"
                            },
                            {
                                "example_id": "0ddd6327-523b-495a-9514-8063a38a12a6",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Die rot-grüne Regierung senkte anschließend den Spitzensteuersatz.“"
                            },
                            {
                                "example_id": "a7230ab2-08e2-423c-a145-ec53b509cdb8",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Der Spitzensteuersatz beträgt in Deutschland 42 Prozent, er wird fällig bei einem zu versteuernden Einkommen von knapp 53.000 Euro pro Jahr.“"
                            },
                            {
                                "example_id": "a2e0c68d-e0b1-4b91-a50a-a4e428e66982",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„»Wir hatten zu Helmut Kohls Zeiten Spitzensteuersätze von 53 Prozent. Es ist völlig falsch zu behaupten, dass Menschen mit hohen Einkommen heute besonders stark belastet werden.«“ (Peter Bofinger, Professor für Volkswirtschaftslehre, Universität Würzburg)"
                            },
                            {
                                "example_id": "cb5f1bb2-8b65-440a-942f-e38dbe5aba75",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Der Spitzensteuersatz lag [2018 in Deutschland] bei über 40 Pozent. In Schweden steht er derzeit bei fast 60 Prozent, während die Hoffnungsträgerin der US-Demokraten Alexandria Ocasio-Cortz einen Spitzensteuersatz von 70 Prozent ins Spiel brachte.“"
                            },
                            {
                                "example_id": "fb3e9fc4-b850-4d3f-8d09-d2524b2185fc",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„1975 wird der Spitzensteuersatz im [britischen] Königreich von 60 auf 83% erhöht. Umgerechnet auf heute und in Euro heißt das: Wer mehr als 240.000 € brutto pro Jahr verdient, hat davon gefälligst 83% Steuern abzuführen.“"
                            },
                            {
                                "example_id": "fb13fe4c-7be6-4342-b817-ae3d647167e9",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Schon Normalverdiener zahlen in Deutschland den Spitzensteuersatz, lautet der Vorwurf. Und der Staat will mehr. Schaut man sich die Zahlen genau an, sieht es anders aus.“"
                            },
                            {
                                "example_id": "fa92c75a-dd01-41be-8fcd-fa5e947f988f",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Den Spitzensteuersatz zahlen inzwischen Menschen, die das 1,3-fache des Durchschnittslohns verdienen. Absurd! Früher galt der für Gehälter, die 15-mal so hoch waren.“"
                            },
                            {
                                "example_id": "5700baf0-2910-40db-b444-9fdeae4a40d7",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Als Hauptgründe für diesen Trend [der wachsenden Ungleichheit in Deutschland] sehen die Forscher die Steuerpolitik. Vor allem die Einkommen aus Kapital seien gestiegen. Weil der Spitzensteuersatz gesenkt wurde, hätten Menschen mit hohem Einkommen viel Kapital ansammeln können, das ihnen auch wieder neue Einkommen beschert.“"
                            },
                            {
                                "example_id": "1e6e82ea-b25d-4117-8455-04d77b7cffb6",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "[Bundesfinanzminister Olaf Scholz (SPD)] „versprach Steuererleichterungen, sowie eine Anhebung des Spitzensteuersatzes.“"
                            },
                            {
                                "example_id": "7a8d5540-3ed5-4976-ba09-39488aeec7e5",
                                "sense_id": "895d55cd-e94b-34bb-86ea-922bbbb09ffc",
                                "text": "„Trump möchte aus dem bis dato siebenstufigen Steuersystem ein System mit drei Stufen machen. Dabei soll der Spitzensteuersatz von derzeit 39,5 Prozent auf 35 Prozent abgesenkt werden, der Eingangssteuersatz hingegen soll von derzeit 10 auf 12 Prozent steigen – was eine Begünstigung der Reichen und eine Benachteiligung der Ärmeren bedeuten würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
