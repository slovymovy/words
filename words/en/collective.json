{
    "word_family": [
        "collect",
        "collection",
        "collector",
        "collectivism",
        "collectivize",
        "collectively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8b22954-7602-38ee-81bb-eb232adf9a48",
                    "sense_definition": "Formed by gathering or collecting into a mass, sum, or body; relating to a group as a whole rather than individuals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>collective</w> effort of the entire team led to the project's success.",
                            "target_lang_translations": {
                                "ru": "<w>Коллективные</w> усилия всей команды привели проект к успеху."
                            }
                        },
                        {
                            "text": "We must take <w>collective</w> responsibility for the environmental impact of our actions.",
                            "target_lang_translations": {
                                "ru": "Мы должны нести <w>коллективную</w> ответственность за воздействие наших действий на окружающую среду."
                            }
                        }
                    ],
                    "synonyms": [
                        "congregated",
                        "aggregated"
                    ],
                    "antonyms": [
                        "individual",
                        "separate"
                    ],
                    "common_phrases": [
                        "collective responsibility",
                        "collective effort",
                        "collective memory",
                        "collective action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к группе как к целому, а не к отдельным личностям; общий, совместный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллективный",
                                "target_lang_sense_clarification": "общий для группы"
                            },
                            {
                                "target_lang_word": "совместный",
                                "target_lang_sense_clarification": "выполняемый вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b480853e-1245-3cda-924e-e740b58d2d91",
                    "sense_definition": "Expressing a collection or aggregate of individuals by using a singular grammatical form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the phrase a flock of birds, the word flock is a <w>collective</w> noun.",
                            "target_lang_translations": {
                                "ru": "В фразе «стая птиц» слово «стая» является <w>собирательным</w> существительным."
                            }
                        },
                        {
                            "text": "The teacher explained how to use <w>collective</w> nouns correctly in a sentence.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как правильно использовать <w>собирательные</w> существительные в предложении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collective noun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий совокупность лиц или предметов с помощью формы единственного числа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирательный",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f58e4ccb-7a45-31b6-963d-be6eac627e4b",
                    "sense_definition": "Deducing consequences or reasoning by inferring from gathered information.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher applied <w>collective</w> reason to solve the complex ethical dilemma.",
                            "target_lang_translations": {
                                "ru": "Философ применил <w>совокупный</w> разум для решения сложной этической дилеммы."
                            }
                        },
                        {
                            "text": "His <w>collective</w> approach to logic allowed him to see patterns others missed.",
                            "target_lang_translations": {
                                "ru": "Его <w>обобщающий</w> подход к логике позволил ему увидеть закономерности, которые другие упустили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collective reason"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or philosophical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на обобщении или выведении следствий из собранной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обобщающий",
                                "target_lang_sense_clarification": "основанный на синтезе данных"
                            },
                            {
                                "target_lang_word": "совокупный",
                                "target_lang_sense_clarification": "взятый в целом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a75bfde7-80bf-3374-819f-cab1a8f17424",
                    "sense_definition": "A group of people who work together on a particular cause, interest, or project, often without a strict hierarchy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artists formed an art <w>collective</w> to share studio space and resources.",
                            "target_lang_translations": {
                                "ru": "Художники создали творческий <w>коллектив</w>, чтобы совместно использовать студию и ресурсы."
                            }
                        },
                        {
                            "text": "Members of the local <w>collective</w> meet every week to discuss community goals.",
                            "target_lang_translations": {
                                "ru": "Члены местного <w>объединения</w> встречаются каждую неделю для обсуждения целей сообщества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "art collective",
                        "workers collective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, работающих вместе над общим делом или проектом, часто без строгой иерархии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллектив",
                                "target_lang_sense_clarification": "группа людей"
                            },
                            {
                                "target_lang_word": "объединение",
                                "target_lang_sense_clarification": "сообщество по интересам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "016c6c65-29cf-3d84-b8dc-a61d83111c79",
                    "sense_definition": "A cooperative enterprise, such as a farm, that is owned and managed by the community or the state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During that era, many farmers were forced to join a state-run <w>collective</w>.",
                            "target_lang_translations": {
                                "ru": "В ту эпоху многие фермеры были вынуждены вступить в государственный <w>колхоз</w>."
                            }
                        },
                        {
                            "text": "The <w>collective</w> produced enough grain to feed the entire village.",
                            "target_lang_translations": {
                                "ru": "<w>Коллективное хозяйство</w> произвело достаточно зерна, чтобы прокормить всю деревню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agricultural collective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кооперативное предприятие (например, ферма), находящееся в собственности и под управлением сообщества или государства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колхоз",
                                "target_lang_sense_clarification": "сельскохозяйственная артель"
                            },
                            {
                                "target_lang_word": "коллективное хозяйство",
                                "target_lang_sense_clarification": "кооперативное предприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "515a3298-50ec-34a6-8b38-cb92becf97f0",
                    "sense_definition": "The flight control lever used to change the pitch of all helicopter rotor blades simultaneously to control ascent or descent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot pulled up on the <w>collective</w> to increase the helicopter's altitude.",
                            "target_lang_translations": {
                                "ru": "Пилот потянул вверх <w>рычаг общего шага</w>, чтобы увеличить высоту вертолета."
                            }
                        },
                        {
                            "text": "To maintain a steady hover, you must carefully adjust the <w>collective</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы поддерживать устойчивое зависание, необходимо осторожно регулировать <w>общий шаг</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lower the collective",
                        "collective pitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical aviation term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рычаг управления шагом винта вертолета, изменяющий угол атаки всех лопастей одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг общего шага",
                                "target_lang_sense_clarification": "авиационный термин"
                            },
                            {
                                "target_lang_word": "шаг-газ",
                                "target_lang_sense_clarification": "разговорный технический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}