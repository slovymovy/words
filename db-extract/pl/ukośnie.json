                "translations": [
                    {
                        "translation_id": "de37f742-bb98-4b17-91a1-dc349e9f5582",
                        "source_entry_id": "682db53d-fd1c-3c7c-ac5e-135771960c54",
                        "source_sense_id": "7dcd6b07-8a62-3a4c-8b65-aafcfce564c0",
                        "target_lang_word": "diagonally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagonally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be56f09a-89d7-3295-8d07-4ce5f29dcc9a",
                                        "entry_id": "d3431d4d-e5ff-3061-aabf-a1e2a984f67b",
                                        "glosses": [
                                            "In a diagonal manner, not square to any direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91203b0-52d0-472f-928e-1c849b4cab1c",
                                                "sense_id": "be56f09a-89d7-3295-8d07-4ce5f29dcc9a",
                                                "text": "The diagonally opposed driving positions in the cab are identical."
                                            },
                                            {
                                                "example_id": "35a040ec-e360-412a-83d0-ac02bed2a530",
                                                "sense_id": "be56f09a-89d7-3295-8d07-4ce5f29dcc9a",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d026150-450c-4f01-845b-f82134af19dc",
                        "source_entry_id": "682db53d-fd1c-3c7c-ac5e-135771960c54",
                        "source_sense_id": "7dcd6b07-8a62-3a4c-8b65-aafcfce564c0",
                        "target_lang_word": "aslant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aslant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                        "entry_id": "d8b98bbc-2769-39be-b933-ce5a1bfb8e67",
                                        "glosses": [
                                            "Slanting."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06dfa37-cef2-45b5-a939-af515665c2ed",
                                                "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                                "text": "Near-synonym: askance"
                                            },
                                            {
                                                "example_id": "bf83d671-2ca6-43c2-88b0-fc1bd6fb4c44",
                                                "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                                "text": "As for the manner and fashion of the cut [when pruning grapevines], it ought alwaies to be aslant, like a goats foot, that no drops of raine may settle and rest thereupon, but that euery shower may soon shoot off:"
                                            },
                                            {
                                                "example_id": "867e89ba-c3fd-40b0-8856-f9f4ff527bdc",
                                                "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                                "text": "But their manner of writing is very peculiar, being neither from the left to the right, like the Europeans; nor from the right to the left, like the Arabians; nor from up to down, like the Chinese; nor from down to up, like the Cascagians; but aslant from one Corner of the Paper to the other, like Ladies in England."
                                            },
                                            {
                                                "example_id": "1b042a65-895b-4c53-a0cd-5d168995c551",
                                                "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                                "text": "Meantime everything in the Pequod was aslant. To cross to the other side of the deck was like walking up the steep gabled roof of a house."
                                            },
                                            {
                                                "example_id": "9b53c1db-89fd-404a-a9c8-c67bec38636a",
                                                "sense_id": "06ccd290-8ae0-364f-95be-a6e3f6ab9f87",
                                                "text": "Now she stands musing on the beach, leg locked, pelvis aslant, thumb and forefingers propped along the iliac crest and lightly, propped lightly as an athlete."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aslant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8608489-b3d0-3a2e-b31c-6ee2010d62ff",
                                        "entry_id": "6c180c28-acad-3eaf-b128-7736f668b234",
                                        "glosses": [
                                            "At a slant."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97651a75-f8b7-4ea0-b118-2904405f78c6",
                                                "sense_id": "f8608489-b3d0-3a2e-b31c-6ee2010d62ff",
                                                "text": "The Shaft that slightly was impress’d,\nNow from his heavy Fall with weight increas’d,\nDrove through his Neck, aslant,"
                                            },
                                            {
                                                "example_id": "2816ad1a-b12d-46df-87fa-4a241c044865",
                                                "sense_id": "f8608489-b3d0-3a2e-b31c-6ee2010d62ff",
                                                "text": "It [the light] led me aslant over the hill, through a wide bog;"
                                            },
                                            {
                                                "example_id": "8870268d-2ffb-4a83-9448-f4a66412ec89",
                                                "sense_id": "f8608489-b3d0-3a2e-b31c-6ee2010d62ff",
                                                "text": "1914, Constance Garnett (translator), Crime and Punishment by Fyodor Dostoevsky, New York: P. F. Collier & Son, 1917, Part 4, Chapter 4, p. 321,\nA wall with three windows looking out on to the canal ran aslant so that one corner formed a very acute angle, and it was difficult to see in it without very strong light."
                                            },
                                            {
                                                "example_id": "00f63111-2adf-4438-83a4-76e9fa635cf0",
                                                "sense_id": "f8608489-b3d0-3a2e-b31c-6ee2010d62ff",
                                                "text": "[…] he was looking aslant and not directly at me; more of a gaze to the side of me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aslant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffedbbe1-77cf-3e84-9d0f-309031538202",
                                        "entry_id": "cbfb5f2f-3c35-3b8d-a8d9-a9e9e717b72a",
                                        "glosses": [
                                            "Diagonally over or across."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85838e74-82b0-4733-b5ea-32677b46fd37",
                                                "sense_id": "ffedbbe1-77cf-3e84-9d0f-309031538202",
                                                "text": "There is a willow grows aslant a brook,\nThat shows his hoar leaves in the glassy stream."
                                            },
                                            {
                                                "example_id": "5e7de3b9-af90-4ee2-ab12-a7b337f23e06",
                                                "sense_id": "ffedbbe1-77cf-3e84-9d0f-309031538202",
                                                "text": "I oft have passed your cottage, and still prais’d\nIts beauty, and that trim orchard-plot, whose blossoms\nThe gusts of April shower’d aslant its thatch."
                                            },
                                            {
                                                "example_id": "25ee54e6-a77b-4fb8-99a3-a4819a2b4b86",
                                                "sense_id": "ffedbbe1-77cf-3e84-9d0f-309031538202",
                                                "text": "But aslant this particular glass reclined a single, white, wintry rose, possibly the last rose ever, its invalid complexion infused with a delicate transcendent green."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
