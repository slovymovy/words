                ],
                "translations": [
                    {
                        "translation_id": "678518bb-5550-4b61-bcd6-e83bb1357c7e",
                        "source_entry_id": "0c8753a7-15ac-3dc7-b5ab-047ce9b7a70c",
                        "source_sense_id": "f05f50da-0283-3849-91d2-ff8046e4513d",
                        "target_lang_word": "hanovrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hanovrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e315b9c-ead3-3f23-90c1-c37c5cab0d01",
                                        "entry_id": "3c661133-7301-3317-9bb3-c822c42ef5e9",
                                        "glosses": [
                                            "Relatif à Hanovre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a88a3d98-97eb-4ecc-ad20-3b59e8c8741a",
                                                "sense_id": "4e315b9c-ead3-3f23-90c1-c37c5cab0d01",
                                                "text": "Les droits de Stade, c’est ainsi que l’on désigne les taxes perçues par la douane hanovrienne de Hambourg, tirent leur nom de l’ancienne et petite ville de Stade, située à huit ou neuf lieues au-dessous de Hambourg et à une lieue de l’Elbe. Dès les temps les plus reculés du moyen-âge, les seigneurs de Stade, qui étaient les évêques de Brême et de Werden, levaient un péage sur tous les bateaux qui entraient dans l’Elbe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hanovrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c253d60-36e2-395e-8af5-698e28073e3b",
                                        "entry_id": "068f5623-79e7-3de0-8727-747975f0c9f8",
                                        "glosses": [
                                            "Dialecte de l’allemand, parlé à Hanovre et dans sa région."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b40f8f-37d9-403b-be02-cb80c4cc932f",
                                                "sense_id": "4c253d60-36e2-395e-8af5-698e28073e3b",
                                                "text": "Je me décide à leur parler allemand : pour qu’ils comprennent mieux, j’emploie mon haut allemand le plus clair, la langue officielle des théâtres de Meiningen et de Weimar, le hanovrien saccadé des auteurs juifs qui déclament les traductions de Verlaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hanovrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86b7abad-5a9c-3d2d-aebf-087afa371579",
                                        "entry_id": "d93b8c65-9c49-36ec-97eb-a0ee02ef95d9",
                                        "glosses": [
                                            "Grand cheval de sport demi-sang allemand, dérivé du holstein et de chevaux anglais."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e009bad-3c6e-4517-a52e-7bd8483e7c7a",
                                                "sense_id": "86b7abad-5a9c-3d2d-aebf-087afa371579",
                                                "text": "Selon le standard, la taille au garrot du hanovrien est de 1,56 à 1,72 m."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5473510b-8646-4eb8-9c1f-4ef82da9bd8b",
                        "source_entry_id": "0c8753a7-15ac-3dc7-b5ab-047ce9b7a70c",
                        "source_sense_id": "f05f50da-0283-3849-91d2-ff8046e4513d",
                        "target_lang_word": "Hannoveraner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hannoveraner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd12750c-6839-3b4a-8465-64032d68da8e",
                                        "entry_id": "1ed109af-2a95-38ff-a624-e0e213dd41b9",
                                        "glosses": [
                                            "Bewohner von Hannover, jemand, der aus Hannover stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a71c6f-b5d1-4807-9998-0a0d148a9920",
                                                "sense_id": "cd12750c-6839-3b4a-8465-64032d68da8e",
                                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Hannoveraner."
                                            },
                                            {
                                                "example_id": "e548209d-a739-4ff5-ab8d-b14edd40f711",
                                                "sense_id": "cd12750c-6839-3b4a-8465-64032d68da8e",
                                                "text": "„Während es heute viele Hannoveraner gibt, die lieber Kurt Schwitters zum berühmtesten Künstler der Stadt promovieren würden, sind es aber nun einmal die Scorpions, die emblematisch für den Hannoverismus wirken - und das weltweit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05043142-260e-35de-b0ca-679e27fc534f",
                                        "entry_id": "1ed109af-2a95-38ff-a624-e0e213dd41b9",
                                        "glosses": [
                                            "Pferderasse, die zahlenmäßig zu den stärksten Warmblutzuchten weltweit gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5fb5a9-6da9-4a46-a9e6-3c702bc4e639",
                                                "sense_id": "05043142-260e-35de-b0ca-679e27fc534f",
                                                "text": "„Deutlich dominierend ist der absolute Allrounder, der Hannoveraner; der Trakehner, Platz fünf, gilt als die edelste der Warmblutrassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hannoveraner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37cb3724-401c-3dab-937f-3653e01e5b2c",
                                        "entry_id": "3a2541fe-1aa5-3b6b-a413-68fc62c87e17",
                                        "glosses": [
                                            "zu Hannover gehörig, aus ihm kommend oder es betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad179595-b4c5-438f-946f-cd10aa4e9c99",
                                                "sense_id": "37cb3724-401c-3dab-937f-3653e01e5b2c",
                                                "text": "Die Hannoveraner Innenstadt hat einiges zu bieten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
