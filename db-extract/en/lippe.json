                                                "sense_id": "27a915eb-29e5-3a9b-a561-8ba2f208095a",
                                                "text": "Ich bin in Lippe geboren."
                                            },
                                            {
                                                "example_id": "4628d428-89c7-4289-b495-d7398087b33a",
                                                "sense_id": "27a915eb-29e5-3a9b-a561-8ba2f208095a",
                                                "text": "Ich habe in Lippe meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "c02e7710-fcb8-4b58-a736-d5ccd89e312e",
                                                "sense_id": "27a915eb-29e5-3a9b-a561-8ba2f208095a",
                                                "text": "Nach Lippe führen viele Wege."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a8420d8-749a-3889-9d80-85cf6d3a0f61",
