                        "examples": [
                            {
                                "example_id": "dd429006-6578-4f89-8508-5911c3522d2e",
                                "sense_id": "5cb8e147-bf8e-3951-a5ea-3040498f0bb6",
                                "text": "La personne qui réalise les opérations de décolletage est appelé une décolleteuse ou un décolleteur."
                            }
                        ]
