                "senses": [
                    {
                        "sense_id": "78005b9d-54bd-398d-bb8b-0f834be50996",
                        "entry_id": "0077568d-0af6-32c7-be2d-92442d02c4da",
                        "glosses": [
                            "Enlever sa qualité d’auteur à (une personne)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aecf7a1-0f22-4e54-b189-561af2d293fa",
                                "sense_id": "78005b9d-54bd-398d-bb8b-0f834be50996",
                                "text": "On n’aime alors rien tant qu’à les « désauteuriser », si l’on permet le néologisme, en les renvoyant à leur univers d’origine et en les priant de s’en tenir là."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c9666df-554e-3328-aa80-26067a7b17b9",
                        "entry_id": "0077568d-0af6-32c7-be2d-92442d02c4da",
                        "glosses": [
                            "Ne plus reconnaître d’auteur à (une œuvre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7c5813-486b-470c-b2cd-b2633e923147",
                                "sense_id": "1c9666df-554e-3328-aa80-26067a7b17b9",
                                "text": "Film non prévu, non voulu, film à deux auteurs et pourtant, à proprement parler, «désauteurisé», que Wim par deux fois, tentera d'arrêter pour lui donner sa signature, au prix de sa culpabilité."
                            }
                        ]
                    }
