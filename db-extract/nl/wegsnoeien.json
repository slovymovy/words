                        "glosses": [
                            "verwijderen van takken en uitlopers van bomen en planten met behulp van een snoeimes of snoeischaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a908928c-d8f9-405b-aa53-b7d21d587204",
                                "sense_id": "06e299a2-898f-34be-ab34-dd7e69c0b953",
                                "text": "Even, héél even, kon ik in alle rust takken wegsnoeien en een prachtig mooie 1 op de bast van een eik plakken."
                            },
                            {
                                "example_id": "8e015795-1ddf-4117-9ab3-24189feaefe6",
                                "sense_id": "06e299a2-898f-34be-ab34-dd7e69c0b953",
                                "text": "Met zijn snoeimes in zijn mond bindt de man een iel boompje op en laat hij zien hoe je de onderste takken moet wegsnoeien om zo'n hoogte te bereiken."
                            },
                            {
                                "example_id": "166117de-e9ce-4ee0-9e54-6ac664d8d613",
                                "sense_id": "06e299a2-898f-34be-ab34-dd7e69c0b953",
                                "text": "Of er bomen staan die om moeten, weten ze nog niet. \"Vaak is het niet nodig, dan nemen we snoeimaatregelen. Als we de top van de boom wegsnoeien, komt er al veel minder kracht op te staan bij storm. Ze hopen dat ze alle bomen kunnen laten staan; de gemeente is trots op de bomen."
                            }
                        ]
                    }
