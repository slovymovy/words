                "translations": [
                    {
                        "translation_id": "7f33de41-ac0c-4255-89c9-0829af018e10",
                        "source_entry_id": "2677aa0f-877c-335f-97cf-e768a3cca4ac",
                        "source_sense_id": "be830fc0-76ff-35c0-a0aa-a50865ae2825",
                        "source_sense_description": "een verzamelnaam voor vogels die gekweekt worden als voedsel",
                        "target_lang_word": "Geflügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geflügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                        "entry_id": "5ceaf253-f8de-380f-ad2a-62de5a1046f3",
                                        "glosses": [
                                            "Vögel als landwirtschaftliche Nutztiere und als Haustiere"
                                        ],
                                        "tags": [
                                            "Nutztier",
                                            "auch im Plural (oft bezüglich verschiedener Arten)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd2f774-de2a-4c1d-a6d5-2ee74718b561",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "„Wieder andere halten „Mastschweine“ oder verschiedene Geflügel in der Nähe von Häfen, wo Futtermittel aus importierten Produkten günstig hergestellt werden.“"
                                            },
                                            {
                                                "example_id": "c43a90f6-013d-4ce5-bcbc-2ee63572afe4",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "„Gemeldet sind 44 Aussteller mit 413 Tieren verschiedener Geflügel, deren ursprüngliche Abstammung und Herkunft sich vom fränkischen über den deutschen Raum, sowie weit darüber hinaus erstreckt.“"
                                            },
                                            {
                                                "example_id": "a7d6b869-1262-4cdd-a0c8-ca26acea053f",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "„Mit der Bezeichnung \"Vogelgrippe\" wollte man allgemein verständlich machen, dass das Virus von Geflügeln auf den Menschen übertragen wurde.“"
                                            },
                                            {
                                                "example_id": "6655a79e-4ed9-49f2-a8fd-ab782f2c1ce2",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "Wir züchten Geflügel."
                                            },
                                            {
                                                "example_id": "bbe26ac1-886e-42da-90fb-85fa74324cfb",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "Ottokar, sorg dafür, dass das Geflügel in den Stall kommt."
                                            },
                                            {
                                                "example_id": "17c340e8-5225-4706-a983-e07cb2d29622",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "„Die Knospen sind eine Aesung der Birkhüner. Die Nordländer sammeln sie, trocknen sie in gelinder Wärme, und füttern mit schicklichen Zusätzen ihre Geflügel den ganzen Winter durch damit.“"
                                            },
                                            {
                                                "example_id": "f7d10f22-f7d4-438d-870a-c45be0a93358",
                                                "sense_id": "4a228b6f-5446-3b09-bbb6-e1c0c7dc5a35",
                                                "text": "„Derzeit bereits verboten ist die Einfuhr von Geflügel, anderen Vögeln, Geflügelfleisch, Eiern und anderen Produkten von Geflügeln sowie Federn und unbehandelten Jagdtrophäen aus Kambodscha, Indonesien, Japan, Laos, Malaysia, Pakistan, Südkorea, Thailand, Vietnam sowie China und Hongkong.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd67b56f-f76b-38ec-a012-0dd3a6e22d42",
                                        "entry_id": "5ceaf253-f8de-380f-ad2a-62de5a1046f3",
                                        "glosses": [
                                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch der als Nutztiere gehaltenen Vögel"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f9faa5-0319-4dde-ae8e-1e58ba24301d",
                                                "sense_id": "fd67b56f-f76b-38ec-a012-0dd3a6e22d42",
                                                "text": "Heute gibt's Geflügel."
                                            },
                                            {
                                                "example_id": "e98881b9-ff88-4e0f-ad69-26e91414f789",
                                                "sense_id": "fd67b56f-f76b-38ec-a012-0dd3a6e22d42",
                                                "text": "Martin isst am liebsten Geflügel. Rindfleisch oder Schweinefleisch kommt bei uns deswegen nie auf den Tisch."
                                            },
                                            {
                                                "example_id": "859696e1-d662-4ab1-9468-fc208664257c",
                                                "sense_id": "fd67b56f-f76b-38ec-a012-0dd3a6e22d42",
                                                "text": "„Geflügel gab es offiziell praktisch gar nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b1ff191-91ed-3c00-8afd-4c62fc525967",
                                        "entry_id": "5ceaf253-f8de-380f-ad2a-62de5a1046f3",
                                        "glosses": [
                                            "Vögel als Jagdwild"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d43819-3d18-4544-89fe-3b913e69c6ef",
                                                "sense_id": "2b1ff191-91ed-3c00-8afd-4c62fc525967",
                                                "text": "Fasane gehören zum jagdbaren Geflügel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "66b183db-abcc-33c2-a849-e5e1eb41ebba",
                                        "entry_id": "5ceaf253-f8de-380f-ad2a-62de5a1046f3",
                                        "glosses": [
                                            "Flügel, Gefieder"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ef5d94-dbb4-4398-890d-758203448a10",
                                                "sense_id": "66b183db-abcc-33c2-a849-e5e1eb41ebba",
                                                "text": "Die Vögel tragen auf ihrem Geflügel den Sommer heran."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "adb772e1-4e12-3f61-a977-dc2614a4ca77",
                                        "entry_id": "5ceaf253-f8de-380f-ad2a-62de5a1046f3",
                                        "glosses": [
                                            "Engel"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9538e7c0-e03d-4d24-980c-5c88fbf1a90d",
                                                "sense_id": "adb772e1-4e12-3f61-a977-dc2614a4ca77",
                                                "text": "Das himmlische Geflügel wird dich heimgeleiten."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
