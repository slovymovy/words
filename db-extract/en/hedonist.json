                                        "glosses": [
                                            "iemand die steevast positief in het leven staat en zoveel mogelijk geniet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d88d72-acb8-4fab-95d6-439894ec80dc",
                                                "sense_id": "f28e002e-cd1d-3feb-a9d4-7f36f075df28",
                                                "text": "Hij was een levensgenieter / Hij was de koning te rijk / Hij overtroefde zelfs Palieter / En kende plaats noch tijd …"
                                            },
                                            {
                                                "example_id": "07638097-daee-4b98-a6a6-dbee7b921296",
                                                "sense_id": "f28e002e-cd1d-3feb-a9d4-7f36f075df28",
                                                "text": "Ze hield van extremen, een avontuurlijke levensgenieter die altijd leven in de brouwerij bracht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "960596db-427d-4f39-8125-41fe3fc7c307",
                        "source_entry_id": "cc7bc29c-35f8-332c-803b-62b402fce1a9",
                        "source_sense_id": "7ad6fda5-a151-3d83-a475-d02a99bfe517",
                        "source_sense_description": "someone devoted to hedonism",
                        "target_lang_word": "epicurist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
