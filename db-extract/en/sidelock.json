                        "sense_id": "558f652e-0b22-374d-b246-c84476c5cc46",
                        "entry_id": "abcbb19c-9532-3908-ac55-75ea4433055e",
                        "glosses": [
                            "A lock of hair worn at the side of the head."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ff5ae7-a454-46b7-8da0-be5089bcd1db",
                                "sense_id": "558f652e-0b22-374d-b246-c84476c5cc46",
                                "text": "observation of the Sabbath (rather than the décadi) and the wearing of Jewish side-locks and beards were regarded as ‘uncivic’ offences."
                            },
                            {
                                "example_id": "ff94a648-dadf-4e9c-8b96-98b4a3dc9567",
                                "sense_id": "558f652e-0b22-374d-b246-c84476c5cc46",
                                "text": "Its male residents dress like crows: heavy black suits, black Borsalino hats, the old grandfathers hugely whiskered and the boys in peot, the curled sidelocks of the pious."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f74f110-b024-3612-a8a8-c93d889abc09",
                        "entry_id": "abcbb19c-9532-3908-ac55-75ea4433055e",
                        "glosses": [
                            "The design of a gun that has the lockwork mounted to the inside of a plate; compare boxlock."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
