                "senses": [
                    {
                        "sense_id": "8737f09a-5a43-3b2e-9af6-9f0b12fc8420",
                        "entry_id": "0c34f36c-46ca-3c3b-8458-65ba60fa30ec",
                        "glosses": [
                            "Wohlbefinden, Zufriedenheit beim Anblick von guter, hochwertiger Kunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53b508a-24c6-441e-8c68-7d9e9e0d8bb3",
                                "sense_id": "8737f09a-5a43-3b2e-9af6-9f0b12fc8420",
                                "text": "„Dummerweise ist das Gedrängel vor den Gemälden so groß, dass einem der Kunstgenuss vergeht.“"
                            },
                            {
                                "example_id": "604c1ae6-0e0f-48c9-8e0e-f7c311f63232",
                                "sense_id": "8737f09a-5a43-3b2e-9af6-9f0b12fc8420",
                                "text": "„Bei angenehm kühlen Temperaturen hat jeder, der an diesem Nachmittag gekommen ist, Platz für uneingeschränkten Kunstgenuss.“"
                            },
                            {
                                "example_id": "e5859523-855e-4e19-a24b-002061e36751",
                                "sense_id": "8737f09a-5a43-3b2e-9af6-9f0b12fc8420",
                                "text": "„Beim Kauf des Tickets bekommen sie zudem ein Hinweisblatt, worauf Kunstgenüsse in der Umgebung wie die Gemäldegalerie und das Kupferstichkabinett für die Wartezeit empfohlen werden.“"
                            },
                            {
                                "example_id": "492a5b15-f2b8-4f82-845a-acbbbbc4a56d",
                                "sense_id": "8737f09a-5a43-3b2e-9af6-9f0b12fc8420",
                                "text": "„Hagel ist in Berlin bereits bekannt für ungewöhnliche Kunstgenüsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
