                "senses": [
                    {
                        "sense_id": "8f382c33-4afa-31b1-8c21-2a938514fbd7",
                        "entry_id": "4af73aad-a3b0-3897-8766-f362efc7536e",
                        "glosses": [
                            "iemand die flink schreeuwt, een grote mond opzet"
                        ],
                        "tags": [],
