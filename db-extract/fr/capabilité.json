        "fr-extract.jsonl": [
            {
                "entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                "word": "capabilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b6dc1b8-2701-4f3f-8d04-c3c16eb82dc9",
                        "entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "tags": [
                            "plural"
                        ],
                        "form": "capabilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80c8b128-20c5-37e3-8b70-7f213b934a9d",
                        "entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "glosses": [
                            "Capacité, fait de pouvoir faire quelque chose."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "472e85f7-c237-4465-9913-036ef6589f1f",
                                "sense_id": "80c8b128-20c5-37e3-8b70-7f213b934a9d",
                                "text": "Une personne handicapée avec le même ballot de marchandises peut être aussi riche qu’une autre, mais manque cependant de la capabilité de se déplacer librement et de réussir d’autres fonctionnements qui sont affectés par son handicap."
                            }
                        ]
                    },
                    {
                        "sense_id": "250e6cf3-3967-3f92-93b4-d8ab6a9cd690",
                        "entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "glosses": [
                            "Mesure de la capacité d’une machine à accomplir son travail conformément aux exigences du cahier des charges."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0be45d48-ca1c-33a8-9d03-f4c80f72f741",
                        "entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "glosses": [
                            "Mesure de la capacité d’un instrument de mesure ou moyen de mesure à réaliser une opération de mesure, typiquement dans le cadre d'un contrôle pour garantir le respect des tolérances de fabrication."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab1e4dd0-2601-4d32-8fd9-0acd165e1f72",
                        "source_entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "source_sense_id": "80c8b128-20c5-37e3-8b70-7f213b934a9d",
                        "source_sense_description": "Capacité",
                        "target_lang_word": "Fähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                        "entry_id": "2421fb90-d794-3e1f-9d09-fa69f961e9bd",
                                        "glosses": [
                                            "die angeborene oder erworbene Eigenschaft, zu etwas imstande zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fcfac5-bb2e-45e7-9f14-324849f0da5c",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.“"
                                            },
                                            {
                                                "example_id": "fde3d101-ab17-4116-b693-414c09f8ab94",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "„Ihre Fähigkeit, eine Art von kleinbürgerlicher Behaglichkeit um sich zu verbreiten, war erstaunlich; ebenso ihre unerschütterliche gute Laune.“"
                                            },
                                            {
                                                "example_id": "6885b197-57a5-40fd-9081-0611307606ec",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "Im Berufsleben muss man über bestimmte Fähigkeiten verfügen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9107e4f8-f82e-4cd2-9b45-0cc39a2fc358",
                        "source_entry_id": "619f43d8-1c10-3aa9-9ff7-93d4d00cddac",
                        "source_sense_id": "80c8b128-20c5-37e3-8b70-7f213b934a9d",
                        "source_sense_description": "Capacité",
                        "target_lang_word": "capability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "135095a8-a3a4-3d8b-bc01-b022da54c2a5",
                                        "entry_id": "cd25809f-df02-3c2c-a42c-ba0a17f98e6e",
                                        "glosses": [
                                            "The power or ability to generate an outcome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4315b6-78ee-4487-abdf-8159cc0cf4df",
                                                "sense_id": "135095a8-a3a4-3d8b-bc01-b022da54c2a5",
                                                "text": "And that sight will become more common in the coming years, as the city’s police pursue an ambitious campaign to install thousands of cameras to elevate their surveillance capabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f285dacc-b51d-3c4d-8468-b598c1b4d31f",
                                        "entry_id": "cd25809f-df02-3c2c-a42c-ba0a17f98e6e",
                                        "glosses": [
                                            "A digital token allowing a user or process to interact in a specified way with an object that is subject to access control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c675ba1-3257-4136-a32e-cf4722a0121c",
                                                "sense_id": "f285dacc-b51d-3c4d-8468-b598c1b4d31f",
                                                "text": "A file descriptor can be considered a capability that can only be leveraged using the appropriate system calls, passing it as an argument."
                                            },
                                            {
                                                "example_id": "87360dd0-746f-4f53-b668-eb2af4018ed4",
                                                "sense_id": "f285dacc-b51d-3c4d-8468-b598c1b4d31f",
                                                "text": "Enforcing a security policy means controlling the rights users can acquire to data. In a capability machine, a user’s rights are defined by the capabilities he (or a process acting on his behalf) can obtain and the access rights conferred by those capabilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
