                "senses": [
                    {
                        "sense_id": "6425740d-83ec-35a2-ad6a-e186b8e6bf36",
                        "entry_id": "94ad64c0-6da8-3e1d-8541-018415bde9de",
                        "glosses": [
                            "flexibles Behältnis zum Mitführen von Geld"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bad93250-5fe3-4b55-a4ec-d217f2101db9",
                                "sense_id": "6425740d-83ec-35a2-ad6a-e186b8e6bf36",
                                "text": "„…; danach stopften wir Pfeifen, Tabak und Geldkatze in Buchten und Höhlen zwischen den Postsäcken, schlossen ringsum die Vorhänge und machten es so dunkel »wie im Pansen einer Kuh«, wie der Führer es in seiner bildhaften Sprache ausdrückte.“"
                            },
                            {
                                "example_id": "5d151d13-a468-462d-9caa-f9b321af27f0",
                                "sense_id": "6425740d-83ec-35a2-ad6a-e186b8e6bf36",
                                "text": "„Jedes Schlagloch schiebt die halb geöffnete Weste über den breiten Hosenbund und gibt für Sekunden nur den Blick frei auf eine prall gefüllte Geldkatze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
