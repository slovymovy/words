                "senses": [
                    {
                        "sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                        "entry_id": "5cc536a2-a867-33b6-b46c-62f6d1dcff3f",
                        "glosses": [
                            "Bougon et grincheux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e146b5-ec8d-4983-939c-0b3fc1da4ec5",
                                "sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                                "text": "Mélenchon, lui, campe sur son non-choix ronchon."
                            },
                            {
                                "example_id": "9ebd3e02-daad-46d1-bbd4-d57a58b1b5b2",
                                "sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                                "text": "Un caractère ronchon."
                            },
                            {
                                "example_id": "5594b026-b92a-4eed-baef-9f93e110e3ac",
                                "sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                                "text": "– Ils cherchent tous à m’embobiner, dit le duc d’un air ronchon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b424744e-3c0d-4ba5-87c5-43c422a0b01b",
                        "source_entry_id": "5cc536a2-a867-33b6-b46c-62f6d1dcff3f",
                        "source_sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                        "target_lang_word": "brummig",
