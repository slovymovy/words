                "senses": [
                    {
                        "sense_id": "c97cfffa-c55b-3e9d-99c1-ca1a7f40012b",
                        "entry_id": "a8628464-24fe-3db7-9a2c-6e22ed8be386",
                        "glosses": [
                            "ostra, energiczna wymiana zdań między osobami niezgadzającymi się ze sobą"
                        ],
