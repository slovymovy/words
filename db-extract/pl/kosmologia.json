                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "космология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "527e4158-45cb-3e50-b890-e6536fb6852d",
                                        "entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                                        "glosses": [
                                            "раздел астрономии, изучающий свойства и эволюцию Вселенной в целом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "136f3416-52cb-4733-bc52-7a723236a101",
                                                "sense_id": "527e4158-45cb-3e50-b890-e6536fb6852d",
                                                "text": "Современное естествознание — физика, астрономия, космология, кибернетика, математика, информатика — поставляет все большее количество новых данных, способных пролить свет на природу времени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bd930c-2f7f-39d5-adc6-ba987ef4c684",
                                        "entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                                        "glosses": [
                                            "совокупность представлений, учение о мироздании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb682a1-a9d0-4a48-98b4-6a6fba7212e7",
                                                "sense_id": "a9bd930c-2f7f-39d5-adc6-ba987ef4c684",
                                                "text": "Её идеи представляют собой причудливую смесь из иудаизма, разного рода космологий, вегетарианства и уфологии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
