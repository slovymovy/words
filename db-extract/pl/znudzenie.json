                    {
                        "translation_id": "e19aeded-45de-421d-92f3-a5881685ab11",
                        "source_entry_id": "a91955e2-06fb-3558-bfbd-1a47323c6d68",
                        "source_sense_id": "2c628c85-8697-39b7-a610-ac862938965a",
                        "target_lang_word": "Langweile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1afc5d29-cdcb-414e-aa6c-1b1a73aafe2e",
                        "source_entry_id": "a91955e2-06fb-3558-bfbd-1a47323c6d68",
                        "source_sense_id": "2c628c85-8697-39b7-a610-ac862938965a",
                        "target_lang_word": "Langeweile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langeweile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                        "entry_id": "d318e77a-9292-35a0-af79-6d447aaf1134",
                                        "glosses": [
                                            "Gefühl der Untätigkeit, der Eintönigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207c4c5c-233a-4c37-b56f-99a9c5ed3447",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "Aus Langeweile haben schon viele Kinder Schaden angerichtet."
                                            },
                                            {
                                                "example_id": "5001a739-4611-41b8-b9a0-0df92de90692",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Die Langeweile wird in der heutigen Gesellschaft leider gar nicht geschätzt.“"
                                            },
                                            {
                                                "example_id": "26d6e442-e676-4aa8-850a-4ea8d2a468b7",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Eine Nacht und einen Tag hatte sie allein im Zimmer gewartet, hatte vor Langeweile den Sextanten auseinandergenommen, die gesammelten Pflanzen durcheinander gebracht, von dem für Präparate vorgesehenen Spiritus getrunken und ihren Rausch ausgeschlafen.“"
                                            },
                                            {
                                                "example_id": "e5b0be1d-02bc-4f27-8db9-e54ecd114836",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Auf der anderen Seite drang die Langeweile jeden Tag stärker wie tödliches Gift in mich ein.“"
                                            },
                                            {
                                                "example_id": "1026d52b-17e8-46be-ba75-6fa93bce5489",
                                                "sense_id": "699dbf56-1c0f-3512-9e30-25f439a77777",
                                                "text": "„Schlump hatte Langeweile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49298b92-ea0b-4c77-8f07-20062914377c",
                        "source_entry_id": "a91955e2-06fb-3558-bfbd-1a47323c6d68",
                        "source_sense_id": "2c628c85-8697-39b7-a610-ac862938965a",
                        "target_lang_word": "Überdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                        "entry_id": "174b1932-d097-3884-9e8f-22550755cb74",
                                        "glosses": [
                                            "Widerwille, den jemand gegenüber jemandem oder etwas empfindet, weil er sich über eine lange Zeit damit hat befassen müssen, ohne dies zu wollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3332f75c-495b-4748-a1b2-86a088821665",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Auf einmal befiel ihn ein Überdruss an seiner ganzen Sammlung von Streichholzschachteln."
                                            },
                                            {
                                                "example_id": "98c5f145-9e3a-4f9b-b51f-cc315322a5d3",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Aus unendlichem Überdruss am Leben stürzte Ottmar sich von den Klippen ins tosende Meer."
                                            },
                                            {
                                                "example_id": "c71a2905-48e7-410f-9093-4f54aad4ad62",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Wir haben das Thema nun bis zum Überdruss diskutiert und trotzdem sind wir zu keinem Ergebnis gekommen."
                                            },
                                            {
                                                "example_id": "09fecfe3-853a-491d-8993-8596dad6b08c",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Und zu ihrem Überdruss sollten die weiteren Entwicklungen Sibylle auch noch recht geben.“"
                                            },
                                            {
                                                "example_id": "d2336b68-9bbe-4a17-9541-3fda75a74a9e",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Zwischen ihr und den Straussens hatte sich nach der langen gemeinsamen Zeit eine Trägheit eingestellt, ja, fast schon Überdruss.“"
                                            },
                                            {
                                                "example_id": "277fe3b5-fd75-4b54-b7d1-610c04ba5fc6",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Doch ihr Überdruss am Dasein überwuchert alle Vorsätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
