        "fr-extract.jsonl": [
            {
                "entry_id": "5fe4502f-4b18-3e2a-824f-9b392e729895",
                "word": "vodka",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67ebf7d4-5fe6-4fcf-9630-07579cc3d9ba",
                        "entry_id": "5fe4502f-4b18-3e2a-824f-9b392e729895",
                        "tags": [
                            "plural"
                        ],
                        "form": "vodkas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6b93196-b2f4-3024-a5bf-a4d21df22beb",
                        "entry_id": "5fe4502f-4b18-3e2a-824f-9b392e729895",
                        "glosses": [
                            "Eau-de-vie à base de seigle, de blé, mais aussi de pomme de terre ou de betterave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4beb163c-f332-4f68-9de4-325ef2dbec9c",
                                "sense_id": "c6b93196-b2f4-3024-a5bf-a4d21df22beb",
                                "text": "Quant aux Russes, généralement sobres, l’infusion de thé leur suffit, paraît-il, non sans une certaine addition de « vodka », qui est l’eau-de-vie moscovite par excellence."
                            },
                            {
                                "example_id": "63790280-43c2-4a8a-8833-36d4d0e8665f",
                                "sense_id": "c6b93196-b2f4-3024-a5bf-a4d21df22beb",
                                "text": "Au retour, dans la moiteur du soir, elles entrent dans une épicerie russe, se chargent de zakouskis et de blinis. Sur le sable du salon, elles s'inventent une grignoterie arrosée de vodka aux herbes dont Aurore aime l'âpreté et la chaleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84224065-8a0a-4493-ade8-0e2d6064d001",
                        "source_entry_id": "5fe4502f-4b18-3e2a-824f-9b392e729895",
                        "source_sense_id": "c6b93196-b2f4-3024-a5bf-a4d21df22beb",
                        "target_lang_word": "Wodka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wodka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                        "entry_id": "a1e5ca14-cfff-3341-9bc8-9eb270c8937a",
                                        "glosses": [
                                            "ein Branntwein, hergestellt aus Getreide, Kartoffeln oder Melasse"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ee0b59-feac-4609-b263-7c63cd9aef1f",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "Wodka ist das russische Nationalgetränk."
                                            },
                                            {
                                                "example_id": "41390617-d510-4e89-9f06-800cebd3ba13",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Vom Wodka wurde Humboldt so schlecht, daß er zwei Tage im Bett bleiben mußte.“"
                                            },
                                            {
                                                "example_id": "50de6df7-db73-42ab-ad4e-e62accc6674c",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Dabei schmeckt Wodka nach nichts.“"
                                            },
                                            {
                                                "example_id": "4b652a2b-4efb-4854-89e1-b5102f7d6dae",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Wenn der Großvater Godny kein Geld mehr für den Wodka hatte, trank er Spiritus, den er mit etwas Wasser und Himbeersaft streckte.“"
                                            },
                                            {
                                                "example_id": "f809fee3-a54e-42aa-833e-de137d147e65",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Er war mit seinem Wodka sehr freigebig, fand ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                        "entry_id": "a1e5ca14-cfff-3341-9bc8-9eb270c8937a",
                                        "glosses": [
                                            "in ein Glas abgefüllter Branntwein [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb54739-d9cc-413e-99f3-e9a733e22465",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "Er bestellte beim Wirt einen Wodka."
                                            },
                                            {
                                                "example_id": "0c788361-01ae-4c9d-97bd-8ea0e8e7ca5b",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Ich trank meinen Wodka runter und fühlte mich seltsam unbeteiligt.“"
                                            },
                                            {
                                                "example_id": "f1b826c4-58ac-44f8-94c6-4d7dedd77b8f",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Wir opfern dieser Gelegenheit unseren beinahe letzten Bohnenkaffee, den der Gast mit Wodka anreichert; das Gespräch dauert bis weit in den Abend hinein.“"
                                            },
                                            {
                                                "example_id": "febee010-5308-4294-8cb3-dc18bf504939",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Nach dem vierten Wodka kichern wir wie zwei Teenager.“"
                                            },
                                            {
                                                "example_id": "e030b5c2-64e8-4229-a1e0-ed324b12feb5",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Nach einigen Wodkas saß ich wieder neben ihm auf dem Beifahrersitz und ließ auf dem Rückweg nach Kaliningrad die Eichenalleen an mir vorbeiziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd555493-8f6f-4803-b49f-f3f63105dab4",
                        "source_entry_id": "5fe4502f-4b18-3e2a-824f-9b392e729895",
