                "senses": [
                    {
                        "sense_id": "658515d4-8d13-36d4-85db-611b2e8003b4",
                        "entry_id": "51c95726-4998-302e-943a-668c59075099",
                        "glosses": [
                            "Introduire deux césures dans [un vers]."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6e7082f3-ed11-40fb-ad15-44aeb7c4d7ff",
                                "sense_id": "658515d4-8d13-36d4-85db-611b2e8003b4",
                                "text": "Le vers de 15 pieds se bicésure non seulement pour ce motif, mais aussi parce que cette bicésure assure un nombre égal de syllabes à chaque partie."
                            },
                            {
                                "example_id": "ab1e9a92-6212-4a2c-b8a8-f9902c7e717e",
                                "sense_id": "658515d4-8d13-36d4-85db-611b2e8003b4",
                                "text": "C'est aussi ce que suggère Izambard, qui montre Verlaine en train d'imiter Bretagne en train de scander « Et la tigresse... », alors que l'ancien professeur considère qu'il s'agit d'un vers « artistement décésuré, ou plutôt bicésuré » (Rimbaud tel que je l’ai connu, Mercure de France, 1963 (texte de 1921), p. 87)."
                            }
                        ]
                    }
