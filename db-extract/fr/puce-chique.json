                        "examples": [
                            {
                                "example_id": "c817135d-34d9-489a-9e74-c8bf78bbafe1",
                                "sense_id": "981b9582-c3e2-37c2-ad59-31f01c98f54e",
                                "text": "Ils s’efforçaient, qui avec un poinçon, qui avec la pointe d’un couteau, d’extraire de leurs orteils gonflés les puces-chiques, les affreuses larves qui s’insinuent dans les chairs, y déposent leurs œufs, y pullulent avec une vitesse sans merci, rendant inévitable, à brève échéance, l’amputation."
                            },
                            {
                                "example_id": "f8c1ee89-86c5-46d5-8ca9-c2cd6b8260b4",
                                "sense_id": "981b9582-c3e2-37c2-ad59-31f01c98f54e",
                                "text": "Depuis quelques semaines, le camp gouvernemental a fait une campagne médiatique sans précédent sur l’impact de la prolifération des puces-chiques dans la région de Toamasina."
                            },
                            {
                                "example_id": "24271b71-57d8-42c0-8fa0-e3f7f147757f",
                                "sense_id": "981b9582-c3e2-37c2-ad59-31f01c98f54e",
                                "text": "La sédentarité des villages entraîne aussi le pullulement des puces-chiques qui prend ainsi allure de fléau et provoque des ravages sur les pieds et même les mains des jeunes enfants."
                            }
                        ]
                    }
