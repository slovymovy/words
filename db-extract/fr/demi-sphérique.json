                        "sense_id": "a4fa7945-2ccc-3e3a-9910-dd1129b3d9f2",
                        "entry_id": "c45d8bee-528a-326f-bd15-462b31e75ecb",
                        "glosses": [
                            "Qui a la forme d’un hémisphère, de la moitié d’une sphère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991eec67-c609-4be0-ab18-c566f3946732",
                                "sense_id": "a4fa7945-2ccc-3e3a-9910-dd1129b3d9f2",
                                "text": "Yeux composés, demi-sphériques, sur les parties latérales de la tête, au-dessus, et en dehors des antennes."
                            },
                            {
                                "example_id": "a3ecef1c-15d4-4c41-8186-c80f2c174bd7",
                                "sense_id": "a4fa7945-2ccc-3e3a-9910-dd1129b3d9f2",
                                "text": "Il paraît difficile aussi qu’elle eût pu s’y asseoir, si l’on prenait pour l’holmos la partie demi-sphérique qui, dans quelques bas-reliefs, termine par le haut le trépied, et donne à cette partie une forme approchant de celle de la sphère."
                            },
                            {
                                "example_id": "77c97867-1b37-41bb-a381-340923eb4554",
                                "sense_id": "a4fa7945-2ccc-3e3a-9910-dd1129b3d9f2",
                                "text": "Quelque chose de demi-sphérique qui, sous le tissu d’un vêtement, ressemble fort à un nichon juvénile, mais un nichon pas du tout gambadeur et plus très chaud."
                            }
                        ]
                    }
