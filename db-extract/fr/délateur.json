                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db181c0a-4d11-304b-be3b-1388f4ded503",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs someone else about something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "A person who tells authorities about improper or illegal activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b071e531-d399-4de0-af29-be4d470bb1cb",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "Being an informer often meant living in fear."
                                            },
                                            {
                                                "example_id": "67ec682d-553b-418f-b414-451e5adb63dc",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "The police relied on an informer to catch the gang."
                                            },
                                            {
                                                "example_id": "ae006e29-ea6f-4b46-a3e6-cf9d40bff675",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "He acted as an informer during the rebellion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs, animates, or inspires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586e092e-9a14-4fc2-aa2e-63f932ce1dd3",
                                                "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                                "text": "1729, Alexander Pope, Prologue to Sophonisba (by James Thomson\nNature, informer of the poet's art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23868780-4254-4766-8f20-a38c8ef288c8",
                        "source_entry_id": "bf0dc54b-2292-3617-9d58-ee2ae5ac7851",
                        "source_sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
