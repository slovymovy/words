                ],
                "senses": [
                    {
                        "sense_id": "8991ac58-7d53-35b9-8b5e-3b08eefa4150",
                        "entry_id": "0451bc13-01a5-39b6-a123-2bece593b974",
                        "glosses": [
                            "jemand, der im Bergwerk oder beim Tunnelbau arbeitet"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "fba24d4f-08bc-4a07-ad42-963c49b27fc6",
                                "sense_id": "8991ac58-7d53-35b9-8b5e-3b08eefa4150",
                                "text": "„Gerade durch Löchern des Gotthards hat die Schweiz Pioniergeist bewiesen, so mancher Mineur blieb dafür auf der Strecke, aber das erste Loch durch den Gotthard-Scheitel war schon 1880 das längste der Welt.“"
                            },
                            {
                                "example_id": "e04d2b09-5524-452a-a6c5-3ca6ded065e6",
                                "sense_id": "8991ac58-7d53-35b9-8b5e-3b08eefa4150",
                                "text": "„ An der Ortsbrust, wo die Bergleute den Tunnel ins Gestein treiben, bereitet ein Team Kärntner Mineure die nächste Sprengung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81b5554f-60bc-3bad-b527-b6dc82eac17c",
                        "entry_id": "0451bc13-01a5-39b6-a123-2bece593b974",
                        "glosses": [
                            "Soldat, der verdeckte Gräben (Minen) für den Angriff gegen den Feind anlegt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1b2ad228-1173-4f65-87ae-9b708fc41df9",
                                "sense_id": "81b5554f-60bc-3bad-b527-b6dc82eac17c",
                                "text": "„Schlump sauste über ihn hinweg, er wußte, daß gleich ein zweites Geschoß kommen würde, er sprang um die Ecke und fiel in einen Stollen, den die Mineure gegraben hatten.“"
                            },
                            {
                                "example_id": "b3cbd6b8-d7a8-4c05-8130-31566947a101",
                                "sense_id": "81b5554f-60bc-3bad-b527-b6dc82eac17c",
                                "text": "„Für die Grabenkämpfer im Weltkrieg kann das kein schönes Leben gewesen sein, wenn sie nichts tun konnten, als abzuwarten, bis sie hochflogen, von den gegnerischen Mineuren in die luft gesprengt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7e5aba03-5707-3bda-b709-4bdf90f9fa3a",
                        "entry_id": "0451bc13-01a5-39b6-a123-2bece593b974",
                        "glosses": [
                            "Person, die auf steigende Börsenkurse setzt"
                        ],
                        "tags": [
                            "Börsenwesen"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
