                        "entry_id": "8801fd4e-4644-30bc-a239-056a706f6b6d",
                        "glosses": [
                            "Pagayeur qui pratique le kayak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b483d47-fe9d-4cdf-b481-cdf455c8680f",
                                "sense_id": "683bd250-972a-3c16-abee-1ebd09b72453",
                                "text": "Un kayakeur expérimenté vous guidera à travers les rapides déchaînés du Zambèze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a50d544-ffcf-4774-aaf5-a7c78bdc4502",
                        "source_entry_id": "8801fd4e-4644-30bc-a239-056a706f6b6d",
                        "source_sense_id": "683bd250-972a-3c16-abee-1ebd09b72453",
                        "target_lang_word": "Kajakfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kajakfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                        "entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                                        "glosses": [
                                            "Person, die ein Kajak fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea701843-6758-428f-a220-0f177903887d",
                                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                                "text": "„Vor allem, wenn im Frühling die Schneeschmelze für optimalen Wasserstand sorgt, sind mehrere Hundert Kajakfahrer pro Tag auf dem Fluss und queren die innerhalb eines engen Waldtals liegende Schlucht zu Füßen von Zugspitze und Waxenstein.“"
                                            },
                                            {
                                                "example_id": "f32070cc-b07e-4e13-abdb-352820ebe2be",
                                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                                            },
                                            {
                                                "example_id": "769e1df4-ff8b-4675-aa15-7331cedaafb9",
                                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                                "text": "„In Frankreich wurden Berichten zufolge am Sonntag die Leichen von drei Kajakfahrern gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c93df52-31a9-45ad-8b40-58e91d7fd887",
                        "source_entry_id": "8801fd4e-4644-30bc-a239-056a706f6b6d",
