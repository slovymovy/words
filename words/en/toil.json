{
    "word_family": [
        "toiler",
        "toilsome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f0a7a53-56a3-39fe-9835-541d0ea9f4cf",
                    "sense_definition": "To work extremely hard or incessantly, especially at a physically demanding task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "labor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers had to <w>toil</w> in the fields from sunrise until sunset to harvest the crops.",
                            "target_lang_translations": {
                                "ru": "Фермерам приходилось <w>трудиться</w> в полях от рассвета до заката, чтобы собрать урожай."
                            }
                        },
                        {
                            "text": "He spent years <w>toiling</w> away at his desk to finish the complex research project.",
                            "target_lang_translations": {
                                "ru": "Он провел годы, <w>вкалывая</w> за своим столом, чтобы закончить сложный исследовательский проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweat"
                    ],
                    "antonyms": [
                        "rest",
                        "relax",
                        "idle"
                    ],
                    "common_phrases": [
                        "toil away",
                        "toil in the fields"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать крайне усердно или непрерывно, особенно над физически тяжелой задачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трудиться",
                                "target_lang_sense_clarification": "усердно работать"
                            },
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "тяжело работать, разг."
                            },
                            {
                                "target_lang_word": "надрываться",
                                "target_lang_sense_clarification": "работать из последних сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "638b5d34-706d-3dc0-860c-98398bf9e418",
                    "sense_definition": "To move or proceed with great effort and difficulty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary travelers continued to <w>toil</w> up the steep mountain path despite their exhaustion.",
                            "target_lang_translations": {
                                "ru": "Утомленные путешественники продолжали <w>плестись</w> вверх по крутой горной тропе, несмотря на изнеможение."
                            }
                        },
                        {
                            "text": "The heavy cart <w>toiled</w> along the muddy road, barely moving an inch every minute.",
                            "target_lang_translations": {
                                "ru": "Тяжелая телега <w>тащилась</w> по грязной дороге, едва продвигаясь на дюйм каждую минуту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toil up the hill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или продвигаться с большим трудом и усилием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "медленно и тяжело идти"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "двигаться с трудом"
                            },
                            {
                                "target_lang_word": "пробираться",
                                "target_lang_sense_clarification": "с трудом преодолевать путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06bc1a5d-cb8c-33a1-a7a0-ded6990ff11c",
                    "sense_definition": "To exhaust or weary someone through excessive labor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exhaustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were <w>toiled</w> with the endless works of war and constant marching.",
                            "target_lang_translations": {
                                "ru": "Солдаты были <w>изнурены</w> бесконечными тяготами войны и постоянными маршами."
                            }
                        },
                        {
                            "text": "Years of heavy lifting had <w>toiled</w> his body beyond repair.",
                            "target_lang_translations": {
                                "ru": "Годы поднятия тяжестей <w>измотали</w> его тело до непоправимого состояния."
                            }
                        }
                    ],
                    "synonyms": [
                        "fatigue"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used transitively to mean exhaust"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изнурять или утомлять кого-либо чрезмерным трудом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнурять",
                                "target_lang_sense_clarification": "доводить до истощения"
                            },
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "вызывать сильную усталость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd11e06c-7010-3941-b35c-6897bb5847c0",
                    "sense_definition": "Hard, exhausting work or effort that is often grueling or repetitive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "labor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of daily <w>toil</w> in the coal mines, he finally decided to retire.",
                            "target_lang_translations": {
                                "ru": "После многих лет ежедневного <w>труда</w> в угольных шахтах он, наконец, решил уйти на покой."
                            }
                        },
                        {
                            "text": "The success of the project was the result of much <w>toil</w> and many sleepless nights.",
                            "target_lang_translations": {
                                "ru": "Успех проекта стал результатом огромных <w>усилий</w> и многих бессонных ночей."
                            }
                        }
                    ],
                    "synonyms": [
                        "drudgery",
                        "drudgework",
                        "toil"
                    ],
                    "antonyms": [
                        "leisure",
                        "ease"
                    ],
                    "common_phrases": [
                        "daily toil",
                        "years of toil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелая, изнурительная работа или усилие, часто мучительное или однообразное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труд",
                                "target_lang_sense_clarification": "тяжелая работа"
                            },
                            {
                                "target_lang_word": "тяжкая работа",
                                "target_lang_sense_clarification": "изнурительный труд"
                            },
                            {
                                "target_lang_word": "пахота",
                                "target_lang_sense_clarification": "тяжелый, изнурительный труд, перен."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "084eba14-1db9-3d1e-b286-98c26d8d1008",
                    "sense_definition": "A net, snare, or trap used to catch prey or, figuratively, to entangle someone in a difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter set the <w>toils</w> carefully in the woods to catch the wild beasts.",
                            "target_lang_translations": {
                                "ru": "Охотник осторожно расставил <w>силки</w> в лесу, чтобы поймать диких зверей."
                            }
                        },
                        {
                            "text": "She realized too late that she had been caught in the <w>toils</w> of a complex legal battle.",
                            "target_lang_translations": {
                                "ru": "Она слишком поздно поняла, что попала в <w>сети</w> сложной судебной тяжбы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught in the toils"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеть, силок или ловушка для поимки добычи или, в переносном смысле, для вовлечения кого-либо в сложную ситуацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сети",
                                "target_lang_sense_clarification": "ловушка, часто перен."
                            },
                            {
                                "target_lang_word": "силки",
                                "target_lang_sense_clarification": "приспособление для ловли птиц и зверей"
                            },
                            {
                                "target_lang_word": "тенета",
                                "target_lang_sense_clarification": "охотничья сеть, перен. путы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "470a89ec-3146-3cf5-90f7-dedc78f15674",
                    "sense_definition": "A state of trouble, strife, or conflict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nation was weary of the internal <w>toil</w> and political strife that had lasted for decades.",
                            "target_lang_translations": {
                                "ru": "Нация устала от внутренних <w>раздоров</w> и политической борьбы, длившихся десятилетиями."
                            }
                        },
                        {
                            "text": "He sought a quiet life far away from the <w>toil</w> of the city's social rivalries.",
                            "target_lang_translations": {
                                "ru": "Он искал тихой жизни вдали от <w>суеты</w> и социальных соперничеств города."
                            }
                        }
                    ],
                    "antonyms": [
                        "peace"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to strife"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние беспокойства, раздора или конфликта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "отсутствие согласия, вражда"
                            },
                            {
                                "target_lang_word": "смута",
                                "target_lang_sense_clarification": "мятеж, беспорядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0904f52-7d97-371e-bb0a-81e5ffd89202",
                    "sense_definition": "An acronym for 'time off in lieu', referring to time taken off work instead of receiving overtime pay.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I worked ten extra hours last week, so I am going to take some <w>TOIL</w> on Friday.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе я отработал десять лишних часов, поэтому в пятницу возьму <w>отгул</w>."
                            }
                        },
                        {
                            "text": "The company policy allows employees to accrue <w>TOIL</w> for any weekend events they attend.",
                            "target_lang_translations": {
                                "ru": "Политика компании позволяет сотрудникам накапливать <w>часы отгула</w> за любые мероприятия в выходные дни, которые они посещают."
                            }
                        }
                    ],
                    "synonyms": [
                        "comp time"
                    ],
                    "common_phrases": [
                        "take TOIL"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура, означающая отгул за отработанное сверхурочное время вместо денежной оплаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отгул",
                                "target_lang_sense_clarification": "время отдыха за переработку"
                            },
                            {
                                "target_lang_word": "компенсационный отпуск",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}