                        "entry_id": "198e9483-e34a-3d04-8424-126ecf1b2f83",
                        "glosses": [
                            "unerlaubtes Entfernen von einer Unfallstelle, bei der man als Fahrer eines Fahrzeuges beteiligt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9127324-790c-453e-959d-3eb5df8a7000",
                                "sense_id": "79497ab7-8022-35e4-81b2-77e82d8055c4",
                                "text": "Melde den Unfall der Polizei, anstatt Fahrerflucht zu begehen."
                            },
                            {
                                "example_id": "bf8abac4-93fc-4a70-8a87-6a990a540495",
                                "sense_id": "79497ab7-8022-35e4-81b2-77e82d8055c4",
                                "text": "„Rolf wurde von der Fahrerflucht freigesprochen.“"
                            },
                            {
                                "example_id": "6ba1a477-90cb-4572-8386-168941bd6ee3",
                                "sense_id": "79497ab7-8022-35e4-81b2-77e82d8055c4",
                                "text": "„Niemand ruft die Polizei an, um eine Fahrerflucht zu melden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3334eeab-9458-4b25-9761-96eba45ccc1b",
                        "source_entry_id": "198e9483-e34a-3d04-8424-126ecf1b2f83",
                        "source_sense_id": "79497ab7-8022-35e4-81b2-77e82d8055c4",
                        "source_sense_description": "unerlaubtes Entfernen von einer Unfallstelle, bei der man als Fahrer eines Fahrzeuges beteiligt war",
                        "target_lang_word": "hit and run",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hit and run",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a08f840-40d9-3387-9e4c-91bf13a57c4b",
                                        "entry_id": "3844486c-1509-32ec-8968-1375fa20d4f6",
                                        "glosses": [
                                            "The crime of causing a traffic collision, and leaving without acknowledging responsibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59b64fd-d56e-4b96-8a20-cd2b50308990",
                                                "sense_id": "6a08f840-40d9-3387-9e4c-91bf13a57c4b",
                                                "text": "But why don't you grab your old lady by the feet / And just lay her out in the darkest street / And by morning, she's just another hit and run"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "303903db-16fc-3862-a898-8f2077e711e1",
                                        "entry_id": "3844486c-1509-32ec-8968-1375fa20d4f6",
                                        "glosses": [
                                            "A play where the baserunners leave their base before the batter hits the ball, assuming that the batter will in fact hit the ball and this will give them an advantage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98a01330-f1a4-3c01-a80e-500ee0232776",
                                        "entry_id": "3844486c-1509-32ec-8968-1375fa20d4f6",
                                        "glosses": [
                                            "The tactic of attacking one place and then quickly moving to another before defenders can react."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918154b8-1fb7-46b3-8d19-1454bdba1b94",
                                                "sense_id": "98a01330-f1a4-3c01-a80e-500ee0232776",
                                                "text": "It used it as a launching pad of its hit and run attacks against Yugoslavia with the full—though clandestine—support of the Bulgarian Ministry of War and Fascist Italy."
                                            },
                                            {
                                                "example_id": "b03542e0-545f-4605-80a8-4ca207287ee2",
                                                "sense_id": "98a01330-f1a4-3c01-a80e-500ee0232776",
                                                "text": "In the city centre far from the stadium, what the mayor, Femke Halsema, has described as violent “hit and run” attacks on Israeli supporters by groups of local people took place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a89def5-289d-362c-b983-fea2615b689f",
                                        "entry_id": "3844486c-1509-32ec-8968-1375fa20d4f6",
                                        "glosses": [
                                            "Sexual intercourse followed by a prompt departure; a one-night stand."
                                        ],
                                        "tags": [
                                            "countable",
                                            "idiomatic",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hit and run",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e363c814-f2fb-3729-a44b-cf42471bff31",
                                        "entry_id": "e717fba3-c40f-3302-a89c-8f7609531076",
                                        "glosses": [
                                            "To hit something or someone with a vehicle and leave the scene of the incident."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32e0bf70-171a-374f-baf8-3e12da5b56e5",
                                        "entry_id": "e717fba3-c40f-3302-a89c-8f7609531076",
                                        "glosses": [
                                            "To engage in sexual intercourse followed by a prompt departure; to engage in a one-night stand."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8ce758-b3ba-4142-9635-f86bd3ffe038",
                                                "sense_id": "32e0bf70-171a-374f-baf8-3e12da5b56e5",
                                                "text": "You can't hit and run / I've got to be number one / Better make up your mind / 'Cause you'll never find a love so divine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebca7b87-6274-3805-9846-2b7ef38e3013",
                                        "entry_id": "e717fba3-c40f-3302-a89c-8f7609531076",
                                        "glosses": [
                                            "To join a poker game, quickly win several hands, then leave."
                                        ],
