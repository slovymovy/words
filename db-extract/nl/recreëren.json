                "senses": [
                    {
                        "sense_id": "6e2b3040-0316-3823-aad7-18b02703284b",
                        "entry_id": "21348ead-534f-3bce-891d-ed540e5aa7f8",
                        "glosses": [
                            "zich ontspannen, zijn vrije tijd besteden"
                        ],
