                                "target_senses": [
                                    {
                                        "sense_id": "28d30368-c9c1-33ed-b76a-d0dced2925d5",
                                        "entry_id": "bb4d01f7-21fe-3047-921c-7ed248f68edb",
                                        "glosses": [
                                            "To scatter in different directions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22fb54c7-51b9-406c-9da0-0ed649c8398b",
                                                "sense_id": "28d30368-c9c1-33ed-b76a-d0dced2925d5",
                                                "text": "The Jews are dispersed among all nations."
                                            },
                                            {
                                                "example_id": "25dd2188-9ba3-4d52-83ea-4c1449c295ca",
                                                "sense_id": "28d30368-c9c1-33ed-b76a-d0dced2925d5",
                                                "text": "The lippes of the wiſe diſperſe knowledge: but the heart of the fooliſh, doeth not ſo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11b26213-17cb-3d0e-825d-a486b8b6c595",
                                        "entry_id": "bb4d01f7-21fe-3047-921c-7ed248f68edb",
                                        "glosses": [
                                            "To break up and disappear; to dissipate."
                                        ],
                                        "tags": [
