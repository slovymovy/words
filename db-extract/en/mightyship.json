                        "examples": [
                            {
                                "example_id": "60da6729-84d4-48a4-825b-5418af333f85",
                                "sense_id": "11f181fd-25e7-3d14-85a0-f0e6a9db188d",
                                "text": "Is it fit, let your mightyship say, / That I, like some pitiful flirt, / Should tarry within doors all day, / Or else trudge it afoot in the dirt?"
                            },
                            {
                                "example_id": "ea11a039-6941-49f3-acfb-fdaa40bd1272",
                                "sense_id": "11f181fd-25e7-3d14-85a0-f0e6a9db188d",
                                "text": "To the contrary, Your Mightyship. This is Thuringia-Franconia, or have you forgotten?"
                            }
                        ]
                    }
