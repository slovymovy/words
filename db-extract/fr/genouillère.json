                                        "entry_id": "929973aa-2ac9-3cd0-a53a-e4d43f5de923",
                                        "glosses": [
                                            "gepolstertes Kleidungsstück, das man als Schutz am Knie anlegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1feba54-034f-4fb3-b0f9-976ed19bd797",
                                                "sense_id": "762add30-1735-3482-8771-61c48beb3361",
                                                "text": "Dank seiner Knieschoner erlitt er bei seinem Sturz keine Schürfwunden."
                                            },
                                            {
                                                "example_id": "a0761223-10f8-42d1-b535-cfd144cedd26",
                                                "sense_id": "762add30-1735-3482-8771-61c48beb3361",
                                                "text": "„Er hielt die Knieschoner meines Zimmergenossen hoch, um sie mir zu zeigen.“"
                                            }
                                        ],
