                "senses": [
                    {
                        "sense_id": "61fcdacb-7172-39a6-9e50-3e9f7829192d",
                        "entry_id": "95ab9928-f95a-31cb-b85b-1e910baa5b8d",
                        "glosses": [
                            "Of, pertaining to, or resembling a cyclone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28bc447-ec5e-4323-8061-39f05ed7f87d",
                                "sense_id": "61fcdacb-7172-39a6-9e50-3e9f7829192d",
                                "text": "1894, Ivan Dexter, Talmud: A Strange Narrative of Central Australia, published in serial form in Port Adelaide News and Lefevre's Peninsula Advertiser (SA), Chapter I, http://gutenberg.net.au/ebooks16/1600641.txt\nThe wind was blowing in cyclonic fashion, but not a drop of rain fell."
                            },
                            {
                                "example_id": "f8ae90bb-0152-4639-8132-11f1e2271c01",
                                "sense_id": "61fcdacb-7172-39a6-9e50-3e9f7829192d",
                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae9be874-66ae-3f06-b1fd-10fa115c26f3",
                        "entry_id": "95ab9928-f95a-31cb-b85b-1e910baa5b8d",
                        "glosses": [
                            "Rotating in the same direction as the Earth i.e. anticlockwise in the Northern Hemisphere and clockwise in the Southern Hemisphere."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "614bb9c9-fde8-48f9-855c-1da79954517e",
                        "source_entry_id": "95ab9928-f95a-31cb-b85b-1e910baa5b8d",
                        "source_sense_description": "of, pertaining to, or resembling a cyclone",
                        "target_lang_word": "cyclonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1014bd-aa71-30e2-8235-fa8873097960",
                                        "entry_id": "135ebb12-d07f-33a3-b8ce-413f008a1a2f",
                                        "glosses": [
                                            "Relatif au cyclone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55fcfa1b-e072-486f-a0d4-0d3dacab7289",
                                                "sense_id": "ec1014bd-aa71-30e2-8235-fa8873097960",
                                                "text": "Vers le soir la tempête présentait des caractères cycloniques et je pris la cape, les amures à tribord, pour m'éloigner du centre de la dépression."
                                            },
                                            {
                                                "example_id": "5bd9e8b9-2b72-4838-a5b9-32c798f45e22",
                                                "sense_id": "ec1014bd-aa71-30e2-8235-fa8873097960",
                                                "text": "Au nord du ruban, dans les creux, se trouvent des tourbillons cycloniques dont les éléments spiralent vers le centre dans le sens des aiguilles d'une montre."
                                            },
                                            {
                                                "example_id": "45718806-9086-4265-8bc1-b9df3f0db297",
                                                "sense_id": "ec1014bd-aa71-30e2-8235-fa8873097960",
                                                "text": "Les plus importants phénomènes de la météorologie revêtent la forme cyclonique."
                                            },
                                            {
                                                "example_id": "305d2c54-f98c-4986-b102-2febf73eaa76",
                                                "sense_id": "ec1014bd-aa71-30e2-8235-fa8873097960",
                                                "text": "Des alertes cycloniques ont été lancées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
