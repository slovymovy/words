                "senses": [
                    {
                        "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                        "entry_id": "c91183d8-a47f-315e-a675-48073904fabe",
                        "glosses": [
                            "italienische Stadt in Apulien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b418fd1d-15a9-4444-afdb-65479a11bf34",
                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                "text": "„Während die Flüchtlingsschiffe „Excelsior“ und „Catania“ ihre Fahrt ins apulische Taranto antraten, sollten noch am Donnerstag weitere 2000 Nordafrikaner in Lampedusa abgelegt haben.“"
                            },
                            {
                                "example_id": "6105c0b1-bc84-4ab4-9ff3-14302852596a",
                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                "text": "„Libyen deckte sein Atomwaffenprogramm auf, aus Angst vor den Amerikanern, nachdem im italienischen Taranto im Oktober 2003 das deutsche Frachtschiff \"BBC China\" mit einer Ladung Atombombenbedarf für den Wüstenstaat an die Kette gelegt worden war.“"
                            },
                            {
                                "example_id": "0be96b1d-6d12-4ea2-8e98-04941c6227bf",
                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                "text": "„Eine Untersuchung zur Häufigkeit von Krebserkrankungen aus diesem Jahr fand heraus, dass die Wahrscheinlichkeit in Taranto bis zu 190 Mal höher ist als im Landesdurchschnitt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
