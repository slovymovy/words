                                "target_senses": [
                                    {
                                        "sense_id": "a6922ede-4e93-3785-84a6-ca247216ea7e",
                                        "entry_id": "51c5fb18-d03d-3d88-8d0a-2ed781590636",
                                        "glosses": [
                                            "zweifache Bedeutung, doppelter Sinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c04b8ae-f4cb-4e55-9f40-de21301942d8",
                                                "sense_id": "a6922ede-4e93-3785-84a6-ca247216ea7e",
                                                "text": "„Und erst als ers gesprochen hatte, fiel ihm der Doppelsinn darin auf, und er gedachte der Eltern, die drunten in der Dorfkirche in großen Kupfersärgen und mit einem aufgelöteten Kruzifix darauf in der alten Gruft der Familie standen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c89a7d87-78bb-4cc1-9673-77539aff1234",
                        "source_entry_id": "17005ff3-9868-33ac-86fc-ac5cc114c27b",
