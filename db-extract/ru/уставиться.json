                    }
                ],
                "senses": [
                    {
                        "sense_id": "4acaee6e-9847-3374-b463-7893d309b381",
                        "entry_id": "bf6479ae-f7fb-3a89-882f-df24afcf4554",
                        "glosses": [
                            "разместиться, уместиться где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b38576-4ae1-4ffa-8f59-5e1eca22e4b4",
                                "sense_id": "4acaee6e-9847-3374-b463-7893d309b381",
                                "text": "Вся мебель уставилась в одной комнате."
                            },
                            {
                                "example_id": "e997a7d1-0b15-4009-92e7-e2abab99f8a2",
                                "sense_id": "4acaee6e-9847-3374-b463-7893d309b381",
                                "text": "Все книги уставились в шкафу."
                            }
                        ]
                    },
                    {
                        "sense_id": "562c41b1-d712-3b93-9e19-a47d3894fecf",
                        "entry_id": "bf6479ae-f7fb-3a89-882f-df24afcf4554",
                        "glosses": [
                            "разг. покрыться чем-либо так, что вся поверхность оказывается заставленной"
                        ],
                        "tags": [
                            "чем"
                        ],
                        "examples": [
                            {
                                "example_id": "18ef81d3-6761-4e18-9c11-197c8ac21557",
                                "sense_id": "562c41b1-d712-3b93-9e19-a47d3894fecf",
                                "text": "Поле уставилось скирдами."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bebb0d3-940f-3435-9293-179f3c7ec429",
                        "entry_id": "bf6479ae-f7fb-3a89-882f-df24afcf4554",
                        "glosses": [
                            "разг., направить, упереть что-либо куда-либо"
                        ],
                        "tags": [
                            "чем"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "56663a96-89d3-3641-b856-938f84a8d5f7",
                        "entry_id": "bf6479ae-f7fb-3a89-882f-df24afcf4554",
                        "glosses": [
                            "разг., неодобр., устремить неподвижный, пристальный взгляд на кого-либо, что-либо"
                        ],
                        "tags": [
                            "часто в сочет. с «глазами»"
                        ],
                        "examples": [
                            {
                                "example_id": "be0d3bcc-216a-4753-98f4-8a0bb37c4777",
                                "sense_id": "56663a96-89d3-3641-b856-938f84a8d5f7",
                                "text": "Уставился посоловелыми мутными глазами на Мурашкину."
                            },
                            {
                                "example_id": "f4c8da87-0466-4621-91e0-ec7d3b1282d9",
                                "sense_id": "56663a96-89d3-3641-b856-938f84a8d5f7",
                                "text": "Он уставился острыми глазами в лицо Андрея."
                            },
                            {
                                "example_id": "340ec02d-aaac-4714-b0c6-a0eff9f5cba7",
                                "sense_id": "56663a96-89d3-3641-b856-938f84a8d5f7",
                                "text": "Маркелов опять уставился на угол и жевал усы."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf21d3c-0695-318d-b517-38bb84cad287",
                        "entry_id": "bf6479ae-f7fb-3a89-882f-df24afcf4554",
                        "glosses": [
                            "устар., то же, что установиться; укрепиться, войти в действие, в силу; водвориться, наступить; закрепиться, стать устойчивым, без колебаний и перемен; осуществиться, стать постоянно действующим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa3edd4-e116-4d6b-9924-684088ca3c27",
                                "sense_id": "bbf21d3c-0695-318d-b517-38bb84cad287",
                                "text": "В народной совести уставилось решение, что больше тут злосчастия, чем лжи."
                            }
                        ]
                    }
                ],
