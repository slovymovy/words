                "senses": [
                    {
                        "sense_id": "05e96278-27a7-3ad1-a2cc-fb86d6428280",
                        "entry_id": "1a74b36f-723d-3da8-808b-a80ea4ba503a",
                        "glosses": [
                            "female equivalent of энтузиа́ст (entuziást): female enthusiast"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1e61a0bd-a3d2-4b21-8034-525bd120479a",
                                "sense_id": "05e96278-27a7-3ad1-a2cc-fb86d6428280",
                                "text": "Быть энтузиа́сткой сде́лалось её́ обще́ственным положе́нием, и иногда́, когда́ ей да́же того́ не хоте́лось, она́, что́бы не обману́ть ожида́ний люде́й, зна́вших её́, де́лалась энтузиа́сткой.",
                                "translation": "To be an enthusiast had become her social vocation and, sometimes even when she did not feel like it, she became enthusiastic in order not to disappoint the expectations of those who knew her.",
                                "english": "To be an enthusiast had become her social vocation and, sometimes even when she did not feel like it, she became enthusiastic in order not to disappoint the expectations of those who knew her."
                            }
                        ]
                    }
