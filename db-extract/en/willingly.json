                                            {
                                                "example_id": "bfea6e18-df8e-403e-897c-eaa837d2865f",
                                                "sense_id": "b8073010-cb9d-36c8-9356-481eec980bf7",
                                                "text": "De komst van hem, wiens last men willens had geschonden,\nHoe meer men wierd bedugt voor zulk een oogenblik,\nAlleen stond Fabius ontrefbaar voor de schrik."
                                            }
                                        ]
