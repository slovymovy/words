                        "entry_id": "ccf27a1f-3709-3c06-b50e-afe3e77866d0",
                        "glosses": [
                            "kleine, hilfreich nach Oben geneigte Stütze, die etwas Größeres stabilisiert und Querkräfte aufhebt/aufnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da29d1d2-851e-4057-aa1d-c6a4621f991e",
                                "sense_id": "89eea1d4-069d-3de3-9098-b98e8b3ead4c",
                                "text": "Die Strebe stabilisiert das Fachwerk."
                            },
                            {
                                "example_id": "388ae6a6-ed46-4926-aa3a-ca808b287705",
                                "sense_id": "89eea1d4-069d-3de3-9098-b98e8b3ead4c",
                                "text": "Bei Streben unterscheidet man zwischen Streben, die Druckkräfte aufnehmen können und Streben, die Zugkräfte aufnehmen können; hierbei denke man an ein Seil."
                            }
                        ],
