                                            {
                                                "example_id": "7cd21f2d-b743-4198-9e0e-e858c71b85dd",
                                                "sense_id": "0c4fc836-b12f-3874-9d5a-40b9b15a3b71",
                                                "text": "I don't know where I left my keys. They could be anywhere."
                                            },
                                            {
                                                "example_id": "6b6c1564-3b02-4c92-8cd9-40837c29f6f4",
                                                "sense_id": "0c4fc836-b12f-3874-9d5a-40b9b15a3b71",
                                                "text": "I'd rather be anywhere else."
                                            },
                                            {
                                                "example_id": "e889f6c2-4207-4817-9502-b871c3eac6af",
                                                "sense_id": "0c4fc836-b12f-3874-9d5a-40b9b15a3b71",
                                                "text": "For many 'home' is an affectation when used anywhere that 'house' would be appropriate, as in 'Home for Sale'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a5198d-9cce-30ff-8f16-ab984a3e0136",
                                        "entry_id": "33a72a44-79d1-3033-905c-92d9cc693a43",
                                        "glosses": [
                                            "To (in the direction of) any location."
