                        "sense_id": "0bef60a4-00f2-3dea-9512-afcf9ebd9ace",
                        "entry_id": "08139cbb-3e8f-38cc-aee9-ee023d248de4",
                        "glosses": [
                            "człowiek wywodzący się z Solidarności, solidarnościowiec"
                        ],
                        "tags": [
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "0b15ac17-b8f9-48d3-9067-b04402c7db54",
                                "sense_id": "0bef60a4-00f2-3dea-9512-afcf9ebd9ace",
                                "text": "Dzięki solidaruchom rozpieprzono to państwo tak, że nie produkuje niczego i żyje na pożyczkach."
                            },
                            {
                                "example_id": "d1b968e6-4e85-438a-af8b-c55f6fc91c15",
                                "sense_id": "0bef60a4-00f2-3dea-9512-afcf9ebd9ace",
                                "text": "Powstały podział na solidaruchów i komuchów jest zbyt naturalnym i głębokim, by móc zasypać i zlikwidować na dzień dzisiejszy występujące podziały."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
