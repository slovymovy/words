                        "glosses": [
                            "Type de parasite qui pratique l'holoparasitisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e354d2-e628-44f4-90d6-c25f7a36744b",
                                "sense_id": "2f225101-a915-32e2-89cc-f981ccfe6fd7",
                                "text": "D'autre part, il apparaît que même dans les génomes les plus réduits, chez les holoparasites, la région répétée inversée qui porte presque exclusivement des gènes domestiques est la mieux conservée."
                            },
                            {
                                "example_id": "58beee8e-05e8-47c5-a790-480b7c8d405d",
                                "sense_id": "2f225101-a915-32e2-89cc-f981ccfe6fd7",
                                "text": "Les plantes holoparasites n'ont pas de chlorophylle et ne font pas de photosynthèse. Elles sont parasites, possèdent un suçoir qui leur permet de se nourrir sur d'autres plantes."
                            }
                        ]
                    }
