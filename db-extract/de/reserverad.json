                                        ],
                                        "examples": [
                                            {
                                                "example_id": "954830ba-9668-43f7-9a7a-ba4e0cc0b246",
                                                "sense_id": "dd76cd56-b2a2-3177-ac66-7fe87e0098d5",
                                                "text": "Il est possible d’échouer dans un allaitement au sein. Ce n'est pas très grave, puisque le biberon est là, comme une roue de secours."
                                            },
                                            {
                                                "example_id": "5e073c52-2dfc-446d-b85d-ea6b3c723c92",
                                                "sense_id": "dd76cd56-b2a2-3177-ac66-7fe87e0098d5",
                                                "text": "Le crédit à la consommation est devenu la roue de secours de 40 % des ménages québécois … contraints de dépenser plus que leurs revenu disponible pour les dépenses courantes."
                                            }
