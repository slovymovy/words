                                    },
                                    {
                                        "sense_id": "e5fade91-5dba-3023-a643-b9d865f8d93f",
                                        "entry_id": "5efe6623-3ab3-3fce-bdc8-2eba828b4ce4",
                                        "glosses": [
                                            "Crystal meth; methamphetamine hydrochloride."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60148be4-908f-4de7-8e45-779a3eb8eb33",
                                                "sense_id": "e5fade91-5dba-3023-a643-b9d865f8d93f",
                                                "text": "He tells me he's been shooting crystal, which I already pretty much know because he does not bother to keep his sleeves rolled down over the needle tracks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583b2428-bb7c-3ab4-ab46-793040a9dbd2",
                                        "entry_id": "5efe6623-3ab3-3fce-bdc8-2eba828b4ce4",
                                        "glosses": [
                                            "A person's eye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "obsolete",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b579e4de-a228-4779-89a1-64fe16272aac",
                                                "sense_id": "583b2428-bb7c-3ab4-ab46-793040a9dbd2",
                                                "text": "Come, let's away. My loue, giue me thy Lippes: Looke to my Chattels, and my Moueables: [...] Goe, cleare they Chryſtalls. Yokefellowes in Armes, let vs to France",
                                                "translation": "Come, let's away. My love, kiss me. Look after my goods and property … Go, dry your eyes. Comrades in arms, let us to France",
                                                "english": "Come, let's away. My love, kiss me. Look after my goods and property … Go, dry your eyes. Comrades in arms, let us to France"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4405bf5-82db-307e-af44-84e6f0a312f3",
                                        "entry_id": "5efe6623-3ab3-3fce-bdc8-2eba828b4ce4",
                                        "glosses": [
                                            "The glass over the dial of a watch case."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crystal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0c3fc7-1cf3-360b-9f79-7423300ce2c4",
                                        "entry_id": "bc0e71f3-aab4-33ab-a659-eb6528f206db",
                                        "glosses": [
                                            "Made of crystal."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51aba5e5-02f1-47ac-861f-3b5acc37fa5e",
                                                "sense_id": "ff0c3fc7-1cf3-360b-9f79-7423300ce2c4",
                                                "text": "Its ceiling was crystal, around on the wall / Thickly studded were rubies and diamonds rare; / But purer than crystal, and brighter than all / Of the jewels adorning her glittering hall, / Was the mermaiden languishing there."
                                            },
                                            {
                                                "example_id": "3bf09318-3c3c-4ab9-b0b1-a2ab65fb80bf",
                                                "sense_id": "ff0c3fc7-1cf3-360b-9f79-7423300ce2c4",
                                                "text": "The walls were crystal, and they seemed to have hundreds of different-colored lights shifting behind them."
                                            },
                                            {
                                                "example_id": "8b50327b-6150-4164-aaff-9086aec30624",
                                                "sense_id": "ff0c3fc7-1cf3-360b-9f79-7423300ce2c4",
                                                "text": "The uneven floor was crystal as well, as if there once had been huge crystals jutting up here, too, but ones that had been broken away and the surface crudely adzed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb4ed1a0-617e-39c6-bd7e-27ffd2cd1d0d",
                                        "entry_id": "bc0e71f3-aab4-33ab-a659-eb6528f206db",
                                        "glosses": [
                                            "Very clear; coherent."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e02886ba-07a4-461d-a176-c9a929399d5e",
                                                "sense_id": "fb4ed1a0-617e-39c6-bd7e-27ffd2cd1d0d",
                                                "text": "\"Do I make myself clear?\" / \"Crystal.\""
                                            },
                                            {
                                                "example_id": "d277c330-ae37-4a95-a44c-2cea4db6fb3e",
                                                "sense_id": "fb4ed1a0-617e-39c6-bd7e-27ffd2cd1d0d",
                                                "text": "[…] the more faire and chriſtall is the skie,\nThe vglier ſeeme the cloudes that in it flye: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15fb7042-08ce-425d-a64b-d72fee61d757",
                        "source_entry_id": "70ecced5-b9b0-3e98-9d25-4a46155ad789",
                        "source_sense_id": "a8077f3a-2810-347b-bd83-067f56aa7d8e",
                        "source_sense_description": "een hoeveelheid ordelijk gerangschikte atomen of moleculen in vaste vorm",
                        "target_lang_word": "cristal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cristal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                        "entry_id": "03ed9e95-be08-32d1-921d-613c9379ede6",
                                        "glosses": [
                                            "Corps solide homogène composé d’atomes ou de molécules dont l’organisation dans l’espace est une répétition régulière et périodique qui définit la perfection géométrique du cristal isolé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8731b7e7-98ac-4395-84f9-345ab025e29b",
                                                "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                                "text": "Les trois échantillons sur lesquels ont porté les expériences ont été pris dans le même cristal de magnétite octaédrique (provenance d’Essex, États-Unis)."
                                            },
                                            {
                                                "example_id": "577b19fd-9add-4691-8526-33cddbe7eed4",
                                                "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                                "text": "Quand la cristallisation est achevée on sépare les cristaux de la liqueur mère qui se compose principalement d’acide oléique, on les fait recristalliser dans l’alcool à plusieurs reprises."
                                            },
                                            {
                                                "example_id": "12d8f02f-df1f-4940-81f4-09f191ff79e2",
                                                "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                                "text": "La neige en cristaux fins tombe en voltigeant comme une immense nuée de moustiques."
                                            },
                                            {
                                                "example_id": "f443c3a6-9243-4ab9-88e7-f5cf4f9ad4cb",
                                                "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                                "text": "Le thiosulfate de sodium est très soluble dans l’eau; le pentahydrate Na₂S₂O₃ 5 H₂O, qui cristallise à partir des solutions de thiosulfate, forme de gros cristaux transparents, incolores, qui fondent à 48 °C (on considère parfois que le sel s’est dissous dans son eau de cristallisation)."
                                            },
                                            {
                                                "example_id": "003327ef-464e-4d69-809c-ab0e0e3a5478",
                                                "sense_id": "26e8b27f-1dcf-3b53-b59f-5e6cacc7cd8b",
                                                "text": "Dans la contre-utopie Nous d'Evguéni Zamiatine, le cristal est le symbole du totalitarisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ff4052-710a-375e-865e-c6d3d8b4fe27",
                                        "entry_id": "03ed9e95-be08-32d1-921d-613c9379ede6",
                                        "glosses": [
                                            "Cristal de roche, synonyme de quartz transparent, non coloré."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369f7bc7-c2d2-4b59-9569-35e5dff31d1a",
                                                "sense_id": "13ff4052-710a-375e-865e-c6d3d8b4fe27",
                                                "text": "Tailler du cristal, des morceaux de cristal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                        "entry_id": "03ed9e95-be08-32d1-921d-613c9379ede6",
                                        "glosses": [
                                            "Verre à l’oxyde de plomb, transparent et clair comme le cristal de roche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635442fc-1cc5-46c6-ac56-a3ece099d5d6",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Il s’était fait faire un splendide verre en cristal de Bohême, qui jaugeait, Dieu me damne ! une bouteille de bordeaux tout entière, et il le buvait d’une haleine !"
                                            },
                                            {
                                                "example_id": "79e02fd8-616e-41dd-8b89-eed1ddf09baf",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Vous voyez ces verres de cristal, si légers qu’un mot dit à voix haute les fait vibrer, si clairs qu’un souffle les ternit... c’est le duc d’Estancourt qui les a offerts à notre mère lors de son mariage."
                                            },
                                            {
                                                "example_id": "ec36235d-6416-44e5-b858-dc00e3e114ce",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Les cordons ovigères ressemblent à de flexibles tubes de cristal, que garniraient de petites perles noires."
                                            },
                                            {
                                                "example_id": "b3d333ff-a3a6-4b8a-a7b8-38c5e4fde869",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Pour imiter le cristal de roche, les verriers cherchent à obtenir un verre incolore. Les matières premières [sont] additionnées d'un décolorant, en général du manganèse, pour annuler la coloration verte due à la présence d'oxyde de fer. Dans ce contexte, le terme cristal désigne un beau verre incolore."
                                            },
                                            {
                                                "example_id": "736a21b5-5a9d-4633-8035-e1da351e6732",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Une voix de cristal, une âme de cristal."
                                            },
                                            {
                                                "example_id": "dc689abe-6587-4a73-85f8-51c4228f9a2f",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "Se mirer dans le cristal d’une onde pure."
                                            },
                                            {
                                                "example_id": "9a6645b7-aadc-42a3-a660-c84dbf8c3c6d",
                                                "sense_id": "30655688-cbaa-31db-9bee-2717b0c114b4",
                                                "text": "C’était Mlle Préfère. Les mains jointes, elle avançait sur le miroir du parquet comme les saintes de la Légende dorée sur le cristal des eaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bce7eca-68de-3c38-b2d6-62d153027dfe",
                                        "entry_id": "03ed9e95-be08-32d1-921d-613c9379ede6",
                                        "glosses": [
                                            "Objet fait de cristal naturel ou factice."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36034b37-1d63-4791-8d1c-751f219e5fcf",
                                                "sense_id": "2bce7eca-68de-3c38-b2d6-62d153027dfe",
                                                "text": "Posséder de beaux cristaux. — Collectionneur de cristaux."
                                            },
                                            {
                                                "example_id": "13032bb0-4deb-4bdf-b213-20efe99ed0eb",
                                                "sense_id": "2bce7eca-68de-3c38-b2d6-62d153027dfe",
                                                "text": "Le timbre d'office. — On nomme ainsi l'appareil installé dans une pièce de service voisine de la salle a manger ; c'est une sorte d’évier en étain destiné au rinçage des cristaux et de l’argenterie qu'on ne descend pas à la cuisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0cbb7f7-d303-3b00-bbe5-e46a43968eb7",
                                        "entry_id": "03ed9e95-be08-32d1-921d-613c9379ede6",
                                        "glosses": [
                                            "Cristaux de soude."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
