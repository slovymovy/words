                                "target_senses": [
                                    {
                                        "sense_id": "13bb73f4-fe22-3d41-a97c-04e0ed9d5856",
                                        "entry_id": "9cae2c5c-dc33-34f1-8c8f-3972593ffe25",
                                        "glosses": [
                                            "Causing something to last longer or remain in effect longer; prolongation, continuance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e53027c-4c7c-32d9-bf55-223737f2c4be",
                                        "entry_id": "9cae2c5c-dc33-34f1-8c8f-3972593ffe25",
                                        "glosses": [
                                            "The action of proroguing an assembly, especially a parliament; discontinuance of meetings for a given period of time, without dissolution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be3945d-eb3b-4c0b-8c69-9fdb434d3029",
                                                "sense_id": "8e53027c-4c7c-32d9-bf55-223737f2c4be",
                                                "text": "There were extraordinary scenes of chaos and anger in the House of Commons overnight as opposition MPs staged a protest against the suspension of parliament for five weeks – a prorogation that the Speaker of the House said represented “an act of executive fiat”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661bb36d-accf-30f9-bf76-cbe66e71f205",
                                        "entry_id": "9cae2c5c-dc33-34f1-8c8f-3972593ffe25",
                                        "glosses": [
                                            "The period of such a discontinuance between two sessions of a legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb76be19-e8da-321a-8007-8d5868cf1304",
                                        "entry_id": "9cae2c5c-dc33-34f1-8c8f-3972593ffe25",
                                        "glosses": [
                                            "Deferral to a later time; postponement."
                                        ],
                                        "tags": [
