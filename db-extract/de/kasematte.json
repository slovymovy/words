                        ],
                        "form": "die Kasematten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
                        "entry_id": "bcd49ac5-4403-38e5-98af-5b6e050b654b",
                        "glosses": [
                            "ein schusssicherer Bunkerraum innerhalb eines Festungsraumes oder vollkommen freistehend"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "405aa854-071e-4b6b-9a54-08842b921ae3",
                                "sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
                                "text": "In Friedenszeiten dienten die Kasematten oft als Gefängnis."
                            },
                            {
                                "example_id": "f0014601-18ff-49cd-b897-baf63665c7f2",
                                "sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
                                "text": "„Beim Verlassen einer Kasematte geriet ihre Frisur etwas in Unordnung, und sie bat mich, sie ihr wieder zu richten; dabei senkte sie den Kopf, und nun konnte ich nichts mehr verbergen.“"
                            },
                            {
                                "example_id": "8915e7c9-b62b-416f-8b8f-5f3b37afc6a0",
                                "sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
                                "text": "„Das ändert sich dann später in den meterdicken Kasematten von Vincennes oder der Bastille.“"
                            },
                            {
                                "example_id": "8285c85a-96b6-424a-9118-d9b0734542f3",
                                "sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
                                "text": "„Leisten wir dem übermüdeten Wächter Gesellschaft, der auf der Burgmauer hin- und hertappt und seine in den Kasematten schnarchenden Spießgesellen beneidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b173267c-9459-3f22-8c86-ab16bded4c0b",
                        "entry_id": "bcd49ac5-4403-38e5-98af-5b6e050b654b",
                        "glosses": [
                            "durch Panzerwände gesicherter Raum zur Aufstellung von Geschützen in einem Kriegsschiff"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "53829b42-61cb-4da0-bed4-271cb027a8ca",
                                "sense_id": "b173267c-9459-3f22-8c86-ab16bded4c0b",
                                "text": "Es existierte der Typus des Kasemattschiffes, welches sich durch in zentralen gepanzerten Kasematten aufgestellte Hauptgeschütze auszeichnete."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
