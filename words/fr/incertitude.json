                    "frequency": "Low",
                    "semantic_group_id": "mesure_scientifique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le physicien a calculé l'<w>incertitude</w> liée aux instruments employés pendant l'expérience."
