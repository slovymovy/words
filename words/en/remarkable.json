                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>remarkable</w> that the two strangers had the exact same name.",
                            "target_lang_translations": {
                                "ru": "<w>Удивительно</w>, что у двух незнакомцев были совершенно одинаковые имена.",
                                "tr": "İki yabancının birebir aynı ada sahip olması <w>şaşırtıcı</w>.",
                                "zh": "这两个陌生人竟然同名，真是<w>令人惊奇</w>。",
                                "de": "Es ist <w>erstaunlich</w>, dass die beiden Fremden exakt denselben Namen hatten.",
                                "nl": "Het is <w>opmerkelijk</w> dat de twee vreemden precies dezelfde naam hadden.",
                                "pl": "To <w>zdumiewające</w>, że dwoje nieznajomych miało dokładnie takie samo nazwisko.",
                                "fr": "Il est <w>étonnant</w> que les deux inconnus portent exactement le même nom.",
                                "it": "È <w>sorprendente</w> che i due sconosciuti avessero esattamente lo stesso nome.",
                                "cs": "Je <w>pozoruhodné</w>, že ti dva cizinci měli naprosto stejné jméno.",
                                "es": "Es <w>sorprendente</w> que los dos desconocidos tuvieran exactamente el mismo nombre."
                            }
                        },
                        {
                            "text": "There is a <w>remarkable</w> similarity between the two paintings.",
                            "target_lang_translations": {
                                "ru": "Между двумя картинами существует <w>поразительное</w> сходство.",
                                "tr": "İki tablo arasında <w>göze çarpan</w> bir benzerlik var.",
                                "zh": "这两幅画之间存在着<w>惊人的</w>相似之处。",
                                "de": "Es gibt eine <w>erstaunliche</w> Ähnlichkeit zwischen den beiden Gemälden.",
                                "nl": "Er is een <w>opmerkelijke</w> overeenkomst tussen de twee schilderijen.",
                                "pl": "Między tymi dwoma obrazami istnieje <w>uderzające</w> podobieństwo.",
                                "fr": "Il y a une ressemblance <w>frappante</w> entre les deux peintures.",
                                "it": "C'è una <w>sorprendente</w> somiglianza tra i due dipinti.",
                                "cs": "Mezi těmito dvěma obrazy je <w>podivuhodná</w> podobnost.",
                                "es": "Hay una similitud <w>sorprendente</w> entre las dos pinturas."
                            }
                        }
