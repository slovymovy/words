                                        "sense_id": "3049cf02-9580-366e-9f8c-c531ad73c77d",
                                        "entry_id": "04752019-04ef-3ca8-be78-ca1a9f562070",
                                        "glosses": [
                                            "A dark green colour, like that of some wine bottles."
                                        ],
                                        "tags": [
