                        "examples": [
                            {
                                "example_id": "97ad8e23-6502-44d8-aa42-2c942f0923c5",
                                "sense_id": "d0281f44-0d46-373c-b66e-5ef64f7aa5eb",
                                "text": "Er werd een derde minder kolen gestookt en 6 procent minder gas, waardoor de uitstoot van koolstofdioxide voor elektriciteitsopwekking in de EU met bijna een kwart daalde."
                            },
                            {
                                "example_id": "fcad6445-237e-4e07-b99d-f3e95974d87f",
                                "sense_id": "d0281f44-0d46-373c-b66e-5ef64f7aa5eb",
                                "text": "Ze zijn kritisch op het kabinetsvoorstel voor een CO2-heffing en de plannen voor de ondergrondse opslag van CO2. Die noemen Milieudefensie en Greenpeace een \"schijnoplossing\". Wel zijn ze positief over onder meer de afspraken voor duurzame elektriciteitsopwekking en \"goede, nieuwe, groene banen\"."
                            },
                            {
                                "example_id": "1d0bb025-efb5-4c1a-9b3d-49ac0c26a1f4",
                                "sense_id": "d0281f44-0d46-373c-b66e-5ef64f7aa5eb",
                                "text": "Maar wat weten we verder over Bidens klimaatambities? Deze zomer presenteerde hij een plan om zo'n twee biljoen (2000 miljard) dollar te investeren in duurzame energie en vergroening. Elektriciteitsopwekking moet in 2035 CO2-neutraal zijn. In 2050 moet het hele land klimaatneutraal zijn."
                            }
                        ]
                    }
