                                            {
                                                "example_id": "c18ebde4-a82a-4e93-92d4-16fe82377c90",
                                                "sense_id": "40936449-573b-39f6-9d2c-2e07ddbc192b",
                                                "text": "Loose nodular deposits of gold metal are commonly referred to as nuggets."
                                            },
                                            {
                                                "example_id": "9358b8f1-ac5d-47c3-b398-be748f1613dc",
                                                "sense_id": "40936449-573b-39f6-9d2c-2e07ddbc192b",
                                                "text": "The disease causes nodular black growths that may become pustular."
                                            },
                                            {
                                                "example_id": "011b9ad2-a768-4cdb-af60-316a9c757bcc",
                                                "sense_id": "40936449-573b-39f6-9d2c-2e07ddbc192b",
                                                "text": "The capsule in both families is spherical, with a bistratose wall; the outer cell layer usually bears nodular thickenings[…]; the inner layer (of nearly equally large cells) lacks the regular semiannular or annular thickenings of most other leafy liverworts[…]"
