                                            {
                                                "example_id": "10fcb9a9-27b9-4a0f-8b69-9bac4e1725d7",
                                                "sense_id": "285bf471-a0d6-3a71-a543-a87c5881f2c5",
                                                "text": "김소월의 시는 자연풍을 갖고 있다."
                                            },
                                            {
                                                "example_id": "271acb93-3f8d-4e24-9271-3d31549d43ac",
                                                "sense_id": "285bf471-a0d6-3a71-a543-a87c5881f2c5",
                                                "text": "시는 크게 서정시와 서사시로 나누어진다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
