                },
                {
                    "sense_id": "43141f90-104b-305f-9b52-f1d272603f61",
                    "sense_definition": "Qui manifeste de l'anxiété, de la nervosité ou une agitation intérieure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "etat_mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient semblait très <w>agité</w> avant d'entrer dans la salle d'opération ce matin.",
                            "target_lang_translations": {
                                "en": "The patient seemed very <w>agitated</w> before going into the operating room this morning.",
                                "ru": "Пациент выглядел очень <w>взволнованным</w> перед тем, как сегодня утром зайти в операционную.",
                                "de": "Der Patient wirkte heute Morgen, bevor er den Operationssaal betrat, sehr <w>nervös</w>.",
                                "es": "El paciente parecía muy <w>nervioso</w> antes de entrar al quirófano esta mañana.",
                                "zh": "今天早上进手术室之前，病人看上去非常<w>紧张</w>。"
                            }
                        },
                        {
                            "text": "Pourquoi es-tu si <w>agité</w> depuis l'annonce de cette mauvaise nouvelle à la réunion ?",
                            "target_lang_translations": {
                                "en": "Why have you been so <w>agitated</w> since this bad news was announced at the meeting?",
                                "ru": "Почему ты так <w>взволнован</w> с тех пор, как на совещании объявили эту плохую новость?",
                                "de": "Warum bist du so <w>aufgewühlt</w>, seit auf der Besprechung diese schlechte Nachricht verkündet wurde?",
                                "es": "¿Por qué estás tan <w>agitado</w> desde que se anunció esta mala noticia en la reunión?",
                                "zh": "自从会上宣布这个坏消息以后，你为什么一直这么<w>焦躁</w>？"
                            }
                        }
                    ],
                    "synonyms": [
                        "nerveux",
                        "fébrile",
                        "inquiet",
                        "anxieux"
                    ],
                    "antonyms": [
                        "calme",
                        "posé",
                        "serein",
                        "tranquille"
                    ],
                    "common_phrases": [
                        "air agité",
                        "esprit agité",
                        "état agité"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing anxiety, nervousness or inner agitation.",
                        "ru": "Выражающий тревогу, нервозность или внутреннее волнение.",
                        "de": "Anzeichen von Angst, Nervosität oder innerer Unruhe zeigend.",
                        "es": "Que muestra ansiedad, nerviosismo o inquietud interior.",
                        "zh": "形容人因焦虑、紧张或内心不安而表现出的情绪状态。"
                    },
