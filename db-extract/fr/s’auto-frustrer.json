                ],
                "senses": [
                    {
                        "sense_id": "c6961187-a16e-3f63-ae01-5b5ab6aacb5e",
                        "entry_id": "acfbce08-2612-32bd-af1c-e40913e12a6b",
                        "glosses": [
                            "Se frustrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3698888-c097-4285-af8b-72ceef8716ec",
                                "sense_id": "c6961187-a16e-3f63-ae01-5b5ab6aacb5e",
                                "text": "Il faut dire que j'ai une fâcheuse tendance à m'auto-censurer, à m'auto-réguler ou à m'auto-frustrer pour être exact."
                            },
                            {
                                "example_id": "54623588-c578-4fcc-b9cf-cfd94b66bc42",
                                "sense_id": "c6961187-a16e-3f63-ae01-5b5ab6aacb5e",
                                "text": "C'est pas vrai que je vais m'auto-frustrer encore 10 ans."
                            },
                            {
                                "example_id": "5accdf02-0b64-45b7-81d9-49cd37471e06",
                                "sense_id": "c6961187-a16e-3f63-ae01-5b5ab6aacb5e",
                                "text": "La vie quotidienne étant déjà bien frustrante, je ne comprend pas qu'on puisse s'auto-frustrer comme cela, ça me dépasse."
                            }
                        ]
                    }
