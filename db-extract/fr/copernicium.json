            {
                "entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                "word": "copernicium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d35f4d91-a422-407c-a97b-be2f1e9dbe1d",
                        "entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "tags": [
                            "plural"
                        ],
                        "form": "coperniciums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d43056c4-b0eb-3422-971e-63d948f45862",
                        "entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "glosses": [
                            "Élément chimique portant le numéro atomique 112 et le symbole Cn, qui a été synthétisé pour la première fois en 1996 ; il appartient à la série chimique des métaux de transition."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aaa482b4-0571-4d9b-8d2a-ed9a6395257a",
                                "sense_id": "d43056c4-b0eb-3422-971e-63d948f45862",
                                "text": "En 2009, l'élément 112 a officiellement été nommé Copernicium (symbole Cp), du nom du grand astronome polonais."
                            },
                            {
                                "example_id": "5214d46f-83cb-4734-a133-50ed188382af",
                                "sense_id": "d43056c4-b0eb-3422-971e-63d948f45862",
                                "text": "Le copernicium (élément chimique de numéro atomique 112) a été synthétisé pour la première fois en février 1996 par le GSI (centre de recherche sur les ions lourds allemand, situé à Darmstadt dans le Land de Hesse)."
                            },
                            {
                                "example_id": "f719361a-07c5-4b8b-84d7-24f149cb6de4",
                                "sense_id": "d43056c4-b0eb-3422-971e-63d948f45862",
                                "text": "Cette évolution est bien illustrée par le cas de l’élément 112, le copernicium (Cn) : alors que la variante de l’élément à 112 protons et 165 neutrons (le ²⁷⁷Cn) ne dure que 0,6 milliseconde environ, la déclinaison plus lourde de 8 neutrons (le ²⁸⁵Cn) a, elle, une longévité environ 50000 fois supérieure!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5cdb95e9-e05c-3f86-ab9d-1a1c076704bd",
                        "entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "glosses": [
                            "Corps simple métallique de cet élément."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "518fef34-b860-3508-99ab-e08f8bd3ccd4",
                        "entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "glosses": [
                            "Atome (ou, par ellipse, noyau) de copernicium."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "7a53047e-70ce-49f4-afaa-c43c7a92da01",
                                "sense_id": "518fef34-b860-3508-99ab-e08f8bd3ccd4",
                                "text": "Moins d’une centaine de coperniciums ont été synthétisés à ce jour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36f828e5-9fac-4eac-8e2e-22f116af3df4",
                        "source_entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "source_sense_description": "Élément chimique, métal.",
                        "target_lang_word": "Copernicium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Copernicium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                                        "entry_id": "7ad095d7-a8cb-3fcb-a1f2-2d493cd20796",
                                        "glosses": [
                                            "das chemische Element der Ordnungszahl 112"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf5138f-3002-4e82-a0f4-6bd701bdcaac",
                                                "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                                                "text": "„Nach Pressemitteilung des Paul Scherrer Instituts im Mai 2006 ergaben Experimente, dass Copernicium sich chemisch ähnlich wie Quecksilber (Hg) verhalte.“"
                                            },
                                            {
                                                "example_id": "8c54cd09-437c-4f98-8a68-d59972065285",
                                                "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                                                "text": "„\"Copernicium\" trägt die Ordnungszahl 112. Es ist 277-mal schwerer als Wasserstoff, das leichteste aller Atome.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "440400dd-8c95-43d3-9440-7df3ab2518a1",
                        "source_entry_id": "2c6b6b9e-368d-3876-a46f-ac670dc77991",
                        "source_sense_description": "Élément chimique, métal.",
                        "target_lang_word": "copernicium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copernicium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcad35b-6b1a-3278-b0ba-409cd279980c",
                                        "entry_id": "f488475e-5779-33e3-ba4e-e67ee41da5d4",
                                        "glosses": [
                                            "The transuranic chemical element (symbol Cn) with atomic number 112."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "008978d5-d51e-48df-9293-8214a7e5c597",
                                                "sense_id": "5fcad35b-6b1a-3278-b0ba-409cd279980c",
                                                "text": "Copernicium is one of a group of superheavy elements made artificially in a particle accelerator by colliding ions into a heavymetal target; and, like the other superheavy elements, it is radioactive and decays very quickly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
