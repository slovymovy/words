                ],
                "translations": [
                    {
                        "translation_id": "bdc6b997-b2ac-4cbb-be1c-74e517bf0dfc",
                        "source_entry_id": "fbbefe9f-16f1-3e9c-9b0d-5cc4e96076cb",
                        "source_sense_id": "105ce953-f94a-3bab-8a24-2d747cdcba27",
                        "target_lang_word": "Antipode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antipode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee74e1b-0740-3ee9-8da1-322a6bf6259f",
                                        "entry_id": "c2aa3023-afaf-3554-9489-55b36e7b5db4",
                                        "glosses": [
                                            "Mensch, der auf der Gegenseite der Erde lebt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825fc3d6-0708-4edc-82ec-3c2ce945ac8c",
                                                "sense_id": "9ee74e1b-0740-3ee9-8da1-322a6bf6259f",
                                                "text": "Europas Antipoden sind die Neuseeländer."
                                            },
                                            {
                                                "example_id": "b8598ed7-3715-4465-b056-542d4ea59248",
                                                "sense_id": "9ee74e1b-0740-3ee9-8da1-322a6bf6259f",
                                                "text": "„Diese gehörte zu den beiden Schiffen, die in einer vierjährigen Reise über Kap Hoorn und die Südsee zu den Antipoden und zurück gesegelt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a65ac1ce-f5d3-3224-a52f-8e98252c2889",
                                        "entry_id": "c2aa3023-afaf-3554-9489-55b36e7b5db4",
                                        "glosses": [
                                            "Person mit völlig gegengesetzter Einstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae7cc88-b53d-4c54-a4e3-b06fad99bd38",
                                                "sense_id": "a65ac1ce-f5d3-3224-a52f-8e98252c2889",
                                                "text": "Karl ist wohl dein Antipode? Ihr scheint euch ja über nichts einig zu sein."
                                            },
                                            {
                                                "example_id": "f6aa77cb-ea10-4065-bac6-9f964f409e83",
                                                "sense_id": "a65ac1ce-f5d3-3224-a52f-8e98252c2889",
                                                "text": "„Er ist der absolute Antipode zum Reisenden.“"
                                            },
                                            {
                                                "example_id": "9a85289d-4c9c-403f-9d1b-5734dc88965e",
                                                "sense_id": "a65ac1ce-f5d3-3224-a52f-8e98252c2889",
                                                "text": "„Der Schriftseller Alfred Döblin, in den zwanziger Jahren »Großinquisitor des Atheismus« genannt, ist fromm geworden, dieser Gigantomane der deutschen Literatur, der mit seinen Romanen ein ganzes Jahrhundert erschloss, wo sein Antipode Thomas Mann das Vergangene im Gegenwärtigen abschloss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "36a47eac-4b20-309e-aa5c-34dcb3cb72f9",
                                        "entry_id": "c2aa3023-afaf-3554-9489-55b36e7b5db4",
                                        "glosses": [
                                            "auf der gegenüberliegenden Seite der Erde liegender Punkt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f81118-b6af-4334-8262-0cdb7b8c6e33",
                                                "sense_id": "36a47eac-4b20-309e-aa5c-34dcb3cb72f9",
                                                "text": "„Rund 12.756 Kilometer lang wäre ein kerzengerader Tunnel, der von einem Antipoden zum anderen führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7261ac5-d5cd-4a61-b49d-3b31a829b0c0",
                        "source_entry_id": "fbbefe9f-16f1-3e9c-9b0d-5cc4e96076cb",
                        "source_sense_id": "105ce953-f94a-3bab-8a24-2d747cdcba27",
