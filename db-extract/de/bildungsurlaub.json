                ],
                "senses": [
                    {
                        "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                        "entry_id": "b82ab99d-c3e6-38c5-a919-48b5e07f8de2",
                        "glosses": [
                            "vom Arbeitgeber bezahlte Freistellung von der Arbeit zum Zweck der beruflichen oder politischen Fortbildung (in Deutschland meist fünf Tage pro Jahr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "186df613-6c9e-41db-84f2-bd6a671d04ee",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "Von den 16 Bundesländern haben nur Sachsen und Bayern kein Gesetz, das den Anspruch auf Bildungsurlaub regelt."
                            },
                            {
                                "example_id": "a0f988b2-f842-4571-8d6a-53b842c160ea",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Was war am 1. Apr. 1974? – Als erstes deutsches Bundesland gewährt Hamburg seinen Arbeitnehmern den sog. Bildungsurlaub.“"
                            },
                            {
                                "example_id": "bd26de64-2bf7-4478-b3e1-3f59c9028578",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Unabhängig vom Jahresurlaub kann jeder Arbeitnehmer fünf Tage pro Jahr als Bildungsurlaub beantragen.“"
                            },
                            {
                                "example_id": "4479356c-8efd-43e8-9db3-4897164aede8",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„[…] Arbeitnehmer [haben] in vielen Bundesländern auch die Option, den Bildungsurlaub von zwei aufeinanderfolgenden Kalenderjahren zusammenzufassen – somit erhält man dann 10 bezahlte Arbeitstage.“"
                            },
                            {
                                "example_id": "8f6d371f-ae6d-45c6-a7d4-bab20fd07951",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Während des Bildungsurlaubs zahlt der Betrieb den Lohn weiter, die Kosten für den Kurs sowie Fahrt und Übernachtung übernimmt der Teilnehmende.“"
                            },
                            {
                                "example_id": "9e7cc71e-acfb-4eb1-a3cd-550ae37b83e2",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Wie frage ich nach Bildungsurlaub? Es kostet Überwindung, den Chef um freie Tage für die Fortbildung zu bitten.“"
                            },
                            {
                                "example_id": "436be91e-fa9a-4772-80a0-28382a6a4d2c",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Dauert ein Seminar länger als zwei Wochen, kann man auch nur einen Teil als Bildungsurlaub anerkennen lassen. Für den Rest müssen Urlaubstage eingesetzt werden.“"
                            },
                            {
                                "example_id": "8e2e9194-eb80-47bc-8cee-8755b6d31dc0",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Weiterbildung ist laut CDU Unternehmenssache: Das Bildungsfreistellungsgesetz und den darin verbrieften Bildungsurlaub will sie abschaffen.“"
                            },
                            {
                                "example_id": "2d6fe655-4b17-4c37-aed5-7ac71e2ecc88",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Ein Teilnehmer brachte seinen Missmut darüber zum Ausdruck, dass ihm sein Arbeitgeber keinen Bildungsurlaub gewährt.“"
                            },
                            {
                                "example_id": "a15777a2-f48e-490d-b0cd-dcb74c96997e",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Fernstudierende können für Präsenztage an der Hochschule häufig Bildungsurlaub beantragen“"
                            },
                            {
                                "example_id": "d679eae0-50bb-4e93-9918-0e29ed3bc1a6",
                                "sense_id": "e1a46cd0-bdc4-3991-8f55-cca5b4c031fe",
                                "text": "„Beschäftigte in Schleswig-Holstein können Bildungsurlaub ab sofort auch für reine Online- und sogenannte Hybrid-Veranstaltungen in Anspruch nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
