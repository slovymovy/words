                                "target_senses": [
                                    {
                                        "sense_id": "576938b6-ce8c-3ae9-a67f-be067ccf3e7e",
                                        "entry_id": "ac8e0535-35ae-33c8-b3c0-bb823f2c728d",
                                        "glosses": [
                                            "Consentimiento o beneplácito que se otorga a alguien para hacer, disponer o decir algo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e4594b-d3d6-4c55-bcd5-f38e16f66136",
                                                "sense_id": "576938b6-ce8c-3ae9-a67f-be067ccf3e7e",
                                                "text": "Después le pedí permiso y puse uno de aquellos discos de blues y aunque no sabía nada de inglés me di cuenta que el cantaba con esa voz ronca y negra se sentía exactamente igual que yo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85eaa4f9-664e-3ce9-aa62-908339485c2b",
                                        "entry_id": "ac8e0535-35ae-33c8-b3c0-bb823f2c728d",
                                        "glosses": [
                                            "Autorización que se concede para abandonar una actividad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18be3fb-1f22-453c-9bf5-560e19506236",
                                                "sense_id": "85eaa4f9-664e-3ce9-aa62-908339485c2b",
                                                "text": "Mi jefe me ha dado cinco días de permiso."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1363c86-b54c-3ac0-a326-84b80120c034",
                                        "entry_id": "ac8e0535-35ae-33c8-b3c0-bb823f2c728d",
                                        "glosses": [
                                            "Margen de tolerancia que se permite en la acuñación de monedas entre su peso efectivo y el que formalmente deben tener."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8ebfe83a-0f27-319f-8df3-4e31c9f2d2f1",
                                        "entry_id": "ac8e0535-35ae-33c8-b3c0-bb823f2c728d",
                                        "glosses": [
                                            "Venia o autorización para ejercer algún oficio conforme a la ley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
