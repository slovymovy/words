                                "target_senses": [
                                    {
                                        "sense_id": "0ed1f1fa-53bc-36ab-956d-34aa117e2744",
                                        "entry_id": "7b1603bf-253d-3e6b-aed0-b75129775dcd",
                                        "glosses": [
                                            "mit großer Achtsamkeit und Sorgfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2242c85f-73ba-41bf-b751-3626eb38d5b0",
                                                "sense_id": "0ed1f1fa-53bc-36ab-956d-34aa117e2744",
                                                "text": "„Sorgsam wich er den dornigen Zweigen der Sträucher aus, indem er sich niederbeugte und auf diese Weise verborgene finstere Winkel durchstöberte.“"
                                            },
                                            {
                                                "example_id": "e2b75d19-9cfa-4349-8666-415ff12130d7",
                                                "sense_id": "0ed1f1fa-53bc-36ab-956d-34aa117e2744",
                                                "text": "Besonders bei der Pflege andere sollte man den sorgsamen Umgang mit sich selbst nicht außer Acht lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3c93819-4f45-4468-bdb3-e03b4b9aa329",
                        "source_entry_id": "dc99955c-d9eb-30e3-af52-a6f13f6c5594",
