                                    {
                                        "sense_id": "a4b61c08-2e89-36ef-882d-9f5a88b77aa6",
                                        "entry_id": "e616ba74-4b6d-396c-960e-6e0b55b7002d",
                                        "glosses": [
                                            "politische Strömung, die auf den Ideen des russischen Politikers und kommunistischen Revolutionärs sowie marxistischen Theoretikers basieren, und die den Marxismus an die historischen Bedingungen der Gesellschaft des russischen Zarenreichs anpasste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c465a9-2693-41ef-a73d-7e16c9899f46",
                                                "sense_id": "a4b61c08-2e89-36ef-882d-9f5a88b77aa6",
                                                "text": "„Mugabe übernahm die Verschleierung, jedoch ohne den ideologischen Gehalt des Leninismus.“"
                                            }
