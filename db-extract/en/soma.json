                    {
                        "sense_id": "db531232-0448-3d94-b357-23ca401a2086",
                        "entry_id": "ba1b103b-6aa4-30ca-a57a-20900ef3a338",
                        "glosses": [
                            "A ritual drink in ancient Vedic culture, obtained by pressing the Soma plant."
                        ],
                        "tags": [
                            "Vedic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "325b4d91-5632-4d0b-b43b-62bb1c54c058",
                                "sense_id": "db531232-0448-3d94-b357-23ca401a2086",
                                "text": "Once he had drunk the intoxicating soma, he experienced an ascent to the gods without having to die a violent death, as in the old ritual."
                            }
                        ]
                    },
                    {
                        "sense_id": "00f63062-0d87-3932-b31c-077962c1f6da",
                        "entry_id": "ba1b103b-6aa4-30ca-a57a-20900ef3a338",
                        "glosses": [
                            "Any kind of intoxicating drug."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c75b034-51bf-4f3b-a04b-e8284facb14f",
                                "sense_id": "00f63062-0d87-3932-b31c-077962c1f6da",
                                "text": "[…] there is always soma, delicious soma, half a gramme for a half-holiday, a gramme for a week-end, two grammes for a trip to the gorgeous East, three for a dark eternity on the moon […]"
                            }
                        ]
                    }
