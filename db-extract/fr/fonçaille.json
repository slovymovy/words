                    {
                        "sense_id": "7ca48f9e-d324-376d-b65e-0e48871a7e60",
                        "entry_id": "e25d7c88-1af4-334b-b3cc-2b79241d183d",
                        "glosses": [
                            "Barre de bois qui porte la paillasse d’un lit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d04179e-1ab8-4687-b0b6-44ea66f852d4",
                                "sense_id": "7ca48f9e-d324-376d-b65e-0e48871a7e60",
                                "text": "Le chef de famille prie un jeune couple en pleine santé et bon producteur de planter la perche de bambou derrière sa maison, ou bien il s'en sert comme fonçailles de son lit."
                            },
                            {
                                "example_id": "541cbd2d-020a-48d2-8d5e-bfb4fe385b59",
                                "sense_id": "7ca48f9e-d324-376d-b65e-0e48871a7e60",
                                "text": "Une métayère, faisant devant moi l’éloge de son cher matou, assurait qu’il ne se passait pas une journée où il ne rapportât du dehors lapineau ou levraut, qu’on lui entendait croquer, en grommelant, sous la fonçaille du lit."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eb201a0-6f63-396c-a702-3568cfc30404",
                        "entry_id": "e25d7c88-1af4-334b-b3cc-2b79241d183d",
                        "glosses": [
                            "Planche utilisée pour former le fond d’une barrique ou d’un fût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d65f96-6952-4953-a639-1906f8c98f07",
                                "sense_id": "8eb201a0-6f63-396c-a702-3568cfc30404",
                                "text": "Le merrain était du bois de tonnellerie ébauché en douves et fonçailles, ces dernières constituant les éléments des fonds des barriques."
                            },
                            {
                                "example_id": "67e77ae9-7dcb-492c-a865-255f834834b4",
                                "sense_id": "8eb201a0-6f63-396c-a702-3568cfc30404",
                                "text": "Pour les barriques de 225 litres, utilisées dans le bordelais, le quart se compte toujours pour 300 pièces le longailles et 20 pièces de fonçailles, sachant que 2 pièces de fond équivalent à une longaille ou douve."
                            }
                        ]
                    }
