    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5a5c6fe6-264b-3ab3-978c-dda5ecfc2c30",
                    "sense_definition": "Kurzform für <w>auf Wiederhören</w>; Abschiedsgruß am Telefon",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Danke für das nette Gespräch, <w>wiederhören</w> und einen schönen Tag noch!",
                            "target_lang_translations": {
                                "en": "Thank you for the nice conversation, <w>bye</w> and have a nice day!"
                            }
                        },
                        {
                            "text": "Ich muss jetzt leider auflegen, also dann: <w>wiederhören</w>!",
                            "target_lang_translations": {
                                "en": "Unfortunately I have to hang up now, so: <w>talk to you later</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "tschüss"
                    ],
                    "antonyms": [
                        "hallo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Verkürzte Grußformel am Telefon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "short form for 'auf Wiederhören'; farewell said on the phone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bye",
                                "target_lang_sense_clarification": "informal farewell on the phone"
                            },
                            {
                                "target_lang_word": "talk to you later",
                                "target_lang_sense_clarification": "farewell on the phone"
                            },
                            {
                                "target_lang_word": "goodbye",
                                "target_lang_sense_clarification": "farewell on the phone"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2731026-252a-35fa-8848-280b600f7eb9",
                    "sense_definition": "das erneute Hören von etwas oder das erneute Sprechen mit jemandem (besonders am Telefon)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vielen Dank für Ihren Anruf, auf <w>Wiederhören</w>!",
                            "target_lang_translations": {
                                "en": "Thank you very much for your call, <w>goodbye</w>!"
                            }
                        },
                        {
                            "text": "Beim <w>Wiederhören</w> dieser alten Aufnahme bemerkte sie viele neue Details.",
                            "target_lang_translations": {
                                "en": "Upon <w>listening again</w> to this old recording, she noticed many new details."
                            }
                        }
                    ],
                    "common_phrases": [
                        "auf Wiederhören"
                    ],
                    "target_lang_definitions": {
                        "en": "hearing something again or speaking with someone again (especially on the phone)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "goodbye",
                                "target_lang_sense_clarification": "in 'auf Wiederhören' (on the phone)"
                            },
                            {
                                "target_lang_word": "listening again",
                                "target_lang_sense_clarification": "hearing a recording or sound again"
                            },
                            {
                                "target_lang_word": "rehearing",
                                "target_lang_sense_clarification": "hearing something again"
                            }
                        ]
                    }
                }
            ]
        }
    ]
