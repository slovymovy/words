{
    "word_family": [
        "grisliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0277d6ae-1cd5-3053-bed2-11415fba6137",
                    "sense_definition": "Horrifyingly repellent, gruesome, or terrifying, especially involving death or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horrifying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived at the crime scene to find a <w>grisly</w> sight that they would never forget.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла на место преступления и обнаружила <w>жуткое</w> зрелище, которое они никогда не забудут."
                            }
                        },
                        {
                            "text": "The news report provided <w>grisly</w> details about the accident that occurred on the highway last night.",
                            "target_lang_translations": {
                                "ru": "В репортаже новостей приводились <w>ужасающие</w> подробности аварии, произошедшей на шоссе вчера вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "gruesome",
                        "ghastly",
                        "horrific",
                        "macabre"
                    ],
                    "antonyms": [
                        "pleasant",
                        "delightful"
                    ],
                    "common_phrases": [
                        "grisly details",
                        "grisly murder",
                        "grisly discovery",
                        "grisly scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ужасающий, вызывающий отвращение или жуткий, особенно в контексте смерти или увечий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "вызывающий страх и отвращение"
                            },
                            {
                                "target_lang_word": "ужасающий",
                                "target_lang_sense_clarification": "крайне страшный"
                            },
                            {
                                "target_lang_word": "леденящий душу",
                                "target_lang_sense_clarification": "о подробностях или сценах"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий физическое неприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cde9db9-f26b-3e29-a32c-c630df6b16d6",
                    "sense_definition": "An obsolete form of <w>grizzly</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "variant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old journals, the explorer described encountering a <w>grisly</w> bear during his travels.",
                            "target_lang_translations": {
                                "ru": "В старых дневниках исследователь описывал встречу с медведем <w>гризли</w> во время своих путешествий."
                            }
                        },
                        {
                            "text": "The antique book mentions <w>grisly</w> squirrels that turn grey as they age.",
                            "target_lang_translations": {
                                "ru": "В антикварной книге упоминаются <w>серые</w> белки, которые седеют с возрастом."
                            }
                        }
                    ],
                    "synonyms": [
                        "grizzly"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in historical texts instead of grizzly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова grizzly (сероватый, с проседью)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "устаревшее написание grizzly"
                            },
                            {
                                "target_lang_word": "седоватый",
                                "target_lang_sense_clarification": "о цвете шерсти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f67eecb-3e8b-3cd6-897d-9cbf7858dab8",
                    "sense_definition": "A misspelling of <w>gristly</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He complained that the steak was <w>grisly</w>, though he actually meant it contained too much cartilage.",
                            "target_lang_translations": {
                                "ru": "Он жаловался, что стейк был <w>хрящеватым</w>, хотя на самом деле он имел в виду, что в нем слишком много хрящей."
                            }
                        },
                        {
                            "text": "It is a common error to write <w>grisly</w> when describing tough, chewy meat.",
                            "target_lang_translations": {
                                "ru": "Часто ошибочно пишут <w>grisly</w>, описывая жесткое, жилистое мясо."
                            }
                        }
                    ],
                    "synonyms": [
                        "gristly"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "erroneous spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание слова gristly (хрящеватый)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрящеватый",
                                "target_lang_sense_clarification": "ошибочное написание gristly"
                            },
                            {
                                "target_lang_word": "жилистый",
                                "target_lang_sense_clarification": "о мясе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "61752b94-7068-31f3-836f-1af790e09801",
                    "sense_definition": "In a horrible, terrible, or terrifying manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "horrifying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The creature's face was <w>grisly</w> changed by the curse, making it a terrible sight to behold.",
                            "target_lang_translations": {
                                "ru": "Лицо существа было <w>ужасающе</w> изменено проклятием, превратив его в страшное зрелище."
                            }
                        },
                        {
                            "text": "The two armies got so <w>grisly</w> together in the narrow pass that the ground was soon covered in blood.",
                            "target_lang_translations": {
                                "ru": "Две армии сошлись в узком проходе так <w>яростно и страшно</w>, что земля вскоре была покрыта кровью."
                            }
                        }
                    ],
                    "synonyms": [
                        "horribly",
                        "terribly",
                        "grimly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adverb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ужасным, страшным или пугающим образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "пугающим образом"
                            },
                            {
                                "target_lang_word": "жутко",
                                "target_lang_sense_clarification": "вызывая страх"
                            }
                        ]
                    }
                }
            ]
        },
        {
