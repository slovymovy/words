                    }
                ],
                "senses": [
                    {
                        "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                        "entry_id": "b92cbb6c-2960-3c60-8c90-57aa486a55fc",
                        "glosses": [
                            "so, dass es überwunden werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2127bc-8f25-4c89-ae1d-c2550450697a",
                                "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                                "text": "„Wenn er wenige Meilen südlich die Hügel zu überschreiten versucht hätte, würde er die Straße gefunden haben, die von der Ranch der Jordans in bequemen Kurven über die Berge führte, aber die Abhänge, die gerade über ihm lagen, waren kaum überwindlich.“"
                            },
                            {
                                "example_id": "5c9cb8f7-d458-443f-baae-9cccad9df4fa",
                                "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                                "text": "„Was wäre ein Sieg in der Diplomatie oder in der Liebe ohne Hindernisse, sagte Herr Rosel, und wo ist ein Hinderniß, das für den Herrn Marquis nicht überwindlich wäre!“"
                            },
                            {
                                "example_id": "3f9d74de-abbf-4f19-9962-bd8edca7d224",
                                "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                                "text": "„Alles schien ihm leicht und überwindlich und frischen Mutes faßte er an seinem Geburtstage den »festen Vorsatz«, sich als ein tüchtiger Mensch in das neue Leben und Wirken zu finden.“"
                            },
                            {
                                "example_id": "4caa5356-00aa-49ed-8828-9ae764b1bdac",
                                "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                                "text": "„Alles Widerwärtige, Feindselige, das ihm begegnet war, hatte sich packen und ordnen oder umgehen lassen, war zuletzt klar und überwindlich geworden.“"
                            },
                            {
                                "example_id": "00d83742-b821-4388-8e8a-1faa4a14056c",
                                "sense_id": "c68ae21e-c2d4-348c-9399-5f06166c3630",
                                "text": "„Der Stolz des anderen erwies sich nun als recht leicht überwindlich. »Wenn du dies Duwort so schmeichelhaft motivierst«, sagte er lächelnd, »da muss ich dir wohl hierin gleich nachkommen«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
