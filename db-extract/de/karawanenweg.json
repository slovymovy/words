                "senses": [
                    {
                        "sense_id": "f01d8abc-784e-3f46-a2d8-759f30697c7b",
                        "entry_id": "5467efee-a1bc-3d9c-99af-acdd1ee6a13e",
                        "glosses": [
                            "Weg, den Karawanen nutzen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d298e290-dc6c-4d8f-8048-6f138384713c",
                                "sense_id": "f01d8abc-784e-3f46-a2d8-759f30697c7b",
                                "text": "„Händlern aus Benin werden wichtige Privilegien eingeräumt, so kontrollieren sie schließlich die Routen in den Norden, die zu den Karawanenwegen durch die Sahara führen.“"
                            },
                            {
                                "example_id": "8214e23a-f1c2-4d96-9607-5b9dda67f403",
                                "sense_id": "f01d8abc-784e-3f46-a2d8-759f30697c7b",
                                "text": "„Die Berber gründen in der Folgezeit eigene Königreiche, die durch die Kontrolle der Karawanenwege in der Sahara reich werden.“"
                            },
                            {
                                "example_id": "1dac6814-f3b3-4c91-b6d7-e46af30e166e",
                                "sense_id": "f01d8abc-784e-3f46-a2d8-759f30697c7b",
                                "text": "„Wir fuhren zuerst landeinwärts, weg von der Küste bei Gaza, fuhren auf Karawanenwegen in die Wüste, schwenkten dann um, fuhren nordwärts, machten einen weiten Bogen und stießen zur Küste zurück.“"
                            },
                            {
                                "example_id": "0b168fee-1ed1-4d0d-9990-4fa2d9afb955",
                                "sense_id": "f01d8abc-784e-3f46-a2d8-759f30697c7b",
                                "text": "„Die wenigen Städte bildeten die wesentlichen Stationen an den Karawanenwegen und waren Teil des kosmopolitischen Handelsnetzwerks der Seidenstraße, während die ländlichen Regionen sich weitgehend selbst überlassen blieben und nur in geringem Austausch mit den urbanen Zentren standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
