                        "sense_id": "6de46085-e5ab-3f68-9e26-ba80293d59d7",
                        "entry_id": "d4eecd3c-8b89-3da0-a026-3ca9d5167c0d",
                        "glosses": [
                            "Flowing back."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "9fddc27e-4a94-44e4-8365-a86d8de20f5e",
                                "sense_id": "6de46085-e5ab-3f68-9e26-ba80293d59d7",
                                "text": "[…] let them cast it [my soul] downe\nWhere refluent Oceanus doth crowne\nHis curled head;"
                            },
                            {
                                "example_id": "bfcc19a4-5e49-489a-ae8d-d109f614eb51",
                                "sense_id": "6de46085-e5ab-3f68-9e26-ba80293d59d7",
                                "text": "When the muscles of the heart cease to act, the refluent blood again distends or elongates them;"
                            },
                            {
                                "example_id": "39139da0-53f5-4872-9c06-f2462aecd5ad",
                                "sense_id": "6de46085-e5ab-3f68-9e26-ba80293d59d7",
                                "text": "[…] in haste the refluent ocean\nFled away from the shore, and left the line of the sand-beach\nCovered with waifs of the tide, with kelp and the slippery sea-weed."
                            },
                            {
                                "example_id": "1b8f8f7d-a81e-4566-ad82-59e98a841aa3",
                                "sense_id": "6de46085-e5ab-3f68-9e26-ba80293d59d7",
                                "text": "now floods back refluent like a tide, the red, thick stream of life again"
                            }
                        ]
                    }
                ],
