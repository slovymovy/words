                    }
                ],
                "senses": [
                    {
                        "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                        "entry_id": "b9e6487a-4d15-3d88-9182-86776f8b9574",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b410cd7-164e-4627-b929-03189049ea5f",
                                "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                                "text": "Alicja sama sobie zaprojektowała ten niespotykany ubiór."
                            },
                            {
                                "example_id": "838a94eb-17f3-4f22-a913-2d552a77e252",
                                "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                                "text": "U nas propozycje małżeńskie składa się przeważnie mimochodem w łóżku, pod zgubnym wpływem seksualnego zadowolenia. Ale co było robić? Zwabić Alicję do mego pokoiku i zgwałcić na tapczanie Renaty?"
                            },
                            {
                                "example_id": "fdfebe46-ea9e-4d0f-a84b-d87f18154818",
                                "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                                "text": "Alicja, chociaż nieśmiała, z początku bardzo serdeczna, także się zmieniła."
                            },
                            {
                                "example_id": "984f62ad-f0b2-4d8c-9633-cf602a22abba",
                                "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                                "text": "Elżbieta kończyła doprawiać specjalnym sosem surówkę z różnorakich warzyw i owoców, a Alicja już zaczęła nakrywać stół kolorowym obrusem."
                            },
                            {
                                "example_id": "8f26e983-0509-4bf9-8dc7-627c8e34a62d",
                                "sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                                "text": "Po powrocie do hotelu Alicja nie czuła nóg. Wyszli z muzeum o pierwszej, kiedy je zamykano, jako jedni z ostatnich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1448a0c-9568-4a35-8ad0-18af9c5039b7",
                        "source_entry_id": "b9e6487a-4d15-3d88-9182-86776f8b9574",
                        "source_sense_id": "b25af8eb-564c-3279-95ee-dba3abea63c9",
                        "target_lang_word": "Alice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2b721d2-0ec8-3076-a247-b83e2ae5b3b5",
                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "A female given name from the Germanic languages popular in England since the Middle Ages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478dc04e-e634-4421-b2b1-e39a98425c22",
                                                "sense_id": "d2b721d2-0ec8-3076-a247-b83e2ae5b3b5",
                                                "text": "\"My name is Alice, but—\"\n\"It's a stupid name enough!\" Humpty Dumpty interrupted impatiently. \"What does it mean?\"\n\"Must a name mean something?\" Alice asked doubtfully.\n\"Of course it must,\" Humpty Dumpty said with a short laugh, \"my name means the shape I am—and a good handsome shape it is, too. With a name like yours, you might be any shape, almost.\""
                                            },
                                            {
                                                "example_id": "cfe3d9b7-bed6-444c-943f-0b2db06c8bf2",
                                                "sense_id": "d2b721d2-0ec8-3076-a247-b83e2ae5b3b5",
                                                "text": "She was heavenly to look at, and graceful, both in and out of water. She was a sculptress. She was christened 'Alice', but she used to deny that she was really an Alice. I agreed. Everybody agreed. Sometime in a dream maybe I will find out what her real name was."
                                            },
                                            {
                                                "example_id": "9bad4b08-8e7e-4822-af0a-31a892bc0fb4",
                                                "sense_id": "d2b721d2-0ec8-3076-a247-b83e2ae5b3b5",
                                                "text": "Party leader Alice Weidel has already hailed the coalition’s collapse as a “liberation” for Germany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ba46776-9216-34d5-8628-6d9ac5403e59",
                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "The person or system that sends a message to another person or system conventionally known as Bob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb3a2b46-1a28-407d-9113-fe3290d48aee",
                                                "sense_id": "0ba46776-9216-34d5-8628-6d9ac5403e59",
                                                "text": "Alice sends the message, \"I am Alice,\" to Bob. Bob chooses a nonce, N and sends it to Alice. Alice encrypts the nonce using Alice and Bob's symmetric secret key, K#95;#123;A-B#125;, and sends the encrypted nonce, K#95;#123;A-B#125;(N) back to Bob."
                                            },
                                            {
                                                "example_id": "c0ce446f-52a9-4cc9-9c98-38e2fd956384",
                                                "sense_id": "0ba46776-9216-34d5-8628-6d9ac5403e59",
                                                "text": "Alice opens her lantern, Bob opens his the instant he sees Alice's, and Alice notes the time T that passes between the moment she opens hers and the moment she sees the light returning to her from Bob's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e778e0-1543-3207-a0f6-0f6ee8f39b04",
                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "The city of Alice Springs, Australia."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "often",
                                            "slang",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c25ec23-ea0c-4a6b-8cb8-e88d7df0c447",
                                                "sense_id": "f7e778e0-1543-3207-a0f6-0f6ee8f39b04",
                                                "text": "At that point in my second visit to the Alice, I'd been there only a day.[…] they're doing Australia in two weeks, with a few days each for Sydney, the Alice and the Rock, Kakadu and Cairns."
                                            },
                                            {
                                                "example_id": "898ba6b4-1ea7-4eaa-a318-d4384cb16510",
                                                "sense_id": "f7e778e0-1543-3207-a0f6-0f6ee8f39b04",
                                                "text": "In 1892 my Chinese grandfather lived in Alice."
                                            },
                                            {
                                                "example_id": "1774ea1d-7673-40c6-bc09-381388e8f92e",
                                                "sense_id": "f7e778e0-1543-3207-a0f6-0f6ee8f39b04",
                                                "text": "\"Don't waste yer time in The Alice, get out and see the country — that's what yer 'ere for.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae503ef-3655-3da2-983b-5047d6ab6443",
                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "A city in North Dakota."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba14eb97-61d6-3411-8183-36373d43fbf0",
                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "A city, the county seat of Jim Wells County, Texas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
