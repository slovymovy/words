                "senses": [
                    {
                        "sense_id": "d59a34c0-8664-30b3-8b5b-6d310ffea78b",
                        "entry_id": "961d9229-d0e5-3c49-818d-6cbbdacc314f",
                        "glosses": [
                            "Nom donné en Abyssinie à un arbre dont le nom est Albizia anthelmintica, l'écorce de cet arbre est un vermifuge, anthelmintique utilisé par les populations locales. De cette écorce a été extraite la musénine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319f01c6-e7a3-4482-bbd0-2946f325b372",
                                "sense_id": "d59a34c0-8664-30b3-8b5b-6d310ffea78b",
                                "text": "L'écorce de musenna ou moucenna est extrêmement rare dans le commerce, elle se présente sous la forme de tuyaux de 0ᵐ,15 à 0ᵐ,20 de long et de 0ᵐ,03 à 0ᵐ,06 de large."
                            }
                        ]
                    },
                    {
                        "sense_id": "767a8fce-aacf-37e0-8840-a66abff8bf08",
                        "entry_id": "961d9229-d0e5-3c49-818d-6cbbdacc314f",
                        "glosses": [
                            "Écorce de l'arbre Albizia anthelmintica, qui a des propriétés vermifuges."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf1ae48-90af-4bb7-80ef-25c1b540e4f3",
                                "sense_id": "767a8fce-aacf-37e0-8840-a66abff8bf08",
                                "text": "Le musenna est exempt de tous ces inconvénients. C'est l'écorce d'un arbre qui croît près de la mer Rouge, dans les environs de Muçawwa."
                            }
                        ]
                    }
