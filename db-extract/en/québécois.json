            {
                "entry_id": "94df0ce0-2b05-3b8f-b77d-d9610f4d57db",
                "word": "Québécois",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "94d6e77c-24a9-4f19-b6e4-421833b11da8",
                        "entry_id": "94df0ce0-2b05-3b8f-b77d-d9610f4d57db",
                        "tags": [
                            "plural"
                        ],
                        "form": "Québécois"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0d77b11-a6ae-36d7-8cb9-944021c25e9f",
                        "entry_id": "94df0ce0-2b05-3b8f-b77d-d9610f4d57db",
                        "glosses": [
                            "A native or inhabitant of the province of Quebec, Canada or the Quebec City, Quebec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8337dffc-6e88-4c2c-bacf-00d54ca3e639",
                                "sense_id": "a0d77b11-a6ae-36d7-8cb9-944021c25e9f",
                                "text": "I am a proud Québécois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e10e32-2438-425c-a711-5cac31a66295",
                        "source_entry_id": "94df0ce0-2b05-3b8f-b77d-d9610f4d57db",
                        "source_sense_id": "a0d77b11-a6ae-36d7-8cb9-944021c25e9f",
                        "source_sense_description": "native or inhabitant of the province or city of Quebec",
                        "target_lang_word": "Québécois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Québécois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbff662d-c192-3343-ac64-78b8a8c5b415",
                                        "entry_id": "77c86fe1-883e-3205-ac29-53ae557f829d",
                                        "glosses": [
                                            "Citoyen de la province de Québec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440b0612-b93d-42b0-9543-6764a46eabb6",
                                                "sense_id": "dbff662d-c192-3343-ac64-78b8a8c5b415",
                                                "text": "Je n’ai jamais pensé que je pourrais être aussi fier d’être Québécois."
                                            },
                                            {
                                                "example_id": "e06e387f-5f01-4042-8165-4b126f3720af",
                                                "sense_id": "dbff662d-c192-3343-ac64-78b8a8c5b415",
                                                "text": "Or, à partir des années 1960 et pour des raisons bien connues qu’il est inutile de détailler, les Québécois ont cessé de se penser comme des minoritaires canadiens-français au Canada, mais se sont mis plutôt à se voir comme des Québécois, majoritaires dans leur province. Ce changement a été vécu amèrement à l’extérieur du Québec."
                                            },
                                            {
                                                "example_id": "33ef29c3-aefd-41b1-a2db-409369ca18a5",
                                                "sense_id": "dbff662d-c192-3343-ac64-78b8a8c5b415",
                                                "text": "La trempette que tous les Québécois ont goûtée au moins une fois dans leur vie arrive sur le marché en formule déjà mélangée. Oui, la mayochup, heureuse rencontre entre la mayonnaise et le ketchup, existe."
                                            },
                                            {
                                                "example_id": "e880b2a9-5a10-48d6-8a84-ace334b68d15",
                                                "sense_id": "dbff662d-c192-3343-ac64-78b8a8c5b415",
                                                "text": "Comme bien des Québécois, au vu des actions récentes du gouvernement Trump, j’ai moi aussi décidé de claquer la porte à la culture américaine et à ses multinationales. Au revoir, Amazon, Netflix et compagnie. On regardera des émissions québécoises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a433a2-5029-312f-b9e2-108cb29e4bbc",
                                        "entry_id": "77c86fe1-883e-3205-ac29-53ae557f829d",
                                        "glosses": [
                                            "Citoyen de la ville de Québec. → voir Québecquois"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
