                "senses": [
                    {
                        "sense_id": "0016cd7d-ca94-390f-b68c-2dbf8985b8e8",
                        "entry_id": "f5bda0a2-e012-308d-aee5-a60fc3886ce0",
                        "glosses": [
                            "Anbetung, Verehrung"
                        ],
                        "tags": [
