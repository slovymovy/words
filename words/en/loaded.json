                {
                    "sense_id": "49772b1f-4492-36d0-a008-38b9de0aacfb",
                    "sense_definition": "Phrased in a way that implies a specific answer or sets a trap for the respondent.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "biased",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporter asked a <w>loaded</w> question to try and trick the politician.",
                            "target_lang_translations": {
                                "ru": "Репортер задал <w>провокационный</w> вопрос, чтобы попытаться обмануть политика.",
                                "zh": "记者提出了一个<w>诱导性</w>问题，试图诱骗这位政治家。"
                            }
                        },
                        {
                            "text": "Asking someone \"Have you stopped lying?\" is a classic example of a <w>loaded</w> question.",
                            "target_lang_translations": {
                                "ru": "Спросить кого-то «Вы перестали лгать?» — это классический пример <w>провокационного</w> вопроса.",
                                "zh": "问别人“你停止撒谎了吗？”是<w>诱导性</w>问题的典型例子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leading"
                    ],
                    "antonyms": [
                        "neutral",
                        "fair"
                    ],
                    "common_phrases": [
                        "loaded question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформулированный так, чтобы подразумевать определенный ответ или поставить в тупик.",
                        "zh": "措辞方式暗示特定答案或为受访者设下陷阱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провокационный",
                                "target_lang_sense_clarification": "о вопросе"
                            },
                            {
                                "target_lang_word": "с подвохом",
                                "target_lang_sense_clarification": "содержащий скрытую ловушку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱导性的",
                                "target_lang_sense_clarification": "指问题带有预设倾向"
                            },
                            {
                                "target_lang_word": "陷阱式的",
                                "target_lang_sense_clarification": "指问题旨在让人陷入困境"
                            }
                        ]
