                "forms": [],
                "senses": [
                    {
                        "sense_id": "44e97a26-06ed-362d-89c2-ff37d0357c94",
                        "entry_id": "1b6d6e2e-554d-3058-98b5-a6ceb001339b",
                        "glosses": [
                            "door dat, door die waarbij de oorzaak van het vervolg is gegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408204ab-c509-4e9f-a506-71377643205d",
                                "sense_id": "44e97a26-06ed-362d-89c2-ff37d0357c94",
                                "text": "Het is hierbinnen was het warm en vochtig. Daardoor beslaan alle ramen."
                            },
                            {
                                "example_id": "ae4300a2-62de-42c5-8776-48d5de528a50",
                                "sense_id": "44e97a26-06ed-362d-89c2-ff37d0357c94",
                                "text": "Station Groningen is vanaf vandaag ruim twee maanden grotendeels onbereikbaar. De verbouwing van het Hoofdstation van Groningen gaat een nieuwe fase in. Daardoor rijden er tot en met 12 juli minder treinen en is er dit weekend helemaal geen treinverkeer mogelijk."
                            },
                            {
                                "example_id": "28bdde2a-2677-48ef-9b24-293b0dbe07ca",
                                "sense_id": "44e97a26-06ed-362d-89c2-ff37d0357c94",
                                "text": "Ik wilde flexibeler in het leven staan en zag in dat ik thuis daardoor een veel aangenamere partner en collega zou worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcd31ad5-6f93-38ea-bae5-4d6d4272aa45",
                        "entry_id": "1b6d6e2e-554d-3058-98b5-a6ceb001339b",
                        "glosses": [
                            "fysiek: ergens doorheen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d437ba-ec7b-4ef2-9257-3f6e706eed37",
                                "sense_id": "fcd31ad5-6f93-38ea-bae5-4d6d4272aa45",
                                "text": "Er zat een gat in de zak, en alle suiker stroomde daardoor weg."
                            }
                        ]
                    }
                ],
