                "senses": [
                    {
                        "sense_id": "e8496849-92f1-3008-83a9-65e47f1539b7",
                        "entry_id": "6a07d4a1-27c5-3285-a067-c5eb6da4ee4e",
                        "glosses": [
                            "Computerprogramm zum Filtern von jugendgefährdenden Internetseiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061ed4c4-abf8-45e3-9a5a-6b59d105b25e",
                                "sense_id": "e8496849-92f1-3008-83a9-65e47f1539b7",
                                "text": "„Staat und Industrie müssten also dafür sorgen, dass Jugendschutzfilter möglichst schnell so normal wie ein Virenscanner würden, sagt ein Teilnehmer der Diskussionsrunde in München.“"
                            },
                            {
                                "example_id": "93614944-ad50-4105-a864-5d7eaa4bb628",
                                "sense_id": "e8496849-92f1-3008-83a9-65e47f1539b7",
                                "text": "„Ein von offizieller Stelle empfohlener Jugendschutzfilter blockiert auch bekannte politische Websites und Blogs.“"
                            },
                            {
                                "example_id": "4650eae9-28a2-4b3e-aaa5-546d38974d14",
                                "sense_id": "e8496849-92f1-3008-83a9-65e47f1539b7",
                                "text": "„Jugendschutzfilter arbeiten den Experten zufolge oft nur mangelhaft und bewerten jede fünfte Webseite falsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
