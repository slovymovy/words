                    {
                        "translation_id": "0fcb8533-99c6-4ef2-834c-151eece77d37",
                        "source_entry_id": "f838b6a0-e2cd-3d2e-8d94-c942621df28f",
                        "source_sense_id": "fe78fcf2-2c6e-3f73-b0d3-8e8768ad0508",
                        "target_lang_word": "Orthopäde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orthopäde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ebc2a10-1e94-3b10-a828-d3d065f8a64d",
                                        "entry_id": "fd34c249-6709-32c1-aed4-accb4881c65c",
                                        "glosses": [
                                            "Facharzt für Orthopädie"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Orthopädie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f120c654-7eec-4960-82bb-671e635e0de6",
                                                "sense_id": "6ebc2a10-1e94-3b10-a828-d3d065f8a64d",
                                                "text": "Mit deinem Knochenbruch solltest du dringend einen Orthopäden aufsuchen."
                                            },
                                            {
                                                "example_id": "bcf5216c-0a4f-49ad-8ea3-74879ac2c6a8",
                                                "sense_id": "6ebc2a10-1e94-3b10-a828-d3d065f8a64d",
                                                "text": "„Roth erwähnte das Spiel gegen Princeton 1948, und die beiden freundeten sich an; da Roth im nahegelegenen Warren lebte, konsulierte er Root, einen hervorragenden Orthopäden, gelegentlich wegen seiner Rückenprobleme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ff64b39-033f-4588-8e76-c1057465eada",
                        "source_entry_id": "f838b6a0-e2cd-3d2e-8d94-c942621df28f",
                        "source_sense_id": "fe78fcf2-2c6e-3f73-b0d3-8e8768ad0508",
                        "target_lang_word": "orthopédiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orthopédiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b16c07e-1842-3c15-b927-95940f228c12",
                                        "entry_id": "c5ec5765-bcd1-3ac8-8cbb-871d6705fbd4",
                                        "glosses": [
                                            "Spécialiste de l’orthopédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88eb742-f31d-406e-928b-e7271064eb7b",
                                                "sense_id": "9b16c07e-1842-3c15-b927-95940f228c12",
                                                "text": "L’orthopédiste peut être amené à plâtrer l’enfant quelque temps pour une meilleure immobilisation."
                                            },
                                            {
                                                "example_id": "2b73fb71-7610-4cb7-ac8e-8460c5ca52ff",
                                                "sense_id": "9b16c07e-1842-3c15-b927-95940f228c12",
                                                "text": "Les orthopédistes arrivent très souvent, grâce à ce matériel et à leur compétence, à guérir complètement les séquelles des traumatismes les plus graves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orthopédiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4d5476-07b3-3e5a-88b4-a140c554399d",
                                        "entry_id": "6314a9d4-8c68-3451-9a5b-8e228d0ade50",
