                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Casino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28988170-d3d8-3955-a256-508d8fae49c5",
                                        "entry_id": "44e20388-c0b3-3d74-a262-6677744c4a28",
                                        "glosses": [
                                            "Ort oder Haus für Zusammenkünfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f32bb0-6a10-4123-bb95-81c58be9cb95",
                                                "sense_id": "28988170-d3d8-3955-a256-508d8fae49c5",
                                                "text": "„Denn das Casino war eben nicht nur ein Zirkel gebildeter Bürgerlichkeit, ein Kommunikationskreis, in dem über Lessing und Moses Mendelssohn gesprochen wurde, es war auch ein Machtzentrum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f035aa11-00f3-3c15-a154-43e351af74c5",
                                        "entry_id": "44e20388-c0b3-3d74-a262-6677744c4a28",
                                        "glosses": [
                                            "Kantine für Offiziere oder in Firmen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                                        "entry_id": "44e20388-c0b3-3d74-a262-6677744c4a28",
                                        "glosses": [
                                            "Glücksspielmöglichkeit im Rahmen eines Restaurations- und Variétébetriebs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3488d54b-d2d4-420e-85af-4fa4be4335a0",
                                                "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                                                "text": "„Das Casino ist düster und abschreckend, seine grünen Stühle verlassen, die Vorhänge zugezogen.“"
                                            },
                                            {
                                                "example_id": "fcda947a-99df-41ec-9cd2-314d01136ea2",
                                                "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                                                "text": "„Doch nicht alle sehen die Casinos als Erfolgsgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd75510-c5b0-4d22-9745-6e795fb409c6",
                        "source_entry_id": "0ee55948-92bb-3b64-9617-cb2d57666097",
                        "source_sense_id": "bf1ec94f-45a4-38da-9d3b-f449c6e2d5dd",
                        "target_lang_word": "Spielkasino",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielkasino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                                        "entry_id": "5c9baa25-3e6c-3000-8a13-e1138325d2bb",
                                        "glosses": [
                                            "Gebäude, gewerbliches Unternehmen, in dem um Geld gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87aed9a4-3723-4fd6-a635-f7462f3fe523",
                                                "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                                                "text": "„An der »The Strip« genannten Vergnügungsavenue reiht sich Spielkasino an Spielkasino.“"
                                            },
                                            {
                                                "example_id": "1390e41e-971f-49a4-a106-e6fdccbcd940",
                                                "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                                                "text": "„Erst vor wenigen Tagen war er mit Carlito in Bad Neuenahr im Spielkasino gewesen.“"
                                            },
                                            {
                                                "example_id": "764da3e8-3317-4777-9b5d-180b94df86a8",
                                                "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                                                "text": "„Zu seinen Unternehmungen gehörten ein großes Spielkasino in Kiel und ein Nachtclub in Hagensmoor, das Madagaskar.“"
                                            },
                                            {
                                                "example_id": "971ab710-a9d0-4ae3-a209-a996356cc74b",
                                                "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                                                "text": "„Oldřich Duras […], der Wegbereiter des tschechischen Schachs, stammte aus einer böhmischen Bauernfamilie und sollte im weltmännischen Milieu der internationalen Schachturniere, die Anfang des 19. Jahrhunderts häufig in Seebädern, Kurhotels und Spielkasinos stattfanden, nie ganz heimisch werden, wie Michael Negele in der Kulturschachzeitschrift Karl schreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
