                        "form": "den Unbill"
                    },
                    {
                        "form_id": "04fc2cfa-2bbc-4d33-87bc-f558ba789589",
                        "entry_id": "31159409-3066-397f-ba5e-942e1e89de6a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Unbill"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                        "entry_id": "31159409-3066-397f-ba5e-942e1e89de6a",
                        "glosses": [
                            "Kränkung, ungerechte Behandlung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f85e6092-18d1-4487-9df2-995734b52d0a",
                                "sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                                "text": "Er versucht, des Lebens Unbill zu entfliehen."
                            },
                            {
                                "example_id": "cbec7f88-e1a3-4595-930b-ebe221e464f9",
                                "sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                                "text": "„Der Kommerzienrat blieb wirklich im ersten Augenblick sprachlos vor Schreck, denn der Gedanke, trotz aller erlittenen Unbill, war ihm noch zu neu, sich mitten in der Welt, wie er ging und stand und allein auf sich selber angewiesen zu wissen.“"
                            },
                            {
                                "example_id": "ef2b475e-ad3e-4d8a-8078-6a4dfa09b6ac",
                                "sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                                "text": "„Einmal band er sich eine Woche lang den Arm auf den Rücken, um sich mit Unbill und Schmerz vertraut zu machen.“"
                            },
                            {
                                "example_id": "8950ada1-7dc0-4a41-8c94-5bb66fc4d682",
                                "sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                                "text": "„Sie werden mir vergeben, himmlisches Weib, oder ich selber räche Sie für die Unbill, die ich Ihnen angetan habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77ddb155-1910-3ac4-a4ec-aab037106017",
                        "entry_id": "31159409-3066-397f-ba5e-942e1e89de6a",
                        "glosses": [
                            "Unannehmlichkeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4f40d2b5-b1cc-4edc-ab5a-623db2b408f6",
                                "sense_id": "77ddb155-1910-3ac4-a4ec-aab037106017",
                                "text": "„Jetzt aber, 1940, droht ihm Unbill.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "400af41d-96a7-4fb2-bf30-671cf4269aee",
                        "source_entry_id": "31159409-3066-397f-ba5e-942e1e89de6a",
                        "source_sense_id": "078494e2-8a24-320e-9db3-134a12f2caad",
                        "target_lang_word": "inconvenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconvenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce970598-380f-3241-81ec-850a51512c3b",
                                        "entry_id": "5dc563a2-27ec-3e15-9e73-13d0ae89f984",
                                        "glosses": [
                                            "The quality of being inconvenient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde8fdac-5033-4212-9e96-f2e928c611e1",
                                                "sense_id": "ce970598-380f-3241-81ec-850a51512c3b",
                                                "text": "They plead against the inconvenience, not the unlawfulness, […] of ceremonies in burial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                        "entry_id": "5dc563a2-27ec-3e15-9e73-13d0ae89f984",
                                        "glosses": [
                                            "Something that is not convenient, something that bothers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9e191b-7f83-4560-adea-142cf0c01330",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "[Man] is liable to a great many inconveniences."
                                            },
                                            {
                                                "example_id": "2cd8da19-92e5-4fa2-a9f7-0089a60ff36f",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "The inconveniences that must be endured before the modernisation plan can come into action may be seen at Coventry, where since August the station has been in the throes of rebuilding."
                                            },
                                            {
                                                "example_id": "a8c8c1e9-3326-4f1d-a25f-8267efa3d93c",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "An artificial kidney […] can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inconvenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c202815-51d5-3c3e-9b15-b631ec05ac5d",
                                        "entry_id": "30ea56cf-35cb-3e38-a92e-08e0a80c8372",
                                        "glosses": [
                                            "To bother; to discomfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358da721-c7a2-424e-9d9b-7e5b9167a1a8",
                                                "sense_id": "7c202815-51d5-3c3e-9b15-b631ec05ac5d",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
