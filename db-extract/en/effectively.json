                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5229274c-b3bb-4c7d-9504-eda2379c61bd",
                                                "sense_id": "38e860ca-30a8-3e39-9264-7fd17f5bd05f",
                                                "text": "Wir haben endlich eine effektive Methode entwickeln können."
                                            },
                                            {
                                                "example_id": "52d8a690-51a3-4090-8d51-31e302bea4d2",
                                                "sense_id": "38e860ca-30a8-3e39-9264-7fd17f5bd05f",
                                                "text": "Die Organisation der Betriebsabläufe ist jetzt noch effektiver geworden, als sie ohnehin schon war."
                                            },
                                            {
                                                "example_id": "32c7fea2-02d4-4b70-b79f-b96d492ddd0b",
                                                "sense_id": "38e860ca-30a8-3e39-9264-7fd17f5bd05f",
                                                "text": "Am effektivsten wäre, ihm den Geldhahn zuzudrehen."
                                            },
                                            {
                                                "example_id": "aa394e00-db2b-48d0-8a6f-2655753b3197",
                                                "sense_id": "38e860ca-30a8-3e39-9264-7fd17f5bd05f",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2bce2eb1-f31f-30a6-839c-1205c4a7fca0",
                                        "entry_id": "675e2898-a894-326f-ae5f-db21a72c6859",
                                        "glosses": [
                                            "sich tatsächlich feststellen lassend, wirklich"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27138591-6015-4412-be5a-1d70273ca679",
                                                "sense_id": "2bce2eb1-f31f-30a6-839c-1205c4a7fca0",
                                                "text": "Die effektive Steigerung der Nominallöhne lag bei 3 %."
                                            },
                                            {
                                                "example_id": "a0c3e605-676a-4ba3-b622-d1b0d7425076",
                                                "sense_id": "2bce2eb1-f31f-30a6-839c-1205c4a7fca0",
                                                "text": "Die effektiven Kosten liegen wesentlich höher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
