                "senses": [
                    {
                        "sense_id": "988f6011-49f7-3c4b-a49f-ef5708578770",
                        "entry_id": "1e182fe1-6422-3793-b0fd-858e8dfd9f50",
                        "glosses": [
                            "Wissenschaft, die sich mit der Erforschung und Lehre der Geschichte des Menschen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79de136e-edcb-4e1f-b5a7-47d8da4da24e",
                                "sense_id": "988f6011-49f7-3c4b-a49f-ef5708578770",
                                "text": "„So stehen Chancen und Risiken mathematischer Methoden in der Geschichtswissenschaft derzeit im Brennpunkt der Diskussion.“"
                            },
                            {
                                "example_id": "0210a57d-b769-4748-b648-9ff6f985a43a",
                                "sense_id": "988f6011-49f7-3c4b-a49f-ef5708578770",
                                "text": "„Aehnlich muss auch die Geschichtswissenschaft zu Werke gehen.“"
                            },
                            {
                                "example_id": "8577688d-ed4b-49db-9c98-e3501a168d07",
                                "sense_id": "988f6011-49f7-3c4b-a49f-ef5708578770",
                                "text": "„Die Geschichtswissenschaft hatte für Leibniz stets zwei Aspekte und Funktionen, die er nicht als Widerspruch begriff: sie war Magd der Politik und gleichermaßen zweckfreie Forschung zum exakten Wissen um den Menschen und seine Vergangenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
