{
    "word_family": [
        "dear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                    "sense_definition": "A person who is very dear to one; often used as an affectionate term of address.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beloved_dear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pass the wine, would you, <w>darling</w>?",
                            "target_lang_translations": {
                                "ru": "Передай, пожалуйста, вино, <w>дорогой</w>?",
                                "zh": "能帮我递一下酒吗，<w>亲爱的</w>？"
                            }
                        },
                        {
                            "text": "Sleep, my <w>darling</w>, tenderly!",
                            "target_lang_translations": {
                                "ru": "Спи, мой <w>любимый</w>, нежно!",
                                "zh": "睡吧，我的<w>宝贝</w>，温柔地睡吧！"
                            }
                        }
                    ],
                    "synonyms": [
                        "honey",
                        "sweetheart",
                        "love",
                        "dear",
                        "babe",
                        "pet",
                        "sweetie",
                        "baby"
                    ],
                    "common_phrases": [
                        "my darling",
                        "hello darling",
                        "yes darling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который очень дорог; часто используется как ласковое обращение.",
                        "zh": "指代对自己非常亲近的人；常作为一种亲昵的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "обращение к мужчине"
                            },
                            {
                                "target_lang_word": "дорогая",
                                "target_lang_sense_clarification": "обращение к женщине"
                            },
                            {
                                "target_lang_word": "любимый",
                                "target_lang_sense_clarification": "обращение к возлюбленному"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲爱的",
                                "target_lang_sense_clarification": "用于称呼爱人或亲近的人"
                            },
                            {
                                "target_lang_word": "宝贝",
                                "target_lang_sense_clarification": "用于称呼爱人或孩子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                    "sense_definition": "A person who is kind, sweet, or lovable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cute_lovable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The girl next door picks up all my shopping for me; she is such a <w>darling</w>.",
                            "target_lang_translations": {
                                "ru": "Девушка по соседству забирает все мои покупки; она такая <w>душка</w>.",
                                "zh": "隔壁的女孩帮我取回了所有的购物，她真是个<w>可爱的人</w>。"
                            }
                        },
                        {
                            "text": "The puppy is a little <w>darling</w>.",
                            "target_lang_translations": {
                                "ru": "Этот щенок — просто <w>прелесть</w>.",
                                "zh": "这只小狗真是个<w>小甜心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "angel",
                        "treasure",
                        "sweetheart",
                        "gem",
                        "jewel",
                        "sweetie",
                        "dear"
                    ],
                    "common_phrases": [
                        "such a darling",
                        "absolute darling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который добр, мил или приятен в общении.",
                        "zh": "指性格善良、可爱或讨人喜欢的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душка",
                                "target_lang_sense_clarification": "разг. о приятном, милом человеке"
                            },
                            {
                                "target_lang_word": "прелесть",
                                "target_lang_sense_clarification": "о ком-то очень милом и обаятельном"
                            },
                            {
                                "target_lang_word": "ангел",
                                "target_lang_sense_clarification": "о добром, безупречном человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可爱的人",
                                "target_lang_sense_clarification": "指讨人喜欢的人"
                            },
                            {
                                "target_lang_word": "小甜心",
                                "target_lang_sense_clarification": "指性格甜美的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                    "sense_definition": "A person or thing that is very popular with a certain group of people; a favourite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "favourite_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She became a media <w>darling</w> after the movie release.",
                            "target_lang_translations": {
                                "ru": "После выхода фильма она стала <w>любимицей</w> СМИ.",
                                "zh": "电影上映后，她成了媒体的<w>宠儿</w>。"
                            }
                        },
                        {
                            "text": "He was the <w>darling</w> of the tennis circuit.",
                            "target_lang_translations": {
                                "ru": "Он был <w>любимцем</w> теннисного мира.",
                                "zh": "他是网球界的<w>偶像</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "favourite",
                        "pet",
                        "idol"
                    ],
                    "common_phrases": [
                        "media darling",
                        "darling of the court"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, пользующийся большой популярностью у определенной группы людей; любимец.",
                        "zh": "指在特定群体中非常受欢迎的人或事物；宠儿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любимец",
                                "target_lang_sense_clarification": "фаворит, тот, кого все любят"
                            },
                            {
                                "target_lang_word": "кумир",
                                "target_lang_sense_clarification": "объект восхищения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宠儿",
                                "target_lang_sense_clarification": "备受喜爱的人"
                            },
                            {
                                "target_lang_word": "偶像",
                                "target_lang_sense_clarification": "受人崇拜的对象"
                            }
                        ]
                    }
                }
            ]
        },
        {
