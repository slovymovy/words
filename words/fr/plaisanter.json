    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac917e46-258a-3aa7-b5a4-f9877cd6d643",
                    "sense_definition": "Dire ou faire quelque chose pour amuser, faire rire ou ne pas parler sérieusement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas, je <w>plaisantais</w> quand je disais cela."
                        },
                        {
                            "text": "Nous avons passé la soirée à rire et à <w>plaisanter</w> ensemble."
                        }
                    ],
                    "synonyms": [
                        "badiner",
                        "déconner"
                    ],
                    "common_phrases": [
                        "sans plaisanter",
                        "aimer plaisanter"
                    ]
                },
                {
                    "sense_id": "85bcb14c-29ca-3b3a-831f-b2555d03940c",
                    "sense_definition": "Prendre les choses à la légère ou manquer de rigueur, le plus souvent employé à la forme négative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur ne <w>plaisante</w> pas du tout avec la ponctualité."
                        },
                        {
                            "text": "La sécurité dans cette usine est primordiale, on ne <w>plaisante</w> pas avec ces règles."
                        }
                    ],
                    "common_phrases": [
                        "ne pas plaisanter avec"
                    ]
                },
                {
                    "sense_id": "6c1544f5-a575-3b79-9dcf-5d1ed5bea3c0",
                    "sense_definition": "Tourner quelqu'un en dérision avec gentillesse ou ironie ; taquiner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses collègues aimaient le <w>plaisanter</w> sur sa nouvelle cravate colorée."
                        },
                        {
                            "text": "Il rougissait facilement dès qu'on le <w>plaisantait</w> devant ses amis."
                        }
                    ],
                    "synonyms": [
                        "gouailler"
                    ]
                }
            ]
        }
    ]
