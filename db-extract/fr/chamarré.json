                        "source_entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "source_sense_description": "très coloré, chargé, surchargé d’ornements, couvert de décorations",
                        "target_lang_word": "bedizened",
                        "target_lang_code": "en",
