                        "поставить на место",
                        "поставить в угол",
                        "поставить машину"
                    ],
                    "target_lang_definitions": {
                        "en": "To place an object somewhere, usually in a vertical position or a specific place.",
                        "de": "Einen Gegenstand irgendwohin platzieren, meist in aufrechter Position oder an einem bestimmten Ort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put",
                                "target_lang_sense_clarification": "general placement"
                            },
                            {
