                "senses": [
                    {
                        "sense_id": "4343e148-41f7-3302-9d67-e77533c70eea",
                        "entry_id": "4bb6e9c5-442c-3483-a5f8-e1ed73bae185",
                        "glosses": [
                            "a fateful day, a day of destiny"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d834d591-de88-4196-811a-4a714abbe32d",
                                "sense_id": "4343e148-41f7-3302-9d67-e77533c70eea",
                                "text": "Bei solch günstiger Verkettung von Umständen erntete jetzt die „Gran Reconquista“ die Früchte des Schicksalstags von Navas de Tolosa."
                            },
                            {
                                "example_id": "26c5b0c7-f396-4fde-8906-a5d6f8eff6b0",
                                "sense_id": "4343e148-41f7-3302-9d67-e77533c70eea",
                                "text": "Die Vorstellung des Schicksalstages verbindet sich so eng mit dies, daß das Possessivpronomen auch ganz fehlen kann."
                            },
                            {
                                "example_id": "7d0f84f5-a95c-4cfa-8c4b-5914d8e94edd",
                                "sense_id": "4343e148-41f7-3302-9d67-e77533c70eea",
                                "text": "Bis zu jenem Schicksalstag der amerikanischen Kleinstadt Littleton galt er als schwierig, aber nicht als gefährlich."
                            }
                        ]
                    }
