                "senses": [
                    {
                        "sense_id": "2c933fe7-9c9b-324a-a62b-60ac668f088c",
                        "entry_id": "9e27f05f-3248-35b2-9cb3-a5a944747cd9",
                        "glosses": [
                            "Enlever son parent à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07c621e-2b59-4a06-a9d3-84fe7e1562ba",
                                "sense_id": "2c933fe7-9c9b-324a-a62b-60ac668f088c",
                                "text": "Vous pouvez déparenter les sommets du hook de votre choix."
                            },
                            {
                                "example_id": "12dbfb65-38e8-47a9-9bfa-b2cc64ee1275",
                                "sense_id": "2c933fe7-9c9b-324a-a62b-60ac668f088c",
                                "text": "Si maintenant on veut déparenter notre cylindre par rapport à notre sphère, il suffit de faire pareil, bouton du milieu et le glisse hors de la sphère en faisant comme ça et on revient comme tout à l'heure."
                            },
                            {
                                "example_id": "ed8a7fb1-6987-4602-91d5-9fa36ffeb87b",
                                "sense_id": "2c933fe7-9c9b-324a-a62b-60ac668f088c",
                                "text": "J'ai essayé de déparenter - reparenter tout les objets, même problème."
                            }
                        ]
                    }
