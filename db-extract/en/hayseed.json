                "senses": [
                    {
                        "sense_id": "bbd4c546-2d47-39ac-bcb3-82642c787a5f",
                        "entry_id": "c66aa76a-7fb6-3783-9b41-322b5e0c86a0",
                        "glosses": [
                            "Seeds from grass that has become hay."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ea2c863f-b160-4384-9fd2-5f4a2c32b861",
                                "sense_id": "bbd4c546-2d47-39ac-bcb3-82642c787a5f",
                                "text": "I lay and lay, and was doctored and doctored,; until at last I drove the physicians from me, and called in an apothecary from Nicolai who had cured an old woman of a malady similar to my own—cured her merely with a little hayseed."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c914e28-320f-3832-8b5e-37fdcd0ca831",
                        "entry_id": "c66aa76a-7fb6-3783-9b41-322b5e0c86a0",
                        "glosses": [
                            "Cruft from bits of hay that sticks to clothing, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
