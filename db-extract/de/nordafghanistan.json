                        "examples": [
                            {
                                "example_id": "39dff2e3-c7c6-4eb5-b0ec-f1b07f8787d6",
                                "sense_id": "15376c5e-d30d-3660-bed0-a598d58a0463",
                                "text": "„Dies änderte sich erst im 20. Jahrhundert: 1933 entstand eine erste Straßenverbindung von Nordafghanistan nach Kabul, die jedoch nur temporär genutzt werden konnte.“"
                            },
                            {
                                "example_id": "93008e65-c904-454b-8639-c0b98b61f057",
                                "sense_id": "15376c5e-d30d-3660-bed0-a598d58a0463",
                                "text": "„Die Strategie dafür hatten sie in den Wintermonaten 2020/21 verfeinert, als sie isolierte Armeeposten und Dorfälteste in Nordafghanistan auf ihre Seite zogen.“"
                            }
