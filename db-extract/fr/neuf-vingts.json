                        "examples": [
                            {
                                "example_id": "ef359d35-3833-470b-8da5-eb526ed5a4d1",
                                "sense_id": "59192ca0-baf8-36f4-ac58-5ec58325481a",
                                "text": "Les articles,neuf-vingts troiſiéme,commençant par ce mot, (L’arcquereur,) neuf-vingts-quatriéme, commençant par ces mots,(Si ceux,) neuf-vingts-cinquiéme,commençant par ces mots, (Si les heritiers,) & neuf-vingts-ſixiéme, commençant par ce mot, (Meuble,) ont eſté adiouſtez , pour auoir eſté obmis,comme ledit premier article."
                            },
                            {
                                "example_id": "4a0554f7-29da-4154-93c6-f498438561cd",
                                "sense_id": "59192ca0-baf8-36f4-ac58-5ec58325481a",
                                "text": "A Maiſtre Iean Philipy auſſi Conſeiller du Roy & President en ladite Cour des Aydes de Montpellier , la ſomme de neuf-vingts-ſix eſcus deux tiers,à ſçauoir pour trois quartiers de ſes gages de la dite année de ce compte […]"
                            },
                            {
                                "example_id": "6535a741-415b-48a6-b7eb-a8b9d4ac7789",
                                "sense_id": "59192ca0-baf8-36f4-ac58-5ec58325481a",
                                "text": "A l’article cent ſoixant dix-neuf,commençant, toutesfois, qui eſtoit le neuf-vingts ſeptième article de l’ancien Couſtumier, ont eſté pour interpretajon adjouſtez ces mots,pour quelque cauſe que ce ſoit,encore qu’aucun des creanciers euſt fait premier ſaiſir."
                            }
                        ]
                    }
