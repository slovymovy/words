                        "glosses": [
                            "Nom vernaculaire d’une espèce de centaurée dont quelques variétés sont cultivées dans les jardins, à cause de la beauté de leurs fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad9d4d2-16f7-4e3b-8ba5-a4506dc68d07",
                                "sense_id": "91ee5bd3-afc5-36fb-a835-24ac44a38c01",
                                "text": "La jacée fournit une teinture jaune."
                            },
                            {
                                "example_id": "f15bdb62-869e-4e36-b8cc-71b11a4094a0",
                                "sense_id": "91ee5bd3-afc5-36fb-a835-24ac44a38c01",
                                "text": "Nous marchons à la file indienne sur le bas-côté de la 161 B dont Blandine cueille méthodiquement les jacées."
                            },
                            {
                                "example_id": "bccadbde-ed53-454d-a19f-24cf5885683d",
                                "sense_id": "91ee5bd3-afc5-36fb-a835-24ac44a38c01",
                                "text": "Puis il alla ramasser des cardelle, des jacées, sur les terrasses, et les posa sur la toile avant d'en nouer les coins."
                            }
                        ]
                    }
