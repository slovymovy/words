                        "glosses": [
                            "Relatif aux solfatares, à l'activité volcanique soufrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8831d5bb-b7d6-4994-8c94-eb0a93ba47ca",
                                "sense_id": "a6230a61-6018-357e-8254-838590d53cad",
                                "text": "La zone solfatarienne de Namaskard."
