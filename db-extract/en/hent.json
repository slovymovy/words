                                "example_id": "d6c8f4c5-81cc-4dbe-b987-ac2a7614cfcf",
                                "sense_id": "115f59cd-84fd-3724-a3a5-f5949573e5c5",
                                "text": "1400, Geoffrey Chaucer, \"The Pardoner's Tale\", The Canterbury Tales, republished 1897 [Clarendon Press], Walter W. Skeat (editor), Chaucer's Works: Volume 4, 2018 reprint, Outlook Verlag, page 533,\nThis cursed man hath in his hond y-hent / This poyson in a box, and sith he ran / In-to the nexte strete, un-to a man, / And borwed [of] him large botels three;"
                            },
                            {
                                "example_id": "d695fb01-89ca-4ba1-b5aa-af46d2a48e9f",
                                "sense_id": "115f59cd-84fd-3724-a3a5-f5949573e5c5",
                                "text": "And in the grekynge of the day Sir Gawayne hente his hors wondyrs for to seke."
                            }
