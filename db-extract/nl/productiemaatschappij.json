                        "glosses": [
                            "bedrijf dat iets maakt met name als het gaat om theater voorstellingen of programma's voor radio en televisie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c30576a-e231-48e6-9f23-3fd6d792b448",
                                "sense_id": "570fff7b-b4e8-30cc-9fde-c6af7697f736",
                                "text": "De internationale film- en seriegigant Netflix gaat een serie maken op basis van het bekroonde Nederlandse kinderboek De brief voor de koning. Uitgeverij Leopold bevestigt dat de rechten voor het boek van auteur Tonke Dragt verkocht zijn aan een Britse productiemaatschappij die de serie gaat draaien."
                            },
                            {
                                "example_id": "22b8fd6c-50ce-4cba-b15c-d84355f6ec05",
                                "sense_id": "570fff7b-b4e8-30cc-9fde-c6af7697f736",
                                "text": "De 26-jarige Vlaamse actrice Désirée Viola is overleden. Ze is onder meer bekend van de kinderserie Prinsessia van productiemaatschappij Studio 100 en was in Nederland ook te zien in Nieuwe Tijden, een spin-off van Goede Tijden Slechte Tijden. Over haar doodsoorzaak zijn geen mededelingen gedaan."
                            }
                        ]
                    }
