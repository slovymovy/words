                        "examples": [
                            {
                                "example_id": "dc3cc615-8e97-4680-8723-c632300b59fb",
                                "sense_id": "5eaec916-6f92-3764-8454-750db02e53e8",
                                "text": "Es herrschte eine rege Betriebsamkeit im Betrieb nach Neujahr."
                            },
                            {
                                "example_id": "00098e43-26ef-4efa-a35f-c04995b11426",
                                "sense_id": "5eaec916-6f92-3764-8454-750db02e53e8",
                                "text": "„Schon lange vor Tagesanbruch herrschte hektische Betriebsamkeit im Dorf.“"
                            },
                            {
                                "example_id": "8fcad7ea-d26e-4c7c-95ca-272f1e8ad45f",
                                "sense_id": "5eaec916-6f92-3764-8454-750db02e53e8",
                                "text": "„Und diese Betriebsamkeit vor dem Tod hat mit Mut nichts zu tun.“"
                            }
