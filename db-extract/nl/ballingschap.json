                "senses": [
                    {
                        "sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                        "entry_id": "da2078b1-ed79-3d1a-8ef1-13f103956936",
                        "glosses": [
                            "gedwongen verblijf elders dan waar men thuis is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e4cf31-55c6-4d15-b40e-827bd023b624",
                                "sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                                "text": "Koninging Wilhelmina leidde een regering in ballingschap gedurende de bezetting."
                            },
                            {
                                "example_id": "fbb1113b-b8a6-423b-844d-715d6a298b99",
                                "sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                                "text": "De ballingen leefden in ballingschap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44874625-08e8-4fd7-b6c3-8171b41d0283",
                        "source_entry_id": "da2078b1-ed79-3d1a-8ef1-13f103956936",
                        "source_sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                        "source_sense_description": "gedwongen verblijf elders dan waar men thuis is",
                        "target_lang_word": "Exil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                        "entry_id": "c2918746-8ad4-3a69-a59f-a092bea82c2b",
                                        "glosses": [
                                            "selbst gewählte oder aufgezwungene Verbannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10678941-9bf2-4d9f-9718-77e822595fc3",
                                                "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                                "text": "„Das über ein halbes Jahrhundert währende Exil hat sein Verhalten geprägt, seine Mimik, die Gesten, mit denen er seine Worte begleitet.“"
                                            },
                                            {
                                                "example_id": "e1daa703-a97b-479e-8a68-924cddb4a024",
                                                "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                                "text": "Napoleon wurde ins Exil geschickt."
                                            },
                                            {
                                                "example_id": "9a47cb17-3a42-45db-8bd3-7f3ff02b0d18",
                                                "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                                "text": "„Und hier wohl fasst Harald den Entschluss, seine Reise fortzusetzen, das Abenteuer des erzwungenen Exils um eine neue Dimension zu erweitern.“"
                                            },
                                            {
                                                "example_id": "0d4f723e-de61-44ff-bf49-dff731ec25fd",
                                                "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                                "text": "„Diese drei Autoren und damit indirekt auch die Problematik des Exils bilden einen Schwerpunkt des neuen Heftes.“"
                                            },
                                            {
                                                "example_id": "57e1533f-bf27-48d2-a80b-0422f7918872",
                                                "sense_id": "ff32c8ed-e10b-3358-a6d3-a8754ead6ca2",
                                                "text": "„Seit der Französischen Revolution waren unerwünschte Personen ins Exil nach Guyana geschickt worden, und ab Mitte des 19. Jahrhunderts errichtete man in der Kolonie eine Reihe von Gefängnissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a983bc-c288-4052-9667-aaa3838eea79",
                        "source_entry_id": "da2078b1-ed79-3d1a-8ef1-13f103956936",
                        "source_sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                        "source_sense_description": "gedwongen verblijf elders dan waar men thuis is",
                        "target_lang_word": "Verbannung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbannung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b11011e-3512-3436-9c66-007ebdabfe16",
                                        "entry_id": "3ec82fa9-773a-35be-b987-7dd2ae107316",
                                        "glosses": [
                                            "durch Urteil oder Dekret erzwungene Verlegung an einen von der betroffenen Person nicht gewünschten Ort"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                        "entry_id": "3ec82fa9-773a-35be-b987-7dd2ae107316",
                                        "glosses": [
                                            "erzwungener Aufenthalt an einem von der betroffenen Person nicht gewünschten Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86737580-cc32-41e4-a52c-58dec205bc85",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Er war der nominale Anführer der Rebellion und starb fünf Jahre später in der Verbannung in Burma.“"
                                            },
                                            {
                                                "example_id": "d569b18c-23ba-4b85-b007-9b81e3af4345",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Jetzt liegt der Strafgefangene C843 in einem fensterlosen Güterwagen, wie damals, als sie ihn nach Sibirien in die Verbannung geschickt haben.“"
                                            },
                                            {
                                                "example_id": "fba6e967-6226-469c-bf9b-d4f719b4e933",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Es schien, als hätte er immer noch nicht mit dem Ende seiner Verbannung gerechnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2548ad00-fed4-4a0b-903c-20e8d36f83a6",
                        "source_entry_id": "da2078b1-ed79-3d1a-8ef1-13f103956936",
                        "source_sense_id": "d3ff1817-523d-328e-b831-d0f8763f2b5c",
                        "source_sense_description": "gedwongen verblijf elders dan waar men thuis is",
                        "target_lang_word": "exile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "The state of being banished from one's home or country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf95d16-de8e-4f3e-a7bd-003ca5fa4825",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "He lived in exile."
                                            },
                                            {
                                                "example_id": "eb50e641-0cac-4b7d-80ac-a494020503c7",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "They chose exile rather than assimilation."
                                            },
                                            {
                                                "example_id": "17cd259e-ddeb-4cb8-9022-ea5f3c2fe97c",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "Let them be recalled from their exile."
                                            },
                                            {
                                                "example_id": "3dbce57f-9ea8-4caf-b4fe-da514d06f81b",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "Someone who is banished from his home or country."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114ace20-b0e7-47f3-bfdf-5ef2eb2283db",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "She lived as an exile, and did her best to make the most out of such life."
                                            },
                                            {
                                                "example_id": "d3ffce3f-a27d-437b-a365-4cbb94bf6a54",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "Thou art an exile, and thou must not stay."
                                            },
                                            {
                                                "example_id": "48e6b175-21bc-4ffd-b95e-7481a745b37f",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                        "entry_id": "8b58734b-4757-3c88-96bc-30e33853883e",
                                        "glosses": [
                                            "To send (someone or something) into exile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd5c73-0037-4b82-97a4-bd6c1a20c07e",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "Calling home our exiled friends abroad."
                                            },
                                            {
                                                "example_id": "e906013b-93c6-4eaa-9b2d-b4260c1034e8",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "She, mouldering with the dull earth's mouldering sod, / Inwrapt tenfold in slothful shame, / Lay there exiled from eternal God, / Lost to her place and name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
