    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "4cdf0528-8923-39f9-87ab-4e598804d60b",
                    "sense_definition": "Pronom personnel équivalent à « nous », désignant un ensemble de personnes comprenant le locuteur.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "premiere_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soir, <w>on</w> va au restaurant avec des amis pour fêter son anniversaire."
                        },
                        {
                            "text": "Si tu veux, <w>on</w> y va ensemble dès que tu as fini ton travail."
                        }
                    ],
                    "synonyms": [
                        "nous"
                    ],
                    "common_phrases": [
                        "on y va",
                        "on se voit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "d'un usage extrêmement fréquent à l'oral"
                        }
                    ]
                },
                {
                    "sense_id": "f638db95-2abd-31fa-8d6e-4736ddd9f7be",
                    "sense_definition": "Pronom indéfini désignant une ou plusieurs personnes indéterminées, les gens en général ou quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "personne_indefinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ici, <w>on</w> ne peut pas fumer car c'est un lieu public fermé."
                        },
                        {
                            "text": "Comme <w>on</w> dit souvent, il vaut mieux prévenir que guérir."
                        }
                    ],
                    "synonyms": [
                        "quelqu'un"
                    ],
                    "common_phrases": [
                        "comme on dit",
                        "si l'on veut",
                        "l'on"
                    ]
                },
                {
                    "sense_id": "2f6991f1-dea6-3e14-9125-a9882682bb36",
                    "sense_definition": "Pronom utilisé pour s'adresser à l'interlocuteur à la place de « tu » ou « vous », avec une nuance d'affection ou d'ironie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "interlocuteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alors, <w>on</w> fait la tête aujourd'hui parce qu'on a perdu le match ?"
                        },
                        {
                            "text": "Comment va-t-<w>on</w> ce matin après cette longue nuit de sommeil ?"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage affectif ou condescendant"
                        }
                    ]
                },
                {
                    "sense_id": "61192cf6-1b92-34e9-af1f-618e51f0e04e",
                    "sense_definition": "Pronom remplaçant « je » pour marquer une prise de distance, de la modestie ou une absence d'engagement direct.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "premiere_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne vous inquiétez surtout pas, <w>on</w> s'occupera rapidement de votre dossier."
                        },
                        {
                            "text": "Si vous avez un problème avec le produit, <w>on</w> trouvera une solution amiable."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "distance polie ou hésitante"
                        }
                    ]
                }
            ]
        },
