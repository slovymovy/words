                                "target_senses": [
                                    {
                                        "sense_id": "cdc1b89b-98f4-3637-8b5d-7a824e70396b",
                                        "entry_id": "6b4b8527-1cb9-3713-81a6-712b3a327b7b",
                                        "glosses": [
                                            "Dans la musique vocale, voix correspondant à la voix féminine la plus grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c235bd36-1f80-4435-ab28-7ef2f22cfe16",
                                                "sense_id": "cdc1b89b-98f4-3637-8b5d-7a824e70396b",
                                                "text": "En l'espace de quelques années, il fit évacuer tous les falsettistes restants pour les remplacer par des castrats sopranos, les parties d’alto demeurant encore assez longtemps confiées à des faussets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef1625f-4ccc-3d8b-97ed-a73e6dba1899",
                                        "entry_id": "6b4b8527-1cb9-3713-81a6-712b3a327b7b",
                                        "glosses": [
                                            "Ellipse pour violon alto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a7d121-7202-458f-a73b-275215652c17",
                                                "sense_id": "6ef1625f-4ccc-3d8b-97ed-a73e6dba1899",
                                                "text": "Jouer de l’alto."
                                            },
                                            {
                                                "example_id": "a7a4479a-571c-4fc7-a648-935fdaa29026",
                                                "sense_id": "6ef1625f-4ccc-3d8b-97ed-a73e6dba1899",
                                                "text": "J’essayai donc pour plaire à l’illustre virtuose d’écrire un solo d’alto, mais un solo combiné avec l’orchestre de manière à ne rien enlever de son action à la masse instrumentale, bien certain que Paganini, par son incomparable puissance d’exécution, saurait toujours conserver à l’alto le rôle principal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "783742b9-0729-37b9-8636-b7359a575549",
                                        "entry_id": "6b4b8527-1cb9-3713-81a6-712b3a327b7b",
                                        "glosses": [
                                            "Dans un orchestre de jazz, ellipse pour saxophone alto."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b966f91b-9aeb-4bce-9c9c-8370d044ba2b",
                                                "sense_id": "783742b9-0729-37b9-8636-b7359a575549",
                                                "text": "Charlie Parker jouait de l'alto."
                                            }
                                        ]
                                    }
                                ]
                            },
