                        "glosses": [
                            "in kurzer Zeit"
                        ],
                        "tags": [
                            "im Sekundentakt"
                        ],
                        "examples": [
                            {
                                "example_id": "8896432e-b64c-4479-bf33-c1dcc16ff42d",
                                "sense_id": "22b1089a-d7af-376c-a2a5-9733ad5a520c",
                                "text": "„Börsendeals werden heute im Sekundentakt abgewickelt.“"
                            },
                            {
                                "example_id": "bbf1a78c-baf3-41e6-b9eb-9256bcc68019",
                                "sense_id": "22b1089a-d7af-376c-a2a5-9733ad5a520c",
                                "text": "„Doch dann brach ein gewaltiges, ja gewalttätiges Unwetter los und die Blitze explodierten im Sekundentakt.“"
                            }
                        ],
