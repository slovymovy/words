                "senses": [
                    {
                        "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                        "entry_id": "bd963a27-4f39-3e9d-bcb7-6a889724a3a2",
                        "glosses": [
                            "Bereitschaft, zu geben, zu schenken, Geld auszugeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9245928-8fc4-4b15-81b7-a300f6f38ea7",
                                "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                                "text": "„Es fand sich ein fröhlicher Kreis von jungen Leuten, der gerne die Spendabilität der ‚alten Herren‘ genoß.“"
                            },
                            {
                                "example_id": "832421a7-a9ad-4244-8fb3-0a7ba76ae42a",
                                "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                                "text": "„Die bloße Aussicht, mit Bier entlohnt zu werden, war von fataler Wirkung; denn im Vertrauen auf meine Spendabilität hatte er schon vor meinem Kommen überreichlich gezecht.“"
                            },
                            {
                                "example_id": "1af8a7a9-abd1-4321-88ab-f085338ea8f3",
                                "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                                "text": "„Wahrscheinlich, sagte sich Hantsch, wollte er bloß die Spendabilität seines neuen Geschäftspartners ausnutzen, bevor der es sich anders.“"
                            },
                            {
                                "example_id": "09a54839-054f-498e-a151-5de431c8b1de",
                                "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                                "text": "„Allerdings findet man es selten, dass sich die Jugendlichen durch Spendabilität auszeichnen.“"
                            },
                            {
                                "example_id": "4ed91dc1-bcc4-4e21-bdd1-f4260af0f008",
                                "sense_id": "0e94d9f2-aaf9-3cd1-9120-2dd5165c78a4",
                                "text": "„Die Spendabilität der Einzelnen reicht jedoch gerade mal, um die Tourismuseinnahmen insgesamt bis Ende Oktober auf ein Niveau von 58 Prozent des gleichen Zeitraums 2019 zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
