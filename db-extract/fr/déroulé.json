                        "entry_id": "278594bc-d621-3f42-acdd-e9e28d22b8d3",
                        "glosses": [
                            "Énumération de la succession de faits qui constituent un événement, déroulement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "284cd190-b78a-40c5-94e7-290938ff6e5a",
                                "sense_id": "08691309-9845-366f-8ef0-f229695da305",
                                "text": "Vous avez maintenant une suite de séquences, le déroulé chronologique de l’histoire."
                            },
                            {
                                "example_id": "0e075d3a-ffea-4d3f-babf-0d81d30a78cb",
                                "sense_id": "08691309-9845-366f-8ef0-f229695da305",
                                "text": "Le déroulé des deux catastrophes montre les vulnérabilités humaines."
                            }
