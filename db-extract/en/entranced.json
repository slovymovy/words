                            "comparative"
                        ],
                        "form": "more entranced"
                    },
                    {
                        "form_id": "7c3de978-7cfb-461e-823d-7ff2977118de",
                        "entry_id": "1e1cfbcc-d549-3542-beae-c0bedd600e6c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most entranced"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c5cd623-0860-3818-9ee7-cef408a48867",
                        "entry_id": "1e1cfbcc-d549-3542-beae-c0bedd600e6c",
                        "glosses": [
                            "Placed in a trance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95cafb59-fd74-4792-9297-351d3dac0c47",
                                "sense_id": "9c5cd623-0860-3818-9ee7-cef408a48867",
                                "text": "There sate a Spirit in the vault,\nIn shape, in hue, in lineaments, like life,\nAnd by him couch’d, as if intranced,\nThe hundred-headed Worm that never dies."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4f3d923-c25b-358d-a89b-04b44453b3b0",
                        "entry_id": "1e1cfbcc-d549-3542-beae-c0bedd600e6c",
                        "glosses": [
                            "Held at attention, as if by magic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80763973-866d-4949-b678-5980f9559e16",
                                "sense_id": "b4f3d923-c25b-358d-a89b-04b44453b3b0",
                                "text": "The entranced spectator was cut off from reality as long as the adventure lasted; it was as if he lived a dream yet believed he was awake."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b514d09f-179e-4fa6-a331-afb5e5c41c12",
                        "source_entry_id": "1e1cfbcc-d549-3542-beae-c0bedd600e6c",
                        "source_sense_description": "held at attention, as if by magic",
                        "target_lang_word": "bezaubert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezaubert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                        "entry_id": "ad0d9443-eea8-339d-b111-254dd5a6c82a",
                                        "glosses": [
                                            "von Zauber eingenommen sein, vom Reiz ergriffen sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c746e2c8-2f5b-4a4d-902b-1b3b36a4e38e",
                                                "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                                "text": "Du hast eine bezauberte Frau."
                                            },
                                            {
                                                "example_id": "5a5da733-685f-43b2-b84e-bbe7e93685c3",
                                                "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                                "text": "„Und doch: Als Sokrates die Wahrheit über Eros ausspricht (und auch schon in der voraufgehenden Rede), scheint er nicht er selbst zu sein — er redet lang, ist verzückt von dem idyllischen Ort, an den Phaidros ihn geführt hat, und bezaubert von dem Jüngling, der ihm zuhört.“"
                                            },
                                            {
                                                "example_id": "7fc6f854-1621-4dd3-9ebd-e498c21205ce",
                                                "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                                "text": "„Ich blieb bezaubert von der Schönheit, die mich umgab, stehen und schaute mich aufmerksam nach allen Seiten um.“"
                                            },
                                            {
                                                "example_id": "054c4fa4-f108-487c-baed-394d0d2c1dee",
                                                "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                                "text": "„Es ist so einsam als irgend ein bezaubertes Schloß in Tausend und eine Nacht.“"
                                            },
                                            {
                                                "example_id": "bec51d7d-2d8a-43bd-adb8-5181793f4211",
                                                "sense_id": "5ad9557b-047a-34c3-a636-ee883a74615a",
                                                "text": "„Behexte Milch, Hexenkränze und -puppen, Hexenbutter und -eier werden durch die Flamme unschädlich gemacht; ein bezaubertes Schlachttier wird genießbar, wenn man Herz, Leber und Lunge verbrennt, ja, man darf, ohne seine Gesundheit zu gefährden, Eßwaren von verdächtigen Personen verzehren, wenn man nur zuvor einen Teil ins Feuer geworfen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
