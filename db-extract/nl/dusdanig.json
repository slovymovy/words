                                    }
                                ]
                            },
                            {
                                "target_word": "dusdanig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
