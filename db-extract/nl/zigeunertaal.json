                    {
                        "sense_id": "1626f365-07b1-3b5d-af5c-3487d0691483",
                        "entry_id": "64be0a5d-d2bc-3368-b268-3e80cb7d752a",
                        "glosses": [
                            "elk van de talen gesproken door Roma en Sinti"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aba05b7-8161-4fdf-8e34-befb1129944c",
                                "sense_id": "1626f365-07b1-3b5d-af5c-3487d0691483",
                                "text": "Vooral in de voormalige Oostbloklanden zijn er grote gemeenschappen Roma die het Romani spreken. Het Romani kent minimaal 85 verschillende dialecten. Veel organisaties zijn bezig met de zigeunertaal. De Roma Bible Society wil een platform zijn waar alle kennis op taalgebied met betrekking tot de Roma wordt gebundeld."
                            },
                            {
                                "example_id": "bf594594-92de-4c9d-811a-bfc24a615adc",
                                "sense_id": "1626f365-07b1-3b5d-af5c-3487d0691483",
                                "text": "Volgens Van Dijk heeft het boekje grote symbolische waarde. „De zigeunertaal wordt serieus genomen.” Ook dient het als eyeopener voor zowel de Roma als voor West-Europeanen „dat er op missionair gebied bijzondere ontwikkelingen zijn."
                            },
                            {
                                "example_id": "d17da999-8003-4dec-b4f5-df4bd1cf6128",
                                "sense_id": "1626f365-07b1-3b5d-af5c-3487d0691483",
                                "text": "Meko’s vader is een Sinti-zigeuner. Zelf kent Meko ook Romenes, een zigeunertaal, en heeft hij tot zijn twaalfde in caravans en chalets gewoond."
                            }
                        ]
                    }
