                "senses": [
                    {
                        "sense_id": "91e481f5-0fdc-37d4-a3de-7da22ed9c860",
                        "entry_id": "36aa0f95-9c31-3798-82f0-83bf9514e4c8",
                        "glosses": [
                            "Insel, die sich in der Nähe der Arktis/im Nordpolarmeer befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c62aca-90a9-4f14-86e3-f233aa69f28b",
                                "sense_id": "91e481f5-0fdc-37d4-a3de-7da22ed9c860",
                                "text": "„Außerdem ließen sich die Depots am Rande der riesigen Arktisinsel vergleichsweise umweltschonend abbauen.“"
                            },
                            {
                                "example_id": "f0d5ad6e-37c4-4e55-8d08-f9859197547d",
                                "sense_id": "91e481f5-0fdc-37d4-a3de-7da22ed9c860",
                                "text": "„Nun hat Dänemarks König Frederik X. mit einer nur wenig subtilen Botschaft deutlich gemacht, dass die Arktisinsel in seinen Herrschaftsbereich gehört.“"
                            }
                        ],
