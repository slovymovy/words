                        "glosses": [
                            "in einem Traum erlebte Vision"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1e6bac-d5f3-4d82-90e0-8a7aac1a4e93",
                                "sense_id": "600c806c-e619-3918-b2ca-6e2251ac7e13",
                                "text": "„Abrupt schreckte er aus seiner Traumvision auf und fand sich mitten in einem wüsten Ödland wieder.“"
                            },
                            {
                                "example_id": "9a9c2f3b-3cef-4028-b73c-4c8d2d5e220b",
                                "sense_id": "600c806c-e619-3918-b2ca-6e2251ac7e13",
                                "text": "„Als ob sie das Grauen meiner Traumvisionen noch verstärken wollte, war sie gleichzeitig die Farbe des tintenartigen Wassers, das an den Strand der Insel brandete und sich bis in die weite Ferne hinzog.“"
                            }
                        ],
