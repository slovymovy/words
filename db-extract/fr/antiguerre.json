                "translations": [
                    {
                        "translation_id": "cf24b3ab-f04b-4a1a-9eae-062682dd29e6",
                        "source_entry_id": "7d919eae-059c-3535-8654-c2cf3e13c035",
                        "source_sense_id": "77007859-e520-32eb-93d0-f90b3dca1e93",
                        "source_sense_description": "Person, die gegen den Krieg ist; Kriegsgegner",
                        "target_lang_word": "Kriegsgegner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriegsgegner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "989ae801-9be1-3179-8745-85b79a4b021e",
                                        "entry_id": "1ba8dfc2-f450-3a83-9298-7e57fcaaad41",
                                        "glosses": [
                                            "Kontrahent in einem Krieg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2295b165-382f-4a84-879c-37b1e6c084d2",
                                                "sense_id": "989ae801-9be1-3179-8745-85b79a4b021e",
                                                "text": "„Vom Kriegsministerium des Deutschen Reiches wurde eine Zensur verhängt, damit den Kriegsgegnern keine Veröffentlichungen über kriegswichtige wissenschaftliche Erkenntnisse zugänglich gemacht werden.“"
                                            },
                                            {
                                                "example_id": "97c31780-e11e-4010-b8e9-2853eccf6c26",
                                                "sense_id": "989ae801-9be1-3179-8745-85b79a4b021e",
                                                "text": "„Die Einbeziehung der Zivilbevölkerung in das Kriegsgeschehen vollzog sich in Deutschland und bei den Kriegsgegnern in mancher Hinsicht auf unterschiedliche Weise.“"
                                            },
                                            {
                                                "example_id": "23a5d401-8b97-4081-95bc-156279282777",
                                                "sense_id": "989ae801-9be1-3179-8745-85b79a4b021e",
                                                "text": "„Die Isolation auf der internationalen Bühne brachte die Kriegsverlierer und ehemaligen Kriegsgegner Deutschland und Russland einander näher.“"
                                            },
                                            {
                                                "example_id": "8166345d-e4aa-4182-9ca7-cf76b9e913c3",
                                                "sense_id": "989ae801-9be1-3179-8745-85b79a4b021e",
                                                "text": "„Ostpreußen, das war für die Kriegsgegner Deutschlands die Wiege des preußischen und damit deutschen Militarismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fb3505c-bfb6-34c7-a527-ab977ce29d96",
                                        "entry_id": "1ba8dfc2-f450-3a83-9298-7e57fcaaad41",
                                        "glosses": [
                                            "Person, die gegen das Führen eines Krieges ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728517dc-1b50-44e3-86d8-a90db904343d",
                                                "sense_id": "7fb3505c-bfb6-34c7-a527-ab977ce29d96",
                                                "text": "„Der Krieg ließ mich zum Kriegsgegner werden, ich hatte erkannt, daß der Krieg das Verhängnis Europas, die Pest der Menschheit, die Schande unseres Jahrhunderts ist.“"
                                            },
                                            {
                                                "example_id": "97551e84-af19-4738-ae40-04ed37733e65",
                                                "sense_id": "7fb3505c-bfb6-34c7-a527-ab977ce29d96",
                                                "text": "„Anders als im Sommer 1914 zogen sich die Kriegsgegner nun nicht mehr einfach meistens zurück, vielmehr hatten sie jetzt prominente Politiker auf ihrer Seite - keineswegs nur den Hinterbänkler Karl Liebknecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
