{
    "word_family": [
        "blijven",
        "aanblijving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98f4578b-07ae-3c43-8a5f-7cae7908dc28",
                    "sense_definition": "In dezelfde functie of positie blijven, niet aftreden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "functie_behouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadat het schandaal bekend werd kon de directeur niet langer <w>aanblijven</w>.",
                            "target_lang_translations": {
                                "en": "After the scandal became known, the director could no longer <w>stay on</w>."
                            }
                        },
                        {
                            "text": "De minister besloot ondanks de zware kritiek toch <w>aan</w> te <w>blijven</w>.",
                            "target_lang_translations": {
                                "en": "Despite the heavy criticism, the minister decided to <w>remain in office</w> anyway."
                            }
                        }
                    ],
                    "synonyms": [
                        "blijven",
                        "standhouden"
                    ],
                    "antonyms": [
                        "aftreden",
                        "opstappen",
                        "aftreden"
                    ],
                    "common_phrases": [
                        "als minister aanblijven",
                        "niet langer aanblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain in the same function or position, not to resign."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay on",
                                "target_lang_sense_clarification": "to continue in a position or job"
                            },
                            {
                                "target_lang_word": "remain in office",
                                "target_lang_sense_clarification": "for politicians or officials"
                            },
                            {
                                "target_lang_word": "stay in power",
                                "target_lang_sense_clarification": "for leaders or governments"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54f1b5f1-0b89-3968-af69-bf3092b09de6",
                    "sense_definition": "Ingeschakeld of brandend blijven (van licht, apparaten of vuur).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingeschakeld_blijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vuur <w>bleef</w> tot diep in de nacht <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The fire <w>kept burning</w> until deep into the night."
                            }
                        },
                        {
                            "text": "Laat de lichten in de gang maar <w>aanblijven</w> voor de veiligheid.",
                            "target_lang_translations": {
                                "en": "Just let the lights in the hallway <w>stay on</w> for safety."
                            }
                        }
                    ],
                    "synonyms": [
                        "branden"
                    ],
                    "antonyms": [
                        "uitgaan"
                    ],
                    "common_phrases": [
                        "het licht laten aanblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain switched on or burning (of lights, appliances, or fire)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay on",
                                "target_lang_sense_clarification": "for lights or appliances"
                            },
                            {
                                "target_lang_word": "remain on",
                                "target_lang_sense_clarification": "for devices or lights"
                            },
                            {
                                "target_lang_word": "keep burning",
                                "target_lang_sense_clarification": "for fire or lights"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}