                "senses": [
                    {
                        "sense_id": "83bcc621-804b-3566-bda3-2143177c3bc9",
                        "entry_id": "44990e5d-25e0-3893-b26b-284966dac76e",
                        "glosses": [
                            "устар. увеличиваться в размерах, количестве, объёме и т.п.; приумножаться, возрастать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4b54caa4-ed96-34e8-b44e-c415fbad3dd8",
                        "entry_id": "44990e5d-25e0-3893-b26b-284966dac76e",
                        "glosses": [
                            "становиться более ощутимым, проявляться с большей силой (обычно о чём-либо неприятном, нежелательном, тяжёлом)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ade957cc-d6fc-49ee-931f-d40e47a3e00a",
                        "source_entry_id": "44990e5d-25e0-3893-b26b-284966dac76e",
                        "target_lang_word": "croître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                        "entry_id": "a1a7fa94-be9e-356f-9bc4-a7c06124a4bb",
                                        "glosses": [
                                            "Se développer, en parlant des êtres humains, des animaux, des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0358d8-da35-4e7f-9f45-bcbfbcfc0319",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Pour croître, un arbre a besoin d'eau, d'oxygène, de lumière, d'éléments nutritifs tirés du sol, etc."
                                            },
                                            {
                                                "example_id": "1576028f-b95b-4405-8e58-88971803111e",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Croître très vite, en peu de temps, à vue d’œil, insensiblement."
                                            },
                                            {
                                                "example_id": "00ca444e-837f-4a9a-82db-c7d4a9724f36",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Croître à une certaine hauteur."
                                            },
                                            {
                                                "example_id": "8b8de984-41ca-48db-a3b2-7694c9874d7f",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Se laisser croître la barbe, les cheveux."
                                            },
                                            {
                                                "example_id": "e8044903-afff-447b-b1b7-68c373749879",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Les herbes, les arbres croissent."
                                            },
                                            {
                                                "example_id": "026e3f94-133c-4d48-a705-a3928310dfaf",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Cette pluie a fait croître les blés."
                                            },
                                            {
                                                "example_id": "736f73c7-8979-4278-aaa7-0b124e0d536f",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Ces animaux croissent jusqu’à tel âge."
                                            },
                                            {
                                                "example_id": "b5228454-8eab-410e-ae6f-61d05840bb9a",
                                                "sense_id": "8cb5d51d-def3-387b-9403-1765bb2f7719",
                                                "text": "Bien plus commode à exploiter que le bois, le bambou croît très rapidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a2c92f-e9db-3535-9c08-3defae2e2555",
                                        "entry_id": "a1a7fa94-be9e-356f-9bc4-a7c06124a4bb",
                                        "glosses": [
                                            "Augmenter de quelque façon que ce soit, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3073f806-492d-4099-b3d0-eeeb70839cdf",
                                                "sense_id": "08a2c92f-e9db-3535-9c08-3defae2e2555",
                                                "text": "La vitesse de circulation de la monnaie croissait ainsi de jour en jour et sa répudiation définitive semblait devoir être prochaine."
                                            },
                                            {
                                                "example_id": "ea157b79-8077-4f2d-87d2-eb439c437009",
                                                "sense_id": "08a2c92f-e9db-3535-9c08-3defae2e2555",
                                                "text": "La rivière a crû, est crue. - Les pluies, les neiges l’ont fait croître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4654df-b268-3c84-ab00-bb3b34d2e48f",
                                        "entry_id": "a1a7fa94-be9e-356f-9bc4-a7c06124a4bb",
                                        "glosses": [
                                            "Naître, pousser, en parlant des herbes, des plantes, des fruits, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f4ac8c-68f7-4377-9ae3-fd7cd579af80",
                                                "sense_id": "9d4654df-b268-3c84-ab00-bb3b34d2e48f",
                                                "text": "La laine apparait au mois de septembre, croît pendant l’hiver et tombe au printemps, au moment de la mue ; on peigne tous les deux jours, sur l’animal vivant, la toison avec un démêloir jusqu’à ce que celui-ci n’amène plus de duvet."
                                            },
                                            {
                                                "example_id": "f061340d-51c5-4bf5-a5b5-fc6853ca0727",
                                                "sense_id": "9d4654df-b268-3c84-ab00-bb3b34d2e48f",
                                                "text": "Cette stérilité contraste avec les nombreuses touffes de retems et de verdure qui croissent dans le lit de la vallée."
                                            },
                                            {
                                                "example_id": "3f124960-cfa5-4aff-a94c-e116cffb167a",
                                                "sense_id": "9d4654df-b268-3c84-ab00-bb3b34d2e48f",
                                                "text": "Ce pays est bon, toutes sortes de plantes y croissent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6865803e-f8b1-4915-9e65-f840645a354f",
