    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                "word": "edified",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1e5e6d9d-11e0-4091-984b-e016c832adb8",
                        "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more edified"
                    },
                    {
                        "form_id": "1acbb521-a17d-42c4-a136-38887abb3561",
                        "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most edified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c8b6081-0dbc-368d-8537-4f3a2f092fb6",
                        "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                        "glosses": [
                            "Furnished with buildings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404ac79d-f02d-46ce-8778-04a095a21d69",
                                "sense_id": "1c8b6081-0dbc-368d-8537-4f3a2f092fb6",
                                "text": "Long they thus travelled in friendly wise, / Through countreyes waste, and eke well edifyde [...]."
                            },
                            {
                                "example_id": "2c22fd0a-35d5-4242-ae44-87f89e22ea6d",
                                "sense_id": "1c8b6081-0dbc-368d-8537-4f3a2f092fb6",
                                "text": "In Calvià the demoasidetion of 16 hotels built in the early 1970s and the new planning strategies have given visibiasidety to a possible reuse of edified areas often showing relevant impacts, in Rimini the project tried to put into action a process of divulgation on sustainable tourism themes."
                            },
                            {
                                "example_id": "c7f49a73-f650-4e01-97ac-5c404681c4dd",
                                "sense_id": "1c8b6081-0dbc-368d-8537-4f3a2f092fb6",
                                "text": "The Pissaglio river alluvial fan is the area where about 90% of Bruzolo edified areas are located (Fig. 2) ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ebc68cb-dcf8-345b-abea-f0cee8a6080e",
                        "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                        "glosses": [
                            "Built or constructed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f37d08ff-3e12-48b9-98fe-4f0d71a4c734",
                                "sense_id": "5ebc68cb-dcf8-345b-abea-f0cee8a6080e",
                                "text": "Based on the definition put forward and the fact that the elements surrounding the square should be clearly visible, we can state that it is not the edified elements which delimit the square, but rather, that it is the square which bestows on them a tangential sense of boundary and conformation;"
                            },
                            {
                                "example_id": "c5984ecc-1a1b-45cf-a671-4e66c0f142c3",
                                "sense_id": "5ebc68cb-dcf8-345b-abea-f0cee8a6080e",
                                "text": "Summing up, the designed buildings' generic ontology intends to establish a generalist organization for edified structures, based on the CityGML standard."
                            },
                            {
                                "example_id": "b531f107-bebd-42b0-8cfa-c7cd86803c4b",
                                "sense_id": "5ebc68cb-dcf8-345b-abea-f0cee8a6080e",
                                "text": "Still in the colonial period, it began to be charged when it focused on the ownership of edified buildings."
                            }
                        ]
                    },
                    {
                        "sense_id": "7294658f-7a7b-3dc0-a460-bf3170c5ea90",
                        "entry_id": "d3a36d65-f652-3e94-854d-aa8e9b9f7f08",
                        "glosses": [
                            "Morally or intellectually improved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619db2a8-14ec-4a53-92ab-225c33513426",
                                "sense_id": "7294658f-7a7b-3dc0-a460-bf3170c5ea90",
                                "text": "I am personally very edified at the amount of energy and effort they apply to age cases, not only dealing with the people and the issues but frequently dealing with other related issues as well."
                            },
                            {
                                "example_id": "fc28bf9c-9e79-44ec-afb2-bcfb98c91aa9",
                                "sense_id": "7294658f-7a7b-3dc0-a460-bf3170c5ea90",
                                "text": "Will you allow then at once, that their feeling, and their notion of being more edified, will justify their heresies and their schism?"
                            },
                            {
                                "example_id": "7a6c1bd9-9cfd-4891-9a09-8859756d013c",
                                "sense_id": "7294658f-7a7b-3dc0-a460-bf3170c5ea90",
                                "text": "The oftener you are at them, the better you will like them, and the more edified you will be by them;"
                            },
                            {
                                "example_id": "14e7fa11-3d5a-4085-ac6c-b4aafd63c2d8",
                                "sense_id": "7294658f-7a7b-3dc0-a460-bf3170c5ea90",
                                "text": "I concede that I may be overestimating Jung's significance for your emotional life, as he himself did, and you can believe me when I say that I am not very edified by this symptom of unconscious identification with him."
                            }
                        ]
                    }
                ],
