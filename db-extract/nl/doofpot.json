                    {
                        "translation_id": "13bbc804-0979-4bd7-90f4-7c3f896f3d06",
                        "source_entry_id": "c78e8d96-127c-3fad-8870-8e290100000d",
                        "source_sense_id": "c56b0d09-6f0d-3ebd-ae50-02456ab052ef",
