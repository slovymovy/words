                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4afde54b-0e4a-498d-88aa-146903db9030",
                        "source_entry_id": "5ff821e2-8bf3-3e69-b797-7915e5fb40c2",
                        "source_sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
                        "source_sense_description": "große Ansammlung von Gräbern in der Antike oder in der Vorgeschichte",
                        "target_lang_word": "nécropole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nécropole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "102a6341-a9e6-3c3c-9317-9480b29f69cb",
                                        "entry_id": "e068aaae-ddb9-3af9-b5a8-25ea3f254419",
                                        "glosses": [
                                            "Cimetière."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "416630b6-5ba8-4a6e-8a2d-932f9726088f",
                                                "sense_id": "102a6341-a9e6-3c3c-9317-9480b29f69cb",
                                                "text": "Ah! cette ville imbécile et mortelle […] Elle prend des aspects de nécropole où les macchabées folâtres auraient licence de grimacer et de gesticuler sous un ciel putride, gonflé comme un égout."
                                            },
                                            {
                                                "example_id": "4d0d72c6-ffa3-47ac-973b-cb8634d2233b",
                                                "sense_id": "102a6341-a9e6-3c3c-9317-9480b29f69cb",
                                                "text": "Les nécropoles étaient quelquefois de vastes souterrains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "484132ac-b27f-3e8b-8094-aa5c4abdbb65",
                                        "entry_id": "e068aaae-ddb9-3af9-b5a8-25ea3f254419",
                                        "glosses": [
                                            "Cimetière.",
                                            "Ensemble de sépultures monumentales agglomérées."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04d175b1-e64d-4005-b3fc-323292ca94e0",
                                                "sense_id": "484132ac-b27f-3e8b-8094-aa5c4abdbb65",
                                                "text": "Son tombeau qui se trouve dans la nécropole de Dra Abou El Naga à Thèbes, au nord de ceux de ses prédécesseurs, semble indiquer qu’il inaugure une nouvelle lignée de souverains puissants et ambitieux qui ont édifié également leurs propres sépultures."
                                            },
                                            {
                                                "example_id": "fcd1119b-313f-4216-a95d-aab87f75222e",
                                                "sense_id": "484132ac-b27f-3e8b-8094-aa5c4abdbb65",
                                                "text": "Nécropole princière, lieu, fréquemment un monastère ou une abbaye, où les princes d’une dynastie ou d’un État ont coutume de se faire inhumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29de48b8-faee-325b-9888-4c55e34fcf11",
                                        "entry_id": "e068aaae-ddb9-3af9-b5a8-25ea3f254419",
                                        "glosses": [
                                            "Cimetière militaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6c0ed7-18f2-4645-b752-726392634fb5",
                        "source_entry_id": "5ff821e2-8bf3-3e69-b797-7915e5fb40c2",
