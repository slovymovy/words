                ],
                "senses": [
                    {
                        "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                        "entry_id": "4fbcf2c1-78b0-36c1-b767-41bf0ee85a75",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656c818b-e365-4fbb-99bc-4dbfd2f04f75",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Der ehemalige Bundesliga-Trainer Falko Götz wird beim Fußball-Regionalligisten 1. FC Saarbrücken in Personalunion neuer Chefcoach und Sportlicher Leiter."
                            },
                            {
                                "example_id": "7169e3a7-62e0-4256-9e4a-5c00e2121922",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Frau Götz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a3b184a5-8a99-4ca7-a959-42fe915f9559",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Herr Götz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0ad0b66d-e0e1-4e84-9b18-dd369524c7b5",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Die Götzens fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "3f448fc9-1ce6-4beb-a8f6-0480a4e419e9",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Der Götz trägt nie die Schals, die die Götz ihm strickt."
                            },
                            {
                                "example_id": "7222f779-261e-4102-a694-f23a2ba0aa96",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Götz kommt, geht der Herr Götz.“"
                            },
                            {
                                "example_id": "54c38b0a-57f7-4b8b-8fa2-0079c8149e58",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Götz kommt und geht."
                            },
                            {
                                "example_id": "ba1dbf5b-9d0f-443a-94a1-5f2bb728f6c5",
                                "sense_id": "984ba53b-5acb-3ead-bab7-d63225eedc1c",
                                "text": "Götzens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
