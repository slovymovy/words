                "senses": [
                    {
                        "sense_id": "141182a7-8fb0-35ef-9d56-48f8354004e0",
                        "entry_id": "a7ca4eb6-24b8-3787-9b3e-ab0b0d77c595",
                        "glosses": [
                            "總體藝術，全藝術作品，純藝術作品"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2629892d-3b12-4e28-a001-f39f8145aa09",
                                "sense_id": "141182a7-8fb0-35ef-9d56-48f8354004e0",
                                "text": "Begeleitend zu den Symbolisten möchte ich auch die Beziehung zwischen dem Gesamtkunstwerk und der Synästhesie betrachten, die zumindest Elemente des Gesamtkunstwerkverständnisses bis heute prägen.",
                                "translation": "伴隨著象徵主義者，我還想考慮總體藝術和聯覺之間的關係，這至少是迄今為止對總體藝術理解的要素的特徵。"
                            }
                        ]
                    },
                    {
                        "sense_id": "d478851f-89f9-352d-9edd-d934be62e459",
                        "entry_id": "a7ca4eb6-24b8-3787-9b3e-ab0b0d77c595",
                        "glosses": [
                            "令人眼花繚亂或浮華的人，尤其是穿著特別的衣服、穿孔、紋身等的人。"
                        ],
                        "tags": [
                            "主要作為詼諧用語"
                        ],
                        "examples": [
                            {
                                "example_id": "4b16729d-924a-442a-a5b5-08e101a693b9",
                                "sense_id": "d478851f-89f9-352d-9edd-d934be62e459",
                                "text": "Peters Mutter mit ihrer Federboa und den anstößigen Witzen ist wirklich ein Gesamtkunstwerk."
                            }
                        ]
                    },
                    {
                        "sense_id": "e69d3cb8-e352-3372-ac73-089876f88ef3",
                        "entry_id": "a7ca4eb6-24b8-3787-9b3e-ab0b0d77c595",
                        "glosses": [
                            "一個地方、場景或想法，通常看起來十分混亂，暗示有一種潛在的美"
                        ],
                        "tags": [
                            "主要作為詼諧用語"
                        ],
                        "examples": [
                            {
                                "example_id": "182dc4da-eb5f-4bed-92a2-59b61be4fe6b",
                                "sense_id": "e69d3cb8-e352-3372-ac73-089876f88ef3",
                                "text": "Mein Arbeitszimmer ist keine Müllhalde, das ist ein Gesamtkunstwerk.",
                                "translation": "我的書房不是垃圾場，而是一件裝置藝術。"
                            }
                        ]
                    }
