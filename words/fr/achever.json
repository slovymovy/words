                    "sense_definition": "Mener à son terme, finir entièrement une action ou un ouvrage commencé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "terminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain espère <w>achever</w> son travail avant la fin du mois.",
                            "target_lang_translations": {
                                "en": "The writer hopes to <w>finish</w> their work before the end of the month.",
                                "ru": "Писатель надеется <w>закончить</w> работу до конца месяца.",
                                "nl": "De schrijver hoopt zijn werk voor het einde van de maand <w>af</w> te <w>maken</w>.",
                                "de": "Der Schriftsteller hofft, seine Arbeit vor Monatsende zu <w>beenden</w>.",
                                "pl": "Pisarz ma nadzieję <w>skończyć</w> pracę przed końcem miesiąca.",
                                "it": "Lo scrittore spera di <w>finire</w> il suo lavoro prima della fine del mese.",
                                "cs": "Spisovatel doufá, že <w>dokončí</w> svou práci před koncem měsíce.",
                                "tr": "Yazar, ayın sonundan önce işini <w>bitirmeyi</w> umuyor.",
                                "es": "El escritor espera <w>terminar</w> su trabajo antes de que acabe el mes.",
                                "zh": "这位作家希望在月底前<w>完成</w>自己的工作。"
                            }
                        },
                        {
                            "text": "J'<w>achève</w> la rédaction de mon rapport pour la réunion de demain.",
                            "target_lang_translations": {
                                "en": "I'm <w>finishing</w> writing my report for tomorrow's meeting.",
                                "ru": "Я <w>заканчиваю</w> писать свой отчёт к завтрашнему совещанию.",
                                "nl": "Ik <w>rond</w> het schrijven van mijn rapport voor de vergadering van morgen <w>af</w>.",
                                "de": "Ich <w>beende</w> gerade das Schreiben meines Berichts für die morgige Besprechung.",
                                "pl": "Właśnie <w>kończę</w> pisanie mojego raportu na jutrzejsze spotkanie.",
                                "it": "Sto <w>ultimando</w> la stesura del mio rapporto per la riunione di domani.",
                                "cs": "<w>Dokončuji</w> psaní své zprávy na zítřejší poradu.",
                                "tr": "Yarınki toplantı için raporumun yazımını <w>bitiriyorum</w>.",
                                "es": "Estoy <w>terminando</w> la redacción de mi informe para la reunión de mañana.",
                                "zh": "我正在<w>完成</w>明天会议所用报告的撰写。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminer"
                    ],
                    "common_phrases": [
                        "achever son travail",
                        "achever sa tâche"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring an action or piece of work that has been started through to its end.",
                        "ru": "Довести начатое дело или работу до конца.",
                        "nl": "Een begonnen handeling of werk volledig tot een einde brengen.",
