                ],
                "senses": [
                    {
                        "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                        "entry_id": "1ee16c51-47c4-38a2-82ea-7855283cf525",
                        "glosses": [
                            "nicht wirklich existenter und nur in der Vorstellung vorhandener Ort, an dem Gerüchte entstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1909fd3d-db2d-4449-96e0-803894b9e500",
                                "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                                "text": "„Die Gerüchteküche besagt, dass Kollege Müller eine Affäre mit der Frau des Chefs hat.“"
                            },
                            {
                                "example_id": "e048f84b-8931-4539-8cc4-af13e59afbfe",
                                "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                                "text": "„Neu ist jetzt allerdings, dass mittlerweile jede Mitteilung aus der Gerüchteküche um das Datum eines eventuellen Rücktritts des italienischen Premiers von Kurssprüngen oder Stürzen an der Mailänder Börse begleitet wird.“"
                            },
                            {
                                "example_id": "95cd3c32-3578-4bb4-842a-969199d375e4",
                                "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                                "text": "„Wichtiger als das Rumoren dieser Gerüchteküche erscheint mir aber die Frage, wie ich mit dieser Veränderung meines Status umgehen soll.“"
                            },
                            {
                                "example_id": "7b07a975-d6ea-4a4e-9c60-e27bf44285ff",
                                "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                                "text": "Die Spekulationen um den nächsten Bond-Darsteller reißen nicht ab. Auf Twitter hat sich nun auch US-Schauspielerin Gillian Anderson ins Spiel gebracht. Damit sorgt sie für Wirbel in der Gerüchteküche."
                            },
                            {
                                "example_id": "acf6a23d-e9ff-4745-a65b-7e847ffe25b4",
                                "sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                                "text": "Nachdem Thomas Tuchel dem FC Bayern München als möglicher Nachfolger von Jupp Heynckes abgesagt hatte – mit der Begründung, er sei mit einem \"ausländischen Spitzenclub im Wort\" – wollte die Gerüchteküche gar nicht mehr aufhören zu spekulieren, um welchen Verein es sich dabei handeln könnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b7cca7-68ef-4e9f-a691-a1922fae03fb",
                        "source_entry_id": "1ee16c51-47c4-38a2-82ea-7855283cf525",
                        "source_sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                        "source_sense_description": "nicht wirklich existenter und nur in der Vorstellung vorhandener Ort, an dem Gerüchte entstehen",
                        "target_lang_word": "grapevine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grapevine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31d127e2-ee65-3639-8f84-11c3803c38f1",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "The plant, a vine of genus Vitis, on which grapes grow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fcd82b-102d-4b5c-84c4-6b6f4ae46f4e",
                                                "sense_id": "31d127e2-ee65-3639-8f84-11c3803c38f1",
                                                "text": "Although many grapevines have geographical names, these rarely reflect their real origin, if known at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6297009e-34bb-31ad-b18c-5c746ae08fd2",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "An informal person-to-person means of circulating information or gossip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb9ee39-9953-4e34-8947-1dd067011aa5",
                                                "sense_id": "6297009e-34bb-31ad-b18c-5c746ae08fd2",
                                                "text": "I heard through the grapevine that Jim will be leaving soon."
                                            },
                                            {
                                                "example_id": "e7e4c2bb-f2de-44f5-9989-08b38aaaa756",
                                                "sense_id": "6297009e-34bb-31ad-b18c-5c746ae08fd2",
                                                "text": "The Bat—they called him the Bat. […] Most lone wolves had a moll at any rate—women were their ruin—but if the Bat had a moll, not even the grapevine telegraph could locate her."
                                            },
                                            {
                                                "example_id": "b254a351-61c7-4bc9-9c04-a4f97fdc6181",
                                                "sense_id": "6297009e-34bb-31ad-b18c-5c746ae08fd2",
                                                "text": "I heard it through the grapevine\nNot much longer would you be mine."
                                            },
                                            {
                                                "example_id": "3a1cfa47-9b13-4895-8e37-bc5dcb764fac",
                                                "sense_id": "6297009e-34bb-31ad-b18c-5c746ae08fd2",
                                                "text": "The grapevine was so fast that sometimes news was circulated before it happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "928884d3-9b94-3909-a77a-67bdeaab34a0",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "A rumor."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d671add0-a35a-4c90-9e62-4d793ad67d98",
                                                "sense_id": "928884d3-9b94-3909-a77a-67bdeaab34a0",
                                                "text": "The legend, like all army grapevine, got around to me."
                                            },
                                            {
                                                "example_id": "e180271b-b549-4bfa-801e-60ce28a0d002",
                                                "sense_id": "928884d3-9b94-3909-a77a-67bdeaab34a0",
                                                "text": "The grapevine was that the reason for the school closure was to do with the fact that a lot of students from Bonda had absconded to go to war because Bonda was close to the border between Mozambique and Zimbabwe."
                                            },
                                            {
                                                "example_id": "11146782-37f2-4c26-8728-ccfa1c29b964",
                                                "sense_id": "928884d3-9b94-3909-a77a-67bdeaab34a0",
                                                "text": "An image of Mohanlal with a tonsured head recently spread online and people started guessing about the film it belonged to. The majority guess was for a film directed by Prajith which had announced a character that was supposed to be acted by Mohanlal named Benz Vasu. But the director denied the grapevine and more guesses and assumptions starting flowing in."
                                            },
                                            {
                                                "example_id": "f32794a2-aea8-4585-b053-983d560cb759",
                                                "sense_id": "928884d3-9b94-3909-a77a-67bdeaab34a0",
                                                "text": "The grapevine was that Saina believed that Gopichand was focussing more on PV Sindhu.·"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "467548bf-e395-3f11-8c9f-af853e0907dd",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "A move in which the feet are alternately placed in front of each other, while both remaining on the ice or ground, incorporating half-turns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc1caae-3f1f-3a3e-a095-4e74a8e4e7b4",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "A leglock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065d4e1f-99f3-380c-8965-859c6477bd54",
                                        "entry_id": "9f8bdce8-b0b9-376a-9bb7-80ddda135917",
                                        "glosses": [
                                            "A dance figure in partner dancing that includes sidesteps and steps across the support foot. See Grapevine (dance move)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grapevine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f127152-5bff-3928-8454-4e1a85b8c0fb",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "To restrain in a leglock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96d638f-bee2-41b6-a2ac-16ed0401bbeb",
                                                "sense_id": "6f127152-5bff-3928-8454-4e1a85b8c0fb",
                                                "text": "From the top he grapevined his leg around Tibbits' leg and planted his elbow in his opponent's opposite side."
                                            },
                                            {
                                                "example_id": "d0d627dd-281c-4e95-b4e6-1ccc9e64d500",
                                                "sense_id": "6f127152-5bff-3928-8454-4e1a85b8c0fb",
                                                "text": "The Low Mount is the position where your hips are tight to your opponent's and your legs are usually grapevined or locked underneath his."
                                            },
                                            {
                                                "example_id": "beaa71aa-cdfe-4b13-b582-b84b9b5fd85a",
                                                "sense_id": "6f127152-5bff-3928-8454-4e1a85b8c0fb",
                                                "text": "So now she's grapevined me, I can't straighten my legs, which means I can't generate the momentum I need to bridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "To drape or curl around adjacent objects."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54d3018-6391-46ea-884d-9de9445c0ca6",
                                                "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                                "text": "This results from the plug wires being grapevined around each other too closely."
                                            },
                                            {
                                                "example_id": "807ba1f7-bb79-4990-a5a1-ff71fe9e2561",
                                                "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                                "text": "I drove around town looking at the limp glitter of Christmas decorations grapevined around traffic lights which just blinked after a certain hour, even on a Friday night."
                                            },
                                            {
                                                "example_id": "448d599a-0837-4ea5-8536-f3f8893f9522",
                                                "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                                "text": "Balance on the back of the sit bones with the arms “grapevined” under the calves, with hands wrapping around to hold the ankles."
                                            },
                                            {
                                                "example_id": "7254ab1b-8178-487d-8e59-b3403794c88d",
                                                "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                                "text": "A matted beard tingled from his shin and grapevined all over the exposed parts of his body."
                                            },
                                            {
                                                "example_id": "2d873cd5-bba7-47c0-8c34-31a794864fe9",
                                                "sense_id": "b3ee6a62-9beb-350b-893c-9f21bffa07ed",
                                                "text": "I grapevined my right arm around one of his legs, then flung myself backward to the ground, slamming the knife-wielding idiot into the ground, and my shoulders into the idiot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf982d2-ead7-3f81-aa36-10d9aba737fa",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "To move one's body in a smooth undulating wave while stepping in the direction the wave is moving."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e86ecb-c17e-42d2-be04-e57eea273be7",
                                                "sense_id": "cdf982d2-ead7-3f81-aa36-10d9aba737fa",
                                                "text": "Up on the stage, the dancers twirled and whirled in time to the music and then grapevined across the broad expanse and exited stage left."
                                            },
                                            {
                                                "example_id": "da293173-9691-4767-84e1-c9f6b4fd31cc",
                                                "sense_id": "cdf982d2-ead7-3f81-aa36-10d9aba737fa",
                                                "text": "The underwear-baker grapevined down the length of the display and grabbed a to-go box from the stack on top of it."
                                            },
                                            {
                                                "example_id": "febfc531-89c2-4c5c-a173-e0f90166d8d3",
                                                "sense_id": "cdf982d2-ead7-3f81-aa36-10d9aba737fa",
                                                "text": "When the room grapevined left, I grapevined right, causing a head-on collision with the lady next to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8aa7687-c795-3a7a-8d82-5891443e88bd",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "To score mortar at a joint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1dd5b94-1f05-4ac9-9b64-078aded884df",
                                                "sense_id": "c8aa7687-c795-3a7a-8d82-5891443e88bd",
                                                "text": "The bridge is faced with rusticated stone and grapevined mortar joints, a trademark of WPA-built structures in southeast Colorado, and features beveled stone piers, corbeled copings and tapered voussoirs for the arches."
                                            },
                                            {
                                                "example_id": "239137b7-0acf-495e-abe4-48ccf3ecbd52",
                                                "sense_id": "c8aa7687-c795-3a7a-8d82-5891443e88bd",
                                                "text": "Generally the mortar line was “grapevined” (scored) and “penciled” (the score painted with a fine white line), which separated each brick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d8f2123-bbb9-379b-b4d2-e50f6775dd4b",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "Of information, to spread as a rumor."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014ef0e7-3d83-41a0-8fe9-dc02c4ad2272",
                                                "sense_id": "7d8f2123-bbb9-379b-b4d2-e50f6775dd4b",
                                                "text": "For several years, as Mr. Watson's challenge gradually grapevined its way through the business world, many business groups asked Mr. Russell to speak at their directors' meetings and conventions."
                                            },
                                            {
                                                "example_id": "31ac1dfd-8849-47c8-9b34-a9c01ef380b9",
                                                "sense_id": "7d8f2123-bbb9-379b-b4d2-e50f6775dd4b",
                                                "text": "But the story grapevined around to Marshal Petain."
                                            },
                                            {
                                                "example_id": "6715e252-1de4-4c42-a089-e372ecd3869b",
                                                "sense_id": "7d8f2123-bbb9-379b-b4d2-e50f6775dd4b",
                                                "text": "Word of the fight grapevined fast, and from all the other bonus army camps reinforcements rushed in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cfb293-4360-39ad-8992-1001bc772364",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "Of a person or group, to spread (a rumor)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5973df61-7a68-489d-8fb0-0d2a706c7d66",
                                                "sense_id": "66cfb293-4360-39ad-8992-1001bc772364",
                                                "text": "The doctor's orders were soon grapevined around the league, and all the bench jockeys on the circuit were quickly counting ten on every pitch Lefty made."
                                            },
                                            {
                                                "example_id": "fa8f1bf5-4d36-478a-9a71-ede2eea9f5bf",
                                                "sense_id": "66cfb293-4360-39ad-8992-1001bc772364",
                                                "text": "His flock had already grapevined the what and why."
                                            },
                                            {
                                                "example_id": "a56d130e-4cf8-481a-bbfe-5a15abfe6eba",
                                                "sense_id": "66cfb293-4360-39ad-8992-1001bc772364",
                                                "text": "It will not only be long remembered by the nine million Chinese on Formosa and the twelve and half million overseas Chinese, but will soon be grapevined to the Chinese mainland and whispered there from person to person among the hundreds of millions of Chinese who have been living and suffering for the last five years under Communist tyranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e588d8f-ec98-3551-8468-12c6bd79c8d7",
                                        "entry_id": "437e1d25-01d0-356a-a26f-e109a873eaf3",
                                        "glosses": [
                                            "To link up through an informal communication network."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0accc716-d641-4733-a310-a55e98525d1d",
                                                "sense_id": "3e588d8f-ec98-3551-8468-12c6bd79c8d7",
                                                "text": "But with the Negro foster homes in Pasadena grapevined together, the circumstances of little Narva did not make anyone enthusiastic about taking her into their homes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e2116fd-2ef7-4d3b-89df-b3786eb73aa4",
                        "source_entry_id": "1ee16c51-47c4-38a2-82ea-7855283cf525",
                        "source_sense_id": "b2e34a0d-d547-30b3-9511-0e0635ca71ab",
                        "source_sense_description": "nicht wirklich existenter und nur in der Vorstellung vorhandener Ort, an dem Gerüchte entstehen",
                        "target_lang_word": "rumor mill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rumor mill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4232dfa2-fa84-3b40-856d-7e03f446fcb8",
                                        "entry_id": "fb83721a-b9f7-3243-ab9f-a48b43b5a922",
                                        "glosses": [
                                            "A process in which a group or network of persons originate or promulgate gossip and other unsubstantiated claims."
                                        ],
                                        "tags": [
                                            "US",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e75a3d65-138c-46d0-95a3-6c4e74d7b663",
                                                "sense_id": "4232dfa2-fa84-3b40-856d-7e03f446fcb8",
                                                "text": "For months the Washington rumor mill has ground out gossip about who might replace U.S. Ambassador Frederick E. Nolting Jr."
                                            },
                                            {
                                                "example_id": "33fbd88a-7e60-4353-8da2-2ea97b5c1fb6",
                                                "sense_id": "4232dfa2-fa84-3b40-856d-7e03f446fcb8",
                                                "text": "Unofficial results instead traveled through the rumor mill, passed along on mobile phones from one part of the country to another."
                                            },
                                            {
                                                "example_id": "18d161b9-0de0-4a09-a179-318b8ef49c2f",
                                                "sense_id": "4232dfa2-fa84-3b40-856d-7e03f446fcb8",
                                                "text": "The rumour mill is also abuzz with chat that Alessandro Michele, who parted with Gucci last year, is to make a return to the fashion frontline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
