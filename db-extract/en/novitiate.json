                                        "glosses": [
                                            "iemand die (voor de intrede in het klooster) een proeftijd doormaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0af6e1b-dd94-4efc-b69a-b22d3978b1d1",
                                                "sense_id": "2284d04d-6eae-3959-89dd-7bdeb2af2eb5",
                                                "text": "De jonge novice Agnes bevalt binnen de muren van het klooster van een kind zonder ooit een man te hebben aangeraakt."
                                            },
                                            {
                                                "example_id": "b7412034-f232-4618-a0b3-523eb9f10c7d",
                                                "sense_id": "2284d04d-6eae-3959-89dd-7bdeb2af2eb5",
                                                "text": "Op het onderdeel 1-baton introductie in hun eigen categorie behaalde Dianne Laarman 64.3 punten, Lyan Moes dook daar net onder met 63.5, gevolgd door Sanne Vos 63.1 Marlinde Kroeze 62.5 Kyra Ekkel 60.2 en Cherel Wuite 58.9 punten. Zij werden allemaal in de categorie novice geplaatst."
                                            },
                                            {
                                                "example_id": "6abbc963-e061-47d5-aeda-05aefa1f0440",
                                                "sense_id": "2284d04d-6eae-3959-89dd-7bdeb2af2eb5",
                                                "text": "Kelly Kalkhaar werd tweede en Kimberley Wiegman vierde in de klasse Novice Youth Female. Ook werd een prima prestatie behaald door Celeena Lamers die als vijfde eindigde in de klasse Newcomer Youth Female."
                                            }
                                        ]
                                    }
                                ]
                            }
