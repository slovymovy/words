{
    "word_family": [
        "dominate",
        "dominance",
        "domination",
        "domineering",
        "dominion",
        "predominant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99fa5a67-90ac-37f6-aec8-d17edfd547b2",
                    "sense_definition": "Having power, authority, or influence over others; ruling or governing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "power_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dominant</w> party won the election by a large margin.",
                            "target_lang_translations": {
                                "ru": "<w>Доминирующая</w> партия выиграла выборы с большим отрывом.",
                                "zh": "<w>支配性的</w>政党以巨大优势赢得了选举。"
                            }
                        },
                        {
                            "text": "She has a <w>dominant</w> personality and naturally takes charge of the group.",
                            "target_lang_translations": {
                                "ru": "У неё <w>властный</w> характер, и она естественно берет на себя руководство группой.",
                                "zh": "她性格<w>强势</w>，在团队中总是自然而然地承担起领导责任。"
                            }
                        }
                    ],
                    "antonyms": [
                        "submissive"
                    ],
                    "common_phrases": [
                        "dominant personality",
                        "dominant position",
                        "dominant role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий власть, авторитет или влияние на других; правящий или управляющий.",
                        "zh": "拥有对他人或事物的权力、权威或影响力；处于统治或支配地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господствующий",
                                "target_lang_sense_clarification": "имеющий верховную власть или превосходство"
                            },
                            {
                                "target_lang_word": "доминирующий",
                                "target_lang_sense_clarification": "превосходящий по силе или влиянию"
                            },
                            {
                                "target_lang_word": "властный",
                                "target_lang_sense_clarification": "о характере: склонный повелевать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支配性的",
                                "target_lang_sense_clarification": "指在权力或影响力上处于主导地位"
                            },
                            {
                                "target_lang_word": "强势的",
                                "target_lang_sense_clarification": "形容性格或态度倾向于控制他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c2270c9-cf7a-3f5d-8a19-85ab8723d32c",
                    "sense_definition": "Most common, frequent, or important; prevailing over others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "prevalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agriculture remains the <w>dominant</w> industry in the region.",
                            "target_lang_translations": {
                                "ru": "Сельское хозяйство остается <w>ведущей</w> отраслью в регионе.",
                                "zh": "农业仍然是该地区<w>主要</w>的产业。"
                            }
                        },
                        {
                            "text": "Red is the <w>dominant</w> color in this painting.",
                            "target_lang_translations": {
                                "ru": "Красный — <w>преобладающий</w> цвет на этой картине.",
                                "zh": "红色是这幅画中<w>占优势</w>的颜色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prevalent"
                    ],
                    "common_phrases": [
                        "dominant culture",
                        "dominant feature",
                        "dominant force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наиболее распространенный, частый или важный; преобладающий над другими.",
                        "zh": "最常见、最频繁或最重要的；在其他事物中占优势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобладающий",
                                "target_lang_sense_clarification": "занимающий наибольшее место, встречающийся чаще всего"
                            },
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "главный, наиболее важный"
                            },
                            {
                                "target_lang_word": "доминирующий",
                                "target_lang_sense_clarification": "выделяющийся на фоне остальных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主要的",
                                "target_lang_sense_clarification": "指在数量或重要性上占首位"
                            },
                            {
                                "target_lang_word": "占优势的",
                                "target_lang_sense_clarification": "指在竞争或分布中超过其他部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7823faa-5ad6-37f3-a1db-9906a006ae85",
                    "sense_definition": "Referring to the hand, eye, or foot that a person prefers to use and uses most effectively.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology_handedness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most people write with their <w>dominant</w> hand.",
                            "target_lang_translations": {
                                "ru": "Большинство людей пишут своей <w>ведущей</w> рукой.",
                                "zh": "大多数人写字时都用<w>惯用</w>手。"
                            }
                        },
                        {
                            "text": "In archery, you must aim using your <w>dominant</w> eye.",
                            "target_lang_translations": {
                                "ru": "В стрельбе из лука нужно целиться, используя свой <w>ведущий</w> глаз.",
                                "zh": "射箭时，你必须用<w>惯用</w>眼瞄准。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dominant hand",
                        "dominant eye",
                        "dominant foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к руке, глазу или ноге, которые человек предпочитает использовать и использует наиболее эффективно.",
                        "zh": "指人更倾向于使用且使用效率最高的手、眼或脚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "о руке, глазе или ноге"
                            },
                            {
                                "target_lang_word": "доминантный",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惯用的",
                                "target_lang_sense_clarification": "指身体器官的习惯性使用偏好"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5857871-355d-3196-bc53-e2aa2ccd33b3",
                    "sense_definition": "A gene or trait that is expressed in the phenotype even when inherited from only one parent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this species, the gene for dark fur is a <w>dominant</w>.",
                            "target_lang_translations": {
                                "ru": "У этого вида ген темного меха является <w>доминантом</w>.",
                                "zh": "在这个物种中，深色皮毛的基因是<w>显性</w>的。"
                            }
                        },
                        {
                            "text": "Natural selection may eliminate disadvantageous <w>dominants</w> more quickly than recessive traits.",
                            "target_lang_translations": {
                                "ru": "Естественный отбор может устранять невыгодные <w>доминанты</w> быстрее, чем рецессивные признаки.",
                                "zh": "自然选择淘汰不利<w>显性</w>性状的速度可能比隐性性状更快。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "genetics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ген или признак, который проявляется в фенотипе даже при наследовании только от одного родителя.",
                        "zh": "即使只从单亲遗传也能在表型中表现出来的基因或性状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминант",
                                "target_lang_sense_clarification": "доминантный ген или признак"
                            },
                            {
                                "target_lang_word": "доминантный признак",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显性基因",
                                "target_lang_sense_clarification": "遗传学中表现出的性状"
                            },
                            {
                                "target_lang_word": "显性",
                                "target_lang_sense_clarification": "指遗传学上的显性特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be0f1119-1d10-34ce-bdff-d39411176f41",
                    "sense_definition": "The fifth note of a diatonic musical scale.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The melody resolves from the <w>dominant</w> back to the tonic.",
                            "target_lang_translations": {
                                "ru": "Мелодия разрешается от <w>доминанты</w> обратно в тонику.",
                                "zh": "旋律从<w>属音</w>回到主音结束。"
                            }
                        },
                        {
                            "text": "In the key of C major, G is the <w>dominant</w>.",
                            "target_lang_translations": {
                                "ru": "В тональности до мажор соль является <w>доминантой</w>.",
                                "zh": "在C大调中，G音是<w>属音</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятая ступень диатонической гаммы.",
                        "zh": "自然音阶中的第五级音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминанта",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "属音",
                                "target_lang_sense_clarification": "音乐理论中音阶的第五级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b72d6cc-f478-31ca-a38e-e23ce3ffa00b",
                    "sense_definition": "The partner who takes the controlling role in sadomasochistic sexual activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "power_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dominant</w> set clear rules before the scene began.",
                            "target_lang_translations": {
                                "ru": "<w>Доминант</w> установил четкие правила перед началом сессии.",
                                "zh": "<w>主导方</w>在活动开始前制定了明确的规则。"
                            }
                        },
                        {
                            "text": "Trust is essential between a <w>dominant</w> and their partner.",
                            "target_lang_translations": {
                                "ru": "Доверие необходимо между <w>доминантом</w> и его партнером.",
                                "zh": "<w>主导方</w>与其伴侣之间必须建立信任。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dominator"
                    ],
                    "antonyms": [
                        "submissive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Партнер, берущий на себя контролирующую роль в садомазохистских отношениях.",
                        "zh": "在性虐活动中扮演控制角色的伴侣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминант",
                                "target_lang_sense_clarification": "доминирующий партнер"
                            },
                            {
                                "target_lang_word": "верхний",
                                "target_lang_sense_clarification": "сленг БДСМ-сообщества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主导方",
                                "target_lang_sense_clarification": "指在特定关系中掌握控制权的一方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}