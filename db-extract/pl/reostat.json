                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheostat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11ff512b-8f78-3399-b1c3-3c141fc64798",
                                        "entry_id": "a396d732-9bf0-3c4b-a92b-7ea79a1360ad",
                                        "glosses": [
                                            "historische Bauform eines einstellbaren elektrischen Widerstandes für hohe elektrische Leistung und/oder hohe Präzision und Stabilität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca1ef6f-bfb8-470b-8c54-0939478685bd",
                                                "sense_id": "11ff512b-8f78-3399-b1c3-3c141fc64798",
                                                "text": "„Alles wird sorgfältig mit einem Rheostat reguliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9de60e7f-0666-458a-b2fb-dcf9d9814050",
                        "source_entry_id": "610584f6-a893-358c-a43f-1dfa2c3d66fc",
                        "source_sense_id": "1ca7936e-512d-35b3-aa51-f6287f1afb44",
                        "target_lang_word": "Widerstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "003fbbd5-4a5b-3390-b79d-0d1dee653645",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Eigenschaft, trotz eines verändernden Einflusses im derzeitigen Zustand zu verharren, sich nicht zu verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359d403f-0dd3-4d18-be4e-710516a489b7",
                                                "sense_id": "003fbbd5-4a5b-3390-b79d-0d1dee653645",
                                                "text": "Diese Jacke besitzt einen hohen Verschleiß-Widerstand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb44b3df-8c97-36c4-82fd-65957cecb373",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Verhältnis des Potentialunterschieds zum Strom; Kehrwert der Leitfähigkeit"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdbc50b6-b640-45b8-92fe-753ab25f1979",
                                                "sense_id": "cb44b3df-8c97-36c4-82fd-65957cecb373",
                                                "text": "Je enger die Poren im Gestein, desto höher der (Strömungs-)Widerstand für das Grundwasser."
                                            },
                                            {
                                                "example_id": "9d5bdf02-4884-45fe-bfe2-9ef6e141c07c",
                                                "sense_id": "cb44b3df-8c97-36c4-82fd-65957cecb373",
                                                "text": "Der (elektrische) Widerstand beträgt 50 Ohm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45b717f4-b690-391a-a2ad-e3d07c5d9293",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Bauelement zur Realisierung eines Widerstandes [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b821275-4937-4610-a5bd-a54267a07712",
                                                "sense_id": "45b717f4-b690-391a-a2ad-e3d07c5d9293",
                                                "text": "Der Wert eines (ohmschen) Widerstands kann mitunter an seinen Farbringen abgelesen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3c815a97-844e-3b49-9f81-b2ba28ce2118",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Widerstandskraft (eine der Bewegung entgegengesetzte Kraft)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2d13ce-b4d4-4162-987d-4e9563d9dbde",
                                                "sense_id": "3c815a97-844e-3b49-9f81-b2ba28ce2118",
                                                "text": "Je größer der Cw-Wert eines Fahrzeugs ist, desto höher ist sein (Luft-)Widerstand."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3698d716-cf4c-3d8a-ab9f-cff132b2e1ae",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "[4] dividiert durch die Geschwindigkeit; Kehrwert der Mobilität"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805767d4-2f12-45f7-8bf7-7e370bcda407",
                                                "sense_id": "3698d716-cf4c-3d8a-ab9f-cff132b2e1ae",
                                                "text": "Der Widerstand einer Kugel in Wasser ist abhängig von ihrem Radius."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e861fcc3-efbd-31a7-b3f9-bedb0a6d31e3",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Handlung mit der Absicht, die Wirkung anderer Handlungen abzuschwächen"
                                        ],
                                        "tags": [
                                            "Sozialwissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2408b0f7-bc7d-4793-b067-1a568af27b6f",
                                                "sense_id": "e861fcc3-efbd-31a7-b3f9-bedb0a6d31e3",
                                                "text": "Die Streikenden leisteten den Ordnungsbehörden Widerstand."
                                            },
                                            {
                                                "example_id": "9abbb2dd-f6aa-40f3-8c33-bcb79f7267bd",
                                                "sense_id": "e861fcc3-efbd-31a7-b3f9-bedb0a6d31e3",
                                                "text": "„Ich leistete keinen Widerstand und konnte über ihre erfolglosen Bemühungen nur lächeln.“"
                                            },
                                            {
                                                "example_id": "882f97ce-965e-4423-a612-948f43c3ec7b",
                                                "sense_id": "e861fcc3-efbd-31a7-b3f9-bedb0a6d31e3",
                                                "text": "„Letztes Mal hatte sie noch erbitterte Widerstände zu brechen gehabt, bevor er ein Bad nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Gruppe, deren Aktivitäten sich gegen Handlungen von Obrigkeit, Regierung oder ähnliche Instanzen richten; Kurzform von Widerstandsbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a0824d-d89a-4394-b4f6-eaa1e1e6892b",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "Sophie Scholl gehörte dem Widerstand an."
                                            },
                                            {
                                                "example_id": "4559604a-6e60-49a7-94a9-79584bcf3e14",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "Er war Mitglied im organisierten Widerstand."
                                            },
                                            {
                                                "example_id": "81601e3d-66f8-482f-b1a0-8ef7bbea4fc2",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "Tief verwurzelt im katholischen Glauben […] entschloss sich Willi Graf zum aktiven Widerstand im Kreis der „Weißen Rose“."
                                            },
                                            {
                                                "example_id": "f11f3ed7-3883-4cfb-91a5-c0a9256ff4eb",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "„1943 schloss er [Anmerkung: der Schriftsteller und Chemiker Primo Levi] sich dem Widerstand, der Resistenza, an und kämpfte im Nordwesten Italiens.“"
                                            },
                                            {
                                                "example_id": "a4d46173-bea6-492f-b215-585686e3ec17",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "„Ich sprach in den Versammlungen der Bürger und Studenten, in denen Walther Rathenaus Aufruf zum nationalen Widerstand, zur Levée en masse umkämpft wurde.“"
                                            },
                                            {
                                                "example_id": "79b43728-6da9-428d-8f6d-a3fd18c007b4",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "„Napoleons Widerstand war damit endgültig gebrochen und am 7. Juli 1815 zog Blücher in Paris ein.“"
                                            },
                                            {
                                                "example_id": "986b1b0d-954a-4d25-a0a8-fa33c9062626",
                                                "sense_id": "d1e2be7f-5462-3ebd-b40e-176d059f939e",
                                                "text": "„Ende der 1940er Jahre verschärft sich der Widerstand der Schwarzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "a978c580-d9c6-3b3f-95c5-2c75f5e313f5",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "prinzipielle Haltung gegen Regeln, Befehle, Normen oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956f1dfb-2b62-4e7a-b99e-cb3e72d594cd",
                                                "sense_id": "a978c580-d9c6-3b3f-95c5-2c75f5e313f5",
                                                "text": "Ihr Widerstand wird Sie noch die Gesundheit kosten."
                                            },
                                            {
                                                "example_id": "0d6e5828-d36f-49e6-9f74-c24da075365e",
                                                "sense_id": "a978c580-d9c6-3b3f-95c5-2c75f5e313f5",
                                                "text": "Dieser Vorschlag wird auf Widerstand stoßen."
                                            },
                                            {
                                                "example_id": "cf202367-c55e-41b5-abd5-8ab187643b88",
                                                "sense_id": "a978c580-d9c6-3b3f-95c5-2c75f5e313f5",
                                                "text": "„Sie wußte darüber nicht mehr als ich; aber ihre Worte, daß ein Widerstand gegen Begierden das Gefühl des Erniedrigtseins nach ihrer Befriedigung verhindert, enthielten einen tiefen Sinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "670f0857-2a8d-3c4e-9a77-54ebaabe0089",
                                        "entry_id": "03a79f0c-173b-3246-a02f-00956cff8f87",
                                        "glosses": [
                                            "Ablehnung eines anstehenden Fortschritts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2d3a39-e0f3-4ad5-97de-4a478b61406d",
                                                "sense_id": "670f0857-2a8d-3c4e-9a77-54ebaabe0089",
                                                "text": "Nach dem Widerstand kommt die gesunde Resignation."
                                            },
                                            {
                                                "example_id": "e3379f20-47cf-467b-b227-9656e5d53dc3",
                                                "sense_id": "670f0857-2a8d-3c4e-9a77-54ebaabe0089",
                                                "text": "Daher wird es am zweckmäßigsten sein, die verschiedenen Arten der Widerstände immer anschließend an jene Hilfenart zu besprechen, durch welche sie hervorgerufen wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
