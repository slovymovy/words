                    }
                ],
                "senses": [
                    {
                        "sense_id": "005c7660-1018-3c41-89bf-76afd24a697b",
                        "entry_id": "8cdb0c39-01cb-3e6c-904c-e5740aa8cb8e",
                        "glosses": [
                            "высок. тот, кто обеспечивает сохранность чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3dba66d-70ce-43c6-86a4-197b6c474aa3",
                                "sense_id": "005c7660-1018-3c41-89bf-76afd24a697b",
                                "text": "Хранитель обязан заботиться о музейных памятниках, вести их строгий учёт, отвечать за их сохранность и использование."
                            },
                            {
                                "example_id": "ab44ed0c-a16d-49e0-beab-03da519eccc5",
                                "sense_id": "005c7660-1018-3c41-89bf-76afd24a697b",
                                "text": "Начинающего писателя Жан-Жака Руссо принимал у себя сам господин де Боз, секретарь Академии надписей и хранитель королевской коллекции медалей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dae561d-77c2-4328-aa82-fef5e208b1f6",
                        "source_entry_id": "8cdb0c39-01cb-3e6c-904c-e5740aa8cb8e",
                        "source_sense_id": "005c7660-1018-3c41-89bf-76afd24a697b",
                        "target_lang_word": "keeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff581714-5161-39dc-b43e-dfc15d81dd3c",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "One who keeps (retains) something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab553844-b5ad-4f20-9fa0-60df140da65e",
                                                "sense_id": "ff581714-5161-39dc-b43e-dfc15d81dd3c",
                                                "text": "Finders keepers; losers weepers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36836b39-4e32-3662-b8ff-882647e67d04",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "One who remains or keeps in a place or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5ab3e2-cfe3-4a8b-8972-b2bef068c4e5",
                                                "sense_id": "36836b39-4e32-3662-b8ff-882647e67d04",
                                                "text": "discreet; chaste; keepers at home"
                                            },
                                            {
                                                "example_id": "2e86fb7d-059e-414f-af5d-10e38c908d13",
                                                "sense_id": "36836b39-4e32-3662-b8ff-882647e67d04",
                                                "text": "I was not altogether surprised: they seemed to be, even more than people in the surrounding wolds, stolid keepers-to-themselves, impossible to stir, dourly determined to stick to the firm routine of their lives[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b71eb7c-b031-3137-b1c3-5266f9f8b1e5",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "A fruit or vegetable that keeps (remains good) for some time without spoiling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e61513-d889-458c-b065-d806de522cf8",
                                                "sense_id": "4b71eb7c-b031-3137-b1c3-5266f9f8b1e5",
                                                "text": "Roxbury Russet: Market and keeper."
                                            },
                                            {
                                                "example_id": "a24a3b54-14b3-4ee3-9f64-086d92026a34",
                                                "sense_id": "4b71eb7c-b031-3137-b1c3-5266f9f8b1e5",
                                                "text": "And mark you, good keepers are some years bad keepers, as this year; and a hard, heavy, unbruisable Apple that really will keep to late on in the season is doubly valuable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a18047-4b50-3b6c-aad4-e0d7ddb46b5a",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "A person or thing worth keeping."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e2671a-1c10-475d-9d71-a4c516f94ffe",
                                                "sense_id": "69a18047-4b50-3b6c-aad4-e0d7ddb46b5a",
                                                "text": "\"Okay, that's a keeper,\" Harold said as he netted the 3-pounder and put him on a stringer over the side of the boat."
                                            },
                                            {
                                                "example_id": "a443aaf3-4b8b-4c40-b100-f6ce352f6b40",
                                                "sense_id": "69a18047-4b50-3b6c-aad4-e0d7ddb46b5a",
                                                "text": "When he brought me home and volunteered to come with me while I walked my dog, Max, I knew he was a keeper."
                                            },
                                            {
                                                "example_id": "fb78ed7e-9836-4654-8511-8ccd1b04e6b7",
                                                "sense_id": "69a18047-4b50-3b6c-aad4-e0d7ddb46b5a",
                                                "text": "We hadn't dated for long when he said those three magic words: \"I'll cook tonight.\" I knew he was a keeper."
                                            },
                                            {
                                                "example_id": "51bbd678-e381-4c3f-a89e-2134f12a17f1",
                                                "sense_id": "69a18047-4b50-3b6c-aad4-e0d7ddb46b5a",
                                                "text": "He sucked in a deep breath, then opened his eyes and searched for hers. \"So what do you figure? Alternate universe?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89db445-5e66-3f9f-99f8-1c522e6cfb88",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "A person charged with guarding or caring for, storing, or maintaining something; a custodian, a guard; sometimes a gamekeeper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0708e1d4-601b-414e-9620-ccbf7ac8802c",
                                                "sense_id": "e89db445-5e66-3f9f-99f8-1c522e6cfb88",
                                                "text": "And the Lord said unto Cain, Where is Abel thy brother? And he said, I know not: Am I my brother's keeper?"
                                            },
                                            {
                                                "example_id": "bb7375c4-07d7-41bd-b7bd-d93e185a355e",
                                                "sense_id": "e89db445-5e66-3f9f-99f8-1c522e6cfb88",
                                                "text": "The inquest on keeper Davidson was duly held, and at the commencement seemed likely to cause Tony Palliser less anxiety than he had expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607a4411-2c93-3d59-aeae-e8cd1f8efc7a",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "The player charged with guarding a goal or wicket; a goalkeeper or wicketkeeper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427444be-dde5-4b48-a0ad-0cea5f304a34",
                                                "sense_id": "607a4411-2c93-3d59-aeae-e8cd1f8efc7a",
                                                "text": "England should have capitalised on their growing momentum to win, but Darren Bent failed to reproduce the finishing touches that have brought him goals in three successive appearances. He was blocked by Diego Benaglio when he was played in by Wilshere then blazed over the top of an open goal late on after Young's shot was saved by Switzerland's keeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57eebbd1-9061-3d01-ad5d-ba6977eb9874",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "At Eton College, a student who is the captain of a sport or an activity such as drama."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5a9be59-b9d0-3810-aa46-041e267f44fc",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "A part of a mechanism that catches or retains another part, for example the part of a door lock that fits in the frame and receives the bolt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28c3d628-3209-394d-b5b1-835876020f5b",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "A thin, flexible tress or tongue of material (e.g. leather) at the end of a crop opposite the handle, which is broad enough to prevent the horse's skin from being marked as it might be by a whip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4d6b4b-6e47-4095-813d-02649b144e43",
                                                "sense_id": "28c3d628-3209-394d-b5b1-835876020f5b",
                                                "text": "The all-whalebone crop, braided with gut, pigskin handle, single brown stitched leather keeper, and close[…]"
                                            },
                                            {
                                                "example_id": "1a6309f9-de79-4f50-9c07-65272484d367",
                                                "sense_id": "28c3d628-3209-394d-b5b1-835876020f5b",
                                                "text": "“When we catch you—” A brief but vivid fantasy of the nose-ringed girl trailing a riding crop's cool leather keeper over her clenched and trembling ass shoved its way eagerly into Fran's imagination. “—we're gonna[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcfda2ff-8542-3689-a9ca-2f02f1a04a1f",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "An offensive play in which the quarterback runs toward the goal with the ball after it is snapped."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e62622e7-64fc-34b8-8a44-092b9d5b8fb6",
                                        "entry_id": "c7dac13a-a08a-37a5-9934-b398b858047d",
                                        "glosses": [
                                            "Synonym of armature (“piece of metal connecting the poles of a magnet to preserve its strength by forming a circuit”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132341e7-495a-4af1-8bc4-c44fafbfaa87",
                                                "sense_id": "e62622e7-64fc-34b8-8a44-092b9d5b8fb6",
                                                "text": "The continuous lines indicate the moments, when the magnet and keeper of equal diameter (10.5mm) act upon each other […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
