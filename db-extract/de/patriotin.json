                ],
                "senses": [
                    {
                        "sense_id": "70e5bbf9-3b98-34c1-9733-ebdf091082c5",
                        "entry_id": "acb5e8ec-2305-3242-aa77-184015c2a90c",
                        "glosses": [
                            "weibliche Person, welche ihr Heimatland liebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "598de6c5-a9fd-4e83-a713-19112d98045f",
                                "sense_id": "70e5bbf9-3b98-34c1-9733-ebdf091082c5",
                                "text": "„Ihm wurde heiß, denn Yvonne küßte mit der Leidenschaft einer Patriotin, die einen nationalen Dank abstattet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41097b6f-1919-4b7b-a27b-a3d0f9b59e09",
                        "source_entry_id": "acb5e8ec-2305-3242-aa77-184015c2a90c",
                        "source_sense_id": "70e5bbf9-3b98-34c1-9733-ebdf091082c5",
                        "source_sense_description": "weibliche Person, welche ihr Heimatland liebt",
                        "target_lang_word": "patriot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                        "entry_id": "7ba70301-65d5-3ce9-964a-c5e4cc39ae79",
                                        "glosses": [
                                            "A person who loves and zealously supports and defends their country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3aeb09-5837-4e89-8974-2c48c99dd5ec",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "Here Tears ſhall flovv from a more gen'rous Cauſe, / Such Tears as Patriots ſhed for dying Lavvs: […]"
                                            },
                                            {
                                                "example_id": "833c80db-235e-4f00-a64c-573338fdf140",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "'My country, right or wrong,' is a thing that no patriot would think of saying except in a desperate case. It is like saying, 'My mother, drunk or sober.'"
                                            },
                                            {
                                                "example_id": "e0ac2de1-634b-4ce2-a635-36b3fa70ed27",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "The difference between patriotism and nationalism is that the patriot is proud of his country for what it does, and the nationalist is proud of his country no matter what it does; the first attitude creates a feeling of responsibility, but the second a feeling of blind arrogance that leads to war."
                                            },
                                            {
                                                "example_id": "59c62be8-61e8-41e7-845e-049d5ad0031c",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "Nothing beats a gunboat. HMS Illustrious glided out of Portsmouth on Monday, past HMS Victory and cheering crowds of patriots. Within a week it will be off Gibraltar, a mere cannon shot from Cape Trafalgar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1189f0c-c43a-37ae-b42b-781b64ddc799",
                                        "entry_id": "7ba70301-65d5-3ce9-964a-c5e4cc39ae79",
                                        "glosses": [
                                            "A fellow countryman, a compatriot."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60e19af-8321-4d46-a2aa-1dbff9388168",
                                                "sense_id": "f1189f0c-c43a-37ae-b42b-781b64ddc799",
                                                "text": "The aim of patriots, therefore, was to set limits to the power which the ruler should be allowed to exercise over the community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1996c77-14e6-496c-85b1-c9c01a58f0e6",
                        "source_entry_id": "acb5e8ec-2305-3242-aa77-184015c2a90c",
                        "source_sense_id": "70e5bbf9-3b98-34c1-9733-ebdf091082c5",
                        "source_sense_description": "weibliche Person, welche ihr Heimatland liebt",
                        "target_lang_word": "patriote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5378cd16-5def-35f4-894c-3f2cbb9b03b2",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Compatriote."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Personne qui adhère à l’idée de patrie, qui aime sa patrie et s’efforce de bien la servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef558bbf-35e9-4689-b50b-60684a177a72",
                                                "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                                "text": "Je me suis toujours appliqué à être un patriote, mais, en vérité, j’étais un patriote de salon."
                                            },
                                            {
                                                "example_id": "0dcdb856-2788-44e2-a230-d3c5d9a96fcd",
                                                "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                                "text": "L’empire assyrien, l’empire persan, l’empire d’Alexandre ne furent pas non plus des patries. Il n’y eut jamais de patriotes assyriens ; l’empire persan fut une vaste féodalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2ffc5d-3631-3f98-b2b7-f7e6c1172de3",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Résistant à l’occupant, dans les guerres de libération nationale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6010f886-1999-3314-bfe9-2acb3a003914",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Partisan de la Révolution française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a339150b-1000-3e96-bde6-fe342a4cb6b2",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Résistant à l’Occupation allemande de la France en 1940-1945, par opposition aux collaborateurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Personne prônant le rattachement de Hong Kong à la Chine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbff675f-409b-4908-99e2-0f738206792d",
                                                "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                                "text": "Pour cause, le patriotisme est devenu synonyme de contrôle croissant de la Chine sur sa région administrative spéciale. Le PCC a ainsi réformé le système électoral de Hong Kong en adoptant une «loi sur les patriotes» qui interdit aux citoyens qui la violeraient d'exercer une fonction politique. Plus récemment, le parti a interdit ce qui est devenu l'hymne officieux de Hong Kong: une chanson contestataire intitulée «Glory to Hong Kong» («gloire à Hong Kong» en français)."
                                            },
                                            {
                                                "example_id": "070b5e83-60cb-4e4f-ab7b-000676e0a5d7",
                                                "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                                "text": "Le parti n’a plus de siège à l’Assemblée depuis que ses élus ont démissionné en 2020 pour protester contre la reprise en main chinoise et que Hongkong a remanié son système électoral en 2021 pour le réserver à des « patriotes ». Cela sonnait alors le début de la fin pour le Parti démocrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635d53ca-2c31-3b54-9b6e-b6afc25e81db",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Membre du mouvement des Patriotes (essentiellement 1826-1840, et surtout 1837-1840)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patriote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3775ce0-8d06-3b7d-8e88-813564b9f4ca",
                                        "entry_id": "532407ed-82c0-3d29-9f57-06fab551b472",
                                        "glosses": [
                                            "Qui fait preuve d’un vif attachement envers sa patrie et la sert avec dévouement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6d3ab1-fdf4-4ec1-b0e3-935a82301241",
                                                "sense_id": "e3775ce0-8d06-3b7d-8e88-813564b9f4ca",
                                                "text": "En 1910, le parti pro-germanique secondait les attaques contre la Chambre des Lords, dont la majorité était patriote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c18ac0-2f92-305e-9029-def5872278ea",
                                        "entry_id": "532407ed-82c0-3d29-9f57-06fab551b472",
                                        "glosses": [
                                            "Partisan de la Révolution française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
