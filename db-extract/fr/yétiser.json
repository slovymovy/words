                "senses": [
                    {
                        "sense_id": "54f62f0a-912e-3a57-b78d-5ae0071bd7a0",
                        "entry_id": "c1a7c95c-82af-39b5-9d95-950eedb3b857",
                        "glosses": [
                            "Couvrir de poils."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "a238dbc0-e394-4b52-90dd-d884fe7f357f",
                                "sense_id": "54f62f0a-912e-3a57-b78d-5ae0071bd7a0",
                                "text": "Présent par sa taille, sa gentillesse et son odeur, il me gratifie tout au long de l’année d’un volume de poil à me yétiser pour plusieurs hivers sibériens."
                            },
                            {
                                "example_id": "004c024d-2c05-4aeb-b7cb-1a4a4e5c6e89",
                                "sense_id": "54f62f0a-912e-3a57-b78d-5ae0071bd7a0",
                                "text": "J’ vais me \"yétiser\" tiens!"
                            },
                            {
                                "example_id": "9554b044-fd7a-4af8-b32f-841ff5671e90",
                                "sense_id": "54f62f0a-912e-3a57-b78d-5ae0071bd7a0",
                                "text": "Perso mes jambes sont pas épilées depuis plusieurs mois et je ne me sens pas \"yétisée\" pour autant…"
                            },
                            {
                                "example_id": "dfad5654-b33c-42ee-8442-0f12d096fc0b",
                                "sense_id": "54f62f0a-912e-3a57-b78d-5ae0071bd7a0",
                                "text": "Garantie antidragueurs: en Chine, la jupette se porterait sur des jambes yétisées."
                            }
                        ]
                    }
                ],
