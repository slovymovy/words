                        "target_lang_word": "ex-mari",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ex-mari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c00a75-6194-3f6f-be65-780966a03b88",
                                        "entry_id": "618486cb-a7d6-3ef6-a3bd-0dfa8cd69d1e",
                                        "glosses": [
                                            "Ancien mari, ancien époux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad45749f-038a-4c65-a329-def426aad1b4",
                                                "sense_id": "a1c00a75-6194-3f6f-be65-780966a03b88",
                                                "text": "Les inquiétudes de Lucile concernant la violence de son ex-mari ou le climat d’enfermement dans lequel elle craint que nous vivions sont signalées, ainsi que les doutes de Gabriel sur la capacité de son ex-femme à assumer la garde et la manière dont nous avons été, jusque-là, livrées à nous-mêmes."
                                            },
                                            {
                                                "example_id": "f54f7cc3-580c-4cd3-9f77-1e19a6018b19",
                                                "sense_id": "a1c00a75-6194-3f6f-be65-780966a03b88",
                                                "text": "Visiblement, son ex-mari avait laissé ses livres en partant."
                                            },
                                            {
                                                "example_id": "966e64df-7e0d-4832-8033-0e580d19afc6",
                                                "sense_id": "a1c00a75-6194-3f6f-be65-780966a03b88",
                                                "text": "Le 20 juin dernier, c’est Cédric Bruguière, son ex-mari, qui est sorti du silence pour dire le fond de sa pensée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
