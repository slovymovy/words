                "senses": [
                    {
                        "sense_id": "d9b31bb6-893a-3066-b8e8-824606bc6b2d",
                        "entry_id": "09760fc4-9b85-3092-b0e0-e82a381f84e2",
                        "glosses": [
                            "een min of meer spontane, onvoorbereide vorm van muzikaal samenspel, meestal in het jazzgenre of aanverwante popgenres als hardrock, blues en rock"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f357643-62da-4917-9ca2-5c31c73ed1fc",
                                "sense_id": "d9b31bb6-893a-3066-b8e8-824606bc6b2d",
                                "text": "Vernieuwing door verdieping - het kan! Dat bewijzen Andrea Leine en Harijono Roebana, die voor hun zilveren jubileumchoreografie Light voor de derde keer samenwerken met de Indonesische componist Iwan Gunawan, voor de tweede keer in gezelschap van zijn gamelanensemble Kyai Fatahillah - nu aangevuld met de operazangeressen Bernadeta Astari en Ekaterina Levental, tevens harpiste. Het is geen gemakzuchtig teruggrijpen op hun hit Ghost uit 2011, maar een extra grote cross-over met de speelsheid van een jamsessie."
                            },
                            {
                                "example_id": "9efd5436-12fb-42ce-81d2-2b9f1088f51e",
                                "sense_id": "d9b31bb6-893a-3066-b8e8-824606bc6b2d",
                                "text": "Kom even rustig op gang op deze mooie maandagmorgen en laat je toezingen door deze drie heren die bij een Amerikaanse supermarkt spontaan een jamsessie starten, een jamsessie die lekker wegluistert en bijzonder snel viral ging."
                            }
                        ]
                    }
                ],
