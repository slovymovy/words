                        "examples": [
                            {
                                "example_id": "da0f9349-f238-4aa9-b3dd-c2c549464c45",
                                "sense_id": "9260d338-d722-3fce-b688-b0582f8ec0c6",
                                "text": "Vanuit het houten huis, dat zeker meer dan honderd jaar oud was, klonk operamuziek."
                            },
                            {
                                "example_id": "9134d2d1-b872-4142-9288-2e491ba8132f",
                                "sense_id": "9260d338-d722-3fce-b688-b0582f8ec0c6",
                                "text": "In de karaokerubriek tijdens The Late Late Show bewees Jason bovendien dat hij een geoefend operazanger is. Grappend beloofde Jason dat hij zijn liefde voor hiphop en operamuziek nog eens zal combineren in een nieuw muziekgenre."
                            },
                            {
                                "example_id": "91aa4f3d-49f6-4f37-ab0d-991c3ca4fa9b",
                                "sense_id": "9260d338-d722-3fce-b688-b0582f8ec0c6",
                                "text": "Eenmaal binnen bleek er echter niemand in nood, maar troffen ze een man aan die hardop meezong met operamuziek. Hij was alleen thuis en had een koptelefoon op gezet, maar zijn operastem klonk toch wat minder muzikaal dan hij wellicht gehoopt had."
                            }
                        ]
                    }
