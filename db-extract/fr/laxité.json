                                "sense_id": "5725127d-3c6c-37b6-8c10-f1a297b42b58",
                                "text": "La laxité de la peau du ventre après l’évacuation des eaux de l’ascite."
                            },
                            {
                                "example_id": "0149f24b-30e7-420a-9805-37088c24cd53",
                                "sense_id": "5725127d-3c6c-37b6-8c10-f1a297b42b58",
                                "text": "La laxité d’une corde."
                            },
                            {
                                "example_id": "a9e8d056-3449-4384-abb3-8ac15d27bff1",
                                "sense_id": "5725127d-3c6c-37b6-8c10-f1a297b42b58",
                                "text": "Cette laxité frontale témoigne d’une destruction fémoro-tibiale importante ou d’une laxité des ligaments latéraux."
                            }
                        ]
