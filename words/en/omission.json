    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e19bcc2a-bf13-3893-9af1-568cdc1815c3",
                    "sense_definition": "The act of leaving something out or excluding it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_excluding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>omission</w> of her name from the guest list was a deliberate decision.",
                            "target_lang_translations": {
                                "ru": "<w>Исключение</w> её имени из списка гостей было намеренным решением."
                            }
                        },
                        {
                            "text": "The editor explained that the <w>omission</w> of the final chapter was due to space constraints.",
                            "target_lang_translations": {
                                "ru": "Редактор объяснил, что <w>пропуск</w> последней главы был вызван нехваткой места."
                            }
                        }
                    ],
                    "synonyms": [
                        "exclusion",
                        "leaving out"
                    ],
                    "antonyms": [
                        "inclusion"
                    ],
                    "common_phrases": [
                        "deliberate omission",
                        "by omission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по исключению или ненаписанию чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "действие по исключению чего-либо из текста или списка"
                            },
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "намеренное или ненамеренное невключение"
                            },
                            {
                                "target_lang_word": "упущение",
                                "target_lang_sense_clarification": "недосмотр, ненамеренный пропуск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57c43e96-88f1-351a-93b5-d282b7a13a19",
                    "sense_definition": "Something that has been left out, deleted, or neglected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thing_excluded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check the document carefully to ensure there are no errors or <w>omissions</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, внимательно проверьте документ, чтобы убедиться в отсутствии ошибок и <w>пропусков</w>."
                            }
                        },
                        {
                            "text": "The suspicious <w>omissions</w> in the report attracted claims of censorship.",
                            "target_lang_translations": {
                                "ru": "Подозрительные <w>упущения</w> в отчете вызвали обвинения в цензуре."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversight",
                        "gap"
                    ],
                    "antonyms": [
                        "addition"
                    ],
                    "common_phrases": [
                        "errors and omissions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что было упущено, удалено или не сделано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "пропущенное место или деталь в документе"
                            },
                            {
                                "target_lang_word": "упущение",
                                "target_lang_sense_clarification": "ошибка по небрежности, недосмотр"
                            },
                            {
                                "target_lang_word": "пробел",
                                "target_lang_sense_clarification": "недостаток информации или знаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f6e9a5-c65a-3f8f-8ad1-52f1adeda8c4",
                    "sense_definition": "The failure to perform an action, especially one that is required or expected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "failure_to_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was sued for negligence due to an <w>omission</w> of safety checks.",
                            "target_lang_translations": {
                                "ru": "На компанию подали в суд за халатность из-за <w>непроведения</w> проверок безопасности."
                            }
                        },
                        {
                            "text": "In legal terms, a crime can be committed by an act or a failure to act, known as an <w>omission</w>.",
                            "target_lang_translations": {
                                "ru": "С юридической точки зрения преступление может быть совершено путем действия или бездействия, именуемого <w>упущением</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "neglect",
                        "nonfeasance"
                    ],
                    "antonyms": [
                        "commission"
                    ],
                    "common_phrases": [
                        "act or omission",
                        "negligent omission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невыполнение действия, особенно обязательного или ожидаемого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездействие",
                                "target_lang_sense_clarification": "юридический термин, невыполнение обязанностей"
                            },
                            {
                                "target_lang_word": "упущение",
                                "target_lang_sense_clarification": "невыполнение должного действия"
                            },
                            {
                                "target_lang_word": "невыполнение",
                                "target_lang_sense_clarification": "неосуществление требуемого действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2f7197c-dfb4-3fd9-be96-45882baaf63c",
                    "sense_definition": "The shortening of a word or phrase by leaving out letters, often represented by an apostrophe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistic_shortening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apostrophe in the word 'don't' indicates the <w>omission</w> of the letter 'o'.",
                            "target_lang_translations": {
                                "ru": "Апостроф в слове «don't» указывает на <w>пропуск</w> буквы «o»."
                            }
                        },
                        {
                            "text": "In informal writing, the <w>omission</w> of letters is common to mimic spoken dialect.",
                            "target_lang_translations": {
                                "ru": "В неформальном письме <w>пропуск</w> букв часто используется для имитации разговорного диалекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "elision",
                        "contraction"
                    ],
                    "common_phrases": [
