                        "sense_id": "6800fe2f-09b5-3d4f-a94f-ce159294b02a",
                        "entry_id": "7cd275d3-7e7b-3ce6-938c-245a0c29f05a",
                        "glosses": [
                            "Détonation subite, explosion d’une matière fulminante."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5594ee86-56d6-3113-9a68-a7a6aceb8876",
                        "entry_id": "7cd275d3-7e7b-3ce6-938c-245a0c29f05a",
                        "glosses": [
                            "Action de lancer une condamnation, ou une dispense."
                        ],
                        "tags": [
                            "Droit canon"
                        ],
                        "examples": [
                            {
                                "example_id": "c76dcb4f-e3fc-4307-bd6e-696558833e96",
                                "sense_id": "5594ee86-56d6-3113-9a68-a7a6aceb8876",
                                "text": "La fulmination d’une sentence ecclésiastique."
                            },
                            {
                                "example_id": "36925bfe-bec6-4e53-920d-0281c4886595",
                                "sense_id": "5594ee86-56d6-3113-9a68-a7a6aceb8876",
                                "text": "La fulmination d'une dispense papale à l'occasion d'un mariage religieux normalement interdit suite à un degré de parenté trop proche."
                            },
                            {
                                "example_id": "7d44df6c-769a-4256-9b05-e6f1675f72e4",
                                "sense_id": "5594ee86-56d6-3113-9a68-a7a6aceb8876",
                                "text": "Le pape prononça les fulminations contre lui avec précipitation, et Henri en fut tellement irrité qu'il se déclara chef de la religion et entraîneur de toute l'Angleterre dans le malheureux changement où vous la voyez."
                            },
                            {
                                "example_id": "7ad9fa50-b94e-45b2-84b3-b2aecad1a2df",
                                "sense_id": "5594ee86-56d6-3113-9a68-a7a6aceb8876",
                                "text": "Finalement, durant, cette période, seul Henri II prit l’initiative de rompre le traité de Tordesillas, et donc de passer outre à la bulle d’Alexandre VI, soixante ans après sa fulmination."
                            }
                        ]
                    }
