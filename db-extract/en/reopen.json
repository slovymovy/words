                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                        "entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                        "glosses": [
                            "To open (something) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee16f685-8e86-43dc-aa54-059b9c7db454",
                                "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                                "text": "1920, Breckinridge Long, US Ambassador to Italy, a speech titled America's Accomplishments\nFrom the moment of the declaration by Germany, she would reopen her inhuman warfare by the indiscriminate use of submarines."
                            },
                            {
                                "example_id": "266aa7df-e575-4fed-b7d6-9902744338e6",
                                "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                                "text": "Says Barnes: \"The next priority [for Devon County Council] is reopening the line from Tavistock to Plymouth."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cd4463-581a-3388-b4d9-69cbf2867eb9",
                        "entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                        "glosses": [
                            "To open again."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89a2de87-6cd3-4b9b-a9b9-06753dc424e7",
                                "sense_id": "02cd4463-581a-3388-b4d9-69cbf2867eb9",
                                "text": "The new law allows the twelve Federal Reserve Banks to issue additional currency on good assets and thus the banks which reopen will be able to meet every legitimate call."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3933eda2-99d4-4302-a3a2-6f0f3210a42d",
                        "source_entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                        "source_sense_description": "(transitive) to open again",
                        "target_lang_word": "rouvrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouvrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                        "entry_id": "01c8d0d4-19b9-346c-9466-4a62863bbe27",
                                        "glosses": [
                                            "Ouvrir de nouveau, ouvrir ce qui avait été fermé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf26df9-34d3-4558-8a99-74b0cf906c0a",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "Hervé les avait vus distinctement tracasser la grille et un grincement de ferrailles lui apprit qu'ils l’avaient fermé à clé, derrière eux, après l’avoir ouverte en arrivant, et qu'ils étaient en train de la rouvrir pour s’en aller."
                                            },
                                            {
                                                "example_id": "16644ace-00aa-42a1-9130-8f813301142f",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "La question de la fin du permis à vie a été rouverte il y a une dizaine de jours après l’accident de Pauline Déroulède, qui a dû être amputée d’une jambe, après s’être fait renverser par un conducteur âgé."
                                            },
                                            {
                                                "example_id": "1882b5a9-8560-409d-b8bf-8d58e2472096",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "Une à une les succursales des magasins de luxe parisiens, londoniens ou berlinois fermaient, devant rouvrir, l'été, dans les stations chic : Chamonix, Royat, ou Aix-les-Bains."
                                            },
                                            {
                                                "example_id": "8e1d6b12-b599-4ab4-95b5-a0e9e843fb80",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "— […] ; mais la porte du jardin s’est rouverte, mon amant est là, dans l’allée, il vient, il approche, […]."
                                            },
                                            {
                                                "example_id": "b244b9a1-bfef-47be-8617-da29744c1524",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "— Soudain, comme d’une plaie saignante qui se serait rouverte au fond d’elle même, tout son amour surgit."
                                            },
                                            {
                                                "example_id": "f3b92064-4bb9-480a-8d30-24ba6fe309d3",
                                                "sense_id": "52fd88d9-10db-36df-a76f-2f7e43602f95",
                                                "text": "— Ce théâtre ne rouvrira qu’en décembre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeadb60f-6915-3421-a892-fa1f08ce4d73",
                                        "entry_id": "01c8d0d4-19b9-346c-9466-4a62863bbe27",
                                        "glosses": [
                                            "Redonner entière liberté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c36c849-6abf-4f3f-b659-02caf3b42a9e",
                                                "sense_id": "eeadb60f-6915-3421-a892-fa1f08ce4d73",
                                                "text": "Quelques hommes, qui ont dans le cœur plus de génie que le XVIIIe siècle n’en avait dans la tête, ont rouvert par d’admirables inspirations les chemins de l’âme que le scepticisme et l’impiété avaient fermés depuis si longtemps."
                                            },
                                            {
                                                "example_id": "8a7a8a15-ef57-4390-9cd1-01a43ed5375d",
                                                "sense_id": "eeadb60f-6915-3421-a892-fa1f08ce4d73",
                                                "text": "Ces questions sembleront peut-être déplacées dans les circonstances. On se les poserait néanmoins si on cherchait à rouvrir la société dans le respect de la sécurité sanitaire pour traverser les derniers mois de l’épidémie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e8235b-3826-4d81-9e2e-e61e9f08adde",
                        "source_entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                        "source_sense_description": "(transitive) to open again",
                        "target_lang_word": "réouvrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réouvrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                        "entry_id": "f603d49e-3c29-3dd9-bb6d-87f98ec5a96f",
                                        "glosses": [
                                            "Ouvrir à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd4eb6a0-59de-44c9-a48b-d47364a25b5e",
                                                "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                                "text": "Depuis le week-end des 10 et 11 juin, les jardins en terrasses du castel Vuillier, au bourg de Gimel-les-Cascades, ont été réouverts au public, après trente mois de travaux et d’aménagement paysager."
                                            },
                                            {
                                                "example_id": "1f8e1d19-2892-4c67-a032-3fc9f357d081",
                                                "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                                "text": "Je rampai long-temps dans des détours obliques, j'entrevis la lumière, je rendis la liberté à mon guide, et, continuant à réouvrir un passage, je sortis de la région des ténèbres."
                                            },
                                            {
                                                "example_id": "df10ea54-a6d0-4dbc-b19e-930954f6b25f",
                                                "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                                "text": "En tous cas, et en admettant que le débat, dont, selon nous, le vœu de la loi appelle l’extinction complète, en même temps que celle de l'instance, soit susceptible de se réouvrir, sous la forme nouvelle d'une demande directe en révocation intentée dans les termes de l’art. 957 […]."
                                            },
                                            {
                                                "example_id": "9f0faeaa-df1d-4f47-82be-7ecde51af543",
                                                "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                                "text": "De plus, ils sont prêts à réouvrir les manufactures pour le temps de l'arbitrage à la condition que les ouvriers signent les documents déposés chez le notaire Grenier ; ceux-ci seront nuls si la sentence les contredit."
                                            },
                                            {
                                                "example_id": "a08bde7f-39ab-42ef-85f5-16912696110d",
                                                "sense_id": "409631ad-658d-3a1a-83f9-a6d30ef6cc80",
                                                "text": "Ce n'est qu'en 1877 qu'une mission catholique put réouvrir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
