        "fr-extract.jsonl": [
            {
                "entry_id": "ba59ef63-6ef0-3deb-877a-09e772824b78",
                "word": "laïque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c411e81-e9e8-4944-a97a-c73c6e0ab8d0",
                        "entry_id": "ba59ef63-6ef0-3deb-877a-09e772824b78",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "laïques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5571f957-7c52-30d4-a330-462f069a1e82",
                        "entry_id": "ba59ef63-6ef0-3deb-877a-09e772824b78",
                        "glosses": [
                            "Variante de laïc."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "322c7949-b9c1-4da8-a124-83626f5f9994",
                                "sense_id": "5571f957-7c52-30d4-a330-462f069a1e82",
                                "text": "Il faut à une vie une religion mystique ou laïque, une grande idée."
                            },
                            {
                                "example_id": "e95b239a-b075-48de-9494-1b4892ee985e",
                                "sense_id": "5571f957-7c52-30d4-a330-462f069a1e82",
                                "text": "Face à l’afflux de blessés pendant la guerre (1 200 lits), et à l’augmentation du nombre d’infirmiers et d’infirmières majors, les sœurs de Saint-Éloi perdent néanmoins du terrain : le personnel laïque « essaie de remplacer les sœurs pour les pansements, piqûres, salles d’opération, etc. » (1919)."
                            },
                            {
                                "example_id": "def1fb84-106b-4c20-b8de-7bae99c0aded",
                                "sense_id": "5571f957-7c52-30d4-a330-462f069a1e82",
                                "text": "Cette secte japonaise, dirigée par Daisaku Ikeda depuis le 3 mai 1960, est le pendant laïque de l'ordre des moines bouddhistes de l’obédience Nichiren Shoshu."
                            }
                        ]
                    }
                ],
