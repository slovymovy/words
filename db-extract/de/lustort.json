                ],
                "senses": [
                    {
                        "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                        "entry_id": "d5fa0d5c-6eae-35f7-b526-a394020ce3d5",
                        "glosses": [
                            "Ort, wohin man reist, wo man seine Zeit verbringt oder lebt, weil es angenehm ist, Freude bereitet"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "baa71189-a4b8-47a8-9ae9-5a3405198a74",
                                "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                                "text": "„Auch früher schon war Antium der beliebte Lustort der Römer; Atticus, Lucullus, Cicero, Mäcenas und Augustus hatten hier ihre Villen, und wo, in welchem kühlen Gebirg, an welchem lieblichen Strande Italiens hätten die Glücklichen nicht ihre Villen gehabt!“"
                            },
                            {
                                "example_id": "e36eb48d-0a03-4298-a5bf-88b98db11a66",
                                "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                                "text": "„Wir gingen in das Kollegium zurück, und gern nahm ich des Professors Einladung an, der mit mir nachmittags einen nahgelegenen Lustort besuchen wollte.“"
                            },
                            {
                                "example_id": "015cbc05-01ec-4917-bd98-7433d0a57353",
                                "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                                "text": "„So fahren sie also in einer Droschke nach Jakobsruh, jenem Lustort, der bekanntlich so schön ist wie nichts auf der Welt.“"
                            },
                            {
                                "example_id": "bfdb51d6-e7d9-40de-9fa0-80b7ec836f5d",
                                "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                                "text": "„Es ist wirklich die größte Verkehrtheit, diesen Schauplatz des Jammers in einen Lustort verwandeln zu wollen und, statt der möglichsten Schmerzlosigkeit, Genüsse und Freuden sich zum Ziele zu stecken; wie doch so viele tun. “"
                            },
                            {
                                "example_id": "f76265a4-7238-4fce-9d6f-a7dc90bb3dd9",
                                "sense_id": "bbeb118a-ab07-3186-80a0-f4ffb45e9fd1",
                                "text": "„Er besuchte nur noch aus Gewohnheit sowohl Freunde als Lustörter, und nur mit Widerwillen griff er noch einigemal in die Kasse des Vaters, um Ausgaben zu bestreiten, zu denen ihn keine Leidenschaften nötigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
