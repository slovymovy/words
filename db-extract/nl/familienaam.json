                                    },
                                    {
                                        "sense_id": "9c56f19b-df63-3574-85ec-608b011d0772",
                                        "entry_id": "fe2d2681-4074-35fa-b8bf-fa0f85c2f4c1",
                                        "glosses": [
                                            "To call by a surname."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03fca5fd-76ad-4c75-9958-560596a53cb7",
                                                "sense_id": "9c56f19b-df63-3574-85ec-608b011d0772",
                                                "text": "“Lord,” said Sir Launcelot, “I am hight Launcelot, and am surnamed ‘He of the Lake.’”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e40609e-961a-4e95-9951-9863ea7e68f9",
                        "source_entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "source_sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "source_sense_description": "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt",
                        "target_lang_word": "last name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "last name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c28d6f8-78b3-3259-a808-cbb63e458382",
                                        "entry_id": "7da62444-9efb-3846-8265-88629b7962fa",
                                        "glosses": [
                                            "Synonym of surname, a person's family name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d913f21e-997e-3e20-800e-0b0a9b4b7598",
                                        "entry_id": "7da62444-9efb-3846-8265-88629b7962fa",
                                        "glosses": [
                                            "The last element of a full name, particularly when it could also be given name in East Asian and other cultural traditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88fc3131-713e-40c9-b582-9ea9a9fff3e5",
                                                "sense_id": "d913f21e-997e-3e20-800e-0b0a9b4b7598",
                                                "text": "In a structure typical for East Asia cultures, last names are usually used as given names. It usually differentiates that person from the other members of a group (typically a family or clan) who have a common family name"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a7ca5db-1d15-411b-a8e5-906a9b1b1e8b",
                        "source_entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "source_sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "source_sense_description": "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt",
                        "target_lang_word": "nom de famille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nom de famille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "040de0ce-ab13-30f9-8f6e-6af316b29c8a",
                                        "entry_id": "8b42fc5e-a406-3a45-b646-7363fbed3357",
                                        "glosses": [
                                            "Nom qu’une personne partage avec les autres membres de sa famille, hérité de ses parents, distinct de son ou ses noms personnels (prénoms ou postnoms), et qui se transmet de génération en génération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc0deb1-ccd9-416d-a35e-bd6b78d8e16a",
                                                "sense_id": "040de0ce-ab13-30f9-8f6e-6af316b29c8a",
                                                "text": "Je lui ai annoncé qu’il avait perdu son nom de famille, – l’autre nom après Jules. Ça, il l’a compris ; un enfant comprend ce que c’est que de perdre : on perd son mouchoir, des billes, des sous."
                                            },
                                            {
                                                "example_id": "91f3f45a-5a40-48c3-9d74-06c38611dff1",
                                                "sense_id": "040de0ce-ab13-30f9-8f6e-6af316b29c8a",
                                                "text": "Les descendants d’un ancêtre commun portent en principe le même nom de famille. On compte au Viêtnam environ une trentaine de noms de famille, dont certains sont ceux des anciennes dynasties, comme Ngô, Dinh, Lê, Ly, Trân, Nguyên."
                                            },
                                            {
                                                "example_id": "2a95ba49-9254-48e9-84e4-ee7833708414",
                                                "sense_id": "040de0ce-ab13-30f9-8f6e-6af316b29c8a",
                                                "text": "Le nom de famille français est bien, conformément à la formule exprimée par D. Kremer, la « forme définitive de ce qui était à l’origine un nom second » ou surnom accolé au nom de baptême, apparu à l’orée du second millénaire."
                                            },
                                            {
                                                "example_id": "f909ba54-ad09-4da1-8714-2b320961952d",
                                                "sense_id": "040de0ce-ab13-30f9-8f6e-6af316b29c8a",
                                                "text": "Le nom se compose tout d’abord du nom de famille, ensuite du prénom et, enfin, de ce que l’on appelle les accessoires du nom, pseudonyme, surnom et titres nobiliaires."
                                            }
                                        ]
                                    }
                                ]
                            }
