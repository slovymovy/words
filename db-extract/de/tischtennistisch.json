                        "entry_id": "bbee412f-4751-3fc8-87fb-544b3414ade4",
                        "glosses": [
                            "auf Stützen stehende Tischtennisplatte; Tisch für das Tischtennisspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2311ddc7-7298-4359-8c69-1e50dbe15f0d",
                                "sense_id": "d8b6b786-44d4-3a46-8f77-98a2a9ee17f9",
                                "text": "„Breitbeinig steht er vor dem Tischtennistisch.“"
                            },
                            {
                                "example_id": "bb654ab8-1d9e-4668-8aec-1ddafeeef4eb",
                                "sense_id": "d8b6b786-44d4-3a46-8f77-98a2a9ee17f9",
                                "text": "„Andere Outdoor-Aktivitäten bieten der Tennisplatz, der Tischtennistisch, oder man kann an der Rezeption ein Fahrrad mieten, um die Umgebung zu erkunden.“"
                            },
                            {
                                "example_id": "4c10ef8d-8bd9-41e6-8727-5643096b1a4c",
                                "sense_id": "d8b6b786-44d4-3a46-8f77-98a2a9ee17f9",
                                "text": "„Es handelte sich um den Münchner Flügelspieler Robin Amaize, der mit dem elfjährigen Tischtennis-Nachwuchsspieler Raphael Aicher vom FC Bayern medienwirksam einige Körbe warf und sich anschließend am Tischtennistisch duellierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
