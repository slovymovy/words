                "senses": [
                    {
                        "sense_id": "20c024e8-d35b-3db9-8859-50ba2ddb8e03",
                        "entry_id": "f09c0ba9-581b-3c6c-9e90-59319e6e39f2",
                        "glosses": [
                            "относящийся к Клоду Луи Бертолле, открытый им"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3241eca9-93c3-40fd-8395-d60be6917dd4",
                                "sense_id": "20c024e8-d35b-3db9-8859-50ba2ddb8e03",
                                "text": "Бертолетов взрывчатый порошок — так называется гремучее серебро, открытое Бертоле в 1788 г."
                            },
                            {
                                "example_id": "6490b27b-7aa2-4562-9b76-777090358280",
                                "sense_id": "20c024e8-d35b-3db9-8859-50ba2ddb8e03",
                                "text": "Сюда войдут Гей-Люссак, чей закон известен каждому школьнику; Клод Луи Бертолле, давший название бертолетовой соли …"
                            }
                        ]
                    }
