        "fr-extract.jsonl": [
            {
                "entry_id": "e875a758-a1a9-37ac-bb23-c57bf4d4e535",
                "word": "Courlande",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53ae7838-0d06-3584-8a10-afa626265a77",
                        "entry_id": "e875a758-a1a9-37ac-bb23-c57bf4d4e535",
                        "glosses": [
                            "Région occidentale de la Lettonie, située sur la mer Baltique."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "8c337087-0760-4acc-b408-04fce40ebe40",
                                "sense_id": "53ae7838-0d06-3584-8a10-afa626265a77",
                                "text": "Le duché de Courlande."
                            },
                            {
                                "example_id": "b7db2851-4d87-43d0-a173-e27c317dafee",
                                "sense_id": "53ae7838-0d06-3584-8a10-afa626265a77",
                                "text": "CURLANDE ou COURLANDE, (Géog. mod.) province avec titre de duché, dans la Livonie, sous la protection de la Pologne. Il est borné par la Livonie, la Lithuanie, la Samogitie, & la mer Baltique. Ce pays se divise en deux parties, la Courlande & le Semigalle. Ce pays est fertile. Mittau en est la capitale."
                            },
                            {
                                "example_id": "5988928d-3dea-4f80-a5bf-206d31ab1b73",
                                "sense_id": "53ae7838-0d06-3584-8a10-afa626265a77",
                                "text": "Nous avons vécu environ deux ans en Courlande, où réside sa famille, puis à Saint-Pétersbourg, ensuite en Allemagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f118a39e-3103-4cdb-aafc-8f2e878a1487",
                        "source_entry_id": "e875a758-a1a9-37ac-bb23-c57bf4d4e535",
                        "source_sense_id": "53ae7838-0d06-3584-8a10-afa626265a77",
                        "target_lang_word": "Kurland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7ae7da-7b56-36c5-8af4-676df110e943",
                                        "entry_id": "b50701d5-128d-323f-859f-d7b7fa9ee5e7",
                                        "glosses": [
                                            "eine historische Landschaft in Lettland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2533e60-d7c6-46c4-a750-63a2cc1a1547",
                                                "sense_id": "8a7ae7da-7b56-36c5-8af4-676df110e943",
                                                "text": "Kurland liegt im Westen Lettlands."
                                            },
                                            {
                                                "example_id": "af78e832-bca6-4c69-81c9-b543bc1c44ee",
                                                "sense_id": "8a7ae7da-7b56-36c5-8af4-676df110e943",
                                                "text": "„Der Baron Treyden ermunterte mich dazu und versprach mir einen Empfehlungsbrief an seine Schwester, die Herzogin von Kurland; ich bat sogleich Signor Bragadin um eine Empfehlung an einen Bankier in Petersburg, der mir jeden Monat den Betrag auszahlen sollte, den ich für ein angenehmes Leben nötig haben würde.“"
                                            },
                                            {
                                                "example_id": "5ff28177-8d5e-41e7-9e07-e43396ac73e5",
                                                "sense_id": "8a7ae7da-7b56-36c5-8af4-676df110e943",
                                                "text": "„Ich hatte Freunde in Kurland; ich kannte das Land und sprach seine Sprache, ja sogar verschiedene Ortsdialekte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
