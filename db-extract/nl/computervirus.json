                                        "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                                        "entry_id": "9d159c5f-2b61-3f7a-a11f-79e54ac38d77",
                                        "glosses": [
                                            "Computerprogramm, das sich selbst weiter verbreiten kann und mit einer Schadfunktion ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b892e8-3611-490c-b896-b7aafd61382c",
                                                "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                                                "text": "„Als Cohen Computerviren definierte, hatte er deren Vorbilder aus der Biologie im Hinterkopf: […]“"
                                            },
                                            {
                                                "example_id": "1ec27aee-169e-4e45-9bb6-87d60db410fe",
                                                "sense_id": "fe12e551-ba23-3667-b704-545e4dc37bfa",
                                                "text": "„Die Ausschüsse für Unfug und Desinformation wetteifern darum, einen Computervirus zu entwickeln, der Bankautomaten so krank macht, dass sie massenhaft Zehn- und Zwanzigdollarscheine ausspucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc214a6d-1ecb-4f3d-b575-59dc208dcf45",
                        "source_entry_id": "5f995b59-d843-37f1-9714-51fcdc319171",
