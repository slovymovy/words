                        ],
                        "examples": [
                            {
                                "example_id": "9d566c1a-0eea-4993-b901-7691b56b8f29",
                                "sense_id": "749d4d28-6149-32c2-bb7a-40ec8bb60973",
                                "text": "Apparently I do not suffer from eisoptrophobia. I say this because last year I looked in the mirror and realized I was the heaviest I'd been in a long time."
                            },
                            {
                                "example_id": "7d2c59d4-625c-43fd-afef-75ad3ea004bf",
                                "sense_id": "749d4d28-6149-32c2-bb7a-40ec8bb60973",
                                "text": "Not because I hate my reflection or that I suffer from Eisoptrophobia. Mirrors see straight through my facade."
                            },
                            {
                                "example_id": "cb46e276-2f1e-4aa0-9d3e-bfbce48b4c81",
                                "sense_id": "749d4d28-6149-32c2-bb7a-40ec8bb60973",
                                "text": "She showed them through to the back of the shop where to his left Horton caught sight of a row of well-lit changing rooms with enough mirrors to terrorize anyone suffering from Eisoptrophobia."
                            }
                        ]
                    }
