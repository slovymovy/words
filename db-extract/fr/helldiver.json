                                "target_senses": [
                                    {
                                        "sense_id": "257b9cce-9d73-3bc3-aebf-03c64af052fe",
                                        "entry_id": "70b753fa-b8f7-35b7-ac4f-f799746b6cf9",
                                        "glosses": [
                                            "Alternative form of hell-diver."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1121565c-6c02-4598-a320-0ec11649f022",
                                                "sense_id": "257b9cce-9d73-3bc3-aebf-03c64af052fe",
                                                "text": "Every winter the birds went south. One time a helldiver volunteered to stay for the winter to take care of two birds, an injured whooping crane and a wounded mallard duck, both of whom had broken wings."
                                            },
                                            {
                                                "example_id": "e835353d-bd74-4a6b-8cd0-b158ecc8b496",
                                                "sense_id": "257b9cce-9d73-3bc3-aebf-03c64af052fe",
                                                "text": "At dawn on the first day of April 1870, Cora Paint stood near one of her spindly and failing apple trees a hundred feet from the river, watching the rednecked helldivers above the falls soar and plummet into the Big Sioux after carp or perch."
                                            },
                                            {
                                                "example_id": "91abf8f2-565d-40da-a365-6949c2db2bd8",
                                                "sense_id": "257b9cce-9d73-3bc3-aebf-03c64af052fe",
                                                "text": "Most cultures have a flood myth, and the Paiutes are not exception. Instead of a dove, however, it is the little helldiver that finds land; and the land above the waters is not Mt. Ararat but Mt. Tom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
