                    {
                        "translation_id": "8111a19b-074f-4aeb-bdf7-7298f92a57e6",
                        "source_entry_id": "761c1f4f-19c8-34d7-b57b-513fbc6d8582",
                        "source_sense_id": "013b7e26-5755-35d9-85e3-7dd8244174da",
                        "source_sense_description": "de leer van de mechanische verzameling en verwerking van informatie",
