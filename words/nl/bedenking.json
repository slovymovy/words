{
    "word_family": [
        "bedenken",
        "bedenkelijk",
        "bedenksel",
        "bedenker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6907ff-5b61-3f94-a4c5-3b5892c1d370",
                    "sense_definition": "Twijfel of bezwaar tegen een plan of idee; tegenwerping.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bezwaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De commissie had serieuze <w>bedenkingen</w> bij het nieuwe voorstel van het bestuur.",
                            "target_lang_translations": {
                                "en": "The committee had serious <w>reservations</w> about the board's new proposal."
                            }
                        },
                        {
                            "text": "Als u het niet eens bent met het plan, kunt u een schriftelijke <w>bedenking</w> indienen.",
                            "target_lang_translations": {
                                "en": "If you do not agree with the plan, you can submit a written <w>objection</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "twijfel"
                    ],
                    "common_phrases": [
                        "bedenkingen hebben bij",
                        "een bedenking indienen",
                        "ernstige bedenkingen"
                    ],
                    "target_lang_definitions": {
                        "en": "Doubt, reservation, or objection against a plan, proposal, or idea."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "objection",
                                "target_lang_sense_clarification": "statement expressing opposition"
                            },
                            {
                                "target_lang_word": "reservation",
                                "target_lang_sense_clarification": "feeling of doubt or uncertainty"
                            },
                            {
                                "target_lang_word": "qualm",
                                "target_lang_sense_clarification": "doubt or unease"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf3f808-6a67-3a03-bbcb-c39516b424e5",
                    "sense_definition": "Het nadenken over iets; overweging of beraad.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na grondige <w>bedenking</w> van alle opties besloot de raad de plannen toch uit te stellen.",
                            "target_lang_translations": {
                                "en": "After thorough <w>consideration</w> of all options, the council decided to postpone the plans after all."
                            }
                        },
                        {
                            "text": "Deze belangrijke kwestie verdient nadere <w>bedenking</w> voordat er een definitief besluit valt.",
                            "target_lang_translations": {
                                "en": "This important matter deserves further <w>deliberation</w> before a final decision is made."
                            }
                        }
                    ],
                    "synonyms": [
                        "overweging"
                    ],
                    "common_phrases": [
                        "in bedenking nemen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of thinking something over; consideration, reflection, or deliberation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consideration",
                                "target_lang_sense_clarification": "careful thought"
                            },
                            {
                                "target_lang_word": "deliberation",
                                "target_lang_sense_clarification": "careful discussion or consideration"
                            },
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "serious thought"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}