    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "38ccff17-9c3b-3656-86b7-6dd2993b4d82",
                    "sense_definition": "zedig en ingetogen op seksueel gebied",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zedelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij leidde een sober en <w>kuis</w> leven in het klooster.",
                            "target_lang_translations": {
                                "fr": "Elle menait une vie sobre et <w>chaste</w> au couvent."
                            }
                        },
                        {
                            "text": "Hij gaf haar een <w>kuise</w> zoen op haar wang voor het slapengaan.",
                            "target_lang_translations": {
                                "fr": "Il lui donna un baiser <w>chaste</w> sur la joue avant d'aller dormir."
                            }
                        }
                    ],
                    "synonyms": [
                        "zedig"
                    ],
                    "antonyms": [
                        "onkuis",
                        "onzedig"
                    ],
                    "common_phrases": [
                        "een kuise zoen"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui fait preuve de retenue et de décence sur le plan sexuel ; chaste, pudique"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chaste",
                                "target_lang_sense_clarification": "qui s'abstient de plaisirs charnels ou manifeste de la retenue"
                            },
                            {
                                "target_lang_word": "pudique",
                                "target_lang_sense_clarification": "qui a de la retenue, de la décence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f2d419-4682-3d60-b281-4b64a96c3d2a",
                    "sense_definition": "schoon, zuiver en vrij van vuil",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zuiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monniken dronken alleen <w>kuis</w> water uit de bron in de bergen.",
                            "target_lang_translations": {
                                "fr": "Les moines ne buvaient que de l'eau <w>pure</w> provenant de la source de montagne."
                            }
                        },
                        {
                            "text": "De pas gewassen lakens roken heerlijk fris en <w>kuis</w>.",
                            "target_lang_translations": {
                                "fr": "Les draps fraîchement lavés sentaient délicieusement le frais et le <w>propre</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in de betekenis van rein of schoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "propre, net et exempt de toute souillure (vieilli ou littéraire)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pur",
                                "target_lang_sense_clarification": "sans souillure ou impureté"
                            },
                            {
                                "target_lang_word": "propre",
                                "target_lang_sense_clarification": "net, nettoyé"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0a5ee9d-3645-361d-894e-d81202a0843f",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>kuisen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordvorm_kuisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke zaterdag <w>kuis</w> ik grondig het hele huis.",
                            "target_lang_translations": {
                                "fr": "Chaque samedi, je <w>nettoie</w> la maison de fond en comble."
                            }
                        },
                        {
                            "text": "Ik <w>kuis</w> eerst de vloer van de keuken voordat de gasten arriveren.",
                            "target_lang_translations": {
                                "fr": "Je <w>nettoie</w> d'abord le sol de la cuisine avant que les invités n'arrivent."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gangbaar in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "première personne du singulier du présent de l'indicatif de « kuisen » (nettoyer, faire le ménage)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "nettoie",
                                "target_lang_sense_clarification": "forme du verbe nettoyer à la 1re personne"
                            },
                            {
                                "target_lang_word": "fais le ménage",
                                "target_lang_sense_clarification": "forme du verbe faire à la 1re personne"
                            }
