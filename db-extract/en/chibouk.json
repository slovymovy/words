                        "entry_id": "281ee92f-f8cc-3937-9c8e-942f024aa9ae",
                        "glosses": [
                            "A Turkish tobacco pipe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2db949b-3bc5-45ee-a669-83981982ed26",
                                "sense_id": "2424b774-d788-3730-9aa8-63aabf17cc17",
                                "text": "Half a dozen chibouks, with amber mouthpieces and cherry or jasmine-wood stems, leant in a corner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c413ee3d-cfa6-4029-8279-7b8e3735a600",
                        "source_entry_id": "281ee92f-f8cc-3937-9c8e-942f024aa9ae",
                        "source_sense_id": "2424b774-d788-3730-9aa8-63aabf17cc17",
                        "source_sense_description": "Turkish tobacco pipe",
                        "target_lang_word": "chibouque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chibouque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc40eb5b-d316-3df8-b416-bb462196a5ad",
                                        "entry_id": "50ad8b92-d2b7-3aa5-8634-2bdeaf7b92b9",
                                        "glosses": [
                                            "Pipe turque, à long tuyau de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeae8630-eacb-4257-a7e1-a6f933158775",
                                                "sense_id": "bc40eb5b-d316-3df8-b416-bb462196a5ad",
                                                "text": "Madame Dubarry peinte au pastel par Latour, une étoile sur la tête, nue et dans un nuage, paraissait contempler avec concupiscence une chibouque indienne."
                                            },
                                            {
                                                "example_id": "357cc821-c6de-4486-b2af-204041ea8bf6",
                                                "sense_id": "bc40eb5b-d316-3df8-b416-bb462196a5ad",
                                                "text": "Le pope Nikola pointait alors souvent sa chibouque vers la ville en contrebas, au bord de la rivière, et il disait en plaisantant à demi : Tout ce qui respire et grouille là en bas, tout ce qui est doté d’une voix humaine, c’est nous deux qui en répondons."
                                            },
                                            {
                                                "example_id": "cf70ed20-f98b-4bb0-8c25-88b9d17a0f22",
                                                "sense_id": "bc40eb5b-d316-3df8-b416-bb462196a5ad",
                                                "text": "Puis le Nubien alla fumer sa chibouque sur la borne qui formait l’angle de la maison et de la rue, tandis que Monte-Cristo rentrait sans plus s’occuper de rien."
                                            },
                                            {
                                                "example_id": "4afbcdf3-48f5-4ee7-9256-8573c01d7675",
                                                "sense_id": "bc40eb5b-d316-3df8-b416-bb462196a5ad",
                                                "text": "À côté des magasins à grandes glaces où se vendaient des choses venues de Paris, s’ouvraient les cafés maures, où des gens en burnous fumaient tranquillement le chibouque assis sur des divans, en écoutant des histoires d’un autre monde, qu’un conteur noir leur faisait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
