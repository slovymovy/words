                                        "entry_id": "1fbe5de1-93d8-37c4-ab31-4839410854b4",
                                        "glosses": [
                                            "polymethyl methacrylate (polymer of methyl methacrylate), a tough transparent plastic used sometimes in lieu of glass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "733b42ab-9b4c-4b20-8ef6-25a9dc24cd22",
                                                "sense_id": "29a8b40d-dac9-34b4-aae1-2496072d4945",
                                                "text": "The wall and door of the compartment on the corridor side are of plexiglass, fully curtained on the inside."
                                            },
                                            {
                                                "example_id": "5f8f93f4-4cef-46cb-a0fe-90356e2bff34",
                                                "sense_id": "29a8b40d-dac9-34b4-aae1-2496072d4945",
                                                "text": "A new concept car from Honda — a hydrogen-powered vehicle — sat inside the walls of a just-completed plexiglass tent at the corner of Seventh and Main Streets in the heart of downtown Park City, promoting the green pleasures of its energy conservation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
