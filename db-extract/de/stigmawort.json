                ],
                "senses": [
                    {
                        "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                        "entry_id": "5baf6c67-f569-375d-a4e4-14c1a03f076f",
                        "glosses": [
                            "Wort vor allem der politischen Auseinandersetzung, das eine parteiische Haltung/ Position (die des Gegners) mit einem negativ bewerteten Ausdruck wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b67c23-ad30-4d34-b8a0-33b7be54cd95",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "Ob etwas als Stigmawort oder als Fahnenwort aufgefasst wird, hängt ganz von der Einstellung des Sprechers/ Schreibers ab: Ein- und dasselbe Wort kann für Menschen mit verschiedenen Auffassungen das eine oder aber das andere sein."
                            },
                            {
                                "example_id": "267f9d55-2a23-4226-a50b-3c8270e0aea9",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "Ein Werbeslogan der CDU hieß einmal: „Freiheit oder Sozialismus.“ Das kann man nur so verstehen, dass „Sozialismus“ das Stigmawort sein sollte, während für die eigene Position „Freiheit“ als Fahnenwort in Anspruch genommen wird."
                            },
                            {
                                "example_id": "55b0ee26-c18d-4190-83da-49fcc7508d9a",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "Geläufige Stigmawörter der politischen Auseinandersetzung sind in Deutschland Ausdrücke wie „Manchesterkapitalismus“ oder „Überwachungsstaat“."
                            },
                            {
                                "example_id": "ea10aa73-ee02-4900-afaf-e7974abe8056",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "„Die Nationalsozialisten benutzten System als Stigmawort, um die Weimarer Republik abzuqualifizieren.“"
                            },
                            {
                                "example_id": "5d99636c-d681-4974-a1fd-cf3bf9322790",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "„Was nicht zutrifft, ist, dass sich die GfdS mit der Frage der Entlehnungen aus anderen Sprachen nicht beschäftigt (wenn auch nicht unter dem ebenso emotional aufgeladenen Stigmawort »Denglisch«).“"
                            },
                            {
                                "example_id": "dbc8ec08-6715-43e5-bcae-04f64b2bcbd7",
                                "sense_id": "408e688d-1263-3f86-895c-13e3fa2e13f1",
                                "text": "„Im Gegensatz zu den anderen Sendungen besteht der Verantwortlichkeitsframe in diesem Fall nicht aus der Gegenüberstellung von unterschiedlichen Gruppen und Verantwortlichen, sondern der alleinigen Benennung des Verursachers: Poker, Schuldenpoker und Trotzwahl können als Stigmawörter verstanden werden, die in negativem Sinn attributiv mit Griechen verbunden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
