                        "glosses": [
                            "Qui monte, qui a un mouvent ascensionnel"
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec3f47f-6f59-45d5-bb5a-a240693d373d",
                                "sense_id": "3e8d7c60-091d-3c73-9b87-2251001b61bb",
                                "text": "… et le mystère pascal anabatique (autel-sacerdoce) que la consécration du Christ reçoit toute sa signification et que sa messianité se dévoile avec plus de clarté."
                            }
                        ]
                    },
                    {
                        "sense_id": "6edd9d3f-20dc-315e-89e5-9a8b92d0af8f",
                        "entry_id": "b0587365-91a3-3172-8b57-d2f0d6a8652e",
                        "glosses": [
                            "Qualifie un vent qui monte, ascendant."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "00bb29a6-f400-4905-89d9-811c76b0a4ad",
                                "sense_id": "6edd9d3f-20dc-315e-89e5-9a8b92d0af8f",
                                "text": "C'est un flux anabatique, ce qui signifie simplement qu'il remonte les reliefs et les vallées. Ce flux anabatique se forme et se régule avec les thermiques présents."
                            },
                            {
                                "example_id": "186372e4-f5a2-4e1f-854f-67e8a02d81bb",
                                "sense_id": "6edd9d3f-20dc-315e-89e5-9a8b92d0af8f",
                                "text": "Le vent anabatique est un vent ascensionnel le long d'un relief géographique causé par le réchauffement de celui-ci par temps ensoleillé."
                            }
                        ]
                    }
