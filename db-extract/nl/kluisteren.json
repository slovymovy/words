        "nl-extract.jsonl": [
            {
                "entry_id": "5e4195a1-e640-3e28-81b8-f02bd31201e1",
                "word": "kluisteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a1c2a2c-36b6-3297-ba8d-8e4e2cee8e09",
                        "entry_id": "5e4195a1-e640-3e28-81b8-f02bd31201e1",
                        "glosses": [
                            "in bewegingen en invloed beperken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e786d7-a203-4a7c-90ed-bdd5ff313e3f",
                                "sense_id": "8a1c2a2c-36b6-3297-ba8d-8e4e2cee8e09",
                                "text": "Ze heeft zichzelf een bikkelharde houding aangemeten om het mysterieuze 'kolkend zwarte oog' van haar innerlijk te kluisteren. Dat innerlijk begint zich te roeren wanneer haar beeldschone neef Endy zijn intrek neemt in haar huis. De jongen wekt het verlangen in haar op hem te bezitten. Niet op een liefdevolle, maar op een sadistische manier."
                            }
                        ]
                    },
                    {
                        "sense_id": "eed262c9-9a58-3c8b-8dc5-4e0d937b9bf2",
                        "entry_id": "5e4195a1-e640-3e28-81b8-f02bd31201e1",
                        "glosses": [
                            "~~ aan: zoveel aandacht trekken dat je er je moeilijk van kunt losmaken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "703c95c8-06db-4b82-ac23-564979636720",
                                "sense_id": "eed262c9-9a58-3c8b-8dc5-4e0d937b9bf2",
                                "text": "Ook in de montage en verteltactiek wordt al het mogelijke gedaan om je op het puntje van je stoel te krijgen, een plek waar het lastig ontspannen is. De kijkervaring wordt een rollercoaster, een emotionele slingertocht. De bedoeling is niet zozeer om ons een verhaal te vertellen, maar om ons aan het scherm te kluisteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e3028c4-fa3f-4b9c-9d68-519bd32ae26e",
                        "source_entry_id": "5e4195a1-e640-3e28-81b8-f02bd31201e1",
                        "source_sense_id": "8a1c2a2c-36b6-3297-ba8d-8e4e2cee8e09",
