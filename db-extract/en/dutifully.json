                ],
                "translations": [
                    {
                        "translation_id": "87b25fba-f84c-4c0c-964b-3d6e031393e4",
                        "source_entry_id": "164c32e6-f79f-3796-819b-f77636d6bbb9",
                        "source_sense_id": "d32d809e-7279-36fa-83b0-8d62fc7312b0",
                        "source_sense_description": "in a dutiful manner",
                        "target_lang_word": "attentivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attentivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68fb4d52-6412-3865-aea8-c671beb1551b",
                                        "entry_id": "40946f7c-a138-3fff-a5bf-8083078fc5b5",
                                        "glosses": [
                                            "Avec attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddeb33d7-9876-4d70-8247-50d1681e0946",
                                                "sense_id": "68fb4d52-6412-3865-aea8-c671beb1551b",
                                                "text": "Quand je considère attentivement dans l'Évangile la parabole ou plutôt l'histoire du mauvais riche."
                                            },
                                            {
                                                "example_id": "792a60da-a67f-42fe-99a5-96dba89d8f4c",
                                                "sense_id": "68fb4d52-6412-3865-aea8-c671beb1551b",
                                                "text": "Pendant toute la nuit, je dus veiller attentivement, car mes observations m'avaient indiqué la proximité du rocher de Malpelo, […]."
                                            },
                                            {
                                                "example_id": "ab0a8c79-2dd3-4973-9765-7e7cc0b76655",
                                                "sense_id": "68fb4d52-6412-3865-aea8-c671beb1551b",
                                                "text": "Quand j'examine attentivement l'état actuel des cantons brayons durant les trois années additionnées de 1926, 1927, 1928, je ne les trouve nullement en état de sous-natalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "836dc5e9-c00c-4540-9a7f-a0c378649e6a",
                        "source_entry_id": "164c32e6-f79f-3796-819b-f77636d6bbb9",
                        "source_sense_id": "d32d809e-7279-36fa-83b0-8d62fc7312b0",
                        "source_sense_description": "in a dutiful manner",
                        "target_lang_word": "consciencieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consciencieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd5cfea-f7b1-313d-8cf2-687aaa424f11",
                                        "entry_id": "51e4a653-25ce-3d04-aa5a-dc9df36a0541",
                                        "glosses": [
                                            "D’une manière consciencieuse."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4d3315c-ff55-3a09-b5dc-95fa4490daef",
                                        "entry_id": "51e4a653-25ce-3d04-aa5a-dc9df36a0541",
                                        "glosses": [
                                            "Avec une exigence morale consciencieuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdae123d-08cd-468e-912b-20710dec1c04",
                                                "sense_id": "b4d3315c-ff55-3a09-b5dc-95fa4490daef",
                                                "text": "Je ne sais même si on n'aurait pas moins de dépit de se voir tuer brutalement par des gens emportés que de se sentir poignardé consciencieusement par des gens dévots."
                                            },
                                            {
                                                "example_id": "3a015a4f-89f9-495f-967b-cb1f3757b61d",
                                                "sense_id": "b4d3315c-ff55-3a09-b5dc-95fa4490daef",
                                                "text": "Il est facile et rassurant : jeter consciencieusement bouteilles vides et papiers dans une poubelle jaune donne l’impression de participer sans effort à l’avènement d'une société de consommation responsable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e852207-4491-3c9b-bde6-1d5ee715af6a",
                                        "entry_id": "51e4a653-25ce-3d04-aa5a-dc9df36a0541",
                                        "glosses": [
                                            "Avec de la conscience professionnelle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "790d6920-e37b-4a90-b1b9-4cdfa9006594",
                                                "sense_id": "3e852207-4491-3c9b-bde6-1d5ee715af6a",
                                                "text": "[…] ; les convives d'un repas funèbre devant bientôt s'attabler en cette maison, il importe que je prépare consciencieusement la tête de veau dont ils m'ont passé commande."
                                            },
                                            {
                                                "example_id": "910ed528-a5e8-496b-a883-a2f21d4da010",
                                                "sense_id": "3e852207-4491-3c9b-bde6-1d5ee715af6a",
                                                "text": "Soudain, j'entends des coups de fusil. Je me retourne : un vieil Albatros est là, qui tire consciencieusement sur moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdafd855-b2f1-386f-af7e-d36b5bb891b7",
                                        "entry_id": "51e4a653-25ce-3d04-aa5a-dc9df36a0541",
                                        "glosses": [
                                            "Avec grande application."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b04fbce-0c06-4b31-b5f1-60a5a917c64a",
                                                "sense_id": "bdafd855-b2f1-386f-af7e-d36b5bb891b7",
                                                "text": "Dans cette voie et au moyen de primes en argent payées aux ramasseurs, MM. Lalouette, de Barbery (Oise), Reisel, à Écorchebœuf (Seine-Inférieure), et l’administration préfectorale du département de la Somme, paraissent avoir obtenu de bons résultats, mais si l’on peut donner le conseil d’imiter ces bons exemples, il est absolument impossible d’aller jusqu’à la contrainte, car le hanneton est volage et le propriétaire qui aura consciencieusement déhannetonné son jardin ou son champ, n’en sera pas moins exposé à recevoir les hannetons du voisin."
                                            },
                                            {
                                                "example_id": "806bac73-a0b0-4c47-8861-0c3358489a91",
                                                "sense_id": "bdafd855-b2f1-386f-af7e-d36b5bb891b7",
                                                "text": "Les gendarmes étaient venus à pied, par sept kilomètres de vieux chemins. En admettant qu’ils confisquassent le filet séance tenante, il leur fallait réveiller le garde-champêtre du plus proche village où tout dormait consciencieusement."
                                            },
                                            {
                                                "example_id": "d0cef5de-91c9-425b-9ebe-bc710ae38c8c",
                                                "sense_id": "bdafd855-b2f1-386f-af7e-d36b5bb891b7",
                                                "text": "« T’inquiète », lui répond Ayrault, qui bloque consciencieusement son adjoint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec00c265-58c0-4f74-a29d-3ebc457a41ff",
                        "source_entry_id": "164c32e6-f79f-3796-819b-f77636d6bbb9",
                        "source_sense_id": "d32d809e-7279-36fa-83b0-8d62fc7312b0",
                        "source_sense_description": "in a dutiful manner",
                        "target_lang_word": "scrupuleusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrupuleusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6da8fd98-fba3-3ab9-8456-c405336bb75b",
                                        "entry_id": "947eb60a-f3d6-31e5-b093-29281aa48f94",
                                        "glosses": [
                                            "D’une manière scrupuleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54c28388-4454-4f5f-833e-12679145b311",
                                                "sense_id": "6da8fd98-fba3-3ab9-8456-c405336bb75b",
                                                "text": "En examinant avec soin, en étudiant scrupuleusement, et dans les moindres détails, les ouvrages défensifs de ces temps, on comprend ces récits d’attaques gigantesques que nous sommes trop disposés à taxer d’exagération."
                                            },
                                            {
                                                "example_id": "1a294308-14b9-4b68-9369-2a161b64e4d4",
                                                "sense_id": "6da8fd98-fba3-3ab9-8456-c405336bb75b",
                                                "text": "Dans tous les articles, les auteurs s'attachent scrupuleusement aux faits, aux données brutes et concrètes : pas de bavardage, pas d’interprétations oiseuses, mais des informations précises étayées par des citations sourcées."
                                            },
                                            {
                                                "example_id": "94841d73-8283-4616-81e8-0b09da1b944a",
                                                "sense_id": "6da8fd98-fba3-3ab9-8456-c405336bb75b",
                                                "text": "Ce qui nous a frappé vivement, dans cette pièce, c’est que l’unité de temps, de lieu et d’action y est observée scrupuleusement."
                                            },
                                            {
                                                "example_id": "bb0f7531-c598-43db-b8e6-7433462bfa78",
                                                "sense_id": "6da8fd98-fba3-3ab9-8456-c405336bb75b",
                                                "text": "Je n’avais jamais été tout à fait sans religion ; mais peut-être vaudrait-il mieux n’en point avoir du tout que d’en avoir une extérieure et maniérée, qui sans toucher le cœur rassure la conscience ; de se borner à des formules, et de croire exactement en Dieu à certaines heures pour n’y plus penser le reste du temps. Scrupuleusement attachée au culte public, je n’en savais rien tirer pour la pratique de ma vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
