                "senses": [
                    {
                        "sense_id": "64b778d9-addc-3ee0-99a3-42b82f313672",
                        "entry_id": "66f3979a-bbc1-3fff-8d70-6d41304a735b",
                        "glosses": [
                            "Aktivität, sich eine eigene Meinung zu bilden oder andere bei diesem Prozess anzuleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2807662-cb5a-47a2-85db-6f37b832aa13",
                                "sense_id": "64b778d9-addc-3ee0-99a3-42b82f313672",
                                "text": "Die Massenmedien sollen zur Meinungsbildung beitragen."
                            },
                            {
                                "example_id": "917e5508-e9b7-4694-a251-a9228d79af6e",
                                "sense_id": "64b778d9-addc-3ee0-99a3-42b82f313672",
                                "text": "„Demokratische Meinungsbildung wird in unserer komplexen Welt immer anstrengender.“"
                            },
                            {
                                "example_id": "529393c2-4751-41c0-823a-d73263019e2c",
                                "sense_id": "64b778d9-addc-3ee0-99a3-42b82f313672",
                                "text": "„Keiner kümmert sich um die Möglichkeit, Filme in Wien als Ausdrucksmittel und Mittel zur öffentlichen Meinungsbildung zu verwenden – um Filme zu produzieren, die eine Idee vertreten oder etwas aussagen.“"
                            }
                        ],
