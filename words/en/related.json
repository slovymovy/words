                },
                {
                    "sense_id": "d2b52965-adcf-3898-a503-ad35f70155ff",
                    "sense_definition": "Belonging to the same family.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone is <w>related</w> to their parents.",
                            "target_lang_translations": {
                                "ru": "Все <w>состоят в родстве</w> со своими родителями.",
                                "pl": "Każdy jest <w>spokrewniony</w> ze swoimi rodzicami."
                            }
                        },
                        {
                            "text": "She was surprised to find she is <w>related</w> to a famous actor.",
