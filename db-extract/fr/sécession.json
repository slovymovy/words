                                                "example_id": "6ea8b9d8-adad-4b2e-b1bf-e5804d54b91d",
                                                "sense_id": "86bc4ecf-2999-3945-a567-390db6ea2355",
                                                "text": "Ze brachten een afscheiding aan tussen de twee delen van de weide door middel van een hek."
