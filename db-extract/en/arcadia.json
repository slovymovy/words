                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2f458ed-0c5c-4f65-954b-094cad9a22c1",
                        "source_entry_id": "65fc7077-b162-32fc-9a03-a0daf66bab53",
                        "source_sense_id": "052a88f5-ef35-329c-a9a9-2d2614955662",
                        "source_sense_description": "a district or a prefecture in the central and mid SE Peloponnese",
                        "target_lang_word": "Arcadie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arcadie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6348fc-da88-329e-810c-5f76dba65fc1",
                                        "entry_id": "981108ea-03b2-3faa-b900-57a93072fab8",
                                        "glosses": [
                                            "Région de la Grèce, au centre du Péloponnèse."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead2aa39-709c-49fa-b1e1-c88a61f128df",
                                                "sense_id": "dc6348fc-da88-329e-810c-5f76dba65fc1",
                                                "text": "Mais Pan qui parcourait l'Arcadie et allait chasser tantôt sur un mont, tantôt sur l'autre, étant venu sur le mont Elaïum, reconnut Cérès sous la forme et sous les vêtements qu'elle avait pris."
                                            },
                                            {
                                                "example_id": "dd492003-9645-4e03-b8f4-06aa2b3bc8b7",
                                                "sense_id": "dc6348fc-da88-329e-810c-5f76dba65fc1",
                                                "text": "En fait, l’Arcadie fut toujours […] une province à part, un cirque de villages isolés par de hautes montagnes, protégés par de denses forêts et dont les habitants maintinrent très longtemps des habitudes et des usages archaïques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Arcadie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c46f5a40-bc16-33e0-83be-467612cf921b",
                                        "entry_id": "bbf57428-e8cd-374e-b2d5-e0235d2fe569",
                                        "glosses": [
                                            "Utopie, terre idyllique pastorale et harmonieuse."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d788e2d-ea46-40cc-8e90-d9cf3a77dd24",
                                                "sense_id": "c46f5a40-bc16-33e0-83be-467612cf921b",
                                                "text": "Son île fleurie de Tahiti est, telle que la décrit Loti, une nouvelle Arcadie."
                                            },
                                            {
                                                "example_id": "ee452e27-4ca6-4c65-80f6-3502e80b1cc6",
                                                "sense_id": "c46f5a40-bc16-33e0-83be-467612cf921b",
                                                "text": "Les noms de ces rivières ont une douceur hellénique ; mais cette région même de Quimperlé n’a-t-elle pas été appelée une Arcadie bretonne ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7235367-31eb-409e-8e6f-86ef1cd657b2",
                        "source_entry_id": "65fc7077-b162-32fc-9a03-a0daf66bab53",
                        "source_sense_id": "052a88f5-ef35-329c-a9a9-2d2614955662",
                        "source_sense_description": "a district or a prefecture in the central and mid SE Peloponnese",
                        "target_lang_word": "Arkadien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arkadien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c57ff022-d038-32e3-9e01-5d0167e2aa23",
                                        "entry_id": "6f8142c9-e358-359c-9160-a300fb4728db",
                                        "glosses": [
                                            "Bergland auf dem Peloponnes in Griechenland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400cc4ea-9ed2-46ca-b429-c18601c71129",
                                                "sense_id": "c57ff022-d038-32e3-9e01-5d0167e2aa23",
                                                "text": "„Arkadien (griechisch Αρκαδία - Arkadía) ist eine der fünf Präfekturen (νομοί/nomí) der griechischen Verwaltungsregion Peloponnes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28a64823-28f5-3d3a-8e73-ea61e2c80bf0",
                                        "entry_id": "6f8142c9-e358-359c-9160-a300fb4728db",
                                        "glosses": [
                                            "In der Antike ein Hirtenland, welches in der Dichtersprache zum Land der Seligkeit und des Glücks idealisiert wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bafd49b-c552-48f0-91dd-d11f59421cc2",
                                                "sense_id": "28a64823-28f5-3d3a-8e73-ea61e2c80bf0",
                                                "text": "„Auch ich war in Arkadien geboren, auch mir hat die Natur an meiner Wiege Freude zugeschworen, auch ich war in Arkadien geboren, doch Tränen gab der kurze Lenz mir nur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
