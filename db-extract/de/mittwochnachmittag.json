                                        "sense_id": "5590eed2-1f9a-315f-bf89-e69465e11db6",
                                        "entry_id": "39951053-3601-3daf-92ac-6b9eda638cdd",
                                        "glosses": [
                                            "de uren van een woensdag tussen het middaguur en de avond"
                                        ],
                                        "tags": [
                                            "tijdrekening"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38cfbe71-317f-4529-8274-9fcb06120391",
                                                "sense_id": "5590eed2-1f9a-315f-bf89-e69465e11db6",
                                                "text": "We hebben die hele woensdagmiddag in het ziekenhuis doorgebracht."
                                            },
                                            {
                                                "example_id": "169ab218-2d60-440d-83c2-35813f090044",
                                                "sense_id": "5590eed2-1f9a-315f-bf89-e69465e11db6",
                                                "text": "Er hing veel werk van lokale schilders en achterin zat een groep oudere dames aan een lange tafel te schilderen. ‘Wij zijn de woensdagmiddag schilderclub."
                                            },
                                            {
                                                "example_id": "04ab04e4-3552-4314-843e-db9a79d6d41c",
                                                "sense_id": "5590eed2-1f9a-315f-bf89-e69465e11db6",
                                                "text": "Toen ik die woensdagmiddag naar haar huis liep, moest ik me inhouden om niet te gaan rennen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woensdagmiddag",
