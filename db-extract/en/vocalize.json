                "senses": [
                    {
                        "sense_id": "ed7aac10-ac32-3b74-b2e9-ca91ace2de60",
                        "entry_id": "8d42f9fd-21e2-3e49-9b41-d9e2a305e349",
                        "glosses": [
                            "To express with the voice, to utter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1609182e-239b-41c1-a5ed-b3e32c457b52",
                                "sense_id": "ed7aac10-ac32-3b74-b2e9-ca91ace2de60",
                                "text": "Following the modern spirit, the real poems of the present, ever solidifying and expanding into the future, must vocalize the vastness and splendor and reality with which scientism has invested man and the universe,[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d945fcdb-1c6e-3a6e-ba5e-1c95b67ed796",
                        "entry_id": "8d42f9fd-21e2-3e49-9b41-d9e2a305e349",
                        "glosses": [
                            "To produce noises or calls from the throat."
                        ],
                        "tags": [
                            "of animals"
                        ],
                        "examples": [
                            {
                                "example_id": "0d38eb7e-8a6a-48de-9fca-a175c4a4c381",
                                "sense_id": "d945fcdb-1c6e-3a6e-ba5e-1c95b67ed796",
                                "text": "We could hear the monkeys vocalizing, though we could not see them."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcc13973-4b1c-3cc4-9a18-23b146a9724b",
                        "entry_id": "8d42f9fd-21e2-3e49-9b41-d9e2a305e349",
                        "glosses": [
                            "To sing without using words."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d9a5a7e4-97f0-37f4-8dad-616f3346e4c0",
                        "entry_id": "8d42f9fd-21e2-3e49-9b41-d9e2a305e349",
                        "glosses": [
                            "To turn a consonant into a vowel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b84ab8ff-f7b1-4eec-99ac-9a14e68e02f3",
                                "sense_id": "d9a5a7e4-97f0-37f4-8dad-616f3346e4c0",
                                "text": "In Hong Kong English, /l/ may be vocalized at the end of a syllable."
                            }
                        ]
                    },
                    {
                        "sense_id": "76e8e931-d458-32c8-9c6d-a0392f9f1df1",
                        "entry_id": "8d42f9fd-21e2-3e49-9b41-d9e2a305e349",
                        "glosses": [
                            "To make a sound voiced rather than voiceless."
