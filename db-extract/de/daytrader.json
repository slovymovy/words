                        "glosses": [
                            "Person, die Daytrading betreibt; Käufer von Wertpapieren, die er noch am selben Tag wieder verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02d36f6-d30a-47fe-ace1-f30531586713",
                                "sense_id": "7b3942c3-b756-33c4-b917-083090dbce33",
                                "text": "„Daytrader, die meist sehr kurzfristig agieren und selbst Kontrolle über die Orderausführung haben wollen, präferieren den Direkthandel.“"
                            },
                            {
                                "example_id": "639edf58-2a3c-499e-b219-b8b0da173812",
                                "sense_id": "7b3942c3-b756-33c4-b917-083090dbce33",
                                "text": "„Du musst das nicht tun, sagte Wells. Ich bin ein Daytrader. Ich könnte einfach nach Hause gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
