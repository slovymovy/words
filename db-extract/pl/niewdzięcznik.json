                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a35ea8d-0f56-4d17-bbe1-ceb852640654",
                        "source_entry_id": "ab3e28a0-b38e-319c-badb-4e43ad29bb3c",
                        "source_sense_id": "7eee6df8-b3a4-324b-b60b-524fc30ebffe",
                        "target_lang_word": "ingrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                        "entry_id": "6f1f7740-b772-3dcd-8c16-85ded10e2376",
                                        "glosses": [
                                            "Ungrateful."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad80f03-71c0-4ec1-bec2-8342f13cd306",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "Many of theſe might ſeem ingrate and unkind children, that vvill no better acknovvledge and recogniſe their parents in vvords and outvvard pretence, but abrenounce and caſt them off, as though they hated them as dogs and ſerpents."
                                            },
                                            {
                                                "example_id": "2106b01d-4dbe-49f6-9a56-bcc338b97624",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "Yet in his mind malitious and ingrate"
                                            },
                                            {
                                                "example_id": "8d879b54-cd06-4f33-9f47-7a1ab6ae1f6a",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "But I will lift the down-trod Mortimer / As high in the air as this unthankful king, / As this ingrate and canker'd Bolingbroke."
                                            },
                                            {
                                                "example_id": "49951cb1-9409-49ba-8f81-5b07bf7a23a9",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "The causes of that which is pleasing , or ingrate to the hearing , may receive light by that which is pleasing or ingrate to the sight"
                                            },
                                            {
                                                "example_id": "52bcbc40-efb9-4ad8-9d4b-f49c91e13cbd",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "Who, for ſo many benefits receiv'd, / Turn'd recreant to God, ingrate and falſe, / And ſo of all true good himſelf deſpoil'd, […]"
                                            },
                                            {
                                                "example_id": "83087d24-795d-413a-9858-9e84db17c154",
                                                "sense_id": "490ae7b8-8f60-3286-84eb-da3ef1ec0dd5",
                                                "text": "thou art among the stars / of highest Heaven: to the rolling spheres / Thou sweetly singest: naught thy hymning mars, / Above the ingrate world and human fears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60020197-c644-3332-9103-ca2de0c3dfce",
                                        "entry_id": "6f1f7740-b772-3dcd-8c16-85ded10e2376",
                                        "glosses": [
                                            "Unfriendly; unpleasant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ingrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3990b7c8-0b32-31eb-aa03-b983a5115fdd",
                                        "entry_id": "789ff687-ec58-30d8-a2db-cc416d5e5e36",
                                        "glosses": [
                                            "An ungrateful person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74826ae1-301a-4549-bffa-13f64a7d02f8",
                                                "sense_id": "3990b7c8-0b32-31eb-aa03-b983a5115fdd",
                                                "text": "But Mr Pecksniff, dismissing all ephemeral considerations of social pleasure and enjoyment, concentrated his meditations on the one great virtuous purpose before him, of casting out that ingrate and deceiver, whose presence yet troubled his domestic hearth, and was a sacrilege upon the altars of his household gods."
                                            },
                                            {
                                                "example_id": "99261ac5-f8f9-44a7-9952-27423d48b4a4",
                                                "sense_id": "3990b7c8-0b32-31eb-aa03-b983a5115fdd",
                                                "text": "\"Speak the truth, you ingrate!\" cried Miss Havisham"
                                            },
                                            {
                                                "example_id": "b49e8732-e77e-4081-9f39-252b46dd05fa",
                                                "sense_id": "3990b7c8-0b32-31eb-aa03-b983a5115fdd",
                                                "text": "Out of my sight, ingrate!"
                                            },
                                            {
                                                "example_id": "b42f970f-6a59-4472-a4ae-b09a10d1c3db",
                                                "sense_id": "3990b7c8-0b32-31eb-aa03-b983a5115fdd",
                                                "text": "The consensus—certainly among the great and the good of Cambridge, Massachusetts—was that he was an ultranationalist, a reactionary, and, above all, an ingrate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8a3337e-1dca-44a7-804d-9556ed8ec43f",
                        "source_entry_id": "ab3e28a0-b38e-319c-badb-4e43ad29bb3c",
                        "source_sense_id": "7eee6df8-b3a4-324b-b60b-524fc30ebffe",
                        "target_lang_word": "nevděčník",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1f2674d2-ab8f-4ede-8a85-6074e4fa9536",
                        "source_entry_id": "ab3e28a0-b38e-319c-badb-4e43ad29bb3c",
                        "source_sense_id": "7eee6df8-b3a4-324b-b60b-524fc30ebffe",
                        "target_lang_word": "ingrat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingrat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                        "entry_id": "faf591c2-9f2a-343e-9539-56cca04451ef",
                                        "glosses": [
                                            "Qui n’a pas de reconnaissance, qui ne tient pas compte des bienfaits qu’il a reçus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59be4c75-4406-4f50-afd9-0f742214c313",
                                                "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                                "text": "Toutes les fois que je donne une place vacante, je fais cent mécontents et un ingrat."
                                            },
                                            {
                                                "example_id": "7302e550-119b-4cfc-ba7b-2de08286a6d4",
                                                "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                                "text": "[…] Quand vous nous donnez quelque chose, et de si belles choses, nous serions bien ingrats de ne pas vous remercier."
                                            },
                                            {
                                                "example_id": "26d93674-8954-449e-bdb2-b87361ae0f77",
                                                "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                                "text": "Des fils ingrats."
                                            },
                                            {
                                                "example_id": "5409f1c4-f3cc-4128-afd7-365dbd340919",
                                                "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                                "text": "cœur ingrat."
                                            },
                                            {
                                                "example_id": "7982c12e-360b-4096-9a54-6a5b601dbbc6",
                                                "sense_id": "7fff2c7a-8fbc-3694-80e5-0c0785906738",
                                                "text": "La patrie ne fut point ingrate envers lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a9f706-8b7e-348e-a176-763a3b27d8b0",
                                        "entry_id": "faf591c2-9f2a-343e-9539-56cca04451ef",
                                        "glosses": [
                                            "Qui ne récompense pas des dépenses qu’on fait, ou des peines qu’on se donne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3eca1d-e468-45bf-bcdf-5b04c6eae6a1",
                                                "sense_id": "95a9f706-8b7e-348e-a176-763a3b27d8b0",
                                                "text": "Étude ingrate, travail ingrat."
                                            },
                                            {
                                                "example_id": "99a23673-18fd-4727-bb71-a2970b60a6eb",
                                                "sense_id": "95a9f706-8b7e-348e-a176-763a3b27d8b0",
                                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l’obligeant à vivre dans des usines malsaines, […]."
                                            },
                                            {
                                                "example_id": "b318bb97-3a1c-45b6-aab3-015d4eb5cf80",
                                                "sense_id": "95a9f706-8b7e-348e-a176-763a3b27d8b0",
                                                "text": "Elle n’avait que dix ou onze ans quand sa mère, Mabel, s’est enfuie pour ne jamais revenir, ne lui laissant rien, hormis un petit lopin de terre ingrate que la fillette défend avec une opiniâtreté surprenante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7473f060-61c5-3d2d-abd9-52dcc3b6423f",
                                        "entry_id": "faf591c2-9f2a-343e-9539-56cca04451ef",
                                        "glosses": [
                                            "Qui n’est pas favorable au développement du talent, qui fournit peu d’idées, en parlant d’un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd11b9d9-818c-43d4-9b9c-d2244c11e03e",
                                                "sense_id": "7473f060-61c5-3d2d-abd9-52dcc3b6423f",
                                                "text": "Le sujet de ce poème, de ce tableau était vraiment ingrat."
                                            },
                                            {
                                                "example_id": "6faad70d-fa39-49d2-9f48-33f42fcb2127",
                                                "sense_id": "7473f060-61c5-3d2d-abd9-52dcc3b6423f",
                                                "text": "Vous avez choisi une matière fort ingrate."
                                            },
                                            {
                                                "example_id": "dbb4b43a-6567-42dc-85db-87623cd6fa17",
                                                "sense_id": "7473f060-61c5-3d2d-abd9-52dcc3b6423f",
                                                "text": "Vous travaillez sur un fond bien ingrat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfa254c-18f1-3f49-ae86-eecd174066fd",
                                        "entry_id": "faf591c2-9f2a-343e-9539-56cca04451ef",
                                        "glosses": [
                                            "Déplaisant, désagréable, qui inspire la défiance."
                                        ],
                                        "tags": [],
