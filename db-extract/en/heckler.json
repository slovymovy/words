                    },
                    {
                        "translation_id": "d3fdd491-f299-4b21-94ea-f40c37b76e02",
                        "source_entry_id": "24b56e6f-2721-3a0f-8313-c64f62d82edd",
                        "source_sense_description": "one who heckles, insults, makes fun of, or teases",
                        "target_lang_word": "Schelm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schelm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2f1f83-6ca3-3321-9cae-aa80ac50d11a",
                                        "entry_id": "6a06d794-083b-30de-b2cd-e99f20fcd93c",
                                        "glosses": [
                                            "Mensch, der gerne scherzt und neckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf225d4-dd82-4587-b9b6-6a90f8786dab",
                                                "sense_id": "1d2f1f83-6ca3-3321-9cae-aa80ac50d11a",
                                                "text": "„Der Schelm ist, es sei geradeheraus gesagt, eine überaus unsympathische Figur, und seine Streiche können nur Leute lustig finden, die eine Neigung zum Fäkalhumor und zur Schadenfreude haben .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                        "entry_id": "6a06d794-083b-30de-b2cd-e99f20fcd93c",
                                        "glosses": [
                                            "durchtriebener, unehrlicher Mensch"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a331c6ad-c444-469a-a919-3854dbdffad0",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "Ein Schelm, wer Böses dabei denkt."
                                            },
                                            {
                                                "example_id": "1e8012c3-174b-4f22-b2e9-bbc6973deb00",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Auf groben Klotz ein grober Keil! Auf einen Schelmen anderthalbe!“"
                                            },
                                            {
                                                "example_id": "b75c370a-b0b2-4639-b757-caf2e7f24b9d",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Seine Vorliebe galt seit jeher den Schelmen und Lügenbolden, den Sonderlingen und Außenseitern, die sich eine eigene Welt erschufen.“"
                                            },
                                            {
                                                "example_id": "17d86345-8078-4fdc-9c6a-b41f88da713d",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Fast scheint es, ein Schelm stünde vor uns, der uns hinters Licht führen will.“"
                                            },
                                            {
                                                "example_id": "22d6f207-bbac-404f-a244-048ebaf61701",
                                                "sense_id": "fc17d658-f93b-3c0a-9a08-c758e638afd1",
                                                "text": "„Selbstverständlich geleitete sie am nächsten Tage den alten Schelm schon in aller Morgenfrühe durch das Hauptportal nach den inneren Gemächern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
