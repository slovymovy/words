                "senses": [
                    {
                        "sense_id": "b3f3f991-5156-3b86-9f78-acfdadb999d1",
                        "entry_id": "ca837367-4469-3c61-8fac-595632f3a747",
                        "glosses": [
                            "człowieczek, ludzik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feebdf7f-b3a9-4eaf-880f-8aefbd33a25f",
                                "sense_id": "b3f3f991-5156-3b86-9f78-acfdadb999d1",
                                "text": "Dziewczynka naustawiała na stole plastelinowe ludki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "089fc01d-ff60-4a7a-bc60-4ba7f0e9cbb2",
                        "source_entry_id": "ca837367-4469-3c61-8fac-595632f3a747",
                        "source_sense_id": "b3f3f991-5156-3b86-9f78-acfdadb999d1",
                        "target_lang_word": "Männchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Männchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                        "entry_id": "63d531ed-9d1c-335a-9977-4a1157a2dca6",
                                        "glosses": [
                                            "männliches Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7121e10-88f8-4d23-ad85-e2f20d488f48",
                                                "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                                "text": "Bei den Gottesanbeterinnen verspeisen die Weibchen das Männchen oft noch während der Begattung."
                                            },
                                            {
                                                "example_id": "6d19d971-ad97-44da-a281-fba5f54f48fb",
                                                "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                                "text": "„Und das war auch richtig so, denn in der ganzen Schöpfung gehören die Weibchen den stärksten Männchen.“"
                                            },
                                            {
                                                "example_id": "4beb276c-5e4a-4dd9-a638-4d2534b6ee97",
                                                "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                                "text": "„Die Männchen anderer Affenarten tragen die auffällige Farbe, die den Weibchen signalisieren soll, was für potente Kerle sie sind, am Po.“"
                                            },
                                            {
                                                "example_id": "e13c3285-fbc1-4593-956c-add1088c1170",
                                                "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                                "text": "„Bei den Seenadeln trägt das Männchen die Eier.“"
                                            },
                                            {
                                                "example_id": "884c6c66-b3e8-4d84-8ad6-a779f5427400",
                                                "sense_id": "25db62fd-51aa-3fda-8391-6f888eec4911",
                                                "text": "„Erneut schaute das Männchen sich ruckartig um, musterte wachsam seine Umgebung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e962c93-ee29-3355-97bc-bd15048f8804",
                                        "entry_id": "63d531ed-9d1c-335a-9977-4a1157a2dca6",
                                        "glosses": [
                                            "kleiner Mann; auch für stilisierte, bildliche oder figürliche Darstellungen eines Menschen"
                                        ],
                                        "tags": [
                                            "meist norddeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bae711-ba38-4b35-b49e-e8aff35c8505",
                                                "sense_id": "4e962c93-ee29-3355-97bc-bd15048f8804",
                                                "text": "Du darfst erst gehen, wenn das Männchen in der Ampel grün leuchtet."
                                            },
                                            {
                                                "example_id": "8064dd62-3539-4ac4-a055-a11c6d40d1b9",
                                                "sense_id": "4e962c93-ee29-3355-97bc-bd15048f8804",
                                                "text": "„Ein kleines Männchen führte seinen Dackel spazieren.“"
                                            },
                                            {
                                                "example_id": "871b1498-4d45-4992-9e21-cdf6ed782e36",
                                                "sense_id": "4e962c93-ee29-3355-97bc-bd15048f8804",
                                                "text": "„Alidji Samoura war ein dürres Männchen und mochte um die fünfunsechzig Jahre alt sein.“"
                                            },
                                            {
                                                "example_id": "30805787-ebb2-4f77-ae26-96371eb9f77e",
                                                "sense_id": "4e962c93-ee29-3355-97bc-bd15048f8804",
                                                "text": "„Papst Gregor VII. zum Beispiel, ein kleines Männchen mit Säbelbeinen, diskutiert nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
