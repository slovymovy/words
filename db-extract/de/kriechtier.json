                                            {
                                                "example_id": "ff3ae505-b6d4-43f5-a130-675c11a71519",
                                                "sense_id": "3490be58-3471-3b8c-a682-30bc65642b48",
                                                "text": "Certains des serpents se dressent pour l’attaquer, mais il les ravage de son talon pilonneur, impitoyable et précis. Bientôt, l’écheveau de reptiles n’a plus que des soubresauts agoniques."
                                            },
                                            {
                                                "example_id": "3a6f5f53-54d2-474d-94aa-b8191224df2a",
                                                "sense_id": "3490be58-3471-3b8c-a682-30bc65642b48",
                                                "text": "Les reptiles tordus au front, les yeux ardents,\nL’aboyeuse Gorgô vole et grince des dents\nPar la plaine où le sang exhale ses buées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96da389f-8d80-340d-a6b3-ac2ef4a2665d",
                                        "entry_id": "d3870aa1-4691-375e-a15c-9607bcbe9cad",
                                        "glosses": [
                                            "Viande d'un de ces animaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06352a1-d592-4c92-ae62-02e1727e07e7",
                                                "sense_id": "96da389f-8d80-340d-a6b3-ac2ef4a2665d",
                                                "text": "L’iguane est un plat médiocre, disent les uns, cela sent le reptile. Mais si l'on peut vaincre sa répugnance, cela constitue un plat de résistance et qui vaut bien le singe rouge. Quant à moi, j'en suis très friand ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a26eed5f-60ca-39d7-b71e-c97f956be458",
                                        "entry_id": "d3870aa1-4691-375e-a15c-9607bcbe9cad",
                                        "glosses": [
                                            "Dinosaure (appellation aujourd’hui rejetée par les scientifiques)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0db90f73-f3c7-35cf-b596-57629bd4cf7b",
                                        "entry_id": "d3870aa1-4691-375e-a15c-9607bcbe9cad",
                                        "glosses": [
                                            "Animal qui rampe ou semble ramper."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05e222f-748c-4fb5-8a14-dba0b2c83cec",
                                                "sense_id": "0db90f73-f3c7-35cf-b596-57629bd4cf7b",
                                                "text": "[…] dès que la femelle couve, elle ne chante plus, et vers la fin de juin le mâle se tait aussi, ou ne se fait entendre que par quelques sons rauques semblables au coassement d'un reptile, et si différents des premiers qu'on a de la peine à se persuader que ces sons viennent du rossignol, ni même d'un autre oiseau."
                                            },
                                            {
                                                "example_id": "a1c132f3-c82f-4ec0-9c75-0369debee61e",
                                                "sense_id": "0db90f73-f3c7-35cf-b596-57629bd4cf7b",
                                                "text": "Certains coins, les coins d’ombre humide, grouillaient d’un pullulement de reptiles, noirs, jaunes, violacés, zébrés, tigrés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
