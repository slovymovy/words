                                                "example_id": "09908f1f-4ead-4642-80b7-87ff0f2682a3",
                                                "sense_id": "1fdfdefc-91d7-3869-a6bc-994ff78b49ed",
                                                "text": "The individual characters of the several minerals produced from the change of the spodumene have already been given, and something has been said as to their mutual relations;[…]."
                                            },
                                            {
                                                "example_id": "2984e749-247d-453e-b764-882b2cdf98df",
                                                "sense_id": "1fdfdefc-91d7-3869-a6bc-994ff78b49ed",
                                                "text": "Two coexisting spodumenes occurred in sample A, one with high, the other with low, sodium content."
                                            },
                                            {
                                                "example_id": "e987d13c-cf55-4595-acc8-a56b726916c3",
                                                "sense_id": "1fdfdefc-91d7-3869-a6bc-994ff78b49ed",
                                                "text": "Spodumene alone was found to be too refractory to produce vitrification at cone 11."
                                            }
