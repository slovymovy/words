                "senses": [
                    {
                        "sense_id": "97004ddf-171b-3442-97bb-fadac1e103db",
                        "entry_id": "ebc68537-c21c-3875-b92f-b69b14341d5f",
                        "glosses": [
                            "Cloison légère et décorative constituée d’éléments non jointifs ou évidés. Son usage est plus fréquent au jardin qu'en intérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fb9f3d-1c6d-4c85-b18e-3dec1dc6def8",
                                "sense_id": "97004ddf-171b-3442-97bb-fadac1e103db",
                                "text": "La loggia qui donne sur la rue est fermée sur une partie par un claustra. Sur la partie qui n’est pas fermée, le couple a mis des plantes."
                            },
                            {
                                "example_id": "01cae5d3-2581-4a64-acda-0e743bafab1b",
                                "sense_id": "97004ddf-171b-3442-97bb-fadac1e103db",
                                "text": "À gauche, la cuisine coin repas, séparée du living par une claustra, qui permet de voir d’une pièce dans l’autre ; à droite, la salle de bains WC douche; au milieu, le living."
                            },
                            {
                                "example_id": "b15c4edd-4bbf-4d1a-9cba-1d7e2c8c69c6",
                                "sense_id": "97004ddf-171b-3442-97bb-fadac1e103db",
                                "text": "Pierrot accompagne aussi l’abbé quand il va dire les vêpres chez les Visitandines, invisibles derrière un claustra."
                            },
                            {
                                "example_id": "aad2c766-39e2-4aff-81e7-9eaa96c945a4",
                                "sense_id": "97004ddf-171b-3442-97bb-fadac1e103db",
                                "text": "Pour s’en imprégner, il faut parcourir le quartier de Foncillon, ses auvents, ses escaliers, ses claustras, ses brise-soleil…"
                            }
                        ]
                    }
                ],
