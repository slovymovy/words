                        "entry_id": "b06db349-660c-3bad-ac04-db3aef120c39",
                        "glosses": [
                            "One who offers excuses or pleads in extenuation of the fault of another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "336befab-5bd1-4865-aaa0-08bebb65a533",
                                "sense_id": "978ce395-8c65-3395-9ea1-5091ce9ef35d",
                                "text": "In vain would his excusers endeavour to palliate his enormities, by imputing them to madness; because it is well known, that madness only operates by inflaming and enlarging the good or evil dispositions of the mind."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea78be72-49ba-3c17-89b0-cf367f1049ca",
                        "entry_id": "b06db349-660c-3bad-ac04-db3aef120c39",
                        "glosses": [
                            "One who excuses or forgives another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b601ca0-23ce-486c-8a06-864664608a6e",
                                "sense_id": "ea78be72-49ba-3c17-89b0-cf367f1049ca",
                                "text": "yet love is a sufficient excuse and excuser of greater errors than are mine"
                            }
                        ]
                    }
