{
    "word_family": [
        "little",
        "lessen",
        "littleness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "71a3e401-2307-3e21-a852-8195e260db7d",
                    "sense_definition": "Used to form the superlative of adjectives and adverbs, indicating the lowest level or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lowest_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>least</w> expensive option on the menu.",
                            "target_lang_translations": {
                                "ru": "Это <w>наименее</w> дорогой вариант в меню.",
                                "zh": "这是菜单上<w>最不</w>贵的选择。"
                            }
                        },
                        {
                            "text": "It was the <w>least</w> surprising news I heard all day.",
                            "target_lang_translations": {
                                "ru": "Это была <w>наименее</w> удивительная новость, которую я слышал за весь день.",
                                "zh": "这是我今天听到的<w>最不</w>让人惊讶的消息。"
                            }
                        }
                    ],
                    "antonyms": [
                        "most"
                    ],
                    "common_phrases": [
                        "least likely",
                        "least important",
                        "least expensive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для образования превосходной степени прилагательных и наречий, указывая на самый низкий уровень или степень.",
                        "zh": "用于形容词和副词的最高级，表示最低的程度或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наименее",
                                "target_lang_sense_clarification": "формальный способ образования превосходной степени"
                            },
                            {
                                "target_lang_word": "меньше всего",
                                "target_lang_sense_clarification": "наиболее употребительный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最不",
                                "target_lang_sense_clarification": "用于形容词前表示程度最低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4d9940a-d274-3adc-8954-1ae3daafba70",
                    "sense_definition": "To the smallest extent or lowest degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lowest_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I suspect him the <w>least</w> of all the people in the room.",
                            "target_lang_translations": {
                                "ru": "Я подозреваю его <w>меньше всего</w> из всех людей в комнате.",
                                "zh": "在房间里的所有人中，我怀疑他怀疑得<w>最少</w>。"
                            }
                        },
                        {
                            "text": "The plan that we discussed the <w>least</w> turned out to be the best.",
                            "target_lang_translations": {
                                "ru": "План, который мы обсуждали <w>меньше всего</w>, оказался лучшим.",
                                "zh": "我们讨论得<w>最少</w>的那个计划反而成了最好的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "minimally"
                    ],
                    "antonyms": [
                        "most"
                    ],
                    "common_phrases": [
                        "least of all",
                        "expect least",
                        "last but not least"
                    ],
                    "target_lang_definitions": {
                        "ru": "В наименьшей степени или мере.",
                        "zh": "在最小的程度上或最低的限度内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньше всего",
                                "target_lang_sense_clarification": "о степени действия или чувства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最少",
                                "target_lang_sense_clarification": "表示动作或程度的最低限度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e59b011-b2e0-3de0-9c51-37000f852af1",
                    "sense_definition": "A shortening of the phrase \"at least\", used to introduce a positive comment or a minimum estimate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Least</w> I tried to fix the problem before calling for help.",
                            "target_lang_translations": {
                                "ru": "<w>По крайней мере</w>, я попытался решить проблему, прежде чем звать на помощь.",
                                "zh": "<w>至少</w>我在寻求帮助前尝试过解决这个问题。"
                            }
                        },
                        {
                            "text": "It was a difficult journey, but <w>least</w> we arrived safely.",
                            "target_lang_translations": {
                                "ru": "Это было трудное путешествие, но, <w>по крайней мере</w>, мы добрались благополучно.",
                                "zh": "这是一段艰难的旅程，但<w>至少</w>我们安全抵达了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of 'at least'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение фразы \"at least\" (по крайней мере), используется для введения позитивного комментария или минимальной оценки.",
                        "zh": "“at least”的缩略形式，用于引出积极的评论或最低限度的估计。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по крайней мере",
                                "target_lang_sense_clarification": "вводная фраза"
                            },
                            {
                                "target_lang_word": "хотя бы",
                                "target_lang_sense_clarification": "указание на минимальное условие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "至少",
                                "target_lang_sense_clarification": "表示最低限度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                    "sense_definition": "The smallest amount or quantity of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lowest_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has the <w>least</w> money of anyone in the group.",
