                                "example_id": "56a28d67-5eaf-46b5-99f6-f1314fe9e76f",
                                "sense_id": "ea87f14d-c864-30f0-8f3d-3542ffb8ba8f",
                                "text": "La Méditerranée est de dimension trop réduite pour pouvoir, écologiquement , s’\"auto-compenser\"."
                            },
