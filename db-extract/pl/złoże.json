                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "344d83d2-7c9b-37fd-81fb-2fbdc25bac0e",
                        "entry_id": "e8f66f9d-1252-382a-9ab8-0b3f3dbb465c",
                        "glosses": [
                            "nagromadzenie kopaliny użytecznej w skorupie ziemskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705df79f-6cfe-4eae-9ee8-4178c92b569d",
                                "sense_id": "344d83d2-7c9b-37fd-81fb-2fbdc25bac0e",
                                "text": "Na równinach abisalnych znajdują się złoża konkrecji polimetalicznych – brył zbudowanych ze związków manganu, niklu, żelaza, kobaltu, miedzi z domieszkami innych metali, będące obiektem zainteresowania ze strony ludzi pod kątem ich gospodarczego wykorzystania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7c17db7-9f4d-4d75-bc12-ed3d9a00982c",
                        "source_entry_id": "e8f66f9d-1252-382a-9ab8-0b3f3dbb465c",
                        "source_sense_id": "344d83d2-7c9b-37fd-81fb-2fbdc25bac0e",
                        "target_lang_word": "lode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
