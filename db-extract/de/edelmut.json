                "senses": [
                    {
                        "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                        "entry_id": "c35fa14b-4d9c-3f8d-8ec5-c7ce39592ae0",
                        "glosses": [
                            "edle Gesinnung, die egoistische Motive hintenan stellt"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "d983599d-62fe-4b4d-88da-20d416f3ba47",
                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                "text": "Mit dieser Aktion hat er einmal mehr seinen Edelmut bewiesen."
                            },
                            {
                                "example_id": "e4b5072f-b7d7-4e86-9b19-08bada82acb6",
                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                "text": "„»so gütig werden Sie nicht immer denken; es wird sich eine Stimme finden, die Sie von diesem Edelmut abzubringen suchen wird.« – »Sie irren, d'Artagnan, der Rat, Herrn d'Herblay nicht weiter zu verfolgen, rührt von Colbert selbst her.“"
                            },
                            {
                                "example_id": "17e3a2ad-790b-4ba5-a988-e1d69b790710",
                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                "text": "„Der Edelmut, mit dem Napoleon in Moskau verfahren wollte, riss ihn selbst hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
