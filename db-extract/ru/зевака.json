                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9cf9c97-d8c8-3a6d-a067-4d50b06f5461",
                        "entry_id": "d45d1b4d-a68c-3097-a23a-63e461cff37e",
                        "glosses": [
                            "разг. тот (та), кто из праздного любопытства засматривается на кого-либо или рассматривает что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57cb8744-7810-4f61-8ccc-15998610663e",
                                "sense_id": "a9cf9c97-d8c8-3a6d-a067-4d50b06f5461",
                                "text": "У его дома опять дежурил телевизионный автобус. Собралось даже несколько зевак. Дед вошёл в свою разорённую квартиру, ожидая увидеть полный тарарам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5653046b-ef41-43a5-ac55-e9f7645f9e06",
                        "source_entry_id": "d45d1b4d-a68c-3097-a23a-63e461cff37e",
                        "source_sense_id": "a9cf9c97-d8c8-3a6d-a067-4d50b06f5461",
                        "target_lang_word": "onlooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onlooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                        "entry_id": "c467616c-7b61-32cd-8da6-7d4a258a313b",
                                        "glosses": [
                                            "A spectator; someone looks on or watches, without becoming involved or participating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d641ad28-474d-44bd-a50c-f4c18285e8ad",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "I wasn’t involved in the fight; I was only an onlooker."
                                            },
                                            {
                                                "example_id": "e366a5ae-69d3-426e-93ff-51acaa5196e0",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "When the right-away was given, Driver Gibson would give a sonorous blast on Cardean's deep-toned hooter, and amid a flurry of swirling steam the train would move majestically out, with nearly half the city of Carlisle—or so it would appear—as onlookers on the platform."
                                            },
                                            {
                                                "example_id": "75a66cc0-3ee5-4b94-af99-b161fc96b076",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "As a result, while the train was being shunted at Bombay, the buffers became locked, producing a situation most intriguing for the onlookers, but exasperating for the exalted passengers and the unhappy railway authorities."
                                            },
                                            {
                                                "example_id": "2c382c57-be74-4bb2-b66e-57af6757c974",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "Please allow me to adjust my pants\nSo that I may dance the good time dance\nAnd put the onlookers and innocent bystanders into a trance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6378fb6b-a805-4d6c-84b4-58e7c1f9f520",
                        "source_entry_id": "d45d1b4d-a68c-3097-a23a-63e461cff37e",
                        "source_sense_id": "a9cf9c97-d8c8-3a6d-a067-4d50b06f5461",
                        "target_lang_word": "pazguato",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pazguato",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a0bd648b-313e-38df-b7d9-a754a2af9cf1",
                                        "entry_id": "47592ebf-e664-3342-ba7d-1eb92d070c82",
                                        "glosses": [
                                            "Fácil de engañar o impresionar."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67efad4-4a2d-4aad-8127-2bc6586864e7",
                                                "sense_id": "a0bd648b-313e-38df-b7d9-a754a2af9cf1",
                                                "text": "Con los Soverbios, ni con los ingratos,\nNi con los Cortesanos orgullosos,\nNi con los Tontos, simples, y pazguatos."
                                            },
                                            {
                                                "example_id": "95906619-d043-43fc-a8c5-8f90a6e891a5",
                                                "sense_id": "a0bd648b-313e-38df-b7d9-a754a2af9cf1",
                                                "text": "Bueno, esto es así y no hay quien lo mueva, ¿verdad? Entonces tú estás en la verdad, pero llega un pazguato o una pazguata, que para el caso es lo mismo, y trata de desmontar tu verdad con cuatro vulgaridades que le han grabado a fuego cuando niño. Y ahí está lo grave; a ese pazguato o a esa pazguata difícilmente podrás convencerles de que no tienen ideas, de que lo único que tienen es aserrín dentro de la cabeza, ¿me has comprendido?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "173cc17f-9197-3425-b65d-c7725a9851ac",
                                        "entry_id": "47592ebf-e664-3342-ba7d-1eb92d070c82",
                                        "glosses": [
                                            "Fácil de escandalizar."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5fae17-a9d3-413d-9b45-3aeef5d027f2",
                                                "sense_id": "173cc17f-9197-3425-b65d-c7725a9851ac",
                                                "text": "¡Ya me conoces!, ¡eh!, ¡ya me conoces! Conmigo no se juega. No pienses que yo soy como el pazguato del padre de la monja (lo decía por mi suegro) que se volvió loco, se murió y no hizo nada. No, yo no soy tan para poco."
                                            },
                                            {
                                                "example_id": "aceabca3-37f8-41f7-a488-74a2b7218b9a",
                                                "sense_id": "173cc17f-9197-3425-b65d-c7725a9851ac",
                                                "text": "Con el hormigueo incitante de lo improcedente, inspeccioné el armario de Mary y, ante todo, un neceser, con un contenido en billetes y otros documentos de crédito que habría sosegado al más pusilánime, tanto como excitado al más pazguato el resto de la tramoya, cuya enumeración caótica agotaba cualquier posibilidad de inventario."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
