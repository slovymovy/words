                        ],
                        "form": "[A] stenen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dba54dbf-f207-378c-9265-68b596e39e0b",
                        "entry_id": "cb2267ba-5f37-3022-b267-9e8dc8835e50",
                        "glosses": [
                            "gemaakt van steen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85da842b-6cd9-42d3-927d-fbea22c4970f",
                                "sense_id": "dba54dbf-f207-378c-9265-68b596e39e0b",
                                "text": "De stenen gevel werd verwijderd."
                            },
                            {
                                "example_id": "f1cd88c1-5e17-40f2-be4d-fe5b84b4c125",
                                "sense_id": "dba54dbf-f207-378c-9265-68b596e39e0b",
                                "text": "Het uitzicht vanuit de kamer die ze me hadden toegewezen, was verschrikkelijk, een zwart beroete stenen muur, en als je naar beneden keek diep onder je een steeg, waar portiers en secretaresses van een belendend gebouw op een rijtje stonden te roken."
                            },
                            {
                                "example_id": "2a245d25-966d-41e2-8585-8f9bf4b9c511",
                                "sense_id": "dba54dbf-f207-378c-9265-68b596e39e0b",
                                "text": "Iedere dag liep ik de stenen treden op naar de brede deuren van het Skelton, waar met gouden letters Am vmcn~owuA op het glas stond geschilderd."
                            },
                            {
                                "example_id": "1220fd18-dac9-4eed-9730-667e431744b2",
                                "sense_id": "dba54dbf-f207-378c-9265-68b596e39e0b",
                                "text": "Op de Hardangervidda bouwde hij stenen bruggen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a59369ca-83c0-3060-aa8c-9a2cfc01359e",
                "word": "stenen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "157b8ecd-7507-388d-84b4-5d5c42c05159",
                        "entry_id": "a59369ca-83c0-3060-aa8c-9a2cfc01359e",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord steen"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2b7765ee-8c43-4e99-b0f6-2f10506fd7f3",
                                "sense_id": "157b8ecd-7507-388d-84b4-5d5c42c05159",
                                "text": "Na uren lopen en een hele tijd zoeken vond ik een vlakke plek voor mijn tent en gooide ik eerst een aantal stenen de struiken in om eventuele slangen te verjagen."
                            },
                            {
                                "example_id": "ccbcd326-83be-440e-afe6-4644ed8da773",
                                "sense_id": "157b8ecd-7507-388d-84b4-5d5c42c05159",
                                "text": "De man en de vrouw kwamen naar het huis gelopen, allebei met de zekere pas van berggeiten, terwijl ze konijnenholen en kleine stenen ontweken in hun ogenschijnlijk onwrikbare verlangen dichterbij te komen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "027038df-080c-3425-b008-98b36025e34d",
                "word": "stenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1ee8157a-b060-4e84-91f6-d7bcfb1cc3c1",
                        "entry_id": "027038df-080c-3425-b008-98b36025e34d",
                        "tags": [
                            "canonical"
                        ],
                        "form": "[A] stenen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a358a7c-41cb-39e7-8722-dad5c6606b9e",
                        "entry_id": "027038df-080c-3425-b008-98b36025e34d",
                        "glosses": [
                            "doden door bekogeling met keien"
                        ],
                        "tags": [
                            "Early-Modern-Dutch",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6cd07d26-1b92-4eea-b66f-5e16b12621cf",
                                "sense_id": "6a358a7c-41cb-39e7-8722-dad5c6606b9e",
                                "text": "⧖ Sy riepen seer en stopten haer ooren\nVielen tot hem aen eendrachtelijck\nStieten hem ter stadt wt met verstooren\nEn steenden den man Gods crachtelijck."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf42ddcf-ac1b-34f2-8978-63e5a6616ad9",
                        "entry_id": "027038df-080c-3425-b008-98b36025e34d",
                        "glosses": [
                            "van wegverharding voorzien"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "afb1e3d7-254a-4883-982c-4b6aa288be61",
                                "sense_id": "bf42ddcf-ac1b-34f2-8978-63e5a6616ad9",
                                "text": "De straten zijn lang en somtijds ruim, maar altijd hoekerig en slecht gesteend; in de voorsteden vindt men er zelfs, welke, even als de openbare wegen, zijn voorzien van balken, waarop men planken legt."
                            }
                        ]
                    },
                    {
                        "sense_id": "01c04124-3b6e-35e9-bc8d-bc2b54d95c06",
                        "entry_id": "027038df-080c-3425-b008-98b36025e34d",
                        "glosses": [
                            "van een of meer edelstenen voorzien"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7af374e7-72a4-4916-81b8-a703aa85957d",
                                "sense_id": "01c04124-3b6e-35e9-bc8d-bc2b54d95c06",
                                "text": "U zult bemerken, dat een goed gesteend Zwitsers ankerhorloge niet duur behoeft te zijn."
                            }
                        ]
                    }
                ],
