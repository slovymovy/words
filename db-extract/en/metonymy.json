    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                "word": "metonymy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a1a29f41-59b3-403a-adc6-0339edda85de",
                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                        "tags": [
                            "plural"
                        ],
                        "form": "metonymies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                        "glosses": [
                            "The use of a single characteristic or part of an object, concept or phenomenon to identify the entire object, concept, phenomenon or a related object."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "815454ee-6aa5-48a2-908c-5aa5ff85e0b9",
                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                "text": "Metonymy does new names impose,\nAnd things for things by near relation shews."
                            },
                            {
                                "example_id": "60b907d6-1ace-496e-a9d8-5a60923b4f9b",
                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                "text": "...the principle of metonymy is simply to substitute for the plain name of a thing a name or phrase based on something connected with it."
                            },
                            {
                                "example_id": "053dd200-5254-4067-aa19-f6893e47ac3d",
                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                "text": "THE KEY CONCEPT IS “metonymy.” This is the act of a word or phrase associated with a concept coming to represent the entirety of said concept. Generally, this means an extension of the original meaning. For example, “city hall” no longer means just the structure, but also the lawmakers who inhabit that structure. In the same way, “dish” started as the physical plate a meal is served on, before people started using it to represent the meal itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbabde25-4491-3761-aad6-af39e35d06bf",
                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                        "glosses": [
                            "A metonym."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe777409-51fe-49b0-bbca-02034df849fe",
