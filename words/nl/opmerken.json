{
    "word_family": [
        "opmerking",
        "opmerkzaam",
        "opmerkzaamheid",
        "merken",
        "merk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d70e7987-25b8-3875-90d9-1a9a03c127e7",
                    "sense_definition": "iets of iemand met de zintuigen of de geest waarnemen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waarnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De inbreker werd direct <w>opgemerkt</w> door een toevallige voorbijganger.",
                            "target_lang_translations": {
                                "en": "The burglar was immediately <w>noticed</w> by a chance passerby."
                            }
                        },
                        {
                            "text": "Ik kon een klein detail in het schilderij <w>opmerken</w> dat niemand anders zag.",
                            "target_lang_translations": {
                                "en": "I was able to <w>observe</w> a small detail in the painting that no one else saw."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemerken",
                        "waarnemen",
                        "zien",
                        "constateren"
                    ],
                    "antonyms": [
                        "negeren",
                        "over het hoofd zien"
                    ],
                    "common_phrases": [
                        "een verschil opmerken",
                        "direct opmerken"
                    ],
                    "target_lang_definitions": {
                        "en": "to perceive something or someone with the senses or the mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "notice",
                                "target_lang_sense_clarification": "to become aware of something"
                            },
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "to view or notice carefully"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "to see or notice something, often from a distance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce188f47-32ec-3efd-afbe-9508483c212b",
                    "sense_definition": "een waarneming of mening mondeling of schriftelijk uiten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een voorbijganger <w>merkte</w> <w>op</w> dat de dop nog op de lens zat.",
                            "target_lang_translations": {
                                "en": "A passerby <w>remarked</w> that the cap was still on the lens."
                            }
                        },
                        {
                            "text": "Hij <w>merkte</w> terecht <w>op</w> dat we nog niet klaar waren met het project.",
                            "target_lang_translations": {
                                "en": "He rightly <w>noted</w> that we were not yet finished with the project."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeggen",
                        "aanstippen",
                        "vermelden",
                        "constateren"
                    ],
                    "antonyms": [
                        "verzwijgen"
                    ],
                    "common_phrases": [
                        "terecht opmerken",
                        "tussen neus en lippen opmerken"
                    ],
                    "target_lang_definitions": {
                        "en": "to express an observation or opinion orally or in writing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remark",
                                "target_lang_sense_clarification": "to state as an observation"
                            },
                            {
                                "target_lang_word": "note",
                                "target_lang_sense_clarification": "to mention or point out something"
                            },
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "to comment on something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}