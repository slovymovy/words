                                "sense_id": "7335f8e9-e38e-3d7b-b473-58fb86c6c918",
                                "text": "I really hate the grinding to get that 1% chance item."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9ef802a-75f9-36ba-b0a3-d2d19ad24764",
                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                        "glosses": [
