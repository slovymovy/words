{
    "word_family": [
        "résiduel",
        "résiduaire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54855a48-f69f-3f9f-a1db-8cb1b2b5e06f",
                    "sense_definition": "Ce qui reste ou subsiste d'un ensemble, d'une matière ou d'une quantité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir nettoyé le filtre, il a constaté qu'un <w>résidu</w> de poussière s'était accumulé au fond."
                        },
                        {
                            "text": "Les quelques maisons encore debout ne sont que le <w>résidu</w> d'un village autrefois prospère."
                        }
                    ],
                    "synonyms": [
                        "reste",
                        "reliquat"
                    ],
                    "antonyms": [
                        "principal"
                    ],
                    "common_phrases": [
                        "éliminer les résidus"
                    ]
                },
                {
                    "sense_id": "719af059-05bd-32bf-8434-eda0157812d5",
                    "sense_definition": "Substance solide ou pâteuse restant après une opération chimique, une combustion ou une filtration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matière_restante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traitement des <w>résidus</w> industriels doit respecter des normes environnementales très strictes."
                        },
                        {
                            "text": "La combustion incomplète du charbon laisse souvent un <w>résidu</w> sombre au fond du foyer."
                        }
                    ],
                    "synonyms": [
                        "effondrilles"
                    ],
                    "common_phrases": [
                        "traitement des résidus",
                        "résidus toxiques"
                    ]
                },
                {
                    "sense_id": "33e74000-8500-3c5d-8e0a-f3a724fcc18c",
                    "sense_definition": "Liquide non évaporé restant au fond du récipient à l'issue d'une distillation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matière_restante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chimiste a extrait le <w>résidu</w> de distillation pour analyser sa composition moléculaire."
                        },
                        {
                            "text": "Après le processus d'évaporation, le <w>résidu</w> visqueux a été jeté dans un bac sécurisé."
                        }
                    ],
                    "synonyms": [
                        "soutirat"
                    ],
                    "antonyms": [
                        "distillat"
                    ],
                    "common_phrases": [
                        "résidu de distillation"
                    ]
                },
                {
                    "sense_id": "233da300-7cf6-3b27-b228-db6c546b8341",
                    "sense_definition": "Ce qui demeure inexpliqué ou non résolu dans une théorie ou un ensemble de données.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs cherchent encore à interpréter ce <w>résidu</w> d'observations contradictoires dans leur modèle."
                        },
                        {
                            "text": "Dans cette analyse, l'écart mesuré constitue un <w>résidu</w> inexpliqué que la théorie ne justifie pas."
                        }
                    ],
                    "common_phrases": [
                        "résidu inexpliqué"
                    ]
                },
                {
                    "sense_id": "9453b445-e597-3e4f-acfb-bceab3a89a34",
                    "sense_definition": "Nombre complexe décrivant le comportement d'une fonction holomorphe au voisinage d'une singularité.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathématiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mathématicien a utilisé le théorème des <w>résidus</w> pour calculer cette intégrale complexe."
                        },
                        {
                            "text": "La méthode consiste à déterminer le <w>résidu</w> de la fonction en chaque pôle isolé."
                        }
                    ],
                    "common_phrases": [
                        "théorème des résidus",
                        "calcul des résidus"
                    ]
                }
            ]
        }
    ]
}