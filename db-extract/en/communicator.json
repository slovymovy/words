                    {
                        "sense_id": "e88634f0-38ef-3c3b-acaf-a02d0a1e511a",
                        "entry_id": "43c374cd-cce8-3df8-bd9e-f4c2413cfaca",
                        "glosses": [
                            "Someone who, or something that communicates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50e35e6-34cc-4ede-b5cc-b16b95a30c8e",
                                "sense_id": "e88634f0-38ef-3c3b-acaf-a02d0a1e511a",
                                "text": "We'll let Nick give the presentation next week: he's a good communicator."
                            }
                        ]
                    },
                    {
                        "sense_id": "63ec8a5f-869d-3430-9e63-f20dfa17ea73",
                        "entry_id": "43c374cd-cce8-3df8-bd9e-f4c2413cfaca",
                        "glosses": [
                            "Any of several electronic devices that allow people with various disabilities to communicate via displays or artificial speech."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a08c3064-157b-3627-a742-634905bcef9c",
                        "entry_id": "43c374cd-cce8-3df8-bd9e-f4c2413cfaca",
                        "glosses": [
                            "A usually portable communications device."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e2da35-24ee-42d2-b479-f49710ae22de",
                                "sense_id": "a08c3064-157b-3627-a742-634905bcef9c",
                                "text": "‘Observation Officer of the Z12Q, attention!’ snapped from the tight-beam headquarters communicator. ‘Cut off those spy rays and report yourself under arrest for treason!’"
                            },
                            {
                                "example_id": "b22a301b-ee24-4984-824b-e22453812a37",
                                "sense_id": "a08c3064-157b-3627-a742-634905bcef9c",
                                "text": "Captain, if the Iotians, who are very bright an imitative people, should take that communicator apart..."
                            }
                        ]
                    }
                ],
