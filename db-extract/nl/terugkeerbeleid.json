                "senses": [
                    {
                        "sense_id": "7505d470-7140-3b9f-b87b-d771959a405e",
                        "entry_id": "c1a12553-607b-368a-8ecf-dbd20362c7dd",
                        "glosses": [
                            "plannen en maatregelen die erop gericht zijn om immigranten weer terug te laten gaan naar hun land van herkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916f9c14-8e55-402e-91a4-800ccf5b3b28",
                                "sense_id": "7505d470-7140-3b9f-b87b-d771959a405e",
                                "text": "ˈDe EU en Ghana zijn het erover eens dat een goed functionerend terugkeerbeleid integraal onderdeel moet uitmaken van de aanpak van de migratiestromen tussen West-Afrika en Europaˈ, aldus Koenders."
                            },
                            {
                                "example_id": "15fe152f-1ddd-4941-a1ee-86ef0bd12e4b",
                                "sense_id": "7505d470-7140-3b9f-b87b-d771959a405e",
                                "text": "Landen die meewerken aan het terugkeerbeleid wordt handelsvoordelen, meer ontwikkelingssteun en geld voor grensbewaking of vluchtelingenopvang in het vooruitzicht gesteld. Bij tegenwerking kan bijvoorbeeld het visumbeleid worden aangescherpt of de samenwerking op landbouwgebied worden opgezegd."
                            },
                            {
                                "example_id": "6056a65f-0428-4c0a-be17-d16124f8165b",
                                "sense_id": "7505d470-7140-3b9f-b87b-d771959a405e",
                                "text": "Ze zegt zich te blijven inzetten \"voor een migratiebeleid waarin kinderrechten centraal staan\". Ze noemt het onacceptabel dat in Nederland nog steeds kinderen na tien jaar uitgezet kunnen worden en pleit voor een beter terugkeerbeleid, met korte procedures en een goede voorbereiding op terugkeer. \"Laten we er samen voor zorgen dat kinderen zoals Howick en Lili niet langer jarenlang in onzekerheid hoeven te leven.\""
                            }
                        ]
                    }
