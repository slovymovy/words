                ],
                "senses": [
                    {
                        "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                        "entry_id": "3a9a38ff-f3eb-370f-a8c0-929df95b957e",
                        "glosses": [
                            "Persistent or pressing, often annoyingly so."
                        ],
                        "tags": [
                            "of a demand"
                        ],
                        "examples": [
                            {
                                "example_id": "4e5ec05c-1573-4fc3-8a86-61f837995f5b",
                                "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                                "text": "Nick was on the point of declaring again that he was a humbug, so vivid was his inner sense of what he thought of his factitious public utterances, which had the cursed property of creating dreadful responsibilities and importunate credulities for him."
                            },
                            {
                                "example_id": "72c5f2aa-ce51-4941-bc11-c50d7c05b4f6",
                                "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                                "text": "Trembling in every limb I raise my loud im­portunate cry,\nAnd in a sacred terror wait the Delian god’s reply."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ba1d892-2bf2-32db-882c-c1a3cd759413",
                        "entry_id": "3a9a38ff-f3eb-370f-a8c0-929df95b957e",
                        "glosses": [
                            "Given to importunate demands, greedily or thoughtlessly demanding."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4206ea38-8331-440d-a0f2-50d3679feea1",
                        "source_entry_id": "3a9a38ff-f3eb-370f-a8c0-929df95b957e",
                        "source_sense_description": "of a demand, persistent or pressing",
                        "target_lang_word": "настойчивый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "настойчивый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9360e599-b56f-378d-afec-31c79b1c668b",
                                        "entry_id": "402e9223-d276-3e6b-9cb9-191736d3cdd7",
                                        "glosses": [
                                            "упорный, твёрдый в достижении какой-либо цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4586aa05-5d5b-4c9f-a688-8083d0f4e21a",
                                                "sense_id": "9360e599-b56f-378d-afec-31c79b1c668b",
                                                "text": "Г-жа Ельцова была женщина очень странная, с характером, настойчивая и сосредоточенная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                        "entry_id": "402e9223-d276-3e6b-9cb9-191736d3cdd7",
                                        "glosses": [
                                            "перен. неотступный, упорный; назойливый, навязчивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322e5fa8-f887-4c93-bac1-e79b719f596d",
                                                "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                                "text": "Настойчивая мысль о том, что я сумасшедший, вызывала и сумасшедшие желания, а как только я выполнил их, оказалось, что и желаний-то никаких нет, и я не безумный."
                                            },
                                            {
                                                "example_id": "9f41965a-2ea5-4eb0-876c-5aa1e4fe5153",
                                                "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                                "text": "Щенок как будто не слыхал; он глядел в сторону и дрожал всё той же настойчивой и мучительной дрожью, на которую холодно было смотреть."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
