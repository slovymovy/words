                "senses": [
                    {
                        "sense_id": "1a971edd-76b2-33f0-a6ca-5cbb70c3cc1c",
                        "entry_id": "7a590696-a4ad-3834-b511-1d2be534a340",
                        "glosses": [
                            "die Uhrzeit oder der Zeitpunkt, zu der ein Flugzeug irgendwo abfliegt beziehungsweise abfliegen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db08883-8bd6-4c51-a45a-9380c2b99d8a",
                                "sense_id": "1a971edd-76b2-33f0-a6ca-5cbb70c3cc1c",
                                "text": "„Ich gebe vor, die Abflugzeiten über unseren Köpfen zu studieren.“"
                            },
                            {
                                "example_id": "cdded216-f873-45bb-ade3-d5e5ac7e8de9",
                                "sense_id": "1a971edd-76b2-33f0-a6ca-5cbb70c3cc1c",
                                "text": "„Für die Richter steht fest, dass die Abflugzeit für viele Urlauber ein wichtiges Kriterium bei der Buchung einer Reise darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
