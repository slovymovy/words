                                    {
                                        "sense_id": "6e1d5fe6-41bb-392b-805d-bc3831ba0b0e",
                                        "entry_id": "62ba9cd2-23ee-394c-8cc8-6dfa17add3a3",
                                        "glosses": [
                                            "Any plant of the genus Camellia, shrubs and small trees native to Asia; Camellia japonica is the most popular as a garden plant; Camellia sinensis is the tea plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727ded31-5c9c-4512-a67f-6d0ca1d88a73",
                                                "sense_id": "6e1d5fe6-41bb-392b-805d-bc3831ba0b0e",
                                                "text": "Palms towered majestically over the heads of the lower shrubs, and camellias, stephanotis, and many other semi-tropical flowers were growing luxuriantly in the open air."
                                            },
                                            {
                                                "example_id": "dd84e523-630b-40e0-a60c-68b269fa6ec3",
                                                "sense_id": "6e1d5fe6-41bb-392b-805d-bc3831ba0b0e",
                                                "text": "I already hinted at the problem of sea eutrophication (where excess nutrients cause algae to flourish) due to the phosphates that used to be added to washing powder, and, surely, it is not pleasant for plants to find underfoot (or, better, \"underroot\") those surfactants we use daily at home (please, never pour your dishwater on the roots of a magnificent camellia, even if it is blooming in the garden of a next-door neighbor you cannot stand)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
