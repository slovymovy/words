                    "sense_definition": "Jednostka danych przetwarzana przez procesor komputera.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Architektura tego procesora opiera się na trzydziestodwubitowym <w>słowie</w> maszynowym.",
                            "target_lang_translations": {
