                            {
                                "example_id": "f776514e-f5d1-4845-a6d1-d36c24fd4386",
                                "sense_id": "9877b0b3-4480-31de-bb4c-5f9012d90bca",
                                "text": "De compensatieregeling vervangt de huidige regeling, waarbij huiseigenaren alleen een vergoeding kunnen claimen bij de NAM op het moment dat ze hun huis verkopen. In de nieuwe regeling komen alle huiseigenaren in aanmerking voor compensatie."
                            },
