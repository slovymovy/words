                {
                    "sense_id": "295f32cf-8ab4-31df-9a01-4a87e1f6b506",
                    "sense_definition": "Habiter un lieu ou y établir une population d'humains ou d'animaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses espèces d'oiseaux viennent <w>peupler</w> les forêts dès le début du printemps.",
                            "target_lang_translations": {
                                "en": "Many species of birds come to <w>populate</w> the forests from the very start of spring.",
                                "ru": "С самого начала весны многие виды птиц начинают <w>заселять</w> леса.",
                                "de": "Viele Vogelarten <w>bevölkern</w> schon ab dem Frühlingsbeginn die Wälder.",
                                "es": "Muchas especies de aves llegan a <w>poblar</w> los bosques desde el inicio de la primavera.",
                                "zh": "从初春开始，许多种鸟类就来森林中<w>栖息</w>。"
                            }
                        },
                        {
                            "text": "Le gouvernement a encouragé les familles à <w>peupler</w> cette région isolée.",
                            "target_lang_translations": {
                                "en": "The government encouraged families to <w>populate</w> this isolated region.",
                                "ru": "Правительство поощряло семьи <w>заселять</w> этот отдалённый регион.",
                                "de": "Die Regierung ermutigte Familien, diese abgelegene Region zu <w>besiedeln</w>.",
                                "es": "El gobierno animó a las familias a <w>poblar</w> esta región aislada.",
                                "zh": "政府鼓励各家庭<w>移居</w>到这个偏远地区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coloniser",
                        "habiter",
                        "occuper"
                    ],
                    "antonyms": [
                        "dépeupler"
                    ],
                    "common_phrases": [
                        "peupler un pays",
                        "peupler une région"
                    ],
                    "target_lang_definitions": {
                        "en": "To live in a place, or establish a population of people or animals there.",
                        "ru": "Жить в каком-либо месте или заселять его людьми или животными.",
                        "de": "Einen Ort bewohnen oder dort eine Bevölkerung aus Menschen oder Tieren ansiedeln.",
                        "es": "Vivir en un lugar o establecer en él una población de personas o animales.",
                        "zh": "在某地居住，或在该地建立人类或动物的群体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "populate",
                                "target_lang_sense_clarification": "stock a region with inhabitants"
                            },
                            {
