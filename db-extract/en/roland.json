                                "target_senses": [
                                    {
                                        "sense_id": "520d2624-788c-3ae4-9478-f2e710502786",
                                        "entry_id": "698aada4-140b-38ed-86a8-cedd3b93cdcc",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421fc34a-7d4b-4b43-b8bd-5c9c0b1a2b89",
                                                "sense_id": "520d2624-788c-3ae4-9478-f2e710502786",
                                                "text": "Roland leur distribua des champs à décaillouter, incitant certains à favoriser l’élevage des vaches et des moutons, grands dispensateurs de lait, de viande, de cuir et de laine."
                                            },
                                            {
                                                "example_id": "f2874060-2ca0-459b-9e52-b3db93182d83",
                                                "sense_id": "520d2624-788c-3ae4-9478-f2e710502786",
                                                "text": "« On tourne à 120 employés municipaux à l’année, qui travaillent dans la mairie, les établissements de santé… L’été, je suis obligé de prendre 40 saisonniers supplémentaires », explique le maire, Roland Tabart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Roland",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb1ccd6-1d3c-31b8-aacb-36cfa818da75",
                                        "entry_id": "8d6928d8-34ba-3cd1-9923-81921a3212d3",
                                        "glosses": [
                                            "Par métonymie, nom d’un tournoi de tennis créé en 1925 et qui se tient dans le stade Roland-Garros à Paris."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6770a5c1-c4e8-4ee1-8fcf-78e1246db47f",
                                                "sense_id": "bdb1ccd6-1d3c-31b8-aacb-36cfa818da75",
                                                "text": "La terre orange sombre de Roland vient à son heure, celle des enjeux, des révisions pour les examens, l’heure d’un presque été où les soirées s’allongent infiniment – on glissera vers un cinquième set à l’heure où les loges se vident, une poignée de spectateurs pourra se rassembler, se faire peur et espérer au centre des tribunes du Lenglen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Roland",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5ee6cb-ad1a-36d7-8a02-68c4891ac2a3",
                                        "entry_id": "02fdd050-c698-36a7-b0a4-3cd4dc16cfbb",
                                        "glosses": [
                                            "Nom de famille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "742da851-c962-41de-b8fd-9ecac5fb6091",
                                                "sense_id": "fc5ee6cb-ad1a-36d7-8a02-68c4891ac2a3",
                                                "text": "— Le langage du Père Duchesne... Ces ordures que, de sa cellule de l’Abbaye, Manon Roland entendait crier à son sujet. Et les crieurs en remettaient ! C'est impardonnable. Impardonnable. Je ne le pardonne pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
