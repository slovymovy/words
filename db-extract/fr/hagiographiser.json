                "senses": [
                    {
                        "sense_id": "de786d0a-a615-3f28-84f9-e0029288d41a",
                        "entry_id": "9ab1c861-e84a-37d1-96dd-fb699bf5891e",
                        "glosses": [
                            "Considérer avec un point de vue hagiographique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b24e67-9f68-4f7e-b7b0-4fa3643a9dd0",
                                "sense_id": "de786d0a-a615-3f28-84f9-e0029288d41a",
                                "text": "Faut-il ramener l’inconnu au connu, faut-il aligner l’élément libre à une catégorie, mais faut-il, si l’on porte aux pinacles, statufier, hagiographiser, et donc former un glacis uniforme à tout élément célébré ?"
                            },
                            {
                                "example_id": "20c75baa-d65b-47c5-8272-25998a7c1888",
                                "sense_id": "de786d0a-a615-3f28-84f9-e0029288d41a",
                                "text": "Pourquoi n’a-t-il pas tenu à simplifier davantage, à « hagiographiser » davantage ?"
                            }
                        ]
                    }
