                        "examples": [
                            {
                                "example_id": "b7171cf6-f725-4d01-87a9-5934d76ee39b",
                                "sense_id": "a2ec6747-ffd2-3c71-b191-66f04bf662a4",
                                "text": "Chez les espèces où les phénomènes de feuillaison et défeuillaison diffèrent sensiblement d’individu à individu, dans la même localité et sous les mêmes influences, on trouve quelquefois (tilleul) que les individus les plus hâtifs au printemps sont les plus tardifs, en automne."
                            },
                            {
                                "example_id": "49d19c5b-3e3f-4905-882c-69882448c3e3",
                                "sense_id": "a2ec6747-ffd2-3c71-b191-66f04bf662a4",
                                "text": "La défeuillaison de Faidherbia albida pendant la saison des pluies est la caractéristique la plus remarquable de cette espèce."
                            }
                        ]
                    }
