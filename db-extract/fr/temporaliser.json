                ],
                "senses": [
                    {
                        "sense_id": "d2eb19df-566e-3b8d-9c1f-0eb88e0b6387",
                        "entry_id": "94d30300-9d8a-3b95-a181-25084d4916ff",
                        "glosses": [
                            "Donner un caractère temporel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1517ea9f-8169-4831-ae88-5b3671c7a816",
                                "sense_id": "d2eb19df-566e-3b8d-9c1f-0eb88e0b6387",
                                "text": "Ce sont là des manières socialement spécifiques de spatialiser et de temporaliser relativement auxquelles il s’agit de se demander s’il existe en nous des ressources pouvant permettre que nous parvenions à nous en déprendre."
                            },
                            {
                                "example_id": "80f487e0-fec3-4721-bd66-3bc7389350d7",
                                "sense_id": "d2eb19df-566e-3b8d-9c1f-0eb88e0b6387",
                                "text": "D’abord, parce qu’on ne saurait temporaliser l'éternité, qui en aucun cas ni ne précède la durée, ni ne lui succède."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97d447b2-39ca-47a9-95b7-c0158733f653",
                        "source_entry_id": "94d30300-9d8a-3b95-a181-25084d4916ff",
                        "source_sense_id": "d2eb19df-566e-3b8d-9c1f-0eb88e0b6387",
                        "target_lang_word": "temporalise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temporalise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b77bdd1-2cf8-31ad-89fb-5319e6759619",
                                        "entry_id": "cb25a6bc-a57b-34f9-a2fb-92c07f19aa4d",
                                        "glosses": [
                                            "Alternative form of temporalize."
                                        ],
                                        "tags": [
                                            "alt-of",
