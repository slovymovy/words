                        "entry_id": "63dee930-791f-3c2c-86f2-7349076edc7d",
                        "glosses": [
                            "Spiegel an der linken oder rechten Seite eines Autos zur Beobachtung des Verkehrsgeschehens hinter dem eigenen Auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4487bcd5-ad29-4002-87f4-621b30e72c30",
                                "sense_id": "4e4a36bd-825b-3993-9ff8-bcb4b90b100f",
                                "text": "Bei dem Unfall wurde der rechte Seitenspiegel abgefahren."
                            },
                            {
                                "example_id": "b8da6339-8ff1-45fe-aa6e-b130d935403f",
                                "sense_id": "4e4a36bd-825b-3993-9ff8-bcb4b90b100f",
                                "text": "„Er legte den ersten Gang ein, schaute kurz in den Seitenspiegel und gab Vollgas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
