                        "examples": []
                    },
                    {
                        "sense_id": "db89b63f-9159-36bf-8e84-b3339069abfb",
                        "entry_id": "0f8ca960-daf5-32eb-a5cd-d4873818973c",
                        "glosses": [
                            "An amount of money paid by the government to a person trading in an old car (to be scrapped) for a more environmentally-friendly new one."
                        ],
                        "tags": [
                            "UK",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3a0e2209-b461-4941-8761-58bc574621a4",
                                "sense_id": "db89b63f-9159-36bf-8e84-b3339069abfb",
                                "text": "Motorists will receive £2,000 if they sell their old car and buy a new model, after the chancellor bowed to pressure from the automotive sector and announced a car scrappage scheme this afternoon."
                            },
                            {
                                "example_id": "3ac9dcf0-488f-442b-9365-5ba81f77b239",
                                "sense_id": "db89b63f-9159-36bf-8e84-b3339069abfb",
                                "text": "A London-wide Ultra Low Emissions Zone will be in operation from August 29 2023, supported by new bus services and a £110m car scrappage scheme for Londoners who are disabled and/or on low incomes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90cc615d-f0e4-400b-bcb6-ac39a219010f",
                        "source_entry_id": "0f8ca960-daf5-32eb-a5cd-d4873818973c",
                        "source_sense_description": "amount of money paid to trade in an old car",
                        "target_lang_word": "Abwrackprämie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwrackprämie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                                        "glosses": [
                                            "eine (meist staatliche) finanzielle Entschädigung, die für das Verschrotten eines Gegenstandes (in der Regel eines Fahrzeuges) geleistet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d8b617-96ea-4991-9178-60747679f1cf",
                                                "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                                                "text": "„Die Abwrackaktion, durch die Schifffahrtstreibende, die ihr Fahrzeug abwracken und aus dem Markt ausscheiden, eine Abwrackprämie erhalten, wurde […] durch eine Änderung des BSCHVG geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                                        "glosses": [
                                            "eine 2009 verfügbare staatliche Prämie („Umweltprämie“), die unter bestimmten Bedingungen für das Verschrotten eines Kraftfahrzeugs gezahlt wurde"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8246abeb-7ec9-482d-911e-520303fa9c92",
                                                "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                                                "text": "„Mit der Abwrackprämie wollte die Bundesregierung der Autoindustrie zu Hilfe eilen, indem sie die Nachfrage der Bürger nach neuen Fahrzeugen stimuliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
