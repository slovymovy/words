                        "translation_id": "7aa15e02-c8f3-41ed-a48f-333e9cfc070e",
                        "source_entry_id": "2df49b06-1bbe-341c-87c5-881acc65e24c",
                        "source_sense_id": "12828ba1-863a-375d-a8c7-5bed52d5eaa2",
