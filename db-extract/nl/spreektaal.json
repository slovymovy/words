                        "examples": [
                            {
                                "example_id": "59c0ab57-c7da-4e8b-89a6-55ca79076b97",
                                "sense_id": "519cea7c-7475-349e-9058-65998199f994",
                                "text": "Dat is geen officieel woord, maar wordt wel vaak in de spreektaal gebruikt."
                            }
                        ]
