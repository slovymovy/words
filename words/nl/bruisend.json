                    "sense_definition": "vol leven, energie en activiteit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "levendigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Amsterdam is de meest <w>bruisende</w> stad van Nederland voor jonge mensen.",
