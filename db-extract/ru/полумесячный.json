                ],
                "senses": [
                    {
                        "sense_id": "47c188f0-4e2c-3db7-90bd-0d816f5f02ba",
                        "entry_id": "78d6f468-423f-34b5-9837-299a8dd7e7e1",
                        "glosses": [
                            "продолжающийся в течение половины месяца, длящийся половину месяца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4f828f-4477-4d31-9edc-f43b3d16dad3",
                                "sense_id": "47c188f0-4e2c-3db7-90bd-0d816f5f02ba",
                                "text": "Позади остались нерестовые плесы и полумесячное путешествие по одной из крупнейших рек северо-востока страны."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bc267c6-660b-349c-bf8d-1ba8d73d6b52",
                        "entry_id": "78d6f468-423f-34b5-9837-299a8dd7e7e1",
                        "glosses": [
                            "рассчитанный на полмесяца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aebf794f-ea37-4a5c-a14b-058684782727",
                                "sense_id": "0bc267c6-660b-349c-bf8d-1ba8d73d6b52",
                                "text": "Он обещал завтра же выписать нам полный полумесячный красноармейский паек."
                            }
                        ]
                    },
                    {
                        "sense_id": "65e5ca60-e79f-37cb-a099-745d29e32868",
                        "entry_id": "78d6f468-423f-34b5-9837-299a8dd7e7e1",
                        "glosses": [
                            "происходящий, бывающий каждые полмесяца"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9466cd24-e987-32ab-b7ac-a8c8217e55f9",
                        "entry_id": "78d6f468-423f-34b5-9837-299a8dd7e7e1",
                        "glosses": [
                            "причитающийся за половину месяца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48dd720-a510-42a5-a5f8-435ed1d52218",
                                "sense_id": "9466cd24-e987-32ab-b7ac-a8c8217e55f9",
                                "text": "Однако пятнадцатого числа артельщик-плательщик вручил Заузе полумесячное жалованье."
                            }
                        ]
                    }
