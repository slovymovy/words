                        "examples": [
                            {
                                "example_id": "ad58f45c-e6e6-4943-bc2f-626f3ce65faf",
                                "sense_id": "b8e89dca-7f93-3e4e-90b0-40717e4e066d",
                                "text": "[…] A break from the routine of mundanity made the 40-year-old from Sivakasi revisit a childhood memory revolving a squeaker that was gifted to him by a relative. He recalls looking after the bird for a few years until he couldn’t do it anymore. The recollection set free the joy in the aviary of his heart after three decades and he settled on rearing his feathered friends thereafter."
                            }
