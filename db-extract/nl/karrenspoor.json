                "senses": [
                    {
                        "sense_id": "506af4b3-849e-31dd-8ff8-f66eb25d3b97",
                        "entry_id": "438aaccd-d688-3de0-83cf-4703d403c011",
                        "glosses": [
                            "een (onverharde)weg met 2 sporen zodat er voor ieder wiel een apart spoor is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704be0ff-9f93-4176-acd4-21b41bcf528a",
                                "sense_id": "506af4b3-849e-31dd-8ff8-f66eb25d3b97",
                                "text": "Van Dis kan bloemrijk vertellen over de jaren vijftig in zijn dorp aan zee. Over mevrouw Van Reenen-Völter, die samen met haar man in 1905 Bergen aan Zee als het ware heeft gesticht door een karrenspoor aan te leggen naar het strand."
                            }
                        ]
                    },
                    {
                        "sense_id": "13ef99b9-ff16-3203-87bc-1e72c083b250",
                        "entry_id": "438aaccd-d688-3de0-83cf-4703d403c011",
                        "glosses": [
                            "een te smalle weg voor de hoeveelheid verkeer die gebruik maakt van de weg"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c57f496c-0797-4492-a75a-c168e209f3dc",
                                "sense_id": "13ef99b9-ff16-3203-87bc-1e72c083b250",
                                "text": "De gemeente Almelo, maar ook de stichting Dorpsbelangen Bornerbroek en de ondernemersvereniging De Doorbraak Bornerbroek zitten niet te wachten op een ‘karrenspoor’ tussen Bornerbroek en Delden."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9b085e7-2acf-3fcb-9926-92a221da62d0",
                        "entry_id": "438aaccd-d688-3de0-83cf-4703d403c011",
                        "glosses": [
                            "een rustige 'weg' waarop je niet snel kunt rijden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f1762b2c-c773-432f-b7a9-d248146b8a61",
                                "sense_id": "b9b085e7-2acf-3fcb-9926-92a221da62d0",
                                "text": "Ergens tussen de luie woestijnmuziek van J.J. Cale en de rafelige indiepop van Kurt Vile ligt het spoor dat Cass McCombs trekt door het Amerikaanse poplandschap. Het is eerder een karrenspoor dan een autoweg, want McCombs heeft nooit haast en zijn muziek is van een weldadige loomheid."
                            }
                        ]
                    }
                ],
