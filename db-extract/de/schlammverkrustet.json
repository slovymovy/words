                "senses": [
                    {
                        "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                        "entry_id": "cc1efcd0-e010-3458-b0d8-68a6f7c693a6",
                        "glosses": [
                            "mit Schlamm verkrustet, von getrocknetem Schlamm bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd19dc7-a020-4def-938b-3192defdd07f",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Inmitten des Lichtkreises befand sich ein kreisrunder Schacht, über dessen schlammverkrustete Umfassung sich Risse zogen.“"
                            },
                            {
                                "example_id": "00ba920a-cbb3-45bf-8444-28faa6ac520f",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Die meisten Sachen waren uralte Fischereiutensilien, schlammverkrustet und bedeckt mit Rückständen von Fischtran.“"
                            },
                            {
                                "example_id": "cc5b5097-e762-4239-8582-d30b1c4c5625",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Sie weiß, dass er meist in den frühen Morgenstunden von der Arbeit kommt, manchmal mit Sand im Haar und schlammverkrusteten Stiefeln.“"
                            },
                            {
                                "example_id": "fb198194-c5ce-4e0f-b434-842ac73f62ee",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Sein Gewand war schmutzig von der Reise und seine europäischen Stiefel schlammverkrustet.“"
                            },
                            {
                                "example_id": "dfa3f9e8-bff8-44aa-91ca-3671d7ea13eb",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Dann breitete er die Plastikplane auf dem Boden aus, holte Jacken und Decken aus dem Wagen, zog sich und dem Jungen die feuchten, schlammverkrusteten Schuhe aus, und dann saßen sie da, die Hände zu den Flammen hingestreckt.“"
                            },
                            {
                                "example_id": "25df7a8e-8183-4ebc-9581-a50ae4fff61d",
                                "sense_id": "2afb1838-f8a8-3a0f-9acf-8f33027f7ef7",
                                "text": "„Der Regen tropfte von der Kapuze seines Regenmantels auf seine schlammverkrusteten Schuhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
