                    "frequency": "Middle",
                    "semantic_group_id": "desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a lu plusieurs ouvrages pour tenter de <w>rassasier</w> sa curiosité grandissante."
                        },
                        {
                            "text": "Rien ne semblait pouvoir <w>rassasier</w> sa soif insatiable de gloire."
