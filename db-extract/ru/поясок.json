                            {
                                "example_id": "11794082-ade2-4672-9da9-07bd8857977c",
                                "sense_id": "eb254376-8082-36cb-896b-4cf959c911a8",
                                "text": "Татьяна поясок шелко́вый // Сняла, разделась и в постель // Легла."
                            },
                            {
                                "example_id": "2989e3bf-bcec-4503-9f49-e3183d30dece",
                                "sense_id": "eb254376-8082-36cb-896b-4cf959c911a8",
                                "text": "Засаленный верёвочный поясок сполз с живота на бёдра, а рубаху так и тянет вверх к лопаткам."
                            }
                        ]
