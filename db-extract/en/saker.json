                    {
                        "sense_id": "bf9f5a4b-ae99-31fd-9273-aec8f61a7121",
                        "entry_id": "fd46a1fe-0e83-3c13-8261-295f2dcacd09",
                        "glosses": [
                            "A falcon (Falco cherrug) native of Southern Europe and Asia."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b9a0a06-30c5-36a9-ad36-77c8745e1e50",
                        "entry_id": "fd46a1fe-0e83-3c13-8261-295f2dcacd09",
                        "glosses": [
                            "A medium cannon slightly smaller than a culverin developed during the early 17th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db43dba-966b-422e-a146-a6b42efa38c2",
                                "sense_id": "5b9a0a06-30c5-36a9-ad36-77c8745e1e50",
                                "text": "This place of strength vvas furnished of sixe great peeces, demi-Culuerins, and Sakers, vvhich shot directlie in front vpon vs as vve approched."
                            },
                            {
                                "example_id": "f278e67d-3095-4647-b7e5-b6ac43db582d",
                                "sense_id": "5b9a0a06-30c5-36a9-ad36-77c8745e1e50",
                                "text": "Let Sacars, Culuerings, and Cannons ſound / In honour of their bones, and rock the ground / With all your deafning terrors: for behold / The Balſum for your wounds, are rich mens gold, / Powder the world with wonder, and thus crie, / The Camel now may paſſe the needles eie."
                            },
                            {
                                "example_id": "ac96b64e-159a-4b98-bd0f-3e9d202e023e",
                                "sense_id": "5b9a0a06-30c5-36a9-ad36-77c8745e1e50",
                                "text": "Of warlike engines he was author, / Devised for quick despatch of slaughter: / The cannon, blunderbuss, and saker, / He was th' inventor of, and maker: […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "247c38e6-30b8-4b33-8277-31d7a05724ad",
                        "source_entry_id": "fd46a1fe-0e83-3c13-8261-295f2dcacd09",
                        "source_sense_description": "falcon",
                        "target_lang_word": "faucon sacre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faucon sacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78a987ae-5358-33e3-90ab-8e8f3741cbc4",
                                        "entry_id": "3223ceb7-e1ba-3a01-8d30-b133aaca9962",
                                        "glosses": [
                                            "Espèce d'oiseau de proies rapace diurne (falconiforme) de la famille des falconidés, un grand faucon de l'Ancien Monde aux parties supérieures brunes, la tête et les parties ventrales brun pâle, traditionnellement utilisé en fauconnerie, dans les pays arabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3daa127d-cb21-4acd-bb15-b593ec3d6b80",
                                                "sense_id": "78a987ae-5358-33e3-90ab-8e8f3741cbc4",
                                                "text": "Le faucon sacre est l'un des deux oiseaux de proie de la fauconnerie de la base militaire de Bagotville."
                                            },
                                            {
                                                "example_id": "5fb6995f-33c9-4700-a9ca-f040e405f2c3",
                                                "sense_id": "78a987ae-5358-33e3-90ab-8e8f3741cbc4",
                                                "text": "Le faucon sacre est un grand faucon dont l’aire de répartition s’étend de l’Asie centrale au nord de l’Inde, à l’Europe orientale et à l’Italie, à la Tunisie, à l’Arabie et jusqu’à l’Éthiopie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
