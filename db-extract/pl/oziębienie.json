                                        "glosses": [
                                            "Abschwächung eines emotionalen Zustandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65a971a-8bfd-4d1a-95af-1808461256e4",
                                                "sense_id": "6ab5cc10-09e3-37a1-80d5-ad3b36c68d5a",
