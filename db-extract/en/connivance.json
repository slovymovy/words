    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dc2b3200-4c36-3218-b139-4ab717ccaa1f",
                "word": "connivance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "258bf0fe-9f7f-46ac-a74f-910dbc47c942",
                        "entry_id": "dc2b3200-4c36-3218-b139-4ab717ccaa1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "connivances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d005aebf-0a08-3bd3-ad78-bd264d8660a1",
                        "entry_id": "dc2b3200-4c36-3218-b139-4ab717ccaa1f",
                        "glosses": [
                            "The process of conniving or conspiring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d83d5bb-6d04-425e-a643-82b3174413d0",
                                "sense_id": "d005aebf-0a08-3bd3-ad78-bd264d8660a1",
                                "text": "The Abbot’s house, which formed the third side of the square, was, though injured, still inhabited, and afforded refuge to the few brethren who yet, rather by connivance than by actual authority, were permitted to remain at Kennaquhair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "385c9680-a1e7-468c-aa4a-c6bc961d274c",
                        "source_entry_id": "dc2b3200-4c36-3218-b139-4ab717ccaa1f",
                        "source_sense_id": "d005aebf-0a08-3bd3-ad78-bd264d8660a1",
                        "source_sense_description": "(law) the process of conniving or conspiring",
                        "target_lang_word": "connivence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connivence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e323ce43-c509-32c0-9091-f79a256848b8",
                                        "entry_id": "b94be377-4c13-3ea0-b4b4-f2eaa3681123",
                                        "glosses": [
                                            "Complicité par tolérance et dissimulation d’un mal qu’on doit ou qu’on peut empêcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f85236-77f5-4c57-9a26-e234a9b5b0e5",
                                                "sense_id": "e323ce43-c509-32c0-9091-f79a256848b8",
                                                "text": "Plus la lutte contre les schismatiques s’aggrave, plus l’Église s’acharne contre les juifs, qu’elle soupçonne d’être de connivence avec les hérétiques."
                                            },
                                            {
                                                "example_id": "42229fb1-a720-43bd-97b4-78117d6dd3b4",
                                                "sense_id": "e323ce43-c509-32c0-9091-f79a256848b8",
                                                "text": "C’est vrai qu’il [Napoléon Bonaparte] a eu une légende. C’est vrai qu’il y avait le chauvinisme qui se satisfaisait, en pensant à toute la gloire que la France avait conquise… C’est vrai aussi que cette légende s’appuyait sur de sombres profondeurs humaines, avec cette connivence qui est en nous à l’égard de la guerre et de la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                        "entry_id": "b94be377-4c13-3ea0-b4b4-f2eaa3681123",
                                        "glosses": [
                                            "Entente secrète ou tacite, intelligence avec quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d749d93c-ad00-4ed9-8870-49f4d140886e",
                                                "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                                "text": "Il se douta que la mère et la fille étaient de connivence, mais comme il n’aimait point les querelles de ménage, il ne souffla mot et sortit pour dissiper sa colère."
                                            },
                                            {
                                                "example_id": "df0b2b46-750c-4710-b30b-d2ac16e608ed",
                                                "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                                "text": "Elle m’adressa avec les sourcils, les paupières clignées, la bouche avancée, un langage de complicité que je n’espérais pas et qui m’enchanta. Je la vis destinée à la dissimulation, la connivence défendue, enfin le péché."
                                            },
                                            {
                                                "example_id": "f271b643-a467-420c-b765-c12d2c715202",
                                                "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                                "text": "Il disparaissait dans le salon, et j’avais surpris un geste de connivence qu’il faisait à l’intention du notaire, et ce geste – mais peut-être avais-je l’esprit mal intentionné – voulait dire :\n— Essaie de le persuader."
                                            },
                                            {
                                                "example_id": "783e9f1f-bc24-4490-9b4c-2552ebe2f9bf",
                                                "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                                "text": "Les souvenirs brûlent rarement si longtemps à moins qu’il n’y ait eu entre deux êtres connivence charnelle."
                                            },
                                            {
                                                "example_id": "929f66b5-2855-4ae6-b8e8-298cc653f7ad",
                                                "sense_id": "1deeb905-d82b-3759-848a-dd68206ffa69",
                                                "text": "Cette séance fut donc la dernière à rendre compte de cette intime connivence entre Monk et Rollins ; on ne peut s’empêcher de regretter qu’ils n’aient pas plus souvent associé leur destin sur disque ; mais c’est comme ça, alors on imagine…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
