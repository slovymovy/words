                "senses": [
                    {
                        "sense_id": "0cc573e3-b1b3-3db6-8523-78ae1f483c4d",
                        "entry_id": "06d3897c-3701-3656-bea8-cfac61d0e2aa",
                        "glosses": [
                            "(Vendée) Touffes d’arbres, bosquets."
                        ],
                        "tags": [
                            "Régionalisme",
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "c49ee673-1458-4b06-b9a1-5e12d0e89984",
                                "sense_id": "0cc573e3-b1b3-3db6-8523-78ae1f483c4d",
                                "text": "Cherchez à vous rappeler, mon cher oncle, une de ces vieilles truisses de chêne, dont le tronc noueux, ébranché de la veille, s’élève fantastiquement sur un chemin désert, et vous aurez une image vraie de cet homme."
                            },
                            {
                                "example_id": "0243cc62-163b-43c8-9385-8b8fed2e05a2",
                                "sense_id": "0cc573e3-b1b3-3db6-8523-78ae1f483c4d",
                                "text": "Son bois de chauffage était coupé dans ses haies ou pris dans les vieilles truisses à moitié pourries qu’il enlevait au bord de ses champs."
                            },
                            {
                                "example_id": "c52c4775-463f-48a5-9a62-087a6e2f33dd",
                                "sense_id": "0cc573e3-b1b3-3db6-8523-78ae1f483c4d",
                                "text": "Il fallait connaître le Chouan pour le distinguer au milieu de cette assemblée de truisses ébranchées parmi lesquelles la sienne se confondait si facilement"
                            }
                        ]
                    }
                ],
                "translations": [
