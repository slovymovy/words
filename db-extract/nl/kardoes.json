                "translations": [
                    {
                        "translation_id": "e82f00fc-fc14-4d21-a13f-362e4a334fd2",
                        "source_entry_id": "ac190f72-ebba-344d-a854-83f526dbb176",
                        "source_sense_id": "c716e26d-a908-3fa6-8042-65399fe99f0c",
                        "source_sense_description": "patroonhuls",
                        "target_lang_word": "cartridge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cartridge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b60a6cad-659a-302d-ae88-63006b67716b",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "The package consisting of the bullet, primer, and casing containing gunpowder; a round of ammunition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962fac6b-c0cd-4c7a-bef6-450431427cac",
                                                "sense_id": "b60a6cad-659a-302d-ae88-63006b67716b",
                                                "text": "Still, a dozen men with rifles, and cartridges to match, stayed behind when they filed through a white aldea lying silent amid the cane, and the Sin Verguenza swung into slightly quicker stride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64b637f-7d25-3e2a-8345-f3e9d331c19b",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "A prefabricated subassembly that can be easily installed in or removed from a larger mechanism or replaced with another interchangeable subassembly."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2fa120f-b9c5-31a1-abca-a26d7ce7e294",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "A vessel which contains the ink or toner for a computer printer and can be easily replaced with another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46b24973-967f-36ee-9e9e-cea6c98d0dd6",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "Magnetic tape storage, used for storing (backup) copies of data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d902fd6-eaaf-4b11-a90d-adcd7e433ebf",
                                                "sense_id": "46b24973-967f-36ee-9e9e-cea6c98d0dd6",
                                                "text": "The program generates a catalogue of the files on the cartridge selected by the user, reads the catalogue into memory and erases the cartridge copy, so that an up-to-date copy is always generated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ab7161-316b-39d7-921d-cc2ac15c8299",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "A removable enclosure containing read-only memory devices, used for rapid loading of software onto a home computer or video game console."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2bfbeda-f5f4-4aa5-9256-d44076ebf2d7",
                                                "sense_id": "41ab7161-316b-39d7-921d-cc2ac15c8299",
                                                "text": "We would like to see someone market a low-power, text-to-speech cartridge that would mate with the Epson and use its internal battery pack."
                                            },
                                            {
                                                "example_id": "e02af85a-a1da-4675-8218-bc97f2e797a3",
                                                "sense_id": "41ab7161-316b-39d7-921d-cc2ac15c8299",
                                                "text": "Nintendo made sure to loudly trumpet all of the advantages of the cartridge format, particularly the greatly reduced loading times and the sturdiness of the cartridges[…]"
                                            },
                                            {
                                                "example_id": "1b14130f-0ccf-4555-a5f2-d3b368043b02",
                                                "sense_id": "41ab7161-316b-39d7-921d-cc2ac15c8299",
                                                "text": "Not as good, though, as the PolyStation. Looks like a first-generation PlayStation in a Nitendo 64 box. And even though that bit on top looks like it should take a disc, it actually uses something like a Super Nintendo cartridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d874e4eb-b9ec-33e2-9f85-b1cca1903abb",
                                        "entry_id": "84ae9470-aba0-32a7-b468-bac8b9a24b66",
                                        "glosses": [
                                            "A small paper package, e.g. in an old book about making printer's type: After all the type has been cast: \\\"The Boy will paper up each sort in a cartridge by itself\\\"."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
