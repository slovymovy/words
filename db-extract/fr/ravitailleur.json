                        "entry_id": "a677ea14-d2ca-343e-a188-44c5dc4ad45d",
                        "glosses": [
                            "Celui qui assure le ravitaillement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304b491c-bd0e-4f07-9984-8c909209f843",
                                "sense_id": "ca6550d8-4c16-357d-a29f-1634265c04e8",
                                "text": "Comme je l’ai su plus tard, c’était le comptable de l’aubergiste, qui, lui, était le ravitailleur du maquis voisin."
                            }
                        ]
                    },
                    {
                        "sense_id": "512cf125-e38b-37d3-a2bc-13ba0b025b1b",
                        "entry_id": "a677ea14-d2ca-343e-a188-44c5dc4ad45d",
                        "glosses": [
                            "Cargo chargé du ravitaillement d’un autre navire."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "99ac04e7-99ab-3fa2-aa1c-f4d5e3a5d8e0",
                        "entry_id": "a677ea14-d2ca-343e-a188-44c5dc4ad45d",
                        "glosses": [
                            "Fournisseur de drogue, de stupéfiants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2f2e5d-f77c-4501-bd82-ff33b707a33b",
                                "sense_id": "99ac04e7-99ab-3fa2-aa1c-f4d5e3a5d8e0",
                                "text": "Gonzague avait déjà eu de la chance qu’on n’ait pratiquement rien saisi : ce qui lui a permis d’être poursuivi comme ravitaillé et non comme ravitailleur."
                            }
                        ]
                    }
