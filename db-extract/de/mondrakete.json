                        "examples": [
                            {
                                "example_id": "e4f2cc43-1634-44c2-9249-216b570e8de5",
                                "sense_id": "3f3fc227-ff98-3b4b-ac47-f628111d3869",
                                "text": "„Die neue NASA-Mondrakete hat ihren ersten Test in der Wüste von Utah ohne Probleme absolviert.“"
                            },
                            {
                                "example_id": "ea24fcd7-3dd3-4ac4-92b6-d8a242876c60",
                                "sense_id": "3f3fc227-ff98-3b4b-ac47-f628111d3869",
                                "text": "„Elon Musk geht mit seinem Raumfahrtunternehmen SpaceX wieder einmal eigene Wege. Er hat in Texas eine etwa 40 Meter hohe Versuchsrakete montiert, die vom Design frappierend an die Mondrakete aus dem Comic-Album „Tim und Struppi – Reiseziel Mond“ erinnert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
