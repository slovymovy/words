                    "frequency": "Middle",
                    "semantic_group_id": "aantasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aanhoudende droogte heeft de oogst dit jaar zwaar <w>aangetast</w>.",
                            "target_lang_translations": {
