                ],
                "senses": [
                    {
                        "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                        "entry_id": "23e7fa5b-b900-3019-9169-80afdeca6f26",
                        "glosses": [
                            "Aussage (eines Ange- oder Beklagten)"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "47a71761-70dc-4c1f-99a0-546ab7f9405b",
                                "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                                "text": "„Die Einlassung des Angeklagten ist auch kein Beweismittel, wie etwa die Aussage eines Zeugen; es findet also keine Beweiswürdigung statt wie bei einer Zeugenaussage.“"
                            },
                            {
                                "example_id": "057ffbc9-f692-4443-9de7-a22ed8ed3aa7",
                                "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                                "text": "„Im bezirksgerichtlichen Mahnverfahren ist der schriftliche Einspruch der beklagten Partei gegen den Zahlungsbefehl, selbst wenn er bereits ein Sachgegenvorbringen enthält, noch keine Streiteinlassung im Sinne des § 104 Abs 3 JN und auch keine rügelose Einlassung nach Art 18 LGVÜ.“"
                            },
                            {
                                "example_id": "6eb94a8d-d042-49ca-8230-d9826912eac3",
                                "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                                "text": "„Die Einlassungen Ecos in jenen Mailänder Sitzungen waren jedes Mal richtiggehende Theateraufführungen: Er traf stets atemlos ein, verspätet, er war eben dem Flugzeug entstiegen, das ihn von San Francisco nach Mailand gebracht hatte.“"
                            },
                            {
                                "example_id": "0b942cd7-43d1-4dc0-8fcf-365de91cf1a0",
                                "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                                "text": "„Das wiederum war keine Neuigkeit, denn schon zuvor hatte die türkische Seite den Regierungssprecher Steffen Seibert für seine Einlassung zur Armenien-Resolution ebenso prompt wie ungeniert belobigt.“"
                            },
                            {
                                "example_id": "8a27de00-7391-49d9-9e1a-82b7eb8aeaf2",
                                "sense_id": "4a27fe46-2488-30c4-b7ac-0e18e3747116",
                                "text": "„Dass er zu dieser Erkenntnis satte 16 Jahre brauchte, macht seine Einlassung nicht gerade überzeugender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
