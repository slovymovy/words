                "entry_id": "46556443-0c47-3966-aa67-a9035208a2d1",
                "word": "Bätz",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                        "entry_id": "46556443-0c47-3966-aa67-a9035208a2d1",
                        "glosses": [
                            "breiige Masse; Schlamm"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "c3916757-c589-489e-8308-2f2737752870",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Meine Gummistiefel sind voller Bätz."
                            },
                            {
                                "example_id": "28190ec7-3b9f-4eeb-9d32-7a6c3dcb5698",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Wisch dem Kind den Bätz vom Mund ab."
                            },
                            {
                                "example_id": "45b9f089-3c02-4ee3-9f6a-9884702305fb",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Voller Dreck und Baz kam sie heim, stolz 4 Kohlrabi in der Hand"
                            },
                            {
                                "example_id": "db8d8992-18cc-484a-982f-73fae1744764",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Der Alte sticht sofort zwei Schaufeln Baaz vom Karren herunter und wirft sie zurück in die Mörtelwanne."
                            },
                            {
                                "example_id": "4bea2c2e-9a87-44f9-abe4-e9e485154e25",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Gottzumgruß sagt der Kerl, mierda del Grandio, steh, vetlo, und gleich wieder abasso, in den Baz mit dir, nel buio, c’est bon."
                            },
                            {
                                "example_id": "9ea36347-9191-44a9-ac1d-142d4a3e02c9",
                                "sense_id": "6249938d-ffa6-301b-a649-d5a47810380d",
                                "text": "Der Maurer rührte den Gips mit Wasser zu einem Baz zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
