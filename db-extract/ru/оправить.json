                "senses": [
                    {
                        "sense_id": "15e51806-7765-3b33-a04d-df95f46d09a9",
                        "entry_id": "0527a9d2-8e43-33f7-adef-75aef6217b76",
                        "glosses": [
                            "привести в надлежащий вид, в порядок, поправить (что-нибудь надетое, какой-нибудь предмет туалета, убора)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a07b5d51-4a2d-4033-80f1-008bc27d9cab",
                                "sense_id": "15e51806-7765-3b33-a04d-df95f46d09a9",
                                "text": "Оправить платье перед зеркалом. Не выходя из строя, оправить одежду и снаряжение. Оправить шашку."
                            },
                            {
                                "example_id": "9a0d4d16-9c57-45c7-8aa3-6b22f106f579",
                                "sense_id": "15e51806-7765-3b33-a04d-df95f46d09a9",
                                "text": "Она встала, оправила прическу."
                            }
                        ]
                    },
                    {
                        "sense_id": "293a6148-fb73-3aae-9e50-ce2695ceae66",
                        "entry_id": "0527a9d2-8e43-33f7-adef-75aef6217b76",
                        "glosses": [
                            "вставить в оправу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f525561-0b08-4b43-89dd-ed22bb93fa63",
                                "sense_id": "293a6148-fb73-3aae-9e50-ce2695ceae66",
                                "text": "Оправить медальон."
                            }
                        ]
                    },
                    {
                        "sense_id": "31afc330-f8d8-3060-bef6-aced6c3d30b1",
                        "entry_id": "0527a9d2-8e43-33f7-adef-75aef6217b76",
                        "glosses": [
                            "устар. прост. то же, что оправдать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589092c7-2ce9-42ef-b3d6-3a57428ef30e",
                                "sense_id": "31afc330-f8d8-3060-bef6-aced6c3d30b1",
                                "text": "В те поры вон убийцу оправили."
                            }
                        ]
                    }
