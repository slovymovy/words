                "senses": [
                    {
                        "sense_id": "d72f70e2-fad9-376e-a76d-723f6fb64570",
                        "entry_id": "b81bb79a-1005-3923-acc4-7b3512171c36",
                        "glosses": [
                            "Relatif à l’estomac ou au duodénum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f35a48-882d-4bc5-93a7-ba6ade91fae0",
                                "sense_id": "d72f70e2-fad9-376e-a76d-723f6fb64570",
                                "text": "Le traitement hygiéno-diététique de l’ulcère gastroduodénal a été balayé par le traitement pharmacologique."
                            },
                            {
                                "example_id": "efbe8b6b-71c3-4a8a-a033-0e329196cee4",
                                "sense_id": "d72f70e2-fad9-376e-a76d-723f6fb64570",
                                "text": "Les ulcères gastroduodénaux affectent l’estomac ou le duodénum et peuvent survenir à tout âge, y compris pendant la petite enfance et l’enfance."
                            },
                            {
                                "example_id": "366d0bbe-ce46-4ead-9ddb-be7c411c9533",
                                "sense_id": "d72f70e2-fad9-376e-a76d-723f6fb64570",
                                "text": "Le diagnostic de l’ulcère est effectué grâce à la fibroscopie gastroduodénale."
                            }
                        ]
                    }
