            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66ed352f-f25d-3bab-922e-ac4c68573256",
                    "sense_definition": "het overnemen van een ambt, functie of positie van iemand anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "successie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning maakte zich grote zorgen over de <w>opvolging</w> van de troon.",
                            "target_lang_translations": {
                                "fr": "Le roi s'inquiétait beaucoup pour la <w>succession</w> au trône."
                            }
                        },
                        {
                            "text": "Het familiebedrijf heeft de zakelijke <w>opvolging</w> al jaren van tevoren geregeld.",
                            "target_lang_translations": {
                                "fr": "L'entreprise familiale a réglé la <w>succession</w> commerciale des années à l'avance."
                            }
                        }
                    ],
                    "synonyms": [
                        "successie"
                    ],
                    "common_phrases": [
                        "koninklijke opvolging",
                        "opvolging van de troon"
                    ],
                    "target_lang_definitions": {
                        "fr": "Action de reprendre une fonction, une charge ou une position après quelqu'un d'autre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "succession",
                                "target_lang_sense_clarification": "fait de succéder à un poste, trône ou fonction"
                            },
                            {
                                "target_lang_word": "relève",
                                "target_lang_sense_clarification": "remplacement d'une équipe ou d'un dirigeant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a12bc452-d633-3c58-bc50-19b3c67a9cb8",
                    "sense_definition": "het gehoor geven aan of naleven van een advies, bevel of richtlijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een goede <w>opvolging</w> van de veiligheidsregels voorkomt ernstige ongelukken op de werkvloer.",
                            "target_lang_translations": {
                                "fr": "Un bon <w>respect</w> des règles de sécurité évite des accidents graves sur le lieu de travail."
                            }
                        },
                        {
                            "text": "De arts benadrukte dat stipte <w>opvolging</w> van zijn advies noodzakelijk was voor herstel.",
                            "target_lang_translations": {
                                "fr": "Le médecin a insisté sur le fait qu'une stricte <w>observation</w> de ses conseils était nécessaire pour la guérison."
                            }
                        }
                    ],
                    "synonyms": [
                        "naleving"
                    ],
                    "common_phrases": [
                        "opvolging van advies"
                    ],
                    "target_lang_definitions": {
                        "fr": "Action d'obéir à un conseil, un ordre ou une directive, ou de les mettre en pratique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "respect",
                                "target_lang_sense_clarification": "d'une règle, d'une consigne"
                            },
                            {
                                "target_lang_word": "observation",
                                "target_lang_sense_clarification": "d'une consigne ou prescription"
                            },
                            {
                                "target_lang_word": "suivi",
                                "target_lang_sense_clarification": "prise en compte d'une recommandation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
