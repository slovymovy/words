                                                "sense_id": "ea448a28-724d-390b-a144-cbc226db2591",
                                                "text": "W sieni panowała ciemność."
                                            },
                                            {
                                                "example_id": "03f36f43-cf61-4727-bdc9-40b4cdf4ee5b",
                                                "sense_id": "ea448a28-724d-390b-a144-cbc226db2591",
                                                "text": "Boję się ciemności, dlatego zawsze mam przy sobie latarkę."
                                            },
