{
    "word_family": [
        "allot",
        "allotment",
        "lottery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9c593bc-641e-3a0b-8cdf-44a93f2c7ff2",
                    "sense_definition": "A large number, amount, or quantity of people or things.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>lot</w> of friends in the city.",
                            "target_lang_translations": {
                                "ru": "У неё <w>много</w> друзей в городе.",
                                "zh": "她在城里有<w>很多</w>朋友。"
                            }
                        },
                        {
                            "text": "There is a <w>lot</w> of work to be done today.",
                            "target_lang_translations": {
                                "ru": "Сегодня нужно сделать <w>кучу</w> работы.",
                                "zh": "今天有<w>大量</w>的工作要做。"
                            }
                        },
                        {
                            "text": "Thanks a <w>lot</w> for your help.",
                            "target_lang_translations": {
                                "ru": "<w>Большое</w> спасибо за помощь.",
                                "zh": "<w>非常</w>感谢你的帮助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "load",
                        "heap",
                        "pile",
                        "mass",
                        "ton",
                        "abundance",
                        "great deal",
                        "mountain",
                        "slew",
                        "many",
                        "much"
                    ],
                    "antonyms": [
                        "modicum"
                    ],
                    "common_phrases": [
                        "a lot of",
                        "lots of",
                        "a whole lot",
                        "thanks a lot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество людей или вещей.",
                        "zh": "指大量的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "много",
                                "target_lang_sense_clarification": "наречие, обозначающее большое количество"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разговорное: большое количество чего-либо"
                            },
                            {
                                "target_lang_word": "масса",
                                "target_lang_sense_clarification": "множество, большое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很多",
                                "target_lang_sense_clarification": "表示数量多"
                            },
                            {
                                "target_lang_word": "大量",
                                "target_lang_sense_clarification": "表示数量巨大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e5256e7-69ba-3a58-b533-f227bb61063b",
                    "sense_definition": "A distinct piece of land, often used for a specific purpose like building or parking.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "land_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We parked the car in the empty <w>lot</w>.",
                            "target_lang_translations": {
                                "ru": "Мы припарковали машину на пустой <w>площадке</w>.",
                                "zh": "我们把车停在了那块空<w>场地</w>上。"
                            }
                        },
                        {
                            "text": "They bought a <w>lot</w> to build a new house.",
                            "target_lang_translations": {
                                "ru": "Они купили <w>участок</w>, чтобы построить новый дом.",
                                "zh": "他们买了一块<w>地块</w>来盖新房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "parcel",
                        "site"
                    ],
                    "common_phrases": [
                        "parking lot",
                        "vacant lot",
                        "building lot"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный участок земли, часто используемый для строительства или парковки.",
                        "zh": "一块独立的土地，常用于特定用途，如建筑或停车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "кусок земли"
                            },
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "ровное место, специально оборудованное для чего-либо (например, парковки)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地块",
                                "target_lang_sense_clarification": "指一块土地"
                            },
                            {
                                "target_lang_word": "场地",
                                "target_lang_sense_clarification": "指用于特定活动的空地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee97d59-6988-3f52-952d-0533a5ec76be",
                    "sense_definition": "The whole quantity or number of things or people; everything.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of the <w>lot</w> of you.",
                            "target_lang_translations": {
                                "ru": "Я устал от <w>всех</w> вас.",
                                "zh": "我受够了你们<w>全部</w>人。"
                            }
                        },
                        {
                            "text": "He was hungry and ate the <w>lot</w>.",
                            "target_lang_translations": {
                                "ru": "Он был голоден и съел <w>всё</w>.",
                                "zh": "他饿了，把<w>全部</w>都吃了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collection",
                        "group",
                        "set",
                        "everything",
                        "whole"
                    ],
                    "common_phrases": [
                        "the lot",
                        "the whole lot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вся совокупность вещей или людей; всё вместе.",
                        "zh": "全部的数量或总和；所有事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё",
                                "target_lang_sense_clarification": "полный объем или количество"
                            },
                            {
                                "target_lang_word": "все",
                                "target_lang_sense_clarification": "о людях: все присутствующие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全部",
                                "target_lang_sense_clarification": "指整体或所有部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c57698fa-08c0-3dd3-9d7c-5b907a96650d",
                    "sense_definition": "A specific group of people, often considered together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You <w>lot</w> need to hurry up.",
                            "target_lang_translations": {
                                "ru": "Эй вы, <w>народ</w>, вам нужно поторопиться.",
                                "zh": "你们<w>一伙</w>人得快点。"
                            }
                        },
                        {
                            "text": "Stay away from that bad <w>lot</w>.",
                            "target_lang_translations": {
                                "ru": "Держись подальше от этой дурной <w>компании</w>.",
                                "zh": "离那<w>一伙</w>坏人远点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd",
                        "gang",
                        "group"
                    ],
                    "common_phrases": [
                        "you lot",
                        "bad lot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная группа людей, часто рассматриваемая как единое целое.",
                        "zh": "特定的一群人，常被视为一个整体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "группа людей, проводящих время вместе"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "совокупность людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一伙",
                                "target_lang_sense_clarification": "指一群人，常含贬义"
                            },
                            {
                                "target_lang_word": "群体",
                                "target_lang_sense_clarification": "指一群人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afb5cfb0-a8ef-388e-899e-197337e856a9",
                    "sense_definition": "A person's luck, situation, or destiny in life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was his <w>lot</w> to become a soldier.",
                            "target_lang_translations": {
                                "ru": "Ему выпала <w>участь</w> стать солдатом.",
                                "zh": "他命中注定要成为一名士兵，这是他的<w>命运</w>。"
                            }
                        },
                        {
                            "text": "She seemed content with her <w>lot</w> in life.",
                            "target_lang_translations": {
                                "ru": "Она казалась довольной своей <w>судьбой</w> в жизни.",
                                "zh": "她似乎对自己的生活<w>境遇</w>感到满足。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fate",
                        "destiny",
                        "fortune",
                        "portion"
                    ],
                    "common_phrases": [
                        "lot in life",
                        "cast in one's lot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судьба, положение или участь человека в жизни.",
                        "zh": "一个人的命运、处境或生活境遇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участь",
                                "target_lang_sense_clarification": "доля, судьба, часто с оттенком неизбежности"
                            },
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "складывающийся ход жизни"
                            },
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "жизненный удел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "命运",
                                "target_lang_sense_clarification": "指人生的际遇"
                            },
                            {
                                "target_lang_word": "境遇",
                                "target_lang_sense_clarification": "指所处的环境和遭遇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acafaa2c-a7f5-3d60-bc06-10aa93ba260c",
                    "sense_definition": "A specific item or set of items offered for sale, especially at an auction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "auction_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The next <w>lot</w> is a rare painting.",
                            "target_lang_translations": {
                                "ru": "Следующий <w>лот</w> — редкая картина.",
                                "zh": "下一件<w>拍品</w>是一幅珍稀画作。"
                            }
                        },
                        {
                            "text": "He bid on a <w>lot</w> of antique furniture.",
                            "target_lang_translations": {
                                "ru": "Он сделал ставку на <w>лот</w> старинной мебели.",
                                "zh": "他竞拍了一<w>拍品</w>古董家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "batch",
                        "group",
                        "collection"
                    ],
                    "common_phrases": [
                        "auction lot",
                        "job lot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный предмет или набор предметов, выставленных на продажу, особенно на аукционе.",
                        "zh": "拍卖会上出售的特定物品或一组物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лот",
                                "target_lang_sense_clarification": "единица купли-продажи на аукционе"
                            },
                            {
                                "target_lang_word": "партия",
                                "target_lang_sense_clarification": "группа товаров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍品",
                                "target_lang_sense_clarification": "拍卖会上的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19406b5-258d-37b6-9bba-7bab1b9493bf",
                    "sense_definition": "An object used to make a decision by chance, such as a straw or slip of paper.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to draw <w>lots</w> to see who would go first.",
                            "target_lang_translations": {
                                "ru": "Они решили тянуть <w>жребий</w>, чтобы узнать, кто пойдет первым.",
                                "zh": "他们决定抽<w>阄</w>来决定谁先去。"
                            }
                        },
                        {
                            "text": "The soldiers cast <w>lots</w> for the prize.",
                            "target_lang_translations": {
                                "ru": "Солдаты бросали <w>жребий</w> за приз.",
                                "zh": "士兵们通过抽<w>阄</w>来争夺奖品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance"
                    ],
                    "common_phrases": [
                        "cast lots",
                        "draw lots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, используемый для принятия решения наугад, например, соломинка или листок бумаги.",
                        "zh": "用于通过偶然机会做决定的物品，如纸条或签。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жребий",
                                "target_lang_sense_clarification": "условный предмет, вынимаемый наудачу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阄",
                                "target_lang_sense_clarification": "用于抽签决定的纸条"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "87d19480-67fa-3d93-9a9c-0c894291239f",
                    "sense_definition": "A nephew of Abraham in the Bible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Lot</w> escaped from the city before it was destroyed.",
                            "target_lang_translations": {
                                "ru": "<w>Лот</w> бежал из города до того, как тот был разрушен.",
                                "zh": "<w>罗得</w>在城市被毁前逃了出来。"
                            }
                        },
                        {
                            "text": "The story of <w>Lot</w> is well known.",
                            "target_lang_translations": {
                                "ru": "История <w>Лота</w> хорошо известна.",
                                "zh": "<w>罗得</w>的故事广为人知。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Племянник Авраама в Библии.",
                        "zh": "圣经中亚伯拉罕的侄子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лот",
                                "target_lang_sense_clarification": "библейский персонаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗得",
                                "target_lang_sense_clarification": "圣经人物名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c08f30d8-37c6-30da-b75f-7a9b9f496bb6",
                    "sense_definition": "A department in the Occitania region of France.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They went on holiday to the <w>Lot</w>.",
                            "target_lang_translations": {
                                "ru": "Они поехали в отпуск в <w>Лот</w>.",
                                "zh": "他们去<w>洛特省</w>度假了。"
                            }
                        },
                        {
                            "text": "The river flows through the <w>Lot</w> department.",
                            "target_lang_translations": {
                                "ru": "Река протекает через департамент <w>Лот</w>.",
                                "zh": "这条河穿过<w>洛特省</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Департамент в регионе Окситания во Франции.",
                        "zh": "法国奥克西塔尼大区的一个省。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лот",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洛特省",
                                "target_lang_sense_clarification": "法国地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54c1b9d9-c21c-3712-8fc6-899b550148b1",
                    "sense_definition": "To divide or group items into lots, often for sale or distribution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auctioneer <w>lotted</w> the items carefully.",
                            "target_lang_translations": {
                                "ru": "Аукционист тщательно <w>разбил на лоты</w> предметы.",
                                "zh": "拍卖师仔细地将物品<w>分批</w>。"
                            }
                        },
                        {
                            "text": "They <w>lotted</w> out the work to different teams.",
                            "target_lang_translations": {
                                "ru": "Они <w>распределили</w> работу между разными командами.",
                                "zh": "他们把工作<w>分配</w>给了不同的团队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "group",
                        "parcel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять или группировать предметы на партии, часто для продажи или распределения.",
                        "zh": "将物品分组或分类，通常为了销售或分配。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать на лоты",
                                "target_lang_sense_clarification": "формировать аукционные лоты"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "делить на части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分批",
                                "target_lang_sense_clarification": "将物品分成若干批次"
                            },
                            {
                                "target_lang_word": "分配",
                                "target_lang_sense_clarification": "将物品分发给不同对象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}