                ],
                "senses": [
                    {
                        "sense_id": "97aeb565-ca3c-3d2c-b0ab-6ed4cc3b220b",
                        "entry_id": "02224b73-f648-315a-936e-809508cb84b6",
                        "glosses": [
                            "очень маленький, крайне незначительный по размерам, достоинствам и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba174fb1-0693-469c-a735-c787be70ef49",
                                "sense_id": "97aeb565-ca3c-3d2c-b0ab-6ed4cc3b220b",
                                "text": "После закуски пришлось выпить несколько микроскопичных чарочек разных настоек."
                            },
                            {
                                "example_id": "289a65d7-96fb-4775-9ee7-8217cfa8947f",
                                "sense_id": "97aeb565-ca3c-3d2c-b0ab-6ed4cc3b220b",
                                "text": "Перед отпуском ногти можно украсить при помощи техники «Аквариум» (в выемку акрила или геля «запускают» микроскопичных рыбок и закрывают покрытием)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5ad7ddb-369a-45aa-9ee9-eb30f5a132b8",
                        "source_entry_id": "02224b73-f648-315a-936e-809508cb84b6",
                        "source_sense_id": "97aeb565-ca3c-3d2c-b0ab-6ed4cc3b220b",
                        "target_lang_word": "microscopic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscopic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Of, or relating to microscopes or microscopy; microscopal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdbe038-ca09-4757-8fc1-5e75e1f8adef",
                                                "sense_id": "e62c011a-1b3d-3875-8e06-682abd8a4b70",
                                                "text": "We supply all microscopic stains and other materials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "So small that it can only be seen with the aid of a microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90017d6-39bc-46b9-b68d-1cc362b36218",
                                                "sense_id": "bce7aeda-d8f9-3d78-bd2e-bb1d27ce2ac0",
                                                "text": "The water was full of microscopic organisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Very small; minute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c68045-f407-4b1f-959b-41a80e3c0319",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "Compared to the galaxy, we are microscopic in scale."
                                            },
                                            {
                                                "example_id": "d8d8bb97-ef8c-4f46-ab3e-447b8eb42cbd",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "By wholesale omission of connections and by the use of a microscopic scale of photographic reproduction which makes some of the most important tables difficult to read, the size has been cut down from last winter's 580 to 520 pages only."
                                            },
                                            {
                                                "example_id": "8f8a6644-9b19-44cf-a3c4-a6e8a2358018",
                                                "sense_id": "0b5d5558-889b-33c8-8104-b2f086bb0a91",
                                                "text": "... the notion of the microscopic was often used in the foundations of quantum theory right from the start, to indicate the realm in which quantum theory is required in order to explain phenomena when classical theory cannot do so; quantum theory was generally considered in those years to apply only to situations involving atoms and smaller “microscopic” entities..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Carried out with great attention to detail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d51ad7-0eb7-4a4b-935b-7ecc3bb795b4",
                                                "sense_id": "85bd560e-a397-3614-b092-791470fb698a",
                                                "text": "The police carried out a microscopic search of the crime scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                        "entry_id": "89a83424-bdf3-3c39-8803-5dd42db2afb5",
                                        "glosses": [
                                            "Able to see extremely minute objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3565db4-64fc-4788-83aa-3ec9bcde9d73",
                                                "sense_id": "bb347896-863e-350a-bca9-6d3b29467593",
                                                "text": "Why has not man a microscopic eye?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e210782-7552-4fa3-9d48-013692e60a23",
                        "source_entry_id": "02224b73-f648-315a-936e-809508cb84b6",
                        "source_sense_id": "97aeb565-ca3c-3d2c-b0ab-6ed4cc3b220b",
