                                        "glosses": [
                                            "To grow again (of a plant, leaf etc.)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37757bd-de3b-46a3-8708-6ea0a2bcc854",
                                                "sense_id": "deade5c7-39b2-3b55-b53b-5831cf13cf9b",
                                                "text": "Forsyth's Power real or imaginary of healing wounded Plants, and making them revegetate is a strange Thing:—more strange than true I fancy […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539cdeed-82d3-3bbc-99a1-51c4d684a167",
                                        "entry_id": "e5e1dafb-8182-3af6-9878-6889c73d2222",
                                        "glosses": [
                                            "To produce new vegetation on (a barren ground or area); to colonize (barren ground)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
