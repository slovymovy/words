                "senses": [
                    {
                        "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                        "entry_id": "f44955aa-81a2-3cac-bcc1-4f175e95eb88",
                        "glosses": [
                            "To take magic mushrooms."
                        ],
                        "tags": [
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "80cb7ff4-8aad-447d-820b-6a5c172de4c7",
                                "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                                "text": "Not just because it was sophmoric^([sic]) and juvenile (which it surely was) but I was shrooming pretty heavily by now."
                            },
                            {
                                "example_id": "174a0d80-0894-414a-a7c2-dd7b355f28d4",
                                "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                                "text": "Just a few months ago I was in Amsterdam with two old friends from the Lahore art world. On a warm summer night we checked out some galleries and walked along the canals, whirring bicycles and shrooming teenagers passing us in the darkness."
                            }
                        ]
                    }
                ],
