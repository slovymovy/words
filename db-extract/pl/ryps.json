                "translations": [
                    {
                        "translation_id": "3d5c7847-4785-45e1-b75f-ad1c160b7ce0",
                        "source_entry_id": "c47356f8-0481-3ac7-b338-35b080259204",
                        "source_sense_id": "f03a39c4-d7e3-3d4c-8b14-eb3f8246e152",
                        "target_lang_word": "rep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43f6c2f-c94b-3bc4-9943-3b007597a3a0",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of reputation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ae7b83-f37d-4a86-b32f-552561e1f25d",
                                                "sense_id": "e43f6c2f-c94b-3bc4-9943-3b007597a3a0",
                                                "text": "Try not to make it easy for the tabloids to ruin your rep."
                                            },
                                            {
                                                "example_id": "8edadff5-6051-4cfd-8f20-1cc27da212a5",
                                                "sense_id": "e43f6c2f-c94b-3bc4-9943-3b007597a3a0",
                                                "text": "Clean up your rep, your story's gettin' dusty / Wash out your mouth, your lies are gettin' rusty"
                                            },
                                            {
                                                "example_id": "09bf6504-52d6-4b37-bc8e-433f0ada91b3",
                                                "sense_id": "e43f6c2f-c94b-3bc4-9943-3b007597a3a0",
                                                "text": "Remember. I got a rep to protect, OK, Shakespeare?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead1cdcf-c075-378e-802c-2b05557e1b48",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of repetition."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5b3725-42f1-46dc-85ae-a55d2067db00",
                                                "sense_id": "ead1cdcf-c075-378e-802c-2b05557e1b48",
                                                "text": "Holonym: sets"
                                            },
                                            {
                                                "example_id": "507c4ab7-64d0-4f8b-bb92-2e22f10c4d6f",
                                                "sense_id": "ead1cdcf-c075-378e-802c-2b05557e1b48",
                                                "text": "I get a better bicep workout if I use less weight and more reps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02218bc4-26c8-3c8c-98b3-4493bb5fc5b5",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of representative."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d42c997-08f1-4134-9c6a-9683b0ff4fa1",
                                                "sense_id": "02218bc4-26c8-3c8c-98b3-4493bb5fc5b5",
                                                "text": "When I requested tickets for Nassau, my rep just put me on hold."
                                            },
                                            {
                                                "example_id": "00ca2340-4ac7-4e54-9091-2d3706bef5b5",
                                                "sense_id": "02218bc4-26c8-3c8c-98b3-4493bb5fc5b5",
                                                "text": "John Doe is a member of the House of Reps."
                                            },
                                            {
                                                "example_id": "5503b48b-52f3-4ee1-a227-ca01659e0089",
                                                "sense_id": "02218bc4-26c8-3c8c-98b3-4493bb5fc5b5",
                                                "text": "An upcoming problem to be thrashed out at a meeting of diskery reps and execs of the American Federation of Radio Artists (AFRA), is the degree of AFRA's jurisdictional claim over singers on records."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705ad085-4dda-3935-938f-cf5ac07b99df",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of representation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f269b4f-693a-4052-973b-a8877b7dd89b",
                                                "sense_id": "705ad085-4dda-3935-938f-cf5ac07b99df",
                                                "text": "This was the first episode of Degrassi I saw, and it was a formative episode. Why, might you ask? Not only because in 2003, there, again, wasn't much gay rep, but because of this interaction at the end of the episode that I stumbled upon, […]"
                                            },
                                            {
                                                "example_id": "8c729b2c-02e6-48bb-b6a9-5613dee1e695",
                                                "sense_id": "705ad085-4dda-3935-938f-cf5ac07b99df",
                                                "text": "But for those looking for movies that have pronounced and meaningful queer rep, it might be best to shift focus over to smaller Summer 2022 titles like Neptune Frost, which deliver vibrant and righteous queer energy in every frame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6fdc3a-b80e-3a13-8bb3-317ace64a3aa",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of repertory."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72f8cd95-f063-49f9-bf1f-4605afe0f71c",
                                                "sense_id": "ff6fdc3a-b80e-3a13-8bb3-317ace64a3aa",
                                                "text": "She did her time in reps before she made the grade in West End theatre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b75846-cf5a-301d-bb50-b0b86bb25cf9",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of report."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "in-compounds",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2846ed7-db84-4a2e-9552-2403c828aabc",
                                                "sense_id": "e2b75846-cf5a-301d-bb50-b0b86bb25cf9",
                                                "text": "A shell report, or \"shell rep,\" was supposed to be sent in by any man who witnessed the fall of enemy artillery fire."
                                            },
                                            {
                                                "example_id": "53451fd8-02ab-4921-aaf2-31ef78ef438d",
                                                "sense_id": "e2b75846-cf5a-301d-bb50-b0b86bb25cf9",
                                                "text": "[…] and Henry Riser is still waiting for official casualty reps and family info on Doug Wheless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b880a36-0f49-371d-a2a4-31fd43162080",
                                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                                        "glosses": [
                                            "Clipping of replica."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24139343-4ede-4fb9-8ea5-4e562a5f677b",
                                                "sense_id": "4b880a36-0f49-371d-a2a4-31fd43162080",
                                                "text": "rep sneakers"
                                            },
                                            {
                                                "example_id": "25e3b717-e938-448a-b55c-fc10cabf98c0",
                                                "sense_id": "4b880a36-0f49-371d-a2a4-31fd43162080",
                                                "text": "Overall, David is cagey when talking about reps, like someone might be while talking about an ex. That's understandable. But I wonder if Soulsfeng will ever reach the notoriety that David the rep seller did."
                                            },
                                            {
                                                "example_id": "be140fde-faf3-4f1b-9f31-026c335bc162",
                                                "sense_id": "4b880a36-0f49-371d-a2a4-31fd43162080",
                                                "text": "The forum is a democratised, judgement-free zone in which people share a love of high quality replicas or 'reps', where members are friendly and even supportive. They help one another to find the best sellers and sites to buy from, while discussing discrepancies between retail items and their counterfeit counterparts – from stitching and logos, to details and finishes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb0d43b-c7ff-373d-96a5-989548a6df22",
                                        "entry_id": "2fd2354b-1432-3459-a4b1-1395db281899",
                                        "glosses": [
                                            "To represent; to act as a representative for."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647e7d0c-0336-4df3-a112-b30fd497eb75",
                                                "sense_id": "dfb0d43b-c7ff-373d-96a5-989548a6df22",
                                                "text": "Bentley, the man who repped for Slade, carried the air and the rest joined in."
                                            },
                                            {
                                                "example_id": "303ee922-25cb-4b82-98be-b24bda4d9de1",
                                                "sense_id": "dfb0d43b-c7ff-373d-96a5-989548a6df22",
                                                "text": "He left to help the Reader set up its national advertising arm, went back to Rolling Stone for five years, repped other magazines, and finally set up his own company, which currently scouts ads for the Atlantic, Spin, Discover, and a publication called Disney Adventures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7ec0c2-59a0-3285-872d-d8d93680abd1",
                                        "entry_id": "2fd2354b-1432-3459-a4b1-1395db281899",
                                        "glosses": [
                                            "To display as a representative example."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544716f2-89c4-458a-9c88-91268bf545b8",
                                                "sense_id": "0a7ec0c2-59a0-3285-872d-d8d93680abd1",
                                                "text": "Last year, Olivia famously went full-2000s at a Grammys after-party she attended with Paris Hilton, where she repped a bright blue butterfly dress featuring a plunging neckline and dramatic ruffles. Now, for her latest look, she's gone and repped another recognisable combination: silk trousers and a leather boob tube."
                                            },
                                            {
                                                "example_id": "0d2d827d-c1c3-40bc-8083-27fa57c0b63c",
                                                "sense_id": "0a7ec0c2-59a0-3285-872d-d8d93680abd1",
                                                "text": "As for her beauty look, the Jennifer’s Body star had dyed her long tresses a burnt-orange shade, and styled them slightly curled at the ends and down across her shoulders. She also repped a bubblegum-pink manicure with an abstract black design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2892081-47f5-3d94-aed4-4a97f697ec41",
                                        "entry_id": "2fd2354b-1432-3459-a4b1-1395db281899",
                                        "glosses": [
                                            "Abbreviation of repeat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bec3058-8dd4-403b-a741-adb5d646f2e2",
                                                "sense_id": "b2892081-47f5-3d94-aed4-4a97f697ec41",
                                                "text": "Rep neck dec EOR 4 times more, AND AT THE SAME TIME, rep armhole dec EOR 4 (4,5) times more"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e9301d-c8b9-3de0-93f0-5d1ebe958cbb",
                                        "entry_id": "2fd2354b-1432-3459-a4b1-1395db281899",
                                        "glosses": [
                                            "To lift for multiple reps."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "022cb976-55db-34ba-b87a-131e0b9463dd",
                                        "entry_id": "e26bd31d-8928-3598-af30-aac25bcf97f2",
                                        "glosses": [
                                            "A fabric made of silk or wool, or of silk and wool, and having a transversely corded or ribbed surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2c08f9c-f189-4a16-8557-90b98a0b03cf",
                                                "sense_id": "022cb976-55db-34ba-b87a-131e0b9463dd",
                                                "text": "Underfoot is a rich brown marble from the shores of Lake Champlain. The wainscoting is of green rep and red Numidian marble."
                                            },
                                            {
                                                "example_id": "f41f9081-5830-4965-b56d-7f90e3ad1f5e",
                                                "sense_id": "022cb976-55db-34ba-b87a-131e0b9463dd",
                                                "text": "It was decorated in […] horsehair and red rep curtains[.]"
                                            },
                                            {
                                                "example_id": "568601f3-9743-4a4d-acea-4c90d3aa8f2c",
                                                "sense_id": "022cb976-55db-34ba-b87a-131e0b9463dd",
                                                "text": "I toted a (rather fetching) $100 Gucci 1955 Horsebit rep through a vacation across Europe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
