                        ],
                        "examples": [
                            {
                                "example_id": "151c4957-ad58-475d-a983-89d75e16b9cc",
                                "sense_id": "744b7889-53ac-309b-877b-9a215cc2e583",
                                "text": "Politiek en gokwereld spanden samen om Helmin Wiels te vermoorden. Dat beeld kwam naar voren in de rechtszaak tegen Burney F., gisteren op Curaçao. Ex-minister van Financiën, George Jamaloodin van de partij van Gerrit Schotte, de MFK, zou de grote organisator zijn. Samen met zijn halfbroer en gokbaas op het eiland, Robbie dos S."
                            }
                        ]
                    },
                    {
                        "sense_id": "09a567df-c5b9-3b33-9015-496fee517ac9",
