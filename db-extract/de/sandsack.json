                        "form": "den Sandsack"
                    },
                    {
                        "form_id": "5922234c-8a81-47d2-8452-2431d07fcd0c",
                        "entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sandsäcke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                        "entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                        "glosses": [
                            "mit Sand gefüllter Sack, bestehend aus Naturfasern oder Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1baabc81-4bc5-4c03-b5f7-77978cc11729",
                                "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                                "text": "Die verheerende Flutwelle wird durch Sandsäcke gestoppt, damit die Stadt vor der Überflutung verschont bleibt."
                            },
                            {
                                "example_id": "9f123849-f019-497b-bd87-585b3a01f85e",
                                "sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                                "text": "„Val dichtete währenddessen die zugigen Fenster mit Sandsäcken aus einem nie zu Ende gebauten Gewächshaus ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                        "entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                        "glosses": [
                            "Trainingsgerät, unter anderem für Boxer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479e4169-e9ae-4841-bcf2-25085445c990",
                                "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                                "text": "Der Boxer trainiert jeden Tag am Sandsack."
                            },
                            {
                                "example_id": "35ccf4f5-a819-4c59-96c0-51ebea0b8b32",
                                "sense_id": "a2b92cc6-73c8-3206-a382-b02a2eb77abe",
                                "text": "„Unter den Bäumen war ein Ring aufgebaut, in dem die Kämpfer bei gutem Wetter trainierten, und im Tanzsaal gab es einen großen und einen kleinen Sandsack und eine Matte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d68ba10-2021-460e-a8c5-c72d05af8715",
                        "source_entry_id": "14c59fe4-2ec8-35d9-9c6d-a5be2eef3993",
                        "source_sense_id": "14d5bc47-1605-3f9f-aa3f-b675c3bb2606",
                        "source_sense_description": "mit Sand gefüllter Sack bestehend aus Naturfasern oder Kunststoff",
                        "target_lang_word": "sandbag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandbag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c63a4ae-8ec8-3364-a2f2-5b578b093b8b",
                                        "entry_id": "92c484c2-7175-3d89-8c76-05bad3327da3",
                                        "glosses": [
                                            "A sturdy sack filled with sand, generally used in large numbers to make defensive walls against flooding, bullets, or shrapnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0dee77d6-418a-32da-9b3f-b9b282e7031e",
                                        "entry_id": "92c484c2-7175-3d89-8c76-05bad3327da3",
                                        "glosses": [
                                            "A small bag filled with sand and used as a cudgel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cb1560c-5921-397b-b521-887b753cfb79",
                                        "entry_id": "92c484c2-7175-3d89-8c76-05bad3327da3",
                                        "glosses": [
                                            "An engraver's leather cushion, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbd5b271-b758-3f55-81d8-7336653da6c2",
                                        "entry_id": "92c484c2-7175-3d89-8c76-05bad3327da3",
                                        "glosses": [
                                            "A deceptive play whereby a player with a strong hand bets weakly or passively."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sandbag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a08f9d5f-6462-3fb1-8147-e78b7d5b948d",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To construct a barrier of sandbags (around)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd4ec94-ac81-4de6-93fa-14cadb4dfe9f",
                                                "sense_id": "a08f9d5f-6462-3fb1-8147-e78b7d5b948d",
                                                "text": "We sandbagged the basement windows against the floodwaters."
                                            },
                                            {
                                                "example_id": "eb247efb-faad-42fb-bd10-57744bc7cd3b",
                                                "sense_id": "a08f9d5f-6462-3fb1-8147-e78b7d5b948d",
                                                "text": "The height “49 feet” became a mantra, as volunteers worked for weeks sandbagging and building to match that height."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a2a77bc-3804-3081-b143-087bba054f0a",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To strike someone with a sandbag or other object to disable or render unconscious."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7fab772-1f28-3d9a-8e2a-f27c6ce82261",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To conceal or misrepresent one's true position, potential, or intent in order to gain an advantage; (originally poker) to pretend to have a weak hand, as a strategy."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6718f570-0f0a-4142-9a84-943f1d0edfb9",
                                                "sense_id": "f7fab772-1f28-3d9a-8e2a-f27c6ce82261",
                                                "text": "Some felt that Roberts was sandbagging, because his mastery of the 250s wasn't really showing in practice or the heat."
                                            },
                                            {
                                                "example_id": "45a002a4-6efe-4516-83ec-559c563e16d7",
                                                "sense_id": "f7fab772-1f28-3d9a-8e2a-f27c6ce82261",
                                                "text": "The sandbagging manager is similarly deceptive. He has mastered the art of seeming harmless and without power, but in reality he carries far more authority and clout than one would be led to believe."
                                            },
                                            {
                                                "example_id": "12721d07-4350-421e-93da-192a06cbf101",
                                                "sense_id": "f7fab772-1f28-3d9a-8e2a-f27c6ce82261",
                                                "text": "When playing against a wild man, try to be in a position to pick off his bluffs without too many players remaining behind you who can benefit from the action by sandbagging (passing on big hands and waiting for “sport” to whoop up the betting)."
                                            },
                                            {
                                                "example_id": "11ff4794-48d2-4e60-84f6-c3c982587af5",
                                                "sense_id": "f7fab772-1f28-3d9a-8e2a-f27c6ce82261",
                                                "text": "Accordingly, we may establish as our principle that the time to sandbag is when you have three of a kind or better, when there are at least five players to act after you, and when your hand is made up of low cards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To blindside; to deceive; to undermine."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4eb9f9d-5a53-4e27-9e62-c422d9d90f0c",
                                                "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                                "text": "“Sandbagged” was used by George Bush in response to the charges of stiffing. “We feel we were sandbagged,” he said, repeating the slang verb used first by his New Hampshire campaign manager. Concurrently, Joe Scott wrote in his newsletter, “The Political Animal,” that Governor Jerry Brown was “sandbagging Kennedy's surge.”"
                                            },
                                            {
                                                "example_id": "65fdef88-1343-4f1c-a3bc-2d5de83bc0cb",
                                                "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                                "text": "The Liberal Democrat leader Nick Clegg has allowed himself to be sandbagged by his Tory partners in his otherwise laudable attempt to introduce a fairer electoral system, probably losing a once-in-a-generation opportunity for electoral reform."
                                            },
                                            {
                                                "example_id": "3f01d551-1a51-4bf3-bc04-5c0b7fd02f5f",
                                                "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                                "text": "[Shane Black:] And keep in mind, I got sandbagged by this one reporter in like 1999 or 2000. He said, \"I'm a big fan of your work; I'd love to do a story on you.\" And after he had interviewed me, he said, \"Oh, by the way, I'm going to kind of crunch your words together to make it look like you're talking. I'll sort of take my voice out of it.\" And it turns out the article is called “Letters from Oblivion” and it was basically about has-beens. But because he was able to put it in my own words it sounded like I was complicit in the article. Like, \"As a has-been, here's what I'd like to say about it.\""
                                            },
                                            {
                                                "example_id": "adc2dcad-2bfd-44c2-93be-6c97b7beb373",
                                                "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                                "text": "In the past month, President Trump has sideswiped certification of the Iran nuclear deal, sandbagged his own secretary of state’s diplomatic efforts with North Korea, and even provoked the ever-careful Senate Foreign Relations Committee Chairman, Bob Corker, to uncork his deepest fears in a series of bombshell interviews."
                                            },
                                            {
                                                "example_id": "f74e8963-0c2e-445f-b847-37d362a6ab76",
                                                "sense_id": "97b7b933-3c82-32cc-b397-ae804b2ad962",
                                                "text": "Responding to Axios business editor Dan Primack's assertion that she \"sandbagged\" Yaccarino by springing the former executive's appearance on her, Swisher maintained that upon learning of his booking earlier Wednesday, it was the X CEO's decision to speak after Roth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66587fe-6306-330e-a971-2e4222aaa50b",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To premake dishes (prepare them in advance) (intransitive); to premake (dishes) (transitive)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6356e3f-8cf2-32a5-b0db-d193ab981a79",
                                        "entry_id": "49459db4-49a5-3472-a886-7fe88862c507",
                                        "glosses": [
                                            "To pretend to drink alcohol early on so that, as the night draws on, one can drink everybody else \\\"under the table\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
