        "fr-extract.jsonl": [
            {
                "entry_id": "01ebf222-828f-369c-b5c7-32dcee7fb341",
                "word": "pupe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4669fff5-a202-44ef-a4e3-fd7b081c3ecd",
                        "entry_id": "01ebf222-828f-369c-b5c7-32dcee7fb341",
                        "tags": [
                            "plural"
                        ],
                        "form": "pupes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "977f778e-bab0-34de-959f-164f9262eb85",
                        "entry_id": "01ebf222-828f-369c-b5c7-32dcee7fb341",
                        "glosses": [
                            "Nymphe enclose dans le tégument (ou exuvie) du dernier stade larvaire, typique des diptères (dont la larve est un asticot)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083076e3-d270-491a-a691-61452a207305",
                                "sense_id": "977f778e-bab0-34de-959f-164f9262eb85",
                                "text": "La pupe est formée par la dernière exuvie larvaire rétractée qui constitue un puparium chitinisé, dur et résistant. La pupe enferme la nymphe et ne permet pas de distinguer les parties de l'imago. Les pupes sont immobiles."
                            },
                            {
                                "example_id": "434b9945-ff01-4954-bdb6-36b4689e6d1c",
                                "sense_id": "977f778e-bab0-34de-959f-164f9262eb85",
                                "text": "À la fin de leur troisième mue, les asticots rampent vers un endroit frais et sec et se transforment en pupes, de couleur rougeâtre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5c9d764-82c1-4e72-bb9e-6b64538831fa",
                        "source_entry_id": "01ebf222-828f-369c-b5c7-32dcee7fb341",
                        "source_sense_id": "977f778e-bab0-34de-959f-164f9262eb85",
                        "target_lang_word": "Puppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b1a977b-507a-3241-83c5-4d9e797bb0b6",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "eine (verkleinerte) Rekonstruktion eines Menschen, eines Kleinkindes (welches zumeist als Spielzeug verwendet wird)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "48123f3a-0bca-34ff-aaad-e8ebbee908f4",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "speziell angefertigte Puppe^([1a]), die zum Theaterspielen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "b213bfb9-2638-3323-b790-15595404f08f",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "eine gutaussehende weibliche Person"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae038434-105c-47bc-9102-427d70c9686b",
                                                "sense_id": "b213bfb9-2638-3323-b790-15595404f08f",
                                                "text": "Na, Puppe, hast du heute schon was vor?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95fba627-ef2c-338c-85ba-5eff174aa2cf",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "Entwicklungsstadium eines Insekts zwischen Larve und Vollinsekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0b2986-f567-42e5-96b6-a22a484d960a",
                                                "sense_id": "95fba627-ef2c-338c-85ba-5eff174aa2cf",
                                                "text": "Aus der hässlichen Puppe wird in den nächsten Tagen ein wunderschöner Schmetterling."
                                            },
                                            {
                                                "example_id": "cb5ad9d3-8d09-491d-8c8c-0b7cbf60089a",
                                                "sense_id": "95fba627-ef2c-338c-85ba-5eff174aa2cf",
                                                "text": "„Da an dem Leichnam keine Fliegenmaden oder Puppen gefunden wurden, muss er konserviert worden sein; wie genau, konnte bislang nicht ermittelt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8c656441-a183-3f30-aa09-67ed536bf117",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "zu Haufen zusammengestellte Stroh- oder Getreidegarben"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed507ab-2881-489a-bff5-3e3c77330c2f",
                                                "sense_id": "8c656441-a183-3f30-aa09-67ed536bf117",
                                                "text": "Wir müssen die Puppen noch vom Feld holen, bevor es regnet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                        "entry_id": "d04ab3c0-2639-3439-b7d8-bb1912fe0c6d",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87917044-9f84-496b-95c0-3762aeffc411",
                                                "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                                "text": "Als ich klein war, habe ich oft mit Puppen gespielt."
                                            },
                                            {
                                                "example_id": "3a182a4f-0a54-4d9b-b9f5-198f3f695e82",
                                                "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                                "text": "„Die Puppe und die Großmutter hatten eines gemeinsam: Sie waren lange nicht mehr rausgekommen.“"
                                            },
                                            {
                                                "example_id": "bd98f147-16ff-4e78-b6b0-4cda4848f637",
                                                "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                                "text": "„Sie nahm die Puppe aus dem Wagen und bemerkte, dass der Faden sich über den Puppenwagen hinaus im Dunkel verlor.“"
                                            },
                                            {
                                                "example_id": "d4140770-d47a-4bd7-ae9a-896fefd52259",
                                                "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                                "text": "„Anse füllte sich beide Hände mit Erde, ließ sie auf die Puppe fallen und deckte sie teilweise zu.“"
                                            },
                                            {
                                                "example_id": "cc0b2329-f585-4476-b180-dbf6ec093f53",
                                                "sense_id": "9e20f993-0bb2-3c50-904f-6ae7d8e3e67f",
                                                "text": "„Sie hatte im Koffer gelegen, als Papa einmal aus Japan zurückgekommen war, er war zwei Wochen weg gewesen, ich bekam als Mitbringsel einen seltenen Kimono, während die Puppe nach oben ins Regal gesetzt wurde, damit ich sie nicht erreichen könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
