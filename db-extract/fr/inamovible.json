            {
                "entry_id": "83183664-92a8-33de-a143-b43d9373d0e8",
                "word": "inamovible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "592b5d5b-fba0-4c22-a470-97db27b472cf",
                        "entry_id": "83183664-92a8-33de-a143-b43d9373d0e8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inamovibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06c361cd-116c-3f37-a768-10cb9a54628c",
                        "entry_id": "83183664-92a8-33de-a143-b43d9373d0e8",
                        "glosses": [
                            "Qui ne peut être ôté d’un poste, qui ne peut être destitué de sa place arbitrairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dcf4c39-008c-48a4-9309-a9de593f3c26",
                                "sense_id": "06c361cd-116c-3f37-a768-10cb9a54628c",
                                "text": "Certains magistrats sont inamovibles."
                            },
                            {
                                "example_id": "b0b3b2f1-d216-4128-bbc0-1885b697fa18",
                                "sense_id": "06c361cd-116c-3f37-a768-10cb9a54628c",
                                "text": "Autrefois, il existait en France des sénateurs inamovibles."
                            },
                            {
                                "example_id": "00e627ca-1396-4f31-b0ef-f4914ea3cce5",
                                "sense_id": "06c361cd-116c-3f37-a768-10cb9a54628c",
                                "text": "Explication de cette étrange mansuétude : Macron a encore besoin de l’inamovible pédégé de la SNCF, qui entretient avec les syndicats de bonnes relations, pour faire passer la très délicate réforme des retraites."
                            }
                        ]
                    },
                    {
                        "sense_id": "3830adb3-48bc-3a49-893f-07709fe39f8c",
                        "entry_id": "83183664-92a8-33de-a143-b43d9373d0e8",
                        "glosses": [
                            "Il se dit également des emplois à vie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9bd36a1-ed27-40e3-8815-e95add04384e",
                                "sense_id": "3830adb3-48bc-3a49-893f-07709fe39f8c",
                                "text": "Emploi, dignité, magistrature inamovible."
                            },
                            {
                                "example_id": "d16e334a-c08f-4ce6-83a5-306e5d2eded9",
                                "sense_id": "3830adb3-48bc-3a49-893f-07709fe39f8c",
                                "text": "Jean-Michel ne peut être exclu de l'alliance, il est inamovible."
                            }
                        ]
                    },
                    {
                        "sense_id": "848408fc-e827-343d-801e-1ccfc2a02b63",
                        "entry_id": "83183664-92a8-33de-a143-b43d9373d0e8",
                        "glosses": [
                            "Qui est toujours à sa place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71356e9e-9559-4521-8faf-7ed003a9d140",
                                "sense_id": "848408fc-e827-343d-801e-1ccfc2a02b63",
                                "text": "Presque tous avaient l’aspect louche, la voix huileuse, les yeux rampants, les lunettes inamovibles, les vêtements en bois noir des sacristains."
                            }
                        ]
                    }
                ],
