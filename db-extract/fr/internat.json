            {
                "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                "word": "internat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf9a24e2-e1d2-4d61-a429-4c93b3757228",
                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "internats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d98cd775-c9a6-3f54-a6db-ab52c6a2ec60",
                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "glosses": [
                            "État d’un élève qui loge dans son lieu d’enseignement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7028cd13-940b-47e2-b20a-51bfafcb347d",
                                "sense_id": "d98cd775-c9a6-3f54-a6db-ab52c6a2ec60",
                                "text": "Sa liberté, son quant à soi, le plus grand bien, après l'incarcération de six années d’internat scolaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dffaf1b-6da0-3812-8c57-8dc34f8f7b55",
                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "glosses": [
                            "Ce lieu d’enseignement lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32baf56c-6f4c-4c8d-b979-6bf02518e4c9",
                                "sense_id": "4dffaf1b-6da0-3812-8c57-8dc34f8f7b55",
                                "text": "Mes potes de l’internat ont eu la mauvaise idée de mettre tous les lits en cathédrale et même de jeter un matelas par la fenêtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "glosses": [
                            "Fonction des internes dans un hôpital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f70348e-4c42-4904-96b5-3ae39cde3c95",
                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                "text": "Entre l’addictologie et Laurent Karila, c’est une histoire d’affect qui dure. Après un internat de psychiatrie, il s’entiche rapidement de la science des dépendances."
                            },
                            {
                                "example_id": "1c54aaac-c69b-44eb-adb0-6f30c8322552",
                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                "text": "Il porte un jean et une veste en cuir. À peine sorti de l’internat et peut-être même encore interne."
                            },
                            {
                                "example_id": "ceeb2a57-d224-4c18-a580-5622df10e0d3",
                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                "text": "Dès qu’elle peut, elle rend visite à Tamara, qui finit son internat de médecine."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4d050bb-b581-3086-8380-8b0bbfcf24dd",
                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "glosses": [
                            "Concours que doivent subir les externes des hôpitaux pour devenir internes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "14b0c103-ae33-4a14-b071-19540a21893c",
                                "sense_id": "d4d050bb-b581-3086-8380-8b0bbfcf24dd",
                                "text": "Il a passé l’internat avec succès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c7c0849-fcbe-4224-ad3f-cdf6fb9fdf87",
                        "source_entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "source_sense_id": "4dffaf1b-6da0-3812-8c57-8dc34f8f7b55",
                        "source_sense_description": "lieu d’enseignement lui-même.",
                        "target_lang_word": "boarding school",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boarding school",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                        "entry_id": "992ab997-c3a6-317c-b022-ca7f2c70fc64",
                                        "glosses": [
                                            "A residential school, where the students are housed on-site (the school provides board and lodging as well as education), sometimes involuntarily, typically at a pre-collegiate level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b67162-ef69-404c-ae84-6b23befe05e6",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "[…] a pan-Indian movement based on the successes of the Black Power Movement […] had its roots [in] the 1870-1933 Native American boarding school experiences of their parents and grandparents. It was in these boarding schools where Native language, culture and ceremony would be beaten out of the Native children in order to 'Kill the Indian and Save the Child'."
                                            },
                                            {
                                                "example_id": "1ab3b533-7f3e-4e1b-a48b-fdbbdcf29ad1",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "[…] he looked like the housemaster [Shaun] had so hated during his time at boarding school."
                                            },
                                            {
                                                "example_id": "fa433a7c-c202-4a29-ae9e-4356c94810c0",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "My brother loved his boarding school, and the few months I spent there were some of the happiest times of my life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10402aa9-a2dc-4787-86e5-b81df152aac9",
                        "source_entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                        "source_sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                        "source_sense_description": "Fonction des internes dans un hôpital.",
                        "target_lang_word": "internship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d95fbf19-e57d-35d1-8f99-af59e6ef1f33",
                                        "entry_id": "dfafd301-3702-39f5-91b3-8cf33f333509",
                                        "glosses": [
                                            "A job taken by a student in order to learn a profession or trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9517c3bc-b190-49d7-b895-33009b21a4b2",
                                                "sense_id": "d95fbf19-e57d-35d1-8f99-af59e6ef1f33",
                                                "text": "From the job seeker's point of view, however, it may be best to stay in school for an internship—if you can afford the time and expense. That way, some career advisers say, you can maximize your marketability to get the hottest job at the highest possible salary."
                                            },
                                            {
                                                "example_id": "4fd31975-fe6f-45e7-aed4-58c81f1ca9be",
                                                "sense_id": "d95fbf19-e57d-35d1-8f99-af59e6ef1f33",
                                                "text": "H-2B visas are for unskilled seasonal workers, including landscapers, forestry workers and summer resort workers, while J-1s are for exchange visitors who come for short stays, typically for summer work, brief internships or to be au pairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41cd63c5-e81a-3441-a014-208aa856a16d",
                                        "entry_id": "dfafd301-3702-39f5-91b3-8cf33f333509",
                                        "glosses": [
                                            "A job taken by a student in order to learn a profession or trade.",
                                            "The first year of a medical residency."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
