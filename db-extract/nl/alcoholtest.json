                        "entry_id": "5bf0b973-a4f0-3ad5-97e6-2b38ba6c16b2",
                        "glosses": [
                            "meting waarbij de hoeveelheid ethanol in de adem of het bloed wordt bepaald om vast te stellen hoe sterk iemand nog onder de invloed van sterke drank is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3a5748-5340-4e65-8a67-a10bf3b065be",
                                "sense_id": "8d45e8b7-c009-379d-a788-6cffb286f46b",
                                "text": "Uit een alcoholtest bleek dat hij meer dan twee promille alcohol in zijn bloed had, ruim boven de limiet van een half promille."
                            },
                            {
                                "example_id": "865c4bbe-f092-4db6-bb62-656d093886ab",
                                "sense_id": "8d45e8b7-c009-379d-a788-6cffb286f46b",
                                "text": "Ouders en school organiseren voor- en nafeesten, stuk voor stuk met alcoholtests."
                            }
                        ]
                    },
                    {
                        "sense_id": "05d8c5cc-f808-3eed-ab11-7ca96178e4e0",
                        "entry_id": "5bf0b973-a4f0-3ad5-97e6-2b38ba6c16b2",
                        "glosses": [
                            "simpel meetinstrument om de hoeveelheid ethanol in de adem of het bloed te bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392308b8-00f1-445b-b30d-04505d1d9c98",
                                "sense_id": "05d8c5cc-f808-3eed-ab11-7ca96178e4e0",
                                "text": "Heb je in Nederland alleen een gevarendriehoek in de auto liggen, in veel andere Europese landen zijn ook een verbanddoos, veiligheidshesje en zelfs reservelampjes, alcoholtest of brandblusser verplicht."
                            },
                            {
                                "example_id": "8c0426df-a2df-4bba-9ca4-e20d8791e358",
                                "sense_id": "05d8c5cc-f808-3eed-ab11-7ca96178e4e0",
                                "text": "Tegenwoordig moet Jasper van zijn moeder blazen als hij op stap is geweest. Judith: „Ik heb alcoholtesten gekocht en laat ’m random blazen.”"
                            }
                        ]
                    }
