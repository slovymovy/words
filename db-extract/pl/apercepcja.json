                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apperception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7567f74-1100-3942-a730-338d7ede5bce",
                                        "entry_id": "c6905789-9a32-319d-bf2a-827ca905165a",
                                        "glosses": [
                                            "The mind's perception of itself as the subject or actor in its own states, unifying past and present experiences; self-consciousness, perception that reflects upon itself."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adf4f06e-62c5-3a20-9770-4fe9b9668bb2",
                                        "entry_id": "c6905789-9a32-319d-bf2a-827ca905165a",
                                        "glosses": [
                                            "Psychological or mental perception; recognition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc8e17a-e1f1-4e92-9798-79bc836879a9",
                                                "sense_id": "adf4f06e-62c5-3a20-9770-4fe9b9668bb2",
                                                "text": "Conception is... the simplest act of thinking; it is the apprehension of the universal, as perception is the apperception of the particular."
                                            },
                                            {
                                                "example_id": "146a5814-ac1c-4dad-a39f-29c9f2667fc3",
                                                "sense_id": "adf4f06e-62c5-3a20-9770-4fe9b9668bb2",
                                                "text": "For as she smiled I was gifted a glimpse past the apperception of an anonymous spherical quantity of human flesh; and into the individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e16b70-6a93-3a43-b2dd-f9355fc3ac35",
                                        "entry_id": "c6905789-9a32-319d-bf2a-827ca905165a",
                                        "glosses": [
                                            "The general process or a particular act of mental assimilation of new experience into the totality of one's past experience."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d8e572-2cf0-473e-b8d5-b6d69a4f8f07",
                        "source_entry_id": "5822b230-f55e-3f9f-9e7a-3af78dd1f2fb",
                        "source_sense_id": "723399f3-81fe-392f-aed7-c327d4587d44",
                        "target_lang_word": "Apperzeption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apperzeption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcdb40a4-5167-3e30-8c96-c5d243a7e146",
                                        "entry_id": "355ae7f8-3dc6-3afb-bfae-b71822f33cc2",
                                        "glosses": [
                                            "begrifflich urteilendes Erfassen und Einordnen in einen Bewusstseinszusammenhang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e00f3d9-8b34-42ef-be7f-18ccdf24e622",
                                                "sense_id": "dcdb40a4-5167-3e30-8c96-c5d243a7e146",
                                                "text": "Nur der Mensch besitzt diese letztere Art der Apperzeption, da nur ihm das Vermögen des Verstandes zukommt, mithin das virtuell Eingeborene, was den Tieren gänzlich ermangelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25d03e93-9775-341b-a6c6-68d6b1436063",
                                        "entry_id": "355ae7f8-3dc6-3afb-bfae-b71822f33cc2",
                                        "glosses": [
                                            "bewusste Wahrnehmung von Sinneseindrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2d19bb-2860-484e-945c-2659ebfaf342",
                                                "sense_id": "25d03e93-9775-341b-a6c6-68d6b1436063",
                                                "text": "Apperzipieren wurde hier ganz allgemein in der Bedeutung von „bemerken“ oder „gewahr werden“ gebraucht. In diesem Sinne kann Leibniz sogar den Tieren die Apperzeption zusprechen. Im Anschluß an Lockes Terminologie nennt Leibniz Apperzeption eines äußeren Objektes auch Sensation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
