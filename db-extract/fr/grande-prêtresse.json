                    {
                        "sense_id": "27414c0a-2196-3ee1-9f35-942ccb20eefb",
                        "entry_id": "e6f90a1d-f87b-31a2-ac87-fa81727db510",
                        "glosses": [
                            "Variante orthographique de grande prêtresse."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c5bed309-5bf5-4cbf-b39d-54f95eba936a",
                                "sense_id": "27414c0a-2196-3ee1-9f35-942ccb20eefb",
                                "text": "À la voir nouer lentement les cordons de ses oreillers, d’un air sérieux et pensif, on eût dit d’une grande-prêtresse occupée à quelque mystérieuse fonction dans les sacrifices."
                            },
                            {
                                "example_id": "ab73c92a-673e-482a-93a4-ef85a6d92f60",
                                "sense_id": "27414c0a-2196-3ee1-9f35-942ccb20eefb",
                                "text": "Mais le cadavre donnait l’impression de voir malgré tout, car la tête arrêta de tourner quand elle fut face à la grande-prêtresse. Sa bouche s’ouvrit et un rire creux et lointain en sortit. La grande-prêtresse s’avança."
                            }
                        ]
                    }
