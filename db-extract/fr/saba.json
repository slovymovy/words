                "senses": [
                    {
                        "sense_id": "70fdae25-b535-3f84-a007-bc5e19f8636d",
                        "entry_id": "751a7dcf-ea32-392c-a5a7-009045516cfa",
                        "glosses": [
                            "Royaume du sud de la péninsule arabique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32eedc0-751c-43b7-b894-083bd6f543d5",
                                "sense_id": "70fdae25-b535-3f84-a007-bc5e19f8636d",
                                "text": "Eh ? ne suis-je pas tout à la fois l’infante d’Irlande, la reine de Saba, la reine Thomyris, Vénus et sainte Justine, vierge et martyre ?"
                            },
                            {
                                "example_id": "bef709c0-c5b4-4394-aec2-664f11b0bce6",
                                "sense_id": "70fdae25-b535-3f84-a007-bc5e19f8636d",
                                "text": "Une mission scientifique du gouvernement français faisait au courageux explorateur du pays de Saba un devoir de retourner sur les bords de la mer Rouge et d’étudier en détail les monumens hamyarites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
