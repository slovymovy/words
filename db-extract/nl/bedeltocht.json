                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15fba9e-c91f-45e2-8ee9-b209e7644d01",
                                "sense_id": "8482dbc4-c259-3ceb-a174-e96e81b7503e",
                                "text": "Ze kwam uit een sociaal voelend gezin in Dordrecht. Dat legde de basis voor haar verzet. Ze zong in 1941 bij huiskamerconcerten waarvan de opbrengst naar Joodse gezinnen ging. Daarna zocht ze voor Joodse families onderduikadressen. De bedeltocht op de fiets bracht haar naar de Zeeuwse eilanden."
                            },
                            {
                                "example_id": "9be464c7-bdfc-4052-a9cf-6f31fd530c40",
                                "sense_id": "8482dbc4-c259-3ceb-a174-e96e81b7503e",
                                "text": "Honderdduizend monniken vanuit de hele wereld zijn in het noorden van Bangkok bij elkaar voor een speciale bedeltocht. Dat levert bijzondere plaatjes op. Met de massale bijeenkomst wordt de 72ste verjaardag gevierd van de omstreden abt van de Thaise Wat Phra Dhammakaya-tempel."
                            },
                            {
                                "example_id": "c6d33df3-717c-47fc-bf7c-138d3d1f383a",
                                "sense_id": "8482dbc4-c259-3ceb-a174-e96e81b7503e",
                                "text": "Honderdduizend monniken bijeen voor speciale bedeltocht"
                            }
                        ]
                    }
