                "senses": [
                    {
                        "sense_id": "0f1a1cb3-2dce-38d7-a696-aae0f8ef3948",
                        "entry_id": "dd63a7ff-d726-3967-832f-4ebbaad84eab",
                        "glosses": [
                            "in een tint blauw met RAL-nummer 5009 ( )."
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "b8d11d9f-7855-441a-8339-2c54ebf7895f",
                                "sense_id": "0f1a1cb3-2dce-38d7-a696-aae0f8ef3948",
                                "text": "De zijkant was een egaal azuurblauw vlak."
                            },
                            {
                                "example_id": "862b3af3-6a04-48c9-a04e-889a2ce41edb",
                                "sense_id": "0f1a1cb3-2dce-38d7-a696-aae0f8ef3948",
                                "text": "Hij rijdt in een azuurblauwe auto."
                            },
                            {
                                "example_id": "4d11ec6b-58a5-421e-b8a1-d9758dddecf2",
                                "sense_id": "0f1a1cb3-2dce-38d7-a696-aae0f8ef3948",
                                "text": "Een schitterend hotel met een azuurblauwe zee op de achtergrond contrasteerde heftig met de bakken regen die er in Almere-Buiten uit de lucht vielen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9f5370c-a240-4662-9bdf-c2f95caec5a0",
                        "source_entry_id": "dd63a7ff-d726-3967-832f-4ebbaad84eab",
                        "source_sense_id": "0f1a1cb3-2dce-38d7-a696-aae0f8ef3948",
