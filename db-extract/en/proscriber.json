                        "glosses": [
                            "One who, or that which, proscribes, denounces, or prohibits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c8b7e86-2069-4dc6-9566-b88c986b9405",
                                "sense_id": "c950b2f4-4bd2-3c70-95e8-4c567d722598",
                                "text": "In a period of quiet, he had acquired the name of a man of worth; in darker days, he left the renown of a pitiless proscriber."
                            },
                            {
                                "example_id": "ceff65e8-fe13-44e2-9bc2-3c7f2179853a",
                                "sense_id": "c950b2f4-4bd2-3c70-95e8-4c567d722598",
                                "text": "“In principle,” he declared, “proscription is not only a crime, but a fault; history is full of instances, showing how proscribers have in their turn been forced into the ranks of the proscribed.\""
                            },
                            {
                                "example_id": "1d05f3e5-c2b4-4246-982f-6316791dd96c",
                                "sense_id": "c950b2f4-4bd2-3c70-95e8-4c567d722598",
                                "text": "I made no connection to the fact that the other proscribers of books were Hitler and the Catholic Church."
                            }
                        ]
                    }
                ],
