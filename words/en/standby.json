{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f116ab19-db90-3d7c-81e7-558cbeeb4c53",
                    "sense_definition": "A state of readiness to react or act immediately if needed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "readiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters were put on <w>standby</w> during the high-wind storm.",
                            "target_lang_translations": {
                                "tr": "Şiddetli rüzgarlı fırtına sırasında itfaiyeciler <w>alarm durumuna</w> geçirildi."
                            }
                        },
                        {
                            "text": "The medical team is on <w>standby</w> in case of an emergency.",
                            "target_lang_translations": {
                                "tr": "Tıbbi ekip acil bir durum ihtimaline karşı <w>hazırda beklemektedir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "at the ready"
                    ],
                    "common_phrases": [
                        "on standby"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gerektiğinde derhal tepki verme veya harekete geçme hazır olma durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hazırda bekleme",
                                "target_lang_sense_clarification": "görev veya müdahale için"
                            },
                            {
                                "target_lang_word": "tetikte olma",
                                "target_lang_sense_clarification": "her an harekete geçmeye hazır"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54966815-3726-3127-a058-218ef2125178",
                    "sense_definition": "Something reliable, familiar, or standard that is frequently used or relied upon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This quick pasta dish is an old <w>standby</w> when I do not have time to cook.",
                            "target_lang_translations": {
                                "tr": "Bu hızlı makarna yemeği, yemek yapmaya vaktim olmadığında <w>vazgeçilmez bir kurtarıcıdır</w>."
                            }
                        },
                        {
                            "text": "That local cafe has been a neighborhood <w>standby</w> for decades.",
                            "target_lang_translations": {
                                "tr": "O yerel kafe, onlarca yıldır mahallenin <w>vazgeçilmez mekanlarından biridir</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "old standby"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıkça başvurulan, güvenilir, tanıdık veya standart şey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kurtarıcı",
                                "target_lang_sense_clarification": "sıkça başvurulan pratik şey"
                            },
                            {
                                "target_lang_word": "vazgeçilmez",
                                "target_lang_sense_clarification": "her zaman güvenilen seçenek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41d72234-4200-3c53-bc5c-0372d5824727",
                    "sense_definition": "A person or thing kept in reserve to substitute for someone or something else if necessary.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "readiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theater hired a <w>standby</w> actor to step in if the lead performer fell ill.",
                            "target_lang_translations": {
                                "tr": "Tiyatro, başrol oyuncusu hastalanırsa yerine geçmesi için bir <w>yedek</w> oyuncu kiraladı."
                            }
                        },
                        {
                            "text": "We brought a second generator as a <w>standby</w> for the outdoor event.",
                            "target_lang_translations": {
                                "tr": "Açık hava etkinliği için <w>yedek</w> olarak ikinci bir jeneratör getirdik."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Gerektiğinde bir başkasının yerini almak üzere yedekte tutulan kişi veya nesne."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yedek",
                                "target_lang_sense_clarification": "kişi veya nesne"
                            },
                            {
                                "target_lang_word": "ikame",
                                "target_lang_sense_clarification": "yerini alabilecek araç veya kişi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37f2f061-0f9f-392f-a8a8-d007430990ff",
                    "sense_definition": "A low-power mode in electronic devices when they are not in active use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remember to switch to <w>standby</w> when you finish using the television.",
                            "target_lang_translations": {
                                "tr": "Televizyonu kullanmayı bitirdiğinizde <w>bekleme moduna almayı</w> unutmayın."
                            }
                        },
                        {
                            "text": "The computer enters <w>standby</w> mode automatically after ten minutes of inactivity.",
                            "target_lang_translations": {
                                "tr": "Bilgisayar, on dakika boyunca işlem yapılmadığında otomatik olarak <w>hazırda bekleme</w> moduna geçer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "switch to standby"
                    ],
                    "target_lang_definitions": {
                        "tr": "Elektronik cihazların aktif olarak kullanılmadıklarında geçtiği düşük güç modu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bekleme modu",
                                "target_lang_sense_clarification": "elektronik cihazlarda"
                            },
                            {
                                "target_lang_word": "standby",
                                "target_lang_sense_clarification": "hazırda bekleme konumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5957e21a-370f-3cb8-a5cf-1fb0643674f9",
                    "sense_definition": "The status of waiting for an unreserved seat to become available on a flight or travel service.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since the flight was fully booked, we had to fly <w>standby</w>.",
                            "target_lang_translations": {
                                "tr": "Uçuş tamamen dolu olduğu için <w>yedekten uçmak</w> zorunda kaldık."
                            }
                        },
                        {
                            "text": "Passengers traveling on <w>standby</w> waited near the gate for their names to be called.",
                            "target_lang_translations": {
                                "tr": "<w>Yedek listede</w> seyahat eden yolcular, isimlerinin okunması için kapının yakınında bekledi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fly standby"
                    ],
                    "target_lang_definitions": {
                        "tr": "Uçuş veya ulaşım hizmetinde boş koltuk çıkması için bekleme durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yedek liste",
                                "target_lang_sense_clarification": "uçuş veya yolculukta boş yer bekleme"
                            },
                            {
                                "target_lang_word": "bekleme listesi",
                                "target_lang_sense_clarification": "bilet almadan boş yer bekleme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b247e28e-1972-33fd-b1a1-432f5ba94e6b",
                    "sense_definition": "To wait briefly or hold on, especially during telephone or radio communications.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>standby</w> while I transfer your call to the manager.",
                            "target_lang_translations": {
                                "tr": "Aramanızı müdüre aktarırken lütfen <w>hatta kalın</w>."
                            }
                        },
                        {
                            "text": "The pilot was instructed to <w>standby</w> for further instructions from control.",
                            "target_lang_translations": {
                                "tr": "Pilota, kontrol merkezinden gelecek ek talimatlar için <w>beklemede kalması</w> talimatı verildi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle telefon veya radyo görüşmelerinde kısa bir süre beklemek veya hattı tutmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hatta kalmak",
                                "target_lang_sense_clarification": "telefonda beklemek"
                            },
                            {
                                "target_lang_word": "beklemede kalmak",
                                "target_lang_sense_clarification": "talimat veya bağlantı beklemek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}