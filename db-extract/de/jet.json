                "senses": [
                    {
                        "sense_id": "1e9f7809-47de-34d2-9e0d-ff95f94bc401",
                        "entry_id": "85d7d109-ae36-357a-98f5-5baa8f17c830",
                        "glosses": [
                            "Flugzeug mit Strahltriebwerk"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "4250f3e4-08a8-4cac-aee8-1578e2e6768e",
                                "sense_id": "1e9f7809-47de-34d2-9e0d-ff95f94bc401",
                                "text": "Sie flogen Kurzstrecken mit einem Jet."
                            },
                            {
                                "example_id": "ff02465b-75ab-42c0-82aa-c5a592772f61",
                                "sense_id": "1e9f7809-47de-34d2-9e0d-ff95f94bc401",
                                "text": "„In zwei Jahren solle die Wiener Basis auf 14 bis 15 Mittelstrecken-Flieger und in fünf Jahren auf 30 Jets wachsen, sagte IAG-Chef Willie Walsh am Dienstag zum Start der neuen Billigfluglinie mit zunächst vier Flugzeugen.“"
                            },
                            {
                                "example_id": "96fe5ddf-e09c-445f-a6f1-ec574d415087",
                                "sense_id": "1e9f7809-47de-34d2-9e0d-ff95f94bc401",
                                "text": "„Bei Jane’s geht man von etwa 370 Jets aus, von denen nur ein Teil jederzeit flugfähig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d7f9341-9baa-477e-b386-ee97d91b66c7",
                        "source_entry_id": "85d7d109-ae36-357a-98f5-5baa8f17c830",
                        "source_sense_id": "1e9f7809-47de-34d2-9e0d-ff95f94bc401",
                        "source_sense_description": "Luftfahrt: Flugzeug mit Strahltriebwerk",
                        "target_lang_word": "jet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2015cc8a-a93a-37cf-bc65-4e939595c343",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "A collimated stream, spurt or flow of liquid or gas from a pressurized container, an engine, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615dca8c-434e-4481-a833-55051c92347b",
                                                "sense_id": "2015cc8a-a93a-37cf-bc65-4e939595c343",
                                                "text": "In the floor of the valley the line passes hills of fantastic shape, like sleeping camels and inverted washbasins, and you can see the beautiful lakes Naivasha and Elementeita; at Eburru jets of steam spurt out of the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1c3e8d-7a46-3b47-b897-13ed89f01ade",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "A spout or nozzle for creating a jet of fluid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f63b393e-61ac-36b4-a1de-4d022c69e8d7",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "A type of airplane using jet engines rather than propellers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdca9657-3d50-46bf-8272-5d4c1a85459d",
                                                "sense_id": "f63b393e-61ac-36b4-a1de-4d022c69e8d7",
                                                "text": "One of the other two nations to operate the F-35B, the United Kingdom, has had US versions of the jet operating off its HMS Queen Elizabeth aircraft carrier."
                                            },
                                            {
                                                "example_id": "65e3b789-2cad-4d21-9357-3cceac020783",
                                                "sense_id": "f63b393e-61ac-36b4-a1de-4d022c69e8d7",
                                                "text": "“Rather than writing off both jets as a loss … teams made a bold decision in 2022 to remove the nose from AF-27 and put it onto AF-211 to maximize savings and add back an operational aircraft to the fleet,” a report from the F-35 JPO said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a325af4d-00ab-3c61-9d6d-9cd11cddb8e8",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "An engine that propels a vehicle using a stream of fluid as propulsion.",
                                            "A turbine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9008297b-064a-3c64-bf9a-99ce74d818e8",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "An engine that propels a vehicle using a stream of fluid as propulsion.",
                                            "A rocket engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c7105e5-751a-336d-b9e8-5d3f89ba956a",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "A part of a carburetor that controls the amount of fuel mixed with the air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53b523b5-400f-34c2-b44e-a11ab6305da2",
                                        "entry_id": "465e427a-e74f-3b9e-b552-e2d258a3c08a",
                                        "glosses": [
                                            "A narrow cone of hadrons and other particles produced by the hadronization of a quark or gluon."
                                        ],
                                        "tags": [],
