                        "cross_references": [
                            {
                                "target_word": "indirect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92514f87-6277-3fa7-8c96-6d42d7b5f945",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Not direct"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a394e6f-6908-4a2c-b9da-32ce82df137d",
                                                "sense_id": "92514f87-6277-3fa7-8c96-6d42d7b5f945",
                                                "text": "While not mentioning any of their competitors by name, the CEO made some indirect statements that they were acting immorally."
                                            },
                                            {
                                                "example_id": "e3047bd5-d9cf-42df-94c7-c76bf159e1e5",
                                                "sense_id": "92514f87-6277-3fa7-8c96-6d42d7b5f945",
                                                "text": "Se asked him some indirect questions to ascertain whether he was single."
                                            },
                                            {
                                                "example_id": "40813d50-ea4c-41e5-8a46-55869d469964",
                                                "sense_id": "92514f87-6277-3fa7-8c96-6d42d7b5f945",
                                                "text": "Indirect messages permit communicative contacts when, without them, the alternatives would be total inhibition, silence, and solitude on the one hand, or, on the other, communicative behavior that is direct, offensive, and hence forbidden. This is a painful choice. In actual practice, neither alternative is likely to result in the gratification of personal or sexual needs. In this dilemma, indirect communications provide a useful compromise. As an early move in the dating game, the young man might invite the young woman to dinner or to the movies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78a4c3b-2710-3d29-9a3b-d471477b0fbf",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Not direct:",
                                            "Not of obvious or immediate cause, but as a secondary result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0b6c48-dea2-473d-9807-f7cc1730e499",
                                                "sense_id": "e78a4c3b-2710-3d29-9a3b-d471477b0fbf",
                                                "text": "The direct result of socialising every day in the bars may be happiness and meeting new people, but the indirect results could be addiction, or even poverty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a229b7bf-0fd5-3008-98f8-14782f720575",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Not direct:",
                                            "Not focused straight at the target or subject; whose true aim appears secondary or obscure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a441bbe-19cf-3214-9586-96c8d11efb37",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Not direct:",
                                            "Not involving the quickest, shortest, or most convenient path; oblique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3ccb3b-f610-4229-a133-5de250edfab7",
                                                "sense_id": "1a441bbe-19cf-3214-9586-96c8d11efb37",
                                                "text": "In an effort to beat the traffic jams, they opted to take an indirect route to their destination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607b4b75-5a5b-3daa-96b0-ef523a148e46",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Not direct:",
                                            "Employing argument by contradiction; making use the law of the excluded middle; arguing via the contrapositive."
                                        ],
                                        "tags": [
                                            "of a proof"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aea4161-f958-358d-8d0a-f2d06c4bd059",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Figuratively"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85b76790-bf5a-3fba-b0e8-3bd735b339e4",
                                        "entry_id": "91e4ab14-b9f4-3f76-a602-123987ef67eb",
                                        "glosses": [
                                            "Figuratively",
                                            "Not straightforward, fair, or honest; corrupt."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f72116-f1a6-4784-b296-e42612ccd862",
                                                "sense_id": "85b76790-bf5a-3fba-b0e8-3bd735b339e4",
                                                "text": "Did you, by indirect, and forced courſes / Subdue, and poyſon this tong Maides affections? / Or came it by requeſt, and ſuch faire queſtion / As ſoule, to ſoule affordeth?"
                                            }
