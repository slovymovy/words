                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c22303de-04dc-3af3-9705-28a42cc17296",
                        "entry_id": "6f667103-b7ae-316c-b7dc-2d3b523910b4",
                        "glosses": [
                            "A person who assigns codes or classifications."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77846a8-ff01-4f3b-b45a-5327e93ce5e7",
                                "sense_id": "c22303de-04dc-3af3-9705-28a42cc17296",
                                "text": "Others may be subjective ratings made by the coders who independently read the studies, such as sex stereotype of the job […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "89779bbd-f276-3fcf-8f0e-0f8aecf7a3ad",
                        "entry_id": "6f667103-b7ae-316c-b7dc-2d3b523910b4",
                        "glosses": [
                            "A programmer (computer programmer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6db1a8c-1d42-44ca-96ec-4cd00bf8125e",
                                "sense_id": "89779bbd-f276-3fcf-8f0e-0f8aecf7a3ad",
                                "text": "Part of the series' goal was to change how coders are perceived -- and show the community that it offers."
                            },
                            {
                                "example_id": "1457b24e-9a75-4b04-a06a-751e3b749221",
                                "sense_id": "89779bbd-f276-3fcf-8f0e-0f8aecf7a3ad",
                                "text": "Reshma Saujani is not a coder but she's empowering \"an army of young women\" to take on tech's gender gap through her nonprofit Girls Who Code."
                            }
                        ]
                    }
                ],
