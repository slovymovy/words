                "senses": [
                    {
                        "sense_id": "900f37dc-d0fd-3dc3-b012-7db9f6c5a42a",
                        "entry_id": "6eadec51-43d4-38b8-ac69-d92e88937511",
                        "glosses": [
                            "für die Vereinten Nationen (UN) tätiger Beobachter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c89fad5-eda6-46ee-b7df-97f3667a5562",
                                "sense_id": "900f37dc-d0fd-3dc3-b012-7db9f6c5a42a",
                                "text": "„Nach Berichten eines französischen UN-Beobachters, Leutnant Petite, kam es nach dem Fall der Stadt zu umfangreichen, systematischen Plünderungen durch die jüdische Armee, bei denen Möbel, Kleidung und alles mitgenommen wurde, was für neue jüdische Einwanderer nützlich sein und die Rückkehr der Flüchtlinge erschweren konnte.“"
                            },
                            {
                                "example_id": "3dc01c04-21d5-485d-85fa-f53b7cbba97b",
                                "sense_id": "900f37dc-d0fd-3dc3-b012-7db9f6c5a42a",
                                "text": "„Die Taliban und die islamischen Parteien Pakistans, welche die Taliban unterstützen, erklärten daraufhin, sie würden jeden UN-Beobachter töten, der sich an die pakistanisch-afghanische Grenze wage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
