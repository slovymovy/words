                                "target_senses": [
                                    {
                                        "sense_id": "e2df0d25-e20a-32f4-b58a-53a8761e096e",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Layperson, someone who is not an ordained cleric or member of the clergy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Someone who is not a professional in a given field."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258bf4c0-6f15-4d22-8e39-d4c1d2bf8704",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "Carmen is not a professional anthropologist, but strictly a layman."
                                            },
                                            {
                                                "example_id": "046f792f-708c-49b4-83a0-1f9cdb9670e8",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "Let me explain it to you [[in layman's terms|in layman's terms]]."
                                            },
                                            {
                                                "example_id": "35ec6305-91dc-4b6c-94eb-f131df4b838f",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "The layman, perhaps, is not fully aware to what extent even the popular reputations of scientists and scholars are made by that class and are inevitably affected by its views on subjects which have little to do with the merits of the real achievements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "228ab784-fa94-35ad-9b74-3c0e8592a809",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "A common person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c13e6a98-131d-31ff-a5a1-d075779aa846",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "A person who is untrained or lacks knowledge of a subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07406d2b-3a54-4beb-943c-ab0f40b63ab7",
                                                "sense_id": "c13e6a98-131d-31ff-a5a1-d075779aa846",
                                                "text": "should he be held to be just a layman, or does he have some art?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f7c41e-0f4f-33d1-8cbd-a2e6e889bc0e",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Lay-sister or lay-brother, person received into a convent of monks, following the vows, but not being member of the order."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e09c6e-c43f-410a-9e13-de701bd40255",
                        "source_entry_id": "abf98652-f7ad-35da-9845-555a188c5ee9",
                        "source_sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                        "source_sense_description": "durchschnittlicher Mensch",
                        "target_lang_word": "monsieur Tout-le-monde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monsieur Tout-le-monde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ab0b72-cb3a-3c52-9dba-bb0405974e36",
                                        "entry_id": "d4208fd1-3bce-33a2-8c5d-200b162b3f21",
                                        "glosses": [
                                            "N’importe qui, une personne quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c9a28b-9dd9-413e-9efe-f3acf9c9ff08",
                                                "sense_id": "d2ab0b72-cb3a-3c52-9dba-bb0405974e36",
                                                "text": "On voit mal comment on peut exiger de monsieur Tout-le-Monde l’usage d’un vocabulaire donné plutôt qu’un autre."
                                            },
                                            {
                                                "example_id": "4b6a18d9-84a6-4454-893e-2975cf12c2ce",
                                                "sense_id": "d2ab0b72-cb3a-3c52-9dba-bb0405974e36",
                                                "text": "N'est-ce pas le propre de monsieur Tout-le-monde que de se croire au-dessus de la mêlée ?"
                                            },
                                            {
                                                "example_id": "0fb8b11a-3c6f-41d7-beb5-72e2727c1683",
                                                "sense_id": "d2ab0b72-cb3a-3c52-9dba-bb0405974e36",
                                                "text": "— Voilà ce qui nous rend meilleurs que tous ces ternes, ces messieurs Tout-le-Monde, ces balourds, les non-créateurs, qui se contentent d'absorber la lumière au lieu de la refléter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1588e720-0fdf-40e3-bb31-605f8720dbf1",
                        "source_entry_id": "abf98652-f7ad-35da-9845-555a188c5ee9",
                        "source_sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                        "source_sense_description": "durchschnittlicher Mensch",
                        "target_lang_word": "madame Tout-le-monde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madame Tout-le-monde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6603d24-8ed4-3bd2-8ca6-1e4fe9730eb4",
                                        "entry_id": "afd49706-142f-31ba-8ffe-4a09c690aa67",
                                        "glosses": [
                                            "N’importe qui, une personne quelconque."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23642beb-72ee-4a84-a3fe-181ca51f3b37",
                                                "sense_id": "b6603d24-8ed4-3bd2-8ca6-1e4fe9730eb4",
                                                "text": "Ainsi, derrière des apparences de madame Tout le Monde, une madame Irma sommeillait en elle en guide fétiche. Celle-ci se matérialisait le plus souvent par un instinct sans faille qui allait parfois à contre-courant de la raison pure."
                                            },
                                            {
                                                "example_id": "11dd0042-8339-488f-b5fc-4d9d30a38612",
                                                "sense_id": "b6603d24-8ed4-3bd2-8ca6-1e4fe9730eb4",
                                                "text": "Pour lui, le vrai problème est que \"monsieur, madame Tout-le-Monde\" ne peut simplement pas se permettre l'achat d'un véhicule électrique."
                                            },
                                            {
                                                "example_id": "8bf97abd-a993-48e7-ba9a-ff69acb7ad7c",
                                                "sense_id": "b6603d24-8ed4-3bd2-8ca6-1e4fe9730eb4",
                                                "text": "Monsieur et madame Tout-le-Monde entendent ça et se disent (non sans raison) : « Si le gouvernement nous permet de voyager, c’est que la situation n’est pas très dangereuse. Car si elle était dangereuse, les autorités nous interdiraient d’effectuer des voyages non essentiels, comme elles l’ont déjà fait… »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
