                        "glosses": [
                            "zeer eiwitrijke, op kwark lijkende ongerijpte kaas van niet geperste wrongel, met een frisse smaak"
                        ],
                        "tags": [
                            "wikidata: hüttenkäse"
                        ],
                        "examples": [
                            {
                                "example_id": "a12a8dc1-0bb1-4f8d-be4c-aa9b20085a18",
                                "sense_id": "48a2a77e-c606-3f48-9615-2bed3f0a8181",
                                "text": "Gezond eten vind ik leuk. Op school noemen ze het vaak konijnenvoer als ik rucola en hüttenkäse bij me heb op een volkoren cracker."
                            }
                        ]
                    }
                ],
