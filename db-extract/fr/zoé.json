                                    {
                                        "sense_id": "90040adf-867d-34e0-8b74-3376914e8162",
                                        "entry_id": "ac1c1716-f4dc-3223-8394-6b5b2fee6692",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673d629b-4335-4765-a723-2b9a636aa4fd",
                                                "sense_id": "90040adf-867d-34e0-8b74-3376914e8162",
                                                "text": "\"Zoë!\" The high-born girl repeated her own name in genuine astonishment. / \"Yes,\" replied the negress. \"Rustan is very affectionate. He says that I am his Zoë, his \"life\", because he would surely die of starvation without me.\""
                                            },
                                            {
                                                "example_id": "987aa84f-d7c0-4d41-83f8-6b46620da85a",
                                                "sense_id": "90040adf-867d-34e0-8b74-3376914e8162",
                                                "text": "On August 16, 2014, a 24-year-old male programmer posted a more than 9,000-word tirade about the dissolution of his relationship with video game developer Zoë Quinn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7faa8cd2-89eb-4f64-b144-3fc6ed5397c9",
                        "source_entry_id": "14250109-ba45-3ad1-b2cc-e0166036a8da",
