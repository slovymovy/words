{
    "word_family": [
        "treatment",
        "treatable",
        "mistreat",
        "maltreat",
        "entreat",
        "treatise",
        "treaty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5580c6ff-f11c-3b2a-8451-4b67dbc5f936",
                    "sense_definition": "To handle, deal with or behave towards in a specific way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>treat</w> everyone with respect regardless of their background.",
                            "target_lang_translations": {
                                "ru": "Важно <w>относиться</w> ко всем с уважением, независимо от их происхождения."
                            }
                        },
                        {
                            "text": "You <w>treated</w> me like a fool during the meeting yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на собрании ты <w>обращался</w> со мной как с дураком."
                            }
                        }
                    ],
                    "synonyms": [
                        "handle"
                    ],
                    "common_phrases": [
                        "treat with respect",
                        "treat fairly",
                        "treat like a"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться с кем-либо или чем-либо определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "к кому-либо"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "с кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e281e639-ff02-3d0b-9b19-82e775e88218",
                    "sense_definition": "To entertain with food or drink, especially at one's own expense; to show hospitality to; to pay for as celebration or reward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hospitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I've done so well this month, I'll <w>treat</w> you all to dinner tonight.",
                            "target_lang_translations": {
                                "ru": "У меня были такие успехи в этом месяце, что сегодня вечером я <w>угощаю</w> всех ужином."
                            }
                        },
                        {
                            "text": "My husband <w>treated</w> me to a Paris holiday for our anniversary.",
                            "target_lang_translations": {
                                "ru": "Муж <w>подарил</w> мне поездку в Париж на нашу годовщину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treat someone to",
                        "treat yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угощать едой или напитками, часто за свой счет; проявлять гостеприимство или оплачивать что-то в качестве награды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать",
                                "target_lang_sense_clarification": "кого-либо чем-либо"
                            },
                            {
                                "target_lang_word": "угостить",
                                "target_lang_sense_clarification": "сделать подарок или оплатить счет"
                            },
                            {
                                "target_lang_word": "радовать",
                                "target_lang_sense_clarification": "чем-то приятным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad650156-3826-37dc-86c0-f65e7a661ce4",
                    "sense_definition": "To care for medicinally or surgically; to apply medical care to.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors <w>treated</w> me for malaria after I returned from my trip.",
                            "target_lang_translations": {
                                "ru": "Врачи <w>лечили</w> меня от малярии после того, как я вернулся из поездки."
                            }
                        },
                        {
                            "text": "We <w>treated</w> firefighters suffering from smoke inhalation by giving them oxygen.",
                            "target_lang_translations": {
                                "ru": "Мы <w>оказывали помощь</w> пожарным, пострадавшим от вдыхания дыма, давая им кислород."
                            }
                        }
                    ],
                    "synonyms": [
                        "leech",
                        "make better"
                    ],
                    "common_phrases": [
                        "treat for",
                        "treat a patient",
                        "treat a wound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать медицинскую помощь; лечить болезнь или рану."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечить",
                                "target_lang_sense_clarification": "проводить процесс лечения"
                            },
                            {
                                "target_lang_word": "вылечить",
                                "target_lang_sense_clarification": "излечить полностью"
                            },
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "рану или повреждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f8fa195-e478-3864-9bfe-c68306539c1b",
                    "sense_definition": "To discourse on; to represent or deal with in a particular way, in writing or speaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article <w>treated</w> feminism as a quintessentially modern movement.",
                            "target_lang_translations": {
                                "ru": "В статье феминизм <w>трактовался</w> как типично современное движение."
                            }
                        },
                        {
                            "text": "The documentary <w>treats</w> the subject of climate change with great urgency.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм <w>рассматривает</w> тему изменения климата как крайне насущную."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treat as",
                        "treat the subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать или излагать тему определенным образом в речи или письме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трактовать",
                                "target_lang_sense_clarification": "истолковывать тему"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "анализировать вопрос"
                            },
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "в прессе или литературе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad9e45a3-c4b9-3ffe-bd7e-fb71b20dcbf4",
                    "sense_definition": "To subject to a chemical or other action; to act upon with a specific scientific result in mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>treated</w> the substance with sulphuric acid to see the reaction.",
                            "target_lang_translations": {
                                "ru": "Он <w>обработал</w> вещество серной кислотой, чтобы увидеть реакцию."
                            }
                        },
                        {
                            "text": "The wood was <w>treated</w> with a special chemical to prevent rot.",
                            "target_lang_translations": {
                                "ru": "Древесина была <w>пропитана</w> специальным химикатом для предотвращения гниения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treat with",
                        "chemically treated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать химическому или иному воздействию для достижения определенного результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "вещество или материал"
                            },
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "специальным составом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f08840d9-bc4b-3a54-a9c9-f53aacd02357",
                    "sense_definition": "To negotiate, discuss terms, bargain (for or with).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassadors were sent to <w>treat</w> with the enemy for a peace agreement.",
                            "target_lang_translations": {
                                "ru": "Послы были отправлены, чтобы <w>вести переговоры</w> с врагом о мирном соглашении."
                            }
                        },
                        {
                            "text": "Is there any in this rout with authority to <w>treat</w> with me?",
                            "target_lang_translations": {
                                "ru": "Есть ли в этой толпе кто-нибудь, наделенный властью <w>договариваться</w> со мной?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "treat with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести переговоры, обсуждать условия или договариваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести переговоры",
                                "target_lang_sense_clarification": "о мире или условиях"
                            },
                            {
                                "target_lang_word": "договариваться",
                                "target_lang_sense_clarification": "с противником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f153a3-28dc-3c36-b50e-07c900f93f8d",
                    "sense_definition": "To entreat or beseech (someone).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only let my family live, I <w>treat</w> thee.",
                            "target_lang_translations": {
                                "ru": "Только сохрани жизнь моей семье, <w>умоляю</w> тебя."
                            }
                        },
                        {
                            "text": "He began to <w>treat</w> his captors for mercy.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>молить</w> своих похитителей о пощаде."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умолять или слезно просить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "о пощаде"
                            },
                            {
                                "target_lang_word": "заклинать",
                                "target_lang_sense_clarification": "высокий стиль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1061aaf9-137a-3034-afeb-56c11c45f24a",
                    "sense_definition": "An entertainment, outing, food, drink, or other indulgence provided by someone for the enjoyment of others.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took the kids to the zoo for a <w>treat</w> after they finished their exams.",
                            "target_lang_translations": {
                                "ru": "В качестве <w>поощрения</w> я сводил детей в зоопарк после того, как они сдали экзамены."
                            }
                        },
                        {
                            "text": "Going to the cinema was a real <w>treat</w> for the family.",
                            "target_lang_translations": {
                                "ru": "Поход в кино стал настоящим <w>праздником</w> для всей семьи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a real treat",
                        "for a treat",
                        "my treat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развлечение, прогулка или угощение, организованное для удовольствия других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "еда или напитки"
                            },
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "приятное времяпрепровождение"
                            },
                            {
                                "target_lang_word": "праздник",
                                "target_lang_sense_clarification": "особенное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "983cb5e0-647b-3732-9d8c-f0782889f603",
                    "sense_definition": "A snack food, often sweet or special.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These coconut and marshmallow <w>treats</w> are very easy to make.",
                            "target_lang_translations": {
                                "ru": "Эти кокосовые <w>лакомства</w> с маршмэллоу очень легко приготовить."
                            }
                        },
                        {
                            "text": "The children were given sweet <w>treats</w> after they finished their dinner.",
                            "target_lang_translations": {
                                "ru": "Детям дали <w>сладости</w> после того, как они закончили ужинать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweet treats",
                        "healthy treats"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лакомство, часто сладкое или особенное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакомство",
                                "target_lang_sense_clarification": "вкусная еда"
                            },
                            {
                                "target_lang_word": "сладость",
                                "target_lang_sense_clarification": "десерт"
                            },
                            {
                                "target_lang_word": "вкусняшка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee7fdf5-7902-3e59-8a6f-1c5367ea8827",
                    "sense_definition": "A snack food item designed to be given to pets.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I lured the cat into her carrier by throwing a couple of <w>treats</w> in there.",
                            "target_lang_translations": {
                                "ru": "Я заманил кошку в переноску, бросив туда пару <w>вкусняшек</w>."
                            }
                        },
                        {
                            "text": "The dog sat patiently waiting for his favorite liver <w>treat</w>.",
                            "target_lang_translations": {
                                "ru": "Пес терпеливо сидел в ожидании своего любимого печеночного <w>лакомства</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dog treats",
                        "cat treats"
                    ],
                    "target_lang_definitions": {
                        "ru": "Корм или лакомство, предназначенное для домашних животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакомство",
                                "target_lang_sense_clarification": "для питомцев"
                            },
                            {
                                "target_lang_word": "вкусняшка",
                                "target_lang_sense_clarification": "для собаки или кошки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b8bd1a-4a61-374c-a369-4cbba40bf4f0",
                    "sense_definition": "An unexpected gift, event etc., which provides great pleasure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was such a <w>treat</w> to see her back in action on the London stage.",
                            "target_lang_translations": {
                                "ru": "Было таким <w>удовольствием</w> снова увидеть ее на лондонской сцене."
                            }
                        },
                        {
                            "text": "Listening to the orchestra play live was an absolute <w>treat</w>.",
                            "target_lang_translations": {
                                "ru": "Слушать живое выступление оркестра было истинным <w>наслаждением</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "an absolute treat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданный подарок или событие, доставляющее огромное удовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подарок",
                                "target_lang_sense_clarification": "судьбы или приятный сюрприз"
                            },
                            {
                                "target_lang_word": "наслаждение",
                                "target_lang_sense_clarification": "редкая возможность"
                            },
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "приятное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aeabcad-0048-3173-8cb7-fd84d8eec37d",
                    "sense_definition": "A parley or discussion of terms; a negotiation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The generals entered into a <w>treat</w> to discuss the surrender of the city.",
                            "target_lang_translations": {
                                "ru": "Генералы вступили в <w>переговоры</w>, чтобы обсудить сдачу города."
                            }
                        },
                        {
                            "text": "The long <w>treat</w> between the two nations finally resulted in a ceasefire.",
                            "target_lang_translations": {
                                "ru": "Долгие <w>обсуждения</w> между двумя странами в конечном итоге привели к прекращению огня."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now usually replaced by 'treaty' or 'negotiation'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переговоры или обсуждение условий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переговоры",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "08b635a2-b008-3478-87f5-7af55e9499c2",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Robert <w>Treat</w> was a colonial leader and governor of the Connecticut Colony.",
                            "target_lang_translations": {
                                "ru": "Роберт <w>Трит</w> был колониальным лидером и губернатором колонии Коннектикут."
                            }
                        },
                        {
                            "text": "The <w>Treat</w> family has lived in this region for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Трит</w> живет в этом регионе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Трит",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}