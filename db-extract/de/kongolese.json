                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ff4a3db-943a-3e57-8975-67cd96e7e5f5",
                        "entry_id": "3fed3e5c-45ea-3033-b0b7-859d45d09397",
                        "glosses": [
                            "Staatsbürger der Republik Kongo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a7c36e-fe2f-482e-92d9-363bff2dc518",
                                "sense_id": "0ff4a3db-943a-3e57-8975-67cd96e7e5f5",
                                "text": "Unter den Studenten war kein Kongolese."
                            },
                            {
                                "example_id": "ed6eed82-fde0-4104-8f6c-b1d5f48db9ab",
                                "sense_id": "0ff4a3db-943a-3e57-8975-67cd96e7e5f5",
                                "text": "„Schließlich übernehmen die Kongolesen die Zuschreibungen selbst, und so sammelt sich hier ideologischer Brennstoff für die blutigen Rivalitäten und Bürgerkriege, die Afrika bis ins 20. Jahrhundert verheeren werden.“"
                            },
                            {
                                "example_id": "e8eb17f4-e03c-444c-b06b-fe344ab4e2ec",
                                "sense_id": "0ff4a3db-943a-3e57-8975-67cd96e7e5f5",
                                "text": "„Auch die Kongolesen profitieren ein wenig von dem Reichtum, den ihr Land produziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af8a84d7-ee23-369f-825f-f36d012b617a",
                        "entry_id": "3fed3e5c-45ea-3033-b0b7-859d45d09397",
                        "glosses": [
                            "Staatsbürger der Demokratischen Republik Kongo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45836f9-bc38-4a0b-b8b0-57477b614d8d",
                                "sense_id": "af8a84d7-ee23-369f-825f-f36d012b617a",
                                "text": "Unter den Studenten war kein Kongolese."
                            },
                            {
                                "example_id": "14173010-88de-4993-ae99-16e831086649",
                                "sense_id": "af8a84d7-ee23-369f-825f-f36d012b617a",
                                "text": "„Schließlich übernehmen die Kongolesen die Zuschreibungen selbst, und so sammelt sich hier ideologischer Brennstoff für die blutigen Rivalitäten und Bürgerkriege, die Afrika bis ins 20. Jahrhundert verheeren werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f3d4372-4417-4a6b-ac5f-2087b8a8bee7",
                        "source_entry_id": "3fed3e5c-45ea-3033-b0b7-859d45d09397",
