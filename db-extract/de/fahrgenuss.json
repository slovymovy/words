                "senses": [
                    {
                        "sense_id": "2e2237e2-e09b-355a-8762-27aa1d8112ab",
                        "entry_id": "3ca6cb08-4e03-3dc5-b0e1-07ae16bdb502",
                        "glosses": [
                            "Wohlbehagen, Freude, die jemand beim Fahren eines Fahrzeuges empfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8911a5-0ae9-47c9-8458-b0e7c065ce83",
                                "sense_id": "2e2237e2-e09b-355a-8762-27aa1d8112ab",
                                "text": "„Der wahre Fahrgenuss auf der Landstraße liegt in der ausgewogenen Kombination von geringem Gewicht und adäquater Motorleistung.“"
                            },
                            {
                                "example_id": "6bb954ff-7211-4b10-99b9-bd04d8c69930",
                                "sense_id": "2e2237e2-e09b-355a-8762-27aa1d8112ab",
                                "text": "„Dass sehr hohe Geschwindigkeiten eher ein Ausdauertraining der Nackenmuskulatur darstellen als Fahrgenuss bringen, versteht sich auf einem Nakedbike von selbst.“"
                            },
                            {
                                "example_id": "ce0fc1bb-91e4-4198-a012-7337cfd643b6",
                                "sense_id": "2e2237e2-e09b-355a-8762-27aa1d8112ab",
                                "text": "„Nach seiner Tagesbestzeit am Freitag blieb ihm im dritten Freien Training der Fahrgenuss auf dem 5,554 Kilometer langen Kurs fast gänzlich verwehrt.“"
                            },
                            {
                                "example_id": "0e837539-93d6-49c7-9ecf-3290e18b38c0",
                                "sense_id": "2e2237e2-e09b-355a-8762-27aa1d8112ab",
                                "text": "„In eine ähnliche Richtung, zumindest was entspannten Fahrgenuss angeht, zielt die BT 1100 Bulldog, in welcher sich der sportliche Komfort der TDM und die Motorcharakteristik eines Choppers vereinen.“"
                            }
                        ],
