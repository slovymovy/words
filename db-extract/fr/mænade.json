                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8efca0e-d437-4595-8af6-ee45776d60a1",
                                "sense_id": "9689717d-cbbe-3573-a5a2-db0841c62552",
                                "text": "Débris d’une figure de mænade dont les bras sont ornés de bracelets , et qui n’est reconnaissable qu’à sa nébris et à un reste dé thyrse qu’elle tient de la main gauche."
                            },
                            {
                                "example_id": "0d0ac635-b7ae-46f2-9ed8-73c26e4cd539",
                                "sense_id": "9689717d-cbbe-3573-a5a2-db0841c62552",
                                "text": "Mais un gros crabe tourteau parut à son tour sur la scène , et le pauvre petit mænade dut se hâter de battre en retraite pour échapper à ses redoutables pinces."
                            }
                        ],
