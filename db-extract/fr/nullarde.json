                        "sense_id": "377d80ce-f9c6-38e0-a809-f33bbe919b11",
                        "entry_id": "282faf93-0e42-3d23-99a0-08a501cc5228",
                        "glosses": [
                            "Femme sans talent, incompétente ou ignorante."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "766e3cc9-a901-4131-8e58-f5603c1e6de1",
                                "sense_id": "377d80ce-f9c6-38e0-a809-f33bbe919b11",
                                "text": "Socialement, j’étais considérée comme une nullarde, un rebut, mais tout en moi indiquait que j’avais tiré le gros lot."
                            },
                            {
                                "example_id": "2771f910-c51b-4153-9a50-1276ea5a4733",
                                "sense_id": "377d80ce-f9c6-38e0-a809-f33bbe919b11",
                                "text": "Cette nullarde de Nicole et ses copines y viennent de temps en temps."
                            },
                            {
                                "example_id": "9459ac72-ea01-4369-b5af-2dcc4129bf92",
                                "sense_id": "377d80ce-f9c6-38e0-a809-f33bbe919b11",
                                "text": "De prime abord, Moore l’avait reléguée dans la catégorie des nullardes coincées dont la virginité resterait intacte jusqu’à ce qu'un comptable bedonnant et palot ([…]) survienne et l’amène à céder de haute lutte […]."
                            }
                        ]
                    }
