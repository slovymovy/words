                        "source_sense_id": "c9cf5e67-824d-398c-9ff6-3143bf772471",
                        "source_sense_description": "Oberflächenform von Felsen, die durch die Gleitbewegung, das Gewicht eines Gletschers und darin eingelagertes Gestein abgeschliffen (z.B. poliert, gekratzt) wurden.",
                        "target_lang_word": "glacial polish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glacial polish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63a3c6e2-31d5-3d5b-ac47-159886da6371",
                                        "entry_id": "cf8ed4cc-28ca-3ca2-889f-1daa299ecff1",
                                        "glosses": [
                                            "The appearance of rock after having been worn smooth by a passing glacier."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd0492d-1ce3-4dae-ad84-63490962e213",
                                                "sense_id": "63a3c6e2-31d5-3d5b-ac47-159886da6371",
                                                "text": "Tenaya Lake was at one time under as much as 2,460 feet of glacial ice that produced a pressure of about 74 tons per square foot and extensive glacial polish (fig. 18)."
                                            },
                                            {
                                                "example_id": "5495035e-cacb-4417-9ffb-4c35fe9f95b8",
                                                "sense_id": "63a3c6e2-31d5-3d5b-ac47-159886da6371",
                                                "text": "Glacial polish on lee surfaces may reflect this sorting."
                                            },
                                            {
                                                "example_id": "a5008b07-477a-450d-82f4-fe27599421d2",
                                                "sense_id": "63a3c6e2-31d5-3d5b-ac47-159886da6371",
                                                "text": "However, in Canada and Northern Europe—where they are known collectively as \"shields\"—the basement formations stretch out in the lowlands, smoothed by glacial polish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
