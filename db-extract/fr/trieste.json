                                                "sense_id": "baecfa5d-017c-3bc9-8c20-1445938c07ab",
                                                "text": "„Triest mit seinem Tiefwasserhafen ist heute, wie vor 1918, ein maritimes Tor für Norditalien, Deutschland, Österreich und Zentraleuropa, […].“"
                                            },
                                            {
                                                "example_id": "23db2a15-c6b4-460e-8161-eef9bf87c017",
                                                "sense_id": "baecfa5d-017c-3bc9-8c20-1445938c07ab",
                                                "text": "„Ich entschied mich für Ancona, weil von dort täglich ein Schiff nach Triest abging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
