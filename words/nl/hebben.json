                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to include or feature"
                            },
                            {
                                "target_lang_word": "contain",
                                "target_lang_sense_clarification": "to have within"
                            },
                            {
                                "target_lang_word": "feature",
                                "target_lang_sense_clarification": "to have as a distinct part"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "обладать свойством или частью"
                            },
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "находиться или присутствовать"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "включать в себя"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "comporter ou posséder comme caractéristique"
                            },
                            {
                                "target_lang_word": "comporter",
                                "target_lang_sense_clarification": "comprendre comme élément"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d356a484-bbcb-3b25-96cd-1f1c37b36186",
                    "sense_definition": "In een familierelatie staan tot iemand.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <heeft> drie kinderen en twee kleinkinderen.",
                            "target_lang_translations": {
                                "en": "He <has> three children and two grandchildren.",
                                "ru": "У него <есть> трое детей и двое внуков.",
                                "fr": "Il <w>a</w> trois enfants et deux petits-enfants."
                            }
                        },
                        {
                            "text": "Zij <heeft> een broer die in het buitenland woont.",
                            "target_lang_translations": {
                                "en": "She <has> a brother who lives abroad.",
                                "ru": "У нее <есть> брат, который живет за границей.",
                                "fr": "Elle <w>a</w> un frère qui vit à l'étranger."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a family relationship with someone.",
                        "ru": "Состоять в родственных отношениях с кем-либо.",
                        "fr": "Avoir un lien de parenté avec quelqu'un."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to be related to"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "о родственниках"
                            },
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "в конструкции 'у кого-то есть'"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "en parlant de relations familiales"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fccf2ec-3fec-3b20-a59d-e210382d042c",
                    "sense_definition": "Lijden aan een ziekte, pijn of ongemak.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan niet komen werken want ik <heb> griep.",
                            "target_lang_translations": {
                                "en": "I cannot come to work because I <have> the flu.",
                                "ru": "Я не могу прийти на работу, потому что я <болею> гриппом.",
                                "fr": "Je ne peux pas venir travailler car j' <w>ai</w> la grippe."
                            }
                        },
                        {
                            "text": "Hij <heeft> vreselijke hoofdpijn na die lange vergadering.",
                            "target_lang_translations": {
                                "en": "He <has> a terrible headache after that long meeting.",
                                "ru": "У него ужасно <болит> голова после этого долгого собрания.",
                                "fr": "Il <w>a</w> un terrible mal de tête après cette longue réunion."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pijn hebben",
                        "honger hebben",
                        "dorst hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "To suffer from an illness, pain, or discomfort.",
                        "ru": "Страдать от болезни, боли или дискомфорта.",
                        "fr": "Souffrir d'une maladie, d'une douleur ou d'un inconfort."
                    },
