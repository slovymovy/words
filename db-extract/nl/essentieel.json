                "senses": [
                    {
                        "sense_id": "9283f0af-02eb-323e-9572-347ae3c9d41c",
                        "entry_id": "ace3eb89-1f14-3490-a627-fe7311049050",
                        "glosses": [
                            "zeer belangrijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2fac901-4e00-4443-8afe-a4098ddaabe8",
                                "sense_id": "9283f0af-02eb-323e-9572-347ae3c9d41c",
                                "text": "Een essentiële eigenschap van dit WikiWoordenboek is dat iedereen kan bijdragen."
                            },
                            {
                                "example_id": "5d51c11d-1310-47be-9625-ab23feaee810",
                                "sense_id": "9283f0af-02eb-323e-9572-347ae3c9d41c",
                                "text": "Soms zag ik Banjo in een dorp voorbij vliegen op zijn kleine skateboard, met zijn lange haar wapperend in de wind. Sommige dingen zijn nou eenmaal essentieel om bij je te hebben op de trail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe4780ab-a6f1-46ff-b2a5-7a7c76cec137",
                        "source_entry_id": "ace3eb89-1f14-3490-a627-fe7311049050",
                        "source_sense_id": "9283f0af-02eb-323e-9572-347ae3c9d41c",
                        "source_sense_description": "zeer belangrijk",
                        "target_lang_word": "essential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Necessary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0400433d-ca30-4c44-a52a-c81c283851a5",
                                                "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                                "text": "There’s canker at the root, your seed\nDenies the blessing of the sun,\nThe light essential to your need.\nYour hopes are murdered and undone."
                                            },
                                            {
                                                "example_id": "5c280d43-8fb6-44e8-965c-c5e59d207ebc",
                                                "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                                "text": "Thus, research-based resources with the potential to assist teachers prepare secondary students for tertiary education are essential."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ea2595-247b-37e3-ba87-c47a7afc7057",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Very important; of high importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313fc8d4-f73a-4925-9f53-5acb851a4f7f",
                                                "sense_id": "e9ea2595-247b-37e3-ba87-c47a7afc7057",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. Essential public services are cut so that the rich may pay less tax. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e30e97-aeaa-31c5-93de-5fde9e358b19",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Necessary for survival but not synthesized by the organism, thus needing to be ingested."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd46c99f-d0bd-3a87-8938-8458f877b820",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Being in the basic form; showing its essence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56be631-e0cb-4272-864e-bd3c439a9689",
                                                "sense_id": "fd46c99f-d0bd-3a87-8938-8458f877b820",
                                                "text": "Don’t mind him being grumpy. That’s the essential Fred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742dc728-f2a4-3a72-9b50-f86263537629",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Really existing; existent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a035378-5adb-4acf-8371-679d8ed0eaca",
                                                "sense_id": "742dc728-f2a4-3a72-9b50-f86263537629",
                                                "text": "Or is it true, that thou art but a bare name, / And no eſſential thing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54550533-c3ef-3a32-a6bf-7abdea58ae69",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Such that each complementary region is irreducible, the boundary of each complementary region is incompressible by disks and monogons in the complementary region, and no leaf is a sphere or a torus bounding a solid torus in the manifold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17fcb53f-a310-3a4c-b32f-ea59b29108a9",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Idiopathic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb96e963-5851-4021-95b2-46085a191184",
                                                "sense_id": "17fcb53f-a310-3a4c-b32f-ea59b29108a9",
                                                "text": "essential blepharospasm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dcb0a2d-a4a1-337e-b118-43f2f034b2b0",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Having the nature of essence; not physical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9f7dc2d-7b5b-4d31-917c-8bdafc49c7b5",
                                                "sense_id": "4dcb0a2d-a4a1-337e-b118-43f2f034b2b0",
                                                "text": "It is usually allowed that there is the natural body, as St. Paul called it, which is dissolved at death, and the etheric or spiritual body which survives and functions upon an etheric plane. Those are the essential things. But we may really have as many coats as an onion and there may be a mental body which may shed itself at any spot where great mental or emotional strain has been experienced."
                                            }
                                        ]
                                    }
                                ]
                            },
