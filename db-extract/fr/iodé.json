                ],
                "senses": [
                    {
                        "sense_id": "42d8f16a-a5d8-3b34-8c4e-52b7c1e0e1db",
                        "entry_id": "910cde97-f175-36d1-b5b1-9bb38e99c750",
                        "glosses": [
                            "Qui contient de l’iode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7c491e-08ec-4474-9604-5e64d9d36f50",
                                "sense_id": "42d8f16a-a5d8-3b34-8c4e-52b7c1e0e1db",
                                "text": "On panse ensuite, selon les cas, avec du digestif ordinaire, de l'onguent égyptiac, de la teinture d’aloès, le sulfate de cuivre, la liqueur de Villate, la teinture d’iode, l’acide phénique, la poudre de sublimé, la glycérine iodée au tiers."
                            },
                            {
                                "example_id": "e54b6893-5d4e-47fa-870f-f18287219641",
                                "sense_id": "42d8f16a-a5d8-3b34-8c4e-52b7c1e0e1db",
                                "text": "La ficoïde, presque inconnue, est une variété de salade très rare, appréciée pour sa saveur iodée."
                            },
                            {
                                "example_id": "5bc69a15-9d61-4e92-97ca-efddde78e700",
                                "sense_id": "42d8f16a-a5d8-3b34-8c4e-52b7c1e0e1db",
                                "text": "Elle entreprend une drôle de danse, qui tient du pogo et du swing en braillant à tue-tête: «L'air iodé, voilà ce qu'il me fallait.»"
                            }
                        ]
                    }
