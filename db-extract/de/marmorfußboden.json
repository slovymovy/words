                "senses": [
                    {
                        "sense_id": "0f4ff3d0-5012-32cf-a03a-23fa07bbd3a9",
                        "entry_id": "eef405de-a56f-351a-807a-1cd018df9c90",
                        "glosses": [
                            "Fußboden aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4e740d-93ab-4dcf-af67-7fc5a779e7a9",
                                "sense_id": "0f4ff3d0-5012-32cf-a03a-23fa07bbd3a9",
                                "text": "„Bevor General Zia ins Army House Einzug gehalten hatte, war der Raum mit dem Marmorfußboden und den mahagonigetäfelten Wänden mit Büchern zur Militärgeschichte und den Porträts seiner Vorgänger bestückt gewesen.“"
                            },
                            {
                                "example_id": "524b3f27-0c35-43e9-a248-ddac7170ae32",
                                "sense_id": "0f4ff3d0-5012-32cf-a03a-23fa07bbd3a9",
                                "text": "„John fing sie unter den Achseln auf, zog sie über den Marmorfußboden und kniete sich schützend über sie, die Waffe auf das heruntergefallene Standbild gerichtet.“"
                            },
                            {
                                "example_id": "9fd8b752-233a-4970-b68c-3cd1a2e48648",
                                "sense_id": "0f4ff3d0-5012-32cf-a03a-23fa07bbd3a9",
                                "text": "„Anson stand auf dem geheizten Marmorfußboden vor dem großen Spiegel des absurd überdimensionierten Badezimmers seiner Suite im Peninsula Hotel in New York und führte Selbstgespräche.“"
                            },
                            {
                                "example_id": "dc8b07dc-9bdc-4dce-8fc6-0cb486b795fe",
                                "sense_id": "0f4ff3d0-5012-32cf-a03a-23fa07bbd3a9",
                                "text": "„Der ältere Polizist runzelt die Stirn, steht auf, wobei er mit den Stuhlbeinen über den Marmorfußboden kratzt, und drängt seinen Partner, ihm zu folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
