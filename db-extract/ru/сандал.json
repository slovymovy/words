                    }
                ],
                "senses": [
                    {
                        "sense_id": "d602f136-3701-3b92-8185-fbe5480e9fcc",
                        "entry_id": "f83305a8-5cb3-336f-8a25-ddec9a69e90c",
                        "glosses": [
                            "вечнозелёное тропическое дерево с ароматической, богатой эфирными маслами древесиной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe177f8-b94f-4a3f-89f6-389666a82f68",
                                "sense_id": "d602f136-3701-3b92-8185-fbe5480e9fcc",
                                "text": "Гунашарман подбросил в огонь сухие ветви карникары ― дерева, цветы которого лишены запаха, и кору сандала, чей душистый аромат стесняет дыхание."
                            }
                        ]
                    },
                    {
                        "sense_id": "68fa5ecc-eff0-3241-b8ca-68e630777cf0",
                        "entry_id": "f83305a8-5cb3-336f-8a25-ddec9a69e90c",
                        "glosses": [
                            "устар. растительный пигмент, получаемый из древесины этого и некоторых других деревьев, а также краситель на его основе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb83aefa-7890-42c2-99c1-64f9b6f9624b",
                                "sense_id": "68fa5ecc-eff0-3241-b8ca-68e630777cf0",
                                "text": "В былые дни, до открытия искусственных органических красок, сандал был весьма популярен среди красильщиков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7f2fc05-2f85-4d3a-8b42-2b46c824e91e",
                        "source_entry_id": "f83305a8-5cb3-336f-8a25-ddec9a69e90c",
                        "target_lang_word": "sandalwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandalwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a17a95-f20c-3871-befb-9c40642cd420",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "Any of various tropical trees of the genus Santalum, native or long naturalized in India, Australia, Hawaii, and many south Pacific islands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "The aromatic heartwood of these trees used in ornamental carving, in the construction of insect-repellent boxes and chests, and as a source of certain perfumes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d4410f-a978-4737-8dcc-fe7259bb973f",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "You ſhall put in a little bag the Powder of Sandalwood with the aforeſaid well-ſcenting Spices, and heart-ſtrengthening Powders, and lay it warm upon the left breaſt."
                                            },
                                            {
                                                "example_id": "92f03927-39b6-47c7-afd6-2bc5bd58b103",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "The branches of the white cedar will keep off moths when placed amongst clothes or furs. Boxes of red cedar (cedar of Lebanon) will do the same, as also sandalwood."
                                            },
                                            {
                                                "example_id": "909a4f21-8a68-488c-95d4-568ef46c191c",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "Sandalwood is a favorite cosmetic with Burmese ladies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecbe13d0-c050-4cad-b45e-19026ba5a32c",
                        "source_entry_id": "f83305a8-5cb3-336f-8a25-ddec9a69e90c",
                        "target_lang_word": "sándalo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sándalo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f72785fc-411a-3b67-8471-10848ce4ca24",
                                        "entry_id": "a5842420-1bf8-3273-ad8f-64ed1b9c595c",
                                        "glosses": [
                                            "(Santalum album) Árbol de hoja perenne originario de Oceanía, de 4 a 9 metros de altura, hojas elípticas opuestas, duramen verde pálido, y madera amarillenta de buen olor. Puede vivir hasta los 100 años. Parasita las raíces de otras especies de árboles pero sin gran perjuicio."
                                        ],
                                        "tags": [
                                            "árboles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e36bb26-9eac-4488-b288-f7bfc0e2280c",
                                                "sense_id": "f72785fc-411a-3b67-8471-10848ce4ca24",
                                                "text": "En 1967, unos británicos descubrieron que el aceite de madera de sándalo que se hallaba en algunos cosméticos para el cutis y en las cremas solares, provocaba fotoalergias"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "230a32ed-91ef-4810-814c-83618ed46ce9",
                        "source_entry_id": "f83305a8-5cb3-336f-8a25-ddec9a69e90c",
                        "target_lang_word": "santal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "santal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7cf3407-aca4-323c-bef0-37d19a4bb16b",
                                        "entry_id": "9cec28b6-c53d-3a26-bc49-27e3330d4d55",
                                        "glosses": [
                                            "Arbre de petite taille, à feuilles opposées, à fleurs hermaphrodites, qui pousse en Extrême-Orient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce41983f-395a-427e-a6af-59dd4faf6146",
                                                "sense_id": "d7cf3407-aca4-323c-bef0-37d19a4bb16b",
                                                "text": "Le santal, bel arbre d’Inde et des îles Chaudes, croît spontanément à Mysore, Madras, Java, Sumatra, Bornéo, en Nouvelle-Calédonie et en Australie."
                                            },
                                            {
                                                "example_id": "bfdcf38f-0866-4913-8346-6900bd76148f",
                                                "sense_id": "d7cf3407-aca4-323c-bef0-37d19a4bb16b",
                                                "text": "C’est ainsi que la cérémonie se déroula le matin, à l’ombre des santals, sous lesquels une table avait été dressée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465ace19-72c6-3c9d-ba1b-3901da9792fd",
                                        "entry_id": "9cec28b6-c53d-3a26-bc49-27e3330d4d55",
                                        "glosses": [
                                            "Bois de cet arbre, qui est odoriférant, dont on fait de petits meubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe9332f-0015-414d-8732-c300dc979f22",
                                                "sense_id": "465ace19-72c6-3c9d-ba1b-3901da9792fd",
                                                "text": "Un étui, un coffret de santal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7883e9d-e995-3649-a918-57e2c90ee421",
                                        "entry_id": "9cec28b6-c53d-3a26-bc49-27e3330d4d55",
                                        "glosses": [
                                            "Parfum tiré de ce bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42cfdbf-6fcb-494b-a460-5eb6616a0d78",
                                                "sense_id": "f7883e9d-e995-3649-a918-57e2c90ee421",
                                                "text": "De l’essence de santal."
                                            },
                                            {
                                                "example_id": "e15d69a7-71bd-4d10-ab3e-b9705d398fff",
                                                "sense_id": "f7883e9d-e995-3649-a918-57e2c90ee421",
                                                "text": "Il serrait les paupières pour ne pas la voir. Mais il ne pouvait fuir l’odeur de chevelure noire, de peau échauffée, de santal qu’exhalent les brunes saines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "santal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a1c0dc-ba64-3e97-85c5-b21f77483e5d",
                                        "entry_id": "e00687f5-19fd-35a6-ac12-2b9ac62373fb",
                                        "glosses": [
                                            "Langue du groupe munda de la famille des langues austroasiatiques, apparentée à la langue ho et au mundari, parlée par les Santâls ou Santâlîs, un groupe d’aborigènes de l’Inde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
