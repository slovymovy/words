                "senses": [
                    {
                        "sense_id": "6900900a-fc3c-3e01-bd81-9acee2a7607f",
                        "entry_id": "91b08d5e-62d8-3781-84c7-abba0ff571f8",
                        "glosses": [
                            "Philosophe grec né vers 371 et mort vers 288 av J.-C, de son vrai nom Tyrtame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "581da270-a866-40ef-bd28-499e0a302a56",
                                "sense_id": "6900900a-fc3c-3e01-bd81-9acee2a7607f",
                                "text": "Une si belle éducation prodiguée aux jeunes gens de l’Attique se communiquait sans jalousie aux cités rivales. Théophraste avait deux mille disciples ; les écoles de rhétorique durent être encore plus nombreuses que celles de philosophie ; et les élèves se succédant avec rapidité, répandaient la gloire de leurs maîtres partout où l’on connaissait la langue et le nom des Grecs."
                            }
                        ]
                    }
