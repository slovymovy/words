                    {
                        "sense_id": "ac0910ef-7b22-3f8d-8967-fa28efe2f3d5",
                        "entry_id": "c3020832-9d59-324c-afeb-5c4aa97c3a00",
                        "glosses": [
                            "een aaneengesloten deel van een oppervlak dat gekleurd is met één kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d129f834-fcc0-4e5d-8c49-c4e3db0fda83",
                                "sense_id": "ac0910ef-7b22-3f8d-8967-fa28efe2f3d5",
                                "text": "Intrigerend zijn vier werken die uit verschillende kleurvlakken bestaan. Rosseel: ,,Wanneer je een zoekterm invoert zie je voordat de foto geladen is vaak dit soort vlakken op je scherm. Soms zegt één kleurvlak al genoeg om je de volledige foto te doen herinneren.”"
                            },
                            {
                                "example_id": "8a6cde7f-dc18-40d1-bc47-81c8ef6851d8",
                                "sense_id": "ac0910ef-7b22-3f8d-8967-fa28efe2f3d5",
                                "text": "De grootte van het kleurvlak geeft aan in hoeverre de gezonde doelstellingen worden gehaald. Wanneer je op het onderdeel klikt verschijnt er ook een percentage in beeld."
                            }
                        ]
                    }
