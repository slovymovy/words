                        "glosses": [
                            "With porridge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f00737-803f-4675-8b5a-cc3175096bef",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "A drenched, big-chested girl, her sodden T-shirt clinging to her large breasts, led him forward by a porridgy hand, put him on the stool and sat squadgily on his lap."
                            },
                            {
                                "example_id": "46a552b3-9e44-4b04-a1a6-ed141de12e01",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "She wiped a porridgy hand on the back of her jeans, adding another streak to the existing collage."
                            },
                            {
                                "example_id": "a1f108e6-3cfe-4646-8535-cd182f8f77c5",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "Trying to get some porridge inside rather than outside of Jamie – an endeavour in which the little boy, as usual, was proving to be no help at all – Ellie grimaced. […] Jamie beamed a porridgy smile when he saw his mother."
                            },
                            {
                                "example_id": "9ce42952-e7ec-4564-a53b-b17d6902c2c0",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "We were sent to change our aprons and have a break at nine-thirty, by which time I was as hollow as if I’d not eaten a vast porridgy breakfast a couple or so hours ago."
                            },
                            {
                                "example_id": "f877f70b-b6a8-458c-89e6-0074a099f82c",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "She scooped a spoonful of sieved porridge from the nursery bowl, and offered it to baby Adrian, who was sitting in his high chair next to her. His mouth made a very serious and deliberate O as he took the food and swilled it round his mouth. Then he smiled a lovely gummy, porridgy smile at her."
                            },
                            {
                                "example_id": "1337c2ce-eec5-4899-929d-b9c70d22711d",
                                "sense_id": "0ce189c6-a9fd-31f4-a799-43836b4a39ab",
                                "text": "Porridgy breakfast-time chatter skitters up the stairs."
                            }
                        ]
