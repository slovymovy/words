                        "entry_id": "22d1b215-b0be-37ee-8ab9-cd4df3bbd77b",
                        "glosses": [
                            "Force qui attire ; attirance."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "1ee1e1ce-5591-475e-ae32-b4a8084a96bf",
                                "sense_id": "f2d4f721-5f1c-3891-baa8-79160daf5d60",
                                "text": "... je me suis surpris à avoir presque peur de l’attirement que produit le tournoiement des grandes machines, l’action enveloppante de l’engrenage : cela a quelque chose de la fascination du vide."
                            }
                        ]
                    },
