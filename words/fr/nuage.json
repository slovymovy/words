                    "frequency": "Middle",
                    "semantic_group_id": "obscurcissement_figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un léger <w>nuage</w> de mélancolie a traversé son regard au souvenir du passé."
                        },
                        {
                            "text": "Leur amitié de longue date s'est poursuivie sans le moindre <w>nuage</w>."
