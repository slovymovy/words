                ],
                "senses": [
                    {
                        "sense_id": "859de0e2-a518-3044-831b-6d1f66e84282",
                        "entry_id": "65b08f87-1c1f-3861-9b5c-72a94f01fada",
                        "glosses": [
                            "middel dat defaecatie veroorzaakt en daardoor de darmen en het lichaam zou reinigen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "31734178-1dcf-4349-8708-14d0e62bc736",
                                "sense_id": "859de0e2-a518-3044-831b-6d1f66e84282",
                                "text": "Mijn Universalium is een betere hartversterker dan het fijnste tonicum en reinigt de ingewanden milder dan het zachtste purgeermiddel. Het werkt afdoende tegen opgeblazenheid, verlicht de pijnen van kraambed en maandstonden en bestrijdt de scheurbuik die onze zeevaarders kwelt."
                            },
                            {
                                "example_id": "f3d01305-b973-4720-beb6-d0d5406cdcff",
                                "sense_id": "859de0e2-a518-3044-831b-6d1f66e84282",
                                "text": "'Mijn beste Ewing, je Worm is in doodsstrijd & stoot de allerlaatste druppels van zijn gif uit! Je moet dit purgeermiddel drinken om zijn verkalkte resten te verdrijven. Je zal erop inslapen, maar als je wakker wordt, is de Worm die jou zo heeft gekweld eruit! Het einde van je lijden is nabij."
                            },
                            {
                                "example_id": "2116c894-0737-43b2-bda1-29b83a391f9c",
                                "sense_id": "859de0e2-a518-3044-831b-6d1f66e84282",
                                "text": "Bovendien ondergaan de vaste gasten ook minder aangename behandelingen, met braakdrankjes en heilzame vloeistoffen in de anus (purgeermiddel), de penis of de vagina gegoten worden, en zelfs bloedzuigers als bloedzuiveraars worden niet geschuwd."
                            }
                        ]
                    }
