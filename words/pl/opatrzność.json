                    "sense_definition": "opieka Boga lub siły wyższej nad ludźmi i światem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religia_los",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierzący ufają, że boska <w>opatrzność</w> czuwa nad ich losem każdego dnia.",
                            "target_lang_translations": {
                                "en": "Believers trust that divine <w>providence</w> watches over their fate every day."
                            }
                        },
                        {
                            "text": "Tylko szczęśliwy zbieg okoliczności i <w>opatrzność</w> uratowały go z tego wypadku.",
                            "target_lang_translations": {
                                "en": "Only a fortunate coincidence and <w>providence</w> saved him from that accident."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boska opatrzność",
                        "czuwanie opatrzności",
                        "z wyroku opatrzności"
