                            {
                                "example_id": "b6ccb531-4148-4a9f-8086-ceca3f20e669",
                                "sense_id": "7dfb699b-6270-35f1-8b1c-c52a2d2064e6",
                                "text": "En mathématiques, un matroïde uniforme est un matroïde dont chaque permutation des éléments est une symétrie."
                            },
                            {
                                "example_id": "0ab5512c-a78f-4672-8f2c-3ba52747f76d",
                                "sense_id": "7dfb699b-6270-35f1-8b1c-c52a2d2064e6",
                                "text": "La fin de la démonstration du théorème nous précise la structure d’un matroïde régulier plan."
                            }
                        ]
                    }
