                            "target_lang_translations": {
                                "ru": "Мой друг <Чейз> придет сегодня на ужин.",
                                "zh": "我的朋友<w>蔡斯</w>今晚要来吃晚饭。"
                            }
                        },
                        {
                            "text": "<Chase> was excited to start his new job at the bank.",
                            "target_lang_translations": {
                                "ru": "<Чейз> был рад начать свою новую работу в банке.",
                                "zh": "<w>蔡斯</w>很兴奋能开始他在银行的新工作。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя собственное (мужское или женское).",
                        "zh": "中性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чейз",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蔡斯",
                                "target_lang_sense_clarification": "人名音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fda4ae8-75e1-32a6-8d13-0d958404814c",
                    "sense_definition": "A surname originally derived from a nickname for a hunter.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name_person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Dr. <Chase> will see you now regarding your appointment.",
                            "target_lang_translations": {
                                "ru": "Доктор <Чейз> примет вас сейчас по поводу вашего визита.",
                                "zh": "<w>蔡斯</w>医生现在可以见您，讨论您的预约事宜。"
                            }
                        },
                        {
                            "text": "The <Chase> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <Чейз> живет в этом городе уже несколько поколений.",
                                "zh": "<w>蔡斯</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, первоначально произошедшая от прозвища охотника.",
                        "zh": "源自猎人绰号的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чейз",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蔡斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50bee15f-e2ac-3800-8d96-7b16db0cb1b3",
