            "senses": [
                {
                    "sense_id": "f77aaa57-fc50-3acf-b1e2-4100c1a151db",
                    "sense_definition": "Living, nesting, or spending most of one's life in trees.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tree_dwelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many species of monkeys are strictly <w>arboreal</w> and rarely descend to the ground.",
                            "target_lang_translations": {
                                "ru": "Многие виды обезьян ведут исключительно <w>древесный</w> образ жизни и редко спускаются на землю."
                            }
                        },
                        {
                            "text": "The zoologist spent months studying the habits of <w>arboreal</w> animals in the rain forest.",
                            "target_lang_translations": {
                                "ru": "Зоолог провел месяцы, изучая повадки <w>древесных</w> животных в тропическом лесу."
