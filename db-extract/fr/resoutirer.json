                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ffb6b1-f19e-4865-8003-489975824183",
                                "sense_id": "21d0d561-546e-3062-9bcb-813b2f3ee797",
                                "text": "Aussi, en Bourgogne, chaque année, dans les mois de mars et de septembre, on soutire et resoutire pour avoir le vin clair."
                            },
                            {
                                "example_id": "52e46470-ba5f-496f-8f05-26298e334e8b",
                                "sense_id": "21d0d561-546e-3062-9bcb-813b2f3ee797",
                                "text": "Je vais sans doute resoutirer une fois dans une semaine et une dernière fois dans 3 semaines avant d'embouteiller."
                            }
                        ]
                    }
