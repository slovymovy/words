                        "sense_id": "fb43cd32-2997-331a-ba3e-0cb45315eaa5",
                        "entry_id": "0c39cc9f-5a63-3de2-9f9e-26cb6f28576c",
                        "glosses": [
                            "Répartir les impôts fonciers de manière proportionnelle aux biens de chaque contribuable."
