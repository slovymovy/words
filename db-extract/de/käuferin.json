                        "glosses": [
                            "weibliche Person, die gegen Bezahlung etwas in Besitz nimmt, etwas kauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56413c96-af34-424e-8ea1-df2dc7c3a995",
                                "sense_id": "8a589dcc-d49f-3bc5-963f-bc4992694ffe",
                                "text": "Erst nach zehn Jahre dauernden Verkaufsversuchen hat sich eine Käuferin für die Liegenschaft gefunden."
                            }
                        ],
