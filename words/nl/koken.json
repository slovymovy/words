                {
                    "sense_id": "b874c1c8-925a-320b-a7d1-fb3b65cacd22",
                    "sense_definition": "Zeer woedend zijn en dit nauwelijks kunnen inhouden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kookte</w> van woede toen hij de onterechte beschuldiging hoorde.",
                            "target_lang_translations": {
                                "en": "He <w>seethed</w> with rage when he heard the unjust accusation.",
                                "ru": "Он <w>кипел</w> от ярости, когда услышал несправедливое обвинение.",
                                "pl": "On <w>kipiał</w> ze wściekłości, kiedy usłyszał niesprawiedliwe oskarżenie.",
                                "de": "Er <w>kochte</w> vor Wut, als er die ungerechtfertigte Anschuldigung hörte.",
                                "fr": "Il <w>bouillonnait</w> de colère lorsqu'il a entendu l'accusation injuste.",
                                "it": "<w>Bolliva</w> di rabbia quando ha sentito l'accusa ingiusta.",
                                "cs": "Když uslyšel to nespravedlivé obvinění, <w>vřel</w> vzteky.",
                                "tr": "Haksız suçlamayı duyduğunda öfkeden <w>küplere bindi</w>.",
                                "es": "Él <w>hervía</w> de rabia cuando escuchó la acusación injusta.",
                                "zh": "当听到那项不公正的指控时，他<w>怒火中烧</w>。"
                            }
                        },
                        {
                            "text": "Vanbinnen <w>kookte</w> ze, maar ze bleef uiterlijk kalm.",
                            "target_lang_translations": {
                                "en": "She was <w>seething</w> inside, but she remained outwardly calm.",
                                "ru": "Внутри она <w>кипела</w>, но внешне оставалась спокойной.",
                                "pl": "Wewnątrz się <w>gotowała</w>, ale na zewnątrz pozostała spokojna.",
                                "de": "In ihrem Inneren <w>kochte</w> sie, aber äußerlich blieb sie ruhig.",
                                "fr": "Intérieurement, elle <w>bouillait</w>, mais elle restait calme en apparence.",
                                "it": "Dentro di sé <w>bolliva</w>, ma fuori rimaneva calma.",
                                "cs": "Uvnitř <w>pěnila</w> vzteky, ale navenek zůstala klidná.",
                                "tr": "İçten içe <w>köpürüyordu</w> ama dışarıdan sakin kaldı.",
                                "es": "Por dentro <w>hervía de rabia</w>, pero por fuera se mantuvo tranquila.",
                                "zh": "她内心<w>气得发抖</w>，但外表依然保持冷静。"
                            }
                        }
