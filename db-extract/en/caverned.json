                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df07dbd-2c65-442a-b2f1-006d900a8f0b",
                                "sense_id": "d06702d6-62da-34de-b7f9-786fdbc3e9f9",
                                "text": "No Bandit fierce, no Tyrant mad with pride, / No cavern'd Hermit, reſt ſelf-ſatisfy'd; / Who moſt to ſhun or hate mankind pretend, / Seek an Admirer, or wou'd fix a Friend."
                            },
                            {
                                "example_id": "6a5f6002-6367-4277-a5ec-97aeb4e6303a",
                                "sense_id": "d06702d6-62da-34de-b7f9-786fdbc3e9f9",
                                "text": "[…] he will heed as little the lofty generous enterprises that kindle upon the moral world, as a caverned bear the luminous expanse of the glittering heaven."
                            }
                        ]
                    }
