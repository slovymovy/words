                "senses": [
                    {
                        "sense_id": "87baa3b9-0f82-384e-bb7b-d2fec1b9db42",
                        "entry_id": "df9446d9-7c4f-3c18-b4b1-6bebd49515b2",
                        "glosses": [
                            "Wissenschaft, die die sich mit dem Einfluss des Klimas auf Nutzpflanzen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17303134-902d-469e-aa1d-a20e8781aa81",
                                "sense_id": "87baa3b9-0f82-384e-bb7b-d2fec1b9db42",
                                "text": "„Angewandt wird die Agrarklimatologie vor allem für die langfristige Planung eines standortgerechten Kulturanbaus.“"
                            },
                            {
                                "example_id": "ec7dcb4c-f458-48f8-99ae-eed9b8867f7d",
                                "sense_id": "87baa3b9-0f82-384e-bb7b-d2fec1b9db42",
                                "text": "„Die Agrarklimatologie förderte er durch Aufdeckung der Zusammenhänge zwischen den Ernteerträgen Norddeutschlands und den Schwankungen des Golfstroms.“"
                            },
                            {
                                "example_id": "07387112-972c-4912-96db-8999458a2651",
                                "sense_id": "87baa3b9-0f82-384e-bb7b-d2fec1b9db42",
                                "text": "„Die in der Agrarklimatologie häufig vorhandene und oft zitierte Vorstellung ist die einer Umströmung von Gehölzen analog zu Gebäuden, basierend auf der Beobachtung, dass im Lee von Schutzpflanzungen eine Temperaturerhöhung auftritt.“"
                            },
                            {
                                "example_id": "fde2e3a3-ad45-433d-9316-b37875d74702",
                                "sense_id": "87baa3b9-0f82-384e-bb7b-d2fec1b9db42",
                                "text": "„Er wurde zum Chef der Agrarklimatologie beim nationalen Wetterdienst ernannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
