        "nl-extract.jsonl": [
            {
                "entry_id": "fc8f9164-bdf2-3076-9e9a-8ffc09c66cda",
                "word": "uitpoepen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "09403e62-61a1-3221-934d-ad258f195c3b",
                        "entry_id": "fc8f9164-bdf2-3076-9e9a-8ffc09c66cda",
                        "glosses": [
                            "in grote hoeveelheden inferieure producten maken; onzin uitkramen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4b4a44a8-ece2-49aa-a3f4-1fcc790e1519",
                                "sense_id": "09403e62-61a1-3221-934d-ad258f195c3b",
                                "text": "Begin vorig jaar barstte de bom. Hij raakte zijn nieuwe tv-programma BAAS Raymann kwijt door een gebrek aan kijkers, had geen inspiratie voor iets nieuws op de planken. ,,Ik bleef maar tv-formules uitpoepen om bij de NPO te kunnen aankloppen, maar ze vonden het telkens niet goed genoeg. Het werd ineens heel stil en ik raakte goed in paniek.’’"
                            }
                        ]
                    },
                    {
                        "sense_id": "21c3004a-227d-335e-aa62-28e11ab36e6f",
                        "entry_id": "fc8f9164-bdf2-3076-9e9a-8ffc09c66cda",
                        "glosses": [
                            "door defeceren verwijderen uit het lichaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be306f0b-c8b7-4f10-968e-040062d9af16",
                                "sense_id": "21c3004a-227d-335e-aa62-28e11ab36e6f",
                                "text": "Zwijgend scheppen ze. Klaas trekt met een schaper de kippenstront en veren onder de stellingen uit. Wilma schuift het tot hopen pluimen met poep. De 17.000 biologische leghennen van Wilma en Klaas van de Heuvel volgen een detox-kuur. ,,We hopen dat ze het fipronil letterlijk uitpoepen. Goede kippen laat je toch niet vergassen?’’"
                            },
                            {
                                "example_id": "826b6a4d-0a9e-4dbc-88fd-867d3bed0ce1",
                                "sense_id": "21c3004a-227d-335e-aa62-28e11ab36e6f",
                                "text": "Zo kunnen ze meer melken, terwijl hun dieren op papier maar half zoveel fosfaat uitpoepen. Een relatief makkelijke truc, omdat de registratiesystemen van beide landen niet direct aan elkaar zijn gekoppeld."
                            }
                        ]
                    }
                ],
