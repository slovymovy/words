                "senses": [
                    {
                        "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                        "entry_id": "6e1ac51a-3e7e-32cb-aabe-b9907f4da513",
                        "glosses": [
                            "gezielte Kontrolle/Reduzierung von Stress (durch verschiedene Strategien, Maßnahmen und Techniken)"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4839f992-71a4-4c88-9fa4-02712692d6c6",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Ein umfassendes Konzept zur Stressbewältigung führt zu einem achtsamen Umgang mit sich selbst und dadurch zu mehr innerer Ruhe und Stärke.“"
                            },
                            {
                                "example_id": "7c0d36ef-0f36-44aa-a1f7-df5435005e9f",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Stressbewältigung, ein aktiver Lebensstil, besserer Schlaf und eine optimale Nährstoffzufuhr können einen großen Unterschied machen.“"
                            },
                            {
                                "example_id": "8c7ce03e-fb73-404a-9e80-6c07e4076978",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Arbeitsprobleme: Burnout, Überforderung, Stressbewältigung, Konzentrationsprobleme, Mobbing“"
                            },
                            {
                                "example_id": "6a12e126-a8cf-4a41-883e-2c0fa447e027",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Schon Kinder mahlen mit dem Kiefer oder knirschen zunehmend unterbewusst zur Stressbewältigung.“"
                            },
                            {
                                "example_id": "bc5c869a-8e95-4737-9eb4-1f953fd96966",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Du bist vielleicht auf der Suche nach neuen Methoden zur Stressbewältigung, zur Verbesserung Deiner Gesundheit oder zur spirituellen Entwicklung.“"
                            },
                            {
                                "example_id": "896ebd4d-418e-4d78-a043-3c9b80838167",
                                "sense_id": "3d70f503-c6ea-3be9-8234-fa61f65a5bf3",
                                "text": "„Durch eine Kombination aus Gesprächen, Techniken zur Stressbewältigung und maßgeschneiderten Strategien helfe ich dir, deine Emotionen zu regulieren und dein inneres Gleichgewicht wiederzufinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
