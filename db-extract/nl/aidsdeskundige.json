                        "examples": [
                            {
                                "example_id": "9b8e9120-7dd5-4d5b-9a35-34d3d26fbf44",
                                "sense_id": "527ed192-e5dc-3932-a375-0117b926b396",
                                "text": "Aidsdeskundigen zijn boos op de Chinese overheid omdat die van plan is hiv-patiënten uit badhuizen te weren. Discriminatie, vinden zij, zo meldt de BBC."
                            },
                            {
                                "example_id": "91ffdffb-5e85-45bb-a790-890641a1fac3",
                                "sense_id": "527ed192-e5dc-3932-a375-0117b926b396",
                                "text": "Onnodig veel hiv-patiënten overlijden jaarlijks aan tuberculose (tbc), met name in zuidelijk Afrika. Dat stelt aidsdeskundige Joep Lange van KNCV Tuberculosestichting. Veel patiënten slikken namelijk geen hiv-remmers. Doen ze dat wel, dan krijgen ze de infectie waarschijnlijk niet of slechts in een mildere variant."
                            },
                            {
                                "example_id": "aa06be0f-cd10-4f59-95cd-010da003b781",
                                "sense_id": "527ed192-e5dc-3932-a375-0117b926b396",
                                "text": "Ook andere aidsdeskundigen waren ongelukkig met Bucks uitspraken, en vonden dat hij geen ijdele hoop had mogen wekken."
                            }
                        ]
                    }
