                        "glosses": [
                            "ein Hund^([1]), der überwiegend im Haus, im Haushalt lebt und gehalten wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c66c81-e6d9-41e6-8d21-0af57e40bd90",
                                "sense_id": "9cf4f890-3ef6-3db4-a019-cba27f53fde9",
