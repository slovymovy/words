                "senses": [
                    {
                        "sense_id": "1c1611ab-baf6-3758-8f50-97c73604330a",
                        "entry_id": "c9c8daf7-d122-3096-87e3-a812cf122994",
                        "glosses": [
                            "Sorte de maladie du ver à soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "9f0b49f5-32d4-4ca6-a6e0-84ebabb747c0",
                                "sense_id": "1c1611ab-baf6-3758-8f50-97c73604330a",
                                "text": "La maladie des vers à soie désignée sous le nom de gâtine, de pébrine, a causé à la France, et nous pouvons dire au monde entier, des pertes très-considérables qui s'élèvent à des centaines de millions."
                            },
                            {
                                "example_id": "7be15405-b8ae-4895-b95b-4e79457cf365",
                                "sense_id": "1c1611ab-baf6-3758-8f50-97c73604330a",
                                "text": "[…] ; et les vers à soie en proie à la pébrine ou à la gâtine ne fournissent plus aux campagnes leur appoint précieux."
                            }
                        ]
                    }
