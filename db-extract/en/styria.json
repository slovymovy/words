                                                "sense_id": "cdc1a816-07c6-3d10-9c3f-2ac0d547bb06",
                                                "text": "Er kommt aus der Steiermark."
                                            },
                                            {
                                                "example_id": "1ce16c89-655e-454f-8bc5-0d31e71f2474",
                                                "sense_id": "cdc1a816-07c6-3d10-9c3f-2ac0d547bb06",
                                                "text": "Heute ist Josef Zotters Schoko-Laden-Theater mit 174.000 Besuchern pro Jahr die zweitgrößte Touristenattraktion der Steiermark."
                                            },
                                            {
                                                "example_id": "a0f2ad70-d70a-4fe4-a43f-ed5f7709d5bf",
                                                "sense_id": "cdc1a816-07c6-3d10-9c3f-2ac0d547bb06",
                                                "text": "Schließlich gäbe es im Wiener Parlament genügend Abgeordnete aus der Steiermark, um einen eigenen Klub zu gründen."
                                            },
                                            {
                                                "example_id": "a01c8871-1267-4812-a156-b00a9e5a6686",
                                                "sense_id": "cdc1a816-07c6-3d10-9c3f-2ac0d547bb06",
                                                "text": "Die iranische Fußball-Nationalmannschaft wird vor der WM in Brasilien ein knapp dreiwöchiges Trainingslager in der Steiermark beziehen."
                                            },
                                            {
                                                "example_id": "1b912454-ddc4-4744-b53b-a278650841ac",
                                                "sense_id": "cdc1a816-07c6-3d10-9c3f-2ac0d547bb06",
                                                "text": "Ab 2015 soll es in der Steiermark nicht mehr wie bisher 539 Gemeinden geben, sondern 287."
                                            }
