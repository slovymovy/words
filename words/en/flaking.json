{
    "word_family": [
        "flake",
        "flaky",
        "flakiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c862744-d44c-3138-9823-be3de421ccc8",
                    "sense_definition": "present participle and gerund of <w>flake</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry skin on his forehead was <w>flaking</w> after spending the entire afternoon in the sun.",
                            "target_lang_translations": {
                                "ru": "Сухая кожа на его лбу <w>шелушилась</w> после целого дня, проведённого на солнце."
                            }
                        },
                        {
                            "text": "Old paint was already <w>flaking</w> off the wooden window frame.",
                            "target_lang_translations": {
                                "ru": "Старая краска уже <w>отслаивалась</w> от деревянной оконной рамы."
                            }
                        }
                    ],
                    "synonyms": [
                        "peeling"
                    ],
                    "common_phrases": [
                        "flaking off",
                        "flaking away"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола flake: шелушиться, отслаиваться, осыпаться хлопьями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелушиться",
                                "target_lang_sense_clarification": "о коже"
                            },
                            {
                                "target_lang_word": "отслаиваться",
                                "target_lang_sense_clarification": "о краске, штукатурке"
                            },
                            {
                                "target_lang_word": "осыпаться",
                                "target_lang_sense_clarification": "хлопьями, кусочками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "102de976-61e5-31fc-96a2-1479efa19879",
                    "sense_definition": "Breaking or tending to break away in small, thin layers or pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All the <w>flaking</w> paint had to be scraped off before repainting; fortunately, it came off easily.",
                            "target_lang_translations": {
                                "ru": "Всю <w>отслаивающуюся</w> краску нужно было соскоблить перед повторной покраской; к счастью, она легко отходила."
                            }
                        },
                        {
                            "text": "He applied a soothing cream to treat his dry, <w>flaking</w> skin.",
                            "target_lang_translations": {
                                "ru": "Он нанёс успокаивающий крем, чтобы подлечить сухую, <w>шелушащуюся</w> кожу."
                            }
                        }
                    ],
                    "synonyms": [
                        "peeling",
                        "chipping"
                    ],
                    "common_phrases": [
                        "flaking paint",
                        "flaking skin",
                        "flaking plaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откалывающийся, отслаивающийся или отпадающий тонкими слоями или чешуйками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелушащийся",
                                "target_lang_sense_clarification": "о коже"
                            },
                            {
                                "target_lang_word": "отслаивающийся",
                                "target_lang_sense_clarification": "о краске, штукатурке"
                            },
                            {
                                "target_lang_word": "осыпающийся",
                                "target_lang_sense_clarification": "чешуйками или хлопьями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c8286ff-04e9-33a8-ae8d-d3984417235e",
                    "sense_definition": "A small, thin piece or fragment that has peeled or chipped off.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a cornfield on one side <w>flakings</w> of flint are numerous.",
                            "target_lang_translations": {
                                "ru": "С одной стороны, на кукурузном поле в изобилии встречаются кремневые <w>сколы</w>."
                            }
                        },
                        {
                            "text": "Archaeologists carefully gathered tiny stone <w>flakings</w> from the excavation site.",
                            "target_lang_translations": {
                                "ru": "Археологи аккуратно собрали крошечные каменные <w>отщепы</w> с места раскопок."
                            }
                        }
                    ],
                    "synonyms": [
                        "flake",
                        "shaving",
                        "chipping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький тонкий осколок, чешуйка или фрагмент, отколовшийся от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скол",
                                "target_lang_sense_clarification": "каменная чешуйка, отщеп"
                            },
                            {
                                "target_lang_word": "чешуйка",
                                "target_lang_sense_clarification": "тонкий отпавший фрагмент"
                            },
                            {
                                "target_lang_word": "отщеп",
                                "target_lang_sense_clarification": "в археологии, отколотый кусок камня"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}