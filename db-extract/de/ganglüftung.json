                ],
                "senses": [
                    {
                        "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                        "entry_id": "0f5926c6-7bb3-33e0-b396-001717cee76e",
                        "glosses": [
                            "Technik: Lüftungsart und Lüftungstechnik zur Lüftung eines Ganges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a24617-692b-44cf-b792-255debf5edcf",
                                "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                                "text": "„Bei einer anderen Variante der Ganglüftung, die so genannte Unterflurganglüftung, steigt die Zuluft von unten aus einem extra Zuluftkanal unter dem Futtergang durch den perforierten Gang auf.“"
                            },
                            {
                                "example_id": "72330e7b-f709-4ba3-96f4-4020da05e79d",
                                "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                                "text": "„Die Ganglüftung ist eine der einfachsten und zuverlässigsten Lüftungsarten im Schweinestall.“"
                            },
                            {
                                "example_id": "c9de798b-0807-4276-90e4-44ada4eade4e",
                                "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                                "text": "„Wo häufig im Futtergang gearbeitet wird, ist wegen der Zugluft nicht nur die Ganglüftung, sondern auch der Einsatz der Unterflurzulüftung zweifelhaft.“"
                            },
                            {
                                "example_id": "672e5352-7278-4260-a4ac-65d2345d108c",
                                "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                                "text": "„Allerdings handelte es sich bei der Verbauung in diesem Arbeiterbezirk, der damals überwiegend von tschechischen Zuwanderern bewohnt wurde, um die berüchtigten „Zinskasernen“, die Zimmer-Küche-Wohnungen mit Ganglüftung anboten und zumeist von mehreren Familien bewohnt wurden.“"
                            },
                            {
                                "example_id": "74b6f777-fd87-4bbf-8a08-6beedacc3f9e",
                                "sense_id": "8b9f7c79-42ea-36e8-bd0e-0768da3542f3",
                                "text": "„Ein weiteres Einsatzgebiet ist die Ganglüftung, bei der die Deckenventile oberhalb des Futterganges in die Abteildecke montiert werden und somit die Frischluft gerichtet in den Futtergang geführt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
