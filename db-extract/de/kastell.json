                "senses": [
                    {
                        "sense_id": "66951ffe-100a-3983-8bdd-198a0b08cd50",
                        "entry_id": "7c623a4c-05ee-3d47-b668-ff377b6af592",
                        "glosses": [
                            "ein befestigtes römisches Truppenlager"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "71f6b9ad-9eac-48aa-b521-2ce54f70643e",
                                "sense_id": "66951ffe-100a-3983-8bdd-198a0b08cd50",
                                "text": "\"Das Kastell Niederberg ist ein ehemaliges römisches Auxiliarkastell des Obergermanischen Limes, der seit 2005 den Status eines UNESCO-Weltkulturerbes besitzt."
                            },
                            {
                                "example_id": "c83d2699-cda8-40f8-ba1c-9d455d4eb0d2",
                                "sense_id": "66951ffe-100a-3983-8bdd-198a0b08cd50",
                                "text": "„Schon die Römer erkannten die Geländestufe und errichteten hier ein Kastell, das »Castellum apud confluentes«.“"
                            },
                            {
                                "example_id": "7a79d599-95d3-4867-af49-9e6fee7fe696",
                                "sense_id": "66951ffe-100a-3983-8bdd-198a0b08cd50",
                                "text": "„In der Nähe der alten Moselfurt, im Bereich der heutigen Europabrücke, befand sich seit ca. 8 vor Christus ein relativ kleines römisches Kastell.“"
                            },
                            {
                                "example_id": "f0081dc0-2a14-486e-9467-60f5a6b6dd5f",
                                "sense_id": "66951ffe-100a-3983-8bdd-198a0b08cd50",
                                "text": "„Ursprünglich mochte der alte Palast nach der Art eines befestigten Kastells angelegt worden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87f96ba1-2e9c-378f-af5f-a1f16b153b02",
                        "entry_id": "7c623a4c-05ee-3d47-b668-ff377b6af592",
                        "glosses": [
                            "eine Burg oder ein befestigtes Schloss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f8044b-27bf-45ad-aa36-d21a0978593e",
                                "sense_id": "87f96ba1-2e9c-378f-af5f-a1f16b153b02",
                                "text": "„Um fünf Uhr früh sah mich alle Welt im Kastell herumspazieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
