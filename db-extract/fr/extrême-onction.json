                "forms": [
                    {
                        "form_id": "1aad8ba5-6ddf-41a4-bf3f-bd4e06d584b5",
                        "entry_id": "20a2c4dc-0626-3e43-8567-a652f05000ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "extrêmes-onctions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "683ce80e-62f8-3d16-b61c-65c78a9b4df4",
                        "entry_id": "20a2c4dc-0626-3e43-8567-a652f05000ac",
                        "glosses": [
                            "Un des sept sacrements qui se confère en oignant de l’une des saintes huiles un catholique en péril de mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991356f9-4d8a-45c4-a872-7f6c88a450e6",
                                "sense_id": "683ce80e-62f8-3d16-b61c-65c78a9b4df4",
                                "text": "La maladie faisant des progrès, Louis demanda l’extrême-onction."
                            },
                            {
                                "example_id": "3ea0804e-e280-4ea7-b4e0-a723e8730beb",
                                "sense_id": "683ce80e-62f8-3d16-b61c-65c78a9b4df4",
                                "text": "Il resta trois mois couché sur le dos, dans son lit, blasphéma dans la souffrance, […] se confessa, bien qu’il fût voltairien, reçut l’extrême-onction. Finalement, il ne mourut point."
                            },
                            {
                                "example_id": "aa0eac25-b7d4-4996-bd97-df7dc3cd4887",
                                "sense_id": "683ce80e-62f8-3d16-b61c-65c78a9b4df4",
                                "text": "Pour rester jusqu’au bout dans son rôle, il demanda au village d’assister à la cérémonie de l’Extrême-Onction."
                            },
                            {
                                "example_id": "70d77f90-2ed2-44a4-97ac-94729d7e1788",
                                "sense_id": "683ce80e-62f8-3d16-b61c-65c78a9b4df4",
                                "text": "En Afrique, un Blanc qui adresse la parole à un Noir n’a plus la condescendance raciste des colonisateurs d’antan ; désormais c’est bien plus violent. Désormais, il a le regard apitoyé du prêtre qui administre l’extrême-onction à un condamné à mort."
                            }
                        ]
                    }
                ],
