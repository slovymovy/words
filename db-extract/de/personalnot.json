                "senses": [
                    {
                        "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                        "entry_id": "5494427d-ceaf-38d1-aefe-4a4a760839d9",
                        "glosses": [
                            "Mangel an Arbeitskräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11bbd2df-12f9-4597-870a-66e3ac700f29",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Soldaten:] „Reicht Freiwilligkeit aus, um die Personalnot bei der Bundeswehr zu lindern?“"
                            },
                            {
                                "example_id": "b4e34c09-aad6-43ce-acf3-244fc85e563b",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "„Spätestens im Frühjahr 2024 hatten ukrainische Militärverbände eigene Werbekampagnen gestartet, um der Personalnot entgegenzuwirken.“"
                            },
                            {
                                "example_id": "4d3c7a63-49bf-4689-95f2-b0aac7dc3ab2",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Lehrer:] „In Sachsen-Anhalt ist die Personalnot besonders dramatisch. Nach Angaben des Bildungsministeriums in Magdeburg fehlen aktuell 568 Lehrkräfte.“"
                            },
                            {
                                "example_id": "62aabada-6d14-4160-842f-0975c015749c",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Verwaltungsmitarbeiter:] „Fast alle Jugendämter in Niedersachsen klagen über gravierende Personalnot.“"
                            },
                            {
                                "example_id": "f073475f-c868-46f6-898f-0a6e2a69e0e1",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Standesbeamte:] „Für interkulturelle Paare nimmt das Verfahren oft kafkaeske Züge an - nicht nur wegen der Personalnot, sondern auch wegen der deutschen Bürokratie.“"
                            },
                            {
                                "example_id": "b45fce81-98e3-418b-aa59-9160a8654301",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Schlagzeile:] „Hamburger Pflegekräfte protestieren gegen Personalnot“"
                            },
                            {
                                "example_id": "74903d44-cb49-4852-9d3b-b232a1c42170",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "„Die Personalnot in der Pflege spitzt sich zu: Heimplätze können teils nicht mehr belegt werden. Ambulante Dienste können den großen Bedarf nicht mehr abdecken.“"
                            },
                            {
                                "example_id": "614d0aba-4e17-40a4-961e-e07a8b15b1cc",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Kindergärtnerinnen:] „Bundesweit fehlen etwa 430.000 Kita-Plätze. Ihrem Auftrag zu frühkindlicher Bildung können Kindertagesstätten wegen Personalnot oft nicht gerecht werden. Was hilft gegen einen \"Kita-Kollaps\"?“"
                            },
                            {
                                "example_id": "955cae49-1a54-4519-b010-af68c73f4328",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "„Was sind die Ursachen für die Personalnot in Kitas?“"
                            },
                            {
                                "example_id": "bf5cb0f2-2937-47f0-b953-5ec2a03cf60a",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "„Während der Zivildienst über ausreichende personelle Ressourcen verfügt, herrscht im Zivilschutz Personalnot.“"
                            },
                            {
                                "example_id": "641ee844-0d2a-4276-82da-269ffdcd70b7",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "„Ein Ende der Personalnot an IT-Fachkräften ist nicht [abzusehen].“"
                            },
                            {
                                "example_id": "8413c207-7ac9-4a18-88de-9009fbbb5998",
                                "sense_id": "e1b4fa3d-cb7f-3b17-b512-6296025a5012",
                                "text": "[Staatsanwälte:] „Die fünf neuen Länder richteten nach der Wiedervereinigung zu Beginn der neunziger Jahre Schwerpunktstaatsanwaltschaften für das SED-Unrecht ein, die wegen drastischer Personalnot die tausenden Verfahren jedoch nicht aufklären konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
