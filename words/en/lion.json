                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社交名流",
                                "target_lang_sense_clarification": "在社交界活跃且有名望的人"
                            },
                            {
                                "target_lang_word": "风云人物",
                                "target_lang_sense_clarification": "备受瞩目的知名人士"
                            }
                        ]
                    }
                }
            ]
