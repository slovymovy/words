                    {
                        "sense_id": "a7a1da6e-9bf6-31ed-ade4-d811e1bb40ac",
                        "entry_id": "68d71881-02e3-3d7d-984c-2e8dfa62f888",
                        "glosses": [
                            "A person who is aromantic."
                        ],
                        "tags": [
                            "neologism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0a3578c9-83c2-4586-b0cc-5b01e1b44923",
                                "sense_id": "a7a1da6e-9bf6-31ed-ade4-d811e1bb40ac",
                                "text": "While aces and aros can often be a misunderstood demographic in the queer community and outside of it, information about our identities is making its way into more conversations."
                            },
                            {
                                "example_id": "28fe7100-7ac0-47fb-a85e-6156b51fdb25",
                                "sense_id": "a7a1da6e-9bf6-31ed-ade4-d811e1bb40ac",
                                "text": "Now most of my social circle is made up of other aces and aros."
                            },
                            {
                                "example_id": "39be0ede-4847-4472-8734-d0fde51b6469",
                                "sense_id": "a7a1da6e-9bf6-31ed-ade4-d811e1bb40ac",
                                "text": "Building off from this calling card, aros have a more obscure variation of this where they don white rings."
                            }
                        ]
                    }
                ],
