                    "sense_definition": "Qui frise l'indécence ou l'inconvenance ; osé, scabreux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inconvenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humoriste a fait une plaisanterie un peu <w>risquée</w> qui a surpris l'auditoire.",
                            "target_lang_translations": {
                                "en": "The comedian made a slightly <w>risqué</w> joke that surprised the audience.",
                                "ru": "Юморист отпустил немного <w>рискованную</w> шутку, которая удивила публику.",
                                "de": "Der Humorist machte einen etwas <w>gewagten</w> Scherz, der das Publikum überraschte.",
                                "es": "El humorista hizo una broma algo <w>picante</w> que sorprendió al público.",
                                "zh": "这位喜剧演员讲了一个有点<w>荤</w>的笑话，让观众感到意外。"
                            }
                        },
                        {
                            "text": "Maxime lui a raconté une histoire <w>risquée</w> à la fin du repas.",
                            "target_lang_translations": {
                                "en": "Maxime told them a <w>risqué</w> story at the end of the meal.",
                                "ru": "Максим в конце обеда рассказал ему <w>рискованную</w> историю.",
                                "de": "Maxime erzählte ihm am Ende des Essens eine <w>gewagte</w> Geschichte.",
                                "es": "Maxime le contó una historia <w>picante</w> al final de la comida.",
                                "zh": "饭快吃完时，马克西姆给他讲了一个有点<w>低俗</w>的故事。"
                            }
                        }
