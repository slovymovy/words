                        "glosses": [
                            "Hypothetically, to reverse the act of ringing, or the consequences of the action."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2c015e5a-4817-4061-95d7-8502f8f6a3b1",
                                "sense_id": "8e1b853f-02a2-3663-a3f8-4cd9c7dfb4eb",
                                "text": "In a criminal trial, if the prosecution brings in inadmissible evidence that would unfairly prejudice the accused, a mistrial may be warranted. Having the judge admonish the jury to disregard the evidence might not be enough, as the saying goes, 'You can't unring the bell.'"
                            }
                        ]
                    }
