                ],
                "senses": [
                    {
                        "sense_id": "4acf438a-e0fb-3f5f-850c-8d65a3dc3a31",
                        "entry_id": "7d63fda9-0a67-3140-b790-22e3ab9c4453",
                        "glosses": [
                            "Jugendorganisation der Nationalsozialisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fdeb33a-65bd-4f56-8f99-6d77d0f7b801",
                                "sense_id": "4acf438a-e0fb-3f5f-850c-8d65a3dc3a31",
                                "text": "„…all diese Gören sind von der Hitlerjugend, sie haben die Armbinde mit dem Hakenkreuz, die Jugend Hitlers…“"
                            },
                            {
                                "example_id": "a451664f-d56b-42dc-b1e5-8a1e2693ddf3",
                                "sense_id": "4acf438a-e0fb-3f5f-850c-8d65a3dc3a31",
                                "text": "„Als kleiner Junge durchlief er Pimpfe, Jungvolk und Hitlerjugend und war begeistert von den Jugendaktivitäten der Nationalsozialisten.“"
                            },
                            {
                                "example_id": "9acf4f91-b5ad-4f94-972b-6bbade262260",
                                "sense_id": "4acf438a-e0fb-3f5f-850c-8d65a3dc3a31",
                                "text": "„Die Kleine Synagoge wurde zu einer Musikschule umgewandelt, später zum Sitz der Hitlerjugend.“"
                            },
                            {
                                "example_id": "63302ab5-af7c-4a61-bd40-abfe2ddbb709",
                                "sense_id": "4acf438a-e0fb-3f5f-850c-8d65a3dc3a31",
                                "text": "„Günter Grass tritt der Hitlerjugend bei, und später wird er als Soldat an die Ostfront geschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
