        "fr-extract.jsonl": [
            {
                "entry_id": "d02b10cc-8e85-3f5d-88e7-b16165b336cc",
                "word": "hétérométabole",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dfa71b81-fa54-4452-8fb8-27cc8aa16101",
                        "entry_id": "d02b10cc-8e85-3f5d-88e7-b16165b336cc",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "hétérométaboles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52933601-71d4-3ff1-8afa-808c82e23f35",
                        "entry_id": "d02b10cc-8e85-3f5d-88e7-b16165b336cc",
                        "glosses": [
                            "Qualifie les insectes chez qui le passage de l'état de larve à l’état adulte se fait directement, sans passer à l’état de nymphe. Les ailes se développent en général à mesure des stades larvaires successifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829c11b0-7f2a-4af0-9b9a-cda8c551d9a3",
                                "sense_id": "52933601-71d4-3ff1-8afa-808c82e23f35",
                                "text": "On a voulu souligner les particularités d'un tel développement, fondamentalement d'un type hétérométabole, en le dénommant hémimétabolie, ce qui veut dire demi-métamorphose."
                            },
                            {
                                "example_id": "5f081042-3328-4447-b589-b1da0154bca7",
                                "sense_id": "52933601-71d4-3ff1-8afa-808c82e23f35",
                                "text": "Le développement de cette espèce est de type hétérométabole : l'accroissement de la taille se fait progressivement au cours de quatre mues juvéniles et d'une mue imaginale et s'accompagne de changements dans les proportions du corps."
                            },
                            {
                                "example_id": "6ba0f2df-5f45-4fbd-8391-a00b0da8149d",
                                "sense_id": "52933601-71d4-3ff1-8afa-808c82e23f35",
                                "text": "Mais la plupart subissent des métamorphoses qui définissent les insectes hétéromorphes ; elles sont progressives dans le type hétérométabole , et se font par étapes dans le type holométabole qui est le plus fréquent et le plus important."
                            }
                        ]
                    }
                ],
