                                "target_senses": [
                                    {
                                        "sense_id": "63d05710-5fa2-3731-ae3d-af870f9dda76",
                                        "entry_id": "62f077c8-7835-3b7d-a3f6-189bfd4f7b12",
                                        "glosses": [
                                            "A booklet of printed informational matter, like a pamphlet, often for promotional purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9fdc486-ce7d-43b0-89db-ce37a66b8335",
                                                "sense_id": "63d05710-5fa2-3731-ae3d-af870f9dda76",
                                                "text": "Have a look in the Acme brochure for a new vacuum cleaner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e418e004-b80c-4fe4-8724-08ed6cd9f26b",
                        "source_entry_id": "d0d6d2da-450d-3f5e-9967-1c16d26daf3d",
