                "senses": [
                    {
                        "sense_id": "dba6116c-c5a6-333f-b456-efba9baad88f",
                        "entry_id": "0b675dd4-5ce7-371c-ada4-b6bc874d2ea6",
                        "glosses": [
                            "Region um einen der Pole (Nord- oder Südpol)"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba7c85d-31e0-4f4a-a0a2-3097c1516d6e",
                                "sense_id": "dba6116c-c5a6-333f-b456-efba9baad88f",
                                "text": "Zu den Polarregionen gehören die Landschaftsformen Eiswüste und Tundra, wobei es am Südpol nur wenig Tundren gibt."
                            },
                            {
                                "example_id": "afd16e7f-eec0-4ca8-85b2-b4e42e581073",
                                "sense_id": "dba6116c-c5a6-333f-b456-efba9baad88f",
                                "text": "„In den Polarregionen und in den Bergen erschweren starke Winde und heftige Kälte das Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
