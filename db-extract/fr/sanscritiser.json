                "senses": [
                    {
                        "sense_id": "54d522c2-e5d4-3b03-95e1-e5e94e2e30a9",
                        "entry_id": "7faf8438-6bb7-336d-b380-16db8950b760",
                        "glosses": [
                            "Donner un caractère sanscrit à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e87a942-33f3-44f8-8478-3d130dadaa71",
                                "sense_id": "54d522c2-e5d4-3b03-95e1-e5e94e2e30a9",
                                "text": "Le discours qu’ils ont développé depuis le milieu des années 1980 signale une rupture radicale avec leurs tentatives antérieures pour « sanscritiser » les Tharu ou, pourrions-nous dire, les « brahmaniser »."
                            },
                            {
                                "example_id": "cde472f0-1c3d-4b32-b065-8ba3df5f15c2",
                                "sense_id": "54d522c2-e5d4-3b03-95e1-e5e94e2e30a9",
                                "text": "Cet ouvrage a le défaut de sanscritiser à outrance le néwari et de ne donner aucun mot de la vie courante ou du vocabulaire technologique; d’un usage limité pour l’ethnologue, c'est plutôt un guide dans l’étude de la littérature Néwar."
                            }
                        ]
                    }
