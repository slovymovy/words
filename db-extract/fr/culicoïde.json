                        "entry_id": "3bbb6e75-9c1f-3622-868d-237a6a859280",
                        "glosses": [
                            "Genre de moucherons (Culicoides spp.) dont la femelle suce le sang de vertébrés, à piqûre urticante et douloureuse, et pouvant transmettre des maladies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fd45e02-66b0-4d7d-8bf1-9202804a95c5",
                                "sense_id": "d3b51d28-8ff1-39ee-973c-bb132bf90db9",
                                "text": "Les moucherons piqueurs (Cullicoïdes) inoculent la peste équine, la fièvre catarrhale du mouton et la fièvre de trois jours."
                            },
                            {
                                "example_id": "13028036-aaa1-4080-98fc-b387400ad2fc",
                                "sense_id": "d3b51d28-8ff1-39ee-973c-bb132bf90db9",
                                "text": "La vie larvaire d’un culicoïde comprend quatre stades."
                            }
                        ]
                    }
                ],
