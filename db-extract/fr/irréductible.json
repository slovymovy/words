                    {
                        "translation_id": "fc723a96-b90b-44f6-aaf1-631074a80ffe",
                        "source_entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                        "source_sense_description": "qu’on ne peut vaincre ou faire fléchir",
                        "target_lang_word": "indomitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indomitable",
