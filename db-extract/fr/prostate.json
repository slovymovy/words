        "fr-extract.jsonl": [
            {
                "entry_id": "eadbc062-e435-31fa-8a43-7a6b04d40e25",
                "word": "prostate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cab80968-7365-4150-9cfd-32a1017fa2df",
                        "entry_id": "eadbc062-e435-31fa-8a43-7a6b04d40e25",
                        "tags": [
                            "plural"
                        ],
                        "form": "prostates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b9781bc-4bfa-3c5b-8689-3f37159eb3f9",
                        "entry_id": "eadbc062-e435-31fa-8a43-7a6b04d40e25",
                        "glosses": [
                            "Une glande de l’appareil génital masculin qui sécrète une partie du liquide séminal et qui, chez l’homme, est située sur la ligne médiane et à la partie inférieure du col vésical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1bf99e-67cc-4bd9-8f6d-e131002f1c52",
                                "sense_id": "1b9781bc-4bfa-3c5b-8689-3f37159eb3f9",
                                "text": "Mon grand-père disait : « N’ont de problème de prostate que les chastes et les assis. » Je ne sais pas grand-chose de sa chasteté, mais son métier de pharmacien l’obligeait à travailler debout toute la journée, et le fait est qu’il est mort à quatre-vingt-treize ans sans avoir été opéré de la prostate."
                            },
                            {
                                "example_id": "48ebde66-2f40-48a5-b969-919247b92888",
                                "sense_id": "1b9781bc-4bfa-3c5b-8689-3f37159eb3f9",
                                "text": "Selon l’Inserm, les personnes qui ont tendance à manger relativement tard et proche du moment du coucher augmentent sur le long terme le risque de cancer du sein ou de la prostate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93d29d9b-5881-4574-b614-f58703ca983c",
                        "source_entry_id": "eadbc062-e435-31fa-8a43-7a6b04d40e25",
                        "source_sense_id": "1b9781bc-4bfa-3c5b-8689-3f37159eb3f9",
                        "target_lang_word": "Prostata",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prostata",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                                        "entry_id": "97067df4-f3c2-3102-ae5b-cd067f8525ba",
                                        "glosses": [
                                            "akzessorische Geschlechtsdrüse aller Säugetiere (einschließlich Mensch), die nahe der Harnblase liegt und die Harnröhre umgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b17ec7b-392c-45f0-b2ef-95aa48d4423d",
                                                "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                                                "text": "„Die Prostata liegt an der Einmündung der paarigen Samenleiter in die Harnröhre direkt unterhalb der Harnblase.“"
                                            },
                                            {
                                                "example_id": "b57e20b4-e222-4aba-a78f-ee1e361a10ac",
                                                "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                                                "text": "„1991, etwa um die Zeit, als seinem Bruder die von Krebs befallene Prostata entfernt wurde, was zu Impotenz und ständiger Inkontinenz führte, unterzog er sich unverzüglich einer Prostatauntersuchung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae34887-dc4d-45e2-aa69-b56c92bc458a",
                        "source_entry_id": "eadbc062-e435-31fa-8a43-7a6b04d40e25",
