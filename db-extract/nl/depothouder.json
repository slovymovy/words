                        "examples": [
                            {
                                "example_id": "6f145c4b-f91b-4e50-8f04-f4f5e2a3ab93",
                                "sense_id": "3309ec5b-e053-3b34-9b66-cc0e1af19dae",
                                "text": "Inmiddels vergaat het hen stukken beter. Haar partner heeft werk en zij is zich voor Stop Armoede 053 gaan inzetten. Eerst werd ze depothouder en nu is ze de contactpersoon en de waakzame ogen voor Evelien op het Facobookaccount. „Tot de dag van vandaag zijn we Evelien dankbaar”, zegt ze. „Je was een zo onzeker meisje en bent nu veel zelfverzekerder geworden”, zegt Evelien. „Dankjewel, schat”, zegt Danique."
                            }
                        ]
                    },
                    {
                        "sense_id": "a24c0116-f034-3c5e-98a3-64388aa5403a",
                        "entry_id": "efbe6748-7ed1-383a-b678-cae321d9a2e5",
                        "glosses": [
                            "bedrijf dat een hoeveelheid geld beheert voor een ander"
                        ],
                        "tags": [],
                        "examples": [
                            {
