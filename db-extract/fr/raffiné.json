                                                "sense_id": "757842bc-f9f7-3c60-9efa-38a568cbfc4e",
                                                "text": "Hier sehen Sie eine Auswahl der erlesensten Weine dieser Gegend."
                                            },
                                            {
                                                "example_id": "ea181e92-b3ec-4342-9ae7-094d96478aa6",
                                                "sense_id": "757842bc-f9f7-3c60-9efa-38a568cbfc4e",
                                                "text": "„George hätte nie ein so properes Restaurant mit einer erlesenen christlichen Kundschaft auf die Beine stellen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "erlesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b5e83d-e577-3113-a77c-bc351690ef18",
