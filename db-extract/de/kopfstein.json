                "senses": [
                    {
                        "sense_id": "f5b1eac0-5f95-37aa-a6c7-65f88bc0e327",
                        "entry_id": "7993c620-ff76-3ced-901a-1acd03ce1ee6",
                        "glosses": [
                            "Pflasterstein mit leicht gerundeter, unebener Oberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba4c57ff-17a7-4263-b195-835029b5b1c1",
                                "sense_id": "f5b1eac0-5f95-37aa-a6c7-65f88bc0e327",
                                "text": "„Die Straßen der hübschen Orte waren mit Kopfstein oder hellen Granitplatten gepflastert, ich spürte die Sonne auf meiner Haut und den italienischen Bunga Bunga.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e03f688-e4e2-45b6-93b5-3f15d648884d",
