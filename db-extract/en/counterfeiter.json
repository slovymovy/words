    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3b68cc30-ff40-31d1-a2d8-2006700fd9ad",
                "word": "counterfeiter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c51eb199-23e9-4102-b17e-e549a57492c0",
