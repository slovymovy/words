                },
                {
                    "sense_id": "63be30bd-66bf-3b3f-af56-8defb23d1574",
                    "sense_definition": "Praticien qui effectuait autrefois des actes de petite chirurgie, des saignées ou des extractions dentaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metier_sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, les <w>barbiers</w> étaient souvent appelés pour soigner des blessures légères."
                        },
                        {
                            "text": "Ce <w>barbier</w> pratiquait la saignée pour tenter de faire baisser la fièvre du patient."
