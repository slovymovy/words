                                        "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                        "entry_id": "9f532119-4eea-3ecc-ae9e-c08804a2b984",
                                        "glosses": [
                                            "A block or slab upon which a column, pedestal, statue or other structure is based."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c4a9bd-65c4-4429-9488-9ff01ec8373a",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "The queen placed the vase on the plinth so the cupbearer could fill it with flowers."
                                            },
                                            {
                                                "example_id": "894ff4f8-6314-4565-b176-4be02813b519",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "There appears to be no definite information about the origin of the two large boulders, mounted on plinths, on the platforms of St. Anne's Park Station, Bristol."
                                            },
                                            {
                                                "example_id": "979898c0-6f76-4edd-9847-d3815dfe005f",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "The station building forms a street-level portal and ticket hall, connected by staircases and escalators to the sub-surface platforms. The whole structure is designed as a plinth for a future block of buildings above."
                                            },
                                            {
                                                "example_id": "77df8a0d-aac7-445b-a890-f88d86b9e4c0",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    },
