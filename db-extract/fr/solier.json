                    {
                        "sense_id": "bfe0fae8-b6f0-3f1e-aa06-4084efa49d66",
                        "entry_id": "1333f399-b28a-383d-aba0-793d3345b3cc",
                        "glosses": [
                            "Speicher, Dachboden, Söller"
                        ],
                        "tags": [
                            "historisch (Mittelalter bis 16. Jahrhundert)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8944b92f-ba66-3f8b-a15a-1198d7eb0b4f",
                        "entry_id": "1333f399-b28a-383d-aba0-793d3345b3cc",
                        "glosses": [
                            "erhöhtes Geschoss, das bewohnt werden kann; Dachboden, Söller"
                        ],
                        "tags": [
                            "historisch (Mittelalter bis 16. Jahrhundert)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "413c0439-3bd2-4066-85df-27a15bb538d1",
                        "source_entry_id": "1333f399-b28a-383d-aba0-793d3345b3cc",
                        "source_sense_id": "bfe0fae8-b6f0-3f1e-aa06-4084efa49d66",
                        "target_lang_word": "Speicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Gebäude, das zur Lagerung von Vorräten dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce892c2-d099-48fc-a7f0-a7685699db23",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "Dort ist der Speicher für unsere Ernte."
                                            },
                                            {
                                                "example_id": "46bfb05f-5cb6-43db-b637-081c442d4c77",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Es macht einen seltsamen Eindruck, mitten in diesem modernen Treiben vor jedem Speicher Reihen von Kamelen zu sehen, die daliegen, um mit Waren beladen zu werden.“"
                                            },
                                            {
                                                "example_id": "a10b5138-966f-4d88-b538-3bb2d31105a8",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Reis und Getreide füllten seine Speicher.“"
                                            },
                                            {
                                                "example_id": "e9c0675f-ec0e-4444-a545-3bb9c12021b2",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Sie liess sich schildern, wo es zum Speicher ging, wie sie sich schweigend hinstellen und horchen müsse.“"
                                            },
                                            {
                                                "example_id": "fb5a74e0-4b43-4972-a138-c8f3e3f9b551",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Stattdessen wurde nun beim Donautor ein überdurchschnittlich großes Gebäude errichtet, das ebenfalls als Speicher interpretiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Gerät/Gerätschaft/Anlage, dass/die der Speicherung eines (meist wertvollen) Mediums dient (beispielsweise Erdgas, Wasser, Strom, Wärme)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20807a6-89dd-496d-a3b3-b7d9b26e485b",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Die Anlage, die Ende kommenden Jahres ans Netz gehen soll, ist dann der größte Speicher seiner Art in Europa.“"
                                            },
                                            {
                                                "example_id": "d3709ffe-0ac8-4e87-a4f6-98c7e1993f54",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Wurde 2017 noch der Speicher in Braderup (Kreis Nordfriesland) als einer der größten mit 2 Megawattstunden (MWh) gefeiert, so geht es jetzt um 239 MWh im Bollingstedter Ortsteil Gammelund (Kreis Schleswig-Flensburg).“"
                                            },
                                            {
                                                "example_id": "0dde7175-daea-43d9-bbdb-9e4fc935f8f8",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "[Batteriespeicher:] „Ein Verkaufsargument: Weil die neuartigen Batterien nicht brennbar sind, können sie zu beliebig großen Speichern zusammengefügt werden.“"
                                            },
                                            {
                                                "example_id": "4e137ba4-9d06-48e1-8d91-7431e1d52138",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "[Batteriespeicher:] „Weil Wind- und Sonnenenergie stark wetterabhängig sind, benötigen sie solche Speicher, um eine durchgängige Versorgung sicherzustellen.“"
                                            },
                                            {
                                                "example_id": "3572e54f-244e-4aa7-8ac4-3c177d3e01c3",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Der Energiekonzern EWE etwa plant, einen Erdgasspeicher in Huntorf (Landkreis Wesermarsch) als Speicher für grünen Wasserstoff umzubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Raum unter dem Dach, der zum Abstellen dient"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a86c54e-a8f6-4ef6-8544-22ba33b75636",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "Wie findest du dein neues Zimmer auf dem Speicher?"
                                            },
                                            {
                                                "example_id": "02543166-b4a9-4ba6-acb7-2d57e2dcfe1c",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "„Einmal schlich sich ein Junge in den Speicher, obwohl es die Eltern ausdrücklich verboten hatten.“"
                                            },
                                            {
                                                "example_id": "917e2441-0d5c-446e-b3fc-b3db719c6d55",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "„Im Schein der Handytaschenlampe stieg ich die schmale Treppe zum Speicher hinauf, die schließlich vor einer Leiter endete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d380cd56-5223-351d-8b3b-4a9b05a1f311",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Vorrichtung an elektrischen Rechenanlagen zum Speichern von Informationen"
                                        ],
                                        "tags": [
                                            "Hardware"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd53e9cc-9311-42b6-af0d-a13a9898170b",
                                                "sense_id": "d380cd56-5223-351d-8b3b-4a9b05a1f311",
                                                "text": "Ich habe keinen Speicher mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b36ad7b8-1968-3bf0-859a-a5ffbc95c8b8",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Datenspeicher"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0552b776-677f-4942-a3d6-d1c1eccd8cdc",
                        "source_entry_id": "1333f399-b28a-383d-aba0-793d3345b3cc",
                        "source_sense_id": "bfe0fae8-b6f0-3f1e-aa06-4084efa49d66",
                        "target_lang_word": "Dachboden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachboden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                        "entry_id": "bd61c1db-85ff-3700-87ef-efee5edd2097",
                                        "glosses": [
                                            "Raum direkt unterhalb eines Daches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c15111-e4d7-4962-b523-7e3966a4e9cc",
                                                "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                                "text": "In vielen Häusern dient der Dachboden als Rumpelkammer."
                                            },
                                            {
                                                "example_id": "b25b1e3a-5290-474a-8848-6c3dc0d83da2",
                                                "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                                "text": "„Auf dem Dachboden befand sich eine Kathedrale in Miniaturformat.“"
                                            },
                                            {
                                                "example_id": "882f6360-1920-429e-b539-c7b5a380a115",
                                                "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                                "text": "„Menschenscheuer denn je, verkroch sich Horst Cunert auf dem Dachboden in der Düsternstraße, zwischen Blechkästen und Dampfschiffen, wo ihn nur Cesar und Roman besuchen durften.“"
                                            },
                                            {
                                                "example_id": "cb7fdb38-41b4-4681-8467-9f84994b65a2",
                                                "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                                "text": "„Auf dem Dachboden schossen wir mit Axels Luftgewehr auf Papierscheiben.“"
                                            },
                                            {
                                                "example_id": "be48589e-f9a4-4bec-ac62-f3303d1733ca",
                                                "sense_id": "dee9b813-a1c5-34fd-8061-08ea7695f373",
                                                "text": "„Mit einer Petroleumlampe in der Hand zeigte sie Hjartvard auf dem Dachboden das Zimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f582ffab-054d-4243-be3f-95567e8e9e28",
                        "source_entry_id": "1333f399-b28a-383d-aba0-793d3345b3cc",
                        "source_sense_id": "bfe0fae8-b6f0-3f1e-aa06-4084efa49d66",
                        "target_lang_word": "Söller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Söller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f07abad-2ba7-37be-9dde-9558a8ce4114",
                                        "entry_id": "c80ea84c-5cf1-3714-8c7b-88121663e25e",
                                        "glosses": [
                                            "eine in den Obergeschossen von Häusern ins Freie führende eventuell auch überdeckte Plattform, die im Gegensatz zu einem Balkon nicht frei auskragt, sondern von Mauern oder Pfeilern gestützt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a5b76fb-2b66-49c4-a8d0-ff3e741a5042",
                                                "sense_id": "0f07abad-2ba7-37be-9dde-9558a8ce4114",
                                                "text": "Bei dem schönen Wetter heute sollten wir auf dem Söller frühstücken."
                                            },
                                            {
                                                "example_id": "decaa131-a955-4fda-9073-8291eb72a171",
                                                "sense_id": "0f07abad-2ba7-37be-9dde-9558a8ce4114",
                                                "text": "„Allmählich hatte sich sein Blick von dem Kommissar gelöst und war in den Hintergrund gedrungen, wo eine breite Türöffnung auf einen Söller führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a4b514f-9964-32bb-9183-361a112a7756",
                                        "entry_id": "c80ea84c-5cf1-3714-8c7b-88121663e25e",
                                        "glosses": [
                                            "Dachboden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b494876f-7743-48e4-8698-b64d626e3aa5",
                                                "sense_id": "7a4b514f-9964-32bb-9183-361a112a7756",
                                                "text": "Bring die Kiste auf den Söller!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
