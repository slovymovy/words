                "senses": [
                    {
                        "sense_id": "436c616a-3694-34db-af83-6979d0583154",
                        "entry_id": "958418a4-db8b-3477-baa1-7dd7daebf498",
                        "glosses": [
                            "meist am Ende eines Textes stehende, inhaltliche Zusammenfassung mit eigener Wertung und/oder Schlussfolgerungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b84e24-459c-4132-851f-bb4f5ec6cbe0",
                                "sense_id": "436c616a-3694-34db-af83-6979d0583154",
                                "text": "Der Kanzler zieht ein Resümee seiner Amtszeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59f475b6-bb5c-41f3-9d53-8b30d13491b6",
                        "source_entry_id": "958418a4-db8b-3477-baa1-7dd7daebf498",
                        "source_sense_id": "436c616a-3694-34db-af83-6979d0583154",
                        "source_sense_description": "zusammenfassender Überblick",
                        "target_lang_word": "resume",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resume",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ae9868-9bd8-3ae4-8d37-81f2c02c19ea",
                                        "entry_id": "38eedb4c-8a5a-3873-ab6f-cf96fe8efedb",
                                        "glosses": [
                                            "To take back possession of (something)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d7257b-125d-4ac8-9212-69f7227d48fa",
                                                "sense_id": "66ae9868-9bd8-3ae4-8d37-81f2c02c19ea",
                                                "text": "Ladies and gentlemen, please resume your seats."
                                            },
                                            {
                                                "example_id": "c002d55c-f1eb-4f31-b8cd-3c83d032e768",
                                                "sense_id": "66ae9868-9bd8-3ae4-8d37-81f2c02c19ea",
                                                "text": "As to the advice you give, to resume my estate, I am determined not to litigate with my father, let what will be the consequence to myself."
                                            },
                                            {
                                                "example_id": "f4387427-c45a-4047-8f9e-641476b163ea",
                                                "sense_id": "66ae9868-9bd8-3ae4-8d37-81f2c02c19ea",
                                                "text": "For after that initiation it was impossible to attach any profound importance to the notion of dying. All individual deaths had been resumed by the death of God!"
                                            },
                                            {
                                                "example_id": "fba415d9-eba3-4872-afce-d779e39112e0",
                                                "sense_id": "66ae9868-9bd8-3ae4-8d37-81f2c02c19ea",
                                                "text": "By resumption The Government, most likely the State Government, can resume property for the purposes of building a road or a school or some other purpose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "359319e5-8ae2-3a56-89e9-39b6e438dc6a",
                                        "entry_id": "38eedb4c-8a5a-3873-ab6f-cf96fe8efedb",
                                        "glosses": [
                                            "To summarise."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0e5cf3-267d-4381-bbac-4a2bbc910d88",
                                                "sense_id": "359319e5-8ae2-3a56-89e9-39b6e438dc6a",
                                                "text": "He […] used to say that each separate death had taught him something new about death, and that he was going to resume this knowledge in a philosophic essay about dying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103826d9-ebeb-3c21-8e14-7875031087cb",
                                        "entry_id": "38eedb4c-8a5a-3873-ab6f-cf96fe8efedb",
                                        "glosses": [
                                            "To start (something) again that has been stopped or paused from the point at which it was stopped or paused; continue, carry on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e8192f-ae6f-4731-93cd-1694d126a5f6",
                                                "sense_id": "103826d9-ebeb-3c21-8e14-7875031087cb",
                                                "text": "We will resume this discussion tomorrow at nine."
                                            },
                                            {
                                                "example_id": "fbc04621-e27f-41be-8a25-88faf79bfd2d",
                                                "sense_id": "103826d9-ebeb-3c21-8e14-7875031087cb",
                                                "text": "No man wiſhed more for the high establiſhment of the Royal Family than he did ; but he thought the Prince would do himſelf more honour by giving up the trappings of royalty at this moment, than by reſuming them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a213a0b-dd82-31eb-bd15-f8d4b2d6281a",
                                        "entry_id": "38eedb4c-8a5a-3873-ab6f-cf96fe8efedb",
                                        "glosses": [
                                            "To start again after an interruption or pause."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a1e66fa-8f5e-4b81-b4dc-ac7d166425e6",
                                                "sense_id": "5a213a0b-dd82-31eb-bd15-f8d4b2d6281a",
                                                "text": "1991, The Code of Federal Regulations of the United States of America, 43 CFR 5451.4, Office of the Federal Register, page 68.\nBefore operations resume, a reduced bond shall be increased to the amount of a full"
                                            },
                                            {
                                                "example_id": "6ae67e66-5db3-4937-97c7-7a2c7f680242",
                                                "sense_id": "5a213a0b-dd82-31eb-bd15-f8d4b2d6281a",
                                                "text": "Normal service has resumed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "resume",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1285d1-7863-3f32-b17e-58bd4749de64",
                                        "entry_id": "fbe9b059-5617-3b6c-923d-ae84b2a28435",
                                        "glosses": [
                                            "A summary or synopsis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6dfd05-4154-447c-b71e-1dd450b3adf2",
                                                "sense_id": "1b1285d1-7863-3f32-b17e-58bd4749de64",
                                                "text": "He had scanned the resumé of the three previous instalments, and was abut to commence the story[.]"
                                            }
