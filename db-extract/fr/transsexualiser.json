                ],
                "senses": [
                    {
                        "sense_id": "7447eb06-6058-37ef-b608-a95aff7b4ea2",
                        "entry_id": "dbbbd43a-6db3-3e66-a3e6-9ffd4911211f",
                        "glosses": [
                            "Rendre transsexuel, donner un caractère transsexuel à."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5c16193a-85d6-4658-9375-7c3c41edb242",
                                "sense_id": "7447eb06-6058-37ef-b608-a95aff7b4ea2",
                                "text": "Parfois, ils voudraient changer carrément de sexe, et il existe des médecins assez cinglés pour les transsexualiser."
                            },
                            {
                                "example_id": "ebfb9e00-4b27-4870-85e9-83130a722f7f",
                                "sense_id": "7447eb06-6058-37ef-b608-a95aff7b4ea2",
                                "text": "Les quelques femmes de transvestis en train de se transsexualiser que nous avons vues nous ont frappés par la manière dont elles affirmaient n’avoir rien pressenti pendant longtemps des particularités de leur mari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd2c6523-c9f3-41c3-8bae-964b04a20e33",
                        "source_entry_id": "dbbbd43a-6db3-3e66-a3e6-9ffd4911211f",
                        "source_sense_id": "7447eb06-6058-37ef-b608-a95aff7b4ea2",
                        "target_lang_word": "transsexualize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transsexualize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f603fe-bd08-3b2c-966f-9dd7a0e67669",
                                        "entry_id": "793a10f4-0fb8-3adc-8d2f-a66381b8322e",
                                        "glosses": [
                                            "To make transsexual."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b710e0b-780b-4e53-b139-d9626fb7b5a3",
                                                "sense_id": "c1f603fe-bd08-3b2c-966f-9dd7a0e67669",
                                                "text": "[…] which he liked to compare to an archduchess's urine, fetishizing it as a kind of elixir of femaleness by which he can transsexualize himself […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3783d2c5-a58b-3888-ad90-9efa69be5cbe",
                                        "entry_id": "793a10f4-0fb8-3adc-8d2f-a66381b8322e",
                                        "glosses": [
                                            "To cause (something such as an anthropomorphized natural phenomenon, like a flood) to have the opposite sex or gender."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da9ceb01-51c2-4df5-9036-f0634968134e",
                                                "sense_id": "3783d2c5-a58b-3888-ad90-9efa69be5cbe",
                                                "text": "these embodied female waters are actually present in full flood despite [...] the embrace of the English translation of \"Father of Waters\" [...]. This is to say that waters that are turbulent and torrential are not always transsexualized as males via the rhetorical strategies of birth (The Columbiad) or metamorphosis (The Johnstown Flood). They are also at times imaged as female."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
