                {
                    "sense_id": "d6359554-a024-3929-975a-0824a12c1fd8",
                    "sense_definition": "Having a yellowish-brown color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cinnamon_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird was easily identified by its distinctive <w>cinnamon</w> wings.",
                            "target_lang_translations": {
                                "ru": "Птицу было легко узнать по характерным крыльям <w>коричного цвета</w>."
                            }
                        },
                        {
                            "text": "He wore a <w>cinnamon</w> jacket that matched his brown boots perfectly.",
                            "target_lang_translations": {
                                "ru": "На нем была куртка <w>цвета корицы</w>, которая идеально сочеталась с его коричневыми ботинками."
                            }
                        }
                    ],
                    "synonyms": [
                        "brownish",
                        "tan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий желтовато-коричневый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коричного цвета",
                                "target_lang_sense_clarification": "окрас"
                            },
                            {
                                "target_lang_word": "светло-коричневый",
                                "target_lang_sense_clarification": "похожий оттенок"
                            }
                        ]
                    }
                }
            ]
        },
