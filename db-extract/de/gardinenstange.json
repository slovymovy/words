                    {
                        "translation_id": "015aa405-bc0d-48d5-b730-3e53c9b1b8b7",
                        "source_entry_id": "4cd55491-3b72-307a-84a8-af40e5d7d8e9",
                        "source_sense_id": "ec5f0ed6-8e76-331c-b7c2-1df8879640bc",
                        "source_sense_description": "Stange, an der eine Gardine aufgehängt wird",
                        "target_lang_word": "карниз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "карниз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e9126de6-836b-393a-b221-f94f84c685ac",
                                        "entry_id": "32108e6f-3f85-3c59-a900-c93250fed322",
                                        "glosses": [
                                            "архит. горизонтальный продольный выступ на стене, поддерживающий крышу (покрытие) здания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a148fcb-d77e-48b6-95fc-e60b5f1f0660",
                                                "sense_id": "e9126de6-836b-393a-b221-f94f84c685ac",
                                                "text": "Я перемахнул через подоконник и, упираясь на выступ карниза, прижался к стене."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2879df59-dfeb-3e1f-ba8f-30a7200c867e",
                                        "entry_id": "32108e6f-3f85-3c59-a900-c93250fed322",
                                        "glosses": [
                                            "архит., истор. верхняя часть антаблемента, лежащая на фризе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803df335-2a0d-41a5-a84e-0f987627eedc",
                                                "sense_id": "2879df59-dfeb-3e1f-ba8f-30a7200c867e",
                                                "text": "С боков, конечно, не было фронтонов, зато карниз украшался львиными головами, через которые стекала дождевая вода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ce0043-83ec-33af-bc9d-6c3462b5576b",
                                        "entry_id": "32108e6f-3f85-3c59-a900-c93250fed322",
                                        "glosses": [
                                            "перекладина, на которую вешают шторы, обычно над окном или дверью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc70355-3560-47be-b0aa-a422c0da74bf",
                                                "sense_id": "00ce0043-83ec-33af-bc9d-6c3462b5576b",
                                                "text": "Тот стукнул хозяйку когтистой лапой и, мигом взлетев вверх по занавеске, устроился на карнизе, свесив вниз круглую ушастую голову."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d60791c9-14d9-3002-8896-72fb382e60e2",
                                        "entry_id": "32108e6f-3f85-3c59-a900-c93250fed322",
                                        "glosses": [
                                            "перен. нависающая часть кручи, стены"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c88e9383-0925-41f9-b026-7c6f5f057202",
                                                "sense_id": "d60791c9-14d9-3002-8896-72fb382e60e2",
                                                "text": "Несколько лет потом мне все снились сны, что я оступаюсь на скальном карнизе и падаю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
