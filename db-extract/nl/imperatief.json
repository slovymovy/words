                                                "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                                "text": "imperative orders"
                                            },
                                            {
                                                "example_id": "bb7655b6-498e-455c-bf8d-97297128c388",
                                                "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                                "text": "The suits of kings are imperative."
                                            }
