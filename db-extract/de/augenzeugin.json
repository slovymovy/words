                        "cross_references": [
                            {
                                "target_word": "témoin oculaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a070824c-6f13-3c53-9f66-cc5dc77c6c59",
                                        "entry_id": "36e40ad8-9d2b-3b87-8a68-a719b69d0b29",
                                        "glosses": [
                                            "Celui qui a vu de ses propres yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2432b22-7a63-4e99-a8f4-a9259857377e",
                                                "sense_id": "a070824c-6f13-3c53-9f66-cc5dc77c6c59",
                                                "text": "Ayant eu l’occasion, même avant de commencer nos études de Vétérinaire, d’assister à des foires et des marchés, nous avons pu être témoin oculaire d’une foule de ruses employées par les marchands, propriétaires ou maquignons."
                                            },
                                            {
                                                "example_id": "9767b4de-bf37-4742-a4d9-492f3dba3a04",
                                                "sense_id": "a070824c-6f13-3c53-9f66-cc5dc77c6c59",
                                                "text": "Partout j'ai vérifié autant que possible les dires de mes témoins oculaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
