                ],
                "senses": [
                    {
                        "sense_id": "080d2c9e-93c4-30d0-b8c0-eb101baac0b9",
                        "entry_id": "ccc8edbe-e264-326c-957f-5c8ee2205fc0",
                        "glosses": [
                            "Sorte de pâtisserie très légère faite avec des blancs d’œuf et du sucre en poudre."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "68df2c69-7c49-4087-b67b-0115a289ede8",
                                "sense_id": "080d2c9e-93c4-30d0-b8c0-eb101baac0b9",
                                "text": "Jamais votre bouche charmante n'aspira la suavité d’une meringue à la vanille ou à la rose ; à peine vous élevâtes-vous jusqu'au pain d'épice."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff3ba816-efac-3a51-92f9-500eab4dd553",
                        "entry_id": "ccc8edbe-e264-326c-957f-5c8ee2205fc0",
                        "glosses": [
                            "Appareil utilisé pour cette pâtisserie, utilisé comme base pour de nombreuses préparations."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4a30b28b-91f8-3c4b-a23d-e55c8e71935b",
                        "entry_id": "ccc8edbe-e264-326c-957f-5c8ee2205fc0",
                        "glosses": [
                            "Coiffure, vêtement, évoquant l’aspect d’une meringue."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d5d37f00-4f65-4488-b679-df8b903d003f",
                                "sense_id": "4a30b28b-91f8-3c4b-a23d-e55c8e71935b",
                                "text": "Hors mes robes de tous les jours, de vraies robes de concierge, je n’ai qu’une sorte de meringue blanche nuptiale ensevelie de naphtaline et une chasuble noir lugubre dont j’use pour les rares enterrements auxquels on me convie."
                            }
                        ]
                    }
                ],
                "translations": [
