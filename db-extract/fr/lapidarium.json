                                        "entry_id": "dedd211c-5d0d-3fc9-85a2-8264b0e85a0f",
                                        "glosses": [
                                            "Sammlung von Steindenkmälern wie Grenzsteinen, Grabsteinen, Altären, Schreinen, Sarkophagen etc. in Museen oder ähnlichen Institutionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d67931-6e5f-451c-a91e-33d945f1a828",
                                                "sense_id": "0c31e9f6-cf3e-3a61-84c8-4b538f2a5c09",
                                                "text": "„Die Grabstele eines römischen Zenturions aus dem Lapidarium des Vatikans zeigt einen stehenden Menschen in einer Ädikula.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "183c63d8-6a2b-3c1c-a4b8-1c666e36620f",
                                        "entry_id": "dedd211c-5d0d-3fc9-85a2-8264b0e85a0f",
                                        "glosses": [
                                            "mittelalterliches Steinbuch oder Verzeichnis, in dem die Eigenschaften und Heilkräfte von Edelsteinen abgehandelt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9718f97-d700-4c82-bf90-ef388ae0f6b8",
                                                "sense_id": "183c63d8-6a2b-3c1c-a4b8-1c666e36620f",
                                                "text": "„In der mittelhochdeutschen Dichtung findet sich ein Lapidarium im >Parzival< (13. Jahrhundert) Wolframs von Eschenbach.“"
                                            },
                                            {
                                                "example_id": "2cc9db4a-9185-4472-8c5b-e385c4ab9964",
                                                "sense_id": "183c63d8-6a2b-3c1c-a4b8-1c666e36620f",
                                                "text": "„Das bedeutendste Lapidarium des Mittelalters stammt von Marbod von Rennes (12. Jahrhundert).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
