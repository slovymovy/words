                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c290d617-ee59-4e3b-bb35-8745fc3d2e42",
                                "sense_id": "3fde6c0b-92e2-3bd7-94eb-363f385a8b8f",
                                "text": "Autrement dit, plus le décideur paie cher, plus il a l'impression d'hyper-sécuriser son informatique."
                            },
                            {
                                "example_id": "9b9bc1fe-30f1-499f-9d2b-2ddb2b96c8c0",
                                "sense_id": "3fde6c0b-92e2-3bd7-94eb-363f385a8b8f",
                                "text": "Un de ces quartiers « hyper-sécurisés » et quelque peu aseptisés que l'on retrouve dans plusieurs capitales à l'étranger, avec gardiens, terrains de sport et supermarchés remplis de produits occidentaux plantés au milieu des vastes villas."
                            },
