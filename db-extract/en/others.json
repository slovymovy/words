                                "target_senses": [
                                    {
                                        "sense_id": "ae1a4650-72c9-3691-b596-981de01c0110",
                                        "entry_id": "e06ce9a3-0e3c-3dfc-b417-5fa7bc7c3f39",
                                        "glosses": [
                                            "všichni další, zbývající"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9ecff5-8605-42a0-8c20-59cbe2f2dc2e",
                                                "sense_id": "ae1a4650-72c9-3691-b596-981de01c0110",
                                                "text": "Ostatní nepřišli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2000baf3-0b9b-30b3-8f7d-c976fc034423",
                                        "entry_id": "e06ce9a3-0e3c-3dfc-b417-5fa7bc7c3f39",
                                        "glosses": [
                                            "jiní"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4132034d-f2c1-407d-bead-8ecda0544bf8",
                                                "sense_id": "2000baf3-0b9b-30b3-8f7d-c976fc034423",
                                                "text": "Ostatní chlapci ho nezajímali."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5176f03f-de0e-48cf-a3cb-874b31e05e4a",
                        "source_entry_id": "24acc2da-2bcd-305e-806e-51e820909dfd",
                        "source_sense_description": "other people",
                        "target_lang_word": "les autres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "les autres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5822d6f5-fa12-3f60-a6b4-e945b07183b5",
                                        "entry_id": "e71687b7-ef7d-3d66-b89e-f22a979e8c8f",
                                        "glosses": [
                                            "Ensemble des personnes autre que soi-même, dans un tout indéterminé marquant nettement l'altérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb4ac2f-dd26-4824-a5f0-92e21b4c2156",
                                                "sense_id": "5822d6f5-fa12-3f60-a6b4-e945b07183b5",
                                                "text": "« L’enfer, c’est les autres », écrivait Jean-Paul Sartre en 1947."
                                            },
                                            {
                                                "example_id": "28a83eb9-6e7b-483f-9e6c-f7523f25ce93",
                                                "sense_id": "5822d6f5-fa12-3f60-a6b4-e945b07183b5",
                                                "text": "— Les autres! Les autres! Pense donc à toi, d'abord. Tu désespères ta mère. Je veux que tu réussisses ta vie à toi!"
                                            },
                                            {
                                                "example_id": "dd994ec0-51f3-4b26-b922-7259a5fb2d79",
                                                "sense_id": "5822d6f5-fa12-3f60-a6b4-e945b07183b5",
                                                "text": "Toutes les personnes présentes ont indiqué utiliser le chaussidou en voiture, mais ce sont « les autres qui n’en comprennent pas le fonctionnement ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
