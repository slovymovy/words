                                            {
                                                "example_id": "28ebced2-e84a-4c06-bbb8-909fbe70225e",
                                                "sense_id": "f777ee66-8ca4-3dd5-87ae-67a9698b8400",
                                                "text": "Klammere das Bild bitte gleich mit an den Antrag."
                                            },
                                            {
                                                "example_id": "0f383ead-0713-4593-b4ab-a2e8981e7f5d",
                                                "sense_id": "f777ee66-8ca4-3dd5-87ae-67a9698b8400",
                                                "text": "Wir klammern die Wunde statt zu nähen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "956560dc-5021-36c7-baf0-565dd24ad7f4",
                                        "entry_id": "50644634-5c61-3d7d-90a0-24c84823e8b8",
                                        "glosses": [
                                            "einen mathematischen Ausdruck mit Klammern umschließen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f11d8c-179f-4faf-b97d-948646f726e2",
                                                "sense_id": "956560dc-5021-36c7-baf0-565dd24ad7f4",
                                                "text": "2V * 3A + 4A = 14 Watt? Das muss geklammert werden!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95b78292-792d-363c-a018-3821d87dd3fa",
                                        "entry_id": "50644634-5c61-3d7d-90a0-24c84823e8b8",
                                        "glosses": [
                                            "sich verzweifelt an etwas festhalten"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a6fc9c0-e786-42ba-bf6a-b662e3479072",
                                                "sense_id": "95b78292-792d-363c-a018-3821d87dd3fa",
                                                "text": "Auf der Flucht klammerte sich das Junge fest in den Pelz seiner Mutter."
                                            },
                                            {
                                                "example_id": "c7a5ea52-998b-4f27-830f-7104ef719778",
                                                "sense_id": "95b78292-792d-363c-a018-3821d87dd3fa",
                                                "text": "Verzweifelt klammerten sie sich an den Gedanken auf Rettung durch die Suchmannschaft."
                                            },
                                            {
                                                "example_id": "b97d5939-1598-4e6e-96a4-bf30d643663c",
                                                "sense_id": "95b78292-792d-363c-a018-3821d87dd3fa",
                                                "text": "„Schwarze Amerikaner haben den großen Vorteil, nie an die gesammelten Mythen geglaubt zu haben, an die sich weiße Amerikaner klammern: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf9d8131-b46d-3589-9177-b5ffc36ae42b",
                                        "entry_id": "50644634-5c61-3d7d-90a0-24c84823e8b8",
                                        "glosses": [
                                            "einem Gegner durch Festhalten die Bewegungsfreiheit nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2719fc1b-1831-4906-9683-dd8ac9f0cc37",
                                                "sense_id": "cf9d8131-b46d-3589-9177-b5ffc36ae42b",
                                                "text": "Der Boxer klammert, um dann in eine bessere Position zu kommen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
