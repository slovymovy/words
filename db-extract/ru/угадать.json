                ],
                "translations": [
                    {
                        "translation_id": "c82150a6-4fd1-4189-81f0-cabcc8ea4d49",
                        "source_entry_id": "ba25132a-08f6-389a-ad02-53674cdee031",
                        "target_lang_word": "guess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To reach a partly (or totally) unconfirmed conclusion; to engage in conjecture; to speculate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d53f432-f88d-421c-8d0d-2adb7cd15164",
                                                "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                                "text": "We can only guess at what was going through her mind."
                                            },
                                            {
                                                "example_id": "77c31abe-bd15-410c-b385-45ba3f9e2d30",
                                                "sense_id": "b12137c8-5ff9-3bcd-9d15-6d250252490f",
                                                "text": "She guessed that the delivery driver must have got stuck in traffic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To solve by a correct conjecture; to conjecture rightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f832cca2-142e-4c8b-a80b-ba3724f68cd6",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "He who guesses the riddle shall have the ring."
                                            },
                                            {
                                                "example_id": "0393150c-c6aa-4e56-aaa4-5e8ab40525af",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "You guessed the right answer!"
                                            },
                                            {
                                                "example_id": "811df0ec-1c06-4f26-86c9-017f5105ff18",
                                                "sense_id": "874ed899-c8aa-3f1c-91e1-435df4491b8f",
                                                "text": "You will never guess what happened next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "to suppose, to imagine (introducing a proposition of uncertain plausibility)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d59b23-7c8e-4af2-8531-ec81945bb415",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "That album is quite hard to find, but I guess you could try ordering it online."
                                            },
                                            {
                                                "example_id": "3580b20e-ecc3-432f-a990-8aed62fca577",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "Not all together; better far, I guess, / That we do make our entrance several ways."
                                            },
                                            {
                                                "example_id": "89c8cb3c-d5d6-41fa-b036-631497c84914",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "But in known images of life I guess / The labour greater."
                                            },
                                            {
                                                "example_id": "d09dc485-6317-4f7f-b834-15340f61415a",
                                                "sense_id": "32e0efd9-3c91-3b8a-9491-8f57d7b2de04",
                                                "text": "\"Are you a member of the union?\"\n\"Sure.\"\n\"Then you'll get your job, I guess. Have you any friends?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To think, conclude, or decide (without a connotation of uncertainty). Usually in first person: \\\"I guess\\\"."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451fad31-0813-43aa-893a-db9c13a3d9ad",
                                                "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                                "text": "\"I guess you were right.\" \"What did he say?\" \"He guesses you were right.\""
                                            },
                                            {
                                                "example_id": "1a6be814-ffa5-4693-af90-dc3d9b1c17b9",
                                                "sense_id": "4a187c12-f2bc-3d8a-bc32-a0e492a69e69",
                                                "text": "\"I guess I'll go to bed.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d2a2bf7-8a10-35ec-ab82-07f0f7de56ca",
                                        "entry_id": "ff3705e7-e1b4-3dd7-862e-15dce4daf365",
                                        "glosses": [
                                            "To hit upon or reproduce by memory."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1755362b-d212-4486-88dc-61d4816b08de",
                                                "sense_id": "5d2a2bf7-8a10-35ec-ab82-07f0f7de56ca",
                                                "text": "Tell me their words, as near as thou canst guess them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                        "entry_id": "e0c50fe7-c266-3298-9c14-0ec0c08bf077",
                                        "glosses": [
                                            "A prediction about the outcome of something, typically made without factual evidence or support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbba3d86-fe31-496f-b81b-341d22a60fd3",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "If you don't know the answer, take a guess."
                                            },
                                            {
                                                "example_id": "22ad0faa-9352-4968-9fa7-065777050031",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "\"But I shall have eleven guesses,\" answered Ozma. \"Surely I ought to guess one object in eleven correctly; and, if I do, I shall rescue one of the royal family and be safe myself. Then the rest of you may attempt it, and soon we shall free all those who are enslaved.\""
                                            },
                                            {
                                                "example_id": "99aa70a8-d5e0-4e31-8b20-d5b132617cc2",
                                                "sense_id": "9796d83f-323f-3849-9ebd-e96a63fcaa58",
                                                "text": "We are twelve billion light years from the edge / That's a guess"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef553d72-ab1c-406c-bb03-90019a99df05",
                        "source_entry_id": "ba25132a-08f6-389a-ad02-53674cdee031",
                        "target_lang_word": "deviner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deviner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "802c04e2-1e15-3d3d-b11c-053270f2848b",
                                        "entry_id": "ea6b5c62-71fc-3fa0-9258-33881f4924d9",
                                        "glosses": [
                                            "Prédire ce qui doit arriver, découvrir, par des sortilèges, ce qui est caché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7405ba6-2e67-4aec-b002-2c07520770c5",
                                                "sense_id": "802c04e2-1e15-3d3d-b11c-053270f2848b",
                                                "text": "Il prétendait deviner où était caché le trésor."
                                            },
                                            {
                                                "example_id": "fade095e-8f18-4fd2-bc9f-a92763aad0f3",
                                                "sense_id": "802c04e2-1e15-3d3d-b11c-053270f2848b",
                                                "text": "L’art de deviner est une chimère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                        "entry_id": "ea6b5c62-71fc-3fa0-9258-33881f4924d9",
                                        "glosses": [
                                            "Parvenir à connaître, à découvrir par voie de conjecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6fe426-eb64-4236-b655-8953ba032d5d",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Comment tu as deviné que j'avais un cancer? - Ma tante aussi avait un point comme ça sur la peau."
                                            },
                                            {
                                                "example_id": "8de7cbe7-0cee-4a73-8921-1d178beb1e84",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Au fracas grinçant des roues, se devinait le cheminement des camions."
                                            },
                                            {
                                                "example_id": "a094ba02-67ee-4380-94aa-990cbcf819dd",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Une expression matoise parcourut le visage de l’homme aux lunettes noires sans qu’il me fût possible d’en deviner la cause."
                                            },
                                            {
                                                "example_id": "c00b78e6-0745-446d-b10c-0253ec4d6a25",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Depuis leur retour à Paris, Jim devinait et flairait dans l'air une espèce de coalition redoutable, dirigée de toute évidence contre eux."
                                            },
                                            {
                                                "example_id": "c007ea46-2b13-4f15-9447-794bc01bf2a7",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Il ne devinait pas encore combien l'âme de la jeune fille, déjà, lui appartenait. Il habitait chaque seconde de ses heures, chaque rêve de ses nuits."
                                            },
                                            {
                                                "example_id": "06123f4b-cb08-4abf-a60d-10fbc1279053",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "On ne sait pas qui elle est ; nul ne peut se douter qu’elle a des diplômes, ni qu’elle est issue d’une famille bourgeoise. Et voilà son bien le plus cher : elle ne sera devinée par personne."
                                            },
                                            {
                                                "example_id": "169fb604-5d3f-4440-a335-e7af2f8a3dd1",
                                                "sense_id": "9d10415f-2c99-3d76-b3df-e991f52ed558",
                                                "text": "Tandis que Louis Fronsac se faisait secouer comme un bouchon dans un torrent sur les chemins de France, Gaston de Tilly tentait de deviner comment des voleurs avaient pu pénétrer dans la nonciature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b15ac6c-1484-31ad-ab38-bc51f2b12940",
                                        "entry_id": "ea6b5c62-71fc-3fa0-9258-33881f4924d9",
                                        "glosses": [
                                            "Trouver le mot, la solution, en parlant d'une énigme, d'un logogriphe, d'une charade"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a658d257-fa8a-4883-a06c-505c8c15acf9",
                                                "sense_id": "1b15ac6c-1484-31ad-ab38-bc51f2b12940",
                                                "text": "Il n’y a là rien à deviner, c’est une chose claire par elle-même."
                                            },
                                            {
                                                "example_id": "60dd378c-c01e-480e-8d7b-7691d942bf9a",
                                                "sense_id": "1b15ac6c-1484-31ad-ab38-bc51f2b12940",
                                                "text": "Je vous le donne à deviner en dix, en cent, se dit en parlant d’une chose dont on suppose que celui à qui l’on parle ne se douterait jamais."
                                            },
                                            {
                                                "example_id": "af5ae953-afb4-4890-b721-c28a6c31999c",
                                                "sense_id": "1b15ac6c-1484-31ad-ab38-bc51f2b12940",
                                                "text": "Vous devinez le reste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a6c081-c087-33b7-abd6-cf482f0f36b8",
                                        "entry_id": "ea6b5c62-71fc-3fa0-9258-33881f4924d9",
                                        "glosses": [
                                            "Comprendre la personnalité, les pensées, les intentions ou les desseins de quelqu'un"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ede658-05df-4f45-a471-5f1db12ec3af",
                                                "sense_id": "44a6c081-c087-33b7-abd6-cf482f0f36b8",
                                                "text": "Fouché, dans ses Mémoires, avoue que ses plans ne réussirent pas; Talleyrand fut plus heureux, il contribua grandement à la restauration des Bourbons ; mais tous deux jouèrent gros jeu en conspirant contre un homme tel que Napoléon , qui les devina, et qui fut tenté plus d'une fois de les faire tout simplement fusiller."
                                            },
                                            {
                                                "example_id": "cbef902d-c807-480f-aa72-ce7e0d3ac1f5",
                                                "sense_id": "44a6c081-c087-33b7-abd6-cf482f0f36b8",
                                                "text": "Ces lettres étaient écrites sur un ton de familiarité affectueuse, et si Hervé avait voulu lire entre les lignes, il aurait facilement deviné que la marquise avait une forte inclination pour lui."
                                            },
                                            {
                                                "example_id": "0e834886-aebd-436b-b468-b4a21f614929",
                                                "sense_id": "44a6c081-c087-33b7-abd6-cf482f0f36b8",
                                                "text": "Il se rappela la fille Desroches et son cousin, qui avaient convenu, lorsqu’ils ne seraient pas seuls et s’embrasseraient en pensée, de porter leur main droite à leur front ; mais une amie les avait devinés et toutes les apprenties se poussaient du coude, quand Berthe saluait l’amour de son salut militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b1f488-1f39-3b21-af33-dfcd2c3a8bc8",
                                        "entry_id": "ea6b5c62-71fc-3fa0-9258-33881f4924d9",
                                        "glosses": [
                                            "Distinguer, voir, confusément par la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19860e82-d218-467b-93d9-db7e1ecb5af2",
                                                "sense_id": "16b1f488-1f39-3b21-af33-dfcd2c3a8bc8",
                                                "text": "Dans la pénombre des couchettes où dorment les matelots, on devine une photo de famille et une niche remplie de bondieuseries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
