                        "entry_id": "cf5cadb2-b640-3146-bfb5-ecb12d840f26",
                        "glosses": [
                            "The state or condition of being highly perceptive, as if in an almost hypnotic or telepathic state."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f838c697-9f9f-45c4-8635-4e68fd9b6f62",
                                "sense_id": "74c650f6-51ba-3682-84cf-712bf3f858a2",
                                "text": "She lay in a state of percipience without volition, and the rustle of the straw and the cutting of the ears by the others had the weight of bodily touches."
                            },
                            {
                                "example_id": "8604d3f6-f7f1-43cd-b071-141dacc16e1f",
                                "sense_id": "74c650f6-51ba-3682-84cf-712bf3f858a2",
                                "text": "Percipience is sometimes increased, with individuals observing that they are more astute in judging people, in seeing patterns in data, or in reading “micro-expressions of people” and nonverbal interpersonal nuances (e.g., “I think everyone is a lot happier,” “I judge people’s body language more accurately”)."
                            }
                        ]
                    }
