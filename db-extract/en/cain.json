                "entry_id": "2632e086-ff9a-34f0-a98b-25e8f281f318",
                "word": "Cain",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b497b78-198f-3b3f-b910-bb767654f608",
                        "entry_id": "2632e086-ff9a-34f0-a98b-25e8f281f318",
                        "glosses": [
                            "The son of Adam and Eve who killed his brother Abel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dacb3fb-f055-472e-8f5c-0f3d4b7f1473",
                                "sense_id": "0b497b78-198f-3b3f-b910-bb767654f608",
                                "text": "According to the Book of Jubilees Cain got married to his sister Awan."
                            },
                            {
                                "example_id": "aeb22fd4-da18-4b26-a638-225a07a4bcf7",
                                "sense_id": "0b497b78-198f-3b3f-b910-bb767654f608",
                                "text": "And Cain talked with Abel his brother: and it came to paſſe when they were in the field, that Cain roſe vp againſt Abel his brother, and ſlew him."
                            }
                        ]
                    },
