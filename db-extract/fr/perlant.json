                        "entry_id": "9bc7cf85-efa0-345e-81d9-3fdcf67903e2",
                        "glosses": [
                            "Vin perlant, vin légèrement pétillant."
                        ],
                        "tags": [
                            "Par substantivation"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8b79d6-7d5b-4f0b-907a-a60d7026baf1",
                                "sense_id": "cb8ee2bd-9e38-3193-8161-69b6f24bff8d",
                                "text": "Les perlants également appelés « perlés » laissent voir de très fines bulles fugaces et presque immobiles."
                            },
                            {
                                "example_id": "93be585a-7cc9-47f2-91a5-eb3ecbf0b42c",
                                "sense_id": "cb8ee2bd-9e38-3193-8161-69b6f24bff8d",
                                "text": "… ; à moitié vide, une bouteille de vin rouge – celui de la veille, un perlant sans prétention – se dressait sur la table de nuit, à côté des flacons de médicaments."
                            }
                        ]
                    }
                ],
