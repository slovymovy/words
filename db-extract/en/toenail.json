                                        "examples": [
                                            {
                                                "example_id": "7b64eb05-1560-4f47-82a9-14149b0f3a2a",
                                                "sense_id": "13decadf-b994-30f4-823f-651f63e58d9c",
                                                "text": "Joyce keert terug als een sterke, zelfstandige vrouw, die zich niet meer verschuilt achter haar baan, haar spullen, haar vrouwelijkheid. Die in haar eentje - „ik ben écht graag alleen” - naar een liefdeshotel gaat, zich opmaakt, baddert, zich van haar netgelakte teennagels tot haar perfect gekapte haar insmeert met groene klei en verandert in een levend standbeeld. Met deze serie wint ze de International Photography Award 2016."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
