                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "329da00e-ac11-454b-ba37-cfa0723da79b",
                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more symptomatic"
                    },
                    {
                        "form_id": "9aa076e3-67c6-4b1b-b374-9abcbb551e22",
                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                        "tags": [
