                                "target_senses": [
                                    {
                                        "sense_id": "b93b2103-831e-3103-b78b-75947234ba48",
                                        "entry_id": "0218f49c-43e7-3e4e-9961-143371f3804e",
                                        "glosses": [
                                            "artiest die het publiek met liedjes, grapjes en verhalen vermaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1615e291-521c-4c85-b3b0-5e6f1c49bf0e",
                                                "sense_id": "b93b2103-831e-3103-b78b-75947234ba48",
                                                "text": "Het zal geen toeval zijn dat Arjen Lubach en zijn eindredacteur Janine Abbring uit Groningen komen. Ook entertainer Freek de Jonge, geboren in die provincie, voert al een tijdje actie tegen het afschepen van mensen op een manier waar de NAM in de Randstad vermoedelijk niet mee weg zou komen."
                                            },
                                            {
                                                "example_id": "3d03ef35-a7dd-4b35-a6be-b63d4fd0f259",
                                                "sense_id": "b93b2103-831e-3103-b78b-75947234ba48",
                                                "text": "Hij was een bescheiden Britse kostschooljongen met een keurig Engels accent die, eenmaal op het podium, in een echte entertainer veranderde en als een kleine Mark Knopfler een weergaloze gitaarsolo neerzette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a6feef8-209a-4333-abb0-0a7fa1546620",
                        "source_entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                        "source_sense_description": "person who entertains",
                        "target_lang_word": "amuseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amuseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc065352-d6e3-309b-b7ea-c13361aeb14e",
                                        "entry_id": "6e312989-17b4-3b52-ae6f-79174d694f66",
                                        "glosses": [
                                            "Celui qui amuse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655225d1-bb28-439f-b00b-1f27e9fb29bb",
                                                "sense_id": "bc065352-d6e3-309b-b7ea-c13361aeb14e",
                                                "text": "Pour eux, tout artiste n’est qu’un amuseur, tout comédien ou chanteur, un guignol à leur solde, qu’ils admettent ou rejettent, le geste las."
                                            },
                                            {
                                                "example_id": "4119cc7b-9767-4de7-9b58-1305334a1dfc",
                                                "sense_id": "bc065352-d6e3-309b-b7ea-c13361aeb14e",
                                                "text": "En revanche, un amuseur involontaire n'a aucune raison d'espérer une récompense, et si l'on rit à ses dépens, il se voit même infliger une sorte de punition (déshonneur, dégradation morale)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fc513e8-2acd-4a7c-bf0c-819ea930b201",
                        "source_entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
