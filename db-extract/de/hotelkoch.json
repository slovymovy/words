                        "glosses": [
                            "jemand, der als Koch in einem Hotel arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deee8d48-a597-41d0-85ed-982374500653",
                                "sense_id": "fe9a54c3-7c50-38b3-852a-ef355375620d",
                                "text": "„In Kombination mit der extra-entrischen Lage wuchs sich das vor sieben, acht Jahren zum Finanzproblem aus, das Gasthaus wurde aufgegeben, und Jeitler verdingte sich als Hotelkoch in einem burgenländischen Wellnessressort.“"
                            },
                            {
                                "example_id": "fd6779d8-64e4-47c7-8c87-1cfdc544424f",
                                "sense_id": "fe9a54c3-7c50-38b3-852a-ef355375620d",
                                "text": "„Sie zeigt ein etwas mürrisch wirkendes Paar im Regen, das eigentlich nur die italienischen Hotelköche ein bisschen glücklich macht, die ihrer Signora Angela wieder einmal Pasta mit Sardellen auf den blütenweißen Teller zaubern können.“"
                            }
                        ],
