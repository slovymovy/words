                                "target_senses": [
                                    {
                                        "sense_id": "3515f75b-1908-377a-9d64-0c740593b728",
                                        "entry_id": "c51e5e25-952f-3f15-b4fa-60f8c75687e4",
                                        "glosses": [
                                            "Something with three legs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e66c89-1add-403f-8e7c-458cb7527010",
                                                "sense_id": "3515f75b-1908-377a-9d64-0c740593b728",
                                                "text": "The three-leggeds had everyone in stitches. Some pairs simply could not learn to run together — just impossible."
                                            },
                                            {
                                                "example_id": "5661dcb4-216a-4b54-a0d8-911fd3cea306",
                                                "sense_id": "3515f75b-1908-377a-9d64-0c740593b728",
                                                "text": "My father said that three-leggeds are more detestable than four-leggeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c60d7e-7172-3c83-b283-ad0ac4d2fa6b",
                                        "entry_id": "c51e5e25-952f-3f15-b4fa-60f8c75687e4",
                                        "glosses": [
                                            "An intersection where three roads meet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f4de65-6a9d-4b95-9bb5-aa13261c8a4f",
                                                "sense_id": "c7c60d7e-7172-3c83-b283-ad0ac4d2fa6b",
                                                "text": "With respect to hazard rating, an opposite and possibly inconsistent explanation might be offered: It may be that drivers underestimate roadside hazards at three-leggeds and relatively speaking overestimate them at four-leggeds."
                                            }
                                        ]
                                    }
