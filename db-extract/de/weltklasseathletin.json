                "senses": [
                    {
                        "sense_id": "725248f9-fbb2-31a6-99df-dd7f245611ed",
                        "entry_id": "bd646f88-ade9-365b-b01c-655fad0f41a4",
                        "glosses": [
                            "Sportlerin mit sehr guten sportlichen Leistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5149635a-f723-46f1-ae2b-3e2c16877921",
                                "sense_id": "725248f9-fbb2-31a6-99df-dd7f245611ed",
                                "text": "„Die 30-jährige Weltklasseathletin hatte sich vor dem Weltcuprennen am 13. Jänner in Ruhpolding den Fuß beim Joggen umgeknickt.“"
                            },
                            {
                                "example_id": "00d3887a-7c71-4a38-b3a0-cde9034e7296",
                                "sense_id": "725248f9-fbb2-31a6-99df-dd7f245611ed",
                                "text": "„Nach dem kapitalen Patzer von Carolin Schäfer drei Wochen zuvor im österreichischen Götzis, wo sie im Kugelstoßen drei Fehlversuche produzierte, stand die Weltklasseathletin mehr als gewollt unter Druck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
