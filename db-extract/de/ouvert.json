                                                "example_id": "7423bd90-1e8f-48db-888f-1800aa4f341f",
                                                "sense_id": "c5782288-405a-3360-bb2d-d6218977a9ef",
                                                "text": "Une élection primaire ouverte, une primaire ouverte."
