                                "sense_id": "53440cb9-1efb-3be7-b164-e26d9c9e783b",
                                "text": "Zij was de schranderste van de klas."
                            }
                        ]
                    },
                    {
                        "sense_id": "96dc6893-7979-3a63-b45b-2b695393d8ae",
                        "entry_id": "a13da910-eed9-31ff-88ac-5ee33bd86839",
