                "senses": [
                    {
                        "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                        "entry_id": "b7ac6f2b-20a3-38a6-8155-74f9d5bd4bac",
                        "glosses": [
                            "Gespräch zwischen der Bundesregierung und den Regierungschefs der Länder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e9cde8-8fe9-4dfe-be0c-edff4234ddce",
                                "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                                "text": "„Kanzlerin Merkel berichtet gemeinsam mit Bayerns Ministerpräsidenten Söder (l.) und Hamburgs Erstem Bürgermeister Tschentscher (2.v.r.) über die Bund-Länder-Beratung.“"
                            },
                            {
                                "example_id": "d805fffa-6f73-4dd0-96b5-224aaa9a10ea",
                                "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                                "text": "„Anlässlich der heutigen Bund-Länder-Beratung zur Nachschärfung des Düngerechts und den Äußerungen von Europa-Spitzenkandidat Manfred Weber (CSU) kommentiert Prof. Dr. Kai Niebert, Präsident des Umweltdachverbandes Deutscher Naturschutzring (DNR): […].“"
                            },
                            {
                                "example_id": "b8de0500-8c33-4c6e-9e92-733898b7a9e0",
                                "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                                "text": "„Ein weiteres Thema der Bund-Länder-Beratung war die Energiewende.“"
                            },
                            {
                                "example_id": "ae1b9ddf-02b5-4aaa-a592-a3a91647da40",
                                "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                                "text": "„Der Ministerpräsident betonte: ‚Nordrhein-Westfalen hat Ideen und Konzepte für die Bund-Länder-Beratungen geliefert und wird nun umsetzen, was die Länder gemeinsam mit der Bundeskanzlerin entscheiden.‘ “"
                            },
                            {
                                "example_id": "93e73265-4449-48c7-8a77-19b1e762b5cb",
                                "sense_id": "f870b1d1-071b-3244-a67b-b1c1460cdf27",
                                "text": "„Ursprünglich sollten die Bund-Länder-Beratungen direkt im Anschluss an das Treffen der Länderchefs am 22. April mit Kanzlerin Angela Merkel (CDU) stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
