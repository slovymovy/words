                "senses": [
                    {
                        "sense_id": "9bda27a4-9f6c-3e2f-b864-6f5d14119d20",
                        "entry_id": "820ce6ce-fb0a-309d-b147-519a2291070e",
                        "glosses": [
                            "Leisten von Erster Hilfe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf650416-10ad-48b8-b26a-1bacb871b203",
                                "sense_id": "9bda27a4-9f6c-3e2f-b864-6f5d14119d20",
                                "text": "„In seinem Blog behauptete er, dass bei Schumis Erstversorgung nach dem Ski-Unfall schwere Fehler gemacht worden seien.“"
                            },
                            {
                                "example_id": "1c7d4248-04ed-449b-8fe2-17559c515118",
                                "sense_id": "9bda27a4-9f6c-3e2f-b864-6f5d14119d20",
                                "text": "„Nationalspieler Benedikt Höwedes hat nach dem Unfall im Trainingscamp der deutschen Fußball-Nationalmannschaft bei der Erstversorgung geholfen.“"
                            },
                            {
                                "example_id": "7f36d194-109b-4a23-b980-06308ef99d97",
                                "sense_id": "9bda27a4-9f6c-3e2f-b864-6f5d14119d20",
                                "text": "„Zugenommen hat auch wieder die Zahl der medizinischen Erstversorgungen. Insgesamt 18 Mal rückte die Vaterstettener Feuerwehr aus, um verletzten oder erkrankten Mitbürgern zu helfen und somit die Zeit bis zum Eintreffen des Rettungswagens zu überbrücken.“"
                            },
                            {
                                "example_id": "aabbf375-746f-4436-8c99-140c9a1d9705",
                                "sense_id": "9bda27a4-9f6c-3e2f-b864-6f5d14119d20",
                                "text": "„60 Erstversorgungen gab es, elf davon wurden ins Klinikum transportiert und insgesamt waren allein dafür 639 Dienststunden von 54 Helfern nötig[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
