            {
                "entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                "word": "expressionniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20195a6a-1ac0-416d-a8d6-479077bafd8e",
                        "entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "expressionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                        "entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                        "glosses": [
                            "Adepte de l'expressionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f19132-57a6-42fa-b6c1-c7ca74c577da",
                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                "text": "Otto Dix est un expressionniste allemand."
                            },
                            {
                                "example_id": "dff99563-b23d-4ecd-ba37-c20a30e155c7",
                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                "text": "Paul Klee n’était pas à proprement parler un expressionniste typique."
                            },
                            {
                                "example_id": "1fdaf16d-beb2-488d-9c9a-d8a936714553",
                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                "text": "… il revient avec le coffret de thuya où il garde, avec son carnet de la Caisse Populaire et ses polices d'assurances\n (vie, feu, vol), les dessins de Laïnou. Elle les lui donne à mesure ; de toute façon ils sont sans valeur ; les critiques l'ont classée expressionniste abstraite, ça fait que tout ce qu'elle fait qui ressemble à de quoi ne vaut pas 5 cennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3f83c1e-431e-4e24-a113-a9dc51202095",
                        "source_entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                        "source_sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                        "target_lang_word": "Expressionist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Expressionist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                        "entry_id": "7aad4986-4307-376c-ae7d-9a601411d8e7",
                                        "glosses": [
                                            "Vertreter des Expressionismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "149830d1-2de7-4c06-b163-8d8d232bdd65",
                                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                                "text": "„Mit der Wiederentdeckung der Expressionisten hätte sich mein Vater gerne geschmückt.“"
                                            },
                                            {
                                                "example_id": "7d2be95d-4045-4e0d-bbe1-9d79cbb06d52",
                                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                                "text": "„Hanns Johst will helfen, aber Wolfgang Willrich, unterstützt von Ernährungsminister Walther Darré, greift auch ihn an, schließlich hat auch Johst als Expressionist und Jungautor »dumme Sachen« gemacht.“"
                                            },
                                            {
                                                "example_id": "7eff1050-2de3-487d-8dd1-51c0b35457fd",
                                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                                "text": "„Auf der nahe gelegenen Kurischen Nehrung konnte man den großen deutschen Expressionisten der Zeit beim Malen zusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
