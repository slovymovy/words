                "senses": [
                    {
                        "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                        "entry_id": "7c793f30-91c3-31ed-8145-1a75970b0e1a",
                        "glosses": [
                            "niedergeschlagener, trauriger, sorgenvoller Gefühlszustand"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "06335e4b-8cfc-4130-96a9-3dedbf637767",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "Trübsal hin, Trübsal her, du musst mal raus und unter Leute, los jetzt, zieh dir was Anständiges an!"
                            },
                            {
                                "example_id": "a3033c99-af0e-4fc7-9ce5-a3e419b24a57",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "Ich mag sie nicht besonders, diese Bilder, die nur zu sehr an Trübsal erinnern."
                            },
                            {
                                "example_id": "1269a4db-79af-4da6-84ed-4fa495fb57f0",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "Mein bester Freund steht mir auch in Zeiten der Trübsal bei."
                            },
                            {
                                "example_id": "a96402b4-78c6-4a55-aac0-707fff937ced",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "Ich habe keine Lust Trübsal zu blasen, lass uns ausgehen, am besten in eine Disko zum Tanzen!"
                            },
                            {
                                "example_id": "cbcef800-b7e5-41b0-b7ef-649c06379809",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "„Solche Menschen strömen eine graue Trübsal aus, die alles rings um sie her erfaßt.“"
                            },
                            {
                                "example_id": "809e3e2f-aab6-4854-b502-f51f1bc93c75",
                                "sense_id": "078bed3a-a56d-3cd6-bff3-8a15d3b424b8",
                                "text": "„Denn Mrs. Wetzel genoß zu guten Rufes unter den Männern von Hebron, als daß man sie schutzlos der Untüchtigkeit ihrer eigenen Landsleute und der Trübsal dauernder Witwenschaft hätte überlassen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
