                        "source_sense_description": "Person/Gruppe, die Frieden garantiert",
                        "target_lang_word": "peacekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peacekeeper",
