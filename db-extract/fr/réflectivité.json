                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42ad1a0e-7b1b-3bf4-869b-1c5333d2d29a",
                                        "entry_id": "ad4f182f-1d08-3a84-8292-3958b5300d67",
                                        "glosses": [
                                            "An automatic response to a simple stimulus which does not require mental processing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff96e16-2920-42de-b7d3-4c3126894892",
                                                "sense_id": "42ad1a0e-7b1b-3bf4-869b-1c5333d2d29a",
                                                "text": "For a while, I shall have to make a conscious effort to smile, nod, stand and perform the thousands of little gestures which constitute life on Earth, and then those gestures will become reflexes again."
                                            },
                                            {
                                                "example_id": "55b8d8f0-d699-470b-b688-3f407bf4f72d",
                                                "sense_id": "42ad1a0e-7b1b-3bf4-869b-1c5333d2d29a",
                                                "text": "He met Luis Suarez's cross at the far post, only for Chelsea keeper Petr Cech to show brilliant reflexes to deflect his header on to the bar. Carroll turned away to lead Liverpool's insistent protests that the ball had crossed the line but referee Phil Dowd and assistant referee Andrew Garratt waved play on, with even a succession of replays proving inconclusive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5966ed4d-e631-3307-af66-121815c973e6",
                                        "entry_id": "ad4f182f-1d08-3a84-8292-3958b5300d67",
                                        "glosses": [
                                            "The descendant of an earlier language element, such as a word or phoneme, in a daughter language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "735d424a-7e20-316b-942e-a43fb5b0d66f",
                                        "entry_id": "ad4f182f-1d08-3a84-8292-3958b5300d67",
                                        "glosses": [
                                            "The ancestor word corresponding to a descendant."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e722adb-ba82-4216-aadd-72ecf30075b6",
                                                "sense_id": "735d424a-7e20-316b-942e-a43fb5b0d66f",
                                                "text": "The Middle Korean reflex for mey was mwoy 뫼"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809ea241-03f9-32e3-a4f5-5b197febee25",
                                        "entry_id": "ad4f182f-1d08-3a84-8292-3958b5300d67",
                                        "glosses": [
                                            "The descendant of anything from an earlier time, such as a cultural myth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5ebeae-b6df-423d-8089-75ea4c1ad3bc",
                                                "sense_id": "809ea241-03f9-32e3-a4f5-5b197febee25",
                                                "text": "The superstition of the loup-garou, or werewolf, belongs to the folklore of most modern nations, and has its reflex in the story of \"Little Red Riding-hood\" and others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094047f6-99c6-3e16-9fa2-4649493026a2",
                                        "entry_id": "ad4f182f-1d08-3a84-8292-3958b5300d67",
                                        "glosses": [
                                            "A reflection or an image produced by a reflection; the light reflected from an illuminated surface to one in shade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d658cc9-cbe1-41d6-b9a1-d941a6b10a7b",
                                                "sense_id": "094047f6-99c6-3e16-9fa2-4649493026a2",
                                                "text": "A reflex camera uses a mirror to reflect the image onto a ground-glass viewfinder."
                                            },
                                            {
                                                "example_id": "9aae72ae-dbf6-4bf0-96d7-49685720b478",
                                                "sense_id": "094047f6-99c6-3e16-9fa2-4649493026a2",
                                                "text": "Yon gray is not the morning’s eye,\n ’Tis but the pale reflex of Cynthia's brow."
                                            },
                                            {
                                                "example_id": "cdace7d9-41a0-4b67-b653-f2dc0bbc4835",
                                                "sense_id": "094047f6-99c6-3e16-9fa2-4649493026a2",
                                                "text": "On the depths of death there swims\n The reflex of a human face."
                                            },
                                            {
                                                "example_id": "05b17afa-0901-47be-8b79-f53d1df516bb",
                                                "sense_id": "094047f6-99c6-3e16-9fa2-4649493026a2",
                                                "text": "Lucy is sleeping soundly; the reflex of the dawn is high and far over the sea[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reflex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb8ed8ea-4212-3d8b-8fc2-68a7c16148f9",
                                        "entry_id": "6b967022-62cf-32e6-b4b3-bcf3564e4e35",
                                        "glosses": [
                                            "Bent, turned back or reflected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b6f3c3-4754-4ffd-afdb-96d2b17e2435",
                                                "sense_id": "eb8ed8ea-4212-3d8b-8fc2-68a7c16148f9",
                                                "text": "the reflex act of the soul, or the turning of the intellectual eye inward upon its own actions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c3d6aca-5ea8-341c-9af6-2f8cb0c5baa9",
                                        "entry_id": "6b967022-62cf-32e6-b4b3-bcf3564e4e35",
                                        "glosses": [
                                            "Produced automatically by a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cfd8900-8bb5-420d-b05a-cb912297f602",
                                                "sense_id": "3c3d6aca-5ea8-341c-9af6-2f8cb0c5baa9",
                                                "text": "It's easier to focus on the particular relationship or object (as in 'pornography', for example) than on the sexist (racist, ageist, etc.) attitudes that generate the almost reflex violence taught in our schools, churches, legal processes, families, mass entertainment, and advertising propaganda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                        "entry_id": "6b967022-62cf-32e6-b4b3-bcf3564e4e35",
                                        "glosses": [
                                            "Having greater than 180 degrees but less than 360 degrees."
                                        ],
                                        "tags": [
                                            "of an angle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d74432fe-9dc9-4dc3-a062-31645e90e2be",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "P denotes a polygon and r the number of reflex vertices."
                                            },
                                            {
                                                "example_id": "12497384-a852-4a44-9c25-daf079011f16",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "A polygon is said to be convex when no one of its angles is reflex."
                                            },
                                            {
                                                "example_id": "c500c33b-17f2-4fa0-8655-c098754b9ee1",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "An angle less than a right angle is said to be acute; one greater than a right angle but less than a straight angle is said to be obtuse; one greater than a straight angle but less than a perigon is said to be reflex or convex."
                                            },
                                            {
                                                "example_id": "f17c0676-7151-4ecb-b3fc-71cbd4a4734d",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "If the reflex region is the interior of the angle, the dihedral angle is reflex."
                                            },
                                            {
                                                "example_id": "0d9a5766-4d09-48bb-937d-b0ef75258308",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "A reflex edge of a polyhedron is an edge where the inner dihedral angle subtended by two incident faces is greater than 180°."
                                            },
                                            {
                                                "example_id": "78bae78f-be9a-4344-a4ab-ded19078ac0e",
                                                "sense_id": "f7a907f5-ed3a-3702-a2e8-fa677667e689",
                                                "text": "We say that an angle is convex if it is not reflex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0316da10-59b0-3a7c-8ea7-b36b712d1850",
                                        "entry_id": "6b967022-62cf-32e6-b4b3-bcf3564e4e35",
                                        "glosses": [
                                            "Illuminated by light reflected from another part of the same picture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reflex",
