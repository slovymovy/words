                                    {
                                        "sense_id": "820c3150-37c3-31b0-b89b-e5582dceaf8e",
                                        "entry_id": "96179606-a606-3a5a-aff1-5cfedcd72cf8",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord levensmiddel"
                                        ],
                                        "tags": [
