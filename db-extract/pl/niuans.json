                                    {
                                        "sense_id": "d730d89b-7044-3c35-a9d2-5dfaafb18ebb",
                                        "entry_id": "8fb95c73-8788-30fd-a02d-5c625c56f2a5",
                                        "glosses": [
                                            "A minor distinction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17584d74-2aa1-4303-a8ca-e139c62e8dbe",
                                                "sense_id": "d730d89b-7044-3c35-a9d2-5dfaafb18ebb",
                                                "text": "hidden nuances"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d8d27b6-2056-3a11-86f6-1190e957a6aa",
                                        "entry_id": "8fb95c73-8788-30fd-a02d-5c625c56f2a5",
                                        "glosses": [
                                            "Subtlety or fine detail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43adebc1-514e-42da-9db0-14556ff9e8b8",
                                                "sense_id": "4d8d27b6-2056-3a11-86f6-1190e957a6aa",
                                                "text": "Understanding the basics is easy, but appreciating the nuances takes years."
                                            },
                                            {
                                                "example_id": "ca26e717-5a75-4ab7-ad7a-a0942b35931a",
                                                "sense_id": "4d8d27b6-2056-3a11-86f6-1190e957a6aa",
                                                "text": "[…] the richer our collections become, the more numerous are the proofs that all is more or less shaded (nuance), that the remarkable differences become obliterated […]"
                                            },
                                            {
                                                "example_id": "29e94fab-22b7-490f-b34e-9e4a478280ba",
                                                "sense_id": "4d8d27b6-2056-3a11-86f6-1190e957a6aa",
                                                "text": "It’s a miracle Lindsey Graham has met the concept of nuance. And this is the man who once warned “the world is literally about to blow up.” So you’re not dealing with someone who likes to dabble with grey areas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nuance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c78403-4769-3153-9d8f-2ae50523fe06",
                                        "entry_id": "0443c7cf-3905-32dc-973a-edbccdf964ed",
                                        "glosses": [
                                            "To apply a nuance to; to change or redefine in a subtle way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
