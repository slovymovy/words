                        "glosses": [
                            "iemand of groep die in een wedstrijd kampioen is geworden en er nog geen nieuwe wedstrijd is gehouden waarin iemand anders de kans heeft gehad om de titel over te nemen"
                        ],
                        "tags": [],
                        "examples": [
