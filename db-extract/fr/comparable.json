                                            {
                                                "example_id": "1ede1511-44bd-4749-8907-3943180659dd",
                                                "sense_id": "4bb52c79-9765-33b5-b191-53905e3c5b1d",
                                                "text": "Die Höhe der an die soziale Rechtfertigung zu stellenden materiellen Anforderungen muß daher […] rechtlich komparabel sein. - (Neue Juristische Wochenschrift, zitiert nach Wortschatz-Lexikon)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6efa27eb-4ced-3f21-8e4b-1c9f07e6cef0",
                                        "entry_id": "83b0fe15-f940-33b0-9c40-241e46e108f1",
                                        "glosses": [
                                            "steigerbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ba8582-61e6-4e6f-8f57-6b8585c61bba",
                                                "sense_id": "6efa27eb-4ced-3f21-8e4b-1c9f07e6cef0",
                                                "text": "Manche meinen, das Wort „schwarz“ sei nicht komparabel."
