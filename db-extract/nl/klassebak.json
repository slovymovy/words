                        "examples": [
                            {
                                "example_id": "19a99330-4c66-40e2-915e-5246e157912c",
                                "sense_id": "46d6b3ef-d67c-356f-ab07-c70dc2560084",
                                "text": "Op de achtergrond de truck waar hij niet onderdoor is kunnen rijden, ondanks zijn flitsende klassebak uit Beieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "d029ab31-508c-3032-a7c4-aedd0463f62e",
                        "entry_id": "0c3e7681-75f3-3235-a252-b8302a390273",
                        "glosses": [
                            "iets of iemand van zeer goede kwaliteit"
                        ],
                        "tags": [
