                                        "examples": [
                                            {
                                                "example_id": "5feaa384-c099-4d97-8900-254081253c2e",
                                                "sense_id": "04b64259-736e-3617-8c84-16012003ac06",
                                                "text": "Le bouddhisme est né sept siècles avant le christianisme. Cakia Mouni fut l’auteur des soutras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffea663-4526-30d1-9f7f-67c670509e06",
                                        "entry_id": "0f93c558-8053-3918-95f0-725fb68eed56",
                                        "glosses": [
                                            "Livre religieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f12a1273-c141-4597-ac00-4a731a2e099f",
                                                "sense_id": "4ffea663-4526-30d1-9f7f-67c670509e06",
                                                "text": "L’on peut encore se figurer à peu près l’état de ces premiers soutras chrétiens. C’étaient des espèces de fascicules de sentences et de paraboles, sans beaucoup d’ordre."
                                            }
                                        ]
                                    }
                                ]
                            }
