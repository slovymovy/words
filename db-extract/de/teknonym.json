                "senses": [
                    {
                        "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                        "entry_id": "8a0f04b3-6855-3980-adf2-5e35b78d223e",
                        "glosses": [
                            "Personenname oder Namensteil, der sich vom Namen eines Kindes ableitet"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "a58890c3-9320-4bed-a557-ce3629b41416",
                                "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                                "text": "„Wie in vielen anderen Regionen Indonesiens werden Männer und Frauen, sobald sie ihr erstes Kind haben, mit Teknonymen angeredet.“"
                            },
                            {
                                "example_id": "7258da8b-d1cc-49fb-8495-74ce822ac1a2",
                                "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                                "text": "„Nach dem Aufrücken in die Elterngeneration wird der persönliche Name durch ein Teknonym ersetzt, das sich vom Kind ableitet.“"
                            },
                            {
                                "example_id": "726acff0-a7b6-424a-b049-eca9e2fb1b70",
                                "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                                "text": "„Das kunya ist auffällig; denn Abū l-Yusr ist hier nicht Teknonym, bezieht sich also nicht auf einen Sohn dieses Namens, sondern bildet den Gegensatz zu der kunya des älteren Bruders Abū l-'Usr 'Alī b Muhammad.“"
                            },
                            {
                                "example_id": "3ba9855c-0da2-48d9-91ea-cacc0fa81de1",
                                "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                                "text": "„In indirekter Rede kann auch ein Teknonym verwendet werden, so z.B. dani-o-ama, Mutter von Dani.“"
                            },
                            {
                                "example_id": "fa1f8267-e70a-4f80-868e-a40cb3f29699",
                                "sense_id": "51b1b271-323c-38ae-9e3a-a075ef597615",
                                "text": "„Das auf eine bestimmte Person zur Anwendung kommende Teknonym, leitet sich von dem Namen ihres ältesten Sohnes ab und nur im Falle, daß kein Sohn vorhanden ist, auch von dem der ältesten Tochter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
