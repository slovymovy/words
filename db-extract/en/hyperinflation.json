                "senses": [
                    {
                        "sense_id": "cb87e5ea-b777-3736-b6a2-0c4c4a6dc754",
                        "entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                        "glosses": [
                            "Excessive inflation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "40ddea24-caf0-46dd-a7cd-933b15d77b88",
                                "sense_id": "cb87e5ea-b777-3736-b6a2-0c4c4a6dc754",
                                "text": "hyperinflation of the lungs"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                        "entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                        "glosses": [
                            "A very high rate of inflation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f67546a7-9a72-47f2-a1da-3284a0106ff6",
                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                "text": "Even though ten years elapsed between the German hyperinflation of 1923 and the seizure of power by Hitler, it is often suggested that the two events are causally related."
                            },
                            {
                                "example_id": "17673793-296e-45c6-9e8f-5dbb75e622c5",
                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                "text": "Only inconvertible paper currencies can be expanded rapidly without limit to generate hyperinflation."
                            },
                            {
                                "example_id": "c7d3b1e6-e042-4c97-a09c-22383618bb04",
                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                "text": "When hyperinflation peaked, wheelbarrows full of money were required to shop for groceries."
                            },
                            {
                                "example_id": "a41fd8f6-9c52-47b9-bcaf-3afc20ea857b",
                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                "text": "Javier Milei, a far-right libertarian presidential candidate, has made “dollarizing” Argentina a signature proposal of his campaign, hailing it as a cure for the country’s hyperinflation problem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fa94ead-5c84-4c8e-9920-bed4783c17b5",
                        "source_entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                        "source_sense_description": "economic inflation at a very high rate",
                        "target_lang_word": "hyperinflace",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperinflace",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a3dc61cb-a9c0-3e28-a891-6ae401691001",
                                        "entry_id": "b5183db4-2e72-3213-bf7c-e11da16bd4d6",
                                        "glosses": [
                                            "velmi vysoká inflace, technicky definovaná různě, například Caganem jako taková, že její měsíční míra překročí 50 procent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f296a392-5dce-4d74-8f53-af74886f3368",
                                                "sense_id": "a3dc61cb-a9c0-3e28-a891-6ae401691001",
                                                "text": "Zimbabwský dolar zanikl v roce 2009 po období hyperinflace, která na konci roku 2008 podle MMF dosáhla 500 miliard procent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f082ef7-7428-45cb-a37c-64e09daba84f",
                        "source_entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                        "source_sense_description": "economic inflation at a very high rate",
                        "target_lang_word": "hyperinflatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperinflatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5d66fdac-587d-3371-af08-24adf1aa491a",
                                        "entry_id": "2f328d1c-8f82-3c76-a5ec-ef386caca55a",
                                        "glosses": [
                                            "zeer snelle geldontwaarding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299518ca-494c-4665-ab70-bbe1fcdb2a53",
                                                "sense_id": "5d66fdac-587d-3371-af08-24adf1aa491a",
                                                "text": "Zimbabwe verhoogt rente naar 200 procent in strijd tegen hyperinflatie: De centrale bank van Zimbabwe heeft het belangrijkste rentetarief opgevoerd naar een recordhoogte. Dat doen de beleidsmakers om de torenhoge inflatie in het Afrikaanse land te beteugelen. Ook hopen ze de wisselkoers van de Zimbabwaanse dollar enigszins stabiel te krijgen."
                                            },
                                            {
                                                "example_id": "c5751417-1c1a-420d-8332-75926c5547f3",
                                                "sense_id": "5d66fdac-587d-3371-af08-24adf1aa491a",
                                                "text": "Alleen al het onroerendgoedarsenaal in Berlijn en Dresden bezat waarschijnlijk een waarde die niet zomaar in geld was uit te drukken. En dat was geheel en al Oscars verdienste. Met wat hulp van de Duitse hyperinflatie in de jaren twintig, om helemaal eerlijk te zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5c43dc0-bc08-4fb2-be58-81ec41398e80",
                        "source_entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                        "source_sense_description": "economic inflation at a very high rate",
                        "target_lang_word": "hyperinflation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperinflation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                                        "entry_id": "ca33b27a-6ba0-3d1d-a545-d010bc7af075",
                                        "glosses": [
                                            "Inflation excessive."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "268e0f33-4bfb-4fa1-aa00-c0e00c39aa81",
                                                "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                                                "text": "Si la hausse du déficit budgétaire se poursuit, on va connaitre l’hyperinflation."
                                            },
                                            {
                                                "example_id": "62acc9b4-1376-4be5-a562-f209f3c64259",
                                                "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                                                "text": "La devise sombre dans l’hyperinflation et un transfert massif de richesse s’'effectue vers ceux qui ont eu la prévoyance de placer leur pouvoir d’achat dans les bons actifs avant l’incendie monétaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1cdf9e0-5c0d-442f-ad53-b4277d6837a6",
