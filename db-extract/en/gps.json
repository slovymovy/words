                "senses": [
                    {
                        "sense_id": "6add9f49-dd10-38f6-9c2f-84cecd9c048b",
                        "entry_id": "a3714857-5ba3-3ee3-92a9-09784dfae124",
                        "glosses": [
                            "Initialism of Global Positioning System (“a U.S. military-based satellite navigation system”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "0a566717-46b9-46d4-ab32-a35643cba59f",
                                "sense_id": "6add9f49-dd10-38f6-9c2f-84cecd9c048b",
                                "text": "Since then he has been an Consultant Engineer within INMOS, specialising in GPS and satcomms applications of the transputer."
                            },
                            {
                                "example_id": "35a683ba-af03-4423-b451-f77f3721ed49",
                                "sense_id": "6add9f49-dd10-38f6-9c2f-84cecd9c048b",
                                "text": "While it is easy to dismiss GPS art as nothing more than the misuse of a system meant to provide information, the spatial intelligence required to create these works is something to admire (Farman, 2014)."
                            },
                            {
                                "example_id": "610cf272-b571-49c6-a5b2-61b1405b8a8d",
                                "sense_id": "6add9f49-dd10-38f6-9c2f-84cecd9c048b",
                                "text": "A TIGER, a bear and a T-Rex dinosaur are among the GPS art created by a runner."
                            }
                        ]
                    }
                ],
