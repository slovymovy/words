                                        "glosses": [
                                            "hevige sneeuwval gepaard met sterke wind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4029cada-5180-4115-becd-f6703a96c093",
                                                "sense_id": "6825fa44-c0df-3c77-bedf-bafb8e05f3ee",
                                                "text": "Door de sneeuwstorm kon ik niet naar mijn werk komen."
                                            },
                                            {
                                                "example_id": "9f8e0d09-805c-4e89-8d62-0a21d77b48e1",
                                                "sense_id": "6825fa44-c0df-3c77-bedf-bafb8e05f3ee",
                                                "text": "De een-na-laatste dag werd ik getroffen door een enorme sneeuwstorm die de hele dag duurde."
                                            },
                                            {
                                                "example_id": "eadff846-43c0-4e6a-adbe-638caa33639e",
                                                "sense_id": "6825fa44-c0df-3c77-bedf-bafb8e05f3ee",
                                                "text": "Er is slechts een beperkt aantal maanden (tussen maart en september) geschikt om de sneeuwstormen te vermijden in de High Sierra’s en de Cascadebergen bij Canada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
