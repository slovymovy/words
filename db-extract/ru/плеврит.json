                "senses": [
                    {
                        "sense_id": "f35c05cb-5251-3a1b-9147-c05f6e2753cc",
                        "entry_id": "b952d720-de68-350b-8038-b3f1917a5f1f",
                        "glosses": [
                            "мед. воспаление плевры при туберкулёзе, пневмонии, ревматизме, сопровождающееся повышением температуры, одышкой, кашлем, болями в груди"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a180fb-89e0-498b-acd0-ac8aa841c788",
                                "sense_id": "f35c05cb-5251-3a1b-9147-c05f6e2753cc",
                                "text": "Но воспаление быстро опустилось ниже, и образовался гнойный плеврит."
                            },
                            {
                                "example_id": "d9432f73-7236-472a-8dab-16a11cf2c8d4",
                                "sense_id": "f35c05cb-5251-3a1b-9147-c05f6e2753cc",
                                "text": "В дороге простужается, плеврит даёт высокую температуру, он уже почти не встаёт с постели."
                            }
                        ]
                    }
