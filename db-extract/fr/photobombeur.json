                    {
                        "sense_id": "107551e7-b6ac-3554-80a6-769c32fec734",
                        "entry_id": "397700be-43ef-3ab4-abab-e891af513c6f",
                        "glosses": [
                            "Personne qui se glisse dans une scène à photographier de façon à dénaturer le sens de la photo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87092d00-d331-4c20-ab3c-a2b79979e54d",
                                "sense_id": "107551e7-b6ac-3554-80a6-769c32fec734",
                                "text": "Au moment de dire « Cheese ! », le photobombeur a pour mission de faire une pose débile ou au contraire très sérieuse derrière sa victime."
                            },
                            {
                                "example_id": "40555150-68c7-4066-9bf2-ee15f8ffb6d4",
                                "sense_id": "107551e7-b6ac-3554-80a6-769c32fec734",
                                "text": "Pourrir la photo hyper romantique et totalement dégoûtante du petit couple de devant est un bon début pour tout photobombeur qui se respecte"
                            },
                            {
                                "example_id": "61fd55ba-1449-4767-ac59-4ea488ef4a89",
                                "sense_id": "107551e7-b6ac-3554-80a6-769c32fec734",
                                "text": "Le premier photobombeur de l’année est un phoque."
                            }
                        ]
                    }
