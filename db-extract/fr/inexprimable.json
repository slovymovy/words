        "fr-extract.jsonl": [
            {
                "entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                "word": "inexprimable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ec0266a-a97e-42c4-8fc6-6c4267badf6d",
                        "entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inexprimables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                        "entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                        "glosses": [
                            "Qu’on ne peut exprimer par des paroles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d4823b-b739-444a-a9ca-e3cbeeafc27d",
                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                "text": "Une rage inexprimable rendit le capitaine plus blanc que ses voiles."
                            },
                            {
                                "example_id": "6f37c09c-ae55-4082-8dc2-9b661a36fab6",
                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                "text": "Celui de Laifour, qui est dans un véritable désert, nous peint en mots bien sentis la monotonie de son existence. En hiver, quand la neige couvre la montagne, la solitude est inexprimable."
                            },
                            {
                                "example_id": "2e04bb74-446b-45fc-82a4-50282b8d50b8",
                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                "text": "Il reprit vaguement son chemin vers la ville, baissant le front sous une inexprimable honte."
                            },
                            {
                                "example_id": "1a245169-5d72-442f-ac93-5e9e981a76cc",
                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                "text": "Au carré, dans les cabines et les laboratoires, le désordre est inexprimable ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6e12d23-a864-4236-ab72-e035aff5a194",
                        "source_entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                        "source_sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                        "target_lang_word": "unaussprechbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaussprechbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cf1c505-86f2-3c9d-8847-af8cc00e6ada",
                                        "entry_id": "32387260-013e-33dd-aa0a-506e32a17e90",
                                        "glosses": [
                                            "so, dass es nicht ausgesprochen werden kann (auch figurativ)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d8d93d-4e81-40f5-a5fc-692ca4b81b5a",
                                                "sense_id": "8cf1c505-86f2-3c9d-8847-af8cc00e6ada",
                                                "text": "„Johann hatte das Kind nach dem geliebten Paris gesandt, hatte es dort bei seiner Schwester, des Dauphins Gemahlin, erziehen lassen. Dort hatte der junge Wenzel seinen Namen (tschechisch: Václav), der für die Franzosen unaussprechbar war, in Karl geändert.“"
                                            },
                                            {
                                                "example_id": "4b05189b-9224-4a24-a31b-23fa62c281af",
                                                "sense_id": "8cf1c505-86f2-3c9d-8847-af8cc00e6ada",
                                                "text": "„Damals wäre es mir noch unaussprechbar schrecklich gewesen, wenn irgend jemand in der Stadt von meinen Sorgen und unseren Streitereien erfahren hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da2d7c27-ae94-4524-9a59-00d9e8d1bc07",
                        "source_entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                        "source_sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                        "target_lang_word": "inexpressible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexpressible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                        "entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                                        "glosses": [
                                            "Unable to be expressed; not able to be put into words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2c4a89-519c-4d93-beea-bed13ef49157",
                                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                                "text": "She felt inexpressible contempt for her attackers."
                                            },
                                            {
                                                "example_id": "bdd055fe-f449-4509-95d0-b868e02295eb",
                                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                                "text": "That noise, that awful clamour of uncouthness inexpressible, is the love-call of the storm bird!"
                                            },
                                            {
                                                "example_id": "0bf222ba-5ff4-42a7-b3a1-de524819222e",
                                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64b9b569-424d-4371-b92a-0b362d948d1f",
                        "source_entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                        "source_sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                        "target_lang_word": "unspeakable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unspeakable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4ddaf8-96a4-3e59-a29e-73992f441441",
                                        "entry_id": "58110c1f-9849-388a-8ff0-6f4131abf32a",
                                        "glosses": [
                                            "Incapable of being spoken or uttered"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5860dd-b53e-4a65-90ef-c83e80869452",
                                                "sense_id": "6a4ddaf8-96a4-3e59-a29e-73992f441441",
                                                "text": "1855-1882, Walt Whitman, Leaves of Grass, book xv,\nThe endless pride and outstretching of man, unspeakable joys and sorrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d44db7-322d-33b3-a98c-134849742748",
                                        "entry_id": "58110c1f-9849-388a-8ff0-6f4131abf32a",
                                        "glosses": [
                                            "Impossible to speak about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d10f95f-cf8f-41c5-b9a2-eff4e3ffb6bb",
                                                "sense_id": "e0d44db7-322d-33b3-a98c-134849742748",
                                                "text": "It is true that during the first week hardly a day passed that Erskine did not address himself to Watt, on the subject of Watt's duties. But in the first week Watt's words had not yet begun to fail him, or Watt's world to become unspeakable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bc6aea-15ad-36cd-afc8-b512cce102a0",
                                        "entry_id": "58110c1f-9849-388a-8ff0-6f4131abf32a",
                                        "glosses": [
                                            "Unfit or not permitted to be spoken or described."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d08d8f-903e-46f0-9454-77584496d28d",
                                                "sense_id": "b6bc6aea-15ad-36cd-afc8-b512cce102a0",
                                                "text": "The miser will remember his hoard of gold, the robber his ill-gotten wealth, the angry and revengeful and merciless murderers their deeds of blood and violence in which they revelled, the impure and adulterous the unspeakable and filthy pleasures in which they delighted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b64f807-c0d0-3cdd-ba38-c663378e6c11",
                                        "entry_id": "58110c1f-9849-388a-8ff0-6f4131abf32a",
                                        "glosses": [
                                            "Extremely bad or objectionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aafce8e0-8df0-4b18-8c55-dfb168671ff7",
                                                "sense_id": "7b64f807-c0d0-3cdd-ba38-c663378e6c11",
                                                "text": "an unspeakable fool"
                                            },
                                            {
                                                "example_id": "37d7cb17-1655-4dd5-9b65-83e94c7a30bb",
                                                "sense_id": "7b64f807-c0d0-3cdd-ba38-c663378e6c11",
                                                "text": "an unspeakable play"
                                            },
                                            {
                                                "example_id": "7919d7cf-df69-45b2-9319-500575347450",
                                                "sense_id": "7b64f807-c0d0-3cdd-ba38-c663378e6c11",
                                                "text": "Yet to my horror I saw in its eaten-away and bone-revealing outlines a leering, abhorrent travesty on the human shape; and in its mouldy, disintegrating apparel an unspeakable quality that chilled me even more."
                                            },
                                            {
                                                "example_id": "ea3a4925-4927-42f6-b090-7429d55b7705",
                                                "sense_id": "7b64f807-c0d0-3cdd-ba38-c663378e6c11",
                                                "text": "Anyone who goes into a voting booth on November the 8th and comes out saying, “I feel a hundred percent great about what I just did in there!,” is either lying to themselves, or did something unspeakable in that booth! And that means, as uncomfortable as this is, everyone has to own the floors of whoever you vote for, whether they are a lying handsy narcissistic sociopath, a hawkish Wall Street-friendly embodiment of everything that some people can’t stand about politics, an ill-tempered mountain molester with a radical dangerous tax plan that even he can’t defend, or a conspiracy-pandering political neophyte with no clear understanding of how government operates and who once recorded this folk rap about the virtues of bicycling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "008260df-ae36-3205-b9c0-04ca3b329855",
                                        "entry_id": "58110c1f-9849-388a-8ff0-6f4131abf32a",
                                        "glosses": [
                                            "That cannot be referenced in source code, due to having no usable name."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a807b5d0-cbe6-415c-8c66-579fa30e6ae6",
                                                "sense_id": "008260df-ae36-3205-b9c0-04ca3b329855",
                                                "text": "an instance of an unspeakable type"
                                            },
                                            {
                                                "example_id": "1058f030-a4f7-43b7-84e3-e265b6a19541",
                                                "sense_id": "008260df-ae36-3205-b9c0-04ca3b329855",
                                                "text": "unspeakable field names"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unspeakable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01c87e8d-b3b1-33a2-aaf4-17fd6848e18e",
                                        "entry_id": "8a5c7a21-be5e-3061-b718-4e63e7b7f37f",
                                        "glosses": [
                                            "Something that cannot or must not be spoken about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7144aca-175a-4a82-9565-5fa9c4af3368",
                                                "sense_id": "01c87e8d-b3b1-33a2-aaf4-17fd6848e18e",
                                                "text": "The longer we don't speak about the unspeakables, the more harm they do to the relationship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
