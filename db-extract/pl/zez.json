                                        "examples": [
                                            {
                                                "example_id": "258516c5-edcf-4413-ba4e-ce661932eae6",
                                                "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                                                "text": "The children squinted to frighten each other."
                                            },
                                            {
                                                "example_id": "66ca37ca-9a52-41bb-aa9e-9f642117fa66",
                                                "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b235a0bf-7002-3de5-909c-fc4edb63e7e7",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To look or glance sideways."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f89108a-6c79-30cb-8f27-2971307438c5",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
