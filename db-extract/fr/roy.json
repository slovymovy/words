                "senses": [
                    {
                        "sense_id": "0a872b37-4872-3568-ae3e-3e272e1732f6",
                        "entry_id": "fe433cd8-fc58-3a04-b43a-1f8b29725d10",
                        "glosses": [
                            "De 1694 à 1740 : Orthographe de l’Académie française de roi."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3de32834-5bcb-4efe-92f4-a03d8d983070",
                                "sense_id": "0a872b37-4872-3568-ae3e-3e272e1732f6",
                                "text": "le roy des rois"
                            }
                        ]
                    },
                    {
                        "sense_id": "50154971-89af-399d-99a0-3fde56813212",
                        "entry_id": "fe433cd8-fc58-3a04-b43a-1f8b29725d10",
                        "glosses": [
                            "Depuis 1740 : Orthographe archaïsante de roi."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "08cd418c-b39d-4cf4-93bf-ade8aa92087e",
                                "sense_id": "50154971-89af-399d-99a0-3fde56813212",
                                "text": "Fière chevalière\nArthur le roy\nNe reniera\nTe gardera\nO Damoiselle\nMasquée seras\nExcellemment.\nTruands, larrons\nTerriblement\nEnchaîneras."
                            },
                            {
                                "example_id": "2293c79f-2314-44b1-8a08-e4a30d3a0d42",
                                "sense_id": "50154971-89af-399d-99a0-3fde56813212",
                                "text": "Hostellerie (du Roy Henry) : Il était une fois trois restaurants : dans l’un les couteaux n’étaient pas affûtés. Dans le second, ils l’étaient, et l’on trouvait par conséquent la viande meilleure. Mais c’est le troisième qui faisait payer le plus cher, et savez-vous pourquoi ? Parce qu’il avait rajouté un s et deux y à son enseigne."
                            }
                        ]
                    }
                ],
