                "senses": [
                    {
                        "sense_id": "027cebec-8471-3a37-85ee-4aaff6c216f7",
                        "entry_id": "505f29cd-437b-3399-ac2d-c90629bc9d8d",
                        "glosses": [
                            "Redresser quelque chose qui était gondolé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff59a03-b663-4509-80ed-7dc323e36d48",
                                "sense_id": "027cebec-8471-3a37-85ee-4aaff6c216f7",
                                "text": "Il faudrait tout démonter, puis reconstituer après avoir consolidé l’ensemble et « dégondolé » le carton."
                            },
                            {
                                "example_id": "dc165404-01db-4dde-87bb-068769d8f8fa",
                                "sense_id": "027cebec-8471-3a37-85ee-4aaff6c216f7",
                                "text": "Alfred, le noir matador du Niger qui avait, sa vie durant, pour presque rien, dégondolé des tôles par économie et à coups de marteau, passa sous la file des élus dans un tonnerre d’applaudissements."
                            },
                            {
                                "example_id": "fe79a53d-4f8b-446f-bca3-0cbd8c61a97e",
                                "sense_id": "027cebec-8471-3a37-85ee-4aaff6c216f7",
                                "text": "Voici une technique que je n’ai pas testée mais qui a l’air de fonctionner pour « dégondoler » vos vinyles."
                            }
                        ]
                    }
