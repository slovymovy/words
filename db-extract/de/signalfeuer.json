                        "glosses": [
                            "Feuer, mit dem eine bestimmte Information übermittelt werden soll (zum Beispiel eine Notsituation)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3675bf26-b840-4472-ae62-3df8ca7d7f9f",
                                "sense_id": "f260d0d3-e150-3301-b765-9f6e26ac8f2c",
                                "text": "„Als er einen ausreichenden Vorrat an Brennholz aufgestapelt hatte, beschloss er, gleich ein Signalfeuer zu machen.“"
                            },
                            {
                                "example_id": "09688647-03cf-4e05-b560-d5cf59f4f2eb",
                                "sense_id": "f260d0d3-e150-3301-b765-9f6e26ac8f2c",
                                "text": "bildlich: „Wir tragen die Verantwortung für das Leben: das kleine Signalfeuer in der beängstigenden Dunkelheit, aus der wir kommen und in die wir zurückkehren werden.“"
                            }
