                                    },
                                    {
                                        "sense_id": "adc44276-5df3-3fba-a0bd-de0139c9ee79",
                                        "entry_id": "118f5a5f-4ee2-30b7-a713-2753e186a882",
                                        "glosses": [
                                            "To remove high-temperature scale and oxidation from metal with heated (often sulphuric) industrial acid."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15297b67-b6fa-4343-8fc4-16006e483bd7",
                                                "sense_id": "adc44276-5df3-3fba-a0bd-de0139c9ee79",
                                                "text": "The crew will pickle the fittings in the morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5948d09-0df5-3a5d-9d05-10a4499e1205",
                                        "entry_id": "118f5a5f-4ee2-30b7-a713-2753e186a882",
                                        "glosses": [
                                            "To serialize."
                                        ],
                                        "tags": [
                                            "in Python"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16b230c-b188-4eb8-92a1-34cf76d80fbe",
                                                "sense_id": "f5948d09-0df5-3a5d-9d05-10a4499e1205",
                                                "text": "You can now restore the pickled data. If you like, close your Python interpreter and open a new instance, to convince yourself […]"
                                            },
                                            {
                                                "example_id": "6d9ede53-3947-47d8-b4a0-65f3e30a3f96",
                                                "sense_id": "f5948d09-0df5-3a5d-9d05-10a4499e1205",
                                                "text": "To illustrate how this would work in practice, consider a field designed to store and retrieve a pickled copy of any arbitrary Python object."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca928f21-2c69-3b27-9b86-61db06fc9bd6",
                                        "entry_id": "118f5a5f-4ee2-30b7-a713-2753e186a882",
                                        "glosses": [
                                            "To pour brine over a person after flogging them, as a method of punishment."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "983ae627-1fd6-4115-926b-731a3723d243",
                                                "sense_id": "ca928f21-2c69-3b27-9b86-61db06fc9bd6",
                                                "text": "On Wednesday 26 May, […] I had [an enslaved man] flogged and pickled and then made Hector shit in his mouth. […] In July, […] Gave [another enslaved man] a moderate whipping, pickled him well, made Hector shit in his mouth, […]"
                                            },
                                            {
                                                "example_id": "cc75aae9-37d5-4c19-a7cd-fe3163f060a3",
                                                "sense_id": "ca928f21-2c69-3b27-9b86-61db06fc9bd6",
                                                "text": "Naval seamen could also be keel-hauled, ducked, pickled, and flogged around the fleet.\n[elsewhere, page 93, the book explains:] A pickled man had his flogged back washed with vinegar."
                                            }
                                        ]
                                    }
                                ]
                            },
