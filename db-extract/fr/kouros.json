                                        "entry_id": "385a75ef-d1d6-3de7-ba85-76b0068077bc",
                                        "glosses": [
                                            "A sculpture of a naked youth in Ancient Greece, the male equivalent of a kore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a8086be-00aa-458b-b221-2c2f0049fec5",
                                                "sense_id": "c3526e2f-bb6f-3778-a13a-f60403899451",
                                                "text": "A redstone kouros from Sounion, this strapping young Amsterdammer, translated into the slenderer grace of the modern graminivore."
                                            },
                                            {
                                                "example_id": "0f8369a7-a1e4-4ddc-845d-982734d75eff",
                                                "sense_id": "c3526e2f-bb6f-3778-a13a-f60403899451",
                                                "text": "The smiling kouros is the first fully free-standing sculpture in art."
                                            }
                                        ]
                                    }
