                                "target_senses": [
                                    {
                                        "sense_id": "7323a14c-7c33-3327-874f-0bbe86e1677d",
                                        "entry_id": "ad947583-471f-3b26-992d-4bee790721e5",
                                        "glosses": [
                                            "A French parfait (parfait glacé), an iced dessert made with egg yolks, sugar, cream, and flavouring (usually fruit), sometimes with the addition of a liqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f3214d-022b-4d9d-b613-0c2bb702d7c3",
                                                "sense_id": "7323a14c-7c33-3327-874f-0bbe86e1677d",
                                                "text": "Brad hesitated, peering at the grid of spun sugar that jutted from his loganberry parfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00652321-24bd-3c87-bb48-66e63d426882",
                                        "entry_id": "ad947583-471f-3b26-992d-4bee790721e5",
                                        "glosses": [
                                            "An American parfait, a layered dessert often consisting of fruit, ice cream, pastries, whipped topping, etc. and served in a glass, often a parfait glass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "524f4fc1-8e35-3cbe-9f6a-a70226ec5762",
                                        "entry_id": "ad947583-471f-3b26-992d-4bee790721e5",
                                        "glosses": [
                                            "A smooth pâté, usually made from liver and flavoured with liqueurs."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f20a2382-75fc-4c17-9818-cf6118194d7f",
                        "source_entry_id": "61b81e88-1e21-36ee-b489-ba3bc9808b40",
                        "source_sense_id": "e59ccb8c-bca5-346c-a9d9-204e8b8c0a24",
                        "source_sense_description": "Gastronomie: eine Art Speiseeis aus Eigelb, eventuell auch Eischnee, Sahne, Zucker und Aromen",
                        "target_lang_word": "parfait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7922cda-88b2-36c4-ad2d-ac027893d9b7",
                                        "entry_id": "5a5246ad-6eb5-3ce1-95b2-4b52df0bddec",
                                        "glosses": [
                                            "Qui réunit toutes les qualités, sans nul mélange de défauts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9995c19b-9371-46d3-9da3-575ab0636774",
                                                "sense_id": "d7922cda-88b2-36c4-ad2d-ac027893d9b7",
                                                "text": "La télévision retransmettait en boucle la performance parfaite de Nadia Comaneci aux barres asymétriques. … La perfection, répétait le commentateur éberlué, qui paraissait à bout de souffle. J'avais presque envie de lui dire : Calmez-vous, mon vieux! Des tas de choses sont parfaites : les aurores boréales, les fjords de la baie d'Ungava, l'obscurité polaire, le moindre flocon de neige est parfait ! …"
                                            },
                                            {
                                                "example_id": "c11c1a0c-fe7a-4869-8ad1-34853db0d5d8",
                                                "sense_id": "d7922cda-88b2-36c4-ad2d-ac027893d9b7",
                                                "text": "Deux épéistes se sont livrés à un duel devant un superbe fond de pleine lune. Une initiative qui a permis à un photographe italien, Francesco Fanti, de capturer deux silhouettes parfaites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60279276-8019-3465-ad4d-6dc5b4902ca5",
                                        "entry_id": "5a5246ad-6eb5-3ce1-95b2-4b52df0bddec",
                                        "glosses": [
                                            "Qui n’a que des qualités ; qui est accompli dans son genre ; qui est au plus haut de l’échelle des valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc510ec9-2140-4784-8bc3-c264a7d71c7c",
                                                "sense_id": "60279276-8019-3465-ad4d-6dc5b4902ca5",
                                                "text": "La porcelaine, cette matière céramique la plus parfaite, résulte de la liaison à une température très élevée, de l’infusible kaolin et du fusible feldspath, en une masse homogène."
                                            },
                                            {
                                                "example_id": "994f7308-8758-402e-8e9f-140e2f57f06b",
                                                "sense_id": "60279276-8019-3465-ad4d-6dc5b4902ca5",
                                                "text": "Rosebud se cherche toujours. Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d'un pinardier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                        "entry_id": "5a5246ad-6eb5-3ce1-95b2-4b52df0bddec",
                                        "glosses": [
                                            "Qui est complet, total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2aa2ef-02cb-49ba-a41b-f5f00fb2948f",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Subitement, ce parfait inconnu – dont son père lui avait annoncé la venue au monde un jour de cavalcade complice dans le veld – personnifiait à lui seul l’origine de tous ses malheurs."
                                            },
                                            {
                                                "example_id": "237f4cd2-4938-4682-976d-7ea7db13cfd4",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Dans cette chambre noire, l’obscurité n’est pas parfaite."
                                            },
                                            {
                                                "example_id": "2be5a6c3-5e88-4ae4-bbeb-920b53020158",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Une solitude parfaite."
                                            },
                                            {
                                                "example_id": "c42cd90e-b190-411c-8eea-4580c2a9927e",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Un repos parfait."
                                            },
                                            {
                                                "example_id": "d3ebfe3e-457d-45fe-a6f0-48c087018b48",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Sa guérison n’est pas parfaite."
                                            },
                                            {
                                                "example_id": "c0561f68-0eef-4c5a-aadf-85277438a265",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Un parfait imbécile."
                                            },
                                            {
                                                "example_id": "6237f8ac-f841-41b8-b421-d9d317c81d7a",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Un parfait coquin."
                                            },
                                            {
                                                "example_id": "9cac6628-68d3-4eee-809c-1c5216ae994e",
                                                "sense_id": "849e5988-4d55-3af6-b9be-6757010fbe9f",
                                                "text": "Et le Christ a dit : « Soyez parfaits comme votre Père céleste est parfait. » Et parfait ne veut pas dire seulement exempt de péchés, mais de défauts, de manques, c'est-à-dire terminé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9073853c-92a0-3fdd-b211-6f17c51b3748",
                                        "entry_id": "5a5246ad-6eb5-3ce1-95b2-4b52df0bddec",
                                        "glosses": [
                                            "Qui répond exactement, strictement à un concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bae7057-9fcc-441e-848a-24f79c09d69c",
                                                "sense_id": "9073853c-92a0-3fdd-b211-6f17c51b3748",
                                                "text": "Carré parfait, nombre parfait, consonance parfaite, ensemble parfait, gaz parfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523f5a37-d42b-3d3d-aa50-20716d83b27c",
                                        "entry_id": "5a5246ad-6eb5-3ce1-95b2-4b52df0bddec",
                                        "glosses": [
                                            "Se dit d’une partie fermée sans points isolés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parfait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db00d4bb-5fe1-3862-9e2f-ea14231bc260",
                                        "entry_id": "69d05765-143b-3acc-8531-c52f280fd5c5",
                                        "glosses": [
                                            "Temps de l’indicatif ou du subjonctif qui marque une action passée, par rapport au moment où l’on parle. Ensemble de formes verbales indiquant un état présent résultant d’une action antérieure. → voir imparfait et perfectif"
                                        ],
                                        "tags": [
                                            "conjugation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86ca2ae7-d1d5-4368-bdab-508995042e7c",
                                                "sense_id": "db00d4bb-5fe1-3862-9e2f-ea14231bc260",
                                                "text": "Parfait latin, grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07e12d7a-cee4-35fe-a764-617f06a3363b",
                                        "entry_id": "69d05765-143b-3acc-8531-c52f280fd5c5",
                                        "glosses": [
                                            "Le passé composé en français, opposé à l’imparfait."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24ce71b8-8721-389a-ac5f-25a1c289369a",
                                        "entry_id": "69d05765-143b-3acc-8531-c52f280fd5c5",
                                        "glosses": [
                                            "Crème glacée, en forme de pain de sucre, qui ne contient que de la crème fraîche et un parfum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d2435e-aa8b-48bb-afa3-b24a870bf5be",
                                                "sense_id": "24ce71b8-8721-389a-ac5f-25a1c289369a",
                                                "text": "Les soirs où il restait dîner, Marie faisait un parfait au chocolat avec de la crème fouettée ; Michel lui avait appris à faire du hot-fodge, et maintenant toute la famille Leclerc raffolait du hot-fodge."
                                            },
                                            {
                                                "example_id": "9c706fbe-eb88-4980-b0df-61a174e47934",
                                                "sense_id": "24ce71b8-8721-389a-ac5f-25a1c289369a",
                                                "text": "Elle lui offrit une cuiller de parfait au café. Puis une autre. Parfait parfumé à ses lèvres."
                                            },
                                            {
                                                "example_id": "408d322e-3093-418c-b6c1-782e60e65a06",
                                                "sense_id": "24ce71b8-8721-389a-ac5f-25a1c289369a",
                                                "text": "La serveuse vint débarrasser l’assiette du steak haché de Kento et la coupe du parfait de Daisuke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b59882e-99c6-3195-a4b0-13444b36eecb",
                                        "entry_id": "69d05765-143b-3acc-8531-c52f280fd5c5",
                                        "glosses": [
                                            "Chez les cathares, croyant qui avait reçu le baptême de l’esprit, le consolamentum, et qui recherchait de manière permanente la perfection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba0fef8e-18ac-37c2-a012-3ef65f979159",
                                        "entry_id": "69d05765-143b-3acc-8531-c52f280fd5c5",
                                        "glosses": [
                                            "Qui réunit toutes les qualités, sans nul mélange de défauts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c2939a-423f-4fdc-8ed8-c4ebac57823c",
                                                "sense_id": "ba0fef8e-18ac-37c2-a012-3ef65f979159",
                                                "text": "Or, je dis, moi : le parfait ne peut pas produire l’imparfait […]"
                                            }
                                        ]
                                    }
                                ]
                            },
