                ],
                "senses": [
                    {
                        "sense_id": "2907be20-3f89-31fc-9f35-12ecedef06b2",
                        "entry_id": "ca8f3975-6ecc-3435-8f47-d90c416ea6ac",
                        "glosses": [
                            "Faire sortir de la stupéfaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31f681d-1e3a-4eb3-af7d-a074a9e95f4d",
                                "sense_id": "2907be20-3f89-31fc-9f35-12ecedef06b2",
                                "text": "Une fois dépétrifié, dédominé, Grongor semble déterminer à faire payer aux aboleths sa captivité, il fait preuve d'un manque d’intelligence flagrant assorti d’une prestance toute barbare !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5de825db-2dc6-3630-ac59-d01f1d090d3c",
                        "entry_id": "ca8f3975-6ecc-3435-8f47-d90c416ea6ac",
                        "glosses": [
                            "Sortir de la stupéfaction."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "462c7fb7-2d95-4a41-8cc5-c90d7e6e86f6",
                                "sense_id": "5de825db-2dc6-3630-ac59-d01f1d090d3c",
                                "text": "Dépétrifiez-vous, jeune amant, touchez là."
                            },
                            {
                                "example_id": "0b90ba8d-d121-417a-a1b9-d4d86668cd18",
                                "sense_id": "5de825db-2dc6-3630-ac59-d01f1d090d3c",
                                "text": "Les voilà donc qui ouvrent l’œil, se soulèvent, se dépétrifient."
                            }
                        ]
                    }
