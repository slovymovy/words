                "translations": [
                    {
                        "translation_id": "bd47c9ad-6b8e-40e9-9f80-e19bbf17f614",
                        "source_entry_id": "05f1965a-2a34-37a6-852b-0a1bafe608c5",
                        "source_sense_id": "5e43b3a5-9287-3167-b59d-338245069c98",
                        "target_lang_word": "blinde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blinde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                        "entry_id": "47356707-29b2-362d-bb9f-44a134d1718a",
                                        "glosses": [
                                            "iemand die niet kan zien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3900394-3665-4a6e-9830-1208d0b1c1f6",
                                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                                "text": "De blinde had een blindengeleidehond nodig om naar zijn werk te kunnen gaan."
                                            },
                                            {
                                                "example_id": "b10dc3f4-60d5-4d5b-9b31-8971c9a713c0",
                                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                                "text": "„Maar ik vroeg me af: wat missen blinden nog?”, zegt Dylan Verburg, student aan de Universiteit Twente. Daarom interviewde Dylan een blinde persoon en deed hij een kleine enquête onder blinden. De uitkomst: blinden willen heel graag de gezichtsuitdrukking ‘zien’ van de persoon met wie ze praten."
                                            },
                                            {
                                                "example_id": "ec8e36a7-4550-4bbd-becb-e5781c80663d",
                                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                                "text": "'Zelfs een blinde kon zien dat het een overtreding was, idioot,' becommentarieerde de man met de harde stem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9860ad6f-e3f0-3d27-91ec-b5762f989a26",
                                        "entry_id": "47356707-29b2-362d-bb9f-44a134d1718a",
                                        "glosses": [
                                            "vensterluik, blind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76887c65-9687-4cfc-beb8-8fe633310636",
                                                "sense_id": "9860ad6f-e3f0-3d27-91ec-b5762f989a26",
                                                "text": "Voor de nacht moesten we eerste de blinden sluiten."
                                            }
                                        ]
                                    }
                                ]
                            },
