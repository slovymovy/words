                "senses": [
                    {
                        "sense_id": "d328729e-ba0e-3033-afa3-20cdaf831e23",
                        "entry_id": "1aff9d76-8a0b-3f60-b848-d69365549e18",
                        "glosses": [
                            "Appareil d’éclairage plus petit qu’un lustre et qui se place près du plafond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4571faf-e6a1-47f0-a4cf-6eff586b8f81",
                                "sense_id": "d328729e-ba0e-3033-afa3-20cdaf831e23",
                                "text": "La nuit tombait. Marie-Jeanne faisait des jours à la lumière d’un plafonnier qu’un contrepoids lui permettait d’éloigner ou de rapprocher selon la finesse de l’ouvrage auquel elle travaillait."
                            },
                            {
                                "example_id": "670825e9-3d09-44e0-b378-ef1ff5ddc329",
                                "sense_id": "d328729e-ba0e-3033-afa3-20cdaf831e23",
                                "text": "Montons sur ce large bureau, allons, mes souvenirs de westerns! Comment attraper un plafonnier au lasso? Oups! Raté!"
                            }
                        ]
                    },
                    {
                        "sense_id": "529606ba-64b7-3dd8-b1d5-2943c03a5e82",
                        "entry_id": "1aff9d76-8a0b-3f60-b848-d69365549e18",
                        "glosses": [
                            "Appareil pour l’éclairage intérieur d’un véhicule (voiture, autobus, wagon, etc.), généralement fixé au plafond de celui-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b1cef6-47e8-4c35-948b-b412efef26da",
                                "sense_id": "529606ba-64b7-3dd8-b1d5-2943c03a5e82",
                                "text": "Tony ouvrit la portière de la Cadillac. Les visages de Dick et de Tchang, tournés vers lui et également interrogateurs, surgirent à la lueur du plafonnier."
                            }
                        ]
                    }
                ],
