                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used to go to the <w>pictures</w> every Saturday night when we were young.",
                            "target_lang_translations": {
                                "ru": "В молодости мы ходили в <w>кино</w> каждую субботу вечером.",
                                "zh": "我们年轻时每逢周六晚上都会去<w>电影院</w>。"
                            }
                        },
                        {
                            "text": "My grandmother loves talking about the classic films she saw at the <w>pictures</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка любит рассказывать о классических фильмах, которые она смотрела в <w>кино</w>.",
                                "zh": "我祖母很喜欢谈论她以前在<w>电影院</w>看过的经典电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cinema",
                        "movies"
                    ],
                    "common_phrases": [
