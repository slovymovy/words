                                        ],
                                        "examples": [
                                            {
                                                "example_id": "359e2010-6996-46cc-bc30-60fdeb85a69a",
                                                "sense_id": "b9b3d49f-f1a9-3863-8561-29290bc0e04e",
                                                "text": "Completely normal men who develop prostatitis will suddenly come down with urinary paruresis as one of their symptoms."
                                            },
                                            {
                                                "example_id": "cfd1ae1d-b005-4b36-b0f5-e127ea52c06b",
                                                "sense_id": "b9b3d49f-f1a9-3863-8561-29290bc0e04e",
                                                "text": "Piss-shyness (paruresis) may prevent sufferers from using a public restroom."
                                            },
                                            {
                                                "example_id": "cbcc23be-776f-48b0-9b4a-080674c06aab",
                                                "sense_id": "b9b3d49f-f1a9-3863-8561-29290bc0e04e",
                                                "text": "Paruresis had previously been classified as a social phobia but current thinking about paruresis is that for diagnostic purposes it is classified as a Social Anxiety Disorder in ...DSM-IV."
                                            }
                                        ]
