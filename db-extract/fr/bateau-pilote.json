                    {
                        "sense_id": "76b178ee-25a5-3e15-a2c3-0c73075264f4",
                        "entry_id": "2a842bfa-be91-38a6-a5cb-bd46a86487c1",
                        "glosses": [
                            "Bateau rapide qui est utilisé pour transporter le pilote à bord des navires qui arrivent ou quittent le port."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70e272b2-8e44-458e-bcad-dcd31a302821",
                                "sense_id": "76b178ee-25a5-3e15-a2c3-0c73075264f4",
                                "text": "La Mésange était une coquille de noix plutôt qu’un vrai navire. Mais cette coquille, bâtie et équipée dans les ateliers du meilleur constructeur de Bordeaux, avait toutes les qualités d’un bon bateau-pilote."
                            },
                            {
                                "example_id": "c73881f5-0016-40f3-942a-47b14a220933",
                                "sense_id": "76b178ee-25a5-3e15-a2c3-0c73075264f4",
                                "text": "On voyait le bateau-pilote de Delfzijl, un beau vapeur de cinq cents tonneaux, décrire une courbe sur l’Ems avant d’entrer dans le port."
                            }
                        ]
                    }
