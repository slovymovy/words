                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "09b5fabf-4dbd-48a2-8ff1-16d5805e5a60",
                        "entry_id": "1e3c437f-c633-3c42-b4a5-f7e8f1fcb744",
                        "tags": [
                            "plural"
