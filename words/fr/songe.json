    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fbf345f-3674-38b8-b405-ea7fe318ad2b",
                    "sense_definition": "Rêve, suite d'images et d'idées qui se présentent à l'esprit pendant le sommeil.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant cette longue nuit d'hiver, il a fait un curieux <w>songe</w> plein de mystère."
                        },
                        {
                            "text": "Ce beau <w>songe</w> s'est dissipé dès les premières lueurs du matin."
                        }
                    ],
                    "synonyms": [
                        "rêve"
                    ],
                    "common_phrases": [
                        "faire un songe"
                    ]
                },
                {
                    "sense_id": "1c54bcd1-0e34-31b9-8e1f-835dfa60a756",
                    "sense_definition": "Illusion passagère ou espérance sans fondement dans la réalité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par comprendre que ses grands projets de richesse n'étaient qu'un <w>songe</w>."
                        },
                        {
                            "text": "Elle refusait d'admettre que tout ce bonheur passé n'avait été qu'un doux <w>songe</w>."
                        }
                    ],
                    "common_phrases": [
                        "la vie est un songe"
                    ]
                },
                {
                    "sense_id": "5f6479e2-1347-3034-a5fa-ef5422744d5f",
                    "sense_definition": "Vision reçue pendant le sommeil, particulièrement dans un contexte prophétique ou mystique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un messager mystérieux lui est apparu en <w>songe</w> pour lui révéler la vérité."
                        },
                        {
                            "text": "Dans ce récit ancien, le vieux roi voit en <w>songe</w> l'avenir de son royaume."
                        }
                    ],
                    "common_phrases": [
                        "en songe",
                        "apparaître en songe"
                    ]
                },
                {
                    "sense_id": "4bac8e76-512e-36b2-8595-0a244860ba35",
                    "sense_definition": "Plante tropicale cultivée pour son tubercule comestible, synonyme de taro ou colocase.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le repas traditionnel, elle a préparé du <w>songe</w> cuit avec des épices locales."
                        },
                        {
                            "text": "Dans ce petit jardin tropical poussent du manioc et du <w>songe</w> près du ruisseau."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "La Réunion et île Maurice"
                        }
                    ]
                }
            ]
        },
        {
