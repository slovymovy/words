                "senses": [
                    {
                        "sense_id": "a508d6ae-5923-318b-9070-af77988d2d11",
                        "entry_id": "b73da968-9181-3959-ba0a-459fbe914eb0",
                        "glosses": [
                            "Dreisprachigkeit (einzelner Personen oder Personengruppen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c04a66a-e20a-4acd-82cd-47ae4bf26f3e",
                                "sense_id": "a508d6ae-5923-318b-9070-af77988d2d11",
                                "text": "Trilingualismus ist die Fähigkeit, sich für Zwecke der Kommunikation drei verschiedener Sprachen bedienen zu können."
                            },
                            {
                                "example_id": "b76bf741-10bd-40ca-b8cd-e3d9e6f4787f",
                                "sense_id": "a508d6ae-5923-318b-9070-af77988d2d11",
                                "text": "Trilingualismus herrscht weitgehend in Luxemburg, wo Deutsch, Französisch und Luxemburgisch (Letzebuergesch) verwendet werden."
                            },
                            {
                                "example_id": "d7e950c2-e594-4846-b2ae-623789d3a8e3",
                                "sense_id": "a508d6ae-5923-318b-9070-af77988d2d11",
                                "text": "„Das große Ziel, das sich der Europäische Rat beim Lissabonner Gipfeltreffen gesetzt hat, besteht darin, den Trilingualismus zu erreichen („Muttersprache + 2“): Jeder EU-Bürger soll außer seiner Muttersprache zwei weitere Sprachen sprechen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
