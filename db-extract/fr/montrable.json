                "senses": [
                    {
                        "sense_id": "50420c1b-7760-37af-b2d8-d8e8ddabdaf0",
                        "entry_id": "37f96c66-2d69-3eba-8af8-26354f43b451",
                        "glosses": [
                            "Qui peut être montré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32258da3-5b5a-45c3-a1b3-07d6f131c675",
                                "sense_id": "50420c1b-7760-37af-b2d8-d8e8ddabdaf0",
                                "text": "Si vous aviez des yeux, vous ririez bien de ma figure de quatre-vingts et un ans ; elle n’est assurément ni transportable ni montrable."
                            },
                            {
                                "example_id": "e4e1d5bd-10c3-4d75-8fc3-d0334a564939",
                                "sense_id": "50420c1b-7760-37af-b2d8-d8e8ddabdaf0",
                                "text": "Ce qui achève d’indiquer le caractère habituellement montrable des dépêches officielles, c’est la recommandation expresse de secret que certaines contiennent."
                            },
                            {
                                "example_id": "169e2f7a-5b26-4c1e-9488-102f808adf8c",
                                "sense_id": "50420c1b-7760-37af-b2d8-d8e8ddabdaf0",
                                "text": "De plus, mon corps est culturellement coupé en deux : le montrable (la figure et les mains) et le non montrable (tout le reste)."
                            }
                        ]
                    }
                ],
