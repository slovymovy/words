                        "glosses": [
                            "A small towel, hand or face wipe, either dry or more commonly impregnated with water or a cleansing fluid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908104d2-e766-4bc2-8117-647bc830c819",
                                "sense_id": "c195327b-0e53-3d79-9c2d-62f4d2fba2c8",
                                "text": "The folded moist towelette was smaller than my palm, but when unfolded at least cleaned my hands."
                            }
                        ]
                    }
                ],
