                ],
                "senses": [
                    {
                        "sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "glosses": [
                            "rządy jednostki lub wąskiej grupy, sprawowane poza kontrolą społeczną"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a86e3933-0639-4645-af1e-21646b384d76",
                        "source_entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "source_sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "target_lang_word": "autocracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a390d8f4-b42b-30b8-a673-26b740250561",
                                        "entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                                        "glosses": [
                                            "A form of government in which unlimited power is held by a single individual."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7968831f-ada5-4132-8c71-52852982b83f",
                                                "sense_id": "a390d8f4-b42b-30b8-a673-26b740250561",
                                                "text": "I want to be clear: This shift toward democracy and away from autocracy is no reason to break out the “mission accomplished” banner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26ea1fa-1a55-3643-90f3-f79a0c942d6a",
                                        "entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                                        "glosses": [
                                            "An instance of this government."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5345624d-9e68-4394-920a-3e8ae553f3e8",
                                                "sense_id": "f26ea1fa-1a55-3643-90f3-f79a0c942d6a",
                                                "text": "The will of the people of Ukraine to defend their democracy is a reminder that autocracies cannot ultimately overcome free people willing to defend their liberty."
                                            },
                                            {
                                                "example_id": "b79caaf3-c92d-4ffa-a62c-0a917e940ddb",
                                                "sense_id": "f26ea1fa-1a55-3643-90f3-f79a0c942d6a",
                                                "text": "Among those who study authoritarian regimes, a consensus has emerged that [US president Donald Trump's] early moves display common characteristics of burgeoning autocracies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a519479-7117-4f7d-89e2-749f55a63437",
                        "source_entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "source_sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "target_lang_word": "autocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                                        "glosses": [
                                            "Gouvernement d’un autocrate, dictature, monarchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf70bc9a-5657-4e25-b957-4a91a2a57a1a",
                                                "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                                                "text": "On a pendu les régicides et proclamé sous Alexandre III, l’autocratie « inébranlable »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                                        "glosses": [
                                            "Régime politique d’un autoritarisme absolu."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544ed99d-01fd-442a-ad8b-8640717d51e3",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Peut-être parce que, depuis le XIᵉ siècle, la seule théorie politique de l’islam a été celle de l’obéissance passive à toute autorité de facto, le gouvernement par consentement reste un concept inconnu : l’autocratie a été la véritable et, pour l’essentiel, l’unique expérience."
                                            },
                                            {
                                                "example_id": "3a001333-267f-4a06-9206-2f379748222a",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Un peuple se lavait de l’opprobre d'une autocratie réductrice. Un pays ravalait sa façade dans l'espoir têtu que sa rage de vivre debout allait éclater sur son nouveau visage."
                                            },
                                            {
                                                "example_id": "3e737877-3852-4222-a7bb-8c0769a1fd71",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Les Américains feront le choix entre l’autocratie et la démocratie."
                                            },
                                            {
                                                "example_id": "c47ea998-4901-4fe8-90e2-9f0c451d14ab",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "À l’évidence, dès la fin du XXᵉ siècle, le rêve – réel ou soudoyé – de ceux qui faisaient miroiter une fin de l’Histoire, dans une victoire définitive et totale d’une démocratie à la Suisse, devenait indéfendable, à mesure que la mondialisation économique, la dualité des deux – l’oligarchie à l’ouest et l’autocratie à l’est, jusqu’au Pacifique – s’affirmait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "301bd8c8-9ffa-467d-91e8-b05b66dbaf5a",
                        "source_entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "source_sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "target_lang_word": "autocracia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocracia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8c3ec9-9042-3815-93e4-cf82bae74172",
                                        "entry_id": "050d6da6-994c-3aad-9908-3204ad9c8dc7",
                                        "glosses": [
                                            "Sistema de gobierno en el cual la voluntad de un solo hombre es la suprema ley."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21a70c21-7ff3-46d9-9b1e-2287a08e0689",
                        "source_entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "source_sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "target_lang_word": "Autokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                        "entry_id": "5d00164e-21ae-3e77-8369-f58f8285346c",
                                        "glosses": [
                                            "Staatsform, in der die absolute Herrschaft von einer Person oder Gruppe ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43de086-b923-480e-acee-a2fe783cd124",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "Nach jahrzehntelangem Leben in einer Autokratie müssen sich die Menschen erst an den Gedanken einer neugewonnenen Freiheit und Selbstbestimmung gewöhnen."
                                            },
                                            {
                                                "example_id": "155ceeee-0f97-417d-851c-83d9c2a54725",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36137bb8-8827-46c2-8c21-b3e850385d34",
                        "source_entry_id": "b8b71a4a-552e-3ff6-9bd6-df29d034af0b",
                        "source_sense_id": "6554d6c7-d72a-3e15-b2ca-b3b67b6eefa0",
                        "target_lang_word": "автокра́тия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "автокра́тия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                                        "entry_id": "fc200775-e429-3cc4-bed1-b6d32a9e584d",
                                        "glosses": [
                                            "полит. форма государственного правления, при которой неограниченная верховная власть принадлежит одному лицу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26386493-5851-426a-8f77-1276777adb20",
                                                "sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                                                "text": "Петербургская автократия представляла собою своеобразную смесь петровских веяний со стилизованными преданиями московской старины."
                                            },
                                            {
                                                "example_id": "28e10f67-6f28-4663-a664-f3cca573a6f1",
                                                "sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                                                "text": "Строй, научно предвиденный, предсказанный, оплаченный многими годами борьбы, бесчисленными жертвами, в первые же десятилетия свои обернулся невиданной в истории автократией и бюрократией, деспотией и беззаконием, самоистреблением, неслыханной жестокостью, отчаянными просчётами в практической, хозяйственной жизни, хроническими недостатками предметов первой необходимости ― пищи, одежды, жилья, огрубением нравов, навыками лжи, лицемерия, ханжества, самохвальства и т. д. и т. п."
                                            },
                                            {
                                                "example_id": "a5c807c7-f617-45aa-90f4-ea51a93d5103",
                                                "sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                                                "text": "Подобные обстоятельства легко порождают ту или другую автократию, в каковом контексте тиранов можно рассматривать в качестве компьютеров устарелого образца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
