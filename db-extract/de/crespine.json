                "senses": [
                    {
                        "sense_id": "afba6514-c34c-3af5-96b8-2bdf3811060c",
                        "entry_id": "acd04bb2-322d-3e6f-b7d1-716bb2e8294c",
                        "glosses": [
                            "häufig kunstvoll verziertes Haarnetz aus Metallfäden, das von adligen Frauen in Europa im 14. Jahrhundert getragen wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e51ea64d-13e8-4c18-84bc-57f288337f4f",
                                "sense_id": "afba6514-c34c-3af5-96b8-2bdf3811060c",
                                "text": "„Das Haar wurde oft von einem Netz begrenzt, das als Crespine oder Crespinette bezeichnet wurde.“"
                            },
                            {
                                "example_id": "f4d738b5-6e74-4337-93f4-a861ecbc39dc",
                                "sense_id": "afba6514-c34c-3af5-96b8-2bdf3811060c",
                                "text": "„Frauen, besonders Mädchen, trugen seit dem 14. Jahrh. Haarnetze verschiedener Art: crespine, tresson, dorelot;“"
                            },
                            {
                                "example_id": "918704ba-c4ed-419c-a44c-3b85804a110f",
                                "sense_id": "afba6514-c34c-3af5-96b8-2bdf3811060c",
                                "text": "„Im frühen Mittelalter wurde das Haar meist in zwei langen Zöpfen getragen, die über die Schultern fielen und mit Bändern verziert sein konnten. Später wurden die beiden Zöpfe über den Ohren zu Knoten aufgerollt und vom Crespine gehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
