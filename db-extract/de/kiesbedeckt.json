                "senses": [
                    {
                        "sense_id": "f858f048-fa8d-389f-9206-5c921e28f5d1",
                        "entry_id": "800e634a-97bf-3b4d-a971-361283b5530c",
                        "glosses": [
                            "mit Kies bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535fc27d-68f7-4ae9-b6cc-54ef8937c5b0",
                                "sense_id": "f858f048-fa8d-389f-9206-5c921e28f5d1",
                                "text": "„Und auf dem kiesbedeckten Boden lag etwas so Entsetzliches, dass die ganze Suchmannschaft davor zurückwich.“"
                            },
                            {
                                "example_id": "96c24f05-dd0c-4b28-94d1-a76f30114fd3",
                                "sense_id": "f858f048-fa8d-389f-9206-5c921e28f5d1",
                                "text": "„Wir fuhren Richtung Westen aus der Stadt hinaus und hielten nach einiger Zeit knirschend auf dem kiesbedeckten Platz eines Gebrauchtwagenhändlers, einem Gelände in der Form eines Hufeisens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
