                        "examples": [
                            {
                                "example_id": "267dfeb4-48cc-4503-8dcc-d694ac26d963",
                                "sense_id": "971a8bcd-7c3a-3b37-b99f-c4c120630550",
                                "text": "De brand aan de Gouverneur Houbenstraat ontstond volgens een woordvoerder van de brandweer door een lekkende gashaard. Rond 02.30 uur wilden de bewoners de haard aansteken omdat het koeler werd. „Maar voor ze het wisten stond alles in de hens”, aldus de zegsman."
                            },
                            {
                                "example_id": "ad704a5d-8491-4733-9cfd-e8c5bcc7856c",
                                "sense_id": "971a8bcd-7c3a-3b37-b99f-c4c120630550",
                                "text": "Het stel houdt zich netjes aan het bouwbudget. De spontane verbouwing van de tuin kost 20.000 euro extra. Sikkes vindt het een ‘lekker huis’ geworden. Op één irritatiefactor na: de gashaard. ,,Zo lelijk. Kitsch van de bovenste plank. Het leidt me zo af, dat ik alleen maar naar die haard kan kijken. De meubels doen iets met de ruimte wat ik niet goed vind.’’ Een gemiste kans vindt Sikkes het ontbreken van een tweede badkamer. De kastenkamer met ‘veertien kasten’ vindt hij ‘onhandig’."
                            }
                        ]
                    }
