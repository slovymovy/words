                ],
                "senses": [
                    {
                        "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                        "entry_id": "1a0fcc0f-bcfb-31f6-be86-a3c0f1b20076",
                        "glosses": [
                            "uitermate vreemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b45d9e2-c63c-41eb-908c-f6e1df8eac85",
                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                "text": "Het is een bespottelijk voorstel om hier alleen nog maar fietsers door te laten."
                            },
                            {
                                "example_id": "3b687f64-3380-4a61-baa9-f91773b68e89",
                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                "text": "Het allerliefst zou ik voor vijftig man spelen en hooguit tien dollar voor een kaartje vragen; theater voor hoi polloi. Ik zou graag de vrekken zien komen, de mensen die niet geïnteresseerd zijn, de mensen die andere plannen hebben, die wel wat beters te doen hebben en die ergens anders moeten zijn, de mensen die uitsluitend komen omdat een kaartje zo bespottelijk goedkoop is dat je wel gek zou zijn als je die kans liet lopen."
                            },
                            {
                                "example_id": "0ee2bbc0-01fe-421f-b5a3-f455dd2def9f",
                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                "text": "En dat alles voor de bespottelijke prijs van 1. 600 euro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13d2a389-8098-43d3-b384-93c08ee05f37",
                        "source_entry_id": "1a0fcc0f-bcfb-31f6-be86-a3c0f1b20076",
                        "source_sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                        "source_sense_description": "uitermate vreemd",
                        "target_lang_word": "lächerlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lächerlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "zum Lachen bringend; besonders seltsam, unsinnig oder ärgerlich wirkend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e48ef29-d117-4753-bae6-41e062e2f8bb",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "Es war ein lächerlicher Auftritt, direkt peinlich."
                                            },
                                            {
                                                "example_id": "081857c0-132f-4211-b658-662db2ed3013",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "„Die Maske machte ein unaufhörlich lächerliches Gesicht.“"
                                            },
                                            {
                                                "example_id": "e1292d41-5f86-433f-a45b-d3456c98c2c1",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "„Die aufklärerische Fetischisierung der Nützlichkeit wurde nicht erst von den Romantikern lächerlich gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a007e1d-ca7e-3d18-aa51-04c84066f3ee",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "gering; (ärgerlich) klein"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77add001-7585-40e3-a785-9d4603960dd2",
                                                "sense_id": "3a007e1d-ca7e-3d18-aa51-04c84066f3ee",
                                                "text": "Die lächerliche Gehaltserhöhung ist praktisch null."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "besonders, in hohem Maße"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c574e2f-ec53-43db-9b32-20ccbd0e5c7c",
                                                "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                                "text": "„Aber die hatte vortreffliche Beziehungen in Deutschland, sie behielt keine fertige Tafel lange im Hause; und zweitens brauchte sie lächerlich wenig Geld.“"
                                            },
                                            {
                                                "example_id": "e226f38a-3a06-4b1e-94cc-1b0865724897",
                                                "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                                "text": "„Sie trägt eine kostbare Abendrobe und auf dem blonden Haar verwegen ein lächerlich kleines Hütchen, das bei jedem Schritt wippt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a38d3d97-2c10-4c7a-be7d-0cbc4f75387d",
                        "source_entry_id": "1a0fcc0f-bcfb-31f6-be86-a3c0f1b20076",
                        "source_sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                        "source_sense_description": "uitermate vreemd",
                        "target_lang_word": "ridiculous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridiculous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                        "entry_id": "88e3ad00-8d78-3702-80e3-ddfe5ffeec7d",
                                        "glosses": [
                                            "Deserving of ridicule; foolish, absurd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d529c7e-e0fa-44e4-9a56-ee6fb70aec70",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "That hairstyle looks ridiculous."
                                            },
                                            {
                                                "example_id": "c235b4fb-100a-4bbb-9413-ec874bf3c3a3",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "It's ridiculous to charge so much for a little souvenir."
                                            },
                                            {
                                                "example_id": "bfd06d10-398b-41ea-b03d-56d22dc50c01",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "You make ridiculous statements a lot, like saying that UFOs are real."
                                            },
                                            {
                                                "example_id": "79021443-2e46-4847-ab24-c34ef886ebae",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "Many of the so-called rites of these secret societies were so patently ridiculous, that it is quite obvious that they were merely an excuse for men and women to indulge in sex-play and lustful gratification, frequently of an abnormal kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                        "entry_id": "88e3ad00-8d78-3702-80e3-ddfe5ffeec7d",
                                        "glosses": [
                                            "Astonishing, extreme, unbelievable."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46fb735-e954-4250-b0ee-ebe1d2ba87c4",
                                                "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                                "text": "In a ridiculous feat of engineering, the team can calculate the difference in arrival time to within one-tenth of a nanosecond."
                                            },
                                            {
                                                "example_id": "f35917a1-1a6b-40e7-9695-e923e46a4686",
                                                "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                                "text": "Gaines is a classic motor player with a low center of gravity and ridiculous strength."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "181d3c26-89d2-48b6-94d3-124a6b4a4805",
                        "source_entry_id": "1a0fcc0f-bcfb-31f6-be86-a3c0f1b20076",
                        "source_sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                        "source_sense_description": "uitermate vreemd",
                        "target_lang_word": "dérisoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérisoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11e308fd-f6fc-39b3-a428-f4a18306c60a",
                                        "entry_id": "2dd89a56-188a-3cc8-a16f-713a1ce02073",
                                        "glosses": [
                                            "Qui est fait par dérision, contient de la dérision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92866f49-0ff9-4f69-b146-a2eeb018a5cc",
                                                "sense_id": "11e308fd-f6fc-39b3-a428-f4a18306c60a",
                                                "text": "Tous les laquais, tous les coupe-bourses, réunis aux écoliers, avaient été chercher processionnellement, dans l’armoire de la basoche, la tiare de carton et la simarre dérisoire du pape des fous."
                                            },
                                            {
                                                "example_id": "4b6a0d23-4ffc-43fa-85f0-10d336f22473",
                                                "sense_id": "11e308fd-f6fc-39b3-a428-f4a18306c60a",
                                                "text": "Le combat se déroule malgré son côté dérisoire. Ou plutôt : le combat peut se dérouler justement à cause de son côté dérisoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351f3f55-2db9-3438-aa5a-4fa78605c055",
                                        "entry_id": "2dd89a56-188a-3cc8-a16f-713a1ce02073",
                                        "glosses": [
                                            "Susceptible de provoquer la dérision du fait de son insignifiance, de sa petitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c57c256-332a-401b-858e-625ac2211762",
                                                "sense_id": "351f3f55-2db9-3438-aa5a-4fa78605c055",
                                                "text": "Les noms mêmes des petits métiers qui sont à la base de l'édifice du recyclage révèlent le côté dérisoire de ces occupations : plus spécialisés encore que le chiffonnier, il y a le ramasseur de crottes de chien, le ramasseur de bouts de cigare, etc."
                                            },
                                            {
                                                "example_id": "aecae003-328e-4e5e-8c67-fc48ab551cc4",
                                                "sense_id": "351f3f55-2db9-3438-aa5a-4fa78605c055",
                                                "text": "Chacun va à son travail comme à l’habitude ou baguenaude sur les boulevards. La guerre est enfin finie. Napoléon est parti le 20 avril, oublié, relégué dans son dérisoire petit royaume de l'île d'Elbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20a412b-7404-390f-aa13-458f4186281b",
                                        "entry_id": "2dd89a56-188a-3cc8-a16f-713a1ce02073",
                                        "glosses": [
                                            "Risiblement inutile, vain, inefficace."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a8a9e84-6b0b-4c72-8e83-24d3dfe5689c",
                                                "sense_id": "b20a412b-7404-390f-aa13-458f4186281b",
                                                "text": "Cette conservation de la machine avait on ne sait quoi de dérisoire et ajoutait l’ironie à la catastrophe. La sombre malice de l’inconnu éclate quelquefois dans ces espèces de moqueries amères."
                                            },
                                            {
                                                "example_id": "7f299107-ce1b-44d0-850c-0e3e168f3a61",
                                                "sense_id": "b20a412b-7404-390f-aa13-458f4186281b",
                                                "text": "Dépité, il se retourne vers le rempart dont les flammes lèchent la nuit en un diadème infernal. Derrière, il distingue les efforts dérisoires des hommes qui tentent d'endiguer le brasier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
