                "senses": [
                    {
                        "sense_id": "f4a417ee-9655-38f6-9ec0-16273b8c0393",
                        "entry_id": "27eb65f6-79fa-3aa3-bfcc-168a5e90d012",
                        "glosses": [
                            "Mangel an ausreichend Nahrungsmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69991821-077b-41bb-863d-040c6f38c0b1",
                                "sense_id": "f4a417ee-9655-38f6-9ec0-16273b8c0393",
                                "text": "„Die Behörden hatten gegen die Nahrungsmittelknappheit im vorangegangenen Jahr auf staatlich verordnete Höchstpreise gesetzt, auf den zwangsweisen Aufkauf von ganzen Ernten und die begrenzte Abgabe gegen Lebensmittelkarten, also auf Rationierung.“"
                            },
                            {
                                "example_id": "a377915d-2dd2-4bac-ae97-267dac5feae9",
                                "sense_id": "f4a417ee-9655-38f6-9ec0-16273b8c0393",
                                "text": "„Mit der Belagerung verschärfte sich in Augsburg die bereits bestehende Nahrungsmittelknappheit drastisch weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
