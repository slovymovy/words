                "senses": [
                    {
                        "sense_id": "5dbe0a04-8a3e-306c-8684-26b01d38cd36",
                        "entry_id": "2873ab6a-7410-3a8a-9521-f4c654e44338",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным краеведение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048901df-6c03-4446-b531-05ac87ffc750",
                                "sense_id": "5dbe0a04-8a3e-306c-8684-26b01d38cd36",
                                "text": "Хоробрых написал статью о мореходных качествах этих лодок и напечатал её в краеведческом журнале в Ашхабаде."
                            },
                            {
                                "example_id": "10589d51-e527-40d3-af08-5f298ef39d55",
                                "sense_id": "5dbe0a04-8a3e-306c-8684-26b01d38cd36",
                                "text": "В Кяхтинском краеведческом музее можно увидеть стол работы Михаила Бестужева и несколько небольших картин, исполненных кистью Николая."
                            }
                        ]
                    }
