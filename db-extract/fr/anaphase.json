                                        "entry_id": "bcc0e413-6edb-3818-9e73-cba603896d3f",
                                        "glosses": [
                                            "Stadium der Mitose zwischen der Metaphase und der Telophase, bei dem die geteilten Chromatiden eines Chromosoms sich trennen und zu entgegengesetzten Polen transportiert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d7190f3-ac80-4448-a98d-dd0e494545ec",
                                                "sense_id": "806668b5-dd76-3807-855a-a3ac7f574f5c",
                                                "text": "Die Anaphase ist beendet, wenn die Tochterchromosomen in den Zellpolbereichen angekommen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
