                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "287b512e-0e4b-3c8c-b795-9c80fa99703f",
                                        "entry_id": "68c48744-289b-3f0d-b48d-aa3f3753f696",
                                        "glosses": [
                                            "Branche de l’astronomie consistant en l’étude globale de l’univers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b185cc15-08ec-3ea7-9b46-a56b4de4c6d4",
                                        "entry_id": "68c48744-289b-3f0d-b48d-aa3f3753f696",
                                        "glosses": [
                                            "Partie de la métaphysique qui a pour thème la nature et l’origine du monde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "118ed525-ada3-34dd-985d-d780142c5811",
                                        "entry_id": "68c48744-289b-3f0d-b48d-aa3f3753f696",
                                        "glosses": [
                                            "Science des lois générales par lesquelles l’univers est gouverné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e8a68e-e20a-4e58-82dd-ab29ffdda808",
                                                "sense_id": "118ed525-ada3-34dd-985d-d780142c5811",
                                                "text": "La moniale bénédictine Hildegarde von Bingen décrivit une cosmologie des affections des plantes qui attribue essentiellement aux vapeurs toxiques du macrocosme les dégâts observés dans les champs du microcosme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b04455c-a359-4d88-bb39-b980e0c98e17",
                        "source_entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                        "source_sense_description": "study of the physical universe",
                        "target_lang_word": "Kosmologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosmologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                        "entry_id": "c6befa40-e844-35fb-90a9-8676012291ee",
                                        "glosses": [
                                            "Lehre, die sich mit dem Ursprung und der Entwicklung des Weltalls beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6dee06-8741-4bb2-a665-8575ee8f7184",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Das Jenseits der schamanischen Kosmologie ist von einer ganzen Reihe unterschiedlich mächtiger Geistmächte mit unterschiedlichen Aufgabenbereichen bevölkert.“"
                                            },
                                            {
                                                "example_id": "df3ae567-ac84-4893-9db6-528e01c257d7",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Infolge der kopernikanischen Wende entwickelten sich verschiedene Kosmologien, die sich darin unterschieden, welche Sternenverteilung sie im Universum annehmen.“"
                                            },
                                            {
                                                "example_id": "e216a1d5-15a8-4198-9b4f-dfa107805765",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Das Standardmodell der Kosmologie beschreibt ein Universum, das aus dem Nichts mit dem Urknall entstand und seitdem expandiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
