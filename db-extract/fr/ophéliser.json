                "senses": [
                    {
                        "sense_id": "c7d51d2b-7bb5-31dc-8072-527656586df4",
                        "entry_id": "5e9124b9-4fd0-362e-abd8-1df167c8389f",
                        "glosses": [
                            "Donner un caractère ophélique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e0546b-5721-41d1-9313-a7ce7c162e02",
                                "sense_id": "c7d51d2b-7bb5-31dc-8072-527656586df4",
                                "text": "Se mirer c’est déjà un peu s’ophéliser et participer à la vie des ombres."
                            },
                            {
                                "example_id": "5cbd5c51-5f27-43b0-9333-0c119e7699ad",
                                "sense_id": "c7d51d2b-7bb5-31dc-8072-527656586df4",
                                "text": "Il revient à «la symbolique» de «la plongée», parle de la «noyade écrite» par laquelle il s'«ophélise dans le Rhône»."
                            },
                            {
                                "example_id": "c861bcc7-64c2-4898-a8c2-fdbd50e542e5",
                                "sense_id": "c7d51d2b-7bb5-31dc-8072-527656586df4",
                                "text": "Tous les sommairesJamais heureuse, la jouvencelle regardait la mer pendant des heures et finira par s'y ophéliser."
                            },
                            {
                                "example_id": "07b09021-9a49-4f1d-9aad-b4858a8bccd7",
                                "sense_id": "c7d51d2b-7bb5-31dc-8072-527656586df4",
                                "text": "Les peintures de Guillaume ont, je trouve, une troublante capacité à ophéliser la perception du monde, (…)"
                            }
                        ]
                    }
                ],
