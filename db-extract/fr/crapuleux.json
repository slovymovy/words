                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad265827-e577-4727-bfa2-db6ef66e5378",
                                                "sense_id": "fd1e6900-00ea-3484-a155-bae8c7356084",
                                                "text": "Pomegranates are as seedy as any fruit you are likely to see."
                                            }
                                        ]
