                {
                    "sense_id": "4876dfd9-6fff-311b-90ab-cde1b47ac9d6",
                    "sense_definition": "Corps armé de militaires ou de soldats.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a ordonné le retrait des <w>troupes</w> après des mois de conflit."
                        },
                        {
                            "text": "Les <w>troupes</w> avancent prudemment à travers le territoire ennemi."
                        }
                    ],
                    "common_phrases": [
