                                    {
                                        "sense_id": "14a43cf9-4e80-3a09-ac10-12c4ab1bf6e6",
                                        "entry_id": "611882e4-8856-325c-9296-bf35a08f0e6c",
                                        "glosses": [
                                            "As permitted by law; not contrary to law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3982a1-2ae7-4a71-bdfb-28f04d11f927",
                                                "sense_id": "14a43cf9-4e80-3a09-ac10-12c4ab1bf6e6",
                                                "text": "You can legally park in the lot on weekends without paying the fee, they won't ticket you."
                                            },
                                            {
                                                "example_id": "6f84c117-4859-4dc4-bce8-7d4119678e4c",
                                                "sense_id": "14a43cf9-4e80-3a09-ac10-12c4ab1bf6e6",
                                                "text": "On the question of whether a memorandum of understanding is legally binding, British courts have held that this is determined by the presence (or, as the case may be, absence) of an intention to create a legal obligation, on the part of the states parties concerned, at the time of entry into the arrangement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5db5b56-f137-3227-a261-a55b500ad8c7",
                                        "entry_id": "611882e4-8856-325c-9296-bf35a08f0e6c",
                                        "glosses": [
                                            "From a legal perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d20487-ea97-44db-98b7-6b295f8a1f81",
                                                "sense_id": "e5db5b56-f137-3227-a261-a55b500ad8c7",
                                                "text": "Legally, I think you are covered, but there are angry guys with baseball bats outside."
                                            },
                                            {
                                                "example_id": "e657240c-176a-471e-b484-213a96968816",
                                                "sense_id": "e5db5b56-f137-3227-a261-a55b500ad8c7",
                                                "text": "After filing paperwork to change his name, the rapper, born Kanye Omari West, finally got what he asked for, and will be legally known as “Ye.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
