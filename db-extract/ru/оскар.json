                            {
                                "target_word": "Oscar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e55a708-fc72-3ccc-8d10-8cd7911756ba",
                                        "entry_id": "69282c4b-40a7-32d1-a881-d0cfa23692f5",
                                        "glosses": [
                                            "An Academy Award."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8de4ca-518f-489f-ba35-e5cfdc73fce7",
                                                "sense_id": "1e55a708-fc72-3ccc-8d10-8cd7911756ba",
                                                "text": "Primarily seen as a publicity vehicle for late-year releases, the awards show and its promoters have lately made pretensions to Oscar oracling: Jamie Foxx won the “breakthrough actor of the year” prize for “Ray” in 2004, after all, and Paul Haggis and his ensemble cast were honored for “Crash” four months before it won best picture."
                                            },
                                            {
                                                "example_id": "bbcf0cf7-24d0-4478-8be0-aa6c712696bc",
                                                "sense_id": "1e55a708-fc72-3ccc-8d10-8cd7911756ba",
                                                "text": "The gulf between cinephiles and the public has grown wide. There are pictures that make a lot of money, but seldom win big Oscars or attract young people to the show"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ca63b9-95df-3d7f-83c5-84f641b52235",
                                        "entry_id": "69282c4b-40a7-32d1-a881-d0cfa23692f5",
                                        "glosses": [
                                            "A statuette awarded by the Academy of Motion Picture Arts and Sciences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
