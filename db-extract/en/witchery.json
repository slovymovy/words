    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                "word": "witchery",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8deb6901-4a5a-48e6-bc28-49fbb3673f5b",
                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                        "tags": [
                            "plural"
                        ],
                        "form": "witcheries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                        "glosses": [
                            "Witchcraft."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ad2205-876f-4d21-9f1e-63449c7b75c2",
                                "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                                "text": "You are right to some extent in what you say. In the olden days people had a stronger belief in all kinds of witchery; now they pretend not to believe in it, that they may be looked upon as sensible and educated people, as you say."
                            },
                            {
                                "example_id": "9263c4e9-ddb9-4bdd-ad2d-0de8ee85ba4b",
                                "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                                "text": "They are determined that I shall be burnt as a witch; and they sent their doctor to cure me; but he was forbidden to bleed me because the silly people believe that a witch’s witchery leaves her if she is bled; so he only called me filthy names."
                            }
                        ]
                    },
                    {
                        "sense_id": "edc6a98c-832b-3442-8c0e-5120e6be6a64",
                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                        "glosses": [
                            "An act of witchcraft."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ae6565e4-4199-4396-9a96-80c87986064b",
                                "sense_id": "edc6a98c-832b-3442-8c0e-5120e6be6a64",
                                "text": "It may be they know something of the witcheries of this woman."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                        "glosses": [
                            "Allure, charm, magic."
                        ],
                        "tags": [
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2060b525-b097-46f5-8611-fe89fd4ea1fb",
                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                "text": "At noon, when by the forest's edge / He lay beneath the branches high, / The soft blue sky did never melt / Into his heart,—he never felt / The witchery of the soft blue sky!"
                            },
                            {
                                "example_id": "e921aceb-3e1b-4d7b-a1cb-02c0c4b18ff3",
                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                "text": "I am influenced—conquered; and the influence is sweeter than I can express; and the conquest I undergo has a witchery beyond any triumph I can win."
                            },
                            {
                                "example_id": "f4ca59e1-0c77-4b8c-96c5-4316738f2553",
                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                "text": "He beheld the scene in his mind’s eye, through the witchery of many intervening years, and faintly illuminated it as if with starlight instead of this broad glow of moonshine."
                            },
                            {
                                "example_id": "1032487b-61a4-47b4-a336-2267bc0c28b4",
                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                "text": "The witchery of the dawn turned the grey river-reaches to purple, gold, and opal; and it was as though the lumbering dhoni crept across the splendors of a new heaven."
                            },
                            {
                                "example_id": "1c37709a-fe7c-4dcc-96e2-7bfa8e871903",
                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                "text": "[A]lready his imagination, leaping ahead of the engagement ring, the betrothal kiss and the march from Lohengrin, pictured her at his side in some scene of old European witchery."
                            }
                        ]
                    }
                ],
