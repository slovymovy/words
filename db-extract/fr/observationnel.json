                "senses": [
                    {
                        "sense_id": "39668ed4-7353-3289-b764-a09774a1eb66",
                        "entry_id": "7c5e980a-f15b-33c8-a878-d2094e65b96a",
                        "glosses": [
                            "Qui est fondé sur une ou plusieurs observations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "598e4186-4707-4d7d-b45e-83e9609fb964",
                                "sense_id": "39668ed4-7353-3289-b764-a09774a1eb66",
                                "text": "À ce jour, les études observationnelles post-AMM qui se développent à la suite de cette politique peuvent soit se contenter de décrire le marché atteint, soit être des études de bonne pratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76cfd111-16fa-4c90-8b2d-8ebd76a2af1e",
                        "source_entry_id": "7c5e980a-f15b-33c8-a878-d2094e65b96a",
                        "source_sense_id": "39668ed4-7353-3289-b764-a09774a1eb66",
                        "target_lang_word": "observational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4da1971-a43b-363c-bcde-c3ada827f5af",
                                        "entry_id": "e258e8e9-384b-3ebf-b40c-a7b9e0ef89ac",
                                        "glosses": [
                                            "Relating to observation, especially scientific observation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0f530a-8492-4fe5-a9ee-b3eea0f14c22",
                                                "sense_id": "b4da1971-a43b-363c-bcde-c3ada827f5af",
                                                "text": "The essential fact is simply that all the pictures which science now draws of nature, and which alone seem capable of according with observational fact, are mathematical pictures."
                                            },
                                            {
                                                "example_id": "a17b01e8-ec5d-40f5-9748-7ee4ac9aec51",
                                                "sense_id": "b4da1971-a43b-363c-bcde-c3ada827f5af",
                                                "text": "An alternative way of defending the proposal to conflate NP MOVEMENT with XP MOVEMENT would be to question the observational adequacy of the claim that NP MOVEMENT only ever has NP constituents as its target."
                                            },
                                            {
                                                "example_id": "469c7c64-b1ad-4ef1-b632-b871572bb745",
                                                "sense_id": "b4da1971-a43b-363c-bcde-c3ada827f5af",
                                                "text": "No less than the novelist, the psychologist must employ techniques of literary construction to render scientific accounts acceptable. Most importantly, to the extent that such techniques dominate the scientific account, observational practices—regardless of rigor—cease to be influential."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
