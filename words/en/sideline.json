                    ]
                },
                {
                    "sense_id": "03131bbc-7ea0-35d5-9ce6-dcd656ffe3d5",
                    "sense_definition": "An activity or job done in addition to one's main work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secondary_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started a small business as a <w>sideline</w> to her regular job."
                        },
                        {
                            "text": "Selling handmade crafts became a profitable <w>sideline</w> for him."
                        }
                    ]
                },
                {
                    "sense_id": "2f281609-60e1-39a1-bb3e-7aa118abe012",
                    "sense_definition": "The outside or perimeter of any activity or social group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secondary_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like he was being kept on the <w>sidelines</w> of the important decision-making process."
                        },
                        {
                            "text": "Many people are relegated to the <w>sidelines</w> when they lack the necessary connections."
                        }
                    ],
                    "common_phrases": [
                        "relegated to the sidelines"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3aae7405-f3b0-37c9-92ac-a2b85a3a9e2d",
                    "sense_definition": "To prevent someone from participating in an activity or game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>sidelined</w> the star player because of a minor injury."
                        },
                        {
                            "text": "A sudden injury <w>sidelined</w> him for the rest of the season."
                        }
                    ]
                },
                {
                    "sense_id": "51abc037-9466-3455-8a4f-627dfe6e5c4d",
                    "sense_definition": "To remove someone or something from a position of influence or importance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new management <w>sidelined</w> the older employees to make room for fresh ideas."
                        },
                        {
                            "text": "Political rivals were <w>sidelined</w> during the recent party reorganization."
                        }
                    ],
                    "synonyms": [
