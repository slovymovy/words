                    {
                        "sense_id": "340188da-5fb8-32eb-a263-28f9d1430a6f",
                        "entry_id": "a46220f8-359e-32ee-89ca-4f5a2b44c7d4",
                        "glosses": [
                            "Fausse variété d’opale qui désigne en fait une halloysite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f79b32d-fb5e-43f2-a338-6175a337e2ab",
                                "sense_id": "340188da-5fb8-32eb-a263-28f9d1430a6f",
                                "text": "L’alumocalcite ressemble au collyrite, et se trouve aussi dans l’Eczgebürge. Il a l’éclat du verre ; il est d’un blanc de lait tirant sur le bleu ou le jaune. L’eau lui donne de la translucidité."
                            },
                            {
                                "example_id": "b7a09f9a-1bb0-4645-bf9b-23ce6b8480b9",
                                "sense_id": "340188da-5fb8-32eb-a263-28f9d1430a6f",
                                "text": "L’alumocalcite est un minéral de seconde formation, qui a servi de remplissage dans certains vides des gneiss de la carrière du Pont-Dret."
                            }
                        ]
                    }
                ],
