{
    "word_family": [
        "exemption",
        "exemptible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06a0d5ed-d950-3e09-86af-46132c91112d",
                    "sense_definition": "Free from a duty, obligation, rule, or law that others are subject to.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom from obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In their country, all women are <w>exempt</w> from military service due to current legislation.",
                            "target_lang_translations": {
                                "ru": "В их стране все женщины <w>освобождены</w> от военной службы согласно действующему законодательству."
                            }
                        },
                        {
                            "text": "His annual income is so small that it is <w>exempt</w> from tax this year.",
                            "target_lang_translations": {
                                "ru": "Его годовой доход настолько мал, что в этом году он <w>не подлежит</w> налогообложению."
                            }
                        }
                    ],
                    "synonyms": [
                        "immune",
                        "excused",
                        "free",
                        "released"
                    ],
                    "antonyms": [
                        "liable",
                        "subject",
                        "responsible"
                    ],
                    "common_phrases": [
                        "exempt from tax",
                        "exempt from duty",
                        "exempt from military service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от обязанностей, налогов или правил, которым подчиняются другие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождённый",
                                "target_lang_sense_clarification": "от обязательств или налогов"
                            },
                            {
                                "target_lang_word": "не подлежащий",
                                "target_lang_sense_clarification": "действию правил или налогов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f13f9ac-97a1-3e12-b902-6772729ade54",
                    "sense_definition": "Classified as not being entitled to overtime pay under labor laws, usually referring to professional or executive roles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "employment status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>exempt</w> employee, she does not receive extra pay for working late on Fridays.",
                            "target_lang_translations": {
                                "ru": "Как <w>освобождённый</w> сотрудник, она не получает доплату за работу допоздна по пятницам."
                            }
                        },
                        {
                            "text": "The HR department needs to determine which staff members are <w>exempt</w> under the new regulations.",
                            "target_lang_translations": {
                                "ru": "Отделу кадров необходимо определить, какие сотрудники являются <w>освобождёнными</w> согласно новым правилам."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-exempt"
                    ],
                    "common_phrases": [
                        "exempt employee",
                        "exempt status"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in US labor law context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Классифицируемый как не имеющий права на оплату сверхурочных (обычно о профессиональных или руководящих должностях в США)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождённый",
                                "target_lang_sense_clarification": "от оплаты сверхурочных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bac2f288-32bf-3a08-a333-9e957c9cc0f2",
                    "sense_definition": "Set apart or cut off from others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins stood <w>exempt</w> from the modern city that grew around them.",
                            "target_lang_translations": {
                                "ru": "Древние руины стояли <w>обособленно</w> от современного города, выросшего вокруг них."
                            }
                        },
                        {
                            "text": "He felt <w>exempt</w> from the common gentry, living a life of total isolation.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>отчуждённым</w> от простого дворянства, ведя жизнь в полной изоляции."
                            }
                        }
                    ],
                    "synonyms": [
                        "isolated",
                        "detached",
                        "separated"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обособленный или отделенный от других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обособленный",
                                "target_lang_sense_clarification": "отделенный от окружения"
                            },
                            {
                                "target_lang_word": "изолированный",
                                "target_lang_sense_clarification": "находящийся в стороне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47084a2-308d-30f8-845b-19a64e9e6b77",
                    "sense_definition": "Being extraordinary or exceptional in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exceptional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her talent was so <w>exempt</w> that it defied any comparison to her peers.",
                            "target_lang_translations": {
                                "ru": "Ее талант был настолько <w>исключительным</w>, что не поддавался никакому сравнению с талантами сверстников."
                            }
                        },
                        {
                            "text": "The beauty of the landscape was <w>exempt</w> in its perfection.",
                            "target_lang_translations": {
                                "ru": "Красота пейзажа была <w>необычайной</w> в своем совершенстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "exceptional",
                        "extraordinary"
                    ],
                    "antonyms": [
                        "ordinary",
                        "common"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычайный или исключительный по своей природе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "выдающийся"
                            },
                            {
                                "target_lang_word": "необычайный",
                                "target_lang_sense_clarification": "превосходящий обычное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192b930b-fed4-3b29-a3c7-d66126838c5a",
                    "sense_definition": "To grant someone freedom or immunity from a requirement or obligation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "granting freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to <w>exempt</w> him from the final exam because of his high grades.",
                            "target_lang_translations": {
                                "ru": "Университет решил <w>освободить</w> его от выпускного экзамена из-за высоких оценок."
                            }
                        },
                        {
                            "text": "The new law will <w>exempt</w> small businesses from certain administrative fees.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>освободит</w> малый бизнес от определенных административных сборов."
                            }
                        }
                    ],
                    "synonyms": [
                        "excuse",
                        "release",
                        "spare"
                    ],
                    "antonyms": [
                        "oblige",
                        "require",
                        "enforce"
                    ],
                    "common_phrases": [
                        "exempt from requirements",
                        "exempt from fees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо свободу или иммунитет от требования или обязательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "от выполнения долга или уплаты"
                            },
                            {
                                "target_lang_word": "освободить",
                                "target_lang_sense_clarification": "разовое действие по снятию обязательств"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44f4191d-94dd-3ff4-95d5-d73d52ed6b94",
                    "sense_definition": "A person who has been released or excused from a specific duty or obligation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The list of <w>exempts</w> was posted on the board for all the students to see.",
                            "target_lang_translations": {
                                "ru": "Список <w>освобождённых</w> был вывешен на доске на виду у всех студентов."
                            }
                        },
                        {
                            "text": "As one of the <w>exempts</w>, he did not have to participate in the morning drills.",
                            "target_lang_translations": {
                                "ru": "Как один из <w>освобождённых</w>, он не должен был участвовать в утренних построениях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, освобожденное от определенной обязанности или налога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождённый",
                                "target_lang_sense_clarification": "человек, имеющий льготу или освобождение"
                            },
                            {
                                "target_lang_word": "льготник",
                                "target_lang_sense_clarification": "лицо с правом на освобождение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2a8434a-bc91-3b10-81f2-7f596fb8edae",
                    "sense_definition": "A historical type of French police officer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to slip past the <w>exempts</w> without being recognized by the authorities.",
                            "target_lang_translations": {
                                "ru": "Ему удалось проскользнуть мимо <w>экзамптов</w>, не будучи узнанным властями."
                            }
                        },
                        {
                            "text": "The <w>exempt</w> was responsible for maintaining order in that district of Paris.",
                            "target_lang_translations": {
                                "ru": "<w>Экзампт</w> отвечал за поддержание порядка в этом районе Парижа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical French context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический тип французского полицейского чина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экзампт",
                                "target_lang_sense_clarification": "исторический полицейский чин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cde30e4c-0188-3852-80db-062fb0fca28c",
                    "sense_definition": "One of four officers of the Yeomen of the Royal Guard, holding the rank of corporal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>exempt</w> stood tall during the royal procession at the palace.",
                            "target_lang_translations": {
                                "ru": "<w>Экзампт</w> гордо стоял во время королевской процессии во дворце."
                            }
                        },
                        {
                            "text": "He was promoted to the position of <w>exempt</w> within the Yeomen of the Guard.",
                            "target_lang_translations": {
                                "ru": "Он был повышен до должности <w>экзампта</w> в составе йоменской гвардии."
                            }
                        }
                    ],
                    "synonyms": [
                        "exon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British royal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из четырех офицеров йоменской гвардии Великобритании в чине капрала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экзампт",
                                "target_lang_sense_clarification": "офицер йоменской гвардии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}