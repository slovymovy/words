                ],
                "senses": [
                    {
                        "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                        "entry_id": "d80abf08-04fd-30b9-bd4e-5c76b0eb824f",
                        "glosses": [
                            "das Fehlen von Vitaminen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df5db89-3fa6-4f3d-bc11-951bdfc13b19",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Die Tiere erwiesen sich als hoch-kachektisch, was auf die Vitaminarmut dieser Rückstände zurückgeführt wurde.“"
                            },
                            {
                                "example_id": "35bea3a0-8b9c-4906-82ea-6a9eb145fd18",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Man hat ferner gefunden, daß bei Vitaminarmut die Sterblichkeit auf das Dreifache steigen kann, ohne daß ausgesprochene Mangelkrankheiten ausbrechen müssen.“"
                            },
                            {
                                "example_id": "9ce800fe-68c8-495b-b556-127b3365d603",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Er ist belebend und kühlend, gut, um den Durst zu löschen und bei brennendem Fieber dienlich; er ist von großem Nutzen bei Vitaminarmut.“"
                            },
                            {
                                "example_id": "c0a56291-c923-451c-be17-507f10855849",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Es erscheint durchaus möglich, daß die vorübergehende Häufung von menschlichen Mißbildungen in Notgebieten mit der Vitaminarmut der Nahrung zusammenhängt.“"
                            },
                            {
                                "example_id": "172fcc2e-929e-44ce-9d79-b2201eeedef2",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Bei großer Vitaminarmut der Kindernahrung in Niederländisch-Indien treffen doch selten Steinkrankheit und Avitaminosen zusammen.“"
                            },
                            {
                                "example_id": "bc4a6d91-757f-4bbd-bd87-7f457f6c20f5",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Daß eine häufigere und praktisch wichtigere Vitaminarmut der Nahrung für die Infektionsdisposition Bedeutung hat, ist nicht beweisbar.“"
                            },
                            {
                                "example_id": "f92f38a2-cc8f-4c5b-9709-01c0577e76ed",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Emulsionsmilch, soll auch wegen ihrer Vitaminarmut grundsätzlich von der Säuglingsernährung ausgeschlossen werden.“"
                            },
                            {
                                "example_id": "c09c2614-8110-41ef-9733-fded3077fc68",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Auch Abels vertritt die Ansicht, daß die Vitaminarmut der mütterlichen Nahrung das Geburtsgewicht des Kindes herabzudrücken imstande sei.“"
                            },
                            {
                                "example_id": "685e7181-8d61-4c58-b97c-cfcf7063f853",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Vitaminarmut, oxidativer oder nitrosativer Stress sind gefährlich und würden die Zellwände und dort zuerst die Polyenfettsäuren peroxidieren.“"
                            },
                            {
                                "example_id": "f256d77c-b433-40f8-9387-93f3a0a4dbd8",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Manche Behauptungen dieses Reformers sind sicher richtig, besonders daß die Vitaminarmut Krankheiten hervorrufe und andere begünstige.“"
                            },
                            {
                                "example_id": "c39c2459-7d89-40fe-b29b-43a32823d82b",
                                "sense_id": "44530b3a-642a-3ea1-8ea3-6cf0366e9b2a",
                                "text": "„Dennoch ist ein großer Teil der Bevölkerung infolge der Vitaminarmut der Nahrung unterernährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
