                    },
                    {
                        "sense_id": "8b2d275f-069b-316c-bf93-2322e4b17759",
                        "entry_id": "cfecbc58-ba89-39e3-b27e-f965ff520b27",
                        "glosses": [
                            "dim. tant. kort plezierreisje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed30b26d-f75f-4ab0-a7e9-d8d50a9c844b",
                                "sense_id": "8b2d275f-069b-316c-bf93-2322e4b17759",
                                "text": "Het zou dus ook een toeristisch uitstapje worden."
                            },
                            {
                                "example_id": "c6e05fae-09cf-4b69-bbb5-6973ec0c1cde",
                                "sense_id": "8b2d275f-069b-316c-bf93-2322e4b17759",
                                "text": "Ze waren gekleed voor een uitstapje in tot de knieën reikende skibroeken, geitenwollen sokken, goed ingevette skischoenen en prachtige Noorse truien met een nawinternachtpatroon op de schouders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1af5351-e9dc-4c7c-9999-0b376c58157b",
                        "source_entry_id": "cfecbc58-ba89-39e3-b27e-f965ff520b27",
                        "source_sense_id": "8b2d275f-069b-316c-bf93-2322e4b17759",
                        "source_sense_description": "kort plezierreisje",
                        "target_lang_word": "Ausflug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausflug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e45abf-e742-3aff-913c-7cb28538a955",
                                        "entry_id": "06ba1121-832d-3b89-94ac-3234b20f1e9a",
                                        "glosses": [
                                            "eine kurze Reise oder ein Abstecher, oft mit dem Ziel, sich zu erholen oder zu unterhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33b640f-12e0-44f2-a268-60ad7cf072e4",
                                                "sense_id": "d5e45abf-e742-3aff-913c-7cb28538a955",
                                                "text": "Sonntags machen wir oft mit der ganzen Familie einen Ausflug aufs Land."
                                            },
                                            {
                                                "example_id": "c51dbfd0-4112-48e2-90fe-0be8bca7ede5",
                                                "sense_id": "d5e45abf-e742-3aff-913c-7cb28538a955",
                                                "text": "„An jedem Abend in Kapstadt kehrte ich von Ausflügen in die Townships in mein Luxushotel zurück.“"
                                            },
                                            {
                                                "example_id": "a779a68e-a036-4091-9723-3d1939736995",
                                                "sense_id": "d5e45abf-e742-3aff-913c-7cb28538a955",
                                                "text": "„Der weitere Ausflug folgte demselben Schema.“"
                                            },
                                            {
                                                "example_id": "962eede8-c6a2-4f4f-8176-d0eb998abdc0",
                                                "sense_id": "d5e45abf-e742-3aff-913c-7cb28538a955",
                                                "text": "„Es war Spätfrühling, und ich dachte, jetzt wäre es auf dem Land am schönsten, und wir könnten einen wunderbaren Ausflug machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d113ea5c-89d1-436b-94e7-1274e4866a26",
                        "source_entry_id": "cfecbc58-ba89-39e3-b27e-f965ff520b27",
                        "source_sense_id": "8b2d275f-069b-316c-bf93-2322e4b17759",
                        "source_sense_description": "kort plezierreisje",
                        "target_lang_word": "excursion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3353aef-cd8f-334d-b482-03e4f11be0d7",
                                        "entry_id": "383224b9-0158-3c6a-82e7-b103d28c7442",
                                        "glosses": [
                                            "A brief recreational trip; a journey out of the usual way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1634075f-a402-410b-afb3-d74ee4ea878c",
                                                "sense_id": "d3353aef-cd8f-334d-b482-03e4f11be0d7",
                                                "text": "While driving home I took an excursion and saw some deer."
                                            },
                                            {
                                                "example_id": "2749a93d-369f-46ad-b614-5f2d28c6c494",
                                                "sense_id": "d3353aef-cd8f-334d-b482-03e4f11be0d7",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5442753b-3b77-3469-904f-09b4f3218a7f",
                                        "entry_id": "383224b9-0158-3c6a-82e7-b103d28c7442",
                                        "glosses": [
                                            "A field trip."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ff8ae27-9206-3d66-9cec-672f7d57b6a3",
                                        "entry_id": "383224b9-0158-3c6a-82e7-b103d28c7442",
                                        "glosses": [
                                            "A wandering from the main subject: a digression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e1449cf-71e1-4f85-9f45-2b04cdfe4321",
                                                "sense_id": "6ff8ae27-9206-3d66-9cec-672f7d57b6a3",
                                                "text": "Now all his ponderings, however excursive, wheeled round Isabel as their center; and back to her they came again from every excursion; and again derived some new, small germs for wonderment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21c5a4c-9890-3b05-a7df-939736ed52aa",
                                        "entry_id": "383224b9-0158-3c6a-82e7-b103d28c7442",
                                        "glosses": [
                                            "An occurrence where an aircraft runs off the end or side of a runway or taxiway, usually during takeoff, landing, or taxi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "772e1036-6373-3f4b-99bf-a839667a9c23",
                                        "entry_id": "383224b9-0158-3c6a-82e7-b103d28c7442",
                                        "glosses": [
                                            "A deviation in pitch, for example in the syllables of enthusiastic speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "excursion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b456b158-a585-3276-83b2-8d886d8d093b",
                                        "entry_id": "752204cc-1d77-367c-a4e3-8fa776b2d796",
                                        "glosses": [
                                            "To go on a recreational trip or excursion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78430115-007b-4de6-858e-b059ee8e516f",
                                                "sense_id": "b456b158-a585-3276-83b2-8d886d8d093b",
                                                "text": "1825, Charles Lamb, Letter to Mr. Wordsworth, 6 April, 1825, in The Works of Charles Lamb, Volume I, New York: Harper & Brothers, 1851, p. 249, https://books.google.ca/books?id=ypdNAQAAMAAJ&printsec=frontcover#v=onepage&q&f=false\nYesterday I excursioned twenty miles; to-day I write a few letters."
                                            },
                                            {
                                                "example_id": "02f8b69f-883e-4839-98a1-bdd982125d42",
                                                "sense_id": "b456b158-a585-3276-83b2-8d886d8d093b",
                                                "text": "After breakfast, that next morning in Chamonix, we went out in the yard and watched the gangs of excursioning tourists arriving and departing with their mules and guides and porters […]"
                                            },
                                            {
                                                "example_id": "3b7da220-7a20-4d74-a3e6-d574e3219f57",
                                                "sense_id": "b456b158-a585-3276-83b2-8d886d8d093b",
                                                "text": "Victoria cows preferred to walk on the plank sidewalks in winter rather than dirty their hooves in the mud by the roadside. They liked to tune their chews to the tap, tap, tap of their feet on the planks. Ladies challenged the right of way by opening and shutting their umbrellas in the cows' faces and shooing, but the cows only chewed harder and stood still. It was the woman-lady, not the lady-cow who had to take to the mud and get scratched by the wild rose bushes that grew between sidewalk and fence while she excursioned round the cow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e86b453e-69cb-4166-bda0-bd306c7deb93",
                        "source_entry_id": "cfecbc58-ba89-39e3-b27e-f965ff520b27",
