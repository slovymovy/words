                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klemmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d30557f-e0a9-37ea-955c-a91cea121499",
                                        "entry_id": "2cdd3f24-014a-3abe-96d2-7eab52fe9ce9",
                                        "glosses": [
                                            "Brille, die keine Bügel hat und nur auf die Nase geklemmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96e09e6-7c02-4dc6-841a-449e8ddc7ae4",
                                                "sense_id": "4d30557f-e0a9-37ea-955c-a91cea121499",
                                                "text": "„Schräg gegenüber sitzt Stuff und sieht ihn grade und trüb durch den Klemmer an.“"
                                            },
                                            {
                                                "example_id": "312ebd9f-2284-4229-a2c0-c395a8c348ac",
                                                "sense_id": "4d30557f-e0a9-37ea-955c-a91cea121499",
                                                "text": "„Er trug einen spärlichen, sehr geraden Scheitel in der Mitte und einen Klemmer darunter.“"
                                            },
                                            {
                                                "example_id": "88e36093-d274-41de-a7ff-060c89323d4e",
                                                "sense_id": "4d30557f-e0a9-37ea-955c-a91cea121499",
                                                "text": "„Er zieht seinen Klemmer heraus, setzt ihn auf die Nase, betrachtet die Decken, schaut darauf den Kaufmann an und kann sich gar nicht erholen von seinem Schreck, er sagt kein Wort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16041226-9952-4be6-aebc-3e6c1ed27b4f",
                        "source_entry_id": "ff064c67-e0cb-3750-9260-bb24e2cab232",
