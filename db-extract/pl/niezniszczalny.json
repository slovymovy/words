                        ]
                    },
                    {
                        "translation_id": "041a65fc-623b-4fde-82fd-9dd79599a8e0",
                        "source_entry_id": "c1f714bc-166f-3f0c-954c-f3598878ceb1",
                        "source_sense_id": "c979051d-207f-3d28-a869-2ba91a69abed",
                        "target_lang_word": "imperishable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperishable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                        "entry_id": "d6bfd909-ecad-3747-a614-c8d292375879",
                                        "glosses": [
                                            "Not perishable; not subject to decay; enduring permanently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c418a29e-b51f-4ba1-936c-2650d0baf495",
                                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                                "text": "an imperishable monument"
                                            },
                                            {
                                                "example_id": "5c72cd4b-6995-457b-8060-c1c3a8a26688",
                                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                                "text": "The child was to be a prophet, unrivalled among men, and the parent of an imperishable race."
                                            },
                                            {
                                                "example_id": "e2a6be52-edcd-4d78-9e51-0fa3200d3ebf",
                                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                                "text": "Sir Philip Sidney, soldier, courtier, statesman and poet, was born at Penshurst in 1554. He won imperishable fame 32 years later at the Battle of Zutphen in Holland when, mortally wounded, he refused a drink of water and passed his flask to a wounded soldier, with the words: 'Thy necessity is yet greater than mine.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imperishable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94981a2d-79f7-30a2-b626-3e085de3082e",
                                        "entry_id": "a98fc791-7f6a-3330-ba8e-6293125f5912",
                                        "glosses": [
                                            "something that does not perish, or keeps for a long time"
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a4ea82-f5e5-4b46-ba07-d08511da1941",
                        "source_entry_id": "c1f714bc-166f-3f0c-954c-f3598878ceb1",
                        "source_sense_id": "c979051d-207f-3d28-a869-2ba91a69abed",
                        "target_lang_word": "nezničitelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad35b5e0-fb31-4984-8ea7-e6d2e03d8dc6",
                        "source_entry_id": "c1f714bc-166f-3f0c-954c-f3598878ceb1",
                        "source_sense_id": "c979051d-207f-3d28-a869-2ba91a69abed",
                        "target_lang_word": "indestructible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indestructible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                        "entry_id": "ca404da6-9d9c-3abf-8dcd-e13f1d159e70",
                                        "glosses": [
                                            "Qui ne peut être détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad13026d-2eff-4479-a055-53f0987bbf8e",
                                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                                "text": "Ainsi, en dirigeant les eaux de manière à ce qu’elles n’engorgeassent plus le canal indestructible que la Nature avait fait elle-même, et le débarrassant des terres qui l’avait comblé, l’irrigation serait facilitée par cette longue gouttière, élevée d’environ dix pieds au-dessus de la plaine."
                                            },
                                            {
                                                "example_id": "be499cca-8aa8-4e96-9794-9dd4f79d14c0",
                                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                                "text": "Celui-là, reprit Léonora, porte au cœur une indestructible ambition : fils de roi, régner à son tour !"
                                            },
                                            {
                                                "example_id": "c750bbba-9c6d-4f17-bfcd-9247c58c3ed8",
                                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                                "text": "Baptiste, incapable d'imaginer que l’école nous guettait, avait consacré trois jours entiers à construire un radeau qu’il prétendait indestructible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
