        "ru-extract.jsonl": [
            {
                "entry_id": "008ffbaa-6079-347a-9f5f-01fdb4643fda",
                "word": "дабы",
                "pos": "conj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da4a9b4d-45c8-3cc4-b9d8-b57f7015feca",
                        "entry_id": "008ffbaa-6079-347a-9f5f-01fdb4643fda",
                        "glosses": [
                            "устар. то же, что чтобы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e8397b2-7214-4837-a731-f37f975bc6b4",
                                "sense_id": "da4a9b4d-45c8-3cc4-b9d8-b57f7015feca",
                                "text": "Причиною тому были строгие меры, предпринятые генерал-майором Траубенбергом, дабы привести войско к должному повиновению."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f14ad07e-fb66-473a-930a-71816bb79c53",
                        "source_entry_id": "008ffbaa-6079-347a-9f5f-01fdb4643fda",
                        "source_sense_id": "da4a9b4d-45c8-3cc4-b9d8-b57f7015feca",
                        "target_lang_word": "pour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce02198-855d-32e7-ad5f-4fb47d69f4fc",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Au motif de ; dans le but de ; afin de ; à destination de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33244fb1-6d68-4d8c-88b9-3fb6a6e46cc0",
                                                "sense_id": "6ce02198-855d-32e7-ad5f-4fb47d69f4fc",
                                                "text": "Cet homme fait de l’exercice pour sa santé."
                                            },
                                            {
                                                "example_id": "1ceb032e-32e7-456d-bdd0-02ac350df9dd",
                                                "sense_id": "6ce02198-855d-32e7-ad5f-4fb47d69f4fc",
                                                "text": "Des vêtements pour enfants."
                                            },
                                            {
                                                "example_id": "7233e19a-d356-467d-963c-d264f9a66133",
                                                "sense_id": "6ce02198-855d-32e7-ad5f-4fb47d69f4fc",
                                                "text": "Dans quelle maison habiterai-je, trou, cabane, palais, château, la corde sifflait et s’empêtrait dans les jambes, palais ! On n’a pas de sous pour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8beb645-ae12-35d4-903c-6fa7864d6aef",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "À cause de, en considération de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a46f8f-e2c5-4710-8da2-01b269075b84",
                                                "sense_id": "e8beb645-ae12-35d4-903c-6fa7864d6aef",
                                                "text": "Il est estimé pour ses vertus."
                                            },
                                            {
                                                "example_id": "bb0417f4-80e1-46e1-9f74-2958a4a0c7ad",
                                                "sense_id": "e8beb645-ae12-35d4-903c-6fa7864d6aef",
                                                "text": "Si vous l’eussiez voulu, pour vous, j’aurais pu conquérir des royaumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04356edc-b632-334e-8114-5472af1b45fe",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "En faveur de, en vue de la défense de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5db3f7-1abd-4b5b-9350-cec7f17c02e1",
                                                "sense_id": "04356edc-b632-334e-8114-5472af1b45fe",
                                                "text": "Ce que je dis est autant pour vous que pour moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b353a7-0db6-3494-834c-63c184524bfb",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Envers, à l’égard de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d855c8c-d5f8-4481-8dbf-ed98a7444d4f",
                                                "sense_id": "12b353a7-0db6-3494-834c-63c184524bfb",
                                                "text": "La tendresse d’une mère pour ses enfants."
                                            },
                                            {
                                                "example_id": "f0039382-b878-45f3-a24a-c6d481dc8d45",
                                                "sense_id": "12b353a7-0db6-3494-834c-63c184524bfb",
                                                "text": "Ce remède est bon pour la fièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b4a16a1-c6e2-367b-84d9-903fe9c06800",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Il sert aussi à marquer le rapport entre une chose qui affecte en bien ou en mal et la personne qui en est ou qui en doit être affectée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d8153d-a5d6-4434-bb0a-417a9bc70c5c",
                                                "sense_id": "8b4a16a1-c6e2-367b-84d9-903fe9c06800",
                                                "text": "C’est un grand bonheur pour moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d393fd-2168-3e14-bd12-e608dbabe677",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Eu égard à, par rapport à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee953ea8-b3a6-4db7-a1c6-c86fd49c6a39",
                                                "sense_id": "79d393fd-2168-3e14-bd12-e608dbabe677",
                                                "text": "Cette robe est bien chaude pour la saison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f84edc1-3e02-35db-bf43-67d1cf413d00",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Précédé des mots assez et trop, il s’emploie dans les phrases qui expriment la suffisance ou l’excès."
                                        ],
                                        "tags": [],
                                        "note": "Quelquefois on peut supprimer l’adverbe assez",
                                        "examples": [
                                            {
                                                "example_id": "af515007-3da5-466a-91fd-711a1e98c068",
                                                "sense_id": "5f84edc1-3e02-35db-bf43-67d1cf413d00",
                                                "text": "Y en a-t-il assez pour tout le monde ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4e8a52-ec10-39c0-870c-7d65a1b0b493",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Pour que, afin de, à l’effet de, en vue de, dans le dessein de. - Note d’usage : Il est alors suivi d’un verbe à l’infinitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a959eed1-57f7-4075-a874-98197d8ee6af",
                                                "sense_id": "4c4e8a52-ec10-39c0-870c-7d65a1b0b493",
                                                "text": "Il est encore assez jeune pour s’instruire."
                                            },
                                            {
                                                "example_id": "ca7561fd-65c1-422e-91fe-24f01dc58f2a",
                                                "sense_id": "4c4e8a52-ec10-39c0-870c-7d65a1b0b493",
                                                "text": "On le cherche pour l’arrêter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "409666f5-10c4-3f18-b6bd-4de17ac5078c",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Moyennant un certain prix, en échange de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0271d55-eb5a-4ecc-a913-18e5fffe6b68",
                                                "sense_id": "409666f5-10c4-3f18-b6bd-4de17ac5078c",
                                                "text": "Il a cédé sa voiture pour un morceau de pain."
                                            },
                                            {
                                                "example_id": "16c68de4-5d0d-47b0-a7a2-260f5ff9c604",
                                                "sense_id": "409666f5-10c4-3f18-b6bd-4de17ac5078c",
                                                "text": "J’ai donné mon argenterie pour un diamant."
                                            },
                                            {
                                                "example_id": "72bda1cf-c2c5-4bde-ae81-ecd99adb1f7f",
                                                "sense_id": "409666f5-10c4-3f18-b6bd-4de17ac5078c",
                                                "text": "À cette vente, on avait des tableaux de maître pour rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b64569b-370c-3992-aba8-38d51fcd56c9",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "À proportion de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe94fec7-e2d0-4e3e-9368-3d68fa901c21",
                                                "sense_id": "1b64569b-370c-3992-aba8-38d51fcd56c9",
                                                "text": "Cinq pour cent, dix pour cent, cent pour cent, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d023ac4-c4a1-373b-a5c8-ab11dfb94831",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "À la place de, au lieu de, au nom de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bea305-3efa-4a08-90dc-c43a858d5636",
                                                "sense_id": "2d023ac4-c4a1-373b-a5c8-ab11dfb94831",
                                                "text": "Il répondit pour un tel à la sommation."
                                            },
                                            {
                                                "example_id": "0bffa5ce-721a-478b-add5-cd64a1b723d2",
                                                "sense_id": "2d023ac4-c4a1-373b-a5c8-ab11dfb94831",
                                                "text": "Jouez pour moi."
                                            },
                                            {
                                                "example_id": "7d06302c-7bd9-4ead-86d0-7b60b6428089",
                                                "sense_id": "2d023ac4-c4a1-373b-a5c8-ab11dfb94831",
                                                "text": "Ce mot s’emploie souvent pour tel autre."
                                            },
                                            {
                                                "example_id": "42991d74-5df1-4f9b-a00b-1fb5fac29e45",
                                                "sense_id": "2d023ac4-c4a1-373b-a5c8-ab11dfb94831",
                                                "text": "Pour le président, le secrétaire général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f57f58-6023-3476-b4ce-f63ef07cdb57",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Comme, en qualité de, en guise de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34320c9-7897-40aa-9566-73509c1d54a4",
                                                "sense_id": "97f57f58-6023-3476-b4ce-f63ef07cdb57",
                                                "text": "Ils l’ont laissé pour mort sur la place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1ed95bd-135a-3a3a-b0f8-3fef7db05241",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Précédé et suivi du même mot, il marque la comparaison :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b63f383-5581-4c2b-b52a-851c4346b156",
                                                "sense_id": "e1ed95bd-135a-3a3a-b0f8-3fef7db05241",
                                                "text": "Traduire mot pour mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107a1a0c-3c2b-31b6-b874-726825637e88",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Il sert encore à mettre en balance, à opposer des contraires ou des valeurs différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d6099a-2ceb-4a98-acef-42d3b9d76537",
                                                "sense_id": "107a1a0c-3c2b-31b6-b874-726825637e88",
                                                "text": "Pour quelques bons combien de méchants."
                                            },
                                            {
                                                "example_id": "e0db1e91-8139-4dd6-8106-6f98b1913f8a",
                                                "sense_id": "107a1a0c-3c2b-31b6-b874-726825637e88",
                                                "text": "Pour un saint combien de réprouvés."
                                            },
                                            {
                                                "example_id": "73498b81-5ce1-45fd-a530-85d25ac496c4",
                                                "sense_id": "107a1a0c-3c2b-31b6-b874-726825637e88",
                                                "text": "Pour deux ennemis qu’il s’attendait à combattre il en trouva cent."
                                            },
                                            {
                                                "example_id": "b8a097bd-0bda-4a90-8190-9d2bdb34ffac",
                                                "sense_id": "107a1a0c-3c2b-31b6-b874-726825637e88",
                                                "text": "Rendre le bien pour le mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b0a0a7-1c28-36c1-97a4-4e44a1719877",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Il sert à indiquer la durée."
                                        ],
                                        "tags": [],
                                        "note": "Il est joint alors à une expression qui marque le temps",
                                        "examples": [
                                            {
                                                "example_id": "7b713660-c5ec-4b17-b43e-de8ad4f85d1a",
                                                "sense_id": "14b0a0a7-1c28-36c1-97a4-4e44a1719877",
                                                "text": "Ils décidèrent de faire un feu pour la nuit."
                                            },
                                            {
                                                "example_id": "cd0f1241-423f-4a8e-b557-479919130312",
                                                "sense_id": "14b0a0a7-1c28-36c1-97a4-4e44a1719877",
                                                "text": "L’histoire est longue, il y en aurait pour deux heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "659f5d5d-6554-3ce7-a607-86f0b3330c50",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Il sert aussi à indiquer l’époque à laquelle une chose s’est faite ou se fera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e71c58-a99d-43e3-b3d5-5dd44c1b65af",
                                                "sense_id": "659f5d5d-6554-3ce7-a607-86f0b3330c50",
                                                "text": "Les deux chevaliers s'étant donc accordés avec un égal plaisir à se reconnaître frères d'armes , ils se séparèrent pour ce moment, après mille protestations d’amitié."
                                            },
                                            {
                                                "example_id": "354fe3b6-2b18-461c-8cd2-c2bccc51e5f6",
                                                "sense_id": "659f5d5d-6554-3ce7-a607-86f0b3330c50",
                                                "text": "Son bal était pour hier, est pour aujourd’hui."
                                            },
                                            {
                                                "example_id": "cd6cc7df-129e-40e6-90fb-821d077c7aa8",
                                                "sense_id": "659f5d5d-6554-3ce7-a607-86f0b3330c50",
                                                "text": "Ce sera pour demain, pour après-demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488e116e-6718-38c0-8286-38f47aeccda1",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "À destination de."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors joint à une expression qui marque le lieu, le but. En termes de marine, devant \"France\", on supprime ordinairement l’article",
                                        "examples": [
                                            {
                                                "example_id": "d7278905-4483-43cc-a188-601e89c28f78",
                                                "sense_id": "488e116e-6718-38c0-8286-38f47aeccda1",
                                                "text": "Il est parti pour Londres, pour Naples, pour la France."
                                            },
                                            {
                                                "example_id": "b2d2628a-6015-455d-8aa1-a356762ad55d",
                                                "sense_id": "488e116e-6718-38c0-8286-38f47aeccda1",
                                                "text": "Ce paquebot partira demain pour France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d93443b-2c78-3977-ac0c-55bbcc017276",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Quant à."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors au commencement d’une phrase ou d’un membre de phrase",
                                        "examples": [
                                            {
                                                "example_id": "5edd7120-1128-4c16-a4d6-97434d06a2b5",
                                                "sense_id": "7d93443b-2c78-3977-ac0c-55bbcc017276",
                                                "text": "Mais pour votre femme, qui n'est pas si honnête, je vous conseille de ne pas chercher à la reprendre."
                                            },
                                            {
                                                "example_id": "3eef4136-932d-4481-847d-79a814bdab06",
                                                "sense_id": "7d93443b-2c78-3977-ac0c-55bbcc017276",
                                                "text": "Pour moi, je n’en ferai rien."
                                            },
                                            {
                                                "example_id": "1c9cb035-cc67-4dfc-9b44-d37b79c4b3c2",
                                                "sense_id": "7d93443b-2c78-3977-ac0c-55bbcc017276",
                                                "text": "À cette dernière marque de la constance et de l'amour de cette fille infortunée, je pleurai amèrement. Pour Domingue, il se frappait la poitrine, et perçait l'air de ses cris douloureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8545f24c-e843-3c50-b315-8d79c9cadece",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Quoique, bien que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae95a08a-4805-4e35-8125-ae5a5d90536d",
                                                "sense_id": "8545f24c-e843-3c50-b315-8d79c9cadece",
                                                "text": "Il est bien ignorant pour avoir étudié si longtemps."
                                            },
                                            {
                                                "example_id": "8d1ceb32-5af0-4af6-855e-49074e623866",
                                                "sense_id": "8545f24c-e843-3c50-b315-8d79c9cadece",
                                                "text": "Il est bien grand pour être si jeune."
                                            },
                                            {
                                                "example_id": "52d0a02e-45f5-4743-a929-35366ac8ec83",
                                                "sense_id": "8545f24c-e843-3c50-b315-8d79c9cadece",
                                                "text": "Pour être fêté partout, il n’en est pas plus fier."
                                            },
                                            {
                                                "example_id": "2e90b7a4-a98c-4928-b903-9c52bcc54207",
                                                "sense_id": "8545f24c-e843-3c50-b315-8d79c9cadece",
                                                "text": "Pour être irrationnelles, ces représailles multiformes sont bien réelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff722630-8af1-30e5-abd4-ac28b5ab8ff5",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "De quoi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c537f1-acb2-4251-aa1b-4a6969e120cf",
                                                "sense_id": "ff722630-8af1-30e5-abd4-ac28b5ab8ff5",
                                                "text": "Il y a ici pour contenter tous les goûts."
                                            },
                                            {
                                                "example_id": "8accc16a-c1fe-4113-a46e-5cfdcf6cc7aa",
                                                "sense_id": "ff722630-8af1-30e5-abd4-ac28b5ab8ff5",
                                                "text": "Faire une si longue traite, c’est pour en mourir."
                                            },
                                            {
                                                "example_id": "48bcacca-606a-40fc-8e83-4fa3be37e582",
                                                "sense_id": "ff722630-8af1-30e5-abd4-ac28b5ab8ff5",
                                                "text": "Qu’allez-vous faire là ? Il y en a pour périr d’ennui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a760652b-673a-3d97-a0ed-134ee719e60c",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Parce que."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors joint au passé de l’infinitif des verbes",
                                        "examples": [
                                            {
                                                "example_id": "f00f3bde-5754-4cad-bacb-10e89d63aa74",
                                                "sense_id": "a760652b-673a-3d97-a0ed-134ee719e60c",
                                                "text": "Il a été chassé pour avoir trop parlé."
                                            },
                                            {
                                                "example_id": "7aab401d-11e3-4c98-bf99-70ab4ad8120a",
                                                "sense_id": "a760652b-673a-3d97-a0ed-134ee719e60c",
                                                "text": "Il est malade pour avoir trop mangé, pour s’être livré à des excès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3586b144-3aad-3cb4-8590-bb5395c4590c",
                                        "entry_id": "416a3358-6bac-3a64-802f-29e6cf29fecf",
                                        "glosses": [
                                            "Et ensuite. Coordonne deux évènements, surtout si le second est surprenant ou inattendu. Il est alors suivi de l'infinitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2f9584-86cf-4a32-9d0a-5b31c9406e4d",
                                                "sense_id": "3586b144-3aad-3cb4-8590-bb5395c4590c",
                                                "text": "Il s'est levé ce matin, pour se recoucher dès qu'il a vu qu'il pleuvait."
                                            },
                                            {
                                                "example_id": "2d9f69a5-7078-47f2-8a8f-a6c12a6e43fe",
                                                "sense_id": "3586b144-3aad-3cb4-8590-bb5395c4590c",
                                                "text": "Elle est sortie de l'hôtel, pour se faire renverser par un bus."
                                            },
                                            {
                                                "example_id": "dd663703-b876-4ec2-ba4e-97dc44b2fcfd",
                                                "sense_id": "3586b144-3aad-3cb4-8590-bb5395c4590c",
                                                "text": "Enfant, il rêvait d'être acteur, pour finalement devenir épicier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14b5e922-a1e6-36e1-ae0a-beb268b2337a",
                                        "entry_id": "5e65a5d1-9fdc-37b2-bbea-9d06cb6aac6e",
                                        "glosses": [
                                            "Argument favorable, avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd778a6-1d6f-4bcf-91c7-78e1272666d9",
                                                "sense_id": "14b5e922-a1e6-36e1-ae0a-beb268b2337a",
                                                "text": "Peser le pour et le contre."
                                            },
                                            {
                                                "example_id": "6344844b-45bb-4659-a795-f399b6d5ce6b",
                                                "sense_id": "14b5e922-a1e6-36e1-ae0a-beb268b2337a",
                                                "text": "Lucie.– Oh ! oui… aussi ce serait très mal de le tromper.\nAlbert.– Mon Dieu… il y a du pour et du contre…"
                                            },
                                            {
                                                "example_id": "13101c5e-6f3e-41d8-a820-370f788afbda",
                                                "sense_id": "14b5e922-a1e6-36e1-ae0a-beb268b2337a",
                                                "text": "Le recours aux actes de langage indirects dans la communication a souvent été expliqué en termes de politesse. Quels sont les pours et les contres de cette explication ?"
                                            },
                                            {
                                                "example_id": "2fdc82b4-d340-4543-a327-106515839f0e",
                                                "sense_id": "14b5e922-a1e6-36e1-ae0a-beb268b2337a",
                                                "text": "Faire appel à des saisonniers : les pour et les contre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9aeacce-37e4-3e62-b151-d2a23dd052c9",
                                        "entry_id": "5e65a5d1-9fdc-37b2-bbea-9d06cb6aac6e",
                                        "glosses": [
                                            "Vote en faveur de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af41f886-5d07-485d-b1f0-d9fa1d5321e8",
                                                "sense_id": "c9aeacce-37e4-3e62-b151-d2a23dd052c9",
                                                "text": "Les avis sont partagés, les pour et les contre s’équilibrent."
                                            },
                                            {
                                                "example_id": "c73feafa-7b89-4d51-a758-301ed2324c4f",
                                                "sense_id": "c9aeacce-37e4-3e62-b151-d2a23dd052c9",
                                                "text": "Ici, les opinions divergent : […]. Concernant les pours, ils considèrent que chacun se voyant reconnaître une partie des prérogatives sociales, chacun a implicitement, mais nécessairement, la qualité d’associé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b1a3f11-2a06-41f6-afd2-fbf0bf596957",
                        "source_entry_id": "008ffbaa-6079-347a-9f5f-01fdb4643fda",
                        "source_sense_id": "da4a9b4d-45c8-3cc4-b9d8-b57f7015feca",
                        "target_lang_word": "afin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8731f45f-35bf-3d2e-8a95-55828a123608",
                                        "entry_id": "eece0b62-9a2c-3ad3-bbc5-a4213e5cda14",
                                        "glosses": [
                                            "Mot invariable ne s'employant que dans les locutions prépositive « afin de » (+ infinitif) ou conjonctive « afin que » (+ verbe au subjonctif), permettant d’indiquer dans les constructions le(s) but(s) poursuivi(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9aa59fe-5cf1-46c9-8b32-95634637d322",
                                                "sense_id": "8731f45f-35bf-3d2e-8a95-55828a123608",
                                                "text": "Afin de pouvoir dire que je n’ai rien à me reprocher…"
                                            },
                                            {
                                                "example_id": "98113053-3880-4474-b91f-c78f65b9915b",
                                                "sense_id": "8731f45f-35bf-3d2e-8a95-55828a123608",
                                                "text": "Afin d’obtenir cette grâce…"
                                            },
                                            {
                                                "example_id": "ab46f8d9-f2c3-4b43-a110-069500867ef5",
                                                "sense_id": "8731f45f-35bf-3d2e-8a95-55828a123608",
                                                "text": "Afin que vous le sachiez, que vous ne l’ignoriez pas…"
                                            },
                                            {
                                                "example_id": "2f0faa14-38de-4e58-81a0-9e69aea21b1e",
                                                "sense_id": "8731f45f-35bf-3d2e-8a95-55828a123608",
                                                "text": "Ce livre est toujours sur le bureau, afin qu’on puisse le consulter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
