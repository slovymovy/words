                "senses": [
                    {
                        "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                        "entry_id": "d379d300-bd7a-3696-a9d5-a74ed0c40059",
                        "glosses": [
                            "Abfolge vieler Bilder/Fotos, die schnell nacheinander betrachtet den Eindruck von Bewegung erzeugen"
                        ],
                        "tags": [
                            "Photographie"
                        ],
                        "examples": [
                            {
                                "example_id": "bb9ba8b8-acf8-4453-ae73-506ace0952c7",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "Bewegtbilder kann man meist auch mit einer guten Digitalkamera aufzeichnen."
                            },
                            {
                                "example_id": "66d72749-3f12-4e86-a2dc-7204f3b2b690",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Bewegtbilder (Filme) bestehen aus aufeinanderfolgenden Einzelbildern.“"
                            },
                            {
                                "example_id": "cd084855-4f29-4071-959a-b64b229983f0",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "[Studie:] „Demnach sehen sich 60 Prozent der Befragten mindestens einmal wöchentlich Bewegtbilder im Netz an.“"
                            },
                            {
                                "example_id": "a8b193e4-5826-4d91-bbe3-58650f2bc54d",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Dan Tombs hat eine Vorliebe für abstrakte Bewegtbilder. Er macht Musikvideos, Video-Installationen und Live-Visuals für befreundete Musiker aus dem Bereich der elektronischen Musik,“ […]."
                            },
                            {
                                "example_id": "be09e58f-68fe-430f-afda-7ff0c9461e20",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„In „Avatar“ erzählte James Cameron 2009 eine epische Kolonisierungsgeschichte auf einem exotischen Planeten und setzte Maßstäbe in Sachen 3D-Kino. Nun zeigt er erste Bewegtbilder aus Teil 2.“"
                            },
                            {
                                "example_id": "d87ffd43-38e9-47cb-9698-10527cc8bf12",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "Daumenkino ist auch Bewegtbild, und das gibt es schon fast so lange, wie es Papier und Zeichnungen gibt."
                            },
                            {
                                "example_id": "ccea8822-80a8-4357-9b61-42765b04215d",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "[Zeichentrickfilm:] „Durch geringfügige Änderung des Inhalts, von Bild zu Bild, entsteht beim Betrachter der Eindruck, dass es sich um ein Bewegtbild handelt.“"
                            },
                            {
                                "example_id": "514d9fbd-0b1a-439c-8754-605a28fe103d",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "[Internet:] „Den größten Anteil an diesen Daten machen mittlerweile Videos aus: 80 Prozent aller Daten sausen als Bewegtbild durchs Netz.“"
                            },
                            {
                                "example_id": "7ddc71c4-67f2-4165-b50d-24932e89de50",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Da fallen pro Foto und Videosekunde drei bis vier Megabyte an, allein eine Stunde Bewegtbild schlägt also mit stolzen sieben bis acht Gigabyte zu Buche, von Musik, Dokumenten, E-Mails und Apps ganz zu schweigen.“"
                            },
                            {
                                "example_id": "64a43b43-9ec3-41ba-8160-0196658bd3b6",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Jörn Hintzer und Jakob Hüfner sind Professoren für Crossmediales Bewegtbild an der Bauhaus-Akademie in Weimar.“"
                            },
                            {
                                "example_id": "146835e4-6de5-42f5-9046-610d6b2239b7",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "[Lernvideos:] „Im Bewegtbild können komplexe Themen besonders gut veranschaulicht werden.“"
                            },
                            {
                                "example_id": "e7ad7f60-3310-49f9-920b-3f7476fa954a",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Meine Hauptmotivation ist, bei Kindern und Jugendlichen die Liebe für Film und Bewegtbild zu wecken.“"
                            },
                            {
                                "example_id": "b3013cbb-f442-404f-b5c3-4a4975ecb171",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Das Konzert vom 29. November, dem Vorabend des 1. Advents, wird live im Radio auf BR-Klassik übertragen und ist im Internet als Livestream mit Bewegtbild in HD-Qualität zu sehen –“ […]."
                            },
                            {
                                "example_id": "f89b9aa7-a3b4-4ede-b1dd-cbaca831d5ef",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "„Sowohl der chinesische Marsrover Zhurong als auch die Sonde Solar Orbiter von Esa und Nasa haben in dieser Woche erste Bilder geliefert. Während Zhurong Eindrücke vom roten Planeten übermittelte, hielt Solar Orbiter erstmals Sonneneruptionen im Bewegtbild fest.“"
                            },
                            {
                                "example_id": "d84de9d6-3b6e-4bc6-9b9f-0392751bed16",
                                "sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                                "text": "[Lesen:] „Vom Bewegtbild wieder zurückzufinden zur nüchternen Textzeile, keine einfache Sache: »Das ist kompliziert, weil unser Gehirn so wahnsinnig gern konsumiert. Und das Lesen ist doch eine andere, aktivere Tätigkeit, als Bilder anschauen«, meint Dörrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e2b181d-88b8-4b6d-a768-94792fa79752",
                        "source_entry_id": "d379d300-bd7a-3696-a9d5-a74ed0c40059",
                        "source_sense_id": "83546833-c199-300a-b0bc-ef39bc46ae2f",
                        "source_sense_description": "Abfolge vieler Bilder/Fotos, die schnell nacheinander betrachtet den Eindruck von Bewegung erzeugen",
                        "target_lang_word": "film",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "film",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "542c7266-f4be-3f43-bf4b-126d1be91a95",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "Pellicule de gélatine de type photographique sur laquelle on enregistre une suite d’images à l’aide d’un appareil photo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ab8510-c589-4215-a9bb-a3d5399b047b",
                                                "sense_id": "542c7266-f4be-3f43-bf4b-126d1be91a95",
                                                "text": "Bizarrement, la mode des séances de spiritisme avec déplacements de lourdes tables et apparitions et matérialisations « d’ectoplasmes » perdit beaucoup de sa popularité à peu près à la même époque où la compagnie Kodak mis sur le marché son premier film sensible aux rayons infrarouges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b780618-1bc8-3440-b17e-1953c138a7d3",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "Pellicule cinématographique sur laquelle on enregistre une suite d’images constituant un récit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe01427-3653-42b9-9366-744485a29998",
                                                "sense_id": "6b780618-1bc8-3440-b17e-1953c138a7d3",
                                                "text": "Tourner un film."
                                            },
                                            {
                                                "example_id": "21966452-adf0-46aa-a316-6d8609464619",
                                                "sense_id": "6b780618-1bc8-3440-b17e-1953c138a7d3",
                                                "text": "Film sonore."
                                            },
                                            {
                                                "example_id": "ce0dcdad-803a-41fb-8b8a-57a3550b0cec",
                                                "sense_id": "6b780618-1bc8-3440-b17e-1953c138a7d3",
                                                "text": "Film parlant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "L’œuvre elle-même."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6470d7-c099-4375-ab3d-7ce0070a6443",
                                                "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                                "text": "[…] je décidai de passer l'après midi avec eux, d'étudier leurs méthodes de plonge et de prendre plusieurs films."
                                            },
                                            {
                                                "example_id": "35dc507a-fe57-4f5d-87de-c5f7c0488fa7",
                                                "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                                "text": "À vrai dire, elle avait tourné quelques autres films à Hollywood après avoir participé aux ultimes tentatives avortées de Castle, mais c'étaient des nanars de série B. Pour elle, ces fragments étaient son dernier travail « sérieux »."
                                            },
                                            {
                                                "example_id": "844421a5-3394-4396-b10f-1836dc1f3d48",
                                                "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                                "text": "Ce film musical nous baigne dans les années soixante-dix avec tout ce qu'il y a de plus kitch ; mais comme souvent, certains films comme celui-ci, qualifiés de « nanards » par les critiques, deviennent incontournables après leur sortie."
                                            },
                                            {
                                                "example_id": "cf861b32-9301-4d9a-b304-2b7c44d66257",
                                                "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                                "text": "Si une image vaut mille mots et qu'un film est composé de plusieurs centaines de milliers d'images, le film devient le meilleur outil pour transférer pleinement au spectateur l'idée que le cinéaste veut véhiculer."
                                            },
                                            {
                                                "example_id": "4a3636c4-6fe5-4b9c-ab1c-d34a67eaf903",
                                                "sense_id": "f1106152-1de6-3a56-b142-893660860dba",
                                                "text": "Un film n’a pas besoin d’avoir trois tonnes d’action pour être réussi. Regardez L’Empire contre-attaque : C’est un des volets de la saga Star Wars qui possède le moins d’action. Et pourtant c’est le plus réussi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7687678e-770f-31b2-aeec-998f84dfa072",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "Industrie du cinéma."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135bb5ad-dc87-456a-b8ee-b095279abda3",
                                                "sense_id": "7687678e-770f-31b2-aeec-998f84dfa072",
                                                "text": "Le film français ne se porte pas bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d30732db-28f6-32de-871a-7139e763bcb6",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "Fine pellicule de plastique transparente destinée à l’emballage d’un objet dont elle épouse la forme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a09254f-2803-3638-a083-c239b8f3ef5c",
                                        "entry_id": "d738e9fd-0c27-3fb2-994d-c9c27198f2db",
                                        "glosses": [
                                            "Fine pellicule de plastique transparente destinée à l’emballage d’un objet dont elle épouse la forme.",
                                            "Pellicule de plastique transparente et adhérente utilisée pour la protection des aliments."
                                        ],
                                        "tags": [
