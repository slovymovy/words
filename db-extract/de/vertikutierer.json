                    }
                ],
                "senses": [
                    {
                        "sense_id": "21a374c2-9f89-33f1-a608-f1b7936c6c50",
                        "entry_id": "c886ccc0-d590-3f18-b56f-570871bc8a7f",
                        "glosses": [
                            "Gerät zum Aufreißen der Grasnarbe einer Rasenfläche, um den Boden zu lockern und Mulch und Moos zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c1fd74-f83f-47f4-9e85-4260415d152d",
                                "sense_id": "21a374c2-9f89-33f1-a608-f1b7936c6c50",
                                "text": "Ein Vertikutierer sorgt für einen gepflegten und gesunden Rasen, weil nach der Pflege Regen und Nährstoffe besser in den Boden eindringen können."
                            },
                            {
                                "example_id": "903a191d-70a5-4c9c-940c-312732e50053",
                                "sense_id": "21a374c2-9f89-33f1-a608-f1b7936c6c50",
                                "text": "„Der struppige Rasen verlangt nach dem Vertikutierer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0b57a47-d328-491d-a3b1-5bb30e9614db",
                        "source_entry_id": "c886ccc0-d590-3f18-b56f-570871bc8a7f",
                        "source_sense_id": "21a374c2-9f89-33f1-a608-f1b7936c6c50",
                        "target_lang_word": "dethatcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dethatcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c88a31-360e-38da-abda-f1656efdf855",
                                        "entry_id": "1a590db5-4c1e-3576-b353-4a197e0a8d28",
                                        "glosses": [
                                            "A device for dethatching, similar to a lawnmower but with vertical rotating blades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12aea1cf-4796-4488-aaac-0576eb210755",
                                                "sense_id": "00c88a31-360e-38da-abda-f1656efdf855",
                                                "text": "You can also rent a power dethatcher from a tool rental company. Have them teach you how to start and run the dethatcher; most are operated much like a lawn mower."
                                            },
                                            {
                                                "example_id": "1a54fc43-5533-4d4c-81d6-ca4a733c6517",
                                                "sense_id": "00c88a31-360e-38da-abda-f1656efdf855",
                                                "text": "The dethatcher has blades that cut perpendicular to the lawn, thereby removing the dead debris called thatch, which can easily build up in a lawn."
                                            },
                                            {
                                                "example_id": "4bcd88fc-4ab2-444e-9608-ed9ad55062cb",
                                                "sense_id": "00c88a31-360e-38da-abda-f1656efdf855",
                                                "text": "While you can remove thatch from small areas with a metal garden rake or hand cultivator, you ought to rent a dethatcher for working over large areas of grass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6af7ff31-232b-4a45-b987-0e9a0ce7c682",
                        "source_entry_id": "c886ccc0-d590-3f18-b56f-570871bc8a7f",
