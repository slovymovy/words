                                "target_senses": [
                                    {
                                        "sense_id": "78f1b5a1-fa03-384b-8608-b11e0a3bdc0c",
                                        "entry_id": "4550f41b-f494-3280-94fd-d99a95d47301",
                                        "glosses": [
                                            "der entgeltliche Erwerb einer Ware"
