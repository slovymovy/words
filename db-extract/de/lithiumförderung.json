                                "example_id": "976785da-3a94-4550-a4a4-9077f6d6ab1d",
                                "sense_id": "44f46043-f9c3-3c1c-a581-1772b86c7b2a",
                                "text": "„Er arbeitet für die Universität Buenos Aires, forscht seit Jahren zu den Folgen der Lithiumförderung in Argentinien.“"
                            },
