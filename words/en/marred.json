                                "de": "Das <w>verwöhnte</w> Kind bekam einen Wutanfall, als es seinen Willen nicht durchsetzen konnte."
                            }
                        },
                        {
                            "text": "She grew up as a <w>marred</w> youth who never learned to handle disappointment.",
                            "target_lang_translations": {
                                "nl": "Ze groeide op als een <w>vertroetelde</w> jongere die nooit leerde omgaan met teleurstelling.",
                                "de": "Sie wuchs als eine <w>verhätschelte</w> Jugendliche auf, die nie lernte, mit Enttäuschungen umzugehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoiled",
                        "pampered"
                    ],
                    "target_lang_definitions": {
