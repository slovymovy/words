                ],
                "senses": [
                    {
                        "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                        "entry_id": "c518dad9-d816-3caa-b031-75191800b25b",
                        "glosses": [
                            "ein schmales elastisches Band"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90037717-d1ab-4d36-a345-9c53eaa709ce",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„Den Umfang des Babybauches messen und die Gummilitze in passender Länge zurechtschneiden.“"
                            },
                            {
                                "example_id": "c33ccdc7-0af1-4d51-96dd-fc91150cc52f",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„Und außerdem solltest du dem Jungen nachts lieber Gummilitze um den Kopf binden, das würde nicht so weh tun, nicht wahr, Louis?“"
                            },
                            {
                                "example_id": "5364b832-041e-487c-ad34-a65cd75bf58e",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„Der Prototyp dieser »Sputniks« war eine kleine Bombe, die mit der Gummilitze einer Harpune abgeschossen wurde.“"
                            },
                            {
                                "example_id": "be6cdb73-2635-4f95-a3cd-aa1665b34811",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„[Der TÜV-Sachverständige Michael Krah:] ‚Dabei wird der Zustand der bis zu 1000 einzelnen Gummilitzen des Seils überprüft.‘“"
                            },
                            {
                                "example_id": "cc1c14c0-e8b3-407e-87b1-a58f0eea8b0e",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„Eisenstreben hängen wie geknickte Streichhölzer aus der Fassade, Schläuche, Rohre, Gummilitzen baumeln im Wind, der einen kalten Regen vor sich her treibt: […]“"
                            },
                            {
                                "example_id": "0de20014-47a4-4e96-ad90-fb0bbb7168f4",
                                "sense_id": "853d7707-261c-3054-a259-10c01dfd6a0d",
                                "text": "„Raumeingriffe, die allerdings nun – mit schwarzer Gummilitze und formal unauffälligeren Ankern – mehr wie Liniengeflechte im Raum wirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
