                        "examples": [
                            {
                                "example_id": "eb2b6034-9aaf-4d87-b4bc-97bab4469f37",
                                "sense_id": "6fd61054-139a-3f0d-b1bc-466bf4e55dec",
                                "text": "Dat geldt al voor een simpel vignet: ingeperkt door de rand van het doek of het papier, of als kersenbloesem zwevend op een Japanse prent."
                            },
                            {
                                "example_id": "67feee06-ba53-4d11-9b8e-ba7b67ef7262",
                                "sense_id": "6fd61054-139a-3f0d-b1bc-466bf4e55dec",
                                "text": "Japan schenkt 250 kersenbloesems aan de Verenigde Staten, ter ere van de 250ste verjaardag van het land. Die zullen zo’n 150 kerselaars vervangen rond het getijdenbekken van Washington DC, waar herstellingen nodig zijn aan de afbrokkelende zeewering. De Japanse premier Fumio Kishida kondigde de gift woensdag aan tijdens een staatsbezoek. Tijdens een ontvangstceremonie op het Witte Huis reageerde ook de Amerikaanse president Joe Biden: “Net als onze vriendschap zijn deze bomen tijdloos, inspirerend en bloeiend”."
                            }
                        ]
