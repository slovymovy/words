                "entry_id": "b2d2cf0c-25fe-3bf6-9c90-77700290a6e6",
                "word": "lightfast",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "792a95a3-6acd-4a11-b8ff-72032bc3baf3",
