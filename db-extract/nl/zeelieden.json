        "nl-extract.jsonl": [
            {
                "entry_id": "9ad95b93-4e63-322f-a798-6373c97dcb9b",
                "word": "zeelieden",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5027cd3-254c-3b7c-b9e6-0f7e98d87de5",
                        "entry_id": "9ad95b93-4e63-322f-a798-6373c97dcb9b",
                        "glosses": [
                            "een groep van personen die voor hun beroep de zee bevaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efea89c2-ac0a-4395-a9ca-bdc674e5747c",
                                "sense_id": "c5027cd3-254c-3b7c-b9e6-0f7e98d87de5",
                                "text": "De zeelieden hadden de zeilen gehesen."
                            },
                            {
                                "example_id": "0a518603-de1e-44ea-878a-e46c9d586cd4",
                                "sense_id": "c5027cd3-254c-3b7c-b9e6-0f7e98d87de5",
                                "text": "Bari, een machtige havenstad, riep hem al gauw uit tot 'redder op zee'. En de Noormannen, die Bari in bezit hadden, brachten hun verering voor de 'schutspatroon aller zeelieden' over naar Noord-Europa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf321240-556d-484c-9980-4becb504e9c2",
                        "source_entry_id": "9ad95b93-4e63-322f-a798-6373c97dcb9b",
                        "source_sense_id": "c5027cd3-254c-3b7c-b9e6-0f7e98d87de5",
                        "source_sense_description": "een groep van personen die voor hun beroep de zee bevaren",
                        "target_lang_word": "Seeleute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeleute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb22b89-1d00-331a-bd36-ac9d8815655e",
                                        "entry_id": "a8019681-4dfe-30a6-a759-e64c9249dfad",
                                        "glosses": [
                                            "Ersatzplural von Seemann, Seemännin und Seefrau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13613474-9fe7-4e21-9f4d-bf9253d0c68a",
                                                "sense_id": "ceb22b89-1d00-331a-bd36-ac9d8815655e",
                                                "text": "„Unter den vielen Schiffen, die sie regelmäßig in Liverpool antrafen, waren einige, deren Besatzung aus Seeleuten aliierter Nationen bestand.“"
                                            },
                                            {
                                                "example_id": "df3d4aba-e3ed-4866-8e6b-da742ce156a9",
                                                "sense_id": "ceb22b89-1d00-331a-bd36-ac9d8815655e",
                                                "text": "„Aus der Entfernung beobachteten die Enmyner und auch die Seeleute, die sich ein Stück zurückgezogen hatten, das Wiedersehen.“"
                                            },
                                            {
                                                "example_id": "54a53fd6-3c53-4fb3-844d-ebbeb89a2763",
                                                "sense_id": "ceb22b89-1d00-331a-bd36-ac9d8815655e",
                                                "text": "„Die Reaktionen, die durch die filmische Darstellung der mordenden Seemänner ausgelöst werden, faßt ein griechischer Schiffsingenieur zusammen: ›Das waren keine Seeleute, sondern Mörder‹ und ›stowaways are human beings‹ – ›Blinde Passagiere sind Menschen‹.“"
                                            },
                                            {
                                                "example_id": "d13fd6af-585b-44a9-bd15-542439c37d2c",
                                                "sense_id": "ceb22b89-1d00-331a-bd36-ac9d8815655e",
                                                "text": "„Das kommt daher, daß es lauter Seeleute waren, die auf allen Wassern herumfuhren, bis sie an den Klippen von Djal scheiterten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
