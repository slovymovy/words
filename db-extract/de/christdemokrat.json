                    {
                        "sense_id": "da73435d-8b8c-3282-b763-a43ba77c3c33",
                        "entry_id": "f53478f8-16c5-300a-bbfb-d52cda4310c5",
                        "glosses": [
                            "Anhänger der Christdemokratie, Anhänger oder Mitglied einer christdemokratischen Partei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a930681-3797-428b-a61c-ebcd5004cdc3",
                                "sense_id": "da73435d-8b8c-3282-b763-a43ba77c3c33",
                                "text": "Die Christdemokraten fordern baldige Steuererleichterungen für Mittelständler."
                            },
                            {
                                "example_id": "caaebefd-ae96-466b-8f03-1d238e7e3a9f",
                                "sense_id": "da73435d-8b8c-3282-b763-a43ba77c3c33",
                                "text": "Er ist seit Jahren überzeugter Christdemokrat."
                            },
                            {
                                "example_id": "e174f5f3-dac6-4928-9b15-c029a32d5901",
                                "sense_id": "da73435d-8b8c-3282-b763-a43ba77c3c33",
                                "text": "„Allende war mit den Stimmen der Christdemokraten zum Präsidenten gewählt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
