                "senses": [
                    {
                        "sense_id": "4a27bfaa-743e-33a4-8ea2-a8e35e662ff3",
                        "entry_id": "a5ffe472-8f2f-3158-b9b0-bcb9a95e4c7a",
                        "glosses": [
                            "разг. закончить строчить (быстро и торопливо писать); дописать строку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d192f02c-ad15-496e-ba44-d939843c76d2",
                                "sense_id": "4a27bfaa-743e-33a4-8ea2-a8e35e662ff3",
                                "text": "Полковник Вигланд в английской шинели, имевшей на нем вид халата, сидевший в углу и безостановочно строчивший по-английски свой дневник, преждевременно седой, дурно подстриженный, быстро дострочил начатую фразу и спрятал заветную тетрадку глубоко под шинель."
                            }
                        ]
                    }
