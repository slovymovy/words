                                                "example_id": "56f6729d-9aac-4f4d-ac62-082ee58614a6",
                                                "sense_id": "90d68113-ca4a-3070-a787-832154309a14",
                                                "text": "„In Karlsruhe wurde am Mittwoch ein 47-jähriger Gerichtsvollzieher bei einer Zwangsräumung erschossen.“"
                                            },
