                "senses": [
                    {
                        "sense_id": "bba3eb69-6b5d-3585-a45c-60ca46ce5d6d",
                        "entry_id": "46746c2f-aaaf-3f21-a4f0-77109172a3fd",
                        "glosses": [
                            "eine in Zeilen und Spalten strukturierte Tabelle einer relationalen Datenbank"
                        ],
                        "tags": [
                            "EDV",
                            "relationale Datenbanken"
                        ],
                        "examples": [
                            {
                                "example_id": "366e19a3-8313-413c-8d98-ea057da886c8",
                                "sense_id": "bba3eb69-6b5d-3585-a45c-60ca46ce5d6d",
                                "text": "„Eine Datenbanktabelle kann sogenannte Primärschlüssel enthalten, die aus einem oder mehreren Attributen bestehen.“"
                            },
                            {
                                "example_id": "e32ee8d0-fb2f-4b75-8887-5d6fad18341f",
                                "sense_id": "bba3eb69-6b5d-3585-a45c-60ca46ce5d6d",
                                "text": "„Sollten Sie in Erfahrung bringen wollen, wie viele Datenbanktabellen innerhalb einer Datenbank vorhanden sind, können Sie folgendes Skript einsetzen, um eine entsprechende Auflistung zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
