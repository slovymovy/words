                    {
                        "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                        "entry_id": "495146ce-4430-3e4b-a6ed-bd64faa98e0c",
                        "glosses": [
                            "Qui est dans l’inaction ou l’inactivité, oisif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d724b783-47dd-4d8f-a8f8-1ad69ba61dcf",
                                "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                                "text": "C’est l’homme du monde le plus inactif."
                            },
                            {
                                "example_id": "cad406f8-d96f-4dd0-b84d-c2967937367b",
                                "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                                "text": "Rester inactif."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                        "entry_id": "495146ce-4430-3e4b-a6ed-bd64faa98e0c",
                        "glosses": [
                            "Qualifie une chose qui n’a pas d’effet, inefficace."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0e222077-f35e-4984-b670-520a251f8d02",
                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                "text": "Remède inactif."
                            },
                            {
                                "example_id": "9153257d-2a20-42bd-a630-86c6ba9ef543",
                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                "text": "Moyen inactif."
                            },
                            {
                                "example_id": "3c0d7e93-995d-4f50-a3ea-770892423ceb",
                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                "text": "Il ne faut jamais laisser l’argent inactif. Il en meurt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
