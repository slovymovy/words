                "translations": [
                    {
                        "translation_id": "cd6a0c50-91be-4d08-8656-4739a9c6b19a",
                        "source_entry_id": "4df8e29b-ee1a-371c-88c2-7415812646cf",
                        "source_sense_id": "8977cf94-f7c5-3514-ad88-0e8e6275ffdd",
                        "source_sense_description": "historisch, Militär: Infanterist, der mit einer Hellebarde bewaffnet ist",
                        "target_lang_word": "halberdier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halberdier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b69516dc-19ff-3434-85cd-59cb4dd2df4c",
                                        "entry_id": "3f058959-3de2-31b8-82df-2698b41597ba",
                                        "glosses": [
                                            "A soldier armed with a halberd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770ddc3b-a03c-46c7-ac65-78e5431091f8",
                                                "sense_id": "b69516dc-19ff-3434-85cd-59cb4dd2df4c",
                                                "text": "Jones did not think fit to acquaint the serjeant with his design; though he might have done it with great safety, for the halberdier was himself a man of honour, and had killed his man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f60bd037-3e86-44da-afee-42d7d970e802",
                        "source_entry_id": "4df8e29b-ee1a-371c-88c2-7415812646cf",
                        "source_sense_id": "8977cf94-f7c5-3514-ad88-0e8e6275ffdd",
                        "source_sense_description": "historisch, Militär: Infanterist, der mit einer Hellebarde bewaffnet ist",
                        "target_lang_word": "hallebardier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallebardier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7a0c2d-4d33-3d3b-803f-178ede3a6196",
                                        "entry_id": "788281f6-5645-30d2-bbf2-d20031d114e3",
                                        "glosses": [
                                            "Soldat portant la hallebarde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8685233b-ad2e-42cd-b7ef-c1e83b93d0e5",
                                                "sense_id": "1c7a0c2d-4d33-3d3b-803f-178ede3a6196",
                                                "text": "Quant à la procession en elle-même, outre le personnel d’un nombreux clergé, prêtres, chantres, porte-châsses, porte-bannières, etc., elle s’avançait précédée de deux tambours, avec une escorte de six hallebardiers et douze porte-torches."
                                            },
                                            {
                                                "example_id": "b4486e79-f5e9-4781-aa2c-856120b18440",
                                                "sense_id": "1c7a0c2d-4d33-3d3b-803f-178ede3a6196",
                                                "text": "Jamais je n’arriverai jusqu’à elle, se dit Marguerite après avoir fait près des hallebardiers trois tentatives inutiles."
                                            },
                                            {
                                                "example_id": "ff75750d-edc6-4fae-8371-24fd88f8512c",
                                                "sense_id": "1c7a0c2d-4d33-3d3b-803f-178ede3a6196",
                                                "text": "Mais dans les régions que des reliefs du sol rendaient mal praticables, […] le hallebardier, l’homme d’épée pour le combat corps à corps, l’archer même purent affirmer leur supériorité […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
