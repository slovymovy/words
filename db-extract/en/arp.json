        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d1c3429b-e5c9-3bcb-ad80-99c344891273",
                "word": "arp",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d31e58a-2f21-3618-907b-d0e934809165",
                        "entry_id": "d1c3429b-e5c9-3bcb-ad80-99c344891273",
                        "glosses": [
                            "The bark of a seal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901edeb3-80fe-4c9f-a85e-be49d0c77b1a",
                                "sense_id": "2d31e58a-2f21-3618-907b-d0e934809165",
                                "text": "All through the prayer he made little arp! arp! noises like a baby seal."
                            },
                            {
                                "example_id": "9f3c010d-c05a-4590-aa5b-2743ee9f8e56",
                                "sense_id": "2d31e58a-2f21-3618-907b-d0e934809165",
                                "text": "\"ARP, ARP, ARP.\" George turned and saw the seal waddling down their side of the river."
                            },
                            {
                                "example_id": "637c94da-86c3-4696-8397-cf69e5c9ebe3",
                                "sense_id": "2d31e58a-2f21-3618-907b-d0e934809165",
                                "text": "Usually when I speak about arp [address resolution protocol], at least one person in the audience acts like a seal and shouts, \"Arp, arp, arp!\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
