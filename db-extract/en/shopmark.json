                        "glosses": [
                            "A logo indicating the workshop from which a product originated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7791173-fd28-481e-95e2-a24fed8f22fa",
                                "sense_id": "6f8c2e26-fc18-3beb-9ddf-bfe7c51d7a1e",
                                "text": "In 1910 they issued a catalog under a new name: \"L. & J.G. Stickley Handcraft,\" with a shopmark in red that could easily be confused with their older brother's red joiner's compass shopmark."
                            },
                            {
                                "example_id": "766665a8-4694-4a4a-84f5-711ccf77c187",
                                "sense_id": "6f8c2e26-fc18-3beb-9ddf-bfe7c51d7a1e",
                                "text": "Apparently Stickley was very fond of this symbol; he used it in various forms as a shopmark on his furniture and as a signature on drawings throughout his career."
                            }
                        ]
                    }
