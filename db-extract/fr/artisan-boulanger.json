                        "glosses": [
                            "Boulanger qui exerce son métier de façon artisanale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8cf8881-0609-4f94-afe8-35e053bc5944",
                                "sense_id": "689b1c7b-9ab8-367e-89e4-dfed6d72719f",
                                "text": "Pour pallier cette fermeture privant les Taulésiens de pain frais chaque matin pendant quelques semaines, le couple a décidé de proposer un dépôt de pain au sein de son établissement, en collaboration avec un artisan-boulanger du Léon, à partir de ce lundi, « et ce jusqu’à l’arrivée des nouveaux boulangers et la réouverture du commerce, courant septembre », précise Patrick Le Carré."
                            },
                            {
                                "example_id": "105132ae-5794-484f-ac10-c0f2e9d1d530",
                                "sense_id": "689b1c7b-9ab8-367e-89e4-dfed6d72719f",
                                "text": "Malheureusement il ne pouvait s’appuyer sur les arguments scientifiques dont on dispose maintenant, et il avait contre lui les artisans-boulangers pour qui le recours à la levure était perçu comme une délivrance."
                            },
                            {
                                "example_id": "b92d3bf8-90e5-4e02-8046-1a1986f079d3",
                                "sense_id": "689b1c7b-9ab8-367e-89e4-dfed6d72719f",
                                "text": "Mais les artisans-boulangers locaux ne s’approvisionnent pas en blé local."
                            }
                        ]
                    }
