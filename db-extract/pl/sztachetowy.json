                        "examples": [
                            {
                                "example_id": "d1430aad-3446-43ac-9005-dc6f6883406d",
                                "sense_id": "b5a63754-3f86-3aa3-ab43-ab087bd9f087",
                                "text": "Istnieją płoty, zwane wiklinowymi, chruścianymi, torowymi, plecionymi, tynowymi (wyplatane pionowo, poziomo lub ukośnie), różnego rodzaju płoty koszowe, żerdziowe, dylowane, sztachetowe częstokoły, a ostatnio także płoty z drutu."
                            }
                        ],
