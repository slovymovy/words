                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supernatural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horror movie depicts a terrifying case of demonic <w>possession</w>.",
                            "target_lang_translations": {
