                "senses": [
                    {
                        "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                        "entry_id": "a6f2098f-062c-34a3-a9ae-c4335161b958",
                        "glosses": [
                            "Werkzeug für kultiviertes Essen, Einwegbesteck aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304b5a75-6c4c-44db-b925-ea53f3ee3b59",
                                "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                                "text": "„Plastikbesteck wird schon seit Anfang des 20. Jahrhunderts hergestellt. Damals war die Herstellung noch teuer und schwierig und das Plastikbesteck wurde vorwiegend in Fabriken in Frankreich und England gefertigt.“"
                            },
                            {
                                "example_id": "c651db21-5e6c-4edb-b991-fdb4fdd771d2",
                                "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                                "text": "„Plastikbesteck ist nicht nur beim Picknick oder bei ausschweifenden Partys äußerst praktisch, sondern lässt sich auch für selbstgebastelte Dekoideen verwenden.“"
                            },
                            {
                                "example_id": "c9d8878f-0eac-4910-9ea9-22193278620a",
                                "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                                "text": "„Wenn der Test erfolgreich verlaufe, solle auch zwischen Bangkok und Peking bald mit Plastikbesteck gegessen werden.“"
                            },
                            {
                                "example_id": "20525db9-a5cf-44cf-b181-823353a7501f",
                                "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                                "text": "„Das Sortiment an klassischem Einweggeschirr bietet dem professionellen Anwender neben dem Plastikbesteck (Messer, Gabel, Löffel) auch Pappteller in vielen, verschiedenen Größen und Formen (eckig, rund etc.) an und eignet sich somit insbesondere für die Schnellgastronomie.“"
                            },
                            {
                                "example_id": "395f542f-bde3-4290-a919-c5377c74ba80",
                                "sense_id": "7c0e8cf4-7994-32f3-a70e-d3d3df5e1180",
                                "text": "„Pappteller und Plastikbesteck sind zwar leicht und gut zu transportieren, aber sie füllen Säcke von Müll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
