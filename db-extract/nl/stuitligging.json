                "senses": [
                    {
                        "sense_id": "48f7467f-8cfa-383b-b4f7-76a0303d07b9",
                        "entry_id": "679838ab-9ae3-3f65-bf3d-d24b2c0c3c21",
                        "glosses": [
                            "een liggingsafwijking bij een zwangerschap waarbij de foetus met de stuit naar beneden ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ed102a-3231-4ce0-85ab-790680bc0283",
                                "sense_id": "48f7467f-8cfa-383b-b4f7-76a0303d07b9",
                                "text": "De vroedvrouw vertelde donderdag nogmaals waarom zij de vier vrouwen om wie het in deze zaak draaide, thuis begeleidde bij hun bevalling, ondanks het verhoogde risico. Het ging om tweelingen of stuitliggingen, bevallingen die normaal gesproken in het ziekenhuis moeten gebeuren. Maar deze vrouwen hadden een conflict met het ziekenhuis, of geen vertrouwen in de gynaecoloog."
                            },
                            {
                                "example_id": "3857ac70-a670-4c8d-a80e-99884034b7ea",
                                "sense_id": "48f7467f-8cfa-383b-b4f7-76a0303d07b9",
                                "text": "Bovendien lag haar zoontje eerst in stuitligging, maar bleek deze te zijn gedraaid na een pijnlijke behandeling die Kim onderging in het Thanksgiving-weekend."
                            }
                        ]
                    }
                ],
