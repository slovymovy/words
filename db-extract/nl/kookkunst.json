                "senses": [
                    {
                        "sense_id": "fc27ebdb-a032-3f62-ae99-4f5055917e5c",
                        "entry_id": "80e5781f-211d-3f59-a28e-8d383dd0af48",
                        "glosses": [
                            "de kunst van het door middel van koken voor consumptie geschikt maken van voedsel"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44ff7445-3d19-45e0-88d9-1bb57b78e143",
                        "source_entry_id": "80e5781f-211d-3f59-a28e-8d383dd0af48",
                        "source_sense_id": "fc27ebdb-a032-3f62-ae99-4f5055917e5c",
                        "target_lang_word": "Kochkunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochkunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                        "entry_id": "bf42035f-3420-3d7a-ba95-8760f0909ab1",
                                        "glosses": [
                                            "die Kunst, das Handwerk der Speisenzubereitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2070f989-168d-4b7b-9d87-af26522c6690",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "Er beherrscht die Kochkunst aus dem Effeff."
                                            },
                                            {
                                                "example_id": "c2346594-c75d-44c9-b53d-4eb73bd6ef76",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "Die Kochkunst der Franzosen ist legendär."
                                            },
                                            {
                                                "example_id": "e64182ad-3bec-4c32-a0a7-1beaddbcc8c0",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "„Die Kochkunst der französischen Hofküche übte ebenfalls einen großen Einfluss sowohl auf die Auswahl der Speisen in den Küchen der deutschen Fürstenhöfe als auch auf die Bezeichnungen der Gerichte selbst und sogar auf die zur Zubereitung benötigten Küchengeräte aus.“"
                                            },
                                            {
                                                "example_id": "53b22c3b-e5b0-4e86-bb28-0844dd3eac26",
                                                "sense_id": "4bd321c2-f548-3aca-8077-f5ba40158d46",
                                                "text": "„Der älteste Sohn wird Anfang des neuen Jahrhunderts jene Konservierungsmethode entdecken, die dann die Kochkunst revolutioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                        "entry_id": "bf42035f-3420-3d7a-ba95-8760f0909ab1",
                                        "glosses": [
                                            "die Fähigkeit einer Person, schmackhafte und optisch ansprechende Speisen zuzubereiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57919d07-f716-45ef-854b-1d5766af254b",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "Meine Kochkünste sind eher mittelmäßig."
                                            },
                                            {
                                                "example_id": "11814945-33cb-4239-b774-5267a822ea63",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Ama leckte sich die Suppe von den Fingern und gestand, dass Mama Eko mit ihrem Lob auf die Kochkünste des Hausmädchens nicht übertrieben hatte.“"
                                            },
                                            {
                                                "example_id": "2304c9c9-c2a4-4924-9c92-564e0a394369",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Alle loben den Mann für seine Kochkünste.“"
                                            },
                                            {
                                                "example_id": "4ba4ad1b-c479-48f9-aa4b-4fea83c8739f",
                                                "sense_id": "ba7ac9de-cf27-3484-b95b-0f3cc2d57c1d",
                                                "text": "„Mit deinen Kochkünsten könntest du wahrscheinlich die Welt verändern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f29b158d-b831-40cc-ac58-7075a72cd3e3",
                        "source_entry_id": "80e5781f-211d-3f59-a28e-8d383dd0af48",
                        "source_sense_id": "fc27ebdb-a032-3f62-ae99-4f5055917e5c",
                        "target_lang_word": "cookery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cookery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                                        "glosses": [
                                            "The art and practice of preparing food for consumption, especially by the application of heat; cooking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe23a67-671a-4350-8fb0-f6ea4fbf83a2",
                                                "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                                                "text": "Henry was not very good at cookery and most of his meals ended up burned."
                                            },
                                            {
                                                "example_id": "1eae3864-7592-49fc-a39f-413a2df798d2",
                                                "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                                                "text": "together with excellent directions for cookery, as also for preserving, conserving, candying, &c."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35064240-6717-3b67-b805-58956a471eb9",
                                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                                        "glosses": [
                                            "A delicacy; a dainty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fec1d90-b4da-45de-a946-cc5fab479736",
                                                "sense_id": "35064240-6717-3b67-b805-58956a471eb9",
                                                "text": "I've got a bit of cookery that will astonish him — my marinated pheasants' poults a la braise imperiale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                                        "glosses": [
                                            "Cooking tools or apparatus."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecdd65cc-2577-4990-ad0d-101e2e4397ad",
                                                "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                                                "text": "She directed the servants, inspected both the cookery and arrangements of the table, held council with an old steward..."
                                            },
                                            {
                                                "example_id": "ce71348d-0b52-444c-8c9b-ffce3e4f355b",
                                                "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                                                "text": "...and would not be just dead weight, as on the trail it could conveniently be filled with the cookery and other odds and ends..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bbe826-8f4a-3efa-8b97-533e028a7f0d",
                                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                                        "glosses": [
                                            "A place where cooking is done."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2511011-3add-4441-87d7-43dc600636f2",
                                                "sense_id": "70bbe826-8f4a-3efa-8b97-533e028a7f0d",
                                                "text": "Mr. Weller produced upon the little dining-table, a roast leg of mutton and an enormous meat-pie, with sundry dishes of vegetables, and pots of porter, which stood upon the chairs or the sofa bedstead, or where they could, everybody felt disposed to do justice to the meal, notwithstanding that the meat had been purchased, and dressed, and the pie made, and baked, at the prison cookery hard by."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cookery",
                                "target_lang_code": "en",
                                "target_senses": [
