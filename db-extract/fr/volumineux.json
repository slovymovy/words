                    },
                    {
                        "translation_id": "9621855b-4eef-4c68-9f0e-c3e4665cd05a",
                        "source_entry_id": "96ecc2e8-653f-3f65-b503-c03d069906c7",
                        "target_lang_word": "sperrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sperrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb55cb69-096a-3725-bf46-f0981e992996",
                                        "entry_id": "d15845bf-e567-3d06-bc71-dab83957a3a2",
                                        "glosses": [
                                            "viel Platz einnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5139ecd-a8ca-40c0-98b3-72422bf52a65",
                                                "sense_id": "fb55cb69-096a-3725-bf46-f0981e992996",
                                                "text": "Wie sollen wir diesen sperrigen Schrank transportieren?"
                                            },
                                            {
                                                "example_id": "c3efcec5-7b91-461f-948e-9d9aef50e702",
                                                "sense_id": "fb55cb69-096a-3725-bf46-f0981e992996",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a573ba4-363b-4515-9e12-9b190020aaf1",
                        "source_entry_id": "96ecc2e8-653f-3f65-b503-c03d069906c7",
                        "target_lang_word": "umfangreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umfangreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44b7e291-45db-3a4c-9119-2035d71c4577",
                                        "entry_id": "061fa0eb-ccf9-3a29-b8bc-03d3074c2ff2",
                                        "glosses": [
                                            "sehr viel umfassend, großen Umfang habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dbe828c-4728-4a08-b45f-2478b0b3ff5b",
                                                "sense_id": "44b7e291-45db-3a4c-9119-2035d71c4577",
                                                "text": "Am Montag beginnen umfangreiche Arbeiten an der Autobahnbrücke."
                                            },
                                            {
                                                "example_id": "49e1321d-2d4f-4ad3-8d7b-385e2da6fa1f",
                                                "sense_id": "44b7e291-45db-3a4c-9119-2035d71c4577",
                                                "text": "„Die Korruptionsjäger haben umfangreich geprüft, ob Straches öffentlich einsehbare Aussagen auf Ibiza strafbar waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ac526ef-b554-49ee-847b-380d2790d5ad",
                        "source_entry_id": "96ecc2e8-653f-3f65-b503-c03d069906c7",
                        "target_lang_word": "voluminös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voluminös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                        "entry_id": "742db393-bdde-3b0a-9a03-5ea1b9190343",
                                        "glosses": [
                                            "mit Masse und mit deutlichem Umfang (Volumen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2f9cf8-72f3-46b7-a28a-a38b250e4802",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Die anfängliche Sorge, durch den voluminösen Wasserstofftank werde das Rad unhandlicher, bestätigt sich nicht.“"
                                            },
                                            {
                                                "example_id": "1bd64762-c0c2-4dbd-b5a4-bb0ba7f8c1e0",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Sie ist Mitte dreißig, mittelgroß, misst etwa Einmeterundsiebzig, trägt ihr dunkelblondes Haar lang und offen, durch Dauerwelle voluminös aufgebauscht, eine richtige Löwenmähne.“"
                                            },
                                            {
                                                "example_id": "ac5c6968-55e0-4b6b-b4a5-c3c5e335430a",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "Das Pferd bekommt zur Zeit nahrhaftes, aber wenig voluminöses Futter."
                                            },
                                            {
                                                "example_id": "44c37b85-d8af-46bf-9470-b0b3b7f93d5f",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "Ihr voluminöser Leib passte gerade so in den einzigen Sessel des Wartezimmers."
                                            },
                                            {
                                                "example_id": "9ccac227-266b-49d2-957c-54e6d592eaf3",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Plötzlich war die Wolke da — schwarz, haushoch und voluminöser als alles, was ich bisher gesehen habe — und schon zu nah, um ihr noch entkommen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
