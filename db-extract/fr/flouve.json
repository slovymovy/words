                "word": "flouve",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4446e732-67a2-4845-9006-d617c2b5ed02",
                        "entry_id": "cc6e8722-00bd-3c3f-9af5-2b4c1ca0d071",
