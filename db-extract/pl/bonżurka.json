                                "target_senses": [
                                    {
                                        "sense_id": "b116f845-2adb-32ad-86ee-b33ef8b92fbc",
                                        "entry_id": "91cd9a22-d5d5-37c8-8027-861970c9a81a",
                                        "glosses": [
                                            "A men's jacket designed to be worn while smoking tobacco, typically made of soft fabric with a tie belt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2371b50b-ca95-4d5e-a2b9-4fc8f2e7c7ed",
                                                "sense_id": "b116f845-2adb-32ad-86ee-b33ef8b92fbc",
                                                "text": "In a desperate attempt to impress Laura, Bart begins bathing and sashaying about in a smoking jacket while sucking thoughtfully on a bubble pipe as part of his new pint-sized Hef persona."
                                            },
                                            {
                                                "example_id": "abb1971d-3dd1-4f1c-ad1e-e736945406ae",
                                                "sense_id": "b116f845-2adb-32ad-86ee-b33ef8b92fbc",
                                                "text": "A tall, thin man with silver hair and black-rimmed glasses stepped into the lobby. His quilted smoking jacket made him look a little like Hugh Hefner's less decrepit brother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
