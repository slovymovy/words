                "senses": [
                    {
                        "sense_id": "dfadd403-84e7-376c-af12-2ca30bce3e02",
                        "entry_id": "5c2810e0-24c1-32f7-b575-1f990e92e6c4",
                        "glosses": [
                            "alles wat betrekking heeft op het betalen van de belastingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2406d32-add3-41c5-99f4-1e7cdbd66d28",
                                "sense_id": "dfadd403-84e7-376c-af12-2ca30bce3e02",
                                "text": "Pascal Saint-Amans, directeur van het Centrum voor Fiscaal Beleid van de OESO, wijst wel op de moeilijkheden van een vergelijking. De fiscaliteit weerspiegelt ook de çultuur van een land'. Saint-Amans bedoelt daarmee dat sommige landen meer inschrijvingsgeld vragen voor de universiteit of dat de ziekteverzekering er niet als taak van de overheid wordt beschouwd. Daardoor varieert de belastingdruk sterk."
                            },
                            {
                                "example_id": "81f0bd49-10ea-4f29-955c-938ca22ad46f",
                                "sense_id": "dfadd403-84e7-376c-af12-2ca30bce3e02",
                                "text": "Voor de economen van de Verenigde Naties valt de verarming van de Palestijnen in Oost-Jeruzalem niet enkel te wijten aan de isolering van het gebied. Het feit dat de inwoners over een ander juridisch statuut hebben dan de Israëliërs, brengt een 'reeks obstakels'teweeg, ín het bijzonder rond huisvesting, werk en fiscaliteit'."
                            }
                        ]
                    }
