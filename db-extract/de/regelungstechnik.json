                        "entry_id": "1e4a6419-9d6d-358e-b48a-d457a3c5ecbd",
                        "glosses": [
                            "technisches Fachgebiet, das sich damit befasst, (physikalische) Größen auf bestimmte Werte zu bringen und gegen Störungen zu halten (die Größen also zu regeln)"
                        ],
                        "tags": [
                            "Automatisierungstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "a77b21a9-98d4-451b-b1e0-d57f3b689df1",
                                "sense_id": "cf736eb3-0d43-3439-be8c-307fe4cc1713",
                                "text": "„Somit gehören die Stabilitätsanalyse sowie der optimale Reglerentwurf zu den wichtigsten Problemstellungen der Regelungstechnik, die später eingehend behandelt werden.“"
                            },
                            {
                                "example_id": "c10fc8b7-eeff-4f2b-bfee-e9ee09baf5f3",
                                "sense_id": "cf736eb3-0d43-3439-be8c-307fe4cc1713",
                                "text": "„Die Norm legt ferner die Schreibweise für mathematische Konzepte der Regelungstechnik und Steuerungstechnik fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
