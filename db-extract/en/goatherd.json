                "senses": [
                    {
                        "sense_id": "8c516926-8a7c-3df0-a220-bbc5f346d0ac",
                        "entry_id": "f1f34576-aac3-3e32-8827-f5d813612b9a",
                        "glosses": [
                            "A person who herds, tends goats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7750151e-79c3-4939-a45f-a4fc7d2dff58",
                                "sense_id": "8c516926-8a7c-3df0-a220-bbc5f346d0ac",
                                "text": "'Oh, yes. A man was brought to us about a year ago. There'd been a big storm along the southern sector of the Taklamakan. It went on for four or five days. This man was a goatherd from Tongguzbasti. He'd gone out into the desert in search of tamarisk, along with a camel for the load. At midday he had some bread and water and lay down for a sleep. When he woke there was a storm the like of which he'd never seen before. There was nothing for it but to hunker down and make the best of it; but at some point - whether it was day or night he couldn't say - he found himself on his feet, shouting and screaming at the noise, and walking for what must have been miles.'"
                            },
                            {
                                "example_id": "b08accf3-ff75-4b7f-82d8-cdcdf74d297d",
                                "sense_id": "8c516926-8a7c-3df0-a220-bbc5f346d0ac",
                                "text": "Looking up from the center of Rmaich, a Christian town lodged on Lebanon’s southern border with Israel, a sun-wizened Lebanese goatherd points to a cluster of pine trees on a ridge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9beefcb6-1e9f-4d20-a765-21c30a737484",
                        "source_entry_id": "f1f34576-aac3-3e32-8827-f5d813612b9a",
                        "source_sense_id": "8c516926-8a7c-3df0-a220-bbc5f346d0ac",
                        "source_sense_description": "person who herds, tends goats",
                        "target_lang_word": "chevrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                        "entry_id": "78d5ccde-c9cb-32e4-a8a0-5b0b44dfdb40",
                                        "glosses": [
                                            "Pâtre qui mène des chèvres."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ff8bb6-b70d-4fad-a0fb-8345059baa8e",
                                                "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                                "text": "La Révolution, l’Empire, qu’est-ce que cela pour des chevriers et des pêcheurs qui ne savent pas lire ?"
                                            },
                                            {
                                                "example_id": "6d75d5d1-f8e0-4522-8574-81ee56f98350",
                                                "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                                "text": "Pendant plus de vingt ans, j'ai parcouru cette vallée, et celles qui lui ressemblent, j'ai interrogé des chevriers muets, j'ai frappé à la porte de ruines inhabitées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3c511c-616e-3725-ae9a-c833392fbb4f",
                                        "entry_id": "5c01e471-8a27-326a-b352-6b5e85260e40",
                                        "glosses": [
                                            "Scieur de long qui manie l’extrémité supérieure de la scie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68c17ec0-f9a8-31c5-acb4-64f046f8c6fd",
                                        "entry_id": "7f2628fa-8f63-3d4b-bd5f-72defdf43f15",
                                        "glosses": [
                                            "Nom donné au haricot flageolet d'Arpajon, qui sont ramassés vert et séchés de manière à garder cette couleur et avoir un goût particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fec939c-5730-4c61-a868-cb16b565b255",
                                                "sense_id": "68c17ec0-f9a8-31c5-acb4-64f046f8c6fd",
                                                "text": "« Tu parles d’une expédition pour des fayots !\n– Bien sûr, mais comme ils ne courent pas les rues, il faut les chercher là où ils se trouvent. »\nOpération réussie : six kilos de chevriers payés à un prix raisonnable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d9ef79b-d676-3f37-8635-3ad482078915",
                                        "entry_id": "ad380767-c353-3e91-999f-95791419f925",
                                        "glosses": [
                                            "Qui concerne l’élevage des chèvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e03479-d546-417c-b233-4bf80ca60fe4",
                                                "sense_id": "7d9ef79b-d676-3f37-8635-3ad482078915",
                                                "text": "L’industrie chevrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c8e345-86d5-45be-94c1-945376489a5b",
                        "source_entry_id": "f1f34576-aac3-3e32-8827-f5d813612b9a",
                        "source_sense_id": "8c516926-8a7c-3df0-a220-bbc5f346d0ac",
                        "source_sense_description": "person who herds, tends goats",
                        "target_lang_word": "chevrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29d0ee28-236e-3a5c-b58a-aee6d68fae86",
                                        "entry_id": "4d0e6578-6750-33d7-aebd-fe43b6d9395b",
                                        "glosses": [
                                            "Bergère qui mène des chèvres."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d0b25e-58df-4338-9b0b-5cb28d8a245e",
                                                "sense_id": "29d0ee28-236e-3a5c-b58a-aee6d68fae86",
                                                "text": "Si j’étais peintre, je voudrais croquer cette divine créature… Et si j’étais seul, ajouta-t-il, revenant à son naturel, je voudrais savoir si cette chevrière a tant soit peu d’esprit."
                                            },
                                            {
                                                "example_id": "cc22c770-2608-4e67-9a51-57b6bf0b342e",
                                                "sense_id": "29d0ee28-236e-3a5c-b58a-aee6d68fae86",
                                                "text": "Ce qu’il disait n’était pas bien différent sans doute de ce que disait à la chevrière le bouvier de l’Oaristys."
                                            },
                                            {
                                                "example_id": "2ea26d8a-4332-4acf-b935-399934876523",
                                                "sense_id": "29d0ee28-236e-3a5c-b58a-aee6d68fae86",
                                                "text": "Filles de la Rochère\nÉlevées au pressoir,\nVachères, chevrières\nFidèles du terroir,\nArdentes buandières,\nJ’aimerais vous revoir !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrière",
                                "target_lang_code": "fr",
                                "target_senses": [
