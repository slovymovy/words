                    {
                        "sense_id": "1cbc3def-a2eb-34a5-8c9f-a4d970c12d03",
                        "entry_id": "b6ef7f20-38da-3f30-ae72-6b64967da07d",
                        "glosses": [
                            "Variante orthographique de chabrot"
                        ],
                        "tags": [
