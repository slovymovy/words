                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d733cebb-f276-45f9-9260-382739d65a5c",
                                "sense_id": "4fcd5503-b614-3324-9a72-57ad25d176b5",
                                "text": "— ‘But look at him,’ groaned Mr. Gradgrind. ‘Will any coach—’\n— ‘I don’t mean that he thould go in the comic livery,’ said Sleary. ‘Thay the word, and I’ll make a Jothkin of him, out of the wardrobe, in five minutes.’\n— ‘I don’t understand,’ said Mr. Gradgrind.\n— ‘A Jothkin—a Carter. Make up your mind quick, Thquire. There’ll be beer to feth. I’ve never met with nothing but beer ath’ll ever clean a comic blackamoor.’"
                            }
                        ]
                    }
