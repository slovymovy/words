                        "target_lang_word": "débauche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débauche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfede272-d34c-3605-a503-0c39896ac8cb",
                                        "entry_id": "320afa29-f171-3622-b3c9-cc1d66a34fab",
                                        "glosses": [
                                            "Action de se livrer un peu plus que de coutume aux plaisirs de la table."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f70f456-9a60-4f9c-a07c-77352c531cb0",
                                                "sense_id": "bfede272-d34c-3605-a503-0c39896ac8cb",
                                                "text": "Nous avons fait hier une petite débauche."
                                            },
                                            {
                                                "example_id": "92905e92-972f-413c-8f95-449cfb6ca6ae",
                                                "sense_id": "bfede272-d34c-3605-a503-0c39896ac8cb",
                                                "text": "Il avait dû venir de Melun pour un de ses concerts du dimanche, dont il se donnait la débauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6efa31d9-71d7-3812-a3e7-d6757098405f",
                                        "entry_id": "320afa29-f171-3622-b3c9-cc1d66a34fab",
                                        "glosses": [
                                            "Dérèglement des mœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8190a3-3c17-46ec-bc46-e83b2ea31645",
                                                "sense_id": "6efa31d9-71d7-3812-a3e7-d6757098405f",
                                                "text": "Il avait mené une vie bruyante de débauches, pleine de duels, de paris, de femmes enlevées."
                                            },
                                            {
                                                "example_id": "57bbf50e-9646-4e7a-b734-de9c2b818cd1",
                                                "sense_id": "6efa31d9-71d7-3812-a3e7-d6757098405f",
                                                "text": "Quel scandale ne ferait pas, en effet, cette créature perdue de débauche quand elle saurait qu’elle n’avait plus rien à espérer de lui !"
                                            },
                                            {
                                                "example_id": "8ee77ca4-6900-41cd-8c07-cf491fc6fc4f",
                                                "sense_id": "6efa31d9-71d7-3812-a3e7-d6757098405f",
                                                "text": "On dit que ces professionnelles ont des charmes secrets, […]; qu’un homme vicieux trouve en elles des partenaires expertes, aux impudeurs extraordinaires, aux habiles jeux de la débauche et de la lubricité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55bac708-6f76-3172-a156-0cd6ba9665bd",
                                        "entry_id": "320afa29-f171-3622-b3c9-cc1d66a34fab",
                                        "glosses": [
                                            "Excès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a05fa6b-0594-49fc-9025-ad194930ea91",
                                                "sense_id": "55bac708-6f76-3172-a156-0cd6ba9665bd",
                                                "text": "Scènes du quotidien, débauche de couleurs, poésie et fantaisie sont les maîtres mots de sa peinture."
                                            },
                                            {
                                                "example_id": "9157d902-83d3-4d8e-95ae-71dde2b0b107",
                                                "sense_id": "55bac708-6f76-3172-a156-0cd6ba9665bd",
                                                "text": "Cette femme volontaire a converti la maison aux vertus du XXIe siècle, dans une débauche de luxe décomplexé, joyeux et mondialisé auquel le Paris haussmannien n’était pas habitué."
                                            },
                                            {
                                                "example_id": "6ea035cd-7a14-4824-a281-f36de975f043",
                                                "sense_id": "55bac708-6f76-3172-a156-0cd6ba9665bd",
                                                "text": "« Johnny se donne à Bercy » pendant trois semaines, à guichets fermés. Dans ce lieu gigantesque où l’on s’attend à une débauche de lumières et d’effets, le spectacle surprend par sa sobriété, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afaeee3d-87ec-35f6-bcd8-8dd412cab0c1",
                                        "entry_id": "320afa29-f171-3622-b3c9-cc1d66a34fab",
                                        "glosses": [
                                            "Fin quotidienne du travail."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "891fb36f-d82e-4bc5-85aa-2ee20ced209e",
                                                "sense_id": "afaeee3d-87ec-35f6-bcd8-8dd412cab0c1",
                                                "text": "Chez le boulanger où je travaille il n'y a ni heure d'embauche ni heure de débauche. J'arrive le mardi matin et repars le dimanche midi."
                                            },
                                            {
                                                "example_id": "81884b74-07d2-4334-b4d7-09cfaf7acc3c",
                                                "sense_id": "afaeee3d-87ec-35f6-bcd8-8dd412cab0c1",
                                                "text": "… de même le travail ne devra cesser qu'à l'heure de débauche."
                                            }
                                        ]
                                    }
                                ]
                            },
