                "senses": [
                    {
                        "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                        "entry_id": "16be2a62-b398-3a7a-91fc-adbeb74e2b33",
                        "glosses": [
                            "grafische Darstellung der Wege von Daten/Informationen zwischen Funktionen, Speichern und Schnittstellen sowie der Veränderung von Daten/Informationen in einem Informationssystem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d291c4d8-3210-46f9-80a4-960b4230112f",
                                "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                                "text": "Unternehmen verwenden täglich Datenflussdiagramme, um bestehende Systeme auf Hindernisse zu untersuchen und neue Geschäftsprozesse zu entwickeln."
                            },
                            {
                                "example_id": "bbc1fe24-15fe-4df4-ad28-685d136e5523",
                                "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                                "text": "In einem ersten Schritt analysiert man daher zunächst den Ist-Zustand und dokumentiert diesen in einem Datenflussdiagramm (physisches Datenflussdiagramm)."
                            },
                            {
                                "example_id": "aa3bb210-0c83-404f-b94b-18bcb051abb6",
                                "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                                "text": "„Datenflussdiagramme beschreiben die Funktionalität eines Systems, indem sie den Weg von Daten bzw. Informationen zwischen verschiedenen Funktionen, Speichern und externen Objekten“ darstellen."
                            },
                            {
                                "example_id": "6b8b2b3f-ecea-4e9a-bc78-1d0126d0545c",
                                "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                                "text": "Der Kontrollfluss ist implizit und wird in einem Datenflussdiagramm nicht modelliert."
                            },
                            {
                                "example_id": "aa753a16-2cec-45ea-8dda-547321f0a827",
                                "sense_id": "1c41870a-d423-35e6-971d-8c62ab0b309f",
                                "text": "Ein Datenflussdiagramm (dataflow diagram) setzt sich aus Prozessen, Flüssen, Datenspeichern und Terminatoren zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
