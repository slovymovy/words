                ],
                "senses": [
                    {
                        "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                        "entry_id": "0e4bcd39-ee87-3ef8-a08d-45be6b3ddbad",
                        "glosses": [
                            "Getränk, das für das Abnehmen (Verringern von Körpergewicht) entwickelt wurde"
                        ],
                        "tags": [
                            "Ernährung"
                        ],
                        "examples": [
                            {
                                "example_id": "6148b50d-98c3-4ff4-9847-cd6ff4f48c17",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Wer abnehmen möchte, treibt häufig Sport und greift auch gerne einmal zu Diätdrinks.“"
                            },
                            {
                                "example_id": "48cddfe1-9947-49c5-84ec-d3c2b461e94b",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "Sie hat mit Diätdrinks vier Kilo in einem Monat abgenommen."
                            },
                            {
                                "example_id": "744439fd-b0f8-48bf-bc45-5e6ef8831931",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "Dieser Diätdrink schmeckt nach Schokolade, hat aber wenig Kalorien."
                            },
                            {
                                "example_id": "2f1739d4-5ecf-4275-a28f-4e96a9817d34",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Anrühren, trinken, abspecken? Diätdrinks versprechen purzelnde Kilos.“"
                            },
                            {
                                "example_id": "7d637aec-3c27-4bfb-bad1-d69653b23b8c",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Diätdrinks locken mit schnellen Erfolgen beim Abnehmen.“"
                            },
                            {
                                "example_id": "f29741fb-5ddf-453e-8f75-95d90e73fe44",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Die getesteten freiverkäuflichen Diätdrinks sind in Pulverform und werden mit Wasser, Milch oder einem Pflanzendrink angerührt.“"
                            },
                            {
                                "example_id": "457514b6-3464-4fb2-abde-936b84a63bc0",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Diätdrinks sind fix angerührt, sollen eine Mahlzeit ersetzen und liefern Proteine und Mineralstoffe.“"
                            },
                            {
                                "example_id": "4ea1f741-6552-4c5e-9727-cf0a6197021d",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Diätdrinks können ein Hilfsmittel auf dem Weg zu weniger Gewicht sein. Allerdings ersetzen sie nicht die Umstellung auf eine gesunde Ernährung.“"
                            },
                            {
                                "example_id": "bb047c1b-ddd4-4479-b94c-f8074a131747",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„In den vergangenen Jahren sind frei verkäufliche Diätdrinks zum Abnehmen immer beliebter geworden.“"
                            },
                            {
                                "example_id": "098a1422-28a5-4272-8dca-b5008becc270",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„»Wenn man ein bisschen streng sein wollte, könnte man kritisieren, dass es mit den Diätdrinks schwierig ist, die Empfehlung für die tägliche Ballaststoffzufuhr zu erreichen. Denn viele Drinks enthalten ja überhaupt keine Ballaststoffe.«“"
                            },
                            {
                                "example_id": "51ecac6e-123d-4789-bc1d-6c1510b7d029",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Diätdrinks unterliegen einer Vielzahl von gesetzlichen Regelungen.“"
                            },
                            {
                                "example_id": "a5f87208-25d6-4124-8c45-13d4aa155278",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Die Diätdrinks müssen laut Gesetz […] zwischen 25 und 50 Prozent Proteine enthalten […].“"
                            },
                            {
                                "example_id": "d4526c53-8a6f-425a-b0ec-e3f1eca408a1",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„Wer also auf Wunderheilung oder einen neuen Diätdrink hofft, ist bei Wasserkefir und Kombucha offensichtlich falsch.“"
                            },
                            {
                                "example_id": "e64c7175-3499-45e4-8333-6c0a32846a12",
                                "sense_id": "2622de05-d50c-38a1-837e-d1ac6fcbfcf2",
                                "text": "„1961 entdeckte Alfred Hitchcock sie in einem Werbespot für den Diätdrink Sego.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
