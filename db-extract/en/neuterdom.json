                                "example_id": "71a4ccee-fe41-4a8d-bed0-d6a4431b1e1f",
                                "sense_id": "2d48e103-3a1b-3208-bb7c-8df9f93f2de4",
                                "text": "Jim wrote a tune for me called, “The Seed Of Desire,” which he insisted on announcing as a celebration of my perfect neuterdom. Pretty soon, half the country knew I was a safe lay."
                            },
