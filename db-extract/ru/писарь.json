                                    },
                                    {
                                        "sense_id": "1c3921fb-d94f-3486-8ff7-e5bffc858219",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "One who occupationally provides assistance by working with records, accounts, letters, etc.; an office worker.",
                                            "The chief legal advisor of a legislature or legislative chamber, who is usually also responsible for keeping minutes of sittings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "852b74b7-7de8-3b9b-b2f3-ee0c7ab8e9c9",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A facilitator of a Quaker meeting for business affairs."
                                        ],
                                        "tags": [
                                            "Quakerism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13e0973d-fef3-313b-8b8a-c5e662d78252",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "In the Church of England, the layman that assists in the church service, especially in reading the responses (also called parish clerk and Bible clerk)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54f3a61-3a51-4062-b56f-ffb0710ef651",
                                                "sense_id": "13e0973d-fef3-313b-8b8a-c5e662d78252",
                                                "text": "God save the King! Will no man say, amen? / Am I both priest and clerk? Well then, amen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14d8d9a-b9a0-36fe-9cd3-2a4fcd2375f3",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A cleric or clergyman (the legal title for clergy of the Church of England is \\\"Clerk in Holy Orders\\\", still used in legal documents and cherished by some of their number)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a491b0d8-2d37-3928-b00c-a673c85ae6d7",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A scholar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913dc7b5-9b1d-461e-ab19-1da7dafc8296",
                                                "sense_id": "a491b0d8-2d37-3928-b00c-a673c85ae6d7",
                                                "text": "13th century, Traditional carol,\nAnd all was for an appel, an appel that he toke/As clerkès finden written in their boke."
                                            }
                                        ]
