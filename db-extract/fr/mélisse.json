        "fr-extract.jsonl": [
            {
                "entry_id": "16f7dcdf-400b-3439-b989-5eba13986f4b",
                "word": "mélisse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a15df93e-d290-47c5-8fe6-f45507ab055a",
                        "entry_id": "16f7dcdf-400b-3439-b989-5eba13986f4b",
                        "tags": [
