                        "glosses": [
                            "Donner un caractère oblique à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4728a2b1-2ad0-483e-9a3d-63d8a2610471",
                                "sense_id": "44ef2402-cc27-347c-8034-8238c7af8be2",
                                "text": "C'est une banale Lifetime retroussée F-M archi-raide comme presque tout le temps chez Sheaffer, fabriquée à des centaines de milliers d'exemplaires, très légèrement obliquisée (on dit ?) par l'usage, ce qui donne une très légère variation au trait, une des choses que je recherche certainement le plus."
                            },
                            {
                                "example_id": "5117f80f-9e8a-4193-819a-921293c53233",
                                "sense_id": "44ef2402-cc27-347c-8034-8238c7af8be2",
                                "text": "Les grands, quand ils passent certaines portes ou parlent à un petit,s’obliquisent."
                            }
                        ]
                    }
