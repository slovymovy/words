                "senses": [
                    {
                        "sense_id": "bfdc5721-93ba-3351-8e47-9a158d39aa61",
                        "entry_id": "dbb55529-86d4-3143-936d-b6a25d7afaf0",
                        "glosses": [
                            "Musique pop coréenne moderne depuis les années 1990, influencée par le hip-hop et la musique électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7287e25a-6406-4f07-90cb-e4bce91802e3",
                                "sense_id": "bfdc5721-93ba-3351-8e47-9a158d39aa61",
                                "text": "Sur le Net, de nombreuse vidéos proposent aux internautes d’apprendre le ballet endiablé de la désormais star de la « K-pop » sud-coréenne, le genre musical local à la mode."
                            },
                            {
                                "example_id": "75d8f440-7ee6-4f1e-ab3f-aee75726f64b",
                                "sense_id": "bfdc5721-93ba-3351-8e47-9a158d39aa61",
                                "text": "L’une des stars du groupe de k-pop BTS, Jin (29 ans) va commencer son service militaire en Corée du Sud le 13 décembre, ont rapporté jeudi les médias."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deb3e3ba-513a-45d3-a47c-bebdd9b1b8f9",
                        "source_entry_id": "dbb55529-86d4-3143-936d-b6a25d7afaf0",
                        "source_sense_id": "bfdc5721-93ba-3351-8e47-9a158d39aa61",
                        "target_lang_word": "K-pop",
