                "senses": [
                    {
                        "sense_id": "ac0d4318-1439-3b9e-a494-f7794b75a7bc",
                        "entry_id": "8d1aa9d0-cd11-372b-84e6-fba113e4a74e",
                        "glosses": [
                            "schmales, vom Aussehen an ein Pferd erinnerndes Gesicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3506c58a-8065-4bcd-91ae-1f4f8abaed41",
                                "sense_id": "ac0d4318-1439-3b9e-a494-f7794b75a7bc",
                                "text": "„Shirley ist eine schlanke Frau mit einem schmalen, traurigen Gesicht und vorstehenden Zähnen - ein Pferdegesicht nannten wir so etwas als Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
