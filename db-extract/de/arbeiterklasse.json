                                    {
                                        "sense_id": "68fca7e2-0d08-3c23-b9e7-6bec9d0bdd08",
                                        "entry_id": "a49fa283-bbbb-3c47-b2b3-e31ebebd841e",
                                        "glosses": [
                                            "Catégorie sociale des prolétaires, ceux qui ne disposent pas de la propriété des moyens de production et doivent vendre leur force de travail pour vivre."
                                        ],
                                        "tags": [
                                            "Société"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e549bcfd-de77-4c4f-bab5-8d660baf61df",
                                                "sense_id": "68fca7e2-0d08-3c23-b9e7-6bec9d0bdd08",
                                                "text": "On s’apitoie en ce moment beaucoup sur le sort des classes ouvrières, on les présente comme égorgées par les fabricants ; mais l’État est plus dur cent fois que l’industriel le plus avide ; il pousse, en fait de traitements, l’économie jusqu’au non-sens."
                                            },
                                            {
                                                "example_id": "37d716a0-9b3b-40ee-b630-d3ca8c6b21ac",
                                                "sense_id": "68fca7e2-0d08-3c23-b9e7-6bec9d0bdd08",
                                                "text": "La petite maison offre un confort inouï pour la classe ouvrière de l’époque – deux pièces de jour, des chambres distinctes pour les parents et les enfants, des sanitaires, un grand jardin, un potager."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
