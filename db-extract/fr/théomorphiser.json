                "senses": [
                    {
                        "sense_id": "1e655594-56d6-39b7-bb23-bcf9416e115e",
                        "entry_id": "8d183a76-f9a1-3e37-8ef4-fdb797014e5f",
                        "glosses": [
                            "Considérer comme étant à l’image de Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b9d65b-c979-4efd-bd0b-e32a31a456f2",
                                "sense_id": "1e655594-56d6-39b7-bb23-bcf9416e115e",
                                "text": "L'homme serait donc une image « fidèle » de Dieu, d'un dieu que l'on anthropomorphise afin de théomorphiser l'homme."
                            },
                            {
                                "example_id": "35a23bc9-7745-4f92-8f91-9fef855e41c5",
                                "sense_id": "1e655594-56d6-39b7-bb23-bcf9416e115e",
                                "text": "Il doit se théomorphiser encore."
                            },
                            {
                                "example_id": "75712fb7-b918-48b3-b4d5-fc5cffe6704f",
                                "sense_id": "1e655594-56d6-39b7-bb23-bcf9416e115e",
                                "text": "Mais seul de tous les existants, l’homme, en raison de la position centrale qui est la sienne, - et qui a fait dire à juste titre que la terre, séjour de l’homme, occupait le centre du monde, - et en vertu de son théomorphisme, a la possibilité de redevenir le Soi, de se théomorphiser."
                            }
                        ]
                    }
                ],
