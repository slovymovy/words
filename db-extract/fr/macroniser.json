                "senses": [
                    {
                        "sense_id": "e58f94c7-a29f-3640-b473-c0dc7c3d8957",
                        "entry_id": "5e048cd9-5caa-3fa2-b52b-832766ada822",
                        "glosses": [
                            "Transformer par l’influence d’Emmanuel Macron et de ses idées."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5097c838-d1b4-4d1a-8b16-6157456f8ee8",
                                "sense_id": "e58f94c7-a29f-3640-b473-c0dc7c3d8957",
                                "text": "Delanoë sort de la naphtaline tunisienne pour essayer de nous macroniser !"
                            },
                            {
                                "example_id": "0569b5d2-8edc-408a-b3e7-681da40ea8b2",
                                "sense_id": "e58f94c7-a29f-3640-b473-c0dc7c3d8957",
                                "text": "Nous avons demandé si la DGFIP n’était pas en train de nous « macroniser » !"
                            },
                            {
                                "example_id": "316a8522-8cd8-45ec-a58d-82f9d3ff9804",
                                "sense_id": "e58f94c7-a29f-3640-b473-c0dc7c3d8957",
                                "text": "Avec Fillon et une France qui donne l'impression de se filloniser ou de se macroniser de plus en plus, pas si tôt…"
                            },
                            {
                                "example_id": "49c7c01f-a198-4c02-b2da-1252516e455b",
                                "sense_id": "e58f94c7-a29f-3640-b473-c0dc7c3d8957",
                                "text": "Ce sont les opportunistes autour de lui qui se macronisent, comme Dominique Perben."
                            }
                        ]
                    }
                ],
