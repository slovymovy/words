                ],
                "senses": [
                    {
                        "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                        "entry_id": "1d2a2c26-f6dd-31dd-b5eb-000ae543af0e",
                        "glosses": [
                            "französischsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15665394-0b59-403c-b1bf-147720c2722f",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Frau Carpentier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "83a79368-541b-4c3b-8b82-584b88e07215",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Herr Carpentier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fce3aee0-f108-4b67-92a2-44db497e4fd3",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Die Carpentiers kommen heute aus Berlin."
                            },
                            {
                                "example_id": "64ccca93-79a4-4e1f-bd9d-894020de7dbb",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Der Carpentier trägt nie die Schals, die die Carpentier ihm strickt."
                            },
                            {
                                "example_id": "58fb08f7-ed60-46ff-bd87-38110b16096e",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Carpentier kommt, geht der Herr Carpentier.“"
                            },
                            {
                                "example_id": "e5139199-f342-466b-b9e2-b610eefc97bf",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Carpentier kommt und geht."
                            },
                            {
                                "example_id": "bad71e8b-cb90-4a6d-b357-6860ad97bde1",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "Carpentiers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ad87568e-a5c3-4f2b-bbcd-7c29083439bc",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "An verregneten Herbsttagen ist Familie Carpentiers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "de49dcf9-66e7-47eb-9f9c-f14da459b7a1",
                                "sense_id": "7a93248f-b5b4-3f7b-883b-1210491d7e65",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Carpentier das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
