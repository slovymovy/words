                                    {
                                        "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                        "entry_id": "fe9f1d7a-317a-3805-9fb4-2034a1145143",
                                        "glosses": [
                                            "Oiseau marin pélagique, qui ne vient à terre que pour se reproduire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a9b1ec-50a7-4524-a555-9f7dc1ddf381",
                                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                                "text": "Ce puffin vole avec élégance en tenant en général ses longues ailes en cloche."
                                            },
                                            {
                                                "example_id": "664b64a5-015b-4360-a163-d1bd9099566b",
                                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                                "text": "Quelques oiseaux retardataires, des pétrels, des guillemots, des puffins, animaient encore cette solitude et jetaient des cris perçants."
                                            },
                                            {
                                                "example_id": "3f35cea8-82c2-45b2-a9b3-6da97ba7612f",
                                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                                "text": "Les Procellariidés (pétrels et puffins) sont des oiseaux marins de taille moyenne à grande. Tous possèdent des narines tubulaires à la base du bec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
