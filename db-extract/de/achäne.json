                        "entry_id": "43279118-c294-3391-83f3-4dfcddc2a93a",
                        "glosses": [
                            "Sonderform der einsamigen Frucht der Korbblütler, bei der die Samenschale und die Fruchtwand sehr eng miteinander verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7510f506-fea5-4aa3-bd1a-990f175fd136",
                                "sense_id": "df07a498-4ee6-3139-83a6-7cc285f3f0f2",
                                "text": "Die Früchte der meisten Korbblütler sind Achänen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb25208-92d5-480e-938f-bf0cc56860df",
                        "source_entry_id": "43279118-c294-3391-83f3-4dfcddc2a93a",
                        "source_sense_id": "df07a498-4ee6-3139-83a6-7cc285f3f0f2",
                        "source_sense_description": "Sonderform der einsamigen Frucht der Korbblütler",
                        "target_lang_word": "achene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achene",
