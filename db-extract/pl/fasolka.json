                                "target_senses": [
                                    {
                                        "sense_id": "0b18b686-75f3-30f4-82e8-6756e8640fd7",
                                        "entry_id": "16c0ffd4-70ed-3c80-b8ce-1744c7046023",
                                        "glosses": [
                                            "Obsolete spelling of whole."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4ecc9d-dab5-4663-9ac0-8aeac5778c2f",
                                                "sense_id": "0b18b686-75f3-30f4-82e8-6756e8640fd7",
                                                "text": "Such was the arrangement of the alphabet over the hole North."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1dab83a-c692-3041-bd52-ea4c6638f863",
                                        "entry_id": "16c0ffd4-70ed-3c80-b8ce-1744c7046023",
                                        "glosses": [
                                            "Misspelling of whole."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db9822d5-7cf4-3974-8d8b-dba57d9da045",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "A hollow place or cavity; an excavation; a pit; a dent; a depression; a fissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67fdb270-d025-40b8-b1e2-0baf26567d64",
                                                "sense_id": "db9822d5-7cf4-3974-8d8b-dba57d9da045",
                                                "text": "I made a blind hole in the wall for a peg.  I dug a hole and planted a tree in it."
                                            },
                                            {
                                                "example_id": "b131c147-c727-400f-8a6e-d0d0564889dd",
                                                "sense_id": "db9822d5-7cf4-3974-8d8b-dba57d9da045",
                                                "text": "To be called into a huge sphere, and not to be seen to move in't, are the holes where eyes should be, which pitifully disaster the cheeks."
                                            },
                                            {
                                                "example_id": "a4bcdd9d-cf66-4b22-acd8-cc32e587c6af",
                                                "sense_id": "db9822d5-7cf4-3974-8d8b-dba57d9da045",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d58c2057-1993-3b51-aeb6-aa7ceae381d2",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "An opening that goes all the way through a solid body, a fabric, etc.; a perforation; a rent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4390ad-931e-48dd-830a-483c879eb11f",
                                                "sense_id": "d58c2057-1993-3b51-aeb6-aa7ceae381d2",
                                                "text": "There’s a hole in my shoe.  Her stocking has a hole in it."
                                            },
                                            {
                                                "example_id": "d2365c19-c734-4a1d-972d-99f5d8765ad9",
                                                "sense_id": "d58c2057-1993-3b51-aeb6-aa7ceae381d2",
                                                "text": "The priest took a chest, and bored a hole in the lid."
                                            },
                                            {
                                                "example_id": "ea3b39bc-f136-4993-814f-81dbc19f172e",
                                                "sense_id": "d58c2057-1993-3b51-aeb6-aa7ceae381d2",
                                                "text": "[…]her palfrey’s footfall shot\nLight horrors thro’ her pulses: the blind walls\nWere full of chinks and holes; and overhead\nFantastic gables, crowding, stared:[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "733b7111-46fb-3eb3-9096-92e060163788",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "A subsurface standard-size hole, also called cup, hitting the ball into which is the object of play. Each hole, of which there are usually eighteen as the standard on a full course, is located on a prepared surface, called the green, of a particular type grass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ae97f92-0f1a-3e75-8bc0-72fe87153314",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "The part of a game in which a player attempts to hit the ball into one of the holes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfcde7f-a2ea-42ba-9bc1-78079504e29f",
                                                "sense_id": "7ae97f92-0f1a-3e75-8bc0-72fe87153314",
                                                "text": "I played 18 holes yesterday.  The second hole today cost me three strokes over par."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70b43023-138c-3f21-9603-9b4fc9d905c1",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "The rear portion of the defensive team between the shortstop and the third baseman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f780c196-1861-49a3-b4a7-7ab48f190122",
                                                "sense_id": "70b43023-138c-3f21-9603-9b4fc9d905c1",
                                                "text": "The shortstop ranged deep into the hole to make the stop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd12f61c-233e-3f87-a5e8-fa8381d0c7cb",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "A square on the board, with some positional significance, that a player does not, and cannot in the future, control with a friendly pawn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a6dc819-847b-3db7-a3a4-f8fa21bde570",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "A card (also called a hole card) dealt face down thus unknown to all but its holder; the status in which such a card is."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f21c719-2044-367a-84d9-747a3bd88dcb",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "In games.",
                                            "In the game of fives, part of the floor of the court between the step and the pepperbox."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9939dee-0715-314c-870d-7aa05841065d",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
