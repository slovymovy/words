                "senses": [
                    {
                        "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                        "entry_id": "d94f4278-9d09-3f25-a417-a92dcc28c88b",
                        "glosses": [
                            "Kurzwort für Christlich-Soziale Union (in Bayern (e. V.))"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66a29c2a-3d1f-4e85-84d1-4c0e1813d5a9",
                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                "text": "Die CSU bezeichnet sich als Volkspartei in Bayern."
                            },
                            {
                                "example_id": "66cdb25e-f452-4e5c-96f6-24b23516ca38",
                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                "text": "„Die folgende Fußballgeschichte handelt vom letzten Habsburger, Otto Habsburg, der in Bayern lebte und für die CSU im Europaparlament in Straßburg saß.“"
                            },
                            {
                                "example_id": "fe3a0938-4321-4503-a832-87c495e87710",
                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                "text": "„»Sie waren unfähig, den Ausbau der erneuerbaren Energien herbeizuführen. Sie haben Abwehrkämpfe geführt gegen jede einzelne Windkraftanlage«, sagt Scholz und zeigt dabei auf die Sitzreihen von CDU und CSU.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fdb758e-632f-4654-8299-aa6e5289642f",
                        "source_entry_id": "d94f4278-9d09-3f25-a417-a92dcc28c88b",
                        "source_sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
