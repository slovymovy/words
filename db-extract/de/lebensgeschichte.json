                "senses": [
                    {
                        "sense_id": "b12cd373-75ab-32d3-b135-8d2da620a49e",
                        "entry_id": "05c1bf9e-861b-32c1-97b7-296f67cb555e",
                        "glosses": [
                            "Ablauf dessen, was sich im Leben einer Person ereignet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28554e7-f6a6-483a-b0bf-921d1b7b941f",
                                "sense_id": "b12cd373-75ab-32d3-b135-8d2da620a49e",
                                "text": "„Die Lebensgeschichte von Münchhausen ist eine frühe Parabel auf Ruhm, Lüge, Medien und Imageprobleme.“"
                            },
                            {
                                "example_id": "ef617682-21c0-4c2e-9138-106ff32cb59e",
                                "sense_id": "b12cd373-75ab-32d3-b135-8d2da620a49e",
                                "text": "„Die Lebensgeschichte ihres Vaters ist für einen im kurmainzischen Eichsfeld Geborenen ungewöhnlich.“"
                            },
                            {
                                "example_id": "cee794a0-17cf-49b4-9bf5-9c2618d27e73",
                                "sense_id": "b12cd373-75ab-32d3-b135-8d2da620a49e",
                                "text": "„Die Wirte kennen alle ihre Gäste mit Namen und Lebensgeschichte, denn ihre Gäste sitzen seit Jahrzehnten an ihrem Tresen, sie wohnen in der Nachbarschaft.“"
                            },
                            {
                                "example_id": "e5b385f6-f3c3-45f4-a158-ec4932ebcd33",
                                "sense_id": "b12cd373-75ab-32d3-b135-8d2da620a49e",
                                "text": "„Tourkys Lebensgeschichte und seine Beschreibung der Situation in diesem Land hatten ihm den Angstschweiß auf die Stirn getrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
