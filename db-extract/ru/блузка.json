                                                "sense_id": "b07fc889-3ff0-35f4-a646-80693884824e",
                                                "text": "Voor Genie had ik een ouderwetse, kanten blouse gekocht, recht uit Little house on the prairie."
                                            },
                                            {
                                                "example_id": "7865145f-2149-4aa8-b77a-0d70f592aa4c",
                                                "sense_id": "b07fc889-3ff0-35f4-a646-80693884824e",
                                                "text": "Zijn broek op zijn enkels, zijn blouse halfopen."
                                            },
                                            {
                                                "example_id": "ad98ce60-e82e-467e-8a78-2b5568706af4",
                                                "sense_id": "b07fc889-3ff0-35f4-a646-80693884824e",
                                                "text": "Nerveus pluk ik aan de klosjes van de feestelijke blouse die ik voor de gelegenheid heb aangetrokken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
