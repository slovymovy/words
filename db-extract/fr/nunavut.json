                        "entry_id": "24bffb82-f856-3cd6-91cf-86690a8cb7ed",
                        "glosses": [
                            "Relatif au Nunavut, ses habitants, …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca9e19c-0154-485b-bf0b-7f3472033b4f",
                                "sense_id": "a43af6c3-ae07-3db4-b37b-72fe69507042",
                                "text": "Et un port en eaux profondes ....qui est sur territoire nunavut à la marée descendante!!!!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d79f93c1-6e56-3a47-b737-235d6c6a869c",
                "word": "Nunavut",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d64c08f-bf83-30dd-bbba-f882f6a57a9d",
                        "entry_id": "d79f93c1-6e56-3a47-b737-235d6c6a869c",
                        "glosses": [
                            "Territoire du Canada (symbole postal NU), bordé par l’océan Arctique au nord-ouest, la mer de Lincoln au nord, la mer de Baffin au nord-est, le détroit de Davis à l’est, le détroit et la baie d’Hudson au sud-est, le Manitoba au sud, et les territoires du Nord-Ouest au sud-ouest et à l'ouest, et dont la capitale est Iqaluit."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "b92873da-233d-4eb6-b33e-19deb69632e2",
                                "sense_id": "0d64c08f-bf83-30dd-bbba-f882f6a57a9d",
                                "text": "De la taille de la Pologne, Tuvaijuittuq encercle le parc national de Quttinirpaaq, à l'angle nord-est de l'île d'Ellesmere, elle-même située à l’extrême nord du Nunavut."
                            },
                            {
                                "example_id": "b39c0050-21dc-4d2b-824b-e0b92f1d4457",
                                "sense_id": "0d64c08f-bf83-30dd-bbba-f882f6a57a9d",
                                "text": "Préserver les langues et la culture inuit\n Lucy Tulugarjuk affirme que la chaîne offrira entre autres une programmation en inuinnaqtun, un dialecte inuktut parlé dans l'ouest du Nunavut, et en inuvialuktun, qui est parlé par les Inuit aux Territoires du Nord-Ouest."
                            },
                            {
                                "example_id": "dee0e78a-853b-4ce7-8a00-128be5c55fc3",
                                "sense_id": "0d64c08f-bf83-30dd-bbba-f882f6a57a9d",
                                "text": "Pour la dernière escale de son voyage, à Iqaluit, capitale du Nunavut dans le Grand Nord canadien, le pape avait été accueilli au son des chants de gorge inuits, au milieu des maisons colorées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfea699b-beac-4775-b200-7190e1fbb79a",
                        "source_entry_id": "d79f93c1-6e56-3a47-b737-235d6c6a869c",
                        "source_sense_id": "0d64c08f-bf83-30dd-bbba-f882f6a57a9d",
                        "target_lang_word": "Nunavut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nunavut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                        "entry_id": "791eb0af-8a6f-32c7-a3ce-c37db72fef79",
                                        "glosses": [
                                            "Territorium im Norden Kanadas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf336044-8f2e-4e92-8f0a-8e29bec3175b",
                                                "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                                "text": "Die Hauptstadt von Nunavut ist Iqaluit."
                                            },
                                            {
                                                "example_id": "5642c189-8aa6-4d99-a494-0b47ce22d9b7",
                                                "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                                "text": "„Er hielt seine Idee schriftlich fest, einen Monat nachdem er von einer Angeltour nach Nunavut, in der Nähe der Frobisher-Bucht, zurückkehrte, einem brutalen, felsigen Küstenstrich am Rande der Labradorsee, die hinter dem als Lower Savage Islands bekannten Felsstreifen abrupt eine Kerbung nach Süden vollzieht, um ein einzigartiges, anderthalb Kilometer breites Rinnsal zu bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59ddf161-0f31-4451-aa28-499268553868",
                        "source_entry_id": "d79f93c1-6e56-3a47-b737-235d6c6a869c",
