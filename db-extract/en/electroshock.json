                                        "entry_id": "4a8b939f-09c3-30d8-8446-dab83a8fae84",
                                        "glosses": [
                                            "zabieg polegający na przepuszczeniu prądu elektrycznego przez ciało pacjenta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702ce43d-be69-4148-9406-8063d61988c0",
                                                "sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                                                "text": "Po drugim elektrowstrząsie serce naszego dziecka ożyło"
                                            },
                                            {
                                                "example_id": "30b42a25-8009-40a4-adaf-f0f4c54a06cb",
                                                "sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                                                "text": "Wbrew powszechnym opiniom, elektrowstrząsy to bardzo skuteczna i bardzo bezpieczna metoda leczenia zaburzeń afektywnych zarówno jednobiegunowych (depresja), jak i dwubiegunowych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
