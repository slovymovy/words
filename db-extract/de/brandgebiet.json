                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e22390-f98d-471c-b469-3934fbc8b095",
                                "sense_id": "25344d9b-005e-3cd9-9caa-c779ad603671",
                                "text": "„Bei der Feuersbrunst im Mai 1842 zählte die neue Börse zu den wenigen Gebäuden, die im Brandgebiet gerettet werden konnten.“"
                            },
                            {
                                "example_id": "a9bcb7bd-7745-4188-9dea-cff16fe637ea",
                                "sense_id": "25344d9b-005e-3cd9-9caa-c779ad603671",
                                "text": "„Der Kommandant brüllte durch die Maske Anweisungen in sein Funkgerät, und kurz darauf ließ ein Löschhubschrauber Wasser von oben auf das Brandgebiet regnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
