                "senses": [
                    {
                        "sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                        "entry_id": "49a90bec-3f26-34a5-b9fd-aa53af3a8fd1",
                        "glosses": [
                            "de eerste moeder, de vrouw waar iedereen van afstamt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbe1b85-ff1a-446a-ac31-98fffe396966",
                                "sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                                "text": "Met behulp van dna-technieken kon het onderzoeksteam bepalen wie de \"oermoeder\" van de onderzochte populatie was."
                            },
                            {
                                "example_id": "c680914b-1deb-4986-be22-d782c0140951",
                                "sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                                "text": "Daarna gaat hij de theaters in met GTST-oermoeder Jette van der Meij (Laura). \"Heerlijk om weer op het toneel te staan. Eigenlijk vind ik dat leuker dan televisie, vooral omdat je direct de reactie van het publiek ziet. Slaat iets aan, of niet?\""
                            },
                            {
                                "example_id": "8af70621-d73e-427f-af25-6451c76d3eab",
                                "sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                                "text": "Maandagmiddag arriveerde aan de Oude Borculoseweg op een dieplader van het Almelose transportbedrijf Bolk het 3.80 meter hoge kunstwerk De Oermoeder van kunstenares Lotje de Lussanet die sinds een half jaar in Diepenheim woont."
                            }
                        ]
                    },
                    {
                        "sense_id": "c474ce94-ff30-3d80-bf5e-8c2a33bf524b",
                        "entry_id": "49a90bec-3f26-34a5-b9fd-aa53af3a8fd1",
                        "glosses": [
                            "de eerste van een hele serie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "550d534b-1077-4586-bf42-241f87013b2d",
                                "sense_id": "c474ce94-ff30-3d80-bf5e-8c2a33bf524b",
                                "text": "Dus elk jaar, wanneer er even niets te beleven viel op het WK, zond de BBC maar weer de historische 9-darter van Paul Lim uit. Op veler verzoek overigens. Voor hele generaties dartfans is die leg van Lim de oermoeder van alle 9-darters. Zelfs zijn opponent in die wedstrijd, de weerloze Ier Jack McKenna, is een beroemdheid in de sport dankzij Lim."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3d62030-6edd-461b-8721-4ab5f703777b",
                        "source_entry_id": "49a90bec-3f26-34a5-b9fd-aa53af3a8fd1",
                        "source_sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                        "target_lang_word": "ancestress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancestress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10bab6f0-34ba-3876-bd2d-30a627488eff",
                                        "entry_id": "90f12e5f-0ccd-362b-ac2b-4012fdbc6dd2",
                                        "glosses": [
                                            "A female ancestor."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55f1b3aa-ed58-4bb7-96b1-a2a77793c5d8",
                                                "sense_id": "10bab6f0-34ba-3876-bd2d-30a627488eff",
                                                "text": "The strange legend that you will find inscribed by your remote ancestress upon the potsherd was communicated to me by my father on his deathbed, and took a strong hold upon my imagination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9572cadb-86c5-4c44-a4f3-df164dac346e",
                        "source_entry_id": "49a90bec-3f26-34a5-b9fd-aa53af3a8fd1",
                        "source_sense_id": "d47fa78b-3c79-37dd-841f-4683f2ec5ed1",
                        "target_lang_word": "matriarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matriarch",
