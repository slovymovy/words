                "senses": [
                    {
                        "sense_id": "0f9a8ebd-0365-3a96-8897-1f68bfc71408",
                        "entry_id": "e6eb07d8-4bf5-3dde-b92c-baf2668402f6",
                        "glosses": [
                            "Investition, die nicht den erwarteten Nutzen gebracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8becdb99-5564-4dfa-b747-f37848894c01",
                                "sense_id": "0f9a8ebd-0365-3a96-8897-1f68bfc71408",
                                "text": "„Seltenes Geständnis: Warren Buffett gibt zu, eine Fehlinvestition getätigt zu haben.“"
                            },
                            {
                                "example_id": "c7029499-6754-4883-b108-31d3b7db6beb",
                                "sense_id": "0f9a8ebd-0365-3a96-8897-1f68bfc71408",
                                "text": "„Der Holtzbrinck-Verlag muss StudiVZ nun als Fehlinvestition verbuchen.“"
                            },
                            {
                                "example_id": "ede51250-c8a3-408b-b389-1b0c5d1203c8",
                                "sense_id": "0f9a8ebd-0365-3a96-8897-1f68bfc71408",
                                "text": "„Die starke Ausweitung des Bildungssystems war nationalökonomisch eine Fehlinvestition, da sie isoliert geschah und nicht mit der Schaffung von Arbeitsplätzen verbunden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
