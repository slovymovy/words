                                                "example_id": "d1521819-aaf4-4edc-8d36-09fcfae58fd1",
                                                "sense_id": "f1797f32-7ae0-3984-8540-2e3cc4a884ad",
                                                "text": "the badge of a society; the badge of a policeman"
                                            }
                                        ]
                                    },
