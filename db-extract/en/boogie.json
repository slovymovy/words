                        "sense_id": "49f3cfee-24ef-36f1-ab72-f8374398f7c4",
                        "entry_id": "2f252379-95d5-3503-8c70-3c5f29680c06",
                        "glosses": [
                            "A black person."
                        ],
                        "tags": [
                            "ethnic",
