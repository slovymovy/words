                "senses": [
                    {
                        "sense_id": "fd1f832d-d5af-3385-843d-482321b0a57f",
                        "entry_id": "57696a3b-91c3-3669-811f-cfc03def57f3",
                        "glosses": [
                            "gerichtlich angeordnete Sanktion, durch die jemand zur Zahlung einer Geldleistung verpflichtet wird"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "018f0e4f-56e3-4e0d-986f-12cba4f19767",
                                "sense_id": "fd1f832d-d5af-3385-843d-482321b0a57f",
                                "text": "„Gemäß § 17 Satz 1 kann das Gericht der Hauptsache bei Zuwiderhandlungen ein Ordnungsgeld bis zu € 100.000,00 festsetzen.“"
                            },
                            {
                                "example_id": "ca96479b-1527-4c8d-aa73-59dfd1a785e8",
                                "sense_id": "fd1f832d-d5af-3385-843d-482321b0a57f",
                                "text": "„Insoweit bestehen keine grundsätzlichen Bedenken dagegen, ein Ordnungsgeld gegen Unternehmen zu verhängen.“"
                            },
                            {
                                "example_id": "ca23c67e-8bbf-49b9-b9bf-40e3552e5784",
                                "sense_id": "fd1f832d-d5af-3385-843d-482321b0a57f",
                                "text": "„Zur Auferlegung der Kosten, zur Festsetzung von Ordnungsgeld und zur Anordnung der Vorführung ist der Staatsanwalt zuständig.“"
                            },
                            {
                                "example_id": "c79c50d7-5d20-423d-81f9-7e8944568025",
                                "sense_id": "fd1f832d-d5af-3385-843d-482321b0a57f",
                                "text": "„Zwar liegen die Ordnungsgelder, die das Landgericht festgesetzt hat, noch im unteren Bereich des zur Verfügung stehenden Rahmens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
