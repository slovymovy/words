                        "form": "more Madonna-like"
                    },
                    {
                        "form_id": "755ba645-ed5c-4075-9a49-cf24cc452572",
                        "entry_id": "117f4290-c994-38d3-8185-a9fad92b5541",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Madonna-like"
