                                        "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Action de remplacer une personne par une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
