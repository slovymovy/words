        "de-extract.jsonl": [
            {
                "entry_id": "ec365654-b70c-399b-8095-abe01e9bb2f6",
                "word": "aufm",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e109614-5baf-3ae8-a389-44479d815f69",
                        "entry_id": "ec365654-b70c-399b-8095-abe01e9bb2f6",
                        "glosses": [
                            "auf einem, auf dem"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "81f80f92-bf68-4f1a-a63c-8235bfb640e9",
                                "sense_id": "5e109614-5baf-3ae8-a389-44479d815f69",
                                "text": "„Da aber Gesetze immer nur nachvollziehen können, was eine Gesellschaft als Wertekanon vereinbart, sei daran erinnert, daß im Fußball die Wahrheit nicht zwischen Buchdeckeln, sondern aufm Platz ist.“"
                            },
                            {
                                "example_id": "c622ed27-40bd-4265-a67d-fa1a90f7b090",
                                "sense_id": "5e109614-5baf-3ae8-a389-44479d815f69",
                                "text": "„Sogar Peter Hintze vom Bundesministerium für Frauen und Jugend darf auspacken, wie er vor zwanzig Jahren beim Festival der Weltjugend aufm Alex den CDU-Standpunkt durchsetzen wollte und an der Diktatur gescheitert ist.“"
                            },
                            {
                                "example_id": "6ee5d45d-d2d9-411f-bbfb-63dd06a0ec25",
                                "sense_id": "5e109614-5baf-3ae8-a389-44479d815f69",
                                "text": "„Er rettet ihr, klein, buckelig, Metallhut aufm Kopp, das Leben, er kehrt sie mit dem Rollstuhl gerade noch rechtzeitig vor einem Laster von der Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
