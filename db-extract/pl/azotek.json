                "senses": [
                    {
                        "sense_id": "c4eebe15-e81a-363b-bcb1-252ae9b1d6c8",
                        "entry_id": "8d18c1ed-28df-317b-b65c-09fc9f697871",
                        "glosses": [
                            "związek chemiczny azotu z metalem lub półmetalem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5250a2-0faa-45f9-9abb-7f4b44c1eee1",
                                "sense_id": "c4eebe15-e81a-363b-bcb1-252ae9b1d6c8",
                                "text": "Azotki glinu, galu i indu przyjmują diamentopodobną strukturę wurcytu, w której atomy zajmują tetraedryczne położenia."
                            },
                            {
                                "example_id": "68d0bc1e-a985-495c-9ded-cf2d58abf896",
                                "sense_id": "c4eebe15-e81a-363b-bcb1-252ae9b1d6c8",
                                "text": "Azotek galu jest piekielnie wytrzymałym materiałem — topi się w temperaturze kilku tysięcy stopni i ciśnieniu kilkanaście tysięcy razy większym od atmosferycznego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
