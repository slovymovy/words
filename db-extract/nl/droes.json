                                    {
                                        "sense_id": "0078cde7-5765-3880-8a44-9ecce722e5b9",
                                        "entry_id": "0df3f681-2653-398a-ae82-c483e80b86e9",
                                        "glosses": [
                                            "A disease of horses caused by an infection by the bacterium Streptococcus equi."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cadc90-10cc-47ba-b169-5b0ca421ad6c",
                                                "sense_id": "0078cde7-5765-3880-8a44-9ecce722e5b9",
                                                "text": "The Vives, like the strangles, is most incident to young horses, and usually proceeds from the same causes, such as catching cold, being over-heated, or over-worked, about the time of shedding their teeth."
                                            }
                                        ]
                                    }
                                ]
