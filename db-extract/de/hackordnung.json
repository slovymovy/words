                "senses": [
                    {
                        "sense_id": "25b505ca-bb6d-33cf-880a-7a5b13d7bef9",
                        "entry_id": "4bc4a28e-7e4e-35f6-8815-34bc42eceaa8",
                        "glosses": [
                            "Rangordnung, die durch aggressives Verhalten gegenüber Artgenossen verteidigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3712bff1-3409-4a65-8056-cd0cfabc89ba",
                                "sense_id": "25b505ca-bb6d-33cf-880a-7a5b13d7bef9",
                                "text": "Bei Haushühnern herrscht eine strenge Hackordnung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf7a7df6-59ee-37a9-b970-60b65a14e36d",
                        "entry_id": "4bc4a28e-7e4e-35f6-8815-34bc42eceaa8",
                        "glosses": [
                            "strenge Hierarchie innerhalb einer Menschengruppe"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a75f1d9b-d625-4e66-a51e-c4170454d6ac",
                                "sense_id": "cf7a7df6-59ee-37a9-b970-60b65a14e36d",
                                "text": "Gegen die Hackordnung in unserer Firma traut sich niemand aufzubegehren."
                            },
                            {
                                "example_id": "11f3fd76-5920-4dbf-8662-9346b2eb7920",
                                "sense_id": "cf7a7df6-59ee-37a9-b970-60b65a14e36d",
                                "text": "„Im Büro ist die Hackordnung nur scheinbar festgelegt.“"
                            },
                            {
                                "example_id": "695c992b-ff09-40e1-b749-c008fdaf677f",
                                "sense_id": "cf7a7df6-59ee-37a9-b970-60b65a14e36d",
                                "text": "„Hamid rannte ihm unterwürfig hinterher; diese öffentliche Zurschaustellung der Hackordnung war peinlich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
