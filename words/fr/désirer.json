                        "désirer ardemment"
                    ]
                },
                {
                    "sense_id": "f805484e-3ded-3a57-8aae-932ed29da7f2",
                    "sense_definition": "Vouloir vivement posséder un bien matériel ou un avantage que l'on n'a pas.",
