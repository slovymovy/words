    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7eb3f9c0-a4c8-388b-8534-662ba166de98",
                    "sense_definition": "Sac d'étoffe ou de cuir rempli d'une matière molle, sur lequel on s'assied, s'appuie ou qui sert à décorer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ameublement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté un <w>coussin</w> moelleux pour rendre le fauteuil plus confortable."
                        },
                        {
                            "text": "Elle a déposé un joli <w>coussin</w> de canapé sur le tapis du salon."
                        }
                    ],
                    "common_phrases": [
                        "coussin de canapé",
                        "coussin de sol"
                    ]
                },
                {
                    "sense_id": "c432e593-d332-31ce-9ea8-a1e4cf449913",
                    "sense_definition": "Objet rembourré servant à soutenir la tête pendant le sommeil ou le repos.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "literie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de dormir, elle secoue toujours son <w>coussin</w> pour qu'il soit bien gonflé."
                        },
                        {
                            "text": "Il glisse un petit <w>coussin</w> sous sa nuque pour lire confortablement au lit."
                        }
                    ],
                    "synonyms": [
                        "oreiller"
                    ]
                },
                {
                    "sense_id": "d2a16d03-b4a8-3f09-ba26-18680f15a6cd",
                    "sense_definition": "Dispositif ou élément amortisseur servant à atténuer les chocs ou à éviter les frottements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'aéroglisseur se déplace facilement sur l'eau grâce à un <w>coussin</w> d'air sous sa coque."
                        },
                        {
                            "text": "Le mécanicien a remplacé le <w>coussin</w> en caoutchouc qui protégeait le moteur des vibrations."
