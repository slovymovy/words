                "senses": [
                    {
                        "sense_id": "5f8e46cb-4b09-3ecf-acc6-aee1a5bd1678",
                        "entry_id": "5212d8cc-d4be-3fac-a070-0e6f0185089e",
                        "glosses": [
                            "прийти в изумление от чего-либо; очень сильно удивиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a93211-ff3c-45f7-b736-3130e382e132",
                                "sense_id": "5f8e46cb-4b09-3ecf-acc6-aee1a5bd1678",
                                "text": "Лиза изумилась: она никогда еще не видала своей умной и рассудительной тетки в таком состоянии."
                            },
                            {
                                "example_id": "a4f08922-59f9-4ffe-9dbb-10fa33140391",
                                "sense_id": "5f8e46cb-4b09-3ecf-acc6-aee1a5bd1678",
                                "text": "В субботу вечером друзья пришли к Генке и изумились при виде обильно и празднично накрытого стола."
                            },
                            {
                                "example_id": "2286c9b9-9c5c-431c-8d8f-612074ead94d",
                                "sense_id": "5f8e46cb-4b09-3ecf-acc6-aee1a5bd1678",
                                "text": "― Начальник! ― изумился Валька Карзубин. ― Ты разве куришь?"
                            }
                        ]
                    }
                ],
