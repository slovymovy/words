                ],
                "senses": [
                    {
                        "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                        "entry_id": "5ae2c8b0-4fc0-31f4-8d49-d5981d9ae70a",
                        "glosses": [
                            "Rasenmäher, der das zerkleinerte Schnittgut wieder auswirft, statt es aufzufangen, um den Boden zu mulchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fcbc4f4-d416-48d2-ab52-6f131bbefccc",
                                "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                                "text": "„Mulchmäher sind wegen ihres höheren Kraftbedarfs fast nur mit Benzinmotor zu haben.“"
                            },
                            {
                                "example_id": "c228576f-2c17-49f4-b2a4-d2498080b70e",
                                "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                                "text": "„Eine tolle Entwicklung der letzten Jahre sind Mulchmäher: Sie zerhäckseln die Halme besonders fein und lassen sie zurück auf den Rasen rieseln.“"
                            },
                            {
                                "example_id": "464d4497-7ea4-4cb3-9874-884953dc37be",
                                "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                                "text": "„Die Firma Toro drehte einen Videofilm, um einen automatischen Mulchmäher vorzustellen.“"
                            },
                            {
                                "example_id": "b6ad338b-cc9e-4e85-9ba5-cd6c305578ba",
                                "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                                "text": "„Außerdem ist Düngen überflüssig, wenn durch einen Mulchmäher verrottendes Material liegen bleibt.“"
                            },
                            {
                                "example_id": "e99f19f0-8c1c-42fa-a0b1-960e52564f9d",
                                "sense_id": "32b3cefb-ec44-3220-8397-ec9e9da08b0f",
                                "text": "„Gar keinen Rasenschnitt haben Sie, wenn Sie einen Mulchmäher benutzen, der den Rasenschnitt sogleich zerkleinert und dem Rasen wieder beimischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
