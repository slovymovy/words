                            "plural"
                        ],
                        "form": "overabundances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd03a07a-b744-3173-9119-b63be0e1027d",
                        "entry_id": "313f2f36-b680-3462-9bc7-17fa8bc63a5f",
                        "glosses": [
                            "An excess of what is needed or is appropriate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fadc9d9-6de1-456a-89d2-efed92269552",
                        "source_entry_id": "313f2f36-b680-3462-9bc7-17fa8bc63a5f",
                        "source_sense_id": "fd03a07a-b744-3173-9119-b63be0e1027d",
                        "source_sense_description": "excess of what is needed or is appropriate",
                        "target_lang_word": "surabondance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surabondance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                        "entry_id": "4fe4b74d-323c-3deb-bc2a-7b4a152584ee",
                                        "glosses": [
                                            "Très grande abondance, abondance qui va au-delà du nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77194b47-7fa4-4e80-8293-3b239ebaee32",
                                                "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                                "text": "Le comte des Essarts , parti de Versailles le 9 Février, pour se rendre à sa terre des Essarts, ayant trouvé que la route de traverse de Damville aux Essarts étoit impraticable & dangereuse par la surabondance des neiges, se vit forcé de rester plusieurs jours à Damville chez le procureur fiscal."
                                            },
                                            {
                                                "example_id": "3dc4d78e-bcf5-42ac-97e4-f73bdfa7ab71",
                                                "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                                "text": "Quand je pense au gâchis des tropiques, au désordre des fleurs, des fruits, à ce luxe, cette profusion, cette surabondance scandaleuse jetée par la terre à pleins bras au premier venu, qui n’a rien fait pour ça, ne l’a pas mérité !..."
                                            },
                                            {
                                                "example_id": "bae4df43-af57-4271-a921-b2bed72fbc17",
                                                "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                                "text": "Mais à l'âge de la sérénité cette préoccupation ne se pose plus : l'homme est débordé par la surabondance des possibles qui redondent des valeurs qu'il contemple, si du moins sa destinée est réussie."
                                            },
                                            {
                                                "example_id": "d98a4491-1da5-4443-958c-aecaecdb4cdf",
                                                "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                                "text": "À un point tel qu’un des défis majeurs auxquels nous faisons face aujourd’hui est la surabondance de l’information."
                                            },
                                            {
                                                "example_id": "9f62e461-e50f-41eb-88d8-77465708319c",
                                                "sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                                                "text": "Comble de bonheur, elle était accompagnée de sa stagiaire, belle brune grassouillette dotée d'une surabondance mammaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ad516f4-651f-4a6b-8187-a87cf72fd4ee",
                        "source_entry_id": "313f2f36-b680-3462-9bc7-17fa8bc63a5f",
                        "source_sense_id": "fd03a07a-b744-3173-9119-b63be0e1027d",
                        "source_sense_description": "excess of what is needed or is appropriate",
                        "target_lang_word": "Überfluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überfluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine über den Bedarf vorhandene Menge an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df166c37-ddca-4ef6-a704-f87c3cadb6d8",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Denn hier findet sich der ganze Wahnsinn einer Industriegesellschaft wieder, die glaubt, fossile Energie im Überfluss zu haben."
                                            },
                                            {
                                                "example_id": "dded9fc2-39ea-4bc2-bd2b-b03aa81d904a",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Sonnenenergie ist mit dem Faktor 10.000 im Überfluss vorhanden“, so Hubert Fechner, Geschäftsfeldleiter für Erneuerbare Energietechnologien bei Arsenal Research."
                                            },
                                            {
                                                "example_id": "a94f12c7-d38e-419d-8aae-2067950b546c",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Telekom-Guru George Gilder geht trotzdem davon aus, dass es Bandbreite auf Dauer im Überfluss gibt."
                                            },
                                            {
                                                "example_id": "2d11cd30-9e35-4dec-8076-d21e238b9a27",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Auch Diogenes wurde von Seneca als weiser Mann bezeichnet, weil er dem Überfluss entsagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine Lebenslage, die mehr als das zum Leben Notwendige bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef74b8d4-2d73-4b41-927a-30475726d9ac",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "\"Was krank macht, ist gut; was aus der Fülle, aus dem Überfluss, aus der Macht kommt, ist böse\" so empfindet der Gläubige."
                                            },
                                            {
                                                "example_id": "1b614335-8d16-4bd6-9ccc-02805a2311a8",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Dem zufälligen Mangel in einer einzelnen Provinz wurde sofort durch den Überfluss ihrer begünstigteren Nachbarn abgeholfen."
                                            },
                                            {
                                                "example_id": "fb6912b6-8bf0-474e-a5e9-c5bdc8978c85",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Ein Mann aber trat aus der Menge heraus und sprach voll Bitterkeit und sagte: \"Herr weißt du nicht, dass das Leben der Armen aus dem Überfluss des Reichen strömt? …\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
