            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af5a9193-1b85-3920-afb4-0275319d0c1d",
                    "sense_definition": "Simple past and past participle of <w>settle</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They finally <w>settled</w> the dispute after hours of discussion.",
                            "target_lang_translations": {
                                "ru": "Они наконец <w>уладили</w> спор после многочасового обсуждения.",
                                "fr": "Ils ont finalement <w>résolu</w> le différend après des heures de discussion.",
                                "pl": "W końcu <w>rozstrzygnęli</w> spór po wielu godzinach dyskusji."
                            }
                        },
                        {
                            "text": "She <w>settled</w> down in a comfortable chair to read.",
                            "target_lang_translations": {
                                "ru": "Она <w>устроилась</w> в удобном кресле, чтобы почитать.",
                                "fr": "Elle s'est <w>installée</w> dans un fauteuil confortable pour lire.",
                                "pl": "<w>Rozgościła się</w> w wygodnym fotelu, aby poczytać."
                            }
                        }
                    ],
                    "common_phrases": [
                        "settled down",
                        "settled the matter",
                        "settled in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола settle.",
                        "fr": "Passé et participe passé du verbe settle.",
                        "pl": "Forma czasu przeszłego (past simple) i imiesłów czasu przeszłego (past participle) od czasownika settle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "разрешить спор или конфликт"
                            },
                            {
                                "target_lang_word": "устроиться",
                                "target_lang_sense_clarification": "занять удобное положение"
                            },
                            {
                                "target_lang_word": "поселиться",
                                "target_lang_sense_clarification": "начать жить в новом месте"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "résoudre",
                                "target_lang_sense_clarification": "pour un conflit ou un différend"
                            },
                            {
                                "target_lang_word": "s'installer",
                                "target_lang_sense_clarification": "pour prendre une position confortable ou habiter quelque part"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozwiązać",
                                "target_lang_sense_clarification": "spór, konflikt lub problem"
                            },
                            {
                                "target_lang_word": "rozstrzygnąć",
                                "target_lang_sense_clarification": "kwestię, spór"
                            },
                            {
                                "target_lang_word": "rozgościć się",
                                "target_lang_sense_clarification": "wygodnie usiąść, ułożyć się"
                            },
                            {
                                "target_lang_word": "osiedlić się",
                                "target_lang_sense_clarification": "zamieszkać gdzieś na stałe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a12b733-3db6-32a6-8a9f-14715fdbcf93",
                    "sense_definition": "Comfortable and at ease, especially after a period of change or unrest.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took me a while to feel <w>settled</w> after I moved to this big city.",
                            "target_lang_translations": {
                                "ru": "Мне потребовалось некоторое время, чтобы <w>освоиться</w> после переезда в этот большой город.",
                                "fr": "Il m'a fallu du temps pour me sentir <w>bien installé</w> après avoir déménagé dans cette grande ville.",
                                "pl": "Zajęło mi trochę czasu, aby poczuć się <w>zaaklimatyzowanym</w> po przeprowadzce do tego wielkiego miasta."
                            }
                        },
                        {
                            "text": "Now that we are <w>settled</w> in our new home, we can invite guests.",
                            "target_lang_translations": {
                                "ru": "Теперь, когда мы <w>обустроились</w> в нашем новом доме, мы можем приглашать гостей.",
                                "fr": "Maintenant que nous sommes <w>bien installés</w> dans notre nouvelle maison, nous pouvons inviter des amis.",
                                "pl": "Teraz, kiedy jesteśmy już <w>urządzeni</w> w nowym domu, możemy zaprosić gości."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfortable",
                        "relaxed"
                    ],
                    "antonyms": [
                        "unsettled",
                        "restless"
                    ],
                    "common_phrases": [
                        "feel settled",
                        "get settled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий себя комфортно и спокойно, особенно после периода перемен; обжившийся.",
                        "fr": "Se sentir à l'aise et tranquille, particulièrement après une période de changement ou d'instabilité.",
                        "pl": "Czujący się swobodnie, spokojnie i bezpiecznie, zwłaszcza po okresie zmian lub niepewności; zadomowiony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обустроившийся",
                                "target_lang_sense_clarification": "наладивший быт на новом месте"
                            },
                            {
                                "target_lang_word": "освоившийся",
                                "target_lang_sense_clarification": "привыкший к новой обстановке"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "bien installé",
                                "target_lang_sense_clarification": "qui a pris ses marques dans un nouveau lieu"
                            },
                            {
                                "target_lang_word": "habitué",
                                "target_lang_sense_clarification": "qui s'est adapté à un nouvel environnement"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zadomowiony",
                                "target_lang_sense_clarification": "czujący się jak u siebie w nowym miejscu"
                            },
                            {
                                "target_lang_word": "zaaklimatyzowany",
                                "target_lang_sense_clarification": "przyzwyczajony do nowych warunków"
                            },
                            {
                                "target_lang_word": "ustabilizowany",
                                "target_lang_sense_clarification": "o sytuacji życiowej lub emocjonalnej"
                            },
                            {
                                "target_lang_word": "urządzony",
                                "target_lang_sense_clarification": "w nowym mieszkaniu lub miejscu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
