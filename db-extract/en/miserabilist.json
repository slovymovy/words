                        "glosses": [
                            "Miserable, pessimistic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8d77b9-7d2b-4ab1-84b5-c926b3b1c80a",
                                "sense_id": "0bd8f8bd-11bb-3afa-8d05-218f78638119",
                                "text": "This is a radical difference between the naturalism of the miserabilist approach, and the naturalism practiced by the Romanian New Wave."
                            }
                        ]
                    }
                ],
