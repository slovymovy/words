                "senses": [
                    {
                        "sense_id": "b2b4961c-22db-3777-ab47-50071626e68b",
                        "entry_id": "7132a7ab-d791-38b1-81c5-7307768e9a9e",
                        "glosses": [
                            "Internet-Datentransfer aus der Sicht des Sendenden; das Kopieren von Daten als Server auf einen oder mehrere andere Rechner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7b1561-cdf4-4a80-baa3-f8e71989fab9",
                                "sense_id": "b2b4961c-22db-3777-ab47-50071626e68b",
                                "text": "Ich habe den Upload abgebrochen."
                            },
                            {
                                "example_id": "0721e8d7-c209-445c-8ca9-7f6187896030",
                                "sense_id": "b2b4961c-22db-3777-ab47-50071626e68b",
                                "text": "„Nach Upload von Daten, Lebenslauf, Zeugnissen und einem allgemeinen Bewerbungsschreiben können sich die Nutzer mit wenigen Klicks für eines oder mehrere Angebote bewerben.“"
                            },
                            {
                                "example_id": "49cc45e2-7c22-482f-bb03-67ad7d10ce93",
                                "sense_id": "b2b4961c-22db-3777-ab47-50071626e68b",
                                "text": "„Der Mann, der fünf offene WLAN-Hotspots und zwei Übergangsknoten zum Tor-Netzwerk betreibt, weist die Verantwortung für illegale Uploads von sich.“"
                            },
                            {
                                "example_id": "10950df5-579a-4c0d-a9e5-5df91d724fd0",
                                "sense_id": "b2b4961c-22db-3777-ab47-50071626e68b",
                                "text": "„Wer die neue Bilder-App des Suchmaschinisten löscht, verhindert damit unter Umständen nicht den Upload weiterer Fotos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
