                                    {
                                        "sense_id": "3f4dc416-a933-3c5e-88dd-3567a2742485",
                                        "entry_id": "6d2e49f7-17b3-3f8d-a92a-0a25f6552e05",
                                        "glosses": [
                                            "To twinkle; to sparkle."
                                        ],
