{
    "word_family": [
        "burrower",
        "burrowing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6707f884-a75f-3ea1-acdf-35582549cb9d",
                    "sense_definition": "A tunnel or hole dug in the ground by a small animal, such as a rabbit, for habitation or shelter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burrow_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit quickly disappeared into its <w>burrow</w> when it heard the dog barking.",
                            "target_lang_translations": {
                                "ru": "Кролик быстро скрылся в своей <w>норе</w>, услышав лай собаки."
                            }
                        },
                        {
                            "text": "We found a deep <w>rabbit burrow</w> hidden under the roots of the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Мы нашли глубокую <w>кроличью нору</w>, спрятанную под корнями старого дуба."
                            }
                        }
                    ],
                    "synonyms": [
                        "tunnel",
                        "hole",
                        "warren"
                    ],
                    "common_phrases": [
                        "rabbit burrow",
                        "deep burrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Туннель или нора, вырытая в земле мелким животным, например кроликом, для обитания или укрытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нора",
                                "target_lang_sense_clarification": "жилище животного под землей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e2cc26-e831-3306-946e-731ec909a902",
                    "sense_definition": "An obsolete form of <w>barrow</w> (a mound of earth or stones over an ancient grave).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>burrow</w> on the hill was excavated by archaeologists last summer.",
                            "target_lang_translations": {
                                "ru": "Древний <w>курган</w> на холме был раскопан археологами прошлым летом."
                            }
                        },
                        {
                            "text": "In old texts, this burial mound is referred to as a <w>burrow</w>.",
                            "target_lang_translations": {
                                "ru": "В старых текстах этот могильный холм упоминается как <w>курган</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "barrow",
                        "mound"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used historically to mean a burial mound"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова barrow (курган из земли или камней над древней могилой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курган",
                                "target_lang_sense_clarification": "древнее захоронение"
                            },
                            {
                                "target_lang_word": "могильный холм",
                                "target_lang_sense_clarification": "историческое захоронение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38c7955a-5370-304b-bfd8-d9efc9d266ac",
                    "sense_definition": "An obsolete form of <w>borough</w> (an incorporated town).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval charter granted special trading rights to the local <w>burrow</w>.",
                            "target_lang_translations": {
                                "ru": "Средневековая хартия даровала особые торговые права местному <w>городу</w>."
                            }
                        },
                        {
                            "text": "He researched how the ancient <w>burrow</w> was governed during the fourteenth century.",
                            "target_lang_translations": {
                                "ru": "Он исследовал, как управлялся древний <w>город</w> в четырнадцатом веке."
                            }
                        }
                    ],
                    "synonyms": [
                        "borough",
                        "town"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "spelling variant of borough"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова borough (самоуправляющийся город)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "город",
                                "target_lang_sense_clarification": "небольшой средневековый город с самоуправлением"
                            },
                            {
                                "target_lang_word": "боро",
                                "target_lang_sense_clarification": "административная единица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16f1f7a5-8d6a-35d9-b15c-950916e7938c",
                    "sense_definition": "To dig a tunnel or hole, especially for habitation or shelter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burrow_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rabbits like to <w>burrow</w> deep into the soft soil of the meadow.",
                            "target_lang_translations": {
                                "ru": "Кролики любят <w>рыть норы</w> глубоко в мягкой почве луга."
                            }
                        },
                        {
                            "text": "The small rodents <w>burrow</w> underground to escape the cold winter winds.",
                            "target_lang_translations": {
                                "ru": "Мелкие грызуны <w>зарываются</w> под землю, чтобы спастись от холодных зимних ветров."
                            }
                        }
                    ],
                    "synonyms": [
                        "dig",
                        "tunnel",
                        "excavate"
                    ],
                    "common_phrases": [
                        "burrow underground",
                        "burrow deep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыть туннель или нору, особенно для обитания или укрытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыть нору",
                                "target_lang_sense_clarification": "делать подземное жилище"
                            },
                            {
                                "target_lang_word": "прокапывать",
                                "target_lang_sense_clarification": "делать ходы под землей"
                            },
                            {
                                "target_lang_word": "зарываться",
                                "target_lang_sense_clarification": "уходить под землю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79b9b0ae-c53f-31a3-b344-7de84ba6f01a",
                    "sense_definition": "To nestle, snuggle, or press close to something for warmth, safety, or comfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burrow_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child loved to <w>burrow</w> under the blankets on cold winter mornings.",
                            "target_lang_translations": {
                                "ru": "Ребенок любил <w>зарываться</w> под одеяло холодными зимними утрами."
                            }
                        },
                        {
                            "text": "She would <w>burrow</w> into the blankets to escape the drafty air of the bedroom.",
                            "target_lang_translations": {
                                "ru": "Она <w>зарывалась</w> в одеяла, чтобы спастись от сквозняка в спальне."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuggle",
                        "nestle",
                        "cuddle"
                    ],
                    "common_phrases": [
                        "burrow into the blankets",
                        "burrow under the covers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уютно устроиться, зарыться или прижаться к чему-либо для тепла, безопасности или комфорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарываться",
                                "target_lang_sense_clarification": "прятаться под одеяло, в постель"
                            },
                            {
                                "target_lang_word": "утыкаться",
                                "target_lang_sense_clarification": "прижиматься лицом"
                            },
                            {
                                "target_lang_word": "уютно устраиваться",
                                "target_lang_sense_clarification": "гнездиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b8b386a-149b-3000-b243-551178588673",
                    "sense_definition": "To investigate or search searchingly and thoroughly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burrow_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective had to <w>burrow</w> into old archives to find the missing documents.",
                            "target_lang_translations": {
                                "ru": "Детективу пришлось <w>порыться</w> в старых архивах, чтобы найти пропавшие документы."
                            }
                        },
                        {
                            "text": "She began to <w>burrow</w> into the details of the company's financial history.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>копаться</w> в деталях финансовой истории компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "delve",
                        "investigate",
                        "probe"
                    ],
                    "common_phrases": [
                        "burrow into details",
                        "burrow into archives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и глубоко исследовать или искать информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "искать в бумагах, архивах"
                            },
                            {
                                "target_lang_word": "копаться",
                                "target_lang_sense_clarification": "изучать детали, подробности"
                            },
                            {
                                "target_lang_word": "докапываться",
                                "target_lang_sense_clarification": "выяснять суть"
                            }
                        ]
                    }
                }
            ]
        },
        {
