                            {
                                "example_id": "d9f5b54c-3065-45a7-9e39-1f4d22808584",
                                "sense_id": "8664dc7f-26a4-3c78-82c8-72bf333f8627",
                                "text": "Sie arbeitet als Gehilfin in einer Kanzlei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "287a3e26-3685-3fff-93a6-2ebb575589ea",
                        "entry_id": "6f12e535-d392-3eff-943b-0a0a4991fcac",
                        "glosses": [
                            "weibliche Person, die bei bestimmten Arbeiten als Hilfe mitwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a7bad3-5eda-4e0b-aab3-649078adaa7f",
                                "sense_id": "287a3e26-3685-3fff-93a6-2ebb575589ea",
                                "text": "Sie hat im Hotel des Bruders als Gehilfin mitgearbeitet."
                            },
                            {
                                "example_id": "33aa5878-d140-4803-a05a-762856f800d0",
                                "sense_id": "287a3e26-3685-3fff-93a6-2ebb575589ea",
                                "text": "„Justine weigert sich, seine Gehilfin zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b6f66f58-434e-3f3a-a136-a22c89c2eda6",
                        "entry_id": "6f12e535-d392-3eff-943b-0a0a4991fcac",
                        "glosses": [
                            "weibliche Person, die bei einer Straftat unterstützend mitgewirkt hat"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
