                        "cross_references": [
                            {
                                "target_word": "Kondensstreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb4fa7b-81c8-3d69-8599-e600d8f9a0aa",
                                        "entry_id": "8458f2ed-41b3-360d-bdca-252fb426418a",
                                        "glosses": [
                                            "künstliche Wolken, die von den Abgasen von Flugzeugen oder Raketen erzeugt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f6c749f-b8c4-4c51-b847-850f7154bb71",
                                                "sense_id": "4eb4fa7b-81c8-3d69-8599-e600d8f9a0aa",
                                                "text": "Vom Flugzeug war nur noch der Kondensstreifen zu sehen."
                                            },
                                            {
                                                "example_id": "4e1244c8-bddc-493d-a7d7-0119c9c372ea",
                                                "sense_id": "4eb4fa7b-81c8-3d69-8599-e600d8f9a0aa",
                                                "text": "„Das dumpfe Dröhnen der Geschwader, die hoch über den Köpfen ihre weißen Kondensstreifen ins Blau malten, klingt vielen Älteren noch heute grausam in den Ohren.“"
                                            },
                                            {
                                                "example_id": "f39c10e5-b69f-4dd9-b5f9-9485b971972a",
                                                "sense_id": "4eb4fa7b-81c8-3d69-8599-e600d8f9a0aa",
                                                "text": "„Fliegen schadet dem Klima nicht nur aufgrund der direkten CO₂-Emissionen aus der Verbrennung von Kerosin, sondern auch, weil Flugzeuge Kondensstreifen am Himmel hinterlassen, die als starke Treibhausgase wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff12aac1-d66e-3fcd-85d2-2471599e0027",
                                        "entry_id": "8458f2ed-41b3-360d-bdca-252fb426418a",
                                        "glosses": [
                                            "Abrieb von Fäkalien in der Unterhose"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7368f961-8a7d-4f8a-ac04-3d732f775520",
                                                "sense_id": "ff12aac1-d66e-3fcd-85d2-2471599e0027",
                                                "text": "„Ekelhafter Typ mit Bierfleck auf dem Schlabbershirt und Kondensstreifen in der Hose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
