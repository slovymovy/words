                                "target_lang_word": "saman",
                                "target_lang_sense_clarification": "tarımsal malzeme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稻草",
                                "target_lang_sense_clarification": "农业材料"
                            },
                            {
                                "target_lang_word": "麦秆",
                                "target_lang_sense_clarification": "谷物茎秆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89c0e733-462a-3169-841d-0098c41675dd",
                    "sense_definition": "A single dried stalk of a cereal plant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He picked up a <w>straw</w> from the ground and twisted it in his fingers.",
                            "target_lang_translations": {
                                "ru": "Он поднял с земли <w>соломинку</w> и покрутил её в пальцах.",
                                "tr": "Yerden bir <w>saman</w> çöpü aldı ve parmaklarının arasında çevirdi.",
                                "zh": "他从地上捡起一根<w>稻草</w>，在指间揉搓。"
                            }
                        },
                        {
                            "text": "The bird carried a <w>straw</w> in its beak to help build the nest.",
                            "target_lang_translations": {
                                "ru": "Птица несла в клюве <w>соломинку</w>, чтобы построить гнездо.",
                                "tr": "Kuş, yuva yapımına yardımcı olması için gagasında bir <w>saman</w> çöpü taşıdı.",
                                "zh": "鸟儿衔着一根<w>稻草</w>去筑巢。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "last straw",
                        "short straw",
                        "clutch at straws"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один сухой стебель злакового растения.",
                        "tr": "Tahıl bitkisinin tek bir kuru sapı.",
                        "zh": "谷物植物的一根干燥茎秆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соломинка",
                                "target_lang_sense_clarification": "стебелёк"
                            },
