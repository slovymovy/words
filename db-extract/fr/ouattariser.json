                        "glosses": [
                            "Donner un caractère rappelant Alassane Ouattara à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958cfd86-0078-497f-ae53-81daf2b7aef3",
                                "sense_id": "09785b37-3b58-3164-b3b3-c8c7c45f4a60",
                                "text": "Pas question de ouattariser le Pdci dont le nom fait partie du patrimoine de la Côte d’Ivoire et qui a une représentativité beaucoup plus large que le Rdr semble revendiquer la base du parti cinquantenaire."
                            },
                            {
                                "example_id": "3fb6f519-a233-43bf-8542-6495cd6420b8",
                                "sense_id": "09785b37-3b58-3164-b3b3-c8c7c45f4a60",
                                "text": "Il paraîtrait qu'Alain JUPPE, notre Ministre des Affaires étrangères (le meilleur d'entre-nous d'après CHIRAC) est en train de se \"ouattariser\"."
                            },
                            {
                                "example_id": "31e2c66d-ab64-42ef-a1e9-7ae834b7c99d",
                                "sense_id": "09785b37-3b58-3164-b3b3-c8c7c45f4a60",
                                "text": "Il veut OUATTARISER le Mali !"
                            }
                        ]
