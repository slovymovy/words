        "nl-extract.jsonl": [
            {
                "entry_id": "0291df9f-3580-3392-987a-b208d8693e01",
                "word": "verontwaardigen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ec0cce0-b386-3d6d-8fbf-4d1a550158c8",
                        "entry_id": "0291df9f-3580-3392-987a-b208d8693e01",
                        "glosses": [
                            "boos maken; woedend maken; sterk afkeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815218b5-31f4-4da6-8d29-8745d4a57a52",
                                "sense_id": "0ec0cce0-b386-3d6d-8fbf-4d1a550158c8",
                                "text": "Het zou ons tot op het bot moeten verontwaardigen dat de bombardementen, chemische aanvallen en wreedheden tegen de burgerbevolking nog steeds in alle vormen doorgaan. Het zou ons witheet van woede moeten maken dat de massamoord in Oost-Ghouta, een buitenwijk van Damascus, zich in volle hevigheid, maar onder onze internationale radar voltrekt. HP de Tijd 23/02"
                            },
                            {
                                "example_id": "48e6c718-069f-4b76-a170-bd257def81d6",
                                "sense_id": "0ec0cce0-b386-3d6d-8fbf-4d1a550158c8",
                                "text": "Ik wil echter in deze uitspraak geen veroordeeling gelegd zien van onze maatschappelijke ontwikkeling. Het is even onzinnig de onafwendbare ontwikkeling der maatschappij goed of af tekeuren, als zich te verontwaardigen over den loop der jaargetijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4fec0af-8a1c-4896-be79-a72e4e6f8943",
                        "source_entry_id": "0291df9f-3580-3392-987a-b208d8693e01",
                        "source_sense_id": "0ec0cce0-b386-3d6d-8fbf-4d1a550158c8",
                        "source_sense_description": "boos maken; woedend maken; sterk afkeuren",
                        "target_lang_word": "annoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0e62f7-ccc9-37c0-8bd8-f43e7c7aae68",
                                        "entry_id": "102b7891-a9bc-3177-9107-8965581fed5b",
                                        "glosses": [
                                            "To disturb or irritate, especially by continued or repeated acts; to bother with unpleasant deeds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14a83ab7-f8d2-44b4-8f3b-f36af1762f3f",
                                                "sense_id": "ec0e62f7-ccc9-37c0-8bd8-f43e7c7aae68",
                                                "text": "Marc loved his sister, but when she annoyed him he wanted to switch her off."
                                            },
                                            {
                                                "example_id": "5ca71d9f-5916-4a80-bb40-5abb534a342d",
                                                "sense_id": "ec0e62f7-ccc9-37c0-8bd8-f43e7c7aae68",
                                                "text": "Yet let me flap this bug with gilded wings, / This painted child of dirt that stinks and stings; / Whose buzz the witty and the fair annoys, / Yet wit ne'er tastes, and beauty ne'r enjoys."
                                            },
                                            {
                                                "example_id": "a6c4ea17-2c88-4133-b21c-21e4a918e610",
                                                "sense_id": "ec0e62f7-ccc9-37c0-8bd8-f43e7c7aae68",
                                                "text": "You Klaestrons are allies of the Cardassians; your knowledge of the station confirms that they must have given you the layouts. Which not only compromises Bajoran security, but also... annoys us."
                                            },
                                            {
                                                "example_id": "9183d05c-aa64-4055-87ed-42196398ec9a",
                                                "sense_id": "ec0e62f7-ccc9-37c0-8bd8-f43e7c7aae68",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result. If the bumf arrived electronically, the take-up rate was 0.1%. And for online adverts the “conversion” into sales was a minuscule 0.01%. That means about $165 billion was spent not on drumming up business, but on annoying people, creating landfill and cluttering spam filters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49366518-2758-3123-a89c-404a59bb0907",
                                        "entry_id": "102b7891-a9bc-3177-9107-8965581fed5b",
                                        "glosses": [
                                            "To do something to upset or anger someone; to be troublesome."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ef74349-87eb-3b2c-9af4-c785e0590c73",
                                        "entry_id": "102b7891-a9bc-3177-9107-8965581fed5b",
                                        "glosses": [
                                            "To molest; to harm; to injure."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb774b77-89f6-44ff-9999-56eaa8cd2f9e",
                                                "sense_id": "8ef74349-87eb-3b2c-9af4-c785e0590c73",
                                                "text": "to annoy an army by impeding its march, or by a cannonade"
                                            },
                                            {
                                                "example_id": "a9321698-cdde-4272-8024-298f38a6bc20",
                                                "sense_id": "8ef74349-87eb-3b2c-9af4-c785e0590c73",
                                                "text": "tapers put into lanterns or sconces of several-coloured, oiled paper, that the wind might not annoy them"
                                            },
                                            {
                                                "example_id": "9b29511d-574d-413b-b4a2-9ab8a7985adf",
                                                "sense_id": "8ef74349-87eb-3b2c-9af4-c785e0590c73",
                                                "text": "Say, what can more our tortured souls annoy / Than to behold, admire, and lose our joy?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "annoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7343847e-ee91-301d-b21d-5338ac2dbf47",
                                        "entry_id": "839e08b9-1b43-3c1a-aeaa-353d24b04c94",
                                        "glosses": [
                                            "A feeling of discomfort or vexation caused by what one dislikes."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0541ddd4-bf13-498b-b35b-c431cd6b5707",
                                                "sense_id": "7343847e-ee91-301d-b21d-5338ac2dbf47",
                                                "text": "VVe that ſuffer long anoy / Are contented vvith a thought / Through an idle fancie vvrought / O let my ioyes have ſome abiding."
                                            },
                                            {
                                                "example_id": "042fb726-2fee-4ba9-9503-74de4cd680c6",
                                                "sense_id": "7343847e-ee91-301d-b21d-5338ac2dbf47",
                                                "text": "[I]f she says he was defeated, why he had better, a great deal, have been defeated, than give her a moment's annoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba30fb69-1b14-3196-9c7b-6f2f8b1ddcab",
                                        "entry_id": "839e08b9-1b43-3c1a-aeaa-353d24b04c94",
                                        "glosses": [
                                            "That which causes such a feeling."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013f6e78-c2e6-4af2-b14f-f9815b9dd3e4",
                                                "sense_id": "ba30fb69-1b14-3196-9c7b-6f2f8b1ddcab",
                                                "text": "Sleepe in Peace, and wake in Ioy, / Good Angels guard thee from the Boares annoy […]"
                                            },
                                            {
                                                "example_id": "13ff0482-ebfd-471e-987e-5b7ca3af9242",
                                                "sense_id": "ba30fb69-1b14-3196-9c7b-6f2f8b1ddcab",
                                                "text": "The home far and away, the distance where lives joy, / The cure, at once and ever, of world and world's annoy; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d48d1e5c-a81d-4975-af10-036dc61b2cab",
                        "source_entry_id": "0291df9f-3580-3392-987a-b208d8693e01",
                        "source_sense_id": "0ec0cce0-b386-3d6d-8fbf-4d1a550158c8",
                        "source_sense_description": "boos maken; woedend maken; sterk afkeuren",
                        "target_lang_word": "aggravate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggravate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a53957-fa2b-336d-b29b-d8ab2f328f67",
                                        "entry_id": "ac39e17e-22e3-32e7-b254-d1c0aaa31664",
                                        "glosses": [
                                            "To make (an offence) worse or more severe; to increase in offensiveness or heinousness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517c3f90-94ca-4543-a3c3-5b0d438288ae",
                                                "sense_id": "f4a53957-fa2b-336d-b29b-d8ab2f328f67",
                                                "text": "Once more, the more to aggrauate the note,\nWith a foule Traitors name ſtuffe I thy throte,\nAnd wiſh (ſo pleaſe my Soueraigne) ere I moue,\nWhat my tong ſpeaks, my right drawn ſword may proue"
                                            },
                                            {
                                                "example_id": "a1248a29-b381-4250-86ce-f94e4588bb7f",
                                                "sense_id": "f4a53957-fa2b-336d-b29b-d8ab2f328f67",
                                                "text": "The defense made by the prisoner's counsel did rather aggravate than extenuate his crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee010dd-7dd8-3da5-87a2-9b4e45d7f3b3",
                                        "entry_id": "ac39e17e-22e3-32e7-b254-d1c0aaa31664",
                                        "glosses": [
                                            "To make (any bad thing) worse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e88d39a-db0d-47bd-92dc-bf323a83f0bd",
                                                "sense_id": "4ee010dd-7dd8-3da5-87a2-9b4e45d7f3b3",
                                                "text": "to aggravate my woes."
                                            },
                                            {
                                                "example_id": "58292d41-d48a-46bb-9a7f-7fed494effbb",
                                                "sense_id": "4ee010dd-7dd8-3da5-87a2-9b4e45d7f3b3",
                                                "text": "[…] to aggravate the horrors of the scene"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee01dbe-7407-3316-91f0-dcaba7beb1a3",
                                        "entry_id": "ac39e17e-22e3-32e7-b254-d1c0aaa31664",
                                        "glosses": [
                                            "To give extra weight or intensity to; to exaggerate, to magnify."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04daf571-f204-4c00-be5f-51b4815c1f5e",
                                                "sense_id": "9ee01dbe-7407-3316-91f0-dcaba7beb1a3",
                                                "text": "He aggravated the story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51304ad5-db51-3de2-bde3-b990184471eb",
                                        "entry_id": "ac39e17e-22e3-32e7-b254-d1c0aaa31664",
                                        "glosses": [
                                            "To pile or heap (something heavy or onerous) on or upon someone."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d624d82-c943-4aee-933a-d8c681eae9f5",
                                                "sense_id": "51304ad5-db51-3de2-bde3-b990184471eb",
                                                "text": "In order to lighten the crown still further, they aggravated responsibility on ministers of state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c9be14-9217-3a89-b1dd-1ca88d8a61a8",
                                        "entry_id": "ac39e17e-22e3-32e7-b254-d1c0aaa31664",
                                        "glosses": [
                                            "To exasperate; to provoke or irritate."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "often",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2b7eb9-51b7-4a27-9414-abc176f98011",
                                                "sense_id": "81c9be14-9217-3a89-b1dd-1ca88d8a61a8",
                                                "text": "If both were to aggravate her parents, as my brother and sister do mine."
                                            },
                                            {
                                                "example_id": "4a4fcbd0-cb52-483b-bf83-5cef0f51bc4d",
                                                "sense_id": "81c9be14-9217-3a89-b1dd-1ca88d8a61a8",
                                                "text": "Ben Bella was aggravated by having to express himself in French because the Egyptians were unable to understand his Arabic."
                                            }
                                        ]
                                    }
                                ]
                            },
