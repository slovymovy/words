                                "target_senses": [
                                    {
                                        "sense_id": "4f528050-2490-3a58-87db-bd716c780b06",
                                        "entry_id": "0400764a-6b62-3ba3-81ba-b6cd5fceac85",
                                        "glosses": [
                                            "A stir-fried vegetable dish, served with pieces of beef or pork in a semi-thick sauce, and often soy sauce."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ca20df-03c8-42c3-b90a-fec97fb6c698",
                                                "sense_id": "4f528050-2490-3a58-87db-bd716c780b06",
                                                "text": "On the walls about were the hieroglyphic markings of the craft. Across this scene wafted the pungent fragrance of chop suey, dim sims and other delicacies in course of preparation for the funeral feast."
                                            },
                                            {
                                                "example_id": "29da28db-34bb-4c34-a997-371fa5a7a570",
                                                "sense_id": "4f528050-2490-3a58-87db-bd716c780b06",
                                                "text": "There was feasting and joy from Shanghai to the Wall,\nWhat with dim-sims, chop-suey and crackers and all,\nAnd the donor of these, by the hook of my crook.\nWas Chiang Ki-Konglong, the Mandarin Cook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a868a889-77f9-31a4-a459-8382e8991ce1",
                                        "entry_id": "0400764a-6b62-3ba3-81ba-b6cd5fceac85",
                                        "glosses": [
                                            "Steamed bean sprouts served in a semi-thick sauce, and mixed with a choice of meat and/or vegetables."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d89a395b-8f5c-4596-a902-6ee18a18d155",
                                                "sense_id": "a868a889-77f9-31a4-a459-8382e8991ce1",
                                                "text": "To someone who had spent part of their youth visiting a grandmother in Singapore, a lot of the food they served didn’t seem particularly Chinese to me: the flavour of chop suey with its chicken or pork or prawns, or chow mein, or the omeletty foo yung, never seemed quite right."
                                            }
                                        ]
                                    }
                                ]
