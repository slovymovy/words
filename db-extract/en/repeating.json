                        "target_lang_word": "Periode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Periode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49669ade-abb5-33e8-bd48-113953a08f5b",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "Zeitabschnitt, der durch gemeinsame Merkmale geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1355e9a3-4ae0-42e7-b307-b7afa8362471",
                                                "sense_id": "49669ade-abb5-33e8-bd48-113953a08f5b",
                                                "text": "Dieses Bild ist aus der blauen Periode des Malers."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "weibliche Menstruation"
                                        ],
                                        "tags": [
                                            "Sexualität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0abe571-88d4-4fe7-a720-c89ac1ffccd6",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "Sie hat ihre Periode."
                                            },
                                            {
                                                "example_id": "d563cc4e-58b1-41ed-ab29-eb2886ccc150",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "„An diesem Morgen hat sie ihre Periode bekommen.“"
                                            },
                                            {
                                                "example_id": "5525598e-5916-447b-b975-7950c0a0a763",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "„Es wurde eine Reportage über Contergankinder gesendet, über die Mädchen, die jetzt zum erstenmal ihre Periode bekommen hätten.“"
                                            },
                                            {
                                                "example_id": "7c04a7ce-6b42-4e69-b733-3cce0579a771",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "„Schon bevor ihre Periode ausblieb und ihr Speichel rostig und metallisch schmeckte, vermutete Efe, dass sie schwanger sei.“"
                                            },
                                            {
                                                "example_id": "d0feda74-d1ee-42a4-b2bb-3e4cd477e381",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "„Immer wenn sie ihre Periode bekam, musste sie ihn anrufen.“"
                                            },
                                            {
                                                "example_id": "c6fea32e-bcd3-4749-8157-82b900d2208f",
                                                "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                                                "text": "„Der Umgang von Sportlerinnen mit der Periode während eines Wettkampfs ist bisher meist ein Tabu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18e4749a-9a9a-3d7b-9b4d-fbc6894ebfa7",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "Abstand, nach dem sich ein Ablauf wiederholt"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd52cd2-197e-4eba-9b98-0c3460218623",
                                                "sense_id": "18e4749a-9a9a-3d7b-9b4d-fbc6894ebfa7",
                                                "text": "Die Netzspannung hat eine Periode von 20 ms. Die Sinusfunktion hat eine Periode von 2π."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0cecd28a-3696-3a37-a6a2-9ad6e1922a71",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "bei Darstellung eines Bruches in einem Stellenwertsystem (zum Beispiel im Dezimalsystem) sich wiederholende Ziffernfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbba9706-6d3c-4ba7-a730-d5b80a17e8cd",
                                                "sense_id": "0cecd28a-3696-3a37-a6a2-9ad6e1922a71",
                                                "text": "Vier Drittel ist gleich eins Komma Periode drei ( tfrac 4 3=1,333333333…=1,◌̅3)."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "14232ade-32f8-30c3-8e02-e967ff276caa",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "Menge aufeinanderfolgender Elemente im Periodensystem mit gleicher Anzahl von Elektronenschalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa146d5d-8fbc-464f-a029-6277648982ce",
                                                "sense_id": "14232ade-32f8-30c3-8e02-e967ff276caa",
                                                "text": "Die erste Periode des Periodensystems enthält nur die Elemente Wasserstoff und Helium."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c67822b9-4c8b-3c86-954f-bb25bb7c5946",
                                        "entry_id": "f592d3b3-bf53-3962-b44b-c39c60980e87",
                                        "glosses": [
                                            "komplexer Satz mit mehreren Teilsätzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e304a7b-022e-4952-80ff-1596674f254c",
                                                "sense_id": "c67822b9-4c8b-3c86-954f-bb25bb7c5946",
                                                "text": "Heinrich von Kleist und Thomas Mann sind für ihre Perioden bekannt."
                                            },
                                            {
                                                "example_id": "1e968fe0-2c5d-4753-9f99-fc6182570522",
                                                "sense_id": "c67822b9-4c8b-3c86-954f-bb25bb7c5946",
                                                "text": "„Es gibt zwei Arten langer Satzgefüge (Perioden): den Schachtelsatz und den Kettensatz.“"
                                            },
                                            {
                                                "example_id": "59cf24cd-6c96-44e7-8b73-66f235a0a79a",
                                                "sense_id": "c67822b9-4c8b-3c86-954f-bb25bb7c5946",
                                                "text": "„Von dem Geräusch des sich so laut schließenden Buches peinlich verletzt, ließ Professor Graumilch die begonnene Periode unvollendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
