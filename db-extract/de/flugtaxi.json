                    {
                        "sense_id": "99a04f6b-fca5-3104-a551-0ead5235cc32",
                        "entry_id": "6f4157e8-b886-3ae9-9900-0373946db1a3",
                        "glosses": [
                            "modernes Luftfahrzeug, das zur entgeltlichen Personenbeförderung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432c9929-7612-4b63-aa81-172483aa2768",
                                "sense_id": "99a04f6b-fca5-3104-a551-0ead5235cc32",
                                "text": "„Wer im Flugtaxi sitzt, lacht über jeden Stau!“"
                            },
                            {
                                "example_id": "ae3df0f8-f24f-4a01-8cd3-2b7e1883d81f",
                                "sense_id": "99a04f6b-fca5-3104-a551-0ead5235cc32",
                                "text": "„Das Flugtaxi schafft es in 105 Minuten.“"
                            },
                            {
                                "example_id": "6a08b091-0858-454f-9477-4a216cbe2f53",
                                "sense_id": "99a04f6b-fca5-3104-a551-0ead5235cc32",
                                "text": "„Das Flug-Taxi ähnelt einem Helikopter und kann bis zu einer halben Stunde in der Luft bleiben.“"
                            },
                            {
                                "example_id": "9855f1b2-df35-4550-82ca-d6665a54d86b",
                                "sense_id": "99a04f6b-fca5-3104-a551-0ead5235cc32",
                                "text": "„Während die designierte CSU-Staatsministerin Dorothee Bär schon von Flugtaxis träumt, sind viele Regionen in Deutschland weiterhin vom schnellen Internet abgeschnitten.“"
                            }
                        ],
