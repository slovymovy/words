                                        "sense_id": "494dcce9-87d7-382a-998b-dcca1be47909",
                                        "entry_id": "1a789bc5-6589-3100-b074-40de4d0982b4",
                                        "glosses": [
                                            "Militant antifasciste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d29562-488f-4a3b-bfd4-1a28a6766c0f",
                                                "sense_id": "494dcce9-87d7-382a-998b-dcca1be47909",
                                                "text": "Les agressions entre \"skins\" et \"antifa\", résurgence des années 1980."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antifa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b27b82fc-f76b-33fd-9466-bae033801373",
                                        "entry_id": "dc8391b7-97de-35d1-905c-725220a403b6",
                                        "glosses": [
                                            "Antifasciste."
                                        ],
                                        "tags": [
                                            "Antifascisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925c07a6-3d79-45be-9754-cb97b994cf27",
                                                "sense_id": "b27b82fc-f76b-33fd-9466-bae033801373",
                                                "text": "Comment se fait-il, par exemple, que nous soyons tous convaincus que Donald Trump est l’unique responsable des violences et des émeutes raciales qui ont frappé les États-Unis depuis l’été 2020 sans que nous ne portions attention au rôle de l’extrême gauche antifa et de la frange ultraradicale du mouvement BLM ?"
                                            },
                                            {
                                                "example_id": "bb62047a-1728-4fff-aeb9-8769d9dc4a9b",
                                                "sense_id": "b27b82fc-f76b-33fd-9466-bae033801373",
                                                "text": "Quand j'irais au manifs antifa tu seras parmi ceux qui nous balancent des lacrymo !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antifa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
