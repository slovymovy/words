                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c27157-2a67-382f-92a2-1808ce9a923b",
                                        "entry_id": "215f5ee1-f24a-33a6-b1b9-6768bffdc6dd",
                                        "glosses": [
                                            "Relatif au futurisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1ba38e-b75c-4e44-ab10-4f3149e55f4c",
                                                "sense_id": "e5c27157-2a67-382f-92a2-1808ce9a923b",
                                                "text": "Le nouveau système d’évaluation futuriste fait de l’universel le gnomon du particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                        "entry_id": "215f5ee1-f24a-33a6-b1b9-6768bffdc6dd",
                                        "glosses": [
                                            "Qui donne une impression d’entrer dans le futur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a72e6fc-d635-4307-8b00-4dc5d64f6d58",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "Cette déchetterie futuriste est installée sur une barge de 50 m de long ; cela permet d’optimiser l’espace qui manque dans les centres des grandes villes."
                                            },
                                            {
                                                "example_id": "109c2c76-bfc6-4a60-9e42-d688d3e06e99",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "L’Arabie saoudite organisera les Jeux asiatiques d’hiver de 2029. Ils auront lieu à Neom, une mégapole futuriste en construction dans le désert montagneux du riche État pétrolier, a annoncé, mardi, le Conseil olympique d’Asie."
                                            },
                                            {
                                                "example_id": "d9d66231-6e4f-4881-99c8-7515a902e96c",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "De quoi alimenter des péripéties futuristes, coécrites par Laurent Sarfati, avec lequel le réalisateur avait déjà signé la série Lastman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "futuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                        "entry_id": "83e85aa4-4ffd-3a71-b0ca-6588417026d7",
                                        "glosses": [
                                            "Adepte du futurisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1120da72-056b-419a-8f87-213c74972fdd",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes les plus célèbres sont Filippo Tommaso Marinetti, Giacomo Balla, Umberto Boccioni, Carlo Carrà, Severini et Luigi Russolo."
                                            },
                                            {
                                                "example_id": "68886d2c-b015-4afb-ad28-5d4d1df9b37b",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes feront flèche de tout bois pour assurer leur révolution : l’urbanisme, soit, mais aussi la musique, le vêtement, le cinéma, le roman, autant de domaines oubliés par le surréalisme."
                                            },
                                            {
                                                "example_id": "bf976178-e06b-40a3-ac54-182db248cf88",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes l’avaient senti en 1920. Ils avaient fait de la vitesse un art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
