                },
                {
                    "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                    "sense_definition": "Exercer une influence déterminante ou une autorité sur la conduite de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La raison devrait toujours <w>gouverner</w> nos choix les plus importants."
                        },
                        {
                            "text": "Il refuse catégoriquement de se laisser <w>gouverner</w> par ses émotions au travail."
