                                        "sense_id": "74d5d0e4-6e27-3208-983c-e18d0611e113",
                                        "entry_id": "b9273eaf-479e-31ec-954a-ef5c2131e52b",
                                        "glosses": [
                                            "An obsession with the production of works on a very large scale, such as huge buildings, factories, weapons, or social engineering schemes; such production itself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b05ba5-ed27-44d0-92fb-500d786ee4e5",
                                                "sense_id": "74d5d0e4-6e27-3208-983c-e18d0611e113",
                                                "text": "The issue entered the election campaign when Schroeder's shadow culture minister, Michael Naumann, compared the memorial designs to the gigantomania of Hitler's achitect, Albert Speer. He said that none of his American Jewish friends were in favour of the memorial and that it should be cancelled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
