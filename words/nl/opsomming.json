    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d8c8871-cd69-3557-a4ff-5d42c06ee485",
                    "sense_definition": "een reeks items die onder elkaar of achter elkaar zijn geplaatst",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lijst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar maakte een duidelijke <w>opsomming</w> van de belangrijkste jaartallen op het bord.",
                            "target_lang_translations": {
                                "en": "The teacher made a clear <w>list</w> of the most important dates on the board."
                            }
                        },
                        {
                            "text": "In dit rapport vind je een korte <w>opsomming</w> van de gemaakte kosten.",
                            "target_lang_translations": {
                                "en": "In this report, you will find a short <w>summary</w> of the costs incurred."
                            }
                        }
                    ],
                    "synonyms": [
                        "oplijsting",
                        "enumeratie",
                        "lijst"
                    ],
                    "common_phrases": [
                        "een korte opsomming",
                        "opsomming van feiten"
                    ],
                    "target_lang_definitions": {
                        "en": "a series of items placed one after another or in a list"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "list",
                                "target_lang_sense_clarification": "a series of names or items written down"
                            },
                            {
                                "target_lang_word": "enumeration",
                                "target_lang_sense_clarification": "a detailed mention of items one by one"
                            },
                            {
                                "target_lang_word": "summary",
                                "target_lang_sense_clarification": "a brief statement or account of the main points"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51191009-6091-3610-a0a9-0e26bebac682",
                    "sense_definition": "het proces van het bij elkaar optellen of verzamelen van gegevens tot een resultaat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "berekening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een volledige <w>opsomming</w> van de verliezen bleek de schade groter dan verwacht.",
                            "target_lang_translations": {
                                "en": "After a complete <w>summation</w> of the losses, the damage turned out to be greater than expected."
                            }
                        },
                        {
                            "text": "Als we een <w>opsomming</w> maken van alle uren, komen we op een hoog totaal uit.",
                            "target_lang_translations": {
                                "en": "If we <w>tally up</w> all the hours, we arrive at a high total."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opsomming maken"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of adding up or collecting data to reach a total result"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "summation",
                                "target_lang_sense_clarification": "the process of adding things together"
                            },
                            {
                                "target_lang_word": "tally",
                                "target_lang_sense_clarification": "a current score or amount"
                            },
                            {
                                "target_lang_word": "calculation",
                                "target_lang_sense_clarification": "the process of using numbers to find an amount"
                            }
                        ]
                    }
                }
            ]
        }
    ]
