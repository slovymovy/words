                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ccccb73-1a44-421c-ae52-f6d586590d9d",
                                "sense_id": "4f78e4e0-fadd-3f51-b20f-8da2170f3f3d",
                                "text": "In Lent noblemen and carls alike had got into the traces and pulled the carts of stone themselves."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e83fa90-46ba-3eb6-b657-44c01aa2f44a",
