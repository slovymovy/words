                "senses": [
                    {
                        "sense_id": "c07b7b92-0d52-3476-be13-a035ee758087",
                        "entry_id": "cb11121b-9498-375f-9fcd-fcd67de92e38",
                        "glosses": [
                            "To occur after an event or time; to exist later on in time."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0f66d1b7-5452-4820-98c6-60fd156fd06e",
                                "sense_id": "c07b7b92-0d52-3476-be13-a035ee758087",
                                "text": "Because these prophecies of Isaiah postdate the fall of Babylon (539 B.C.E), they probably refer to that event."
                            },
                            {
                                "example_id": "47f45f7d-3738-441f-a93a-bdd99a93c48c",
                                "sense_id": "c07b7b92-0d52-3476-be13-a035ee758087",
                                "text": "For example, the FAQ page comments that ‘the term “incel” is an abbreviated version and sniglonym of the term “involuntary celibacy,” whose usage reaches back at least to the 18th century.”’ The term ‘sniglonym’ is itself an example of deploying verbose language. The word refers to a term whose date of coinage postdates the pre-existing concept or object it defines."
                            }
                        ]
                    },
                    {
                        "sense_id": "36a09752-3cb1-30e0-acd1-f115ca760309",
                        "entry_id": "cb11121b-9498-375f-9fcd-fcd67de92e38",
                        "glosses": [
                            "To assign an effective date to a document or action later than the actual date."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9002a24f-1119-4d57-84af-8d974a6d9255",
                                "sense_id": "36a09752-3cb1-30e0-acd1-f115ca760309",
                                "text": "no postdated checks [sign in a retail store]"
                            },
                            {
                                "example_id": "973c5c1f-594c-4128-9f12-23d4dd857229",
                                "sense_id": "36a09752-3cb1-30e0-acd1-f115ca760309",
                                "text": "to postdate a contract, that is, to date it later than the time when it was in fact made"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0e42afc-324b-3426-a1d7-f1b320f9eb21",
                        "entry_id": "cb11121b-9498-375f-9fcd-fcd67de92e38",
                        "glosses": [
                            "To affix a date to after the event."
                        ],
