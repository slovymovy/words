                "senses": [
                    {
                        "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                        "entry_id": "5fdf4fa8-22d3-38c8-ac11-7c2406e86b5a",
                        "glosses": [
                            "Unternehmen, das Klingeltöne anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2fc8cff-f82e-412c-bea6-0cd703c13fb6",
                                "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                                "text": "„Der US-Konzern News Corporation, der dem Medienunternehmer Rupert Murdoch gehört, wird 51 Prozent der Anteile am Berliner Klingeltonanbieter Jamba kaufen.“"
                            },
                            {
                                "example_id": "f1f89c51-1da6-438e-b5d3-85650d66f044",
                                "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                                "text": "„Der Klingeltonanbieter Jamba bestreitet Probleme beim Aufbau seines Musikportals.“"
                            },
                            {
                                "example_id": "f2ff03ea-80df-4a2c-b149-b23f92d989ec",
                                "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                                "text": "„Gerade am Musikgeschmack lassen sich Persönlichkeit und Charaktereigenschaften gut erkennen, glaubt Agnieszka Zyluk vom Klingeltonanbieter Jamba in Berlin.“"
                            },
                            {
                                "example_id": "09a4f702-1389-4867-bf64-118479254b93",
                                "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                                "text": "„Bis zu fünf Euro nehmen Klingeltonanbieter ihren meist jugendlichen Kunden ab.“"
                            },
                            {
                                "example_id": "643d80dc-49c6-48d4-9bf5-097cf877e026",
                                "sense_id": "92564f12-5b21-366f-9547-7746ee26a4f4",
                                "text": "„Die Brüder Oliver, Marc und Alexander Samwer haben unter anderem den Klingeltonanbieter Jamba gegründet und später für mehr als 270 Millionen US-Dollar verkauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
