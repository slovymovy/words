                ],
                "senses": [
                    {
                        "sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                        "entry_id": "5130e39c-dcbc-3d9c-bc81-bcfca3b37290",
                        "glosses": [
                            "der zunächst vor allem als Schrift- und Sakralsprache verwendete, spezielle von den 1492 aus Spanien vertriebenen Juden beibehaltene jüdisch-spanische Dialekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506839b0-3861-4c49-8bec-f502e9dad960",
                                "sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                                "text": "„Als kleinere iberische Sprache ist Portugiesisch mit unserem Ladino verwandt.“"
                            },
                            {
                                "example_id": "db4b8477-b548-447b-a844-ef70796c3401",
                                "sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                                "text": "„Im 16. und 17. Jahrhundert entsproß dem Spaniolischen eine Variante, das für Liturgie und religiöses Schriftum bestimmte Ladino.“"
                            },
                            {
                                "example_id": "621d8177-c1ca-42f6-b7d1-b96fbd12f2db",
                                "sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                                "text": "„Die einflußreichste Gruppe sind die Sepharden, deren historisches Identitätssymbol das Judenspanische (Ladino) ist.“"
                            },
                            {
                                "example_id": "7ebe14c6-24dd-4f64-b3da-0b255ef92e28",
                                "sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                                "text": "„So entwickelten sich eigene Judensprachen: Das Spaniolische/Ladino in Spanien auf spanischer Basis verbreitete sich über den gesamten Mittelmeerraum, es war die Gemeinsprache der sephardischen Juden…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f753696-7271-42d7-90dc-8f8c63e8de4c",
                        "source_entry_id": "5130e39c-dcbc-3d9c-bc81-bcfca3b37290",
                        "source_sense_id": "c549ce0b-1834-3fe7-aaa1-f58be71b978b",
                        "target_lang_word": "ladino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c146f400-e049-3901-b661-c617f39adb82",
                                        "entry_id": "a8e4b483-b6d9-359c-a361-2fb89b7fc85c",
                                        "glosses": [
                                            "Alternative letter-case form of Ladino (“mestizo”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bfd9292-490d-4c3e-b2e9-10437cd2e538",
                                                "sense_id": "c146f400-e049-3901-b661-c617f39adb82",
                                                "text": "In the production of the ladino the white element has almost always been represented by the father […]"
                                            },
                                            {
                                                "example_id": "e3e38ff2-19dc-48c8-9011-0c3fbe209017",
                                                "sense_id": "c146f400-e049-3901-b661-c617f39adb82",
                                                "text": "Yolanda's fluctuation between mestizo and ladino is symptomatic of this analytical dilemma. Her inclination to embrace mestizaje signals a deep process of social change underway, in which critical ladino / mestizo self-making has played [a part...]"
                                            },
                                            {
                                                "example_id": "36b6e87a-cce0-4a77-b726-d9a3f9acc387",
                                                "sense_id": "c146f400-e049-3901-b661-c617f39adb82",
                                                "text": "Differentiated from both mulat(t)o and ladino, mestizo/mestico references specifically the mixing of white and Indian, whether phenotypically (simply in terms of the offspring of mixed intercourse) or culturally, and even linguistically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192b456c-e11d-3502-8e2d-dd2ccc2c9b68",
                                        "entry_id": "a8e4b483-b6d9-359c-a361-2fb89b7fc85c",
                                        "glosses": [
                                            "A cunningly vicious, wild or unmanageable horse."
                                        ],
                                        "tags": [
                                            "Southeastern",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
