                    },
                    {
                        "form_id": "5ae72e72-8072-4168-95bc-d44890e6d095",
                        "entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "tags": [
                            "past"
                        ],
                        "form": "wangled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4d99d4c-b4e2-3b62-bd97-85d2c7bb274b",
                        "entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "glosses": [
                            "To obtain through deceitful or manipulative methods."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c563db9-e400-4c14-8f0d-5d35ae0badda",
                                "sense_id": "f4d99d4c-b4e2-3b62-bd97-85d2c7bb274b",
                                "text": "“My dear old lad,” he said, briskly, “this must be remedied! Oh, positively! This must be remedied at once! I suppose my things wouldn’t fit you? No. Well, I tell you what. We’ll wangle something from my father-in-law."
                            },
                            {
                                "example_id": "59d1f352-d07d-45e5-8d7f-e1a66d55b29a",
                                "sense_id": "f4d99d4c-b4e2-3b62-bd97-85d2c7bb274b",
                                "text": "After graduation, she was hired by United Press International, which on one memorable occasion sent her to cover a show by Elvis Presley in Detroit. She wangled an invitation to the singer’s hotel room, where one thing led to another."
                            }
                        ]
                    },
                    {
                        "sense_id": "e462e50c-8513-35cc-955d-b9b1a09e2244",
                        "entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "glosses": [
                            "To falsify, as records."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "04c9c7b9-a419-3ca5-8ae1-949bb2dec8b6",
                        "entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "glosses": [
                            "To achieve through contrivance or cajolery."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95edfe00-7183-4811-a573-f88f58edf513",
                                "sense_id": "04c9c7b9-a419-3ca5-8ae1-949bb2dec8b6",
                                "text": "He tried to wangle an extra ticket to the concert, but it was sold out."
                            },
                            {
                                "example_id": "b077cc87-9f99-4e24-b1b6-2b49d7e83264",
                                "sense_id": "04c9c7b9-a419-3ca5-8ae1-949bb2dec8b6",
                                "text": "She managed to wangle an invitation to the exclusive event."
                            },
                            {
                                "example_id": "ed4ac31d-3479-41cf-960c-706715a8bbf9",
                                "sense_id": "04c9c7b9-a419-3ca5-8ae1-949bb2dec8b6",
                                "text": "It took some effort to wangle a last-minute meeting with the CEO."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c9e374f-1b71-4150-a7d7-6996355e2203",
                        "source_entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
