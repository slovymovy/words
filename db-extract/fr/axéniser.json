                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f08f1578-a6d3-4817-b18b-a8e3b62821ff",
                                "sense_id": "f4dcb13c-5549-3e2c-af8c-44906318e111",
                                "text": "Les méthodes employées pour axéniser les Cyanophycées sont nombreuses mais aucune n'est universelle et l'on sera parfois amené à utiliser plusieurs techniques avant d'obtenir une souche pure."
                            },
                            {
                                "example_id": "44695cd0-5d2c-4885-88f1-6911256de1e9",
                                "sense_id": "f4dcb13c-5549-3e2c-af8c-44906318e111",
                                "text": "La population à axéniser est lavée de la surface d'agar avec du milieu liquide neuf, ensuite cette suspension est ensemencée en veinotube et incubée à 28e et 37° C."
                            }
                        ]
                    }
