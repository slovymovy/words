{
    "word_family": [
        "unleash"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ecc9d31-8d38-357f-88ec-bca296cdd738",
                    "sense_definition": "Not wearing a leash; allowed to move freely.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park has a special area where dogs can run <w>unleashed</w>.",
                            "target_lang_translations": {
                                "nl": "Het park heeft een speciaal gebied waar honden <w>los</w> kunnen rennen."
                            }
                        },
                        {
                            "text": "Please keep your dog on a lead, as <w>unleashed</w> pets can scare small children.",
                            "target_lang_translations": {
                                "nl": "Houd uw hond alstublieft aan de lijn, aangezien <w>loslopende</w> huisdieren kleine kinderen bang kunnen maken."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrestrained",
                        "loose"
                    ],
                    "antonyms": [
                        "leashed"
                    ],
                    "common_phrases": [
                        "unleashed dog"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet aan de lijn; vrij om te bewegen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "los",
                                "target_lang_sense_clarification": "niet vastgehouden of aangelijnd"
                            },
                            {
                                "target_lang_word": "vrij",
                                "target_lang_sense_clarification": "zonder beperkingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f782c3-b58b-321e-9317-eb5f1a58bda0",
                    "sense_definition": "Released from control or restraint; allowed to act or express itself fully.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new coach <w>unleashed</w> the team's hidden talent during the final match.",
                            "target_lang_translations": {
                                "nl": "De nieuwe coach <w>ontketende</w> het verborgen talent van het team tijdens de laatste wedstrijd."
                            }
                        },
                        {
                            "text": "The storm <w>unleashed</w> its full power on the small coastal village.",
                            "target_lang_translations": {
                                "nl": "De storm <w>ontketende</w> zijn volledige kracht op het kleine kustdorp."
                            }
                        }
                    ],
                    "synonyms": [
                        "released",
                        "unlocked",
                        "unleashed"
                    ],
                    "antonyms": [
                        "restrained",
                        "contained"
                    ],
                    "common_phrases": [
                        "unleashed potential",
                        "unleashed power"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bevrijd van controle of beperking; volledig tot uiting gekomen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontketend",
                                "target_lang_sense_clarification": "losgelaten van krachten of emoties"
                            },
                            {
                                "target_lang_word": "losgelaten",
                                "target_lang_sense_clarification": "vrijgegeven van controle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4266deed-d79c-3b81-b7c9-c7df9bbfd5c2",
                    "sense_definition": "Simple past and past participle of <w>unleash</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>unleashed</w> a new marketing campaign last week.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf <w>lanceerde</w> vorige week een nieuwe marketingcampagne."
                            }
                        },
                        {
                            "text": "He <w>unleashed</w> his anger after hearing the bad news.",
                            "target_lang_translations": {
                                "nl": "Hij <w>liet</w> zijn woede <w>de vrije loop</w> na het horen van het slechte nieuws."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van 'ontketenen' of 'loslaten'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontketende",
                                "target_lang_sense_clarification": "verleden tijd van ontketenen"
                            },
                            {
                                "target_lang_word": "losgelaten",
                                "target_lang_sense_clarification": "voltooid deelwoord van loslaten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}