                        "source_sense_id": "9a18d2c0-b590-38ec-9178-26782fa97470",
                        "source_sense_description": "scheikundig element met symbool W en atoomnummer 74",
                        "target_lang_word": "Wolfram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wolfram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                        "entry_id": "32bf899a-06f2-315d-ab91-e3bf49e4f920",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 74, das zur Serie der Übergangsmetalle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c539bec-7667-42eb-9471-203551557844",
                                                "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                                "text": "Wolfram wird als Glühwendel in Glühlampen verwendet."
                                            },
                                            {
                                                "example_id": "45aaf2bd-1a4a-4ed5-8c52-7994869ede1f",
                                                "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                                "text": "„Den gewonnenen Raum in der Waffenkammer musste ich allein mit Wolfram auffüllen, da sich dort schon ein Einzelner kaum bewegen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolfram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85b2a7b7-46fd-346d-a9a3-143cbed3ade8",
                                        "entry_id": "6933abc0-a74e-3977-93ed-70221ccae04a",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31111d9b-52ce-44b0-bfab-556d3e7236b5",
                                                "sense_id": "85b2a7b7-46fd-346d-a9a3-143cbed3ade8",
                                                "text": "Gestern ging Wolfram ins Kino."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolfram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                        "entry_id": "43bbf042-7807-3672-a80b-3eeb3a14a00a",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e86f926-08da-452f-80f5-2b3ac85d50af",
                                                "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                                "text": "Die Wolfram hat schon wieder die Musik so laut."
                                            },
                                            {
                                                "example_id": "02fbd134-2715-489f-9749-2587ae954840",
                                                "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                                "text": "Mit den Wolframs sollte man sich nicht anlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6922585a-0da2-42d6-bfef-134921fb4077",
                        "source_entry_id": "911dd03c-b23a-3651-aa37-6c7fef3ac078",
                        "source_sense_id": "9a18d2c0-b590-38ec-9178-26782fa97470",
                        "source_sense_description": "scheikundig element met symbool W en atoomnummer 74",
                        "target_lang_word": "tungsten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tungsten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "A rare metallic chemical element (symbol W, from Latin wolframium) with an atomic number of 74."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16111632-debc-4b47-912c-cab6ca08439d",
                                                "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                                "text": "So far they have built and used a prototype robot to make millionth-of-a-meter scratches in aluminum with a fine tungsten needle."
                                            },
                                            {
                                                "example_id": "3fada3e2-aea3-4521-a9f0-11e4d7900eb7",
                                                "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                                "text": "Which makes the concept known as Rods From God the ultimate form of kinetic weaponry. This theoretical weapon would drop telephone pole sized rods of dense tungsten from a satellite in orbit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "A light bulb containing tungsten."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae36f97-9337-4647-8ceb-2ffc3024b443",
                                                "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                                "text": "We have several business houses where tungstens are used as window lights only, and find that in nearly every one the wiring was arranged to get more light, leaving the consumption about the same."
                                            },
                                            {
                                                "example_id": "15624afe-f951-4589-b6b9-ae778f6cdc77",
                                                "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                                "text": "Lighting was unimaginative for the standard stock with naked tungsten filament bulbs and metal reflectors. However, all compartments had individual reading lights above the seats with attractive glass shades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc496f3-b064-33d6-a452-bd3d5c30101a",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "scheelite, calcium tungstate"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28e14d8-1df1-4443-a6e7-23a401a8f38e",
                                                "sense_id": "5dc496f3-b064-33d6-a452-bd3d5c30101a",
                                                "text": "We apprehend that this is not the acid of a calx ponderoſa, but rather a diſtinct acid conjoined to common calcareous earth, ſince, in fact, in another place, § 97, the tungſten is mentioned as a calx ſaturated with a peculiar acid, perhaps of a metallic nature, for which the author himſelf refers us to the above § 33, and ſeems to think it the ſame as the acid there mentioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9393fc3-4dee-4399-9ab4-c2f3c16aacbe",
