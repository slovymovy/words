                "senses": [
                    {
                        "sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
                        "entry_id": "89f8074d-2c80-3fd9-8109-f8cdcf045549",
                        "glosses": [
                            "Qui concerne ou évoque le jazz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d808d9d-cfa6-42c9-9c66-ad5c62871e04",
                                "sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
                                "text": "Dans l’ensemble, cette exposition jazzique, complétée par Rapsody in blue, de Gershwîn, John Shag 35, de Vellones, et Impressions de music-hall, de G. Pierné (de beaucoup les plus musiciennes) confirmait qu’une formule accidentelle et toute locale ne peut suffire à alimenter une évolution."
                            },
                            {
                                "example_id": "fec62f91-85b4-4fd5-a403-d3bf6d8e1eb6",
                                "sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
                                "text": "Clyde Hart, c’est le printemps sur un trottoir fleuri, c’est le soleil, c’est l'air... il y a certainement d’autres façons de dire ça, mais ne sacrifions pas au tour de potier de la poésie jazzique."
                            },
                            {
                                "example_id": "f3fb69a5-0d56-4409-848f-78e302cb55b2",
                                "sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
                                "text": "Normalement, le son nouveau de ma musique aurait dû m’apporter la notoriété due aux jazzmen originaux, de tout temps l’élite de la gent jazzique."
                            },
                            {
                                "example_id": "e387b514-93f2-4962-aae2-9c91a3a5f374",
                                "sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
                                "text": "Le seul titre à avoir un peu de saveur jazzique est O Caroline, où Daniel Darc joue avec les improvisations de Joce Mienniel à la flûte et de Vincent Lafont aux claviers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea8a124e-a709-48f5-bf05-06e98cfa1489",
                        "source_entry_id": "89f8074d-2c80-3fd9-8109-f8cdcf045549",
                        "source_sense_id": "19a461a5-7eaf-3178-9660-d17b6940f945",
