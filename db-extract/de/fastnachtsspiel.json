                "senses": [
                    {
                        "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                        "entry_id": "84bb92bf-da86-31be-a43b-b537ea751ea6",
                        "glosses": [
                            "Szenische Burleske in der Tradition der Mysterienspiele als Bestandteil der Karnevalskultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53a8d1c-0770-4961-a6ee-68b327e32288",
                                "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                                "text": "„Das mittelalterliche Kult- und Fastnachtsspiel und noch die Shakespeare-Bühne kennen diese Form.“"
                            },
                            {
                                "example_id": "80bc183e-e43d-4ce7-8f33-d364ea87b964",
                                "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                                "text": "„Das Nibelungenlied, Wolframs Parzival, die Carolina Burana, Hans Sachsens Fastnachtspiele – das sind die wenigen Werke, die man (vielleicht) nicht nur dem Hörensagen nach kennt.“"
                            },
                            {
                                "example_id": "4f937b48-59c6-4dcb-9a85-9e7840c9c54b",
                                "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                                "text": "„Weitere Neueinträge auf der Liste sind das Choralsingen, die Volkstanzbewegung, die manuelle Glasfertigung und das ehrsame Narrengericht in Grosselfingen, ein jahrhundertealtes Fastnachtsspiel in Baden-Württemberg.“"
                            },
                            {
                                "example_id": "6fa28097-f422-4684-b732-2253f9590018",
                                "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                                "text": "„Mehr als ein Kichern gestattete der Rat des alten, mächtigen Nürnberg den durch Zunftregeln botmäßig gehaltenen und sexuell frustrierten Handwerksgesellen (Heiratsverbot!) alljährlich in ihren unflätigen Fastnachtsspielen.“"
                            },
                            {
                                "example_id": "28f907cf-8a79-4d68-98d4-b62dffcc18f9",
                                "sense_id": "dac785d4-00c5-3984-92d4-517d21da874b",
                                "text": "„Das beweist nicht bloß die Geschichte des Welttheaters mit Fastnachtsspielen, kultischen Aktionen und Ritualen, mit dem Hanswurst und dem Marionettentheater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
