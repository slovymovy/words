{
    "word_family": [
        "ijdelheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1278f8c6-ebae-301d-8594-5731b40f3f96",
                    "sense_definition": "Vol van zelfbewondering en overdreven bezorgd over of trots op het eigen uiterlijk of prestaties.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zelfbewondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is zo <w>ijdel</w> dat hij wel tien keer per dag in de spiegel kijkt.",
                            "target_lang_translations": {
                                "en": "He is so <w>vain</w> that he looks in the mirror at least ten times a day."
                            }
                        },
                        {
                            "text": "Zij is een <w>ijdele</w> vrouw die uren besteedt aan haar make-up.",
                            "target_lang_translations": {
                                "en": "She is a <w>vain</w> woman who spends hours on her makeup."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwaand",
                        "koket"
                    ],
                    "antonyms": [
                        "bescheiden"
                    ],
                    "common_phrases": [
                        "een ijdele man",
                        "ijdel gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "Full of self-admiration and excessively concerned with or proud of one's own appearance or achievements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "excessively proud of one's appearance or achievements"
                            },
                            {
                                "target_lang_word": "conceited",
                                "target_lang_sense_clarification": "having an excessively high opinion of oneself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "570479ce-bb58-375d-bb64-34529f9c837b",
                    "sense_definition": "Zonder reële grond of kans op succes; vergeefs of onrealistisch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergeefs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was <w>ijdele</w> hoop dat de vermiste reizigers nog levend gevonden zouden worden.",
                            "target_lang_translations": {
                                "en": "It was <w>idle</w> hope that the missing travelers would still be found alive."
                            }
                        },
                        {
                            "text": "Al hun pogingen om de ruzie bij te leggen bleken uiteindelijk <w>ijdel</w> te zijn.",
                            "target_lang_translations": {
                                "en": "All their attempts to settle the argument ultimately proved to be <w>futile</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergeefs",
                        "nutteloos",
                        "ongegrond"
                    ],
                    "antonyms": [
                        "zinvol"
                    ],
                    "common_phrases": [
                        "ijdele hoop",
                        "ijdele pogingen"
                    ],
                    "target_lang_definitions": {
                        "en": "Without real ground or chance of success; futile or unrealistic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "producing no result; useless"
                            },
                            {
                                "target_lang_word": "futile",
                                "target_lang_sense_clarification": "incapable of producing any useful result; pointless"
                            },
                            {
                                "target_lang_word": "idle",
                                "target_lang_sense_clarification": "without substance or basis, as in 'idle hope'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca917660-a1a0-3bd5-8f4b-65fe91400651",
                    "sense_definition": "Onbeduidend, waardeloos of zonder wezenlijke betekenis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbeduidend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij weigerde haar tijd te verdoen aan <w>ijdele</w> praatjes over de buren.",
                            "target_lang_translations": {
                                "en": "She refused to waste her time on <w>idle</w> gossip about the neighbors."
                            }
                        },
                        {
                            "text": "De filosoof sprak over het <w>ijdele</w> streven naar materiële rijkdom.",
                            "target_lang_translations": {
                                "en": "The philosopher spoke about the <w>vain</w> pursuit of material wealth."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeduidend",
                        "waardeloos",
                        "nietig"
                    ],
                    "antonyms": [
                        "waardevol",
                        "belangrijk"
                    ],
                    "common_phrases": [
                        "ijdele praat",
                        "ijdel streven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak in formele of literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Insignificant, worthless, or without substantial meaning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idle",
                                "target_lang_sense_clarification": "meaningless or insignificant, as in 'idle chatter'"
                            },
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "devoid of real value or worth"
                            },
                            {
                                "target_lang_word": "empty",
                                "target_lang_sense_clarification": "having no real substance or value"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}