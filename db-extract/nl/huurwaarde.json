                        "glosses": [
                            "de hoeveelheid geld die men als huur zou kunnen vragen; de hoeveelheid huur die iets kan opleveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724556b7-9bc9-428e-9c9a-d62569604e52",
                                "sense_id": "dd020a33-88e0-33e8-b194-fa45f4a907e8",
                                "text": "Daarom wordt ook het huurwaardeforfait ingevoerd: een belasting op de fictieve huurwaarde van de woning."
                            },
                            {
                                "example_id": "51fe992e-e38c-46da-bfa4-91cc4972c964",
                                "sense_id": "dd020a33-88e0-33e8-b194-fa45f4a907e8",
                                "text": "De wet wordt wel op een aantal gebieden aangepast. Verhuurders van woningen met een laag energielabel moeten extra werk maken van energiemaatregelen. Verhuurders van tochtige woningen krijgen minder punten in het systeem dat de huurwaarde bepaalt. Zo wordt een huurder die een hoge energierekening heeft, extra geholpen."
                            }
                        ]
                    }
