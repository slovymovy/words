                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bıkkın",
                                "target_lang_sense_clarification": "Bir durumdan dolayı sabrı tükenmiş ve rahatsız olmuş."
                            },
                            {
                                "target_lang_word": "öfkeli",
                                "target_lang_sense_clarification": "Rahatsızlık sonucu oluşan kızgınlık hali."
