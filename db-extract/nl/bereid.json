                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fc12d68-b318-332b-bb75-b33dcf982b7b",
                        "entry_id": "66f2f850-99be-3d51-8f92-76b963ef5111",
                        "glosses": [
                            "eerste persoon enkelvoud tegenwoordige tijd van bereiden"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "09bfd64b-ceab-4fc7-a8a8-1118d8c7e4a4",
                                "sense_id": "9fc12d68-b318-332b-bb75-b33dcf982b7b",
                                "text": "Ik bereid."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b7a5c32-f8f2-302b-885b-9564607f5fca",
                        "entry_id": "66f2f850-99be-3d51-8f92-76b963ef5111",
                        "glosses": [
                            "gebiedende wijs van bereiden"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "74e0700f-f4da-4aef-ba3b-d0eb26ba9e3e",
                                "sense_id": "0b7a5c32-f8f2-302b-885b-9564607f5fca",
                                "text": "Bereid!"
                            }
                        ]
                    },
                    {
                        "sense_id": "dd407139-5c6d-3fc4-abb7-f811fb56b3fe",
                        "entry_id": "66f2f850-99be-3d51-8f92-76b963ef5111",
                        "glosses": [
                            "tweede persoon enkelvoud tegenwoordige tijd van bereiden"
                        ],
                        "tags": [
                            "form-of",
                            "inversion"
                        ],
                        "examples": [
                            {
                                "example_id": "58eeca13-5c6d-4290-980e-9dd5178627fa",
                                "sense_id": "dd407139-5c6d-3fc4-abb7-f811fb56b3fe",
                                "text": "Bereid je?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                        "entry_id": "66f2f850-99be-3d51-8f92-76b963ef5111",
                        "glosses": [
                            "voltooid deelwoord van bereiden"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a7a9f7-8bc5-4502-8ce7-8cbf70ddd1ed",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "Hij had een heerlijke maaltijd voor ons bereid."
                            },
                            {
                                "example_id": "7bcf5e4d-dd75-493e-9bae-4bfe2ffda3b4",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "Acetosal wordt bereid door het acetyleren van salicylzuur."
                            },
                            {
                                "example_id": "ff5a4286-69a6-40ee-a9bf-9b3b6496d652",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "De maaltijd is bereid door een chef-kok."
                            },
                            {
                                "example_id": "a94c281a-6bbe-4c07-bffa-753be90b1559",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "Ben je bereid om vandaag over te werken?"
                            },
                            {
                                "example_id": "88e14143-cadf-4aac-9efe-87870047fb3a",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "Als Lana inderdaad bereid is in te gaan op meer vragen van de pers, dan is onze naam voorgoed bezoedeld."
                            },
                            {
                                "example_id": "60169062-3b03-435c-98f6-f264117d61d4",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "Dat vraagt nu eenmaal offers die we niet altijd bereid of in staat zijn te brengen - en kust niet alleen een ongekende liefde en zorgzaamheid in ons wakker, maar confronteert ons ook keer op keer met de ongeduldigste, wrokkigste en lichtst ontvlambare kanten van onszelf."
                            },
                            {
                                "example_id": "a59163c6-5348-4d18-b790-80b7e346f498",
                                "sense_id": "fa9ddac1-7fdd-3c82-93e9-eee30bb9275b",
                                "text": "De viering werd afgesloten met een door de oudercommissie bereide maaltijd."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
