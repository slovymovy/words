                ],
                "senses": [
                    {
                        "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                        "entry_id": "56060c4b-e691-3b12-9b60-d8dbfa3e7586",
                        "glosses": [
                            "eine streunende, verwilderte Katze (oft Hauskatze), die von den Besitzern ausgesetzt wurde oder davon lief und die ursprünglich keine Wildkatze ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e8be9a-e1e3-4a97-ae87-81a1d37a050d",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "„Streunerkatzen sind verwilderte Hauskatzen, sie haben keinen Besitzer, sind heimatlos, werden gejagt, verscheucht, erschossen, überfahren, vergiftet.“"
                            },
                            {
                                "example_id": "a1da2640-22d5-419a-ad60-f3b92f6394ee",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "Vor einigen Tagen war ihm eine völlig verwahrloste und abgemagerte Streunerkatze zugelaufen; aus Mitleid nahm er sie bei sich auf und bot ihr ein neues Heim, Geborgenheit, Zuwendung und Nahrung."
                            },
                            {
                                "example_id": "6cbed29b-74de-4c60-ba76-c255c2c17915",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "„Infestationsquellen sind häufig Katzen und Hunde, die keiner ausreichenden Parasitenkontrolle unterliegen sowie Streunerkatzen, die durch kleine Öffnungen in Schuppen, Gartenlauben, Keller, u.ä. gelangen und dabei Floheier verlieren …“"
                            },
                            {
                                "example_id": "90a2f04e-816b-41fa-b42b-eda7c8c910f6",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "„Tatsache ist, dass unkastrierte, versorgte Hauskatzen zum Leid der Streunerkatzen beitragen, da sie die Umgebung unsicher machen und für Streuner-Nachwuchs sorgen.“"
                            },
                            {
                                "example_id": "305b2c13-337e-46b5-9e82-f859ab78a374",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "„Aber für Katzen, die reine Hauskatzen sind, also das unabhängige Leben als Streunerkatze aufgrund ihrer Konstitution und allgemeinen Lebenseinstellung nicht für sich realisieren könnten, ist es im Tierheim immer noch besser als in der ‚Wildnis‘ draußen.‘"
                            },
                            {
                                "example_id": "e1c0ee3a-7268-4521-a2d8-65f4351db33b",
                                "sense_id": "2e0018dd-5e18-347d-9f11-9081666af2a4",
                                "text": "„Die Würstel schmecken derartig nach Hammel, dass wir sie nicht hinunter bekommen und für die Streunerkatzen am Campingplatz mitnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
