                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345d1711-fb96-4dad-8de1-ea2babf41325",
                                "sense_id": "f011a848-aca6-3cb6-9653-7ae47cbb3da4",
                                "text": "„Nach wie vor kommen die Modellbahner nicht vom Fleck.“"
                            },
                            {
                                "example_id": "b25d8b8d-3a11-446a-b261-e717bd06edf0",
                                "sense_id": "f011a848-aca6-3cb6-9653-7ae47cbb3da4",
                                "text": "„Die Modellbahner entspannen sich hier.“"
                            },
                            {
                                "example_id": "3733217c-b127-4d50-a642-f8dedb8a0d18",
                                "sense_id": "f011a848-aca6-3cb6-9653-7ae47cbb3da4",
                                "text": "„Das geht aus der Modellbahn-Marktanalyse 2004 hervor, die der Bundesverband Deutscher Eisenbahn-Freunde (BDEF) gerade in Zusammenarbeit mit der Marktforschung und Internetagentur Baining (www.modellbahn-links.de) vorgestellt hat und an der sich fast 9000 Modellbahner beteiligt haben.“"
                            }
                        ],
