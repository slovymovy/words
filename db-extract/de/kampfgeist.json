                ],
                "senses": [
                    {
                        "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                        "entry_id": "bb8fa142-47c9-39b7-8d5f-7fab8faa082b",
                        "glosses": [
                            "Bereitschaft, zu kämpfen/sich zu wehren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c784d1-3789-40ea-96ec-f889d4e2342f",
                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                "text": "„Seit der große Fisch im seichten Wasser war, hatte er das letzte bißchen Kampfgeist verloren.“"
                            },
                            {
                                "example_id": "bf86e80e-3230-4969-8da9-1d69d1b45675",
                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                "text": "„Mit einem eindringlichen Appell an den Kampfgeist seiner Partei hat Gerhard Schröder die SPD auf die heiße Phase des Wahlkampfs eingeschworen.“"
                            },
                            {
                                "example_id": "9e729543-7f50-4619-b88e-46b9aa2ab9ab",
                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                "text": "„Wladimir Klitschko hat seinen Kampfgeist zurückgewonnen und eine Revanche gegen seinen Bezwinger Tyson Fury angekündigt.“"
                            },
                            {
                                "example_id": "81b68358-8e98-4c0a-bc5f-0901ec221f4b",
                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                "text": "„Ohne Rücksicht auf seine eigene Sicherheit hat er sich einer überwältigenden Übermacht gestellt, und er hat aus reiner Willenskraft und aufgrund seines Kampfgeistes und Mutes gewonnen.“"
                            },
                            {
                                "example_id": "bd3ee5eb-585c-4203-b4bc-80b9686c0b2a",
                                "sense_id": "ea5850b7-d3f7-3f0d-a1cd-f6ecd6fe8275",
                                "text": "„Er kämpfte am Platz um jeden Punkt und speziell am Sandplatz machte er mit seinem Kampfgeist die Gegner mürbe. Jeder Punkt musste gegen ihn zwei Mal gemacht werden. Er schaffte schon aussichtslose Spiele nach Rückstand von 2 Sätzen zu gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
