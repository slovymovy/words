                "senses": [
                    {
                        "sense_id": "abeb029f-9337-3b0d-9901-b0e42a243dbf",
                        "entry_id": "1439b76c-dad5-3ec9-b250-ce401868d859",
                        "glosses": [
                            "ein Most, der gerade begonnen hat zu gären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8d87d3-4a1b-42dc-96c5-38fbb723adbd",
                                "sense_id": "abeb029f-9337-3b0d-9901-b0e42a243dbf",
                                "text": "„Wichtig ist, dass zum Sauser überhaupt gegessen wird, denn auf leeren Magen macht er seinem Namen alle Ehre und steigt sausend in den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91d2f54c-f533-41ef-80cc-969144bd73e0",
                        "source_entry_id": "1439b76c-dad5-3ec9-b250-ce401868d859",
                        "source_sense_id": "abeb029f-9337-3b0d-9901-b0e42a243dbf",
                        "source_sense_description": "ein Most, der gerade begonnen hat zu gären",
                        "target_lang_word": "сусло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сусло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11d5fc79-f1a8-3d3d-9532-af3bc149c4f6",
                                        "entry_id": "99c2d16c-8856-3962-8ee9-f0fdcd18b16b",
                                        "glosses": [
                                            "неперебродивший отвар крахмалистых и сахаристых веществ, идущий на изготовление кваса, пива"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac8719e8-434d-329c-8521-bc6ff23151e3",
                                        "entry_id": "99c2d16c-8856-3962-8ee9-f0fdcd18b16b",
                                        "glosses": [
                                            "сладковатый напиток, настоянный на солоде и муке в старом крестьянском быту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eddb0126-061d-4f27-9fb4-e66e01d9c054",
                                                "sense_id": "ac8719e8-434d-329c-8521-bc6ff23151e3",
                                                "text": "Снова уселись за столы, снова налили, на этот раз сусла, за которым бегали домой к Иннокентию Ивановичу. Сам он, как все, не понес, выждал подходящий момент и объявил, что у него есть сусло, чтоб каждый знал: Иннокентия Ивановича сусло. Но оно и верно было хорошо ― тягучее, обманчиво-сладкое, хмельное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "830e6a9e-f0a1-3276-9105-55162799d7c8",
                                        "entry_id": "99c2d16c-8856-3962-8ee9-f0fdcd18b16b",
                                        "glosses": [
                                            "сок винограда, получаемый после его отжима, прессования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bb597d-5142-4ccf-9054-dd6b9ecd05dc",
                                                "sense_id": "830e6a9e-f0a1-3276-9105-55162799d7c8",
                                                "text": "Следует отметить, что изучение буферных свойств сусел имеет не только теоретическое значение, но и практическое, так как буферные свойства играют существенную роль при купажах сусел и вин."
                                            },
                                            {
                                                "example_id": "06bd7932-bf53-42a6-899a-234d3b886be4",
                                                "sense_id": "830e6a9e-f0a1-3276-9105-55162799d7c8",
                                                "text": "Особенно строгий контроль следует установить за соками и концентрированными суслами, в которых понижение концентрации меди не могло произойти за счёт спиртового брожения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
