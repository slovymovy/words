                "senses": [
                    {
                        "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                        "entry_id": "38e9aaa5-f3ec-30e9-8d1f-5869b178d8b8",
                        "glosses": [
                            "skrajna (minimalna lub maksymalna) wartość funkcji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94630e9a-79c5-4e5b-9e5a-3b5999121bf1",
                                "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                                "text": "Cosinus ma ekstremum lokalne w punktach postaci kπ, gdzie k jest całkowite."
                            },
                            {
                                "example_id": "bba849e7-d245-4e02-a6de-8204322787c0",
                                "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                                "text": "Nieśmiały cybernetyk potężne ekstrema"
                            },
                            {
                                "example_id": "959a7c19-6155-415f-affb-f8461aa293ae",
                                "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                                "text": "Poznawał, kiedy grupy unimodularne"
                            },
                            {
                                "example_id": "063f66f1-67df-46d1-9071-1ca61b8d7f63",
                                "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                                "text": "Cyberiady całkował w popołudnie parne,"
                            },
                            {
                                "example_id": "8b727729-ecad-4223-b8e3-0606a694cf42",
                                "sense_id": "4ff143f0-7bfd-32b7-8dfa-825df7dcb68a",
                                "text": "Nie wiedząc, czy jest miłość, czy jeszcze jej nie ma?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9f3ba708-9f1b-35fd-9a3e-5a6d44efb54e",
