                        "glosses": [
                            "Determined to do as one pleases, and not as others want."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a6e4ce-c2e5-47b9-b61e-81615b9c10bb",
                                "sense_id": "c98f0f50-2c1f-3a32-a26c-a844dd208ac9",
                                "text": "He was in that headstrong teenage phase when he felt like he knew everything."
                            },
                            {
                                "example_id": "1054aa79-ab6e-41bf-a0b2-041785b53346",
                                "sense_id": "c98f0f50-2c1f-3a32-a26c-a844dd208ac9",
                                "text": "O, there's nothing to be hoped for from her! ſhe's as headſtrong as an allegory on the banks of the Nile."
                            }
                        ]
                    }
