                "senses": [
                    {
                        "sense_id": "03f21aa6-8245-31b6-a944-9124745bd7d5",
                        "entry_id": "519fc527-2204-35f3-bb88-3f51d5dabd3d",
                        "glosses": [
                            "die Gesamtheit der Einrichtungen und Organisationen eines Gemeinwesens, die der Bildung im Sinne einer Aneignung von Kenntnissen und Fertigkeiten dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76aa06c9-92c4-48ae-b06a-c28f0a55daf2",
                                "sense_id": "03f21aa6-8245-31b6-a944-9124745bd7d5",
                                "text": "Das Bildungswesen muss grundlegend reformiert werden."
                            },
                            {
                                "example_id": "ab73b7eb-367d-4a99-b647-5455bad1040f",
                                "sense_id": "03f21aa6-8245-31b6-a944-9124745bd7d5",
                                "text": "„Zur Koordination des Bildungs-, besonders des Hochschulwesens unter den Besatzungsmächten wurden neue Gremien geschaffen.“"
                            },
                            {
                                "example_id": "ebc653a1-7018-4a0d-9634-e7179a2600ac",
                                "sense_id": "03f21aa6-8245-31b6-a944-9124745bd7d5",
                                "text": "„Unter Kontrolle der Deutschen blieb dagegen das von ihnen geschaffene Bildungswesen in Tsingtau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
