                "senses": [
                    {
                        "sense_id": "388bc00b-7a87-38b2-877b-1984c31c60b2",
                        "entry_id": "3ca94727-2d5e-3aee-a64f-35f29de62f9b",
                        "glosses": [
                            "przebywać w jakimś miejscu przez wiele dni, wraz ze spaniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e744fb3-e8b2-46d0-a47c-b94acc10c61d",
                                "sense_id": "388bc00b-7a87-38b2-877b-1984c31c60b2",
                                "text": "Pomieszkał trochę u córki, ale potem wrócił do swego domu w Drogomyślu."
                            },
                            {
                                "example_id": "69b863f6-caaf-4a53-a658-360d353a50f8",
                                "sense_id": "388bc00b-7a87-38b2-877b-1984c31c60b2",
                                "text": "Pomieszkaj z nim trochę, a zobaczysz, co z niego za gagatek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3056a74c-a69d-37e8-8a92-9e7f5c222b21",
                        "entry_id": "3ca94727-2d5e-3aee-a64f-35f29de62f9b",
                        "glosses": [
                            "nareszcie móc spędzić trochę czasu we własnym domu"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "2add5f14-902d-4bec-9fad-da4d2764ff8f",
                                "sense_id": "3056a74c-a69d-37e8-8a92-9e7f5c222b21",
                                "text": "W piątek wracam i będę mógł nareszcie trochę pomieszkać u siebie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
