                        "sense_id": "6860fc07-e14d-3ef7-94c0-a30b257fc9f9",
                        "entry_id": "39314ac5-ed2d-306b-8620-be5de83fd243",
                        "glosses": [
                            "Livre où sont consignés les souvenirs d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca8b477-1bab-4424-ab83-f26dfc3a6e05",
                                "sense_id": "6860fc07-e14d-3ef7-94c0-a30b257fc9f9",
                                "text": "Avec le Mémorial de Sainte-Hélène le bonapartisme possédait enfin un corps de doctrine à peu près cohérent qui lui permettait, à terme, de ne pas disparaître."
                            }
                        ]
                    },
                    {
                        "sense_id": "799eaf05-b63b-39d2-a1ce-9ffc6fc5fbce",
                        "entry_id": "39314ac5-ed2d-306b-8620-be5de83fd243",
                        "glosses": [
                            "Monument élevé en l’honneur de personnes disparues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad4c551b-2aab-4f45-ae95-c8a4e943bea9",
                                "sense_id": "799eaf05-b63b-39d2-a1ce-9ffc6fc5fbce",
                                "text": "Le mémorial de Verdun symbolise la mémoire historique."
                            }
                        ]
