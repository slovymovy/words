                "senses": [
                    {
                        "sense_id": "15fd616a-03f5-3663-85a6-c3acba341e27",
                        "entry_id": "33c06f20-f24c-303a-a23c-900b38359438",
                        "glosses": [
                            "Gérer de façon très fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94bfdea-7ea4-41a1-af91-8509cb4bcaf5",
                                "sense_id": "15fd616a-03f5-3663-85a6-c3acba341e27",
                                "text": "Les dirigeants ont parfois le tort d’essayer de faire le travail de leurs subordonnés, ou de microgérer, quand leurs tâches ne sont pas assez stimulantes."
                            },
                            {
                                "example_id": "1b712269-257b-4763-b3eb-f835962af61d",
                                "sense_id": "15fd616a-03f5-3663-85a6-c3acba341e27",
                                "text": "L’un après l’autre, les orateurs les ont encensés pour leur patience infinie et leur étonnante habileté à microgérer de minuscules ressources afin de se forger une vie dans la dignité."
                            }
                        ]
                    }
