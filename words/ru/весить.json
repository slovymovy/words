{
    "word_family": [
        "вес",
        "весовой",
        "весы",
        "весовщик",
        "весомый"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3885c511-813e-389d-b8fd-370f9c369fde",
                    "sense_definition": "Иметь определённый вес, обладать массой.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сколько <w>весит</w> этот арбуз?",
                            "target_lang_translations": {
                                "en": "How much does this watermelon <w>weigh</w>?"
                            }
                        },
                        {
                            "text": "Мой новый кот <w>весит</w> пять килограммов.",
                            "target_lang_translations": {
                                "en": "My new cat <w>weighs</w> five kilograms."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have a specific weight or mass."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weigh",
                                "target_lang_sense_clarification": "To have a certain weight."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727d5559-cdab-383c-af8a-655e68f68077",
                    "sense_definition": "Иметь значение, влияние или авторитет.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его мнение в этом вопросе <w>весит</w> больше, чем мнение остальных.",
                            "target_lang_translations": {
                                "en": "His opinion on this matter <w>carries more weight</w> than the others'."
                            }
                        },
                        {
                            "text": "Слова опытного врача <w>весят</w> очень много для пациента.",
                            "target_lang_translations": {
                                "en": "The words of an experienced doctor <w>carry a lot of weight</w> for a patient."
                            }
                        }
                    ],
                    "synonyms": [
                        "значить"
                    ],
                    "target_lang_definitions": {
                        "en": "To have significance, influence, or authority."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carry weight",
                                "target_lang_sense_clarification": "To be influential or important."
                            },
                            {
                                "target_lang_word": "matter",
                                "target_lang_sense_clarification": "To be important."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77926065-6a13-357b-aaa6-1131bb2a4a91",
                    "sense_definition": "Занимать определённый объём памяти на носителе данных.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта программа <w>весит</w> всего несколько мегабайтов.",
                            "target_lang_translations": {
                                "en": "This program <w>takes up</w> only a few megabytes."
                            }
                        },
                        {
                            "text": "Видеофайл <w>весит</w> слишком много для отправки по почте.",
                            "target_lang_translations": {
                                "en": "The video file <w>is too large</w> to send by email."
                            }
                        }
                    ],
                    "synonyms": [
                        "занимать"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "компьютерный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To occupy a certain amount of storage space on a digital medium."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take up",
                                "target_lang_sense_clarification": "To occupy space or memory."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa39cb2d-cd2f-37d3-bb09-efd51930084b",
                    "sense_definition": "Определять массу чего-либо с помощью весов.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weighing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Продавец начал <w>весить</w> овощи для покупателя.",
                            "target_lang_translations": {
                                "en": "The seller started to <w>weigh</w> the vegetables for the customer."
                            }
                        },
                        {
                            "text": "Нужно <w>весить</w> муку перед тем, как замешивать тесто.",
                            "target_lang_translations": {
                                "en": "You need to <w>weigh</w> the flour before kneading the dough."
                            }
                        }
                    ],
                    "synonyms": [
                        "взвешивать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To determine the mass of something using a scale."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weigh",
                                "target_lang_sense_clarification": "To determine the weight of an object."
                            },
                            {
                                "target_lang_word": "weigh out",
                                "target_lang_sense_clarification": "To measure a specific amount by weight."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b3d9c38-c351-3b4e-ad17-67916009ab0d",
                    "sense_definition": "Размещать что-либо на стене или другой опоре.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер решил <w>весить</w> картину в центре гостиной.",
                            "target_lang_translations": {
                                "en": "The master decided to <w>hang</w> the painting in the center of the living room."
                            }
                        },
                        {
                            "text": "Рабочие продолжают <w>весить</w> рекламный баннер на фасад здания.",
                            "target_lang_translations": {
                                "en": "The workers continue to <w>hang</w> the advertising banner on the building's facade."
                            }
                        }
                    ],
                    "synonyms": [
                        "вешать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To place something on a wall or other support."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To attach something so it is supported from above."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}