                    {
                        "sense_id": "23204fed-42a8-3391-b96e-91cc744d697f",
                        "entry_id": "a36258c8-dc44-3573-8d56-312157ce233d",
                        "glosses": [
                            "To gauge the amount of empty space between the top of a cask and the level of liquid inside it."
