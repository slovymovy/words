                "senses": [
                    {
                        "sense_id": "2b1c4d81-5259-31dd-a39d-2ed41576cad8",
                        "entry_id": "f29fcf57-e36f-3bea-8d50-8d8c2f342a36",
                        "glosses": [
                            "Maladie héréditaire caractérisée par l’absence de mélanine dans la peau et dans les cheveux qui sont presque blancs et les yeux qui sont grisâtres ou rougeâtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248296a9-54c3-4fff-9490-26c27f59464d",
                                "sense_id": "2b1c4d81-5259-31dd-a39d-2ed41576cad8",
                                "text": "Le pronostic de l'albinisme en milieu tropical est dominé, outre les troubles de la vision, par la survenue fréquente de carcinomes cutanés, épidermoïdes plus souvent que basocellulaires."
                            },
                            {
                                "example_id": "8bc68ed4-fd6e-49ba-88a8-2743c74d2519",
                                "sense_id": "2b1c4d81-5259-31dd-a39d-2ed41576cad8",
                                "text": "Sur son compte Instagram, M. Adams a décrit l’animal comme étant atteint de leucisme, une mutation génétique à ne pas confondre avec l'albinisme qui fait en sorte que la mélamine produite par l'oiseau ne se dépose pas dans son plumage, faisant ainsi passer ses plumes du noir au jaune et au blanc crème."
                            },
                            {
                                "example_id": "c0fcab3e-7f2f-44cb-9411-5bac6294762b",
                                "sense_id": "2b1c4d81-5259-31dd-a39d-2ed41576cad8",
                                "text": "La fac n’était adaptée ni à mon handicap (un albinisme oculaire) ni à ma pratique sportive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95890829-3659-4503-801a-c6146232ae02",
                        "source_entry_id": "f29fcf57-e36f-3bea-8d50-8d8c2f342a36",
                        "source_sense_id": "2b1c4d81-5259-31dd-a39d-2ed41576cad8",
                        "target_lang_word": "Albinismus",
                        "target_lang_code": "de",
