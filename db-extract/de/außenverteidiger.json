                "senses": [
                    {
                        "sense_id": "10cb2679-cf06-3673-a126-3982483f3a9b",
                        "entry_id": "1059286c-07d2-3d6f-bf12-bba1311815dd",
                        "glosses": [
                            "Abwehrspieler, der auf einer Außenposition spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544c0688-b4bf-4ac5-a1dd-97f65935d66f",
                                "sense_id": "10cb2679-cf06-3673-a126-3982483f3a9b",
                                "text": "Die beiden Außenverteidiger dienen zur Stabilisierung der Verteidigung, sie sollen jedoch über die Außen das Spiel nach vorne verstärken."
                            },
                            {
                                "example_id": "fdef7f16-d5ae-4df0-a909-f14c0d220323",
                                "sense_id": "10cb2679-cf06-3673-a126-3982483f3a9b",
                                "text": "Was Nerlingers Suche nach neuen Spielern, genauer gesagt nach einem neuen Außenverteidiger angeht, führt die Spur erneut nach Frankreich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
