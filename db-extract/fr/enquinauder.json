                        "examples": [
                            {
                                "example_id": "ab6bc6ba-86b2-49d7-9f02-32672567a38e",
                                "sense_id": "104a80ba-1f0c-3761-a99e-3a423524e7d3",
                                "text": "Mais s'il n’eut ces mots sur la langue, Il les eut dans le coeur, il me persuada, à tort, à droit me demanda Du doux, du tendre et semblables sornettes, Petits mots, jargons d’amourettes, Confits au miel ; bref il m’enquinauda'"
                            },
                            {
                                "example_id": "2529310e-4e1f-4fb5-85bf-d838286ad5eb",
                                "sense_id": "104a80ba-1f0c-3761-a99e-3a423524e7d3",
                                "text": "Elle avait été si fêtée par tout le pays, elle avait été si honnête et si polie, que je fus enquinaudé"
                            }
                        ]
