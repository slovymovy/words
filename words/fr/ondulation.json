            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b96aca4a-d8df-3ba4-9f94-b65587c561e8",
                    "sense_definition": "Mouvement ou forme sinueuse qui rappelle l'aspect des vagues ou des ondes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_et_mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses cheveux bruns tombaient sur ses épaules avec de jolies <w>ondulations</w> naturelles."
                        },
                        {
                            "text": "Le vent soufflait doucement sur la plaine, créant des <w>ondulations</w> dorées dans les blés."
                        }
                    ],
                    "synonyms": [
                        "boucle",
                        "sinuosité",
                        "vague"
                    ],
                    "common_phrases": [
                        "ondulations des cheveux",
                        "ondulations du terrain"
                    ]
                },
                {
                    "sense_id": "539bd6a9-f117-35b9-a6a1-6195d689068c",
                    "sense_definition": "Mouvement oscillatoire et régulier qui agite la surface d'un liquide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le caillou jeté dans le lac a produit des <w>ondulations</w> régulières à la surface."
                        },
                        {
                            "text": "À chaque coup de rame, une légère <w>ondulation</w> se propageait vers la rive."
                        }
                    ],
                    "synonyms": [
                        "clapotis",
                        "oscillation",
                        "remous"
                    ],
                    "common_phrases": [
                        "légère ondulation"
                    ]
                },
                {
                    "sense_id": "8c29be76-5207-30c6-84f0-d93e9435bab5",
                    "sense_definition": "Mouvement vibratoire ou oscillatoire qui se propage dans un milieu matériel ou fluide.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les physiciens analysent la vitesse à laquelle cette <w>ondulation</w> sonore se propage dans l'air."
                        },
                        {
                            "text": "La transmission de cette énergie produit une <w>ondulation</w> continue dans la matière."
                        }
                    ],
                    "synonyms": [
                        "oscillation",
                        "vibration"
                    ],
                    "common_phrases": [
                        "ondulation sonore"
                    ]
                },
                {
                    "sense_id": "38c740b9-88b8-3d4c-8acc-b73322084167",
                    "sense_definition": "Tracé souple, sinueux ou arrondi des plis d'une draperie ou d'un tissu dans un dessin ou une œuvre d'art.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forme_et_mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sculpteur a reproduit avec précision les <w>ondulations</w> délicates de la robe en marbre."
                        },
                        {
                            "text": "Les <w>ondulations</w> du rideau peint en arrière-plan apportent une sensation de mouvement au tableau."
                        }
                    ],
                    "synonyms": [
                        "drapé",
                        "pli"
                    ],
                    "common_phrases": [
                        "ondulations des draperies"
                    ]
                }
            ]
        }
    ]
