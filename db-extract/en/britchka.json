                "senses": [
                    {
                        "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                        "entry_id": "c7fd15e3-f26f-3cf4-a746-e3ef2079c648",
                        "glosses": [
                            "A type of horse-drawn carriage, with a foldable roof covering."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "89e50420-54dc-4285-a3a6-9a19f2702ba2",
                                "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                                "text": "[H]e cracked his whip and the britchka leapt forward with increased speed over the cobblestones."
                            },
                            {
                                "example_id": "b365df09-1f55-4388-b1b6-74b5160078a6",
                                "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                                "text": "The appearance of our caravan was curious and grotesque. Our britchka was drawn by three camels, taken in tow by a man on foot."
                            },
                            {
                                "example_id": "540eea93-3770-4983-826f-70d34044ff71",
                                "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                                "text": "A britzka came up at this moment as the three men were speaking."
                            },
                            {
                                "example_id": "890e93f9-448e-488e-b1f2-f6be8f42428f",
                                "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                                "text": "At length, Vassili got up and covered over the britchka, the coachman wrapped himself up in his cloak and lifted his cap to make the sign of the cross at each successive thunderclap, and the horses pricked up their ears and snorted."
                            },
                            {
                                "example_id": "8e8025ae-aa3a-4cab-b69f-e6a43859567e",
                                "sense_id": "7c1e3ef1-efd8-3fc3-968a-1eb82ea3a79a",
                                "text": "The conveyance stopped, a straw-coloured britshka, the summer conveyance of Count Chojnicki."
                            }
                        ]
                    }
                ],
