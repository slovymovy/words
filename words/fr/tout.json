                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distributif_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tout</w> citoyen a le devoir de respecter les lois du pays."
                        },
                        {
                            "text": "Vous pouvez contacter notre service d'assistance à <w>tout</w> moment."
