{
    "word_family": [
        "glider",
        "glidingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                    "sense_definition": "To move softly, smoothly, or effortlessly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swan <w>glides</w> across the calm lake water.",
                            "target_lang_translations": {
                                "zh": "天鹅在平静的湖面上<w>滑行</w>。",
                                "ru": "Лебедь <w>скользит</w> по спокойной глади озера."
                            }
                        },
                        {
                            "text": "The dancer <w>glides</w> across the stage with grace.",
                            "target_lang_translations": {
                                "zh": "舞者优雅地在舞台上<w>滑行</w>。",
                                "ru": "Танцор грациозно <w>скользит</w> по сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "common_phrases": [
                        "glide across"
                    ],
                    "target_lang_definitions": {
                        "zh": "指平稳、轻柔或毫不费力地移动。",
                        "ru": "Плавно, мягко или без усилий перемещаться."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑行",
                                "target_lang_sense_clarification": "指平稳地移动。"
                            },
                            {
                                "target_lang_word": "溜",
                                "target_lang_sense_clarification": "指轻快地移动。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "плавное движение по поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                    "sense_definition": "To fly without using an engine, as of an aircraft or bird.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle <w>glides</w> on the warm air currents.",
                            "target_lang_translations": {
                                "zh": "老鹰在暖气流上<w>滑翔</w>。",
                                "ru": "Орел <w>планирует</w> на теплых воздушных потоках."
                            }
                        },
                        {
                            "text": "The pilot <w>glides</w> the plane down to the runway.",
                            "target_lang_translations": {
                                "zh": "飞行员让飞机<w>滑翔</w>降落在跑道上。",
                                "ru": "Пилот <w>планирует</w> на самолете к взлетно-посадочной полосе."
                            }
                        }
                    ],
                    "synonyms": [
                        "coast"
                    ],
                    "common_phrases": [
                        "glide on"
                    ],
                    "target_lang_definitions": {
                        "zh": "指飞行器或鸟类不使用动力而飞行。",
                        "ru": "Лететь без использования двигателя (о птицах или летательных аппаратах)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑翔",
                                "target_lang_sense_clarification": "指不依靠动力在空中滑行。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "постепенное снижение в полете без двигателя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f357a393-8dc0-309d-a7d6-d78f2282d84c",
                    "sense_definition": "To cause something to move in a smooth, effortless way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>glides</w> the heavy door shut quietly.",
                            "target_lang_translations": {
                                "zh": "他轻轻地<w>推动</w>沉重的大门，把它关上。",
                                "ru": "Он тихо <w>задвигает</w> тяжелую дверь."
                            }
                        },
                        {
                            "text": "She <w>glides</w> the brush over the canvas.",
                            "target_lang_translations": {
                                "zh": "她让画笔在画布上平稳地<w>滑过</w>。",
                                "ru": "Она плавно <w>ведет</w> кистью по холсту."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物平稳、轻松地移动。",
                        "ru": "Заставлять что-либо двигаться плавно и без усилий."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "指平稳地移动某物。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плавно двигать",
                                "target_lang_sense_clarification": "перемещение объекта без рывков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9389a0b-a587-351c-b292-7a646b56b138",
                    "sense_definition": "To transition smoothly between notes or sounds with the voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer <w>glides</w> between the two notes perfectly.",
                            "target_lang_translations": {
                                "zh": "歌手在两个音符之间完美地<w>滑音</w>过渡。",
                                "ru": "Певец идеально <w>переходит</w> между двумя нотами."
                            }
                        },
                        {
                            "text": "She <w>glides</w> her voice up to the high register.",
                            "target_lang_translations": {
                                "zh": "她让声音平滑地<w>滑</w>向高音区。",
                                "ru": "Она плавно <w>переводит</w> голос в высокий регистр."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指声音在音高之间平滑过渡。",
                        "ru": "Плавный переход голосом между нотами или звуками."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑音",
                                "target_lang_sense_clarification": "指音高间的平滑过渡。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "глиссандо",
                                "target_lang_sense_clarification": "музыкальный термин для плавного перехода"
                            },
                            {
                                "target_lang_word": "плавный переход",
                                "target_lang_sense_clarification": "общее описание вокального приема"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5378e95-792a-3877-8dac-d361d09fd7ed",
                    "sense_definition": "The act of moving in a smooth, effortless way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glide</w> of the skater was beautiful to watch.",
                            "target_lang_translations": {
                                "zh": "滑冰者那优美的<w>滑行</w>动作令人赏心悦目。",
                                "ru": "За <w>скольжением</w> фигуриста было приятно наблюдать."
                            }
                        },
                        {
                            "text": "The smooth <w>glide</w> across the ice felt amazing.",
                            "target_lang_translations": {
                                "zh": "在冰面上平稳地<w>滑行</w>感觉棒极了。",
                                "ru": "Плавное <w>скольжение</w> по льду было восхитительным."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "common_phrases": [
                        "smooth glide"
                    ],
                    "target_lang_definitions": {
                        "zh": "平稳、轻松移动的动作。",
                        "ru": "Процесс плавного и легкого движения."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑行",
                                "target_lang_sense_clarification": "指平稳移动的动作。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "процесс плавного перемещения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33f52b65-1065-3263-8890-8390d31a4ece",
                    "sense_definition": "A transitional sound, especially a semivowel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound in the middle is a <w>glide</w>.",
                            "target_lang_translations": {
                                "zh": "中间的那个音是一个<w>滑音</w>。",
                                "ru": "Звук посередине — это <w>скользящий звук</w>."
                            }
                        },
                        {
                            "text": "Phonetically, this <w>glide</w> connects the two vowels.",
                            "target_lang_translations": {
                                "zh": "在语音学上，这个<w>滑音</w>连接了两个元音。",
                                "ru": "Фонетически этот <w>переходный звук</w> соединяет два гласных."
                            }
                        }
                    ],
                    "synonyms": [
                        "semivowel",
                        "semiconsonant"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种过渡音，尤指半元音。",
                        "ru": "Переходный звук, особенно полугласный."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑音",
                                "target_lang_sense_clarification": "语音学中的过渡音。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользящий звук",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "полугласный",
                                "target_lang_sense_clarification": "фонетическая классификация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2480a9b-c762-3eba-92b5-dd89d6d1280a",
                    "sense_definition": "The joining of two sounds without a break.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glide</w> between the words makes them sound like one.",
                            "target_lang_translations": {
                                "zh": "词与词之间的<w>连读</w>使它们听起来像是一个词。",
                                "ru": "Плавное <w>слияние</w> между словами делает их звучащими как одно целое."
                            }
                        },
                        {
                            "text": "A natural <w>glide</w> is essential for fluent speech.",
                            "target_lang_translations": {
                                "zh": "自然的<w>连读</w>对于流利的口语至关重要。",
                                "ru": "Естественное <w>слияние</w> звуков необходимо для беглой речи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "两个声音之间不间断的连接。",
                        "ru": "Соединение двух звуков без паузы."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "连读",
                                "target_lang_sense_clarification": "指声音间的平滑连接。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "слитное произношение",
                                "target_lang_sense_clarification": "отсутствие паузы между звуками"
                            },
                            {
                                "target_lang_word": "связная речь",
                                "target_lang_sense_clarification": "плавность потока речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778d7cd2-b160-386a-b020-79fe1b726c70",
                    "sense_definition": "A smooth and sliding step in dancing the waltz.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer performed a graceful <w>glide</w> across the floor.",
                            "target_lang_translations": {
                                "zh": "舞者在地板上完成了一个优雅的<w>滑步</w>。",
                                "ru": "Танцор выполнил изящный <w>скользящий шаг</w> по полу."
                            }
                        },
                        {
                            "text": "Mastering the <w>glide</w> is important for the waltz.",
                            "target_lang_translations": {
                                "zh": "掌握<w>滑步</w>对于跳华尔兹很重要。",
                                "ru": "Освоение <w>скользящего шага</w> важно для вальса."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "target_lang_definitions": {
                        "zh": "华尔兹舞中一种平滑的滑动舞步。",
                        "ru": "Плавный скользящий шаг в вальсе."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑步",
                                "target_lang_sense_clarification": "舞蹈中的滑动步法。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользящий шаг",
                                "target_lang_sense_clarification": "танцевальное движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d68cbd-cbe9-3094-8036-742893ee439f",
                    "sense_definition": "A cap on furniture legs to protect the floor.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attach a <w>glide</w> to the chair leg to stop scratching.",
                            "target_lang_translations": {
                                "zh": "在椅腿上装一个<w>脚垫</w>以防止刮伤。",
                                "ru": "Прикрепите <w>подпятник</w> к ножке стула, чтобы не царапать пол."
                            }
                        },
                        {
                            "text": "The floor is protected by a plastic <w>glide</w>.",
                            "target_lang_translations": {
                                "zh": "地板由一个塑料<w>脚垫</w>保护着。",
                                "ru": "Пол защищен пластиковой <w>опорой</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "家具腿上的保护套，用于防止刮伤地板。",
                        "ru": "Насадка на ножки мебели для защиты пола."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脚垫",
                                "target_lang_sense_clarification": "家具腿部的保护装置。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мебельная опора",
                                "target_lang_sense_clarification": "защитный элемент для ножек"
                            },
                            {
                                "target_lang_word": "подпятник",
                                "target_lang_sense_clarification": "защитная накладка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22d9ef81-b24b-352a-bc17-cd71736c34e1",
                    "sense_definition": "A fencing movement sliding down an opponent's blade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a quick <w>glide</w> to disarm his opponent.",
                            "target_lang_translations": {
                                "zh": "他用了一个快速的<w>滑剑</w>动作解除了对手的武装。",
                                "ru": "Он использовал быстрое <w>скольжение по клинку</w>, чтобы обезоружить противника."
                            }
                        },
                        {
                            "text": "The <w>glide</w> requires constant contact with the blade.",
                            "target_lang_translations": {
                                "zh": "<w>滑剑</w>动作要求与对方剑身保持持续接触。",
                                "ru": "<w>Скольжение по клинку</w> требует постоянного контакта с лезвием."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "target_lang_definitions": {
                        "zh": "击剑中沿对手剑身滑动的动作。",
                        "ru": "Фехтовальный прием, при котором клинок скользит по клинку противника."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑剑",
                                "target_lang_sense_clarification": "击剑术语。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скольжение по клинку",
                                "target_lang_sense_clarification": "фехтовальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ad91b19-a2a7-3bb2-ba2e-f3c3945f1cc1",
                    "sense_definition": "A bird of prey, also known as a kite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glide</w> circled high above the field.",
                            "target_lang_translations": {
                                "zh": "那只<w>鸢</w>在田野上空盘旋。",
                                "ru": "<w>Коршун</w> кружил высоко над полем."
                            }
                        },
                        {
                            "text": "A rare <w>glide</w> was spotted in the forest.",
                            "target_lang_translations": {
                                "zh": "在森林里发现了一只稀有的<w>鸢</w>。",
                                "ru": "В лесу заметили редкого <w>коршуна</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the bird."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种猛禽，也称为鸢。",
                        "ru": "Хищная птица, также известная как коршун."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸢",
                                "target_lang_sense_clarification": "一种猛禽。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "коршун",
                                "target_lang_sense_clarification": "вид хищной птицы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3292b110-a1a8-35d5-9454-327cc27e5498",
                    "sense_definition": "A census-designated place in Douglas County, Oregon, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They live in a small town called <w>Glide</w>.",
                            "target_lang_translations": {
                                "zh": "他们住在一个叫<w>格莱德</w>的小镇。",
                                "ru": "Они живут в маленьком городке под названием <w>Глайд</w>."
                            }
                        },
                        {
                            "text": "The road to <w>Glide</w> is very scenic.",
                            "target_lang_translations": {
                                "zh": "通往<w>格莱德</w>的公路风景非常优美。",
                                "ru": "Дорога до <w>Глайда</w> очень живописна."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国俄勒冈州道格拉斯县的一个普查规定居民点。",
                        "ru": "Населенный пункт в округе Дуглас, штат Орегон, США."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "格莱德",
                                "target_lang_sense_clarification": "地名。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Глайд",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}