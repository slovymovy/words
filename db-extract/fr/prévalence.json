                "senses": [
                    {
                        "sense_id": "efccefde-a070-335f-a7a3-5db4a994b6eb",
                        "entry_id": "ff7010f4-81b2-342c-a05a-273abd9b8465",
                        "glosses": [
                            "Qualité de ce qui prévaut."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "97ea6846-5c22-4ef0-945a-e2791aa56639",
                                "sense_id": "efccefde-a070-335f-a7a3-5db4a994b6eb",
                                "text": "La prévalence de la coutume."
                            },
                            {
                                "example_id": "74269079-d507-4c77-9bc0-a707bac78c38",
                                "sense_id": "efccefde-a070-335f-a7a3-5db4a994b6eb",
                                "text": "La prévalence de l’autorité de l’État sur la liberté personnelle."
                            },
                            {
                                "example_id": "33dd5b5a-2caa-4ba6-9b49-920998c94485",
                                "sense_id": "efccefde-a070-335f-a7a3-5db4a994b6eb",
                                "text": "Au bonheur, je voulais préférer l'amour. Et surtout pas l'amour que j'éprouvais pour Rébecca, l'amour exclusif, cette prévalence furieuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "462b5479-7d15-35af-9750-1104c06946e9",
                        "entry_id": "ff7010f4-81b2-342c-a05a-273abd9b8465",
                        "glosses": [
                            "Nombre de maladies ou de malades présents à un moment donné dans une population, que le diagnostic ait été porté anciennement ou récemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "badabbd5-11db-4f24-9548-ade22717c1f4",
                                "sense_id": "462b5479-7d15-35af-9750-1104c06946e9",
                                "text": "La prévalence de l'incontinence fécale en institution gériatrique était de 33 à 54 % selon la durée de l'étude."
                            },
                            {
                                "example_id": "51a45b32-2641-4a3c-8d22-3ffa8c7982e0",
                                "sense_id": "462b5479-7d15-35af-9750-1104c06946e9",
                                "text": "Cependant, ces dernières décennies, la prévalence de l’édentement à âge constant diminue, mais, en raison de l’augmentation de l’espérance de vie, le nombre de personnes édentées reste constant."
                            }
                        ]
                    }
