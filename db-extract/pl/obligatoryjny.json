                    },
                    {
                        "sense_id": "b15e260e-c963-3856-a049-3f087f860b99",
                        "entry_id": "33b2d7f7-2c4d-3d5c-82b4-ed30624a5f85",
                        "glosses": [
                            "obligate (biologically required to behave in some way)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab43124b-bb50-4b36-beed-b21a34031ebc",
                                "sense_id": "b15e260e-c963-3856-a049-3f087f860b99",
                                "text": "Dla pasożytów fakultatywnych wykorzystanie gospodarza do rozwoju jest tylko jedną z możliwości osiągnięcia sukcesu rozrodczego, w przeciwieństwie do pasożytów obligatoryjnych, które w toku ewolucji utraciły zdolność do budowy własnych gniazd, czy chociażby do opieki nad własnym potomstwem.",
                                "translation": "For the facultative parasites, the exploitation of a host for reproduction is only one of their options for achieving reproductive success, in contrast with the obligate parasites, which, in the course of evolution, have lost the ability to build their own nests or just to take care of their own offspring.",
                                "english": "For the facultative parasites, the exploitation of a host for reproduction is only one of their options for achieving reproductive success, in contrast with the obligate parasites, which, in the course of evolution, have lost the ability to build their own nests or just to take care of their own offspring."
                            }
                        ]
                    }
