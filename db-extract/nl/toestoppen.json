                "senses": [
                    {
                        "sense_id": "30a017c8-5170-3e54-9e66-af0d89acee72",
                        "entry_id": "368a31e6-0a4a-3541-93a0-6b85df4002f4",
                        "glosses": [
                            "iemand (meestal een kind) bedekken met een deken zodat het kan gaan slapen/ naar bed brengen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "125b4682-cd4f-38e1-acde-74b217a1a26c",
                        "entry_id": "368a31e6-0a4a-3541-93a0-6b85df4002f4",
                        "glosses": [
                            "stilletjes iemand iets geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad788df2-0eb9-44f4-a5db-d13e384608e3",
                                "sense_id": "125b4682-cd4f-38e1-acde-74b217a1a26c",
                                "text": "„Niet als je al bij de bank bent langsgeweest of weet dat je ouders je 100.000 euro toestoppen. Dan is de kans dat de financiering niet rondkomt zo klein dat je het wel kunt doen. Maar als je geen zekerheid over je financiën hebt, is bieden zonder voorbehoud niet verstandig.”"
                            },
                            {
                                "example_id": "38c1a944-b3c8-48f1-b83d-89969a81c89d",
                                "sense_id": "125b4682-cd4f-38e1-acde-74b217a1a26c",
                                "text": "De buurlanden ergeren zich mateloos aan Qatar. Het emiraat leunt als een van de weinige soennitische staten in het Midden-Oosten sterk op het sjiitische Iran. Bovendien zouden de Qatari gewapende groepen als de Palestijnse organisatie Hamas, het terreurnetwerk al-Qaeda en de door Egypte verboden Moslimbroederschap veel geld toestoppen."
                            }
                        ]
                    },
