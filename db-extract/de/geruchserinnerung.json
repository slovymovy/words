                "senses": [
                    {
                        "sense_id": "0fec6ae7-71f4-3e32-a8ca-d1a89338bb5c",
                        "entry_id": "b4cda9de-4ce8-30fe-8487-a4defa13b4ce",
                        "glosses": [
                            "Neurobiologie: assoziative Fähigkeit, einen bestimmten Geruch mit einer Erfahrung zu verknüpfen und wiederholt zuzuordnen; reversible, individuelle Assoziation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3730f039-31af-4d24-be34-8d36519d9f41",
                                "sense_id": "0fec6ae7-71f4-3e32-a8ca-d1a89338bb5c",
                                "text": "„Die Ermittlung verschiedener Geruchserinnerungen wurde anhand einer Umfrage durchgeführt.“"
                            },
                            {
                                "example_id": "64778b97-87b8-44ff-9fa0-7daef21b193e",
                                "sense_id": "0fec6ae7-71f4-3e32-a8ca-d1a89338bb5c",
                                "text": "„Die Geruchserinnerungen aus der Kindheit sind einfach deshalb besonders, weil wir in diesen Jahren das erste Mal etwas mit einem Geruch verbinden.“"
                            },
                            {
                                "example_id": "a3ee65e3-fb73-4b37-90c5-68f52cdb2a2e",
                                "sense_id": "0fec6ae7-71f4-3e32-a8ca-d1a89338bb5c",
                                "text": "„Ausschließlich die ersten Geruchserinnerungen, angenehme sowie unangenehme, hatten nämliche eine spezielle Spur im Gehirn hinterlassen - ein bestimmtes Aktivitätsmuster im Hippocampus und in der Amygdala bzw. Mandelkern, beides Regionen, die sowohl mit der olfaktorischen Wahrnehmung als auch mit Emotionen in Verbindung gebracht werden.“"
                            },
                            {
                                "example_id": "146cc03e-5512-456a-b163-7882a8220cf6",
                                "sense_id": "0fec6ae7-71f4-3e32-a8ca-d1a89338bb5c",
                                "text": "„Meine früheste Geruchserinnerung erzeugt auch ein Bild: Sie transportiert mich in sommerliche Tage vor die Wände einer Hauszeile entlang einer schmalen, geschotterten Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
