        "fr-extract.jsonl": [
            {
                "entry_id": "d2f2e072-19fe-3b11-bde2-a17d9e1aa92b",
                "word": "claudication",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ebecc17d-106e-4968-abe2-ae4f8fbcb53a",
                        "entry_id": "d2f2e072-19fe-3b11-bde2-a17d9e1aa92b",
                        "tags": [
                            "plural"
                        ],
                        "form": "claudications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe6e9f34-9fc6-384d-9ddf-497239b4dc34",
                        "entry_id": "d2f2e072-19fe-3b11-bde2-a17d9e1aa92b",
                        "glosses": [
                            "Action de boiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95cd0cc-c9c1-4d60-ae63-f2cabd771db8",
                                "sense_id": "fe6e9f34-9fc6-384d-9ddf-497239b4dc34",
                                "text": "Si, au contraire, la claudication est dans le train postérieur, on débute par l’allure la plus lente, et, au retour, l’on vous gratifie d’un peu de trot, […]."
                            },
                            {
                                "example_id": "ece27450-a22e-41f0-930b-0ef9d0a08087",
                                "sense_id": "fe6e9f34-9fc6-384d-9ddf-497239b4dc34",
                                "text": "Il répugne à la cérémonie et prétend ne pas désavouer devant sa belle-sœur une veste d’alpaga, un gilet blanc chiné de bleu, un pantalon de coutil et de confortables pantoufles de cuir noir sans talons, qu’il garde même pour sortir, et qu’excuse sa claudication."
                            },
                            {
                                "example_id": "ba344e22-d9f8-4f84-92f2-d9b72d386b96",
                                "sense_id": "fe6e9f34-9fc6-384d-9ddf-497239b4dc34",
                                "text": "Ses dents en or et sa claudication laissaient entendre, avant qu'il ne se fût livré à la moindre confidence, que son ancien métier entraînait certains risques."
                            }
                        ]
                    },
                    {
                        "sense_id": "67959676-00d0-3e2a-ac9c-e2e16027449d",
                        "entry_id": "d2f2e072-19fe-3b11-bde2-a17d9e1aa92b",
                        "glosses": [
                            "Évolution erratique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b0c8f933-b205-4609-a1f6-5f4ded59f84c",
                                "sense_id": "67959676-00d0-3e2a-ac9c-e2e16027449d",
                                "text": "Ces sociétés « fonctionnent » sur le mode de la claudication, passant d’une crise à une autre, avec des paliers de réorganisation provisoire des alliances."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c0a710-2e98-47c2-be96-781f6ae32ef5",
                        "source_entry_id": "d2f2e072-19fe-3b11-bde2-a17d9e1aa92b",
                        "source_sense_id": "fe6e9f34-9fc6-384d-9ddf-497239b4dc34",
                        "source_sense_description": "Action de boiter",
                        "target_lang_word": "limp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "442b4eb8-457b-3cc7-b0dc-530b73b63e89",
                                        "entry_id": "6af88bdb-a380-3f4c-90c3-220c3d4eb5fb",
                                        "glosses": [
                                            "To walk lamely, as if favoring one leg."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e7fc19-7bd3-4895-9e4f-6db67142eea8",
                                                "sense_id": "442b4eb8-457b-3cc7-b0dc-530b73b63e89",
                                                "text": "Dirk Kuyt sandwiched a goal in between Carroll's double as City endured a night of total misery, with captain Carlos Tevez limping off early on with a hamstring strain that puts a serious question mark over his participation in Saturday's FA Cup semi-final against Manchester United at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ee1b2a7-019d-3194-a081-bc474ae18c64",
                                        "entry_id": "6af88bdb-a380-3f4c-90c3-220c3d4eb5fb",
                                        "glosses": [
                                            "To travel with a malfunctioning system of propulsion."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d67dd1-fba9-446f-86d9-eca976e404ee",
                                                "sense_id": "0ee1b2a7-019d-3194-a081-bc474ae18c64",
                                                "text": "The bomber limped home on one engine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf33c5c7-c0b5-366c-88dc-20dde6d7caf6",
                                        "entry_id": "6af88bdb-a380-3f4c-90c3-220c3d4eb5fb",
                                        "glosses": [
                                            "To move or proceed irregularly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d874f1e-4cb8-4fda-b51e-7578452fa148",
                                                "sense_id": "bf33c5c7-c0b5-366c-88dc-20dde6d7caf6",
                                                "text": "limping verses"
                                            },
                                            {
                                                "example_id": "4fcc88f5-307c-46cd-9bbc-4f4fc18c6f93",
                                                "sense_id": "bf33c5c7-c0b5-366c-88dc-20dde6d7caf6",
                                                "text": "The business limped through the recession"
                                            },
                                            {
                                                "example_id": "5026ef9c-389a-4cb9-9d2b-cbcc2e429193",
                                                "sense_id": "bf33c5c7-c0b5-366c-88dc-20dde6d7caf6",
                                                "text": "I think, too, of other organizations that are doing much good work for us, and maybe with words are cheered on, but when it comes to the dollars and cents, few are willing to make any sort of sacrifice to put their money where their mouth is. The National Gay Task Force is an excellent example... drawing on the support of gay people in fifty states, yet having to limp along on $65,000 a year budgets. Organizations like Christian Cause, that would wipe us out if they could, draw ten times that amount with little effort."
                                            },
                                            {
                                                "example_id": "4663226b-43bc-4720-afc7-1b93e6a36523",
                                                "sense_id": "bf33c5c7-c0b5-366c-88dc-20dde6d7caf6",
                                                "text": "And so we limped along for another month or two, pretending we still had a reason to be together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d161d4f2-db31-3277-b3ba-0e9d2526335f",
                                        "entry_id": "6af88bdb-a380-3f4c-90c3-220c3d4eb5fb",
                                        "glosses": [
                                            "To call, particularly in an unraised pot pre-flop."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
