{
    "word_family": [
        "gooien",
        "omverwerping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "852f6c4a-f831-3485-8b26-ed18fcf3d5c8",
                    "sense_definition": "Al of niet per ongeluk iets laten vallen of omverstoten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_omgooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond rende enthousiast door de kamer en wist een dure vaas <w>omver</w> te <w>gooien</w>.",
                            "target_lang_translations": {
                                "en": "The dog ran enthusiastically through the room and managed to <w>knock over</w> an expensive vase."
                            }
                        },
                        {
                            "text": "Pas op dat je je glas water niet per ongeluk zult <w>omvergooien</w> tijdens het praten.",
                            "target_lang_translations": {
                                "en": "Be careful not to accidentally <w>knock over</w> your glass of water while talking."
                            }
                        }
                    ],
                    "synonyms": [
                        "omverstoten",
                        "omkieperen",
                        "kantelen"
                    ],
                    "common_phrases": [
                        "een vaas omvergooien",
                        "per ongeluk omvergooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To knock something over or tip it over, whether accidentally or on purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock over",
                                "target_lang_sense_clarification": "to cause something to fall"
                            },
                            {
                                "target_lang_word": "knock down",
                                "target_lang_sense_clarification": "to strike down or cause to fall"
                            },
                            {
                                "target_lang_word": "tip over",
                                "target_lang_sense_clarification": "to cause to overturn"
                            },
                            {
                                "target_lang_word": "overturn",
                                "target_lang_sense_clarification": "to tip over or capsize"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d583a487-8919-33ad-bdae-68f506a0d87f",
                    "sense_definition": "Het uit de macht zetten van een regering of het radicaal veranderen van een bestaand systeem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_omverwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rebellen hadden als voornaamste doel het <w>omvergooien</w> van het regime.",
                            "target_lang_translations": {
                                "en": "The rebels' main goal was the <w>overthrow</w> of the regime."
                            }
                        },
                        {
                            "text": "Zij planden een revolutie om de huidige regering volledig <w>omver</w> te <w>gooien</w>.",
                            "target_lang_translations": {
                                "en": "They planned a revolution to completely <w>overthrow</w> the current government."
                            }
                        }
                    ],
                    "synonyms": [
                        "omverwerpen"
                    ],
                    "common_phrases": [
                        "het regime omvergooien",
                        "de regering omvergooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To overthrow a government or radically change an existing system."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overthrow",
                                "target_lang_sense_clarification": "to remove from power by force"
                            },
                            {
                                "target_lang_word": "subvert",
                                "target_lang_sense_clarification": "to undermine or overturn a system"
                            },
                            {
                                "target_lang_word": "topple",
                                "target_lang_sense_clarification": "to overthrow a government or leader"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}