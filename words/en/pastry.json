{
    "word_family": [
        "paste",
        "pasty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2af68f6-4814-30a1-8d55-c992be86207a",
                    "sense_definition": "A single baked food item made from a flour and fat dough, often containing a sweet or savory filling.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a delicious chocolate <w>pastry</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Она купила вкусное шоколадное <w>пирожное</w> на завтрак.",
                                "zh": "她买了一块美味的巧克力<w>糕点</w>当早餐。"
                            }
                        },
                        {
                            "text": "The hotel serves coffee and fresh <w>pastries</w> every morning.",
                            "target_lang_translations": {
                                "ru": "В отеле каждое утро подают кофе и свежую <w>выпечку</w>.",
                                "zh": "酒店每天早上供应咖啡和新鲜的<w>糕点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tart",
                        "turnover",
                        "danish"
                    ],
                    "common_phrases": [
                        "breakfast pastry",
                        "danish pastry",
                        "sweet pastry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное выпеченное изделие из теста, часто со сладкой или пикантной начинкой",
                        "zh": "一种由面粉和油脂制成的烘焙食品，通常含有甜味或咸味馅料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пирожное",
                                "target_lang_sense_clarification": "сладкое кондитерское изделие небольшого размера"
                            },
                            {
                                "target_lang_word": "слойка",
                                "target_lang_sense_clarification": "изделие из слоёного теста"
                            },
                            {
                                "target_lang_word": "выпечка",
                                "target_lang_sense_clarification": "собирательное название, часто используется во множественном числе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糕点",
                                "target_lang_sense_clarification": "泛指各种点心"
                            },
                            {
                                "target_lang_word": "酥皮点心",
                                "target_lang_sense_clarification": "特指酥脆的西式点心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a37082b-00f1-3467-b69e-ab8b4fb03026",
                    "sense_definition": "A dough made of flour, water, and fat used as a base or covering for baked dishes like pies.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ingredient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should keep the <w>pastry</w> cold before you roll it out.",
                            "target_lang_translations": {
                                "ru": "Нужно держать <w>тесто</w> в холоде перед тем, как раскатывать его.",
                                "zh": "在擀开之前，你应该把<w>面团</w>保持在低温状态。"
                            }
                        },
                        {
                            "text": "This recipe uses a sheet of puff <w>pastry</w> to create a flaky texture.",
                            "target_lang_translations": {
                                "ru": "В этом рецепте используется лист слоеного <w>теста</w> для создания слоистой текстуры.",
                                "zh": "这个食谱用了一张<w>酥皮</w>来营造酥脆的口感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dough",
                        "crust"
                    ],
                    "common_phrases": [
                        "puff pastry",
                        "shortcrust pastry",
                        "phyllo pastry",
                        "flaky pastry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесто из муки, воды и жира, используемое как основа или покрытие для пирогов и других блюд",
                        "zh": "由面粉、水和油脂混合而成的面团，用作派等烘焙食品的底座或外皮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тесто",
                                "target_lang_sense_clarification": "масса для выпекания (обычно слоёное или песочное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面团",
                                "target_lang_sense_clarification": "用于制作烘焙食品的原料"
                            },
                            {
                                "target_lang_word": "酥皮",
                                "target_lang_sense_clarification": "特指用于包裹或做底的层状面皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34c2ee1e-8ebb-369c-a4d3-748001a17ff9",
                    "sense_definition": "Sweet baked foods viewed as a general group or category.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a weakness for rich <w>pastry</w> and cakes.",
                            "target_lang_translations": {
                                "ru": "Он питает слабость к сдобной <w>выпечке</w> и тортам.",
                                "zh": "他特别喜欢吃浓郁的<w>糕点</w>和蛋糕。"
                            }
                        },
                        {
                            "text": "French <w>pastry</w> is famous all over the world for its delicacy.",
                            "target_lang_translations": {
                                "ru": "Французская <w>выпечка</w> славится своей изысканностью во всем мире.",
                                "zh": "法式<w>糕点</w>以其精致闻名于世。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confectionery",
                        "baked goods"
                    ],
                    "common_phrases": [
                        "fine pastry",
                        "French pastry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкие печеные изделия как общая группа или категория",
                        "zh": "作为一类食品的甜味烘焙制品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпечка",
                                "target_lang_sense_clarification": "изделия из теста"
                            },
                            {
                                "target_lang_word": "кондитерские изделия",
                                "target_lang_sense_clarification": "сладости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糕点",
                                "target_lang_sense_clarification": "作为食品类别的统称"
                            },
                            {
                                "target_lang_word": "烘焙食品",
                                "target_lang_sense_clarification": "指代所有烤制的面食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b2dc12-af0e-35e9-b569-f73138e73bd8",
                    "sense_definition": "The professional art of making desserts, or the section of a kitchen dedicated to preparing them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After culinary school, she decided to specialize in <w>pastry</w>.",
                            "target_lang_translations": {
                                "ru": "После кулинарной школы она решила специализироваться на <w>кондитерском деле</w>.",
                                "zh": "从烹饪学校毕业后，她决定专攻<w>西点制作</w>。"
                            }
                        },
                        {
                            "text": "The head chef moved him to the <w>pastry</w> station to learn about desserts.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар перевел его в <w>кондитерский цех</w>, чтобы он научился готовить десерты.",
                                "zh": "主厨把他调到了<w>西点部</w>去学习制作甜点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "patisserie"
                    ],
                    "common_phrases": [
                        "pastry chef",
                        "pastry section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональное искусство приготовления десертов или цех кухни, где их готовят",
                        "zh": "制作甜点的专业技艺，或厨房中专门负责制作甜点的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кондитерское дело",
                                "target_lang_sense_clarification": "профессия или искусство"
                            },
                            {
                                "target_lang_word": "кондитерский цех",
                                "target_lang_sense_clarification": "место на кухне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西点制作",
                                "target_lang_sense_clarification": "指代专业技艺"
                            },
                            {
                                "target_lang_word": "西点部",
                                "target_lang_sense_clarification": "指代厨房中的工作区域"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}