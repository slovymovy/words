            "senses": [
                {
                    "sense_id": "04be39d9-a00f-39d4-8527-d32f90c61383",
                    "sense_definition": "The state or condition of being married; matrimony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple decided to enter into <w>wedlock</w> after five years of dating.",
                            "target_lang_translations": {
                                "tr": "Çift, beş yıllık flörtün ardından <w>evliliğe</w> adım atmaya karar verdi."
                            }
                        },
                        {
                            "text": "Children born out of <w>wedlock</w> once faced significant social stigma.",
                            "target_lang_translations": {
                                "tr": "Bir zamanlar <w>evlilik dışı</w> doğan çocuklar ciddi bir toplumsal damgalanmayla karşı karşıya kalırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "marriage",
                        "matrimony"
                    ],
                    "common_phrases": [
                        "born out of wedlock",
                        "enter into wedlock",
                        "holy wedlock"
                    ],
                    "target_lang_definitions": {
                        "tr": "Evli olma durumu veya hali; evlilik, nikah."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "evlilik",
                                "target_lang_sense_clarification": "evli olma durumu"
                            },
                            {
                                "target_lang_word": "nikah",
                                "target_lang_sense_clarification": "resmi veya hukuki evlilik bağı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6196a6-31a5-378b-9725-600ba0131a29",
                    "sense_definition": "A wife or married woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight returned home to greet his faithful <w>wedlock</w>.",
                            "target_lang_translations": {
                                "tr": "Şövalye, sadık <w>eşini</w> selamlamak için eve döndü."
                            }
                        },
                        {
                            "text": "In old texts, a man's wife was sometimes referred to as his <w>wedlock</w>.",
                            "target_lang_translations": {
                                "tr": "Eski metinlerde, bir adamın karısından bazen onun <w>eşi</w> olarak bahsedilirdi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to refer to a wife"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Eski kullanımda eş, hanım veya evli kadın."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eş",
                                "target_lang_sense_clarification": "evli kadın, hanım (eski kullanım)"
                            },
                            {
                                "target_lang_word": "hatun",
                                "target_lang_sense_clarification": "eş, hanım (eski dil)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
