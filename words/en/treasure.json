{
    "word_family": [
        "treasurer",
        "treasury"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "945bbc8e-ffeb-3a69-a113-77df473d1320",
                    "sense_definition": "A collection of valuable things such as money, gold, or jewels.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wealth_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates buried their <w>treasure</w> on a remote island.",
                            "target_lang_translations": {
                                "ru": "Пираты зарыли свои <w>сокровища</w> на отдаленном острове.",
                                "zh": "海盗们把他们的<w>财宝</w>埋在了一座偏远的岛上。"
                            }
                        },
                        {
                            "text": "We found a map that leads to a hidden <w>treasure</w> deep in the forest.",
                            "target_lang_translations": {
                                "ru": "Мы нашли карту, которая ведет к спрятанному <w>кладу</w> глубоко в лесу.",
                                "zh": "我们找到了一张通往森林深处隐藏<w>宝藏</w>的地图。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buried treasure",
                        "treasure chest",
                        "treasure hunt",
                        "hidden treasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коллекция ценных вещей, таких как деньги, золото или драгоценности.",
                        "zh": "指金钱、珠宝等贵重物品的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокровище",
                                "target_lang_sense_clarification": "богатство, драгоценности"
                            },
                            {
                                "target_lang_word": "клад",
                                "target_lang_sense_clarification": "спрятанные или зарытые ценности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "财宝",
                                "target_lang_sense_clarification": "指金银珠宝等贵重物品"
                            },
                            {
                                "target_lang_word": "宝藏",
                                "target_lang_sense_clarification": "指被隐藏或埋藏的贵重物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef5e7cb-d9f5-319d-8d2d-7d0bd35eb19d",
                    "sense_definition": "Something or someone that is considered very valuable or special.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "valued_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This old book is a real <w>treasure</w> to me because my grandfather gave it to me.",
                            "target_lang_translations": {
                                "ru": "Эта старая книга для меня — настоящее <w>сокровище</w>, потому что мне подарил ее дедушка.",
                                "zh": "这本书对我来说是真正的<w>宝贝</w>，因为它是祖父送给我的。"
                            }
                        },
                        {
                            "text": "She is a <w>treasure</w> to the company and everyone enjoys working with her.",
                            "target_lang_translations": {
                                "ru": "Она — <w>сокровище</w> для компании, и всем нравится с ней работать.",
                                "zh": "她是公司的<w>珍宝</w>，大家都喜欢和她一起工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prize"
                    ],
                    "common_phrases": [
                        "national treasure",
                        "real treasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то или кто-то, кого считают очень ценным или особенным.",
                        "zh": "被认为非常珍贵或特别的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокровище",
                                "target_lang_sense_clarification": "перен. о человеке или предмете"
                            },
                            {
                                "target_lang_word": "драгоценность",
                                "target_lang_sense_clarification": "очень ценная вещь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝贝",
                                "target_lang_sense_clarification": "指珍贵的人或物"
                            },
                            {
                                "target_lang_word": "珍宝",
                                "target_lang_sense_clarification": "指极其珍贵的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1692c7-79b0-3e20-a707-21dd213b4666",
                    "sense_definition": "A term of affection used to address someone you love.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "valued_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, my <w>treasure</w>, and let me fix your coat.",
                            "target_lang_translations": {
                                "ru": "Иди сюда, мое <w>сокровище</w>, дай я поправлю твое пальто.",
                                "zh": "过来，我的<w>宝贝</w>，让我帮你整理一下外套。"
                            }
                        },
                        {
                            "text": "\"Don't worry, <w>treasure</w>,\" he said softly to comfort her.",
                            "target_lang_translations": {
                                "ru": "«Не волнуйся, <w>сокровище</w>», — мягко сказал он, чтобы утешить ее.",
                                "zh": "“别担心，<w>宝贝</w>，”他轻声说道以安慰她。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "my treasure"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a term of endearment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к любимому человеку.",
                        "zh": "对所爱之人的亲昵称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокровище",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝贝",
                                "target_lang_sense_clarification": "亲昵的称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2aabd3d-d242-30ff-b597-b0e47f408249",
                    "sense_definition": "To consider something to be very precious and value it highly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "valued_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will always <w>treasure</w> the memories of our summer holiday.",
                            "target_lang_translations": {
                                "ru": "Я всегда буду <w>дорожить</w> воспоминаниями о нашем летнем отпуске.",
                                "zh": "我会永远<w>珍视</w>我们暑假的那些回忆。"
                            }
                        },
                        {
                            "text": "She <w>treasures</w> the necklace her mother gave her for her birthday.",
                            "target_lang_translations": {
                                "ru": "Она <w>бережет</w> ожерелье, которое мама подарила ей на день рождения.",
                                "zh": "她非常<w>珍惜</w>母亲在她生日时送给她的项链。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cherish",
                        "prize"
                    ],
                    "antonyms": [
                        "despise"
                    ],
                    "common_phrases": [
                        "treasure the memory",
                        "treasure forever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать что-то очень дорогим и высоко ценить это.",
                        "zh": "认为某事物非常珍贵并高度重视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожить",
                                "target_lang_sense_clarification": "высоко ценить, оберегать"
                            },
                            {
                                "target_lang_word": "ценить",
                                "target_lang_sense_clarification": "придавать большое значение"
                            },
                            {
                                "target_lang_word": "беречь",
                                "target_lang_sense_clarification": "хранить как память"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珍视",
                                "target_lang_sense_clarification": "珍惜并重视"
                            },
                            {
                                "target_lang_word": "珍惜",
                                "target_lang_sense_clarification": "爱惜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38916af4-4903-3def-a48e-4e33891e25e5",
                    "sense_definition": "To store or keep something in a safe place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wealth_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>treasured</w> the secret letter inside his coat pocket.",
                            "target_lang_translations": {
                                "ru": "Он <w>хранил</w> секретное письмо во внутреннем кармане пальто.",
                                "zh": "他把那封秘密信件<w>珍藏</w>在自己的外套口袋里。"
                            }
                        },
                        {
                            "text": "The squirrel <w>treasures</w> nuts away for the long winter ahead.",
                            "target_lang_translations": {
                                "ru": "Белка <w>запасает</w> орехи на долгую зиму.",
                                "zh": "松鼠为即将到来的漫长冬天<w>储藏</w>坚果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хранить или беречь что-то в безопасном месте.",
                        "zh": "将某物存放在安全的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "сберегать"
                            },
                            {
                                "target_lang_word": "копить",
                                "target_lang_sense_clarification": "собирать в запас"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珍藏",
                                "target_lang_sense_clarification": "妥善收藏"
                            },
                            {
                                "target_lang_word": "储藏",
                                "target_lang_sense_clarification": "储备存放"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2635f2a9-8f7e-3213-af7a-d5c6e86e929c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Treasure</w> arrived at the meeting late.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Трежер</w> опоздал на встречу.",
                                "zh": "<w>特雷热</w>先生开会迟到了。"
                            }
                        },
                        {
                            "text": "We are looking for the records of the <w>Treasure</w> family.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье <w>Трежер</w>.",
                                "zh": "我们正在寻找<w>特雷热</w>家族的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Трежер",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特雷热",
                                "target_lang_sense_clarification": "音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97610a15-2e2e-3345-88fa-ce542f698fd1",
                    "sense_definition": "A female given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met a girl named <w>Treasure</w> at school today.",
                            "target_lang_translations": {
                                "ru": "Сегодня в школе я познакомился с девочкой по имени <w>Трежер</w>.",
                                "zh": "今天在学校我遇见了一个叫<w>特雷热</w>的女孩。"
                            }
                        },
                        {
                            "text": "<w>Treasure</w> is coming to the party with us.",
                            "target_lang_translations": {
                                "ru": "<w>Трежер</w> идет на вечеринку с нами.",
                                "zh": "<w>特雷热</w>要和我们一起去参加派对。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Трежер",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特雷热",
                                "target_lang_sense_clarification": "音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}