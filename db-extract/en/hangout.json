                                    {
                                        "sense_id": "b54d49a6-16b7-3ac4-8959-7c1020bce910",
                                        "entry_id": "0d82ed61-d284-3be0-9f5b-fb366c070e13",
                                        "glosses": [
                                            "Farbe im französischen Blatt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d6f1ba-9fb4-454e-9e1a-3b1cd5c46b28",
                                                "sense_id": "b54d49a6-16b7-3ac4-8959-7c1020bce910",
                                                "text": "Beim Skat ist Treff die höchste Farbe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Treff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9ac3ae-835a-33cb-a8d0-44df914a2c0b",
                                        "entry_id": "4f5de31d-5b1d-30a1-95c9-18f27b30f1ae",
                                        "glosses": [
                                            "geplante Zusammenkunft, Treffen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b3f08c-067f-4ef8-9a35-b42601ee4fd6",
                                                "sense_id": "1b9ac3ae-835a-33cb-a8d0-44df914a2c0b",
                                                "text": "An jedem ersten Dienstag im Monat haben wir einen Treff mit alten Arbeitskollegen."
                                            },
                                            {
                                                "example_id": "cdc97cfd-7ee6-4ff8-b6cb-88517bb6ea9c",
                                                "sense_id": "1b9ac3ae-835a-33cb-a8d0-44df914a2c0b",
                                                "text": "„Er sagte mir, ich solle nicht so traurig dreinblicken, denn das passe nicht zu mir, und wenn ich Lust hätte, solle ich zu seinem Treff am Sonntagnachmittag kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1d1631b-6617-3c86-8e21-6190075c339a",
                                        "entry_id": "4f5de31d-5b1d-30a1-95c9-18f27b30f1ae",
                                        "glosses": [
                                            "Ort der Zusammenkunft, des Treffens"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7c1fe0-c18f-40b1-a8a8-a84d839bedae",
                                                "sense_id": "d1d1631b-6617-3c86-8e21-6190075c339a",
                                                "text": "Der Brunnen am Marktplatz ist ein Treff für Jugendliche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
