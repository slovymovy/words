                                "sense_id": "fcbe9fd0-c218-3c91-b3c8-4f94b2fc4e86",
                                "text": "Получить деньги по доверенности."
                            },
                            {
                                "example_id": "ba5708a0-6d64-4ec1-8941-9dfb28a78895",
                                "sense_id": "fcbe9fd0-c218-3c91-b3c8-4f94b2fc4e86",
                                "text": "Выдать доверенность на покупку имущества."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea1f8c6e-6bd1-3ef4-8d58-873309dccf8d",
                        "entry_id": "64d74fe6-2e14-34ce-a8a6-a0a870df1893",
                        "glosses": [
                            "устар. доверие"
                        ],
                        "tags": [
                            "только ед."
                        ],
                        "examples": [
                            {
                                "example_id": "2a73e42d-204d-42c0-b7ca-6a5424b58117",
                                "sense_id": "ea1f8c6e-6bd1-3ef4-8d58-873309dccf8d",
                                "text": "Доверенность её с каждым днём возрастала."
