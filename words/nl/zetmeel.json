                    "sense_id": "dea963b9-791a-3ab6-a86c-7904dbfed09e",
                    "sense_definition": "een verzamelnaam voor complexe koolhydraten die planten gebruiken als energievoorraad",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voedingsstoffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aardappelen en granen bevatten een grote hoeveelheid <w>zetmeel</w>.",
                            "target_lang_translations": {
                                "en": "Potatoes and grains contain a large amount of <w>starch</w>."
                            }
                        },
                        {
                            "text": "Tijdens de spijsvertering wordt <w>zetmeel</w> afgebroken tot enkelvoudige suikers.",
                            "target_lang_translations": {
                                "en": "During digestion, <w>starch</w> is broken down into simple sugars."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bevat veel zetmeel",
                        "vrij van zetmeel"
                    ],
                    "target_lang_definitions": {
                        "en": "a collective term for complex carbohydrates that plants use as an energy reserve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "starch",
                                "target_lang_sense_clarification": "complex carbohydrate in plants"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "319bbb20-6177-374a-beb8-4cf49f1eae1d",
                    "sense_definition": "een wit, poederachtig product dat in de keuken wordt gebruikt als bindmiddel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "keukeningrediënten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de saus dikker maken door een beetje <w>zetmeel</w> toe te voegen.",
                            "target_lang_translations": {
                                "en": "You can make the sauce thicker by adding a little <w>starch</w>."
                            }
                        },
                        {
                            "text": "Meng het <w>zetmeel</w> eerst met koud water om klontjes in de saus te voorkomen.",
                            "target_lang_translations": {
                                "en": "Mix the <w>starch</w> with cold water first to prevent lumps in the sauce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vloeibaar zetmeel",
                        "zetmeel toevoegen"
                    ],
                    "target_lang_definitions": {
