                                        "entry_id": "e6b000a7-cee4-3fa2-b157-8997738277f5",
                                        "glosses": [
                                            "Celle qui voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6402881b-3fdb-4e0c-8d18-908c3d84cf49",
                                                "sense_id": "eaf63840-3b7e-3118-8632-93fd954959b6",
                                                "text": "Cependant, dès que la voyageuse eut sauté sur le marchepied, il fit coinquer sa trompette et la lourde voiture démarra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5285b1-0685-3130-8903-54ee87c25d0d",
                                        "entry_id": "e6b000a7-cee4-3fa2-b157-8997738277f5",
                                        "glosses": [
                                            "Celle qui fait ou qui a fait de grands voyages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cbfe6bd-8ae5-37f1-99be-f45dcabcc413",
                                        "entry_id": "e6b000a7-cee4-3fa2-b157-8997738277f5",
                                        "glosses": [
                                            "Celle qui fait partie des gens du voyage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "voyageuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26ffd460-3194-3cad-9394-a77d36853a29",
                                        "entry_id": "e78c44bd-85db-3c2b-83ad-0a0ba91a2c1d",
                                        "glosses": [
                                            "Féminin singulier de voyageur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c694ed0-2c7b-4476-b4d0-7062b2927b85",
                                                "sense_id": "26ffd460-3194-3cad-9394-a77d36853a29",
                                                "text": "La troupe voyageuse, qui ne s’était arrêtée à Worringen que pour déjeuner, arriva vers les quatre heures du soir à Neufs."
                                            },
                                            {
                                                "example_id": "6ab57f4c-7a3c-4513-afda-a9b330f4ec09",
                                                "sense_id": "26ffd460-3194-3cad-9394-a77d36853a29",
                                                "text": "Au pied de ces petits murs, les vieux viennent s’asseoir au soleil pour filer ou dormir entre l’enclos inculte et silencieux et l’éternité voyageuse de la mer…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
