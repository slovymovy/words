                        "examples": [
                            {
                                "example_id": "e26032b3-fedd-49cf-b681-7140c98b8c17",
                                "sense_id": "1eee7e18-f52f-3156-b6bd-ec93fda713c4",
                                "text": "Jetant bas alors toison de chanvre et rides, l’imprévue chenapane m’assaille au narquois buccin de sa brutale saison brune, si bien que la nausée du scandale arrache à ma besace confuse une illusion — la première."
                            }
                        ]
                    },
                    {
