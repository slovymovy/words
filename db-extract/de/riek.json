                ],
                "senses": [
                    {
                        "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                        "entry_id": "28065a24-79a4-31c9-9fc4-3e455a7efe96",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c0ad5c-4c39-444a-8cdd-2329917b788d",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Riek kommt und geht."
                            },
                            {
                                "example_id": "8aeb7fc6-a466-4bf1-8c35-596d1ca9a4d2",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Rieks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "0b551bbf-d45a-4beb-b819-9ca3a60c00af",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Frau Riek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "45c0e658-5665-4a1d-9760-6051a8b74a0b",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Herr Riek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fde03a93-3438-4777-88bf-4ef8b62b7659",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Die Rieks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4b4e245f-88a1-445c-9062-3da73e8eec4d",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Der Riek trägt nie die Schals, die die Riek ihm strickt."
                            },
                            {
                                "example_id": "71e68d45-8e8a-4f37-891f-e91208ae3175",
                                "sense_id": "0d7af603-69cd-3090-ace7-a28c84d8eb9d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Riek kommt, geht der Herr Riek.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
