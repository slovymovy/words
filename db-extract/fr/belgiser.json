                "senses": [
                    {
                        "sense_id": "984a1e85-bd9b-3a8e-98ed-2318dfd84244",
                        "entry_id": "39e2eea8-2e90-3a63-86fd-1f09e0208562",
                        "glosses": [
                            "Rendre belge (ou plus belge)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f712bc-7934-4b24-807c-a2cae9565c03",
                                "sense_id": "984a1e85-bd9b-3a8e-98ed-2318dfd84244",
                                "text": "Ceux-ci s'attachent d'ailleurs à « belgiser » autant que faire se peut les émissions des télévisions limitrophes."
                            },
                            {
                                "example_id": "00c02b9e-117a-4448-8c78-5664e4244e91",
                                "sense_id": "984a1e85-bd9b-3a8e-98ed-2318dfd84244",
                                "text": "La Belgique passa sous la domination de la Hollande où le soldat est habitué aux coups de bâton, et comme la Belgique a une population double de celle de Hollande, il est clair qu'il valait mieux belgiser les Hollandais en supprimant ses mesures philanthropiques."
                            }
                        ]
                    }
