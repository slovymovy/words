                    {
                        "translation_id": "783315f3-1923-49f5-94e1-e9a0fe9d9874",
                        "source_entry_id": "bb2ecd21-ceaf-3ce0-bb38-be6490ea1cfc",
                        "source_sense_id": "d482190d-af8c-3b85-b98a-cb2d44da3f30",
