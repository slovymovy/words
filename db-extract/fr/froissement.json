                                    },
                                    {
                                        "sense_id": "c5fcd4b7-3513-3a2a-8e81-1d313c4a9a98",
                                        "entry_id": "544f56b3-d0da-3c26-97fc-9e60be5cb1a5",
                                        "glosses": [
                                            "The act of wrinkling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00185e10-7a5a-4c8b-b5ca-f8d980299833",
                                                "sense_id": "c5fcd4b7-3513-3a2a-8e81-1d313c4a9a98",
                                                "text": "Would she be able to appreciate the subtlety of their advances, if they made any; those little twitches and twists of the lips, those narrowings and rollings of the eye, those wrinklings of the speculative temple, that shrugging of an eyebrow at play?"
                                            }
