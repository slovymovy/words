                "senses": [
                    {
                        "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                        "entry_id": "5e0a7618-fbca-3b36-abc9-0fd26fe8ac94",
                        "glosses": [
                            "Qui est donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f334de95-ae9a-4196-9f88-3ab5f9366023",
                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                "text": "Tutelle dative : Tutelle en l'absence de désignation par testament ou si le désigné refuse sa charge, tuteur désigné par le conseil de famille, à la différence de celle qui est déférée par voie testamentaire."
                            },
                            {
                                "example_id": "9105c2a1-5dfe-4570-9878-994da88a9b72",
                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                "text": "On dit dans un sens analogue :"
                            },
                            {
                                "example_id": "ef882a32-dd28-4baf-93de-6f9ae448dd52",
                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                "text": "Tuteur datif."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                "word": "datif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "730ae31b-4995-487e-828e-2b633a340dd9",
                        "entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                        "tags": [
                            "plural"
                        ],
                        "form": "datifs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                        "entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                        "glosses": [
                            "Cas grammatical qui sert à marquer le complément d’attribution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962010eb-14d1-408c-9fda-89849ed384c8",
                                "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                                "text": "Strasbourg boit de la bière comme une ville d’université d’au-delà du Rhin, et sur les enseignes de ses brasseries le datif germanique se substitue souvent au génitif français."
                            },
                            {
                                "example_id": "ec5afc53-c514-4181-bf8b-154d0284de05",
                                "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                                "text": "En effet, aussi bien Herslund que Jacob font observer que le datif se présente très souvent sous forme de clitique, simple (comme en français) ou par redoublement (comme en espagnol)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6146136c-4b63-42c2-89a2-852c3810c769",
                        "source_entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                        "source_sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                        "target_lang_word": "Dativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                        "entry_id": "2c1f1f91-5400-359c-86bf-320f3fd3b7d7",
                                        "glosses": [
                                            "Wem-Fall, (im Deutschen und Lateinischen) 3. Fall (Kasus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "823752fb-b6b7-44cd-9014-36e6a305b21a",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "Im Dativ stehen im Satz oft Personen, denen geholfen wird: \"Dem Manne kann geholfen werden.\""
                                            },
                                            {
                                                "example_id": "2f8ab014-cf15-46c5-94a9-a77e1a20d479",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Was Holländer mit dem deutschen Dativ haben, ist mir schleierhaft.“"
                                            },
                                            {
                                                "example_id": "4d1c482d-cab2-4dbb-98cf-b583788ea6eb",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "25e94e29-62ee-489c-8b41-2343b768f59f",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Der Genitiv ist auf vielen Feldern auf dem Rückzug und wird durch den Dativ ersetzt.“"
                                            },
                                            {
                                                "example_id": "54a6928e-680a-44a4-af9f-7707d654fc3e",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Auch in den Überlieferungen wird der Dativ aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65ccd866-da44-4122-b6aa-bae1ec0e0e59",
                        "source_entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                        "source_sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                        "target_lang_word": "Wemfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wemfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73127385-b3be-38bb-98e6-3b46633c3385",
                                        "entry_id": "cc1b3f6a-da5f-3202-9df5-8c65d52e7a77",
                                        "glosses": [
                                            "Synonym von Dativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb40a99b-1c2a-4c3e-82ca-1c7dbd702ddd",
                                                "sense_id": "73127385-b3be-38bb-98e6-3b46633c3385",
                                                "text": "Nach den Wörtern im Satz, die im Wemfall stehen, kann man mit \"wem\" fragen."
                                            },
                                            {
                                                "example_id": "603367a5-3ec8-445a-9889-079c68136216",
                                                "sense_id": "73127385-b3be-38bb-98e6-3b46633c3385",
                                                "text": "Das Metzler Lexikon Sprache führt zum Dativ aus: „In Schulbüchern auch: Wemfall, Zuwendgröße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
