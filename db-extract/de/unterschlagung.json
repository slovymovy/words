                    {
                        "translation_id": "eeff3c4d-12b3-4a0d-8bc3-1ccf078effce",
                        "source_entry_id": "57716e37-9e35-3eac-8f0d-ee6cbec2260e",
                        "source_sense_id": "98cab05f-214c-3e7b-bf22-8510c8cf5677",
                        "source_sense_description": "rechtswidrige Aneignung fremden Eigentums im Eigenbesitz",
                        "target_lang_word": "defalcation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defalcation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b14e4d8b-3649-35b3-af6a-fe760c16ba65",
                                        "entry_id": "ae913ac0-f719-3991-9fd6-bdd90167180f",
                                        "glosses": [
                                            "The act of cancelling part of a claim by deducting a smaller claim which the claimant owes to the defendant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                                        "entry_id": "ae913ac0-f719-3991-9fd6-bdd90167180f",
                                        "glosses": [
                                            "Embezzlement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48576b66-fde9-440c-8022-d5456e5f6ae5",
                                                "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                                                "text": "Granting that Mr. Ireland had gone into his office at ten minutes to ten o'clock at night for the purpose of extracting £5000 worth of notes and gold from the bank safe, whilst giving the theft the appearance of a night burglary; […] why should he, at nine o'clock the following morning, fall in a dead faint and get cerebral congestion at sight of a defalcation he knew had occurred?"
                                            },
                                            {
                                                "example_id": "1c736057-ad87-4ec3-a18c-e6d60637d194",
                                                "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                                                "text": "“Why should Eldridge commit murder?[…]There was only one possible motive—namely, he wished to avoid detection as James Selby of Anaconda Ltd. He had settled down in Estrepps. There were several persons in the town who had suffered from his defalcations.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f55df9-2a16-4ab1-91e5-3092f2ce605a",
                        "source_entry_id": "57716e37-9e35-3eac-8f0d-ee6cbec2260e",
                        "source_sense_id": "98cab05f-214c-3e7b-bf22-8510c8cf5677",
                        "source_sense_description": "rechtswidrige Aneignung fremden Eigentums im Eigenbesitz",
                        "target_lang_word": "détournement de fonds",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détournement de fonds",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba86a85-69bd-35fb-9898-2c6f987577c9",
                                        "entry_id": "6056dc34-b72f-3285-a238-00a15441c1ab",
                                        "glosses": [
                                            "Délit d’appropriation de sommes, de titres dont on n’a pas la pleine propriété."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633918d6-d74f-491d-81a4-958eb4aec08a",
                                                "sense_id": "5ba86a85-69bd-35fb-9898-2c6f987577c9",
                                                "text": "Dans les dernières années du XVIIIᵉ siècle, il y avait eu plusieurs procès très médiatisés contre des fonctionnaires et des hommes politiques pour mauvaise gestion, détournement de fonds et abus de pouvoirs."
                                            },
                                            {
                                                "example_id": "5bd2674f-4d8e-4b11-8bf9-3edee8918aa4",
                                                "sense_id": "5ba86a85-69bd-35fb-9898-2c6f987577c9",
                                                "text": "Elle l'a mis en examen dans cette affaire le 21 novembre 2007 pour « détournements de fonds » et l'intéressé a été entendu par le juge à deux reprises. L'ancien chef de l'État a finalement été renvoyé devant le Tribunal correctionnel de Paris le 30 octobre 2009 pour « détournements de fonds publics » et « abus de confiance » pour les vingt et un emplois de complaisance présumés payés par le cabinet du maire de Paris."
                                            },
                                            {
                                                "example_id": "c715b30a-f905-4c00-a22c-66067f76c029",
                                                "sense_id": "5ba86a85-69bd-35fb-9898-2c6f987577c9",
                                                "text": "Mise en examen pour détournement de fonds publics, la députée du Pas-de-Calais est auditionnée ce lundi 14 octobre dans le cadre du procès des assistants parlementaires du RN."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
