                "senses": [
                    {
                        "sense_id": "60cc6541-2f09-3537-8bac-d7ae5e8837b1",
                        "entry_id": "1b51d67c-3c52-3433-ac36-45fcecc2c458",
                        "glosses": [
                            "Wohnung, die von Eltern bewohnt wird; elterliche Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e12a7d-56ba-477a-8906-e9789437974f",
                                "sense_id": "60cc6541-2f09-3537-8bac-d7ae5e8837b1",
                                "text": "„Und bei der Gelegenheit könnte man all jenen Jugendlichen, die von ihrer Stadt nur den Schulweg und die Sicht aus dem Fenster der Elternwohnung kennen, den Blick öffnen und sie mit Neugier anstecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "533bf656-4c8d-3cf6-8496-fe96d4960947",
                        "entry_id": "1b51d67c-3c52-3433-ac36-45fcecc2c458",
                        "glosses": [
                            "Wohnung, die Eltern zur Verfügung gestellt wird (zum Beispiel in einer Klinik), damit sie an der Betreuung ihres Kindes mitwirken können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abad7c40-4be1-4bde-93a9-7dd34af1b614",
                                "sense_id": "533bf656-4c8d-3cf6-8496-fe96d4960947",
                                "text": "„Anfang 1986 unterzeichnete die damalige Vorsitzende der Elterninitiative den Mietvertrag für unsere erste Elternwohnung in der Raphaelstraße.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
