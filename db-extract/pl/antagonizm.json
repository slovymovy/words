                    {
                        "translation_id": "48f97010-c2f1-4b5e-a3c5-735149c2257f",
                        "source_entry_id": "a3de5cef-7594-3d4c-8a83-089fc9870b53",
                        "source_sense_id": "b8e358e4-071a-3f7a-86e2-6ba1b0f8c380",
                        "target_lang_word": "antagonism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antagonism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdcdbb6e-2579-3cb0-be10-79d9af5b5e32",
                                        "entry_id": "22bf9820-7667-3001-8088-fc303d2067d5",
                                        "glosses": [
                                            "A strong natural dislike or hatred; antipathy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "039b8a91-082a-477e-be86-fef3e52748a7",
                                                "sense_id": "cdcdbb6e-2579-3cb0-be10-79d9af5b5e32",
                                                "text": "Their longstanding antagonism is manifested in frequent scuffles and shouting matches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1cb7c13-7547-4f3a-a0ff-791ca6e01883",
                        "source_entry_id": "a3de5cef-7594-3d4c-8a83-089fc9870b53",
                        "source_sense_id": "b8e358e4-071a-3f7a-86e2-6ba1b0f8c380",
                        "target_lang_word": "antagonisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antagonisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                        "entry_id": "eb880721-3901-379a-8eca-99e62917e205",
                                        "glosses": [
                                            "État de lutte, de rivalité ou d'opposition entre deux forces, deux principes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774f069b-9053-4308-9b55-8032f96ed9f1",
                                                "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                                "text": "À un fouriériste ardennais qui constate une lutte des classes inéluctable, il répond : pas d’antagonisme sous le régime de la liberté économique, il y a intérêt pour les deux parties à se rencontrer pour discuter des salaires."
                                            },
                                            {
                                                "example_id": "e9c70d39-b7a0-44c9-94ca-024b09e16231",
                                                "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                                "text": "L’absence de liberté résulte donc de l’antagonisme de deux déterminismes comportementaux et de la domination de l’un sur l’autre."
                                            },
                                            {
                                                "example_id": "1e47bb9a-8cbe-4076-b665-45c216ee6466",
                                                "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                                "text": "L’antagonisme de ces deux puissances a causé de longues guerres."
                                            },
                                            {
                                                "example_id": "5f533fe9-092b-40ad-85ac-a361b84177de",
                                                "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                                "text": "L’antagonisme de ces deux partis a troublé la paix publique."
                                            },
                                            {
                                                "example_id": "ee1cb0ab-bc27-49db-b16e-367eba5ecd5a",
                                                "sense_id": "a81d4c62-9438-3774-92d9-131d3233b8fe",
                                                "text": "Antagonisme d’opinions, de vues, de systèmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b19e32f-eba9-3af8-b5cf-76399ef74816",
                                        "entry_id": "eb880721-3901-379a-8eca-99e62917e205",
                                        "glosses": [
                                            "Action de deux muscles, de deux organes, de deux substances agissant en sens contraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "428d6b5a-bf21-4b75-81c7-8ad5941cc566",
                                                "sense_id": "8b19e32f-eba9-3af8-b5cf-76399ef74816",
                                                "text": "L'antagonisme du biceps et du triceps dans le bras."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10f0184-200a-4e5c-b0fd-f8d24a2000a5",
                        "source_entry_id": "a3de5cef-7594-3d4c-8a83-089fc9870b53",
                        "source_sense_id": "b8e358e4-071a-3f7a-86e2-6ba1b0f8c380",
                        "target_lang_word": "antagonismo",
