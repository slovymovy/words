                "senses": [
                    {
                        "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                        "entry_id": "9bd8a954-ae44-3d42-bac6-2c0ce6eca164",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "246f8c5e-46e0-4903-8a1f-03d5ef7ff84f",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Frau Dennerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "34b0a1e2-ab34-41b7-b77c-c4687106d2ee",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Herr Dennerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cf44f857-fbeb-4db7-81ec-517afaa659cd",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Die Dennerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ad4fbe4b-83de-40af-8f4f-6c61d562c9d6",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Der Dennerle trägt nie die Schals, die die Dennerle ihm strickt."
                            },
                            {
                                "example_id": "411690f1-85cc-42b1-be26-49b4f355df83",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dennerle kommt, geht der Herr Dennerle.“"
                            },
                            {
                                "example_id": "83da0f8f-0fd1-44bd-868f-2f87f4c4ced0",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Dennerle kommt und geht."
                            },
                            {
                                "example_id": "e4c4a88b-a94e-4ccd-98f8-a6bd5d81ad26",
                                "sense_id": "bbe09277-ab17-3e88-b748-a86fc25edd34",
                                "text": "Dennerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
