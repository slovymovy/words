                                                "sense_id": "6a1ffdcf-8a81-30ee-9efa-ca2d4a02aee4",
                                                "text": "Il y a perversion de l’appétit dans le pica, de la vue dans la diplopie."
                                            }
                                        ]
                                    }
                                ]
