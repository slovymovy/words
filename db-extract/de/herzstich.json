                        "target_lang_word": "pincement au cœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pincement au cœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e4ef7a-b261-3341-b8c8-23744ed425c3",
                                        "entry_id": "50c55931-e70b-3e3c-ad0e-bf9d1a61d93b",
                                        "glosses": [
                                            "Sensation brève de douleur et d’angoisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1733408-ae63-42f0-a3ac-bdc27206c121",
                                                "sense_id": "20e4ef7a-b261-3341-b8c8-23744ed425c3",
                                                "text": "N'empêche qu'elle avait eu un pincement au cœur et que le soir, à l'hôtel, elle avait failli demander si l'on n'avait pas vu Ferdinand Graux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe2c6404-8cc4-348b-bc37-8d5b1cfb551e",
                                        "entry_id": "50c55931-e70b-3e3c-ad0e-bf9d1a61d93b",
                                        "glosses": [
                                            "Sentiment qui donne cette sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51a176d-971b-4cc1-8730-2c110e1c42d0",
                                                "sense_id": "fe2c6404-8cc4-348b-bc37-8d5b1cfb551e",
                                                "text": "Et Jourgeot, d’un œil hagard, dilaté, le rouge au front, le sang aux tempes, voyait tout cela, un étrange pincement au cœur."
                                            },
                                            {
                                                "example_id": "10d53f4a-daf5-427f-b6cb-608c8fe4c361",
                                                "sense_id": "fe2c6404-8cc4-348b-bc37-8d5b1cfb551e",
                                                "text": "La vie m’impose une pause dans la rédaction de mes chroniques et je ne peux vous cacher que c’est avec un pincement au cœur que j’ai lâché prise."
                                            },
                                            {
                                                "example_id": "13764636-dce8-4a45-9c98-59d651262a7c",
                                                "sense_id": "fe2c6404-8cc4-348b-bc37-8d5b1cfb551e",
                                                "text": "Ai-je un pincement au cœur en repensant à Montréal ? Même pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
