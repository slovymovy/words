                            }
                        },
                        {
                            "text": "The museum celebrates the nation's <w>glorious</w> past.",
                            "target_lang_translations": {
                                "ru": "Музей прославляет <w>славное</w> прошлое нации.",
                                "nl": "Het museum viert het <w>glorieuze</w> verleden van de natie.",
                                "pl": "Muzeum celebruje <w>sławną</w> przeszłość narodu.",
                                "de": "Das Museum feiert die <w>ruhmvolle</w> Vergangenheit der Nation.",
                                "fr": "Le musée célèbre le passé <w>glorieux</w> de la nation.",
                                "it": "Il museo celebra il <w>glorioso</w> passato della nazione.",
                                "cs": "Muzeum oslavuje <w>slavnou</w> minulost národa.",
                                "tr": "Müze, ulusun <w>şanlı</w> geçmişini kutluyor.",
                                "es": "El museo celebra el <w>glorioso</w> pasado de la nación.",
                                "zh": "这家博物馆旨在纪念这个国家<w>辉煌</w>的过去。"
                            }
