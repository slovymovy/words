                                        "entry_id": "b83371c0-8ca0-37f8-ad7e-172a94460627",
                                        "glosses": [
                                            "Qui éprouve une vive passion pour une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df07c06-97a8-4b14-af68-ffd869cfb206",
                                                "sense_id": "95cb4b8d-70f0-32d3-8c9a-678cbffc0f98",
                                                "text": "Tout-à-coup... un énorme lion surgit devant lui, la gueule ouverte, l'oeil enflammé..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1fb9e8-a133-376f-bef2-bcf6f14bec08",
                                        "entry_id": "b83371c0-8ca0-37f8-ad7e-172a94460627",
                                        "glosses": [
                                            "Plein d’amour, qui est inspiré par l’amour."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c311db9e-d883-4e6f-850e-879c03ad49b9",
                                                "sense_id": "4a1fb9e8-a133-376f-bef2-bcf6f14bec08",
                                                "text": "J’irai me baigner à la fontaine où croissent les lys rouges, enflammés comme tes baisers."
                                            }
                                        ]
                                    }
                                ]
                            },
