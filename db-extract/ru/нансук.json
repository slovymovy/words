                                        "entry_id": "7c0fd064-4d6c-3b1b-a0f6-ad2d8ff2813c",
                                        "glosses": [
                                            "A soft, fine muslin of South Asian origin, sometimes used to make baby clothes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0b12dfc-be97-4ffc-89bb-67d62394e01a",
                                                "sense_id": "107f826b-8680-3e59-b857-c061341d69fa",
                                                "text": "Smocking done in colors on fine white batiste, silk mull, or nainsook makes pretty guimpes and dresses for children and very smart blouses for women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
