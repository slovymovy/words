                "senses": [
                    {
                        "sense_id": "7617c583-9312-3861-a2bc-2ac3705d315a",
                        "entry_id": "b10454ab-45ba-349f-bc01-27256a541175",
                        "glosses": [
                            "auf Jahrmärkten, Volksfesten oder in Vergnügungsparks anzutreffendes, elektrisch angetriebenes, autoähnliches, kleines zweisitziges, lenkbares Fahrzeug mit breitem, wulstartigem Gummirand (zum Schutz vor Zusammenstößen), das in einem Fahrgeschäft auf einer begrenzten Fahrfläche gesteuert wird"
                        ],
                        "tags": [
                            "Westösterreich",
                            "(Vorarlberg)",
                            "Ostschweiz"
                        ],
                        "examples": [
                            {
                                "example_id": "d6e05ba0-370b-489a-9d8a-72dd9980fa08",
                                "sense_id": "7617c583-9312-3861-a2bc-2ac3705d315a",
                                "text": "«Eine kleine Versammlung vor Spenglers Autoscooter macht ihn neugierig. Er schwebt hinunter und landet mitten im Gottesdienst für Schausteller. Die Chilbileute sitzen in den Tütschautos, während vor dem Kassenwagen mit seinen blinkenden Gitarren und Saxofonen eine Frau steht und predigt.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
