                        "entry_id": "8055ce57-f96b-3b00-bcba-92d1aa0573ea",
                        "glosses": [
                            "besonders leichter, tragbarer, flacher Kleincomputer mit einem Touchscreen, der mithilfe eines Stifts oder durch Berühren des Bildschirms mit den Fingern bedient wird"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f44839-b067-410e-ac09-4fec46ea8e97",
                                "sense_id": "3e81a59a-4c46-324d-88f6-ce23abe72344",
                                "text": "Ich surfe gerne im Internet mit einem Tabletcomputer."
                            },
                            {
                                "example_id": "f619bea8-fe19-4d06-bc97-3fe4b109693a",
                                "sense_id": "3e81a59a-4c46-324d-88f6-ce23abe72344",
                                "text": "„Die Finnen haben bereits 2014 eine vergleichbare Kooperation für den Tabletcomputer Nokia N1 lanciert, der vom taiwanesischen Foxconn-Konzern hergestellt wird.“"
                            },
                            {
                                "example_id": "cb307ba1-db41-4e11-ac6e-861411955b65",
                                "sense_id": "3e81a59a-4c46-324d-88f6-ce23abe72344",
                                "text": "„Immer lieber nutzen sie dafür Handys oder Tabletcomputer wie das iPad, und das verändert die Lage erneut dramatisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
