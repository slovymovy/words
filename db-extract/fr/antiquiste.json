                        "glosses": [
                            "(Historiographie) Historien spécialiste de l’Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32986f2-f7fe-46a6-805d-de4da75c2ad4",
                                "sense_id": "9c66f782-05db-3b8a-a6a5-24ca708f4471",
                                "text": "Comme on l’a dit, il était sans doute plus facile, pour une antiquiste classique, de passer des femmes au genre à cause de la nature de la documentation qui […] favorisait l’approche constructiviste."
                            },
                            {
                                "example_id": "5332187e-3cc4-4afa-bcd6-95ad68138267",
                                "sense_id": "9c66f782-05db-3b8a-a6a5-24ca708f4471",
                                "text": "Un antiquiste, A. Piganiol, prétend que l’empire a été assassiné par les invasions barbares, tandis que le médiéviste, F. Lot, répond « l’empire est mort de lui-même, les barbares se sont emparés d’un cadavre »."
                            },
                            {
                                "example_id": "0cef9a4f-fe5a-45a6-93f1-fb855a3cec14",
                                "sense_id": "9c66f782-05db-3b8a-a6a5-24ca708f4471",
                                "text": "Les antiquistes, les médiévistes, les modernistes, les contemporanéistes, sans compter les préhistoriens, les archéologues, ont tous largement abordé l’objet."
                            }
                        ]
                    }
