                "senses": [
                    {
                        "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                        "entry_id": "bae86bcd-e49d-3fc1-a507-78ebbc14a92f",
                        "glosses": [
                            "klare, schriftliche Erklärung, wie die Lüftung des Raumes oder Gebäudes rechtssicher zu erfolgen hat; Gebrauchsanweisung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a92f209-4970-47c1-b52d-215af3c35806",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Für Schäden, die aus der Nichtbeachtung der Vorschrift entstehen, ist der Mieter haftbar. Beachten Sie die Lüftungsanleitung.“"
                            },
                            {
                                "example_id": "04b616e6-10bf-49bf-b570-20e29a296333",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Deshalb sollte beispielsweise auch in Deutschland jedem Wohnnutzer - nicht nur der Gebäudeenergieausweis gezeigt -, sondern auch eine brauchbare Lüftungsanleitung ausgehändigt werden.“"
                            },
                            {
                                "example_id": "c7271335-12bf-47f9-8fe1-7658fa1b6ac1",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Manchmal machen sich Vermieter auch die Mühe, dem Mietvertrag spezielle Lüftungsanleitungen als Anlage hinzuzufügen.“"
                            },
                            {
                                "example_id": "4b2d8341-3a21-4d54-87b4-e9a93f604736",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Wenn Sie nach dieser Lüftungsanleitung bedarfsgerecht die Keller lüften, so wird die von unserem Verfahren ausgetriebene Feuchtigkeit auch bedarfsgerecht abgeführt.“"
                            },
                            {
                                "example_id": "b65e1120-d213-444b-b696-05a76653df6a",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Nägele fürchtet, dass sich Schimmel breitmacht im Haus, wenn die Mieter nicht regelmäßig lüften. \"Statt Lüftungsanlage kriegen die eine Lüftungsanleitung. Das muss reichen\", stellte Michael Lang nach kurzer Debatte kategorisch fest - worauf der Schultes mit seinem Antrag beim Gremium glatt abblitzte.“"
                            },
                            {
                                "example_id": "56c07d36-850e-4bc8-928c-660eddc0baf6",
                                "sense_id": "fb36f55e-a66c-33dd-b9d3-9320c1e1cd2e",
                                "text": "„Weder dem Hausverwalter noch den Mietern wurde nach der Sanierung eine Lüftungsanleitung für die Wohnung übergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
