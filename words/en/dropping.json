                                "target_lang_word": "опускание",
                                "target_lang_sense_clarification": "перемещение вниз"
                            },
                            {
                                "target_lang_word": "сбрасывание",
                                "target_lang_sense_clarification": "активное действие"
                            }
                        ],
                        "pl": [
