                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                                        "entry_id": "19944b59-ebb8-34c1-b83d-beced62b78f5",
                                        "glosses": [
                                            "Phase, in der sich der Herzmuskel zusammenzieht (kontrahiert) und damit das Blut ausströmt"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98e6e4d-acbe-4b19-b178-86b5a2f13dd5",
                                                "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                                                "text": "„Jede Systole beginnt damit, dass die Herzmuskelzellen der gefüllten Ventrikel in einer bestimmten Reihenfolge durch einen elektrischen Impuls erregt werden.“"
                                            },
                                            {
                                                "example_id": "e295bbed-3beb-422e-81cd-a397bfe26652",
                                                "sense_id": "201bb310-789a-3889-b65b-b5bc204e387c",
                                                "text": "„Das Herz arbeitet im rhythmischen Wechsel zwischen Erschlaffung (Diastole) und Anspannung (Systole) und hält damit den Blutstrom im kleinen und großen Kreislauf aufrecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
