                        "sense_id": "f4e5542b-ba3b-3de1-9f32-b8a97d7966d0",
                        "entry_id": "627ba2bd-09f4-319b-92cd-74daf6f4aa61",
                        "glosses": [
                            "een dragend element van hout, steen, beton of ijzer boven een muuropening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5f12b1-643d-4497-bacc-bd619c6b883b",
                                "sense_id": "f4e5542b-ba3b-3de1-9f32-b8a97d7966d0",
                                "text": "De oude latei werd door een nieuwe vervangen die van staal is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768446ec-16ef-4d31-bf9b-8061bf8d31e7",
                        "source_entry_id": "627ba2bd-09f4-319b-92cd-74daf6f4aa61",
                        "source_sense_id": "f4e5542b-ba3b-3de1-9f32-b8a97d7966d0",
                        "source_sense_description": "latei",
                        "target_lang_word": "Sturz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sturz",
