                ],
                "senses": [
                    {
                        "sense_id": "f1d39c2e-0781-3dc6-b08f-d65f8548e706",
                        "entry_id": "74386956-cd62-369d-a18c-4f81cc9efa01",
                        "glosses": [
                            "Faire perdre son caractère antisémite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccd5775-c619-415a-bd14-bbd0cae27143",
                                "sense_id": "f1d39c2e-0781-3dc6-b08f-d65f8548e706",
                                "text": "La charte-à-Drainville ne va rien prévoir pour désislamophobiser ou désantisémitiser les débats publics;"
                            },
                            {
                                "example_id": "fa2c5f93-7787-4fda-b11f-3d2455d7f8c6",
                                "sense_id": "f1d39c2e-0781-3dc6-b08f-d65f8548e706",
                                "text": "Il devrait aussi se faire désantisémitiser;"
                            },
                            {
                                "example_id": "bc798035-b305-4cf0-b527-c559e9f2b245",
                                "sense_id": "f1d39c2e-0781-3dc6-b08f-d65f8548e706",
                                "text": "J'ai bien peur que cela ne suffise pas à désantisémitiser la quenelle..."
                            },
                            {
                                "example_id": "aaa64b68-2645-4fcb-b834-9356fa5283c3",
                                "sense_id": "f1d39c2e-0781-3dc6-b08f-d65f8548e706",
                                "text": "Lors d’un colloque à Saint-Jacut, une dame m’accosta : « Je crois que je suis antisémite, je viens pour me \"désantisémitiser\". »"
                            }
                        ]
                    }
                ],
