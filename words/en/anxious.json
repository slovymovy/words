                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon spent several <w>anxious</w> hours in the operating room.",
                            "target_lang_translations": {
                                "ru": "Хирург провел несколько <w>напряженных</w> часов в операционной.",
                                "nl": "De chirurg bracht enkele <w>spannende</w> uren door in de operatiekamer.",
                                "pl": "Chirurg spędził kilka <w>pełnych napięcia</w> godzin na sali operacyjnej.",
                                "de": "Der Chirurg verbrachte mehrere <w>nervöse</w> Stunden im Operationssaal."
                            }
                        },
                        {
                            "text": "There was an <w>anxious</w> wait before the results were revealed.",
                            "target_lang_translations": {
                                "ru": "Последовало <w>мучительное</w> ожидание перед тем, как были объявлены результаты.",
