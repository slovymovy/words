                    "frequency": "Low",
                    "semantic_group_id": "music_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many modern artists are influenced by the beats found in Chicago <w>drill</w>.",
                            "target_lang_translations": {
                                "ru": "Многие современные исполнители находятся под влиянием битов, характерных для чикагского <w>дрилла</w>.",
                                "tr": "Birçok modern sanatçı Chicago <w>drill</w> müziğindeki ritimlerden etkileniyor."
                            }
                        },
                        {
                            "text": "The radio station dedicated an hour to playing local <w>drill</w> music.",
                            "target_lang_translations": {
                                "ru": "Радиостанция посвятила час воспроизведению местной <w>дрилл</w>-музыки.",
                                "tr": "Radyo istasyonu bir saatini yerel <w>drill</w> müziği çalmaya ayırdı."
                            }
