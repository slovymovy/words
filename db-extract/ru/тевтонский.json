                ],
                "senses": [
                    {
                        "sense_id": "9c9e50da-2fe3-3769-8415-1076ff7f81f0",
                        "entry_id": "a6dc2091-159e-3ff7-87df-c67f323cbad3",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным тевтоны"
