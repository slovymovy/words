    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54c22146-52ce-3d3d-b689-ec5fa45be0a0",
                    "sense_definition": "To pull or drag with great effort or force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>tug</w> the heavy suitcase through the narrow hallway. ",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>протащить</w> тяжелый чемодан через узкий коридор.",
                                "zh": "他试图把沉重的行李箱<w>拖</w>过狭窄的走廊。",
                                "pl": "Próbował <w>przeciągnąć</w> ciężką walizkę przez wąski korytarz.",
                                "cs": "Pokusil se <w>protáhnout</w> těžký kufr úzkou chodbou."
                            }
                        },
                        {
                            "text": "She had to <w>tug</w> hard to open the rusty metal gate.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось сильно <w>потянуть</w>, чтобы открыть ржавые металлические ворота.",
                                "zh": "她必须用力<w>拉</w>才能打开那扇生锈的铁门。",
                                "pl": "Musiała mocno <w>pociągnąć</w>, żeby otworzyć zardzewiałą metalową bramę.",
                                "cs": "Musela silně <w>zatáhnout</w>, aby otevřela zrezivělou kovovou bránu."
                            }
                        }
                    ],
                    "synonyms": [
                        "haul",
                        "drag",
                        "pull"
                    ],
                    "antonyms": [
                        "push"
                    ],
                    "common_phrases": [
                        "tug hard"
                    ],
                    "target_lang_definitions": {
