                "senses": [
                    {
                        "sense_id": "14788d36-57c2-3d3e-bfd8-f94ca6dab6a0",
                        "entry_id": "8414f864-f50d-31a2-ad26-b55c53ed9626",
                        "glosses": [
                            "kleiner Stein (poröser Bimsstein), um die Bildung von sehr großen Gasblasen beim Siedevorgang zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec234e2c-2f31-428a-bf3b-18f75432f251",
                                "sense_id": "14788d36-57c2-3d3e-bfd8-f94ca6dab6a0",
                                "text": "Siedestein, verhindern das Spritzen und die Bildung großer Blasen beim Sieden des Mediums, verpackt im praktischen wiederverschließbaren Beutel."
                            },
                            {
                                "example_id": "158bc238-996c-4a7f-b3cd-193e5f8c5082",
                                "sense_id": "14788d36-57c2-3d3e-bfd8-f94ca6dab6a0",
                                "text": "Man setzt Siedesteine ein, um einen Siedeverzug mit anschließender explosionsartiger Dampfbildung zu verhindern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18378221-44db-39dc-be64-1c1f1f61935d",
                        "entry_id": "8414f864-f50d-31a2-ad26-b55c53ed9626",
                        "glosses": [
                            "Mineralen der Zeolithgruppe"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "99d8ef02-0e79-4d3c-9f59-c2bf54172144",
                                "sense_id": "18378221-44db-39dc-be64-1c1f1f61935d",
                                "text": "Beim Zeolith (griech. Siedestein) handelt es sich um einen Keramikwerkstoff, der bei Erwärmung zu sieden beginnt und Wasserdampf abgibt."
                            },
                            {
                                "example_id": "dbfad0ab-62ca-4f39-8947-0984d6ccab6f",
                                "sense_id": "18378221-44db-39dc-be64-1c1f1f61935d",
                                "text": "Die Verwitterung liefert meist Siedesteine (Zeolithe), namentlich Natrolith."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
