                        ],
                        "form": "das Konfekt"
                    },
                    {
                        "form_id": "d18b8f14-9a82-487c-ac3c-73cfdee4a8de",
                        "entry_id": "b9de9228-0db3-3e63-b070-d51f4da70949",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Konfekte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adf23ee2-175a-38c0-bc17-3832756ed7d8",
                        "entry_id": "b9de9228-0db3-3e63-b070-d51f4da70949",
                        "glosses": [
                            "feine Zuckerwaren wie zum Beispiel Pralinen, kleine Schokoladen- oder Marzipanteile oder auch kandierte Früchte"
                        ],
                        "tags": [
                            "Sammelbegriff für"
                        ],
                        "examples": [
                            {
                                "example_id": "aa418e7f-d96f-4c1a-bd99-b1c1b7b40dc4",
                                "sense_id": "adf23ee2-175a-38c0-bc17-3832756ed7d8",
                                "text": "„Zartschmelzende, dunkel glänzende Kostbarkeiten! Pralinen und Konfekt sind kleine, süße Schätze, nach denen sich jeder die Finger leckt.“"
                            },
                            {
                                "example_id": "5792e166-d690-4a3e-ac5a-ce3b606390cb",
                                "sense_id": "adf23ee2-175a-38c0-bc17-3832756ed7d8",
                                "text": "„Da diese Konfekte aus den reinsten besten Früchten, so auch aus den edelsten Zuckerbestandtheilen bereitet werden, so sind selbe für Jedermann, sowohl für Kranke als Gesunde, sehr zu empfehlen.“ (1861)"
                            },
                            {
                                "example_id": "ee2eb45a-3e22-41e9-832b-77e0bc367c9b",
                                "sense_id": "adf23ee2-175a-38c0-bc17-3832756ed7d8",
                                "text": "„Man erhob die Gläser mit Champagner und Hochheimer des Jahrgangs 1783, allerdings in moderaten Mengen. Als Erfrischungen wurden zwei Sorten Eis (Maraschino und Vanille), feine Bisquits und Konfekt gereicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81d5b87d-758b-3102-8c5f-8dad44196cfb",
                        "entry_id": "b9de9228-0db3-3e63-b070-d51f4da70949",
                        "glosses": [
                            "Gebäck, Teegebäck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f77ad6f-f0a4-4629-bed0-1dff2b2acca6",
                                "sense_id": "81d5b87d-758b-3102-8c5f-8dad44196cfb",
                                "text": "„Man erhob die Gläser mit Champagner und Hochheimer des Jahrgangs 1783, allerdings in moderaten Mengen. Als Erfrischungen wurden zwei Sorten Eis (Maraschino und Vanille), feine Bisquits und Konfekt gereicht.“"
                            },
                            {
                                "example_id": "fce76d92-ea43-4fcf-8dfe-1f8e1eecbb54",
                                "sense_id": "81d5b87d-758b-3102-8c5f-8dad44196cfb",
                                "text": "Es gibt Tee aus dem Samowar, und zur Auswahl stehen Kuchen, Torte und Konfekt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
