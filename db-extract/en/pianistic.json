                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89bd40a-3283-449c-8e1f-8409d499b6bd",
                                "sense_id": "a607be6e-8990-34bd-8919-d8b5784aa53d",
                                "text": "But it offers pianistic thrills as well as a few moments of dreamy introspection, and Mr. Ax played it with the vitality and thoughtfulness listeners expect of him."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c1bdd0c-ac8a-3463-b994-fdc99ea43647",
                        "entry_id": "7346e4d5-fd3d-3c02-b151-61059f49da83",
                        "glosses": [
                            "Suitable for playing on a piano, well-suited to piano playing."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70a0e2a2-6f7c-479a-aba8-2ee2d5004c6a",
                        "source_entry_id": "7346e4d5-fd3d-3c02-b151-61059f49da83",
                        "source_sense_description": "pertaining to piano playing",
                        "target_lang_word": "pianistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pianistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611917ba-e62d-36a3-9b70-4d7677424582",
                                        "entry_id": "dc5a5177-d15d-35ed-816f-0f2ab6e77c7f",
                                        "glosses": [
                                            "Relatif à l'art du piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01a6597-91da-4591-8ffd-a02b7661aba6",
                                                "sense_id": "611917ba-e62d-36a3-9b70-4d7677424582",
                                                "text": "Des prouesses pianistiques."
                                            },
                                            {
                                                "example_id": "0f7b694a-2df6-4b66-96a2-3c380aeee7ad",
                                                "sense_id": "611917ba-e62d-36a3-9b70-4d7677424582",
                                                "text": "Finesse, délicatesse, fluidité, énergie, légèreté, chaleur… un concentré de sensations pianistiques admirablement servies par l'interprète."
                                            },
                                            {
                                                "example_id": "8ebebf2e-ac77-41b4-a4df-49d48e78d360",
                                                "sense_id": "611917ba-e62d-36a3-9b70-4d7677424582",
                                                "text": "J'ai toujours regretté que M. de Charlus, au lieu de borner ses dons artistiques à la peinture d'un éventail comme présent à sa belle-soeur (nous avons vu la duchesse de Guermantes le tenir à la main et le déployer moins pour s'en éventer que pour s'en vanter, en faisant ostentation de l'amitié de Palamède) et au perfectionnement de son jeu pianistique afin d'accompagner sans faire de fautes les traits de violon de Morel, j'ai toujours regretté, dis-je, et je regrette encore, que M. de Charlus n'ait jamais rien écrit."
                                            },
                                            {
                                                "example_id": "d5d972e8-14f5-4428-ad41-a8d0c5f069e4",
                                                "sense_id": "611917ba-e62d-36a3-9b70-4d7677424582",
                                                "text": "Au retour de la messe, un autre exercice consistait en une heure de variations pianistiques, exécutées froidement et correctement par Jeanne, qui trouvait sans doute plaisir à sentir ses doigts lui obéir sur les touches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pianistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be57d732-2537-37f8-a769-44fd5b8ea1b5",
                                        "entry_id": "044e62c7-6fc6-34c3-9a9c-fc636a14dd9b",
                                        "glosses": [
                                            "Art de jouer du piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4670288a-79b4-47a6-bcd6-818df220dbee",
                                                "sense_id": "be57d732-2537-37f8-a769-44fd5b8ea1b5",
                                                "text": "La tradition chopinesque laissa son empreinte sur la pianistique polonaise."
                                            },
                                            {
                                                "example_id": "2dfe6b35-e101-449d-bf24-e4dfc4171bac",
                                                "sense_id": "be57d732-2537-37f8-a769-44fd5b8ea1b5",
                                                "text": "Compositeur et pianiste, père de la pianistique moderne et inspirateur de nombreux courants novateurs, Liszt demeure une figure majeure de l’époque romantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19fe57a9-31ee-37d3-b211-9d2638b672ab",
                                        "entry_id": "044e62c7-6fc6-34c3-9a9c-fc636a14dd9b",
                                        "glosses": [
                                            "Virtuosité au piano."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6e8094-0bc2-4e72-9f4f-8f03d1230da4",
                                                "sense_id": "19fe57a9-31ee-37d3-b211-9d2638b672ab",
                                                "text": "Ce film une agréable distraction accompagnée en fosse par la pianistique concertante de bon ton de Michel Legrand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
