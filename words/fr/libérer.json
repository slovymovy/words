            "senses": [
                {
                    "sense_id": "909dfb5a-747d-3879-8df8-9e904e0e39c6",
                    "sense_definition": "Dégager un espace, une table ou un passage en enlevant ce qui l'encombre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu <w>libérer</w> la table pour que nous puissions poser les plats ?"
                        },
                        {
                            "text": "Les ouvriers doivent rapidement <w>libérer</w> le passage pour laisser passer les véhicules de secours."
                        }
                    ],
                    "common_phrases": [
                        "libérer la place",
                        "libérer le passage",
                        "libérer la voie"
                    ]
                },
                {
                    "sense_id": "be2ccfb6-0ac7-3e6a-af3f-0c032d7a5bef",
                    "sense_definition": "Rendre sa liberté à une personne retenue prisonnière ou captive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liberté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les négociateurs ont fait le maximum pour <w>libérer</w> les otages sains et saufs."
                        },
                        {
                            "text": "Le juge a ordonné de <w>libérer</w> le suspect faute de preuves concluantes."
                        }
                    ],
                    "synonyms": [
                        "donner la clé des champs"
                    ],
                    "common_phrases": [
                        "libérer un otage",
                        "libérer un prisonnier"
                    ]
                },
                {
                    "sense_id": "8f7a6a3d-138f-3fcf-9df0-c7684eb09fbf",
                    "sense_definition": "Quitter un logement, une chambre ou un local pour le laisser à la disposition d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les clients de l'hôtel doivent <w>libérer</w> la chambre avant midi le jour du départ."
                        },
                        {
                            "text": "Le locataire s'est engagé par écrit à <w>libérer</w> les lieux à la fin du bail."
                        }
                    ],
                    "common_phrases": [
                        "libérer la chambre",
                        "libérer les lieux"
                    ]
                },
                {
                    "sense_id": "a4fb474e-893b-36bf-9881-449dd2dea57f",
                    "sense_definition": "Délivrer une ville, une région ou un pays du joug d'une force d'occupation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liberté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces alliées ont fini par <w>libérer</w> la capitale après de rudes combats."
                        },
                        {
                            "text": "Les soldats ont donné leur vie pour <w>libérer</w> leur patrie de l'oppression."
                        }
                    ],
                    "common_phrases": [
                        "libérer le pays",
                        "libérer la ville"
                    ]
                },
                {
                    "sense_id": "d416fb01-553d-3399-9fdd-c9440ab2b031",
                    "sense_definition": "Soulager d'un poids moral, affectif ou psychologique, ou d'une contrainte pesant sur l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Partager son angoisse avec un ami lui a permis de se <w>libérer</w> d'un lourd fardeau."
                        },
                        {
                            "text": "Une longue marche en montagne aide à <w>libérer</w> l'esprit des soucis du travail."
                        }
                    ],
                    "common_phrases": [
                        "libérer son esprit",
                        "se libérer de"
                    ]
                },
                {
                    "sense_id": "93c5250b-905a-333d-888f-d7bfb9efe35c",
