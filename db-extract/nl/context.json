                    }
                ],
                "senses": [
                    {
                        "sense_id": "f511305e-4bb4-34ab-8121-8f0a24c29090",
                        "entry_id": "e0efdbe1-8f34-3f59-86cb-2d149ed18e26",
                        "glosses": [
                            "verband waarin iets zich voordoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa6e65c-d904-4227-8fbb-5c4c8fafcd38",
                                "sense_id": "f511305e-4bb4-34ab-8121-8f0a24c29090",
                                "text": "Zelfs Dorien zou ze met zo'n benaming tekortdoen. Al moest je dat natuurlijk weer in een andere context zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "c222072b-97af-3061-b8ce-d801ee34519f",
                        "entry_id": "e0efdbe1-8f34-3f59-86cb-2d149ed18e26",
                        "glosses": [
                            "de tekst die om de tekst heen staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847822f2-a6b7-4ede-9393-bdfb1f53d0b3",
                                "sense_id": "c222072b-97af-3061-b8ce-d801ee34519f",
                                "text": "In de zinnen: „Ik haalde mijn geld van de bank.” en „Ik ging lekker op de bank zitten.” is de betekenis van het woord bank alleen maar te begrijpen door de context."
                            },
                            {
                                "example_id": "48a1ec07-cfa6-4867-a2ee-a1ebb88f6bb1",
                                "sense_id": "c222072b-97af-3061-b8ce-d801ee34519f",
                                "text": "Later nuanceerde hij zijn antwoord. ‘Er is niets verzonnen, maar je moet het geschrevene in een context zien. Het is een verheerlijking van bepaalde idealen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "26af1632-ef2f-3583-8804-ddadcbf5ba88",
                        "entry_id": "e0efdbe1-8f34-3f59-86cb-2d149ed18e26",
                        "glosses": [
                            "de gebeurtenissen die vóór het gebeurde hebben plaatsgevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb891a73-1e74-4894-9174-8d19f86e369c",
                                "sense_id": "26af1632-ef2f-3583-8804-ddadcbf5ba88",
                                "text": "De ontwikkelingen in Turkije kun je alleen maar begrijpen in de historische context."
                            }
                        ]
                    },
                    {
                        "sense_id": "5061e121-bc90-3fa9-a4e4-3038cfd907b1",
                        "entry_id": "e0efdbe1-8f34-3f59-86cb-2d149ed18e26",
                        "glosses": [
                            "zakelijke inhoud of bewoordingen van een oorkonde"
                        ],
                        "tags": [
                            "oorkondeleer, diplomatiek"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbc4ba39-fd58-4956-a011-11687bb66aec",
                        "source_entry_id": "e0efdbe1-8f34-3f59-86cb-2d149ed18e26",
                        "source_sense_id": "f511305e-4bb4-34ab-8121-8f0a24c29090",
                        "source_sense_description": "verband waarin iets zich voordoet",
                        "target_lang_word": "Kontext",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontext",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfd3761f-e140-3e5e-a991-69549e946a7c",
                                        "entry_id": "71e6f642-31a4-3f0d-ac6a-2bd9ecb325d3",
                                        "glosses": [
                                            "der Zusammenhang oder das Umfeld eines Wortes oder einer Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5484e61d-259c-4180-ba07-4fc76301f1b5",
                                                "sense_id": "dfd3761f-e140-3e5e-a991-69549e946a7c",
                                                "text": "Aus dem Kontext können zusätzliche Informationen erschlossen werden."
                                            },
                                            {
                                                "example_id": "15240122-ae61-40d7-a70c-d944ecbbe8b2",
                                                "sense_id": "dfd3761f-e140-3e5e-a991-69549e946a7c",
                                                "text": "„Der sprachliche Kontext reicht nicht zur Bedeutungserschließung und damit auch nicht zur Bedeutungsuntersuchung und -beschreibung aus.“"
                                            },
                                            {
                                                "example_id": "31209db6-5290-4331-a859-506944c7b7f8",
                                                "sense_id": "dfd3761f-e140-3e5e-a991-69549e946a7c",
                                                "text": "„Anders gesagt, wir verstehen unvertraute Komposita nicht allein aufgrund ihrer sprachlichen Form, sondern auch aufgrund der Information, die uns aus dem jeweiligen Kontext zukommt.“"
                                            },
                                            {
                                                "example_id": "6ce55492-955f-4d1e-b625-a324ed4bf372",
                                                "sense_id": "dfd3761f-e140-3e5e-a991-69549e946a7c",
                                                "text": "„Der Kontext zeigt, dass es offenbar um eine politische Auseinandersetzung zum Thema Betreuungsgeld geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9327787-faa1-3fd0-aa5a-c62009a18f21",
                                        "entry_id": "71e6f642-31a4-3f0d-ac6a-2bd9ecb325d3",
                                        "glosses": [
                                            "Zusammenhang, in dem bestimmte Dinge stehen oder betrachtet werden müssen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9157352-71bc-4cab-853b-8d4b928710c6",
                                                "sense_id": "d9327787-faa1-3fd0-aa5a-c62009a18f21",
                                                "text": "Für mich ist das ein guter Beleg für die These, dass das Ich ein Konstrukt ist, das im sozialen Kontext entsteht."
                                            },
                                            {
                                                "example_id": "115de2bb-6b06-48a7-835b-ae168f26ffcf",
                                                "sense_id": "d9327787-faa1-3fd0-aa5a-c62009a18f21",
                                                "text": "Das erklärte auch das Kaspar-Hauser-Phänomen: Wer ohne sozialen Kontext aufwächst, wer keinerlei Ansprache hat, kann auch keine Subjektivität ausbilden."
                                            },
                                            {
                                                "example_id": "03a84a2c-199c-4560-9b9e-b7f1860709dd",
                                                "sense_id": "d9327787-faa1-3fd0-aa5a-c62009a18f21",
                                                "text": "»Für den Geschmack sind auch das Aussehen des Essens und der Kontext wichtig«, sagt Hummel."
                                            },
                                            {
                                                "example_id": "c0258b0a-0c55-4402-9ae1-eed334db64e5",
                                                "sense_id": "d9327787-faa1-3fd0-aa5a-c62009a18f21",
                                                "text": "„Die Handreichung ‚Curriculare Grundlagen – Deutsch als Zweitsprache’ richtet sich an alle Lehrkräfte, die im schulischen Kontext insbesondere mit neu zugewanderten Schülerinnen und Schülern arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f07245a5-ae9e-3859-85d1-902340c003b6",
                                        "entry_id": "71e6f642-31a4-3f0d-ac6a-2bd9ecb325d3",
                                        "glosses": [
                                            "der Hauptteil einer Urkunde, der den Rechtsinhalt enthält"
                                        ],
                                        "tags": [
                                            "Diplomatik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
