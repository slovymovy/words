                    },
                    {
                        "sense_id": "9bff78e2-b882-308d-b7b4-36464a7cbedd",
                        "entry_id": "f7096907-0ead-3289-ba74-26f6b7628e71",
                        "glosses": [
                            "Petit pompon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b7d320-f21a-4be3-8e00-b4a1e031cdc1",
                                "sense_id": "9bff78e2-b882-308d-b7b4-36464a7cbedd",
                                "text": "La garniture se compose de petits velours bleus réunis par une pomponnette de peluche ou de chenille."
                            },
                            {
                                "example_id": "d9c46b6d-7d46-4f26-8640-83b2b4526802",
                                "sense_id": "9bff78e2-b882-308d-b7b4-36464a7cbedd",
                                "text": "S’entoilettant le soir de blouses d’été, les cheveux nattés, tirés, enroulés en couronne, avec une pomponnette de chaque côté du front, elles étaient pour le spectateur et pour le critique officiel de nos manifestations mondaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ab999c-1fa9-33b1-80c5-b120bbcbf490",
                        "entry_id": "f7096907-0ead-3289-ba74-26f6b7628e71",
                        "glosses": [
                            "Femme qui se pomponne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17fa2719-73c4-4299-9d8d-c717bd5b2b2d",
                                "sense_id": "19ab999c-1fa9-33b1-80c5-b120bbcbf490",
                                "text": "Zita était, d’après sa sœur aînée, une pomponnette, une petite garce au regard provocant et au corsage échancré."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b93e69a-ccbb-3229-a4ba-6b507ec619af",
                        "entry_id": "f7096907-0ead-3289-ba74-26f6b7628e71",
                        "glosses": [
                            "Chanson à boire."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "e4034157-21c9-411c-b5db-33d96cbdb732",
                                "sense_id": "1b93e69a-ccbb-3229-a4ba-6b507ec619af",
                                "text": "On leur servit des litres, et ils se mirent à entonner une « pomponnette », c'est-à-dire une rengaine qui comportait un refrain très court pendant lequel chacun devait vider son verre d’un seul trait, sous peine de payer la bouteille."
                            }
                        ]
                    }
