                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33201f26-9b6e-38d3-8324-407d63eb6e2b",
                                        "entry_id": "58cd7187-b834-316d-a5a6-cf4248d25e51",
                                        "glosses": [
                                            "Aktion oder Prozess, die zum Ende von etwas führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "678b159b-c7ec-4471-9557-94f7a1fd4c8e",
                                                "sense_id": "33201f26-9b6e-38d3-8324-407d63eb6e2b",
                                                "text": "„Nur ein Genie wie Napoleon hätte diese Stunde nutzen können, um im Schutze der Dunkelheit mit seiner Garde der Zarenarmee den Todesstoß zu versetzen, aber der Kaiser hatte ein Blasenleiden und war unpässlich.“"
                                            },
                                            {
                                                "example_id": "5c32efd4-dd4c-433d-a8cf-7cd1c7c79200",
                                                "sense_id": "33201f26-9b6e-38d3-8324-407d63eb6e2b",
                                                "text": "„Indiens «klassisches Altertum» endete mit dem Hunneneinfall, der dem Guptareich den Todesstoß versetzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
