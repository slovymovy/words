                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a079582f-b38a-43f8-a151-c9c70fdd1fe1",
                                "sense_id": "0c871bc1-6edb-3d7f-be06-0664719adcfd",
                                "text": "Few understand the works of Cummings,\nAnd few James Joyce's mental slummings,\nAnd few young Auden's coded chatter;\nBut then it is the few that matter."
                            },
                            {
                                "example_id": "6626d56e-41c5-4dca-a7bf-da7904bb6bf8",
                                "sense_id": "0c871bc1-6edb-3d7f-be06-0664719adcfd",
                                "text": "Sir Arthur Sullivan, genius of the comic-opera is — by a curious paradox of fate — remembered on the centenary of his birth by those very scores which he considered his musical slummings […]"
                            }
                        ]
                    }
