                        "entry_id": "038f34f7-1da3-3197-8845-1777295359e9",
                        "glosses": [
                            "Diffusion des principes fondamentaux de la marque McDonald’s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5612d1d-de4d-4a21-ae0c-c78ebe64f388",
                                "sense_id": "ca856c61-62dd-3b42-9ee6-ca8092449d63",
                                "text": "Le sociologue américain Georges Ritzer a d'ailleurs montré dans sa célèbre thèse sur la « macdonaldisation » du monde que les valeurs fondatrices de la marque étaient tellement prégnantes qu'elles s'étaient graduellement infusées à l’ensemble des sociétés occidentales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b9d9556-a174-4f76-9289-b12e7b60eea2",
                        "source_entry_id": "038f34f7-1da3-3197-8845-1777295359e9",
                        "source_sense_id": "ca856c61-62dd-3b42-9ee6-ca8092449d63",
                        "target_lang_word": "McDonaldisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "McDonaldisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eaabfe5-1c42-38d9-8a48-01368d091ccf",
                                        "entry_id": "7a8d8b00-904f-3c8b-93e4-b7b11229f1b2",
                                        "glosses": [
                                            "kulturelle Vereinheitlichung durch das globale Vordringen rationeller Organisationsverfahren und standardisierter Angebote"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d126d8-4f97-47ef-9fc6-d09455004edc",
                                                "sense_id": "5eaabfe5-1c42-38d9-8a48-01368d091ccf",
                                                "text": "„Ob man sie Globalisierung, Amerikanisierung, Europäisierung, Verwestlichung oder McDonaldisierung nennt, scheinen heute die ökonomische, politische und kulturelle Vernetzung der ‚Welten‘ und die damit einhergehenden Transnationalisierungsprozesse unumkehrbar zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54f0dd77-73b5-447c-bcd0-d63e1539ad38",
                        "source_entry_id": "038f34f7-1da3-3197-8845-1777295359e9",
                        "source_sense_id": "ca856c61-62dd-3b42-9ee6-ca8092449d63",
                        "target_lang_word": "McDonaldization",
