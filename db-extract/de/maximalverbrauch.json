                ],
                "senses": [
                    {
                        "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                        "entry_id": "98b61c41-099a-3f40-8f4c-ba34e0159930",
                        "glosses": [
                            "größte Menge von etwas, das knapp ist und verbraucht wird (beispielsweise Energie, Wasser, Benzin), oft als Quotient für eine bestimmte Zeit oder Wegstrecke angegeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74401629-2677-4c4b-934f-04414c0e4d47",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "Der Maximalverbrauch pro Jahr von elektrischer Energie in Deutschland wurde im Jahr 2007 mit 624 Terawattstunden (TWh) erreicht (zum Vergleich 2021: 570 TWh)."
                            },
                            {
                                "example_id": "e67d8b2a-694b-4111-b9f0-4ee3c73e8785",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "„Der zulässige Heizwärmebedarf von Neubauten wurde zwischen 1970 und 1995 von 400 auf 100 Kilowattstunden pro Quadratmeter und Jahr gesenkt. Die Energieeinsparverordnung schreibt seit 2001 einen Maximalverbrauch von 70 Kilowattstunden vor.“"
                            },
                            {
                                "example_id": "6fa0a5fe-f3b9-40f5-a34e-259a62740b93",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "[Gaspreisdeckel: Um nicht auch den Millionär mit Villa und einem mit Gas beheiztem Pool genauso zu entlastet,] „wie kleine einkommensschwache Haushalte, schlagen die Forscher der Hans-Böckler Stiftung vor, den gedeckelten Preis auf einen Maximalverbrauch von 15.500 kWh zu beschränken.“"
                            },
                            {
                                "example_id": "b30e7365-7c21-494f-9e1b-7e723368d51c",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "[Mikroprozessoren:] „Zusätzlich zur Thermal Design Power (TDP), mit welcher AMD weiterhin angibt, für welchen Strombedarf das System ausgelegt sein muss, gibt es nun noch die Average CPU Power. Mit diesem soll der typische Maximalverbrauch eines Prozessors angegeben werden.“"
                            },
                            {
                                "example_id": "437a9d77-9da5-40cc-b4cc-f43500726a05",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "„Zwischen sechs und acht Uhr stellt die Stromlieferantin Elektra Genossenschaft Oberlunkhofen den Strom für Waschmaschine, Tumbler, Geschirrspüler und Sauna jeweils im Winter ab, wenn in der Gemeinde zu viel Strom verbraucht wird.“ […] „Der Maximalverbrauch, welcher eine Sperrung der Geräte auslöst, wird von der Elektra Genossenschaft Oberlunkhofen festgelegt.“"
                            },
                            {
                                "example_id": "32cad9c6-a42e-4751-9529-a296b19c7742",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "„«Die Wasserleitungen werden immer auf den Maximalverbrauch ausgelegt», sagt Urs Kamm.“"
                            },
                            {
                                "example_id": "359f942e-af12-4e32-985b-8925c35a6d40",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "[Wasser – Dürre in Kappstadt:] „Im Juni 2017 wurde die Verbrauchsobergrenze auf Level 4 weiter verringert, was einem Maximalverbrauch von 100 Litern pro Person pro Tag festlegte.“"
                            },
                            {
                                "example_id": "8d0a22d2-805d-4717-94b8-6f9ab8c2a31b",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "[Wasserverbrauch in Berlin 1889:] „Der Maximalverbrauch eines Tages war 124 907 kbm und der Tagesverbrauch im Jahresdurchschnitt 86 632 kbm. Der Maximalverbrauch für Kopf und Tag war 93,80 Liter und der Jahresdurchschnittsverbrauch für Kopf und Tag 64,45 Liter.“"
                            },
                            {
                                "example_id": "fc225e96-50bc-4c59-a880-ed141c1d4f74",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "„3,9 Liter Minimalverbrauch, 13,5 Liter Maximalverbrauch und 5,2 Liter auf der Landstraße - das hat der Verbrauchstest für die Kawasaki Ninja H2 SX ergeben.“"
                            },
                            {
                                "example_id": "bc1ab903-8abd-4dc4-bf16-a0f3f5531e5b",
                                "sense_id": "2f2f120a-ac78-3c1a-8fd3-2c4a9efc46c2",
                                "text": "[Autos:] „Wenn die Industrie jammert, dies sei zu viel Regulierung, bleibt diese deutliche Antwort: Wirklich rigoros wären viel weitergehende Vorgaben – etwa zu Obergrößen der Fahrzeuge je nach Klasse, Höchstgeschwindigkeiten ab Werk oder Maximalverbräuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
