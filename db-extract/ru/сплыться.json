                        "examples": [
                            {
                                "example_id": "b77a12d7-2bad-4e7a-8191-9eb4b6f0d5d4",
                                "sense_id": "c373224d-1059-3270-8791-e545c7704222",
                                "text": "Утки сплылись в стайку. Облака сплылись в тучу."
                            }
                        ]
                    },
                    {
                        "sense_id": "8592639c-dae6-30cb-90c7-a5cd2ffdc297",
                        "entry_id": "2e582a58-4286-31ea-80b9-8421bd856d26",
                        "glosses": [
                            "слиться в одно, смешаться, утратить первоначальную чистоту, яркость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c6d67d-187a-4a33-9115-1be43e4a0b73",
                                "sense_id": "8592639c-dae6-30cb-90c7-a5cd2ffdc297",
                                "text": "Краски сплылись. Очертания домов сплылись в темноте."
