                "senses": [
                    {
                        "sense_id": "91677ea0-2229-3877-af01-ed49e99c9459",
                        "entry_id": "9712e220-9a90-35ee-873f-590d6c247334",
                        "glosses": [
                            "Agent der US-amerikanischen Drogenbekämpfungsbehörde DEA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9890240-cbb4-413e-aa2c-e4dc63ac0706",
                                "sense_id": "91677ea0-2229-3877-af01-ed49e99c9459",
                                "text": "„Dieser DEA-Agent hat wieder angerufen.“"
                            },
                            {
                                "example_id": "ba12c9cb-257a-4995-9d3e-7a1bfd1067c4",
                                "sense_id": "91677ea0-2229-3877-af01-ed49e99c9459",
                                "text": "„Die DEA-Agenten, die mit ihm zu tun gehabt hatten, hielten ihn für einen ausgemachten Dandy, für den der Rang mehr zählte als die tatsächliche Leistung, aber sie mochten ihn.“"
                            },
                            {
                                "example_id": "15dc0292-0c70-4644-b0f7-607027dc4678",
                                "sense_id": "91677ea0-2229-3877-af01-ed49e99c9459",
                                "text": "„Einen DEA-Agenten direkt vor dem US-amerikanischen Konsulat am helllichten Tag zu entführen, zu foltern und zu töten war mehr, als sie bis dato gewagt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
