                "senses": [
                    {
                        "sense_id": "939d17b3-0c4f-30ee-96db-82974dd47823",
                        "entry_id": "a9fc8810-0efb-3f32-bfe9-a5cf1016a3ef",
                        "glosses": [
                            "Mélange de poudre de riz et de sous-nitrate de bismuth qui donne à la peau du visage une sorte de velouté."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "01722d79-fadb-4511-824b-1e7e8bd8e938",
                                "sense_id": "939d17b3-0c4f-30ee-96db-82974dd47823",
                                "text": "Un derme travaillé à la veloutine […] le simple compromis de nombre de femmes de la bourgeoisie qui, sans se grimer […] se nuent tout bonnement la peau de poudre au bismuth, teintée en rose pour les blondes, en nuance Rachel pour les brunes."
                            },
                            {
                                "example_id": "e85f3f8b-4439-44b0-a86d-bc9d740660eb",
                                "sense_id": "939d17b3-0c4f-30ee-96db-82974dd47823",
                                "text": "Elle passa sur son visage la caresse blanchissante d’une houppette à veloutine."
                            },
                            {
                                "example_id": "55e90ba0-776c-42fa-b846-61e9b8a86acc",
                                "sense_id": "939d17b3-0c4f-30ee-96db-82974dd47823",
                                "text": "On dirait une fête de la Haute, une cérémonie de gala, un Te Deum à Notre-Dame ; il flotte dans l’air un parfum de veloutine et de gardenia."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a74ba63-3100-33c9-a78e-7c2f145a55de",
                        "entry_id": "a9fc8810-0efb-3f32-bfe9-a5cf1016a3ef",
                        "glosses": [
                            "Tissu en coton dont l’aspect évoque le velours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c7595c-49b0-4a55-9b8a-9d936d379b95",
                                "sense_id": "5a74ba63-3100-33c9-a78e-7c2f145a55de",
                                "text": "Le col est en veloutine blanche."
                            }
                        ]
                    },
                    {
                        "sense_id": "78c9b5f8-08fe-31c7-b4b3-9a7e054e800e",
                        "entry_id": "a9fc8810-0efb-3f32-bfe9-a5cf1016a3ef",
                        "glosses": [
                            "Tissu d’ameublement très épais, broché d’or et d’argent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "91e3bb1f-ed6f-318f-b43e-02d206129e1f",
                        "entry_id": "a9fc8810-0efb-3f32-bfe9-a5cf1016a3ef",
                        "glosses": [
                            "Branche de câblé coupé formant un relief."
                        ],
                        "tags": [
                            "Passementerie"
                        ],
                        "examples": [
                            {
                                "example_id": "7fb8dbd4-116e-42ac-8a6d-59e6f7e64401",
                                "sense_id": "91e3bb1f-ed6f-318f-b43e-02d206129e1f",
                                "text": "Câblés simples. Composés généralement de quatre branches retordues ensemble […]\nBranches veloutine. Chaque branche est une branche soufflée et coupée, ce qui lui donne un relief spécial."
                            }
                        ]
                    }
