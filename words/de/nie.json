                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat sich in zwei Wochen <w>nie</w> die Haare gewaschen.",
                            "target_lang_translations": {
                                "en": "In two weeks, he <w>never</w> washed his hair.",
                                "ru": "За две недели он <w>ни разу</w> не помыл голову.",
                                "nl": "Hij heeft in twee weken tijd <w>nooit</w> zijn haar gewassen.",
                                "pl": "Przez dwa tygodnie <w>ani razu</w> nie umył włosów.",
                                "fr": "En deux semaines, il ne s'est <w>jamais</w> lavé les cheveux.",
                                "it": "In due settimane non si è <w>mai</w> lavato i capelli.",
                                "cs": "Za dva týdny si <w>ani jednou</w> neumyl vlasy.",
                                "tr": "İki hafta boyunca saçlarını <w>hiç</w> yıkamadı.",
                                "es": "En dos semanas <w>nunca</w> se lavó el pelo.",
                                "zh": "他在两周内<w>一次也没有</w>洗过头发。"
                            }
                        },
                        {
                            "text": "Während der gesamten Reise hat sie <w>nie</w> gelächelt.",
                            "target_lang_translations": {
                                "en": "During the entire trip, she <w>never</w> smiled.",
                                "ru": "За всю поездку она <w>ни разу</w> не улыбнулась.",
                                "nl": "Tijdens de hele reis heeft ze <w>nooit</w> geglimlacht.",
                                "pl": "Podczas całej podróży <w>ani razu</w> się nie uśmiechnęła.",
                                "fr": "Pendant tout le voyage, elle n'a <w>jamais</w> souri.",
                                "it": "Durante tutto il viaggio non ha <w>mai</w> sorriso.",
                                "cs": "Během celé cesty se <w>ani jednou</w> neusmála.",
                                "tr": "Tüm seyahat boyunca <w>hiç</w> gülümsemedi.",
                                "es": "Durante todo el viaje <w>nunca</w> sonrió.",
                                "zh": "在整个旅途中，她<w>从未</w>笑过。"
                            }
                        }
