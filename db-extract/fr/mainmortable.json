                "senses": [
                    {
                        "sense_id": "65d462cb-9e65-38c0-ba8d-0b49221b56b9",
                        "entry_id": "c8dd3f3e-e823-3e90-81f9-78c2f70c030a",
                        "glosses": [
                            "Sujet d'un seigneur féodal qui est soumis à la mainmorte."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "cb0750dc-fc00-44c4-8bc3-85c041dd3330",
                                "sense_id": "65d462cb-9e65-38c0-ba8d-0b49221b56b9",
                                "text": "Ces petits propriétaires, dont le type est représenté par Courtecuisse, étaient les mainmortables du Tibère de la vallée d’Avonne, de même qu’à Paris les industriels sans argent sont les paysans de la haute banque."
                            },
                            {
                                "example_id": "e9876664-c99a-4409-8f3b-628461153682",
                                "sense_id": "65d462cb-9e65-38c0-ba8d-0b49221b56b9",
                                "text": "[…], et la plupart d'entre eux, au XIIᵉ siècle surtout, sont encore des serfs : dans la commune de Senlis, fondée par le roi en 1173, l'évêque a encore des mainmortables ; […]."
                            }
                        ]
                    }
                ],
