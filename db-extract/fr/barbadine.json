                        "sense_id": "5640727e-6532-30d1-9030-aa58ea02c1e0",
                        "entry_id": "d2b72da5-cb55-3629-981d-832f9443894a",
                        "glosses": [
                            "Nom vernaculaire de Passiflora quadrangularis, liane vigoureuse d’Amérique tropicale pouvant atteindre 10 à 20 m de long."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02cf229d-ded5-4ddb-911e-7fdfee07a3e1",
                                "sense_id": "5640727e-6532-30d1-9030-aa58ea02c1e0",
                                "text": "Les racines de la barbadine ont des propriétés émétiques et narcotiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "57fd9b8c-24bc-32e8-9ed8-fba2fd621287",
                        "entry_id": "d2b72da5-cb55-3629-981d-832f9443894a",
                        "glosses": [
                            "Fruit comestible de cette plante."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "6a65f040-a4c8-494f-81ec-abe31e35d36f",
                                "sense_id": "57fd9b8c-24bc-32e8-9ed8-fba2fd621287",
                                "text": "La barbadine est le plus gros des fruits de la passion : 10 à 30 cm de long, 7 à 15 cm de diamètre, son jus (jugo de badea) est très populaire en Équateur."
                            },
                            {
                                "example_id": "3c490091-9263-4138-8e44-2536f17ce256",
                                "sense_id": "57fd9b8c-24bc-32e8-9ed8-fba2fd621287",
                                "text": "On a échangé quelques mots sur la saison des pluies et le beau temps, puis elle m’a invité à entrer dans sa maison pour m’offrir un verre de jus de barbadine. — (Gaël Faye, Petit Pays, Grasset, 2016, page 171)"
                            }
                        ]
                    }
