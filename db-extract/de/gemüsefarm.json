                "senses": [
                    {
                        "sense_id": "50cf19a9-b7d2-33a8-9145-9d5297646467",
                        "entry_id": "ccd06ef2-8eb8-366f-b6fb-a8ea87b0ab43",
                        "glosses": [
                            "Farm, auf der Gemüse angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c713007a-807b-4894-bf2c-ad97fa6209b3",
                                "sense_id": "50cf19a9-b7d2-33a8-9145-9d5297646467",
                                "text": "„Sie kamen an einem alten Holzhaus vorbei und überquerten eine ungepflasterte Straße. Ein gerodetes Stück Land, früher vielleicht einmal eine Gemüsefarm.“"
                            },
                            {
                                "example_id": "1b17dee7-2151-4476-8bd7-4fb9712731f6",
                                "sense_id": "50cf19a9-b7d2-33a8-9145-9d5297646467",
                                "text": "„Da die Kriminaltechniker sagen, dass das Fungizid und die Plastikfolie auf eine Obst- oder Gemüsefarm hinweisen, habe ich den Fachmann vom Botanischen Garten auch nach Jacarandas auf den Farmen rund um Stellenbosch gefragt.“"
                            }
                        ],
