                },
                {
                    "sense_id": "800ecc8a-34f6-3606-abf6-ccad8703257d",
                    "sense_definition": "Qui semble afficher une expression renfrognée ou mécontente, en parlant d'une chose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux sac à dos a une fermeture qui lui donne un air <w>grincheux</w>."
                        },
                        {
                            "text": "Avec ses deux fenêtres et sa porte étroite, la façade de l'immeuble paraît <w>grincheuse</w>."
                        }
                    ],
