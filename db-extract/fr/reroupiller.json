                        "glosses": [
                            "Roupiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a9c4f1-dd8f-4a69-b720-5c27dfbce7ee",
                                "sense_id": "1632c706-1f09-3377-b695-bc3b70aaa181",
                                "text": "Alors on reroupille, on ouvre un œil quante ça bombarde, on ouvre les deux quante les cuistots s’amènent ; et puis on roupille encore."
                            },
                            {
                                "example_id": "c37081ba-9cc0-4ed5-870a-22ce25b78ab3",
                                "sense_id": "1632c706-1f09-3377-b695-bc3b70aaa181",
                                "text": "On peut fouiner partout, roupiller, jouer, reroupiller…"
                            }
                        ]
                    }
