                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4700b3-5cd1-4f71-8192-72e3906bd376",
                                "sense_id": "4f872f12-a482-3737-a2ec-20656d61c61a",
                                "text": "«Сделаем», — чётко произнёс он."
                            },
                            {
                                "example_id": "001edaa9-8ea2-47a1-860c-29b0ffd485bc",
                                "sense_id": "4f872f12-a482-3737-a2ec-20656d61c61a",
                                "text": "На снимках чётко проявились невидимые глазу подробности."
                            },
                            {
                                "example_id": "0352617b-0f1e-478d-8774-4a339f05e96c",
                                "sense_id": "4f872f12-a482-3737-a2ec-20656d61c61a",
                                "text": "Это чётко обозначено в выступлении."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddbfde7e-7082-3478-8720-7b4a5cbf8297",
                        "entry_id": "dcb34cae-8b1b-379b-8200-a84cb72b07ae",
                        "glosses": [
                            "разг. отлично"
                        ],
                        "tags": [],
                        "examples": [
                            {
