                                        "glosses": [
                                            "Observant of tradition; attached to old customs; old-fashioned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f2dbd0-3984-4b87-866f-8419494a13d7",
