                            {
                                "example_id": "816bc793-7793-4662-85aa-c0208038cac4",
                                "sense_id": "0c4a8b9f-c7fa-3c62-b94f-6bda3a4df119",
                                "text": "Aspergeteler Karel van der Putten woont ook in Vlierden. Bij hem werken af en toe Poolse arbeiders. Zo'n drie maanden per jaar komen deze mannen aspergesteken. Ze slapen nu nog in een woonunit op het erf."
                            },
                            {
                                "example_id": "1206d09b-9190-47ca-9c88-48716c3ba14c",
                                "sense_id": "0c4a8b9f-c7fa-3c62-b94f-6bda3a4df119",
                                "text": "Snelheid, kracht, vaardigheid en een beetje geluk, de beste aspergesteker van Nederland heeft het allemaal. Wie zich die titel mag aanmeten wordt vanmiddag bepaald in Blaricum, tijdens het allereerste NK aspergesteken."
                            }
