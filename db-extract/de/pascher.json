                "senses": [
                    {
                        "sense_id": "3217999c-f0e1-3103-853d-ac1cba45e963",
                        "entry_id": "5f52e2e3-484c-3886-ab96-b4db948b0fd5",
                        "glosses": [
                            "Schmuggler"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1770558c-36c9-4d25-94b3-3fd9fa05c364",
                                "sense_id": "3217999c-f0e1-3103-853d-ac1cba45e963",
                                "text": "Ein Pascher schmuggelte unversteuerte Zigaretten über die Grenze."
                            },
                            {
                                "example_id": "610a1bad-9de4-42db-b9cf-fdbafd4d8b09",
                                "sense_id": "3217999c-f0e1-3103-853d-ac1cba45e963",
                                "text": "„Wo soll man den Hauptmann der Pascher suchen, und wo soll man ihn greifen und packen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bc1a4275-45ab-3479-b383-fdc3e557c558",
                        "entry_id": "5f52e2e3-484c-3886-ab96-b4db948b0fd5",
                        "glosses": [
                            "Person, die beim Vortragen eines Volksliedes zusammen mit anderen rhythmisch klatscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5602cc-34d1-4829-9863-b8e3cdcaa57c",
                                "sense_id": "bc1a4275-45ab-3479-b383-fdc3e557c558",
                                "text": "Die rhythmische Struktur des Paschens kann teilweise sehr kompliziert werden, daher braucht es erfahrene Pascher."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
