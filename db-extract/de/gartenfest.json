                "senses": [
                    {
                        "sense_id": "7e5deaab-e773-3a89-a130-8274f6c5d9c4",
                        "entry_id": "4c2da11d-5f71-354e-9804-a89e81d90570",
                        "glosses": [
                            "Fest in einem Garten"
                        ],
                        "tags": [
                            "Veranstaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "25834b98-9c44-4fc5-89dc-6dfb0520c7dd",
                                "sense_id": "7e5deaab-e773-3a89-a130-8274f6c5d9c4",
                                "text": "„Wir waren hier auf Geburtstagsfeiern, Gartenfesten, Buchpremieren und einer Hochzeit.“"
                            },
                            {
                                "example_id": "47527c52-a8c9-406a-9636-c7a6ba3991d6",
                                "sense_id": "7e5deaab-e773-3a89-a130-8274f6c5d9c4",
                                "text": "„Ich folgte ihr mit dem Blick bis Berg, vorbei an dem schleimigen Brackwasser bei Bergsbotn, über die Brücke nach Bjerka, dann hoch zu der Wohnsiedlung, wo das Gartenfest stattfand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
