                "senses": [
                    {
                        "sense_id": "e70d8ef1-1b0c-350c-9a48-10afccc03828",
                        "entry_id": "4c497e67-93cc-3cf7-a1f9-440374b36923",
                        "glosses": [
                            "schip waarmee men vloeibare chemicaliën kan vervoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a3cc82-3045-4ae7-93f7-58e1290bfc0f",
                                "sense_id": "e70d8ef1-1b0c-350c-9a48-10afccc03828",
                                "text": "Op de Noordzee is een chemicaliëntanker tegen een booreiland gevaren. Volgens de Kustwacht is er flinke schade aan de boeg van het schip en aan het productieplatform, dat onbemand en niet meer in gebruik is."
                            },
                            {
                                "example_id": "04038b07-0e7e-48fd-b068-fa22cc904b48",
                                "sense_id": "e70d8ef1-1b0c-350c-9a48-10afccc03828",
                                "text": "In 2006 zonk een chemicaliëntanker tussen Guernsey en de Britse Kust. Het schip was geladen met forforzuur. De 22 bemanningsleden konden allemaal worden gered.In 2005 zonk een Duitse vrachtvaarder 100 kilometer uit de kust bij Den Helder na een aanvaring met een ander schip. De vrachtvaarder was geladen met kolen. Alle zeven opvarenden overleefden de aanvaring. In 2003 kwam een Nederlands vrachtschip in aanvaring met een Zweeds vrachtschip. Het gebeurde 70 kilometer uit de kust bij Terschelling. De zestien bemanningsleden van het Nederlandse schip werden opgepikt door de Zweden.In 2002 zonk een Noorse vrachtschip, de Tricolor, voor de kust bij Ramsgate. Het ongeluk gebeurde in dichte mist. De Tricolore had 3000 auto's aan boord. Alle opvarenden overleefden het ongeluk.In 2001 zonk een Noors vrachtschip 220 kilometer te noorden van Den Helder. De zeskoppige bemanning werd veilig van boord gehaald."
                            },
                            {
                                "example_id": "173db36f-31cb-46cd-b486-00a5fb084baa",
                                "sense_id": "e70d8ef1-1b0c-350c-9a48-10afccc03828",
                                "text": "Schadelijk De kleverige substantie tast het verendek van de vogels aan. Het Nederlands Instituut voor Zeeonderzoek vermoedt dat het spul afkomstig is van een chemicaliëntanker, die het op zee heeft geloosd."
                            }
                        ]
                    }
