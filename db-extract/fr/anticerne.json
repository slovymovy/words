                ],
                "senses": [
                    {
                        "sense_id": "fc59c96f-a025-37a5-ac88-e4cdccf3a6aa",
                        "entry_id": "2aef3b91-b43d-38a6-b6b0-7e93478814ff",
                        "glosses": [
                            "Spécialité commerciale proposée comme remède aux cernes des yeux, pour les corriger ou pour les masquer."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fd4c9f23-4049-4aae-bdd7-8b9ee0a241eb",
                                "sense_id": "fc59c96f-a025-37a5-ac88-e4cdccf3a6aa",
                                "text": "L’anticerne est aussi un correcteur de teint. Il s'applique sur toutes les zones qui ont besoin d'être éclaircies ou corrigées : cernes, mais aussi petits boutons, taches de pigmentation, rougeurs."
                            },
                            {
                                "example_id": "a4d60071-9a6d-4fb2-8fe8-82e70133a536",
                                "sense_id": "fc59c96f-a025-37a5-ac88-e4cdccf3a6aa",
                                "text": "Quelle que soit sa forme, stick, pot, stylo ou crayon, la pose de l’anticerne est la même. Pour ma part, je préfère appliquer l’anticerne le stylo (dit aussi « touche éclat ») : sa texture est très fine et son pinceau très pratique d'utilisation."
                            }
                        ]
                    }
                ],
