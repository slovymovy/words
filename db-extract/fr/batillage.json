                        ],
                        "examples": [
                            {
                                "example_id": "c665b18d-5c71-4502-90ce-40e7c13d207f",
                                "sense_id": "75b55824-095c-386e-8a5a-d5e813ecfd4e",
                                "text": "Le batillage est une source de stress pour le milieu riverain, associée à la circulation des navires dans les zones étroites."
                            },
                            {
                                "example_id": "47e17b30-8ff8-4a30-a7a2-5a60030b8ee6",
                                "sense_id": "75b55824-095c-386e-8a5a-d5e813ecfd4e",
                                "text": "L’érosion est le souci premier de la Compagnie des rivières. Les causes en sont multiples : le courant, la dessiccation, les tourbillons, sans oublier le batillage, oscillation de l’eau provoquée par le vent ou le passage de bateaux."
                            },
                            {
                                "example_id": "d5e78014-ffaa-4676-a471-b084603734cc",
                                "sense_id": "75b55824-095c-386e-8a5a-d5e813ecfd4e",
                                "text": "Deux chalands sont amarrés sur le canal, joue à joue, à petits batillages."
                            }
                        ]
