                        "sense_id": "f444b7fd-69a7-3494-9a4a-277d305576e9",
                        "entry_id": "f4c53974-7f3e-3c3e-bff8-a72d6713fd86",
                        "glosses": [
                            "zbiór wyobrażeń i opowieści na temat pochodzenia bóstw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c3a56d-0c84-4ef7-a609-7071fe8e33a8",
                                "sense_id": "f444b7fd-69a7-3494-9a4a-277d305576e9",
                                "text": "Taką władzę nad parowozami mógł mieć tylko Bóg-Ojciec, Bóg-Maszynista, wieczny i nieśmiertelny. A tymczasem stała się rzecz, która zakłóciła tę parowozową teogonię"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
