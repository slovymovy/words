                            {
                                "target_lang_word": "гитара",
                                "target_lang_sense_clarification": "тип инструмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吉他",
                                "target_lang_sense_clarification": "乐器分类"
                            }
                        ]
                    }
                }
            ]
        },
