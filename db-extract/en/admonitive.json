                            {
                                "example_id": "061350c8-7736-4d6f-b829-fc93b1ba528f",
                                "sense_id": "48c6e2a0-3c7e-30d6-bdf1-8150cd4a6425",
                                "text": "Again, this kind of suffering to the devout Fathers did seem many ways significant, or full of instructive and admonitive emblems; […]"
                            },
                            {
                                "example_id": "3527ae26-de8b-4661-a558-fd22be9ff766",
                                "sense_id": "48c6e2a0-3c7e-30d6-bdf1-8150cd4a6425",
                                "text": "Wale’ typically occurs in S-final position and conveys variously dubitative (X is possible, but I doubt it), admonitive (X is possible so be careful; X is the case, so take note) or, when used with imperatives, exhortative (hurry up and X)."
                            }
                        ]
