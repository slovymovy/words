        "nl-extract.jsonl": [
            {
                "entry_id": "14beaf05-219e-35c7-be52-2d02c5163356",
                "word": "jurisprudentie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "59f11151-1b9e-34e5-a86d-69de4dc54561",
                        "entry_id": "14beaf05-219e-35c7-be52-2d02c5163356",
                        "glosses": [
                            "het geheel van uitspraken van rechters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df667a44-cf09-46f9-ab61-bc7e05e6d75a",
                                "sense_id": "59f11151-1b9e-34e5-a86d-69de4dc54561",
                                "text": "Die dag lichtte hoofdofficier Marianne Bloos in NRC het besluit toe. „Er bestaat zoiets als vrije wil”, zei Bloos. „Niemand dwingt mensen om te roken en ze stoppen er ook vaak genoeg mee. Je kunt tabaksfabrikanten niet verantwoordelijk houden voor hun gedrag. (…) Met de huidige wet en jurisprudentie kun je niet zeggen: de roker handelt helemaal niet zelf.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "134b7c37-ddf8-45c4-87e5-2c91213f19b4",
                        "source_entry_id": "14beaf05-219e-35c7-be52-2d02c5163356",
                        "source_sense_id": "59f11151-1b9e-34e5-a86d-69de4dc54561",
                        "target_lang_word": "Rechtsprechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtsprechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                        "entry_id": "0ec9f068-6902-3f01-be75-a118fe7c81ea",
                                        "glosses": [
                                            "Menge und/oder Art der erfolgten Gerichtsurteile"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa18424-161d-40bb-a627-0c71f8517aec",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "Die Rechtsprechung hat sich im Lauf der Zeit geändert."
                                            },
                                            {
                                                "example_id": "f85c7fb1-9a3e-4834-a00d-e56dd4b772b5",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Später, als ich etwas älter war und mich ernsthafter mit der deutschen Rechtsprechung beschäftigte, wurde mir die Bedeutung von Gesetzen und Rechten viel stärker bewusst.“"
                                            },
                                            {
                                                "example_id": "6e91eff9-03b9-40c5-85a8-a0e3a6e03844",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Ich hörte, wie ein junger Abate mit lauter Stimme eine wahre oder erfundene Begebenheit erzählte, die unmittelbar, doch ohne Gehässigkeit, die Rechtsprechung des Heiligen Vaters angriff.“"
                                            },
                                            {
                                                "example_id": "5138c72b-5455-4688-82a3-04331ae15c1b",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "[Die Ukraine] „hat sich aber in zwei Erklärungen von 2014 und 2015 der Rechtsprechung des IStGH für alle Verbrechen ab November 2013 unterworfen. Damit kann der IStGH zumindest Verbrechen auf ukrainischem Boden untersuchen.“"
                                            },
                                            {
                                                "example_id": "c8b0778a-701f-445b-8c5e-144a2db7754b",
                                                "sense_id": "b0cb9b4c-78bf-357e-a4c8-05923ff59577",
                                                "text": "„Wie immer man zu dieser Darstellung stehen mag, sie zeigt jedenfalls ein ganz anderes Verständnis von literarischer Urheberschaft, als es das unsre ist (auf dem, nota bene, unsere Rechtsprechung beruht).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dcd6f6e-dcf8-41dc-aace-88706c16db7e",
                        "source_entry_id": "14beaf05-219e-35c7-be52-2d02c5163356",
