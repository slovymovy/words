                    },
                    {
                        "translation_id": "eb029271-2a8c-4c27-bcea-034723870a7e",
                        "source_entry_id": "a0b51db7-c1c0-3733-8c17-682989984abb",
                        "source_sense_id": "49bf7fc6-1725-3c05-bff9-9aeddebd2d01",
                        "target_lang_word": "Drachme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drachme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f130add6-8a7c-3be5-b860-272a79aa8c40",
                                        "entry_id": "c62a1aae-484a-37aa-b247-1259973a214d",
                                        "glosses": [
                                            "ehemalige Währungseinheit in Griechenland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3af70f3-7d50-4718-8c82-5d290e6d6446",
                                                "sense_id": "f130add6-8a7c-3be5-b860-272a79aa8c40",
                                                "text": "Die Drachmen wurden durch den Euro ersetzt."
                                            },
                                            {
                                                "example_id": "eda59814-20e4-4cf2-965e-f95d89991741",
                                                "sense_id": "f130add6-8a7c-3be5-b860-272a79aa8c40",
                                                "text": "100 Lepta (λεπτά; Singular: Lepton [λεπτό{ν}]) ergeben eine Drachme."
                                            },
                                            {
                                                "example_id": "6afaa84b-7498-4e24-908c-4216c8c6c5ad",
                                                "sense_id": "f130add6-8a7c-3be5-b860-272a79aa8c40",
                                                "text": "„Die Gebühr war eigentlich zu hoch für die Familie, 3000 Drachmen im Monat würde sie bestimmt nicht bekommen, klagte Chrissi schon im Vorhinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de1322c6-4ca8-4835-9d31-4dca3819b175",
                        "source_entry_id": "a0b51db7-c1c0-3733-8c17-682989984abb",
                        "source_sense_id": "49bf7fc6-1725-3c05-bff9-9aeddebd2d01",
                        "target_lang_word": "драхма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "драхма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "debb16e8-9ec2-3bd6-a96c-7de4de0545f3",
                                        "entry_id": "77ad62c5-6abd-3fe7-979e-d682da0b0c4f",
                                        "glosses": [
                                            "истор. денежная единица Греции с 1833 по 2001 годы, равная 100 лептам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3238850d-cd26-4168-b6d1-7b4aa9956a29",
                                                "sense_id": "debb16e8-9ec2-3bd6-a96c-7de4de0545f3",
                                                "text": "Внесено в храм Гермоном, сыном Солона, Семом, сыном Космиада, и Солоном, сыном Метонима, за цену хлеба, что от царя Масиниссы, согласно решению демоса — 2530 драхм; ⟨…⟩"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858f9f1b-e32c-3d4a-8c1c-29eb059ae2d3",
                                        "entry_id": "77ad62c5-6abd-3fe7-979e-d682da0b0c4f",
                                        "glosses": [
                                            "истор., нумизм. серебряная денежная и весовая единица Древней Греции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "520ed8b4-f6c2-4b63-8ea9-e4f773369afd",
                                                "sense_id": "858f9f1b-e32c-3d4a-8c1c-29eb059ae2d3",
                                                "text": "Такое количество серебра, на которое можно было купить барана или бочку ячменя, стало главной монетой и весовой единицей — драхмой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65149642-100a-3b20-b42b-470c64251f6f",
                                        "entry_id": "77ad62c5-6abd-3fe7-979e-d682da0b0c4f",
                                        "glosses": [
                                            "спец. единица массы, применявшаяся в аптекарской практике и для взвешивания драгоценных металлов и составлявшая 1/8 унции (содержала 3 скрупула, или 3,73 грамма)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6214341-71c9-40c2-838f-39560f6ba9a0",
                                                "sense_id": "65149642-100a-3b20-b42b-470c64251f6f",
                                                "text": "Само собою разумеется, что чадо было встречено слезами радости, перед появлением которых я выпил залпом 1/2 драхмы бромистого калия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
