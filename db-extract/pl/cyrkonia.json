                        "sense_id": "62fb1b8a-5b1e-33ec-998f-63bbb5c0e8d7",
                        "entry_id": "6acee86c-a2e0-3a81-8e12-2f53d26c8f05",
                        "glosses": [
                            "syntetyczny kamień ozdobny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b96158-79b5-46b8-8476-4565affc846b",
                                "sense_id": "62fb1b8a-5b1e-33ec-998f-63bbb5c0e8d7",
                                "text": "Przez długi czas cyrkonia uchodziła za najlepszą imitację diamentu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fba03f1d-5454-444a-bd27-14187ebd70b1",
                        "source_entry_id": "6acee86c-a2e0-3a81-8e12-2f53d26c8f05",
                        "source_sense_id": "62fb1b8a-5b1e-33ec-998f-63bbb5c0e8d7",
                        "target_lang_word": "zirconia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zirconia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0cc5e9c-2f93-38fb-8913-a642520e6bcf",
                                        "entry_id": "ccc33f0c-dded-3c93-b156-8c8b1acfefb7",
                                        "glosses": [
                                            "The oxide of zirconium, obtained as a white powder, and possessing both acid and basic properties. On account of its infusibility, and brilliant luminosity when incandescent, it is used as an ingredient of sticks for the Drummond light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a77f905b-1c0c-4c92-aa61-28057738adbd",
                        "source_entry_id": "6acee86c-a2e0-3a81-8e12-2f53d26c8f05",
                        "source_sense_id": "62fb1b8a-5b1e-33ec-998f-63bbb5c0e8d7",
                        "target_lang_word": "zircone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zircone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a937e7cb-d049-382f-beb7-d5f7b61fa6e4",
                                        "entry_id": "a7e9f2f9-0346-3ff4-8e12-c5f012ef8dc2",
                                        "glosses": [
                                            "Dioxyde de zirconium (ZrO₂). Après frittage, s'emploie en bijouterie ou pour la réalisation de prothèses dentaires, notamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e34057c-3c38-438c-9167-f78ffa4dc664",
                                                "sense_id": "a937e7cb-d049-382f-beb7-d5f7b61fa6e4",
                                                "text": "Or, en 1915, le professeur A. Lacroix découvrait dans des échantillons rapportés du nord-ouest de Madagascar, une roche comparable, mais non identique qu'il appela « fasibitikite ». Elle renferme aussi zircones et terres cériques, ce qui s'expliquait par la présence d'un minéral spécial; l'eucolite, […]."
                                            },
                                            {
                                                "example_id": "986ae115-134e-4216-98f4-33a6df03c2f3",
                                                "sense_id": "a937e7cb-d049-382f-beb7-d5f7b61fa6e4",
                                                "text": "On peut ainsi obtenir un matériau autocicatrisant. C'est le cas, par exemple, de la stabilisation de certaines céramiques par l'inclusion de particules de zircone, oxyde de zirconium, un métal assez semblable au titane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
