                                            {
                                                "example_id": "ba7661f6-b58f-4b64-8cc4-75e3106af2e7",
                                                "sense_id": "96ce7318-6600-3d70-a866-59f05d6d0a17",
                                                "text": "C'est sur l'ailante (glanduleux) vernis du Japon que croît un grand bombyx dont la chenille file une soie grossière."
                                            },
                                            {
                                                "example_id": "6d99f957-170c-4e5a-9782-5858e83e1f33",
                                                "sense_id": "96ce7318-6600-3d70-a866-59f05d6d0a17",
                                                "text": "Le papillon de nuit (hétérocère) suivant se nourrit d'ailante glanduleux :",
                                                "translation": "bombyx de l'ailante, Samia cynthia (Saturniidae)."
                                            }
                                        ]
