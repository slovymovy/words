        "pl-extract.jsonl": [
            {
                "entry_id": "f1b59505-9945-3341-8ae2-d0a57699721f",
                "word": "frazeologizm",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdf729b3-f10c-3dd3-870f-bf8e7a895c7a",
                        "entry_id": "f1b59505-9945-3341-8ae2-d0a57699721f",
                        "glosses": [
                            "zob. związek frazeologiczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82bff4b-f54a-46ac-8a62-f192a577e573",
                                "sense_id": "fdf729b3-f10c-3dd3-870f-bf8e7a895c7a",
                                "text": "Aby utworzyć zdanie, trzeba je uzupełnić składnikiem typu rzeczownikowego, który określi, do kogo lub czego frazeologizm się odnosi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56d86600-f128-4883-8882-f7e72cb54bd3",
                        "source_entry_id": "f1b59505-9945-3341-8ae2-d0a57699721f",
                        "source_sense_id": "fdf729b3-f10c-3dd3-870f-bf8e7a895c7a",
                        "target_lang_word": "Phraseologismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phraseologismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                        "entry_id": "478dd377-9cd0-3f1d-adfa-0bf4ec5d9432",
                                        "glosses": [
                                            "feste Verbindung von zwei oder mehr Wörtern, deren Gesamtbedeutung sich nicht mehr aus den Bedeutungen der einzelnen Komponenten ergibt, sondern eine Übertragung erfahren hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c659b01-f7de-4249-9ce4-387d104414b4",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "„Jemanden in die Pfanne hauen“, „den Rahm abschöpfen“, „durch die Lappen gehn“ sind Phraseologismen im Deutschen."
                                            },
                                            {
                                                "example_id": "aef4fd9c-ed27-4c74-990d-f378a930a0d2",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "Mit Phraseologismen befasst sich die linguistische Disziplin Phraseologie."
                                            },
                                            {
                                                "example_id": "7641397a-2e53-4980-b86c-909c061c433a",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "„Es gibt zwischensprachlich sogar eine Reihe von Phraseologismen, die lexikalisch analog und in ihrer syntaktischen Struktur parallel gebildet werden und dabei auch noch bedeutungsgleich sind: man spricht in diesem Fall von ‚isomorphen Phraseologismen‘.“"
                                            },
                                            {
                                                "example_id": "6dc5c86c-2970-4f6d-ab1d-e7900d84fd42",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "„Unter Phraseologismen wollen wir feste Einheiten aus mehr als einem Wort verstehen.“"
                                            },
                                            {
                                                "example_id": "2b8f2e79-cbd6-47e5-b42f-7b2e467ef735",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "„Bei W. Fleischer erscheinen die meisten festen Formen unter der heute gebräuchlichen Bezeichnung des Phraseologismus.“"
                                            },
                                            {
                                                "example_id": "a0b2eea2-1bef-4e54-a99b-195953883955",
                                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                                "text": "„Sprichwörter zählen zu den Phraseologismen, das heißt zu festen Wortverbindungen, die laut H. Burger (…) Polylexikalität, relative semantische und syntaktische Stabilität, Festigkeit, Lexikalisierung und Idiomatizität sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a470ec3b-4051-456c-a3a9-1874efbfe04e",
                        "source_entry_id": "f1b59505-9945-3341-8ae2-d0a57699721f",
                        "source_sense_id": "fdf729b3-f10c-3dd3-870f-bf8e7a895c7a",
                        "target_lang_word": "фразеологизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фразеологизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "541bb803-62f2-367a-98d0-1bf21892f31b",
                                        "entry_id": "24f29612-a967-30d9-b991-77681106e106",
                                        "glosses": [
                                            "лингв. устойчивое по составу и структуре, лексически неделимое и целостное по значению словосочетание естественного языка, выполняющее функцию отдельной лексемы и имеющее самостоятельное значение, которое в целом не является суммой значений входящих в него слов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47cccf36-ab0d-4a23-9af7-99ab1d18642a",
                                                "sense_id": "541bb803-62f2-367a-98d0-1bf21892f31b",
                                                "text": "Такими замечательными «чудаками» являются переводчики, не знающие фразеологизмов того языка, с которого они переводят."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
