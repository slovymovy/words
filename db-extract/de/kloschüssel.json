                "senses": [
                    {
                        "sense_id": "f1095f3d-7fca-3ed2-b6cb-64fb847148fc",
                        "entry_id": "436d0eba-aa1b-3827-bdab-74d3c7d70b81",
                        "glosses": [
                            "Becken des Toilettensitzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4c08cf-c30d-427d-b2da-a8fc1215e15e",
                                "sense_id": "f1095f3d-7fca-3ed2-b6cb-64fb847148fc",
                                "text": "„In der Kloschüssel hing ein stinkendes Stück Duftseife im Plastikgitter.“"
                            },
                            {
                                "example_id": "10be5082-c9e6-44f7-a5ce-4335f9eb1b7b",
                                "sense_id": "f1095f3d-7fca-3ed2-b6cb-64fb847148fc",
                                "text": "„Beschützt vom Geräusch des Wassers, erbrach ich das Essen in die Kloschüssel.“"
                            },
                            {
                                "example_id": "8292ec09-f66c-4f15-8d41-152949155654",
                                "sense_id": "f1095f3d-7fca-3ed2-b6cb-64fb847148fc",
                                "text": "„Die eine ging aufs Klo und stolperte, schlug sich den Kopf an der Kloschüssel auf und blutete alles voll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
