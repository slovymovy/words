                    {
                        "sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "glosses": [
                            "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ecd0415-2d72-4719-8ce5-eb5111903c6d",
                                "sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                                "text": "(1764) Het overijverige vervolgingsbeleid van hoofdofficier Isaac Sweers had gruwelijke gevolgen voor homoseksuele mannen: acht executies, vijf gevangenisstraffen, drie verbanningen en ruim zestig verstekvonnissen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c72f94e-0927-4660-afc3-0adbb9843435",
                        "source_entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "source_sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "source_sense_description": "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren",
                        "target_lang_word": "Verbannung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbannung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b11011e-3512-3436-9c66-007ebdabfe16",
                                        "entry_id": "3ec82fa9-773a-35be-b987-7dd2ae107316",
                                        "glosses": [
                                            "durch Urteil oder Dekret erzwungene Verlegung an einen von der betroffenen Person nicht gewünschten Ort"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                        "entry_id": "3ec82fa9-773a-35be-b987-7dd2ae107316",
                                        "glosses": [
                                            "erzwungener Aufenthalt an einem von der betroffenen Person nicht gewünschten Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86737580-cc32-41e4-a52c-58dec205bc85",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Er war der nominale Anführer der Rebellion und starb fünf Jahre später in der Verbannung in Burma.“"
                                            },
                                            {
                                                "example_id": "d569b18c-23ba-4b85-b007-9b81e3af4345",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Jetzt liegt der Strafgefangene C843 in einem fensterlosen Güterwagen, wie damals, als sie ihn nach Sibirien in die Verbannung geschickt haben.“"
                                            },
                                            {
                                                "example_id": "fba6e967-6226-469c-bf9b-d4f719b4e933",
                                                "sense_id": "5fb727c1-f34c-362b-873c-2ce5eefdee72",
                                                "text": "„Es schien, als hätte er immer noch nicht mit dem Ende seiner Verbannung gerechnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "173f1769-f4ca-4a80-a658-efe76635ad39",
                        "source_entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "source_sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "source_sense_description": "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren",
                        "target_lang_word": "exile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "The state of being banished from one's home or country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf95d16-de8e-4f3e-a7bd-003ca5fa4825",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "He lived in exile."
                                            },
                                            {
                                                "example_id": "eb50e641-0cac-4b7d-80ac-a494020503c7",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "They chose exile rather than assimilation."
                                            },
                                            {
                                                "example_id": "17cd259e-ddeb-4cb8-9022-ea5f3c2fe97c",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "Let them be recalled from their exile."
                                            },
                                            {
                                                "example_id": "3dbce57f-9ea8-4caf-b4fe-da514d06f81b",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "Someone who is banished from his home or country."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114ace20-b0e7-47f3-bfdf-5ef2eb2283db",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "She lived as an exile, and did her best to make the most out of such life."
                                            },
                                            {
                                                "example_id": "d3ffce3f-a27d-437b-a365-4cbb94bf6a54",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "Thou art an exile, and thou must not stay."
                                            },
                                            {
                                                "example_id": "48e6b175-21bc-4ffd-b95e-7481a745b37f",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                        "entry_id": "8b58734b-4757-3c88-96bc-30e33853883e",
                                        "glosses": [
                                            "To send (someone or something) into exile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd5c73-0037-4b82-97a4-bd6c1a20c07e",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "Calling home our exiled friends abroad."
                                            },
                                            {
                                                "example_id": "e906013b-93c6-4eaa-9b2d-b4260c1034e8",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "She, mouldering with the dull earth's mouldering sod, / Inwrapt tenfold in slothful shame, / Lay there exiled from eternal God, / Lost to her place and name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d9612f3-37d0-46e0-81a0-8189a5a87a72",
                        "source_entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "source_sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "source_sense_description": "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren",
                        "target_lang_word": "banishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2785cf5b-bd93-3ea2-96e5-6d8f1b2a2b6c",
                                        "entry_id": "85d634bb-9774-3235-9ecf-d681ee726bd9",
                                        "glosses": [
                                            "The act of banishing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46a658d-e266-4fb1-bc64-01826acf3a55",
                                                "sense_id": "2785cf5b-bd93-3ea2-96e5-6d8f1b2a2b6c",
                                                "text": "The judge pronounced banishment upon the war criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f4bf072-0038-352c-89f4-b2147ed0c992",
                                        "entry_id": "85d634bb-9774-3235-9ecf-d681ee726bd9",
                                        "glosses": [
                                            "The state of being banished, exile."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998ec4dc-4e81-4525-b3f6-b2106bb33b8f",
                                                "sense_id": "0f4bf072-0038-352c-89f4-b2147ed0c992",
                                                "text": "He has been in banishment from his home country for well over four years."
                                            },
                                            {
                                                "example_id": "c01c7ea4-e3e5-45ed-8537-005c128a5775",
                                                "sense_id": "0f4bf072-0038-352c-89f4-b2147ed0c992",
                                                "text": "You are in error. / This is terror. / This is your banishment. This land is mine. / This is what you earn. / This is the Law of No Return. / This is the sour dough, this the sweet wine. / This is my history, this my race / And this unhappy man threw acid in my face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3302be-49ae-4b0c-b956-7fc5d67f1eb5",
                        "source_entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "source_sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "source_sense_description": "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren",
                        "target_lang_word": "exil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                        "entry_id": "3cdb21e6-35ee-35ba-9ff7-52c7adc03cde",
                                        "glosses": [
                                            "État de celui que l’autorité force à vivre hors de sa patrie, ou qui s’y résout lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2a3e91-d261-4818-b1ce-4cad1534397f",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Envoyer en exil."
                                            },
                                            {
                                                "example_id": "e092f7e4-db89-4555-942c-3133e1faa82e",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Aller en exil."
                                            },
                                            {
                                                "example_id": "a5d738ec-af92-4db6-af0e-911f779c11c6",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Être en exil."
                                            },
                                            {
                                                "example_id": "243c35dd-9ff5-424b-9dbe-f73369493879",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Lieu d’exil."
                                            },
                                            {
                                                "example_id": "d1217edd-48fc-4aa8-b079-17780dd0c349",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Il est revenu, il a été rappelé d’exil, de l’exil, de son exil."
                                            },
                                            {
                                                "example_id": "938d60eb-b094-4358-bbe4-a9d181bcea07",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "La terre est pour l’homme un lieu d’exil, la vie est un temps d’exil."
                                            },
                                            {
                                                "example_id": "1f0e3007-c532-45ac-b5fb-c24c240c65cd",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "La seconde vague d’exil, déclenchée à partir de 1925 par la dissolution des espaces démocratiques, toucha de très nombreux journalistes, intellectuels, parlementaires, élus locaux et cadres intermédiaires des partis jusqu’aux plus hauts dirigeants."
                                            },
                                            {
                                                "example_id": "1aa011bc-9542-4e86-993a-d9339e02bcc2",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "L’exil n’est pas un sentiment, c’est une mutilation. Non seulement on vous ampute de votre moi profond, mais aussi de vos habitudes, de votre langue."
                                            },
                                            {
                                                "example_id": "b4845626-4541-49ab-b86b-57687404f237",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Dans quelques heures, les compartiments et les couchettes se rempliront d’enfants et de vieillards, de baluchons rassemblés à la va-vite, de chats, de chiens, et de l’immense tristesse de l’exil."
                                            },
                                            {
                                                "example_id": "6b1107bf-2111-4a81-a548-dd03f69236f7",
                                                "sense_id": "c02f7ed2-1170-37f5-adb9-0f066ce8b91e",
                                                "text": "Moscou a déjà annexé 125.700 km² de territoire ukrainien, soit l'équivalent de la Grèce, poussant 3,5 millions de personnes à l' exil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f028ab5e-9898-32d5-8f03-770b2e4b0b57",
                                        "entry_id": "3cdb21e6-35ee-35ba-9ff7-52c7adc03cde",
                                        "glosses": [
                                            "Tout séjour dans un lieu qui n’est pas celui où l’on voudrait être, de tout éloignement qui prive de certains agréments que l’on regrette."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f04302-8391-4ecd-80b8-48daca34c96a",
                                                "sense_id": "f028ab5e-9898-32d5-8f03-770b2e4b0b57",
                                                "text": "La présence de Mescaleros n’inquiétait pas outre mesure les Navajos. Dans le passé, ils avaient parfois eu maille à partir avec eux, mais depuis leur exil commun, à Bosque-Redondo, les choses s’étaient considérablement apaisées."
                                            },
                                            {
                                                "example_id": "e20099b1-5db3-4c9c-9939-b647cf3f8354",
                                                "sense_id": "f028ab5e-9898-32d5-8f03-770b2e4b0b57",
                                                "text": "Vivre ainsi loin de vous est une sorte d’exil, est un exil, un véritable exil pour moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53adaa75-2850-4439-b566-eeb355333b0e",
                        "source_entry_id": "f3efb2ce-0325-38bf-842d-fef42d68c32d",
                        "source_sense_id": "78412773-130c-3112-ae3a-41081ccff5d0",
                        "source_sense_description": "het verbod opgelegd krijgen naar een bepaalde plaats terug te keren",
                        "target_lang_word": "bannissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bannissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6c0076-67f7-31c7-a59f-40fd1d5341e8",
                                        "entry_id": "7310d235-b7a2-3b28-81bd-1a81864fe23a",
                                        "glosses": [
                                            "Action de bannir, d’expulser une personne en lui interdisant de revenir ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdc8e5e-c3c0-42b7-8cd3-44fa9b07e1c4",
                                                "sense_id": "8b6c0076-67f7-31c7-a59f-40fd1d5341e8",
                                                "text": "Arrêt de la Cour du Parlement, qui condamne une quidane, connue sous le nom de la femme des Ormes, à être attachée au carcan à la place Saint-Michel, et au bannissement pendant neuf ans, pour avoir escroqué différentes marchandises chez une lingère. (Du 24 janvier 1775.)"
                                            },
                                            {
                                                "example_id": "bb3afeea-9a6f-4ce9-8841-64489688d594",
                                                "sense_id": "8b6c0076-67f7-31c7-a59f-40fd1d5341e8",
                                                "text": "Bravo et ses complices, mis en jugement pour crime de trahison, en vertu d’un décret du congrès, rendu à la majorité de 42 voix contre 16, furent condamnés au bannissement, et le 7 août, ce général, Barragon et environ 50 autres conjurés furent embarqués pour Lima et l’île de Chiloé."
                                            },
                                            {
                                                "example_id": "d708c450-a558-4083-968c-ebc54d2a4ccc",
                                                "sense_id": "8b6c0076-67f7-31c7-a59f-40fd1d5341e8",
                                                "text": "… et maintenant, […], il se trouvait déshérité de l’amour paternel, banni sans savoir le terme de son bannissement …."
                                            },
                                            {
                                                "example_id": "e9de592a-22c2-462c-8da9-b131e459d437",
                                                "sense_id": "8b6c0076-67f7-31c7-a59f-40fd1d5341e8",
                                                "text": "Quelques années de bannissement, dont une loi d'amnistie effaça ultérieurement les traces, furent l'unique peine infligée à quelques-uns de ceux qui avaient gravement offensé la patrie en tentant d'organiser, contre la République parlementaire, un pronunciamiento militaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
