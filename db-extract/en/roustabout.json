        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8a33cbf0-5d67-35b6-b428-9b919a12c8c4",
                "word": "roustabout",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1078143a-eeba-4ef1-bb8d-a82e3c3f9621",
                        "entry_id": "8a33cbf0-5d67-35b6-b428-9b919a12c8c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "roustabouts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                        "entry_id": "8a33cbf0-5d67-35b6-b428-9b919a12c8c4",
                        "glosses": [
                            "An unskilled laborer, especially at an oilfield, at a circus or on a ship."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "b9940b81-3b11-4d6f-8de5-6e3bfddcbef4",
                                "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                                "text": "The U. is my own Alma Mater, and I am proud to be known as an alumni, but there are certain instructors there who seem to think we ought to turn the conduct of the nation over to hoboes and roustabouts."
                            },
                            {
                                "example_id": "2f56cbd1-cabe-492e-b7fc-dbc5504ab390",
                                "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                                "text": "Then Sísiphos in torment I beheld / being roustabout to a tremendous boulder."
                            },
                            {
                                "example_id": "364513a0-5210-439f-9112-5a59caab704c",
                                "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                                "text": "Brooklyn Tony, who had run away from home to be a circus roustabout, became a poster artist and eventually an Abstract Expressionist."
                            },
                            {
                                "example_id": "abd169ba-8719-44c6-96a5-a242c6cddef2",
                                "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                                "text": "She works in McGregor, North Dakota as a roustabout pusher. That means she and her crew help fix and maintain the drilling sites."
                            },
                            {
                                "example_id": "23a7876e-6150-42e2-a86c-761028d96045",
                                "sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                                "text": "See also quotations under rouseabout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8c5e32d-8f6e-4511-acd8-0c86ba55584f",
                        "source_entry_id": "8a33cbf0-5d67-35b6-b428-9b919a12c8c4",
                        "source_sense_id": "d3143099-9c1f-3e5d-b324-90a5f690be19",
                        "source_sense_description": "an unskilled laborer",
                        "target_lang_word": "Hilfsarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilfsarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                        "entry_id": "b0d08c71-dffa-3e94-86b5-446ed92921e9",
                                        "glosses": [
                                            "Person, die für die von ihr ausgeübte Tätigkeit keine spezielle Ausbildung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe2dba1-9498-4142-a535-77c126acf232",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Anders als 1945, als sich die Ansiedler hauptsächlich aus landwirtschaftlichen Hilfsarbeitern und Gewerbetreibenden rekrutierten, nahmen jetzt vermehrt akut benötigte Industriearbeiter an der Siedlungsbewegung teil.“"
                                            },
                                            {
                                                "example_id": "434faf5b-4b50-4851-9edd-b34a6d444942",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Er verdiente sich sein Geld als Hilfsarbeiter und Postkartenmaler.“"
                                            },
                                            {
                                                "example_id": "6f8b41b6-2648-4143-b53b-24c1501aa126",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Der gelernte Schlosser, vertraut mit Metallen, hatte gleich nach dem Ersten Weltkrieg dort als Hilfsarbeiter begonnen und sich langsam hochgedient.“"
                                            },
                                            {
                                                "example_id": "29153440-f58e-4770-b2cb-f9a4f0c3d15d",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Darin ist keine Pioniertat einheitlicher Anrede vom Firmenchef bis zum Hilfsarbeiter zu sehen, sondern schlichtweg Übernahme schwedischen Anredegebrauchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
