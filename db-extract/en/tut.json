                "word": "tut",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fff9e9dd-5a2e-3b5c-86eb-c8b56aa85d24",
                        "entry_id": "48c5a90c-718c-35e5-9ed1-ef95e417061e",
                        "glosses": [
                            "Rubbish."
                        ],
                        "tags": [
                            "Southern-England",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ffbd012-59ae-4d83-8284-2c339b9dc7fa",
                                "sense_id": "fff9e9dd-5a2e-3b5c-86eb-c8b56aa85d24",
                                "text": "Such stupidness is mad 'cause nothing underfoot comes to nothing less to add to a load of old tut."
                            },
                            {
                                "example_id": "383f074b-11d8-4c74-b077-9431567751a1",
                                "sense_id": "fff9e9dd-5a2e-3b5c-86eb-c8b56aa85d24",
                                "text": "Cracking excuse: credible, watertight and yet patently a load of old tut."
                            },
                            {
                                "example_id": "50304bc9-4062-497c-ad00-107a57253557",
                                "sense_id": "fff9e9dd-5a2e-3b5c-86eb-c8b56aa85d24",
                                "text": "“Well there's a load of old tut in the cupboard next to Felicia's room,” she said grudgingly."
                            }
                        ]
                    }
                ],
