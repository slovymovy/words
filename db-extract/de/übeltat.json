                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méfait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Mauvaise action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadaa461-186d-48d8-907c-1841be80d8e2",
                                                "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                                "text": "Vers 1255, le bailli de Pont-Audemer, nommé Jean de Neuvy, était sous le poids des plus graves accusations, et parmi les nombreux méfaits qui lui étaient reprochés se trouvait l’impunité d'un assassinat commis sur un homme de Bourneville."
                                            },
                                            {
                                                "example_id": "b8600bad-d66e-4bcc-8c3b-21d74098a101",
                                                "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                                "text": "La reconnaissance d’un méfait constituerait déjà une petite victoire pour ceux et celles qui considèrent que l’homme n’a jamais pleinement payé le prix de ses frasques. Un argument fort en faveur d’un pardon réside dans son effet présumément unificateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383c1ec7-6c7f-36ce-8251-9856739787e2",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Acte criminel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c08cf9e-9237-3b1b-865d-9a253a99260a",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Dégât, conséquence négative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5783d69-0c8e-412f-b282-113b02d93624",
                                                "sense_id": "1c08cf9e-9237-3b1b-865d-9a253a99260a",
                                                "text": "Je mentionne, en passant, les méfaits du micronationalisme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méfait",
                                "target_lang_code": "fr",
