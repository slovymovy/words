                            {
                                "example_id": "d1e50b43-a6ad-4908-91f0-9c4948a8d7e7",
                                "sense_id": "fd22f84c-e3ef-33ff-9c58-a818fd450a80",
                                "text": "À l'écart du conformisme ambiant, des effarouchements pudibonds et puritains, des bouches cousues, une philosophie inlassablement et inventivement révolutionnaire."
                            }
                        ]
                    }
                ],
