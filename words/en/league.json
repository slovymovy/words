{
    "word_family": [
        "leaguer",
        "interleague"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc96ec32-b889-33f6-a730-80997639eb21",
                    "sense_definition": "An organization of sports teams which play against one another for a championship.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local football <w>league</w> starts its new season next month.",
                            "target_lang_translations": {
                                "ru": "Местная футбольная <w>лига</w> начинает новый сезон в следующем месяце."
                            }
                        },
                        {
                            "text": "He was the top scorer in the entire <w>league</w> last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году он был лучшим бомбардиром во всей <w>лиге</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "association",
                        "federation",
                        "conference"
                    ],
                    "common_phrases": [
                        "football league",
                        "major league",
                        "minor league",
                        "league table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация спортивных команд, которые соревнуются друг с другом в рамках чемпионата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "спортивная организация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae96c416-f9c8-3f9c-bc93-7727d83dd432",
                    "sense_definition": "A class or type of people or things that are evenly matched or on the same level of quality or skill.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "level_of_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When it comes to cooking, she is in a <w>league</w> of her own.",
                            "target_lang_translations": {
                                "ru": "Когда дело доходит до готовки, ей просто нет <w>равных</w>."
                            }
                        },
                        {
                            "text": "I was nervous because I felt that the other candidates were out of my <w>league</w>.",
                            "target_lang_translations": {
                                "ru": "Я нервничал, потому что чувствовал, что другие кандидаты были не моего <w>уровня</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "class",
                        "category",
                        "tier"
                    ],
                    "common_phrases": [
                        "out of your league",
                        "in a different league",
                        "in a league of one's own"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класс или категория людей или вещей, находящихся на одном уровне качества или мастерства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "качество или мастерство"
                            },
                            {
                                "target_lang_word": "категория",
                                "target_lang_sense_clarification": "класс объектов или людей"
                            },
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "переносное значение уровня мастерства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af4123a6-7d95-39fc-a865-2cc85a0dac4f",
                    "sense_definition": "A group or association of cooperating members, often for political or social purposes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>league</w> of nations was formed to maintain world peace.",
                            "target_lang_translations": {
                                "ru": "<w>Лига</w> Наций была создана для поддержания мира во всем мире."
                            }
                        },
                        {
                            "text": "Several environmental groups formed a <w>league</w> to protect the forest.",
                            "target_lang_translations": {
                                "ru": "Несколько экологических групп создали <w>союз</w> для защиты леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "alliance",
                        "coalition",
                        "union",
                        "confederacy"
                    ],
                    "common_phrases": [
                        "form a league",
                        "join a league"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или ассоциация сотрудничающих членов, часто созданная для политических или социальных целей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "общественное или политическое объединение"
                            },
                            {
                                "target_lang_word": "союз",
                                "target_lang_sense_clarification": "объединение для совместных целей"
                            },
                            {
                                "target_lang_word": "объединение",
                                "target_lang_sense_clarification": "структура из нескольких элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9e3480f-c574-354c-a929-f876c4439e6c",
                    "sense_definition": "A common short form for rugby league.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prefers watching <w>league</w> over rugby union.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает смотреть <w>регби-лиг</w>, а не классическое регби."
                            }
                        },
                        {
                            "text": "The <w>league</w> season is about to conclude with a big final.",
                            "target_lang_translations": {
                                "ru": "Сезон в <w>регби-лиг</w> вот-вот завершится большим финалом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rugby league"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in Australia and Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятое сокращенное название для регби-лиг (регби-13)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регби-лиг",
                                "target_lang_sense_clarification": "вид спорта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "321c3099-955b-37cc-8239-837e95c47405",
                    "sense_definition": "An old unit of distance, usually equal to about three miles or five kilometers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers had to walk another <w>league</w> before reaching the castle.",
                            "target_lang_translations": {
                                "ru": "Путешественникам пришлось пройти еще одну <w>лигу</w>, прежде чем они достигли замка."
                            }
                        },
                        {
                            "text": "The ship was still many <w>leagues</w> away from the shore.",
                            "target_lang_translations": {
                                "ru": "Корабль был все еще в нескольких <w>лигах</w> от берега."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seven leagues",
                        "many leagues"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная единица измерения расстояния, обычно равная примерно трем милям или пяти километрам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "английская мера длины"
                            },
                            {
                                "target_lang_word": "лье",
                                "target_lang_sense_clarification": "французская мера длины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f9ab7d8-708f-3e69-a7c8-c1245f4c2d04",
                    "sense_definition": "An administrative division in Inner Mongolia, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Xilingol <w>League</w> is known for its vast grasslands.",
                            "target_lang_translations": {
                                "ru": "<w>Аймак</w> Шилин-Гол известен своими бескрайними степями."
                            }
                        },
                        {
                            "text": "He traveled across the <w>league</w> to visit the remote village.",
                            "target_lang_translations": {
                                "ru": "Он проехал через весь <w>аймак</w>, чтобы посетить отдаленную деревню."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to Inner Mongolia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Административная единица во Внутренней Монголии, Китай (аймак)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аймак",
                                "target_lang_sense_clarification": "административная единица в Монголии и Китае"
                            },
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "калька с английского названия аймака"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c114cad-aff6-3efd-831e-48b1e4c48ee0",
                    "sense_definition": "To join together in an association or alliance for mutual support.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smaller tribes decided to <w>league</w> together against the invaders.",
                            "target_lang_translations": {
                                "ru": "Малые племена решили <w>объединиться</w> против захватчиков."
                            }
                        },
                        {
                            "text": "They <w>leagued</w> with their neighbors to improve trade in the region.",
                            "target_lang_translations": {
                                "ru": "Они <w>вступили в союз</w> с соседями, чтобы улучшить торговлю в регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "combine",
                        "ally",
                        "confederate"
                    ],
                    "common_phrases": [
                        "league together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединяться в ассоциацию или союз для взаимной поддержки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "вступать в союз"
                            },
                            {
                                "target_lang_word": "вступать в союз",
                                "target_lang_sense_clarification": "создавать альянс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a6bc7be-5a78-344b-b686-c50c4b0f336d",
                    "sense_definition": "Relating to a professional sports league, especially the top divisions of English football.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a professional <w>league</w> player with a great reputation.",
                            "target_lang_translations": {
                                "ru": "Он профессиональный <w>лиговый</w> игрок с отличной репутацией."
                            }
                        },
                        {
                            "text": "The team is hoping to secure <w>league</w> status by the end of the season.",
                            "target_lang_translations": {
                                "ru": "Команда надеется закрепить за собой <w>профессиональный</w> статус к концу сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "professional"
                    ],
                    "antonyms": [
                        "non-league"
                    ],
                    "common_phrases": [
                        "league football",
                        "league match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к профессиональной спортивной лиге, особенно к высшим дивизионам английского футбола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиговый",
                                "target_lang_sense_clarification": "относящийся к лиге"
                            },
                            {
                                "target_lang_word": "профессиональный",
                                "target_lang_sense_clarification": "о статусе команды или игрока"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "af6f88d8-589b-30eb-9997-89b4e46e52d1",
                    "sense_definition": "A shortened name for the <w>League</w> of Nations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "association",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>League</w> failed to prevent the outbreak of the second world war.",
                            "target_lang_translations": {
                                "ru": "<w>Лиге</w> не удалось предотвратить начало Второй мировой войны."
                            }
                        },
                        {
                            "text": "Historians often discuss why the <w>League</w> was unable to enforce its rules.",
                            "target_lang_translations": {
                                "ru": "Историки часто обсуждают, почему <w>Лига</w> не смогла обеспечить соблюдение своих правил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the League"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название Лиги Наций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лига",
                                "target_lang_sense_clarification": "сокращение от Лига Наций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0f9f4cf-bc04-3850-98c8-9f9a4af613c9",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>League</w> was invited to speak at the local historical society.",
                            "target_lang_translations": {
                                "ru": "Мистера <w>Лига</w> пригласили выступить в местном историческом обществе."
                            }
                        },
                        {
                            "text": "The <w>League</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Лиг</w> жила в этом городе на протяжении нескольких поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лиг",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}