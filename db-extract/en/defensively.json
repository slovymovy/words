                        "examples": [
                            {
                                "example_id": "39f4d52d-6888-4759-b537-281de0367091",
                                "sense_id": "b1fc3201-2484-323b-8c3a-a7584677b1ab",
                                "text": "This is a particularly disruptive tactic if the opponent also prefers an offensive style and has difficulty fighting defensively or counteroffensively."
                            },
                            {
                                "example_id": "a492f1a2-f863-43b9-be99-40ee60f914dd",
                                "sense_id": "b1fc3201-2484-323b-8c3a-a7584677b1ab",
                                "text": "England, defensively, were not good enough - nowhere near the standard that would be acceptable at the highest international level."
                            },
                            {
                                "example_id": "c53412cb-9686-4677-918b-7fa6b871d480",
                                "sense_id": "b1fc3201-2484-323b-8c3a-a7584677b1ab",
                                "text": "It's fine. I think I could be ... semitarian, maybe? Half vegetarian? It's a thing,' he adds, a little defensively"
                            }
                        ]
                    }
