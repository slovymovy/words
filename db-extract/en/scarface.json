                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dba8b6b5-9a40-3fc3-83d4-d6f864ac353b",
                                        "entry_id": "2385bbc6-d613-3565-a85c-f080b672a82f",
                                        "glosses": [
                                            "vernarbtes Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b94a85c-82ab-48bd-9d7a-53b55303ec2c",
                                                "sense_id": "dba8b6b5-9a40-3fc3-83d4-d6f864ac353b",
                                                "text": "„Er ist ein breitschultriger Mann, und er wäre nicht beleidigt, wenn man sagte, dass er ein Narbengesicht hat.“"
                                            },
                                            {
                                                "example_id": "0d9c651b-7d81-48cf-bd04-379bb9c28b67",
                                                "sense_id": "dba8b6b5-9a40-3fc3-83d4-d6f864ac353b",
                                                "text": "„Der Mann mit dem Narbengesicht wischte sich die Hände an seiner blauen Schürze ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d901037-67ec-3794-a6ee-b5f5c6dbd0a4",
                                        "entry_id": "2385bbc6-d613-3565-a85c-f080b672a82f",
                                        "glosses": [
                                            "jemand mit [1]"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b67ec9-4f37-4ecd-ab85-724358d90a2f",
                                                "sense_id": "7d901037-67ec-3794-a6ee-b5f5c6dbd0a4",
                                                "text": "„Von den Amerikanern erhielt er den Übernamen Scarface – Narbengesicht. Wer Bilder von Otto Skorzeny zu Gesicht bekommt, weiss sofort, warum.“"
                                            },
                                            {
                                                "example_id": "f90ceb8f-0bdb-4245-981a-07cc162bad54",
                                                "sense_id": "7d901037-67ec-3794-a6ee-b5f5c6dbd0a4",
                                                "text": "„Das Haus des Majors für das Gemüt und die Unterkunft des Narbengesichts für ein wenig albanesische Liebe waren meine einzigen Zufluchtsorte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
