                        "examples": [
                            {
                                "example_id": "1029e5db-2d1d-46a8-b120-08534df93e64",
                                "sense_id": "6487b856-935b-3dfa-8d34-a9a6fc936bae",
                                "text": "L’abbé en surplis dans sa chaise de bois, à droite de l’autel, ballottait deci-delà, avait grand’peine à garder une carrure digne, humant un air d’étuve qui l’alangourait."
                            },
                            {
                                "example_id": "3099abe6-e990-46e4-944d-5466c78442e8",
                                "sense_id": "6487b856-935b-3dfa-8d34-a9a6fc936bae",
                                "text": "Le seigneur de Thorncaer ne laissait pas les corps s’alangourer ni les esprits otieux."
                            }
                        ]
                    }
