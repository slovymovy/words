                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3cd33d9a-fa37-4db1-9539-5bedfdebc2cd",
                        "entry_id": "f391b621-5804-36e8-b675-30bf5d3eac86",
