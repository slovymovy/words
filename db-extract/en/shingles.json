                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0951108-2283-3c83-849a-6bd656ff7c86",
                                        "entry_id": "3372332d-9675-3fa5-9be2-e71f40f26a47",
                                        "glosses": [
                                            "Éruption vésiculeuse en grappe qui se développe habituellement sur le trajet d’un réseau nerveux et qui affecte une seule moitié du corps, due à une réactivation du virus varicelle-zona (ou VZV) de la famille des Herpesviridae, et qui survient souvent plusieurs dizaines d’années après avoir contracté la varicelle."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1799c9d7-c9fc-44aa-849e-da21a75f9753",
                                                "sense_id": "b0951108-2283-3c83-849a-6bd656ff7c86",
                                                "text": "Il avait guéri son propre père d’un zona qui menaçait de faire complètement le tour de son ventre, et chacun sait que la mort est au bout de la boucle."
                                            },
                                            {
                                                "example_id": "fad87772-a340-4a25-951e-e30d5afd0e53",
                                                "sense_id": "b0951108-2283-3c83-849a-6bd656ff7c86",
                                                "text": "Outre les 11 vaccins obligatoires pour les bébés et les enfants, la vaccination contre le BCG, le papillomavirus humain, la grippe et le zona est ainsi recommandée en France."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zona",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c51ba4e-d9f9-328e-9a73-3aacaa815ade",
                                        "entry_id": "48ec4ecb-073b-3b6c-a0ab-aae9c4bc6435",
                                        "glosses": [
                                            "Ceinture large portée au-dessus des hanches dans l’Antiquité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46bd23a4-2e4c-45fa-a82e-03d7d9ae1d60",
                                                "sense_id": "6c51ba4e-d9f9-328e-9a73-3aacaa815ade",
                                                "text": "En général les Gaulois portaient une zona, c'est à dire une haute ceinture en métal faite de forts anneaux entrelacés ou de plaques de bronze."
                                            },
                                            {
                                                "example_id": "e60fbdd7-bf73-4e2f-84ad-61f0ffb43f53",
                                                "sense_id": "6c51ba4e-d9f9-328e-9a73-3aacaa815ade",
                                                "text": "Une zona désignait une ceinture large que portaient au-dessus des hanches les jeunes filles, par opposition au cingulum ou ceinture ordinaire qui était placée au-dessous du sein."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zona",
