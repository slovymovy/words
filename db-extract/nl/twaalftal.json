                "senses": [
                    {
                        "sense_id": "c57e4617-478a-3d97-93b8-6de387333028",
                        "entry_id": "39791ed7-7bd1-3d45-9a08-67da4df506d6",
                        "glosses": [
                            "een groep van twaalf stuks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26320ad-f3b2-4381-927e-12f1e7b355a6",
                                "sense_id": "c57e4617-478a-3d97-93b8-6de387333028",
                                "text": "Een grote topfavoriet is er niet, ik zie een twaalftal kanshebbers. Waaronder Tiesj."
                            },
                            {
                                "example_id": "b868588d-68d9-4ae4-abd7-a71eb1895613",
                                "sense_id": "c57e4617-478a-3d97-93b8-6de387333028",
                                "text": "De bedoeling was om een gerenommeerd internationaal studiebureau aan te stellen. Een eerste poging mislukte. Er meldde zich maar één bureau aan, maar dat bleek eerder gewerkt te hebben voor het Brussels Gewest en Brussels Airport, en werd dus afgewezen. De minister trok er daarop zelf op uit en polste bij een twaalftal studiebureaus in binnen- en buitenland. Drie daarvan reageerden positief, antwoordde de minister eind februari op vragen in de Kamercommissie Infrastructuur. Er werd een officiële procedure opgestart, waarna het studiebureau eind maart, begin april gekozen zou worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "330c6b10-0ac7-4873-be47-e9363b269c47",
                        "source_entry_id": "39791ed7-7bd1-3d45-9a08-67da4df506d6",
                        "source_sense_id": "c57e4617-478a-3d97-93b8-6de387333028",
                        "target_lang_word": "dozen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dozen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "A set of twelve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d565ffda-e991-4d14-95a0-7ddcff6374b1",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Can I have a dozen eggs, please?"
                                            },
                                            {
                                                "example_id": "803e1c89-0235-4787-9338-95e02c637178",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "I ordered two dozen doughnuts."
                                            },
                                            {
                                                "example_id": "e61c9211-8e48-46df-825f-d3324ddf1138",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "There are hundreds of people from each continent in the convention but only a few dozen came from Africa."
                                            },
                                            {
                                                "example_id": "be2c953c-426e-40e5-88e5-0fb5f1444164",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Pack the shirts in dozens, please."
                                            },
                                            {
                                                "example_id": "df72d67f-abcc-4982-936d-3e30937fe511",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Almost three dozen US service members were diagnosed with traumatic brain injuries after the Iranian missile attack earlier this month, the Pentagon said Friday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "A large, unspecified number of, comfortably estimated in small multiples of twelve, thus generally implied to be significantly more than ten or twelve, but less than perhaps one or two hundred; many."
                                        ],
                                        "tags": [
                                            "as plural only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3112f49-d79d-4833-b132-e9c169dc13c1",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "There must have been dozens of examples just on the first page."
                                            },
                                            {
                                                "example_id": "979ea899-90aa-4ba9-bcfa-428415627e6b",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "There were dozens and dozens of applicants before the job was posted."
                                            },
                                            {
                                                "example_id": "93bb9652-b433-4974-b70e-5c03ba7649a1",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            },
                                            {
                                                "example_id": "bcd194d1-f9a2-40b0-a7b1-cb7eff921f09",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "Jessalyn, known to her family as Jessa, was one of the dozens who were hit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145d62a1-866d-3415-b0d7-fcee7bd8130e",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "An old English measure of ore containing 12 hundredweight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa403156-1c0a-44c2-b978-7108bd2b3e28",
                                                "sense_id": "145d62a1-866d-3415-b0d7-fcee7bd8130e",
                                                "text": "The dozen as a measure for iron ore remained almost completely constant at 12 cwts. during the sixteenth and seventeenth centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3b5ed7-7bb6-3ff3-a03b-0cf0d92dc052",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "The number twelve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ba32175-3487-4577-8025-3d48d7ef17ce",
                        "source_entry_id": "39791ed7-7bd1-3d45-9a08-67da4df506d6",
                        "source_sense_id": "c57e4617-478a-3d97-93b8-6de387333028",
                        "target_lang_word": "douzaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douzaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                        "entry_id": "ce7ae3be-47d2-3057-be3b-9fde7eca56ca",
                                        "glosses": [
                                            "Douze ou à peu près douze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3be2c6-3f12-4c3c-8d35-2b64e7e027fb",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "— M’apportes-tu seulement douze douzaines de messes à un écu chacune, ou garderas-tu toujours pour toi seul l’or que te versent à flots tes dévotes de province, vieux pingre ?"
                                            },
                                            {
                                                "example_id": "eece312e-7a2d-4274-baa0-4def54119204",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "La douzaine d’otages est prête : il y en a même treize. Rien que des domestiques stylés de la guerre et tout enfant qui crie quand le canon tonne est giflé."
                                            },
                                            {
                                                "example_id": "604ef9a0-a642-4cd3-ad29-a0a32316fb49",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "A une douzaine de kilomètres en aval de Combloux, […], on note un replat où affleurent quelques blocs erratiques granitiques."
                                            },
                                            {
                                                "example_id": "838777f6-bc3d-4978-be96-e1d9027dd7cb",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "La bourgeoisie devait être nombreuse à Auvillar, écrit le docteur Labat, puisque, sous la Restauration, on y comptait une douzaine de chevaliers de Saint-Louis."
                                            },
                                            {
                                                "example_id": "231fc2f2-1fd4-481e-ba23-304e1e2417e1",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "Les deux hommes consultèrent la carte : il commandèrent chacun une douzaine d’escargots qu’ils arrosèrent de muscadet."
                                            },
                                            {
                                                "example_id": "bcb46ebb-4c3e-4f20-bcd1-6d8a6b8528ef",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "Le nouveau campement est établi à une douzaine de kilomètres de l’ancien, dans une plaine ondulée et verdoyante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfc017b-a2cb-3914-93b2-ebdf094edc12",
                                        "entry_id": "ce7ae3be-47d2-3057-be3b-9fde7eca56ca",
                                        "glosses": [
                                            "Nombre indéterminé, mais qui n’est pas considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e55dd2-bc8b-4bb0-b0e8-c66533f7a9bd",
                                                "sense_id": "6cfc017b-a2cb-3914-93b2-ebdf094edc12",
                                                "text": "Friand de la lame il s’est, sous la Restauration, aligné, une douzaine de fois, au côtés des « brigands de la Loire » en face des gentilshommes royalistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
