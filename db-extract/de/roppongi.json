                    {
                        "sense_id": "845c98ed-a82c-3d15-9a25-d92c741168d1",
                        "entry_id": "2b7cbb84-c38c-3b3b-8e7d-9694c21ae977",
                        "glosses": [
                            "Teil des Bezirks Minato in der Präfektur Tokio"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0a7287-b6cf-418c-8cd8-fd5da6dfacb5",
                                "sense_id": "845c98ed-a82c-3d15-9a25-d92c741168d1",
                                "text": "„Sie und Louise gingen nach Roppongi, einem bekannten Treffpunkt für Ausländer und solche Japaner, die gerne Ausländer kennenlernen wollen.“"
                            },
                            {
                                "example_id": "cadb987d-a05c-4709-8ff3-82967c88ff40",
                                "sense_id": "845c98ed-a82c-3d15-9a25-d92c741168d1",
                                "text": "„Und er wusste, wie Edith an ihrem Freundeskreis in der amerikanischen Gemeinde in Roppongi hing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
