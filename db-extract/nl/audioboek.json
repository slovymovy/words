                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                        "entry_id": "74efd1b6-32f9-3d89-adba-ae9f209d4f03",
                                        "glosses": [
                                            "von einem Sprecher vertontes und auf einem Speichermedium gespeichertes Buch (= Lesung), Hörspiel oder Feature, das auf Kassette oder CD publiziert wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43b180e-12dc-4366-a1d2-61723a4370b3",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "Melchior Schedler's Hörspiel \"Cordoba oder die Kunst des Badens\" ist auch als Hörbuch erhältlich."
                                            },
                                            {
                                                "example_id": "ac785493-02e5-4d66-b403-dd3b65892467",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "Mit Hörbuchern kann man akustisch auf Reisen gehen.http://www.zeit.de/2011/17/Reisen-Hoerbuecher"
                                            },
                                            {
                                                "example_id": "f9808eaa-f5d9-4c27-be01-b78653c6ab01",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "„Einmal bin ich um die Insel gefahren, mit meiner Freundin im Auto, und wir haben Hörbücher gehört.“"
                                            },
                                            {
                                                "example_id": "9f8215d4-b547-4a8b-980f-f763dba94909",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "„Allabendlich – der Kontrast hätte nicht größer sein können – schlief meine kleine Tochter zu Hörbüchern über die griechische Mythologie ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
