                        "entry_id": "64b97960-fee6-32d7-912e-897924044bde",
                        "glosses": [
                            "Iberia (a peninsula and region of Europe south of the Pyrenees, consisting of Andorra, Spain, Portugal, and Gibraltar)"
                        ],
