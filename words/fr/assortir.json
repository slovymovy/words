    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5026dbd2-a0c0-3ce1-a57e-b0616dbc17c8",
                    "sense_definition": "Mettre ensemble des choses qui vont bien ensemble, en particulier par la couleur, la forme ou le style.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "harmonie_choses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle prend toujours le temps d'<w>assortir</w> ses chaussures à son sac à main."
                        },
                        {
                            "text": "Pour son mariage, il a voulu <w>assortir</w> sa cravate avec la couleur de son costume."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "harmoniser",
                        "marier"
                    ],
                    "antonyms": [
                        "désassortir"
                    ],
                    "common_phrases": [
                        "assortir les couleurs",
                        "assortir ses vêtements"
                    ]
                },
                {
                    "sense_id": "a0243ba7-0e7e-3f1e-9ca6-3dfc3315cdcb",
                    "sense_definition": "Être en harmonie avec un autre élément, convenir esthétiquement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "harmonie_choses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette écharpe bleue s'<w>assortit</w> parfaitement à ton manteau d'hiver."
                        },
                        {
                            "text": "Les rideaux du salon s'<w>assortissent</w> très bien avec la couleur des murs."
                        }
                    ],
                    "synonyms": [
                        "convenir",
                        "s'accorder"
                    ],
                    "common_phrases": [
                        "s'assortir à",
                        "s'assortir avec"
                    ]
                },
                {
                    "sense_id": "ee043f19-0475-385f-ab87-bc98d1af8e39",
                    "sense_definition": "Réunir ou faire correspondre des personnes dont l'humeur ou le caractère s'accordent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harmonie_personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôte a fait de son mieux pour <w>assortir</w> les invités autour de la table."
                        },
                        {
                            "text": "Leurs tempéraments calmes semblaient les <w>assortir</w> dès leur première rencontre."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "marier"
                    ],
                    "common_phrases": [
                        "assortir des convives"
                    ]
                },
                {
                    "sense_id": "a5a08ad0-eb91-3aee-b5b9-21bf801af554",
                    "sense_definition": "Pourvoir un magasin, un commerce ou une personne de tout ce qui est nécessaire et diversifié.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "approvisionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant a dû <w>assortir</w> sa boutique avant l'ouverture de la saison touristique."
                        },
                        {
                            "text": "Ce nouveau libraire veille à bien <w>assortir</w> ses rayons pour satisfaire les lecteurs."
                        }
                    ],
                    "synonyms": [
                        "approvisionner",
                        "fournir",
                        "garnir"
                    ],
                    "common_phrases": [
                        "assortir un magasin",
                        "assortir une boutique"
                    ]
                }
            ]
        }
    ]
