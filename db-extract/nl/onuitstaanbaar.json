                "senses": [
                    {
                        "sense_id": "1331e485-ec15-3b07-9b3e-76270f548619",
                        "entry_id": "9ed9d159-3f24-3d69-aa07-3497040cd97a",
                        "glosses": [
                            "zo vervelend dat je er niet bij in de buurt kunt blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b957917b-b6e8-4c70-88f0-d121e167e7ce",
                                "sense_id": "1331e485-ec15-3b07-9b3e-76270f548619",
                                "text": "Hij is een onuitstaanbare jongen die altijd de meisjes lastig valt."
                            },
                            {
                                "example_id": "e680ac8b-2a1e-40ea-868a-21a90a84f43c",
                                "sense_id": "1331e485-ec15-3b07-9b3e-76270f548619",
                                "text": "Zoals hij zichzelf herinnerde uit die tijd, iets wat hij niet graag deed, moest hij ondraaglijk zelfverzekerd zijn geweest, verbaal sterk, gewend om alle discussies te winnen, kortom onuitstaanbaar."
                            }
                        ]
                    }
                ],
