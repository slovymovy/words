                "senses": [
                    {
                        "sense_id": "2fceb9cb-b6f5-3d28-95a1-80939c300d77",
                        "entry_id": "580cf799-0d07-3ece-8003-b41dfeea9706",
                        "glosses": [
                            "metalen werktuig voor hakken in steen of aarde met een beitelvormig uiteinde en een puntvormig uiteinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf04139-195c-415e-a16c-3b8eb765b5ab",
                                "sense_id": "2fceb9cb-b6f5-3d28-95a1-80939c300d77",
                                "text": "- Eerder had ik me al afgevraagd wat het embleem betekent dat in de gevel van het huis gebeiteld is, hamer en houweel met gekruiste stelen, anno 1908. Ik zoek rond, op de elektriciteitskast tussen de struiken staat: TEUTONIA."
                            },
                            {
                                "example_id": "0748a7f1-1aa3-4ffd-9dd0-a5d0c8df2284",
                                "sense_id": "2fceb9cb-b6f5-3d28-95a1-80939c300d77",
                                "text": "- Op het Rode Plein ben ik niet geweest. Lenin heb ik niet gezien. Ik werk alleen maar! Met schop, houweel en kruiwagen. Ik druip de hele dag, als een watermeloen."
                            }
                        ]
                    },
