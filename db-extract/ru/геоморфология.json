                "senses": [
                    {
                        "sense_id": "940e8ab2-38e3-34e4-b7fc-8ec6a1eff62e",
                        "entry_id": "089fb203-9b77-3c4f-895d-0c91ad39f539",
                        "glosses": [
                            "наука о рельефе суши, дна океанов и морей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad314ade-7730-40a6-a1c2-42318412da3e",
                                "sense_id": "940e8ab2-38e3-34e4-b7fc-8ec6a1eff62e",
                                "text": "Геоморфология ― наука о структурах земной поверхности ― дает огромное богатство образных возможностей."
                            },
                            {
                                "example_id": "f1dd22fb-c047-49e5-9ead-46edf8510b46",
                                "sense_id": "940e8ab2-38e3-34e4-b7fc-8ec6a1eff62e",
                                "text": "Образование такой обширной плоской равнины ― своего рода загадка геологической истории, причуда геоморфологии."
                            }
                        ]
                    }
                ],
