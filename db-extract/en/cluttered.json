                        "target_lang_word": "encombré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encombré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52914ab2-4161-31ea-8f72-809e9d392e04",
                                        "entry_id": "bc9b1840-84d0-32a1-b76a-be07963e2bf6",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe encombrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08c97f9-9b98-4515-b839-286be895cd2e",
                                                "sense_id": "52914ab2-4161-31ea-8f72-809e9d392e04",
                                                "text": "Ces messieurs passèrent devant la façade de la Madeleine, en causant, à bâtons rompus, comme on peut causer sur une voie publique, encombrée de promeneurs."
                                            },
                                            {
                                                "example_id": "829eec70-62ac-4986-abbb-6a625fa5b01c",
                                                "sense_id": "52914ab2-4161-31ea-8f72-809e9d392e04",
                                                "text": "Je ne traverse pas si la route juste devant moi est encombrée. Les rails ne doivent être franchis que si la voie routière en face est dégagée. Je ne m’arrête jamais sur la voie ferrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77f1b0b6-023d-430f-aa38-c43206a007aa",
                        "source_entry_id": "69a0871b-bde4-32b1-ae10-0c6894f15b4d",
                        "source_sense_id": "92f3894d-f3cc-3fa2-b270-749312832c17",
                        "source_sense_description": "scattered with a disorderly mixture of objects",
                        "target_lang_word": "unaufgeräumt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaufgeräumt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89e4834a-5a5b-390f-b935-5a80dfcf111f",
                                        "entry_id": "647193f9-45f3-3c64-909e-b1bfe94fdb3c",
                                        "glosses": [
                                            "nicht ordentlich/übersichtlich, Bestandteile nicht an ihrem Platz; nicht ordentlich wie eigentlich zu erwarteten/wie es sich gehört"
                                        ],
                                        "tags": [
                                            "von Orten",
                                            "oft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27cc7da3-5573-40ce-b06d-72f030f8073c",
                                                "sense_id": "89e4834a-5a5b-390f-b935-5a80dfcf111f",
                                                "text": "„Wie kommt es denn dazu, dass Ihr Arbeitsplatz unaufgeräumt bleibt? (Azubi erläutert, dass er seinen Bus nach Feierabend pünktlich erreichen will.)“"
                                            },
                                            {
                                                "example_id": "bc448365-59d5-47c5-b95d-09fbd8404a7d",
                                                "sense_id": "89e4834a-5a5b-390f-b935-5a80dfcf111f",
                                                "text": "„Žižkov ist deutlich unaufgeräumter als das gutbürgerliche Vinohrady in meinem Rücken, der Straßenbeleg bröckelt, hin und wieder sieht man ein Haus mit rausgerissenen oder zugemauerten Fenstern und Türen …“"
                                            },
                                            {
                                                "example_id": "9167954d-2fc0-4598-91f3-a8c883cb9037",
                                                "sense_id": "89e4834a-5a5b-390f-b935-5a80dfcf111f",
                                                "text": "„Diese Wohnung, in die er gerade blickte, war die unaufgeräumteste Wohnung, die er je erlebt hatte. Die Bewohner mussten schier hüfttief durch den Sumpf an Spielsachen waten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ab528f6-4a5b-42ad-9cf8-dedb1e1c2555",
                        "source_entry_id": "69a0871b-bde4-32b1-ae10-0c6894f15b4d",
                        "source_sense_id": "92f3894d-f3cc-3fa2-b270-749312832c17",
                        "source_sense_description": "scattered with a disorderly mixture of objects",
                        "target_lang_word": "überladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a225ebac-d37b-3978-8055-47a3420a58cd",
                                        "entry_id": "6dd27459-24f0-3c1d-8b35-91cb3d9e16db",
                                        "glosses": [
                                            "etwas übermäßig mit Fracht versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6da735-a07d-4a32-8fb3-e8b2e38ebb87",
                                                "sense_id": "a225ebac-d37b-3978-8055-47a3420a58cd",
                                                "text": "„Flugkoffer sollten nicht überladen werden, um Schlösser und Handgriffe nicht über die Maßen zu strapazieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3aa9d706-0a3b-35a4-b123-a9784c654dfa",
                                        "entry_id": "6dd27459-24f0-3c1d-8b35-91cb3d9e16db",
                                        "glosses": [
                                            "etwas übermäßig mit elektrischer Energie aufladen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f57939-e96c-4aeb-b9aa-14db777db0a1",
                                                "sense_id": "3aa9d706-0a3b-35a4-b123-a9784c654dfa",
                                                "text": "„Es kam lediglich darauf an, den Akku nicht zu überladen und nicht zu tief zu entladen, denn das verkürzt die Lebensdauer der Energiespeicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                        "entry_id": "6dd27459-24f0-3c1d-8b35-91cb3d9e16db",
                                        "glosses": [
                                            "den gleichen Namen (Bezeichner) für mehrere Funktionen oder Methoden verwenden"
                                        ],
                                        "tags": [
                                            "Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d44398-9c3e-4815-9eb2-758e564b04d9",
                                                "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                                "text": "„Bei Python können Operatoren und Standardfunktionen überladen werden, indem man bei einer neuen Klasse bestimmte Methoden mit vorgegebenen Namen definiert.“"
                                            },
                                            {
                                                "example_id": "40fa51aa-2aeb-40ad-b8ba-7e6e8ed68299",
                                                "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                                "text": "„Die Klasse Konto wird um die Methode Buchen erweitert, die nicht einmal, sondern zweimal vorkommt und damit überladen wird.“"
                                            },
                                            {
                                                "example_id": "1894fcbc-71c7-4c57-853e-0b0bd9add0c0",
                                                "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                                "text": "„Alternativ kann die Methode auch überladen werden, so dass die Ausgabe auf der Konsole und in eine Datei erfolgen kann.“"
                                            },
                                            {
                                                "example_id": "5f36fe92-9218-4fd6-8827-4ef4c49a232e",
                                                "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                                "text": "„In PHP 5 kann fast jeder Aspekt der Objektsyntax durch in C geschriebene Erweiterungen überladen werden.“"
                                            },
                                            {
                                                "example_id": "c372c93b-f78e-428b-a0e0-202fa860b56f",
                                                "sense_id": "228ba25a-db4f-3572-9928-be84fcdeb47c",
                                                "text": "„Es ist zwar möglich, die globalen Operatoren new und delete zu überladen, aber davon ist abzuraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
