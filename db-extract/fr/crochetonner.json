                "senses": [
                    {
                        "sense_id": "bca1fbf7-b38d-31cb-9fb8-4587162ac989",
                        "entry_id": "eab9276b-237c-3a2a-8067-99a68485d894",
                        "glosses": [
                            "Accrocher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f7c474-adbb-48d5-9ef1-c495f8586bb7",
                                "sense_id": "bca1fbf7-b38d-31cb-9fb8-4587162ac989",
                                "text": "Sur ce terreau j’ai couché et crochetonné, suivant le mot des jardiniers, tout le bois d’un an de mes souches, c’est-à-dire qu’à l’aide de tuteurs crochus je l’ai appliqué et fait tenir au ras du sol, le plus fortement possible, marquant chaque œil d’un tuteur droit."
                            },
                            {
                                "example_id": "8b54e889-0926-43e5-8491-073e4bf56504",
                                "sense_id": "bca1fbf7-b38d-31cb-9fb8-4587162ac989",
                                "text": "Les deux jours suivants, ils avaient charpenté un vaste abri de toile, crochetonné à des poutrelles."
                            }
                        ]
                    }
                ],
