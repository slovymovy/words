                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>schulde</w> dir noch zwanzig Euro für das gemeinsame Abendessen."
                        },
                        {
                            "text": "Er <w>schuldete</w> seinem Vermieter die Miete für den letzten Monat."
                        }
                    ],
                    "antonyms": [
