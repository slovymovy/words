                        "sense_id": "f70a08a2-f45e-30e5-b230-a02e794c5cd8",
                        "entry_id": "5e6c2c5d-ecb1-3e5a-a937-d04d94820120",
                        "glosses": [
                            "Maladie cutanée contagieuse de l’homme et de nombreux animaux avec des suintements, des nodules, puis de grandes croûtes contenant des bactéries gram positives de l’espèce Dermatophilus congolensis."
                        ],
                        "tags": [
                            "Médecine vétérinaire",
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "592c6973-a0e1-4624-a797-6233ce69cd06",
                                "sense_id": "f70a08a2-f45e-30e5-b230-a02e794c5cd8",
                                "text": "La dermatophilose est une maladie qui sévit en Asie et en Afrique. De forme généralement bénigne, elle est en revanche souvent grave en Afrique centrale et occidentale, en Zambie et à Madagascar. Ce sont les bœufs qui sont le plus fréquemment atteints. Les chèvres, les moutons et les chevaux ne le sont qu’occasionnellement."
                            }
                        ]
                    }
