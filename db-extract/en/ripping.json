                    {
                        "sense_id": "4d670cbb-c6a8-3e99-a9e9-3b7ac825d42c",
                        "entry_id": "4b6fa3b0-9749-3646-9bae-4522c732c09d",
                        "glosses": [
                            "That rips, or can be removed by ripping."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                        "entry_id": "4b6fa3b0-9749-3646-9bae-4522c732c09d",
                        "glosses": [
                            "Excellent."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6617d7f5-92f8-4c16-a31a-3326f16adcde",
                                "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                                "text": "“First-class place, Simla. Oh, ri—ipping!” said Bobby Wick, and ordered new white cord breeches on the strength of it."
                            },
                            {
                                "example_id": "79c688a6-92f9-4c2e-8373-f75753a2f5b8",
                                "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                                "text": "We never had a Christmas in the country before. It was simply ripping."
                            },
                            {
                                "example_id": "8bf6ef3f-f73f-46a2-835f-07de615308cd",
                                "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                                "text": "“Certainly, I quite understand, my dear fellow,” Tennington had replied. “But you are to be congratulated—ripping girl, don’t you know—really.”"
                            },
                            {
                                "example_id": "7bfe070e-ec8c-4289-b7a0-f8775533797b",
                                "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                                "text": "And ‘blubbing’ . . . Blubbing went out with ‘decent’ and ‘ripping’. Mind you, not a bad new language to start up. 1920s schoolboy slang could be due for a revival."
                            },
                            {
                                "example_id": "d1cd15f2-fca3-4693-ae87-35c3e79fd4b7",
                                "sense_id": "33333ced-b669-3da2-9785-ae9154066c20",
                                "text": "After Sir John Hall came Freddy Shepherd, and after him came Mike Ashley, who thought that tipping up to games in one of the replica shirts he flogs at Lillywhite's was a ripping wheeze."
                            }
                        ]
                    }
