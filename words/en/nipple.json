{
    "word_family": [
        "nipple"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eef6ae2d-1943-3108-be13-3d15b59432f9",
                    "sense_definition": "The small projection on the breast from which milk is secreted.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother gently cleaned the <w>nipple</w> before starting to breastfeed her baby.",
                            "target_lang_translations": {
                                "zh": "母亲在开始给婴儿喂奶前轻轻地清洁了<w>乳头</w>。"
                            }
                        },
                        {
                            "text": "She felt a sharp pain in her <w>nipple</w> during the feeding session.",
                            "target_lang_translations": {
                                "zh": "她在喂奶过程中感到<w>乳头</w>一阵剧痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teat"
                    ],
                    "target_lang_definitions": {
                        "zh": "哺乳动物乳房上分泌乳汁的突起部位。"
                    },
