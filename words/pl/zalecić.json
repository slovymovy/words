                    "frequency": "Middle",
                    "semantic_group_id": "doradzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprzedawca w sklepie tak przekonująco <w>zalecił</w> mi nowy model telefonu, że od razu go kupiłem.",
                            "target_lang_translations": {
                                "ru": "Продавец в магазине так убедительно <w>расхвалил</w> мне новую модель телефона, что я сразу её купил."
                            }
                        },
                        {
                            "text": "Znajomy mechanik <w>zalecił</w> tę markę samochodu jako wyjątkowo oszczędną i bezpieczną.",
                            "target_lang_translations": {
                                "ru": "Знакомый механик <w>порекомендовал</w> эту марку автомобиля как исключительно экономичную и безопасную."
                            }
                        }
                    ],
                    "synonyms": [
