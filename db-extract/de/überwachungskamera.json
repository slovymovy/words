                                        "sense_id": "d6353ff5-d931-3b00-bbd7-cdfc737588a4",
                                        "entry_id": "c2f2aeb5-9461-3d7b-a72f-16790ee1cef4",
                                        "glosses": [
                                            "Synonym of security camera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2992318e-3fc9-303e-b933-160a2ca46ce1",
                                        "entry_id": "c2f2aeb5-9461-3d7b-a72f-16790ee1cef4",
                                        "glosses": [
                                            "Synonym of surveillance camera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c99d76-ee68-4814-bae9-d6b3ac5ec38d",
                                                "sense_id": "2992318e-3fc9-303e-b933-160a2ca46ce1",
                                                "text": "Hong Kong has more than 54,500 public CCTV cameras used by government bodies – about seven cameras per 1,000 people, according to an estimate by Comparitech, a UK-based technology research firm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deda2ddb-9dc2-4d9b-90ba-fbc57ceb2a93",
                        "source_entry_id": "f8cf42d9-91f6-36d4-a953-04fbb7bbcb2e",
                        "source_sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                        "source_sense_description": "Kamera zur Überwachung",
                        "target_lang_word": "surveillance camera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surveillance camera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "641b5694-45d6-3398-a6d6-580cf49b2f6d",
                                        "entry_id": "6c9e09c2-14f5-3e65-8905-716e9a083598",
                                        "glosses": [
                                            "A mounted video camera used for the purpose of surveillance, as part of closed-circuit television."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f4a890-e7d4-4510-b5ea-22d0eb26606e",
                                                "sense_id": "641b5694-45d6-3398-a6d6-580cf49b2f6d",
                                                "text": "Coldly perusing his surveillance cameras one day, Mr. Burns spies nothing but grotesque misconduct: Instead of working, his employees engage in limbo contests, chess games, and, of course, cockfights."
                                            },
                                            {
                                                "example_id": "0672bfd3-0bad-4ef7-a363-48279050cfb1",
                                                "sense_id": "641b5694-45d6-3398-a6d6-580cf49b2f6d",
                                                "text": "A reported 200m surveillance cameras around the country are doing everything from tracking shoppers in stores to preventing violent crime to catching jaywalkers."
                                            },
                                            {
                                                "example_id": "9d7ea31d-0c3e-4d01-a010-5f5ec2177623",
                                                "sense_id": "641b5694-45d6-3398-a6d6-580cf49b2f6d",
                                                "text": "Glance up while strolling through parts of downtown Hong Kong and, chances are, you’ll notice the glassy black lens of a surveillance camera trained on the city’s crowded streets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
