                ],
                "senses": [
                    {
                        "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                        "entry_id": "b999c4dd-d51d-3678-841d-3094d8d44780",
                        "glosses": [
                            "Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27455944-89c8-462f-b354-65fe178700d6",
                                "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                                "text": "„Sie liessen sich nahe am Fluss Chortitza nieder, der in den grossen Dnjeprfluss mündet.“"
                            },
                            {
                                "example_id": "0f200f37-6ac9-465b-893e-c5d98bf2ac46",
                                "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                                "text": "„Die Kämpfer durchschwammen den Dnjeprfluss.“"
                            },
                            {
                                "example_id": "66a815d8-e63d-4311-bf44-0920661e5746",
                                "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                                "text": "„Bei seiner Geburt war die Natur in Aufruhr, ein Untier, Skimen geheissen, kam mit einem ganzen Rudel anderer Bestien ins Land gelaufen, der Dnjeprfluss trat vor Schreck über seine Ufer.“"
                            },
                            {
                                "example_id": "1e029cdd-91f9-47f2-a7ec-475efd78cdc7",
                                "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                                "text": "„Margaretha Unger nahm Anteil an der Gründung der MBG, sie ließ sich 1862 von den ersten Mennoniten im Dnjeprfluss taufen, obwohl sie damals schon 67 Jahre alt war […].“"
                            },
                            {
                                "example_id": "f7e73935-eeae-44b5-bdfa-59051fc26367",
                                "sense_id": "c1c8b8f9-b6c3-3ff7-8fef-bb3166061013",
                                "text": "„Diese liegen sowohl östlich wie westlich von Nikopol am Dnjeprflusse, und zwar das westliche Vorkommen zwischen einem Nebenfluß des Dnjepr, dem Tschertomlyk, und einem Nebenflusse des Basaluk, dem Solenaja.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
