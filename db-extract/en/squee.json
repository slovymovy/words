                "word_linkages": []
            },
            {
                "entry_id": "6587412d-1ef2-3cde-9892-093a5de37c18",
                "word": "squee",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6896bfe9-85c7-44fd-8120-95734c8af415",
                        "entry_id": "6587412d-1ef2-3cde-9892-093a5de37c18",
                        "tags": [
                            "plural"
                        ],
