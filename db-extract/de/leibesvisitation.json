                    {
                        "form_id": "22248af4-6efb-41af-87b5-44ae30b34400",
                        "entry_id": "dddc4698-e9d0-39e1-a4dd-14eed09cf28f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Leibesvisitationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                        "entry_id": "dddc4698-e9d0-39e1-a4dd-14eed09cf28f",
                        "glosses": [
                            "(zumeist von einem oder mehreren Angehörigen der Polizei, des Zolls, der Ordnungsbehörden, des Militärs oder dergleichen vorgenommene) Handlung, bei der die am Körper getragene Kleidung einer Person (auf Drogen, Waffen und dergleichen) durchsucht sowie, im Verdachtsfall, der gesamte Körper/Körperöffnungen (nach Drogen und dergleichen) untersucht werden"
                        ],
                        "tags": [
                            "amtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5c665b-ebcd-4dc9-bc79-4944f2861e39",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Darüber hinaus muß der Häftling aus Sicherheitsgründen regelmäßige Leibesvisitationen über sich ergehen lassen (Artikel D. 275 der französischen Strafprozeßordnung). In den meisten europäischen Ländern hat sich der Häftling bei dieser Prozedur auszuziehen. In manchen Ländern, darunter Großbritannien, Bulgarien, Dänemark, Ungarn und Irland, wird die medizinische Leibesvisitation praktiziert, die sich auch auf die Körperöffnungen erstreckt.“"
                            },
                            {
                                "example_id": "c642c1f3-ab99-49c4-80e2-fe8b22a394b2",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Der erstbeste Jugendliche wird mit ‚Hände hoch‘ angebrüllt und einer Leibesvisitation unterzogen, bevor ihn der Sergeant mit Bedauern wieder ziehen lässt.“"
                            },
                            {
                                "example_id": "70177018-0837-4260-a44d-013a4c53d83f",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Sie habe sich mehrmals einer Leibesvisitation unterziehen müssen.“"
                            },
                            {
                                "example_id": "6db2930e-1dea-4e2e-b97b-95372b1c769f",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Die Regierung müsse gewaltsame Leibesvisitationen und Einzelhaft für Minderjährige beenden und die Strafmündigkeit heraufsetzen, forderte Hammarberg in einem am Freitag veröffentlichten Bericht.“"
                            },
                            {
                                "example_id": "2e44847b-74cc-4287-a709-750b8322b887",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Dann gab es gründlichere Leibesvisitationen bei der Ankunft in einem Stadtgefängnis, vor der Verlegung in eine Bezirkshaftanstalt und schliesslich beim Eintreffen dort.“"
                            },
                            {
                                "example_id": "89b19b4c-6427-4382-bbfb-3e6a9f2fd955",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Bei einer Leibesvisitation fand eine Zollbeamtin die Drogen.“"
                            },
                            {
                                "example_id": "f477f440-9468-45f5-a6ab-211b5b6659b2",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„In den USA hat der Protest eines Flugreisenden gegen die intensiven Kontrollen eine Diskussion über Nacktscanner und Leibesvisitationen an Flughäfen ausgelöst.“"
                            },
                            {
                                "example_id": "af5b2c71-830d-4aa6-8ae9-07f5a969c058",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„An den Zugängen zum Platz wurden sie von Soldaten einer Leibesvisitation unterzogen, eine Gruppe von Protestierenden führte eine zweite Durchsuchung durch.“"
                            },
                            {
                                "example_id": "7dc8df78-238c-46b8-b53c-f9b42289be94",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Er verzichtet auf eine explizite Stellungnahme und lässt die Bilder für sich sprechen: ein Angestellter, der über Dutzende von Monitoren die Räume überwacht, die Leibesvisitation, der sich die Männer vor ihrer Ausschaffung unterziehen müssen, oder die kurzen und emotionalen Besuche von Familienangehörigen.“"
                            },
                            {
                                "example_id": "28ea2f1a-6b01-4785-bd7f-8d9eef965b94",
                                "sense_id": "aeb89326-ccf3-3f25-95cb-5411e4f56fbd",
                                "text": "„Wie der amerikanische Blog «thesmokinggun» aufgrund von Pressemitteilungen berichtet, wanderte der 22-Jährige nach einer Leibesvisitation in eine Zelle des Onslower Bezirksgefängnisses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
