                "senses": [
                    {
                        "sense_id": "43ddd0f3-9a8f-3f7b-a9b6-3a88862169e8",
                        "entry_id": "b326a85e-54af-361e-8903-c22ce2f4e312",
                        "glosses": [
                            "eine Variante des Prostylos, der auf Vorder- und Rückseite eine Säulenreihe aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d61ada-0360-4fef-bbdf-047316f6c1d5",
                                "sense_id": "43ddd0f3-9a8f-3f7b-a9b6-3a88862169e8",
                                "text": "„Eine Variante des Prostylos, der auf Vorder- und Rückseite eine Säulenreihe aufweist, ist der Amphiprostylos.“"
                            },
                            {
                                "example_id": "df1f989b-c37d-4320-b642-ab1f9368897d",
                                "sense_id": "43ddd0f3-9a8f-3f7b-a9b6-3a88862169e8",
                                "text": "\"Bekannte Beispiele für den Amphiprostylos sind der Tempel am Ilissos in Athen, der Athena Nike-Tempel auf der Akropolis in Athen, der Athenatempel von Lindos, Apollontempel III auf Delos.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "174fd132-75a4-4883-a6a3-3a918a26511b",
                        "source_entry_id": "b326a85e-54af-361e-8903-c22ce2f4e312",
                        "source_sense_id": "43ddd0f3-9a8f-3f7b-a9b6-3a88862169e8",
                        "source_sense_description": "Architektur: eine Variante des Prostylos, der auf Vorder- und Rückseite eine Säulenreihe aufweist",
                        "target_lang_word": "amphiprostyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphiprostyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                        "entry_id": "e1c63cc4-6a38-3f2a-b84f-5069bd0f46ac",
                                        "glosses": [
                                            "Having columns at either end but not along the sides."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996b7252-9dcb-4b8a-b658-b6b7b6041bd7",
                                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                                "text": "This much being sufficiently proved; before I draw the inference in contemplation, I have next to prove, the original temple was amphiprostyle, and hexastyle."
                                            },
                                            {
                                                "example_id": "77aaee35-d5bb-4f8f-938e-79bf0f03bfc7",
                                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                                "text": "Another characteristic of amphiprostyle temples was that of their porticoes, consisting of four columns only."
                                            },
                                            {
                                                "example_id": "f70cc89d-e974-43b8-8660-de456fbc5881",
                                                "sense_id": "d02d8910-8497-321b-8c9d-c3fc50a04266",
                                                "text": "\"The Ilissos Temple is the first attested amphiprostyle temple in Greek architecture.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amphiprostyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e089226-7396-321c-8b1b-c8e4a0de5529",
                                        "entry_id": "9d6eec65-1692-3e7e-a1e4-db6909d9462d",
                                        "glosses": [
                                            "An amphiprostyle temple or edifice."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f3d607-69a8-4389-9055-2cdb8d5b80c9",
                                                "sense_id": "2e089226-7396-321c-8b1b-c8e4a0de5529",
                                                "text": "1819, Periptere, Abraham Rees, The Cyclopædia: Or, Universal Dictionary of Arts, Sciences, and Literature, Volume 26, unnumbered page,\nPeripteres were properly temples which had columns on all the four ſides; by which they were distinguished from proſtyles, and amphiproſtyles, the one of which had no columns before, and the other none on the sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58e0d27b-22b1-4aa0-81fe-f35b6796b1d1",
                        "source_entry_id": "b326a85e-54af-361e-8903-c22ce2f4e312",
                        "source_sense_id": "43ddd0f3-9a8f-3f7b-a9b6-3a88862169e8",
                        "source_sense_description": "Architektur: eine Variante des Prostylos, der auf Vorder- und Rückseite eine Säulenreihe aufweist",
                        "target_lang_word": "amphiprostyle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphiprostyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80327b6e-33bf-3593-ac16-e9185edd2e1d",
                                        "entry_id": "d0fbb1d2-18a5-3fe9-b310-3f59421b7d28",
                                        "glosses": [
                                            "Temple oblong qui avait plusieurs colonnes à chaque bout."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffc8186-d09a-4cb2-b514-2747568a426d",
                                                "sense_id": "80327b6e-33bf-3593-ac16-e9185edd2e1d",
                                                "text": "Chaque sorte de temple se distingue par la forme différente qu'il présente à notre vue. La première est le temple à antes, que les Grecs appellent ναὸς ἐν παραστάσι ; les autres sont le prostyle, l'amphiprostyle, le périptère, le pseudodiptère, le diptère, l'hypètre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amphiprostyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "912a4571-02e6-3cfe-b3e6-d95a273f3035",
                                        "entry_id": "f290a98e-a8f3-3980-815d-d1af8c4bd9ee",
                                        "glosses": [
                                            "Qualifie ce type de temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8a3fab-b69a-4550-880f-f3cad48c2f60",
                                                "sense_id": "912a4571-02e6-3cfe-b3e6-d95a273f3035",
                                                "text": "Ce sékos lui-même est amphiprostyle hexastyle et il est divisé en deux parties étanches adossées l'une à l'autre et précédées chacune d'un pronaos fermé par des grilles de bronze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
