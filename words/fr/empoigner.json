{
    "word_family": [
        "poing",
        "poignée",
        "poignet",
        "empoignade"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4a51349-3168-3cdd-a88b-dbee2a10ed3a",
                    "sense_definition": "Prendre vivement et serrer avec la main ou le poing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "préhension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>empoigne</w> la poignée de la valise et commence à courir vers le quai."
                        },
                        {
                            "text": "En voyant le danger approcher, elle a <w>empoigné</w> fermement la rampe de l'escalier."
                        }
                    ],
                    "synonyms": [
                        "saisir",
                        "agripper",
                        "attraper"
                    ],
                    "antonyms": [
                        "lâcher",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "empoigner la poignée",
                        "empoigner le manche"
                    ]
                },
                {
                    "sense_id": "e125ce96-cf23-3a23-9971-47a65a1fcf70",
                    "sense_definition": "Saisir quelqu'un avec vigueur au corps ou par ses vêtements pour le retenir ou l'arrêter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "préhension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vigile a rapidement <w>empoigné</w> le voleur avant qu'il ne parvienne à franchir la porte."
                        },
                        {
                            "text": "Deux agents ont réussi à <w>empoigner</w> le suspect qui tentait de leur échapper dans la foule."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "ceinturer",
                        "arrêter"
                    ],
                    "antonyms": [
                        "libérer",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "empoigner par le bras",
                        "empoigner un suspect"
                    ]
                },
                {
                    "sense_id": "3858c761-7dbe-39de-a068-7d229c083e3b",
                    "sense_definition": "Toucher vivement l'esprit ou émouvoir puissamment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dénouement tragique de cette pièce de théâtre <w>empoigne</w> profondément le spectateur."
                        },
                        {
                            "text": "Une angoisse subite l'a <w>empoignée</w> dès qu'elle a appris la terrible nouvelle."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "émouvoir",
                        "remuer"
                    ],
                    "antonyms": [
                        "laisser indifférent"
                    ],
                    "common_phrases": [
                        "empoigner le public",
                        "empoigner le spectateur"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figuré"
                        }
                    ]
                },
                {
                    "sense_id": "7b4109e8-c764-304d-8017-532b78b3b834",
                    "sense_definition": "Prendre violemment à partie quelqu'un, le quereller ou lui faire des reproches avec véhémence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Furieux du retard accumulé, le directeur a vertement <w>empoigné</w> son collaborateur en public."
                        },
                        {
                            "text": "Elle n'a pas hésité à <w>empoigner</w> son rival lors du débat pour dénoncer ses mensonges."
                        }
                    ],
                    "synonyms": [
                        "houspiller",
                        "tancer",
                        "apostropher"
                    ],
                    "antonyms": [
                        "ménager",
                        "flatter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        }
    ]
}