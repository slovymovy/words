                ],
                "senses": [
                    {
                        "sense_id": "a5898d0c-ff35-3e86-aebf-935cf20b473a",
                        "entry_id": "3294b01e-d4b5-3be8-8b79-3f335e82e260",
                        "glosses": [
                            "A figure that brings sleep and dreams by sprinkling magical sand into people's eyes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab3d8f0-b8da-42d2-ac3b-5d5b493f6060",
                                "sense_id": "a5898d0c-ff35-3e86-aebf-935cf20b473a",
                                "text": "This then was the Sandman; but what was his occupation, and what was his purpose ? The nursery-maid being applied to, gave a nursery-maid's explanation, that the Sandman was a bad man, who flung sand in the eyes of little children who did not go to bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "9640ef8e-fe47-3493-b42f-84c63856a4ba",
                        "entry_id": "3294b01e-d4b5-3be8-8b79-3f335e82e260",
                        "glosses": [
                            "Used as a symbol of the passage of time toward death."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bbb1cb55-a058-3eea-9ae6-5bb1b13e5eb0",
                        "entry_id": "3294b01e-d4b5-3be8-8b79-3f335e82e260",
                        "glosses": [
                            "A seller of sand."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d34e0cf-406e-4fd4-8122-177391be27e2",
                                "sense_id": "bbb1cb55-a058-3eea-9ae6-5bb1b13e5eb0",
                                "text": "1811, Arabian Nights' Entertainments, Consisting of One Thousand and One Stories, Told by the Sultaness of the Indies, Henry Mozley (publ.), page 114.\nWhile I was out, a sandman, who sells scouring sand, which women use to clean the baths with, passed through our street, and called, Any sand ho !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
