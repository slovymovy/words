    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a559a1a8-28ec-3146-a50d-c2813173d8d2",
                    "sense_definition": "vrij van vreemde stoffen of verontreiniging",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "puurheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is het <w>zuiverste</w> water dat de natuur ons te bieden heeft.",
                            "target_lang_translations": {
                                "en": "This is the <w>purest</w> water that nature has to offer us."
                            }
                        },
                        {
                            "text": "De ring is gemaakt van <w>zuiver</w> goud zonder andere metalen.",
                            "target_lang_translations": {
                                "en": "The ring is made of <w>pure</w> gold without other metals."
                            }
                        }
                    ],
                    "synonyms": [
                        "puur",
                        "onbezoedeld",
                        "onvermengd"
                    ],
                    "antonyms": [
                        "onzuiver"
                    ],
                    "common_phrases": [
                        "zuiver water",
                        "zuiver goud",
                        "zuivere lucht"
                    ],
                    "target_lang_definitions": {
                        "en": "free from foreign substances or contamination"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
                                "target_lang_sense_clarification": "free of foreign material or pollutants"
                            },
                            {
                                "target_lang_word": "clean",
                                "target_lang_sense_clarification": "free from dirt or impurities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd74245d-c921-3ddd-872e-e610480dd16f",
                    "sense_definition": "met precies de juiste toonhoogte of klank",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>zuiver</w> instrument dat prachtig klonk in de zaal.",
                            "target_lang_translations": {
                                "en": "It was a <w>pure-sounding</w> instrument that sounded beautiful in the hall."
                            }
                        },
                        {
                            "text": "Zij kan heel <w>zuiver</w> zingen zonder een enkele valse noot.",
                            "target_lang_translations": {
                                "en": "She can sing very <w>purely</w> without a single false note."
                            }
                        }
                    ],
                    "synonyms": [
                        "helder"
                    ],
                    "antonyms": [
                        "vals"
                    ],
                    "common_phrases": [
                        "zuiver zingen",
                        "zuivere toon"
                    ],
                    "target_lang_definitions": {
                        "en": "with exactly the right pitch or sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
                                "target_lang_sense_clarification": "without harmonics or overtones; not harsh"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "distinct and easy to hear"
                            },
                            {
                                "target_lang_word": "in tune",
                                "target_lang_sense_clarification": "at the correct musical pitch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038e8baa-c1b4-3b03-9f17-b242c5798bd0",
                    "sense_definition": "het bedrag dat overblijft na aftrek van alle kosten en belastingen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na alle onkosten hielden we een <w>zuivere</w> winst van duizend euro over.",
                            "target_lang_translations": {
                                "en": "After all expenses, we were left with a <w>net</w> profit of a thousand euros."
                            }
                        },
                        {
                            "text": "De <w>zuivere</w> opbrengst van de actie gaat volledig naar het goede doel.",
                            "target_lang_translations": {
                                "en": "The <w>net</w> proceeds of the campaign go entirely to charity."
                            }
                        }
                    ],
                    "synonyms": [
                        "netto"
                    ],
                    "common_phrases": [
                        "zuivere winst",
                        "zuivere opbrengst"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the amount remaining after deduction of all costs and taxes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "net",
                                "target_lang_sense_clarification": "remaining after all deductions"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "profit after all expenses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aeae8f9-2f29-3180-85ce-7105545fce30",
                    "sense_definition": "vrij van schuld of morele vlekken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moraal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een <w>zuiver</w> geweten omdat hij altijd eerlijk is geweest.",
                            "target_lang_translations": {
                                "en": "He has a <w>clear</w> conscience because he has always been honest."
                            }
                        },
                        {
                            "text": "Haar bedoelingen waren <w>zuiver</w> toen ze besloot ons te helpen.",
                            "target_lang_translations": {
                                "en": "Her intentions were <w>pure</w> when she decided to help us."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerlijk",
                        "oprecht",
                        "onbevlekt"
                    ],
                    "common_phrases": [
                        "zuiver geweten",
                        "zuivere bedoelingen"
                    ],
                    "target_lang_definitions": {
                        "en": "free from guilt or moral stains"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
                                "target_lang_sense_clarification": "free of immoral behavior or qualities"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "free from guilt, as in a conscience"
                            },
                            {
                                "target_lang_word": "clean",
                                "target_lang_sense_clarification": "morally upright"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5d7b4f8-3b55-3520-bb38-b8e7ad1464ad",
                    "sense_definition": "niet beïnvloed door vooroordelen of persoonlijke meningen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oordeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetenschapper probeerde een <w>zuiver</w> oordeel te vellen over de resultaten.",
                            "target_lang_translations": {
                                "en": "The scientist tried to pass an <w>objective</w> judgment on the results."
                            }
                        },
                        {
                            "text": "Het is lastig om een <w>zuivere</w> waarneming te doen zonder eigen interpretatie.",
                            "target_lang_translations": {
                                "en": "It is difficult to make a <w>pure</w> observation without one's own interpretation."
                            }
                        }
                    ],
                    "synonyms": [
                        "objectief",
                        "onbevooroordeeld"
                    ],
                    "common_phrases": [
                        "zuiver oordeel",
                        "zuivere waarneming"
                    ],
                    "target_lang_definitions": {
                        "en": "not influenced by prejudice or personal opinions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
                                "target_lang_sense_clarification": "cold and objective reason"
                            },
                            {
                                "target_lang_word": "objective",
                                "target_lang_sense_clarification": "not influenced by personal feelings"
                            },
                            {
                                "target_lang_word": "unbiased",
                                "target_lang_sense_clarification": "showing no prejudice"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "16655bbb-7629-3dbe-9081-d11e6faf56ee",
                    "sense_definition": "uitroep om aan te geven dat iets klopt of dat men het eens is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Gaan we morgen om acht uur weg?\" \"<w>Zuiver</w>, dat spreken we af.\"",
                            "target_lang_translations": {
                                "en": "\"Are we leaving at eight tomorrow?\" \"<w>Exactly</w>, that's what we'll agree on.\""
                            }
                        },
                        {
                            "text": "Dat is een <w>zuiver</w> antwoord op de vraag die ik stelde.",
                            "target_lang_translations": {
                                "en": "That is a <w>correct</w> answer to the question I asked."
                            }
                        }
                    ],
                    "synonyms": [
                        "precies",
                        "inderdaad",
                        "juist"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal confirmation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "exclamation to indicate that something is correct or that one agrees"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "used to express agreement"
                            },
                            {
                                "target_lang_word": "spot on",
                                "target_lang_sense_clarification": "completely accurate"
                            },
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "correct or true"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
