                        "target_lang_word": "Oligozän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oligozän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a5f724-3727-38da-978d-ac12a721881d",
                                        "entry_id": "7979b2d1-9097-31a4-ba5c-dfee0e148970",
                                        "glosses": [
                                            "geologischer Zeitabschnitt von 23 bis 34 Millionen Jahren vor unserer Zeit, in dem vor allem sehr große herbivore Säugetiere lebten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946d6aa7-8a4c-45eb-8da7-e701127dc9da",
                                                "sense_id": "a5a5f724-3727-38da-978d-ac12a721881d",
                                                "text": "„Afrika war im Oligozän eine Insel, getrennt von Europa, aber verbunden mit Arabien.“"
                                            },
                                            {
                                                "example_id": "45dda52b-743f-4a3d-a3f0-c39944a8c3c8",
                                                "sense_id": "a5a5f724-3727-38da-978d-ac12a721881d",
                                                "text": "„Im subtropischen Klima des Oligozäns mit Palmen und immergrünen Laubbäumen lebten vorwiegend große Säugetiere.“"
                                            },
                                            {
                                                "example_id": "70c20170-b4eb-4dd6-a5c6-aa9f9821de35",
                                                "sense_id": "a5a5f724-3727-38da-978d-ac12a721881d",
                                                "text": "„Im Oligozän wichen die tropischen Wälder in die niederen Breiten zurück und machten grasbewachsenen Ebenen mit einzelnen Bäumen und Sträuchern Platz (Savanne).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
