                },
                {
                    "sense_id": "fdc35f37-8ada-3606-b03c-92db4d177661",
                    "sense_definition": "A native or inhabitant of Italy, or a person of Italian descent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Italians</w> are famous for their contributions to art and history.",
                            "target_lang_translations": {
                                "ru": "<w>Итальянцы</w> славятся своим вкладом в искусство и историю.",
                                "zh": "<w>意大利人</w>以他们对艺术和历史的贡献而闻名。"
                            }
                        },
                        {
                            "text": "My neighbor is an <w>Italian</w> who moved here last year.",
                            "target_lang_translations": {
                                "ru": "Мой сосед — <w>итальянец</w>, который переехал сюда в прошлом году.",
                                "zh": "我的邻居是一位去年搬到这里的<w>意大利人</w>。"
                            }
                        }
