                                "example_id": "3ada400c-a61f-4fb8-b49c-714c8a807676",
                                "sense_id": "3bcf1098-9464-3220-820b-73234438f3d8",
                                "text": "Ein Laserdrucker kann längere Standzeiten überbrücken, ohne dass eine Wartung nötig wäre."
                            },
                            {
                                "example_id": "4c2424a4-b109-4298-ae98-e08184e00cfc",
                                "sense_id": "3bcf1098-9464-3220-820b-73234438f3d8",
                                "text": "„In einem großen Vergleich zahlreicher Tintenstrahl- und Laserdrucker hat die Stiftung Warentest auch untersucht, wie sich die Geräte verhalten, wenn sie nicht benutzt werden.“"
                            }
                        ],
