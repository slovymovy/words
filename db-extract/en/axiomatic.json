                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c7eecdd-7962-373f-b309-817d062f82f0",
                        "entry_id": "e8e0e0a1-8f22-35fe-874a-059aaa565f2b",
                        "glosses": [
                            "Self-evident or unquestionable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0efc26d-f338-47c3-92cc-67d6ecbad90c",
                                "sense_id": "8c7eecdd-7962-373f-b309-817d062f82f0",
                                "text": "The students nodded, emphatically agreeing with a statement which upwards of sixty-two thousand repetitions in the dark had made them accept, not merely as true, but as axiomatic, self-evident, utterly indisputable."
                            },
                            {
                                "example_id": "baa4cb33-8530-4def-b536-65bb2f4c7649",
                                "sense_id": "8c7eecdd-7962-373f-b309-817d062f82f0",
                                "text": "It is axiomatic that the \"physical entry of the home is the chief evil against which the wording of the Fourth Amendment is directed.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "575436f7-23d3-33b8-a901-720e6b6d12fb",
                        "entry_id": "e8e0e0a1-8f22-35fe-874a-059aaa565f2b",
                        "glosses": [
                            "Relating to or containing axioms."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63014fbc-2f52-4e66-bbca-a8e369d8e2db",
                        "source_entry_id": "e8e0e0a1-8f22-35fe-874a-059aaa565f2b",
                        "source_sense_description": "self-evident",
                        "target_lang_word": "vanzelfsprekend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanzelfsprekend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                        "entry_id": "e026b994-3c46-35c3-ac67-d77c285ab062",
                                        "glosses": [
                                            "overduidelijk geldend, zonder verdere uitleg duidelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2954a95c-e992-41bb-ba45-346fc73bef86",
                                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                                "text": "Creativiteit en flexibiliteit zijn vanzelfsprekende vereisten."
                                            },
                                            {
                                                "example_id": "4cf40967-a6d5-4a87-bf7d-23e5c6f355ec",
                                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                                "text": "De band tussen school en kerk was vroeger een vanzelfsprekende zaak."
                                            },
                                            {
                                                "example_id": "6cbe1b03-1104-4144-ae2c-15ba9773108b",
                                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                                "text": "Mijn solidariteit met de Amerikaanse oerbevolking, de índianen', was rotsvast en het is, wat je ook mag denken, geen reconstructie achteraf die is aangepast aan het tegenwoordig vanzelfsprekende standpunt."
                                            },
                                            {
                                                "example_id": "a378ee08-db86-4a7f-b1ee-9f88b9920bd2",
                                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                                "text": "Maar grotere en interessantere stromen werden gegenereerd door het dochterbedrijf Mercurius met zijn lopende effectenbeheer, waarbij de kasstroom werd geproduceerd door korte zaken met snelle winsten en de optiehandel, inclusief die met synthetische opties, terwijl effecten waarvan verwacht werd dat ze een grotere maar langlopendere waardevermeerdering zouden creëren vanzelfsprekend langzamer werkten."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vanzelfsprekend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac116b3-1ec1-38a5-b526-9396b09f2bf4",
                                        "entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                                        "glosses": [
                                            "iets dat geen verdere uitleg nodig heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6b1616-7e76-4516-88e1-98e2a79bf225",
                                                "sense_id": "4ac116b3-1ec1-38a5-b526-9396b09f2bf4",
                                                "text": "Vandaag keek hij vanzelfsprekend niet meer zo tegen de dingen aan. Hij wist dat de oorlog niets anders was dan een reusachtige loterij met levensechte kogels, waarin vier jaar overleven aan het wonderbaarlijke grensde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe7a7c7-41f5-3b8c-86fd-954f9e242bb2",
                                        "entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                                        "glosses": [
                                            "automatisch zonder er verder bij na te denken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57263304-c51a-4a65-ac54-da32597c33a3",
                                                "sense_id": "ebe7a7c7-41f5-3b8c-86fd-954f9e242bb2",
                                                "text": "En bijna vanzelfsprekend bleef het museum opgraven in Egypte, waar het al sinds 1957 welkom is en onder meer heeft meegeholpen aan de internationale reddingsopgravingen rond de bouw van de Aswandam, en bij Sakkara graven heeft ontdekt van twee belangrijke functionarissen van Toetanchamon, generaal Horemheb en schatbewaarder Maya (en zijn vrouw Merit)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c01619-fa56-4c36-893b-55c6a75bf27b",
                        "source_entry_id": "e8e0e0a1-8f22-35fe-874a-059aaa565f2b",
                        "source_sense_description": "self-evident",
                        "target_lang_word": "axiomatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axiomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                        "entry_id": "7ee8e9c0-6c28-39e0-a547-c7f25a585a13",
                                        "glosses": [
                                            "Fondé sur des axiomes, d’une logique de vérité indémontrable, mais faisant autorité en la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a0a801-0285-4b5f-a595-12ddb0dd3696",
                                                "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                                "text": "La faculté de comprendre ou l’impossibilité de comprendre, dit fort judicieusement M. Mill, ne peut, dans aucun cas, être considérée comme un critérium de Vérité axiomatique."
                                            },
                                            {
                                                "example_id": "9cdfa0d2-1e17-4a81-b087-d0381472cee7",
                                                "sense_id": "242a05fb-16dc-3194-aeb1-d2b8910978ed",
                                                "text": "Changer de système axiomatique de base est une décision difficile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "axiomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d00afa7-ccb3-39ab-a5a0-31b7ac1f4e2a",
                                        "entry_id": "d06f5a18-1503-3424-8cf4-c2e190442340",
                                        "glosses": [
                                            "Ensemble de postulats (axiomes) à la base d’un système théorique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3252a73f-0f55-305a-bda1-4efed16c3285",
                                        "entry_id": "d06f5a18-1503-3424-8cf4-c2e190442340",
                                        "glosses": [
                                            "Science de la cohérence de tels ensembles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f259e2b3-4c1a-43fb-b59a-1a1ab475399e",
                                                "sense_id": "3252a73f-0f55-305a-bda1-4efed16c3285",
                                                "text": "On parlait alors de « variété », de « totalité », de « classe » et Cantor a inventé non seulement un tout autre langage, mais l’axiomatique qui va avec, ouvrant la boîte de Pandore d’une théorie alors incongrue, dont il n’avait sans doute pas prévu tous les développements ni tous les excès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "644f1b6b-b8eb-49f8-8b2c-23b684ee7139",
