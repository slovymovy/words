                        "glosses": [
                            "Person oder Gruppe, die in der Lage ist, eine Person zum König zu machen/ihr in ein hohes Amt zu helfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d98ba5-f148-413c-b499-6cf5e2b4af6e",
                                "sense_id": "afdee57b-c195-3e5f-b70a-e8434f998e20",
                                "text": "„Als Ede herrscht er mit der Erlaubnis des Rates der Königsmacher, d.h. der Uzama, deren Autorität seiner eigenen vorausgeht.“"
                            },
                            {
                                "example_id": "e968b6c7-5336-4b7e-bb26-93837c575ea9",
                                "sense_id": "afdee57b-c195-3e5f-b70a-e8434f998e20",
                                "text": "„Die Familie Mudschaddedi führte den Orden in Naqschbandiah und war jahrhundertelang Königsmacher in Kabul.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
