                        "source_entry_id": "0aba4fbb-c6a5-35f8-b428-5310503f9a86",
                        "source_sense_id": "2fa6ea91-6c34-345a-8a19-70c59450ff9b",
                        "target_lang_word": "Verstädterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstädterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                        "entry_id": "839a0bca-5460-3bb8-9b2b-dd93acbc5854",
                                        "glosses": [
                                            "Umwandlung eines ländlichen in ein städtisches Gebiet"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af999b86-5277-42cc-90a4-a8814cbce06a",
                                                "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                                "text": "„Die Probleme der Verstädterung in den Entwicklungsländern rücken immer mehr in den Blickpunkt des öffentlichen Interesses.“"
                                            },
                                            {
                                                "example_id": "4259e2fa-ad0f-484f-b93f-6fef4e562119",
                                                "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                                "text": "Es setzte damals eine Verstädterung ein, die heutzutage dazu führt, dass etwa jeder zweite Mensch in einer Stadt lebt."
                                            },
                                            {
                                                "example_id": "00d6efd6-102a-4d35-a1c5-837699b809c5",
                                                "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                                "text": "Die Verstädterung betrifft viele Menschen."
                                            },
                                            {
                                                "example_id": "116e8749-56df-416c-bf67-e74c145957e0",
                                                "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                                "text": "„In die Zeit der Fürstensitze fällt auch die erste Verstädterung in unserem Land.“"
                                            },
                                            {
                                                "example_id": "ae774121-20e0-4474-9f56-5a16e7f0b4fa",
                                                "sense_id": "4713c42f-0374-3514-af43-a085885452d6",
                                                "text": "„Aufgrund fehlender Statistiken sind Tempo und Ausmaß der Verstädterung nicht nur höchst umstritten, sondern auch ein Politikum, nicht zuletzt weil damit für einige Akteure weitreichende Auswirkungen verbunden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
