    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dc25f9f5-4f04-3b81-bf66-716cf3440e12",
                "word": "baseless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                        "entry_id": "dc25f9f5-4f04-3b81-bf66-716cf3440e12",
                        "glosses": [
                            "Of reasoning: based on something that is not true, or not based on solid reasons or facts; unfounded; without a basis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "360eddd7-6421-480a-9147-00e092aaf08b",
                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                "text": "baseless accusations; baseless rumors"
                            },
                            {
                                "example_id": "1447717f-5a6e-44a9-9593-cb8de5c17e18",
                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                "text": "But Rodríguez says, “Neither the law nor the facts support Senator Grassley’s baseless allegations and extrapolated conclusions."
                            },
                            {
                                "example_id": "19712db6-1734-4efa-9424-3023819ce0d9",
                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                "text": "Speaking to RAIL, a DfT spokesman said: \"We do not recognise these baseless, false figures. Just last month we provided an update to Parliament on the costs of the project and confirmed that it would be delivered within the funding envelope. […].\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b31921a0-1b95-37b4-a3b2-34fcb1e662ad",
                        "entry_id": "dc25f9f5-4f04-3b81-bf66-716cf3440e12",
                        "glosses": [
                            "Without a physical base."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b62b8ff2-87df-417e-befb-3e53915140b3",
                                "sense_id": "b31921a0-1b95-37b4-a3b2-34fcb1e662ad",
                                "text": "More significant still — and most obviously in debt to the painterly imagination — this floating statue is the first baseless statue ever made. It is as though Bernini had taken Michelangelo's 'Pieta' and made it fly."
                            }
                        ]
                    }
                ],
