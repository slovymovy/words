                                        "glosses": [
                                            "inborst, stemming, gemoed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a77235-2f12-46a1-8a49-ccaa2f365127",
                                                "sense_id": "cb8b3e42-a4d8-34d2-a7c7-b4c6ab6e1e60",
                                                "text": "In goede moed ging hij uit fietsen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28c5a3c-554e-3426-a62e-87cc53e29bd3",
                                        "entry_id": "ac679d49-39fe-3adc-a76b-3b104e83f595",
