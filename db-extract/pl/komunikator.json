                            {
                                "target_word": "IM",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d1004d-e18e-3f19-bee0-a1a769cc5540",
                                        "entry_id": "2c10ad17-b97c-3458-8497-f2c1a35e2740",
                                        "glosses": [
                                            "Initialism of instant message (verb)."
                                        ],
                                        "tags": [
                                            "abbreviation",
