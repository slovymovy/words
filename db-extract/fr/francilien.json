                        "examples": [
                            {
                                "example_id": "254c2833-2b00-42c0-a143-bec5b96c105b",
                                "sense_id": "beff2e93-66b4-3323-8bd4-23cded6e79f5",
                                "text": "La veille de l’embarrassante finale de la Ligue des champions se tenait un événement qui célébrait une fierté francilienne : le foot de rue.' — (journal 20 minutes, 8 juin 2022, page 16)"
                            },
                            {
                                "example_id": "7d736f60-78fa-41be-9575-817b6d0c6d57",
                                "sense_id": "beff2e93-66b4-3323-8bd4-23cded6e79f5",
                                "text": "Airparif vient de publier les résultats d’une étude de mesure des particules ultrafines à proximité d’axes routiers franciliens."
                            }
                        ]
                    }
