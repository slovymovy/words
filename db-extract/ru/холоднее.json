                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "4c8657e2-92e5-4015-abdb-1c5586604b7f",
                                "sense_id": "1fb34436-ce55-33f8-a915-fb91f52c5b20",
                                "text": "Небо стало еще синее и холоднее."
                            },
                            {
                                "example_id": "3334da3a-725e-403e-a51d-3e906f899081",
                                "sense_id": "1fb34436-ce55-33f8-a915-fb91f52c5b20",
                                "text": "Год от году холоднее становится лето, теплее зима, и оттого мне порой кажется, что все катится под гору."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0e0688d-91e9-373b-b6f0-6ec4f4cdc73b",
                        "entry_id": "db6d2414-dbb2-3a16-a945-ed8f84d94dc9",
                        "glosses": [
                            "сравн. ст. к нареч. холодно"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "27effdc2-0b43-4bfd-84d7-b8bbd5f4a800",
                                "sense_id": "a0e0688d-91e9-373b-b6f0-6ec4f4cdc73b",
                                "text": "Гораздо ли холоднее на Шпицбергене, нежели в Архангельске?"
                            },
                            {
                                "example_id": "2ac65675-1e26-4c68-97ca-532bb6601f23",
                                "sense_id": "a0e0688d-91e9-373b-b6f0-6ec4f4cdc73b",
                                "text": "Отец обходился с ним всё холоднее и холоднее."
                            },
                            {
                                "example_id": "9ae5bb06-67c1-42f9-82b8-0584ca137ce7",
                                "sense_id": "a0e0688d-91e9-373b-b6f0-6ec4f4cdc73b",
                                "text": "Публика принимала его холоднее в Гамлете, чем в других ролях."
                            }
                        ]
                    }
                ],
