                        "source_entry_id": "a0a4537f-7bab-30d9-843b-680ce3a2ed4c",
                        "source_sense_id": "cf8c77ba-411e-356e-85a9-7c5315760e0a",
                        "source_sense_description": "respiratory organelle",
                        "target_lang_word": "mitochondrie",
