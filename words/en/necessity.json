                            },
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "对某事物的迫切需求"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "necesidad",
                                "target_lang_sense_clarification": "calidad de necesario o inevitable"
                            },
                            {
                                "target_lang_word": "menester",
                                "target_lang_sense_clarification": "algo requerido o necesario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc9c1c4e-cfaa-32a1-96c4-67a36e3d2de8",
                    "sense_definition": "The condition of being needy; desperate need; lack.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family lived in great <necessity> after the father lost his job.",
                            "target_lang_translations": {
                                "ru": "Семья жила в большой <нужде> после того, как отец потерял работу.",
                                "zh": "父亲失业后，这家人陷入了极大的<w>贫困</w>之中。",
                                "es": "La familia vivió en gran <necesidad> después de que el padre perdiera su trabajo."
                            }
                        },
                        {
                            "text": "Charities were established to help those suffering from hunger and <necessity>.",
                            "target_lang_translations": {
                                "ru": "Благотворительные организации были созданы для помощи тем, кто страдает от голода и <нищеты>.",
                                "zh": "慈善机构的成立旨在帮助那些遭受饥饿和<w>贫困</w>折磨的人们。",
                                "es": "Se crearon organizaciones benéficas para ayudar a quienes sufren de hambre y <necesidad>."
                            }
                        }
                    ],
                    "synonyms": [
                        "needfulness"
                    ],
                    "common_phrases": [
                        "dire necessity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нужды; крайняя потребность; нехватка средств.",
                        "zh": "指贫困、匮乏或极度缺乏生活资料的状态。",
                        "es": "La condición de estar necesitado; carencia extrema; falta de recursos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нужда",
                                "target_lang_sense_clarification": "бедность, недостаток"
                            },
                            {
                                "target_lang_word": "нищета",
                                "target_lang_sense_clarification": "крайняя бедность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贫困",
                                "target_lang_sense_clarification": "生活极度匮乏的状态"
                            },
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "因缺乏资源而陷入的艰难处境"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "necesidad",
                                "target_lang_sense_clarification": "situación de carencia o escasez"
                            },
                            {
                                "target_lang_word": "penuria",
                                "target_lang_sense_clarification": "escasez o falta de lo necesario"
                            }
                        ]
                    }
                }
            ]
        }
    ]
