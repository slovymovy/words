                        "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                        "entry_id": "7397af0d-1e62-3d49-bf2c-6bf2ca3e7d26",
                        "glosses": [
                            "Swelling or swollen into large waves; full of billows or surges; resembling billows."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ab0655-7918-4804-880c-95efe21ab3b1",
                                "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                                "text": "He was shabby and careless, with inkstains on the sleeves of his jacket, and his cravat was large and billowy, under a chin shaped like the toe of an old boot."
                            },
                            {
                                "example_id": "676f313d-c7ec-489e-b866-363423f2973a",
                                "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                                "text": "[…] Tiare clasped me to her vast bosom, so that I seemed to sink into a billowy sea, and pressed her red lips to mine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72c46205-2b00-4de6-afca-b24f8f40f67d",
                        "source_entry_id": "7397af0d-1e62-3d49-bf2c-6bf2ca3e7d26",
                        "source_sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                        "source_sense_description": "full of billows or surges",
                        "target_lang_word": "wellig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wellig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                        "entry_id": "e1602da3-1c48-3fed-bac0-b0cafc88bff7",
                                        "glosses": [
                                            "in Form von vielen kleinen Wellen, wellenförmig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bf5512-8b58-4eca-8252-c89cc8de6e7a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Cellulite:] „Stadium 3 – Auch in Ruhe und im Liegen ist eine wellige Hautoberfläche sichtbar.“"
                                            },
                                            {
                                                "example_id": "ee6f6cb5-8fce-4a09-918c-7135f4635964",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[EKG:] „Verschiedenfarbige zackige und wellige Linien laufen über den Bildschirm, jede liefert Informationen über den Schlaf des Patienten.“"
                                            },
                                            {
                                                "example_id": "bafccec8-f769-491e-811c-ad571fb72e1a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Seehunde:] „Die Barthaare sind stark wellig und im Querschnitt oval.“"
                                            },
                                            {
                                                "example_id": "25838cdb-fab9-45d2-8db4-2e36a30d8f37",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Daneben steht ein Styroporkopf, und da herum hängen reihenweise Echthaarperücken, lange und kurze, wellige und glatte, blonde und schwarze.“"
                                            },
                                            {
                                                "example_id": "a964eea6-63b5-4f70-96bd-5cd09949c322",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Der Wind SO 4-6 ist böig, die See ist wellig, der Skipper kämpft Einhand mit dem achterlichen Wind, teilweise wird nur mit der Genua gesegelt. Die Bordfrau nimmt zum ersten Mal Tabletten gegen Seekrankheit.“"
                                            },
                                            {
                                                "example_id": "b3ac9c3e-bda6-4f5e-abf9-9f0511ad0d85",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Das Himmerland im Norden Dänemarks ist eine leicht wellige Hügellandschaft.“"
                                            },
                                            {
                                                "example_id": "81da7537-19ef-4306-9b83-d523d75ef45d",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Roztocze ist eine wellige Hügelkette im südöstlichen Polen und in der westlichen Ukraine.“"
                                            },
                                            {
                                                "example_id": "712fdc81-8cab-4d26-a634-7dd2f48e066c",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Er zeigt auf den welligen gerissenen Asphalt.“"
                                            },
                                            {
                                                "example_id": "762751e0-dc93-4a97-8c05-bcc4693f85ee",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Tour de France 2020:] „»Erst ist die Strecke eben, dann wird es wellig und am Ende kommt ein unglaublicher Berg«, schwärmte Prudhomme vom 36 Kilometer langen Bergzeitfahren zur Planche des Belles Filles in den Vogesen.“"
                                            },
                                            {
                                                "example_id": "9820a620-404c-4a5f-b30e-01480e5ccce9",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Mountainbike-Rennen:] „Schon auf dem ersten der sechs Teilabschnitte, der rund 600 Höhenmeter hinauf auf den Kupferberg und dann durch das wellige Gelände des Khomas-Gebirges führt, spürt er den Lohn seiner unzähligen Trainingsstunden.“"
                                            },
                                            {
                                                "example_id": "91d9c906-795b-410a-8eb3-adc034481d8a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Radrennen – Deutschlandtour:] „Stehen zum Auftakt in Halberstadt noch die Sprinter im Fokus, könnten es auf dem welligen Schlusskurs in Göttingen schon angriffslustige Fahrer sein.“"
                                            },
                                            {
                                                "example_id": "7182c023-fb93-44c9-b66d-b0ccf894a99d",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Formel 1 in Spa-Francorchamps/Belgien:] „Ferrari, das auch schon seit einem Jahr auf einen Triumph wartet, stellte jedenfalls unter Beweis, dass das Auto auf dem welligen und anspruchsvollen Kurs unweit der deutschen Grenze am besten funktioniert.“"
                                            },
                                            {
                                                "example_id": "fb042213-f597-4c6f-904d-9f4a16c00af8",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Golf:] Auf einem welligen Grün ist es schwerer, zu putten."
                                            },
                                            {
                                                "example_id": "c6c195e8-bf07-49b2-b392-63037dad2879",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Skirennen:] „Die Bedingungen waren für alle schwierig, der Lauf war flüssig gesteckt, jedoch sehr wellig, so dass der eine oder andere Läufer ausgehoben wurde und es zu Stürzen und Torfehlern kam.“"
                                            },
                                            {
                                                "example_id": "5041df39-77fe-4d10-b22c-abc1ee9fd9c8",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Steigungen: Die Routen sind leicht wellig durch die Hügel des niederen Fläming.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
