                ],
                "senses": [
                    {
                        "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                        "entry_id": "6acbf438-1d50-3eed-947a-53956c832d95",
                        "glosses": [
                            "Gemälde oder Relief auf kreisrunder Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b22be0-28bb-40dd-99d6-2ab5b6d5aea9",
                                "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                                "text": "„Seinen Ursprung findet das Tondo in der toskanischen Malerei des Quattrocento, und es ist, wie auch noch im Cinquecento, thematisch in erster Linie mit Madonnendarstellungen und Anbetungen Christi besetzt.“"
                            },
                            {
                                "example_id": "587dfd15-516a-4103-befd-37ddc0c77718",
                                "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                                "text": "„In [Hans] Burgkmairs graphischer Synthese beweist sich der Tondo ebenso in seiner formerzeugenden wie formnegierenden Kraft.“"
                            },
                            {
                                "example_id": "3fbc6838-94b8-4afa-a8c3-17219baca033",
                                "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                                "text": "„In der Bogenrundung [Tympanon] darüber befindet sich ein Relief, das Maria mit dem Christuskind zeigt, in Form eines Tondos, das von zwei Engeln gehalten wird.“"
                            },
                            {
                                "example_id": "70d0ff86-9793-4265-a8e9-a6f5aaa5ffce",
                                "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                                "text": "„Im Deckengewölbe, an dem auch Sodoma und Jan Ruysch gemalt haben, hat Raffael vier Tondos (180 cm) geschaffen, mit Personifikationen der Theologie, des Rechts, der Poesie und der Philosophie.“"
                            },
                            {
                                "example_id": "9ef4c662-2c2f-4ad8-90ff-4dafa5396c94",
                                "sense_id": "37b8b505-344a-31b6-8208-616becd6d9e0",
                                "text": "„Wahrscheinlich wurde der Abschnitt der Südwand, die mit Innozenz I. (401–417) schloß, sowie die darauffolgenden fünf Rundbilder einschließlich Leos eigenem Bild noch in dessen Pontifikat ausgeführt. Von den 42 Tondi der Südwand sind glücklicherweise 40 ebenfalls erhalten geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
