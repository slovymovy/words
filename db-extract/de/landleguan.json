                        "examples": [
                            {
                                "example_id": "68994774-73ce-4ff2-aab8-fb1451dbd5c6",
                                "sense_id": "4252787a-8731-3c58-b9e9-a59de464df81",
                                "text": "„Forscher auf den Galapagosinseln haben ein halbes Dutzend Landleguane in ein neues Zuhause gebracht, um ihnen beim Überleben zu helfen.“"
                            },
                            {
                                "example_id": "b29dc6d0-445c-4db6-92c7-0d0d3abd032f",
                                "sense_id": "4252787a-8731-3c58-b9e9-a59de464df81",
                                "text": "„Die Konkurrenz eingeführter Haustiere um Lebensraum und Nahrung tat dann ein Übriges, so dass der Landleguan heute auf der Insel Santiago ausgestorben ist und auf den anderen Inseln nur noch in wenigen Exemplaren vorkommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
