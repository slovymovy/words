                        "examples": [
                            {
                                "example_id": "4c5bfc30-d195-40c6-b409-de35716ac1c8",
                                "sense_id": "29d08ce5-b014-342f-87b1-153c731dfbb6",
                                "text": "Al twintig jaar verzorgt Mona van Minden (69) ezels op De Ezelsociëteit in Zeist. „We vangen ongewenste en verwaarloosde ezels op. Als ze oud zijn blijven ze, voor de jongeren zoeken we een thuis.” Verder met de gebitscontrole van Goofert, de enige die haar ooit „een rotschop” verkocht. „Ik had haast, en bij een ezel moet je altijd rustig te werk gaan.”"
                            },
                            {
                                "example_id": "631e3d39-e86d-4ab9-a4ab-ff268c57badf",
                                "sense_id": "29d08ce5-b014-342f-87b1-153c731dfbb6",
                                "text": "In de dagen van de cloud wordt het denkwerk verricht door servers ver buiten handbereik, die zelden zeggen wat er aan mankeert. Ondertussen blijf je maar op F5 hameren om de browser te verversen. Net zolang totdat iemand bij Google wakker wordt en die server een rotschop geeft."
                            },
                            {
                                "example_id": "a461e505-8a8e-4ee5-a59e-22fb0c3005a7",
                                "sense_id": "29d08ce5-b014-342f-87b1-153c731dfbb6",
                                "text": "Ik vind het veel belachelijker dat scheidsrechters tegenwoordig maar voor alles een gele kaart geven. Spelbederf wordt daardoor even zwaar bestraft als iemand een rotschop geven."
                            }
