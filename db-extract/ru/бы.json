                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d33666e-162a-33a0-bb68-8e24466915cc",
                        "entry_id": "c883936a-9727-340c-acfc-a429b55e0762",
                        "glosses": [
                            "(wyrażenie możliwości) by"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2532bfa5-35f3-466a-9628-6ff07554a2a0",
                                "sense_id": "8d33666e-162a-33a0-bb68-8e24466915cc",
                                "text": "Я бы охотно поехал в Японию, если бы у меня были деньги и время.",
                                "translation": "Chętnie pojechałbym do Japonii, gdybym miał pieniądze i czas."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d829cd2a-4dc5-30ff-9da0-2e043b6a3ca6",
                        "entry_id": "c883936a-9727-340c-acfc-a429b55e0762",
                        "glosses": [
                            "(wyrażenie grzecznej prośby, propozycji) by"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "085241f3-63b9-4518-9da4-326a02b76430",
                                "sense_id": "d829cd2a-4dc5-30ff-9da0-2e043b6a3ca6",
                                "text": "Ты бы прилёг немного.",
                                "translation": "Położyłbyś się na trochę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b6cbc17c-dc34-3660-9215-9f1ee5de7731",
                        "entry_id": "c883936a-9727-340c-acfc-a429b55e0762",
                        "glosses": [
                            "(wyrażenie życzenia) żeby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298fb5fb-9c8c-4b18-b59f-30ddd6cf7fd6",
                                "sense_id": "b6cbc17c-dc34-3660-9215-9f1ee5de7731",
                                "text": "Выспаться бы наконец-то!",
                                "translation": "Ach, żeby się wyspać wreszcie!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "fc7ee975-5e36-3450-9655-1ff2e63c6a7a",
                        "entry_id": "c883936a-9727-340c-acfc-a429b55e0762",
