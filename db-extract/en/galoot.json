                    {
                        "translation_id": "a490810e-6484-4bb8-8871-76b0eb135f05",
                        "source_entry_id": "c9b5601c-ffd1-326a-b66a-00e50a8c4ca7",
                        "source_sense_id": "6b79759e-26dd-33dc-bffc-79fa3c4294a8",
                        "source_sense_description": "clumsy or uncouth person",
                        "target_lang_word": "Tölpel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tölpel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b906a143-f84c-3cc1-a25e-c73297722cea",
                                        "entry_id": "9e9a349f-7ac2-39c4-9244-61f39dd30634",
                                        "glosses": [
                                            "Meeresvogel der Familie Sulidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68562cf-d8c0-4eb0-85da-e5e1984e9d50",
                                                "sense_id": "b906a143-f84c-3cc1-a25e-c73297722cea",
                                                "text": "Der Tölpel ist ein Meeresvogel, der schwimmen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                        "entry_id": "9e9a349f-7ac2-39c4-9244-61f39dd30634",
                                        "glosses": [
                                            "plumper, ungeschickter, meist dummer Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f694b1-cd5a-4833-9604-cc5a457aafd5",
                                                "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                                "text": "Ein ungeschickter Mensch kann manchmal ein richtiger Tölpel sein."
                                            },
                                            {
                                                "example_id": "5abc0402-ae25-404e-b380-4e49333c80aa",
                                                "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                                "text": "„Sich trauen und abserviert zu werden ist erträglicher, als wie ein Tölpel darüber nachzugrübeln, was passieren könnte.“"
                                            },
                                            {
                                                "example_id": "4094cdf5-75c1-4fd9-ad43-0d344e0c62a2",
                                                "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                                "text": "„Sanzonio, so hieß mein Kamerad, konnte sich meiner Meinung nach darüber nicht beklagen, denn er war ein Tölpel; aber ich konnte es nicht ertragen, daß man mich ebenso behandelte wie ihn.“"
                                            },
                                            {
                                                "example_id": "28f827aa-2341-41aa-9922-b051f5465d02",
                                                "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                                "text": "„Wiewohl er zugegebenermaßen diese Worte über seinen Allergnädigsten Herrn und König also von sich gegeben, hoffe er trotz alledem, daß die Majestät in Höchstihrer Gnade einem armen Tölpel und törichten Bettler solch ein unsinniges Gefasel nachsichtsvoll verzeihen werde.“"
                                            },
                                            {
                                                "example_id": "1c98c4be-f28e-4776-9305-5becfb9a5bbd",
                                                "sense_id": "ae17fce4-78ef-3824-bc04-f9ad7ab333ef",
                                                "text": "„Übermäßig häufig hatte er während der letzten Monate wie ein Tölpel gehandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a0199df-4760-459f-996d-008a069c4c2d",
                        "source_entry_id": "c9b5601c-ffd1-326a-b66a-00e50a8c4ca7",
                        "source_sense_id": "6b79759e-26dd-33dc-bffc-79fa3c4294a8",
                        "source_sense_description": "clumsy or uncouth person",
                        "target_lang_word": "Dummkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                        "entry_id": "b5ab529b-6045-333b-aa6e-fa5857841d8c",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d766c218-9b4a-4a95-853b-f7216bb29309",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "Ich Dummkopf, dass ich die Schule abgebrochen habe!"
                                            },
                                            {
                                                "example_id": "cb12cc2a-833e-42e8-a38d-781479c290dd",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Nur Dummköpfe verlangen von euch, dass ihr eure Herkunft, eure Sprache und euren Glauben verleugnet.“"
                                            },
                                            {
                                                "example_id": "b0e128b8-38e9-4cbc-a6e9-ae178e29b143",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Heinrich Cuno ist ein unwissender Dummkopf, der sich vor Eitelkeit aufbläht.“"
                                            },
                                            {
                                                "example_id": "e24fcf47-41f7-4619-b127-a7ab3bd367c5",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Er war ein Dummkopf mit dem Verstand eines Hanswurstes und hielt alle, sie ihm zuhörten, für noch einfältiger.“"
                                            },
                                            {
                                                "example_id": "eb90df82-e3cd-4b6f-acf7-0cc6367134f7",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Ich muß an jener Frau wohl doch leidenschaftlicher gehangen haben, als ich selber wußte; sonst würde es mir nicht so schwerfallen, zuzugeben, daß jener Dummkopf sie geliebt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab313ce8-12ab-499e-a207-64c25f93e3de",
                        "source_entry_id": "c9b5601c-ffd1-326a-b66a-00e50a8c4ca7",
                        "source_sense_id": "6b79759e-26dd-33dc-bffc-79fa3c4294a8",
                        "source_sense_description": "clumsy or uncouth person",
                        "target_lang_word": "Steinzeitmensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinzeitmensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0b72c2a-5271-387a-9e57-b954a2890b45",
                                        "entry_id": "5bedb4b9-8c11-305d-ac82-00fe8189fce9",
                                        "glosses": [
                                            "Mensch, der in der Steinzeit gelebt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73b249a-6948-4b5c-a2b5-1cb6eb05558e",
                                                "sense_id": "f0b72c2a-5271-387a-9e57-b954a2890b45",
                                                "text": "„Die Physik verwirbelter Luft ist, vorsichtig ausgedrückt, anspruchsvoll. Durch Versuch und Irrtum jedoch entlockte schon der Steinzeitmensch Knochen oder Holzstücken Töne, die er zum Musikmachen oder zur Signalerzeugung brauchte. Richtig laut zu pfeifen gelang aber erst Joseph Hudson aus Birmingham.“"
                                            },
                                            {
                                                "example_id": "d3098b18-b9ca-4186-b08e-f7b4b6e5e12d",
                                                "sense_id": "f0b72c2a-5271-387a-9e57-b954a2890b45",
                                                "text": "„Die Schnittspuren waren sehr wahrscheinlich entstanden, als die Steinzeitmenschen das Fleisch von den Knochen und Sehnen lösten, um es leichter verzehren zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
