                        "source_entry_id": "6eed3b5b-5763-33fe-bb3b-9bc83abd2abd",
                        "source_sense_id": "11299066-b871-3a31-a5fe-308938c41c57",
                        "source_sense_description": "blog on which one posts brief updates",
                        "target_lang_word": "микробло́г",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "микробло́г",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "06e58ae2-98d0-36f3-a134-7d62f8f9be27",
                                        "entry_id": "208ab068-f206-3387-a5f1-a8af8aacc9ca",
                                        "glosses": [
                                            "комп., неол. разновидность блога, позволяющая писать короткие заметки, до 140 символов (длина одного SMS)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6e8092-fd0c-4641-a130-940e54c53403",
                                                "sense_id": "06e58ae2-98d0-36f3-a134-7d62f8f9be27",
                                                "text": "К зарегистрированному в сети Twitter микроблогу знаменитой американской телеведущей Опры Уинфри (Oprah Winfrey) за 24 первые часа присоединилось более ста тысяч «френдов»."
                                            },
                                            {
                                                "example_id": "295ccbf0-d281-4efd-a6d3-ed88df0412a2",
                                                "sense_id": "06e58ae2-98d0-36f3-a134-7d62f8f9be27",
                                                "text": "Многие издания посчитали, что бразилец, оценивая предстоящий 2010 год, отметил, что это его лучший шанс стать чемпионом мира, но в своём микроблоге Twitter гонщик рассказал, что его неправильно поняли"
                                            },
                                            {
                                                "example_id": "b411e061-0dfe-4e9e-a494-fdad2033f303",
                                                "sense_id": "06e58ae2-98d0-36f3-a134-7d62f8f9be27",
                                                "text": "За несколько дней бывший глава корпорации Microsoft успел не только завести микроблог на Twitter и вернуться на Facebook, но и открыть личный сайт под названием The Gates Notes («Заметки Гейтса»)"
                                            },
                                            {
                                                "example_id": "e7a24e4d-984a-4c62-9712-7c07189aa9db",
                                                "sense_id": "06e58ae2-98d0-36f3-a134-7d62f8f9be27",
                                                "text": "Джеймс Кокс создал микроблог CNNbrk в 2007 году и настроил туда трансляцию горячих новостей CNN, чтобы ему было удобнее открывать ссылки на новости с мобильного телефона."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
