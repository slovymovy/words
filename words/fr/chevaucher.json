    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc677889-f254-39d3-a5bc-cef553e55369",
                    "sense_definition": "Empiéter l'un sur l'autre, se recouvrir en partie dans l'espace ou dans le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recouvrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nos deux réunions se <w>chevauchent</w> de dix minutes, il faudra en décaler une."
                        },
                        {
                            "text": "Les tuiles du toit se <w>chevauchent</w> parfaitement pour empêcher l'eau de s'infiltrer."
                        }
                    ],
                    "synonyms": [
                        "empiéter",
                        "recouvrir"
                    ],
                    "common_phrases": [
                        "se chevaucher",
                        "chevaucher une ligne"
                    ]
                },
                {
                    "sense_id": "9bef9149-3f33-3ded-9a57-ab0cc3cd6724",
                    "sense_definition": "Être ou s'asseoir à califourchon sur quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "califourchon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'amuse à <w>chevaucher</w> le dossier du canapé comme s'il était un cow-boy."
                        },
                        {
                            "text": "Il préféra <w>chevaucher</w> sa chaise à l'envers pour écouter le débat attentivement."
                        }
                    ],
                    "common_phrases": [
                        "chevaucher une chaise",
                        "chevaucher une moto"
                    ]
                },
                {
                    "sense_id": "34d78539-8926-3161-a49d-169059673ee2",
                    "sense_definition": "Être situé de part et d'autre d'une limite géographique ou administrative.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recouvrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce parc naturel remarquable vient <w>chevaucher</w> deux régions limitrophes très différentes."
                        },
                        {
                            "text": "Le village semble <w>chevaucher</w> la frontière entre les deux pays alpins."
                        }
                    ],
                    "common_phrases": [
                        "chevaucher la frontière",
                        "chevaucher deux régions"
                    ]
                },
                {
                    "sense_id": "f61b56b0-c9dc-3084-bf0d-b55a84bf93ef",
                    "sense_definition": "Monter un cheval, voyager ou se déplacer à cheval.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier fatigué <w>chevauchait</w> depuis l'aube à travers les collines brumeuses."
                        },
                        {
                            "text": "Ils durent <w>chevaucher</w> toute la nuit pour avertir le roi du danger imminent."
                        }
                    ],
                    "common_phrases": [
                        "chevaucher toute la nuit",
                        "chevaucher à travers bois"
                    ],
                    "traits": [
                        {
