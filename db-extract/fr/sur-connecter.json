                "senses": [
                    {
                        "sense_id": "b8351aed-f670-3733-9c4f-8819557e90b9",
                        "entry_id": "830f49ba-c6f6-3de0-98a3-01f58fdf1289",
                        "glosses": [
                            "Se connecter par-dessus la session en cours sans la fermer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4430d6c6-b92f-45f3-8b60-ef6efe4a0d8c",
                                "sense_id": "b8351aed-f670-3733-9c4f-8819557e90b9",
                                "text": "Ces changements de session se font avec la commande su qui, sous un système UNIX ou GNU/Linux permet de se sur-connecter, c’est-à-dire de se connecter par-dessus la session en cours sans la fermer."
                            },
                            {
                                "example_id": "632da6ff-32e6-4a7e-a00a-0485eb21b24c",
                                "sense_id": "b8351aed-f670-3733-9c4f-8819557e90b9",
                                "text": "Se “sur-connecter” avec un autre uid et gid (Substitute User ) : su [-] [username]."
                            }
                        ]
                    },
                    {
                        "sense_id": "9687273f-5381-395a-b6c6-3a2ddc011c2c",
                        "entry_id": "830f49ba-c6f6-3de0-98a3-01f58fdf1289",
                        "glosses": [
                            "Se connecter de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8d39e3-b2cb-42e4-b38c-bddab73033d1",
                                "sense_id": "9687273f-5381-395a-b6c6-3a2ddc011c2c",
                                "text": "Le monde évolue, la technologie s’améliore et l’homme se sur-connecte !"
                            }
                        ]
                    }
