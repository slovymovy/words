                "senses": [
                    {
                        "sense_id": "dd83ae24-4a4e-346a-b3a7-806298ea8be3",
                        "entry_id": "ed6c6b8f-7a9b-3617-92fe-99893f898d60",
                        "glosses": [
                            "Betreiber einer Kantine"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "d4c0c501-6635-4fcb-bbc7-7686ea3e63d0",
                                "sense_id": "dd83ae24-4a4e-346a-b3a7-806298ea8be3",
                                "text": "„Der Kantineur freut sich auf einen modernen Gastrobereich mit Kühl- und Aufbewahrungsräumen ebenso wie der Obmann vom SK Fliesen Garber Werndorf Günther Nowak auf die neue Sportstätte.“"
                            },
                            {
                                "example_id": "d4f16109-708b-47f4-856c-98b7245a6bd8",
                                "sense_id": "dd83ae24-4a4e-346a-b3a7-806298ea8be3",
                                "text": "„In der ersten Ausgabe trifft es TV-Koch Didi Maier und Kantineur Gert Greier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ea3574-a444-4182-ac67-8702cde18cc6",
                        "source_entry_id": "ed6c6b8f-7a9b-3617-92fe-99893f898d60",
                        "source_sense_id": "dd83ae24-4a4e-346a-b3a7-806298ea8be3",
                        "source_sense_description": "Betreiber einer Kantine",
                        "target_lang_word": "cantinier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantinier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "708c8338-56d0-31ee-979d-5cbb7e478fe4",
                                        "entry_id": "ec9aa011-58ea-3347-853b-56904207bf47",
                                        "glosses": [
                                            "Qui relève d'une cantine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588960c4-dffa-4d0b-bfbe-5a5e165df8c1",
                                                "sense_id": "708c8338-56d0-31ee-979d-5cbb7e478fe4",
                                                "text": "Aline revint, languide, ﬂéchissante. Il n'osa lui demander de quoi elle avait souffert, et engagea très mal leur tête-à-tête cantinier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cantinier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6fd111-cff4-35d7-9001-6e2bc2b4faa2",
                                        "entry_id": "5b1188b5-77aa-35a5-92e7-ed4bc87a4f13",
                                        "glosses": [
                                            "Celui qui tient une cantine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937fcce2-a157-414a-bd6b-5ceb153bee3b",
                                                "sense_id": "fc6fd111-cff4-35d7-9001-6e2bc2b4faa2",
                                                "text": "Défenses sont faites à tous cantiniers de recevoir et de garder dans leur maison aucune guildive, sans la permission du juge de police."
                                            },
                                            {
                                                "example_id": "df74333d-c596-42dd-8942-6212ffff8264",
                                                "sense_id": "fc6fd111-cff4-35d7-9001-6e2bc2b4faa2",
                                                "text": "Les soudards s'arrêtèrent, les cantiniers vinrent à eux, leur vendirent du pain, du vin, de la bière, des viandes de toutes sortes."
                                            },
                                            {
                                                "example_id": "7b0ee610-9413-4d8a-a620-9678f13da1dc",
                                                "sense_id": "fc6fd111-cff4-35d7-9001-6e2bc2b4faa2",
                                                "text": "Un cantinier qui se rase sur l’accotement, sa glace pendue à un cerisier, attend avec nervosité, la figure débordant de mousse, que nous ayons fini de faire trembler la route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
