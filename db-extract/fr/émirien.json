                "senses": [
                    {
                        "sense_id": "9e244c9e-01d3-3e6c-a192-30a19ac60395",
                        "entry_id": "94fa828d-b83e-3a2d-8656-c9da1e9f98cb",
                        "glosses": [
                            "Originaire de, ou relatif aux Émirats arabes unis ^([1]) ^([2])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604adc25-3e43-4f9f-aa42-ee763afb450f",
                                "sense_id": "9e244c9e-01d3-3e6c-a192-30a19ac60395",
                                "text": "Le territoire émirien."
                            },
                            {
                                "example_id": "c21eaa79-e456-40ca-8d3f-50c58638d725",
                                "sense_id": "9e244c9e-01d3-3e6c-a192-30a19ac60395",
                                "text": "Le procès de cinq personnalités de la société civile émirienne, qui a lieu actuellement à Abu Dhabi, pourrait intéresser les Français lorsque l’on regarde de plus près les liens étroits entre notre pays et les Émirats arabes unis."
                            },
                            {
                                "example_id": "b5a46366-2fcd-4c00-b7ca-d5dee372ef29",
                                "sense_id": "9e244c9e-01d3-3e6c-a192-30a19ac60395",
                                "text": "Autant dire que la décision émirienne est un vrai coup porté au régime."
                            },
                            {
                                "example_id": "1e7e69c4-fdd0-49e5-b1d0-a06565c4c820",
                                "sense_id": "9e244c9e-01d3-3e6c-a192-30a19ac60395",
                                "text": "Il parlait ainsi de trois îlots émiriens annexés par l’Iran en 1971 et jamais restitués depuis."
                            }
                        ]
                    }
                ],
