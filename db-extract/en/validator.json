                                                "sense_id": "1a8ab3d7-e3a4-3fa8-8f15-397910b09088",
                                                "text": "Mais l'article 50 de la loi de 1988 ne renferme aucun indice d'une portée rétroactive, interprétative ou validatrice."
                                            }
                                        ]
                                    }
                                ]
                            },
