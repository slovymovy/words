                                        "examples": [
                                            {
                                                "example_id": "488d99e5-7e99-4749-bc51-9742bbb075d4",
                                                "sense_id": "bb76ea14-98ec-3be7-8ada-8695064912ab",
                                                "text": "Hervé cheminait à contre-vent sur des quais exposés a toutes les bises."
                                            },
                                            {
                                                "example_id": "b0952809-edde-4f86-8f0c-ecc58ac34df2",
                                                "sense_id": "bb76ea14-98ec-3be7-8ada-8695064912ab",
                                                "text": "Coupe-t-on sous le vent, ou bien à contre-vent?\nPas à contre-vent, car, si le vent renvoyait contre le moissonneur la paille et l'épi, les yeux et les mains auraient trop à souffrir."
                                            }
