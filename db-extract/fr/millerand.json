                ],
                "senses": [
                    {
                        "sense_id": "d0d28984-4a59-3735-9ee0-5196e676675e",
                        "entry_id": "014054b6-0b00-3b8e-a1db-fe952fa8b4b3",
                        "glosses": [
                            "Aux grains très petits, en grand nombre. Avortement partiel des grains de raisin."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "3829c50a-f081-4083-a762-3fd334b3b9e1",
                                "sense_id": "d0d28984-4a59-3735-9ee0-5196e676675e",
                                "text": "Raisins millerands, raisins donnant des grains très petits, en grand nombre, et dépourvus de pépins. Cette anomalie est due à des pluies et du froid survenus au moment de la floraison."
                            },
                            {
                                "example_id": "cff46966-eea4-4459-9e0c-d09f240792e2",
                                "sense_id": "d0d28984-4a59-3735-9ee0-5196e676675e",
                                "text": "Il s’agit de millerandage, qui provient d’une fécondation imparfaite de la vigne. Les raisins dont les fleurs d’origine ont été mal fécondées restent petits et se développent sans pépins. À maturité, ces baies sont plus sucrées. On parle de raisins “millerands”."
                            }
                        ]
                    }
                ],
