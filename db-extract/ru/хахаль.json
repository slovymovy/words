                "senses": [
                    {
                        "sense_id": "c878927a-c6c7-380c-b135-36d7ff4031d4",
                        "entry_id": "8d133c81-0a6f-37e3-8e62-124b3fdec2a0",
                        "glosses": [
                            "прост. ухажёр, любовник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9073fb80-7eb3-4ef7-90d5-b4b8d43a3a8a",
                                "sense_id": "c878927a-c6c7-380c-b135-36d7ff4031d4",
                                "text": "Чтобы московских скосырей да казанских хахалей тут не было — вот про что говорю."
                            },
                            {
                                "example_id": "70040a29-331c-47b8-ad2c-674db062ea74",
                                "sense_id": "c878927a-c6c7-380c-b135-36d7ff4031d4",
                                "text": "А мамзель сейчас своему хахалю: «Душка, вели, чтоб извозчик ехал скорей»."
                            }
                        ]
                    }
                ],
