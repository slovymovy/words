                                            {
                                                "example_id": "ec20bded-570d-47e1-a259-f74b356187ae",
                                                "sense_id": "18eafbea-a054-300c-9be8-1d10af38909b",
                                                "text": "Who shall pull this sword from the stone is rightful king of England.ᵂ"
                                            },
                                            {
