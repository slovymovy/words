                "senses": [
                    {
                        "sense_id": "786d5ac8-88bd-309b-a4da-214833a1e21f",
                        "entry_id": "f1815e96-124b-3b8f-9967-2faa74942451",
                        "glosses": [
                            "Variante de peinturlurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fa3dcc-87b4-46b3-b1b3-3f8cc682851a",
                                "sense_id": "786d5ac8-88bd-309b-a4da-214833a1e21f",
                                "text": "Est-ce que je finirai par m’empeinturlurer l’esprit ?"
                            },
                            {
                                "example_id": "eaeeb25c-4c5d-4886-8a2b-2ca5fe8014d9",
                                "sense_id": "786d5ac8-88bd-309b-a4da-214833a1e21f",
                                "text": "Lequel annonçait au même moment son intention d’« empeinturlurer le musée de Tervuren par hélicoptère », un an plus tard, jour pour jour."
                            },
                            {
                                "example_id": "9e355d45-f4de-4c3d-8545-5bc87265a1f3",
                                "sense_id": "786d5ac8-88bd-309b-a4da-214833a1e21f",
                                "text": "Le commando de trois Moldaves qui, au cours de la même nuit, avaient badigeonné plusieurs autres bâtiments du VIIᵉ arrondissement projetaient aussi, selon les informations du « Canard », d’empeinturlurer le Mémorial d’Omaha Beach, en Normandie."
                            }
                        ]
                    }
