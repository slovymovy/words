{
    "word_family": [
        "бытие",
        "быт",
        "былой",
        "бывший"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecb1fcf7-5e69-3714-bb65-b0b426f7b920",
                    "sense_definition": "Посещать какое-либо место или находиться где-то в течение некоторого времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я часто <w>бываю</w> в этом парке по выходным.",
                            "target_lang_translations": {
                                "pl": "Często <w>bywam</w> w tym parku w weekendy."
                            }
                        },
                        {
                            "text": "Вы когда-нибудь <w>бывали</w> в Москве?",
                            "target_lang_translations": {
                                "pl": "Czy kiedykolwiek <w>byliście</w> w Moskwie?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "часто бывать",
                        "бывать в гостях"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odwiedzać jakieś miejsce lub przebywać gdzieś od czasu do czasu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bywać",
                                "target_lang_sense_clarification": "znajdować się w jakimś miejscu regularnie lub czasami"
                            },
                            {
                                "target_lang_word": "być",
                                "target_lang_sense_clarification": "odwiedzić jakieś miejsce (np. w przeszłości)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24f75194-ef9e-3845-8603-b5ded2deb54d",
                    "sense_definition": "Происходить, случаться время от времени или регулярно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такие ошибки <w>бывают</w> у всех начинающих учеников.",
                            "target_lang_translations": {
                                "pl": "Takie błędy <w>zdarzają się</w> wszystkim początkującym uczniom."
                            }
                        },
                        {
                            "text": "В этом регионе часто <w>бывают</w> сильные дожди осенью.",
                            "target_lang_translations": {
                                "pl": "W tym regionie jesienią często <w>bywają</w> ulewne deszcze."
                            }
                        }
                    ],
                    "synonyms": [
                        "случаться",
                        "происходить"
                    ],
                    "common_phrases": [
                        "часто бывает",
                        "иногда бывает",
                        "всякое бывает"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydarzać się, zdarzać się co jakiś czas lub regularnie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdarzać się",
                                "target_lang_sense_clarification": "mieć miejsce od czasu do czasu"
                            },
                            {
                                "target_lang_word": "bywać",
                                "target_lang_sense_clarification": "mieć miejsce, dziać się czasami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe674aad-df18-3eb9-9971-4a20d62a9f5f",
                    "sense_definition": "Существовать или встречаться в реальности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Таких редких животных в природе почти не <w>бывает</w>.",
                            "target_lang_translations": {
                                "pl": "Takich rzadkich zwierząt w przyrodzie prawie <w>nie ma</w>."
                            }
                        },
                        {
                            "text": "Чудес в реальной жизни не <w>бывает</w>.",
                            "target_lang_translations": {
                                "pl": "Cuda w prawdziwym życiu <w>nie istnieją</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "существовать"
                    ],
                    "target_lang_definitions": {
                        "pl": "Istnieć lub występować w rzeczywistości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "istnieć",
                                "target_lang_sense_clarification": "występować w świecie rzeczywistym"
                            },
                            {
                                "target_lang_word": "być",
                                "target_lang_sense_clarification": "mieć rację bytu, występować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f24cbba-593e-331d-866e-9a9a6ccb6eb1",
                    "sense_definition": "Использоваться как неформальное прощание при уходе.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Мне пора идти, <w>бывай</w>!",
                            "target_lang_translations": {
                                "pl": "— Muszę już iść, <w>trzymaj się</w>!"
                            }
                        },
                        {
                            "text": "— Ну, <w>бывайте</w>, увидимся на следующей неделе.",
                            "target_lang_translations": {
                                "pl": "— Cóż, <w>trzymajcie się</w>, do zobaczenia w przyszłym tygodniu."
                            }
                        }
                    ],
                    "synonyms": [
                        "пока",
                        "прощай"
                    ],
                    "common_phrases": [
                        "ну бывай"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Разговорный стиль, часто используется в молодежной среде."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Potoczne pożegnanie używane przy rozstaniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trzymaj się",
                                "target_lang_sense_clarification": "potoczne pożegnanie do jednej osoby"
                            },
                            {
                                "target_lang_word": "bywaj",
                                "target_lang_sense_clarification": "archaiczne lub potoczne pożegnanie"
                            },
                            {
                                "target_lang_word": "narazie",
                                "target_lang_sense_clarification": "potoczne pożegnanie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}