                        "sense_id": "272a4334-c750-3469-a97f-af644ce60ac1",
                        "entry_id": "690bc40d-f890-3083-9ba7-1cd2947fd23b",
                        "glosses": [
                            "Ensemble de pratiques paraissant archéologiques, mais qui ne respectent pas les méthodes scientifiques et qui proposent éventuellement des théories fantaisistes."
                        ],
                        "tags": [
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "da53d9f0-08b4-4d7d-8fc8-70d0ba826141",
                                "sense_id": "272a4334-c750-3469-a97f-af644ce60ac1",
                                "text": "Certaines théories du complot utilisent la pseudoarchéologie comme argumentation."
                            }
                        ]
                    }
                ],
