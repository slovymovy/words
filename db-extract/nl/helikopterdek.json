                        "glosses": [
                            "voorziening op een schip of gebouw waarop een helikopter kan landen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f381d76d-a20a-4c38-9288-cb7679bd1b23",
                                "sense_id": "b492c4f4-235e-3989-8e07-adaea74606e0",
                                "text": "Ongeveer een uur na de eerste meldingen bij de politie wordt de verdachte, Fouad L., aangehouden bij het ziekenhuis, onder het helikopterdek. Hij had een vuurwapen op zak en droeg een kogelwerend vest."
                            },
                            {
                                "example_id": "514d40ca-4120-4384-bdf0-ae339f4f2f42",
                                "sense_id": "b492c4f4-235e-3989-8e07-adaea74606e0",
                                "text": "Het helikopterdek van de Zr. Ms. Zeeland verandert kort na 09.00 uur in een plein vol knuffelende en zoenende mensen. Het schip is weer terug en dat betekent dat de bemanning na ruim vier maanden hun familie weer in de armen kan sluiten."
                            },
                            {
                                "example_id": "ebef3731-06be-4a08-99b5-1a652915cf9a",
                                "sense_id": "b492c4f4-235e-3989-8e07-adaea74606e0",
                                "text": "De Symphony is ruim honderd meter lang en veertien meter breed. Het heeft zes verdiepingen, een lift, zwembaden, twaalf jacuzzi's en een helikopterdek. De eigenaar heeft naar verluidt 165 miljoen euro betaald."
                            }
                        ]
                    }
