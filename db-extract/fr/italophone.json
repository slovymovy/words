                "senses": [
                    {
                        "sense_id": "41e7ef1d-71ef-36db-91e8-ba593074f013",
                        "entry_id": "64531b16-2c8b-38e0-9ff3-8703ff9c98a7",
                        "glosses": [
                            "Personne parlant la langue italienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "accd9f1e-bd66-4394-86d1-007559719639",
                                "sense_id": "41e7ef1d-71ef-36db-91e8-ba593074f013",
                                "text": "Réciproquement, les traductions du français à la langue maternelle prennent souvent une allure de calque du français par la répétition de pronoms personnels qu’un italophone laisserait normalement en implicite."
                            },
                            {
                                "example_id": "84329f37-204e-4176-8bed-77513aa9807f",
                                "sense_id": "41e7ef1d-71ef-36db-91e8-ba593074f013",
                                "text": "Aujourd’hui encore les germanophones restent les plus nombreux (les deux tiers de la population, contre moins d’un tiers pour les italophones et une petite proportion de Ladins)."
                            }
                        ]
                    }
                ],
