                "senses": [
                    {
                        "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                        "entry_id": "0b652356-b34c-3319-b364-ca6a4e250305",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ae3e3d-eb80-49ce-88f2-71d07d086d17",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Frau Hemmerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35fcc85a-49cc-4d74-a389-bd6b15616950",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Herr Hemmerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "971d7148-23d0-4e20-bb50-db4f658e0027",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Die Hemmerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "69ca2e61-0baf-4c37-ab2e-8b68e19c2a54",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Der Hemmerle trägt nie die Pullover, die die Hemmerle ihm strickt."
                            },
                            {
                                "example_id": "1a84169a-9e94-4fc8-b150-a31412804b0e",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hemmerle kommt, geht der Herr Hemmerle.“"
                            },
                            {
                                "example_id": "f090e681-7ef8-497a-bcc1-b7b3082c4769",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Hemmerle kommt und geht."
                            },
                            {
                                "example_id": "379e7435-c069-4635-81de-bb2f38f687f1",
                                "sense_id": "d070a1d1-2d3c-3d7b-8c7b-791b85c8a2c6",
                                "text": "Hemmerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
