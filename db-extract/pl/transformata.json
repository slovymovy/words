                                        "examples": [
                                            {
                                                "example_id": "cc2904d9-dd92-4a4a-8dca-c92945812658",
                                                "sense_id": "addb7511-fdaf-3212-8e50-9f934f29d3d7",
                                                "text": "Le vieux port était voué à la plaisance comme celui de Tréboul et le Port-Rhu qui, après une intense activité de commerce et de construction navale, avait vu sa ria transformée en musée où s’ancraient les vieux bateaux encore à flot."
                                            },
                                            {
                                                "example_id": "0072a446-0fde-4c4a-887a-c5c23797e92a",
                                                "sense_id": "addb7511-fdaf-3212-8e50-9f934f29d3d7",
                                                "text": "Dans la chapelle de Lambader transformée en vestiaire, Valentin Dluz rappelle les dernières consignes à ses troupes, leur recommande de prendre son plaisir et leur transmet le message de Jean-Louis Jossic, fondateur des Tri Yann et parrain de l’événement qui leur a adressé une vidéo d’encouragement."
                                            }
                                        ]
                                    }
