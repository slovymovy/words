                        "target_lang_word": "unwichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "656f4460-b20a-3392-8920-4b69aac8f911",
                                        "entry_id": "daad6cc5-d2ac-3830-9428-7e77abac201d",
                                        "glosses": [
                                            "nicht wichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35dee81-9b83-4a3f-aec1-3f76cf3c297f",
                                                "sense_id": "656f4460-b20a-3392-8920-4b69aac8f911",
                                                "text": "Ob du die Sachen nach der Prüfung noch weißt, ist unwichtig."
                                            },
                                            {
                                                "example_id": "b97d3e5f-5a1c-4302-8550-59b9e5d815a8",
                                                "sense_id": "656f4460-b20a-3392-8920-4b69aac8f911",
                                                "text": "Danke, das war eine nicht ganz unwichtige Frage."
                                            },
                                            {
                                                "example_id": "6e77089f-0808-46b2-899e-ebe1072000fe",
                                                "sense_id": "656f4460-b20a-3392-8920-4b69aac8f911",
                                                "text": "Wieso tauchst du persönlich hier auf, wenn der Brief eine völlig unwichtige Sache ist?"
                                            },
                                            {
                                                "example_id": "94e3f938-42b8-4e13-a06f-1a5fcb4905cc",
                                                "sense_id": "656f4460-b20a-3392-8920-4b69aac8f911",
                                                "text": "Ihr Alter ist ein kleines, aber nicht unwichtiges Faktum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65d3b22a-e07a-4664-8293-8b62971e7efd",
