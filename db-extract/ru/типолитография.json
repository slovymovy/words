                "senses": [
                    {
                        "sense_id": "2713b605-a586-31e0-9673-eb0f2579f9f0",
                        "entry_id": "9d19b598-708f-35a7-86c9-2a96fb9d481c",
                        "glosses": [
                            "полиграфическое предприятие, осуществляющее печатание способом высокой - типографской — и плоской - литографской или офсетной — печати; типография, имеющая в своем составе литографию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b349814f-10d8-476b-bcb3-7c47b0ad10bc",
                                "sense_id": "2713b605-a586-31e0-9673-eb0f2579f9f0",
                                "text": "Был я десятником при устройстве канализации, был кочегаром в Азовском пароходстве, чертежником, коммивояжером, учеником у зубного врача, таскал кули на пристани, вот в этом самом городе наборщиком служил в типолитографии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a604e076-bd95-45b0-9aef-a60e69087f8a",
                        "source_entry_id": "9d19b598-708f-35a7-86c9-2a96fb9d481c",
                        "source_sense_id": "2713b605-a586-31e0-9673-eb0f2579f9f0",
                        "target_lang_word": "typolitography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "53f618a5-5587-405b-aca1-a30e107262be",
                        "source_entry_id": "9d19b598-708f-35a7-86c9-2a96fb9d481c",
                        "source_sense_id": "2713b605-a586-31e0-9673-eb0f2579f9f0",
                        "target_lang_word": "Allrounddruckerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ae38903e-e546-4519-a5f9-d9b964c951db",
                        "source_entry_id": "9d19b598-708f-35a7-86c9-2a96fb9d481c",
                        "source_sense_id": "2713b605-a586-31e0-9673-eb0f2579f9f0",
                        "target_lang_word": "Druckerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druckerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733085d8-4561-3cb0-99b7-8ad762e3c023",
                                        "entry_id": "de48df75-b1dd-327f-92a0-1307d9ba18e1",
                                        "glosses": [
                                            "Betrieb, in dem Bücher, Prospekte, Zeitungen, Zeitschriften oder andere Druckerzeugnisse hergestellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8858334b-2314-409a-967b-764fabb5df52",
                                                "sense_id": "733085d8-4561-3cb0-99b7-8ad762e3c023",
                                                "text": "„Mehrere der wenigen noch verbliebenen unabhängigen Zeitungen mussten in den vergangenen Monaten wegen des Entzugs der Lizenz, der Verweigerung von Papierkontingenten oder Problemen mit der Druckerei ihr Erscheinen einstellen.“"
                                            },
                                            {
                                                "example_id": "07cbc86a-12d0-43f6-87d0-87d49cd9a525",
                                                "sense_id": "733085d8-4561-3cb0-99b7-8ad762e3c023",
                                                "text": "„Die Anfänge der Druckerei und Schriftgießerei Offizin Haag-Drugulin lassen sich bis in die Mitte des 18. Jahrhunderts zurückverfolgen.“"
                                            },
                                            {
                                                "example_id": "ac659b87-b518-4d82-85d8-e15e855ffbf8",
                                                "sense_id": "733085d8-4561-3cb0-99b7-8ad762e3c023",
                                                "text": "„Bald nach 19 Uhr kamen die ersten regulären Spätausgaben der Zeitungen aus den Druckereien.“"
                                            },
                                            {
                                                "example_id": "5196433b-a576-4f3e-b7f9-f1a85e41e7d0",
                                                "sense_id": "733085d8-4561-3cb0-99b7-8ad762e3c023",
                                                "text": "„Sein Vater hieß Ingvald, und er arbeitete in der Druckerei der Buchhandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb4ee49c-1fc2-3fdc-834f-bde277c75d96",
                                        "entry_id": "de48df75-b1dd-327f-92a0-1307d9ba18e1",
                                        "glosses": [
                                            "Buchdruckerkunst"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d4aa1b-4d5c-47eb-9d8d-eb3fd00df145",
                                                "sense_id": "fb4ee49c-1fc2-3fdc-834f-bde277c75d96",
                                                "text": "Er widmete sein ganzen Leben der Druckerei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51b82ebf-a019-3d8a-b15a-b86f7d29168f",
                                        "entry_id": "de48df75-b1dd-327f-92a0-1307d9ba18e1",
                                        "glosses": [
                                            "etwas Gedrucktes"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cf1381-02f8-45b5-8fd6-820af63a6b16",
                                                "sense_id": "51b82ebf-a019-3d8a-b15a-b86f7d29168f",
                                                "text": "Er veröffentlicht regelmäßig dünne Lyrikbändchen, aber seine Druckereien liest niemand."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
