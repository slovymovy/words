                    },
                    {
                        "sense_id": "7335f8e9-e38e-3d7b-b473-58fb86c6c918",
                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                        "glosses": [
                            "Repeatedly performing the same quest or similar in-game activity in order to amass points or wealth."
