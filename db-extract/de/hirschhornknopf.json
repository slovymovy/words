                        "glosses": [
                            "Knopf, hergestellt aus Hirschhorn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc7f1b3-7302-4c07-abd0-22df6df65860",
                                "sense_id": "a7d190c5-5c71-3260-aa9b-53d951ed6083",
                                "text": "„Ich hatte mir eine Jacke für Jerusalem gekauft, einen Janker mit Hirschhornknöpfen, und er funktionierte.“"
                            },
                            {
                                "example_id": "b372e812-f4c2-497a-a095-bfcc8c5839d1",
                                "sense_id": "a7d190c5-5c71-3260-aa9b-53d951ed6083",
                                "text": "„In sein Zögern hinein pries der Jüngere die Vorzüge des Stücks, wies auf das wärmende Futter, in das Flicken eingenäht waren, sowie auf die Hirschhornknöpfe hin und widerlegte die Bedenken des Älteren mit einem Schwall von Worten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
