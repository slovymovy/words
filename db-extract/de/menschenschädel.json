                "senses": [
                    {
                        "sense_id": "97544108-e715-3e59-b5fd-e7901c9637ec",
                        "entry_id": "2efebce5-bd6e-357a-9340-d6749c92a5e3",
                        "glosses": [
                            "Schädel eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4d52f0-f727-442c-9a58-99e72fd228ea",
                                "sense_id": "97544108-e715-3e59-b5fd-e7901c9637ec",
                                "text": "„Die Siedler behaupteten, das Wesen habe nur ein Opfer gefunden; ich hielt diese Einschätzung allerdings für unzutreffend, da ich neben einem vollständigen Menschenschädel ein Bruchstück entdeckte, das mit Sicherheit irgendwann zu einem anderen menschlichen Schädel gehört hatte.“"
                            },
                            {
                                "example_id": "a1c7d71c-6a84-4b4e-9e0a-c7983a530a09",
                                "sense_id": "97544108-e715-3e59-b5fd-e7901c9637ec",
                                "text": "„Zwischen Gesetzbüchern von Maryland und juristischen Fachschriften stand eine Sammlung von Menschenschädeln – zumeist karikaturhafte Nachbildungen, nur einer war echt –, die es mit jeder Vitrine eines Anthropologen hätten aufnehmen können.“"
                            },
                            {
                                "example_id": "cc5c33ea-ff36-4714-88e4-159e1a552088",
                                "sense_id": "97544108-e715-3e59-b5fd-e7901c9637ec",
                                "text": "„Er platzierte das Blatt auf Laymans Schreibtischunterlage, beschwerte es mit einem als Büroschmuck dienenden Menschenschädel und marschierte zurück auf County-Gebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
