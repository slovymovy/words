        "nl-extract.jsonl": [
            {
                "entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                "word": "hoewel",
                "pos": "conj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                        "entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                        "glosses": [
                            "drukt een tegenstelling met het voorafgaande uit"
                        ],
                        "tags": [
                            "onderschikkend"
                        ],
                        "examples": [
                            {
                                "example_id": "b7bde37c-dce1-431a-9f3f-6f5571942c7c",
                                "sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                                "text": "Hij is gelukkig, hoewel hij niet rijk is."
                            },
                            {
                                "example_id": "195696f4-0f89-4fe1-bb66-93dc45b3d23f",
                                "sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                                "text": "Hoewel de feesten de hoofdrol spelen, hebben ook enkele andere inspirerende en schilderachtige figuren een plaats gekregen. Zoals Franciscus, Hieronymus en Christofoor, die de hele wereld (het Christuskind) op zijn schouder draagt."
                            },
                            {
                                "example_id": "2f532fcc-129a-4734-a7b6-060d67ad61a6",
                                "sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                                "text": "Het pad voor me, niet meer dan 25 cm breed, zou mij door de staten Californië, Oregon en Washington leiden. Na een jaar lang plannen, lezen, onderzoeken, sparen en trainen ging mijn avontuur eindelijk beginnen, hoewel ik eigenlijk geen idee had waar ik aan begon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "430d97bd-690f-4006-ac62-6c327c2e2ea0",
                        "source_entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                        "source_sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                        "source_sense_description": "drukt een tegenstelling uit",
                        "target_lang_word": "obwohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obwohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                        "entry_id": "5f2c84a9-a8eb-377a-860a-0ea66aa0fd5a",
                                        "glosses": [
                                            "leitet einen Nebensatz (Konzessivsatz) ein, der einen Gegengrund zu der Hauptaussage nennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7e075c-6cc3-488d-b70b-382592c06dc8",
                                                "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                                "text": "Das Fenster war wieder zu, obwohl ich es geöffnet hatte."
                                            },
                                            {
                                                "example_id": "c3805a08-1f53-4c03-b849-2e05fb424bdd",
                                                "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                                "text": "Obwohl sie mich nicht besonders mag, hat sie mich zu ihrer Party eingeladen."
                                            },
                                            {
                                                "example_id": "26deaa55-a173-4286-b32a-3eac9117054c",
                                                "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                                "text": "Ich bin hingefahren, obwohl ich zu viel Arbeit hatte."
                                            },
                                            {
                                                "example_id": "0dbab376-51c6-42a0-9ee0-9d1b2d649fd4",
                                                "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                                "text": "Er meinte Ja, obwohl er Nein gesagt hat."
                                            },
                                            {
                                                "example_id": "86128983-0b68-49b1-9e0b-3cea626c0dbb",
                                                "sense_id": "8925a675-b795-333d-aaa2-7d7f75ac4106",
                                                "text": "„Obwohl“ kann nur in der Einleitung eines Nebensatzes verwendet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c47a381e-e742-41ab-adea-2516a9841d08",
                        "source_entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                        "source_sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                        "source_sense_description": "drukt een tegenstelling uit",
                        "target_lang_word": "obgleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obgleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e08ff548-3de8-3723-8130-a6bcbfac8e11",
                                        "entry_id": "bcad6339-60e5-3dd2-ad59-9e64f51c2217",
                                        "glosses": [
                                            "leitet einen Nebensatz (Konzessivsatz) mit einem für die Hauptaussage nicht entscheidenden Gegengrund ein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd1bad7-4bb9-4fad-85cb-1387864051e7",
                                                "sense_id": "e08ff548-3de8-3723-8130-a6bcbfac8e11",
                                                "text": "Er geht zur Arbeit, obgleich er stark erkältet ist."
                                            },
                                            {
                                                "example_id": "2627a8e8-ce8c-4e79-b3b7-ce7ffcf830ad",
                                                "sense_id": "e08ff548-3de8-3723-8130-a6bcbfac8e11",
                                                "text": "„Vielleicht habe ich den Psalm nicht ganz wortgetreu im Gedächtnis behalten, obgleich ich ihn nachher noch oft gelesen habe…“"
                                            },
                                            {
                                                "example_id": "83cc476b-722e-4a88-936b-dbe8e3b9c43b",
                                                "sense_id": "e08ff548-3de8-3723-8130-a6bcbfac8e11",
                                                "text": "„Obgleich ich durch die Ketten an meinen Handgelenken behindert war, war ich im Nu oben und beugte mich hinunter, um Ben nachzuholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "274286b5-5352-411b-93f8-5d8b1610fb8d",
                        "source_entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                        "source_sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                        "source_sense_description": "drukt een tegenstelling uit",
                        "target_lang_word": "although",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "although",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                        "entry_id": "b3ddc799-961b-31e8-8efa-1cd2855466fc",
                                        "glosses": [
                                            "Though, even though, in spite of or despite the fact that: introducing a clause that expresses a concession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986be2ce-2ef1-4ad5-a6cf-d473f444cd26",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "Although it was very muddy, the football game went on."
                                            },
                                            {
                                                "example_id": "4b23c010-4e31-48a5-978d-deb831777ede",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "The patients, (al)though getting stronger, will not come off their medications."
                                            },
                                            {
                                                "example_id": "44dda5db-ed69-4498-84ec-5ba62ec1bbea",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "Although proven, the accusation was ignored by the court."
                                            },
                                            {
                                                "example_id": "9ff4b368-d712-4ddf-b78a-1224c77872da",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "And moreover, much leſs can this poyſonouíneſs be produced from the Lead. For although it being long detained in the Body, and there reſolved, likeunto other Metals, (if it contract any ruſtineſs) it may poſſibly do hurt: but yet neverthleſs, that in this its moment any paſſage through the Body there ſhould be any poyſon imprinted by it upon the Body, this can no waybe."
                                            },
                                            {
                                                "example_id": "f6aa4324-57b7-4410-a290-c9ec189a9345",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "77c909ac-14ca-47c3-93e1-a41d35d6c427",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man's private calendar, took most of them by surprise although they had been well prepared."
                                            },
                                            {
                                                "example_id": "03dee591-6a3d-433d-8907-9ab28d6061b8",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "With the north London derby to come at the weekend, Spurs boss Harry Redknapp opted to rest many of his key players, although he brought back Aaron Lennon after a month out through injury."
                                            },
                                            {
                                                "example_id": "2f6ea81e-2bec-4e39-9897-724f59d5b50b",
                                                "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ccea8b0-bfbc-3dce-a0bd-8729c20c702e",
                                        "entry_id": "b3ddc799-961b-31e8-8efa-1cd2855466fc",
                                        "glosses": [
                                            "But, except."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87bdafaa-d673-4e27-a5da-35797e79fa8b",
                                                "sense_id": "9ccea8b0-bfbc-3dce-a0bd-8729c20c702e",
                                                "text": "It was difficult, although not as difficult as we had expected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "483bf82b-4167-46f7-bc37-a390f045c8f6",
                        "source_entry_id": "8ffe39cf-56a3-3c37-b07f-a03aee25f3a6",
                        "source_sense_id": "cfe9f90a-7687-30ed-bfdb-b1b83d5dda6c",
                        "source_sense_description": "drukt een tegenstelling uit",
                        "target_lang_word": "quoique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quoique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                        "entry_id": "325311c0-eda3-3298-a375-429cc46768c0",
                                        "glosses": [
                                            "Encore que ; bien que."
                                        ],
                                        "tags": [],
                                        "note": "il est alors généralement suivi du subjonctif",
                                        "examples": [
                                            {
                                                "example_id": "fba46eeb-285f-49be-90a6-458bed890c50",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "Aussi, quoique le combat fût long et acharné, quoi qu’il fît en courageux et habile homme d’armes, il ne put résister à la force que donnait au comte Karl la conscience de son droit, […]."
                                            },
                                            {
                                                "example_id": "183d0eae-d8ea-43c3-9133-04117433bbf6",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "Quoique mes croisées dominassent la plus grande partie de leur jardin, je n'avais jamais vu mes tristes voisines."
                                            },
                                            {
                                                "example_id": "8f0944aa-4ffc-4049-aaa5-b62ae1ad519d",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "Quoiqu’il résidât dans la ville principale de Mars, Ulfète, nulle cité ne le réclamait comme citoyen."
                                            },
                                            {
                                                "example_id": "37ab9a92-b80a-4e9e-a323-a90ad241fdfd",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "La soirée était agitée et bruyante ; le conducteur avait peur, quoiqu’il se fût imbibé d'alcool. Les chevaux avaient peur."
                                            },
                                            {
                                                "example_id": "7a458d49-3c08-41f8-8e13-2ae1d4d9c713",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "Dressé sur l’échelle légère et tremblante, en saule de marais, il cueillait sans relâche, leste comme un écureuil, promptement quoique sans se hâter, […]."
                                            },
                                            {
                                                "example_id": "00706998-f4fa-48a4-8d3b-5eb31a7c4ad2",
                                                "sense_id": "1f9f2e74-8938-32f7-bac5-e4386e103c1b",
                                                "text": "Je dirai donc simplement que la vue et la santé de Valville, quoique encore convalescent, ranimèrent presque tout à coup mes esprits ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c54b20e-9303-31a9-9865-9357323fba0b",
                                        "entry_id": "325311c0-eda3-3298-a375-429cc46768c0",
                                        "glosses": [
                                            "Mais, cependant, réflexion faite."
                                        ],
                                        "tags": [],
                                        "note": "il est alors généralement suivi de l'indicatif ou du conditionnel",
                                        "examples": [
                                            {
                                                "example_id": "ed0afbe8-05ad-49cd-badc-15e99999db7c",
                                                "sense_id": "1c54b20e-9303-31a9-9865-9357323fba0b",
                                                "text": "Ce serait bien que j'aille là-bas, quoique mes parents risquent de me manquer."
                                            },
                                            {
                                                "example_id": "51b8e8e7-ea0b-4895-a33a-f118d3ff4b5d",
                                                "sense_id": "1c54b20e-9303-31a9-9865-9357323fba0b",
                                                "text": "Ton récit est très bien, quoique (il est) un peu court."
                                            },
                                            {
                                                "example_id": "903c5fc0-eaaf-41c7-9b9e-99ba34f924af",
                                                "sense_id": "1c54b20e-9303-31a9-9865-9357323fba0b",
                                                "text": "Mais tu as vraiment retrouvé une maman toute neuve quoiqu’un peu fragile. (Pourquoi ai-je dit quoique ? pensait-elle. Ah que les mots me laissent tranquille quand je suis si près d’autre chose où ils périront tous d’un seul coup !)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68c9e070-85a1-3f5f-a6d0-2241c68ff61d",
                                        "entry_id": "325311c0-eda3-3298-a375-429cc46768c0",
                                        "glosses": [
                                            "Utilisé seul, et prononcé en détachant bien les deux syllabes, il exprime une objection à ce qui vient d’être dit juste avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e723136c-fe04-4d68-8b18-5789c3260578",
                                                "sense_id": "68c9e070-85a1-3f5f-a6d0-2241c68ff61d",
                                                "text": "– Crois-moi ou pas, mon p’tit, mais ça me fait bizarre à moi aussi. Quoique, pour dire toute la vérité, je ne regrette pas ce foutu col romain, tout amidonné, qui me serrait le kiki toute la sainte journée ! On aurait dit qu’il voulait m’étrangler, ce col de malheur..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
