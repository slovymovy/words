                "senses": [
                    {
                        "sense_id": "667addd6-0732-3029-8b1a-54c3ccd049c2",
                        "entry_id": "3b2bdb7f-0ec7-3f58-ac0e-40cb9c0f8e68",
                        "glosses": [
                            "Variété de gros cornichon couramment consommé dans les pays slaves, de saveur peu acide, que l’on fait macérer avec des aromates et du sucre dans de la saumure à faible teneur en sel."
                        ],
                        "tags": [
                            "En apposition"
                        ],
                        "examples": [
                            {
                                "example_id": "a2b073e8-a7d7-4904-a885-65fbdf2cc3de",
                                "sense_id": "667addd6-0732-3029-8b1a-54c3ccd049c2",
                                "text": "On parle de tout en buvant du vin blanc en croquant des gros cornichons malossol ou du saucisson polonais, et bien souvent on termine avec de la vodka à l’herbe de bison."
                            },
                            {
                                "example_id": "2ad50078-9021-46e5-9fb4-0418b16aa676",
                                "sense_id": "667addd6-0732-3029-8b1a-54c3ccd049c2",
                                "text": "Nous sommes retournées à la cuisine où ma mère m’a préparé un sac avec un pot de cornichons malossol, mes préférés, que je mangeais enfant à quatre heures pour le goûter. J’aimais leur mélange de mollesse et de croquant, leur fade saveur aigre-douce."
                            }
                        ]
                    },
                    {
                        "sense_id": "41c66dea-fc9a-380d-abb0-f6758a098e94",
                        "entry_id": "3b2bdb7f-0ec7-3f58-ac0e-40cb9c0f8e68",
                        "glosses": [
                            "Cornichon malossol."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "aa7ef4d4-77ac-49ef-bd6e-75b4925d43e0",
                                "sense_id": "41c66dea-fc9a-380d-abb0-f6758a098e94",
                                "text": "David lui mit dans la bouche un gros cornichon au sel. — Qu’est-ce que c’est ? — Un malossol. Elle en reprit un, tellement chargé de saumure qu’en le croquant elle éclaboussa sa tunique."
                            },
                            {
                                "example_id": "008cf2f0-fbba-4c0e-94c6-9224d1bc247b",
                                "sense_id": "41c66dea-fc9a-380d-abb0-f6758a098e94",
                                "text": "C’était un menu slave. Poissons marinés, disposés en fines lamelles, caviar agglutiné en cônes, pain noir et pain blanc, assortis de malossols, et une multitude de fruits rouges : mûres, airelles, framboises."
                            }
                        ]
                    },
                    {
                        "sense_id": "938795d3-4670-38ad-abb8-40084d9ac0e9",
                        "entry_id": "3b2bdb7f-0ec7-3f58-ac0e-40cb9c0f8e68",
                        "glosses": [
                            "Caviar russe préparé dans une saumure faiblement salée (moins de 4% de sel)."
                        ],
                        "tags": [
                            "En apposition"
                        ],
                        "examples": [
                            {
                                "example_id": "c898ce1f-88ec-47ec-b636-cb5a2a0ff6fe",
                                "sense_id": "938795d3-4670-38ad-abb8-40084d9ac0e9",
                                "text": "Ils se sont lavé les mains et nous sommes passés à table. De la limande meunière, du caviar malossol, du pain noir et un petit stakan de spirt. Le spirt est fourni par le kolkhoze, deux stakan par jour et par tête."
                            }
                        ]
                    }
