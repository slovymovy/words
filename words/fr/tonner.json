                        {
                            "text": "Au loin, on pouvait entendre les canons <w>tonner</w> sans interruption.",
                            "target_lang_translations": {
                                "en": "In the distance, you could hear the cannons <w>thundering</w> without pause.",
                                "ru": "Вдали было слышно, как без перерыва <w>гремели</w> пушки.",
                                "nl": "In de verte kon men de kanonnen zonder onderbreking horen <w>bulderen</w>.",
                                "de": "In der Ferne konnte man die Kanonen ohne Unterbrechung <w>donnern</w> hören.",
                                "pl": "W oddali słychać było, jak armaty bez przerwy <w>grzmią</w>.",
                                "it": "In lontananza si sentivano i cannoni <w>tuonare</w> senza sosta.",
                                "cs": "Z dálky bylo slyšet, jak děla bez přestání <w>hřmí</w>.",
                                "tr": "Uzaklardan toplar durmaksızın <w>gümbürdüyordu</w>.",
                                "es": "A lo lejos se podía oír cómo <w>tronaban</w> los cañones sin interrupción.",
                                "zh": "远处能听到大炮不停地<w>轰鸣</w>。"
                            }
                        },
                        {
                            "text": "La batterie se mit à <w>tonner</w> dès le début du concert.",
                            "target_lang_translations": {
                                "en": "The drums began to <w>thunder</w> as soon as the concert started.",
                                "ru": "Барабаны начали <w>греметь</w> с самого начала концерта.",
                                "nl": "Vanaf het begin van het concert begon het slagwerk te <w>bulderen</w>.",
                                "de": "Gleich zu Beginn des Konzerts fing das Schlagzeug an zu <w>dröhnen</w>.",
                                "pl": "Perkusja zaczęła <w>dudnić</w> już na początku koncertu.",
                                "it": "La batteria cominciò a <w>rimbombare</w> fin dall'inizio del concerto.",
                                "cs": "Hned na začátku koncertu začaly bicí <w>dunět</w>.",
                                "tr": "Konserin daha başında davul <w>gümbürdemeye</w> başladı.",
                                "es": "La batería empezó a <w>retumbar</w> desde el inicio del concierto.",
                                "zh": "演唱会一开始，架子鼓就<w>隆隆作响</w>了。"
                            }
                        }
