                "translations": [
                    {
                        "translation_id": "bf86a513-e8f3-447a-86f4-852c8f516dc5",
                        "source_entry_id": "6ba39a73-f431-3f29-9c36-7ad4ae56c97d",
                        "source_sense_id": "b0df1768-fa74-3fee-90a7-985169da77ec",
                        "source_sense_description": "de wetenschap van de wijnbereiding",
                        "target_lang_word": "Önologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Önologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                        "entry_id": "18894748-4028-32d6-a917-87723beb3110",
                                        "glosses": [
                                            "Lehre, Technik und Methoden der Weinproduktion, insbesondere der Traubenverarbeitung, Chemie und Mikrobiologie des Weines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c073da13-ca47-48d0-9fa6-256644f3951a",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "Ziel der Önologie ist die Produktion von Spitzenweinen."
                                            },
                                            {
                                                "example_id": "5b94d8c8-ac43-4a5a-8c0a-5fea5cd15951",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "Das Bachelorstudium „Weinbau, Önologie und Weinwirtschaft“ existiert in Österreich seit dem Wintersemester 2004."
                                            },
                                            {
                                                "example_id": "a18b9e8b-e6fc-4db6-b51e-723b594947d5",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "Wo sich die Fundamentalisten unter den Weinfreunden über das Chaptalisieren, das Zukkern, aufregten, müßten sie eigentlich die gesamte Önologie verdammen, meint der Spezialist."
                                            },
                                            {
                                                "example_id": "88a4e51d-a13f-4854-82f7-64de3511da69",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "Müssen Bücherleser das Verlagsgeschäft kennen? Ebenso wenig, wie Weintrinker Önologie studiert haben müssen."
                                            },
                                            {
                                                "example_id": "7d1a7574-1b9a-414b-be0c-ac650d51f269",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "Die St. Laurent-Rebe zählt noch zu den großen Geheimnissen der Önologie."
                                            },
                                            {
                                                "example_id": "da4b60c0-1e87-458c-8b0c-d1f9efc1689c",
                                                "sense_id": "60ad9e83-b35a-3e07-8d0d-7fa9860b6695",
                                                "text": "„Der Grund hierfür war, dass er, Sohn eines geadelten, auch in Deutschland bekannten Champagnerfabrikanten aus Reims, zum künftigen Firmenchef bestimmt, nach Vaters Willen in Deutschland Agrarwirtschaft und Önologie studierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
