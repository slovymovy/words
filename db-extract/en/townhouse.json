                    {
                        "translation_id": "9ea50d4a-1cec-43a4-95e2-d8a434380873",
                        "source_entry_id": "55ffc7ba-c2ed-31be-8aeb-a7ad00fc915c",
                        "source_sense_description": "house in an urban setting",
                        "target_lang_word": "таунха́ус",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "таунха́ус",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e20ad451-8e51-30b5-8022-4b472d4f9688",
                                        "entry_id": "668545d6-376f-3bff-b6c8-33ef1fb10f58",
                                        "glosses": [
                                            "небольшой городской дом или коттедж ленточной застройки, стоящий в ряду таких же домов, соединённых друг с другом боковыми стенами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ffe9f3-38a1-45e3-abe6-0316462c2ddc",
                                                "sense_id": "e20ad451-8e51-30b5-8022-4b472d4f9688",
                                                "text": "— Скажите, Алексей, что такое таунхаус? Чем он отличается от обычного загородного дома? — Таунхаусы — это сблокированные малоэтажные дома. То есть у нескольких домов обязательно есть общая несущая стена. Могут быть две и даже три общие стены, в зависимости от того, как дома расположены."
                                            },
                                            {
                                                "example_id": "cff9116d-3662-4dca-a0a8-0e59ea4fa9cf",
                                                "sense_id": "e20ad451-8e51-30b5-8022-4b472d4f9688",
                                                "text": "В Европе таунхаусы оценили давно: в Средние века появление «прилепленных» друг к другу домов обусловливалось дороговизной городской земли, а в XIX в. — времени первого «расцвета» сблокированного строительства — желанием застройщиков сэкономить"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ab5a948-be33-38d7-8332-217466eb1058",
                                        "entry_id": "668545d6-376f-3bff-b6c8-33ef1fb10f58",
                                        "glosses": [
                                            "комплекс таких коттеджей, расположенный за пределами центра города"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4622510b-b263-4e47-8b58-f458bfeaa3cf",
                                                "sense_id": "9ab5a948-be33-38d7-8332-217466eb1058",
                                                "text": "Коммуны богемы, обитавшие в заброшенных заводах, интерьеры которых были максимально не похожи на обычные жилые помещения, бросали вызов обществу: хорошим тоном в те времена считалось жить в пригородном таунхаусе, но никак не в подобном месте."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
