                        "widely understood",
                        "little understood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, которого поняли; постигнутый, осознанный.",
                        "zh": "指某事已被领会，或某人感到自己的想法被他人所理解。"
                    },
                    "translations": {
                        "ru": [
