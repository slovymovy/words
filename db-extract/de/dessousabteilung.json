                "senses": [
                    {
                        "sense_id": "4ab4d58c-a604-3f5c-903c-9d7f8cf113e7",
                        "entry_id": "ead7dd84-cd79-36ac-9e60-e09ec3806db7",
                        "glosses": [
                            "Teil eines Bekleidungsgeschäfts, in dem elegante Unterwäsche angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f2f726-0416-4570-81e8-93e54d940d09",
                                "sense_id": "4ab4d58c-a604-3f5c-903c-9d7f8cf113e7",
                                "text": "„Sie hat einige schöne Kleider gefunden, die sie einpacken lässt, und plötzlich ist ihr danach, auch einmal der Dessousabteilung einen Besuch abzustatten, dort hat sie noch nie geschaut.“"
                            },
                            {
                                "example_id": "bcd72fa1-36bb-4849-842c-0cda8a3f91a5",
                                "sense_id": "4ab4d58c-a604-3f5c-903c-9d7f8cf113e7",
                                "text": "„In einem Zeitalter, in dem uns aus jedem Cafe und jeder Dessousabteilung klassische Violinkonzerte entgegentönen, bedarf es einiger Phantasie, den Mut dieser Männer und den Radikalismus ihres Unternehmens zu verstehen.“"
                            },
                            {
                                "example_id": "bc702964-2543-4f9c-ba8d-6e00ff5772b1",
                                "sense_id": "4ab4d58c-a604-3f5c-903c-9d7f8cf113e7",
                                "text": "„Bei den Klautouren in der Dessousabteilung des örtlichen Kaufhauses, die während der High-School-Zeit angesagt waren, bin ich teils deshalb nicht mitgegangen, weil ich wusste, dass es Unrecht war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
