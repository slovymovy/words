                "senses": [
                    {
                        "sense_id": "ddbf39ad-7d6f-3613-9f07-1a55b4d962c0",
                        "entry_id": "f9e54dfa-2ec4-30c5-8c8e-836f05ef5f34",
                        "glosses": [
                            "Qui aime les bagnoles et qui, souvent, utilise la voiture comme moyen de transport privilégié, parfois au détriment des autres."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6940ff8b-93b8-49eb-8196-d73c025f842e",
                                "sense_id": "ddbf39ad-7d6f-3613-9f07-1a55b4d962c0",
                                "text": "A Woluwé Saint Lambert, malgré que la commune est traversée par le premier ICR réalisé à Bruxelles, Mr Désir est toujours pro bagnolard et ne facilite pas la tâche des écoliers qui veulent rejoindre leur établissement scolaire à vélo !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5bee4b9-af33-3f3a-b8f3-c78309130f4a",
                        "entry_id": "f9e54dfa-2ec4-30c5-8c8e-836f05ef5f34",
                        "glosses": [
                            "Qui est conçu uniquement pour les véhicules motorisés au détriment des autres modes de transport."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "efed6e2c-a560-446e-a796-5869f74b12fa",
                                "sense_id": "a5bee4b9-af33-3f3a-b8f3-c78309130f4a",
                                "text": "Pour le maire, la gratuité doit agir comme un « choc psychologique et social » dans sa ville, « une des plus “bagnolardes” de France »."
                            }
                        ]
                    },
                    {
                        "sense_id": "90950570-1725-38f0-9540-4b787c9ded4e",
                        "entry_id": "f9e54dfa-2ec4-30c5-8c8e-836f05ef5f34",
                        "glosses": [
                            "Qui développe l’industrie et/ou l’économie automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356bef2d-79f2-4907-8a63-2044e461f80a",
                                "sense_id": "90950570-1725-38f0-9540-4b787c9ded4e",
                                "text": "Comparons également la taille du dit pays et affirmez-moi que Italie + France + GB + Allemagne ne serait pas un « pays » au moins aussi bagnolard avec toutes ses marques, son histoire, ses clubs, ses artisans…"
                            }
                        ]
                    }
