                ],
                "senses": [
                    {
                        "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                        "entry_id": "9d8a26ec-a260-3dcf-b23e-0d2f805555dc",
                        "glosses": [
                            "Anrede und Kosename für einen Menschen, den man gern hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e11fc1-3b97-4d7d-b48b-af600998902c",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "Darling, möchtest du meine Frau werden?"
                            },
                            {
                                "example_id": "21ec7243-f431-471e-b228-5c7fc0d55ad2",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Plötzlich sind die Deutschen die Darlinge der gesamten Fußball-Welt.“"
                            },
                            {
                                "example_id": "d17ffc3b-362c-4430-ab93-ebe07ad588e9",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Tatsächlich arbeitet er für den in Saudi-Arabien beheimateten Satellitensender ‘Iqraa’, empfängt Schecks von saudischen Millionären (‘nur von seriösen’) und balanciert damit automatisch in den Grauzonen der saudischen und ägyptischen Regime, die ihrerseits den Spagat vollführen, die Darlinge der USA zu sein und zugleich ihre selbst gezüchtete islamistische Riesenkrake unter Kontrolle zu halten.“"
                            },
                            {
                                "example_id": "c7ffb98d-780f-4fa1-8488-d76003bd382d",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Jack Black, Mos Def, Danny Glover und Mia Farrow sind die Darlinge, die sich Gondry für seinen neuen ‘Confusing’-Hit ausgesucht hat.“"
                            },
                            {
                                "example_id": "033dfb3c-7065-4a0b-8efa-bbfbd6cf2dc3",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Zur Erinnerung: Im Vorjahr hagelte es Preise für klassische Kinofilme wie ‘1917’ von Sam Mendes oder die analog gedrehte Hommage ‘Once Upon a Time … in Hollywood’ von Quentin Tarantino, während bei den Oscars Bong Joon-hos Satire ‘Parasite’ sowohl Hollywoods Darlingen als auch den Streamingdiensten die Show stahl und als Sieger des Abends strahlte.“"
                            },
                            {
                                "example_id": "9ade8cf5-7670-4df2-95ca-03451ca9d2eb",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Während Gladbachs Spieler überall in Europa begehrt sind und Marco Rose als einer der Darlinge der neuen deutschen Trainer-Welle gefeiert wird, ist bei Schalke alles trist.“"
                            },
                            {
                                "example_id": "ce96152d-0770-43ee-af90-2e5473e89d70",
                                "sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                                "text": "„Ich erwähnte ja bereits, dass Sie bei der Überarbeitung gnadenlos vorgehen und bereit sein müssen, ›die Darlinge zu killen‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2d11bd0-d0b1-40df-9eb3-8f1128b5cf27",
                        "source_entry_id": "9d8a26ec-a260-3dcf-b23e-0d2f805555dc",
                        "source_sense_id": "1aa0a073-1fc5-3ff7-a5c6-d7a98c68cf86",
                        "source_sense_description": "Anrede und Kosename für einen Menschen, den man gern hat",
                        "target_lang_word": "amour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Sentiment intense et agréable qui incite les êtres à s’unir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3fb7688-73b1-4c83-82fb-d4b423d26087",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Dans Thomas l’imposteur, il avait combiné à une apparence de psychologie « rudimentaire » des aperçus ou constats très fins et pénétrants, dépatinant les sentiments les plus convenus (amour, plaisir, ambition), les sortant du lieu commun."
                                            },
                                            {
                                                "example_id": "3a8b0e94-c51e-458e-8aea-1c9a84584417",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Non, l’amour, sentiment naïf et chaste qui se voile de pudeur et de fierté au sanctuaire du cœur, n’est point cette tendresse cavalière qui répand les larmes de la coquetterie par les yeux du masque de l’innocence !"
                                            },
                                            {
                                                "example_id": "6a2af8c6-cd36-4390-809a-b9a71742aa2e",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "[…] l’entière affection de cet homme, qui répondit par un amour unique à un unique amour, tout avait réconcilié cette pauvre femme avec la vie."
                                            },
                                            {
                                                "example_id": "e72f0495-aac3-4a13-acce-9f46b298156e",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Or savez-vous quels sont ses deux instincts naturels, irrésistibles dans l’ordre psychique? c’est l’amour et la liberté. Ces deux instincts naturels se sont socialement combattus jusqu’à présent ; il a fallu que l’homme immolât ou plutôt subordonnât l’un à l’autre."
                                            },
                                            {
                                                "example_id": "dec318a9-2040-49a0-a10c-97f03d484fee",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Déjà, Jacques aimait Yasmina, follement, avec toute l’intensité débordante d’un premier amour chez un homme à la fois très sensuel et très rêveur en qui l’amour de la chair se spiritualisait, revêtait la forme d’une tendresse vraie…"
                                            },
                                            {
                                                "example_id": "d35cc060-ebce-445d-ba45-2ab08b919464",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "L’amour, par l’enthousiasme qu’il engendre, peut produire le sublime sans lequel il n’y aurait point de morale efficace."
                                            },
                                            {
                                                "example_id": "93b740f0-8620-4a02-a522-df0d20b69448",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "L’homme a inventé les dieux et il a créé l’amour avec son cortège de sensibleries ridicules ou criminelles. L’amour a donné naissance au poète, puis au psychologue et, pour couronner l’humaine sottise, à cet enfonceur de portes ouvertes qui s’est baptisé psychanalyste. Le paladin du refoulement et l’écuyer servant la Haute Dame Libido."
                                            },
                                            {
                                                "example_id": "973e7b8e-52a4-4941-9a81-8c047a7f6771",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Personne que je sache, n’a encore osé dire que l’amour tel qu’on l’imagine de nos jours est la négation pure et simple du mariage que l’on prétend fonder sur lui."
                                            },
                                            {
                                                "example_id": "e2ae9e74-a452-4777-a023-baaaa39b762c",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Je percevais au tremblement de leur voix, au miel de leurs paroles, cette terrible servitude qui les liait à ce qu’on nomme l’amour, d’un mot trop doux parce qu’on ne veut pas lui donner son véritable visage de bestialité et d’animalité."
                                            },
                                            {
                                                "example_id": "30cf63fd-4f40-4994-8016-479f1d8ff51f",
                                                "sense_id": "c8af5be3-53b9-3a1b-a1d9-3ad3036266ee",
                                                "text": "Je veux mourir ès amoureux combats,\n Soûlant l'amour, qu'au sang je porte enclose,\n Toute une nuit au milieu de tes bras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Sentiment intense et agréable qui incite les êtres à s’unir.",
                                            "Affection profonde pour quelqu’un ou quelque chose. Affect éprouvé lié à la libido qui fait tendre le sujet vers un objet affectif qui peut être une autre personne ou une partie d’une autre personne ou un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5162fb2a-79ba-48aa-8af2-78d3987159fb",
                                                "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                                "text": "[…] ce cœur qui s’ignorait soi-même avait tourné toutes ses pensées vers ses enfants, qu’elle s’était mise à adorer de toutes les forces virginales de l’amour maternel, le plus beau et le plus sain de tous."
                                            },
                                            {
                                                "example_id": "a5a0aec1-a44a-40a1-bc0c-b4703a97ff3e",
                                                "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                                "text": "De toutes les villes du département du Nord, Douai est, hélas! celle qui se modernise le plus, où le sentiment innovateur a fait les plus rapides conquêtes, où l’amour du progrès social est le plus répandu."
                                            },
                                            {
                                                "example_id": "1bec7eb2-e14c-4174-9daa-fc2b2c5b2c39",
                                                "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                                "text": "[…] j’avais tâché d’en donner l’impression à Françoise en ne laissant pas paraître devant elle ma souffrance, parce que, même au moment où je l’éprouvais avec une telle violence, mon amour n’oubliait pas qu’il lui importait de sembler un amour heureux, un amour partagé, surtout aux yeux de Françoise qui, n’aimant pas Albertine, avait toujours douté de sa sincérité."
                                            },
                                            {
                                                "example_id": "57dcb563-44fd-44cd-b011-32fe4bf24a5a",
                                                "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                                "text": "Je regarde MM. les délibérants aux assemblées d’élection et les députés aux États-généraux comme des juges aux pieds desquels tous ceux qu’anime l’amour du bien public doivent apporter le tribut de leurs pensées."
                                            },
                                            {
                                                "example_id": "f1e6ef28-b27b-45fe-bc1a-308d14e9ca30",
                                                "sense_id": "b8c6c7fb-d35e-355f-9a27-b2182f1b2362",
                                                "text": "« Amour cérébral ? » Ne m’ennuyez pas avec cette sottise. Direz-vous que l’amour qui précipitait ces foules ingénues vers le tombeau du Christ était cérébral ? Et croyez-vous qu’on aime autrement la France ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca7c681-db0d-3400-85af-0c719808375b",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Plaisir, intérêt, voire obsession."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea27611-aff6-4e84-a62c-b13a4172f347",
                                                "sense_id": "5ca7c681-db0d-3400-85af-0c719808375b",
                                                "text": "Elle accomplissait humblement et avec amour toutes les minuties de la vie vulgaire au Chalet, elle s’en servait comme d’un frein pour enserrer le poème de sa vie idéale, à l’instar des Chartreux qui régularisent la vie matérielle et s’occupent pour laisser l’âme se développer dans la prière."
                                            },
                                            {
                                                "example_id": "710e8350-bfd3-4bae-acb9-4ad355c9efb6",
                                                "sense_id": "5ca7c681-db0d-3400-85af-0c719808375b",
                                                "text": "Dupin a reproché aussi aux Morvandeaux leur amour de la chicane. Ce reproche me surprend de la part d’un avocat-plaidant (de 1800 à 1811), mais enfin l’accusation est fondée."
                                            },
                                            {
                                                "example_id": "99cb45cd-603d-4fea-8ce9-75777282d67e",
                                                "sense_id": "5ca7c681-db0d-3400-85af-0c719808375b",
                                                "text": "Le soir est venu. Il se lève une grande lune ronde, un grand plateau d’étain que doivent considérer avec amour, en ce moment, l’artilleur à barbe noire et le ténor."
                                            },
                                            {
                                                "example_id": "fc8e8265-02f2-42af-ab49-a4f6f011c75a",
                                                "sense_id": "5ca7c681-db0d-3400-85af-0c719808375b",
                                                "text": "Cette glace fondait un tantinet à midi mais regelait le soir, et, chaque matin, on commençait par la repolir avec amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Copulation, relation sexuelle, union charnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33fb6f8c-fb2a-4432-879e-93771a48353e",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "Qu’il me baise des baisers de sa bouche.\nTes amours sont plus délicieuses que le vin ;\nL’arôme de tes parfums est exquis."
                                            },
                                            {
                                                "example_id": "726be9e8-1a3b-4d57-83b8-a77c09078dde",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "nᵒ 3 L’amour physique. […] Tout le monde connaît l’amour fondé sur ce genre de plaisir; quelque sec et malheureux que soit le caractère, on commence par là à seize ans."
                                            },
                                            {
                                                "example_id": "9da48af6-95ae-4b26-87ec-7274d340408c",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "Pourtant, comme il arrive à quelques officiers que leur vie errante et des timidités cachées sous une apparence martiale ont condamnés à des amours de passage, Scilly connaissait trop peu les femmes pour apprécier combien était réelle cette naïveté et à quelle profondeur d’ignorance du mal vivaient les deux Marie-Alice."
                                            },
                                            {
                                                "example_id": "1d9b8488-e151-4b2a-8556-3655e54a61e2",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "Le crapaud manque de tendances sociales. C’est un solitaire, un ermite. Sauf au printemps pour l’amour, il ignore ses semblables."
                                            },
                                            {
                                                "example_id": "9897e6be-4c1c-4854-ae55-bdcd2cd7c7e7",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "Née d’amours fugitives à l’avant dernier printemps, Fuseline, la petite fouine […], était, […], venue de la lisière du bois de hêtres et de charmes."
                                            },
                                            {
                                                "example_id": "c180607d-e87d-4924-8c67-3afbfd99f17b",
                                                "sense_id": "c4fcb669-3739-3352-b4f0-67d9e825768f",
                                                "text": "Car l’amour est un art, comme la musique. Il donne des émotions du même ordre, aussi délicates, aussi vibrantes, parfois peut-être plus intenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c263aa-02db-3935-b4e3-9793c4c12e82",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Ce qui est aimé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f568c85-9975-38a1-8e5a-fd581ba2935c",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Ce qui est aimé.",
                                            "Personne aimée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8600745c-5f8f-4e22-811a-745e771dc5fe",
                                                "sense_id": "5f568c85-9975-38a1-8e5a-fd581ba2935c",
                                                "text": "Il y avait parmi ces Sauvages un vieillard nommé Chactas, qui, par son âge, sa sagesse, et sa science dans les choses de la vie, était le patriarche et l’amour des déserts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3686eef4-f353-3963-85df-f2e2b5e50669",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Ce qui est aimé.",
                                            "Chose aimée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b9b0f5-28c3-497e-ba44-3486622bddbd",
                                                "sense_id": "3686eef4-f353-3963-85df-f2e2b5e50669",
                                                "text": "Ils plaignent la famille des oiseaux, la bergeronnette […], et le rouge-gorge dont la rose, ses amours, s’effeuille au vent."
                                            },
                                            {
                                                "example_id": "82559b3b-a4ad-46bb-98bc-5e674a46b394",
                                                "sense_id": "3686eef4-f353-3963-85df-f2e2b5e50669",
                                                "text": "Moi, je crois sans vous faire tort, que vous avez quelque nouvel amour en tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dac528-5c7c-3a1f-b70a-158a69abe970",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Représentation, allégorie du dieu Amour, sous la forme d’un putto ou d’un cupidon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c86b6aee-1a24-4073-bb43-03f9e1cc4417",
                                                "sense_id": "e1dac528-5c7c-3a1f-b70a-158a69abe970",
                                                "text": "C’est, dans un département lointain, une petite propriété que ne décore aucune boule en verre, et où l’œil le mieux exercé ne saurait rencontrer le moindre kiosque japonais, ni le prétentieux bassin de rocailles avec son amour nu en plâtre et son impudique jet d’eau qui retombe."
                                            },
                                            {
                                                "example_id": "9e539e94-59f8-405a-b052-b681904e1a5e",
                                                "sense_id": "e1dac528-5c7c-3a1f-b70a-158a69abe970",
                                                "text": "[…]; une colossale figure du « Temps », soulève Terre et cadran sur ses vigoureuses épaules, tandis que des anges joufflus, des Amours pour mieux dire, se jouent tout autour, voletant et dégringolant jusque sur le fronton."
                                            },
                                            {
                                                "example_id": "59a82a24-52fe-491a-9e14-1d816d0b8d6b",
                                                "sense_id": "e1dac528-5c7c-3a1f-b70a-158a69abe970",
                                                "text": "La maîtresse de maison fait aussi distribuer dans la rue, dans les hôtels ou dans les gares, des cartes joliment ornées d’un amour ou d’un nu féminin et qui indiquent la nature et l’adresse de son établissement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175867a1-c1c9-3e5f-ae36-1bf0006fde6b",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "État de fermentation propre à la végétation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6fa8e7-c9c3-4a26-bc31-57c9c6bed9af",
                                                "sense_id": "175867a1-c1c9-3e5f-ae36-1bf0006fde6b",
                                                "text": "Amour de la terre, ou terre en amour. Expression dont se servent les jardiniers & les fermiers mêmes. Ils disent : la terre entre en amour, ou est en amour, lorsque les pluies printanières ayant commencé à tomber, & le soleil devenant fort, il s’établit, dans la terre, une fermentation qui fait monter la sève dans les végétaux."
                                            },
                                            {
                                                "example_id": "531afe4e-cf94-479c-8830-126c8eec5012",
                                                "sense_id": "175867a1-c1c9-3e5f-ae36-1bf0006fde6b",
                                                "text": "Quand la terre en amour chante son gai réveil,\nQuand le printemps lascif vient réjouir le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c710e4a-92e4-3303-b460-d82b4f02d912",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Désir d’accomplir le bien d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13677ce-c3c1-4ea6-b67c-e2e3bbc3e0e6",
                                                "sense_id": "8c710e4a-92e4-3303-b460-d82b4f02d912",
                                                "text": "Voir en autrui un homme et se comporter en homme à son égard, c’est agir moralement ; tout l’« amour spirituel » du Christianisme n’est rien d’autre."
                                            },
                                            {
                                                "example_id": "38150057-8166-49e7-a44f-584c2e5e2cd7",
                                                "sense_id": "8c710e4a-92e4-3303-b460-d82b4f02d912",
                                                "text": "Dans ses discours, il défendit avec force cette thèse que la stricte observance des lois religieuses doit s’accompagner, pour devenir méritoire, de la pratique de la justice et de l’amour du prochain, envers les juifs comme envers les non-juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb22c7e7-5563-353b-91de-d447b2048ceb",
                                        "entry_id": "44d68fc9-2238-3b39-9872-f06c856408f6",
                                        "glosses": [
                                            "Dernières gouttes d’une bouteille de vin servies à une personne aimée."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bffd43b-ad1d-4fbf-b568-729f400143e0",
                                                "sense_id": "cb22c7e7-5563-353b-91de-d447b2048ceb",
                                                "text": "S’il le trouve convenable, il sert ensuite à tour de rôle aux convives un vin propre, pour revenir ensuite vers l’élue de son cœur à qui il sert « les amours », les dernières gouttes de la bouteille qui ont toutes les vertus, qui portent chance et signifiaient beaucoup."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
