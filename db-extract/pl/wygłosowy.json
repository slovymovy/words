                "senses": [
                    {
                        "sense_id": "62823eae-a29d-355d-a580-2255759e8b84",
                        "entry_id": "b62339af-2128-30a4-937f-13747b57b8e4",
                        "glosses": [
                            "znajdujący się w wygłosie, na końcu wyrazu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62536003-b4c1-4a90-ad64-24c084302bd6",
                                "sense_id": "62823eae-a29d-355d-a580-2255759e8b84",
                                "text": "W XV w. w całej Polsce wymawiano jeszcze dokładnie wygłosowe nosówki."
                            },
                            {
                                "example_id": "a17ec8ba-1058-4f72-8a3c-d8cb072442a3",
                                "sense_id": "62823eae-a29d-355d-a580-2255759e8b84",
                                "text": "Spółgłoska wygłosowa, wymawiana z reguły bezdźwięcznie udźwięcznia się w wymowie wszystkich Polaków, jeśli następny wyraz rozpoczyna się od spółgłoski dźwięcznej zwarto-wybuchowej lub zwarto-szczelinowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
