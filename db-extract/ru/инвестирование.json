                                            {
                                                "example_id": "ef62adad-45f0-4583-8d67-ce58664204cb",
                                                "sense_id": "b5be904b-3676-349e-ab80-8957c31e3092",
                                                "text": "„Wir fahren von einer Straßenbaustelle zur nächsten, die Investitionen in die Infrastruktur sind gewaltig, Dörfer, die vor drei Jahren noch im Dunkeln lagen, sind mittlerweile an das Stromnetz angeschlossen.“"
                                            },
                                            {
                                                "example_id": "fe092f9f-03fa-43dd-a82c-9f00c02edb12",
                                                "sense_id": "b5be904b-3676-349e-ab80-8957c31e3092",
                                                "text": "„Die Erschließung immer neuer Fundstätten, die zu erwartenden Gewinne, aber auch die dafür nötigen Investitionen zogen das große Kapital an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f9f4a82-a6e4-4412-ba26-a57527229fbc",
                        "source_entry_id": "10ec4add-5272-3d96-83fe-0e67856534ea",
                        "source_sense_id": "45802aa0-bf0b-3511-a1ed-42b92874a734",
