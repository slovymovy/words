                "senses": [
                    {
                        "sense_id": "0dd4a7ba-b88b-37ac-8255-271fa795b8e9",
                        "entry_id": "62546708-5cad-3f59-9be0-110bb6e35bf5",
                        "glosses": [
                            "спортивное сооружение для велосипедных соревнований и тренировок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfd9910-1091-493c-8c47-6613249ac4cc",
                                "sense_id": "0dd4a7ba-b88b-37ac-8255-271fa795b8e9",
                                "text": "Кроме того, во дворе тюрьмы имеется велодром для упражнения в езде на велосипедах."
                            },
                            {
                                "example_id": "4e177b09-1cdd-4d46-9f6d-ce69ae5cfd51",
                                "sense_id": "0dd4a7ba-b88b-37ac-8255-271fa795b8e9",
                                "text": "Мы посещали кино, велодром, боксовые состязания."
                            },
                            {
                                "example_id": "5a7fd8b0-6aea-4a58-9824-1c7b514860c4",
                                "sense_id": "0dd4a7ba-b88b-37ac-8255-271fa795b8e9",
                                "text": "Вчера днём, на Каменоостровском велодроме происходила игра в футбол между командами «Националы» и «Виктория»."
                            }
                        ]
                    }
                ],
