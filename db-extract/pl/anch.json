                                "target_senses": [
                                    {
                                        "sense_id": "52085cfe-ee42-33f0-af15-12085f6a3a43",
                                        "entry_id": "11ecf3e1-5c3b-3da5-a7e9-a6c56135b429",
                                        "glosses": [
                                            "hiëroglief dat leven betekent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0652c58-743d-47f5-b083-46c16b6813f6",
                                                "sense_id": "52085cfe-ee42-33f0-af15-12085f6a3a43",
                                                "text": "De ankh is een hiëroglief dat de levenskracht voorstelt."
                                            },
                                            {
                                                "example_id": "a4912931-2300-44ab-b8db-2cfdb62acdb5",
                                                "sense_id": "52085cfe-ee42-33f0-af15-12085f6a3a43",
                                                "text": "De manier waarop Columbus de drie tekens ankh , tyr en kruis in een schema met negen tekens plaatste, was niet toevallig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9707f4ec-5316-3b4e-a0fa-c2a3482ec26c",
                                        "entry_id": "11ecf3e1-5c3b-3da5-a7e9-a6c56135b429",
                                        "glosses": [
                                            "voorwerp met de vorm van het hiëroglief dat leven betekent, vaak als talisman"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7229e697-2850-49fa-a01a-102d55128675",
                                                "sense_id": "9707f4ec-5316-3b4e-a0fa-c2a3482ec26c",
                                                "text": "Hij wordt benaderd door een duiker die in een oude mijn een oude ankh vond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d6969b9-f67c-4ede-9bcd-a4631dc08151",
