                "senses": [
                    {
                        "sense_id": "4b1db50a-da4b-38f5-b3a1-2b8e4a80bd10",
                        "entry_id": "65ab8532-8083-3e52-9164-6a9592bbc7ee",
                        "glosses": [
                            "met veel bomen die veel schaduw geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590d00db-5176-48a1-8cc0-09c7e317113f",
                                "sense_id": "4b1db50a-da4b-38f5-b3a1-2b8e4a80bd10",
                                "text": "We reizen met de kinderen, al zijn ze nog wat jong\nDoor 't eindeloze woud waarover ik zo-even zong\nEen lommerrijk en zeer onoverzichtelijk terrein\nWaarin men zich gelukkig prijst dat er geen leeuwen zijn"
                            },
                            {
                                "example_id": "beb93d72-4951-4df8-97b3-b626d15daf3a",
                                "sense_id": "4b1db50a-da4b-38f5-b3a1-2b8e4a80bd10",
                                "text": "We volgen een stukje de Verlengde Oosterstraat tot de Heresingel waar we rechtsaf gaan naar het Hereplein. 's Zomers is dit een lommerrijk geheel dat voornamelijk met kastanjes en linden is beplant. Een plataan, een bruine beuk en een vleugelnoot brengen op dit plein variatie in de beplanting."
                            }
                        ]
                    }
                ],
