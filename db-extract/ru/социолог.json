                                "target_senses": [
                                    {
                                        "sense_id": "e8ce7078-1e15-3fb1-94d0-feb9d9268721",
                                        "entry_id": "3310ac9e-7c5f-31b3-a85c-29dcd6985c0c",
                                        "glosses": [
                                            "Toplumun gelişmesini ve bünyesinde meydana gelen olayları inceleyen, mevcut problemlerin çözümü için önerilerde bulunan kişi, toplum bilimi uzmanı"
                                        ],
