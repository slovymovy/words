                "senses": [
                    {
                        "sense_id": "1eca1554-67d9-3481-a5b4-9bd2f051e18f",
                        "entry_id": "6dbab7c4-425d-358e-8bd1-32d92d6f7f3f",
                        "glosses": [
                            "Wettrennen, bei dem die Teilnehmer von Schlittenhunden gezogene Hundeschlitten verwenden"
                        ],
                        "tags": [
                            "Hundesport"
                        ],
                        "examples": [
                            {
                                "example_id": "e4c35a22-e66a-43f5-b77e-d58b105bc2a2",
                                "sense_id": "1eca1554-67d9-3481-a5b4-9bd2f051e18f",
                                "text": "„Drei der Hunde, erfährt man, haben schon beim Iditarod durch Alaska mitgemacht. Und das ist das ärgste Schlittenhunderennen überhaupt, es wird traditionell im März in Anchorage gestartet und endet 1850 Kilometer später in Nome an der Beringsee.“"
                            },
                            {
                                "example_id": "027be26d-efbf-4e81-aff0-8014033bf114",
                                "sense_id": "1eca1554-67d9-3481-a5b4-9bd2f051e18f",
                                "text": "„So konnte er sich teure Hobbys leisten wie Schlittenhunderennen in Alaska oder eben eine Sammlung alter Autos, zu denen auch der legendäre BMW und ein seltener Ferrari gehörten.“"
                            },
                            {
                                "example_id": "55a80f3f-e66d-4ff3-88c3-93846d473459",
                                "sense_id": "1eca1554-67d9-3481-a5b4-9bd2f051e18f",
                                "text": "„Huskys, die Schlitten durch den tiefen Schnee ziehen - diese Bilder kennt man sonst eher aus eisigen Gegenden wie Kanada oder Lappland. Doch am Wochenende fanden sich gleich in mehreren Städten Dutzende Hunde und Herrchen zu Schlittenhunderennen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
