                "senses": [
                    {
                        "sense_id": "a29d4792-e87a-3d41-8fce-e06a1d282c7b",
                        "entry_id": "f44dc4b0-2c39-30d5-b570-e268a64f5a76",
                        "glosses": [
                            "op een ramp uitdraaiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e43e0a-f1a0-4789-807a-8010d4ee78dc",
                                "sense_id": "a29d4792-e87a-3d41-8fce-e06a1d282c7b",
                                "text": "Die overstroming heeft rampzalige gevolgen!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dc49711-7239-4018-b10c-3c4bd3df6014",
                        "source_entry_id": "f44dc4b0-2c39-30d5-b570-e268a64f5a76",
                        "source_sense_id": "a29d4792-e87a-3d41-8fce-e06a1d282c7b",
                        "source_sense_description": "op een ramp uitdraaiend",
                        "target_lang_word": "katastrophal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katastrophal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                        "entry_id": "7048382b-1419-3ec5-82c5-da736b146af3",
                                        "glosses": [
                                            "sehr schlimm, verhängnisvoll, entsetzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef23ed6a-9df8-46cf-8498-3836d75009a6",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "Die katastrophale Wirtschaftslage eines Landes wirkt sich auf andere Länder aus."
                                            },
                                            {
                                                "example_id": "f0279160-73f3-493a-8674-4321e622d3e4",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                                            },
                                            {
                                                "example_id": "f3ae5ed5-544a-4b7e-ad8a-c22a3e04f332",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "7755cf5f-2bfd-481c-ac03-41a5b1444feb",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die Verkehrs- und Versorgungslage in Deutschland ist katastrophal in diesen Tagen [Anmerkung: im April 1945] […].“"
                                            },
                                            {
                                                "example_id": "df306c34-06e7-4220-a992-322c11a00c5e",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Im Gegensatz zu vielen seiner Kollegen ist es Mugabe trotz seiner katastrophalen Politik bisher gelungen, die Armee ruhig und auf seiner Seite zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32084166-aa8f-42c6-baca-b851ff819d10",
                        "source_entry_id": "f44dc4b0-2c39-30d5-b570-e268a64f5a76",
                        "source_sense_id": "a29d4792-e87a-3d41-8fce-e06a1d282c7b",
                        "source_sense_description": "op een ramp uitdraaiend",
                        "target_lang_word": "disastrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disastrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f98f6c-8256-396b-961b-99487434a3b2",
                                        "entry_id": "c73b4df6-2da7-3972-befe-b1c2fe2634c2",
                                        "glosses": [
                                            "Of the nature of a disaster; calamitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4faa0c76-40e4-4954-b910-c72198362083",
                                                "sense_id": "36f98f6c-8256-396b-961b-99487434a3b2",
                                                "text": "In addition, he was also able to reinforce the unease among progressive Democratic-leaning voters over Clinton’s disastrous pro-interventionist positions, thereby suppressing turnout and encouraging third party support in some key swing states that made the difference in his Electoral College victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b3b43d-8c13-3f3e-b82b-8536bdfecab2",
                                        "entry_id": "c73b4df6-2da7-3972-befe-b1c2fe2634c2",
                                        "glosses": [
                                            "Foreboding disaster; ill-omened."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d62ba1d-71ce-4aa1-8e8a-757a6028a994",
                                                "sense_id": "c9b3b43d-8c13-3f3e-b82b-8536bdfecab2",
                                                "text": "A fearsome sight it was to behold how he swelled in his wrath, and his eyes blazed like disastrous stars at midnight, and being wood with anger he gnashed his teeth till the froth stood at his lips and slavered down his chin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
