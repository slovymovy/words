                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fremdwörterbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                        "entry_id": "ef9a5a44-4aea-39ab-8bc9-f1127274b221",
                        "glosses": [
                            "Wörterbuch, in dem Fremdwörter aufgeführt und erklärt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca79f731-a9c3-45b3-8c88-182b43a021ff",
                                "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                                "text": "In einem Fremdwörterbuch kann man nachschlagen, aus welcher Sprache ein Wort stammt, wie es korrekt geschrieben wird und welche Bedeutung es hat."
                            },
                            {
                                "example_id": "03b6a0d2-cd32-4dbf-a57f-26a4073d93dc",
                                "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                                "text": "„Fremdwörter- und Fachwörterbücher widerspiegeln die Breite der lexikographischen Bemühungen.“"
                            },
                            {
                                "example_id": "5712b633-242a-4766-ac22-e0e9f2177a1e",
                                "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                                "text": "„Fremdwörter sind oft als minderwertig aus ‚deutschen‘ Wörterbüchern ausgeschlossen oder in besonderen Wörterbüchern zusammengefasst worden. Das Fremdwörterbuch als Getto - das gibt es nur in der deutschen Sprach- und Lexikografiegeschichte.“"
                            },
                            {
                                "example_id": "1c03af33-d236-43c7-957f-75e4ef33cdaf",
                                "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                                "text": "„Die wichtigste Gruppe unter den Zweitquellen bilden die zahlreichen Fremdwörterbücher.“"
                            },
                            {
                                "example_id": "9c3885ef-9fd6-440f-b504-9d2e67bc2a34",
                                "sense_id": "1fdad3e9-0736-33c0-8eb3-248720227594",
                                "text": "„Die alten Fremdwörterbücher machen bei einem Vergleich mit dem gegenwärtigen Fremdwortgut das Kommen und Gehen der Wörter oder ihren Bedeutungswandel genauso deutlich wie die Lektüre unserer Klassiker oder gar die Durchsicht alter Verordnungen und Verfügungen aus dem vorigen Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
