                                        "entry_id": "029a23de-4001-3410-8972-4ffc62560d20",
                                        "glosses": [
                                            "A person filled with or guided by enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd22552d-c3ff-44ce-81b9-6269fca8b4e8",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "But Charles Aubyn (for it was he) had, like most enthusiasts, overcalculated the influence of his eloquence; surprise had alone procured him a hearing, and the bold cavaliers around were little in the mood for a homily."
                                            },
                                            {
                                                "example_id": "cd28ba49-7500-4c4f-aa5f-0026929abce2",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "I would challenge any rock enthusiast to refrain from tapping his/her foot when listening to such music."
                                            }
                                        ]
                                    },
