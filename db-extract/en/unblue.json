                "senses": [
                    {
                        "sense_id": "326854dd-da9a-3316-888f-3553ae77802d",
                        "entry_id": "3e04aa86-87d4-3023-bf6c-430016fa26a9",
                        "glosses": [
                            "Not blue."
                        ],
                        "tags": [
                            "not-comparable",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "ba068caf-4207-4d51-a9ce-a63a90919712",
                                "sense_id": "326854dd-da9a-3316-888f-3553ae77802d",
                                "text": "[…] a god in an unblue sky."
                            },
                            {
                                "example_id": "f024ae76-99f6-4a43-bc6c-7813e8565f43",
                                "sense_id": "326854dd-da9a-3316-888f-3553ae77802d",
                                "text": "Soon an associational chain reaction occurs that stains blue all that has remained unblue..."
                            },
                            {
                                "example_id": "645f5d79-2fd4-4979-9175-9bf8a76462b3",
                                "sense_id": "326854dd-da9a-3316-888f-3553ae77802d",
                                "text": "A philosopher, busily sorting the world into the blue and the unblue, tells us that some ink is blue. We look at the ink one way, and it looks blue."
                            },
                            {
                                "example_id": "ac0461a1-363b-49f8-84a4-7f4a48bb6c96",
                                "sense_id": "326854dd-da9a-3316-888f-3553ae77802d",
                                "text": "Mind you, if they fly in downstairs, they are quite happy to settle for unblue mangoes."
                            }
                        ]
                    }
                ],
