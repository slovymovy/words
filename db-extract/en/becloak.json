                        "sense_id": "c73c5c29-8c84-3d85-9de5-5f1630b1c254",
                        "entry_id": "1b703742-f5b5-325b-b754-b290577a7aa3",
                        "glosses": [
                            "To cover or surround, as with a cloak."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9faad663-fbd1-4f75-8ea9-33d26a3d77a3",
                                "sense_id": "c73c5c29-8c84-3d85-9de5-5f1630b1c254",
                                "text": "Surely — was the cry — more Staff Officers are wanted who are trained to active service in the field, and not so many medal-hunting gentlemen skilled solely in the accomplishments of correcting visiting lists, becloaking ladies, and writing menu-cards."
                            },
                            {
                                "example_id": "63da3a82-ebe2-4642-a6d9-506c245ada3c",
                                "sense_id": "c73c5c29-8c84-3d85-9de5-5f1630b1c254",
                                "text": "\"You might so becloak yourself that no one would know whom you were,\" suggested Taro."
                            },
                            {
                                "example_id": "ae7b8eca-8245-4599-b135-072af3ed4714",
                                "sense_id": "c73c5c29-8c84-3d85-9de5-5f1630b1c254",
                                "text": "\" […] Therefore, if the converted won't reconvert, their master, or one so guised, should undertake to play our tune. A touch of truthache essentials, lest sharper drama too soon becloak our stage, and weary our watchers of our play.\""
                            }
                        ]
                    }
