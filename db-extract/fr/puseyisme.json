                "senses": [
                    {
                        "sense_id": "d35e533b-8060-3eae-9505-97b527e33518",
                        "entry_id": "e765c622-36ed-36b8-b456-a2108d0f41a1",
                        "glosses": [
                            "Doctrine de Pusey, qui cherchait à rapprocher lʼéglise anglicane de la religion catholique en rétablissant certains cultes propres à la liturgie de celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e43b6d4-2d44-473b-a2e5-8a76ab31a746",
                                "sense_id": "d35e533b-8060-3eae-9505-97b527e33518",
                                "text": "Il est inutile d’insister sur les aveux que fait ici l’évêque d’Oxford, et sur l’hommage qu’il rend au puseyisme, qui, dans ce qu’il fait, rétablit des principes ou des pratiques catholiques !"
                            },
                            {
                                "example_id": "64d32f1d-7e1f-4d3f-a099-0db4bfca858f",
                                "sense_id": "d35e533b-8060-3eae-9505-97b527e33518",
                                "text": "Le dogme de lʼÉglise, longtemps négligé dans la dogmatique protestante, exagéré par le puseyisme, a repris, dans la théologie protestante moderne, la place qui lui appartient."
                            }
                        ]
                    }
                ],
