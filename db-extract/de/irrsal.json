                ],
                "senses": [
                    {
                        "sense_id": "5f333b61-ad47-3364-8200-0de3853a78ba",
                        "entry_id": "e130d633-07d8-3951-a5ce-a6bae8f7738a",
                        "glosses": [
                            "der Zustand, in dem man sich irrt"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "daa93db8-3699-4776-a8ab-69944fa17f4f",
                                "sense_id": "5f333b61-ad47-3364-8200-0de3853a78ba",
                                "text": "\"Im Anfang schuf Gott den Himmel und die Erde.",
                                "translation": "Braus Gottes schwingend über dem Antlitz des Wasser.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8daf69bc-91c5-4380-9e5b-7a0a76a7c0c3",
                        "source_entry_id": "e130d633-07d8-3951-a5ce-a6bae8f7738a",
                        "source_sense_id": "5f333b61-ad47-3364-8200-0de3853a78ba",
                        "source_sense_description": "gehoben, auch dichterisch: der Zustand, in dem man sich irrt",
                        "target_lang_word": "errements",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "errements",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                                        "entry_id": "738109f8-1a41-3967-96db-7df4f8d3551a",
                                        "glosses": [
                                            "Manière dont une affaire est conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962d1d36-6a6e-492b-b94f-70aacb3ab463",
                                                "sense_id": "5415c2ec-ba2a-385e-ae07-460013f8f98d",
                                                "text": "Pour faire des Tragédies qui puissent intéresser le public en 1823, faut-il suivre les errements de Racine ou ceux de Shakspeare ? ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bd9689a-5c87-4371-b249-0a0bc84a6227",
                        "source_entry_id": "e130d633-07d8-3951-a5ce-a6bae8f7738a",
                        "source_sense_id": "5f333b61-ad47-3364-8200-0de3853a78ba",
                        "source_sense_description": "gehoben, auch dichterisch: der Zustand, in dem man sich irrt",
                        "target_lang_word": "erreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Fausse opinion ; fausse doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a789a0b-1a77-4840-8781-a67cf6ca7521",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "La Foi qui sert de fondement à toutes les Religions n'est qu'un principe d’erreurs, d’illusions et d’impostures."
                                            },
                                            {
                                                "example_id": "7b37002d-46ac-4527-81a3-4a6d1df3c584",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "A l'opposé de George Sand qui s'élevait volontiers au-dessus des contingences et, sévère pour les erreurs des autres, était pleine d’indulgence pour ses propres erreurs, s’absolvait de ses chutes en planant, Musset avait une grande puissance de contrition et, par sa nature, était « mea-culpiste »."
                                            },
                                            {
                                                "example_id": "20964ccd-d02c-4bae-9660-5ebdf8fe7be2",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "D'autre part, Péchenard écrit que le pasteur de Gespunsart, « à cause de son attachement aux erreurs jansénistes » fut dénoncé par ses paroissiens à l'autorité diocésaine. Il fut donc interdit par l'archevêque de Mailly."
                                            },
                                            {
                                                "example_id": "9cfdbc26-dbae-4931-bced-8b88605e6e84",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Vous faites erreur."
                                            },
                                            {
                                                "example_id": "4e10c5a3-acb9-4b5e-ae94-dbea41a67512",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Erreur dans la foi, en matière de foi."
                                            },
                                            {
                                                "example_id": "03032427-f8f2-415e-8f64-b190261fe911",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Persister dans l’erreur."
                                            },
                                            {
                                                "example_id": "424794bc-8c8f-4c8d-baac-b64024223360",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "La doctrine de cet homme est pleine d’erreurs."
                                            },
                                            {
                                                "example_id": "5e508b18-4edb-4023-983a-a6e0042167d0",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "On a condamné ses erreurs."
                                            },
                                            {
                                                "example_id": "275eb838-d327-4341-bc0b-a277173d6da8",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Combattre l’erreur."
                                            },
                                            {
                                                "example_id": "e13bce7d-d133-4be3-a6db-83bfe659bc62",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Laisser quelqu’un dans l’erreur."
                                            },
                                            {
                                                "example_id": "a1ba3302-b7d7-41b9-9fd9-659621e819bb",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Triompher de l’erreur."
                                            },
                                            {
                                                "example_id": "c730659a-5116-436f-b2f6-4363c04dd1d7",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Erreurs populaires, Fausses opinions, le plus souvent traditionnelles préjugés des ignorants."
                                            },
                                            {
                                                "example_id": "107c48ca-509f-46ad-b8b9-58762db8b47c",
                                                "sense_id": "6678a730-d6c0-3af1-ac27-fab9e6c205b5",
                                                "text": "Les erreurs populaires en astronomie, en histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a1452b-a27a-3829-8282-6992b889b40e",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Illusion, comme dans cette expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005a063b-d471-4771-9e83-ed51ff4393f2",
                                                "sense_id": "f2a1452b-a27a-3829-8282-6992b889b40e",
                                                "text": "Les erreurs des sens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Faute ; méprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8471fd-5375-41b1-bb72-4bc2aeb56839",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Je pouvais être satisfait de mon atterrissage. Après quarante-huit jours de mer, mon erreur de longitude était inférieure à deux milles."
                                            },
                                            {
                                                "example_id": "cfba9e03-fb9b-42b2-8617-fee311a582a2",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Quelque caillou qu'on lui présentât, il en situait toujours et sans erreur l'emplacement exact : […]."
                                            },
                                            {
                                                "example_id": "6f381380-f80c-4245-9e09-445c1b998b50",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Même fourmillement de fautes innombrables, d’erreurs ou d'inexactitudes phonétiques, dans les mots souletins que porte le dictionnaire du P. Lhande."
                                            },
                                            {
                                                "example_id": "6bc0a703-23a9-4f9d-b739-29df2158b777",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Erreur de personne ou sur la personne : erreur qui consiste à prendre une personne pour une autre ou à lui attribuer des qualités essentielles qu’elle n’a pas."
                                            },
                                            {
                                                "example_id": "5b148818-71fd-4fe7-901c-424f64e04519",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "« Au temps pour moi », concède ma prof de maths quand quelqu'un relève une erreur au tableau."
                                            },
                                            {
                                                "example_id": "dad2b0c6-6b86-4263-b962-b957eb074598",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Il y a erreur dans ce calcul, dans ce relevé de comptes de droits d’auteur."
                                            },
                                            {
                                                "example_id": "f90a4130-b7c3-481d-8fe2-2cf92184b8ae",
                                                "sense_id": "51424975-2682-3553-8fd7-075426b1baf1",
                                                "text": "Erreur n’est pas compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7685667-03d6-3a4e-83bd-981c15a86135",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Action d’errer, au sens d'aller de-ci de-là, ou de voyager."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
