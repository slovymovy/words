                        "glosses": [
                            "Relatif au canton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7971cfaf-4288-4081-94a3-35f702e5b642",
                                "sense_id": "e5f829c8-d3e1-3afa-8a0c-a1349e2ab116",
                                "text": "– Ainsi, tu vas découvrir la France cantonale. La belle affaire ! Mais cette France-là est morte. À supposer qu’elle ait encore un semblant d’existence, c’est du passé."
                            },
                            {
                                "example_id": "a36fdc6f-023b-48bf-97c7-6b99d2a7132c",
                                "sense_id": "e5f829c8-d3e1-3afa-8a0c-a1349e2ab116",
                                "text": "Donc une cantonale partielle aura lieu chaque fois qu'un député ou un sénateur, élu au conseil général, devra renoncer au mandat cantonal."
                            }
                        ]
                    }
