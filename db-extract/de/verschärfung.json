                "senses": [
                    {
                        "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                        "entry_id": "c8ce9795-1820-3d92-8709-6a5578e601c0",
                        "glosses": [
                            "Veränderung in Richtung schlimmer, schlechter, oder auch restriktiver, einschränkender (schärfer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78d76d5-ac73-4d5e-a03d-0ae9eac17a8e",
                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                "text": "Eine Verschärfung der Maßnahmen sei derzeit nicht nötig."
                            },
                            {
                                "example_id": "ba253b01-c0d1-43ff-b7a4-d501d28c35eb",
                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                "text": "Die Verschärfungen der Freiheitsstrafen wurden in der Öffentlichkeit heiß diskutiert."
                            },
                            {
                                "example_id": "11a1c5c1-b613-4170-ab7d-28c0b7fffec0",
                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                "text": "Der subjektive Wahrnehmungsfilter des Betroffenen trägt zur Verschärfung der Problemsituation bei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "588366c8-9173-4735-8052-763f60537284",
                        "source_entry_id": "c8ce9795-1820-3d92-8709-6a5578e601c0",
                        "source_sense_id": "375398af-2262-33bb-b321-28708848fa68",
                        "source_sense_description": "Veränderung in Richtung schlimmer, schlechter oder einschränkender",
                        "target_lang_word": "renforcement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renforcement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                        "entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                                        "glosses": [
                                            "Action de renforcer, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d82387-15c5-4665-ae83-717fcd089458",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Le manche est en bois ; on en colle le talon au bout de la caisse sur le renforcement ou épaulement de la table : il est terminé en volute, et creusé d'un large sillon ou mortaise ; c'est le sommier."
                                            },
                                            {
                                                "example_id": "7bb6157e-8fb9-447c-9eb2-59501f46ef32",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Et c'est cette politique aussi qui favorisa le renforcement du ritualisme juif, lequel semble avoir été assez modéré jusqu'au XVᵉ siècle."
                                            },
                                            {
                                                "example_id": "5a674259-bfad-4f4b-986f-2ea9c199d115",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Les résultats de l’étude permettent de savoir comment on peut réduire l’épaisseur d'un renforcement en utilisant des enrobés moins fatigables qui n’ornièreront pas plus pour autant."
                                            },
                                            {
                                                "example_id": "cd6cfbb9-c9a2-46cf-8ebc-4da1fa22825e",
                                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                                "text": "Le renforcement des alizés depuis vingt ans y a créé un énorme réservoir de chaleur, « les eaux chaudes y forment une couche plus épaisse », explique Cazenave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50666d00-0796-4af1-876a-eb913fb813fb",
                        "source_entry_id": "c8ce9795-1820-3d92-8709-6a5578e601c0",
                        "source_sense_id": "375398af-2262-33bb-b321-28708848fa68",
                        "source_sense_description": "Veränderung in Richtung schlimmer, schlechter oder einschränkender",
                        "target_lang_word": "aggravation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggravation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                                        "glosses": [
                                            "Action d’aggraver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0a0462-507e-461c-85a9-3228b6a201d3",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "Aggravation de peine. Ce qu’on ajoute à une condamnation, à un châtiment."
                                            },
                                            {
                                                "example_id": "f11c8891-9b2c-4380-a8bb-266a19dac42a",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "— En vérité, ce serait peut-être un bonheur pour moi, répondait Lucien ; ou, pour parler avec l’exactitude mathématique que nous aimons, rien ne peut être pour moi aggravation de peine ; je crois, sans trop présumer, être parvenu au comble de l’ennui."
                                            },
                                            {
                                                "example_id": "37310b61-e222-4463-a7e8-408d6b56de32",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": ". L’aggravation du mal."
                                            },
                                            {
                                                "example_id": "7b35d838-33a7-4f0d-803e-52bb74e3df76",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "Sur vingt schizophrènes, on comptabilisa dix améliorations dont quatre sorties et dix échecs dont une aggravation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727f7af5-20dd-39e3-ad03-052a6a5bffb0",
                                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                                        "glosses": [
                                            "Dommage corporel supplémentaire survenu depuis la consolidation. Imputable au fait générateur du dommage et témoignant de l’évolution des séquelles traumatiques temporaires ou définitifs."
                                        ],
