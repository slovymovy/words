    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d204692-2564-3a5b-a394-dd1b53068ad7",
                    "sense_definition": "Proposer une idée, un conseil ou un choix à l'examen de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur nous a <w>suggéré</w> le poisson du jour, qui s'est révélé délicieux."
                        },
                        {
                            "text": "Je vous <w>suggère</w> de partir tôt pour éviter les embouteillages du matin."
                        }
                    ],
                    "synonyms": [
                        "proposer",
                        "conseiller",
                        "recommander"
                    ],
                    "antonyms": [
                        "imposer",
                        "ordonner",
                        "exiger"
                    ],
                    "common_phrases": [
                        "suggérer une idée",
                        "suggérer une solution",
                        "suggérer une amélioration"
                    ]
                },
                {
                    "sense_id": "135740d9-5662-3062-9d22-264f9bd37497",
                    "sense_definition": "Laisser entendre ou évoquer indirectement quelque chose ; donner à penser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats récents de l'étude <w>suggèrent</w> un changement profond dans les habitudes alimentaires."
                        },
                        {
                            "text": "Le ton hésitant de sa voix <w>suggérait</w> qu'elle n'était pas entièrement convaincue."
                        }
                    ],
                    "synonyms": [
                        "évoquer",
                        "indiquer",
                        "sous-entendre"
                    ],
                    "antonyms": [
                        "démontrer",
                        "prouver"
                    ],
                    "common_phrases": [
                        "suggérer une hypothèse",
                        "tout semble suggérer"
                    ]
                },
                {
                    "sense_id": "d964ff73-19f3-3ced-844b-3645b89f64b5",
                    "sense_definition": "Insinuer une pensée, une opinion ou un dessein dans l'esprit d'une personne de façon subtile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a habilement <w>suggéré</w> une réponse au témoin sans attirer l'attention du juge."
                        },
                        {
                            "text": "Par des allusions discrètes, il lui a <w>suggéré</w> de poser sa candidature au poste vacant."
                        }
                    ],
                    "synonyms": [
                        "insuffler",
                        "inspirer",
                        "insinuer"
                    ],
                    "antonyms": [
                        "dissuader"
                    ],
                    "common_phrases": [
                        "suggérer une réponse"
                    ]
                }
            ]
        }
    ]
