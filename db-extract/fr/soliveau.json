                "word_linkages": []
            },
            {
                "entry_id": "18566d6c-8e6b-3267-82f6-f99b3adefb7e",
                "word": "soliveau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fada965c-8270-4611-a9ab-da45290d85da",
                        "entry_id": "18566d6c-8e6b-3267-82f6-f99b3adefb7e",
                        "tags": [
                            "plural"
                        ],
                        "form": "soliveaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f2c07f7-ad1b-304e-bf55-b62d0202b326",
                        "entry_id": "18566d6c-8e6b-3267-82f6-f99b3adefb7e",
                        "glosses": [
                            "Petite solive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e369a849-1b5f-4fdf-b52d-ee817a2e8164",
                                "sense_id": "0f2c07f7-ad1b-304e-bf55-b62d0202b326",
                                "text": "Soupente, s. f. (Menuiserie.) espece d’entresol, qui se fait de planches jointes à rainure & languettes portées sur des chevrons ou soliveaux. On pratique les soupentes dans les lieux élevés pour avoir plus de logement. Daviler."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ccaf9b-cfd5-3310-97f5-73626f736f53",
                        "entry_id": "18566d6c-8e6b-3267-82f6-f99b3adefb7e",
                        "glosses": [
                            "Personne sans énergie et sans autorité, par allusion à la fable de La Fontaine Les Grenouilles qui demandent un Roi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d9f6a75f-d8c1-40ec-ba7e-a9a45cb02f78",
                                "sense_id": "c6ccaf9b-cfd5-3310-97f5-73626f736f53",
                                "text": "Un roi soliveau, roi faible, sans autorité."
                            },
                            {
                                "example_id": "5a8c0a9d-9ba5-49af-bc63-ad1b64b0ad05",
                                "sense_id": "c6ccaf9b-cfd5-3310-97f5-73626f736f53",
                                "text": "Je ne serai ni un président soliveau, ni un président personnel."
                            },
                            {
                                "example_id": "a46baad1-ac0f-4df2-9cc2-b8e11b6181aa",
                                "sense_id": "c6ccaf9b-cfd5-3310-97f5-73626f736f53",
                                "text": "… les vendeurs de journaux criaient qu'on avait assassiné le président de la République. … L'événement était considérable mais sans conséquence. Ce président était soliveau et son meurtrier délirant."
                            }
                        ]
                    }
                ],
