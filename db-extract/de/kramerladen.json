                "senses": [
                    {
                        "sense_id": "d6eda6fc-1df3-3163-bede-0fba64518180",
                        "entry_id": "34979f1a-93b3-3968-80ce-b0fb80d038c3",
                        "glosses": [
                            "Geschäft, das allerlei Waren des täglichen Bedarfs führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1fbde2-f1f4-408c-9bf8-5f744aa8c4fd",
                                "sense_id": "d6eda6fc-1df3-3163-bede-0fba64518180",
                                "text": "„Im Dorf Feldafing gab es damals noch einen richtigen Kramerladen, der einfach alles im Angebot führte, was man hier am See so brauchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e01aaec6-e63b-4bd5-970c-64f6f45566ae",
                        "source_entry_id": "34979f1a-93b3-3968-80ce-b0fb80d038c3",
                        "source_sense_id": "d6eda6fc-1df3-3163-bede-0fba64518180",
