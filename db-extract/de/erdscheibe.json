                        "examples": [
                            {
                                "example_id": "fff6b667-feb2-4a4f-b4b6-3261fa6e76a6",
                                "sense_id": "bfb3e508-b32c-37a7-95c3-cdee15250eae",
                                "text": "„Doch obwohl sich der angebliche Glaube an die flache Erdscheibe als Propaganda neuzeitlicher Autoren entpuppt, gibt es im Mittelalter Bildung nur für wenige.“"
                            },
                            {
                                "example_id": "3b9a545d-ae29-4d7b-98e6-67d49bf79935",
                                "sense_id": "bfb3e508-b32c-37a7-95c3-cdee15250eae",
                                "text": "„Die Erdscheibe durchschneidet die Weltkugel in Schrägaufsicht.“"
                            },
                            {
                                "example_id": "eeb854ea-5635-4e17-bf1f-06934cdf14b6",
                                "sense_id": "bfb3e508-b32c-37a7-95c3-cdee15250eae",
                                "text": "„Die Anreise fühlt sich so an, als würde man hinaussegeln über den Rand der Erdscheibe.“"
                            }
                        ],
