        "fr-extract.jsonl": [
            {
                "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                "word": "faciès",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c70e094-aaf8-4fbc-8c3c-007ddb9e9aae",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "tags": [],
                        "form": "facies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e014c55f-857e-3806-be5d-c8398146cd80",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Aspect du visage dans les maladies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc37e998-b0d4-4586-8021-b895fa96973d",
                                "sense_id": "e014c55f-857e-3806-be5d-c8398146cd80",
                                "text": "Son faciès est mauvais."
                            },
                            {
                                "example_id": "4ff664ad-7767-464b-8027-011baf876913",
                                "sense_id": "e014c55f-857e-3806-be5d-c8398146cd80",
                                "text": "Le cholérique n’a plus de visage : il a un facies, un faciès éminemment cholérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0374ca6b-d66d-37b2-8ae2-978307b4cc11",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Conformation plus ou moins caractéristique du visage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2266d8c7-e227-4dfe-ba4d-28e49824aff7",
                                "sense_id": "0374ca6b-d66d-37b2-8ae2-978307b4cc11",
                                "text": "Le faciès mongol."
                            },
                            {
                                "example_id": "e2f983c6-2da2-41fa-9856-bfc1f6f1dc3c",
                                "sense_id": "0374ca6b-d66d-37b2-8ae2-978307b4cc11",
                                "text": "Anne Desbaresdes s’essaye à un sourire d’excuse de n’avoir pu faire autrement, mais elle est ivre et son visage prend le faciès impudique de l’aveu."
                            },
                            {
                                "example_id": "2f176ecb-45f6-4070-b92e-7aee5d50dc83",
                                "sense_id": "0374ca6b-d66d-37b2-8ae2-978307b4cc11",
                                "text": "Je compris d’emblée à qui j’avais affaire, ma longue carrière de chasseur au faciès m’assurait que je ne pouvais pas me tromper : Lew était juif."
                            }
                        ]
                    },
                    {
                        "sense_id": "91581e78-6791-3a4d-9991-d98886826673",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Se dit d’une personne ayant un visage peu agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad3197b-1b80-41bc-867b-8b4eb77fe7cd",
                                "sense_id": "91581e78-6791-3a4d-9991-d98886826673",
                                "text": "Son faciès n’est pas évident."
                            },
                            {
                                "example_id": "d6374b2e-bb43-43f0-80cb-c32a65e5304e",
                                "sense_id": "91581e78-6791-3a4d-9991-d98886826673",
                                "text": "Pris de remords devant le faciès effaré de M. de La Hourmerie, il s’adoucit, comme la veille."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e3c6026-be7d-3a6c-b1fd-6c9ef8f08d38",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Ensemble de caractères pétrographiques et paléontologiques qui définit un dépôt ou une roche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebae0473-aaa0-413e-9ddd-aabd010e64e9",
                                "sense_id": "9e3c6026-be7d-3a6c-b1fd-6c9ef8f08d38",
                                "text": "La faune liasienne de l'Aveyron montre en général un faciès côtier. Mais déjà, dans le Gard, se manifestent les caractères de mer profonde, caractères qui se poursuivent dans les Bouches-du-Rhône et le Var."
                            },
                            {
                                "example_id": "7d3a384f-6e40-4a17-b534-57478f7c80ce",
                                "sense_id": "9e3c6026-be7d-3a6c-b1fd-6c9ef8f08d38",
                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
                            },
                            {
                                "example_id": "968f0dca-25a6-424d-92ef-791233bed155",
                                "sense_id": "9e3c6026-be7d-3a6c-b1fd-6c9ef8f08d38",
                                "text": "Puis s’installent à nouveau des faciès calcaires, mais plus franchement récifaux, comme ils avaient commencé à se manifester avec les bioherms à Polypiers du sommet du Bajocien moyen : calcaires oolithiques, calcaires pseudoolithiques avec Polypiers isolés."
                            },
                            {
                                "example_id": "64a0cbd0-09cc-4e4e-991e-952d4c8f2a1b",
                                "sense_id": "9e3c6026-be7d-3a6c-b1fd-6c9ef8f08d38",
                                "text": "On parle alors de faciès sapropélique, terme provenant du grec sapros voulant dire « pourriture ». Même si la biomasse initiale a été fortement retravaillée par les bactéries, cette matière organique présente un bon potentiel pétrolier."
                            }
                        ]
                    },
                    {
                        "sense_id": "b65ead62-91a4-3f00-8bbc-dc5eba0ac54d",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Aspect d’un minéral cristallin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea257a8b-6403-3df2-bdbe-4b62c806bcdb",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Aspect typique d’une végétation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c039f54-08a5-46c2-9155-189e16578738",
                                "sense_id": "ea257a8b-6403-3df2-bdbe-4b62c806bcdb",
                                "text": "Ce groupement a été décrit dans l’Ardenne, par P. Jouanne [84], qui le représente comme un faciès subrudéral de l’association à Cicendia avec comme constituants […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3da14974-3037-3081-91ce-1d3e9afb2cc2",
                        "entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "glosses": [
                            "Éléments qui relient un site ou un artéfact à une période chronologique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "342eae16-1bf7-4720-956f-10a6cc9b76fd",
                        "source_entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "target_lang_word": "Gesichtszug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesichtszug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                        "entry_id": "1d0bb2a8-7b7e-3770-a117-ddd7fd669364",
                                        "glosses": [
                                            "ein bestimmter Aspekt (Zug) der Gestalt des Gesichts (Singular relativ ungebräuchlich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6bd1a2a-0ec6-4858-a3a1-bd486a930a54",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Ist die Lebenserwartung niedrig und die Verbreitung ansteckender Krankheiten vergleichsweise hoch, bevorzugen Frauen Männer mit maskulinen Gesichtszügen.“"
                                            },
                                            {
                                                "example_id": "193d3462-f7a3-4971-8b4a-9eb4e4e18c3f",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„In einigen Sitzungen wurde zunehmend das „Einfrieren“ geübt, sodass letztlich über Minuten hinweg, kein Körperteil, kein Gesichtszug sich bewegen durfte.“"
                                            },
                                            {
                                                "example_id": "3d60b50a-462c-43f9-b92b-30965d5b6184",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Der Mann mochte ein Fünfziger, vielleicht älter sein, denn die Haare waren stark ergraut, die Gesichtszüge noch stärker durchfurcht.“"
                                            },
                                            {
                                                "example_id": "dc3ea690-55ff-4e9b-a30a-2867e2c38b70",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Seine angenehmen Gesichtszüge hatten es Grete sogleich angetan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54595872-9d4b-4f9a-8ccc-7d8313cd3aea",
                        "source_entry_id": "3f646cbb-7eaf-342b-baff-17c1c2734ba3",
                        "target_lang_word": "Gesichtsausdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesichtsausdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                        "entry_id": "df5b14b2-440d-3186-affe-a3392cd6fb58",
                                        "glosses": [
                                            "momentane Mimik in einer bestimmten Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4c7ad2-0636-4b6f-9138-c43ea06c294d",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "Er sagte mir, dass er sich freue mich zu sehen, aber sein Gesichtsausdruck verriet mir etwas anderes."
                                            },
                                            {
                                                "example_id": "3c9ae0c7-7f97-4dac-92e1-319e2d748b6b",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "„Sein Gesichtsausdruck verriet sofort Vergeblichkeit.“"
                                            },
                                            {
                                                "example_id": "914ae22a-8c80-4beb-a367-8f91a8c58579",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "„Mit einem grimmigen Gesichtsausdruck kehrte mir der Kellner den Rücken zu und verschwand in der Küche.“"
                                            },
                                            {
                                                "example_id": "42e8878f-4a11-46d2-af56-ea2605c069b5",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "„Ihr Gesichtsausdruck wirkt resigniert.“"
                                            },
                                            {
                                                "example_id": "ed7a9436-1608-43f6-98c0-72c4c8764937",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "„Grenfeld war überrascht, wie hart ihr Gesichtsausdruck geworden war.“"
                                            },
                                            {
                                                "example_id": "4ddd1a44-7afc-4cef-af88-c8a924950e28",
                                                "sense_id": "5503f6ee-104c-3370-a18b-5cc61f736e89",
                                                "text": "„Maries Gesichtsausdruck hell sich auf. Sie hat eine Idee und zeigt auf das Fenster, hoch über dem Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
