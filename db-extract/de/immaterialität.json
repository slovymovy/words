                                        "entry_id": "57cf5dfd-b175-338f-8569-55c6c0452309",
                                        "glosses": [
                                            "The state of being immaterial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0bd9f99-44e7-4b37-85b8-3855dfb5b3bb",
                                                "sense_id": "c6c122ef-fe4c-3287-846e-a9781f37d219",
                                                "text": "the immateriality of the soul"
                                            },
                                            {
                                                "example_id": "71d096de-e297-4ba4-9d83-2df27e420d15",
                                                "sense_id": "c6c122ef-fe4c-3287-846e-a9781f37d219",
                                                "text": "God's immateriality entails the divine attribute of incorporeality, that God is neither a body nor embodied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bddc45aa-0c38-4f25-a5e4-9d3558c93d18",
                        "source_entry_id": "1fa4b334-ee98-3ea8-8872-8cb350e676a5",
                        "source_sense_id": "d8392eb3-46de-3a14-9bd3-44b4160b82ff",
