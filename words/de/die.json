                                "target_lang_sense_clarification": "plural"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "42cc1421-1d0f-3945-bdf7-0e9e735c2121",
                    "sense_definition": "Leitet als Relativpronomen im Nominativ oder Akkusativ einen Relativsatz ein.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relativpronomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das ist die Kollegin, <w>die</w> mir bei der Arbeit geholfen hat.",
                            "target_lang_translations": {
                                "en": "That is the colleague <w>who</w> helped me with work."
                            }
                        },
                        {
                            "text": "Kennst du die Nachbarn, <w>die</w> gerade nebenan eingezogen sind?",
                            "target_lang_translations": {
                                "en": "Do you know the neighbours <w>who</w> just moved in next door?"
                            }
                        }
                    ],
                    "synonyms": [
                        "welche"
                    ],
                    "target_lang_definitions": {
                        "en": "Introduces a relative clause in the nominative or accusative (who, that, which)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "who",
                                "target_lang_sense_clarification": "relative pronoun referring to people"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "relative pronoun referring to people or things"
                            },
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "relative pronoun referring to things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e87f1d45-61a2-3bfe-b365-3d8c01091a58",
                    "sense_definition": "Weist als Demonstrativpronomen nachdrücklich auf eine weibliche Person, eine Sache oder mehrere Personen/Sachen hin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "demonstrativpronomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit dieser Frau möchte ich nicht sprechen, <w>die</w> kenne ich gar nicht.",
                            "target_lang_translations": {
                                "en": "I don't want to talk to this woman; I don't know <w>her</w> at all."
                            }
                        },
                        {
                            "text": "Suchst du deine Schlüssel oder sind das <w>die</w> da drüben?",
                            "target_lang_translations": {
                                "en": "Are you looking for your keys, or are <w>those</w> over there yours?"
                            }
                        }
                    ],
                    "synonyms": [
                        "diese",
                        "jene"
                    ],
                    "common_phrases": [
                        "die da",
                        "die dort"
                    ],
                    "target_lang_definitions": {
                        "en": "Demonstrative pronoun emphatically pointing out a female person, a thing, or multiple people/things."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that one",
                                "target_lang_sense_clarification": "singular, pointing out a specific person or thing"
                            },
                            {
                                "target_lang_word": "those",
                                "target_lang_sense_clarification": "plural, demonstrative pronoun"
                            },
                            {
                                "target_lang_word": "she",
                                "target_lang_sense_clarification": "referring to a previously mentioned female person"
                            },
                            {
                                "target_lang_word": "they",
                                "target_lang_sense_clarification": "referring to previously mentioned people or things"
                            }
                        ]
                    }
                }
            ]
        },
