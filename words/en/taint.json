{
    "word_family": [
        "tainted",
        "tainting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d2ee00f-159d-370c-ba1b-358ae5ad5179",
                    "sense_definition": "To contaminate or corrupt something with an external agent, either physically or morally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>taint</w> his reputation for many years.",
                            "target_lang_translations": {
                                "cs": "Skandál na mnoho let <w>poskvrnil</w> jeho pověst.",
                                "ru": "Скандал <w>опорочил</w> его репутацию на многие годы.",
                                "es": "El escándalo sirvió para <w>manchar</w> su reputación durante muchos años."
                            }
                        },
                        {
                            "text": "Chemical waste can <w>taint</w> the local water supply.",
                            "target_lang_translations": {
                                "cs": "Chemický odpad může <w>kontaminovat</w> místní zásobování vodou.",
                                "ru": "Химические отходы могут <w>загрязнить</w> местный источник воды.",
                                "es": "Los residuos químicos pueden <w>contaminar</w> el suministro de agua local."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taint reputation",
                        "taint water supply"
                    ],
                    "target_lang_definitions": {
                        "cs": "Znečistit nebo zkazit něco vnějšími vlivy, ať už fyzicky nebo morálně.",
                        "ru": "Загрязнять или портить что-либо внешним воздействием, будь то физически или морально.",
                        "es": "Contaminar o corromper algo mediante un agente externo, ya sea de forma física o moral."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poskvrnit",
                                "target_lang_sense_clarification": "morální znečištění pověsti nebo charakteru"
                            },
                            {
                                "target_lang_word": "kontaminovat",
                                "target_lang_sense_clarification": "fyzické znečištění látek nebo prostředí"
                            },
                            {
                                "target_lang_word": "kazit",
                                "target_lang_sense_clarification": "obecné znehodnocení něčeho"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "опорочить",
                                "target_lang_sense_clarification": "моральное очернение репутации или чести"
                            },
                            {
                                "target_lang_word": "загрязнить",
                                "target_lang_sense_clarification": "физическое внесение примесей"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "общее негативное воздействие на качество"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "dañar moralmente la reputación o el honor"
                            },
                            {
                                "target_lang_word": "contaminar",
                                "target_lang_sense_clarification": "polución o introducción de sustancias nocivas"
                            },
                            {
                                "target_lang_word": "corromper",
                                "target_lang_sense_clarification": "pervertir o degradar moralmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf53ce7-9fb1-3a62-a045-fd968b9572d5",
                    "sense_definition": "To spoil food by contamination.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bacteria can quickly <w>taint</w> raw meat if it is left out.",
                            "target_lang_translations": {
                                "cs": "Bakterie mohou syrové maso rychle <w>zkazit</w>, pokud je ponecháno venku.",
                                "ru": "Бактерии могут быстро <w>испортить</w> сырое мясо, если оставить его на открытом воздухе.",
                                "es": "Las bacterias pueden <w>contaminar</w> rápidamente la carne cruda si se deja fuera."
                            }
                        },
                        {
                            "text": "Improper storage will <w>taint</w> the food.",
                            "target_lang_translations": {
                                "cs": "Nesprávné skladování potraviny <w>znehodnotí</w>.",
                                "ru": "Неправильное хранение <w>испортит</w> продукты.",
                                "es": "Un almacenamiento inadecuado <w>echará a perder</w> la comida."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taint food"
                    ],
                    "target_lang_definitions": {
                        "cs": "Znehodnotit potraviny kontaminací.",
                        "ru": "Испортить продукты питания в результате загрязнения.",
                        "es": "Echar a perder o contaminar los alimentos."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zkazit",
                                "target_lang_sense_clarification": "obecné znehodnocení potravin"
                            },
                            {
                                "target_lang_word": "kontaminovat",
                                "target_lang_sense_clarification": "znehodnocení bakteriemi či jinými látkami"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "общее ухудшение качества еды"
                            },
                            {
                                "target_lang_word": "заразить",
                                "target_lang_sense_clarification": "бактериальное или биологическое загрязнение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "contaminar",
                                "target_lang_sense_clarification": "afectar alimentos con bacterias o toxinas"
                            },
                            {
                                "target_lang_word": "echar a perder",
                                "target_lang_sense_clarification": "arruinar la comestibilidad de un alimento"
                            },
                            {
                                "target_lang_word": "descomponer",
                                "target_lang_sense_clarification": "hacer que empiece a pudrirse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d62dfda-e6c8-3888-81bb-569b94d82b38",
                    "sense_definition": "To be affected with the beginning of decay or rot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contaminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meat will <w>taint</w> quickly in the summer heat.",
                            "target_lang_translations": {
                                "cs": "Maso se v letním horku rychle <w>zkazí</w>.",
                                "ru": "Мясо быстро <w>портится</w> в летнюю жару.",
                                "es": "La carne se <w>echará a perder</w> rápidamente con el calor del verano."
                            }
                        },
                        {
                            "text": "The fish began to <w>taint</w> after hours in the sun.",
                            "target_lang_translations": {
                                "cs": "Ryba se po hodinách na slunci začala <w>kazit</w>.",
                                "ru": "Рыба начала <w>тухнуть</w> после нескольких часов на солнце.",
                                "es": "El pescado empezó a <w>descomponerse</w> tras pasar horas al sol."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Začít podléhat rozkladu nebo hnilobě.",
                        "ru": "Начинать подвергаться разложению или гниению.",
                        "es": "Comenzar a descomponerse o pudrirse (especialmente la comida)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kazit se",
                                "target_lang_sense_clarification": "proces počínajícího rozkladu"
                            },
                            {
                                "target_lang_word": "hnít",
                                "target_lang_sense_clarification": "pokročilejší fáze rozkladu"
                            },
                            {
                                "target_lang_word": "zkazit se",
                                "target_lang_sense_clarification": "dokonavý vid: rychle se zkazit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "портиться",
                                "target_lang_sense_clarification": "процесс начала разложения"
                            },
                            {
                                "target_lang_word": "тухнуть",
                                "target_lang_sense_clarification": "процесс гниения белковых продуктов"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "echarse a perder",
                                "target_lang_sense_clarification": "iniciar el deterioro o mal estado"
                            },
                            {
                                "target_lang_word": "descomponerse",
                                "target_lang_sense_clarification": "proceso de degradación o podredumbre"
                            },
                            {
                                "target_lang_word": "pudrirse",
                                "target_lang_sense_clarification": "empezar a podrirse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b9fe47b-b518-3eaf-97d4-b51f2e1178da",
                    "sense_definition": "A mark of disgrace or blemish on one's character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corruption scandal left a permanent <w>taint</w> on his political career.",
                            "target_lang_translations": {
                                "cs": "Korupční skandál zanechal na jeho politické kariéře trvalou <w>poskvrnu</w>.",
                                "ru": "Коррупционный скандал оставил неизгладимое <w>пятно</w> на его политической карьере.",
                                "es": "El escándalo de corrupción dejó una <w>mancha</w> imborrable en su carrera política."
                            }
                        },
                        {
                            "text": "He tried to remove the <w>taint</w> of dishonesty from his name.",
                            "target_lang_translations": {
                                "cs": "Snažil se ze svého jména smýt <w>poskvrnu</w> nečestnosti.",
                                "ru": "Он пытался смыть <w>пятно</w> нечестности со своего имени.",
                                "es": "Intentó borrar la <w>mancha</w> de deshonestidad de su nombre."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taint on character"
                    ],
                    "target_lang_definitions": {
                        "cs": "Známka hanby nebo poskvrna na něčí pověsti.",
                        "ru": "Признак позора или пятно на чьей-либо репутации.",
                        "es": "Mancha o estigma que deshonra la reputación o el carácter de alguien."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poskvrna",
                                "target_lang_sense_clarification": "morální vada na pověsti"
                            },
                            {
                                "target_lang_word": "ostuda",
                                "target_lang_sense_clarification": "společenská diskreditace"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "моральный ущерб репутации"
                            },
                            {
                                "target_lang_word": "позор",
                                "target_lang_sense_clarification": "общественное осуждение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mancha",
                                "target_lang_sense_clarification": "deshonra o desdoro en la reputación"
                            },
                            {
                                "target_lang_word": "estigma",
                                "target_lang_sense_clarification": "marca de deshonra o descrédito social"
                            },
                            {
                                "target_lang_word": "desdoro",
                                "target_lang_sense_clarification": "menoscabo del honor o la fama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "978ca573-49a2-3f9b-9db9-59cbdd6f5438",
                    "sense_definition": "A contamination or decay, especially in food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a slight <w>taint</w> in the milk that made it taste sour.",
                            "target_lang_translations": {
                                "cs": "V mléce byla lehká <w>pachuť</w>, kvůli které chutnalo kysele.",
                                "ru": "В молоке был легкий <w>привкус</w>, из-за которого оно казалось кислым.",
                                "es": "Había un ligero <w>deje agrio</w> en la leche que hacía que supiera ácida."
                            }
                        },
                        {
                            "text": "The <w>taint</w> in the water made it unsafe to drink.",
                            "target_lang_translations": {
                                "cs": "Kvůli <w>kontaminaci</w> vody nebylo bezpečné ji pít.",
                                "ru": "Из-за <w>загрязнения</w> воду стало небезопасно пить.",
                                "es": "La <w>contaminación</w> del agua hizo que no fuera seguro beberla."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taint in food"
                    ],
                    "target_lang_definitions": {
                        "cs": "Kontaminace nebo rozklad, zejména u potravin.",
                        "ru": "Загрязнение или разложение, особенно в продуктах питания.",
                        "es": "Contaminación, impureza o descomposición, especialmente en la comida."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kontaminace",
                                "target_lang_sense_clarification": "přítomnost cizorodých látek"
                            },
                            {
                                "target_lang_word": "zkaženost",
                                "target_lang_sense_clarification": "stav potraviny po rozkladu"
                            },
                            {
                                "target_lang_word": "pachuť",
                                "target_lang_sense_clarification": "cizí pachuť jako známka zkažení"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "загрязнение",
                                "target_lang_sense_clarification": "наличие посторонних примесей"
                            },
                            {
                                "target_lang_word": "порча",
                                "target_lang_sense_clarification": "состояние продукта после разложения"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "посторонний привкус как признак порчи"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "contaminación",
                                "target_lang_sense_clarification": "presencia de agentes nocivos"
                            },
                            {
                                "target_lang_word": "impureza",
                                "target_lang_sense_clarification": "sustancia extraña o defecto"
                            },
                            {
                                "target_lang_word": "corrupción",
                                "target_lang_sense_clarification": "descomposición o putrefacción"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84625d57-9707-3533-b16b-d7afa4fe1274",
                    "sense_definition": "A small trace or touch of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>taint</w> of sadness in her voice.",
                            "target_lang_translations": {
                                "cs": "V jejím hlase byl <w>nádech</w> smutku.",
                                "ru": "В её голосе был <w>оттенок</w> грусти.",
                                "es": "Había un <w>tinte</w> de tristeza en su voz."
                            }
                        },
                        {
                            "text": "The wine had a faint <w>taint</w> of oak.",
                            "target_lang_translations": {
                                "cs": "Víno mělo slabý <w>nádech</w> dubu.",
                                "ru": "Вино имело слабый <w>оттенок</w> дуба.",
                                "es": "El vino tenía un ligero <w>deje</w> a roble."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá stopa nebo nádech něčeho.",
                        "ru": "Небольшой след или оттенок чего-либо.",
                        "es": "Leve rastro, matiz o toque de algo."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nádech",
                                "target_lang_sense_clarification": "lehký podtón nebo stopa vlastnosti"
                            },
                            {
                                "target_lang_word": "stopa",
                                "target_lang_sense_clarification": "nepatrné množství něčeho"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "легкий подтон или след качества"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "незначительная нотка в чем-либо"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deje",
                                "target_lang_sense_clarification": "ligero matiz o sabor secundario"
                            },
                            {
                                "target_lang_word": "tinte",
                                "target_lang_sense_clarification": "matiz o pequeña señal de una cualidad"
                            },
                            {
                                "target_lang_word": "pizca",
                                "target_lang_sense_clarification": "cantidad mínima o leve indicio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}