                "translations": [
                    {
                        "translation_id": "e4bbc92f-4830-47b3-b626-307c899f2af2",
                        "source_entry_id": "a6cc68be-80f7-3a2f-ab1a-de19ad90092f",
                        "source_sense_id": "b5b4ee7d-1697-31de-a744-aa5abbdbcde6",
                        "target_lang_word": "suzerain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suzerain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe5ef4d-95f8-3fbc-a3a8-f69d8b481c81",
                                        "entry_id": "bb71ea78-4649-3a14-af3a-7e3eb7a540af",
                                        "glosses": [
                                            "A dominant nation or state that has control over the international affairs of a subservient state which otherwise has domestic autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ab5ca21-df44-4c84-afda-25ce5908052e",
                                                "sense_id": "2fe5ef4d-95f8-3fbc-a3a8-f69d8b481c81",
                                                "text": "Suzerainty is a term which was originally used for the relation between the feudal lord and his vassal; the lord was said to be the suzerain of the vassal, and at that time suzerainty was a term of Constitutional Law only. With the disappearance of the feudal system, suzerainty of this kind likewise disappeared. Modern suzerainty involves only a few rights of the suzerain State over the vassal State which can be called constitutional rights. The rights of the suzerain State over the vassal are principally international rights, of whatever they may consist."
                                            },
                                            {
                                                "example_id": "9d14eebb-771b-46fd-849d-b5aa2740dc9a",
                                                "sense_id": "2fe5ef4d-95f8-3fbc-a3a8-f69d8b481c81",
                                                "text": "The origin of these conflicts is to be sought in the position which Rome acquired about 275 b.c. as suzerain and protector of all Italy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e6bc4bf-e45a-376c-8d75-71906d07fbfa",
                                        "entry_id": "bb71ea78-4649-3a14-af3a-7e3eb7a540af",
                                        "glosses": [
                                            "A feudal landowner to whom vassals were forced to pledge allegiance."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49103237-10a1-42b6-a479-e79a0fe2a229",
                        "source_entry_id": "a6cc68be-80f7-3a2f-ab1a-de19ad90092f",
                        "source_sense_id": "b5b4ee7d-1697-31de-a744-aa5abbdbcde6",
                        "target_lang_word": "suzerain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suzerain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "908d4eb2-150c-3e05-aba0-bfc0c872395b",
                                        "entry_id": "b9cc4d05-0805-3ecd-a5f3-a8d129798249",
                                        "glosses": [
                                            "Se dit d’un seigneur possédant un fief dont d’autres fiefs relevaient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ea2825-8d6f-4363-b98b-b82b2b38d45d",
                                                "sense_id": "908d4eb2-150c-3e05-aba0-bfc0c872395b",
                                                "text": "Le seigneur suzerain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805870b4-ba89-333d-9ddb-f78e364e2c79",
                                        "entry_id": "b9cc4d05-0805-3ecd-a5f3-a8d129798249",
                                        "glosses": [
                                            "Qui remplit des fonctions de protectorat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ff9ca4-90bb-4aaa-854e-e1873aa25da3",
                                                "sense_id": "805870b4-ba89-333d-9ddb-f78e364e2c79",
                                                "text": "Dans les pays de protectorat, plus que partout ailleurs, il est rare que les représentants de l’État suzerain, après un séjour prolongé au milieu de la race subjuguée, ne s’affranchissent pas des scrupules de l’honnêteté vulgaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suzerain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2a3008-6cfc-38ec-9562-94a34e58b154",
                                        "entry_id": "ca7404b5-a790-385d-9d24-5ff87b558495",
                                        "glosses": [
                                            "Relatif à La Suze-sur-Sarthe, commune française située dans le département de la Sarthe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "suzerain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19e196ce-0baa-3027-a0c8-c3469c6838ed",
                                        "entry_id": "2ef56dbd-a253-3548-aa60-103f8da723e6",
                                        "glosses": [
                                            "Seigneur possédant un fief dont d’autres fiefs relèvent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e387468-86db-4d33-810b-ebd83ee35802",
                                                "sense_id": "19e196ce-0baa-3027-a0c8-c3469c6838ed",
                                                "text": "Rambervillers dépendait du temporel de l'évêché de Metz, et les évêques en étaient les suzerains ; […]."
                                            },
                                            {
                                                "example_id": "efca399d-46e2-430c-86b1-a3d10e3e5443",
                                                "sense_id": "19e196ce-0baa-3027-a0c8-c3469c6838ed",
                                                "text": "Sur la foi jurée à vos Saintes, sur la fidélité au suzerain, sur la légitimité du roi de France, rapportez-vous-en à nous, disaient-ils."
                                            },
                                            {
                                                "example_id": "8bc5be29-56c1-4a9f-ae8b-b1ba7f56ac24",
                                                "sense_id": "19e196ce-0baa-3027-a0c8-c3469c6838ed",
                                                "text": "Le relâchement du lien vassalitique est une des causes de la défaite finale du Midi et de son suzerain, le comte de Toulouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4caf6349-d772-3cd9-87bd-d82c722f0fd0",
                                        "entry_id": "2ef56dbd-a253-3548-aa60-103f8da723e6",
                                        "glosses": [
                                            "Pays qui domine un autre pays, donnant à celui-ci certaines autonomies domestiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
