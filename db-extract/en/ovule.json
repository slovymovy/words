                                    {
                                        "sense_id": "ae4d01ab-aae2-3bf9-beb4-afdab02e9c6d",
                                        "entry_id": "11a6609a-e7e3-3a79-97a3-165aae3024ee",
                                        "glosses": [
                                            "een klein knopje in het vruchtbeginsel waaruit na bevruchting een zaadje groeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af753fc-bed3-44ee-9dda-636c4d977492",
                                                "sense_id": "ae4d01ab-aae2-3bf9-beb4-afdab02e9c6d",
                                                "text": "Op deze afbeelding is de zaadknop van de plant goed weergegeven."
                                            }
                                        ]
                                    }
                                ]
