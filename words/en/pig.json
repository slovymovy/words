        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7a38335-3d05-38ae-8d41-004385e22c4d",
                    "sense_definition": "To eat a large amount of food greedily.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_eat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>pig</w> out on pizza and ice cream all night.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>обожраться</w> пиццей и мороженым на всю ночь.",
                                "zh": "我们决定整晚<w>暴饮暴食</w>披萨和冰淇淋。"
                            }
                        },
                        {
                            "text": "He spent the whole weekend <w>pigging</w> on junk food.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, <w>налегая</w> на вредную еду.",
                                "zh": "他整个周末都在<w>大吃大喝</w>垃圾食品。"
                            }
                        }
