                    {
                        "translation_id": "7c3e4dc2-a797-49df-b439-1e78f14771cf",
                        "source_entry_id": "2b494c0f-5bce-3ed0-8d31-0f619b07611f",
                        "source_sense_id": "92e21ece-0c1f-31d4-b292-c81fca3d4ba6",
                        "target_lang_word": "Birne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15584eb6-90bd-33d0-a9c8-c1f833c532ec",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Obstbaumart"
                                        ],
                                        "tags": [
                                            "Pyrus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a543c8d-f6a6-451b-a4cc-1e2c2ac03087",
                                                "sense_id": "15584eb6-90bd-33d0-a9c8-c1f833c532ec",
                                                "text": "Die Birne blüht früher als der Apfel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "grün-gelbliche Frucht dieses Obstbaumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3658929b-b376-46cc-b6af-f7397d0e2539",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "Ich esse lieber Birnen als Äpfel."
                                            },
                                            {
                                                "example_id": "f5c8a585-d99e-4a69-b68e-f8752391dc71",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "Herr von Ribbeck auf Ribbeck im Havelland: […] Und kam die goldene Herbsteszeit, - Und die Birnen leuchteten weit und breit, - Da stopfte, wenn’s Mittag vom Thurme scholl, - Der von Ribbeck sich beide Taschen voll - […]"
                                            },
                                            {
                                                "example_id": "48e01126-1edc-46f1-b808-6a5c5b319efd",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "„Über die Katze von Saint-Allyre staunte sie sehr, über die Birne in der Karaffe etwas weniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Kopf"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffd919d-1913-4603-8cf5-e1dda8ebeb8d",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "Er hat nichts in der Birne."
                                            },
                                            {
                                                "example_id": "70971df6-9376-45aa-9555-92b586c3e5d2",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "Wer keine weiche Birne hat, kauft harte Äpfel aus Halberstadt."
                                            },
                                            {
                                                "example_id": "931786ef-ef97-43a5-b2a5-3a1cf58c4ab9",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "„Du hast Grips in der Birne und solltest als Philosoph tätig sein, anstatt dubiosen Geschäftspartnern Triebwerke zu verhökern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Glühbirne"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b48dec1-493f-4e46-a6bf-dd7c67841dd3",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "Oh, die Lampe geht nicht mehr, ich muss die Birne wechseln."
                                            },
                                            {
                                                "example_id": "dd8d1c47-f31e-4911-8647-7918eb53cfa1",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "Dank des Preisverfalls werden die innovativen [LED-]Birnen bald zum Massenprodukt, Experten prognostizieren dies schon für das nächste Jahr."
                                            },
                                            {
                                                "example_id": "a2aa785f-be50-4e7e-a737-d55a62e6ce24",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "„Auf sein Banjo war in Schwarz eine Szene am Palmenstrand gemalt, und innen waren rote, gelbe und grüne elektrische Birnen, die aufflackerten und erloschen, während er spielte.“"
                                            },
                                            {
                                                "example_id": "b32fc452-77e2-42b0-aaab-46fc8342ede7",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "„Er stößt gegen die Birne, fällt, krabbelt, fliegt wieder hoch und umkreist das Licht aufs neue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36478fb1-4339-3125-9d91-6127e746186d",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "„auswechselbares, verdicktes Verbindungsstück zwischen Mundstück und Röhre der Klarinette“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5625ada9-f990-482a-be1b-2b559b2ed8a0",
                                                "sense_id": "36478fb1-4339-3125-9d91-6127e746186d",
                                                "text": "„Es kann durchaus sein, daß die eine Klarinette eines Satzes eine engere und die andere Klarinette eine weitere Bohrung der Birne benötigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
