        "fr-extract.jsonl": [
            {
                "entry_id": "dcfd618d-552e-3bd3-bb2d-c36e887fc978",
                "word": "catastrophiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                        "entry_id": "dcfd618d-552e-3bd3-bb2d-c36e887fc978",
                        "glosses": [
                            "D'une manière catastrophique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c70a17-825c-40f1-aa71-05b2d91dda31",
                                "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                                "text": "Ainsi, un producteur de produits alimentaires ne se nourrit jamais mieux que lorsque les prix de ses produits tombent catastrophiquement et que sa situation matérielle empire."
                            },
                            {
                                "example_id": "fbe073a8-a1f4-48a5-b4df-ac5b69e06107",
                                "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                                "text": "On peut dire qu’on y aura mis le temps, mais mieux vaut très tard qu’absolument jamais, comme on dit quand on est catastrophiquement en retard."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc3d16ba-8c1a-3c39-8add-04b95e7c364f",
                        "entry_id": "dcfd618d-552e-3bd3-bb2d-c36e887fc978",
                        "glosses": [
                            "Très brutalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebc05a2-30fd-4d97-9278-9ee895513b66",
                                "sense_id": "bc3d16ba-8c1a-3c39-8add-04b95e7c364f",
                                "text": "Il existera donc en général des points singuliers de W où il sera catastrophiquement substitué par un autre."
                            }
                        ]
                    }
                ],
