                        "entry_id": "11431817-1bfc-398f-9802-ca2c133b1d02",
                        "glosses": [
                            "An Israelite judge in the Old Testament who performed feats of strength against the Philistines but was betrayed by Delilah his mistress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbdb849b-be86-4d89-a449-e97ecb4759e0",
                                "sense_id": "52477f7e-d445-3ed9-a8f1-3173323b23af",
                                "text": "And Delilah ſaid to Samſon, Tel me, I pray thee, wherein thy great ſtrength lyeth, and wherewith thou mighteſt be bound, to afflict thee."
                            }
                        ]
                    },
