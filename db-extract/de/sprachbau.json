                "senses": [
                    {
                        "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                        "entry_id": "1780d5e9-0ff3-3c26-972a-9ba9e62b8ab8",
                        "glosses": [
                            "Linguistik: Art und Weise, wie die grammatischen und lexikalischen Einheiten und Regeln einer Sprache organisiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb87aaa-9620-4f4f-b976-b389a360024e",
                                "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                                "text": "In der kontrastiven Linguistik und in der Sprachtypologie werden Vergleiche hinsichtlich des Sprachbaues durchgeführt."
                            },
                            {
                                "example_id": "c4032c09-226d-4312-b57d-27c83fe684d7",
                                "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                                "text": "„Das Verb selbst ist allmählich nur noch Träger der Tempusfunktion; Numerus, Modus und Tempus werden von anderen Elementen übernommen…: eine Entwicklung vom synthetischen zum analytischen, vom flektierenden zum isolierenden Sprachbau.“"
                            },
                            {
                                "example_id": "4a03fd80-6a2f-49e6-8cf2-cb5d146f53ea",
                                "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                                "text": "„Grammatiktheoretisch wird diese Veränderung als Wandel vom synthetischen zum analytischen Sprachbau klassifiziert…“"
                            },
                            {
                                "example_id": "48695f9a-82d5-4fb7-8f74-ba848dc1deee",
                                "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                                "text": "„Aufgrund der Morphemstruktur der Wörter können drei Typen des Sprachbaus unterschieden werden:…“"
                            },
                            {
                                "example_id": "e0a3538c-ffde-49fa-8240-61eb44fb083a",
                                "sense_id": "0d10cf3e-45e2-31eb-9949-aa40eb5e8346",
                                "text": "„Auf diese Weise vereinheitlichte sich der Sprachbau des Jiddischen und verselbständigte sich endgültig gegenüber allen Formen des Deutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
