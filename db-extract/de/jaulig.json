                        "form": "es ist jaulig"
                    },
                    {
                        "form_id": "0ab06a20-2f1f-44e7-8c2a-996dede32718",
                        "entry_id": "a2466512-2d6a-396b-ae6e-f79dfffc37df",
                        "tags": [
                            "positive",
                            "predicative",
