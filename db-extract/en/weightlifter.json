                                "target_senses": [
                                    {
                                        "sense_id": "689527ce-46ab-3d42-89fa-3cc07f96bcd3",
                                        "entry_id": "92655604-a21e-3d01-be4a-39c0f1176453",
                                        "glosses": [
                                            "Personne pratiquant l’haltérophilie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efac7ce6-552f-4096-93e5-34ad7b5ede8f",
                                                "sense_id": "689527ce-46ab-3d42-89fa-3cc07f96bcd3",
                                                "text": "Cet haltérophile sait porter jusqu’à 150kg à l’arraché."
                                            },
                                            {
                                                "example_id": "27250721-dc21-4024-b557-0b9c66dd8e4d",
                                                "sense_id": "689527ce-46ab-3d42-89fa-3cc07f96bcd3",
                                                "text": "À cet âge-là, dans mon club, je fais aussi la connaissance d’un haltérophile, à peine plus âgé que moi, qui est déjà sélectionné olympique pour les Jeux de Melbourne en 1956, Marcel Paterni."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10ce2102-1722-4751-abdf-4c527dd41ac9",
                        "source_entry_id": "f290ea35-26a1-3363-a781-ae7f63cc60f2",
                        "source_sense_description": "person who competes for maximum weight lifted",
                        "target_lang_word": "Gewichtheber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
