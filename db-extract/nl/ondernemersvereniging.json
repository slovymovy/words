                        "examples": [
                            {
                                "example_id": "5942790c-c1e7-4818-9c54-1399a0d6ce26",
                                "sense_id": "2ff1c6c6-625d-3446-a2d9-c8b91a43ae2d",
                                "text": "Volgens Evofenedex, de ondernemersvereniging voor de handel en logistiek, zijn de oplopende wachttijden het gevolg van een combinatie van de sancties tegen Rusland, de na-ijleffecten van corona en de krapte op de arbeidsmarkt die onder meer leidt tot een tekort aan laders en lossers in de haven."
                            },
                            {
                                "example_id": "df5c6587-5fa5-42a4-9e14-9eb02dd3da9e",
                                "sense_id": "2ff1c6c6-625d-3446-a2d9-c8b91a43ae2d",
                                "text": "Vanwege de vervroegde avondklok zijn veel winkels op Curaçao niet opengegaan, meldt voorzitter Mahesh Mukhi van ondernemersvereniging Downtown Management Organization (DMO) aan deze site. Een deel van de winkeliers op het eiland heeft uit voorzorg zandzakken voor hun winkels geplaatst, vooral aan de waterkant van de hoofdstad Willemstad."
                            }
                        ]
