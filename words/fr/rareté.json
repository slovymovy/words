                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prix de ces métaux augmente fortement en raison de leur <w>rareté</w> sur le marché international."
                        },
                        {
                            "text": "La <w>rareté</w> des pluies durant cet été a causé de graves problèmes aux agriculteurs de la région."
                        }
                    ],
                    "synonyms": [
