{
    "word_family": [
        "desperate",
        "desperation",
        "despair"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                    "sense_definition": "In a way that shows a great need or a hopeless feeling, often without regard for danger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>desperately</w> grabbed at the nearby branches as she heard the wood start to snap.",
                            "target_lang_translations": {
                                "ru": "Она <w>отчаянно</w> хваталась за ближайшие ветки, услышав, как дерево начало трещать."
                            }
                        },
                        {
                            "text": "The thirsty travelers were <w>desperately</w> seeking water in the middle of the dry desert.",
                            "target_lang_translations": {
                                "ru": "Томимые жаждой путешественники <w>отчаянно</w> искали воду посреди сухой пустыни."
                            }
                        }
                    ],
                    "synonyms": [
                        "frantically",
                        "recklessly",
                        "hopelessly",
                        "urgently",
                        "badly"
                    ],
                    "antonyms": [
                        "calmly",
                        "composedly"
                    ],
                    "common_phrases": [
                        "desperately seeking help",
                        "desperately trying to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способом, выражающим крайнюю нужду или чувство безнадежности, часто без оглядки на опасность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчаянно",
                                "target_lang_sense_clarification": "с чувством безнадежности или риска"
                            },
                            {
                                "target_lang_word": "безнадежно",
                                "target_lang_sense_clarification": "без надежды на успех"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                    "sense_definition": "To an extreme degree; used to emphasize a quality or a need.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The race for the silver medal was <w>desperately</w> close and required a photo finish.",
                            "target_lang_translations": {
                                "ru": "Борьба за серебряную медаль была <w>крайне</w> напряженной и потребовала фотофиниша."
                            }
                        },
                        {
                            "text": "After working for twelve hours without a break, I am <w>desperately</w> short of sleep.",
                            "target_lang_translations": {
                                "ru": "После двенадцати часов работы без перерыва мне <w>ужасно</w> не хватает сна."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "critically",
                        "terribly"
                    ],
                    "antonyms": [
                        "slightly",
                        "mildly"
                    ],
                    "common_phrases": [
                        "desperately short of",
                        "desperately close"
                    ],
                    "target_lang_definitions": {
                        "ru": "В крайней степени; используется для подчеркивания качества или потребности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "в высшей степени"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "очень сильно, в разговорной речи"
                            },
                            {
                                "target_lang_word": "отчаянно",
                                "target_lang_sense_clarification": "чрезвычайно сильно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}