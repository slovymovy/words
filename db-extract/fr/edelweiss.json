                    {
                        "sense_id": "73f0314f-749e-3553-9eae-915592b5c158",
                        "entry_id": "4d114772-9985-3a81-9e80-d85055517ff1",
                        "glosses": [
                            "Variante de édelweiss."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2982b179-cafd-40da-be96-06a6eb060d3a",
                                "sense_id": "73f0314f-749e-3553-9eae-915592b5c158",
                                "text": "Immanquables, des plantes protégées telles que le sabot de Vénus de la famille des Orchidacées, le chardon bleu des Alpes, mais aussi l’emblème de la Savoie, l’edelweiss, minuscule en haute montagne qui peut atteindre des proportions plus importantes en plaine."
                            },
                            {
                                "example_id": "b3fbdcd5-4c20-40cd-9df4-8f8220c41795",
                                "sense_id": "73f0314f-749e-3553-9eae-915592b5c158",
                                "text": "Un edelweiss séché glissa d’une des enveloppes de rhodoïd et M. Abel le replaça avec des gestes précautionneux sur la photo aux vilaines couleurs qui lui servait de support : sur un vague fond de mosquée, trois militaires en calot et treillis se tenaient par l’épaule."
                            }
                        ]
                    }
