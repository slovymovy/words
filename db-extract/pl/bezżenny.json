                    {
                        "translation_id": "e1b597f6-1f3f-44e1-bb14-03db9ec0fecf",
                        "source_entry_id": "a49ab1d2-e674-3f22-bd2b-e5d8b65285bd",
                        "source_sense_id": "c0debbbd-b78d-3b6a-be08-064e5d545944",
                        "source_sense_description": "keine Ehefrau habend: ehelos, unverheiratet, ledig",
                        "target_lang_word": "unverheiratet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverheiratet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f1830d-c348-35aa-9d47-58c2643323eb",
                                        "entry_id": "d507d9fe-6a59-338a-a32f-919ce54803d8",
                                        "glosses": [
                                            "keine Ehefrau oder Ehemann habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82749b56-3e13-4ff2-9c18-3755b7efa376",
                                                "sense_id": "a2f1830d-c348-35aa-9d47-58c2643323eb",
                                                "text": "Sie ist schon 30 Jahre alt und noch immer unverheiratet."
                                            },
                                            {
                                                "example_id": "43d3364f-1f96-4e5e-a9f0-cfa2879cef03",
                                                "sense_id": "a2f1830d-c348-35aa-9d47-58c2643323eb",
                                                "text": "„Ein unverheirateter Mann, sagte Werner, sei noch nie ein guter Neptunist gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7608d434-cc03-47f9-8c08-75eaf0e014b7",
                        "source_entry_id": "a49ab1d2-e674-3f22-bd2b-e5d8b65285bd",
                        "source_sense_id": "c0debbbd-b78d-3b6a-be08-064e5d545944",
                        "source_sense_description": "keine Ehefrau habend: ehelos, unverheiratet, ledig",
                        "target_lang_word": "ledig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ledig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce390d1-ef99-38d9-b002-4f90d03e9b3c",
                                        "entry_id": "30be19b5-c62c-3a03-a985-033508ada826",
                                        "glosses": [
                                            "noch nie verheiratet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329feccd-3bd0-4973-b957-0ca0a0349210",
                                                "sense_id": "4ce390d1-ef99-38d9-b002-4f90d03e9b3c",
                                                "text": "Noch bin ich ledig, aber Monika und ich planen bald zu heiraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dcb659e-b272-3dc7-977f-a3435c3f13a3",
                                        "entry_id": "30be19b5-c62c-3a03-a985-033508ada826",
                                        "glosses": [
                                            "frei, ledig einer Sache ledig: frei von einer Sache, unbehindert von einer Sache"
                                        ],
                                        "tags": [
                                            "regiert den Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71165173-33c4-4795-9961-d0c96da8f9f1",
                                                "sense_id": "9dcb659e-b272-3dc7-977f-a3435c3f13a3",
                                                "text": "Seitdem ich einen neuen Arbeitsplatz gefunden habe, fühle ich mich aller Sorgen ledig."
                                            },
                                            {
                                                "example_id": "e84fbc39-2354-4d44-b498-e505f130311a",
                                                "sense_id": "9dcb659e-b272-3dc7-977f-a3435c3f13a3",
                                                "text": "„Das Mädchen brachte den Topf seiner Mutter heim, und nun waren sie ihrer Armut und ihres Hungers ledig und aßen süßen Brei, sooft sie wollten.“"
                                            },
                                            {
                                                "example_id": "6388e0f7-c559-4456-a75f-788c3a55a66b",
                                                "sense_id": "9dcb659e-b272-3dc7-977f-a3435c3f13a3",
                                                "text": "„Ralph ging am Schluß, dankbar, der Verantwortung für eine Weile ledig zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21c68782-4385-3f7e-a4e8-5e33bcdbd684",
                                        "entry_id": "30be19b5-c62c-3a03-a985-033508ada826",
                                        "glosses": [
                                            "(von einem Kind) unehelich"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b36a956-b444-4d56-88b3-caee94047731",
                                                "sense_id": "21c68782-4385-3f7e-a4e8-5e33bcdbd684",
                                                "text": "„Franz Jägerstätter, der 1907 als lediges Kind einer Bauernmagd in St. Radegund geboren wurde, war ein einfacher Bauernsohn, der nur sieben Jahre Volksschulbildung hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "148504de-3c22-390a-a8c9-d6b2d79b8d3c",
                                        "entry_id": "30be19b5-c62c-3a03-a985-033508ada826",
