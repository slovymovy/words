                                "target_senses": [
                                    {
                                        "sense_id": "234975d7-48da-3d27-b0e7-6602d53a1c84",
                                        "entry_id": "0f67f043-e3ab-3290-a602-5e27cb0b3cf3",
                                        "glosses": [
                                            "Acronym of assigned gender at birth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603f1e5d-8dc8-4d1b-8b10-36c2f8a6af1d",
                                                "sense_id": "234975d7-48da-3d27-b0e7-6602d53a1c84",
                                                "text": "The signup form on their website did not have a non-binary option, so I had to select my AGAB instead."
                                            },
                                            {
                                                "example_id": "e1890f54-cb08-4740-ab5a-024738b23171",
                                                "sense_id": "234975d7-48da-3d27-b0e7-6602d53a1c84",
                                                "text": "Since I came out to myself, I felt myself stop dressing in the way I thought I was \"supposed\" to dress based on my assigned gender at birth (AGAB). […] It can still be scary to dress in a way that doesn't match what I was taught based on my AGAB, but it's also really empowering to embrace who I truly am and share it with everyone."
                                            },
                                            {
                                                "example_id": "9f09cc01-caf7-4d14-93d0-8f68ddd14b8a",
                                                "sense_id": "234975d7-48da-3d27-b0e7-6602d53a1c84",
                                                "text": "Genderfluid people can question themselves, worrying that they're \"supposed to transition\" or that they're \"regressing\" if they present as their AGAB, or that they're a fraud if one of their gender forms happens to be their AGAB. Accepting genderfluidity, however, means accepting how many forms one's gender can take."
                                            },
                                            {
                                                "example_id": "5fd42704-3e07-4c79-aae4-7b6d0ceef51e",
                                                "sense_id": "234975d7-48da-3d27-b0e7-6602d53a1c84",
                                                "text": "Your AGAB is the gender that you were assigned at birth based on what your doctor and parents decided you were due to the shape of your genitals. […] The term transgender […] was originally used for people who are transitioning to a presentation different from the one associated with their AGAB. It is used more broadly now to refer to people who do not identify with their gender assigned at birth, whether they were assigned male and know that they are female, assigned female and know their gender to be fluid and flowing, or any combination thereof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
