                        "source_entry_id": "a1aa5ca5-6966-3cc0-aea5-d4ed452355ee",
                        "source_sense_id": "86ddc155-a83b-35fc-b0aa-086229b10092",
                        "source_sense_description": "tending to pollute; causing pollution",
