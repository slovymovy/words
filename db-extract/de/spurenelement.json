                "senses": [
                    {
                        "sense_id": "33bcbaae-7aea-3cca-8832-620547e721b4",
                        "entry_id": "d8fcf6b5-457c-30bd-ae51-8e83868476eb",
                        "glosses": [
                            "Substanz, die nur in sehr geringer Konzentration vorkommt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2126ac40-e854-34d0-96a9-e2410401e95b",
                        "entry_id": "d8fcf6b5-457c-30bd-ae51-8e83868476eb",
                        "glosses": [
                            "Substanz, die ein Körper benötigt, aber nur in sehr geringer Menge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f344923c-8b14-4a5f-82ea-70da59562067",
                                "sense_id": "2126ac40-e854-34d0-96a9-e2410401e95b",
                                "text": "„Die Gülle, die vom Hof nicht vollständig auszubringen ist, wird von Vertragsfirmen mit blankpolierten Tankwagen zum öffentlichen Wirtschaftsdüngerlager, oft auch in andere, teilweise weit entfernt liegende Regionen gefahren, wo die meisten Ackerbauern selbst keine Tiere mehr halten, dafür jedoch für ihren Anbau von Mais, Roggen und Weizen Phosphor, Stickstoff und Spurenelemente gut gebrauchen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93f04c1f-ad1f-4f29-b6e0-9fe1b790fffe",
                        "source_entry_id": "d8fcf6b5-457c-30bd-ae51-8e83868476eb",
                        "source_sense_id": "33bcbaae-7aea-3cca-8832-620547e721b4",
                        "source_sense_description": "Chemie, Geologie: Substanz, die nur in sehr geringer Konzentration vorkommt",
                        "target_lang_word": "микроэлемент",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "микроэлемент",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6892a1d-31b0-3fdd-858a-588416f62a69",
                                        "entry_id": "61771a73-1266-3cfc-ac91-f86617ce2337",
                                        "glosses": [
                                            "мед., биол. элемент, который необходим организму в минимальной концентрации для его нормального роста и развития"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f496ef5-d567-4855-a379-d5f46570eba4",
                                                "sense_id": "d6892a1d-31b0-3fdd-858a-588416f62a69",
                                                "text": "Ещё более поразителен повышенный интерес многих обитателей моря к микроэлементам. Содержание ряда микроэлементов (железа, марганца, цинка, никеля, кобальта, церия, циркония, рутения и др.) в их организмах в сотни и тысячи раз превосходит содержание этих же элементов в морской воде."
                                            },
                                            {
                                                "example_id": "1f04decf-c0bb-4d00-ae39-8f80aa8089ba",
                                                "sense_id": "d6892a1d-31b0-3fdd-858a-588416f62a69",
                                                "text": "Медь нужна и растениям. Это один из важнейших микроэлементов, участвующий в процессе фотосинтеза и влияющий на усвоение растениями азота."
                                            },
                                            {
                                                "example_id": "29cb0ac2-06b9-42e2-b898-1100890f48b7",
                                                "sense_id": "d6892a1d-31b0-3fdd-858a-588416f62a69",
                                                "text": "Микроэлементы играют большую роль во многих жизненных процессах: они составляют основу важнейших биокатализаторов — металлоэнзимов."
                                            },
                                            {
                                                "example_id": "bcdb0afe-e072-49bc-a8e1-83539f66694e",
                                                "sense_id": "d6892a1d-31b0-3fdd-858a-588416f62a69",
                                                "text": "Живые существа и растения содержат в себе много элементов в дозах, совершенно ничтожных, трудно уловимых. Их называют микроэлементами: бор, молибден, медь, марганец, цинк и другие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
