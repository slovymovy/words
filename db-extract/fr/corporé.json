                "senses": [
                    {
                        "sense_id": "bcafae2a-765d-385a-a2fd-bc12c4480a38",
                        "entry_id": "8179a42b-a5ef-37d1-ba79-af5d07849dfd",
                        "glosses": [
                            "Membru."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b0dc6a-3675-45ee-9d86-b3ea35c0c26f",
                                "sense_id": "bcafae2a-765d-385a-a2fd-bc12c4480a38",
                                "text": "Tous étaient d'une petite taille, aucun d'eux n'ayant plus de quatre pieds onze pouces à cinq pieds ; hommes et femmes étaient gros et fortement corporés."
                            },
                            {
                                "example_id": "057ec8b8-e432-4ec1-8106-7089fffa1f36",
                                "sense_id": "bcafae2a-765d-385a-a2fd-bc12c4480a38",
                                "text": "Des beaux hommes, pour sûr, bien membrés, bien corporés, des gaillards aussi solides que Pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3377aac-56fc-327a-9bb1-bc442c96056f",
                        "entry_id": "8179a42b-a5ef-37d1-ba79-af5d07849dfd",
                        "glosses": [
                            "Constitué, bâti, en parlant de quelqu'un."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c8916310-2cea-4d8e-aa92-a158d407fe25",
                                "sense_id": "d3377aac-56fc-327a-9bb1-bc442c96056f",
                                "text": "Quand on a vingt-cinq ans d'âge et qu'on n'est ni pauvre ni mal corporé, ni bouché de son entendement, on n'a pas raison d'être malheureux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d66cefe4-7a34-3869-bbc6-83a04bc3a8b1",
                        "entry_id": "8179a42b-a5ef-37d1-ba79-af5d07849dfd",
                        "glosses": [
                            "Qui est membre d'une corporation."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "f7d2c02d-098f-4fb3-b525-76abccb5b77d",
                                "sense_id": "d66cefe4-7a34-3869-bbc6-83a04bc3a8b1",
                                "text": "Pour l’élection du député direct, la municipalité […] obtint du Garde des sceaux l’autorisation de réunir indistinctement dans les paroisses tous les membres du tiers, corporés ou non corporés."
                            },
                            {
                                "example_id": "2b76ec52-77cc-4fef-b27c-d484bf8c4dcb",
                                "sense_id": "d66cefe4-7a34-3869-bbc6-83a04bc3a8b1",
                                "text": "La proportion d'ensemble se déduit instantanément : s'il existe bien 34.000 corporés pour 150.000 étudiants, il y a donc 23% d'étudiants corporés."
                            }
                        ]
                    }
