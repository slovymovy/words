                        "examples": [
                            {
                                "example_id": "07c25e5f-3d11-44d5-9a2f-e05ee2c3af84",
                                "sense_id": "5824918d-b11c-3f5b-852f-e3a79150b3f6",
                                "text": "Hij werd als jonge gezel opgeleid door Angelo Gatto zelf, die begin 1900 zijn schoenmakerij begon."
                            },
                            {
                                "example_id": "d41a253c-09eb-495e-8b94-9a8f3717f223",
                                "sense_id": "5824918d-b11c-3f5b-852f-e3a79150b3f6",
                                "text": "Ackermans stelde dat de verwachting bij de winkeliers was dat goederen die konden worden veiliggesteld terug zouden worden gegeven. Hij noemt het voorbeeld van een schoenmakerij in het te slopen gebied, waar de schoenen van klanten en zelf machines van de eigenaar gered werden van de sloop."
                            }
                        ]
                    }
