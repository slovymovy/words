        "fr-extract.jsonl": [
            {
                "entry_id": "36d4ad01-844a-359d-ba93-435a11424885",
                "word": "sensualité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8466352-ee8a-4bfe-9b2a-827bdfd79738",
                        "entry_id": "36d4ad01-844a-359d-ba93-435a11424885",
                        "tags": [
                            "plural"
                        ],
                        "form": "sensualités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6671b745-4a04-3f1b-8166-a92cea8290fb",
                        "entry_id": "36d4ad01-844a-359d-ba93-435a11424885",
                        "glosses": [
                            "Attachement aux plaisirs des sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b365745-7bf0-4a07-ab7b-186286bc8463",
                                "sense_id": "6671b745-4a04-3f1b-8166-a92cea8290fb",
                                "text": "Démétrios la regarda, et devinant, à n’en pas douter, quelle sensualité simple et neuve animait ce corps de jeune fille, il dit : « Je l’adore le premier », et il l’entoura de ses bras."
                            },
                            {
                                "example_id": "c12b383e-7cbe-4bae-9657-48af247ea39c",
                                "sense_id": "6671b745-4a04-3f1b-8166-a92cea8290fb",
                                "text": "…mais Beaumanoir est un homme d’une autre trempe. Il hait la sensualité, il méprise la richesse, et brûle de gagner ce qu’ils appellent la couronne du martyre."
                            },
                            {
                                "example_id": "904737e8-6241-4d2b-a789-8340d4ba0d93",
                                "sense_id": "6671b745-4a04-3f1b-8166-a92cea8290fb",
                                "text": "Qu’il s’agisse de sensualité ou d’expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "75c0c685-0d8e-3dc5-8821-b3d2e5b77940",
                        "entry_id": "36d4ad01-844a-359d-ba93-435a11424885",
                        "glosses": [
                            "Les plaisirs sensuels."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e7781f6d-319d-456c-ada4-b6fb8843a191",
                                "sense_id": "75c0c685-0d8e-3dc5-8821-b3d2e5b77940",
                                "text": "Les saunas ou clubs humides proposent régulièrement des soirées mousse dans l’espace hammam ou autour du jacuzzi. Ce sont des sensations uniques. Cette sensualité de la peau fluide sous les caresses, cette excitation des corps qui se frôlent et glissent les uns contre les autres si le feeling est bon, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46617884-3cc5-4567-b80e-3d3030c7a3e6",
                        "source_entry_id": "36d4ad01-844a-359d-ba93-435a11424885",
                        "target_lang_word": "Sinnlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sinnlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Empfänglichkeit und Hingabe für die Empfindungen und das (angenehme) Erleben der äußeren Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55327336-4210-411d-a284-04152dbdb80c",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "Ich bin wie berauscht von der Sinnlichkeit expressionistischer Gemälde."
                                            },
                                            {
                                                "example_id": "22dbdf11-55a5-4ac2-b596-9dea47df5fae",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "„Die Vorstellung, daß meine oder irgend jemandes Sinnlichkeit gedämpft wurde, war mir ekelhaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Offenheit für/Lust auf Erotisches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b1f823-580f-4ff2-80ac-cb380469f791",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Das Bidet ist Zeuge einer gelebten Sinnlichkeit.“"
                                            },
                                            {
                                                "example_id": "cd897890-10b7-4b8f-bc88-a795af148e14",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Dafür strahlte Adele mehr Sinnlichkeit aus.“"
                                            },
                                            {
                                                "example_id": "46de3234-c3ab-4769-aede-b6d12f9917e9",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Während sie darüber sprachen, entdeckte er ihre Sinnlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
