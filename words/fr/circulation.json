                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>circulation</w> est particulièrement difficile au centre-ville le matin."
                        },
                        {
                            "text": "Les travaux sur l'autoroute perturbent fortement la <w>circulation</w> routière."
                        }
                    ],
                    "synonyms": [
                        "traffic",
                        "flux"
                    ],
                    "common_phrases": [
                        "circulation routière",
                        "accident de la circulation",
                        "circulation dense"
                    ]
                },
                {
                    "sense_id": "9f9c2545-9ff6-3499-869c-6ea1991da318",
                    "sense_definition": "Mouvement continu du sang dans les vaisseaux ou des liquides dans un organisme vivant.",
