            {
                "entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
                "word": "autoradio",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "723fe33c-45ff-45a5-9f21-5fb03eb330da",
                        "entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
                        "tags": [
                            "plural"
                        ],
