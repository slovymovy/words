                ],
                "senses": [
                    {
                        "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                        "entry_id": "754d537e-40c5-383d-89b1-182c1448eba1",
                        "glosses": [
                            "kurze, dünne Zigarre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85fb539a-a49b-4b77-b392-f99420e7a8da",
                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                "text": "Peter raucht einen Zigarillo."
                            },
                            {
                                "example_id": "a401164b-0de8-498c-a569-43c4027ffc62",
                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                "text": "„Ich setzte mich neben ihn und zündete mir eines seiner Zigarillos an.“"
                            },
                            {
                                "example_id": "29385d7e-1e0f-479c-9823-eb4f74313e57",
                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                "text": "„Er zündete sich einen Zigarillo an.“"
                            },
                            {
                                "example_id": "1525af54-d65d-4e7c-8047-e5ab08bd8d31",
                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                "text": "„Ein hagerer Mann, der sich als Eduard Pfeiffer vorgestellt hatte und dessen Anzug zwei Nummern zu groß war, zog an seinem Zigarillo und blätterte ungeduldig in Papieren, die auf einem Klemmbrett befestigt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41e002d4-b197-4634-b5aa-db38c0c29c98",
                        "source_entry_id": "754d537e-40c5-383d-89b1-182c1448eba1",
                        "source_sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                        "source_sense_description": "kurze, dünne Zigarre",
