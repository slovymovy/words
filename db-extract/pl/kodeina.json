                        "examples": [
                            {
                                "example_id": "f8c323ad-f803-437a-9c16-1244fe2d9b36",
                                "sense_id": "22751c66-6a16-311d-9867-64ee74d978f6",
                                "text": "Nie wytrzymam z tym męczącym kaszlem, jeśli nie wypiję kodeiny."
                            },
                            {
                                "example_id": "c0712c21-146f-4760-bba5-f75730ce7088",
                                "sense_id": "22751c66-6a16-311d-9867-64ee74d978f6",
                                "text": "Brał środki przeciwkurczowe na zapalenie okrężnicy, a także przeciwbólowe: kodeinę, demerol i metadon"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
