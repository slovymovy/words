                        "form": "onzuiverheidjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fbbf641-bb4d-3778-9911-80d7e8adae60",
                        "entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "glosses": [
                            "de mate waarin iets vervuild is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "312503cf-4271-3162-b3d1-689475a40afa",
                        "entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "glosses": [
                            "de mate waarin iemands motieven en handelingen moreel verwerpelijk zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "834e41e4-e4c4-4c93-87b5-f3e3d792b9a4",
                                "sense_id": "312503cf-4271-3162-b3d1-689475a40afa",
                                "text": "Wat is het voornaamste en eerste doel van deze drie? Natuurlijk de eigen verbetering en loutering. Alleen naar dit doel kunnen wij altijd onafhankelijk van alle omstandigheden streven. Maar tegelijkertijd verlangt juist dit doel van ons de grootste inspanningen, en daarom laten we, misleid door onze trots, dit doel links liggen en richten we ons ofwel op het mysterie dat wij vanwege onze onzuiverheid niet kunnen waarnemen, ofwel op de verbetering van de mensheid, terwijl wijzelf een voorbeeld zijn van laagheid en losbandigheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "b932f9f9-5a42-3871-88cf-9f88d7096a59",
                        "entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "glosses": [
                            "de mate waarin iets slordig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44baed1d-40dc-46e8-b867-dd1671dbd98b",
                                "sense_id": "b932f9f9-5a42-3871-88cf-9f88d7096a59",
                                "text": "PSV moest winnen om de kansen op de volgende ronde in eigen hand te houden. Het elftal van Roger Schmidt speelde uiterst geconcentreerd, bouwde aan de ene na de andere aanval, maar kreeg door onzuiverheid in de laatste pass telkens geen speler vrij voor het doel."
                            }
                        ]
                    },
                    {
                        "sense_id": "3406237b-037f-311f-9444-d894845984e7",
                        "entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "glosses": [
                            "iets dat vuil en smerig is"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65951559-6164-47aa-9461-7ec5e05059f5",
                        "source_entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "source_sense_id": "2fbbf641-bb4d-3778-9911-80d7e8adae60",
                        "source_sense_description": "de mate waarin iets vervuild is",
                        "target_lang_word": "impurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "The condition of being impure; because of contamination, pollution, adulteration or insufficient purification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eceec55-d301-4c5e-81fd-763a3e053734",
                                                "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                                "text": "Even animals in the Jewish system cause impurity only when they are dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A component or additive that renders something else impure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56afd81c-595d-4858-8569-f1d0ef290ac4",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "The impurities in the iron ore made extraction of the iron very difficult."
                                            },
                                            {
                                                "example_id": "d2540255-667a-4f00-85bf-eba7407275a0",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A state of immorality or sin; especially the weakness of the flesh: inchastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6498f97f-51f9-449c-bc85-fae845925ee1",
                                                "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                                "text": "With his cheating, lying and stealing, he epitomised the impurity of humanity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ff5a055-41c2-4d98-bb39-d255fdf3e372",
                        "source_entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "source_sense_id": "2fbbf641-bb4d-3778-9911-80d7e8adae60",
                        "source_sense_description": "de mate waarin iets vervuild is",
                        "target_lang_word": "imperfection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperfection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43f2ad4b-864b-39a0-a708-02d214067359",
                                        "entry_id": "ef043c0f-2aee-3e3b-8664-3498c680e98f",
                                        "glosses": [
                                            "Those qualities or features that are imperfect; the characteristic, state, or quality of being imperfect."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e867e530-d857-4eb2-9af6-db71c6f7822f",
                                                "sense_id": "43f2ad4b-864b-39a0-a708-02d214067359",
                                                "text": "You can accept your imperfection or try to improve."
                                            },
                                            {
                                                "example_id": "eed1b654-599c-4284-b66c-4114162ee3dc",
                                                "sense_id": "43f2ad4b-864b-39a0-a708-02d214067359",
                                                "text": "And for the first time she realised what it was to escape from the smallish perfection of England, into the grander imperfection of a great continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ce7f87-97b5-35b3-b30d-656f97a8c823",
                                        "entry_id": "ef043c0f-2aee-3e3b-8664-3498c680e98f",
                                        "glosses": [
                                            "Something that makes something else less than perfect; a blemish, impurity, error, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6601c29c-5216-49a2-a0a1-5b146aa643e7",
                                                "sense_id": "d2ce7f87-97b5-35b3-b30d-656f97a8c823",
                                                "text": "He loves me despite my imperfections."
                                            },
                                            {
                                                "example_id": "e32b127e-195b-42a4-82c6-fd1bdf1a0b94",
                                                "sense_id": "d2ce7f87-97b5-35b3-b30d-656f97a8c823",
                                                "text": "It will be sufficient for me if I discover many beauties or imperfections which others have not attended to; and I should be very glad to see one of our eminent writers publish their discoveries on the same subject."
                                            },
                                            {
                                                "example_id": "997cc9e9-678c-4dda-97c6-0b62d8933e62",
                                                "sense_id": "d2ce7f87-97b5-35b3-b30d-656f97a8c823",
                                                "text": "Notice that cleavage has nothing to do with imperfections in the crystal. Indeed, if you try cleaving an imperfect crystal, you may find that it cannot be cleaved as well as a perfect one. The cleavage is the result of the orderliness of the atomic arrangement. No wonder imperfections, which disturb the orderliness, disturb the cleavage as well. You will also note that the cleavage directions are obedient to the symmetry of the crystal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97515caf-8e08-4604-9b29-7fab887ecc92",
                        "source_entry_id": "7bca0739-2604-34bc-802d-00e7baaa2378",
                        "source_sense_id": "2fbbf641-bb4d-3778-9911-80d7e8adae60",
                        "source_sense_description": "de mate waarin iets vervuild is",
                        "target_lang_word": "inaccuracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inaccuracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa8a549-e047-3dcf-a0cd-698758101430",
                                        "entry_id": "537802ab-97b5-31d8-b565-276c3bf199f0",
                                        "glosses": [
                                            "The property of being inaccurate; lack of accuracy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9ad47bf-d2fa-3dd8-ac3f-435682cf612a",
                                        "entry_id": "537802ab-97b5-31d8-b565-276c3bf199f0",
                                        "glosses": [
                                            "A statement, passage etc. that is inaccurate or false."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "732e0355-489d-4b52-b36d-a32e49bb5cc8",
                                                "sense_id": "c9ad47bf-d2fa-3dd8-ac3f-435682cf612a",
                                                "text": "This book has a few factual inaccuracies, but only because of the limits of contemporary knowledge. For instance, at the time of writing, Ribbon Falls was thought to be the highest waterfall in the world; today we know that Angel Falls in Venezuela has this distinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a307cde0-9299-327d-9705-f457e96c873f",
                                        "entry_id": "537802ab-97b5-31d8-b565-276c3bf199f0",
                                        "glosses": [
                                            "Incorrect calibration of a measuring device, or incorrect use; lack of precision."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fea467f8-f29c-376a-8e8c-f1dda9545f93",
                                        "entry_id": "537802ab-97b5-31d8-b565-276c3bf199f0",
                                        "glosses": [
                                            "A move that is considered suboptimal, but not as bad as a mistake or blunder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
