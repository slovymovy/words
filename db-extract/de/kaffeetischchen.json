                        "examples": [
                            {
                                "example_id": "3fde6f63-1f8b-4be8-bec7-ec5215991cde",
                                "sense_id": "089ecfd5-4fc3-3b08-89cb-e9998b9dd61c",
                                "text": "„Auf einem Kaffeetischchen vor ihm stand ein Aschenbecher von der Größe einer Radkappe, in dem wohl Hunderte von Zigarettenkippen lagen.“"
                            },
                            {
                                "example_id": "93266aae-aeca-49b2-bc05-f30998a323fc",
                                "sense_id": "089ecfd5-4fc3-3b08-89cb-e9998b9dd61c",
                                "text": "„Darin standen ordentlich eine Sitzgruppe, ein Sofa mit dazu passenden Sesseln, ein falscher Kamin, Hochglanzfotos mit den lächelnden Gesichtern von Rita Hayworth, Betty Grable und Ann Sheridan, Scotch und, säuberlich über das Kaffeetischchen gebreitet, eine erbeutete japanische Fahne.“"
                            }
                        ],
