                        "glosses": [
                            "A novice or ignoramus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc90a67b-da66-4124-9a95-04f732d0d5fc",
                                "sense_id": "f59e90f6-a2dc-3c10-9467-68db81f093ac",
                                "text": "The archbishop was derided in ballads as an \"alphabetarian,\" who had burnt books which he could not read."
                            },
                            {
                                "example_id": "3f4030c4-9c43-432d-b5c7-3bccb3c1df19",
                                "sense_id": "f59e90f6-a2dc-3c10-9467-68db81f093ac",
                                "text": "I know also from experience that when an alphabetarian allows himself to use diacritical accents, he multiplies them excessively..."
                            },
                            {
                                "example_id": "3cdf8c00-938b-4123-aefb-909b619c1d93",
                                "sense_id": "f59e90f6-a2dc-3c10-9467-68db81f093ac",
                                "text": "The young alphabetarian had acquired sufficient learning to lead him to yearn for more; enough to stir his imagination; to give him notions."
                            }
                        ]
                    }
                ],
