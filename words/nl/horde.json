                    "frequency": "Low",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>horde</w> ging dit weekend op kamp in het bos.",
                            "target_lang_translations": {
                                "fr": "La <w>meute</w> est partie en camp dans la forêt ce week-end."
                            }
                        },
                        {
                            "text": "Elke zaterdag komt de <w>horde</w> bij elkaar in het clubhuis.",
                            "target_lang_translations": {
