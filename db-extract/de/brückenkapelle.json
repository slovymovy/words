                ],
                "senses": [
                    {
                        "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                        "entry_id": "76236cf4-44e1-3e19-9ced-84ef8769bdaa",
                        "glosses": [
                            "auf dem Unterbau einer Brücke errichtetes, einfach gestaltetes, kleineres Gotteshaus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4293aa59-408b-4465-b9ce-23414c300373",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„An der dem Dorf zugewandten Seite schließt sich, quergestellt, die einschiffige Brückenkapelle an.“"
                            },
                            {
                                "example_id": "76b39fd2-4dab-4483-8bed-2e23da4abc22",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„Die Restaurierung der Fassade der Brückenkapelle in Obermaßfeld steht kurz vor dem Abschluss.“"
                            },
                            {
                                "example_id": "817824a8-a48f-40c7-b48a-1ba657d37b12",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„Die restaurierte Figur der heiligen Apollonia wird in die Brückenkapelle überführt.“"
                            },
                            {
                                "example_id": "afdc2b04-a133-470d-9930-f01dd78386bc",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„Die Schleifung des Linienwalls brachte die ursprüngliche Brückenkapelle - bereits die zweite in diesem Bereich - wiederum in Gefahr, und diese musste schließlich abgetragen werden.“"
                            },
                            {
                                "example_id": "9ede37aa-1eee-4649-a601-ca8b7796d681",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„Die unter Denkmalschutz stehende Brückenkapelle (datiert 1551) besteht noch heute als letzter Überrest des früheren Pilgerweges, welcher an der Holzbrücke vorbeiführte.“"
                            },
                            {
                                "example_id": "ed42d6e2-410b-47b6-a64f-459644e79285",
                                "sense_id": "f5008163-3f3d-3f71-8dce-a4a8f8abc397",
                                "text": "„Im Verbund mit der Brückenkapelle steht die Brücke, die 1747 durch Thüringens Landesbaumeister Gottfried Heinrich Krone instand gesetzt und nach starken Zerstörungen im 2. Weltkrieg wiederhergestellt sowie 1993 saniert wurde, heute unter Denkmalschutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
