                                        "entry_id": "8bb9eb90-274b-3f38-80fe-1811eaf90f15",
                                        "glosses": [
                                            "The process by which a candidate for public office is selected, usually by a political party"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6b9e7e-5b00-4a5a-ae66-be092e565888",
                                                "sense_id": "29192e68-206b-3d38-a766-4057a66031ca",
                                                "text": "The preselection in Mr Costello's Victorian seat of Higgins will start in April, when he will have to reveal whether he will stand for another term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90e7fcb-385a-3aa9-964c-d14011369822",
                                        "entry_id": "8bb9eb90-274b-3f38-80fe-1811eaf90f15",
                                        "glosses": [
                                            "Selection in advance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df43e8c0-74e9-47da-a6a0-719b7fffbf71",
                                                "sense_id": "d90e7fcb-385a-3aa9-964c-d14011369822",
                                                "text": "After automated particle preselection, manual verification, and selection by cross-correlation, 18,801 particles were chosen for the vacant 40S subunit, 20,939 particles for the IRES-40S complex, and 13,613 particles for the IRES dII-40S complex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd4e9d5-b58d-35fd-9005-a9adf961cff8",
                                        "entry_id": "8bb9eb90-274b-3f38-80fe-1811eaf90f15",
                                        "glosses": [
                                            "The preference for a mate found attractive by other members of one's sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0556cfe7-2e40-3298-a54e-51319c726441",
                                        "entry_id": "8bb9eb90-274b-3f38-80fe-1811eaf90f15",
                                        "glosses": [
                                            "The process of a jury selecting entries to be shown in a competition when there are too many entries for the audience or schedule. The term preselection is often used with the opposite meaning in demoscene context, i.e. selecting entries not to be shown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c09444-6928-4be2-8287-d9a0d2949756",
                                                "sense_id": "0556cfe7-2e40-3298-a54e-51319c726441",
                                                "text": "In compos which are potentially crammed like the music compos, preselection is a necessary evil. [...] 15-16 songs [...] are thus chosen to be played to the audience."
                                            },
                                            {
                                                "example_id": "471ce4f1-8cb0-4264-a2f2-99a233198340",
                                                "sense_id": "0556cfe7-2e40-3298-a54e-51319c726441",
                                                "text": "Every entry will be released [...], unless it was preselected/disqualified, or the competition was canceled."
                                            }
                                        ]
                                    }
                                ]
                            }
