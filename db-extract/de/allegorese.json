                "senses": [
                    {
                        "sense_id": "b54a827b-9b2d-3814-be6d-9c5b004b3249",
                        "entry_id": "9290d78e-8b7f-383d-a8bb-636ffe443a88",
                        "glosses": [
                            "Offenlegen von verborgenen Textinhalten, die „zwischen den Zeilen“ lesbar sind oder auch Auslegung eines Textes nach einem mehrfachen, über den wörtlichen hinausgehenden Sinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3db7b9d-5097-4ee2-804b-fc5b273036da",
                                "sense_id": "b54a827b-9b2d-3814-be6d-9c5b004b3249",
                                "text": "Für den modernen, mit der patristischen Allegorese nicht mehr vertrauten Leser ist das nicht mehr so ohne weiteres durchsichtig."
                            },
                            {
                                "example_id": "01ba670e-eaec-4060-9e21-20e9fa743e1d",
                                "sense_id": "b54a827b-9b2d-3814-be6d-9c5b004b3249",
                                "text": "„Mit stupider Allegorese wird das Alte Testament zur Weissagung auf Christus drapiert . . .“"
                            },
                            {
                                "example_id": "fc32fed6-b2ba-4168-b250-edfb153f1b7b",
                                "sense_id": "b54a827b-9b2d-3814-be6d-9c5b004b3249",
                                "text": "„Daher überschreiten ihre Werke den auslösenden biographischen Kontext, indem sie mitunter zur Allegorese der indianisch-mexikanischen Geschichte werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
