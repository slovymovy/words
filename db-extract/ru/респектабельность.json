                                        "entry_id": "6cd9b65a-85b7-3f89-874e-efb659b2e9c7",
                                        "glosses": [
                                            "Qualité d’une personne ou d’une chose respectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f639d588-c4ba-4561-bcbf-69bb134789c2",
                                                "sense_id": "1ffb2a05-7120-372e-8712-7973981ecb1d",
                                                "text": "Ce n'est pas à cette allure que vont jamais les gentlemen, soucieux de leur respectabilité."
                                            },
                                            {
                                                "example_id": "ef6bdee9-055b-4061-9130-c22fc96acfbe",
                                                "sense_id": "1ffb2a05-7120-372e-8712-7973981ecb1d",
                                                "text": "[…] ; je ris en songeant aux policiers sévères, aux suisses galonnés, à toute cette mise en scène de respectabilité étalée à cinquante mètres de là."
                                            },
                                            {
                                                "example_id": "36e13361-e449-44c7-8150-81e9817e599d",
                                                "sense_id": "1ffb2a05-7120-372e-8712-7973981ecb1d",
                                                "text": "S'il vous reste un rien de respectabilité, remontez à bord de n'importe quelle barcasse et fuyez cet antre de bandits comme la peste !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
