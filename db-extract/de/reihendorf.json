                ],
                "senses": [
                    {
                        "sense_id": "fbb28cac-8c57-3ec6-80e3-1d91d1b7b910",
                        "entry_id": "f02e472d-c73c-3c8f-88e0-c0cdd7a0a4fa",
                        "glosses": [
                            "Dorf, das sich entlang eines langgestreckten topografisches Objektes wie einer Straße, einem Weg, einem Deich, einem Tal, einem Höhenrücken, einem Bach oder einem Graben zieht, an dem die bäuerlichen Siedlungsplätze, das heißt die Höfe oder Hofstellen in mehr oder minder regelmäßigen Abständen aneinandergereiht sind"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "96d3e728-7134-416d-bc41-6aeec6a9b9c3",
                                "sense_id": "fbb28cac-8c57-3ec6-80e3-1d91d1b7b910",
                                "text": "„Meist sind Reihendörfer dadurch gekennzeichnet, dass, sofern die örtlichen Gegebenheiten und Geländebedingungen es ermöglichen, jeweils am Anfang und am Ende des Reihendorfes noch weiter gesiedelt werden, also noch weitere Hofstellen angelegt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
