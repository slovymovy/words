        "nl-extract.jsonl": [
            {
                "entry_id": "d6a0c71b-3aa1-3d44-94b5-88554f11661e",
                "word": "verbrodden",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d6ea64f-f907-301b-a52c-76fc8292171e",
                        "entry_id": "d6a0c71b-3aa1-3d44-94b5-88554f11661e",
                        "glosses": [
                            "iets verknoeien of kapot maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6750ce59-e405-4186-a08a-1ce6384d92b5",
                                "sense_id": "6d6ea64f-f907-301b-a52c-76fc8292171e",
                                "text": "De opdracht was duidelijk: winnen en de titel was een feit. Maar der Rekordmeister begon nonchalant aan de partij. Augsburg startte wél enthousiast en kwam zelfs op voorsprong. Verdediger Boateng stond nog te slapen en liet zich kinderlijk makkelijk de bal afsnoepen. De Augsburg-spits kon alleen op doelman Ulreich af, maar zag zijn poging geweerd worden. Geen erg, want de bal vloog pardoes in het gezicht van Süle, die zo een wel heel ongelukkige onwgoal maakte. Het zou toch niet waar zijn dat Augsburg het feestje ging verbrodden?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a648c8b2-1fe0-4b70-86a5-4956b608dd75",
                        "source_entry_id": "d6a0c71b-3aa1-3d44-94b5-88554f11661e",
                        "source_sense_id": "6d6ea64f-f907-301b-a52c-76fc8292171e",
                        "target_lang_word": "spoil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "874a7c06-9ea9-3e60-90c0-44a58f10c787",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To strip (someone who has been killed or defeated) of arms or armour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fc9149a-2cda-3189-8c6f-fb1a26286a4e",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To strip or deprive (someone) of possessions; to rob, despoil."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895da789-b8f5-4027-9515-7f61b2e4f4e7",
                                                "sense_id": "3fc9149a-2cda-3189-8c6f-fb1a26286a4e",
                                                "text": "All that herde hym wer amased and sayde: ys nott this he that spoylled them whych called on this name in Jerusalem?"
                                            },
                                            {
                                                "example_id": "7c20068b-92b7-49f5-af3b-1b213ad11e99",
                                                "sense_id": "3fc9149a-2cda-3189-8c6f-fb1a26286a4e",
                                                "text": "To do her dye (quoth Vna) were despight, / And shame t'auenge so weake an enimy; / But spoile her of her scarlot robe, and let her fly."
                                            },
                                            {
                                                "example_id": "f97daa98-52d6-462d-b85b-8c518ae34ec1",
                                                "sense_id": "3fc9149a-2cda-3189-8c6f-fb1a26286a4e",
                                                "text": "Roger, that rich Bishop of Salisbury,[…]spoiled of his goods by King Stephen, […]through grief ran mad, spoke and did he knew not what."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e56953-139b-3ac3-9b71-a0ba5d710d3d",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To plunder, pillage (a city, country etc.)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb138363-46ce-476c-a331-7d6206ccd2ee",
                                                "sense_id": "15e56953-139b-3ac3-9b71-a0ba5d710d3d",
                                                "text": "Outlaws, which, lurking in woods, used to break forth to rob and spoil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f9cadb7-4788-3f74-80fd-e6ae4b8c6817",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To carry off (goods) by force; to steal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44c78355-fd9a-4f11-be7e-a8333b5f5368",
                                                "sense_id": "6f9cadb7-4788-3f74-80fd-e6ae4b8c6817",
                                                "text": "No man can enter into a strong man’s house, and spoil his goods, except he will first bind the strong man."
                                            },
                                            {
                                                "example_id": "a2d879b1-3967-4557-95fa-c09239efe2e6",
                                                "sense_id": "6f9cadb7-4788-3f74-80fd-e6ae4b8c6817",
                                                "text": "They must likewise endeavour to be careful in looking after the rest of the Servants, that every one perform their duty in their several places, that they keep good hours in their up-rising and lying down, and that no Goods be either spoiled or embezelled."
                                            },
                                            {
                                                "example_id": "47fef6f6-20a0-435a-aa09-3a00577c4f40",
                                                "sense_id": "6f9cadb7-4788-3f74-80fd-e6ae4b8c6817",
                                                "text": "[…] it was her own knife; little sister Mary had left it to her upon her deathbed, and she ought to have had it to keep herself long ago. But mama kept it from her, and was always letting Betsey get hold of it; and the end of it would be that Betsey would spoil it, and get it for her own, though mama had promised her that Betsey should not have it in her own hands."
                                            },
                                            {
                                                "example_id": "95d9552d-776e-4f4a-8900-9b77e01e936a",
                                                "sense_id": "6f9cadb7-4788-3f74-80fd-e6ae4b8c6817",
                                                "text": "There is hardly a trace of metal left in the Palace at Knossos. In one corner only, on the north-west, a friendly floor level seems to have sunk just before the plunderers entered it, and hidden from their view five splendid bronze vessels. They are all that remain to us […] to tell us what the gold and silver work was like that was spoiled from Knossos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b44aa176-31d6-3e57-b031-d62777a77659",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To ruin; to damage in such a way as to make undesirable or unusable."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65920e28-de0e-4776-937e-3cd07fd56d41",
                                                "sense_id": "b44aa176-31d6-3e57-b031-d62777a77659",
                                                "text": "Spiritual pride […] spoils so many graces."
                                            },
                                            {
                                                "example_id": "7f8f073d-18c6-4554-9c75-96d3bdba4065",
                                                "sense_id": "b44aa176-31d6-3e57-b031-d62777a77659",
                                                "text": "\"I don't want to spoil any comparison you are going to make,\" said Jim, \"but I was at Winchester and New College.\" ¶ \"That will do,\" said Mackenzie. \"I was dragged up at the workhouse school till I was twelve. […]\""
                                            },
                                            {
                                                "example_id": "5ba3cb67-3f0c-4a43-a3cb-a3f65dac749c",
                                                "sense_id": "b44aa176-31d6-3e57-b031-d62777a77659",
                                                "text": "‘This is a great day for us. Let us not spoil it by saying the wrong thing, by promoting a culture of revenge, or by failing to treat the former president with respect.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c68719d-116b-3936-a2a3-199134382613",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To ruin the character of, by overindulgence; to coddle or pamper to excess."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4ca06e3-f8dd-3127-b7c3-05610f14cdb2",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To go bad; to become sour or rancid; to decay."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b88d38-7b44-4c8d-aa19-51c6e9906264",
                                                "sense_id": "c4ca06e3-f8dd-3127-b7c3-05610f14cdb2",
                                                "text": "Make sure you put the milk back in the fridge; otherwise it will spoil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce6647f-2baa-3ddc-9d25-1e0b7c040cff",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To render (a ballot) invalid by deliberately defacing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "125d297b-78df-4a9e-aea2-652b3ad73103",
                                                "sense_id": "bce6647f-2baa-3ddc-9d25-1e0b7c040cff",
                                                "text": "Dr Jonathan Grant (Letters, April 22) feels the best way to show his disaffection with political parties over Iraq is to spoil his ballot paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ff8050-5696-3edd-8b8b-07110a08b152",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To prematurely reveal major events or the ending of (a story etc.); to ruin (a surprise) by exposing ahead of time as a spoiler."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7417ce5-064c-41c2-97ee-363c1d346853",
                                                "sense_id": "85ff8050-5696-3edd-8b8b-07110a08b152",
                                                "text": "These include a brief but showstopping (and trailer-revealed) scene where Vanellope crashes a Disney Princess reunion, packed with gags and references that should send both young and old fans into paroxysms of glee. The princess confab also leads into a scene featuring Vanellope and the cast of Slaughter Race that probably shouldn’t be spoiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac46ae0c-6b44-3c02-9af0-f3826b283228",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To reduce the lift generated by an airplane or wing by deflecting air upwards, usually with a spoiler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dca43210-1b80-3a8d-9a48-71448c386d68",
                                        "entry_id": "d9c3b754-2b8e-3c39-ba54-2bf82c8a1bdb",
                                        "glosses": [
                                            "To be very eager (for something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93354293-8a47-4880-9bb6-fc58a842a713",
                                                "sense_id": "dca43210-1b80-3a8d-9a48-71448c386d68",
                                                "text": "Senator Toombs who announced his readiness to whip Great Britain [...] has been spoiling for a fight ever since"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab619ef9-41ea-38c9-aec8-395c21df9701",
                                        "entry_id": "1c8f06e5-ad82-3d28-af07-894a7280b7df",
                                        "glosses": [
                                            "Plunder taken from an enemy or victim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f120b33-e678-46ac-b693-50a699ad3415",
                                                "sense_id": "ab619ef9-41ea-38c9-aec8-395c21df9701",
                                                "text": "Thoſe thouſand horſe shall ſweat with martiall ſpoyle\nOf conquered kingdomes, and of Cities ſackt, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6927e613-5aed-3ae7-b30f-c62aea69aba0",
                                        "entry_id": "1c8f06e5-ad82-3d28-af07-894a7280b7df",
                                        "glosses": [
                                            "The act of taking plunder from an enemy or victim; spoliation, pillage, rapine."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e9a4f0-66ff-4f84-83ef-34ee66dc4096",
                                                "sense_id": "6927e613-5aed-3ae7-b30f-c62aea69aba0",
                                                "text": "This countrey ſwarmes with vile outragious men,\nThat liue by rapine and by lawleſſe ſpoile,\nFit ſouldiers for the wicked Tamburlaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3acc59f-891e-3102-a0fd-e2f350c3952c",
                                        "entry_id": "1c8f06e5-ad82-3d28-af07-894a7280b7df",
                                        "glosses": [
                                            "Material (such as rock or earth) removed in the course of an excavation, or in mining or dredging. Tailings. Such material could be utilised somewhere else."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60033721-d927-4994-be30-0af402c1ad7e",
                                                "sense_id": "c3acc59f-891e-3102-a0fd-e2f350c3952c",
                                                "text": "In view of the decline in freight traffic, it was strange to hear from Mr. Lambert that there is \"a continuing problem of supplying, particularly for the civil engineer, the number of wagons required for carrying construction materials and spoil for various works.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
