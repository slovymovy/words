                        "glosses": [
                            "Qui concerne l'athéisme ou les athées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bcb1084-a500-4b1f-a8f9-ae724419645a",
                                "sense_id": "307b5efd-64d3-3a8b-ab3b-8ba9d09efe51",
                                "text": "1881 : Le congrès international de Paris définit la Libre Pensée comme une \" société rationaliste et athéistique\"."
                            },
                            {
                                "example_id": "0a97741a-0ff2-4475-b920-9a592e638e9c",
                                "sense_id": "307b5efd-64d3-3a8b-ab3b-8ba9d09efe51",
                                "text": "Dans le cadre du processus complexe de la propagande athéistique et de la dépersonnalisation du peuple roumain, la lutte contre les deux plus grandes fêtes chrétiennes « Noël et Pâques » a joué aussi un rôle très important."
                            }
                        ]
                    }
