                        "entry_id": "4c6e77f3-ee11-38e9-9552-009237d1706d",
                        "glosses": [
                            "prepositioneel deel van een voornaamwoordelijk bijwoord: zich tegen iets verzettend"
                        ],
                        "tags": [],
