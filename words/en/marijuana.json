            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                    "sense_definition": "The dried leaves and flowers of the cannabis plant, used as a drug for its euphoric or medicinal effects.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cannabis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is currently debating whether to legalize <w>marijuana</w> for recreational use.",
                            "target_lang_translations": {
                                "ru": "Правительство в настоящее время обсуждает вопрос о легализации <w>марихуаны</w> для рекреационного использования."
                            }
                        },
                        {
                            "text": "He was arrested for possessing a small amount of <w>marijuana</w> in his car.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за хранение небольшого количества <w>марихуаны</w> в своей машине."
                            }
                        },
                        {
                            "text": "Many patients use medical <w>marijuana</w> to help manage chronic pain and anxiety.",
                            "target_lang_translations": {
                                "ru": "Многие пациенты используют медицинскую <w>марихуану</w>, чтобы справиться с хронической болью и тревогой."
                            }
                        }
                    ],
                    "synonyms": [
                        "cannabis",
                        "pot",
                        "weed",
                        "grass",
                        "dope",
                        "ganja",
                        "herb",
                        "reefer"
                    ],
                    "common_phrases": [
                        "medical marijuana",
                        "recreational marijuana",
                        "smoke marijuana",
                        "possess marijuana"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высушенные листья и цветы конопли, используемые как наркотическое средство из-за их эйфорического или лечебного эффекта."
                    },
                    "translations": {
                        "ru": [
                            {
