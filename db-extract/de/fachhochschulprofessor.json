                "senses": [
                    {
                        "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                        "entry_id": "942b9702-9ba2-3f7c-be4f-8d8c8cc82631",
                        "glosses": [
                            "Professor an einer Fachhochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772be39c-78ba-484f-83b4-4523d6128926",
                                "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                                "text": "„Fachhochschulprofessor Dr. Guntram Feurstein lernte die exotische Küche auf Auslandsreisen kennen.“"
                            },
                            {
                                "example_id": "eb6b5b65-89bc-4193-be4c-33fbb749ce45",
                                "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                                "text": "„So die Antwort des Frankfurter Fachhochschulprofessors Rainer Roth auf die Frage, wo die Mittel für Bildung versickern.“"
                            },
                            {
                                "example_id": "f83c3110-b4b3-4d34-9523-9db955dcc971",
                                "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                                "text": "„Von einer Doppelqualifikation der Fachhochschulprofessoren zu sprechen, träfe also weit eher zu als die (Unkenntnis verratende) Rede vom \"Schmalspurprofessor\".“"
                            },
                            {
                                "example_id": "5940fb85-0d21-4422-a3b2-cbe95d739741",
                                "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                                "text": "„Der von Israel und »Großmächten dieses Planeten« ausgeübte Druck auf Aktivisten und die griechische Regierung, die Schiffe nicht auslaufen zu lassen, sei groß, sagte der griechische Fachhochschulprofessor für Technologietransfer.“"
                            },
                            {
                                "example_id": "8a9444c5-b387-437d-9249-250a71f8bca5",
                                "sense_id": "b98ccef3-f5a7-3640-a3d4-1e1d8b0f85d6",
                                "text": "„Beispiele hat der Hiddenhausener Werbetexter zusammen mit dem Fachhochschulprofessor Gerd Bosbach (RheinAhrCampus, Remagen) in dem jüngst erschienenen Werk \"Lügen mit Zahlen\" (Heyne-Verlag) gesammelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
