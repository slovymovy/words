                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybkie <w>zadanie</w> pytań ułatwiło nam przeprowadzenie wywiadu.",
                            "target_lang_translations": {
