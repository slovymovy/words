                ],
                "senses": [
                    {
                        "sense_id": "788dc1a2-8f30-30fe-af85-e5b4d4df6ac8",
                        "entry_id": "c325b564-11be-3161-b6b4-61e2e3d6efbe",
                        "glosses": [
                            "Verbrennungsmotor mit vier Arbeitsgängen, die während zweier Umdrehungen der Kurbelwelle durchlaufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c19aa4-831b-410b-8a90-d3e0d286238d",
                                "sense_id": "788dc1a2-8f30-30fe-af85-e5b4d4df6ac8",
                                "text": "„Der flüssigkeitsgekühlte 52-Grad-V2-Viertaktmotor mit sechs Ventilen und einem Hubraum von 647 ccm hat schon seit Jahren den Ruf, im Normalbetrieb unzerstörbar zu sein. 53 PS und 55 Nm dahebt er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a86beb28-f077-4471-a93b-14e9228e7aaf",
                        "source_entry_id": "c325b564-11be-3161-b6b4-61e2e3d6efbe",
                        "source_sense_id": "788dc1a2-8f30-30fe-af85-e5b4d4df6ac8",
                        "target_lang_word": "moteur à quatre temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur à quatre temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89db20f1-9af9-365a-916b-2d438a93dccf",
                                        "entry_id": "282c8f2f-4151-3be3-a1e0-5fa97c1fd60e",
                                        "glosses": [
                                            "Moteur à combustion interne fonctionnant selon le cycle de Beau de Rochas, avec les 4 temps successifs : admission, compression, détente, échappement, durant deux allers et retours du piston."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e601c36-31d8-48f9-ab1e-932f9fc89413",
                                                "sense_id": "89db20f1-9af9-365a-916b-2d438a93dccf",
                                                "text": "C’est le moteur à quatre temps qui prévaut sur tous les autres types : l’expiration des brevets Otto de 1876 et de 1877 a mis dans le domaine public le cycle à quatre périodes, réalisées dans un seul cylindre, d’un seul côté du piston moteur …."
                                            },
                                            {
                                                "example_id": "4c7122f4-7dec-4d0f-8340-08259a9e5d55",
                                                "sense_id": "89db20f1-9af9-365a-916b-2d438a93dccf",
                                                "text": "Le premier moteur avec compression préalable à l’intérieur du cylindre ne fut réalisé qu’en 1876 par l’Allemand Nicolas Otto, à qui on doit le premier moteur à quatre temps."
                                            },
                                            {
                                                "example_id": "d3c2959c-ede1-4e59-b1b1-df246ce7a120",
                                                "sense_id": "89db20f1-9af9-365a-916b-2d438a93dccf",
                                                "text": "Au décès de l’emblématique pionnier de la voiture, le journal L’Auto (ancêtre de L’Equipe) devait en effet rappeler que si, en Allemagne, personne n’a cru dans le tricycle avec moteur à quatre temps fabriqué en 1885, « c’est alors qu’un Français, Emile Roger, comprit l’importance de la nouvelle invention et se fit acquéreur de la première machine dont les reproductions firent leur début en France »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
