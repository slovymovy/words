                    "semantic_group_id": "importun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet individu <w>fâcheux</w> interrompt sans cesse les conversations sans y avoir été invité."
                        },
                        {
                            "text": "Elle a dû supporter les remarques d'une voisine <w>fâcheuse</w> pendant tout le trajet."
