                                        "entry_id": "6abc8b30-a5fb-353b-8cff-ee1a840dc00a",
                                        "glosses": [
                                            "για άνοιγμα ή πέρασμα που κλείστηκε, φράχτηκε ή μπλόκαρε και δεν επιτρέπει σε κάποιον ή κάτι να περάσει"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067cb9e5-6d9e-4967-8975-17b88474879a",
                                                "sense_id": "1537b9bd-9e1d-3a4f-9e07-615fa4865667",
                                                "text": "Έχουμε κλειστά τα παράθυρα το βράδυ για να μην μπούνε μέσα τα κουνούπια."
                                            },
                                            {
                                                "example_id": "5b6494a8-a5fc-42fe-860c-7d9cf7100987",
                                                "sense_id": "1537b9bd-9e1d-3a4f-9e07-615fa4865667",
                                                "text": "Δεν κοιμάμαι με τις κουρτίνες κλειστές, μου αρέσει το πρωινό φως."
                                            },
                                            {
                                                "example_id": "27c4ef17-cab4-4fd0-93fc-6e3cca522338",
                                                "sense_id": "1537b9bd-9e1d-3a4f-9e07-615fa4865667",
                                                "text": "Κλειστά τα βόρεια σύνορα από τις κινητοποιήσεις των φορτηγατζήδων."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1624b5e1-818c-3402-ad84-862d023d14ad",
                                        "entry_id": "6abc8b30-a5fb-353b-8cff-ee1a840dc00a",
                                        "glosses": [
                                            "για κάτι στο οποίο η πρόσβαση ή η συμμετοχή είναι περιορισμένη"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c20d03-0a86-4fa8-b531-1a28b6899862",
                                                "sense_id": "1624b5e1-818c-3402-ad84-862d023d14ad",
                                                "text": "κλειστά επαγγέλματα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cdbe9f7-a707-3f23-92db-7176613dbd79",
                                        "entry_id": "6abc8b30-a5fb-353b-8cff-ee1a840dc00a",
                                        "glosses": [
                                            "για γραφείο, κατάστημα, υπηρεσία κλπ. που δεν λειτουργεί για μικρό συνήθως χρονικό διάστημα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4397e34-7847-4041-8c60-797d3f1318dd",
                                                "sense_id": "3cdbe9f7-a707-3f23-92db-7176613dbd79",
                                                "text": "Όταν πέρασα από το μαγαζί, ήταν κλειστό λόγω διακοπών."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec4c4150-8d38-3e79-92da-89185f84e24c",
                                        "entry_id": "6abc8b30-a5fb-353b-8cff-ee1a840dc00a",
                                        "glosses": [
                                            "μη κοινωνικός"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "776e644c-fd11-3c34-a2e2-bd5902649942",
                                        "entry_id": "6abc8b30-a5fb-353b-8cff-ee1a840dc00a",
                                        "glosses": [
                                            "που δεν εκδηλώνει εύκολα σε άλλους τις σκέψεις του ή τα συναισθήματά του"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
