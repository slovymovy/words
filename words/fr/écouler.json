{
    "word_family": [
        "écoulement",
        "couler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f6ef2c0-32f8-35be-a202-5d585964b83e",
                    "sense_definition": "Passer, avancer d'une manière continue, en parlant du temps ou de la durée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs mois s'<w>écoulèrent</w> avant qu'il ne reçoive une réponse à sa demande."
                        },
                        {
                            "text": "Nous regardions les heures s'<w>écouler</w> sans nous soucier du lendemain."
                        }
                    ],
                    "synonyms": [
                        "passer",
                        "défiler"
                    ],
                    "common_phrases": [
                        "laisser s'écouler le temps",
                        "voir les années s'écouler"
                    ]
                },
                {
                    "sense_id": "ee8ee758-7914-33e2-ad45-97da9c1c1bf4",
                    "sense_definition": "Couler hors d'un conduit, d'un récipient ou d'un lieu, en parlant d'un liquide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'eau de pluie s'<w>écoule</w> le long de la gouttière vers le jardin."
                        },
                        {
                            "text": "Il faut nettoyer le tuyau pour laisser l'eau s'<w>écouler</w> librement."
                        }
                    ],
                    "synonyms": [
                        "couler",
                        "fuir"
                    ],
                    "antonyms": [
                        "stagner"
                    ],
                    "common_phrases": [
                        "s'écouler dans le caniveau",
                        "laisser s'écouler l'eau"
                    ]
                },
                {
                    "sense_id": "ab034aa3-48fb-3516-bd75-f13f25573f9c",
                    "sense_definition": "Vendre des marchandises ou des stocks jusqu'à leur épuisement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant a baissé ses prix pour <w>écouler</w> rapidement son stock d'hiver."
                        },
                        {
                            "text": "Ils ont réussi à <w>écouler</w> toute leur production lors du marché artisanal."
                        }
                    ],
                    "synonyms": [
                        "liquider",
                        "vendre"
                    ],
                    "antonyms": [
                        "stocker"
                    ],
                    "common_phrases": [
                        "écouler un stock",
                        "écouler des marchandises"
                    ]
                },
                {
                    "sense_id": "921f8a88-014b-3af9-90dd-f09b513d1691",
                    "sense_definition": "Se disperser ou quitter un endroit de manière fluide, en parlant d'une foule.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin du concert, la foule s'<w>écoule</w> calmement vers les sorties du stade."
                        },
                        {
                            "text": "Les agents de sécurité attendent que les spectateurs s'<w>écoulent</w> avant de fermer."
                        }
                    ],
                    "synonyms": [
                        "se disperser",
                        "défiler"
                    ],
                    "antonyms": [
                        "s'attrouper"
                    ],
                    "common_phrases": [
                        "laisser la foule s'écouler"
                    ]
                },
                {
                    "sense_id": "2bee5994-2637-3185-8f18-8bbfc094c122",
                    "sense_definition": "Diminuer petit à petit jusqu'à disparaître, en parlant d'argent ou de biens matériels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diminution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses économies s'<w>écoulent</w> à une vitesse inquiétante depuis qu'il a perdu son emploi."
                        },
                        {
                            "text": "Sans un budget rigoureux, tout cet héritage risque de s'<w>écouler</w> rapidement."
                        }
                    ],
                    "synonyms": [
                        "se dissiper",
                        "fondre"
                    ],
                    "antonyms": [
                        "s'accumuler"
                    ],
                    "common_phrases": [
                        "s'écouler rapidement"
                    ]
                }
            ]
        }
    ]
}