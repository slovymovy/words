    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7c3c437f-a023-3b35-851c-8b566bc9dba4",
                "word": "detachable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74b7efd6-973a-3ffc-b1e8-99b53bd1fea4",
                        "entry_id": "7c3c437f-a023-3b35-851c-8b566bc9dba4",
                        "glosses": [
                            "Designed to be unfastened or disconnected without damage."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb7e5859-7fce-479a-8bbb-3482ce54843c",
                                "sense_id": "74b7efd6-973a-3ffc-b1e8-99b53bd1fea4",
                                "text": "Pique and linen also accented several coats and oftentimes were both detachable and formed an overcollar covering a collar made from the coat fabric."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97e77ea7-c5f7-43fd-a52f-d896f5599a62",
                        "source_entry_id": "7c3c437f-a023-3b35-851c-8b566bc9dba4",
                        "source_sense_id": "74b7efd6-973a-3ffc-b1e8-99b53bd1fea4",
                        "source_sense_description": "designed to be unfastened",
                        "target_lang_word": "amovible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amovible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b5816a4-78f7-3156-8e98-febc2f848a40",
                                        "entry_id": "f4812fc6-7c45-33b4-ac64-64b4562cae87",
                                        "glosses": [
                                            "Déplaçable, destituable."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687f0b44-e1fb-462b-843a-e86dc114c35b",
                                                "sense_id": "0b5816a4-78f7-3156-8e98-febc2f848a40",
                                                "text": "Il ne faut pas que les juges soient amovibles."
                                            },
                                            {
                                                "example_id": "2ec05461-09f6-4c5b-868a-90a8afaea8df",
                                                "sense_id": "0b5816a4-78f7-3156-8e98-febc2f848a40",
                                                "text": "Dans les cours de justice, les membres du parquet sont seuls amovibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40c8067e-f365-3127-a0e6-a20879f8e5fa",
                                        "entry_id": "f4812fc6-7c45-33b4-ac64-64b4562cae87",
                                        "glosses": [
                                            "Qui peut être enlevé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b7f1434-3028-4a58-8e2a-9a092f3b486e",
                                                "sense_id": "40c8067e-f365-3127-a0e6-a20879f8e5fa",
                                                "text": "J'avais oublié le cran d’arrêt : je pèse sur cette languette amovible qui poussée en arrière découvre une lettre majuscule gravée, une esse, initiale du mot sûreté. Pour un peu, je pressais la gâchette sans que le coup partît."
                                            },
                                            {
                                                "example_id": "bcc65fb0-d8c6-43dd-981f-01213ccbb73c",
                                                "sense_id": "40c8067e-f365-3127-a0e6-a20879f8e5fa",
                                                "text": "L’un des paliers est amovible rapidement pour permettre le changement des lames."
                                            },
                                            {
                                                "example_id": "5b9a2312-7edf-46c5-8a3f-0ca8783de9e9",
                                                "sense_id": "40c8067e-f365-3127-a0e6-a20879f8e5fa",
                                                "text": "Le traitement des édentements partiels par prothèse amovible sur châssis métallique fait appel à des notions purement mécaniques et à des connaissances biologiques."
                                            },
                                            {
                                                "example_id": "5ff10109-e2c3-4005-8df7-de9c26425e41",
                                                "sense_id": "40c8067e-f365-3127-a0e6-a20879f8e5fa",
                                                "text": "Le canapé a des coussins amovibles, ce qui facilite leur nettoyage. Ils peuvent être retirés ou déplacés facilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67dfc060-49f5-4981-bb2b-00f0f0dfdc59",
                        "source_entry_id": "7c3c437f-a023-3b35-851c-8b566bc9dba4",
                        "source_sense_id": "74b7efd6-973a-3ffc-b1e8-99b53bd1fea4",
