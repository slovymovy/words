                "senses": [
                    {
                        "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                        "entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                        "glosses": [
                            "Giebeldreieck über einem vorstehenden Gebäudeteil (oft auch der Giebel über einem Fenster oder einer Tür, der auch „Fronton“ genannt wurde)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a0e615-bb5a-4a08-8024-40caaae8729a",
                                "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                                "text": "„Aus der Untersuchung und Beschreibung der einzelnen Bauformen und Ornamente am Frontispiz des Rathauses hat sich herausgestellt, daß dasselbe in seinen wesentlichen Theilen unverändert sich erhalten hat.“"
                            },
                            {
                                "example_id": "9775c493-59ec-45ce-859a-da78510f40cc",
                                "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                                "text": "„An der Vorderseite gab es eine dreiachsige Oberstube mit Frontispiz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd4d1a5f-b1fe-32fa-9599-8f2dcb3b8848",
                        "entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                        "glosses": [
                            "Illustration auf der zweiten, der Titelseite gegenüberliegenden Seite eines Buches"
                        ],
                        "tags": [
                            "Buchdruck"
                        ],
                        "examples": [
                            {
                                "example_id": "adf84fdc-49bd-4155-98cc-e2706da80efa",
                                "sense_id": "fd4d1a5f-b1fe-32fa-9599-8f2dcb3b8848",
                                "text": "„Das Frontispiz zeigt eine dramatische Szene mit drei Figuren, und es ist Rousseau, der diese Trias 1752, also zwei Jahre nach der Erstveröffentlichung und als Reaktion auf zahlreiche kritische Einwendungen umfassend erläutert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1849f8c6-f621-4b76-8b2e-e06fda9f00dd",
                        "source_entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                        "source_sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                        "target_lang_word": "pediment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pediment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                                        "glosses": [
                                            "A classical architectural element consisting of a triangular section or gable found above the horizontal superstructure (entablature) which lies immediately upon the columns; fronton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8f82f1-35b1-453c-8134-87e9598250e6",
                                                "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                                                "text": "Passing the Congregation Shearith Israel on Central Park West (a white whale of a building with a triangular pediment supported by four count ’em four massive Corinthian columns), Professor Solanka scurrying through the downpour remembered the newly bat-mitzvahed thirteen-year-old girl he’d glimpsed through the side door, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f384aa1-eff4-3dce-bda5-fe6390e03fa5",
                                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                                        "glosses": [
                                            "A very gently sloping (0.5°-7°) inclined bedrock surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b5d6e56-6b66-4f98-a64a-718e397303fe",
                        "source_entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                        "source_sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                        "target_lang_word": "frontispiece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontispiece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "942a9290-46e8-380c-b234-2bda1c2165f5",
                                        "entry_id": "80bd877d-9dca-38fd-89d2-142e31ef5dfa",
                                        "glosses": [
                                            "An illustration that is on the page before the title page of a book, a section of one, or a magazine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1e0820-18cb-48ee-a71d-e26fe3092af3",
                                                "sense_id": "942a9290-46e8-380c-b234-2bda1c2165f5",
                                                "text": "The viaduct was illustrated as a frontispiece to THE RAILWAY MAGAZINE of September, 1938. [In this case, the frontispiece is between the title page and the first article.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6552243-eac4-34b6-a84a-1d90ab392c68",
                                        "entry_id": "80bd877d-9dca-38fd-89d2-142e31ef5dfa",
                                        "glosses": [
                                            "The title page of a book."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd98bf6c-2739-3471-bc6c-78dd7c04bfcd",
                                        "entry_id": "80bd877d-9dca-38fd-89d2-142e31ef5dfa",
                                        "glosses": [
                                            "A façade, especially an ornamental one."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "955aff90-c16d-3f54-9868-ea2cb0f0c79d",
                                        "entry_id": "80bd877d-9dca-38fd-89d2-142e31ef5dfa",
                                        "glosses": [
                                            "A small ornamental pediment, especially at the top of a window or door."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19c6680e-6819-3a22-9df8-f24d004a47a6",
                                        "entry_id": "80bd877d-9dca-38fd-89d2-142e31ef5dfa",
                                        "glosses": [
                                            "A person's face."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffabd84-7c68-47d4-9389-0740a886a59a",
                                                "sense_id": "19c6680e-6819-3a22-9df8-f24d004a47a6",
                                                "text": "He carries on his frontispiece the indubitable marks of a money-dealer. His is one of those peculiar faces […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frontispiece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b115b0bc-e3d7-3da5-abb3-ea322c4489d8",
                                        "entry_id": "f4dc11b4-befc-30d8-938d-ce5eafcda76d",
                                        "glosses": [
                                            "To supply with a frontispiece."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747cc1ba-2e51-481c-bf27-80eec875b1df",
                                                "sense_id": "b115b0bc-e3d7-3da5-abb3-ea322c4489d8",
                                                "text": "The novel was frontispieced with a portrait of the author."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1d83e0a-cf28-45fc-888e-5e23ffa82c04",
                        "source_entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                        "source_sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                        "target_lang_word": "frontispice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontispice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                                        "glosses": [
                                            "Façade principale d’un grand bâtiment."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c6cca3-3cb0-46e0-874f-db0e18d90b3f",
                                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                                "text": "Les vicissitudes de Notre-Dame, à partir de 1789, se présentent ainsi :[…]. Elle fut fermée en 1793; et dans la même année Robespierre fit inscrire sur son frontispice : Temple de la Raison."
                                            },
                                            {
                                                "example_id": "9b2acc3a-34f6-4bcd-a851-e951eda1cdf3",
                                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                                "text": "La salle de réunion du conseil municipal avait autrefois servi de salle de classe pour les enfants du village. Le frontispice de l’édifice public comportait d’ailleurs toujours l’inscription « Ecole-Mairie »."
                                            },
                                            {
                                                "example_id": "26107d63-a036-4fd1-9c28-3a6950e1acf4",
                                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                                "text": "[…], les petits édifices historiques meringués et sculptés de colonnades et de frontispices comme des gâteaux de mariage, […].,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                                        "glosses": [
                                            "Titre imprimé d’un livre placé à la première page et entouré ou accompagné d’ornements ou de vignettes."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc46a486-3d7d-4e24-8211-cd4e3dcd45f4",
                                                "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                                                "text": "Au verso du frontispice de la 1ʳᵉ édition on voit le portrait de l’auteur dans un médaillon, gravé par un anonyme."
                                            },
                                            {
                                                "example_id": "32508b97-e0e8-4082-8b40-aac99d57101d",
                                                "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                                                "text": "Vient ensuite la tomaison, qui se lie moins étroitement encore au frontispice que le nom de l’auteur, puis le nom et l’adresse du libraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                                        "glosses": [
                                            "Illustration placée en regard du titre d’un livre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81a53ee-7dc7-45a8-aef1-a7875d5aa792",
                                                "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                                                "text": "Tandis qu’en 1651, Andromède est illustrée d’un frontispice suivi de six belles gravures du spectacle signées du décorateur Torelli et de François Chauveau."
                                            },
                                            {
                                                "example_id": "aa73b1a7-7ac2-4b01-8dc7-fe39ac4e0239",
                                                "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                                                "text": "Livre d’un format grand in-octavo, et contenant indépendamment de la planche frontispice représentant une promenade au bord de la mer, et de la dernière planche représentant le jeu de Kai-awassé, six planches doubles de coquillages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa86b51-3145-356d-804f-c5e0c8def281",
                                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                                        "glosses": [
                                            "Début, introduction d’un écrit."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
