                    {
                        "translation_id": "0cfdf6ea-0748-4dd4-bd7f-1b70842cf489",
                        "source_entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "source_sense_description": "geek or nerd",
                        "target_lang_word": "Sonderling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonderling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                        "entry_id": "8ccbc3d7-8ad2-34e9-9009-31edbd7cc853",
                                        "glosses": [
                                            "ein Mensch, der einen eigenartigen Charakter hat und in seiner eigenen Welt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1ff61c-eda2-4ce9-9a29-53dfda011d01",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "Ein Sonderling ist oftmals ein Genie, das seinen eigenen Weg geht."
                                            },
                                            {
                                                "example_id": "e19472d9-7db2-437f-a63b-0b916da6003d",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "Wer von der sozialen Norm abweicht, ist ein Sonderling."
                                            },
                                            {
                                                "example_id": "771a5203-b5d7-4440-a507-7986b67babed",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "Sonderlinge sind unbeliebt und haben es sehr schwer in unserer Gesellschaft."
                                            },
                                            {
                                                "example_id": "dbfa67ef-c984-4768-a840-b4f0f3e0f738",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "„So gab ich diesem Sonderling einen der Beweise seiner geistigen Anziehungskraft, auf die er sich gern berief.“"
                                            },
                                            {
                                                "example_id": "4752ef72-45ce-41df-a5e3-be168e6c7766",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "„Mag sein: Mein Leben als Einzelkind und der spärliche Umgang mit Gleichaltrigen haben mich zum Sonderling und Grübler gemacht.“"
                                            },
                                            {
                                                "example_id": "cc71ee25-4fe4-4940-9c5c-ed0713a31d71",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "„Andere Menschen sahen in ihm einen Sonderling, einen, der angeblich auch mit den Elfen sprechen konnte.“"
                                            },
                                            {
                                                "example_id": "8922623c-92c0-4133-a9ed-434f4a8b0010",
                                                "sense_id": "deb44f26-3263-35e9-8b45-70a5732409ae",
                                                "text": "„Wie schon erwähnt, war dieser Doktor Eisentür ein etwas wunderlicher, altmodischer Herr, ein richtiger Sonderling und Eigenbrötler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "500f6d34-839b-46e4-89b9-76bbecabede6",
                        "source_entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "source_sense_description": "geek or nerd",
                        "target_lang_word": "Eigenbrötler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenbrötler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                        "entry_id": "62a1539d-bcaf-3032-9e97-bd99e5d0215e",
                                        "glosses": [
                                            "eine von anderen in ihrem Verhalten eigenartig und seltsam erscheinende Person, die den Kontakt zu anderen meidet und lieber für sich bleibt sowie ihre Angelegenheiten auf eigene Weise und für sich allein erledigt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065f5017-e87d-4c36-89bb-23b45decad55",
                                                "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                                "text": "Dieser unverbesserliche Eigenbrötler verlässt doch sein Haus nie!"
                                            },
                                            {
                                                "example_id": "63cb4576-c09a-416f-b3a8-01cc15257063",
                                                "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                                "text": "„So bleibt der Künstler ein Eigenbrötler, wenn nicht ein Widersacher; bleibt er der Einsame und Isolierte in einer entlegenen Kammer.“"
                                            },
                                            {
                                                "example_id": "cab4367e-cc44-4434-962e-4aab2e1136b7",
                                                "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                                "text": "„Abseits der Arbeit verwandelte sich der nägelkauende Eigenbrötler in ein Phantom.“"
                                            },
                                            {
                                                "example_id": "012bb424-3f95-48e8-9758-22bd5e8d9c27",
                                                "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                                "text": "„Die Eigenbrötler dort scherten sich nicht um königliche Vorgaben und pflegten ihre Sprache, die irische Einwanderer im 5. Jahrhundert mitgebracht hatten.“"
                                            },
                                            {
                                                "example_id": "a4a36893-a8ed-4da9-8266-03e44058063b",
                                                "sense_id": "c1242adc-1841-301f-a653-202482d391a8",
                                                "text": "„Da war manche, die zu dem Mann kam, der als irrer Eigenbrötler dahinexistierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
