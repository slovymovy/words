                                "example_id": "10f8180b-176e-426d-b384-97e91493db7b",
                                "sense_id": "6a16beba-4ab9-3909-ad33-b09b2ac4962c",
                                "text": "Videotaping by an experienced videographer can add so much life to your wedding memories that it is fast becoming a very popular wedding component."
                            }
