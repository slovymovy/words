                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                        "entry_id": "6f08ecb2-6172-355c-a06f-220def862319",
                        "glosses": [
                            "auf Grundlage von Zellen, mithilfe von Zellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81005208-ae37-442b-85f2-18f54dca182e",
                                "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                                "text": "„Alle Impfstoffe werden Ei-basiert hergestellt, inaktivierte Impfstoffe (mono- und trivalent) zusätzlich auch zellbasiert.“"
                            },
                            {
                                "example_id": "d52bb9b5-ac91-46cd-a12e-e05cc5aa439d",
                                "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                                "text": "„Dazu werden Antigene für zellbasierte Impfstoffe aus den jeweiligen Tumoren gewonnen, die bei einem chirurgischen Eingriff entfernt wurden.“"
                            },
                            {
                                "example_id": "5facbab9-6f82-43fc-948c-1632309be859",
                                "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                                "text": "„Strategien, die diese Zellen für die Therapie nutzen, werden als zellbasierte Therapien bezeichnet.“"
                            },
                            {
                                "example_id": "02464430-6677-49ab-8863-6f7e6cc387a9",
                                "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                                "text": "„Es ist möglich, dass zellbasierte Produkte, die am gleichen anatomischen Ort verabreicht werden, unter die Definition von Arzneimitteln für neuartige Therapien fallen, da sie für eine andere wesentliche Funktion verwendet werden.“"
                            },
                            {
                                "example_id": "efcb0f8e-662a-4438-9ac0-011897f82ce6",
                                "sense_id": "8c5b9615-42c5-333c-9da8-88a5ecb7e173",
                                "text": "„Die Start-ups demonstrieren auch, dass die zellbasierte Produktion von Fleisch bereits im kleinen Maßstab funktioniert.“"
