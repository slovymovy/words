                ],
                "translations": [
                    {
                        "translation_id": "ff137cc4-0e3e-4880-8c05-a8c6c451c18e",
                        "source_entry_id": "9231bc65-c7cb-3fda-9d71-83ac7bd615dd",
                        "source_sense_id": "2b92d5fb-b181-3758-9863-5af42a31d9e6",
                        "target_lang_word": "administration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6519d1d6-163e-3046-a639-646e8ac31a79",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The act of administering; government of public affairs; the service rendered, or duties assumed, in conducting affairs; the conducting of any office or employment; direction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e79c84-d90d-420c-91c9-9e877ff4b068",
                                                "sense_id": "6519d1d6-163e-3046-a639-646e8ac31a79",
                                                "text": "[…] the fact that the propertied classes are no longer the best educated, and the fact that the large number of people who owe their position solely to their general education do not possess that experience of the working of the economic system which the administration of property gives are important to understanding the role of the intellectual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The executive part of government; the persons collectively who are entrusted with the execution of laws and the superintendence of public affairs; the chief magistrate and his cabinet or council; or the council, or ministry, alone, as in Great Britain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9ae490-82b5-459e-9ee7-eb7722cd1971",
                                                "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                                "text": "Successive US administrations have had similar Middle East policies."
                                            },
                                            {
                                                "example_id": "493a743d-a3e6-4321-b983-1ff7a3bf0fc1",
                                                "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                                "text": "The trove of documents from half a dozen federal agencies in recent days are a direct result of a blockbuster Supreme Court decision last month that allowed the administration to develop plans for ending birthright citizenship – even though the effort has once again been placed on hold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The country's government under the rule of a particular leader."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d1b8a4-c94b-4bf0-bc5e-1cb27f708127",
                                                "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                                "text": "The Obama administration"
                                            },
                                            {
                                                "example_id": "d6618e60-a59f-4213-88a0-3c0d30626615",
                                                "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                                "text": "The Duterte administration"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839d3add-8e9c-371c-92cb-5231d2f09cbd",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "A body that administers; a body of administrators."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aca86be-04a7-4c9c-8a36-c71ce9a8e7de",
                                                "sense_id": "839d3add-8e9c-371c-92cb-5231d2f09cbd",
                                                "text": "The Chiang Mai Administrative Court ruled in favour of students from the Media Arts and Design Department, Faculty of Fine Arts, Chiang Mai University, who filed for a temporary injunction on 18 October after the University administration prohibited them from showing their final theses in the University Art Centre because some pieces dealt with social and political themes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The act of administering, or tendering something to another; dispensation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd31cd4-be54-4f1f-a83b-6fa4ac9a187b",
                                                "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                                "text": "the administration of a medicine, of an oath, of justice, or of the sacrament"
                                            },
                                            {
                                                "example_id": "ab80f6e7-c003-4eea-baba-43cbb258e384",
                                                "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                                "text": "oral administration of insulin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a10a272-6255-36ea-9ee5-a2946d16055e",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "Management."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "An arrangement whereby an insolvent company can continue trading under supervision."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4181035b-8be0-4597-ae3b-6a0cc500f54f",
                                                "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                                "text": "The company went into voluntary administration last week."
                                            },
                                            {
                                                "example_id": "d8ff2807-2f0d-406e-ac9e-39618668913a",
                                                "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                                "text": "The other ambitions, and much of Prescott's plan, foundered just south of Hatfield that October, when a GNER express derailed on a shattered rail […], plunging the railway into a crisis that led to private track owner Railtrack being put into administration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd73fdf-f3ce-46ee-8068-0638482c9cf3",
                        "source_entry_id": "9231bc65-c7cb-3fda-9d71-83ac7bd615dd",
                        "source_sense_id": "2b92d5fb-b181-3758-9863-5af42a31d9e6",
                        "target_lang_word": "administration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e93db694-091b-36c7-bdea-c211ac0f1404",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Action d’administrer ; direction ou conduite des affaires publiques ou particulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3be40d4-d542-4c43-8edf-582736f28ff6",
                                                "sense_id": "e93db694-091b-36c7-bdea-c211ac0f1404",
                                                "text": "Il me semble que l’administration d’un grand peuple peut être comparée à une chaîne immense. Si chacun des anneaux n’est pas proportionné au poids qu’il supporte, la chaîne se brise…"
                                            },
                                            {
                                                "example_id": "f4d6eff4-3e8e-4712-8caf-eeb69ba5a679",
                                                "sense_id": "e93db694-091b-36c7-bdea-c211ac0f1404",
                                                "text": "Mais New York ne copiait aucun peuple pour le désordre et le gâchis de son administration intérieure, un désarroi, grâce auquel des quartiers entiers échappaient à toute loi, devenaient impénétrables aussitôt que des batailles et des tueries de rue à rue y éclataient."
                                            },
                                            {
                                                "example_id": "8efa0e8c-772f-48fb-9dd5-16f4c24d3a75",
                                                "sense_id": "e93db694-091b-36c7-bdea-c211ac0f1404",
                                                "text": "Enfin, en pays de droit écrit, au moins après la renaissance du droit de Justinien, la femme pouvait avoir des paraphernaux dont elle gardait la propriété, la jouissance et même l’administration, […]."
                                            },
                                            {
                                                "example_id": "5ebd43f8-455b-4605-904c-85eee388083e",
                                                "sense_id": "e93db694-091b-36c7-bdea-c211ac0f1404",
                                                "text": "Pierre Savary avait au surplus l’administration des fiefs de Boutervilliers et de la Grimbardière, dévolus à ses enfants sur la succession de sa femme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e0331b-7d5f-325d-99ad-86012e852dcc",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Période de cette direction des affaires."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc5d019-8474-49bd-8820-b50f8964f871",
                                                "sense_id": "c9e0331b-7d5f-325d-99ad-86012e852dcc",
                                                "text": "Pendant la longue durée de son administration il avait amassé une fortune considérable, si considérable, en effet, qu’un jour le gouvernement chérifien jugea le moment venu de s’en emparer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9fcb37-5a78-3471-9460-9a30165dba57",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Corps des fonctionnaires chargés collectivement de quelque partie de l’administration publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbea7be-1f2e-43a3-993b-ab7057f5a53e",
                                                "sense_id": "da9fcb37-5a78-3471-9460-9a30165dba57",
                                                "text": "En Angleterre la séparation est complète entre l’administration locale et l’administration centrale."
                                            },
                                            {
                                                "example_id": "f05e9a68-94bb-4d60-802d-6995299cecc5",
                                                "sense_id": "da9fcb37-5a78-3471-9460-9a30165dba57",
                                                "text": "Yasmina entendait tous les Arabes des environs se plaindre d’avoir à payer des impôts écrasants, d’être terrorisés par l’administration militaire, d’être spoliés de leurs biens."
                                            },
                                            {
                                                "example_id": "df67a6e9-1559-4649-b87a-4b4b593b3239",
                                                "sense_id": "da9fcb37-5a78-3471-9460-9a30165dba57",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique et surtout pour tout accusé qui bravait sa majesté."
                                            },
                                            {
                                                "example_id": "e53bfc8a-88e5-4515-9e2c-18ad61eb3df1",
                                                "sense_id": "da9fcb37-5a78-3471-9460-9a30165dba57",
                                                "text": "[…] les landes à Bruyères déjà troublées dans leur évolution naturelle par des plantations de Bouleaux, le seront plus encore lorsque dans un avenir prochain l’administration forestière aura enrésiné par des plantations d’Épicéa le plateau tourbeux d’Ecromagny […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a017c259-0904-313c-96c4-477cd1cddfd1",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Corps des fonctionnaires chargés collectivement de quelque partie de l’administration publique.",
                                            "Un de ces corps administratifs."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4921d12-1212-4905-90b6-3454faa08ba0",
                                                "sense_id": "a017c259-0904-313c-96c4-477cd1cddfd1",
                                                "text": "Il est en procès avec l’administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8ad419-a151-33a8-b3e1-fc2ca52d3bc1",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Corps des fonctionnaires chargés collectivement de quelque partie de l’administration publique.",
                                            "Un bâtiment accueillant un de ces corps administratifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb552b0-5930-44d3-a62b-2765e8164d14",
                                                "sense_id": "4a8ad419-a151-33a8-b3e1-fc2ca52d3bc1",
                                                "text": "Il s’est rendu à l’administration des eaux et forêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aaebb33-efd5-31bb-9cf3-cfd0a5590298",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Gouvernement américain."
                                        ],
                                        "tags": [
                                            "Américanisme"
                                        ],
                                        "note": "— Il est souvent suivi du nom du président de ce gouvernement pour spécifier la fourchette historique",
                                        "examples": [
                                            {
                                                "example_id": "3e4a4d8d-f875-40c0-ab51-21af2a1d0a80",
                                                "sense_id": "0aaebb33-efd5-31bb-9cf3-cfd0a5590298",
                                                "text": "L’agence de notation avait en effet prévenu dès la mi-juillet l’administration Obama qu’elle souhaitait une réduction des déficits de 4000 milliards de dollars sur dix ans pour maintenir le triple A, au lieu des 2100 milliards difficilement obtenus."
                                            },
                                            {
                                                "example_id": "33d53dd1-bbcc-456f-a9e7-f90c2b00af38",
                                                "sense_id": "0aaebb33-efd5-31bb-9cf3-cfd0a5590298",
                                                "text": "Dans les exploitations de la Vallée Centrale, les cueilleurs d’agrumes et leurs enfants souffrent à cause des taux dangereux de chlorpyriphos-éthyl, produit neurotoxique dont l’interdiction a été annulée par l’administration Trump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebee49d9-039b-36d5-8904-d55831fb2a73",
                                        "entry_id": "04f90140-0a49-3c41-99c1-35d451d0f49b",
                                        "glosses": [
                                            "Action d’administrer, de fournir une chose à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d47d196-1d83-449c-a258-9f0e64bbf3b5",
                                                "sense_id": "ebee49d9-039b-36d5-8904-d55831fb2a73",
                                                "text": "Mais dans les 24-36 heures qui suivirent l’administration du visnagan, les rats se sont montrés déprimés, somnolents, présentant une anorexie et un retard évident du transit intestinal et, parfois, une chromodacryorrhée et une sécrétion nasale hémorragique."
                                            },
                                            {
                                                "example_id": "e320f968-c920-4e5e-af37-c0d6d6415959",
                                                "sense_id": "ebee49d9-039b-36d5-8904-d55831fb2a73",
                                                "text": "— Ainsi, seuls, en médecine d’urgence, les masques permettent une administration d’oxygène efficace […]"
                                            },
                                            {
                                                "example_id": "8c12e47a-04ae-4d9b-a556-d173232769aa",
                                                "sense_id": "ebee49d9-039b-36d5-8904-d55831fb2a73",
                                                "text": "L’administration de graisse sur le plateau d’un vélo permet de lubrifier sa chaîne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
