                    {
                        "sense_id": "e02577a6-5f6a-3f1e-a171-925d8a17d839",
                        "entry_id": "0551ef9f-3cad-3331-ba1f-10ef2d43d7df",
                        "glosses": [
                            "Umzug/Wechsel in eine andere Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a732059-6846-4c2f-ade0-2ac64536c579",
                                "sense_id": "e02577a6-5f6a-3f1e-a171-925d8a17d839",
                                "text": "„Die anderen empfahlen Wohnungswechsel, in irgendeine ferne, fremde Gegend solle er verziehen, wo er sein Weib sicher vor den Nachstellungen des gewissen Jemand wissen würde.“"
                            },
                            {
                                "example_id": "87bbe54b-0ecc-47fc-bc73-25c4f4d7aa08",
                                "sense_id": "e02577a6-5f6a-3f1e-a171-925d8a17d839",
                                "text": "„Er las den Brief; es stand nichts darin von einem Wohnungswechsel oder von Luftangriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
