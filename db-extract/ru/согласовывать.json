                                "target_word": "zustimmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79fd7b3d-56dd-31f5-9904-9ae446e4ad52",
                                        "entry_id": "1a374abb-3011-3628-86c5-d2001dcd4eea",
                                        "glosses": [
                                            "erklären, dass man mit einer schriftlich oder mündlich gemachten Aussage in Übereinstimmung steht, dass man den Inhalt anerkennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38bec62d-87f1-41a1-83eb-780e0918cd27",
                                                "sense_id": "79fd7b3d-56dd-31f5-9904-9ae446e4ad52",
                                                "text": "„Dieser von dem alten Zühlen, trotz seiner Vorliebe für Dubslav, eindringlich gehaltenen Rede war allgemein zugestimmt worden, und Baron Beetz hatte den götzenhaften Alten-Friesacker an seinen Ehrenplatz geführt.“"
                                            },
                                            {
                                                "example_id": "0ff158a7-6ce5-41b7-b16a-78e05baacc76",
                                                "sense_id": "79fd7b3d-56dd-31f5-9904-9ae446e4ad52",
                                                "text": "Dem kann ich nur vorbehaltlos zustimmen."
                                            },
                                            {
                                                "example_id": "9c4155fb-e367-411e-b6e7-7df6afd243f0",
                                                "sense_id": "79fd7b3d-56dd-31f5-9904-9ae446e4ad52",
                                                "text": "Stimmtest du meinem Vorschlag zu, dann wären wir wenigstens schon zwei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
