                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91795571-36bf-4283-bbc4-beb6134613c0",
                                "sense_id": "828a15fb-aa0f-3a03-a18f-6d841618faa8",
                                "text": "„Seit Antritt seines Amtes hatte Simen Tjing täglich im Strafvollzugsamte gearbeitet, an den Sitzungen im Saale teilgenommen und seine Amtsgeschäfte erledigt.“"
                            },
                            {
                                "example_id": "a4508fed-2eb2-4d22-a87f-a0fc7efaddac",
                                "sense_id": "828a15fb-aa0f-3a03-a18f-6d841618faa8",
                                "text": "„Wenn da nicht die Amtsgeschäfte wären!“"
                            }
                        ],
