                            {
                                "target_word": "port",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05821020-52b0-3341-afee-a2138aa4c238",
                                        "entry_id": "0e6c6fbf-e2f3-30ac-8305-7144e2836d5e",
                                        "glosses": [
                                            "To carry, bear, bring, or transport. See porter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83887961-c8ab-478d-8c48-1e9d93193bb5",
                                                "sense_id": "05821020-52b0-3341-afee-a2138aa4c238",
                                                "text": "Dauid in this Pſalme doth exhoꝛt, to pꝛayſe the Loꝛde alwayes: Foꝛ that he did vs make and poꝛt, and guydes vs all our dayes."
                                            },
                                            {
                                                "example_id": "515c1063-fad3-43be-97df-7897e6e57256",
                                                "sense_id": "05821020-52b0-3341-afee-a2138aa4c238",
                                                "text": "What one may call River or Freſh-water-Coale, digged out in this Country, at ſuch a diſtance from Severne, that they are eaſily ported by Boat into other Shires."
                                            },
                                            {
                                                "example_id": "15a658d1-2488-428b-8c59-01b90eb60e40",
                                                "sense_id": "05821020-52b0-3341-afee-a2138aa4c238",
                                                "text": "A handful of ants meander across each plank, some porting crumblike objects on their back, others apparently just out for a stroll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2cd0c6-60d9-3d5a-97de-f1375d289073",
                                        "entry_id": "0e6c6fbf-e2f3-30ac-8305-7144e2836d5e",
                                        "glosses": [
                                            "To hold or carry (a weapon) with both hands so that it lies diagonally across the front of the body, with the barrel or similar part near the left shoulder and the right hand grasping the small of the stock; or, to throw (the weapon) into this position on command."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b09fc29-068a-404d-967e-f6a3311af673",
                                                "sense_id": "7e2cd0c6-60d9-3d5a-97de-f1375d289073",
                                                "text": "Port arms!"
                                            },
                                            {
                                                "example_id": "5f306e87-b10b-4183-b121-e60572c3fd08",
                                                "sense_id": "7e2cd0c6-60d9-3d5a-97de-f1375d289073",
                                                "text": "[…] the angelic squadron...began to hem him round with ported spears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3fd33e-66aa-3fff-83bb-a8b1b275b277",
                                        "entry_id": "0e6c6fbf-e2f3-30ac-8305-7144e2836d5e",
                                        "glosses": [
                                            "To adapt, modify, or recode to work on a different platform."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "275f3a19-f016-49ec-ae89-27e048eb65f6",
                                                "sense_id": "dd3fd33e-66aa-3fff-83bb-a8b1b275b277",
                                                "text": "By its tenth week of release, CPH was the best-selling PC game in America. PlayStation and Xbox ports were already in the works, and there was talk of porting it to Nintendo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d6a3da-07b9-3919-9355-cf1bf776c2e6",
                                        "entry_id": "0e6c6fbf-e2f3-30ac-8305-7144e2836d5e",
                                        "glosses": [
                                            "To carry or transfer (an existing telephone number) from one service provider to another."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "549f08af-ecb9-4c4a-831e-cc66dc63a08a",
                                                "sense_id": "64d6a3da-07b9-3919-9355-cf1bf776c2e6",
                                                "text": "If you submit a request to port a number, and you list the name on the account as Bob Smith, but your local carrier has the number listed under your wife's name Mary Mahoney, the porting request is rejected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223fda03-84c1-3f56-a5d1-434ee9b35985",
                                        "entry_id": "0e6c6fbf-e2f3-30ac-8305-7144e2836d5e",
                                        "glosses": [
                                            "To transfer a voucher or subsidy from one jurisdiction to another."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
