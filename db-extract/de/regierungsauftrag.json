                ],
                "senses": [
                    {
                        "sense_id": "cfbedf93-03ae-3b79-8001-09957bac8635",
                        "entry_id": "0c12a7ac-ba93-3657-b628-0107c533c906",
                        "glosses": [
                            "von einer amtierenden Regierung erteilter/vergebener Auftrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94c78e3-b5fa-449e-95e0-222f5e3171b7",
                                "sense_id": "cfbedf93-03ae-3b79-8001-09957bac8635",
                                "text": "„Saudi-Arabien ist tief verärgert über die Berliner Politik im Nahen Osten, vor allem über die deutsche Haltung gegenüber Iran. Der neue Thronfolger Mohammed bin Salman verhängte deshalb einen internen Vergabestopp für Regierungsaufträge.“"
                            },
                            {
                                "example_id": "6eff68fc-095f-4dea-9d8a-af023b79a913",
                                "sense_id": "cfbedf93-03ae-3b79-8001-09957bac8635",
                                "text": "„Wie das Unternehmen mitteilte, hat die zuständige US-Regierungsbehörde General Services Administration (GSA) eine Empfehlung vom Sommer aufgehoben, MCI von allen Regierungsaufträgen auszuschließen.“"
                            },
                            {
                                "example_id": "e1f01638-de66-4e11-b25f-5fc93f455e30",
                                "sense_id": "cfbedf93-03ae-3b79-8001-09957bac8635",
                                "text": "„In einem Fall wurde Boeing beschuldigt, Ende der 90er-Jahre illegal interne Unterlagen von Lockheed Martin gekauft zu haben, um sich damit einen Vorteil im Wettbewerb um Regierungsaufträge für den Transport von Satelliten ins All zu verschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c28534ef-988c-38ee-9800-52380b026d93",
                        "entry_id": "0c12a7ac-ba93-3657-b628-0107c533c906",
                        "glosses": [
                            "Beauftragung zur Regierungsbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155becbe-e990-446c-8ad4-d070cadf64ec",
                                "sense_id": "c28534ef-988c-38ee-9800-52380b026d93",
                                "text": "„Die neue italienische Regierung nimmt Formen an. Nachdem Staatspräsident Sergio Mattarella dem Juraprofessor Giuseppe Conte den Regierungsauftrag erteilt hat, ist der Weg frei für eine Koalition aus der rechtspopulistischen Lega Nord und der linkspopulistischen Fünf-Sterne-Bewegung.“"
                            },
                            {
                                "example_id": "2e7bc376-e043-4796-8cb9-363874d7a912",
                                "sense_id": "c28534ef-988c-38ee-9800-52380b026d93",
                                "text": "„Italiens Staatspräsident Sergio Mattarella hat dem politischen Quereinsteiger Giuseppe Conte den Regierungsauftrag erteilt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
