                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paul porte toujours une jolie chemise <w>à</w> carreaux bleus."
                        },
                        {
                            "text": "J'ai aperçu un vieil homme <w>à</w> barbe blanche dans le parc."
