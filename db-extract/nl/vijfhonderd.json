                "senses": [
                    {
                        "sense_id": "a72117dd-be00-3aab-83d3-72fe871e4188",
                        "entry_id": "7ca586e7-92a4-3787-83ba-28e29ee639de",
                        "glosses": [
                            "\\\"500\\\", het getal tussen vierhonderdnegenennegentig en vijfhonderdeen, vijf maal honderd"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0736327-0efe-385c-a4b1-78c29535f2f9",
                        "entry_id": "7ca586e7-92a4-3787-83ba-28e29ee639de",
                        "glosses": [
                            "\\\"500\\\", het getal tussen vierhonderdnegenennegentig en vijfhonderdeen, vijf maal honderd",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65cfa42-851d-4519-b41b-e9f9364aa4d9",
                                "sense_id": "e0736327-0efe-385c-a4b1-78c29535f2f9",
                                "text": "De totale kosten bedragen vijfhonderd euro en zevenendertig cent."
                            },
                            {
                                "example_id": "2937ea52-cf4d-4884-af37-bf8bf235c47f",
                                "sense_id": "e0736327-0efe-385c-a4b1-78c29535f2f9",
                                "text": "Het afscheid van de gestorven graaf is officieel een privéaangelegenheid. Maar een rouwstoet met vijfhonderd genodigden die van de Grote Kerk in het centrum van Almelo naar het mausoleum op het grafelijke landgoed ten oosten van de stad wandelt is ook een publieke aangelegenheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ebaa404-e7a2-3ee5-a124-4eef39a58199",
                        "entry_id": "7ca586e7-92a4-3787-83ba-28e29ee639de",
                        "glosses": [
                            "\\\"500\\\", het getal tussen vierhonderdnegenennegentig en vijfhonderdeen, vijf maal honderd",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ad6319-2a2c-4f27-adda-3f3a60eb483d",
                                "sense_id": "1ebaa404-e7a2-3ee5-a124-4eef39a58199",
                                "text": "We logeerden vlakbij het strand in kamer vijfhonderd van het grootste hotel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "944985de-6b3e-472e-a705-3c2198ff8e4e",
                        "source_entry_id": "7ca586e7-92a4-3787-83ba-28e29ee639de",
                        "source_sense_id": "a72117dd-be00-3aab-83d3-72fe871e4188",
                        "source_sense_description": "het getal 500",
                        "target_lang_word": "fünfhundert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fünfhundert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c0fee5-0da5-3f84-ab4b-32baf67901cf",
                                        "entry_id": "2490ffa7-99f7-3302-acb2-cc2afb9fdc28",
                                        "glosses": [
                                            "die Kardinalzahl, die sich durch Multiplikation von fünf mit hundert ergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b31ff5-077f-41e8-8b71-a0835a6874e7",
                                                "sense_id": "b7c0fee5-0da5-3f84-ab4b-32baf67901cf",
                                                "text": "„Im Auftrag Papst Nikolaus V. übersetzte er Polybios' Römische Geschichte wofür ihm der Papst fünfhundert neue Dukaten schenkte.“"
                                            },
                                            {
                                                "example_id": "d502fbc2-a686-46ec-ab04-13bae3505889",
                                                "sense_id": "b7c0fee5-0da5-3f84-ab4b-32baf67901cf",
                                                "text": "„Brauchen Sie die Hilfen überhaupt? Sie haben fast neun Milliarden Euro Barmittel und schon fünfhundert feste Aufträge für das Flugzeug.“"
                                            },
                                            {
                                                "example_id": "2ea0f8a4-ddd7-498f-8afe-5b23937b8f3d",
                                                "sense_id": "b7c0fee5-0da5-3f84-ab4b-32baf67901cf",
                                                "text": "„Fünfhundert Häuser hätten hier dicht beieinandergestanden, es sei fast ein Städtchen gewesen mit einer eigenen Schule, mit Geschäften, einer Verwaltung und einem Gemeindesaal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1176b5ed-7372-46f8-a4ce-a5ef05c2d1c3",
                        "source_entry_id": "7ca586e7-92a4-3787-83ba-28e29ee639de",
                        "source_sense_id": "a72117dd-be00-3aab-83d3-72fe871e4188",
                        "source_sense_description": "het getal 500",
                        "target_lang_word": "cinq-cents",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinq-cents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9114c86b-cdf6-3825-a533-cae896f62b0e",
                                        "entry_id": "5523bbd9-cf8c-3350-8d7a-47cd2a8027c7",
                                        "glosses": [
                                            "Nombre équivalent à cinq centaines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cinq-cents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fb329c0-04f0-3dab-aa02-2bad2d23da69",
                                        "entry_id": "551934e8-baf4-32da-aae0-f2836b0ab0c3",
                                        "glosses": [
                                            "Jeu de cartes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b23b57e-9b35-4180-8657-282a9cdee444",
                                                "sense_id": "8fb329c0-04f0-3dab-aa02-2bad2d23da69",
                                                "text": "À peine eut-il le dos tourné, la dame de grand mérite s’en alla à son tour à l’office faire un cinq cents avec la cuisinière. Entre nous, je crois que son plus grand mérite, à cette dame-là, c’était de tripoter les cartes fort habilement…"
                                            },
                                            {
                                                "example_id": "dc764ca2-5870-4e6a-9382-6cc73e6c593c",
                                                "sense_id": "8fb329c0-04f0-3dab-aa02-2bad2d23da69",
                                                "text": "On vient de dépouiller les votes ; on a voté sur de vieilles cartes prises dans un jeu de bézigue qui restera dépareillé ; on ne fera plus le cinq cents. J’avais le valet de carreau, et j’ai allumé ma pipe avec."
                                            },
                                            {
                                                "example_id": "9c18848f-c2fe-433f-9369-5d3700c1f8ca",
                                                "sense_id": "8fb329c0-04f0-3dab-aa02-2bad2d23da69",
                                                "text": "« Il n’est pas nécessaire de réfléchir pour apprendre du Démosthène et du Virgile, mais quand il faut faire le quatre-vingt-dix ou le cinq cents, ou échec au roi, ou empaler des mouches sans les faire souffrir, le calme est indispensable à la pensée, et le recueillement est bien dû à l’insecte innocent que va, messieurs, sonder votre curiosité, si j’ose m’exprimer ainsi."
                                            },
                                            {
                                                "example_id": "f9b2f066-83fe-474e-bf45-e0a870e45d95",
                                                "sense_id": "8fb329c0-04f0-3dab-aa02-2bad2d23da69",
                                                "text": "De nos jours, dans le Sud de la France et dans le Nord de l’Italie, on continue à jouer au jeu du Cinq-Cents et au Mariage."
                                            }
                                        ]
                                    }
                                ]
                            },
