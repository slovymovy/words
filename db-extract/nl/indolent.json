                                "target_senses": [
                                    {
                                        "sense_id": "45875cbc-38db-31c9-b632-c6121eb174a8",
                                        "entry_id": "71f38dbd-cfc7-36c8-85b1-319e256b71b8",
                                        "glosses": [
                                            "Habitually lazy, procrastinating, or resistant to physical labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ee5b8a-8190-47ae-a1da-5400b7e28b2d",
                                                "sense_id": "45875cbc-38db-31c9-b632-c6121eb174a8",
                                                "text": "The indolent girl resisted doing her homework."
                                            },
                                            {
                                                "example_id": "e6461af1-5ce3-40d5-876c-1c13ea7bad90",
                                                "sense_id": "45875cbc-38db-31c9-b632-c6121eb174a8",
                                                "text": "Mr. Churchill has pride; but his pride is nothing to his wife’s: his is a quiet, indolent, gentlemanlike sort of pride that would harm nobody, and only make himself a little helpless and tiresome; but her pride is arrogance and insolence!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d03484f3-204d-3573-8930-87659e6f92dd",
                                        "entry_id": "71f38dbd-cfc7-36c8-85b1-319e256b71b8",
                                        "glosses": [
                                            "Inducing laziness."
                                        ],
                                        "tags": [],
                                        "examples": [
