                        ],
                        "form": "haletantes"
                    },
                    {
                        "form_id": "14d5cb64-bc82-47e3-a8c4-d392ef1e9d96",
                        "entry_id": "6ad5e432-3c62-35c7-aed4-b2798cf67933",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "^((h aspiré))\\a.lə.tɑ̃t\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b413bae-0ed6-3427-a564-fd332d30194c",
                        "entry_id": "6ad5e432-3c62-35c7-aed4-b2798cf67933",
                        "glosses": [
                            "Qui halète, qui est essoufflé, qui respire fréquemment, péniblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c10bb4-0c91-4fd2-93a2-f5c3c887793e",
                                "sense_id": "0b413bae-0ed6-3427-a564-fd332d30194c",
                                "text": "Une respiration haletante."
                            },
                            {
                                "example_id": "de67df10-5f67-4277-803a-5f93f2957faf",
                                "sense_id": "0b413bae-0ed6-3427-a564-fd332d30194c",
                                "text": "Buckingham demeura une minute haletant. Pendant cette minute, on vit ses lèvres trembler, ses joues frémir, ses yeux vaciller, comme dans le délire."
                            },
                            {
                                "example_id": "1301e4cb-5365-4f19-83ab-be5aebd6ec52",
                                "sense_id": "0b413bae-0ed6-3427-a564-fd332d30194c",
                                "text": "Les deux goulus haletants emportent dans leurs griffes le papier illustré : ils la tiennent, la pâture délirante où s’assouvira leur infinie avidité !"
                            },
                            {
                                "example_id": "2bd31f11-55e9-4c64-8511-834ca7a9f5d6",
                                "sense_id": "0b413bae-0ed6-3427-a564-fd332d30194c",
                                "text": "Mais la peur trop forte finit pat l’emporter et je … cours dans les couloirs jusqu’aux bras de ma mère dans lesquels je me précipite, haletant, sous l’œil sec et désapprobateur des trois vieilles tantes dont deux en maugréant caressent leur menton poilu."
                            }
                        ]
                    },
                    {
                        "sense_id": "995ec721-36fe-39ff-9b86-442120b82a65",
                        "entry_id": "6ad5e432-3c62-35c7-aed4-b2798cf67933",
                        "glosses": [
                            "Maintenu sous une émotion, une curiosité intense."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dba7d7ad-2b02-47ce-87b0-018ceac56c2a",
                                "sense_id": "995ec721-36fe-39ff-9b86-442120b82a65",
                                "text": "Ce drame tient le public haletant jusqu’au baisser du rideau."
                            }
                        ]
                    },
                    {
                        "sense_id": "4240f3cc-7d4b-33b4-96fa-89d1c4b536b9",
                        "entry_id": "6ad5e432-3c62-35c7-aed4-b2798cf67933",
                        "glosses": [
                            "Qui maintient sous une émotion, une curiosité intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24619378-e317-4e43-a8f7-b1b74a08d7b8",
                                "sense_id": "4240f3cc-7d4b-33b4-96fa-89d1c4b536b9",
                                "text": "Tout à la fois thriller haletant et chronique d’une Amérique en crise, le dernier roman de Douglas Kennedy nous plonge dans les réalités socio-économiques d’un pays où les idéologies extrêmes s’affrontent violemment."
                            },
                            {
                                "example_id": "4ee53100-e6ce-4b18-b31c-629bb2ccc5bf",
                                "sense_id": "4240f3cc-7d4b-33b4-96fa-89d1c4b536b9",
                                "text": "C’est à une course contre la montre haletante que se livrent les enquêteurs, incarnés par Sandrine Kiberlain, Anaïs Demoustier, Lyna Khoudri, Jean Dujardin et Jérémie Renier."
                            },
                            {
                                "example_id": "b92fa5ca-fa92-4e48-91ae-1f9f326feb27",
                                "sense_id": "4240f3cc-7d4b-33b4-96fa-89d1c4b536b9",
                                "text": "Neuf ans après la fin de cette série culte, lancée sur Arte, et qui se déroulait sur trois saisons haletantes, on retrouve avec plaisir Birgitte (Sidse Babett Knudsen), cette élue centriste qui avait été catapultée dix ans plus tôt Première ministre, après un scandale gouvernemental."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90c30fde-5251-4ed1-9699-5b7773a4d29c",
                        "source_entry_id": "6ad5e432-3c62-35c7-aed4-b2798cf67933",
                        "target_lang_word": "breathless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breathless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90d021ff-dc24-39a3-b9d2-685128cd0535",
                                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                                        "glosses": [
                                            "Having difficulty breathing; gasping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f686da41-09ab-4c5d-b340-f47b81842892",
                                                "sense_id": "90d021ff-dc24-39a3-b9d2-685128cd0535",
                                                "text": "In thoughtless and breathless fear I rushed forward to avoid this host of demons, but while flying thus still more frightful and distorted shapes appeared, and I fancied I felt their hands clutching me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                                        "glosses": [
                                            "That makes one hold one's breath (with excitement etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3294c2-71a5-4e7f-a92a-06dbde244a99",
                                                "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                                                "text": "By that stage Sevilla were down to 10 men and Jorge Sampaoli, their manager, had been sent to the stands as a breathless encounter started to spiral out of control."
                                            },
                                            {
                                                "example_id": "31a3b5f7-997e-41c4-81e3-1df1ca428c08",
                                                "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                                                "text": "The plane buzzed on at a breathless speed. Bob had been in a plane before, and he had no fear. Indeed, but for the strange circumstances, he would have enjoyed that breathless rush through space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbe8287-acfd-325c-ad62-e172bf28d97a",
                                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                                        "glosses": [
                                            "Not breathing; dead or apparently so."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8880934c-eed4-34c3-930f-8db2db224cec",
                                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                                        "glosses": [
                                            "Having no wind; still, calm or airless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                                        "glosses": [
                                            "Having a somewhat hysterical tone, using over-emotive language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b84e389-dbaa-4324-82d4-4c0ffa80406f",
                                                "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                                                "text": "In breathless prose that risks making Dr Pachauri, who will be 70 this year, a laughing stock among the serious, high-minded scientists,"
                                            },
                                            {
                                                "example_id": "a207bc27-fb51-41af-a786-e1ff4af0859e",
                                                "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                                                "text": "The more some of us learn, the harder it gets to take each breathless headline seriously."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
