                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbad3506-0104-3ce2-b6a2-f75f0375da40",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "A meal."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0166ef20-3b98-4188-87f1-4a36838b78d6",
                                                "sense_id": "cbad3506-0104-3ce2-b6a2-f75f0375da40",
                                                "text": "184?, Henry Mayhew, London Labour and the London Poor\nOne proposed going to Hungerford-market to do a feed on decayed shrimps or other offal laying about the market; another proposed going to Covent-garden to do a 'tightener' of rotten oranges, to which I was humorously invited; […]"
                                            },
                                            {
                                                "example_id": "b7a7e1eb-0083-402a-ba5e-b20703d09c72",
                                                "sense_id": "cbad3506-0104-3ce2-b6a2-f75f0375da40",
                                                "text": "\"There won't be any more blessed concerts for a million years or so; there won't be any Royal Academy of Arts, and no nice little feeds at restaurants.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d560f3c-6480-3da7-b720-689bdf42b65e",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "A gathering to eat, especially in large quantities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42772f1b-5122-40c9-a839-5a286b8c4171",
                                                "sense_id": "2d560f3c-6480-3da7-b720-689bdf42b65e",
                                                "text": "They held a crab feed on the beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84bf8fbd-47de-3bd9-be6c-d0c1c613e5da",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "online content presented sequentially:",
                                            "antichronological sequence of posts or articles from a single source, especially as consumable on a platform other as originally published."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe6a698-cdfb-4d37-b319-a2edea87d2bb",
                                                "sense_id": "84bf8fbd-47de-3bd9-be6c-d0c1c613e5da",
                                                "text": "I've subscribed to the feeds of my favourite blogs, so I can find out when new posts are added without having to visit those sites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f6a8a9-101f-3c38-b87b-77cd7809e8e9",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "online content presented sequentially:",
                                            "content intended for consumption by scrolling or swiping, especially as a home page and from multiple publishers followed or algorithmically curated"
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e53c49f-01f9-4c4a-b434-d4472e7a5894",
                                                "sense_id": "c6f6a8a9-101f-3c38-b87b-77cd7809e8e9",
                                                "text": "Refresh the top of your various “feeds” — the running column of content on some versions of Facebook, Twitter and Instagram — and you will see the latest news at the top. The further back you scroll, the older the material gets."
                                            },
                                            {
                                                "example_id": "68dac2b3-c052-45b2-9f6f-246a540df59a",
                                                "sense_id": "c6f6a8a9-101f-3c38-b87b-77cd7809e8e9",
                                                "text": "I use Native, that’s what other Native people on Facebook use. I have 660 friends. Tons of Native friends in my feed. Most of my friends, though, are people I don’t know, who’d happily friended me upon request."
                                            },
                                            {
                                                "example_id": "d400023c-d72d-4a96-846b-4949678dc2c4",
                                                "sense_id": "c6f6a8a9-101f-3c38-b87b-77cd7809e8e9",
                                                "text": "Despite spending years studying these toxic dynamics and the better part of a month watching them up close in strangers’ feeds, I was still, like so many, surprised to see it all reflected at the ballot box. We shouldn’t have been surprised; our divisions have been in front of our faces and inside our feeds this whole time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2173c9d2-6b53-3620-bb29-adbee50b6c08",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "A straight man who delivers lines to the comedian during a performance."
