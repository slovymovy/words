                                    }
                                ]
                            },
                            {
                                "target_word": "ear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "268c0738-6ea4-363b-a857-cb346c66b1b5",
                                        "entry_id": "8acb8578-5c1a-3342-b6bd-253f29c7e833",
                                        "glosses": [
                                            "To take in with the ears; to hear."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c25d33-d6ce-4aa9-be13-72c18e9e8490",
                                                "sense_id": "268c0738-6ea4-363b-a857-cb346c66b1b5",
                                                "text": "I eared her language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26b51520-f541-3dba-9031-9367a71b06f9",
                                        "entry_id": "8acb8578-5c1a-3342-b6bd-253f29c7e833",
                                        "glosses": [
                                            "To hold by the ears."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7394e3bf-67b7-4678-923b-8aa21891b9e0",
                                                "sense_id": "26b51520-f541-3dba-9031-9367a71b06f9",
                                                "text": "Sometimes, the helper eared the horse down; and sometimes he used a blindfold."
                                            },
                                            {
                                                "example_id": "de343ab0-6f07-40b7-a04f-735840ef205d",
                                                "sense_id": "26b51520-f541-3dba-9031-9367a71b06f9",
                                                "text": "The general technique was to rope the horse around the neck, and, while one or two men eared the horse down (held him by the ears), the rider saddled the animal and stepped above him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ear",
                                "target_lang_code": "en",
