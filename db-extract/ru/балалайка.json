                                        "sense_id": "4e8fc8f8-7137-311f-9982-06ade83661be",
                                        "entry_id": "596f57e8-b0af-3887-a052-0bcf3ab4056e",
                                        "glosses": [
                                            "strumento cordofono a corde pizzicate originario della Russia, ha la forma di un liuto con la cassa triangolare, una lunga tastiera dove sono tese tre corde: due delle quali all'unisono"
                                        ],
