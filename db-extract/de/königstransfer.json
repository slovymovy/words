                "senses": [
                    {
                        "sense_id": "540219d1-eeab-3ff5-a3f6-2a329dc2453e",
                        "entry_id": "a62cfef1-fb25-35c9-a112-f84e96acbe36",
                        "glosses": [
                            "Verkauf eines besonders guten Berufssportlers eines Vereins an einen anderen"
                        ],
                        "tags": [
                            "Sport, umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "eb4a5130-830c-4129-a9d6-258034c05a29",
                                "sense_id": "540219d1-eeab-3ff5-a3f6-2a329dc2453e",
                                "text": "„Borussia Dortmund ist zum Duell bereit, salutiert von TV-Experten und Ex-Profis wie Stefan Effenberg, der nicht müde wird, den Wechsel von Ex-Nationalspieler Mats Hummels von München nach Dortmund als Königstransfer zu feiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b56a7c5-526f-3f5e-b7b4-53749eadb884",
                        "entry_id": "a62cfef1-fb25-35c9-a112-f84e96acbe36",
                        "glosses": [
                            "als besonders gut geltender Spieler, der von einem Verein an einen anderen verkauft wurde"
                        ],
                        "tags": [
                            "Sport, umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "cfc55904-946d-48dd-b4a2-2ac2921f429e",
                                "sense_id": "1b56a7c5-526f-3f5e-b7b4-53749eadb884",
                                "text": "„Rechtsverteidiger Schmid ist der einzige neu verpflichtete Profi, der zum Stammspieler aufstieg. Wie Königstransfer Vinzenzo Grifo hat aber auch er bereits eine Freiburger Vergangenheit.“"
                            },
                            {
                                "example_id": "b0dadaf7-9d68-4cab-b8d0-f607c5024bca",
                                "sense_id": "1b56a7c5-526f-3f5e-b7b4-53749eadb884",
                                "text": "„Warum es aber so lange dauerte, bis die Bayern in diesem über drei Monate so zähen Transfersommer erst pünktlich zum Saisonstart dreifachen Vollzug um ihren Königstransfer Coutinho vermelden konnten, lag natürlich auch an der Personalie Leroy Sané.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
