                                        "entry_id": "535a62db-c21c-3012-8d0c-ec3fd5520da3",
                                        "glosses": [
                                            "Government department, at the administrative level normally headed by a minister (or equivalent rank, e.g. secretary of state), who holds it as portfolio, especially in a constitutional monarchy, but also as a polity"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76deb7fe-69ed-4a2a-a6fd-8cc23e3ddc41",
                                                "sense_id": "b44fec5b-8bdc-33ad-b658-ca9b78ffcc2f",
                                                "text": "She works for the ministry of finance."
                                            },
                                            {
                                                "example_id": "6569d90e-1c79-4f64-aa20-5c2c3c768346",
                                                "sense_id": "b44fec5b-8bdc-33ad-b658-ca9b78ffcc2f",
                                                "text": "He works for the ministry of defence."
                                            },
                                            {
                                                "example_id": "b2a44dac-d56b-474b-9508-8ce7b450cb08",
                                                "sense_id": "b44fec5b-8bdc-33ad-b658-ca9b78ffcc2f",
                                                "text": "I work for the ministry of education."
                                            },
                                            {
                                                "example_id": "87416a4b-b332-41cc-ade7-1c303f796b7b",
                                                "sense_id": "b44fec5b-8bdc-33ad-b658-ca9b78ffcc2f",
                                                "text": "They work for the ministry of agriculture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e116a290-714c-312d-ac6c-50f03f2c21bd",
                                        "entry_id": "535a62db-c21c-3012-8d0c-ec3fd5520da3",
                                        "glosses": [
                                            "The complete body of government ministers (whether or not they are in cabinet) under the leadership of a head of government (such as a prime minister)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3cbc553-9c79-4ba5-975f-22a541e107ce",
                                                "sense_id": "e116a290-714c-312d-ac6c-50f03f2c21bd",
                                                "text": "The premier offered his last ministry's resignation to the monarch, and is asked to form a new one in accordance with the election results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c82ee69-a04a-3982-a01d-2d40215a4441",
                                        "entry_id": "535a62db-c21c-3012-8d0c-ec3fd5520da3",
                                        "glosses": [
                                            "A ministration"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48328dfb-e269-3ac0-81e1-bf33696f6419",
                                        "entry_id": "535a62db-c21c-3012-8d0c-ec3fd5520da3",
                                        "glosses": [
                                            "The active practice and education of the minister of a particular religion or faith."
                                        ],
