                "senses": [
                    {
                        "sense_id": "eee8ed7c-4a97-3879-ae32-c43b0077485d",
                        "entry_id": "9ee03113-247d-3956-a9a0-9829bbacf432",
                        "glosses": [
                            "Danser un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d253cbac-7f72-47cd-8269-615bf07dfca3",
                                "sense_id": "eee8ed7c-4a97-3879-ae32-c43b0077485d",
                                "text": "L’obstruction en forme de clapet est la plus ennuyeuse pour le service, car elle fait dansiller la flamme de front avec le mouvement du clapet, exposé aux fluctuations de la pression du gaz."
                            },
                            {
                                "example_id": "b8c6ecca-a874-4235-8b9d-23d082b79852",
                                "sense_id": "eee8ed7c-4a97-3879-ae32-c43b0077485d",
                                "text": "Il vous voyait d’abord sourire à la mégère qui se frottait les mains et dansillait sur place pour se réchauffer, tendre des pièces de monnaie et saisir ensuite de deux doigts quelques tiges ficelées."
                            },
                            {
                                "example_id": "e8525d40-9568-4c64-bf7c-256d4f7398fb",
                                "sense_id": "eee8ed7c-4a97-3879-ae32-c43b0077485d",
                                "text": "Ou, si je puis me permettre, elle semble dansoter, comme on toussote ; ou dansiller, comme on sautille ; ou dansonner, comme on chantonne."
                            }
                        ]
                    }
                ],
