                "senses": [
                    {
                        "sense_id": "0c4c20a2-0ecc-3aa6-ac53-7cfd9bc7e091",
                        "entry_id": "b2c1bf37-cad7-37c7-bedb-d2c4a891a4c9",
                        "glosses": [
                            "Illustration insérée dans un volume sur une page séparée."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "df516fe1-9567-4970-99f3-20d3003f8d8b",
                                "sense_id": "0c4c20a2-0ecc-3aa6-ac53-7cfd9bc7e091",
                                "text": "La mention de ceux-ci est elle-même peu courante dans ce type d'ouvrages. L'un des hors-texte est en effet signé « Ab. Girardet del. - Ch. SI. Girardet sculp. ». Il s'agit donc d'Abraham et de Charles-Samuel, tous deux fils de Samuel père."
                            },
                            {
                                "example_id": "06e92ca6-1af5-49ac-916e-84107c8051c9",
                                "sense_id": "0c4c20a2-0ecc-3aa6-ac53-7cfd9bc7e091",
                                "text": "Le premier plan est, lui, une anti-image: il présente un hors-texte à caractère profane, en utilisant les moyens d'un « art autre »."
                            },
                            {
                                "example_id": "44c8632d-28ed-47d4-8615-aaadfa40e283",
                                "sense_id": "0c4c20a2-0ecc-3aa6-ac53-7cfd9bc7e091",
                                "text": "Le livre de Lionel Groulx, Correspondance 1894-1967, contient des hors-textes répertoriés et inscrits à la table des matières sous le titre Illustrations."
                            }
                        ]
                    }
                ],
