                "senses": [
                    {
                        "sense_id": "6c7cf65c-7f2b-30d8-b3a1-1060d04e7ef5",
                        "entry_id": "35a75099-cd2b-39e0-a68e-2cb596c4cd47",
                        "glosses": [
                            "разг. скребя, удалить, счистить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cc0484-d4ae-42b0-bb12-60290853c1e7",
                                "sense_id": "6c7cf65c-7f2b-30d8-b3a1-1060d04e7ef5",
                                "text": "Солнце грело, трава, оживая, росла и зеленела везде, где только не соскребли её〈…〉"
                            }
                        ]
                    },
                    {
                        "sense_id": "f62c1328-9f38-354e-adc7-27ae0c25f6cd",
                        "entry_id": "35a75099-cd2b-39e0-a68e-2cb596c4cd47",
                        "glosses": [
                            "разг. собрать скребком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf1d3cc-b9a2-4b26-bbf8-12495be98b3d",
                                "sense_id": "f62c1328-9f38-354e-adc7-27ae0c25f6cd",
                                "text": "На улицу вышел фельдшер Винокуров с железным измятым ведром, со скребком, посыпал лужу крови золою, соскрёб её снова в ведро."
                            }
                        ]
                    }
                ],
