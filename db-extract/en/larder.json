                    {
                        "translation_id": "db81c16d-4052-4a8b-9075-dc0836ede357",
                        "source_entry_id": "d84ebe2b-7f9b-3edf-ab3b-9177f763edb7",
                        "source_sense_description": "cool room used as food storage",
                        "target_lang_word": "Kühlraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühlraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b2fa0f8-ba69-3f02-aec0-33f79a8732fd",
                                        "entry_id": "ee8181eb-62e4-3313-bea7-5f9f33fb3069",
                                        "glosses": [
                                            "mit Kühltechnik ausgestatteter Raum, in dem Lebensmittel aufbewahrt werden"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7225686c-b56c-482a-940a-bdae812b1fc0",
                                                "sense_id": "9b2fa0f8-ba69-3f02-aec0-33f79a8732fd",
                                                "text": "In einem Kühlraum, zum Beispiel in einem Restaurant, werden frische Lebensmittel wie Obst, Gemüse, Pilze, Fleisch usw. bei Temperaturen zwischen +10 °C und −18 °C vorübergehend, bis zum alsbaldigen Verzehr, aufbewahrt."
                                            },
                                            {
                                                "example_id": "6443d41f-97d3-4aec-83c3-68c4bcdd311b",
                                                "sense_id": "9b2fa0f8-ba69-3f02-aec0-33f79a8732fd",
                                                "text": "„Die Haltbarkeit von Lebensmitteln wird durch Kühlung deutlich verlängert. Daher sind in allen Lebensmittelbereichen Kühlräume vorhanden.“"
                                            },
                                            {
                                                "example_id": "2dd44930-3f57-47a9-ace9-1bd0530a2cde",
                                                "sense_id": "9b2fa0f8-ba69-3f02-aec0-33f79a8732fd",
                                                "text": "„Er hatte mehrere Stunden in einem Kühlraum verbracht, weil er seine Nase in die Angelegenheiten fremder Leute gesteckt hatte.“"
                                            },
                                            {
                                                "example_id": "4739136a-620a-49b9-be6b-a85253883d89",
                                                "sense_id": "9b2fa0f8-ba69-3f02-aec0-33f79a8732fd",
                                                "text": "„Bundschuh trug sogar im Sommer lange Unterhosen und halbhohe warm gefütterte Schuhe, wahrscheinlich weil er als Metzger in der LATSCHA-Filiale in Sprendlingen angestellt war und sich oft im Kühlraum aufhalten mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dce239ce-6d4a-4e9d-a7cd-6c2ef1428226",
                        "source_entry_id": "d84ebe2b-7f9b-3edf-ab3b-9177f763edb7",
                        "source_sense_description": "cool room used as food storage",
                        "target_lang_word": "Speisekammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisekammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                        "entry_id": "d00e1c14-b802-361d-a4f2-4b9647ef4aa4",
                                        "glosses": [
                                            "ein kleiner und kühler Raum, in dem Lebensmittel aufbewahrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846e1f2b-9a33-4f15-b2de-676143e79587",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "Die Speisekammer sollte trocken und eher kühl sein."
                                            },
                                            {
                                                "example_id": "6849e17a-d37a-4df6-aabf-cafe639c77f3",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Die Speisekammer eines Flugzeuges war geräumiger.“"
                                            },
                                            {
                                                "example_id": "ae3552a9-2ae2-4e6f-ba0b-6620ad99fe2f",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Vasen standen in der Speisekammer.“"
                                            },
                                            {
                                                "example_id": "d7b53b64-40b7-49c8-8cfa-c24fabe0b780",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Erich Snider riß die Tür zur Speisekammer auf, wies auf die gefüllten, übervollen Regale.“"
                                            },
                                            {
                                                "example_id": "64b7b4bd-a1ce-4085-bd34-29d3e5750601",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Minnas Teller ist längst leer, und nun stöbert Willy Jensen in der Speisekammer herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
