                                        "sense_id": "c8c9e24a-d983-3248-8ad0-2c966639181f",
                                        "entry_id": "204a8b4a-99dd-38c7-bdd2-474452bbd776",
                                        "glosses": [
                                            "benaming voor bloeiende planten uit het geslacht Zinnia"
                                        ],
                                        "tags": [],
