    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "827bb6e4-c0da-3dfb-a60b-dd140c25261a",
                "word": "moue",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "745260c7-2d56-42af-a8b0-8f59cbe8f2b9",
                        "entry_id": "827bb6e4-c0da-3dfb-a60b-dd140c25261a",
                        "tags": [
                            "plural"
                        ],
                        "form": "moues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                        "entry_id": "827bb6e4-c0da-3dfb-a60b-dd140c25261a",
                        "glosses": [
                            "A pout, especially as expressing mock-annoyance or flirtatiousness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2a978d-7751-40c1-93a0-703fdb9a886a",
                                "sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                                "text": "[S]he looked at her face and made a moue in the glass; and never stopped for Laura’s answer to the questions which she had put."
                            },
                            {
                                "example_id": "720c88a4-2b31-46f4-9803-93ce94c79f77",
                                "sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                                "text": "She glanced aside to the rim of the looking-glass where his photograph was wedged, shuddered, and made a moue of distaste."
                            },
                            {
                                "example_id": "43930ac7-b6ad-45d8-a238-e9adc3546852",
                                "sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                                "text": "She made what I believe, though I wouldn't swear to it, is called a moue. Putting the lips together and shoving them out, if you know what I mean. The impression I got was that she was disappointed in Bertram, having expected better things […]."
                            },
                            {
                                "example_id": "057bceda-f107-4864-92ee-e244816f517c",
                                "sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                                "text": "Why do you wear European clothes?\" fumed Oscar de la Renta with a moue of disapproval and stamp of his bejewelled foot (probably)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39adbe68-da1c-4017-afa9-8bb8ae7434c6",
                        "source_entry_id": "827bb6e4-c0da-3dfb-a60b-dd140c25261a",
                        "source_sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                        "source_sense_description": "pout — see also pout",
                        "target_lang_word": "moue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                        "entry_id": "70e2338c-5aa6-31f1-9cf7-fcc38b7ead5f",
                                        "glosses": [
                                            "Grimace que l’on fait en rapprochant et en allongeant les lèvres, en signe de dérision ou de mécontentement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab576c1-a319-4a48-abfb-06b9f2c0a191",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Vos deux lèvres s’allongent comme si vous faisiez la moue : d’où vient que si vous la voulez faire à quelqu’un, et vous moquer de lui, vous ne sauriez lui dire que : U."
                                            },
                                            {
                                                "example_id": "98f6c998-5752-4ddd-8aa4-b2ac1f83b836",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Quand on lui demandait son avis, il répétait poliment l’opinion de la majorité. Rien ne parvint à lasser sa patience, ni les rêves creux du marquis qui parlait des Bourbons comme au lendemain de 1815, ni les effusions bourgeoises de Roudier, qui s’attendrissait en comptant le nombre de paires de chaussettes qu’il avait fournies jadis au roi citoyen. Au contraire, il paraissait fort à l’aise au milieu de cette tour de Babel. Parfois, quand tous ces grotesques tapaient à bras raccourcis sur la République, on voyait ses yeux rire sans que ses lèvres perdissent leur moue d’homme grave."
                                            },
                                            {
                                                "example_id": "5ec5e400-8bb5-4bc9-a84c-68dec4734f21",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Elle le regarda avec une moue un peu moqueuse qui retroussait ses yeux noirs, et cette expression lui venait de ce qu’elle se savait aimée et qu’elle n’était pas fâchée de l’être et de ce que cette figure-là irrite un amoureux, l’excite à se plaindre, l’induit à se déclarer s’il ne l’a pas encore fait, ce qui était le cas d’Évariste."
                                            },
                                            {
                                                "example_id": "e84feef4-4ed0-4b97-9541-badf619cd5de",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Nazira ne put dissimuler une moue de contrariété. Mais elle cacha adroitement sa pensée."
                                            },
                                            {
                                                "example_id": "a783ceac-cb8b-4ac5-aa4c-189afa3376cd",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Poulouc n’eut qu’une moue pour signifier qu’il n’entendait que couic à ce genre de problème."
                                            },
                                            {
                                                "example_id": "eaf07d81-711b-412d-97b9-3fc2583c58e1",
                                                "sense_id": "b90f5eac-05f7-3f02-9176-4994c432402e",
                                                "text": "Ted Neuville est un « crâne d’œuf » typique, chauve, imberbe et affublé de lunettes, du genre qui, en d’autres temps, aurait servi de modèle à une pub pour un antivirus. Il hausse son absence de sourcils avec une moue désabusée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec4aad0d-63d4-4af1-97b8-ca64962e3eea",
                        "source_entry_id": "827bb6e4-c0da-3dfb-a60b-dd140c25261a",
                        "source_sense_id": "fdba94e7-d980-3096-bb4f-f34250a3fab1",
                        "source_sense_description": "pout — see also pout",
                        "target_lang_word": "Schmollmund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmollmund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                        "entry_id": "e03aa19e-7640-3aee-948c-476943422d39",
                                        "glosses": [
                                            "Mund mit charakteristisch verzogenen Lippen, der den Eindruck vermittelt, als schmolle die betreffende Person; Mund, der in einer sexuell attraktiven Weise verzogen wird"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff93c51-8311-4cbf-aecf-030cca5ddefa",
                                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                                "text": "„Er hatte einen merkwürdigen Schmollmund mit ungläubig vorgeschobener, feuchter Unterlippe, stiere blaue Augen und eine gestrenge, etwas unwillige Art.“"
                                            },
                                            {
                                                "example_id": "6bf56944-b505-4e80-a696-695e9100fde8",
                                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                                "text": "„Unter dem Hashtag #KylieJennerChallenge posten meist junge, moderne Menschen wie Teenie-Modeblogger Brendan Jordan Videos, in denen sie sich selbst einen Schmollmund zaubern.“"
                                            },
                                            {
                                                "example_id": "9431745b-8b81-4307-8305-e9560b29583c",
                                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                                "text": "„Das Aufmacherfoto von einer aktuellen Katastrophe in der Tageszeitung, der Schmollmund des Starlets auf der Fernsehillustrierten und die Fotokollage auf dem Politmagazin – Zeitungen leben von Fotos.“"
                                            },
                                            {
                                                "example_id": "ab91953e-89ae-415b-8821-114b981d5299",
                                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                                "text": "„Die muss in jeder Einstellung mächtig posen und Regisseur Michael Bay ist stets bemüht, ihre Hot-Pants und ihren Schmollmund wirkungsvoll ins Bild zu rücken.“"
                                            },
                                            {
                                                "example_id": "f3aeae11-7e4a-46b1-94ed-3942dc691e41",
                                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                                "text": "„Doch Robben biss sich auf dieselben Lippen, die er in der Vergangenheit bei Nichtberücksichtigungen oder Auswechslungen zu einem solch prallen Schmollmund formte, dass er durchaus als Mick-Jagger-Double hätte arbeiten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
