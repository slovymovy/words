                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5923f870-b75d-4623-a149-3edfb1a5b71d",
                        "source_entry_id": "76209191-1729-3f50-85cd-b77484c6f5dd",
                        "source_sense_description": "belief that one is superior",
                        "target_lang_word": "ješitnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ješitnost",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7a238a-a025-3a15-8c86-9528decf388e",
                                        "entry_id": "d9cae4be-8a25-3798-8145-916e483ca28c",
                                        "glosses": [
                                            "příliš vysoké mínění o svém vzhledu, schopnostech, atd.; vlastnost toho, kdo je ješitný"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ef628a-869c-4203-a2e9-7e7be4b56ad2",
                                                "sense_id": "3a7a238a-a025-3a15-8c86-9528decf388e",
                                                "text": "Neudělala jsem to ale za žádné hnutí. Byla jsem to já, Aneta Petani. Udělala jsem to asi částečně i z ješitnosti, protože hodně lidí říkalo, že se po Piťhově kázání kromě profesora Halíka katolíci neozvali. Z mého pohledu bylo nutné, aby se ozvali i řadoví křesťané."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c65ba2e-8735-498a-883d-f59bc15427af",
