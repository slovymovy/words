                        "examples": [
                            {
                                "example_id": "d1ed6c68-9e1b-41e3-8231-332d5650da51",
                                "sense_id": "2597d7dc-0766-30cf-a340-c6681cd4b495",
                                "text": "Car on aperçoit tout de même, par ci, par là, quelques sarracénies pourpres, la fleur emblème de la province."
                            },
                            {
                                "example_id": "02a1c006-86a4-4d6e-9931-4f115c0b00ad",
                                "sense_id": "2597d7dc-0766-30cf-a340-c6681cd4b495",
                                "text": "Des botanistes du Jardin des plantes de Nantes ont récemment découvert la tendance de la Sarracénie à tuer les frelons asiatiques."
                            },
                            {
                                "example_id": "7e8c276a-f583-469e-86cf-0997fcc658d7",
                                "sense_id": "2597d7dc-0766-30cf-a340-c6681cd4b495",
                                "text": "On ne doit pas demander au chercheur scientifique, comme on ne doit pas demander au poète et à l'artiste, de justifier son existence par des résultats tangibles et pratiques. Autant vaudrait demander à l'hirondelle de défendre la technique de son vol capricieux, et à la sarracénie de nos savanes de justifier le chef-d'oeuvre absurde de sa feuille."
                            }
                        ]
                    }
