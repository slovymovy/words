                "senses": [
                    {
                        "sense_id": "ecbe922a-305e-3819-8480-84f0134e1b3e",
                        "entry_id": "1dc0835c-9015-3bd3-9dea-441bd87690b4",
                        "glosses": [
                            "ein zu dünnen Platten ausgewalztes Aluminium mit darin symmetrisch eingestanzten Löchern, in runder oder eckiger Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38e678d-f985-4f53-9859-e6e0c22f23ca",
                                "sense_id": "ecbe922a-305e-3819-8480-84f0134e1b3e",
                                "text": "„Alte Holzlatten oder Platten entfernen und neue Aluminiumlochbleche anschrauben, diese Aluminiumbleche sind Pulverbeschichtet die nicht altern, rosten oder ausbleichen.“"
                            },
                            {
                                "example_id": "bdbc733a-e3c9-4256-8f41-973915d3ad19",
                                "sense_id": "ecbe922a-305e-3819-8480-84f0134e1b3e",
                                "text": "„Faltschiebeläden aus Aluminiumlochblech fungieren hier als Sonnenschutz und generieren ein abwechslungsreiches Fassadenspiel.“"
                            },
                            {
                                "example_id": "422a17d4-4d8d-4c0a-a055-9bed2eb4e98a",
                                "sense_id": "ecbe922a-305e-3819-8480-84f0134e1b3e",
                                "text": "„Das eloxierte Aluminiumlochblech beziehungsweise -glattblech ist mehr als eine Alternative zum verzinkten Stahllochblech.“"
                            },
                            {
                                "example_id": "b9767949-6522-4551-8dbe-aacf7eb73162",
                                "sense_id": "ecbe922a-305e-3819-8480-84f0134e1b3e",
                                "text": "„Nach eigener Erfahrung läuft Flüssigkeit auf dem altbewährten Aluminiumlochblech mit 2mm Löchern schlechter ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
