{
    "word_family": [
        "clumpy",
        "clumpiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89c81080-92c8-361a-b3a0-a65347504c74",
                    "sense_definition": "A cluster or unshaped mass of material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry soil formed a hard <w>clump</w> in the middle of the garden.",
                            "target_lang_translations": {
                                "zh": "干燥的土壤在花园中间形成了一个坚硬的<w>团</w>。"
                            }
                        },
                        {
                            "text": "She found a <w>clump</w> of mud stuck to her shoe after the walk.",
                            "target_lang_translations": {
                                "zh": "散步后，她发现鞋子上粘着一<w>块</w>泥。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "lump",
                        "mass"
                    ],
                    "common_phrases": [
                        "clump of mud"
                    ],
                    "target_lang_definitions": {
                        "zh": "物质形成的团块或堆积物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "团",
                                "target_lang_sense_clarification": "指成团的物质"
                            },
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "指成块的物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20984fa1-d94d-340e-b235-2d0912f4cf2b",
                    "sense_definition": "A thick group or bunch of plants or hair.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat under a large <w>clump</w> of trees to escape the sun.",
                            "target_lang_translations": {
                                "zh": "我们坐在大<w>丛</w>树下躲避阳光。"
                            }
                        },
                        {
                            "text": "A small <w>clump</w> of flowers grew near the old stone wall.",
                            "target_lang_translations": {
                                "zh": "老石墙边长着一<w>簇</w>小花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bunch",
                        "cluster",
                        "thicket"
                    ],
                    "common_phrases": [
                        "clump of trees"
                    ],
                    "target_lang_definitions": {
                        "zh": "植物或毛发的丛或簇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丛",
                                "target_lang_sense_clarification": "指聚集在一起的植物"
                            },
                            {
                                "target_lang_word": "簇",
                                "target_lang_sense_clarification": "指聚集在一起的毛发或花朵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b10158b-7f71-3647-96bd-4f12291a95c4",
                    "sense_definition": "A dull, heavy sound of impact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy book hit the floor with a loud <w>clump</w>.",
                            "target_lang_translations": {
                                "zh": "那本厚重的书掉在地上，发出<w>咚</w>的一声。"
                            }
                        },
                        {
                            "text": "I heard the <w>clump</w> of boots walking down the hallway.",
                            "target_lang_translations": {
                                "zh": "我听见走廊里传来靴子<w>咚咚</w>的脚步声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thud",
                        "thump"
                    ],
                    "target_lang_definitions": {
                        "zh": "沉重而沉闷的撞击声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咚",
                                "target_lang_sense_clarification": "拟声词，形容沉重的撞击声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5146b5-a3b1-348f-a144-1873fafdca93",
                    "sense_definition": "A thick piece added to the sole of a shoe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shoe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler added a leather <w>clump</w> to the worn-out sole.",
                            "target_lang_translations": {
                                "zh": "鞋匠在磨损的鞋底上加了一块皮革<w>鞋掌</w>。"
                            }
                        },
                        {
                            "text": "These boots have a thick <w>clump</w> for better grip on ice.",
                            "target_lang_translations": {
                                "zh": "这些靴子有厚实的<w>鞋掌</w>，在冰面上抓地力更好。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "加在鞋底上的厚垫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鞋掌",
                                "target_lang_sense_clarification": "指修补鞋底用的厚垫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "976eedd2-8796-3799-9a5a-e0a389d587e1",
                    "sense_definition": "Compressed clay found in coal strata.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners encountered a layer of <w>clump</w> while digging.",
                            "target_lang_translations": {
                                "zh": "矿工在挖掘时遇到了一层<w>硬粘土</w>。"
                            }
                        },
                        {
                            "text": "The <w>clump</w> was removed before the coal could be extracted.",
                            "target_lang_translations": {
                                "zh": "在开采煤炭之前，这层<w>硬粘土</w>被移除了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "煤层中发现的压缩粘土。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "硬粘土",
                                "target_lang_sense_clarification": "地质学中指煤层间的压缩粘土"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97905510-fc37-3f99-b54a-dc5f151871ac",
                    "sense_definition": "To gather together in dense groups.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students began to <w>clump</w> together near the entrance.",
                            "target_lang_translations": {
                                "zh": "学生们开始在入口附近<w>聚集</w>起来。"
                            }
                        },
                        {
                            "text": "Sheep often <w>clump</w> in the corner of the field during storms.",
                            "target_lang_translations": {
                                "zh": "暴风雨期间，羊群经常在田野的角落里<w>聚拢</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "gather",
                        "bunch"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "target_lang_definitions": {
                        "zh": "聚集在一起形成密集的群体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "指人或动物聚在一起"
                            },
                            {
                                "target_lang_word": "聚拢",
                                "target_lang_sense_clarification": "指物体或群体向中心靠拢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1ed83c7-97d6-3b26-bd4b-1dbce536deb8",
                    "sense_definition": "To walk with heavy, noisy footfalls.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>clump</w> up the wooden stairs in his heavy boots.",
                            "target_lang_translations": {
                                "zh": "他穿着沉重的靴子，<w>重重地走</w>上了木楼梯。"
                            }
                        },
                        {
                            "text": "The giant began to <w>clump</w> across the floor.",
                            "target_lang_translations": {
                                "zh": "巨人开始<w>重重地走</w>过地板。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stomp",
                        "trudge"
                    ],
                    "common_phrases": [
                        "clump up stairs"
                    ],
                    "target_lang_definitions": {
                        "zh": "脚步沉重且嘈杂地行走。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重重地走",
                                "target_lang_sense_clarification": "形容脚步沉重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ea9c85-15dd-382a-8356-0465cb52a004",
                    "sense_definition": "To form into clusters or lumps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flour will <w>clump</w> if you add water too quickly.",
                            "target_lang_translations": {
                                "zh": "如果加水太快，面粉就会<w>结块</w>。"
                            }
                        },
                        {
                            "text": "Stir the sauce constantly so the ingredients do not <w>clump</w>.",
                            "target_lang_translations": {
                                "zh": "不断搅拌酱汁，以免配料<w>结块</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulate",
                        "congeal"
                    ],
                    "target_lang_definitions": {
                        "zh": "形成团块或凝结在一起。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结块",
                                "target_lang_sense_clarification": "指粉末或液体凝结成块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c852dd3-9177-3556-ba36-24038252b729",
                    "sense_definition": "To strike or beat someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened to <w>clump</w> him if he did not leave.",
                            "target_lang_translations": {
                                "zh": "那个恶霸威胁说，如果他不离开就<w>猛击</w>他。"
                            }
                        },
                        {
                            "text": "He was angry enough to <w>clump</w> the table with his fist.",
                            "target_lang_translations": {
                                "zh": "他气得用拳头<w>猛击</w>桌子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "strike",
                        "thump"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "击打或殴打某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "指用力击打"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}