                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4d5150-935b-332a-b85f-f83656bbadbe",
                                        "entry_id": "c758f0b5-57b0-37ef-8939-9879914993bf",
