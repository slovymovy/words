                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ee4fc8-4389-403b-b7ce-4ac09f1e8897",
                                "sense_id": "6f72e5fb-031f-3e74-9831-6becc5ac3c87",
                                "text": "„Ein anderer Zahnarzt will für eine Totalprothese oben 1307 Mark - 320 Mark zufiel!“"
                            },
                            {
                                "example_id": "a9119cf0-7d4f-47f8-85f0-9a0ee4e4c185",
                                "sense_id": "6f72e5fb-031f-3e74-9831-6becc5ac3c87",
                                "text": "„Eine Totalprothese saugt sich dazu am Gaumen fest.“"
                            },
                            {
                                "example_id": "ea87a02c-a866-473a-8257-bb57f1bcc469",
                                "sense_id": "6f72e5fb-031f-3e74-9831-6becc5ac3c87",
                                "text": "„Geringfügig günstiger werden auch Totalprothesen.“"
                            }
                        ],
