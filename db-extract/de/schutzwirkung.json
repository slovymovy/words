                "senses": [
                    {
                        "sense_id": "96859c24-6db9-3dbb-8923-d6056ce67abe",
                        "entry_id": "f30114fe-f458-3dd3-8c31-991efb19e43c",
                        "glosses": [
                            "Effekt (Wirkung, Wirksamkeit), den eine Maßnahme hat, die vor etwas bewahren (schützen) soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f085fda-47d7-4bcb-ab71-f49bc78b4b62",
                                "sense_id": "96859c24-6db9-3dbb-8923-d6056ce67abe",
                                "text": "„Sogenannte „intelligente\" Rückhaltesysteme, bestehend aus Gurtstraffern, Airbags und einer auf diese Systeme abgestimmten Sensorik steigern die Qualität der Schutzwirkung dieser Systeme.“"
                            },
                            {
                                "example_id": "4635a48d-ab52-4211-b87b-8202a27f4439",
                                "sense_id": "96859c24-6db9-3dbb-8923-d6056ce67abe",
                                "text": "Bei den meisten Impfungen ist die Schutzwirkung zeitlich begrenzt."
                            },
                            {
                                "example_id": "b290a99f-eac2-40ea-a496-33a60ceea135",
                                "sense_id": "96859c24-6db9-3dbb-8923-d6056ce67abe",
                                "text": "„Je näher die Schutzwirkung eines Impfstoffes an die 100 Prozent heranreicht, desto besser - klar.“"
                            },
                            {
                                "example_id": "9882ffb5-ccc2-4865-bfd9-7586bbc1c385",
                                "sense_id": "96859c24-6db9-3dbb-8923-d6056ce67abe",
                                "text": "[COVID-19-Impfung:] „Sollte sich die über 90-prozentige Schutzwirkung bestätigen, wäre das besser als alles, was man zu hoffen gewagt hat […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
