                    },
                    {
                        "translation_id": "7fb12c94-c0c3-499b-883f-991f4a99dc8d",
                        "source_entry_id": "395a3958-965c-3233-97f1-9f4027fca8f8",
                        "source_sense_description": "действие",
                        "target_lang_word": "dazzling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dazzling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e349a38-2b2a-31a9-9782-28947dde0389",
                                        "entry_id": "c138767a-2472-3573-a314-7b872157ee28",
                                        "glosses": [
                                            "present participle and gerund of dazzle"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dazzling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                                        "entry_id": "dfe5d97a-32f8-37c2-bebc-723de3393bf4",
                                        "glosses": [
                                            "Extremely bright, especially so as to blind the eyes temporarily; bright to the degree that dazzles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c88951a-ae6d-42b3-8131-5b1c26ac6571",
                                                "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                                                "text": "[H]is ſupercilious glances grevv humbled, yea, his dazeling ſplendor (eclipſt in the ſetting [i.e., death] of his Maſter) becomes quickly darkned: […]"
                                            },
                                            {
                                                "example_id": "080748c0-20bb-4c34-acf0-dabe29e201e6",
                                                "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                                                "text": "There is something in intense suffering that seeks concealment, something that is fain to belie itself. In Cooper's novel of the \"Bravo,\" Jacques conceals himself and his boat, by lying where the moonlight fell dazzling on the water. We do the same with any great despair, we shroud it in a glittering atmosphere of smiles and jests; but the smiles are sneers, and the jests are sarcasms."
                                            },
                                            {
                                                "example_id": "9c51c0e7-61c9-4829-867d-b09520d2c33d",
                                                "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                                                "text": "The deafening claps of thunder and the dazzling flashes of lightning which lit up the ghastly scene testified that the artillery of heaven had lent its supernatural pomp to the already gruesome spectacle."
                                            },
                                            {
                                                "example_id": "efec1300-23c0-41f2-8f64-59b969c05a6c",
                                                "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                                                "text": "Driving 2-6-2 locomotive No. 4771 Green Arrow, Blunt suddenly noticed that the tunnel mouth was silhouetted in a dazzling white glare and that incendiary bombs were showering down in their hundreds, he slammed on all his brakes and brought his train to a stop just inside the tunnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288f0df6-1d9f-33c7-b22f-9dd64b9a2d0b",
                                        "entry_id": "dfe5d97a-32f8-37c2-bebc-723de3393bf4",
                                        "glosses": [
                                            "Very brilliant or splendid in display; that dazzles the mind of the observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febb5046-398f-4f9a-97fa-b00f7eda39ab",
                                                "sense_id": "288f0df6-1d9f-33c7-b22f-9dd64b9a2d0b",
                                                "text": "Oakland native [Andre] Ward is now unbeaten in 25 fights and can now claim to be one of the top few pound-for-pound fighters on the planet after a technically dazzling display."
                                            }
                                        ]
                                    }
                                ]
                            },
