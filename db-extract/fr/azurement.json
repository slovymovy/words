                "senses": [
                    {
                        "sense_id": "01efe162-d9ee-35db-acbc-161d84741170",
                        "entry_id": "7614ed36-488c-3b66-9c6d-addda3e383a3",
                        "glosses": [
                            "Action d’azurer."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d7a50be-05d8-4514-aae4-e295dfeaf14e",
                                "sense_id": "01efe162-d9ee-35db-acbc-161d84741170",
                                "text": "L’azurement de ces lambris."
                            }
                        ]
                    },
                    {
                        "sense_id": "36fa57fb-2a16-3d4f-8022-a6073b46d217",
                        "entry_id": "7614ed36-488c-3b66-9c6d-addda3e383a3",
                        "glosses": [
                            "État de ce qui est azuré."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b6045bf7-42b1-435f-9267-0219bc1d03d8",
                                "sense_id": "36fa57fb-2a16-3d4f-8022-a6073b46d217",
                                "text": "De grands chantiers de bois dont les piles formaient des dessins symétriques, s'élevaient au bout de la rue des Filles-du-Calvaire, et plus loin, dans l’azurement bleuâtre du lointain, on découvrait le coteau de Ménilmontant."
                            },
                            {
                                "example_id": "7951b432-f7cd-4754-951f-37091566d81d",
                                "sense_id": "36fa57fb-2a16-3d4f-8022-a6073b46d217",
                                "text": "On aurait dit l’enveloppement des murs par une étoffe inconnue, où l’azurement d’un léger bleu d’empois se répandait dans une teinte café au lait, une étoffe brillantée du plus joli et du plus harmonieux éclairage aux lampes, et cela dans le détachement, le relief du point brodé, et qui était d’un effet tout particulier."
                            },
                            {
                                "example_id": "9d32f94d-2edb-4264-9d41-7b6f3bf025d8",
                                "sense_id": "36fa57fb-2a16-3d4f-8022-a6073b46d217",
                                "text": "A travers la masse frissonnante et diversement verdâtre des grands arbres, ils aperçurent confusément de vastes tapis de tendre verdure, […] et enfin, dans le vague azurement du lointain, la lanterne violâtre du belvédère."
                            }
                        ]
                    }
