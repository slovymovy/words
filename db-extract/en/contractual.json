                                        "glosses": [
                                            "Relatif au contrat, qui est stipulé par contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3706632f-0be1-49ad-9c52-103a9aa27599",
                                                "sense_id": "4f0b20c9-a893-3953-8098-edf757022538",
                                                "text": "Nos obligations contractuelles sont lourdes."
