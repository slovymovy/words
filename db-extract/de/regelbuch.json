                                    {
                                        "sense_id": "116947dd-3ee3-322a-805a-008882fc8938",
                                        "entry_id": "1839a40e-da2b-32e4-a9f0-df04074afc4d",
                                        "glosses": [
                                            "A book containing a set of rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e0fa4e-1b00-4417-970c-c85f4b596aa5",
                                                "sense_id": "116947dd-3ee3-322a-805a-008882fc8938",
                                                "text": "In our rapidly changing business environment, rulebooks swiftly become redundant, and businesses must rely on their senior executives to be confident in their decisions."
                                            },
                                            {
                                                "example_id": "9f5d8f70-5bf8-4056-89d6-2ec4471a68b6",
                                                "sense_id": "116947dd-3ee3-322a-805a-008882fc8938",
                                                "text": "The main tool Rogue-likes bring to creating interesting gameplay through randomness is algorithmic complexity far beyond that provided by a few 1D100 tables in the back of the D&D rulebook."
                                            },
                                            {
                                                "example_id": "e06d4ff6-7d5c-4c3f-8a5a-55c3f0236e6b",
                                                "sense_id": "116947dd-3ee3-322a-805a-008882fc8938",
                                                "text": "The ATP rulebook defines unsportsmanlike conduct as “any misconduct by a player that is clearly abusive or detrimental to the success of a tournament, ATP and/or the sport” and carries a fine of up to $20,000."
                                            }
                                        ]
                                    }
