                ],
                "senses": [
                    {
                        "sense_id": "6e54b9f2-88c4-315f-9bcd-36c98fc22777",
                        "entry_id": "85b73751-6d43-3714-bff0-3ebcd72b2826",
                        "glosses": [
                            "von der Politik (einzelnen Politikern) über die Medien verbreitet; oft mit der Betonung, dass es nunmehr kaum um Sachfragen geht, sondern um den Effekt, den eine breite Streuung durch Informationsmedien nach sich zieht; von Politikern und Medien zur Effekthascherei und Manipulation genutzt"
                        ],
                        "tags": [
                            "auch polemisch"
                        ],
                        "examples": [
                            {
                                "example_id": "fe4ecd07-1101-4f10-83b8-8e6eb03fa6d9",
                                "sense_id": "6e54b9f2-88c4-315f-9bcd-36c98fc22777",
                                "text": "„Bei einem nennenswerten Teil der Bevölkerung steht der politmediale Komplex unter Generalverdacht.“"
                            },
                            {
                                "example_id": "d4129c21-d52f-4cd5-8a27-9382bfa5a39d",
                                "sense_id": "6e54b9f2-88c4-315f-9bcd-36c98fc22777",
                                "text": "„Es ist höchste Zeit, die politmediale Schlammschlacht zu beenden, die zwischen Griechenland und Deutschland tobt.“"
                            },
                            {
                                "example_id": "cc40d532-9cfc-467c-a631-ee3cdd0989d8",
                                "sense_id": "6e54b9f2-88c4-315f-9bcd-36c98fc22777",
                                "text": "„Frau Grütters verübte einen Verzweiflungsakt satirischer Subversion, um die politmediale Stilisierung der gütigen, über allem schwebenden Regentin zu karikieren.“"
                            },
                            {
                                "example_id": "4a3f14eb-2e2c-4dff-b89c-73cac8e71e5e",
                                "sense_id": "6e54b9f2-88c4-315f-9bcd-36c98fc22777",
                                "text": "„Im politmedialen Betrieb wird ein bemerkenswertes Schauspiel aufgeführt. Grund ist die Kapitalismuskritik des Juso-Vorsitzenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
