                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab1deaa4-ac64-3f8b-b38d-706490e96ec9",
                        "entry_id": "11966a86-aa0b-3a17-8f39-01f3e7fe8773",
                        "glosses": [
                            "eine Haustaubenrasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fc6f58-fe12-4e9b-ac3b-0e1c5a9d3455",
                                "sense_id": "ab1deaa4-ac64-3f8b-b38d-706490e96ec9",
                                "text": "„Auch der Vereinsvorsitzende Gerd Reichenbach kann auf seine roten Mährischen Strasser (Tauben) stolz sein, die von den Preisrichtern ebenfalls mit der Note \"Vorzüglich\" bewertet worden waren.“"
                            },
                            {
                                "example_id": "b4c3f631-87ac-424a-84ae-6f087e9d45ca",
                                "sense_id": "ab1deaa4-ac64-3f8b-b38d-706490e96ec9",
                                "text": "„Auf der anderen Seite sind die verbliebenen Mährischen Strasser und die bisherigen weißen Tauben untergebracht.“"
                            },
                            {
                                "example_id": "a30b01b7-4bb5-45cc-a829-9ddc3767036e",
                                "sense_id": "ab1deaa4-ac64-3f8b-b38d-706490e96ec9",
                                "text": "„Sie präsentiert hier die Sieger-Taube der Rasse ‚Strasser‘.“"
                            },
                            {
                                "example_id": "a39352a2-3bc7-4771-9592-85969cc28d51",
                                "sense_id": "ab1deaa4-ac64-3f8b-b38d-706490e96ec9",
                                "text": "„Mit 350 Hühnern und Tauben zeigen sich seine Strasser am Wochenende in Jork von ihrer schönsten Seite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
