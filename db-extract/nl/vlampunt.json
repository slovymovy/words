                                        "examples": [
                                            {
                                                "example_id": "91ead0c0-a223-42cd-95a4-f2057fbf6024",
                                                "sense_id": "e12365b5-1d8d-38a0-a3ca-c2a8dd13e6b5",
                                                "text": "Chances came and went at both ends before the flashpoint involving Vardy and Nasri, who took an age to leave the pitch after Daniele Orsato, the Italian referee, brandished a red card."
                                            },
                                            {
                                                "example_id": "f019e65b-07b9-4edd-9920-7e0148da237f",
                                                "sense_id": "e12365b5-1d8d-38a0-a3ca-c2a8dd13e6b5",
                                                "text": "In a match which contained several flashpoints in the crowd, including loud jeering when England's players took the knee before kick-off, objects being thrown and racist chanting, they came through a mediocre first half to take total control after the break and run out easy winners."
                                            }
                                        ]
                                    }
                                ]
                            }
