        "fr-extract.jsonl": [
            {
                "entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                "word": "mendigot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c110d06-627e-49b7-a53c-68f35d0a4a75",
                        "entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                        "tags": [
                            "plural"
                        ],
                        "form": "mendigots"
                    },
                    {
                        "form_id": "9e81ad98-c40a-4fa7-b5ec-28d2e4d19aaa",
                        "entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                        "tags": [
                            "feminine"
                        ],
                        "form": "mendigote"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                        "entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                        "glosses": [
                            "Mendiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ff0ee3-eb7e-4142-81c9-5a841c74d60c",
                                "sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                                "text": "L’étranger, arrivant au chef-lieu du plus riche département de France et s’y voyant accueilli par des séquelles de mendigots d’origine caravanière, se demande à quoi pense, chez nous, l’élite dirigeante."
                            },
                            {
                                "example_id": "73376e65-30a8-43bd-a9d3-26962f8291d0",
                                "sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                                "text": "Vous sentiez des gens collants et tenaces, des mendigots de privilèges et de faveurs, à qui il ne pouvait entrer dans le crâne que M. Jean Erlane soit traité comme le fils d’un de ses fermiers !…"
                            },
                            {
                                "example_id": "2ac3e4f6-bbf3-46ee-bbe3-55ce4d63916d",
                                "sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                                "text": "Il avait cependant assisté […] à une rafle sur les quais de tous les mendigots et clochards qu’une brigade de flics avait cernés."
                            },
                            {
                                "example_id": "a7a2ef7e-fbb2-434d-8677-368dbd8865f8",
                                "sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                                "text": "Pour témoigner sa joie, elle chanta joyeusement, d’une voix suraiguë, une chanson composée par un agent électoral pour les élections municipales :\nÀ bas Chanot\nCe mendigot\nSans plus attendre\nIl faut le pendre…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d385c037-e069-4134-b912-d964cab9ad23",
                        "source_entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                        "source_sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                        "source_sense_description": "Mendiant",
                        "target_lang_word": "Bettler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "bedürftiger Mensch, der von Almosen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa24032-a9a3-4192-af44-44edcccf1157",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Einen Dritteil der Einwohner machen privilegierte Bettler aus. (Johann Kaspar Riesbeck, Briefe eines reisenden Franzosen über Deutschland, Köln, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "cf0f0235-1bc8-4bc1-9a7f-c2618fc22f32",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Vor dem Eingang zum Bahnhof saß ein Bettler und reckte den Passanten sein handgeschriebenes Schild entgegen."
                                            },
                                            {
                                                "example_id": "4eaaf31b-752e-4e98-8b45-c432f1701636",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Ein Bettler klingelte bei uns.“"
                                            },
                                            {
                                                "example_id": "331a6c2b-0207-439f-a3f1-02a452b209d9",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im jüdischen Viertel gaben sich die Bettler als fromme Juden aus, ließen sich Bärte wachsen, warfen sich in lange schwarze Mäntel und segneten jeden, der ihnen unterkam.“"
                                            },
                                            {
                                                "example_id": "3e65e3fd-58b8-4b45-96ee-6abbc0288f8e",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im September 1930 werden die Vorbereitungen hektischer, Maler streichen viele Fassaden neu, alte Hütten verschwinden hinter Zäunen aus Eukalyptusholz, Bettler und Leprakranke müssen die Stadt verlassen.“"
                                            },
                                            {
                                                "example_id": "addd2b6b-5489-4cf3-85f9-53d712185490",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "dringlich Bittender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e790904a-08eb-4478-9c9e-8ce5edf72d1a",
                                                "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                                "text": "Ich stehe hier als Bittsteller und Bettler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd8fddb9-b58c-4c73-b567-98098bfa4bab",
                        "source_entry_id": "ef420348-b0c5-3550-b88f-93b75de00657",
                        "source_sense_id": "65331f51-e485-39fc-9eb1-c3c6c208db0c",
                        "source_sense_description": "Mendiant",
                        "target_lang_word": "beggar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beggar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A person who begs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926205e5-52fd-41c4-b113-10bbd42fa6bf",
                                                "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            },
                                            {
                                                "example_id": "6124751d-c4b7-43e7-8e6c-4f5670435b06",
                                                "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                                "text": "Odysseus has returned to his home disguised as a beggar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9395d9ae-6187-3568-9c22-59033e99ce7b",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A person suffering from extreme poverty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514e818e-86ed-4dde-9fbb-67b283bb0107",
                                                "sense_id": "9395d9ae-6187-3568-9c22-59033e99ce7b",
                                                "text": "I'm to be a poor, crawling beggar, sponging for rum, when I might be rolling in a coach!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8067cce7-1ab4-32ad-b5e1-52455d14aea7",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A mean or wretched person; a scoundrel."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "endearing",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07950a43-0f15-4657-a4d3-0668f5da171b",
                                                "sense_id": "8067cce7-1ab4-32ad-b5e1-52455d14aea7",
                                                "text": "What does that silly beggar think he's doing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e45c299-4aec-3741-af0b-422b7af78250",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A minced oath for bugger."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beggar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e32bae4-1ba6-3548-b770-126bc1fadcd7",
                                        "entry_id": "9b0a77e1-ca87-3ee7-9f17-96c8ed32b183",
                                        "glosses": [
                                            "To make a beggar of someone; impoverish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                        "entry_id": "9b0a77e1-ca87-3ee7-9f17-96c8ed32b183",
                                        "glosses": [
                                            "To exhaust the resources of; to outdo or go beyond."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c4659a-da1d-4b96-8272-c04324f808e0",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "`Now,' answered Ayesha, with proud humility - `now when my lord doth speak thus royally and give with so free a hand, it cannot become me to lag behind in words, and be beggared of my generosity.'"
                                            },
                                            {
                                                "example_id": "a5772ead-83c2-4953-870a-75dbbecf1719",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "It was a scene of such beauty it caught all his attention. / Some things beggar likeness, he thought."
                                            },
                                            {
                                                "example_id": "8380af4a-ef98-47a3-b51d-f2547b2c3f99",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "Taking the ontological temperature of today and of the pre-revolutionary 18th century, Mr. Kundera finds that the speed we love has beggared us of pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
