                "senses": [
                    {
                        "sense_id": "42a19701-5930-3b40-a4a0-20633a6d6050",
                        "entry_id": "212aa4db-2fb9-338f-9166-c33a4c0c58fa",
                        "glosses": [
                            "zum Zeichnen verwendete Holzstäbchen, die aus gepresstem Holzkohlepulver bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7177b508-bd6a-41f4-91d9-6528aadc6c15",
                                "sense_id": "42a19701-5930-3b40-a4a0-20633a6d6050",
                                "text": "Mit der Zeichenkohle kann man kontrastreiche und effektvolle Kohlezeichnungen herstellen."
                            },
                            {
                                "example_id": "08c0a5ae-fa84-4562-9c69-fd7222f39d50",
                                "sense_id": "42a19701-5930-3b40-a4a0-20633a6d6050",
                                "text": "Ich verwende Zeichenkohle, um starke strukturierte Tonabstufungen zu erzielen."
                            },
                            {
                                "example_id": "e5ff5af8-cc1f-4df0-8a6b-86e783ee85a3",
                                "sense_id": "42a19701-5930-3b40-a4a0-20633a6d6050",
                                "text": "Da die Zeichenkohle leicht verwischbar ist, sind weiche Übergänge und Schattierungen möglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72f4d9a4-a74c-4286-b640-dbb515320524",
                        "source_entry_id": "212aa4db-2fb9-338f-9166-c33a4c0c58fa",
                        "source_sense_id": "42a19701-5930-3b40-a4a0-20633a6d6050",
                        "source_sense_description": "zum Zeichnen verwendete Holzstäbchen, die aus gepresstem Holzkohlepulver bestehen",
                        "target_lang_word": "charcoal",
