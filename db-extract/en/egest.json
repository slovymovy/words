                    }
                ],
                "translations": [
                    {
                        "translation_id": "cda408c1-bf3c-49b9-ba29-c8d7b5b93a87",
                        "source_entry_id": "6314d411-6bbf-3186-938a-a3e8dd3f6a22",
                        "source_sense_id": "81a7dacb-0d3b-3252-aa33-1d71a12eda22",
                        "source_sense_description": "(Kot) ausleeren, absetzen",
                        "target_lang_word": "ausleeren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausleeren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                        "entry_id": "1811c3f8-da31-32f0-85ae-617435df7ab1",
                                        "glosses": [
                                            "einen Behälter mit Flüssigkeiten oder festen Stoffen vollständig leer machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d2f138-3d24-4bb4-8e32-8c329a373a11",
                                                "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                                "text": "Schafzüchter und Milchbauern auf Sardinien haben aus Protest Milch ausgeleert. Sie fordern höhere Milchpreise."
                                            },
                                            {
                                                "example_id": "bc7f1ecf-d350-4a94-abce-a9f6a5bde6cb",
                                                "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                                "text": "In der Nacht von Montag auf Dienstag haben Unbekannte im Bereich der WB Station Hölstein Süd sowie auf umliegenden Strassen, mutwillig eine grössere Menge Speiseöl ausgeleert."
                                            },
                                            {
                                                "example_id": "f7880006-0ace-4021-b42f-5490920ba12a",
                                                "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                                "text": "Am Äquator konnte man ihn öffnen, um die Späne auszuleeren, was man meist mit einer Schnittwunde bezahlte, denn die Kanten der Hemisphären waren rasiermesserscharf."
                                            },
                                            {
                                                "example_id": "c982d0d2-17ad-46f3-85c6-ce3a5a9f0416",
                                                "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                                "text": "Zugegeben, die Vorstellung behagt nicht jeder Frau: Das eigene Menstruationsblut in einer kleinen Tasse zu sammeln und diese dann auszuleeren ist eine eigenartige Vorstellung."
                                            },
                                            {
                                                "example_id": "a67be3ee-3617-4cb8-b50d-af6950753eb7",
                                                "sense_id": "21e76d60-63a1-32a2-b12c-decf9fda6cf1",
                                                "text": "Wie eine Sprecherin sagte, habe es bislang keine Frauen in der Hauptstadt gegeben, die Mülltonnen ausleerten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8078f95b-f6d0-4123-a8e7-34bc5497a59f",
                        "source_entry_id": "6314d411-6bbf-3186-938a-a3e8dd3f6a22",
                        "source_sense_id": "81a7dacb-0d3b-3252-aa33-1d71a12eda22",
                        "source_sense_description": "(Kot) ausleeren, absetzen",
                        "target_lang_word": "absetzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absetzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "609f4116-bc18-3c65-bc60-e4871c9f48bd",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "eine bestimmte Menge an Ware verkaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "913ca4a4-f5df-46d6-83ff-6bdd39abeb4c",
                                                "sense_id": "609f4116-bc18-3c65-bc60-e4871c9f48bd",
                                                "text": "„Im Fall von Volkswagen, dem größten Hersteller in der Volksrepublik, hieße dies, dass der Konzern bei derzeit etwa drei Millionen verkauften Autos seiner Kernmarke VW bereits im kommenden Jahr rund 60 000 reine Elektrofahrzeuge absetzen müsste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c28e1aab-49f4-3799-ad86-28ee2f647cc3",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "von den Einnahmen bzw. der ermittelten Steuer abziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f67d5ac5-f409-41a4-913e-46583f0620f7",
                                                "sense_id": "c28e1aab-49f4-3799-ad86-28ee2f647cc3",
                                                "text": "„Als Betriebsausgaben oder Werbungskosten darf höchstens jener Betrag abgesetzt werden, der dem arithmetischen Mittel der in den angeführten Kalenderjahren tatsächlich angefallenen Betriebsausgaben oder Werbungskosten entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd2c0c12-ef2b-3899-8a80-5f4dc948a1b7",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "etwas, zum Beispiel einen schweren Gegenstand, den man gerade trägt, hinstellen oder hinlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3357b2-b2fb-41e3-b5f9-ec90ea2ea06a",
                                                "sense_id": "dd2c0c12-ef2b-3899-8a80-5f4dc948a1b7",
                                                "text": "Willst du dein Gepäck nicht endlich absetzen?"
                                            },
                                            {
                                                "example_id": "ddc362ec-987d-4ce6-854b-b7e50579baa7",
                                                "sense_id": "dd2c0c12-ef2b-3899-8a80-5f4dc948a1b7",
                                                "text": "„Sie können aber auch den gewünschten Button in gewohnter Windows-Manier auf das Formular ziehen, dort absetzen und auf die gewünschte Größe zu zoomen.“"
                                            },
                                            {
                                                "example_id": "8776fc94-3fcc-4b71-a344-a440a0dd0f5e",
                                                "sense_id": "dd2c0c12-ef2b-3899-8a80-5f4dc948a1b7",
                                                "text": "„In diesem Falle geht es um das Fingerspitzengefühl, vom Gegenüber zu erreichen, dass die Brille abgesetzt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "85637477-ffab-3c0a-a7d8-8c0dacd1c117",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "aus einer Position oder einem Amt entlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b1f769-b342-48be-bab3-dc1be436e791",
                                                "sense_id": "85637477-ffab-3c0a-a7d8-8c0dacd1c117",
                                                "text": "„[Ludwig II.] habe wohl geahnt, dass er abgesetzt werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "44150386-c11c-33c1-8a7f-e29a74137052",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "(sich) entfernen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1324342-2347-4c9f-ac9f-0255b157ba5e",
                                                "sense_id": "44150386-c11c-33c1-8a7f-e29a74137052",
                                                "text": "„Der Tagesordnungspunkt werde abgesetzt, sagte Bundesratspräsidentin Hannelore Kraft (SPD) in der Länderkammer.“"
                                            },
                                            {
                                                "example_id": "79918ede-9b07-421b-9bee-4a607821fa72",
                                                "sense_id": "44150386-c11c-33c1-8a7f-e29a74137052",
                                                "text": "„»Deshalb hat er sich nach Österreich abgesetzt«, stellte der Chefermittler fest.“"
                                            },
                                            {
                                                "example_id": "df646c32-23ba-43d8-98eb-58766f196bde",
                                                "sense_id": "44150386-c11c-33c1-8a7f-e29a74137052",
                                                "text": "„Er musste ein paar Mal die Feder absetzen, um sich zu beruhigen.“"
                                            },
                                            {
                                                "example_id": "f3716a32-db46-40c0-9792-cd5ec1e11f7f",
                                                "sense_id": "44150386-c11c-33c1-8a7f-e29a74137052",
                                                "text": "„Verbinden Sie die neun Punkte mit drei geraden Linien ohne abzusetzen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "4fc38430-ba66-358a-8fa7-9059c844dca5",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "die Einnahme eines Medikaments, die Aufführung eines kulturellen Ereignisses beenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31270b75-c426-41fb-9c96-b2785ad25184",
                                                "sense_id": "4fc38430-ba66-358a-8fa7-9059c844dca5",
                                                "text": "„So beobachtet das zuständige Beratungszentrum für Embryonaltoxikologie in Berlin, dass Frauen immer wieder unnötigerweise ihre Medikamente absetzen, obwohl sie damit möglicherweise ihre und die Gesundheit des Kindes gefährden.“"
                                            },
                                            {
                                                "example_id": "d86daf3a-52a5-4dd6-999d-8c5b8376aa4d",
                                                "sense_id": "4fc38430-ba66-358a-8fa7-9059c844dca5",
                                                "text": "„An diesem Samstag wurde die Sendung kurzfristig abgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "9db1b2a3-4b35-39c7-a7d5-b7516899002c",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "einen gut erkennbaren Unterschied zur Umgebung vorweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af41a717-cb23-4b5d-9a35-b1ea5db02140",
                                                "sense_id": "9db1b2a3-4b35-39c7-a7d5-b7516899002c",
                                                "text": "„Das Entoderm setzt sich von der Chorda schärfer ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "b05918a6-45fb-3424-8684-c7bb57b0247a",
                                        "entry_id": "6a05efb8-d871-34bf-ac2c-ff99ea51e2ac",
                                        "glosses": [
                                            "zu Boden sinken (lassen)"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2679a369-c33d-468f-b7d8-df2c010f988e",
                                                "sense_id": "b05918a6-45fb-3424-8684-c7bb57b0247a",
                                                "text": "„Die Lösung setzt sich ab, das überstehende Wasser wird dekantiert. “"
                                            },
                                            {
                                                "example_id": "a0b8a187-cee9-414b-b22a-4c3712c2420d",
                                                "sense_id": "b05918a6-45fb-3424-8684-c7bb57b0247a",
                                                "text": "„Wenn man eine kleine Menge Sand in ein Glas mit Wasser gibt und umrührt, beobachtet man, dass sich der Sand nicht löst, sondern er setzt sich am Boden ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
