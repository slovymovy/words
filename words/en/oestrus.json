                    ],
                    "target_lang_definitions": {
                        "ru": "Период половой охоты и способности к оплодотворению у самок млекопитающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течка",
                                "target_lang_sense_clarification": "период половой активности у самок млекопитающих"
                            },
                            {
                                "target_lang_word": "эструс",
                                "target_lang_sense_clarification": "научный термин; течка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b11f07a2-34fd-3647-9860-dd65128337e3",
                    "sense_definition": "A parasitic fly belonging to the genus Oestrus; a botfly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entomology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep suffered from nasal discomfort caused by an infestation of an <w>oestrus</w>.",
                            "target_lang_translations": {
                                "ru": "Овца страдала от дискомфорта в носовой полости, вызванного заражением личинками <w>овода</w>."
                            }
                        },
                        {
                            "text": "Farmers carefully monitor their herds to prevent infection from various species of parasitic <w>oestri</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры тщательно осматривают свои стада, чтобы предотвратить заражение различными видами паразитических <w>оводов</w>."
                            }
                        }
                    ],
                    "synonyms": [
