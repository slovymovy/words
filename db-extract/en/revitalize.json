                                                "example_id": "b4793b34-2f50-4e1e-a845-475715cf7809",
                                                "sense_id": "d769c304-ff87-3f51-8625-29d1129959ea",
                                                "text": "Darf ich mal dein Gedächtnis auffrischen? Du warst selbst dabei, als Hans das wortwörtlich gesagt hat."
                                            },
                                            {
                                                "example_id": "9edaed5f-efaf-43f3-aaa9-295b44fcded3",
                                                "sense_id": "d769c304-ff87-3f51-8625-29d1129959ea",
                                                "text": "Ich glaube, ich muss mal meine Italienischkenntnisse auffrischen, wir wollen ja dann im Herbst nach Rom fahren."
                                            },
                                            {
                                                "example_id": "2499e6ad-38c5-4c44-8e12-d57f06eba6d5",
                                                "sense_id": "d769c304-ff87-3f51-8625-29d1129959ea",
                                                "text": "Ja, vermutlich lasse ich meine Impfung auffrischen, falls es dann nicht schon wieder neue Erkenntnisse gibt oder irgendwelche Restriktionen oder Engpässe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "744fbb38-b9dc-3537-ba99-7c3bb7d02295",
                                        "entry_id": "d53a3055-800c-35ab-a1a7-f00317383759",
                                        "glosses": [
