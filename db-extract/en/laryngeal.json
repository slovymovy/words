                    {
                        "translation_id": "dee7ec74-cedd-4e19-bdf0-b3fac9ecc877",
                        "source_entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                        "source_sense_description": "of or pertaining to larynx",
                        "target_lang_word": "laryngé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laryngé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69188c14-cac4-31a3-b31b-d2601ffbe117",
                                        "entry_id": "3c579b62-edf9-3d99-a876-5aaacb5685d9",
                                        "glosses": [
                                            "Qui appartient au larynx."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca3ed30-8187-46a1-9231-31068a502c90",
                                                "sense_id": "69188c14-cac4-31a3-b31b-d2601ffbe117",
                                                "text": "Différents mécanismes laryngés sont utilisés dans la parole et le chant pour faire varier la fréquence des vibrations."
                                            },
                                            {
                                                "example_id": "d14f9622-22b9-458e-b1b5-1d7ad51796cd",
                                                "sense_id": "69188c14-cac4-31a3-b31b-d2601ffbe117",
                                                "text": "« Ce fut le programme de ma guérison. Car, ce que tu entends aujourd’hui, n’est qu’un petit reliquat laryngé de rien du tout »."
                                            },
                                            {
                                                "example_id": "0a7ef048-b803-47fc-a4ba-4add174726c8",
                                                "sense_id": "69188c14-cac4-31a3-b31b-d2601ffbe117",
                                                "text": "Le processus de production des sons met en œuvre trois ensembles d’organes : l’ensemble sous-glottique, l’ensemble laryngé et l’ensemble supra-glottique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0586dc03-9594-34ad-b11a-6571984b205a",
                                        "entry_id": "3c579b62-edf9-3d99-a876-5aaacb5685d9",
                                        "glosses": [
                                            "Prononcé avec le larynx."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d4890f-fe8f-4ce1-adb6-6bc493c4fb63",
                                                "sense_id": "0586dc03-9594-34ad-b11a-6571984b205a",
                                                "text": "Voyelles laryngées."
                                            },
                                            {
                                                "example_id": "9c089bc1-26d1-4635-b48a-0efa0a220475",
                                                "sense_id": "0586dc03-9594-34ad-b11a-6571984b205a",
                                                "text": "Du point de vue articulatoire, la différence fondamentale entre voyelles et consonnes est la suivante : alors que, pour les voyelles, l’air laryngé ne rencontre aucun obstacle, pour les consonnes, il y a toujours un obstacle, que ce soit un rétrécissement du canal buccal ou une obstruction complète, mais momentanée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e41399-2a93-4bb6-bf48-36684fd7b1f5",
                        "source_entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
