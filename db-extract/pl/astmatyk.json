                        "sense_id": "7a82c87a-fbdc-37b1-9512-57e686baad1d",
                        "entry_id": "8d7af719-bc7c-3d63-8d95-c6fb760cfa1c",
                        "glosses": [
                            "człowiek cierpiący na astmę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1958f4-7158-4271-bf1a-c66f16199d12",
                                "sense_id": "7a82c87a-fbdc-37b1-9512-57e686baad1d",
                                "text": "Dlaczego wśród wybitnych sportowców jest tylu astmatyków?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ffe1f5-ea31-469a-915b-c361963f1c02",
                        "source_entry_id": "8d7af719-bc7c-3d63-8d95-c6fb760cfa1c",
                        "source_sense_id": "7a82c87a-fbdc-37b1-9512-57e686baad1d",
                        "target_lang_word": "asthmatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthmatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a951bc36-d89a-3569-a18b-cc1e2c2d93ba",
                                        "entry_id": "cede2f12-6209-312f-8b89-742e3ee6b39a",
                                        "glosses": [
                                            "Having the characteristics of asthma, as in an \\\"asthmatic cough\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb6737a-a4d3-45bf-bcc4-09050d05fda7",
                                                "sense_id": "a951bc36-d89a-3569-a18b-cc1e2c2d93ba",
                                                "text": "The mother, Ekaterina Pavlovna, who at one time had been handsome, but now, asthmatic, depressed, vague, and over-feeble for her years, tried to entertain me with conversation about painting. Having heard from her daughter that I might come to Shelkovka, she had hurriedly recalled two or three of my landscapes which she had seen in exhibitions in Moscow, and now asked what I meant to express by them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asthmatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7133f21a-3c25-37af-85cc-578ca408f1dd",
                                        "entry_id": "551082d6-8efc-31fd-992b-6d2ebdcd9dfb",
                                        "glosses": [
                                            "A person who suffers from asthma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf7f895-01ef-464c-bd09-fcab39aa1091",
                        "source_entry_id": "8d7af719-bc7c-3d63-8d95-c6fb760cfa1c",
                        "source_sense_id": "7a82c87a-fbdc-37b1-9512-57e686baad1d",
                        "target_lang_word": "asthmatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08a765f1-0e10-32a5-b1f0-2d2fe35b6a97",
                                        "entry_id": "e5f31047-8eb0-3d23-bcae-f454c8d18400",
                                        "glosses": [
                                            "Qui est atteint d’asthme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3beb10a8-b3fc-4610-9a91-689e69d744b3",
                                                "sense_id": "08a765f1-0e10-32a5-b1f0-2d2fe35b6a97",
                                                "text": "Ils éclatèrent, et pouffèrent à l’envi ; l’un d’eux était asthmatique et semblait avoir un soufflet pour exciter son rire, dès qu’il se calmait."
                                            },
                                            {
                                                "example_id": "84111122-4f8b-40bb-9338-2258ad83907a",
                                                "sense_id": "08a765f1-0e10-32a5-b1f0-2d2fe35b6a97",
                                                "text": "J’avais donc enchaîné avec mon numéro habituel, la troupe des cinq caniches était au complet et tout s’était bien déroulé, seul Tre avait eu du mal à passer les cercles de feu à la fin, je pense qu’il était un peu asthmatique."
                                            },
                                            {
                                                "example_id": "43bc0d5b-2f9d-4d46-991f-6875232b4036",
                                                "sense_id": "08a765f1-0e10-32a5-b1f0-2d2fe35b6a97",
                                                "text": "Même si Christian Dubé a répété que tous les malades chroniques et personnes atteintes de maladies respiratoires pouvaient prendre rendez-vous, je ne savais pas si « asthmatique » se classait dans ces catégories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asthmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a68a21f5-0d1a-32fe-bfbf-52b68f756b30",
                                        "entry_id": "c78c2478-eedf-349d-8927-3f730d73f2f8",
                                        "glosses": [
                                            "Celui, celle qui est atteint d’asthme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f85082-a6b3-41ad-bd63-0f449656a36d",
                                                "sense_id": "a68a21f5-0d1a-32fe-bfbf-52b68f756b30",
                                                "text": "C’est un(e) asthmatique."
                                            },
                                            {
                                                "example_id": "c445b47e-828e-47aa-93c6-8643d50e5352",
                                                "sense_id": "a68a21f5-0d1a-32fe-bfbf-52b68f756b30",
                                                "text": "L’évolution de la maladie est variable et imprévisible d’un asthmatique à l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db3f1f9f-4b2c-4d6e-9dd8-da98ec14a660",
                        "source_entry_id": "8d7af719-bc7c-3d63-8d95-c6fb760cfa1c",
                        "source_sense_id": "7a82c87a-fbdc-37b1-9512-57e686baad1d",
