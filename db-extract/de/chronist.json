                                        "glosses": [
                                            "osoba, która napisała lub pisze kronikę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a44a6b-46d1-4530-8a66-b21a786e3f5c",
                                                "sense_id": "ff9124dd-2be1-3a85-8f3f-5e7f09df8657",
                                                "text": "Historycy uznają wielkość kronikarza, jakkolwiek są w jego tekstach opowieści ubarwione elementami legendarnymi, ale pamiętajmy, że pisał on w celach dydaktycznych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "0dd7c97a-7627-37fe-a2ea-821e54251411",
                                        "entry_id": "9ef0520f-7962-3aef-b429-41287ad09fd8",
                                        "glosses": [
                                            "osoba śledząca i opisująca przebieg faktów, np. w czasopiśmie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b90c1c-5465-4732-8b45-f734177f1ddf",
                                                "sense_id": "0dd7c97a-7627-37fe-a2ea-821e54251411",
                                                "text": "Kronikarz brochowski nie mógł opuścić takiego wydarzenia"
