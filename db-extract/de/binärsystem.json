                                "target_senses": [
                                    {
                                        "sense_id": "f0e9770f-8832-3da5-adc6-6e4047b29765",
                                        "entry_id": "61a20f46-1bf9-37aa-a29a-d0d6c2c9be7f",
                                        "glosses": [
                                            "Two gravitationally connected stars or other celestial objects which orbit around their center of mass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31419b05-e759-413d-8c19-ef15b9027b8b",
                                                "sense_id": "f0e9770f-8832-3da5-adc6-6e4047b29765",
                                                "text": "[S]cientists from the SETI (Search for Extraterrestrial Intelligence) Institute found subtle dips in the light coming from a binary system about 200 million light years from Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f195882d-9660-3b1b-9617-95fb8ca53548",
                                        "entry_id": "61a20f46-1bf9-37aa-a29a-d0d6c2c9be7f",
                                        "glosses": [
                                            "A numeric system with a base of 2, using only the numerals 0 and 1."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d7320c5-a453-4c3a-9d16-b2d0c957f480",
                                                "sense_id": "f195882d-9660-3b1b-9617-95fb8ca53548",
                                                "text": "Quantum cryptography is one of the first applications of quantum physics, which is expected to replace today's binary system of computing, in which data is represented in series of ones and zeros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
