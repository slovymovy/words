                        {
                            "text": "Na een hele <w>poos</w> zoeken vond zij eindelijk haar sleutels in haar tas.",
                            "target_lang_translations": {
                                "en": "After searching for a long <w>while</w>, she finally found her keys in her bag."
                            }
