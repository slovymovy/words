                    {
                        "translation_id": "32655806-867f-46c3-99cf-baa9d80abf77",
                        "source_entry_id": "69ea3c20-fe02-3fa4-97f2-660b798982cc",
                        "source_sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
