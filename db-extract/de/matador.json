                "senses": [
                    {
                        "sense_id": "c2ce825b-eb67-3343-97b6-9bdd565551b1",
                        "entry_id": "f39c5715-6b1a-3376-a987-2ef783d55661",
                        "glosses": [
                            "(männliche^☆) Person, die im Stierkampf gegen den Stier antritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5ab89c-98c6-4533-af91-04cf78df9674",
                                "sense_id": "c2ce825b-eb67-3343-97b6-9bdd565551b1",
                                "text": "„Auf der Bahnhofstreppe wartete eine Gruppe von Matadoren und spanischen Donnas auf ein Taxi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0476d6d7-eeb7-3b73-8e31-5c594c8264f4",
                        "entry_id": "f39c5715-6b1a-3376-a987-2ef783d55661",
                        "glosses": [
                            "(männliche^☆) Person, die eine bestimmende/führende Rolle innehat"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58e310ba-a33b-4316-96f2-3b2bf6ab76ca",
                        "source_entry_id": "f39c5715-6b1a-3376-a987-2ef783d55661",
                        "source_sense_id": "c2ce825b-eb67-3343-97b6-9bdd565551b1",
                        "target_lang_word": "matador",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matador",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "The person whose aim is to kill the bull in a bullfight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0eac7af-58a9-4188-9e05-d3ca5474bd42",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "[…] few of these boys know how to fight alone, and hardly any without a knife or a gun. They are not to be equated with matadors or boxers or Hemingway heroes. They are dangerous pack hounds who will not even expose themselves singly in the outfield."
                                            },
                                            {
                                                "example_id": "20746eb8-c90b-465d-91cf-ee07160cde41",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "The second is La Macarena, named after an Arabian princess, and she was preferred by another great matador, Joselito, and to see her leave her parish church of San Gil at one in the morning of Good Friday or return later in the day is held by many Sevillanos to be the most important thing that can happen during Holy Week."
                                            },
                                            {
                                                "example_id": "d422e92f-bbdc-46a8-bef8-a013e257a97a",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "Hemingway's subject for the epilogue was the mano a mano (or hand-to-hand, a duel) between Spain's two leading matadors, Luis Miguel Dominguin and his brother-in-law, Antonio Ordonez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b05021-bade-352d-84d2-6713f2a4db5c",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "A certain game of dominoes in which four dominoes (the 4-3, 5-2, 6-1, and double blank), called matadors, may be played at any time in any way."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7e70982-bf5d-3d1e-8ff5-c42e90f1f914",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "The jack of clubs, or any other trump held in sequence with it, in the game of skat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58665c24-7e0a-399e-bb7d-d790a1c6cca1",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "One of the three chief cards in ombre and quadrille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
