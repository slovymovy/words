    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                "word": "nuthatch",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a1b5045-c217-44b2-b6a4-26bf00ed4bd0",
                        "entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                        "tags": [
                            "plural"
                        ],
                        "form": "nuthatches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                        "entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                        "glosses": [
                            "Any of various small passerine birds from the genus Sitta, found throughout the northern hemisphere and noted for their unusual proclivity for climbing down trees head first."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf96e60-b06d-4aae-a702-2b9a34208907",
                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                "text": "Nuthatches have rather a habit of entering houses through open windows, probably out of curiosity; and we owed to this habit a pet nuthatch, which became extremely tame, and used to take flies from our finger."
                            },
                            {
                                "example_id": "6cd0aada-ec00-4c43-8d5a-8ed970a02304",
                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                "text": "The bird was in very faded plumage with only a slight rusty wash to the underparts, and had I not heard the call, I might have mistaken it for a Pygmy Nuthatch."
                            },
                            {
                                "example_id": "d892092b-c41a-4ae2-871b-7b54effbcdbf",
                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                "text": "Considered a resident bird, the red-breasted nuthatch usually winters in the coniferous forests within its breeding range."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0631fe4a-9910-4e42-b5c3-39e84c7637bc",
                        "source_entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                        "source_sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                        "source_sense_description": "passerine bird from the genus Sitta",
                        "target_lang_word": "brhlík",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2aa2412c-220f-4fe1-a3f3-ce77fbcb41f1",
                        "source_entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                        "source_sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                        "source_sense_description": "passerine bird from the genus Sitta",
                        "target_lang_word": "sittelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sittelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                                        "entry_id": "c15c2e59-6680-3cf4-aebf-8e974e39869e",
                                        "glosses": [
                                            "Passereau grimpeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abffb0de-8403-4b0a-9a79-86830cde3f5e",
                                                "sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                                                "text": "Des sittelles, oiseaux rapides de couleur marron moucheté, se posaient tout en biais au bout des branches chargées d’aiguilles, parfois le bec en bas et la queue en l’air,pour becqueter pignes et chenilles."
                                            },
                                            {
                                                "example_id": "917dbcfc-165e-4d5f-b8b0-f058efe29a7c",
                                                "sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                                                "text": "Comme les mésanges, la sittelle travaille sans relâche."
                                            },
                                            {
                                                "example_id": "923f5282-7d9b-44e7-8d3c-a2e9831a2611",
                                                "sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                                                "text": "mes forêts sont lièvres et renards\njungle d’insectes qui scintillent\nun soir d’été quand c’est l’hiver\nelles sont coyote ours noir orignal\nsittelle geai bleu mésange"
                                            },
                                            {
                                                "example_id": "411fa2ec-0560-4b13-bf9e-0764cdda6f63",
                                                "sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                                                "text": "Trois espèces de sittelles peuvent être observées en France : la sittelle torchepot, la sittelle de Neumayer (rare) et la sittelle corse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8626f237-9114-44d1-b236-1b0330a46937",
                        "source_entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                        "source_sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                        "source_sense_description": "passerine bird from the genus Sitta",
                        "target_lang_word": "Kleiber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a239d72f-209c-3862-8766-53ae54bbcf25",
                                        "entry_id": "a59f6c11-7ba5-30e3-8f89-7af01699f330",
                                        "glosses": [
                                            "eine mitteleuropäische Vogelart (Sitta europaea): typisch gefärbter, blaugelber Vogel mit kräftigem Schnabel und kurzem Schwanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0b1283-18b8-4bbf-9654-2e357725b90f",
                                                "sense_id": "a239d72f-209c-3862-8766-53ae54bbcf25",
                                                "text": "Kleiber können im Gegensatz zu Spechten die Bäume nicht nur aufwärts, sondern ebenso hinunter laufen."
                                            },
                                            {
                                                "example_id": "89317d1b-ed83-4082-aa3b-de58772e1072",
                                                "sense_id": "a239d72f-209c-3862-8766-53ae54bbcf25",
                                                "text": "Der Kleiber ist Vogel des Jahres 2006."
                                            },
                                            {
                                                "example_id": "dfc0ae77-fe52-4e1e-9c89-7867d902ade2",
                                                "sense_id": "a239d72f-209c-3862-8766-53ae54bbcf25",
                                                "text": "„Der Kleiber rutscht über die Buchnuß und dreht sich um, daß sein Kopf nach unten hängt. Das macht ihm kein Vogel im Walde nach, weder die Meise noch der Specht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95fe352f-e974-3625-8891-7c05e1b76a40",
                                        "entry_id": "a59f6c11-7ba5-30e3-8f89-7af01699f330",
                                        "glosses": [
                                            "die Gattung der Kleiber^([1]) (Sitta)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5701eda-a693-4acd-a165-d484210ab59e",
                                                "sense_id": "95fe352f-e974-3625-8891-7c05e1b76a40",
                                                "text": "Kleiber sind kleine Sperlingsvögel der Familie Sittidae."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6759c281-6d05-3038-a493-4853c8d9695e",
                                        "entry_id": "a59f6c11-7ba5-30e3-8f89-7af01699f330",
                                        "glosses": [
                                            "die Familie der Kleiber^([1]) (Sittidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e12400c-f06d-473e-8884-2553a3f56251",
                                                "sense_id": "6759c281-6d05-3038-a493-4853c8d9695e",
                                                "text": "Kleiber besitzen kräftige Hackschnäbel und ernähren sich von Wirbellosen und Pflanzensamen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kleiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78abb127-e391-305d-8081-bfedef0886ad",
                                        "entry_id": "77aa3c76-97ae-3681-94b0-287abb395053",
