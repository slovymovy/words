                "senses": [
                    {
                        "sense_id": "7020b0e1-7337-3ec2-bcc4-0013b77f4c4f",
                        "entry_id": "11efe22f-558f-3aad-8450-81a66d418fb1",
                        "glosses": [
                            "die Bildung von Hohlräumen, in Flüssigkeiten unter örtlichen Druckschwankungen (Kavitation), bei der die Hohlräume mit Gas gefüllt sind, das vorher in der Flüssigkeit gelöst war"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "8fa3fd6b-a15e-4b9f-85c4-752a7de74d4a",
                                "sense_id": "7020b0e1-7337-3ec2-bcc4-0013b77f4c4f",
                                "text": "Liegt keine Gaskavitation, sondern nur Dampfkavitation vor, so entsteht dadurch aber keinerlei Förderstromverlust."
                            },
                            {
                                "example_id": "f38a4f26-1f68-4923-91cd-e8cd63dc7ae1",
                                "sense_id": "7020b0e1-7337-3ec2-bcc4-0013b77f4c4f",
                                "text": "Häufige Verwendung bei Gleitlagern finden bläschendynamische Modelle zur Beschreibung von Gaskavitation."
                            },
                            {
                                "example_id": "430f2cfc-a9a0-410a-88ef-1679f01a34bf",
                                "sense_id": "7020b0e1-7337-3ec2-bcc4-0013b77f4c4f",
                                "text": "Gaskavitation richtet keine der Dampfkavitation vergleichbaren Schäden an Pumpenbauteilen an, sie kann aber die Funktion volumetrischer Dosierpumpen stören."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
