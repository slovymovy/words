                ],
                "senses": [
                    {
                        "sense_id": "c8234166-4968-3a39-8abf-8b8d65ea6144",
                        "entry_id": "3efc5743-6799-3677-b65d-5f440e1e96ff",
                        "glosses": [
                            "opresyjna i bezprawna praktyka wypychania osób próbujących przekroczyć granicę państwa z powrotem do punktu wyjścia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c66f979-75f6-4125-8cbb-9824e828bae7",
                                "sense_id": "c8234166-4968-3a39-8abf-8b8d65ea6144",
                                "text": "Dzisiaj mamy do czynienia z ambiwalentną postawa Unii Europejskiej wobec praktyki pushbacków, co daje coraz więcej swobody odpychającym uchodźców władzom państw, które stawiają przed sądem protestujących i pomagających im aktywistów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47d7803e-4ab9-4a21-80c2-640539e051ba",
                        "source_entry_id": "3efc5743-6799-3677-b65d-5f440e1e96ff",
                        "source_sense_id": "c8234166-4968-3a39-8abf-8b8d65ea6144",
                        "target_lang_word": "pushback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pushback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d84aab98-645a-3d8b-908a-5fb1c00919aa",
                                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                                        "glosses": [
                                            "The act of repelling an enemy, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92bd54c4-13a0-3b1d-a723-99251c302b52",
                                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                                        "glosses": [
                                            "A procedure in which an aircraft is pushed backwards away from the gate by some external force, usually a special tractor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "653a8b3f-a6bb-31c7-b2e5-fa64086f330a",
                                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                                        "glosses": [
                                            "A reversal or reduction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5b8d15a-f36f-42db-9f1c-986e0b3e745d",
                                                "sense_id": "653a8b3f-a6bb-31c7-b2e5-fa64086f330a",
                                                "text": "Sweden, as well as the UK, recently announced pushbacks on green targets and budgets, while there are negative noises from Germany on building insulation costs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                                        "glosses": [
                                            "Criticism of or resistance to a proposal, stance, or event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1af10b-ecb6-4ae3-9969-b53b5dcc7348",
                                                "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                                "text": "More pushback from Hill on eavesdropping [title]"
                                            },
                                            {
                                                "example_id": "2bd289a3-a4ef-4716-ba49-8ea9374744a7",
                                                "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                                "text": "Moreover, when Democrats, notably former House minority leader Richard Gephardt, finally put their heads up in the late spring of 2002 to ask questions about that Aug. 6, 2001, memo warning of the possibility of terrorist attacks, the Republican pushback was furious."
                                            },
                                            {
                                                "example_id": "0e3e6f1d-c1e7-4b6a-8530-e703de7ee175",
                                                "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                                "text": "We’ve seen that before, too: civil rights era sit-ins and freedom rides with multiracial participants drew the fierce ire of authorities alike, but black protesters were far more likely to be targeted with harsh jail sentences and violent pushback."
                                            },
                                            {
                                                "example_id": "fcb61969-04b4-4b99-a33f-20de7f164460",
                                                "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                                "text": "“I started just connecting the dots between extreme weather and climate change, and then the volume of pushback started to increase quite dramatically,” he said in an interview with the Associated Press."
                                            },
                                            {
                                                "example_id": "8a7c4821-4ca0-4cae-ae2f-99aa4ac389f2",
                                                "sense_id": "a4a0ee68-8a50-3e55-9810-c3a723dd437f",
                                                "text": "Obsessed only with cost, 'Sir Humphrey' saw that Transport for London 'got away' with ticket office closures on the Tube with only minor public pushback and miscalculated that it could do the same on the national network. This assumption backfired spectacularly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "384cb878-d0c9-335a-a795-e2efdb40cf7c",
                                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                                        "glosses": [
                                            "Summary expulsion of asylum seekers, especially when violating the principle of non-refoulement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e9f23c-2073-4224-a9fc-21d05d0924a0",
                                                "sense_id": "384cb878-d0c9-335a-a795-e2efdb40cf7c",
                                                "text": "\"Every single pushback represents a violation of international and EU law – whether it involves violence or not.\""
                                            },
                                            {
                                                "example_id": "2e2e6d1f-5767-413e-9693-12edb6e69b3a",
                                                "sense_id": "384cb878-d0c9-335a-a795-e2efdb40cf7c",
                                                "text": "Jasmin Redjepi, president of Legis, said the “disturbing and degrading” pushbacks came shortly after an EU-Serbian border cooperation summit, aimed at strengthening the Serbian border against people-smuggling operations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e387e63-0bf1-46cf-b714-76d3c552f21a",
                        "source_entry_id": "3efc5743-6799-3677-b65d-5f440e1e96ff",
                        "source_sense_id": "c8234166-4968-3a39-8abf-8b8d65ea6144",
                        "target_lang_word": "refoulement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refoulement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c94d40d-8a45-390a-8f89-763b53fad344",
                                        "entry_id": "f9f85ad8-42b2-3d9e-b5ea-40c3edb92dc7",
                                        "glosses": [
                                            "The involuntary sending of refugees or asylum seekers to their country of origin or another one, where they are likely to face persecution and harm."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e77680f-e09f-4af3-bbc9-11cc9389e998",
                                                "sense_id": "5c94d40d-8a45-390a-8f89-763b53fad344",
                                                "text": "He also expressed concern that at the same time there could be cases of refoulement with asylum seekers being returned to their countries of origin, where they are at risk of persecution and in an apparent breach of international law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb66a39-3814-3126-a9a6-749e6425034d",
                                        "entry_id": "f9f85ad8-42b2-3d9e-b5ea-40c3edb92dc7",
                                        "glosses": [
                                            "An instance thereof."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34592ea9-83b4-3d49-b9ea-2f5451881f54",
                                        "entry_id": "f9f85ad8-42b2-3d9e-b5ea-40c3edb92dc7",
                                        "glosses": [
                                            "The forced relocation of a group of people."
                                        ],
