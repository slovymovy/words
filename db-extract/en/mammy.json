    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                "word": "mammy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e54967b5-02ef-4566-8620-91321cbc559e",
                        "entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "mammies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fb8052b-098f-350a-a5d1-7e6572f6bbbf",
                        "entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                        "glosses": [
                            "mamma; mother"
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf61d176-26dc-3c65-aa7a-4bef48926224",
                        "entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                        "glosses": [
                            "In the southern United States, a black nanny employed to look after white children; or in the antebellum South, a female slave who was close to the household and looked after the children."
                        ],
                        "tags": [
                            "US",
                            "historical",
                            "often",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ce75d13f-1d03-449e-b77d-c4fdd97299e8",
                                "sense_id": "cf61d176-26dc-3c65-aa7a-4bef48926224",
                                "text": "That's what you for—to help white folks keep niggers down. That's why he sent you to me. They be calling you mammy in a few years. You be running the whole house when the old man dies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a5654de-deb1-4801-9554-c858b52dd83f",
                        "source_entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                        "source_sense_description": "child's name for mother",
                        "target_lang_word": "maman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0b6328f-e269-3013-8799-dd7ddd112685",
                                        "entry_id": "ce9015d6-712f-3947-935a-3d1c9704a161",
                                        "glosses": [
                                            "Mère."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d313ecec-620d-477d-af5a-b04428d49a28",
                                                "sense_id": "f0b6328f-e269-3013-8799-dd7ddd112685",
                                                "text": "Tout de même, il ne pouvait pas aller dire aux mamans : Sapristi, mais gardez donc un peu mieux vos filles ou elles se feront… manger du loup !"
                                            },
                                            {
                                                "example_id": "940aa92e-f7fa-4c78-8861-316c997cd611",
                                                "sense_id": "f0b6328f-e269-3013-8799-dd7ddd112685",
                                                "text": "Un homme entraîne son gamin loin des voitures radiocommandées « Viens on va rejoindre manman ». J’ai entendu et dit manman toute mon enfance, pas maman. L’homme qui vient de me le rappeler est d’origine africaine ou antillaise."
                                            },
                                            {
                                                "example_id": "58187c90-8c5b-4892-891b-153340aa7c6a",
                                                "sense_id": "f0b6328f-e269-3013-8799-dd7ddd112685",
                                                "text": "Les restaurants Regnum et Plaza Restauration nous offrent les repas pour la moitié de la semaine, mais le mardi et le jeudi, ce sont les mamans qui cuisinent, indique-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                        "entry_id": "ce9015d6-712f-3947-935a-3d1c9704a161",
                                        "glosses": [
                                            "Nom donné à la mère par son enfant (y compris à l’âge adulte), pour la désigner affectueusement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844f5f13-06ff-4f22-a54b-a4a58876f6f0",
                                                "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                                "text": "Née sous les châtaigniers de Faverges-de-la-Tour en Isère, cette maman chérie (disparue en 2019) a rencontré son papa, Louis, après la Seconde Guerre mondiale."
                                            },
                                            {
                                                "example_id": "d74184a6-2ca0-4bab-8bb4-85ac520fba51",
                                                "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                                "text": "Les soirs où une bise polaire hurlait dans la cheminée, quand, à l'heure du repas, maman posait la cocotte noire sur la table, la cacasse-à-cul-nu dégageait un parfum particulier."
                                            },
                                            {
                                                "example_id": "9479d489-9a8b-47e7-90c3-87afb85ff852",
                                                "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                                "text": "Ouah ! Mais il a l’air génial ce jeu ! En plus, sur la jaquette il y a un monsieur super classe avec plein de muscles en train de mettre une dérouillée à un super méchant ! Dis, maman, tu peux me l’acheter s’il te plaît ? Allez ! Il a l’air vraiment trop bien. […]. Je peux l’avoir maman ? S’il te plaît !"
                                            },
                                            {
                                                "example_id": "b9d02fa3-b983-40f9-89e7-8c8678d37396",
                                                "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                                "text": "Avec maman, quand le cœur est au gris\nAprès le dîner, on se passe \"Nathalie\"\nÇa la fait un peu pleurer\nEt moi ça me fait danser."
                                            },
                                            {
                                                "example_id": "015f1d5e-9a1b-4e91-a16e-1f9811cb396c",
                                                "sense_id": "9380cc77-e105-3295-b403-f4adde7bf749",
                                                "text": "Que de fois j'ai vu tomber des hommes, blessés, râlant et leurs premiers cris étaient « Maman »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "068e212d-0271-32ad-9497-b5476e7116b5",
                                        "entry_id": "ce9015d6-712f-3947-935a-3d1c9704a161",
                                        "glosses": [
                                            "Dame, madame."
                                        ],
                                        "tags": [
                                            "Afrique centrale"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "maman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b7141e0-8dc6-39b9-959f-b07c6e793654",
                                        "entry_id": "f94bbd9a-8d7d-3295-a87c-6c99d2d89c44",
                                        "glosses": [
                                            "Expression de la frayeur, la douleur, le désarroi."
                                        ],
                                        "tags": [
                                            "Aude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082cb497-3fde-44e7-bb33-17c4522db849",
                                                "sense_id": "8b7141e0-8dc6-39b9-959f-b07c6e793654",
                                                "text": "Maman ! J’ai peur !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7162dc83-582c-4641-bb46-cd49b80db7b0",
                        "source_entry_id": "49cd1019-adb7-3f23-8b3a-71c7d71714ba",
                        "source_sense_description": "child's name for mother",
                        "target_lang_word": "Mami",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc65ff0c-e4ba-36d2-be1c-e304f6606a93",
                                        "entry_id": "51be589f-900b-3c80-a210-952517f8f4da",
                                        "glosses": [
                                            "Koseform von Mama"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7b8380-829c-49b6-8c66-0fd0c7f93445",
                                                "sense_id": "fc65ff0c-e4ba-36d2-be1c-e304f6606a93",
                                                "text": "Mami, kannst du mir mein Taschengeld schon heute geben?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                        "entry_id": "242d1e50-5efd-31f6-aef7-4c28296f9806",
                                        "glosses": [
                                            "Koseform von Mama"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88f8c4a-831b-4317-a8c2-fce7d90a3198",
                                                "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                                "text": "„Das übernimmt weiterhin sein Mami.“"
                                            },
                                            {
                                                "example_id": "4aa2d0af-aaa6-4b9f-a3e8-72c1966d72e4",
                                                "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                                "text": "„Kontakt zu seinem Mami Elvira soll er seit Knastantritt keinen haben.“"
                                            },
                                            {
                                                "example_id": "e441fcd9-5273-48c8-996f-a2d6d827f1bb",
                                                "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                                "text": "„Fabrizio Behrens hat mit 20 Minuten über Frauen, die Zukunft und sein Mami gesprochen.“"
                                            },
                                            {
                                                "example_id": "9ba81b3d-ae2c-4237-b02c-a341fab846d4",
                                                "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                                "text": "„Ihre ältere Tochter, nunmehr vierjährig, hat laut dem Mami eine unbändige Neugier entwickelt.“"
                                            },
                                            {
                                                "example_id": "151ab64d-4304-40fa-9525-170d6d5c5560",
                                                "sense_id": "6e35b448-cd8e-30e1-8005-1937bc0e0e1a",
                                                "text": "„Das findet auch der 2-jährige Nael, der sich laut seinem Mami Lisa dort schon seit zwei Stunden zu beschäftigen weiss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05a9dcb4-a3fe-4e1e-893f-b3a94521de64",
