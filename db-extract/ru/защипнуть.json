                "senses": [
                    {
                        "sense_id": "5384d380-25ce-3f1d-b948-1fa66e910ff7",
                        "entry_id": "c2df1bb0-82ae-39d0-a2ea-9c456fed46bc",
                        "glosses": [
                            "ухватить щипком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113fc693-6925-40ce-94b0-acda8b0699f9",
                                "sense_id": "5384d380-25ce-3f1d-b948-1fa66e910ff7",
                                "text": "Уже я не мальчик; уж над губой могу свой ус я защипнуть."
                            },
                            {
                                "example_id": "a55bd4a8-0688-4c07-b93b-60b440be59c5",
                                "sense_id": "5384d380-25ce-3f1d-b948-1fa66e910ff7",
                                "text": "Во время брожения тесто один или два раза следует обмять. Сформовать шарики, расстоять в течение 5–10 минут и раскатать на круглые лепешки, на середину которых выложить фарш; края защипнуть веревочкой так, чтобы середина пирожка осталась открытой."
                            }
                        ]
                    },
                    {
                        "sense_id": "56ffcfff-22a1-3400-9298-99d089ea354f",
                        "entry_id": "c2df1bb0-82ae-39d0-a2ea-9c456fed46bc",
                        "glosses": [
                            "разг. ухватив щипцами, взять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f4c51e-0f8d-4cd5-a4c9-adbcefe8ad93",
                                "sense_id": "56ffcfff-22a1-3400-9298-99d089ea354f",
                                "text": "Защипнуть кусок сахару."
                            }
                        ]
                    }
