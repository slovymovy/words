                "senses": [
                    {
                        "sense_id": "ca900780-7aee-3f72-9cfc-a2a48e41d02e",
                        "entry_id": "c1104a31-7d0d-36ff-bdbd-7b3a75816911",
                        "glosses": [
                            "farbige Textilien, die nicht kochecht und/oder nicht farbecht sind und daher bei niedrigeren Temperaturen (üblicherweise 30, 40 oder 60 Grad) gewaschen werden"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "2b049e44-c8e1-44a1-8287-8c7526181d9d",
                                "sense_id": "ca900780-7aee-3f72-9cfc-a2a48e41d02e",
                                "text": "„Die Maschine ist mit ihrer großen Trommel zwar sehr familienfreundlich und dabei trotzdem günstig im Wasser- und Stromverbrauch, spült Buntwäsche allerdings nur sehr schlecht.“"
                            },
                            {
                                "example_id": "896fe521-34af-424f-ab18-b25262a7d201",
                                "sense_id": "ca900780-7aee-3f72-9cfc-a2a48e41d02e",
                                "text": "„Leicht und normal verschmutzte Buntwäsche wird meist bei 20 bis 30 °C und Weißwäsche in der Regel bereits bei 40 °C sauber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
