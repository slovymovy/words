                                "sense_id": "58c1182a-269a-3d14-83d8-6bcecb546fa7",
                                "text": "Bujne porosty na korze drzew świadczą o czystym powietrzu w okolicy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e179efd9-fce9-325e-9f22-405a2138d45a",
