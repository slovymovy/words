                "senses": [
                    {
                        "sense_id": "d9df8a9a-eab4-3376-b7cc-1ba96d16d209",
                        "entry_id": "807b27f4-4b16-3059-9ada-1449b450dff8",
                        "glosses": [
                            "een beeld of afbeelding van Boeddha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b350be51-4251-4fc9-9d5e-f3296b7b4fd0",
                                "sense_id": "d9df8a9a-eab4-3376-b7cc-1ba96d16d209",
                                "text": "Nieuwkomer Donald Ellis uit New York presenteert een fantastische verzameling maskers en gebruiksvoorwerpen van de inuit uit Alaska, waaronder een onweerstaanbaar Yupik-masker (4,8 miljoen euro). Een grote veertiende-eeuwse boeddha domineert de stand van Van der Ven Oriental Art, ook met een prijskaartje met zeven cijfers. Een Amerikaanse bezoekster stond er bewonderend naar te kijken: „Hij kan zo opstaan en weglopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c9bcf0-12fd-39a1-a071-d5bce322616a",
                        "entry_id": "807b27f4-4b16-3059-9ada-1449b450dff8",
                        "glosses": [
                            "een rustig meestal wat gezet persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd5b8b2e-4132-40e9-8274-a9ad3ff96231",
                                "sense_id": "22c9bcf0-12fd-39a1-a071-d5bce322616a",
                                "text": "We treffen een Deense boeddha op het dakterras van het Marriot Hotel in Cannes, achterover leunend op een spierwitte loungebank. Is filmmaker Nicolas Winding Refn (45) werkelijk zo relaxed?"
                            }
                        ]
                    }
