    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc2a156c-bc78-3f6e-970c-51bcfe0879cb",
                    "sense_definition": "A payment made to an employee upon the termination of their employment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered a generous <w>severance</w> to all employees affected by the restructuring.",
                            "target_lang_translations": {
                                "cs": "Společnost nabídla štědré <w>odstupné</w> všem zaměstnancům zasaženým restrukturalizací."
                            }
                        },
                        {
                            "text": "After twenty years of service, she received a significant <w>severance</w> package.",
                            "target_lang_translations": {
                                "cs": "Po dvaceti letech služby obdržela významné <w>odstupné</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "severance payment",
                        "severance pay"
                    ],
                    "common_phrases": [
                        "severance pay",
                        "severance package"
                    ],
                    "target_lang_definitions": {
                        "cs": "Finanční vyrovnání poskytnuté zaměstnanci při ukončení pracovního poměru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odstupné",
                                "target_lang_sense_clarification": "peněžní částka při výpovědi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a67d11d-16e6-3743-b3f1-22e72d822247",
                    "sense_definition": "The act of cutting something off or the state of being separated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>severance</w> of the main power cable caused a total blackout in the building.",
                            "target_lang_translations": {
                                "cs": "<w>Přerušení</w> hlavního napájecího kabelu způsobilo v budově úplný výpadek proudu."
                            }
                        },
                        {
                            "text": "The sudden <w>severance</w> of diplomatic ties between the two nations surprised the international community.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>přerušení</w> diplomatických styků mezi oběma národy překvapilo mezinárodní společenství."
                            }
                        }
                    ],
                    "synonyms": [
                        "separation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt přerušení, oddělení nebo stav odloučení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přerušení",
                                "target_lang_sense_clarification": "ukončení spojení nebo činnosti"
                            },
                            {
                                "target_lang_word": "oddělení",
                                "target_lang_sense_clarification": "fyzické rozpojení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ab4c00b3-075b-364a-beff-d9f8628cc0ae",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a man named Mr. <w>Severance</w> who lived in the village.",
                            "target_lang_translations": {
                                "cs": "Historické záznamy zmiňují muže jménem pan <w>Severance</w>, který žil v této vesnici."
                            }
                        },
                        {
                            "text": "The library was named after the <w>Severance</w> family who donated the land.",
                            "target_lang_translations": {
                                "cs": "Knihovna byla pojmenována po rodině <w>Severanceových</w>, kteří darovali pozemek."
                            }
                        }
