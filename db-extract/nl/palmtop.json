                        "translation_id": "a48f7f9c-143f-4a82-9321-420159c86752",
                        "source_entry_id": "a540f3d3-b152-3887-8874-0edee0f7a070",
                        "source_sense_id": "c192edd3-b4b3-3a54-96d0-372f3010fa96",
                        "target_lang_word": "personal digital assistant",
