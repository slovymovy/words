        "fr-extract.jsonl": [
            {
                "entry_id": "0f932495-9a97-3875-b07b-1c56ccace20c",
                "word": "oratoire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b15ada54-f659-403c-9b73-037f3480b4cc",
                        "entry_id": "0f932495-9a97-3875-b07b-1c56ccace20c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "oratoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54c45cc2-e951-35bc-b7b3-04441821d5a6",
                        "entry_id": "0f932495-9a97-3875-b07b-1c56ccace20c",
                        "glosses": [
                            "Qui appartient à l’orateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597a3c1d-7080-45b2-8434-64b29661059b",
                                "sense_id": "54c45cc2-e951-35bc-b7b3-04441821d5a6",
                                "text": "Il possède un véritable talent oratoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc917df4-1c8f-3fe6-895d-32d7a1855da4",
                        "entry_id": "0f932495-9a97-3875-b07b-1c56ccace20c",
                        "glosses": [
                            "Qui est propre à la technique du discours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754892eb-bf8f-4ce6-aaa6-dd49143a7a13",
                                "sense_id": "cc917df4-1c8f-3fe6-895d-32d7a1855da4",
                                "text": "[…] ; ses moindres discours étaient accompagnés d’un geste oratoire de la main droite, qu’on aurait pu croire destiné à en marquer la cadence."
                            },
                            {
                                "example_id": "588ff2fe-47d6-410a-8351-71040009aeac",
                                "sense_id": "cc917df4-1c8f-3fe6-895d-32d7a1855da4",
                                "text": "Mais rien ne put comprimer les battements de leurs cœurs pendant le discours de sir Francis M…, et, de mémoire humaine, ce fut là certainement le plus beau succès oratoire de la Société royale géographique de Londres."
                            },
                            {
                                "example_id": "2f25caa0-20d4-4f74-b962-bec9f4798c18",
                                "sense_id": "cc917df4-1c8f-3fe6-895d-32d7a1855da4",
                                "text": "Elle savait qu'il avait mis un orgueil masochiste (ça existe !) à abaisser son talent, à mirlitonner des vers politiques et à briser la cadence autrefois superbement oratoire de son style."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15fd03e0-01a3-4957-81ab-ee05b13df8ef",
                        "source_entry_id": "0f932495-9a97-3875-b07b-1c56ccace20c",
                        "target_lang_word": "oratorical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oratorical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5b1a33f-6a98-3180-9969-7f5a7eac78a9",
                                        "entry_id": "1181da42-9514-3d89-8a44-2a873e98ed14",
                                        "glosses": [
                                            "of, or relating to oratory or an orator."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02f7ba74-3813-4051-a5c1-b6431dc840c7",
                                                "sense_id": "c5b1a33f-6a98-3180-9969-7f5a7eac78a9",
                                                "text": "A to'oto'o is a Sāmoan oratorical staff."
                                            },
                                            {
                                                "example_id": "bfeb0149-24d7-485f-91cd-63577de1d350",
                                                "sense_id": "c5b1a33f-6a98-3180-9969-7f5a7eac78a9",
                                                "text": "I reached up without thinking, actually a desperate oratorical gesture of disagreement and defiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                "word": "oratoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "53f6f639-012e-4a05-8ac9-66c20a3c52c3",
                        "entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                        "tags": [
                            "plural"
                        ],
                        "form": "oratoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7012e815-a97a-36c7-8e6c-581bc35490b4",
                        "entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                        "glosses": [
                            "Petite chapelle, adjointe à un édifice où l’on peut prier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea79e92f-0057-474b-a660-07530ea4afcc",
                                "sense_id": "7012e815-a97a-36c7-8e6c-581bc35490b4",
                                "text": "Servir Dieu, ce n’est point passer sa vie à genoux dans un oratoire, je le sais bien ; c’est remplir sur la terre les devoirs qu’il nous impose ; c’est faire en vue de lui plaire tout ce qui convient à l’état où il nous a mis."
                            },
                            {
                                "example_id": "dbbc961a-27ca-40d8-9f0a-31cd87778e82",
                                "sense_id": "7012e815-a97a-36c7-8e6c-581bc35490b4",
                                "text": "Monsieur d’Espard, qui a suivi cette affaire, m’a menée à l’Oratoire où cette femme va au prêche, car elle est protestante."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8c7320c-8f04-3e61-9a9a-37cfea6cff93",
                        "entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                        "glosses": [
                            "Chapelle élevée sur le bord d’une route pour conserver un souvenir religieux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "037d483d-27ed-4e44-8ab2-3d8541c73e58",
                                "sense_id": "f8c7320c-8f04-3e61-9a9a-37cfea6cff93",
                                "text": "Cependant, quoique l’oratoire fût dédié à Sainte-Barbe, la statue de Marie-Immaculée occupait la place d'honneur."
                            },
                            {
                                "example_id": "ce2043c9-9421-48bc-b1c2-1f2ac350a36d",
                                "sense_id": "f8c7320c-8f04-3e61-9a9a-37cfea6cff93",
                                "text": "Le chemin qui reliait Plougasnou à Saint-Jean-du-Doigt était ponctué de trois oratoires, dont celui de Notre-Dame-de-Lorette, à Plougasnou."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed799ca3-8f9a-3ef1-baa6-8c9b22015712",
                        "entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                        "glosses": [
                            "De façon générale, pièce destinée à la prière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b773c96-2420-4252-87e9-97826870106f",
                                "sense_id": "ed799ca3-8f9a-3ef1-baa6-8c9b22015712",
                                "text": "C’était devenu un oratoire, où le papier-vitrail des fenêtres tamisait une lumière intime, religieuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d744c95b-15cc-44ca-b514-9dd4f608bd6f",
                        "source_entry_id": "b53d084d-86f9-3fe6-b82c-359f79af5564",
                        "target_lang_word": "oratory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oratory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8da5eaa4-5016-3f5e-a80d-91a01ce6fe86",
                                        "entry_id": "ccdb4116-f593-3cae-a22f-03b4c34ffb98",
                                        "glosses": [
                                            "A private chapel or prayer room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396ad0cb-4ea0-401d-9488-360b7b5bf8b3",
                                                "sense_id": "8da5eaa4-5016-3f5e-a80d-91a01ce6fe86",
                                                "text": "I will retire to my oratory, and pray to the blessed Virgin to inspire you with her holy counsels […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed75713e-39ff-3444-bdb1-1472c1c44f4c",
                                        "entry_id": "ccdb4116-f593-3cae-a22f-03b4c34ffb98",
                                        "glosses": [
                                            "A Roman Catholic chapel; a building for public or private worship that is not a parish church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4330d37f-e995-4da1-b985-15bf5a2a7822",
                                                "sense_id": "ed75713e-39ff-3444-bdb1-1472c1c44f4c",
                                                "text": "By public oratories are meant those attached to monasteries, convents, seminaries, etc., having a public entrance by which the faithful have access to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f177908-8daf-307c-88af-0f117eb6ae7b",
                                        "entry_id": "ccdb4116-f593-3cae-a22f-03b4c34ffb98",
                                        "glosses": [
                                            "A Catholic church belonging to the Oratory of Saint Philip Neri."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0546d04-cd56-4264-920f-34e3b407e884",
                                                "sense_id": "2f177908-8daf-307c-88af-0f117eb6ae7b",
                                                "text": "They had been given the old Oscott College premises as a temporary home, but were content there until Oratories could be established in the cities. St Philip Neri had specifically intended that the Oratory should be a city-based form of communal and missionary life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oratory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b79661e9-9e0c-36ff-aa72-177a04d87930",
                                        "entry_id": "3af0c789-1d84-3b0d-9b6a-7572ddad7780",
                                        "glosses": [
                                            "The art of public speaking, especially in a formal, expressive, or forceful manner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3045177f-eeba-39de-9a44-32f24608f006",
                                        "entry_id": "3af0c789-1d84-3b0d-9b6a-7572ddad7780",
                                        "glosses": [
                                            "Eloquence; the quality of artistry and persuasiveness in speech or writing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606b4230-1520-4fc5-acc3-b07b2262ba3b",
                                                "sense_id": "3045177f-eeba-39de-9a44-32f24608f006",
                                                "text": "Rising from humble farmhand to community organizer to a leader of the national Fatah party, Mr. Barghouti became known for his soaring oratory and common touch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
