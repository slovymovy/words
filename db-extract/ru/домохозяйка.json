                "translations": [
                    {
                        "translation_id": "f5d40a46-9510-42f7-ad4c-9cc627dbb2cd",
                        "source_entry_id": "58dc8812-f072-35af-b3fe-3851e64ad0aa",
                        "source_sense_description": "женщина, ведущая домашнее хозяйство",
                        "target_lang_word": "housewife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housewife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71a368d-0324-327c-915a-91dd24f47e73",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A woman whose main employment is homemaking, maintaining the upkeep of her home and tending to household affairs; often, such a woman whose sole [unpaid] employment is homemaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510ecf74-b592-4305-bbca-6d11db1a032d",
                                                "sense_id": "b71a368d-0324-327c-915a-91dd24f47e73",
                                                "text": "2000, Uli Kusch, \"Mr. Torture\", Helloween, The Dark Ride\nMr Torture sells pain / To the housewives in Spain / He knows just what they crave / Mr Torture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "314e8e25-70c7-30ad-82da-488e12772450",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "The wife of a householder; the mistress of a family; the female head of a household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A little case or bag for materials used in sewing, and for other articles of female work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5cc0235-8a9a-4368-9aa1-e12aefe9ef71",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "It was a housewife, containing needles, a bodkin, and thread; ‘and, do you know,’ added he, ‘it was the most useful thing she could have given me, for it lasted all the time I was at Rome to mend my clothes with […].’"
                                            },
                                            {
                                                "example_id": "28ea052f-5ef7-4ad5-a14f-27bf1eb29d08",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "Woffington's housewife, made by herself, homely to the eye, but holds everything in the world"
                                            },
                                            {
                                                "example_id": "3eb0a422-8cd8-4ac9-802d-a52da2a47131",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "The \"soldier's housewife\" was a small sewing kit that was carried to make timely repairs to clothing and equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8429ea-80c9-328e-a31f-58f2c17ed534",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A worthless woman; a hussy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "housewife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c784e2c0-94c3-3e6a-834e-edeae01c58bd",
                                        "entry_id": "4cbbea62-61ff-3a33-9fcd-10bf7ead4b57",
                                        "glosses": [
                                            "Alternative form of housewive."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94de3f22-f60c-4f57-bca9-c53a40eeec0f",
                                                "sense_id": "c784e2c0-94c3-3e6a-834e-edeae01c58bd",
                                                "text": "Career opportunity […] is the one who never knocks — especially not on the doors of women, who are still hooking, housewifing and hairdressing for their livings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8a1495f-ce1e-4b59-9564-a0bbd4d7c3a7",
                        "source_entry_id": "58dc8812-f072-35af-b3fe-3851e64ad0aa",
                        "source_sense_description": "женщина, ведущая домашнее хозяйство",
                        "target_lang_word": "gospodyni domowa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gospodyni domowa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "39526aee-66ac-30f2-adbb-702ef6f274f2",
                                        "entry_id": "1311dae9-79cb-314b-a16c-95c19097f4db",
                                        "glosses": [
                                            "kobieta, która zajmuje się własnym domem i opieką nad dziećmi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936d4e59-a69e-4c6b-a4f6-ff66daf9aeb8",
                                                "sense_id": "39526aee-66ac-30f2-adbb-702ef6f274f2",
                                                "text": "… pokazywanie w większości reklam kobiety jako gospodyni domowej lub pięknej, ale niezbyt mądrej istoty jest częścią ideologii, która czyni kobiety obywatelami drugiej kategorii"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab2cc671-e476-43c2-b38b-a75cf0c2eeaf",
                        "source_entry_id": "58dc8812-f072-35af-b3fe-3851e64ad0aa",
                        "source_sense_description": "женщина, ведущая домашнее хозяйство",
                        "target_lang_word": "maîtresse de maison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maîtresse de maison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                        "entry_id": "8c5e5b94-fdb7-3769-a432-f49fd819e4e9",
                                        "glosses": [
                                            "Celle qui dirige la maison, qui reçoit des visites ou des invités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5b0f37-a152-49a7-9919-dc34a62402bf",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Comme maîtresse de maison, Alix a en gouvernation les clefs des appartements."
                                            },
                                            {
                                                "example_id": "f0dc69a0-334a-48eb-b6f5-e4f7e8b6bc13",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "La maîtresse de maison a, dans Homère, la moitié du gouvernement, tous les soins intérieurs, ceux même de l’hospitalité. Elle siège vis-à-vis du mari, et comme son égale, au foyer."
                                            },
                                            {
                                                "example_id": "910a0d7e-eb67-40ab-8e3a-216079e75e0f",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "De toutes les maîtresses de maison où il dînait, Mme Berthier était la seule que Pons nommât de son petit nom : il lui disait : « Félicie ! » et il croyait parfois être compris par elle."
                                            },
                                            {
                                                "example_id": "f94290fe-5210-494e-8b9e-c829f1dcefee",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Fierté des maîtresses de maison formées aux traditions familiales, la blanquette est, révérence gardée, à la cuisine française ce que Molière est au théâtre."
                                            },
                                            {
                                                "example_id": "254521ac-50e5-4469-9abb-414b49f542c0",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Je suis une maîtresse de maison désastreuse, mais je rattrape le coup en mettant tout en place à la one again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
