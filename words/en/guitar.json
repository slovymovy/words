    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78e45849-cc27-3b41-9c0a-397c81f95f7b",
                    "sense_definition": "A stringed musical instrument, of European origin, usually with a fretted fingerboard and six strings, played with the fingers or a plectrum.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He plays the <w>guitar</w> in a rock band.",
                            "target_lang_translations": {
                                "ru": "Он играет на <w>гитаре</w> в рок-группе.",
                                "zh": "他在一支摇滚乐队里弹<w>吉他</w>。"
                            }
                        },
                        {
                            "text": "I bought a new acoustic <w>guitar</w> for my music lessons.",
                            "target_lang_translations": {
                                "ru": "Я купил новую акустическую <w>гитару</w> для уроков музыки.",
                                "zh": "我买了一把新的原声<w>吉他</w>用来上音乐课。"
                            }
                        }
                    ],
                    "synonyms": [
                        "axe"
                    ],
                    "common_phrases": [
                        "play the guitar",
                        "acoustic guitar",
                        "electric guitar",
                        "bass guitar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Струнный музыкальный инструмент, обычно с ладами и шестью струнами, на котором играют пальцами или медиатором.",
                        "zh": "一种源于欧洲的弦乐器，通常有品位指板和六根弦，用手指或拨片弹奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гитара",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吉他",
                                "target_lang_sense_clarification": "乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3982d896-08f6-3811-b638-f968ab9955b3",
                    "sense_definition": "Any type of musical instrument of the lute family, characterized by a flat back, along with a neck whose upper surface is in the same plane as the soundboard.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum curator explained that this ancient instrument is technically a <w>guitar</w>.",
                            "target_lang_translations": {
                                "ru": "Куратор музея объяснил, что этот древний инструмент технически является <w>гитарой</w>.",
                                "zh": "博物馆馆长解释说，这件古老的乐器从技术上讲属于<w>吉他</w>。"
                            }
                        },
                        {
                            "text": "Scholars classify the instrument as a <w>guitar</w> because of its flat back and neck structure.",
                            "target_lang_translations": {
                                "ru": "Ученые классифицируют этот инструмент как <w>гитару</w> из-за его плоской задней деки и строения грифа.",
                                "zh": "学者们根据其平坦的背部和琴颈结构，将这种乐器归类为<w>吉他</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой музыкальный инструмент семейства лютневых, характеризующийся плоской задней декой.",
                        "zh": "鲁特琴族的一种乐器，特点是背部平坦，琴颈上表面与音板处于同一平面。"
                    },
                    "translations": {
