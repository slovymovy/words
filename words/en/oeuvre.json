                    "sense_id": "9785f094-4f9f-3d69-8dbf-fb6461a18a7b",
                    "sense_definition": "The complete body of work produced by a particular artist, writer, or composer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artistic output",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum is hosting a retrospective exhibition covering the artist's entire <w>oeuvre</w>.",
                            "target_lang_translations": {
                                "ru": "В музее проходит ретроспективная выставка, охватывающая все <w>творчество</w> художника."
                            }
                        },
                        {
                            "text": "Scholars spent decades studying the <w>oeuvre</w> of Mozart to understand his musical evolution.",
                            "target_lang_translations": {
                                "ru": "Ученые десятилетиями изучали <w>наследие</w> Моцарта, чтобы понять его музыкальную эволюцию."
