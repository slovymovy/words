            {
                "entry_id": "af85566e-c1e8-3399-aecf-e28e5061547b",
                "word": "ragougnasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9bf2e02e-1b91-4aeb-bd80-907ca7b5e4be",
                        "entry_id": "af85566e-c1e8-3399-aecf-e28e5061547b",
                        "tags": [
