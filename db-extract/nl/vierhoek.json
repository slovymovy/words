                "translations": [
                    {
                        "translation_id": "a1768844-f5c7-4cee-b8ea-1dac50cf55c7",
                        "source_entry_id": "1d7d7d19-b931-3103-88ea-a631759c3ca1",
                        "source_sense_id": "af5dc4ba-b2f4-30d1-80b6-32351df7c531",
                        "source_sense_description": "een geometrische tweedimensionale vorm, bestaande uit vier hoeken en derhalve ook vier zijden",
                        "target_lang_word": "Viereck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viereck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa2ca08-f9bd-3e8f-99db-91fd68e21c9c",
                                        "entry_id": "8ef09d85-de6b-3e2e-b30d-89877db4ef4e",
                                        "glosses": [
                                            "ebenes (zweidimensionales) Vieleck (Polygon) mit vier Ecken und vier Seiten"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3994e9-42c7-4a5b-8104-829010d35c83",
                                                "sense_id": "7fa2ca08-f9bd-3e8f-99db-91fd68e21c9c",
                                                "text": "„Die Summe der Innenwinkel eines Vierecks beträgt 360°: α + β + ɣ + δ = 360°“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                        "entry_id": "8ef09d85-de6b-3e2e-b30d-89877db4ef4e",
                                        "glosses": [
                                            "einem Quadrat oder Rechteck ähnliche Form/Figur"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de721290-1d64-4a0c-987c-f48c143862cd",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Ein gerahmtes Bild, von unten gesehen, erscheint nicht wie ein Viereck sondern verliert seine Proportionen und rechte Winkel.“"
                                            },
                                            {
                                                "example_id": "ef2f3ad0-ea24-420f-a92d-a1fd5d0bea2d",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Sie waren etwas erweiterte Lichtspalten, rimae weniger Quadrate als Rechtecke, breit unter 2 bis gegen 3 Fuß, 63 bis 94 cm (Diocletian-Palast), hoch 3 Fuß bis 6 Fuß 8 Zoll (Diocletian), 94 bis 210 cm, oben auch mit dem Bogen schließend, mit dem Doppelbogen, mit Gesimszugabe aus Ziegel und Stein; übrigens mögen auch breite niedrige Viereck-Fenster und rundliche nicht gefehlt haben.“"
                                            },
                                            {
                                                "example_id": "25b2542d-e60d-462a-982c-d0a95c9950c0",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Das Viereck ist also nur ein Ausschnitt, man hat es in seiner Phantasie in alle Richtungen endlos auszudehnen.“"
                                            },
                                            {
                                                "example_id": "c59b52b7-c475-4b56-a04f-e860c6841736",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Unter dem Viereck gewaltiger Steinblöcke sollen sich einige Grabkammern befinden, in denen angeblich reich verzierte Tongefäße wie auch menschliche Knochen und Schädel entdeckt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "386ef27c-61c0-460c-9515-67e68dd32217",
                        "source_entry_id": "1d7d7d19-b931-3103-88ea-a631759c3ca1",
                        "source_sense_id": "af5dc4ba-b2f4-30d1-80b6-32351df7c531",
                        "source_sense_description": "een geometrische tweedimensionale vorm, bestaande uit vier hoeken en derhalve ook vier zijden",
                        "target_lang_word": "quadrangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "637eca70-9acc-3c9d-8f32-c3b337130254",
                                        "entry_id": "855358e4-0be6-33f0-b65e-4b431d8fa27e",
                                        "glosses": [
                                            "A geometric shape with four angles and four straight sides; a four-sided polygon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2375a05-6d2d-3cd2-8f12-d0e617845a9c",
                                        "entry_id": "855358e4-0be6-33f0-b65e-4b431d8fa27e",
                                        "glosses": [
                                            "A courtyard which is quadrangular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c6a340-ba3e-4c61-9588-f7fb0b60448d",
                                                "sense_id": "d2375a05-6d2d-3cd2-8f12-d0e617845a9c",
                                                "text": "I looked up from my desk and saw that suddenly there were big flakes twirling down into the quadrangle, settling on the carefully pruned shrubbery bordering the crosswalks, the three elms still holding many of their leaves, the still-green lawns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85df38b8-7ab0-3cba-ba02-d018c882ca12",
                                        "entry_id": "855358e4-0be6-33f0-b65e-4b431d8fa27e",
                                        "glosses": [
                                            "The buildings forming the border of such a courtyard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c637379-984f-4e1d-9178-5f8fe4739a70",
                                                "sense_id": "85df38b8-7ab0-3cba-ba02-d018c882ca12",
                                                "text": "The quadrangle surrounding the Far Common was never considered absolutely essential to the Devon School."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "175821a5-04ed-4571-bea8-6a2fbeac2906",
                        "source_entry_id": "1d7d7d19-b931-3103-88ea-a631759c3ca1",
                        "source_sense_id": "af5dc4ba-b2f4-30d1-80b6-32351df7c531",
                        "source_sense_description": "een geometrische tweedimensionale vorm, bestaande uit vier hoeken en derhalve ook vier zijden",
                        "target_lang_word": "quadrilatère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrilatère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64f9cdff-45de-3350-b9fc-c6d264d86b1e",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Polygone qui a quatre côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c2952a-72b5-46b1-bd30-53d1e0ae7643",
                                                "sense_id": "64f9cdff-45de-3350-b9fc-c6d264d86b1e",
                                                "text": "Les côtés d’un quadrilatère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Espace limité par quatre côtés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606f2afd-ccdc-47a2-9765-35fc1f084b16",
                                                "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                                "text": "Le troupeau des faisans fonctionne dans le quadrilatère que forment les rues Montmartre et Richelieu d’un côté, les boulevards et le rue Réaumur de l’autre."
                                            },
                                            {
                                                "example_id": "72347593-8a0d-4de9-9420-686256d2bcb6",
                                                "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                                "text": "Ils ont ensuite déambulé dans le quadrilatère autour du quartier général du Service de police de SherbrookeSPS, escortés par les policiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9f373f-96af-3c71-9db0-07fa492241a5",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Bloc de terrain compris entre les rues qui le bordent. → voir pâté de maisons"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87494c29-d144-4adb-a7e1-1a68e08f599a",
                                                "sense_id": "4f9f373f-96af-3c71-9db0-07fa492241a5",
                                                "text": "Ces édifices en vinrent à occuper des quadrilatères complets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a66e73b-9e11-35fd-a788-39007b2567af",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Espace limité par quatre côtés, dont quatre forteresses occupent les angles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689aa475-ce49-4812-ad97-70716316e672",
                                                "sense_id": "8a66e73b-9e11-35fd-a788-39007b2567af",
                                                "text": "Ces quatre forteresses sont placées de manière à former un quadrilatère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrilatère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                        "entry_id": "d30fb55e-59dd-3e2d-af6e-cef5fdbcdd32",
                                        "glosses": [
                                            "Qui a quatre côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a6d845-5e73-4d1b-8208-af1f76a45f16",
                                                "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                                "text": "Appliqué contre la face externe de la branche du maxillaire inférieur, le masséter est court, large et très-épais, aplati d’un côté à l’autre, de forme irrégulièrement quadrilatère, formé de plans superposés dont deux principaux, qui sont parfaitement distincts, près de l’articulation temporo-maxillaire, par la direction un peu différente de leurs fibres."
                                            },
                                            {
                                                "example_id": "56acb375-79df-4cfa-9b31-6137645619f9",
                                                "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                                "text": "Les labiales supérieures sont au nombre de six, et de grandeur assez inégale ; […] elles ont une forme quadrilatère […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
