                    {
                        "sense_id": "1c066564-67af-304d-8c36-0129755eb0c1",
                        "entry_id": "6bcbf8ad-e168-3897-bd9a-c24cba9f42d5",
                        "glosses": [
                            "chaotische toestand"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "27e5bdcc-3e03-4120-b661-5a2a9472ee14",
                                "sense_id": "1c066564-67af-304d-8c36-0129755eb0c1",
                                "text": "Ik was behoorlijk in de war toen ik teveel gedronken had."
                            },
                            {
                                "example_id": "f63e1740-da01-46c6-b1d9-40b497a5bbf9",
                                "sense_id": "1c066564-67af-304d-8c36-0129755eb0c1",
                                "text": "Zou Annet zich een jaar na dato nog steeds op die plek bevinden? Toen ik in die meest bittere rouwfase zat, kort na Caspers dood, was ik soms zo in de war dat ik niet meer wist welke dag het was of wanneer ik voor het laatst had gegeten."
                            },
                            {
                                "example_id": "c7cf6dc1-4117-430c-aeb5-5f9e58db4d87",
                                "sense_id": "1c066564-67af-304d-8c36-0129755eb0c1",
                                "text": "Misschien weten enig kinderen dit allang, en zijn het alleen broers, zussen en hun ouders die in de war zijn."
                            }
                        ]
                    }
                ],
