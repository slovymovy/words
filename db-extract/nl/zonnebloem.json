                                        "entry_id": "6eeea2fe-6f09-3708-b44c-f31049cadea0",
                                        "glosses": [
                                            "Any plant of the genus Helianthus, so called probably from the form and color of its floral head, having the form of a large disk surrounded by yellow ray flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f7e1ff-218f-4937-b03d-574e5a7ecccd",
                                                "sense_id": "96f3f351-c788-3604-8e4b-d1b5bf6cd72b",
                                                "text": "The flowers glowed red and golden: snapdragons and sunflowers, and nasturtians trailing all over the turf walls and peeping in at the round windows."
                                            },
                                            {
                                                "example_id": "d9cf30ad-aed5-4132-a4e3-68ef8e0bebb0",
                                                "sense_id": "96f3f351-c788-3604-8e4b-d1b5bf6cd72b",
                                                "text": "The low-beamed Bell Inn, believed to date from 1520, is locally renowned for its garden where giant sunflowers grow. In 1978, one reached the spectacular height of 23 ft 6 in."
                                            }
                                        ]
                                    },
