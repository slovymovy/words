                    {
                        "sense_id": "5bf24269-556c-317b-8bf7-3648044d848d",
                        "entry_id": "0980def4-959a-3b0d-a39a-a4c93bb1fe98",
                        "glosses": [
                            "A trifling quantity or amount."
                        ],
                        "tags": [
                            "Maine",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "64f32168-c97c-4b58-b91c-17d4ca0717fb",
                                "sense_id": "5bf24269-556c-317b-8bf7-3648044d848d",
                                "text": "A “dite” is a Maine measurement, somewhere between a smidge and a bit."
                            },
                            {
                                "example_id": "f65437be-307d-4ff5-8ee0-dface3b0c91e",
                                "sense_id": "5bf24269-556c-317b-8bf7-3648044d848d",
                                "text": "Two carpenters were moving a small building onto a new foundation, and one of them says, “Shove it my way a dite!” The other shoved, but shoved a little too hard. “Nope — too much! I said a dite!”"
                            },
                            {
                                "example_id": "8eff430d-eabc-460f-8670-004aed2cf399",
                                "sense_id": "5bf24269-556c-317b-8bf7-3648044d848d",
                                "text": "“Set your calipers a dite bigger’n the hole so’s they’ll fit good and snug.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
