                    {
                        "sense_id": "bc94a8fe-ed30-3ebf-8ca5-5cf942d65e6c",
                        "entry_id": "ed232eb8-fe10-3108-995c-eb9f90cbe654",
                        "glosses": [
                            "zeer groot viermotorig vliegtuig voor vervoer van passagiers en vracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee9a5d11-8b78-4a20-ab2f-8814ab766c38",
                                "sense_id": "bc94a8fe-ed30-3ebf-8ca5-5cf942d65e6c",
                                "text": "Er zijn net iets meer dan 1500 jumbo's gemaakt sinds 1970."
                            },
                            {
                                "example_id": "6f83d34a-b968-4fca-8152-ee0e77e809d6",
                                "sense_id": "bc94a8fe-ed30-3ebf-8ca5-5cf942d65e6c",
                                "text": "De geweldige hangar aan de overkant van Schiphol, waar de jumbo's worden onderhouden – eigenlijk niet meer dan een kolossale doos – heeft zijn eigen schoonheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "a396692a-77b1-3824-8da6-cf3821dc2f42",
                        "entry_id": "ed232eb8-fe10-3108-995c-eb9f90cbe654",
                        "glosses": [
                            "aanduiding voor een olifant"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4796299d-558a-4946-aa5a-922b230b33ff",
                                "sense_id": "a396692a-77b1-3824-8da6-cf3821dc2f42",
                                "text": "De jumbo nam de pinda met zijn lange slurf aan."
                            },
                            {
                                "example_id": "858729d3-9763-4a76-8265-db9dceaeed83",
                                "sense_id": "a396692a-77b1-3824-8da6-cf3821dc2f42",
                                "text": "Hee meid met je mooie palmboom zou je niet opzij gaan voor de koning van de vetzakken, ik bedoel van de zware dieren, deze jumbo dus. Ik kijk om naar een soort het lijkt wel een ceremoniemeester die de olifant uitlaat of aan een touw de pont optrekt."
                            }
                        ]
                    }
