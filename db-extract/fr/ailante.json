                    {
                        "form_id": "ce210843-86cd-4d41-9c6d-25a47ddb733c",
                        "entry_id": "734213d7-8ecc-3181-ac98-274133b181a5",
                        "tags": [],
                        "form": "ailanthe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed4635af-bdf9-351a-9caa-641c65d68536",
                        "entry_id": "734213d7-8ecc-3181-ac98-274133b181a5",
                        "glosses": [
                            "Arbre de l’Asie orientale et l'Australasie, dont les feuilles d'une des espèces servent à la nourriture de la chenille du bombyx de l'ailante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24326db5-862e-4bce-a824-b3ed6887efea",
                                "sense_id": "ed4635af-bdf9-351a-9caa-641c65d68536",
                                "text": "Du jardin même où je me balance aujourd’hui dans le hamac suspendu entre un marronnier et un ailante, j’entendais, enfant, s’animer les matins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5257809a-727c-41c0-8796-82120e85c97c",
                        "source_entry_id": "734213d7-8ecc-3181-ac98-274133b181a5",
                        "source_sense_id": "ed4635af-bdf9-351a-9caa-641c65d68536",
                        "target_lang_word": "Götterbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Götterbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5402d02-e51e-35eb-a41a-dcb5b246ee61",
                                        "entry_id": "03e855dd-9b7a-3caa-a839-e40aeec07f81",
                                        "glosses": [
                                            "eine ursprünglich aus China stammende Art der Laubbäume, seit Mitte des 18. Jahrhunderts international verbreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3297bbf0-3305-4016-a4cb-da472334bd60",
                                                "sense_id": "a5402d02-e51e-35eb-a41a-dcb5b246ee61",
                                                "text": "„Ursprünglich ist der Götterbaum in China und im nördlichen Vietnam beheimatet. Seit Mitte des 18. Jahrhunderts wurde die Art in anderen Teilen Asiens sowie in Europa, Amerika, später in Afrika und Australien angepflanzt, wo sie als invasive Art gilt.“"
                                            },
                                            {
                                                "example_id": "8b4d907b-5809-4cc5-a3af-204c97925cc7",
                                                "sense_id": "a5402d02-e51e-35eb-a41a-dcb5b246ee61",
                                                "text": "„Als die Gartenfrau einmal ein Blatt von einem Götterbaum mitbrachte und die Größe schätzte, kam plötzlich Einspruch aus der stummen Ecke: \"Das ist keinen Meter lang\". Das Nachmessen habe dann 97 Zentimeter ergeben. Die Seniorin war früher Schneiderin mit feinem Augenmaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "667abf90-d5d5-478d-bcf1-d9e3a1ed27ea",
                        "source_entry_id": "734213d7-8ecc-3181-ac98-274133b181a5",
                        "source_sense_id": "ed4635af-bdf9-351a-9caa-641c65d68536",
