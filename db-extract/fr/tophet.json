                        "glosses": [
                            "Sanctuaire où l’on inhumait des enfants ou, selon une autre hypothèse, on les sacrifiait puis les inhumait."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "953dbc11-4464-4f85-a8fa-ce4d0d600ad6",
                                "sense_id": "d4d6fa45-53d8-30d0-a3f7-5b92c9363bf2",
                                "text": "Le tophet de Carthage, aussi appelé tophet de Salammbô, est une ancienne aire sacrée dédiée aux divinités phéniciennes Tanit et Baal situé dans le quartier carthaginois de Salammbô, en Tunisie."
                            }
                        ]
                    }
