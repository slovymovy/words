                    },
                    {
                        "translation_id": "6f923b98-c902-43a1-919f-198e49d02ce2",
                        "source_entry_id": "6dd4b58d-a1fa-365a-98e2-d97e180b4642",
                        "source_sense_id": "5b9726a6-48ad-3527-81f8-7540df18408b",
                        "target_lang_word": "intelligiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intelligiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b409ab-e19f-3aaa-9f3c-575354e291cb",
                                        "entry_id": "46a5ddf9-2f6c-313a-ab0c-21fd100cbfb7",
                                        "glosses": [
                                            "D’une manière facile à comprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c7e00ef-b891-4944-af18-7ad30ec209b5",
                                                "sense_id": "f9b409ab-e19f-3aaa-9f3c-575354e291cb",
                                                "text": "Lesquels, non contents de savoir tout ce qui est intelligiblement expliqué dans leur auteur, veulent outre cela y trouver la solution de plusieurs difficultés dont il ne dit rien et auxquelles il n'a peut-être jamais pensé."
                                            },
                                            {
                                                "example_id": "7aeb426f-e724-437d-9bf2-f8778b09af6d",
                                                "sense_id": "f9b409ab-e19f-3aaa-9f3c-575354e291cb",
                                                "text": "Il parlait français fort intelligiblement."
                                            },
                                            {
                                                "example_id": "03029d69-3ae1-4aa6-8c7e-0861c67a722b",
                                                "sense_id": "f9b409ab-e19f-3aaa-9f3c-575354e291cb",
                                                "text": "Il a prononcé intelligiblement."
                                            },
                                            {
                                                "example_id": "35a4cc7f-b4cc-48ad-9704-f3a8cce976d2",
                                                "sense_id": "f9b409ab-e19f-3aaa-9f3c-575354e291cb",
                                                "text": "La présence de Dieu se rendait sensible par les oracles qui sortaient intelligiblement du milieu de l’arche entre les deux chérubins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1bb9bc-4187-3e66-a23b-14224bcdeffe",
                                        "entry_id": "46a5ddf9-2f6c-313a-ab0c-21fd100cbfb7",
                                        "glosses": [
                                            "D’une façon appartenant à l’ordre de l’intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7fd7a3a-b609-4bec-a04f-bb3e9ce1f366",
                                                "sense_id": "4a1bb9bc-4187-3e66-a23b-14224bcdeffe",
                                                "text": "Par la grandeur et la beauté de la créature, on pouvait voir et connaître intelligiblement le créateur."
                                            },
                                            {
                                                "example_id": "0691c138-778e-4279-89e5-a3d8de223a07",
                                                "sense_id": "4a1bb9bc-4187-3e66-a23b-14224bcdeffe",
                                                "text": "Il [Platon] appelle quelquefois la matière éternelle ; par où il n'a pas voulu faire entendre qu’elle subsistait visiblement de toute éternité, mais qu’elle subsistait intelligiblement dans l’idée éternelle de Dieu ; c’est ce qu’il entend lorsqu'il dit : l’exemplaire du monde est de toute éternité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84edfe54-8ec5-4f20-a43a-720eb6050814",
                        "source_entry_id": "6dd4b58d-a1fa-365a-98e2-d97e180b4642",
                        "source_sense_id": "5b9726a6-48ad-3527-81f8-7540df18408b",
                        "target_lang_word": "clairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "D’une manière claire et nette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a07e334-3376-4e75-b122-fa360b162691",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Les principaux problèmes auxquels il faudra faire face dans vingt ans sont clairement posés : la Corée du Nord et l’Iran auront-ils à cette date une arme nucléaire qui puisse être vectorisée ?"
                                            },
                                            {
                                                "example_id": "cb1d0246-8a3b-40d5-bae2-d1bcb1d17394",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Si vous vous expliquiez un peu plus clairement."
                                            },
                                            {
                                                "example_id": "5b5c360e-5448-4564-93d3-ef4dda66808b",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "[Elle] […] fait voir clairement les merveilleux effets Qu’en un cœur irrité produisent les bienfaits."
                                            },
                                            {
                                                "example_id": "2d18c738-88df-4e7b-b6bf-79138f37f2a2",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Ce que l’on conçoit bien s’énonce clairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "Indéniablement, sans aucun doute."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403dffde-55df-4e1f-8dc5-947e3ba31359",
                                                "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                                "text": "C’est clairement moins cher dans ce magasin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
