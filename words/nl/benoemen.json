                    "frequency": "High",
                    "semantic_group_id": "identificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om het probleem te <w>benoemen</w> voordat we naar een oplossing zoeken.",
                            "target_lang_translations": {
