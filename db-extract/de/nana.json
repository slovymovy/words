                "senses": [
                    {
                        "sense_id": "dec281d6-91f6-33a6-ab7c-b94dcff4fdbd",
                        "entry_id": "698bc5b7-1255-3190-80fd-025218da710e",
                        "glosses": [
                            "weibliche Plastik der französischen Künstlerin Niki de Saint Phalle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea466da8-a419-4fde-baad-215ac3901dc5",
                                "sense_id": "dec281d6-91f6-33a6-ab7c-b94dcff4fdbd",
                                "text": "„In Hannover war sie am 14. Januar 1974 dabei, als die Nanas am Hohen Ufer aufgestellt wurden und anwesende Hannoveraner Bürger Vorschläge für »deutsche, hannoversche Namen« machten, die sich die Künstlerin gewünscht hatte.“"
                            },
                            {
                                "example_id": "2f164272-6956-4a31-b385-2e2119e23c22",
                                "sense_id": "dec281d6-91f6-33a6-ab7c-b94dcff4fdbd",
                                "text": "„Das ist längst vergessen, denn die Nanas sind mittlerweile so etwas wie ein Wahrzeichen der Stadt geworden, das keiner mehr missen möchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
