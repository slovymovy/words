                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8cfa0bb-490e-47e1-8923-79dc07c99454",
                        "entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "majordomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "798a7524-f755-353a-844a-c248c9d6cdd4",
                        "entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "glosses": [
                            "Chef du service intérieur de la maison d’un souverain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf3d5aa-5fc7-437a-8034-27ab3f837ee7",
                                "sense_id": "798a7524-f755-353a-844a-c248c9d6cdd4",
                                "text": "Le majordome du Pape."
                            },
                            {
                                "example_id": "0b4e6388-f60e-4e99-9e46-baa68db2e957",
                                "sense_id": "798a7524-f755-353a-844a-c248c9d6cdd4",
                                "text": "Le majordome du roi, de la reine d’Angleterre."
                            }
                        ]
                    },
                    {
                        "sense_id": "788331de-2bfc-3e5d-aa24-bb482b51f544",
                        "entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "glosses": [
                            "Personne qui encadre le personnel de service d'une maison."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b894d38a-bbab-43e3-acb0-1647ffc52b62",
                                "sense_id": "788331de-2bfc-3e5d-aa24-bb482b51f544",
                                "text": "Le majordome sortit avec plusieurs serviteurs pour exécuter les ordres de son maître."
                            },
                            {
                                "example_id": "d347819d-99c6-4364-ad4b-2b9f3bd264bd",
                                "sense_id": "788331de-2bfc-3e5d-aa24-bb482b51f544",
                                "text": "Catherine. – Pourquoi ta chambre est-elle aujourd’hui si belle et en si bon état ? je ne croyais pas que l’esprit d’ordre fût ton majordome."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5927d33-dc08-33b2-b2b7-19bbe688ce91",
                        "entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "glosses": [
                            "Valet de nuit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2f78681d-a2da-3d61-8dbf-75fe8835f46f",
                        "entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "glosses": [
                            "Membre du personnel chargé de l’entretien et des services d’un site commercial."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9828798a-a92e-4e7d-87c6-316810a16cd1",
                                "sense_id": "2f78681d-a2da-3d61-8dbf-75fe8835f46f",
                                "text": "La première fois qu’elle avait entendu son… son quoi, d’ailleurs ? son titre ?, la première fois qu’elle avait entendu qu’on l’appelait le majordome de la plage, cela l’avait fait rire, elle en avait à peine cru ses oreilles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a44808a-a261-4c2c-87fd-adb20f8388d8",
                        "source_entry_id": "3961a43c-385c-37ab-a605-afbff83420ec",
                        "target_lang_word": "majordomo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majordomo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "The head servant or official in a royal Spanish or Italian household; later, any head servant in a wealthy household in a foreign country; a leading servant or butler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08989a8b-8ebb-4f3d-b69c-ce26dd613d74",
                                                "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                                "text": "Pancho, the major-domo, came up to say that Colonel Morales was waiting below. Appleby bade him bring out cigars and wine, and rose from his seat when Morales came in."
                                            },
                                            {
                                                "example_id": "841414e2-0492-4876-9f1b-06c1ccd21e00",
                                                "sense_id": "ec158b13-2846-3fa1-9087-170f821c36db",
                                                "text": "In return for ruling over the king's palace, serving as the monarch's alter ego in the domestic sphere, and bearing the burden of accountability, the majordomo was compensated amply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84cc8db-6ec1-3bc3-8b39-5d0923b55d96",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "A manager of a hacienda, ranch or estate."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe201bd-f2c3-4ed8-89e2-eb4bbbc44445",
                                                "sense_id": "e84cc8db-6ec1-3bc3-8b39-5d0923b55d96",
                                                "text": "She called upon a Missouri cousin named Edward Hardy Clark, who became the indispensable majordomo of the Hearst estate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52913b5c-0cb0-3e65-9953-3ab3f5510a07",
                                        "entry_id": "340aca80-1641-36dd-af1b-4db98a844bab",
                                        "glosses": [
                                            "Any overseer, organizer, person in command."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c143c62-4389-4bd6-98a5-bec20831b5b3",
                                                "sense_id": "52913b5c-0cb0-3e65-9953-3ab3f5510a07",
                                                "text": "The United Nation's climate majordomo -- tasked with herding 192 nations toward a do-or-die deal by year's end -- does not have the power to impose an agreement on how to curb greenhouse gases and cope with its consequences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "345f271b-d490-4bb5-9a05-dcc6a7be239b",
