    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2caa3e87-398c-3ee5-b977-74aab2f9e9ee",
                    "sense_definition": "In elk geval; hoe dan ook; ongeacht de omstandigheden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inevitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het maakt niet uit of het regent, ik ga <w>sowieso</w> naar buiten.",
                            "target_lang_translations": {
                                "en": "It doesn't matter if it rains, I'm going outside <w>anyway</w>.",
                                "ru": "Неважно, идет ли дождь, я <w>в любом случае</w> пойду на улицу.",
                                "pl": "Nieważne czy pada deszcz, <w>i tak</w> wychodzę na zewnątrz.",
                                "fr": "Peu importe qu'il pleuve, je sors <w>de toute façon</w>."
                            }
                        },
                        {
                            "text": "Ik wilde <w>sowieso</w> al niet naar dat feest gaan, dus ik vind het niet erg dat het is afgelast.",
                            "target_lang_translations": {
                                "en": "I didn't want to go to that party <w>anyway</w>, so I don't mind that it's cancelled.",
                                "ru": "Я <w>в любом случае</w> не хотел идти на эту вечеринку, так что я не против, что ее отменили.",
                                "pl": "<w>I tak</w> nie chciałem iść na tę imprezę, więc nie przeszkadza mi, że została odwołana.",
                                "fr": "Je ne voulais <w>de toute façon</w> pas aller à cette fête, donc ça ne me dérange pas qu'elle soit annulée."
                            }
                        }
                    ],
                    "synonyms": [
                        "in elk geval",
                        "toch al",
                        "hoe dan ook"
                    ],
                    "common_phrases": [
                        "sowieso niet"
                    ],
                    "target_lang_definitions": {
                        "en": "In any case; no matter what happens; regardless of the circumstances.",
                        "ru": "В любом случае; что бы ни случилось; независимо от обстоятельств.",
                        "pl": "W każdym razie; tak czy siak; bez względu na okoliczności.",
                        "fr": "En tout cas ; de toute façon ; quelles que soient les circonstances."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anyway",
                                "target_lang_sense_clarification": "regardless of other factors"
                            },
                            {
                                "target_lang_word": "in any case",
                                "target_lang_sense_clarification": "no matter what happens"
                            },
                            {
                                "target_lang_word": "regardless",
                                "target_lang_sense_clarification": "despite circumstances"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "в любом случае",
                                "target_lang_sense_clarification": "независимо от того, что произойдет"
                            },
                            {
                                "target_lang_word": "всё равно",
                                "target_lang_sense_clarification": "без разницы; несмотря ни на что"
                            },
                            {
                                "target_lang_word": "так или иначе",
                                "target_lang_sense_clarification": "каким-либо образом; в конечном счете"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tak czy siak",
                                "target_lang_sense_clarification": "bez względu na okoliczności"
                            },
                            {
                                "target_lang_word": "w każdym razie",
                                "target_lang_sense_clarification": "niezależnie od tego, co się wydarzy"
                            },
                            {
                                "target_lang_word": "i tak",
                                "target_lang_sense_clarification": "niezależnie od innych czynników"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "de toute façon",
                                "target_lang_sense_clarification": "quelles que soient les circonstances"
                            },
                            {
                                "target_lang_word": "en tout cas",
                                "target_lang_sense_clarification": "dans tous les cas"
                            },
                            {
                                "target_lang_word": "quand même",
                                "target_lang_sense_clarification": "malgré tout, quoi qu'il arrive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6b83376-9f93-331e-9b48-7777e356cf32",
                    "sense_definition": "Eigenlijk; over het algemeen genomen; überhaupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inevitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben <w>sowieso</w> geen liefhebber van spruitjes, hoe je ze ook klaarmaakt.",
                            "target_lang_translations": {
                                "en": "I'm not a fan of Brussels sprouts <w>to begin with</w>, no matter how you prepare them.",
                                "ru": "Я <w>вообще</w> не любитель брюссельской капусты, как ее ни готовь.",
                                "pl": "Ja <w>w ogóle</w> nie jestem miłośnikiem brukselek, bez względu na to, jak je przyrządzisz.",
                                "fr": "Je ne suis <w>à la base</w> pas amateur de choux de Bruxelles, peu importe comment on les prépare."
                            }
                        },
                        {
                            "text": "Is er <w>sowieso</w> nog wel genoeg tijd om dit project af te ronden?",
                            "target_lang_translations": {
                                "en": "Is there enough time to finish this project <w>at all</w>?",
                                "ru": "Есть ли <w>вообще</w> достаточно времени, чтобы завершить этот проект?",
                                "pl": "Czy <w>w ogóle</w> jest jeszcze wystarczająco dużo czasu, aby ukończyć ten projekt?",
                                "fr": "Reste-t-il <w>seulement</w> assez de temps pour mener à bien ce projet ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "überhaupt"
                    ],
                    "common_phrases": [
                        "sowieso al"
                    ],
                    "target_lang_definitions": {
                        "en": "Actually; generally speaking; at all (often used to reinforce a fundamental fact).",
                        "ru": "Вообще; в принципе; изначально (часто используется для усиления факта).",
                        "pl": "Właściwie; ogólnie rzecz biorąc; w ogóle (często używane do wzmocnienia podstawowego faktu).",
                        "fr": "En soi ; à la base ; généralement parlant ; au fond."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to begin with",
                                "target_lang_sense_clarification": "fundamentally; from the start"
                            },
                            {
                                "target_lang_word": "at all",
                                "target_lang_sense_clarification": "used in questions or negatives to emphasize scope"
                            },
                            {
                                "target_lang_word": "in general",
                                "target_lang_sense_clarification": "as a general rule"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вообще",
                                "target_lang_sense_clarification": "совсем; в целом (часто в отрицаниях или вопросах)"
                            },
                            {
                                "target_lang_word": "в принципе",
                                "target_lang_sense_clarification": "по сути; как правило"
                            },
                            {
                                "target_lang_word": "и так",
                                "target_lang_sense_clarification": "уже; изначально (без дополнительных условий)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "w ogóle",
                                "target_lang_sense_clarification": "używane w pytaniach lub przeczeniach dla podkreślenia zakresu"
                            },
                            {
                                "target_lang_word": "w zasadzie",
                                "target_lang_sense_clarification": "ogólnie rzecz biorąc"
                            },
                            {
                                "target_lang_word": "i tak już",
                                "target_lang_sense_clarification": "od samego początku, bez dodatkowych warunków"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "à la base",
                                "target_lang_sense_clarification": "fondamentalement, dès le départ"
                            },
                            {
                                "target_lang_word": "déjà",
                                "target_lang_sense_clarification": "en premier lieu, pour commencer"
                            },
                            {
                                "target_lang_word": "d'une manière générale",
                                "target_lang_sense_clarification": "globalement, dans l'ensemble"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19fff56-fd5c-39f8-92ec-4ce9572816bb",
                    "sense_definition": "Noodzakelijkerwijs; per se; in alle gevallen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "necessity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een duurder product hoeft niet <w>sowieso</w> van betere kwaliteit te zijn.",
                            "target_lang_translations": {
                                "en": "A more expensive product is not <w>necessarily</w> of better quality.",
                                "ru": "Более дорогой продукт не <w>обязательно</w> должен быть лучшего качества.",
                                "pl": "Droższy produkt nie musi <w>koniecznie</w> być lepszej jakości.",
                                "fr": "Un produit plus cher n'est pas <w>forcément</w> de meilleure qualité."
                            }
                        },
                        {
                            "text": "Dat dit plan mislukt is, betekent niet <w>sowieso</w> dat we moeten stoppen.",
                            "target_lang_translations": {
                                "en": "The fact that this plan failed does not mean <w>automatically</w> that we have to stop.",
                                "ru": "Тот факт, что этот план провалился, не означает <w>автоматически</w>, что мы должны остановиться.",
                                "pl": "To, że ten plan się nie powiódł, nie oznacza <w>automatycznie</w>, że musimy przerwać.",
                                "fr": "Le fait que ce plan ait échoué ne signifie pas <w>automatiquement</w> que nous devons nous arrêter."
                            }
                        }
                    ],
                    "synonyms": [
                        "noodzakelijk",
                        "noodzakelijkerwijs",
                        "per se"
                    ],
                    "common_phrases": [
                        "niet sowieso"
                    ],
                    "target_lang_definitions": {
                        "en": "Necessarily; automatically; by definition.",
                        "ru": "Обязательно; непременно; само по себе.",
                        "pl": "Koniecznie; automatycznie; z definicji.",
                        "fr": "Nécessairement ; automatiquement ; d'office."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessarily",
                                "target_lang_sense_clarification": "inevitably or logically required"
                            },
                            {
                                "target_lang_word": "automatically",
                                "target_lang_sense_clarification": "as a direct result"
                            },
                            {
                                "target_lang_word": "per se",
                                "target_lang_sense_clarification": "by itself"
                            }
                        ],
                        "ru": [
                            {
