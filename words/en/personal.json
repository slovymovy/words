                    ],
                    "antonyms": [
                        "indirect"
                    ],
                    "common_phrases": [
                        "personal attention",
                        "personal meeting",
                        "personal visit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный или сделанный самим человеком лично, а не через кого-то другого."
