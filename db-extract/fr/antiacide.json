                        "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                        "entry_id": "6666c444-aed6-364a-b70e-35e44de2e585",
                        "glosses": [
                            "Qui s’oppose à l’acidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139b8a89-463e-4044-ba3c-af7015b0858e",
                                "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                                "text": "Les bourgeons de Figuier normalisent les excès de secrétions acides, apaisent l’irritation gastrique, permettant le sevrage aux inhibiteurs de la pompe à protons (IPP) ou de tout autre produit antiacide'."
                            },
                            {
                                "example_id": "4915b084-7df7-4b4f-ae18-e799da99af37",
                                "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                                "text": "Selon certaines estimations, la valeur des achats de produits antiacides se chiffrerait en milliards de dollars."
                            }
                        ]
                    }
