                                "sense_id": "74770a90-a979-3690-8efa-2ee2a7e19a08",
                                "text": "Rozmaryn uprawiany jest ze względu na dużą zawartość olejków eterycznych."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "330b8455-8fa2-31ac-ae66-b5457d1ce7ad",
                        "entry_id": "9d9ff2c3-c5b6-3bd6-a6fc-8463192897ae",
