                            {
                                "example_id": "5028a53a-356d-4003-a7b2-944adcf26640",
                                "sense_id": "51794da2-f689-33b1-ba38-6186f30186fd",
                                "text": "Sûr que cézigue va parler de son coffiot, que Paulo et lui ont tenté, six mois plus tôt, de faire bâiller, au forcing !"
                            },
                            {
                                "example_id": "5515afe5-46d5-4edf-97f6-7ffc8e8cf54a",
                                "sense_id": "51794da2-f689-33b1-ba38-6186f30186fd",
                                "text": "— Évidemment, s’il sait où est le coffre… Ton chiffre, hein, il s’en bat l’œil ! Il peut y passer des mois, si ça lui plaît, devant le coffiot. Prendre son temps pour l’ouvrir."
                            },
                            {
                                "example_id": "447aac97-0653-4c02-81f4-f48cff71234b",
                                "sense_id": "51794da2-f689-33b1-ba38-6186f30186fd",
                                "text": "Le banquier décrocha la toile de Turner et la déposa précautionneusement sur le repose-noix. La marine dissimulait une plaque grise de 30 centimètres carrés environ, le coffiot bien juteux."
                            }
                        ]
                    }
