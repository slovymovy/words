                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She fell into a comfortable <w>sprawl</w> in the oversized armchair.",
                            "target_lang_translations": {
                                "ru": "Она <w>развалилась</w> в удобной позе в огромном кресле."
                            }
                        },
                        {
                            "text": "His limbs were in a messy <w>sprawl</w> as he slept on the rug.",
                            "target_lang_translations": {
                                "ru": "Его руки и ноги были <w>беспорядочно раскинуты</w>, пока он спал на коврике."
                            }
                        }
                    ],
                    "target_lang_definitions": {
