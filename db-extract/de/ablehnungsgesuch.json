                        "sense_id": "2ced3447-1f6d-3f7f-a5b4-921f656d0c14",
                        "entry_id": "af954c14-6267-3fce-9c1e-35ef8fda5248",
                        "glosses": [
                            "„ein Antrag, durch welchen ein an einem gerichtlichen Verfahren Beteiligter die Besorgnis geltend machen kann, ein zur Entscheidung berufener Richter sei befangen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a984a84-8190-4cf8-a323-851b98358eed",
                                "sense_id": "2ced3447-1f6d-3f7f-a5b4-921f656d0c14",
                                "text": "Ein Ablehnungsgesuch ist begründet, wenn ein Grund gegeben ist, dessentwegen der Ablehnende von seinem Standpunkt aus nachvollziehbaren Anlaß für die Befürchtung hat, der Rechtspfleger werde nicht unparteiisch sachlich entscheiden."
                            }
                        ],
