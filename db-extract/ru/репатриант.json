                    },
                    {
                        "translation_id": "53ff34a5-44f4-4919-a8bf-28d20c687a4f",
                        "source_entry_id": "934a5d23-c62f-377a-a083-157e751013d6",
                        "source_sense_id": "f6ca2c94-3728-39a3-a5ee-0f3e328c6d9b",
