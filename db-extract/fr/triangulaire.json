                        ]
                    },
                    {
                        "translation_id": "7fbf85dc-6cfb-40fc-844d-44ed818ebc20",
                        "source_entry_id": "2b0a09f1-bec3-3341-b96f-1464975779c2",
                        "source_sense_id": "11d6d3e2-3999-357d-8aa2-e197fae766be",
                        "source_sense_description": "(Par extension) À trois éléments.",
                        "target_lang_word": "ménage à trois",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménage à trois",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                        "entry_id": "49d1dd39-2e3a-378d-a842-ffdb4bbf040f",
                                        "glosses": [
                                            "A household or relationship whereby three people live together as lovers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01306e5-f290-44a7-a19e-5e388935aa0b",
                                                "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                                "text": "Old men frequently marry young girls, but then the portion is high and the ménage à trois common."
                                            },
                                            {
                                                "example_id": "262f3870-4acf-4668-8ae5-c1918a712182",
                                                "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                                "text": "\"We are certainly going to be happy—we three—in this innocent ménage à trois,\" she said. \"I don't know what more you two men could ask for—or I, either—or the children or Eileen."
                                            },
                                            {
                                                "example_id": "07ccd96a-ce4c-44bf-a1bb-dd8985c5118a",
                                                "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                                "text": "[…]if she frowned—and there could be no doubt that she was frowning now—what lay before him, before them? A scamped and mean ménage à trois, existence eked out with the aid of Mrs. Knyvett’s scanty resources, and soured by her laments!"
                                            },
                                            {
                                                "example_id": "cb9e85b1-4e39-40ff-9f48-740e055aecc0",
                                                "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                                "text": "For a while, he lived in a ménage à trois with the poet Paul Eluard and his wife, Gala Diakonova (who would later marry Salvador Dali)."
                                            },
                                            {
                                                "example_id": "c219ead9-37ce-474d-8175-a77eb281264a",
                                                "sense_id": "1423d43f-f655-3280-a6cb-db0094acda73",
                                                "text": "I'm not a prude and I wasn't a prude then, but I couldn't see living in a ménage à trois unless the third member were a girl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8739747a-c626-3371-9a25-97972cfb4293",
                                        "entry_id": "49d1dd39-2e3a-378d-a842-ffdb4bbf040f",
                                        "glosses": [
                                            "A sexual act or experience involving three people; a threesome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d1ff9e-1589-4137-932e-bc29bd35a0af",
                                                "sense_id": "8739747a-c626-3371-9a25-97972cfb4293",
                                                "text": "David and Angela and I had a ménage à trois for about five minutes, but then I made her leave because David and I were gonna play."
                                            },
                                            {
                                                "example_id": "922345d4-d66b-4124-bac4-1f9870bdabaf",
                                                "sense_id": "8739747a-c626-3371-9a25-97972cfb4293",
                                                "text": "No, the two guys don't go for each other; the triad tried a ménage à trois once but stopped because Chris thought it was icky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
