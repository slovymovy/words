{
    "word_family": [
        "skittishly",
        "skittishness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af6b8a6f-443c-3580-8cb8-19d3316d4502",
                    "sense_definition": "Easily scared, nervous, or startled; timid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nervous_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog likes people he knows, but he is <w>skittish</w> around strangers.",
                            "target_lang_translations": {
                                "de": "Der Hund mag Menschen, die er kennt, aber in der Nähe von Fremden ist er <w>scheu</w>."
                            }
                        },
                        {
                            "text": "The loud thunder made the <w>skittish</w> horse jump and run across the field.",
                            "target_lang_translations": {
                                "de": "Der laute Donner ließ das <w>schreckhafte</w> Pferd aufspringen und über das Feld rennen."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumpy",
                        "spookish",
                        "skittery",
                        "skitterish",
                        "squirrelly"
                    ],
                    "antonyms": [
                        "calm",
                        "confident",
                        "bold"
                    ],
                    "common_phrases": [
                        "skittish horse",
                        "skittish animal"
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht zu erschrecken, nervös oder scheu; ängstlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schreckhaft",
                                "target_lang_sense_clarification": "leicht erschreckend"
                            },
                            {
                                "target_lang_word": "scheu",
                                "target_lang_sense_clarification": "zurückhaltend, ängstlich gegenüber Fremden oder Tieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "441a5811-ba22-3739-8865-3290097fa7a5",
                    "sense_definition": "Difficult to manage, control, or predict; tricky.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unpredictable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors remained cautious due to the <w>skittish</w> stock market.",
                            "target_lang_translations": {
                                "de": "Investoren blieben aufgrund des <w>nervösen</w> Aktienmarktes vorsichtig."
                            }
                        },
                        {
                            "text": "The sailboat was hard to steer in such <w>skittish</w> winds.",
                            "target_lang_translations": {
                                "de": "Das Segelboot war bei solch <w>unberechenbaren</w> Winden schwer zu steuern."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumpy"
                    ],
                    "antonyms": [
                        "stable",
                        "predictable"
                    ],
                    "common_phrases": [
                        "skittish market"
                    ],
                    "target_lang_definitions": {
                        "de": "Schwer zu handhaben, zu kontrollieren oder vorherzusagen; unbeständig oder nervös."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unberechenbar",
                                "target_lang_sense_clarification": "schwer vorhersehbar, sprunghaft"
                            },
                            {
                                "target_lang_word": "nervös",
                                "target_lang_sense_clarification": "unruhig, schwankend (z. B. Märkte)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "704f90a1-6b61-36bc-9632-d9173dcc145f",
                    "sense_definition": "Fickle, changeable, or playful in an inconstant way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unpredictable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled to capture the attention of her <w>skittish</w> fancy.",
                            "target_lang_translations": {
                                "de": "Er hatte Mühe, die Aufmerksamkeit ihrer <w>launischen</w> Fantasie zu fesseln."
                            }
                        },
                        {
                            "text": "The young artist was known for his <w>skittish</w> moods, changing his style every week.",
                            "target_lang_translations": {
                                "de": "Der junge Künstler war für seine <w>unbeständigen</w> Launen bekannt und änderte jede Woche seinen Stil."
                            }
                        }
                    ],
                    "synonyms": [
                        "squirrelly"
                    ],
                    "antonyms": [
                        "constant",
                        "steadfast"
                    ],
                    "common_phrases": [
                        "skittish fancy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense of being fickle or wanton is literary and dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Launisch, unbeständig oder verspielt auf eine unzuverlässige Art."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "launisch",
                                "target_lang_sense_clarification": "stimmungsumschwänglich, unbeständig"
                            },
                            {
                                "target_lang_word": "unbeständig",
                                "target_lang_sense_clarification": "wechselhaft, nicht konstant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}