                        "examples": [
                            {
                                "example_id": "f2c2068d-fc45-404f-a1aa-d69fa313c659",
                                "sense_id": "58970915-927d-391d-93a6-5e6d536d85c0",
                                "text": "Ik kende Barbara al van de Sneekweek een jaar eerder. Daar hadden wij een eerste amourette: hand in hand wandelen door een laantje, meer niet hoor."
                            },
                            {
                                "example_id": "3cbf4562-42a5-4b83-ab70-8d9db0927d8a",
                                "sense_id": "58970915-927d-391d-93a6-5e6d536d85c0",
                                "text": "Gut o gut, nu RTL-verslaggever Frits Wester (52) weer, die zijn gezinnetje ziet ontploffen omdat zijn wettige echtgenote z’n amourette met een 30-jarige Friezin niet langer pikt."
                            },
                            {
                                "example_id": "f29a10c3-9589-4281-8f21-289e91194810",
                                "sense_id": "58970915-927d-391d-93a6-5e6d536d85c0",
                                "text": "Deze amourette zou even snel aan z'n einde komen als de mijne indertijd, want Robert was een zeer vurig man - wanneer hij uit wrok en onbevredigd verlangen verstrooiing zocht bij een minnares, zou hij er zeker geen genoegen mee nemen door haar op dezelfde manier aan het lijntje te worden gehouden als door Elizabeth."
                            },
                            {
                                "example_id": "7d7ca321-785b-4807-a9a5-456740b5ca70",
                                "sense_id": "58970915-927d-391d-93a6-5e6d536d85c0",
                                "text": "Hij begon een reputatie te krijgen in het aanknopen van amourettes."
                            }
                        ]
                    }
