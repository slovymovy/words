                            },
                            {
                                "target_lang_word": "steal",
                                "target_lang_sense_clarification": "to take something without permission"
                            },
                            {
                                "target_lang_word": "loot",
                                "target_lang_sense_clarification": "to steal goods during a war or riot"
                            }
