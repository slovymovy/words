                "senses": [
                    {
                        "sense_id": "89a62c5a-7f99-35ba-8206-039cd252f247",
                        "entry_id": "c7ef66e7-c95d-3f15-871e-b1cf70049f81",
                        "glosses": [
                            "Dieu-fleuve de la mythologie gréco-romaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2a6a4d-a9e4-4acc-947c-f4e73baa06b7",
                                "sense_id": "89a62c5a-7f99-35ba-8206-039cd252f247",
                                "text": "Le fleuve Asterion fut pere de deux filles nommées Eubora Porcymnæ, & Acrona, qui servirent, à ce qu’on dit, de nourrices à Junon."
                            }
                        ]
                    },
                    {
                        "sense_id": "689b4c98-863f-39b4-b0a0-3e8290cd3fa2",
                        "entry_id": "c7ef66e7-c95d-3f15-871e-b1cf70049f81",
                        "glosses": [
                            "Étoile de la constellation des Chiens de chasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf6864b-605f-4b5c-a121-27c667013f82",
                                "sense_id": "689b4c98-863f-39b4-b0a0-3e8290cd3fa2",
                                "text": "ASTÉRION & CHARA sont des termes d’Astronomie, & signifient les noms des Chiens de chasse qu’on voit sous la queue de la grande ourse."
                            }
                        ]
                    }
                ],
