                {
                    "sense_id": "69b455e1-c16a-3981-8557-13e9db70bafe",
                    "sense_definition": "Copier ou plagier frauduleusement le travail de quelqu'un d'autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a remarqué qu'il avait <w>pompé</w> tout son devoir sur internet.",
                            "target_lang_translations": {
                                "en": "The teacher noticed he had <w>copied</w> his entire homework from the internet.",
                                "ru": "Учитель заметил, что он <w>списал</w> всё своё домашнее задание из интернета.",
                                "de": "Der Lehrer hat bemerkt, dass er seine ganze Hausaufgabe aus dem Internet <w>abgeschrieben</w> hatte.",
                                "es": "El profesor se dio cuenta de que había <w>copiado</w> toda su tarea de internet.",
                                "zh": "老师发现，他整份作业都是从网上<w>抄</w>来的。"
                            }
                        },
                        {
                            "text": "Pendant l'examen de mathématiques, cet élève n'a cessé de <w>pomper</w> sur son voisin.",
                            "target_lang_translations": {
                                "en": "During the maths exam, this pupil kept <w>copying</w> from his neighbour.",
                                "ru": "Во время экзамена по математике этот ученик не переставал <w>списывать</w> у соседа.",
                                "de": "Während der Mathematikprüfung hörte dieser Schüler nicht auf, bei seinem Nachbarn <w>abzuschreiben</w>.",
                                "es": "Durante el examen de matemáticas, este alumno no paró de <w>copiar</w> de su compañero de al lado.",
                                "zh": "数学考试期间，这个学生不停地<w>抄</w>邻座的答案。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pomper sur son voisin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier pour désigner la tricherie scolaire ou le plagiat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To copy or plagiarize someone else's work dishonestly.",
                        "ru": "Нечестно копировать или присваивать чужую работу.",
                        "de": "Die Arbeit eines anderen unerlaubt abschreiben oder als eigene ausgeben.",
                        "es": "Copiar o plagiar de forma fraudulenta el trabajo ajeno.",
                        "zh": "不正当地抄袭或剽窃他人的作品。"
                    },
