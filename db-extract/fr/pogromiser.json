                ],
                "senses": [
                    {
                        "sense_id": "ff88985e-9a7f-3d3d-8bd5-825c1fe391c3",
                        "entry_id": "d865d834-85c1-33cd-9888-46c9c69d8efc",
                        "glosses": [
                            "Procéder à un pogrom, exterminer les Juifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3210cf-540d-4b9b-9053-99787abc2423",
                                "sense_id": "ff88985e-9a7f-3d3d-8bd5-825c1fe391c3",
                                "text": "Après les immenses tueries, il restait quelques dizaines de milliers de Juifs en Pologne, juste de quoi pogromiser sans se donner trop de mal."
                            },
                            {
                                "example_id": "bff91007-8780-49b8-b0a7-d420a0c7d940",
                                "sense_id": "ff88985e-9a7f-3d3d-8bd5-825c1fe391c3",
                                "text": "C’est de la jalousie pure et simple; le même instinct de cour de récréation qui pousse à tyranniser le matheux pousse à pogromiser le macher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75a6a602-eeae-4b55-a7f8-d635c4c23d0b",
