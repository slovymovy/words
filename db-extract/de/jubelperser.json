                "senses": [
                    {
                        "sense_id": "f3bbb3fe-c199-304a-91b5-58e1a5a22d36",
                        "entry_id": "f1c554c0-2ce1-31b6-a72f-3f821e25e914",
                        "glosses": [
                            "ein bestellter, gekaufter Applaudierer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e697a747-f817-46e5-a86c-6a6a44133840",
                                "sense_id": "f3bbb3fe-c199-304a-91b5-58e1a5a22d36",
                                "text": "„Da dürfen nur bewährte ‚Jubelperser‘ aus dem eigenen Verlag die einzelnen Fachbücher und Kommentare überschwenglich im Ergebnis zum Nachteil der Benutzer anpreisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bed3542f-ffe4-4cef-a3fd-0e02e264dff2",
                        "source_entry_id": "f1c554c0-2ce1-31b6-a72f-3f821e25e914",
                        "source_sense_id": "f3bbb3fe-c199-304a-91b5-58e1a5a22d36",
                        "source_sense_description": "ein bestellter, gekaufter Applaudierer",
                        "target_lang_word": "claqueur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claqueur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecdfff1-3c00-3306-ba49-b751acbc4592",
                                        "entry_id": "f2035f26-0471-356a-a806-6138dca97dd3",
                                        "glosses": [
                                            "A member of the claque employed to applaud during a theatre performance."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a6290a-b597-452c-bb98-b4769ca4b168",
                                                "sense_id": "5ecdfff1-3c00-3306-ba49-b751acbc4592",
                                                "text": "“Many a clever fellow fails through life, because the silly fellows, whom half a word well spoken could make his claqueurs, turn him into ridicule. Whatever you are, avoid the fault of most reading men: in a word, don’t be a prig!”"
                                            },
                                            {
                                                "example_id": "d7087933-752e-488a-b964-0263230b71aa",
                                                "sense_id": "5ecdfff1-3c00-3306-ba49-b751acbc4592",
                                                "text": "One hundred and fifty “iron-handed” Vienna theatre claqueurs today formed a trade union, probably the first of its kind in the world. […] The most popular singers have been obliged to give free tickets and even to donate cash, lest the claque retaliate by frantic applause at the wrong moment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
