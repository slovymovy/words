    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2ba63ab-1c1e-3560-8c71-49971be5a56c",
                    "sense_definition": "Het deel van de menselijke geest dat niet direct in het actieve bewustzijn aanwezig is, maar wel invloed uitoefent op het gedrag en de gevoelens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel van onze dagelijkse beslissingen worden ongemerkt gestuurd door ons <w>onderbewuste</w>.",
                            "target_lang_translations": {
                                "en": "Many of our daily decisions are unnoticedly guided by our <w>subconscious</w>."
                            }
                        },
                        {
                            "text": "In zijn dromen kwamen angsten uit het <w>onderbewuste</w> naar boven.",
                            "target_lang_translations": {
                                "en": "In his dreams, fears from the <w>subconscious</w> surfaced."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderbewustzijn"
                    ],
                    "antonyms": [
                        "bewustzijn"
                    ],
                    "common_phrases": [
                        "het menselijk onderbewuste",
                        "angsten uit het onderbewuste"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of the human mind that is not currently in focal awareness, but influences behavior and feelings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subconscious",
                                "target_lang_sense_clarification": "noun"
                            },
                            {
                                "target_lang_word": "subconscious mind",
                                "target_lang_sense_clarification": "noun"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7fcc63ac-2d3c-3a52-b100-45b1a07d17ed",
                    "sense_definition": "Verbogen vorm van het bijvoeglijk naamwoord <w>onderbewust</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed dat vanuit een <w>onderbewuste</w> reactie op het gevaar.",
                            "target_lang_translations": {
                                "en": "She did that out of a <w>subconscious</w> reaction to the danger."
                            }
                        },
                        {
                            "text": "Soms hebben we een <w>onderbewuste</w> drang om bepaalde dingen te vermijden.",
                            "target_lang_translations": {
                                "en": "Sometimes we have a <w>subconscious</w> urge to avoid certain things."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een onderbewuste reactie",
                        "onderbewuste verlangens"
