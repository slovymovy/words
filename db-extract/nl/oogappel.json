                            {
                                "example_id": "552d15a7-f240-4a6d-a880-f831d08cee48",
                                "sense_id": "82d2e9ee-b938-3b42-8ae8-4c3e0e5daa77",
                                "text": "De dokter constateerde de uitpuiling van de oogappel."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cf7f89f-2a86-3c4a-b830-c5efdf44d46e",
                        "entry_id": "93d2d3c3-317d-3f8f-8cb3-b9a31ace5317",
                        "glosses": [
                            "een waardevol bezit"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9f0c938e-55b8-4df2-a9cb-83aeedac87f5",
                                "sense_id": "8cf7f89f-2a86-3c4a-b830-c5efdf44d46e",
                                "text": "Zijn dochter was echt zijn oogappel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a854e147-f0a2-4c76-8445-3a1f03b59b70",
                        "source_entry_id": "93d2d3c3-317d-3f8f-8cb3-b9a31ace5317",
                        "source_sense_id": "82d2e9ee-b938-3b42-8ae8-4c3e0e5daa77",
                        "source_sense_description": "een oogbol",
                        "target_lang_word": "Augapfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augapfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0028b8-4086-30f9-88fa-2b4f3100019b",
                                        "entry_id": "5edee204-69d9-3bca-8715-99ae99c7d5a3",
                                        "glosses": [
                                            "kugelförmiger, wesentlicher Teil des Auges, der in der Augenhöhle sitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a621d04d-6e0f-4124-8c21-d6ce2c0408d7",
                                                "sense_id": "ac0028b8-4086-30f9-88fa-2b4f3100019b",
                                                "text": "„Ein Gefäß platzte im Augapfel, nur mit einer Notoperation konnte die sofortige Erblindung verhindert werden.“"
                                            },
                                            {
                                                "example_id": "b84226f6-1b76-4e20-b4b3-95e6359c081c",
                                                "sense_id": "ac0028b8-4086-30f9-88fa-2b4f3100019b",
                                                "text": "„Kelley ist mit der seltsamen Ruhelosigkeit, die als Vorzeichen die unsichtbare Nähe des Engels verkündet, auf einen Stapel von Säcken hinaufgeklettert und sitzt dort hoch oben mit gekreuzten Beinen, das Kinn vorgestreckt mit dem spitzigen Bart, den Kopf ins Genick gedrückt und die Augäpfel nach innen gedreht, daß nur noch das Weiße darin glitzert wie milchiges Glas.“"
                                            },
                                            {
                                                "example_id": "9a2fdc16-51c0-46f1-9714-c514e81969c3",
                                                "sense_id": "ac0028b8-4086-30f9-88fa-2b4f3100019b",
                                                "text": "„Die Augäpfel waren von der Muskelanstrengung nach oben gedreht und sahen dorthin, wo es in seinem Kopf noch dachte.“"
                                            },
                                            {
                                                "example_id": "8c9147b7-1b01-40fa-b1a0-5a50a6779388",
                                                "sense_id": "ac0028b8-4086-30f9-88fa-2b4f3100019b",
                                                "text": "„Das Weiße im Augapfel war klar, und er sah Gunther mit aufrichtigem, offenem Blick an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c01a4e39-0d72-3cfc-9896-11c421856a6d",
                                        "entry_id": "5edee204-69d9-3bca-8715-99ae99c7d5a3",
                                        "glosses": [
                                            "das Liebste, was man hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bb781b-2d3e-4cc2-9013-fc919c8526ab",
                                                "sense_id": "c01a4e39-0d72-3cfc-9896-11c421856a6d",
                                                "text": "Seine jüngste Tochter ist sein Augapfel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92e1887d-0116-43e2-9312-282ce319da07",
                        "source_entry_id": "93d2d3c3-317d-3f8f-8cb3-b9a31ace5317",
                        "source_sense_id": "82d2e9ee-b938-3b42-8ae8-4c3e0e5daa77",
                        "source_sense_description": "een oogbol",
                        "target_lang_word": "pupil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pupil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a81ed894-3675-3263-8a91-05ca7bfc1abb",
                                        "entry_id": "b3a31241-5a28-31fe-ada5-02b65e95083c",
                                        "glosses": [
                                            "A learner at a school under the supervision of a teacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea84a77-ebce-4bcb-9021-7d700b91d863",
                                                "sense_id": "a81ed894-3675-3263-8a91-05ca7bfc1abb",
                                                "text": "The bell which called the pupils to their lessons can still be seen on the roof."
                                            },
                                            {
                                                "example_id": "a4e7f78f-a5ae-454d-bdd7-d903ba4f08dc",
                                                "sense_id": "a81ed894-3675-3263-8a91-05ca7bfc1abb",
                                                "text": "The Pupil after his Pupillarity, had granted a Diſcharge to one of the Co-tutors, which did extinguiſh the whole Debt of that Co-tutor, and conſequently of all the reſt, they being all correi debendi, lyable by one individual Obligation, which cannot be Diſcharged as to one, and ſtand as to all the reſt."
                                            },
                                            {
                                                "example_id": "73859061-ebf8-4b33-b582-6ba3ecf8db61",
                                                "sense_id": "a81ed894-3675-3263-8a91-05ca7bfc1abb",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "647efcc2-7755-35fd-917d-be1d8e41ae14",
                                        "entry_id": "b3a31241-5a28-31fe-ada5-02b65e95083c",
                                        "glosses": [
                                            "One who studies under supervision of a renowned expert in their field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2da5d1ed-f5f4-4bb6-93ae-2d3ac5cf7f1f",
                                                "sense_id": "647efcc2-7755-35fd-917d-be1d8e41ae14",
                                                "text": "Plato was Socrates' pupil, and in turn Aristotle was Plato's pupil."
                                            },
                                            {
                                                "example_id": "92d82fd8-33a9-4f31-8219-2f164597e205",
                                                "sense_id": "647efcc2-7755-35fd-917d-be1d8e41ae14",
                                                "text": "I understand; it’s because I seem to you to be a worse pupil than the judges in court, because obviously you’ll demonstrate to them that the sorts of things your father did are unjust and hated by all the gods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c1085b7-5868-37a1-81ac-a7cedb54b2ab",
                                        "entry_id": "b3a31241-5a28-31fe-ada5-02b65e95083c",
                                        "glosses": [
                                            "An orphan who is a minor and under the protection of the state."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pupil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa15da36-72e4-32e3-a053-dd203b2f0cdb",
                                        "entry_id": "b7080f7c-9acb-3eee-8cc2-25cddac54fce",
                                        "glosses": [
                                            "The hole in the middle of the iris of the eye, through which light passes to be focused on the retina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632e3207-5e94-49c1-b1d9-f6c283f3efa3",
                                                "sense_id": "aa15da36-72e4-32e3-a053-dd203b2f0cdb",
                                                "text": "There are sharks with round pupils, sharks with slitlike pupils, and some with pupils that expand and contract with the amount of light available. As unimpressive as this might sound to people who are used to having their pupils dilate and contract regularly, realize that no bony fish has this modification of the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e528738-65a6-3195-80eb-246969f760bc",
                                        "entry_id": "b7080f7c-9acb-3eee-8cc2-25cddac54fce",
                                        "glosses": [
                                            "The central dark part of an ocellated spot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
