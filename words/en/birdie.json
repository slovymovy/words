{
    "word_family": [
        "bird"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                    "sense_definition": "A small and cute bird.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at that cute little <w>birdie</w> sitting on the branch.",
                            "target_lang_translations": {
                                "pl": "Spójrz na tego uroczego, małego <w>ptaszka</w> siedzącego na gałęzi."
                            }
                        },
                        {
                            "text": "The children loved watching the <w>birdies</w> fly around the garden.",
                            "target_lang_translations": {
                                "pl": "Dzieci uwielbiały obserwować <w>ptaszki</w> latające po ogrodzie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mały, uroczy ptak."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ptaszek",
                                "target_lang_sense_clarification": "zdrobnienie od słowa ptak, używane w kontekście małych lub uroczych ptaków"
                            },
                            {
                                "target_lang_word": "ptaszyna",
                                "target_lang_sense_clarification": "określenie małego ptaka, często z nutą czułości lub litości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77995b30-ab39-359b-84c7-6651cee1e642",
                    "sense_definition": "The completion of a hole in golf one stroke below par.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "golf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played very well and made a <w>birdie</w> on the final hole.",
                            "target_lang_translations": {
                                "pl": "Zagrał bardzo dobrze i zdobył <w>birdie</w> na ostatnim dołku."
                            }
                        },
                        {
                            "text": "She celebrated her second <w>birdie</w> of the day with a smile.",
                            "target_lang_translations": {
                                "pl": "Świętowała swoje drugie <w>birdie</w> tego dnia z uśmiechem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "score a birdie"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wynik w golfie oznaczający ukończenie dołka jednym uderzeniem poniżej normy (par)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "birdie",
                                "target_lang_sense_clarification": "termin zapożyczony z języka angielskiego, powszechnie używany w polskiej terminologii golfowej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4f52f0-2510-3236-8c67-c4a46ad6f50d",
                    "sense_definition": "A shuttlecock used in badminton.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>birdie</w> flew over the net during the intense match.",
                            "target_lang_translations": {
                                "pl": "<w>Lotka</w> przeleciała nad siatką podczas zaciętego meczu."
                            }
                        },
                        {
                            "text": "She hit the <w>birdie</w> hard to win the point.",
                            "target_lang_translations": {
                                "pl": "Uderzyła mocno <w>lotkę</w>, aby zdobyć punkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "shuttlecock"
                    ],
                    "target_lang_definitions": {
                        "pl": "Lotka używana w grze w badmintona."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lotka",
                                "target_lang_sense_clarification": "standardowe określenie przyrządu używanego w badmintonie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "efe40659-a9fa-304c-890a-5082c143c1fa",
                    "sense_definition": "To score a birdie in golf.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "golf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needed to <w>birdie</w> the last hole to win the tournament.",
                            "target_lang_translations": {
                                "pl": "Musiał <w>zagrać birdie</w> na ostatnim dołku, aby wygrać turniej."
                            }
                        },
                        {
                            "text": "She <w>birdied</w> the difficult par-four hole with a great putt.",
                            "target_lang_translations": {
                                "pl": "<w>Zagrała birdie</w> na trudnym dołku par-cztery świetnym puttem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zdobyć birdie w golfie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zagrać birdie",
                                "target_lang_sense_clarification": "opisowa forma czasownikowa używana w polskim golfie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
