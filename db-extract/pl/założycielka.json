                                "target_senses": [
                                    {
                                        "sense_id": "d6283f01-0399-3957-a7e4-0cfb05a0ca20",
                                        "entry_id": "91c03c47-d7c3-3488-8c0d-2aba67f8643f",
                                        "glosses": [
                                            "Celle qui fonde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee58b82c-bc39-4897-9829-0ac35e0f5b58",
                                                "sense_id": "d6283f01-0399-3957-a7e4-0cfb05a0ca20",
                                                "text": "Par rapport à la crise sanitaire, il y a un manque criant de pédagogie, relève Caroline Marchetti, fondatrice de Controverse, agence de conseil en stratégie."
                                            },
                                            {
                                                "example_id": "c98bf4a6-10f3-4244-a1b6-014552eb19f2",
                                                "sense_id": "d6283f01-0399-3957-a7e4-0cfb05a0ca20",
                                                "text": "« Les témoignages peuvent raconter un paysage, un livre, un bijou, une œuvre d’art… », illustre la fondatrice, qui a, auparavant, travaillé pendant vingt ans dans une PME d’audioguides."
                                            },
                                            {
                                                "example_id": "7f34c716-82e9-492f-9cf6-d11b068c6018",
                                                "sense_id": "d6283f01-0399-3957-a7e4-0cfb05a0ca20",
                                                "text": "C’est un classique qui, avec quelques ajustements, peut prendre une allure très moderne, confie Louise Drouhet, la fondatrice de la marque de vêtements éthiques Soubacq."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caeea4db-4c9b-3961-9a6e-0807b25eb5b9",
                                        "entry_id": "91c03c47-d7c3-3488-8c0d-2aba67f8643f",
                                        "glosses": [
                                            "Celle qui fonde un établissement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d08ad4c-5411-44b4-86d1-002b9ea584c4",
                                                "sense_id": "caeea4db-4c9b-3961-9a6e-0807b25eb5b9",
                                                "text": "Elles allerent descendre dans la Maison que Madame d’Auxerre leur Fondatrice leur avoit destinée pour la Fondation, ou cette Dame les receut avec une foye parfaite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671a6a46-f4e9-3cf7-8308-565729607337",
                                        "entry_id": "91c03c47-d7c3-3488-8c0d-2aba67f8643f",
                                        "glosses": [
                                            "Reine, insecte femelle non stérile qui peut fonder un nid, une ruche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e7b69b-be72-46b5-a045-aa6d0e9152ec",
                                                "sense_id": "671a6a46-f4e9-3cf7-8308-565729607337",
                                                "text": "Cette petite bête est, en effet, le Romulus de sa ruche ; c’est pourquoi les éleveurs d’abeilles, qui la connaissent bien, l’ont appelée d’un nom que vous n’oublierez plus maintenant ; on la nomme la fondatrice."
                                            },
                                            {
                                                "example_id": "fff1760a-f76b-4a69-8df4-c9116cd95861",
                                                "sense_id": "671a6a46-f4e9-3cf7-8308-565729607337",
                                                "text": "Il faudrait détruire 100 % des nids courant août, mais ils sont cachés en haut des arbres. Quand on les découvre à la chute des feuilles, les fondatrices, celles qui passent l’hiver, sont déjà parties."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fondatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5938e138-9abf-3e71-9e79-9bacded921c5",
                                        "entry_id": "ed8243d1-7aeb-304d-ad95-76a7bc32f0f7",
                                        "glosses": [
                                            "Féminin singulier de fondateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2dc2e62-bc56-40cb-91e6-933f83d69ca9",
                                                "sense_id": "5938e138-9abf-3e71-9e79-9bacded921c5",
                                                "text": "Les grandes œuvres naissent toujours d’une expérience fondatrice, d’un traumatisme, d’une tension intérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
