                ],
                "senses": [
                    {
                        "sense_id": "39899336-3268-3574-823f-0e0a36bcaaef",
                        "entry_id": "ca859d13-1c56-32be-a234-409ebf3995da",
                        "glosses": [
                            "Weg/Pfad, der von Wild regelmäßig genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b02c26e5-c3a1-4b41-acbd-820c2ee133cb",
                                "sense_id": "39899336-3268-3574-823f-0e0a36bcaaef",
                                "text": "„Folgt den Wildwechseln, das Wild hat gelernt, Gefahren auszuweichen.“"
                            },
                            {
                                "example_id": "3b3c3c2c-7325-4d02-8942-d9312af28a83",
                                "sense_id": "39899336-3268-3574-823f-0e0a36bcaaef",
                                "text": "„Da erschienen schon rund ein Dutzend weiterer Tiere, die auf dem Wildwechsel zur Tränke den Wald durchquerten.“"
                            },
                            {
                                "example_id": "b64c321f-5159-4580-9ce3-ddc31931b0ec",
                                "sense_id": "39899336-3268-3574-823f-0e0a36bcaaef",
                                "text": "„Also verließen wir den Weg, gingen eine schmale Böschung hinauf und einen Wildwechsel entlang.“"
                            },
                            {
                                "example_id": "2f9d15a4-43a7-41a0-8139-202e813ee42a",
                                "sense_id": "39899336-3268-3574-823f-0e0a36bcaaef",
                                "text": "„Schlingen und Fallen werden in Wildpfaden oder auf viel benutzten Wildwechseln ausgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa29e51f-06bf-3d57-b56f-c7269f48c366",
                        "entry_id": "ca859d13-1c56-32be-a234-409ebf3995da",
                        "glosses": [
                            "Überquerung eines Verkehrsweges durch Wild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0784b861-e304-4159-aa18-c63dfe9f7554",
                                "sense_id": "aa29e51f-06bf-3d57-b56f-c7269f48c366",
                                "text": "„Das dreieckige Straßenschild, das auf einen Wildwechsel hinwies, zeigte in den grauen Himmel.“"
                            },
                            {
                                "example_id": "70f125b3-8d94-498d-accf-185f3f5cae00",
                                "sense_id": "aa29e51f-06bf-3d57-b56f-c7269f48c366",
                                "text": "„Bei Wildwechsel – egal ob Ameisenstraße oder Elefantenkuh – das Lenkrad fest umschlossen halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
