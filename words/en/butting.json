{
    "word_family": [
        "butt",
        "butter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49866da9-40b3-3fa6-a902-0e06c1f6898b",
                    "sense_definition": "present participle and gerund of <w>butt</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "strike_or_intrude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept <w>butting</w> in while they were trying to have a serious conversation.",
                            "target_lang_translations": {
                                "es": "Él no paraba de <w>entrometerse</w> mientras ellos intentaban tener una conversación seria."
                            }
                        },
                        {
                            "text": "The young ram was playfully <w>butting</w> its head against the wooden gate.",
                            "target_lang_translations": {
                                "es": "El carnero joven estaba <w>dando cabezazos</w> juguetonamente contra la valla de madera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "butting in",
                        "butting heads"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma de participio de presente o gerundio de butt; dar cabezazos o entrometerse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "dando cabezazos",
                                "target_lang_sense_clarification": "golpeando con la cabeza"
                            },
                            {
                                "target_lang_word": "entrometiéndose",
                                "target_lang_sense_clarification": "metiéndose en asuntos ajenos (butting in)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd76c945-24cf-37d3-9155-b304b08e4d7c",
                    "sense_definition": "present participle and gerund of <w>but</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>butting</w> and make a clear decision about what you want to do.",
                            "target_lang_translations": {
                                "es": "Deja de <w>poner peros</w> y toma una decisión clara sobre lo que quieres hacer."
                            }
                        },
                        {
                            "text": "Her endless \"if\"ing and <w>butting</w> annoyed everyone in the room.",
                            "target_lang_translations": {
                                "es": "Su interminable costumbre de poner dudas y <w>peros</w> molestó a todos en la habitación."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma de participio de presente o gerundio de but; poner reparos, objeciones o peros."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "poniendo peros",
                                "target_lang_sense_clarification": "presentar objeciones o excusas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d168d2b-1344-315e-9954-4dea0893d3e0",
                    "sense_definition": "The act of striking or pushing with the head or horns.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "strike_or_intrude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep prevented injury by ending their continuous <w>buttings</w> against each other.",
                            "target_lang_translations": {
                                "es": "Las ovejas evitaron lastimarse al poner fin a sus continuos <w>topetazos</w> entre sí."
                            }
                        },
                        {
                            "text": "A sudden <w>butting</w> by the angry goat knocked the bucket across the yard.",
                            "target_lang_translations": {
                                "es": "Un repentino <w>cabezazo</w> de la cabra enfurecida lanzó el cubo por el patio."
                            }
                        }
                    ],
                    "synonyms": [
                        "headbutt"
                    ],
                    "target_lang_definitions": {
                        "es": "Acción de golpear o empujar con la cabeza o los cuernos; cabezazo o topetazo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cabezazo",
                                "target_lang_sense_clarification": "golpe dado con la cabeza"
                            },
                            {
                                "target_lang_word": "topetazo",
                                "target_lang_sense_clarification": "golpe dado con los cuernos o la cabeza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447eb24f-6dd8-33e6-ba23-db30365e8cd8",
                    "sense_definition": "An abuttal; a boundary or limit of a piece of land.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old property deed described the parcel without any clear <w>buttings</w> or boundings on any side.",
                            "target_lang_translations": {
                                "es": "La antigua escritura de propiedad describía la parcela sin ningún <w>linde</w> ni demarcación clara en ninguno de sus lados."
                            }
                        },
                        {
                            "text": "They surveyed the estate to mark every <w>butting</w> alongside the neighboring farm.",
                            "target_lang_translations": {
                                "es": "Inspeccionaron la finca para marcar cada <w>lindero</w> junto a la granja vecina."
                            }
                        }
                    ],
                    "synonyms": [
                        "boundary",
                        "abuttal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically in legal land descriptions"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Linde o límite que confina una parcela de terreno."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "linde",
                                "target_lang_sense_clarification": "límite de un terreno"
                            },
                            {
                                "target_lang_word": "lindero",
                                "target_lang_sense_clarification": "línea divisoria de fincas o terrenos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}