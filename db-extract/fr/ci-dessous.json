                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "The town is situated on a hillside, with a river running below."
                                            },
                                            {
                                                "example_id": "c0e3704c-c8ab-4b40-8cc9-2391f7bb59d0",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "He was pulled below by a sea monster."
