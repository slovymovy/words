{
    "word_family": [
        "loiter",
        "loiterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39da75a5-33a6-3aa0-a72e-320474aa95a4",
                    "sense_definition": "The act of standing or waiting around without an apparent purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loiter_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store owner put up a sign that prohibited <w>loitering</w> near the entrance.",
                            "target_lang_translations": {
                                "es": "El dueño de la tienda puso un cartel que prohibía <w>merodear</w> cerca de la entrada."
                            }
                        },
                        {
                            "text": "The police questioned several teenagers who were accused of <w>loitering</w> in the park after dark.",
                            "target_lang_translations": {
                                "es": "La policía interrogó a varios adolescentes acusados de <w>vagar sin rumbo</w> en el parque después del anochecer."
                            }
                        }
                    ],
                    "synonyms": [
                        "lingering"
                    ],
                    "common_phrases": [
                        "no loitering",
                        "loitering with intent"
                    ],
                    "target_lang_definitions": {
                        "es": "Acción de permanecer o merodear en un lugar público sin un propósito aparente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "merodeo",
                                "target_lang_sense_clarification": "acción de rondar o merodear"
                            },
                            {
                                "target_lang_word": "vagancia",
                                "target_lang_sense_clarification": "hábito o acción de estar ocioso"
                            },
                            {
                                "target_lang_word": "permanencia no autorizada",
                                "target_lang_sense_clarification": "en avisos legales o prohibiciones"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a341476a-9beb-300a-bad2-52597bc742e8",
                    "sense_definition": "present participle and gerund of <w>loiter</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loiter_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A few suspicious individuals were <w>loitering</w> outside the bank all morning.",
                            "target_lang_translations": {
                                "es": "Unos pocos individuos sospechosos estuvieron <w>merodeando</w> fuera del banco toda la mañana."
                            }
                        },
                        {
                            "text": "Instead of going straight home, the students were <w>loitering</w> by the train station.",
                            "target_lang_translations": {
                                "es": "En lugar de ir directamente a casa, los estudiantes estaban <w>perdiendo el tiempo</w> cerca de la estación de tren."
                            }
                        }
                    ],
                    "synonyms": [
                        "lingering"
                    ],
                    "common_phrases": [
                        "loitering around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma en gerundio de loiter; estar merodeando o perdiendo el tiempo sin rumbo fijo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "merodeando",
                                "target_lang_sense_clarification": "andando por un lugar de manera sospechosa o sin fin claro"
                            },
                            {
                                "target_lang_word": "rondando",
                                "target_lang_sense_clarification": "dando vueltas alrededor de un lugar"
                            },
                            {
                                "target_lang_word": "holgazaneando",
                                "target_lang_sense_clarification": "perdiendo el tiempo sin hacer nada"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}