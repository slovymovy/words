        "fr-extract.jsonl": [
            {
                "entry_id": "0d3010fd-31cc-37eb-ba6c-8bcaacb19246",
                "word": "coït",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbc5a957-6c4c-4026-8348-90800f3fc5f2",
                        "entry_id": "0d3010fd-31cc-37eb-ba6c-8bcaacb19246",
                        "tags": [
