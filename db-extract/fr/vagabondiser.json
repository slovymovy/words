                "senses": [
                    {
                        "sense_id": "22019ed1-ac74-3825-a81e-0a5f9669d3a8",
                        "entry_id": "15850707-05c1-355f-985c-22fd45e431fe",
                        "glosses": [
                            "Donner un caractère vagabond à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b3e3f5-d193-44ce-9d84-b2d75f2f55cc",
                                "sense_id": "22019ed1-ac74-3825-a81e-0a5f9669d3a8",
                                "text": "Nous avons tous besoin d'un ego, comme un toit pour vivre au-dessous, comme une maison sans laquelle nous sommes vagabondisés, remis aux quatre éléments."
                            },
                            {
                                "example_id": "192cdcba-e5dd-4007-93db-7c059765d2d4",
                                "sense_id": "22019ed1-ac74-3825-a81e-0a5f9669d3a8",
                                "text": "Nul ne contredira le fait que tout est dilué, «vagabondisé», clochardisé dans une Algérie qui ne sait plus où donner de la tête."
                            },
                            {
                                "example_id": "c387f4b6-a4ee-4331-a19c-aebe66d9aff5",
                                "sense_id": "22019ed1-ac74-3825-a81e-0a5f9669d3a8",
                                "text": "Je commence à en mettre des tartines comme Ronin, je me vagabondise"
                            }
                        ]
                    }
