                        "source_sense_id": "f83be404-d26e-3e29-bc00-9f325746ae89",
                        "source_sense_description": "meist Singular, je nach Zusammenhang: die nächsten Tage, Monate, Jahre",
                        "target_lang_word": "aftermath",
