                                        "glosses": [
                                            "een balkje dat ervoor dient in een supermarkt met een lopende band boodschappen van klanten te scheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242af303-4865-48f9-807d-12f8329d2d87",
                                                "sense_id": "e70bf9c3-a027-3e88-8149-1f896485358d",
                                                "text": "De klant voor mij had ook het beurtbalkje niet klaargelegd."
                                            },
                                            {
                                                "example_id": "6b1c4634-f681-456c-8ecf-6bebad8e72a5",
                                                "sense_id": "e70bf9c3-a027-3e88-8149-1f896485358d",
                                                "text": "Weet u hoe dit voorwerp heet?” vraag ik de volgende dag aan een andere. Ook in de dagen erna blijkt geen van de dames ooit van beurtbalkje te hebben gehoord. Gisteren werd de filiaalleider erbij gehaald. „Beurtbalkje? U moet een geintje maken, mijnheer. Dat ding heet ‘divider’. (Maarten de Gier NRC 14 mei 2007)"
                                            }
                                        ]
