                                    {
                                        "sense_id": "1b0942a5-f53d-379d-9e60-b3368756ffe9",
                                        "entry_id": "fd9e29db-88c0-38d2-b89d-1c43c19bf286",
                                        "glosses": [
                                            "die europäisch-asiatische Schwesterart (Bison bonasus) des Amerikanischen Bisons (Bison bison)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34ec35f-d7ce-4927-a967-3bf3380c010a",
                                                "sense_id": "1b0942a5-f53d-379d-9e60-b3368756ffe9",
                                                "text": "Der Wisent ist Europas schwerstes und größtes Landsäugetier und zudem der letzte Vertreter der Wildrindarten des europäischen Kontinents."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
