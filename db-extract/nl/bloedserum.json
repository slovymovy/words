                                        "examples": [
                                            {
                                                "example_id": "fade163d-025e-4915-adc4-0d94239b71cc",
                                                "sense_id": "152505ca-198a-3676-89c7-8b50e9fdf98c",
                                                "text": "„Der Blutzucker kann im venösen Blut, im Blutserum oder im Kapillarblut bestimmt werden.“"
                                            },
                                            {
                                                "example_id": "7cd95ba5-5f05-41e1-b1bd-8ea02a3d6077",
                                                "sense_id": "152505ca-198a-3676-89c7-8b50e9fdf98c",
                                                "text": "„Den wäßrigen Anteil des Blutes ohne die Gerinnungsstoffe (Fibrin) nennt man Blutserum (Serumproteine).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
