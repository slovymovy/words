            "senses": [
                {
                    "sense_id": "d7aeaef2-84fe-3d1f-9125-d77cf31583cb",
                    "sense_definition": "Having been comprehended.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's explanation was easily <w>understood</w> by the young students.",
                            "target_lang_translations": {
                                "ru": "Объяснение учителя было легко <w>понято</w> юными учениками.",
                                "zh": "老师的讲解很容易被年轻的学生们所<w>理解</w>。"
                            }
                        },
                        {
                            "text": "He finally felt <w>understood</w> after sharing his feelings with his best friend.",
                            "target_lang_translations": {
                                "ru": "Он наконец почувствовал себя <w>понятым</w>, поделившись чувствами с лучшим другом.",
                                "zh": "在和最好的朋友分享感受后，他终于感到自己被<w>理解</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehended",
                        "clear"
                    ],
                    "antonyms": [
