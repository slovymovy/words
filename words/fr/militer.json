                },
                {
                    "sense_id": "89ac3c86-50e8-341f-a44f-b12bb9f42a6d",
                    "sense_definition": "Constituer une raison ou un argument pesant en faveur de ou contre quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
