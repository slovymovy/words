                                "target_senses": [
                                    {
                                        "sense_id": "a6c8ab84-ea8a-35d2-9ff6-59a3fa32da18",
                                        "entry_id": "19bef2db-543d-34ae-ba6d-8624b7712279",
                                        "glosses": [
                                            "устар. соотносящийся Тавриде (историческое название Крыма), связанный с ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad2a6f8-0132-4204-b3df-78caa3eacd81",
                                                "sense_id": "a6c8ab84-ea8a-35d2-9ff6-59a3fa32da18",
                                                "text": "Делегатский съезд избрал общим одесским и таврическим караимским гахамом бывшего советника шаха Шапшала."
                                            },
                                            {
                                                "example_id": "55d546d2-bce1-4071-8f03-5d8713358000",
                                                "sense_id": "a6c8ab84-ea8a-35d2-9ff6-59a3fa32da18",
                                                "text": "Медея Мендес, урожденная Синопли, если не считать её младшей сестры Александры, перебравшейся в Москву в конце двадцатых годов, осталась последней чистопородной гречанкой в семье, поселившейся в незапамятные времена на родственных Элладе таврических берегах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
