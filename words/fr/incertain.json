                {
                    "sense_id": "31ab4d9d-98c0-3aba-895f-6243ca48e50c",
                    "sense_definition": "Qui éprouve des doutes, qui hésite ou manque d'assurance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à toutes ces options, je reste <w>incertain</w> sur le choix de mes études.",
                            "target_lang_translations": {
                                "en": "Faced with all these options, I'm still <w>unsure</w> which field to study.",
                                "ru": "Перед всеми этими вариантами я до сих пор <w>не уверен</w> в выборе специальности.",
                                "de": "Angesichts all dieser Möglichkeiten bin ich mir bei der Wahl meines Studiums immer noch <w>unsicher</w>.",
                                "es": "Ante todas estas opciones, sigo <w>indeciso</w> sobre qué estudiar.",
                                "zh": "面对这么多选择，我在选择专业的问题上仍然<w>犹豫</w>不决。"
                            }
                        },
                        {
                            "text": "Elle semblait très <w>incertaine</w> au moment de signer le bail de location.",
                            "target_lang_translations": {
                                "en": "She seemed very <w>uncertain</w> when it came to signing the rental lease.",
                                "ru": "Она выглядела очень <w>неуверенной</w>, когда подписывала договор аренды.",
                                "de": "Als es darum ging, den Mietvertrag zu unterschreiben, wirkte sie sehr <w>unsicher</w>.",
                                "es": "Parecía muy <w>insegura</w> a la hora de firmar el contrato de alquiler.",
                                "zh": "签租房合同的时候，她看起来非常<w>迟疑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hésitant",
                        "indécis"
                    ],
                    "antonyms": [
                        "assuré",
                        "décidé"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking confidence or certainty; hesitant to decide or to believe something.",
                        "ru": "Испытывающий сомнения, нерешительный или лишённый уверенности.",
                        "de": "Ohne Selbstvertrauen und zögernd, weil man an einer Entscheidung oder Überzeugung zweifelt.",
                        "es": "Que duda, vacila o carece de seguridad al decidir o creer algo.",
                        "zh": "缺乏信心，做决定或相信某事时犹豫不决。"
                    },
