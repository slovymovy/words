                                                "text": "Die Litauerin hat schwarzes Haar, das für ein baltisches Mädchen typisch ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8e03dd0-2c72-32a0-88c9-c7959a911212",
