                "senses": [
                    {
                        "sense_id": "cd3ac96d-a92d-3a1b-b6cc-653e5fe9ed5c",
                        "entry_id": "91c0cac8-a808-3f1a-8ef1-4efdc3701618",
                        "glosses": [
                            "ans Kämpfen gewohnt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "fb26fe4d-3333-4a4c-839d-04d880189535",
                                "sense_id": "cd3ac96d-a92d-3a1b-b6cc-653e5fe9ed5c",
                                "text": "„Rosenemil legt seine sehr schwere und sehr kampfgewohnte Hand Maud sehr zart auf den Kopf. “"
                            },
                            {
                                "example_id": "15ccb4cf-114b-4d69-a6f5-fb23a68eacde",
                                "sense_id": "cd3ac96d-a92d-3a1b-b6cc-653e5fe9ed5c",
                                "text": "„Am 27. Dezember wurden drei Edelleute, die hervorragendsten der Stadt, von den Behörden zu Fürst Luigi gesandt, welcher bei sich im Hause vierzig Männer, lauter alte kampfgewohnte Soldaten hatte.“"
