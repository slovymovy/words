{
    "word_family": [
        "flauntingly",
        "flaunter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cb0c3dd-302d-35f6-a100-2e30d1f61eb6",
                    "sense_definition": "To display something ostentatiously; to show off proudly in order to impress others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "show_off",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to <w>flaunt</w> her wealth by wearing expensive designer clothes to every casual event.",
                            "target_lang_translations": {
                                "pl": "Ona uwielbia <w>obnosić się</w> ze swoim bogactwem, nosząc drogie, markowe ubrania na każde codzienne spotkanie."
                            }
                        },
                        {
                            "text": "Instead of being humble about his promotion, he chose to <w>flaunt</w> his success in front of his colleagues.",
                            "target_lang_translations": {
                                "pl": "Zamiast zachować skromność wobec awansu, postanowił <w>afiszować się</w> swoim sukcesem przed kolegami z pracy."
                            }
                        }
                    ],
                    "synonyms": [
                        "show off",
                        "parade",
                        "exhibit",
                        "brandish"
                    ],
                    "antonyms": [
                        "hide",
                        "conceal",
                        "disguise"
                    ],
                    "common_phrases": [
                        "flaunt one's wealth",
                        "flaunt success"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pokazywać coś ostentacyjnie; chwalić się dumnie, aby zaimponować innym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obnosić się",
                                "target_lang_sense_clarification": "z czymś, np. z bogactwem"
                            },
                            {
                                "target_lang_word": "afiszować się",
                                "target_lang_sense_clarification": "pokazywać coś ostentacyjnie"
                            },
                            {
                                "target_lang_word": "paradować",
                                "target_lang_sense_clarification": "pokazywać się dumnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "828c217f-0330-3e4a-864f-36048509d882",
                    "sense_definition": "To dress or behave in a flashy, bold, or defiant manner to attract attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "show_off",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young actors would <w>flaunt</w> about the streets in the latest extravagant fashions.",
                            "target_lang_translations": {
                                "pl": "Młodzi aktorzy <w>paradowali</w> po ulicach w najnowszych, ekstrawaganckich kreacjach."
                            }
                        },
                        {
                            "text": "She decided to <w>flaunt</w> in her new colorful dress, ignoring the conservative dress code of the party.",
                            "target_lang_translations": {
                                "pl": "Postanowiła <w>pokazać się</w> w swojej nowej, kolorowej sukience, ignorując konserwatywny dress code przyjęcia."
                            }
                        }
                    ],
                    "synonyms": [
                        "strut",
                        "swagger"
                    ],
                    "common_phrases": [
                        "flaunt about"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ubierać się lub zachowywać w sposób krzykliwy, śmiały lub prowokujący, aby przyciągnąć uwagę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "afiszować się",
                                "target_lang_sense_clarification": "zwracać na siebie uwagę zachowaniem lub strojem"
                            },
                            {
                                "target_lang_word": "paradować",
                                "target_lang_sense_clarification": "chodzić dumnie w wyzywającym stroju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d33475-7c13-30f4-a5c9-9516d172c036",
                    "sense_definition": "To treat with contempt; to openly disregard or flout rules or conventions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several large corporations were caught trying to <w>flaunt</w> the environmental regulations.",
                            "target_lang_translations": {
                                "pl": "Kilka dużych korporacji zostało przyłapanych na próbach <w>zlekceważenia</w> przepisów dotyczących ochrony środowiska."
                            }
                        },
                        {
                            "text": "By openly <w>flaunting</w> the authority of the court, the defendant faced severe penalties.",
                            "target_lang_translations": {
                                "pl": "Poprzez otwarte <w>drwienie</w> z powagi sądu, oskarżony naraził się na surowe kary."
                            }
                        }
                    ],
                    "synonyms": [
                        "flout",
                        "defy",
                        "disregard"
                    ],
                    "antonyms": [
                        "obey",
                        "respect",
                        "observe"
                    ],
                    "common_phrases": [
                        "flaunt the rules",
                        "flaunt authority"
                    ],
                    "target_lang_definitions": {
                        "pl": "Traktować z pogardą; otwarcie lekceważyć zasady lub konwenanse (często mylone z 'flout')."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lekceważyć",
                                "target_lang_sense_clarification": "otwarcie łamać zasady"
                            },
                            {
                                "target_lang_word": "drwić sobie",
                                "target_lang_sense_clarification": "z przepisów lub autorytetu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc6b058d-75cc-3cb5-9ad1-f1fdf412d9ba",
                    "sense_definition": "To wave, flutter, or move dynamically and conspicuously in the wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Brightly colored banners were seen to <w>flaunt</w> in the breeze above the castle walls.",
                            "target_lang_translations": {
                                "pl": "Widziano jaskrawe sztandary <w>powiewające</w> na wietrze nad murami zamku."
                            }
                        },
                        {
                            "text": "The sails of the ships began to <w>flaunt</w> as the sudden storm winds picked up.",
                            "target_lang_translations": {
                                "pl": "Żagle statków zaczęły <w>trzepotać</w>, gdy zerwał się nagły sztormowy wiatr."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter",
                        "wave",
                        "flap"
                    ],
                    "common_phrases": [
                        "flaunt in the wind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly literary or poetic in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powiewać, trzepotać lub poruszać się dynamicznie i widocznie na wietrze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powiewać",
                                "target_lang_sense_clarification": "o flagach, żaglach na wietrze"
                            },
                            {
                                "target_lang_word": "trzepotać",
                                "target_lang_sense_clarification": "na wietrze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "952157c8-b0d9-3542-a827-b9884d08d9c1",
                    "sense_definition": "An act of displaying ostentatiously, or something that is displayed for show.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire parade was a vulgar <w>flaunt</w> of military power designed to intimidate neighbors.",
                            "target_lang_translations": {
                                "pl": "Cała parada była wulgarną <w>pokazówką</w> siły militarnej, mającą na celu zastraszenie sąsiadów."
                            }
                        },
                        {
                            "text": "She dismissed his expensive new sports car as a mere <w>flaunt</w> of his sudden wealth.",
                            "target_lang_translations": {
                                "pl": "Zbyła jego nowy, drogi samochód sportowy jako zwykłe <w>szpanowanie</w> nagłym bogactwem."
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "show",
                        "exhibition"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt ostentacyjnego pokazywania czegoś lub rzecz wystawiona na pokaz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pokazówka",
                                "target_lang_sense_clarification": "ostentacyjne zachowanie na pokaz"
                            },
                            {
                                "target_lang_word": "paradowanie",
                                "target_lang_sense_clarification": "obnoszenie się z czymś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}