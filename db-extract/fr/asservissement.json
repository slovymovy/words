                                        "sense_id": "f2b06013-be13-3cb7-8e93-390655c37e12",
                                        "entry_id": "7667d876-2f72-3cb1-a207-864f896338fe",
                                        "glosses": [
                                            "The act of enslaving or the state of being a slave; bondage"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1de5a4-86d7-4610-a357-7d00b94ed20c",
                                                "sense_id": "f2b06013-be13-3cb7-8e93-390655c37e12",
                                                "text": "I should like to take this opportunity to express my wish for success and victory in our struggle against Communism and enslavement and for freedom and peace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b379efb2-a70d-49e3-afa0-b57d4809331d",
                        "source_entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                        "target_lang_word": "slaafsheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaafsheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6071da7f-2ac8-3646-92c0-476ab3ac4359",
                                        "entry_id": "c3345dd0-0f11-32c4-93ec-31442d515480",
                                        "glosses": [
                                            "gedrag dat duidt om te grote onderdanigheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c64773-d075-452d-99d6-a7e0e6c639a7",
                                                "sense_id": "6071da7f-2ac8-3646-92c0-476ab3ac4359",
                                                "text": "Door iedereen uitgekotst, zo gedroegen zelfs hun nazaten zich nog - gemakshalve ook tegenover toeristen, die niet goed raad wisten met zoveel vijandige slaafsheid."
                                            },
                                            {
                                                "example_id": "bb89a2ce-cd1d-458f-bccf-0c5e61fe753b",
                                                "sense_id": "6071da7f-2ac8-3646-92c0-476ab3ac4359",
                                                "text": "Hoewel... Donners slaafsheid is gespeeld, zijn onderhorigheid is eigenlijk cynisme; hij wilde bal zijn om God stiekem te laten winnen, want anders zou die elke wedstrijd verliezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7748677f-103d-49b8-94c3-5529f67d09a9",
