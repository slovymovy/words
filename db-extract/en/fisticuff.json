                        "examples": [
                            {
                                "example_id": "47e5f5cb-3c6d-4e99-813c-f07b16c5b172",
                                "sense_id": "7645276e-cbb4-3643-93f0-c154f5fab802",
                                "text": "Every fifteen or twenty minutes there was a rush to some part, to witness a fisticuff."
                            },
                            {
                                "example_id": "fe60637b-1e5c-4533-b872-f94c95a0358c",
                                "sense_id": "7645276e-cbb4-3643-93f0-c154f5fab802",
                                "text": "This clearly was not a case for fisticuffs, even apart from the very natural aversion I had to beat that Shadow—this wandering and tormented thing."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2dad588-d915-30d4-b23d-b1dc0480ad6d",
                        "entry_id": "f6625cde-a4d8-328c-8630-409d09f711b8",
                        "glosses": [
                            "A cuff or blow administered with the fist."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
