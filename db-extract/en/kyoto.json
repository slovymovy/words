                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "72bf4842-2402-3b57-ac6b-86ec54a6ff65",
                        "entry_id": "92634ff2-1358-31a7-9bfc-64620e31aacf",
                        "glosses": [
                            "The capital city of Kyoto Prefecture, Japan, and the country's former capital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d6e750-31c7-46c7-8594-6e5025e5caaf",
                                "sense_id": "72bf4842-2402-3b57-ac6b-86ec54a6ff65",
                                "text": "The aversion to public displays of eating persists today not only in Kyoto but also throughout the higher levels of Japanese society."
                            }
                        ]
                    },
                    {
                        "sense_id": "82d02cc5-cdf7-3f4a-824c-ced1752b06f3",
                        "entry_id": "92634ff2-1358-31a7-9bfc-64620e31aacf",
                        "glosses": [
                            "The Kyoto Protocol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee291306-5834-41f0-9ab0-8e96492ff517",
                                "sense_id": "82d02cc5-cdf7-3f4a-824c-ced1752b06f3",
                                "text": "The merits and limitations of Kyoto have been subject to great discussion. Some criticize the regime for being too top-down, wasteful and infective as a means of tacking climate change (Prins and Rayner 2007; Victor 2001)."
                            }
                        ]
                    }
                ],
