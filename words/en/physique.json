    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86a0dcd3-003a-32e9-89f9-5a488a652c58",
                    "sense_definition": "The natural constitution or physical structure of a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was born with a strong <w>physique</w> that helped him excel in many different sports.",
                            "target_lang_translations": {
                                "zh": "他天生有着强健的<w>体格</w>，这使他在许多不同的运动项目中表现出色。"
                            }
                        },
                        {
                            "text": "The athlete's natural <w>physique</w> was perfectly suited for long-distance running.",
                            "target_lang_translations": {
                                "zh": "这位运动员天生的<w>体质</w>非常适合长跑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "body",
                        "frame",
                        "build",
                        "anatomy",
                        "constitution",
                        "figure",
                        "shape"
                    ],
                    "antonyms": [
                        "psyche"
                    ],
                    "common_phrases": [
                        "strong physique",
                        "natural physique"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一个人的自然体质或身体结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "体格",
                                "target_lang_sense_clarification": "指人的身体结构和发育状况。"
                            },
                            {
                                "target_lang_word": "体质",
                                "target_lang_sense_clarification": "指身体的质量，侧重于健康状况和生理基础。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eea7882-c50e-3f5c-afdd-2bf7db6d2faf",
                    "sense_definition": "The trained muscular structure of a person's body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years in the gym to develop such an impressive <w>physique</w>.",
                            "target_lang_translations": {
                                "zh": "他在健身房苦练多年，才练就了如此令人印象深刻的<w>身材</w>。"
                            }
                        },
                        {
                            "text": "Bodybuilders often compete to show off their highly developed <w>physique</w>.",
                            "target_lang_translations": {
                                "zh": "健美运动员经常通过比赛来展示他们高度发达的<w>体型</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "build",
                        "frame",
                        "proportions"
                    ],
                    "common_phrases": [
                        "muscular physique",
                        "developed physique"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过锻炼形成的肌肉发达的身体结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "身材",
                                "target_lang_sense_clarification": "指人的体型，常用于描述锻炼后的肌肉线条。"
                            },
                            {
                                "target_lang_word": "体型",
                                "target_lang_sense_clarification": "指身体的形状，常用于描述肌肉发达程度。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}