                        "examples": [
                            {
                                "example_id": "9dcd8b0b-ad1c-4cd0-b240-a462d2d68a81",
                                "sense_id": "21848a4e-79e2-300c-bc7f-baa9e19ecddd",
                                "text": "Oui, mon bon Lucien, voilà qui est vrai, jusqu’à un certain point ; mais conviens que tu as bien su leur dorer la pilule à ces bons, archibons Bourbons ; et qu’à leur tour, ils ne se sont pas montrés trop ingrats envers toi."
                            },
                            {
                                "example_id": "ff61c06f-03bb-44fb-acf2-d55f4d232671",
                                "sense_id": "21848a4e-79e2-300c-bc7f-baa9e19ecddd",
                                "text": "Jeune veuve, riche, noble, indépendante, confiante, intelligente, archibonne et archi-naïve, elle commence une brillante carrière dans la haute société parisienne et tombe amoureuse."
                            },
                            {
                                "example_id": "a31f5c11-191a-4e89-a691-f7729a8fb8ac",
                                "sense_id": "21848a4e-79e2-300c-bc7f-baa9e19ecddd",
                                "text": "Je suis archibonne"
                            }
                        ]
                    }
