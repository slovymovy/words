                "senses": [
                    {
                        "sense_id": "8b6a7701-f902-3ade-b172-0e41c461ca44",
                        "entry_id": "256f1319-8ac2-34ad-9612-2785479cc210",
                        "glosses": [
                            "Salade d’œuf(s), salade aux œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13da90de-2340-4651-b3d8-47574e4fb9c9",
                                "sense_id": "8b6a7701-f902-3ade-b172-0e41c461ca44",
                                "text": "Dein Eiersalat schmeckte vorzüglich.",
                                "translation": "Ta salade aux œufs avait un excellent goût."
                            },
                            {
                                "example_id": "49d266e3-123d-4101-981a-adbc4c5eab5d",
                                "sense_id": "8b6a7701-f902-3ade-b172-0e41c461ca44",
                                "text": "Wenn es nicht anders geht, greifen Sie auf einen Proteinsnack zurück, zum Beispiel Thunfisch in Wasser, fettarmen Eiersalat, gebratenes Hühnchen, Trockenobst oder Nüsse in kleinen Mengen.",
                                "translation": "Si cela ne convient pas autrement, ayez recours à un encas riche en protéines, comme par exemple du thon à l’eau, de la salade d’œufs allégée, du poulet rôti, des fruits secs ou des noix en petites quantités."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
