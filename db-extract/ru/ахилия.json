                "senses": [
                    {
                        "sense_id": "6d4c025b-cd87-30d9-970a-86e0258c749f",
                        "entry_id": "d3ff26ce-a2e8-3062-ba7b-89a22cbc6091",
                        "glosses": [
                            "мед. отсутствие соляной кислоты и пепсина в желудочном соке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763696e8-1570-43fd-9c8e-df9968379409",
                                "sense_id": "6d4c025b-cd87-30d9-970a-86e0258c749f",
                                "text": "Количественные изменения желудочной секреции выражаются в форме гиперсекреции, гипосекреции желудочного сока и ахилии."
                            },
                            {
                                "example_id": "9bdf77f3-bd69-4af4-a5cc-61dd98c5b790",
                                "sense_id": "6d4c025b-cd87-30d9-970a-86e0258c749f",
                                "text": "Сок ягод пьют при поносах, ахилии, катаре желудка, а разбавленный водой используют для полосканий при ангинах и воспалительных процессах глотки и полости рта."
                            }
                        ]
                    }
