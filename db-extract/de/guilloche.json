                                        "entry_id": "4dbbe6f0-81e4-375f-9846-88e94e8d8567",
                                        "glosses": [
                                            "The tool used to create such work."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
