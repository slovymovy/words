{
    "word_family": [
        "like",
        "likely",
        "likeness",
        "liking",
        "unlike",
        "dislikable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f198308b-3350-34a7-a24c-f417c4b79454",
                    "sense_definition": "To consider someone or something unpleasant, disagreeable, or offensive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_aversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>dislike</w> having to wake up early on weekends.",
                            "target_lang_translations": {
                                "ru": "Я <w>не люблю</w> просыпаться рано по выходным.",
                                "zh": "我<w>不喜欢</w>周末还得早起。"
                            }
                        },
                        {
                            "text": "She seems to <w>dislike</w> the new manager for some reason.",
                            "target_lang_translations": {
                                "ru": "Кажется, она <w>недолюбливает</w> нового менеджера по какой-то причине.",
                                "zh": "不知为什么，她似乎对新经理很<w>反感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "object to",
                        "mind",
                        "hate"
                    ],
                    "antonyms": [
                        "like"
                    ],
                    "common_phrases": [
                        "dislike intensely",
                        "strongly dislike",
                        "really dislike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать кого-то или что-то неприятным, неприемлемым или оскорбительным.",
                        "zh": "认为某人或某事令人不快、不合意或反感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не любить",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "испытывать неприязнь",
                                "target_lang_sense_clarification": "более формально"
                            },
                            {
                                "target_lang_word": "невзлюбить",
                                "target_lang_sense_clarification": "начать испытывать неприязнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不喜欢",
                                "target_lang_sense_clarification": "通用表达"
                            },
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "程度较深"
                            },
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "对某人或某事产生抵触情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1aec5133-51c2-3d63-91aa-c84e88492715",
                    "sense_definition": "To register disapproval of online content by clicking a specific button.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "internet_vote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of users <w>disliked</w> the controversial video within an hour.",
                            "target_lang_translations": {
                                "ru": "Тысячи пользователей <w>поставили дизлайк</w> скандальному видео в течение часа.",
                                "zh": "一小时内，成千上万的用户给那个争议视频<w>点踩</w>了。"
                            }
                        },
                        {
                            "text": "Please do not <w>dislike</w> the post just because you disagree with the opinion.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>ставьте дизлайк</w> посту только потому, что вы не согласны с мнением.",
                                "zh": "请不要仅仅因为不同意观点就给帖子<w>点踩</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "like"
                    ],
                    "common_phrases": [
                        "dislike a video",
                        "dislike a comment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать неодобрение онлайн-контенту, нажимая специальную кнопку.",
                        "zh": "在网络平台上通过点击特定按钮来表示不赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить дизлайк",
                                "target_lang_sense_clarification": "действие в интернете"
                            },
                            {
                                "target_lang_word": "дизлайкнуть",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点踩",
                                "target_lang_sense_clarification": "网络用语"
                            },
                            {
                                "target_lang_word": "给……差评",
                                "target_lang_sense_clarification": "表示不认可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cadbeef8-a34b-3830-8425-7b2b4ae135d5",
                    "sense_definition": "To cause displeasure or offense to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy meal <w>disliked</w> him greatly, causing him to feel ill.",
                            "target_lang_translations": {
                                "ru": "Тяжелая пища <w>не пошла</w> ему, вызвав тошноту.",
                                "zh": "那顿油腻的饭让他感到很不舒服，导致他身体不适。"
                            }
                        },
                        {
                            "text": "Such rude behavior <w>dislikes</w> me and makes me want to leave.",
                            "target_lang_translations": {
                                "ru": "Такое грубое поведение мне <w>претит</w> и вызывает желание уйти.",
                                "zh": "这种粗鲁的行为让我<w>反感</w>，让我只想离开。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is no longer common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать неудовольствие или обиду у кого-либо.",
                        "zh": "使某人感到不快或冒犯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть неприятным",
                                "target_lang_sense_clarification": "вызывать отторжение"
                            },
                            {
                                "target_lang_word": "претить",
                                "target_lang_sense_clarification": "вызывать отвращение (устар./книжн.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……不快",
                                "target_lang_sense_clarification": "引起反感"
                            },
                            {
                                "target_lang_word": "令……厌恶",
                                "target_lang_sense_clarification": "书面语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b4fe8e7-b419-32f2-839d-bc511cc30b8e",
                    "sense_definition": "A feeling of not liking or approving of something or someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_aversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made no secret of his <w>dislike</w> for the new company policy.",
                            "target_lang_translations": {
                                "ru": "Он не скрывал своей <w>неприязни</w> к новой политике компании.",
                                "zh": "他毫不掩饰自己对公司新政策的<w>反感</w>。"
                            }
                        },
                        {
                            "text": "She took an instant <w>dislike</w> to the house as soon as she walked in.",
                            "target_lang_translations": {
                                "ru": "Она сразу же почувствовала <w>неприязнь</w> к дому, как только вошла.",
                                "zh": "她一走进那栋房子就立刻产生了<w>厌恶</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distaste",
                        "aversion"
                    ],
                    "antonyms": [
                        "like"
                    ],
                    "common_phrases": [
                        "strong dislike",
                        "take a dislike to",
                        "intense dislike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство нерасположения или неодобрения по отношению к чему-либо или кому-либо.",
                        "zh": "对某人或某事不喜欢或不赞同的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "враждебное отношение"
                            },
                            {
                                "target_lang_word": "нелюбовь",
                                "target_lang_sense_clarification": "отсутствие любви"
                            },
                            {
                                "target_lang_word": "антипатия",
                                "target_lang_sense_clarification": "отвращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "抵触情绪"
                            },
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "强烈的排斥感"
                            },
                            {
                                "target_lang_word": "不喜欢",
                                "target_lang_sense_clarification": "一般性不喜爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2cdcd2e-d670-3f42-ab71-dfbea16aac4b",
                    "sense_definition": "A vote indicating disapproval on a website or social media platform.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "internet_vote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The video received more <w>dislikes</w> than likes due to the poor audio quality.",
                            "target_lang_translations": {
                                "ru": "Видео получило больше <w>дизлайков</w>, чем лайков, из-за плохого качества звука.",
                                "zh": "由于音频质量差，这个视频收到的<w>踩</w>比赞多。"
                            }
                        },
                        {
                            "text": "I accidentally gave the comment a <w>dislike</w> while scrolling down.",
                            "target_lang_translations": {
                                "ru": "Я случайно поставил комментарию <w>дизлайк</w>, прокручивая страницу вниз.",
                                "zh": "我向下滚动页面时，不小心给那条评论<w>点踩</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "like"
                    ],
                    "common_phrases": [
                        "get a dislike",
                        "give a dislike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Голос, указывающий на неодобрение на веб-сайте или в социальной сети.",
                        "zh": "在网站或社交媒体上表示不赞同的投票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дизлайк",
                                "target_lang_sense_clarification": "интернет-термин"
                            },
                            {
                                "target_lang_word": "дисла́йк",
                                "target_lang_sense_clarification": "вариант написания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踩",
                                "target_lang_sense_clarification": "网络投票"
                            },
                            {
                                "target_lang_word": "差评",
                                "target_lang_sense_clarification": "负面评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9e38d20-5cb6-34fe-8ac5-5bf6a3c2c2ae",
                    "sense_definition": "A specific thing that a person does not like.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_aversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat down to discuss our likes and <w>dislikes</w> regarding food.",
                            "target_lang_translations": {
                                "ru": "Мы сели обсудить наши предпочтения и <w>антипатии</w> в еде.",
                                "zh": "我们坐下来讨论了我们在食物方面的喜好和<w>厌恶</w>。"
                            }
                        },
                        {
                            "text": "One of my biggest <w>dislikes</w> is waiting in long lines at the airport.",
                            "target_lang_translations": {
                                "ru": "Одна из вещей, которые я больше всего <w>не люблю</w>, — это ожидание в длинных очередях в аэропорту.",
                                "zh": "我最<w>讨厌</w>的事情之一就是在机场排长队。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "likes and dislikes",
                        "list of dislikes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная вещь, которая человеку не нравится.",
                        "zh": "一个人不喜欢的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет нелюбви",
                                "target_lang_sense_clarification": "то, что не нравится"
                            },
                            {
                                "target_lang_word": "антипатия",
                                "target_lang_sense_clarification": "в контексте вкусов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厌恶的事物",
                                "target_lang_sense_clarification": "指代具体不喜欢的东西"
                            },
                            {
                                "target_lang_word": "反感点",
                                "target_lang_sense_clarification": "个人不喜欢的方面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}