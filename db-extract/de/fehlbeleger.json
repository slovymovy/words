                "senses": [
                    {
                        "sense_id": "af19540c-d3b8-3027-87c4-4a9dac37f83c",
                        "entry_id": "d15298c7-f35d-395e-a45a-47f4842972d4",
                        "glosses": [
                            "nicht den Richtlinien entsprechend untergebrachte Person"
                        ],
                        "tags": [
                            "Amtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "c666c107-c862-40b3-96ef-ceb4d07382fa",
                                "sense_id": "af19540c-d3b8-3027-87c4-4a9dac37f83c",
                                "text": "„Sie gelten als sogenannte Fehlbeleger, die in Flüchtlingsunterkünften untergebracht sind, sich aber eigentlich eine eigene Wohnung suchen müssten.“"
                            },
                            {
                                "example_id": "a384974b-8d0d-4ba1-a46b-1ffdaf9ee421",
                                "sense_id": "af19540c-d3b8-3027-87c4-4a9dac37f83c",
                                "text": "„Doch angesichts unverändert hoher Zuweisungsquoten sieht sich der Landkreis nun gezwungen, die durch die Fehlbeleger blockierten Unterbringungsplätze für neue Asylbewerber frei zu machen.“"
                            },
                            {
                                "example_id": "4362acb3-e967-4455-a09b-fec09c5752fe",
                                "sense_id": "af19540c-d3b8-3027-87c4-4a9dac37f83c",
                                "text": "„Faktische Fehlbeleger sind (weiterhin) grundsätzlich leistungsberechtigt nach dem Asylbewerberleistungsgesetz, jedoch von der Verpflichtung, in Gemeinschaftsunterkünften zu wohnen, befreit.“"
                            },
                            {
                                "example_id": "def78e75-2438-4370-a3a8-fa424123d48b",
                                "sense_id": "af19540c-d3b8-3027-87c4-4a9dac37f83c",
                                "text": "„Laut Sozialministerium gibt es rund 7100 so genannte Fehlbeleger in bayerischen Asyl-Unterkünften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
