                        ]
                    },
                    {
                        "translation_id": "0963ae53-37c2-4768-bff0-b21bff37a0d9",
                        "source_entry_id": "4a55a61a-e351-311f-97cd-48656cccc095",
                        "source_sense_id": "35aed201-e26f-3ea4-9f85-d25699c749fb",
                        "source_sense_description": "using an excessive number of words",
                        "target_lang_word": "weitschweifig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weitschweifig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65002f6a-c531-3371-a6bf-f7fbe3611601",
                                        "entry_id": "97684d75-42bd-32bf-a552-15bc16861d90",
                                        "glosses": [
                                            "eine große Fläche abdeckend, mit vielen Umwegen"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b299a02f-6d5e-48e3-a9bc-5fd5e9b3a3d1",
                                                "sense_id": "65002f6a-c531-3371-a6bf-f7fbe3611601",
                                                "text": "Wir haben oft weitschweifige Wanderungen unternommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                        "entry_id": "97684d75-42bd-32bf-a552-15bc16861d90",
                                        "glosses": [
                                            "ausführlicher und wortreicher als nötig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a239f650-a072-43ed-be66-9e777483029e",
                                                "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                                "text": "Opa erzählte gerne weitschweifige Geschichten von früher."
                                            },
                                            {
                                                "example_id": "ef102920-3fff-4891-8963-f79d9e2a6e4e",
                                                "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                                "text": "Das Für und Wider wurde weitscheifig diskutiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f721b00c-a83e-4d9f-a2fd-8b19b959169f",
                        "source_entry_id": "4a55a61a-e351-311f-97cd-48656cccc095",
                        "source_sense_id": "35aed201-e26f-3ea4-9f85-d25699c749fb",
                        "source_sense_description": "using an excessive number of words",
                        "target_lang_word": "wortreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wortreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                        "entry_id": "2a1adc98-7064-324f-82d6-05e7f475e35c",
                                        "glosses": [
                                            "mit vielen Worten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75f5f2a-333f-4b1d-89c5-e93886549384",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "„Wortreich entschuldigte er sich für den Irrtum.“"
                                            },
                                            {
                                                "example_id": "1ff36ba5-2f55-4ff5-835d-b7a3bc3004f8",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "„Journalisten kritisierten in Journalen wortreich die Journaille…“"
                                            },
                                            {
                                                "example_id": "527b61df-28d1-448d-b074-936ebbf76ee0",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "Sie antwortet immer sehr wortreich. Manche sagen deshalb über ihre Ausführungen: „Es hagelt Worte, doch es rieselt Sinn.“"
                                            },
                                            {
                                                "example_id": "c6609969-8791-4a49-8f74-54366f2f5b9c",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "„Er war sichtlich verwundert, dass ich von diesem Brauchtum noch nichts gehört hatte, seufzte tief und setzte zu einer wortreichen Erklärung an.“"
                                            },
                                            {
                                                "example_id": "e825dd5d-fdcc-4bc8-a71d-8ec8230f0bcd",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "„Während Quangel aber so ungewohnt wortreich daherredet, denkt er innerlich: Ich will 'nen Besen fressen, wenn dieser Barkhausen nicht ein Spitzel ist!“"
                                            },
                                            {
                                                "example_id": "0e19413e-7828-4e5f-8e06-e4d9b1b35fe6",
                                                "sense_id": "2a6fd575-dff3-3f2b-9202-578e9d7e8ef5",
                                                "text": "„Man glaubt, daß ich als Vorsitzender des alten Zentralrats dem neuen gefährlich werden könne, erst nach wortreichem Hin und Her werde ich entlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
