                },
                {
                    "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                    "sense_definition": "Having no actual bottom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mythology, Tartarus is described as a <w>bottomless</w> pit beneath the earth.",
                            "target_lang_translations": {
                                "es": "En la mitología, el Tártaro se describe como un pozo <w>sin fondo</w> bajo la tierra."
                            }
