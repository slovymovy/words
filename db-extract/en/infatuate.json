                        "form": "more infatuate"
                    },
                    {
                        "form_id": "4e385a53-9652-41a3-ba12-78ad3ebc2ebe",
                        "entry_id": "8506fab2-78aa-3bf5-adc1-587273f9d843",
                        "tags": [
                            "superlative"
