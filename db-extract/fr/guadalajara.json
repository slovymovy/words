                    {
                        "sense_id": "d9881051-c99c-3dd8-aa6e-6980d6630d5a",
                        "entry_id": "fb2c3498-f4c0-3413-99a0-112e61e59e13",
                        "glosses": [
                            "Commune et ville d’Espagne, chef-lieu de la province du même nom."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1b803000-a643-3d8c-895e-48588d22493b",
                        "entry_id": "fb2c3498-f4c0-3413-99a0-112e61e59e13",
                        "glosses": [
                            "Province d’Espagne située dans la communauté autonome de Castille-La Manche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98f4837f-8fd1-35a2-885f-188cefe2a178",
                        "entry_id": "fb2c3498-f4c0-3413-99a0-112e61e59e13",
                        "glosses": [
                            "Ville du Mexique, capitale de l’État de Jalisco."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1020fee4-d08f-4cf6-be16-8e0cff560fda",
                                "sense_id": "98f4837f-8fd1-35a2-885f-188cefe2a178",
                                "text": "Guadalajara est la deuxième ville du Mexique après Mexico, avec une population de plus de 4 millions d’habitants."
                            },
                            {
                                "example_id": "6cbdd524-e785-426c-abf7-ab6018150358",
                                "sense_id": "98f4837f-8fd1-35a2-885f-188cefe2a178",
                                "text": "Marie Bouzkova a bénéficié de l’abandon d’Anna Kalinskaya (5-2 ab.) lors des quarts de finale du tournoi de Guadalajara (WTA)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5bc1a6d-b072-4ac2-ba8d-ef5ba0667371",
                        "source_entry_id": "fb2c3498-f4c0-3413-99a0-112e61e59e13",
                        "source_sense_description": "Ville espagnole",
                        "target_lang_word": "Guadalajara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guadalajara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "401c03da-35c4-37bd-b123-d464321139f6",
                                        "entry_id": "ed1abff3-2837-34e2-8155-f9e3d6e0e0f9",
                                        "glosses": [
                                            "Stadt in der spanischen Autonomen Gemeinschaft Kastilien-La Mancha"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e6246b1-4426-30a6-ba2b-2913b1e1b919",
                                        "entry_id": "ed1abff3-2837-34e2-8155-f9e3d6e0e0f9",
                                        "glosses": [
                                            "Provinz in der spanischen Autonomen Gemeinschaft Kastilien-La Mancha"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bb666e8f-d9f3-360c-90b5-310dd038d23e",
                                        "entry_id": "ed1abff3-2837-34e2-8155-f9e3d6e0e0f9",
                                        "glosses": [
                                            "Hauptstadt des mexikanischen Bundesstaates Jalisco"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320036ab-e381-464c-92e7-54f014b56c40",
                                                "sense_id": "bb666e8f-d9f3-360c-90b5-310dd038d23e",
                                                "text": "„In Spanien und Guadalajara geprägte Dublonen und halbe Dublonen fielen heraus, außerdem Golddollars und kleine goldene Halfdollarstücke, französische Zehn-Franc-Münzen, Golden Eagles und Half-Eagles, Ringdollars sowie in North Carolina und Georgia geprägte Dollarmünzen von zweiundzwanzig Karat.“"
                                            },
                                            {
                                                "example_id": "bca34a5b-5bf2-4196-b712-86fe2c0131f9",
                                                "sense_id": "bb666e8f-d9f3-360c-90b5-310dd038d23e",
                                                "text": "„Er erfuhr, dass sie aus Guadalajara kam, Eddie getroffen hatte, als er dort als DEA-Agent gearbeitet hatte, und dass sie geheiratet hatten, kurz bevor er vor fünf Jahren wieder nach Mexiko zog, um der Policía Federal beizutreten.“"
                                            },
                                            {
                                                "example_id": "113757a0-7816-4154-8c94-d5fd9ea059f5",
                                                "sense_id": "bb666e8f-d9f3-360c-90b5-310dd038d23e",
                                                "text": "„Sie wollten sich in einem Lokal ein Stück weit von seinem Büro treffen, in einem der schönsten Viertel von Guadalajara.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6e269d-5f45-49a2-9fb4-8f73c6a836d7",
