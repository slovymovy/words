{
    "word_family": [
        "vanishment",
        "vanishing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a96e732-833e-3a75-a838-79601fc0129f",
                    "sense_definition": "To become invisible or to move out of view suddenly or unnoticed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician made the white rabbit <w>vanish</w> into thin air before the amazed audience.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист заставил белого кролика <w>исчезнуть</w> прямо в воздухе на глазах у изумленной публики."
                            }
                        },
                        {
                            "text": "I watched the small boat slowly <w>vanish</w> without a trace as it sailed toward the horizon.",
                            "target_lang_translations": {
                                "ru": "Я наблюдал, как маленькая лодка медленно <w>скрывается</w> без следа, уплывая к горизонту."
                            }
                        }
                    ],
                    "synonyms": [
                        "disappear"
                    ],
                    "antonyms": [
                        "appear",
                        "emerge"
                    ],
                    "common_phrases": [
                        "vanish into thin air",
                        "vanish without a trace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать невидимым или внезапно и незаметно скрыться из виду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "становиться невидимым"
                            },
                            {
                                "target_lang_word": "скрыться",
                                "target_lang_sense_clarification": "уйти из поля зрения"
                            },
                            {
                                "target_lang_word": "пропадать",
                                "target_lang_sense_clarification": "переставать быть видимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd8a0381-23d3-32f4-8d9e-ba84651b09da",
                    "sense_definition": "To cause someone to disappear, often by kidnapping or for political reasons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the civil war, the secret police would <w>vanish</w> anyone who spoke against the government.",
                            "target_lang_translations": {
                                "ru": "Во время гражданской войны тайная полиция заставляла <w>исчезать</w> любого, кто высказывался против правительства."
                            }
                        },
                        {
                            "text": "It was whispered that several activists had been <w>vanished</w> by the regime and never seen again.",
                            "target_lang_translations": {
                                "ru": "Шептались, что режим заставил <w>исчезнуть</w> нескольких активистов, и их больше никто не видел."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо исчезнуть, часто путем похищения или по политическим мотивам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "насильственно избавляться"
                            },
                            {
                                "target_lang_word": "похищать",
                                "target_lang_sense_clarification": "заставлять исчезнуть тайно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a83158c3-23f4-3611-857f-732435b3b363",
                    "sense_definition": "To become equal to zero in a mathematical context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this specific equation, the function <w>vanishes</w> when the value of x is zero.",
                            "target_lang_translations": {
                                "ru": "В этом конкретном уравнении функция <w>обращается в нуль</w>, когда значение x равно нулю."
                            }
                        },
                        {
                            "text": "The terms in the series <w>vanish</w> as the variable approaches infinity.",
                            "target_lang_translations": {
                                "ru": "Члены ряда <w>обнуляются</w> по мере того, как переменная стремится к бесконечности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать равным нулю в математическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращаться в нуль",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "обнуляться",
                                "target_lang_sense_clarification": "сводиться к нулю"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "852ffeec-201e-3358-9ce0-27cd275703eb",
                    "sense_definition": "A magic trick or illusion in which an object or person seems to disappear.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performer executed a perfect coin <w>vanish</w> that left the children wondering where it went.",
                            "target_lang_translations": {
                                "ru": "Исполнитель продемонстрировал идеальное <w>исчезновение</w> монеты, заставив детей гадать, куда она делась."
                            }
                        },
                        {
                            "text": "He practiced the sleight of hand required for a convincing <w>vanish</w> for many months.",
                            "target_lang_translations": {
                                "ru": "Он много месяцев тренировал ловкость рук, необходимую для убедительного <w>исчезновения</w> предмета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coin vanish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магический трюк или иллюзия, при которой предмет или человек кажется исчезнувшим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезновение",
                                "target_lang_sense_clarification": "фокус или иллюзия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "522d7870-d873-3702-9fba-043a59bb0081",
                    "sense_definition": "The act of disappearing; a vanishment.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>vanish</w> of the suspect from the locked room baffled the investigators.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>исчезновение</w> подозреваемого из запертой комнаты поставило следователей в тупик."
                            }
                        },
                        {
                            "text": "Her mysterious <w>vanish</w> remained the talk of the small town for several decades.",
                            "target_lang_translations": {
                                "ru": "Её таинственное <w>исчезновение</w> оставалось главной темой для разговоров в маленьком городке на протяжении нескольких десятилетий."
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "ru": "Акт исчезновения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезновение",
                                "target_lang_sense_clarification": "процесс или факт пропажи"
                            },
                            {
                                "target_lang_word": "пропажа",
                                "target_lang_sense_clarification": "факт исчезновения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "148c54fa-e0b1-36cc-91c1-6c4af0acef3c",
                    "sense_definition": "The brief terminal part of a vowel sound that differs in quality from the main part.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In certain dialects, the long vowel ends with a distinct <w>vanish</w> toward a higher position.",
                            "target_lang_translations": {
                                "ru": "В некоторых диалектах долгий гласный заканчивается отчетливым <w>отзвуком</w> в сторону более высокого положения."
                            }
                        },
                        {
                            "text": "The phonetician analyzed the <w>vanish</w> of the diphthong to determine the speaker's origin.",
                            "target_lang_translations": {
                                "ru": "Фонетист проанализировал <w>офглид</w> дифтонга, чтобы определить происхождение говорящего."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая конечная часть гласного звука, отличающаяся по качеству от основной части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзвук",
                                "target_lang_sense_clarification": "фонетический термин"
                            },
                            {
                                "target_lang_word": "офглид",
                                "target_lang_sense_clarification": "технический термин в лингвистике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}