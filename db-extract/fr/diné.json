                "senses": [
                    {
                        "sense_id": "dab274e4-206d-3db3-8da0-3f1b9abc3bbd",
                        "entry_id": "2efeea5f-e3e4-3bb2-aadc-be0ebe5066b8",
                        "glosses": [
                            "synonyme de navajo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a612427-b940-458c-91fb-5eb4d66928ce",
                                "sense_id": "dab274e4-206d-3db3-8da0-3f1b9abc3bbd",
                                "text": "La Marine forme dans le Pacifique une unité de transmission spéciale avec 400 Navajos, les Code Talkers, qui se servent de la langue diné dans les communications."
                            },
                            {
                                "example_id": "be167947-c0d1-4f94-a815-a0ee697b6c47",
                                "sense_id": "dab274e4-206d-3db3-8da0-3f1b9abc3bbd",
                                "text": "Quelqu’un l’a raconté à mon père, et lui me l’a raconté ensuite. Comment Jadi était né à Konawa, chez les Indiens choctaws, près de la Canadian River. Sa mère était de la nation diné, et son père français, et c’est pourquoi il s’appelait Anthony Martin."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "839f34b0-6c8e-31dc-87f2-2c137a8efc18",
                "word": "Diné",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "237a9f25-62be-3d8d-bd78-654f0d06bc35",
                        "entry_id": "839f34b0-6c8e-31dc-87f2-2c137a8efc18",
                        "glosses": [
                            "Peuple amérindien des Navajos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04998cc7-7a57-4648-93dc-5dbc36cf7855",
                                "sense_id": "237a9f25-62be-3d8d-bd78-654f0d06bc35",
                                "text": "Le territoire ritualistique du Diné (peuple navajo) est délimité par quatre montagnes qui bornent Dinetah, terre sacrée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3bca1514-063c-3f15-9f4a-78116306167d",
                "word": "diné",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3021f9a1-5ccf-3416-81be-9e190cce768c",
                        "entry_id": "3bca1514-063c-3f15-9f4a-78116306167d",
                        "glosses": [
                            "synonyme de navajo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53398dc1-baa0-4418-b826-9399ca80aa3e",
                                "sense_id": "3021f9a1-5ccf-3416-81be-9e190cce768c",
                                "text": "Le tout premier épisode de La Guerre des étoiles va être traduit dans une langue très rare : le diné, parlé par les indiens navajos."
                            },
                            {
                                "example_id": "524077bd-29aa-4606-9915-6270ffaf36c2",
                                "sense_id": "3021f9a1-5ccf-3416-81be-9e190cce768c",
                                "text": "Ayant grandi dans la Réserve navajo de l’Arizona et plongée dans la culture tribale, sa langue maternelle est le diné."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
