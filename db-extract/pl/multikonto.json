                        "glosses": [
                            "konto zakładane na pewnym serwisie (np. portalu społecznościowym, w grze sieciowej itp.) przez użytkownika, który posiada na nim już inne konto, często wbrew regulaminowi tego serwisu"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
