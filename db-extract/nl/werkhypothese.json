                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d04f925-cdef-4449-82c4-0d44cda25af8",
                                "sense_id": "7e1a3efb-687c-359d-978e-1eef368996d8",
                                "text": "In de flat zijn sporen van geweld aangetroffen. De politie benadrukte maandag dat de theorie vooralsnog een 'werkhypothese' is."
                            },
                            {
                                "example_id": "063c079f-edc7-4ed7-8b48-d3160bd286ba",
                                "sense_id": "7e1a3efb-687c-359d-978e-1eef368996d8",
                                "text": "'De werkhypothese is dat het toestel zuidwaarts ging en dat het zich toen verder verplaatste richting het zuidelijke einde van die hoek', zei de bron, verwijzend naar het zoekgebied dat zich uitstrekt van het westen van Indonesië naar de Indische Oceaan ten westen van Australië."
                            },
                            {
                                "example_id": "99eef10c-18b0-4eb6-a514-761b4aa816c2",
                                "sense_id": "7e1a3efb-687c-359d-978e-1eef368996d8",
                                "text": "De werkhypothese van NLFI is dat met betrekking tot het dossier beleggingsverzekeringen geen enkele garantie of vrijwaring door de Staat en/of SNS Reaal wordt afgegeven.” NLFI meent dat het verkoopproces vooralsnog aan alle voorwaarden van de Europese Commissie voldoet."
                            }
                        ]
                    }
