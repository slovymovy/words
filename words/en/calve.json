{
    "word_family": [
        "calf"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f1d99dd-485a-3968-a70b-2769781c4192",
                    "sense_definition": "To give birth to a calf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer could tell that the cow was about to <w>calve</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер видел, что корова вот-вот <w>отелится</w>."
                            }
                        },
                        {
                            "text": "Several heifers are expected to <w>calve</w> during the early spring.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что несколько нетелей <w>отелятся</w> в начале весны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "about to calve",
                        "due to calve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рожать детёныша (о корове или некоторых других животных); телиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телиться",
                                "target_lang_sense_clarification": "рожать телёнка (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "отелиться",
                                "target_lang_sense_clarification": "родить телёнка (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32056db0-79fc-3919-b4d7-7d1f12a4b4de",
                    "sense_definition": "To break off and release a large mass of ice, such as an iceberg from a glacier or ice shelf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ice_detachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glacier was starting to <w>calve</w> even as the scientists watched.",
                            "target_lang_translations": {
                                "ru": "Ледник начал <w>откалываться</w> прямо на глазах у учёных."
                            }
                        },
                        {
                            "text": "Huge chunks of ice regularly <w>calve</w> into the freezing water below.",
                            "target_lang_translations": {
                                "ru": "Огромные глыбы льда регулярно <w>откалываются</w> и падают в ледяную воду внизу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "calve into the ocean",
                        "glacier calved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отламываться, откалываться (о ледяных массах или айсбергах от ледника)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откалываться",
                                "target_lang_sense_clarification": "о глыбах льда, айсбергах"
                            },
                            {
                                "target_lang_word": "отламываться",
                                "target_lang_sense_clarification": "об айсбергах от ледника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "625c18f7-4b7a-3a5f-8953-908a0bf7f068",
                    "sense_definition": "To assist a cow or similar animal in giving birth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced vet had to <w>calve</w> the difficult heifer late at night.",
                            "target_lang_translations": {
                                "ru": "Опытному ветеринару пришлось поздно ночью <w>принимать отёл</w> у проблемной тёлки."
                            }
                        },
                        {
                            "text": "The farmer <w>calved</w> the cow for almost two hours before the baby was born.",
                            "target_lang_translations": {
                                "ru": "Фермер почти два часа <w>помогал корове отелиться</w>, прежде чем появился телёнок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать отёл у коровы или другого животного, помогать при родах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать отёл",
                                "target_lang_sense_clarification": "помогать корове при рождении телёнка"
                            },
                            {
                                "target_lang_word": "помогать при отёле",
                                "target_lang_sense_clarification": "оказывать помощь животному при родах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}