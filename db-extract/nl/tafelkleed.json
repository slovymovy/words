                "senses": [
                    {
                        "sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                        "entry_id": "97a2a10d-ef7e-3490-9117-cab83688f882",
                        "glosses": [
                            "kleed dat als bescherming of versiering over een tafel ligt"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "9855b8cc-ca6f-4661-96c5-a617257d8897",
                                "sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                                "text": "Na het diner zat het tafelkleed vol vlekken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0721040d-617a-460a-961d-c9ac6692385e",
                        "source_entry_id": "97a2a10d-ef7e-3490-9117-cab83688f882",
                        "source_sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                        "source_sense_description": "kleed dat als bescherming of versiering over een tafel ligt",
                        "target_lang_word": "Tischdecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischdecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                        "entry_id": "1a0586b1-9404-3031-a927-15571c887ea6",
                                        "glosses": [
                                            "Textil, das als Schutz oder Zierde über eine Tischplatte gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "882674af-cca9-4f2c-946a-e50e7a2712f0",
                                                "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                                "text": "Hermann warf seine Tasse um und versaute damit die ganze Tischdecke."
                                            },
                                            {
                                                "example_id": "5e2275db-6076-4f0f-b881-e12e1049ec69",
                                                "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                                "text": "„Im Wohnzimmer schoben wir die Tischdecke zurück und legten eine Zeitung unter die Teller.“"
                                            },
                                            {
                                                "example_id": "7aff4fd6-732c-4c8e-8537-7a6f5c82bdd3",
                                                "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                                "text": "„Er starrte auf die Tischdecke, rauchte eine französische Zigarette und schien zu schlafen.“"
                                            },
                                            {
                                                "example_id": "849c009f-cf56-42cf-ab5c-567bf1c98c3f",
                                                "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                                "text": "„Über der weißen Tischdecke lag eine gehäkelte Decke.“"
                                            },
                                            {
                                                "example_id": "acf81a02-7e98-461c-a722-f9891ca59210",
                                                "sense_id": "5e970b4a-a46e-3994-925c-83f81eeb1676",
                                                "text": "„Es war das gute Geschirr mit dem Goldrand, das Mama nur zu Ostern und Weihnachten und nur mit der blütenweißen, gestärkten Tischdecke hergenommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5108c81e-1cd1-424e-947f-8ac7aa456322",
                        "source_entry_id": "97a2a10d-ef7e-3490-9117-cab83688f882",
                        "source_sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                        "source_sense_description": "kleed dat als bescherming of versiering over een tafel ligt",
                        "target_lang_word": "Tischtuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischtuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c657ecb-0c60-3275-a15a-88e9d26b4df8",
                                        "entry_id": "6fb6b953-41e5-32f5-a99b-4da3a4cbf692",
                                        "glosses": [
                                            "ein Tuch, das auf den Tisch gelegt wird, zum Beispiel aus Anlass einer Mahlzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a24fc0-335b-4725-ac66-e12b75454e53",
                                                "sense_id": "6c657ecb-0c60-3275-a15a-88e9d26b4df8",
                                                "text": "„Das Mobiliar sah bereits recht mitgenommen aus, doch machten die weißen Tischtücher eine Menge wieder gut.“"
                                            },
                                            {
                                                "example_id": "d7ac8048-33e9-4558-b1f1-f0ba6672b0e8",
                                                "sense_id": "6c657ecb-0c60-3275-a15a-88e9d26b4df8",
                                                "text": "„Die silberne Kaffeekanne ist umgefallen und hat ihren Inhalt über das Tischtuch ergossen und einen Frühstücksteller zerschlagen.“"
                                            },
                                            {
                                                "example_id": "5e4f193b-24e6-4fa6-b4ba-9cb15f79d2f2",
                                                "sense_id": "6c657ecb-0c60-3275-a15a-88e9d26b4df8",
                                                "text": "„Papa hatte Metallklemmen für die Tischtücher beschafft.“"
                                            },
                                            {
                                                "example_id": "f6f1dcd3-efe9-4222-bb93-7910d824049e",
                                                "sense_id": "6c657ecb-0c60-3275-a15a-88e9d26b4df8",
                                                "text": "„Es gibt kein Tischtuch, die Teller wurden auf das Holz gesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d7c01eb-5dff-4143-97c3-fa596a78cd4a",
                        "source_entry_id": "97a2a10d-ef7e-3490-9117-cab83688f882",
                        "source_sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                        "source_sense_description": "kleed dat als bescherming of versiering over een tafel ligt",
                        "target_lang_word": "tablecloth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tablecloth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8631cf-9ab3-3378-964c-707b679350be",
                                        "entry_id": "c77a3346-7d46-3b37-ad0e-2737d5eab3e4",
                                        "glosses": [
                                            "A cloth used to cover and protect a table, especially for a dining table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47642dbf-c117-497b-bbfe-6b699c0977e0",
                                                "sense_id": "dc8631cf-9ab3-3378-964c-707b679350be",
                                                "text": "Just across the field stood a small house. In the yard the week's washing was hung out. Among the articles was a red tablecloth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5a78c33-1e2b-40aa-9352-c701d70eeeba",
                        "source_entry_id": "97a2a10d-ef7e-3490-9117-cab83688f882",
                        "source_sense_id": "930d40d5-fbf4-3fb7-a783-043fc26e0253",
                        "source_sense_description": "kleed dat als bescherming of versiering over een tafel ligt",
                        "target_lang_word": "nappe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nappe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Linge dont on couvre la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6f6f17-9fea-4731-8adf-4cf4f53d53e1",
                                                "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                                "text": "[…], sur deux chaises était posé un cercueil de bois blanc, à demi recouvert d’une nappe de toile écrue qu’ornaient seulement le crucifix de cuivre et le rameau de buis bénit."
                                            },
                                            {
                                                "example_id": "efeca600-6112-4ddb-a002-b0804c0764c8",
                                                "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                                "text": "La broderie des chasubles et des nappes d’autel était devenue un art qui occupait le reste de son temps ; elle offrait ensuite ces objets à diverses églises."
                                            },
                                            {
                                                "example_id": "5168f65b-616a-493c-b793-80148a73c5d5",
                                                "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                                "text": "Nappe de communion, linge qu’on étend devant les communiants."
                                            },
                                            {
                                                "example_id": "618f5490-c81b-42d3-83d9-1824700eff91",
                                                "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                                "text": "Nappe fine, ouvrée, damassée, unie, blanche, de couleur."
                                            },
                                            {
                                                "example_id": "64c1345e-167c-49b8-a81d-2166fc4412d1",
                                                "sense_id": "8a4db2a7-7d38-3ccd-a0ce-e83828dc012f",
                                                "text": "Nappe d’autel, linge dont on couvre l’autel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf749de-8077-392b-b59f-6886a5f974c6",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Tout assemblage de fil qui se présente à plat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58378ca7-8aec-459e-bbbc-010c64d86b65",
                                                "sense_id": "faf749de-8077-392b-b59f-6886a5f974c6",
                                                "text": "La nappe formée passe alors entre deux cylindres cannelés 2 et 3, soumis à une forte pression au moyen d’un système de leviers avec contrepoids 5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0296f341-3fe8-39ea-8ea0-8017e3ff5685",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Assemblage de fils à plat reliant la carte mère à certains périphériques. On utilise parfois le terme de limande."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fddb906f-b063-3bf7-805f-aade8077f6af",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Vaste étendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490a9e5b-a99f-4d18-aeea-64c01f9a00f3",
                                                "sense_id": "fddb906f-b063-3bf7-805f-aade8077f6af",
                                                "text": "Cependant l’incendie prenait des proportions formidables […] ; la prairie n’était plus qu’une nappe de flammes, au milieu de laquelle couraient affolées de terreur les bêtes fauves."
                                            },
                                            {
                                                "example_id": "8893b422-dee9-48af-87d4-981a75a76bb9",
                                                "sense_id": "fddb906f-b063-3bf7-805f-aade8077f6af",
                                                "text": "Ce que c’est que d’habiter une maison historique ! M. Majesté n’est pas poète, oh ! non ; et pourtant, en regardant cette belle cour aristocratique, où la lune étend une nappe de lumière bleue, ce vieux logis de grand seigneur qui a si bien l’air de dormir avec ses toits engourdis sous leur capuchon de neige, il lui vient des idées de l’autre monde."
                                            },
                                            {
                                                "example_id": "b1138f5e-347e-444e-8e67-6609ad6b7223",
                                                "sense_id": "fddb906f-b063-3bf7-805f-aade8077f6af",
                                                "text": "Parmi la centaine de nappes d’eau éparpillées qui découlent du bassin versant de la rivière Laviolette, seulement 80 sont exploitées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Ensemble des eaux comprises dans la zone saturée d’un horizon du sol ou d’un aquifère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b4cba2f-9509-4cb7-bb3f-d0f471bcc97d",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "Près de 30 millions de mètres cubes d'eau sont ainsi injectés chaque année, soit 40 % du volume prélevé ensuite par l'homme : cette nappe est essentielle puisqu'elle fournit à elle seule plus de 90 % de l'eau consommée par le million d'habitants de la métropole lyonnaise."
                                            },
                                            {
                                                "example_id": "e8554c37-0271-4e4d-a06a-dc0503084809",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "La qualité de l’eau potable issue de la nappe de Machecoul est à \" 100 % de conformité macrobiologique \" et à \" 99,2 % de conformité physico-chimique \""
                                            },
                                            {
                                                "example_id": "25c4965e-0df3-49bc-a135-13ab5b9983c2",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "Dans les 152 derniers mètres de la section 4, du fait de la présence de la nappe, la berlinoise a été remplacée par des parois préfabriquées faisant également fonction de piédroits pour le tunnel qui a une section en cadre."
                                            },
                                            {
                                                "example_id": "05a40060-d8d4-4efd-a9a0-0c189cd22df8",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "L’actuel captage de Villemanoche qui sollicite la nappe de la craie, a été réalisé en 2000 […]. Auparavant, l'alimentation de la commune était assurée par un ouvrage sollicitant le même aquifère et situé à environ 30 mètres du forage actuel."
                                            },
                                            {
                                                "example_id": "57461c2a-42f7-4e61-88f8-3f81ec61d248",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "Dès la fin novembre, les plantations de peupliers peuvent débuter […]. À l'exception toutefois des stations où la nappe remonte près de la surface en hiver. Dans ces parcelles, mieux vaut attendre mars, voire avril."
                                            },
                                            {
                                                "example_id": "cff00c16-a8d5-4955-bf75-2c3c3b59fdc4",
                                                "sense_id": "6852434a-963d-35d8-832b-5a579dbe2c82",
                                                "text": "La nappe, dans sa partie libre (on appelle ainsi les nappes dont le niveau supérieur, à pression atmosphérique, peut varier, car il n’est pas en contact avec une limite imperméable) est très vulnérable aux pollutions anthropiques, notamment aux nitrates et produits phytosanitaires utilisés pour l’agriculture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b67a1b4-d86c-30eb-aa08-04d5a9249b42",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Sorte de filet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3462b8dd-14dc-4e4c-9ccf-42b56d812ff5",
                                                "sense_id": "9b67a1b4-d86c-30eb-aa08-04d5a9249b42",
                                                "text": "On les tend bien roide avec des piquets ; on laisse entre les nappes autant d’espace qu’elles peuvent en couvrir, et un homme caché dans une loge à peu de distance, les tire lorsque les oiseaux sont dans l’espace qui doit les envelopper, en sorte que les nappes se ferment comme les deux battants d’une porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cdf5b44-27ba-3421-a874-3ca50a26227c",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Peau du cerf qu’on étend par terre, quand on veut donner la curée aux chiens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8934b4ed-4772-3828-9c6b-7fa476aba952",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Partie connexe d’un hyperboloïde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "437f649a-4db4-35d4-8dcd-91207814b4d5",
                                        "entry_id": "15a884b4-75e2-3fdd-9028-43d34ec37fc2",
                                        "glosses": [
                                            "Ensemble de sons prolongés, faiblement rythmés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4657ff-ce12-4b4a-9859-6837e5a9af49",
                                                "sense_id": "437f649a-4db4-35d4-8dcd-91207814b4d5",
                                                "text": "Et le voilà parti dans ses fameuses « sheets of sound », comme elles seront vite baptisées, ces nappes de son qui n’ont plus de définition rythmique à proprement parler, qui sont juste une élan d’un accord à un autre, une longue respiration qui s’élève, s’élève en s’enroulant autour d’elle-même, comme la corde du fakir."
                                            }
                                        ]
                                    }
                                ]
