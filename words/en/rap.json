                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно и непринужденно разговаривать с кем-либо.",
                        "zh": "与某人自由、随意地交谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "разговаривать"
                            },
                            {
                                "target_lang_word": "трепаться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "随意交谈"
                            },
                            {
                                "target_lang_word": "侃大山",
                                "target_lang_sense_clarification": "口语化的聊天"
                            }
                        ]
                    }
                }
            ]
        }
    ]
