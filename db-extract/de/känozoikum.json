                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae3a217-9865-40d3-b899-98d154f9a16f",
                                                "sense_id": "3593351c-e3a9-3d4e-bc74-d0b3ced52396",
                                                "text": "Кайнозой — это эра, отличающаяся большим разнообразием наземных, морских и летающих животных."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d67804f-9675-3071-a9bb-829b20f852c4",
