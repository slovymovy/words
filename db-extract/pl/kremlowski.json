                        "translation_id": "d6b1608e-ab7f-494a-8658-c51ededc78bf",
                        "source_entry_id": "8048d279-778e-3d58-87c0-ebdb149fa810",
                        "source_sense_id": "c2c3de4e-8272-3a4a-bfcd-27e220d7729f",
                        "target_lang_word": "кремлёвский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кремлёвский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3ab5da-1fd4-3044-b813-da0327b2540e",
                                        "entry_id": "2c9f1477-f53a-3ef3-943a-1215255b3170",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительными кремль, Кремль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e63dec1-65a5-4bf1-83a8-9b5f19a7afb8",
                                                "sense_id": "aa3ab5da-1fd4-3044-b813-da0327b2540e",
                                                "text": "Кремлёвский культурный слой по своей мощности, доходящей до 4.75 м, оказался далеко превосходящим слой Торговой стороны."
                                            },
                                            {
                                                "example_id": "a0ad0830-971c-4de7-b51a-4dfe41a667f0",
                                                "sense_id": "aa3ab5da-1fd4-3044-b813-da0327b2540e",
                                                "text": "Г. Стеллецкий[,] например, убеждён, что только тщательное изучение подземных кремлёвских ходов в Москве может дать материал для решения старого, но очень важного вопроса о том, куда девалась знаменитая библиотека Иоанна Грозного, которая приводила в восторг иностранцев и которая, по преданию, ещё при жизни Иоанна Грозного и по его приказанию [была перенесена] в кремлёвское подземелье."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
