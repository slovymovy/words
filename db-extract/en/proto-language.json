                                    {
                                        "sense_id": "169a220e-ba82-377f-b699-78c3051fd7a9",
                                        "entry_id": "d7aab734-b7a8-3dd0-ba48-24e350c728da",
                                        "glosses": [
                                            "Langue théorique et non attestée reconstruite à partir des similarités entre d’autres langues dont on pense qu’elles sont issues de cette langue unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7f6dde-e3de-45fd-82a0-4d5370981204",
                                                "sense_id": "169a220e-ba82-377f-b699-78c3051fd7a9",
                                                "text": "L’indo-européen est une protolangue."
                                            },
                                            {
                                                "example_id": "7348224e-6d30-43e9-bf31-f6b18cf1e9b8",
                                                "sense_id": "169a220e-ba82-377f-b699-78c3051fd7a9",
                                                "text": "Le linguiste doit aussi chercher à découvrir comment les langues qui sont apparentées ont évolué de la protolangue jusqu’à leurs formes actuelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eca11330-cba3-465f-8151-30b88eb45f6c",
                        "source_entry_id": "54fb4866-97a7-3829-89f3-0aeb9d38e3a2",
                        "source_sense_description": "common ancestor language",
                        "target_lang_word": "Ursprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ursprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                        "entry_id": "4ce98f97-a95f-3375-9367-1e64545fbb87",
                                        "glosses": [
                                            "die – meist nicht schriftlich überlieferte, sondern durch Rekonstruktion erschlossene – Sprache, aus der heraus sich im Lauf der Zeit Tochtersprachen entwickelt haben, die zusammen mit der Ursprache eine Sprachfamilie bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c7820c-0335-44e1-95bb-f90a27d634bc",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "Für die romanischen Sprachen ist Latein eine Ursprache."
                                            },
                                            {
                                                "example_id": "98f829d1-c4fb-486c-9392-d2e6f217f0cc",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "Urgermanisch ist eine nicht belegte, sondern nur rekonstruierte Ursprache der germanischen Sprachen."
                                            },
                                            {
                                                "example_id": "83100603-2543-4c84-8d84-7c25f7f43c61",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "„Die von den Russen angewandte Methode beruht auf der Rekonstruktion der »Protosprache« jeder Familie, das heißt der hypothetischen Ursprache, von der die verschiedenen modernen Sprachen abstammen (…).“"
                                            },
                                            {
                                                "example_id": "eab58987-b21f-430a-8cea-7bd7f605e302",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "„Bereits für die ältere Linguistik stand fest, daß Sprachen dann auf eine gemeinsame Ursprache zurückzuführen seien, wenn sie die genannten regelmäßigen Lautentsprechungen in lexikalischen und grammatischen Elementen erkennen ließen.“"
                                            },
                                            {
                                                "example_id": "c1bd4f40-5585-4e7d-a38c-f19b520debb0",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "„Diese indogermanische Ursprache ist eine wissenschaftliche Konstruktion; geschichtlich bezeugt oder schriftlich überliefert ist sie nicht.“"
                                            },
                                            {
                                                "example_id": "0b7a93e4-c371-46be-aac8-1f1cf491d48a",
                                                "sense_id": "ad56e9b0-c0c8-3e7a-8c92-afedf074688e",
                                                "text": "„Dass es eine gemeinsame Ursprache, das Indogermanische, gegeben haben muss, lässt sich feststellen, wenn man Wörter aus diesen Sprachen miteinander vergleicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3b0c24d-3064-37d1-a2dd-ba219f3a90e5",
                                        "entry_id": "4ce98f97-a95f-3375-9367-1e64545fbb87",
                                        "glosses": [
                                            "Originalsprache eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee1c7ee-7d28-4eb3-9e49-86e635ff5da0",
                                                "sense_id": "f3b0c24d-3064-37d1-a2dd-ba219f3a90e5",
                                                "text": "Die Ursprache der Bibel ist nicht Deutsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
