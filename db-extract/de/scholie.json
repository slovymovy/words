                "senses": [
                    {
                        "sense_id": "7f3458eb-f2b7-3ec2-92e0-3f487222acd9",
                        "entry_id": "d2c8c23e-d262-3842-abde-4afcb282a8db",
                        "glosses": [
                            "erklärende Randbemerkung in antiken Literaturwerken"
                        ],
                        "tags": [],
