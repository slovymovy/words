                    {
                        "sense_id": "9ceb18d3-8855-3b52-8db8-5cb5182c337b",
                        "entry_id": "0b618766-72ab-3c00-8807-be6b2a853dd8",
                        "glosses": [
                            "Cheville qui est attachée perpendiculairement sur le plat d’une roue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35df4740-51c1-44c5-8c0e-4ea672f8efe7",
                                "sense_id": "9ceb18d3-8855-3b52-8db8-5cb5182c337b",
                                "text": "En horlogerie, la roue d’étouteau sert à régler la sonnerie des heures, des demies et des quarts."
                            },
                            {
                                "example_id": "cc8fe932-2f5a-4844-b1f3-d270fea65dc9",
                                "sense_id": "9ceb18d3-8855-3b52-8db8-5cb5182c337b",
                                "text": "Dans les baïonnettes à douille, l’étouteau, fixé sur la douille, sert à limiter le mouvement de la virole."
                            },
                            {
                                "example_id": "fcf64955-86c9-403e-993b-fc01d8ba603b",
                                "sense_id": "9ceb18d3-8855-3b52-8db8-5cb5182c337b",
                                "text": "Les chefs armuriers enlèveront la partie tronconique de l’étouteau des chiens existant actuellement dans le chargement, et transformeront en bouchons filetés les étouteaux de rechange. Ce travail sera exécuté sans rétribution spéciale."
                            }
                        ]
                    }
