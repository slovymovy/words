    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "9bbe0365-2c0f-3aad-a07e-624a59e07543",
                "word": "aangespen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a2dfdad-5e31-355e-ac6a-f1da52ae7940",
                        "entry_id": "9bbe0365-2c0f-3aad-a07e-624a59e07543",
                        "glosses": [
                            "vastmaken met een gesp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e227dd15-0a39-4aa6-8e43-99599d13b8ab",
                                "sense_id": "3a2dfdad-5e31-355e-ac6a-f1da52ae7940",
                                "text": "Latours beroemde voorbeeld is dat van de autogordel. Omdat bestuurders deze vaak niet uit zichzelf aangespen, worden zij via dashboard-signalen hierop aangesproken. Zelfs is overwogen om een auto te ontwerpen waarvan de motor niet start als de gordel niet vastgegespt is. Het apparaat nodigt of dwingt de gebruiker om zich veilig te gedragen. De waarde 'veiligheid' blijkt hier niet zozeer in de mens als in het apparaat te zijn verinnerlijkt."
                            },
                            {
                                "example_id": "df727e25-29d4-4efb-a396-682be28992fe",
                                "sense_id": "3a2dfdad-5e31-355e-ac6a-f1da52ae7940",
                                "text": "Allemaal zware motoren, met voluptueuze spatborden, brede sturen en nadrukkelijk geprofileerde koelribben. Ze zijn in staat in een week dwars door de Verenigde Staten te rijden, en als hun berijders zich in hun lederen jacks ritsen en hun laarzen aangespen zou je zweren dat ze daar ook niet voor terugdeinzen. Maar de realiteit van het post-Easy Rider tijdperk is hard: het weekeinde duurt maar kort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ce683ab-7fc9-4115-9cb0-7391aaa23d1d",
                        "source_entry_id": "9bbe0365-2c0f-3aad-a07e-624a59e07543",
                        "source_sense_id": "3a2dfdad-5e31-355e-ac6a-f1da52ae7940",
                        "source_sense_description": "vastmaken met een gesp",
                        "target_lang_word": "clasping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clasping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6aa024d-07c7-38c2-9107-ed4d184d1fff",
                                        "entry_id": "e1e7db3e-684b-3eb9-ba07-2c5448b7b91a",
                                        "glosses": [
                                            "present participle and gerund of clasp"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clasping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdcd3384-771f-3468-971e-eaa758862278",
                                        "entry_id": "6d8fc29b-1a27-3bb6-b169-f9d1d7809c72",
                                        "glosses": [
                                            "The act by which something is clasped."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4b5dde-02fe-4338-849f-527d9f14bc55",
                                                "sense_id": "cdcd3384-771f-3468-971e-eaa758862278",
                                                "text": "Nothing had been said during our drive, but the high thin breathing of our new companion, and the claspings and unclaspings of his hands spoke of the nervous tension within him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d12c8747-934c-42d7-86a6-ecc11ee70bf5",
                        "source_entry_id": "9bbe0365-2c0f-3aad-a07e-624a59e07543",
                        "source_sense_id": "3a2dfdad-5e31-355e-ac6a-f1da52ae7940",
                        "source_sense_description": "vastmaken met een gesp",
                        "target_lang_word": "gird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c704a045-019c-33a3-830e-ada4bbb02fd9",
                                        "entry_id": "7d335b8c-6c6c-32ec-bc6e-c1429022d968",
                                        "glosses": [
                                            "To bind with a flexible rope or cord."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836655d8-b4bb-4bff-b703-85b811516fce",
                                                "sense_id": "c704a045-019c-33a3-830e-ada4bbb02fd9",
                                                "text": "The fasces were girt about with twine in bundles large."
                                            },
                                            {
                                                "example_id": "84848239-66d4-4434-851a-c93ce6688acf",
                                                "sense_id": "c704a045-019c-33a3-830e-ada4bbb02fd9",
                                                "text": "We heere create thee the firſt Duke of Suffolke, / And girt thee with the Sword. Coſin of Yorke"
                                            },
                                            {
                                                "example_id": "fe70bd68-f99c-4007-813f-3c9a143e3d56",
                                                "sense_id": "c704a045-019c-33a3-830e-ada4bbb02fd9",
                                                "text": "Gird thy sword vpon thy thigh, O most mightie: with thy glory and thy maiestie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "042bbb07-a8dc-317e-b9cc-4355734cfed5",
                                        "entry_id": "7d335b8c-6c6c-32ec-bc6e-c1429022d968",
                                        "glosses": [
                                            "To encircle with, or as if with a belt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b38098f-8e18-441c-aa71-fc7e2bc618de",
                                                "sense_id": "042bbb07-a8dc-317e-b9cc-4355734cfed5",
                                                "text": "The lady girt herself with silver chain, from which she hung a golden shear."
                                            },
                                            {
                                                "example_id": "3398133e-aad0-4a2b-9bee-565ae339b26a",
                                                "sense_id": "042bbb07-a8dc-317e-b9cc-4355734cfed5",
                                                "text": "And he put vpon him the coate, and girded him with the girdle, and clothed him with the robe, and put the Ephod vpon him, and he girded him with the curious girdle of the Ephod, and bound it vnto him therewith."
                                            },
                                            {
                                                "example_id": "68cecbee-682d-4368-b837-ab785bc0ad37",
                                                "sense_id": "042bbb07-a8dc-317e-b9cc-4355734cfed5",
                                                "text": "Australia's sons, let us rejoice, / For we are young and free / We've golden soil and wealth for toil / Our home is girt by sea"
                                            },
                                            {
                                                "example_id": "a73c947e-36fb-409f-8600-a04446da697e",
                                                "sense_id": "042bbb07-a8dc-317e-b9cc-4355734cfed5",
                                                "text": "It took me back across the dim gulf of ages to some happy home in dead Imperial Kôr, where this winsome lady girt about with beauty had lived and died, and dying taken her last-born with her to the tomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7c871b-b68f-3c29-9ec0-eaee94be571c",
                                        "entry_id": "7d335b8c-6c6c-32ec-bc6e-c1429022d968",
                                        "glosses": [
                                            "To prepare (oneself) for an action."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f02c98-9369-4724-ab54-63ca57094cf0",
                                                "sense_id": "3f7c871b-b68f-3c29-9ec0-eaee94be571c",
                                                "text": "The remarks came just days after Putin appeared to be girding Russians for a protracted war in Ukraine, saying that his military operation could be a “long-term process”."
                                            },
                                            {
                                                "example_id": "f1505913-dd3d-475e-b6b9-bdc710586d9b",
                                                "sense_id": "3f7c871b-b68f-3c29-9ec0-eaee94be571c",
                                                "text": "Associate your selues, O ye people, and yee shalbe broken in pieces; and giue eare all ye of farre countreys: gird your selues, and ye shalbe broken in pieces; gird your selues, and ye shalbe broken in pieces."
                                            },
                                            {
                                                "example_id": "b27e3f35-2306-41ea-bbd5-d4f8e109489e",
                                                "sense_id": "3f7c871b-b68f-3c29-9ec0-eaee94be571c",
                                                "text": "The poet is not trying to conform to any of the old standards of behavior. She is instead focusing her rage and girding herself for battle."
                                            },
                                            {
                                                "example_id": "42944776-0c08-4c39-a0fd-0ddb122f89e5",
                                                "sense_id": "3f7c871b-b68f-3c29-9ec0-eaee94be571c",
                                                "text": "[…] I was intrigued by the notion of ‘virtual beating’, so I entered the words in the Mamma search engine. I girded myself for the sleaziest sites on the net, the kind that advertise the video of Pamela Anderson and Tommy Lee uncut, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a58ea8-2fa7-34a5-9d4a-505b1b46cdb2",
                                        "entry_id": "7d335b8c-6c6c-32ec-bc6e-c1429022d968",
                                        "glosses": [
                                            "(of a vessel towing another) To be pulled on sideways by its towline, putting it at risk of capsizing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5545522e-5be1-4033-a9a5-f8d76813a1bc",
                                                "sense_id": "58a58ea8-2fa7-34a5-9d4a-505b1b46cdb2",
                                                "text": "On 19 July 2009, the tug North Arm Venture was towing the barge North Arm Express, loaded with fuel and deck cargo, from Toba Inlet to Sechelt Inlet. The tug girded and capsized at approximately 1250 Pacific Daylight Time while making a turn to port at the entrance to Sechelt Rapids .... Girding is defined as a situation where a vessel experiences athwartship forces from its towline. This situation can lead to a capsizing or foundering."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4517e5b-637c-3bb1-a6a2-12cbb04dec98",
                                        "entry_id": "619d3f57-39d7-3306-b72d-54bb165e2cdf",
                                        "glosses": [
                                            "A sarcastic remark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923a5c8f-a50b-470f-8643-5715f816c2f0",
                                                "sense_id": "e4517e5b-637c-3bb1-a6a2-12cbb04dec98",
                                                "text": "I thank thee for that gird, good Tranio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2859300b-52dc-37be-a341-5d6046fc6272",
                                        "entry_id": "619d3f57-39d7-3306-b72d-54bb165e2cdf",
                                        "glosses": [
                                            "A stroke with a rod or switch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cef7ef5-a650-3dd1-b6cf-96d605b14559",
                                        "entry_id": "619d3f57-39d7-3306-b72d-54bb165e2cdf",
                                        "glosses": [
                                            "A severe spasm; a twinge; a pang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd42412-547b-4d09-aee0-e1f4eac1638e",
                                                "sense_id": "0cef7ef5-a650-3dd1-b6cf-96d605b14559",
                                                "text": "Conscience […] is freed from many fearful girds and twinges which the atheist feels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9180e17a-9778-343a-8b35-89c6fe59d76e",
                                        "entry_id": "bfb8d603-5110-321d-a522-2b12a8d52a08",
                                        "glosses": [
                                            "To jeer at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6d603a4-6baa-4897-ba78-57221650a29f",
                                                "sense_id": "9180e17a-9778-343a-8b35-89c6fe59d76e",
                                                "text": "Being moved, he will not spare to gird the gods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88df2a2c-a54d-34eb-8b99-0bd6312df54c",
                                        "entry_id": "bfb8d603-5110-321d-a522-2b12a8d52a08",
                                        "glosses": [
                                            "To jeer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8807ca0-ae30-4b08-bd74-f8a1c6b9fabb",
                                                "sense_id": "88df2a2c-a54d-34eb-8b99-0bd6312df54c",
                                                "text": "Men of all sorts take a pride to gird at me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
