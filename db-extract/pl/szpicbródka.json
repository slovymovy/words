                                    {
                                        "sense_id": "c711587f-eb3f-34a2-a492-e20248ed1566",
                                        "entry_id": "b8f8ab9d-2628-34c1-bf73-fef1f169a250",
                                        "glosses": [
                                            "nach unten immer schmaler werdender, in einer Spitze endender Kinnbart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d53b90-7ba4-45af-b5b7-3da6d8a1e758",
                                                "sense_id": "c711587f-eb3f-34a2-a492-e20248ed1566",
                                                "text": "„Mein Spitzbart war naß, Brillengläser angelaufen, Froschaugen entzündet, hatte rote Flecken in den Achselhöhlen und zwischen den Schenkeln, wußte das, obwohl ich das Rot nicht sehen konnte.“"
                                            },
                                            {
                                                "example_id": "28124b73-8eb3-4c44-bb1a-f52eb445517c",
                                                "sense_id": "c711587f-eb3f-34a2-a492-e20248ed1566",
                                                "text": "„Der Mann, der auf dem Kopf eine dunkle Samtkappe trug, hatte rote Backen und einen weißen Spitzbart wie ein Gnom.“"
                                            },
                                            {
                                                "example_id": "3cb5efc5-456c-4bd4-a214-ff546a6a37ef",
                                                "sense_id": "c711587f-eb3f-34a2-a492-e20248ed1566",
                                                "text": "„Er ist klein, hat einen Spitzbart und flinke Augen.“"
                                            }
                                        ],
