{
    "word_family": [
        "coparticiper",
        "participant",
        "participatif",
        "participation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edfd7011-d570-34ff-b57e-16d5dbf9de79",
                    "sense_definition": "Prendre part activement à une action, à une activité ou à un événement collectif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les élèves de la classe souhaitent <w>participer</w> au spectacle de fin d'année."
                        },
                        {
                            "text": "Elle va <w>participer</w> à une réunion importante avec toute son équipe demain matin."
                        }
                    ],
                    "synonyms": [
                        "collaborer",
                        "coopérer"
                    ],
                    "antonyms": [
                        "s'abstenir"
                    ],
                    "common_phrases": [
                        "participer à une réunion",
                        "participer à un projet"
                    ]
                },
                {
                    "sense_id": "0bec0360-f06c-3475-80d4-a4e7314a9f1c",
                    "sense_definition": "Contribuer financièrement à une dépense commune ou payer sa part de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque colocataire doit <w>participer</w> aux frais de nourriture et d'électricité chaque mois."
                        },
                        {
                            "text": "Nous avons décidé de <w>participer</w> financièrement à l'achat du cadeau pour notre collègue."
                        }
                    ],
                    "synonyms": [
                        "contribuer",
                        "cotiser"
                    ],
                    "common_phrases": [
                        "participer aux frais",
                        "participer au financement"
                    ]
                },
                {
                    "sense_id": "38e4b177-379c-3e56-90e4-378f64cfe4ad",
                    "sense_definition": "S'associer aux sentiments, aux émotions ou à l'épreuve vécue par autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voisins sont venus nous voir pour <w>participer</w> à notre douleur après cette terrible nouvelle."
                        },
                        {
                            "text": "Tous les amis proches tenaient à <w>participer</w> à leur joie lors de cette belle annonce."
                        }
                    ],
                    "synonyms": [
                        "compatir",
                        "partager"
                    ],
                    "common_phrases": [
                        "participer à la douleur",
                        "participer au deuil"
                    ]
                },
                {
                    "sense_id": "3e90566d-3222-3243-a75e-cab2c185d8ba",
                    "sense_definition": "Avoir part à quelque chose, en recevoir une quote-part ou une portion légitime.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon leur contrat de travail, les salariés vont <w>participer</w> aux bénéfices annuels de l'entreprise."
                        },
                        {
                            "text": "En investissant dans cette société, il espère <w>participer</w> aux futurs gains générés par les ventes."
                        }
                    ],
                    "common_phrases": [
                        "participer aux bénéfices",
                        "participer aux gains"
                    ]
                },
                {
                    "sense_id": "5fd5878e-8fd0-3264-9515-ad8861c87fdf",
                    "sense_definition": "Tenir de la nature de quelque chose, en partager les caractéristiques essentielles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce récit poétique <w>participe</w> à la fois du conte merveilleux et du témoignage historique."
                        },
                        {
                            "text": "Sa réaction étrange <w>participe</w> d'un sentiment de méfiance profondément enraciné chez lui."
                        }
                    ],
                    "synonyms": [
                        "relever de",
                        "s'apparenter à"
                    ],
                    "common_phrases": [
                        "participer de la folie"
                    ]
                }
            ]
        }
    ]
}