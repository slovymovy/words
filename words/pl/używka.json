    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fc33261-bbb8-36d3-b9d3-43c892c77156",
                    "sense_definition": "substancja lub produkt spożywczy niemający wartości odżywczych, wpływający pobudzająco lub odurzająco na układ nerwowy (np. kawa, alkohol, tytoń)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substancja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zalecił mu całkowite odstawienie wszelkich <w>używek</w>, zwłaszcza mocnej kawy i alkoholu.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал ему полностью отказаться от любых <w>стимуляторов</w>, особенно крепкого кофе и алкоголя."
                            }
                        },
                        {
                            "text": "Kofeina to popularna <w>używka</w>, po którą sięga codziennie wielu dorosłych ludzi.",
                            "target_lang_translations": {
                                "ru": "Кофеин — это популярный <w>стимулятор</w>, к которому ежедневно прибегают многие взрослые."
                            }
                        }
                    ],
                    "synonyms": [
                        "stymulant",
                        "użytek"
                    ],
                    "common_phrases": [
                        "sięgać po używki",
                        "unikać używek"
                    ],
                    "target_lang_definitions": {
                        "ru": "вещество или продукт питания, не имеющий питательной ценности, оказывающий стимулирующее или одурманивающее действие на нервную систему (например, кофе, алкоголь, табак)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимулятор",
                                "target_lang_sense_clarification": "возбуждающее вещество, напр. кофеин"
                            },
                            {
                                "target_lang_word": "психоактивное вещество",
                                "target_lang_sense_clarification": "более формальный общий термин"
                            },
                            {
                                "target_lang_word": "вредная привычка",
                                "target_lang_sense_clarification": "употребление табака, алкоголя и т. п. (в контексте)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "320f0bda-a6de-31cb-9336-c21f9c7be6b4",
                    "sense_definition": "przedmiot z drugiej ręki, który był już wcześniej przez kogoś używany",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przedmiot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie stać mnie na nowy samochód z salonu, dlatego kupię sprawdzoną <w>używkę</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу позволить себе новую машину из автосалона, поэтому куплю проверенную <w>подержанную</w>."
                            }
                        },
                        {
                            "text": "Ta konsola do gier to zadbana <w>używka</w> kupiona w bardzo dobrej cenie.",
                            "target_lang_translations": {
                                "ru": "Эта игровая консоль — ухоженная <w>б/у вещь</w>, купленная по очень хорошей цене."
                            }
                        }
                    ],
                    "antonyms": [
                        "nówka"
                    ],
                    "common_phrases": [
                        "kupić używkę",
                        "tania używka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie rzeczy używanej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "подержанная вещь, предмет, уже бывший в употреблении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "б/у вещь",
                                "target_lang_sense_clarification": "бывший в употреблении предмет"
                            },
                            {
                                "target_lang_word": "подержанная вещь",
                                "target_lang_sense_clarification": "предмет со вторых рук"
                            }
                        ]
                    }
                }
            ]
