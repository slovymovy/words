{
    "word_family": [
        "angelic",
        "archangel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6110ea65-12a1-3b4c-b2d0-0c10005439c5",
                    "sense_definition": "An incorporeal and holy messenger from a deity, traditionally depicted as a youthful, winged figure in flowing robes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting shows a beautiful <w>angel</w> with large white wings.",
                            "target_lang_translations": {
                                "ru": "На картине изображён прекрасный <w>ангел</w> с большими белыми крыльями.",
                                "zh": "画中描绘了一位长着巨大白翅膀的美丽<w>天使</w>。"
                            }
                        },
                        {
                            "text": "She believes that a guardian <w>angel</w> watches over her family.",
                            "target_lang_translations": {
                                "ru": "Она верит, что <w>ангел</w>-хранитель оберегает её семью.",
                                "zh": "她相信有一位守护<w>天使</w>在保佑她的家人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guardian angel",
                        "fallen angel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверхъестественный посланник Бога, традиционно изображаемый как крылатая фигура в светлых одеждах.",
                        "zh": "一种超自然的、神圣的使者，传统上被描绘为长着翅膀、身穿长袍的年轻形象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ангел",
                                "target_lang_sense_clarification": "религиозное существо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天使",
                                "target_lang_sense_clarification": "宗教中的神圣使者"
                            },
                            {
                                "target_lang_word": "安琪儿",
                                "target_lang_sense_clarification": "天使的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79b3849d-427c-3233-b9b5-95282714d6b4",
                    "sense_definition": "A person who is exceptionally kind, selfless, or innocent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are such an <w>angel</w> for helping me with the cleaning.",
                            "target_lang_translations": {
                                "ru": "Ты просто <w>ангел</w>, раз помог мне с уборкой.",
                                "zh": "你真是个<w>天使</w>，帮我一起打扫卫生。"
                            }
                        },
                        {
                            "text": "The baby looks like a perfect little <w>angel</w> when he sleeps.",
                            "target_lang_translations": {
                                "ru": "Ребёнок выглядит как настоящий маленький <w>ангел</w>, когда спит.",
                                "zh": "宝宝睡觉的时候看起来就像个完美的小<w>天使</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be an angel",
                        "absolute angel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, отличающийся исключительной добротой, бескорыстием или невинностью.",
                        "zh": "形容一个人非常善良、无私或纯洁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ангел",
                                "target_lang_sense_clarification": "добрый человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天使",
                                "target_lang_sense_clarification": "比喻善良纯洁的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37338480-3e19-38b6-9814-0bd982e2fa06",
                    "sense_definition": "An investor who provides financial backing for small startups or entrepreneurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_backer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup was saved by a wealthy <w>angel</w> who believed in their product.",
                            "target_lang_translations": {
                                "ru": "Стартап был спасён богатым <w>бизнес-ангелом</w>, который поверил в их продукт.",
                                "zh": "这家初创公司被一位相信他们产品的富有<w>天使投资人</w>救活了。"
                            }
                        },
                        {
                            "text": "He works as an <w>angel</w> investor for technology companies.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>бизнес-ангелом</w> для технологических компаний.",
                                "zh": "他担任科技公司的<w>天使投资人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backer"
                    ],
                    "common_phrases": [
                        "angel investor",
                        "business angel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвестор, предоставляющий финансовую поддержку стартапам или предпринимателям.",
                        "zh": "为小型初创企业或创业者提供资金支持的投资者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бизнес-ангел",
                                "target_lang_sense_clarification": "инвестор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天使投资人",
                                "target_lang_sense_clarification": "金融领域的投资人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0cfb229b-22ec-35b5-a913-a8b22eb23f00",
                    "sense_definition": "A male given name.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "name_male",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Angel</w> is coming to the party tonight.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Энджел</w> придёт сегодня на вечеринку.",
                                "zh": "我的朋友<w>安赫尔</w>今晚要来参加派对。"
                            }
                        },
                        {
                            "text": "Please introduce yourself to <w>Angel</w> when you arrive.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, представься <w>Энджелу</w>, когда придёшь.",
                                "zh": "你到了之后请向<w>安赫尔</w>做个自我介绍。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Энджел",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安赫尔",
                                "target_lang_sense_clarification": "男性人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af87e8c3-9b0e-372d-bb20-873721e98cf4",
                    "sense_definition": "A female given name.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "name_female",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Angel</w> was the most popular girl in our school.",
                            "target_lang_translations": {
                                "ru": "<w>Энджел</w> была самой популярной девочкой в нашей школе.",
                                "zh": "<w>安赫尔</w>是我们学校最受欢迎的女孩。"
                            }
                        },
                        {
                            "text": "They decided to name their daughter <w>Angel</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать дочь <w>Энджел</w>.",
                                "zh": "他们决定给女儿取名为<w>安赫尔</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Энджел",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安赫尔",
                                "target_lang_sense_clarification": "女性人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd353188-94c7-3873-b682-a5e36831216c",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Angel</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Энджел</w> примет вас в своём кабинете сейчас.",
                                "zh": "<w>安赫尔</w>先生现在要在办公室见你。"
                            }
                        },
                        {
                            "text": "The <w>Angel</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Энджел</w> живёт в этом городе уже несколько поколений.",
                                "zh": "<w>安赫尔</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Энджел",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安赫尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e890d5fb-b351-308b-94af-1bddedf577ba",
                    "sense_definition": "To support a business or theatrical production by donating money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_backer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>angel</w> the show despite the high financial risks.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>спонсировать</w> шоу, несмотря на высокие финансовые риски.",
                                "zh": "尽管财务风险很高，她还是决定<w>资助</w>这场演出。"
                            }
                        },
                        {
                            "text": "They are looking for someone to <w>angel</w> the new Broadway production.",
                            "target_lang_translations": {
                                "ru": "Они ищут кого-то, кто мог бы <w>профинансировать</w> новую бродвейскую постановку.",
                                "zh": "他们正在寻找愿意<w>投资</w>这部新百老汇作品的人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать бизнес или театральную постановку деньгами.",
                        "zh": "通过捐赠资金来支持商业或戏剧制作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спонсировать",
                                "target_lang_sense_clarification": "финансировать"
                            },
                            {
                                "target_lang_word": "финансировать",
                                "target_lang_sense_clarification": "выделять средства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "提供资金支持"
                            },
                            {
                                "target_lang_word": "投资",
                                "target_lang_sense_clarification": "投入资金"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}