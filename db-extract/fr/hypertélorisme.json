                        "entry_id": "19aa7e4b-b077-32b3-932c-acde3c896bf8",
                        "glosses": [
                            "Malformation congénitale, cranio-faciale, qui se caractérise par un élargissement de l'espace inter-orbitaire et de la base du nez. Elle est associée dans de nombreux cas à des troubles oculaires et à de la déficience mentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2efafb2-29f8-4379-92f2-eed2bd7be1c8",
                                "sense_id": "d991f681-f429-3f5b-9c06-7ea5b2286f53",
                                "text": "L'hypertélorisrne orbitaire (1-1T0), correspondant à une augmentation de l'espace séparant les orbites, est retrouvé dans diverses malformations cranio-faciales."
                            }
                        ]
                    }
                ],
