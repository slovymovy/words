                "senses": [
                    {
                        "sense_id": "3c624714-f4d0-36d3-b9cf-d90046646927",
                        "entry_id": "7fba9666-1fad-35a1-9d39-5f35d008aea1",
                        "glosses": [
                            "Waffe, die einen besonders starken Laserstrahl zur Bekämpfung der Ziele verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594a0b87-0cae-461c-b9c9-7478dfc4e34a",
                                "sense_id": "3c624714-f4d0-36d3-b9cf-d90046646927",
                                "text": "„Man konnte eine Laserkanone auf böse Alienroboter abfeuern, die durch ein Portal in einer Wand sprangen.“"
                            },
                            {
                                "example_id": "b1b7fef0-c743-4a2a-b8ce-e459fcdb71a5",
                                "sense_id": "3c624714-f4d0-36d3-b9cf-d90046646927",
                                "text": "Dank der höheren Leistung und Reichweite könnte sie [eine 150KW Laserkanone] dann wohl auch Raketen vom Himmel holen könnte, bevor sie das Schiff treffen."
                            },
                            {
                                "example_id": "5ca66ae5-3f6c-49e0-a547-4d436ac4b92a",
                                "sense_id": "3c624714-f4d0-36d3-b9cf-d90046646927",
                                "text": "„Wie aus dem Nichts geht ein unbemanntes Schnellboot in Flammen auf - das US-Militär hat im persischen Golf eine neue Laserkanone getestet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
