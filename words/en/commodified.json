{
    "word_family": [
        "commodity",
        "commodify",
        "commodification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "650a96eb-5f4a-37f6-96eb-085ff05676b5",
                    "sense_definition": "Treated as a product that can be bought, sold, or traded for profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercialization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist felt that her personal life had been <w>commodified</w> by the media for entertainment.",
                            "target_lang_translations": {
                                "zh": "这位艺术家感到她的私生活被媒体<w>商品化</w>了，沦为娱乐的工具。"
                            }
                        },
                        {
                            "text": "In modern society, even basic human experiences are often <w>commodified</w> and sold as luxury services.",
                            "target_lang_translations": {
                                "zh": "在现代社会，即使是基本的人类体验也常常被<w>商品化</w>，并作为奢侈服务出售。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commercialized",
                        "marketized"
                    ],
                    "target_lang_definitions": {
                        "zh": "被视为可以买卖或交易以获取利润的商品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "商品化",
                                "target_lang_sense_clarification": "指将某事物变成可供买卖的商品。"
                            },
                            {
                                "target_lang_word": "商业化",
                                "target_lang_sense_clarification": "指以营利为目的进行运作。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bed3fe1-652c-3c2c-b596-9a91d2fad2e0",
                    "sense_definition": "Simple past and past participle of <w>commodify</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercialization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>commodified</w> the data collected from its users to increase its advertising revenue.",
                            "target_lang_translations": {
                                "zh": "该公司将收集到的用户数据<w>商品化</w>，以增加其广告收入。"
                            }
                        },
                        {
                            "text": "They have <w>commodified</w> traditional cultural practices to attract more tourists to the region.",
                            "target_lang_translations": {
                                "zh": "他们已经将传统的文化习俗<w>商品化</w>，以吸引更多的游客来到该地区。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb commodify."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将某事物变成商品，使其具有商业价值。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "商品化",
                                "target_lang_sense_clarification": "动词用法，指使某事物成为商品。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}