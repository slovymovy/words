                                        "examples": [
                                            {
                                                "example_id": "d220702d-3091-4ab2-b209-05033bca3355",
                                                "sense_id": "130ecf31-aa2a-3f85-93a9-70bc7219bd29",
                                                "text": "De eenden werden door een lokeend in de kooi gelokt."
                                            },
                                            {
                                                "example_id": "1d08af2b-33e2-45ec-9fd7-fca48ccf28b6",
                                                "sense_id": "130ecf31-aa2a-3f85-93a9-70bc7219bd29",
                                                "text": "Nella is ervan overtuigd dat de miniatuurmaakster hier is geweest, en ze kan zich niet voorstellen dat de vrouw haar naar zich toe zou lokken en haar vervolgens in de steek zou laten."
                                            }
                                        ]
                                    },
