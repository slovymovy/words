                            {
                                "example_id": "16f0b338-7f1c-4ca2-9d42-39eff81e09ed",
                                "sense_id": "4c2d853b-bbc5-3d2e-81fd-99ff8c9d1ee7",
                                "text": "Et puis, je pensais au niston, ce petit voyou de roupilleur qui dormait sur sa maman la nuit de l’orage."
                            },
                            {
                                "example_id": "1b7d20ce-40bf-4144-a50c-482183f7020a",
                                "sense_id": "4c2d853b-bbc5-3d2e-81fd-99ff8c9d1ee7",
                                "text": "— Ce putain de Blanchon ! Je l’tuerai, l’ordure… Je l’tuerai… Il m’a battu comme si j’étais encore un niston. Si j’osais, j’irais tout raconter au pitaine…"
                            }
                        ]
