                "senses": [
                    {
                        "sense_id": "cb89c1c1-390f-3e9b-8c20-412a7fa79510",
                        "entry_id": "1beeec05-aa94-38b7-b641-cac90f6474ac",
                        "glosses": [
                            "dem Abbau nervöser Zustände dienende aus feinkörnigem Material gepresste Tablette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588dbe31-42a4-42dd-96d1-e433dff513f7",
                                "sense_id": "cb89c1c1-390f-3e9b-8c20-412a7fa79510",
                                "text": "„Ein Beamter gab mir dann 5 Beruhigungspulver, die ich natürlich wegwarf.“"
                            },
                            {
                                "example_id": "0aa25efc-0e56-483b-944f-108df255d916",
                                "sense_id": "cb89c1c1-390f-3e9b-8c20-412a7fa79510",
                                "text": "„Am liebsten hätte er ein Beruhigungspulver gehabt, aber danach zu fragen schämte er sich. “"
                            },
                            {
                                "example_id": "0d48eea9-ca4b-408f-a408-64bfb2a82ac1",
                                "sense_id": "cb89c1c1-390f-3e9b-8c20-412a7fa79510",
                                "text": "übertragen: „Die am 20. Januar tagenden Arbeiter- und Soldatenräte des Reviers protestierten, wie der Zechenverband triumphierend feststellte, gegen die am 18. Januar angeordnete Wahl von Zechen- und Bergwerksräten, da sie kein „Beruhigungspulver für die Belegschaften“ wünschten, sondern „praktische sozialistische Arbeit“.“"
                            },
                            {
                                "example_id": "089bebc6-500b-41ea-8ac6-9c4bf9f46e1c",
                                "sense_id": "cb89c1c1-390f-3e9b-8c20-412a7fa79510",
                                "text": "übertragen: „Bei der ersten Besprechung über die drohende Verkleinerung der Dresdner Heide hat Herr Minister Reinhold versucht, ein kleines Beruhigungspulver herumzureichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
