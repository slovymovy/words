                                "target_senses": [
                                    {
                                        "sense_id": "58b38a57-4827-3855-beef-6e586b41354a",
                                        "entry_id": "b5a30964-b4da-3e46-9214-1166433f0f04",
                                        "glosses": [
                                            "graziös, feingliedrig, zart gebaut, auf ansprechende Weise fein und klein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b17b1a25-9ae9-4742-8d01-1fe4d9da70eb",
                                                "sense_id": "58b38a57-4827-3855-beef-6e586b41354a",
                                                "text": "Das Mädchen hat zierliche Füßchen."
                                            },
                                            {
                                                "example_id": "57436b4f-4b87-482b-b607-46cb34ab1460",
                                                "sense_id": "58b38a57-4827-3855-beef-6e586b41354a",
                                                "text": "Diese zierlichen Porzellanfigürchen zerbrechen wohl bei geringster Berührung."
                                            },
                                            {
                                                "example_id": "53a9a5c6-b0d2-4748-baf1-d7aba74a604f",
                                                "sense_id": "58b38a57-4827-3855-beef-6e586b41354a",
                                                "text": "Weil sie [Judith Scholz aus Koblenz] klein und zierlich ist, sitzt sie auf zwei Kissen, um besser über das Lenkrad gucken zu können."
                                            },
                                            {
                                                "example_id": "d42f00a0-b6da-41e2-b467-53b64e686c0f",
                                                "sense_id": "58b38a57-4827-3855-beef-6e586b41354a",
                                                "text": "Juliette Binoche, schmal und zart, schlägt die Beine mit den zierlichen Stiefelchen übereinander."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c7c2dec-2b66-47ea-902e-c992892b5179",
                        "source_entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
                        "source_sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                        "target_lang_word": "slender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Thin; slim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90d9a6f-073c-4c72-ad73-e5583d4890c0",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "A rod is a long slender pole used for angling."
                                            },
                                            {
                                                "example_id": "ba70c749-66a2-4b05-83d9-8affa575765e",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "She is very slender."
                                            },
                                            {
                                                "example_id": "0127d8bc-f5e0-49ce-8488-ba383eb3f2af",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Meagre; deficient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2278568-096a-42f7-a28f-2c61d759af28",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "Being a person of slender means, he was unable to afford any luxuries."
                                            },
                                            {
                                                "example_id": "2c9e090e-a06b-44b7-8609-1dad26b94025",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The grounds for the conjecture are somewhat slender."
                                            },
                                            {
                                                "example_id": "83df510e-0748-4e8a-abd7-6b7c67286d08",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The slender service between Ellesmere Port and Helsby has been added, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1256381b-7d42-3cc1-9bc0-172a03b48829",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Palatalized."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "301939b3-11c0-4061-90c7-cbc79e0f1eec",
                        "source_entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
                        "source_sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
                        "target_lang_word": "sylphlike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sylphlike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                        "entry_id": "550f44f2-2d1f-3a24-b9c2-2d52e55d8750",
                                        "glosses": [
                                            "Resembling (that of) a sylph; slender and graceful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670dd856-563e-493c-94c6-827893997741",
                                                "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                                "text": "Once Tex had said to me, very sister-to-sister, “Aren’t we mad, we gay boys, starving ourselves to sylphlike fragility, all so we can attract a straight cop with a beer belly?”"
                                            },
                                            {
                                                "example_id": "b5a3d203-53ae-4523-b244-d9a6d6d2a9db",
                                                "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                                "text": "Soon advancing through the hall, he saw the sylphlike figure of the lovely Olympia […]"
                                            },
                                            {
                                                "example_id": "344e27f3-90bc-474c-8d13-102aa452ee97",
                                                "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                                "text": "[…] the thin robes\nFloating like light clouds ’twixt our gaze and heaven;\nThe many-twinkling feet so small and sylphlike,\nSuggesting the more secret symmetry\nOf the fair forms which terminate so well—"
                                            },
                                            {
                                                "example_id": "b492d4af-aafc-4712-9b2b-4effe28f5fdb",
                                                "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                                "text": "Arm's length from her he saw the sylphlike grace of her girlish body"
                                            },
                                            {
                                                "example_id": "5dba5aa3-3f36-4cf2-bb8a-e39728aca5cf",
                                                "sense_id": "5e2ca418-0b2e-30e9-a6fd-d60964170593",
                                                "text": "Here we see a few of the 48 diminutive hopefuls who showed up that day, awaiting their turn to impress the judges with a high instep or a particularly sylphlike extension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed312c54-16e9-4084-8619-f4b449cd3686",
                        "source_entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
