    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b49d91f8-7be4-33dc-9d54-df3da0c926bb",
                    "sense_definition": "Appeler la protection divine sur une personne ou consacrer rituellement un objet par la prière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant le repas de fête, le grand-père aimait <w>bénir</w> toute la famille réunie."
                        },
                        {
                            "text": "Le prêtre avance dans l'allée centrale pour <w>bénir</w> les fidèles avec de l'eau sacrée."
                        }
                    ],
                    "synonyms": [
                        "consacrer",
                        "sanctifier"
                    ],
                    "antonyms": [
                        "maudire"
                    ],
                    "common_phrases": [
                        "bénir l'assemblée",
                        "bénir les époux"
                    ]
                },
                {
                    "sense_id": "8c5d82b1-10ac-38e1-b7d2-151ec753c3a3",
                    "sense_definition": "Se réjouir vivement d'une circonstance favorable ou éprouver une profonde gratitude pour un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>bénis</w> le ciel d'avoir enfin trouvé une solution à ce problème complexe."
                        },
                        {
                            "text": "Chaque matin, elle <w>bénit</w> le jour où elle a décidé de changer de carrière."
                        }
                    ],
                    "synonyms": [
                        "louer",
                        "remercier"
                    ],
                    "antonyms": [
                        "maudire"
                    ],
                    "common_phrases": [
                        "bénir le ciel",
                        "bénir le jour",
                        "bénir le hasard"
                    ]
                },
                {
                    "sense_id": "db9c5156-1cb6-309f-90f8-09ed5b4fae54",
                    "sense_definition": "Combler de faveurs, protéger et faire prospérer, en parlant du destin ou de Dieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "faveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chance semblait <w>bénir</w> tous leurs projets commerciaux depuis le début de l'année."
                        },
                        {
                            "text": "Les anciens espéraient que la providence divine allait <w>bénir</w> leurs futures récoltes de blé."
                        }
                    ],
                    "synonyms": [
                        "favoriser",
                        "protéger"
                    ],
                    "antonyms": [
                        "maudire"
                    ],
                    "common_phrases": [
                        "bénir une entreprise",
                        "bénir les récoltes"
                    ]
                }
            ]
        }
    ]
