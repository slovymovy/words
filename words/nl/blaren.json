    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aab19fe-b7dd-3ecb-bcd6-f7fc3ded66e1",
                    "sense_definition": "Meervoud van <w>blaar</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "blaar_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling had hij grote <w>blaren</w> op zijn voeten.",
                            "target_lang_translations": {
                                "en": "After the long walk he had large <w>blisters</w> on his feet."
                            }
                        },
                        {
                            "text": "Hij moest verzorging zoeken voor zijn pijnlijk <w>blaren</w> op zijn hielen.",
                            "target_lang_translations": {
                                "en": "He had to seek care for his painful <w>blisters</w> on his heels."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pijnlijke blaren",
                        "blaren op de voeten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of blaar"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of blister."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blisters",
                                "target_lang_sense_clarification": "painful skin bubbles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1d8a38-cc6f-3bc4-a905-77197b496a6e",
                    "sense_definition": "Meervoud van <w>blad</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "blad_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst vallen de <w>blaren</w> van de bomen.",
                            "target_lang_translations": {
                                "en": "In autumn, the <w>leaves</w> fall from the trees."
                            }
                        },
                        {
                            "text": "Hij veegde de droge <w>blaren</w> in de tuin bij elkaar.",
                            "target_lang_translations": {
                                "en": "He swept up the dry <w>leaves</w> in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "bladeren"
                    ],
                    "common_phrases": [
                        "vallende blaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "variant plural of blad"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of leaf (dialectal/variant form of 'bladeren')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leaves",
                                "target_lang_sense_clarification": "tree or plant leaves"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87e58b43-2699-3de0-8b3f-79a019a76654",
                    "sense_definition": "Blaren krijgen of doen ontstaan op de huid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "blaar_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het zware werk met de schep begonnen zijn handen snel te <w>blaren</w>.",
                            "target_lang_translations": {
                                "en": "Because of the heavy shovel work, his hands quickly started to <w>blister</w>."
                            }
                        },
                        {
                            "text": "Mijn voeten <w>blaren</w> altijd als ik nieuwe schoenen draag.",
                            "target_lang_translations": {
                                "en": "My feet always <w>blister</w> when I wear new shoes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snel blaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To form blisters on the skin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blister",
                                "target_lang_sense_clarification": "to form skin blisters"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62b05ec7-2933-3361-b722-a52c786931cc",
                    "sense_definition": "Het geluid maken van een schaap of geit; blaten.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schapen <w>blaren</w> luidruchtig in de wei als het etenstijd is.",
                            "target_lang_translations": {
                                "en": "The sheep <w>bleat</w> noisily in the pasture when it is feeding time."
                            }
                        },
                        {
                            "text": "In de verte hoorde ik een kleine geit <w>blaren</w> om haar moeder.",
                            "target_lang_translations": {
                                "en": "In the distance I heard a small goat <w>bleating</w> for its mother."
                            }
                        }
                    ],
                    "synonyms": [
                        "blaten",
                        "bulken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound of a sheep or goat; bleat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleat",
                                "target_lang_sense_clarification": "make sheep or goat sounds"
                            },
                            {
                                "target_lang_word": "baa",
                                "target_lang_sense_clarification": "animal noise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c145bd-684d-37fd-922f-197a70b468d8",
                    "sense_definition": "Luid en onaangenaam roepen, zingen of huilen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dronken mannen bleven tot diep in de nacht luidkeels <w>blaren</w> op straat.",
                            "target_lang_translations": {
                                "en": "The drunk men kept <w>bellowing</w> loudly on the street until late at night."
                            }
                        },
                        {
                            "text": "Het kind begon opeens te <w>blaren</w> toen het zijn zin niet kreeg.",
                            "target_lang_translations": {
                                "en": "The child suddenly started to <w>bawl</w> when it didn't get its way."
                            }
                        }
                    ],
                    "synonyms": [
                        "blèren",
                        "tieren"
                    ],
                    "common_phrases": [
                        "luidkeels blaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or negative connotation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To shout, sing, or cry loudly and unpleasantly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bellow",
                                "target_lang_sense_clarification": "shout loudly"
                            },
                            {
                                "target_lang_word": "bawl",
                                "target_lang_sense_clarification": "cry or shout noisily"
                            },
                            {
                                "target_lang_word": "holler",
                                "target_lang_sense_clarification": "shout loudly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}