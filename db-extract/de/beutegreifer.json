                                    {
                                        "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                        "entry_id": "09014bf5-9efa-383d-96c1-43956d3f2917",
                                        "glosses": [
                                            "Any animal or other organism that hunts and kills other non-plant organisms (their prey), primarily for food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25718967-dec4-417b-9ad6-91fae49dd803",
                                                "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                                "text": "Hives should be positioned, oriented and protected to avoid predators and ensure survival in the meliponary. A study (pers. obs.) of predators shows that the main culprits in a Malaysian meliponary are frogs and lizards."
                                            },
                                            {
                                                "example_id": "7febb5de-f022-4dab-b43b-ea0564e530e1",
                                                "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                                "text": "So if you're the only thing worth eating in the middle of the ocean, the predator that grabs you will probably have gotten there by a Levy walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3169c32-3708-3e1a-91b6-955a24b42852",
                                        "entry_id": "09014bf5-9efa-383d-96c1-43956d3f2917",
                                        "glosses": [
                                            "Someone who attacks and plunders for gain."
                                        ],
