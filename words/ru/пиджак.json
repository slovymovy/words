                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твой новый <w>пиджак</w> уже ждёт тебя у подъезда с цветами.",
                            "target_lang_translations": {
                                "en": "Your new <w>suitor</w> is already waiting for you at the entrance with flowers.",
                                "nl": "Je <w>nieuwe aanbidder</w> staat al bij de ingang op je te wachten met bloemen.",
                                "pl": "Twój nowy <w>kawaler</w> czeka już na ciebie przed klatką z kwiatami.",
                                "de": "Dein neuer <w>Verehrer</w> wartet bereits mit Blumen am Eingang auf dich.",
                                "fr": "Ton nouveau <w>soupirant</w> t'attend déjà à l'entrée avec des fleurs.",
                                "it": "Il tuo nuovo <w>cavaliere</w> ti sta già aspettando all'ingresso con i fiori.",
                                "cs": "Tvůj nový <w>nápadník</w> už na tebe čeká u vchodu s květinami.",
                                "tr": "Yeni <w>kavalyen</w> kapının önünde elinde çiçeklerle seni bekliyor bile.",
                                "es": "Tu nuevo <w>pretendiente</w> ya te está esperando en la entrada con flores."
                            }
                        },
                        {
                            "text": "На танцы она пришла одна, но её <w>пиджак</w> скоро появился.",
                            "target_lang_translations": {
                                "en": "She came to the dance alone, but her <w>beau</w> soon appeared.",
                                "nl": "Ze kwam alleen naar het dansfeest, maar haar <w>vrijer</w> verscheen al snel.",
                                "pl": "Na tańce przyszła sama, ale jej <w>chłopak</w> szybko się pojawił.",
                                "de": "Sie kam allein zum Tanz, aber ihr <w>Kavalier</w> tauchte bald auf.",
