            "senses": [
                {
                    "sense_id": "9ff6b2cf-d145-36fa-affd-7596119a5488",
                    "sense_definition": "Een continu, zacht geluid makend dat op de z-klank lijkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De motor laat alleen een licht <w>zoemend</w> geluid horen wanneer er echt gas wordt gegeven.",
                            "target_lang_translations": {
                                "en": "The engine only makes a slight <w>humming</w> sound when you really step on the gas."
                            }
                        },
                        {
                            "text": "Ik kon niet slapen door het irritante, <w>zoemende</w> geluid van een mug in mijn kamer.",
                            "target_lang_translations": {
                                "en": "I couldn't sleep because of the annoying, <w>buzzing</w> sound of a mosquito in my room."
                            }
                        }
                    ],
                    "synonyms": [
                        "gonzend"
                    ],
                    "common_phrases": [
                        "zoemend geluid",
                        "zoemende insecten"
                    ],
                    "target_lang_definitions": {
                        "en": "Making a continuous, soft sound resembling a 'z' sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buzzing",
                                "target_lang_sense_clarification": "making a continuous low humming sound like a bee"
                            },
                            {
                                "target_lang_word": "humming",
                                "target_lang_sense_clarification": "making a low, steady continuous sound like an engine"
                            }
                        ]
                    }
                }
            ]
        },
        {
