                "senses": [
                    {
                        "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                        "entry_id": "53d93ab8-15fe-3890-915d-bd9d99dfe39b",
                        "glosses": [
                            "Boire l’apéritif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b65c6e-7169-4ba9-b302-cce40bb6cefc",
                                "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                                "text": "Pour sa part, Benjamin Crespo et quelques habitués continuaient d’y apéritiver."
                            },
                            {
                                "example_id": "471d7d00-572b-4ed1-a85b-2951070ae1e6",
                                "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                                "text": "Or, ce concert incluait un entracte où nous comptions apéritiver de la sorte."
                            },
                            {
                                "example_id": "2379821e-0e21-44fb-86f4-f059515224bd",
                                "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                                "text": "En attendant le plaisir d’apéritiver en votre compagnie, quand vous reviendrez de vacances, agréez, monsieur le percepteur, l’assurance de ma considération la plus élévatoire."
                            },
                            {
                                "example_id": "4f255f2e-5553-4deb-9a06-d71b5a3857be",
                                "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                                "text": "Nous nous apéritivons d’un verre d'eau minérale et continuons notre route."
                            },
                            {
                                "example_id": "fafa9d68-6a31-41ad-9d4f-a5e4b2127869",
                                "sense_id": "123850e2-4b84-3cc6-ad87-68a41c292fcb",
                                "text": "Le bar, fait-il à mi-voix, pas déranger l’honorable clille venu s’apéritiver céans."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae1ee646-f56c-3bc7-9485-3811f53bd99d",
                        "entry_id": "53d93ab8-15fe-3890-915d-bd9d99dfe39b",
                        "glosses": [
                            "S’ouvrir l’appétit, de façon générale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cddd368-ee53-4024-999d-81a7464cab9a",
                                "sense_id": "ae1ee646-f56c-3bc7-9485-3811f53bd99d",
                                "text": "Le P. Jousse — car on ne lui dit pas mon lieutenant mais “mon Père” — me céda son propre cheval, un grand alezan dans le style de Page, tandis que lui montait un cheval de prise allemand et l’on partit s’apéritiver d’une trotte de 8 kilomètres dans des forêts splendides au crépuscule."
                            }
                        ]
                    }
