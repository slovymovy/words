                    {
                        "sense_id": "003c0d34-47e1-3488-a9a4-25aed48a84e0",
                        "entry_id": "3d3a8f41-04fe-3666-955b-45bc64251801",
                        "glosses": [
                            "prettig voor vrouwen; uitnodigend voor vrouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0df228f-87fe-4a86-bf08-ed66da097cc2",
                                "sense_id": "003c0d34-47e1-3488-a9a4-25aed48a84e0",
                                "text": "Wanneer vrouwen in Iran niet voldoen aan de islamitische kledingvoorschriften, worden ze niet meer gearresteerd en gestraft. In plaats daarvan worden ze ’heropgevoed’. Met die versoepeling lijkt Iran zich - in navolging van Saoedi-Arabië - te willen opstellen als steeds toleranter en vrouwvriendelijker land."
                            },
                            {
                                "example_id": "6a627fc1-3a11-4d71-bdaf-efbcbf54137c",
                                "sense_id": "003c0d34-47e1-3488-a9a4-25aed48a84e0",
                                "text": "Damon zou een klein rolletje spelen in de film waarin deze keer juist vrouwen de hoofdrollen spelen. In zo’n vrouwvriendelijke film hoort Damon niet thuis, stellen de mensen achter de petitie."
                            }
                        ]
                    }
