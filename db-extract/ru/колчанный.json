                ],
                "senses": [
                    {
                        "sense_id": "a0ab5b45-d5ba-37d9-bd0b-5fb09a33092c",
                        "entry_id": "8cf5dcbc-b1ac-367a-a0fd-898b616bf7d7",
                        "glosses": [
                            "свойственный колчану, предназначенный для колчана, либо имеющий к этому футляру для стрел иное непосредственное отношение."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c609bf-d9c5-43ae-b816-ed778127f59c",
                                "sense_id": "a0ab5b45-d5ba-37d9-bd0b-5fb09a33092c",
                                "text": "А это предметы сурового воинского быта: колчанная скоба, накладки на солдатскую портупею, псалии, колчанный крючок, наконечник ремня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5c1cd87-7e78-4653-a8ef-1ac98b1693b1",
                        "source_entry_id": "8cf5dcbc-b1ac-367a-a0fd-898b616bf7d7",
                        "source_sense_id": "a0ab5b45-d5ba-37d9-bd0b-5fb09a33092c",
                        "target_lang_word": "quiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A container for arrows, crossbow bolts or darts, such as those fired from a bow, crossbow or blowgun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91812c30-7fe8-4c00-85ac-583d930defd9",
                                                "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                                "text": "Don Pedro: Nay, if Cupid have not spent all his quiver in Venice, thou wilt quake for this shortly."
                                            },
                                            {
                                                "example_id": "19b8b72b-436d-466b-be60-3c44d1e04f40",
                                                "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                                "text": "Arrows were carried in quiver, called also an arrow case, which served for the magazine, arrows for immediate use were worn in the girdle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70fdfec9-d7c9-3de8-9135-1907801baf91",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A ready storage location for figurative tools or weapons."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1f61ef-94cf-49d9-8818-8caef4b4f948",
                                                "sense_id": "70fdfec9-d7c9-3de8-9135-1907801baf91",
                                                "text": "He's got lots of sales pitches in his quiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e75cf66-a671-3b67-8847-c6a05c03f3ef",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A vulva."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b7e5456-045b-313d-b510-bf96f64788f0",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "The collective noun for cobras."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6354aefd-98dc-3323-99da-275ea2482118",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A multidigraph, especially in the context of representation theory."
                                        ],
                                        "tags": [],
