                "senses": [
                    {
                        "sense_id": "1e09abbf-ddda-3f39-aac3-de5e117de1d3",
                        "entry_id": "a521b777-63d9-3c76-ada5-ac4baf361bae",
                        "glosses": [
                            "тот, кто принадлежит к тому или иному лобби"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84ad979-9fc4-469e-9842-061905319b1e",
                                "sense_id": "1e09abbf-ddda-3f39-aac3-de5e117de1d3",
                                "text": "Сегодня и из самой старинной в мире демократии, швейцарской, раздается тревожное предупреждение (Ганс Штауб): что важные решения принимаются в анонимных и неконтролируемых местах, где-то за кулисами, под влиянием «групп давления», «лоббистов»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9470ef41-cc66-4bc8-af61-8ed859ce5533",
                        "source_entry_id": "a521b777-63d9-3c76-ada5-ac4baf361bae",
                        "source_sense_id": "1e09abbf-ddda-3f39-aac3-de5e117de1d3",
                        "target_lang_word": "lobbyist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobbyist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a750e2db-00c9-3209-a592-1f1a51f2686f",
                                        "entry_id": "ce9256e9-8bbc-3d3c-b017-a50e7d8925fa",
                                        "glosses": [
                                            "A person who is paid to lobby politicians and encourage them to vote a certain way or otherwise use their office to effect a desired result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7e6963-5728-4f55-8cb5-c282d7356e97",
                                                "sense_id": "a750e2db-00c9-3209-a592-1f1a51f2686f",
                                                "text": "Banning President Trump from Twitter didn't just cut his personal communications channel but curbed a cottage industry of lobbyists and consultants who monetized their ability to get clients into his Twitterverse. […] One lobbyist told Axios his firm paid another consulting shop to generate earned media for clients, including tweets from prominent MAGA personalities such as Charlie Kirk, the founder of the pro-Trump student group Turning Point USA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51bcde8f-9c18-4b6f-ac8c-f7e2e6e38876",
                        "source_entry_id": "a521b777-63d9-3c76-ada5-ac4baf361bae",
                        "source_sense_id": "1e09abbf-ddda-3f39-aac3-de5e117de1d3",
                        "target_lang_word": "Lobbyist",
                        "target_lang_code": "de",
