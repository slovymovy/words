                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983e271e-c7bb-4652-a64f-fb4235473dab",
                                "sense_id": "675460d8-23aa-3919-b36b-07a36f3f21c2",
                                "text": "„Sie schluckt, Blut und zertrümmerte Diamanten und Zahnsplitter, und verzieht entsetzlich das Gesicht.“"
                            },
                            {
                                "example_id": "3cbb7817-64a2-4666-8fc4-25c5ad2b4664",
                                "sense_id": "675460d8-23aa-3919-b36b-07a36f3f21c2",
                                "text": "„Das grausige Todesgrinsen war der Gipfel der Brutalität - die Zahnsplitter im aufgequollenen Fleisch des Gaumens zwangen mich, den Blick abzuwenden.“"
                            }
                        ],
