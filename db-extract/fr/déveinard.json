                        "entry_id": "40ca7ac4-fa32-3bad-9d2d-49b48945fbe1",
                        "glosses": [
                            "Personne qui a de la déveine, de la malchance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0b98e2-55d3-467d-aad8-ddd5a9cba518",
                                "sense_id": "d641072f-2ddd-3822-a967-56f589c4bd9b",
                                "text": "Il sʼacharne, le déveinard, il transpire à grosses gouttes."
                            },
                            {
                                "example_id": "25227d30-a26e-4a02-949b-7d5309c473ae",
                                "sense_id": "d641072f-2ddd-3822-a967-56f589c4bd9b",
                                "text": "H. était et resta un déveinard ; cette nuit même, en chargeant son pistolet signaleur, il se tira une fusée dans la tige de sa botte et dut être évacué avec des brûlures graves."
                            }
                        ]
                    }
