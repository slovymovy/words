                    "sense_id": "970f0bc0-7989-3ca8-8682-b3236f3df12d",
                    "sense_definition": "The quality or state of lacking tact, social sensitivity, or diplomacy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>tactlessness</w> combined with his bluntness made him many enemies at the office. ",
                            "target_lang_translations": {
                                "tr": "Aşırı harbiligiyle birleşen <w>patavatsızlığı</w> ofiste birçok düşman edinmesine neden oldu."
                            }
                        },
                        {
                            "text": "Her extreme <w>tactlessness</w> was obvious when she made social blunders during the formal dinner.",
                            "target_lang_translations": {
                                "tr": "Resmi akşam yemeğinde yaptığı sosyal gaflar sırasında aşırı <w>inceliksizliği</w> çok barizdi."
                            }
                        }
                    ],
