                "senses": [
                    {
                        "sense_id": "6c74c832-2cfd-309d-8d69-05e27ab1db77",
                        "entry_id": "37cf8326-e33a-322e-956b-0d41b784849d",
                        "glosses": [
                            "samenleving waarin verantwoordelijke mensen en organisaties, soms al te sterk, worden afgerekend op hun prestaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a10c71-01bf-4253-8618-d2465e23373c",
                                "sense_id": "6c74c832-2cfd-309d-8d69-05e27ab1db77",
                                "text": "Volgens Ad Kappen van het Steunpunt Onderwijs Enschede gaat het niet om het toetsen, maar om wat je daarna mee doet. Waar zit het talent en wat moet er nog meer ontwikkeld worden? De scholen zijn er heel positief over, omdat ze zo meer uit de kinderen kunnen halen. Er is geen afrekencultuur en de school maakt ook aan de kinderen inzichtelijk wat hun doelen zijn."
                            },
                            {
                                "example_id": "8d613b48-1598-43d1-93ca-6a7484ec88ad",
                                "sense_id": "6c74c832-2cfd-309d-8d69-05e27ab1db77",
                                "text": "Ze wil dat Dekker met een systeem komt waardoor scholen niet alleen vergeleken kunnen worden op basis van de Cito-scores, maar ook op andere terreinen. Ze vreest dat ouders in de openbare Cito-scores een soort \"ranglijst\" zien tussen scholen en dat dat leidt tot een afrekencultuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "06b2efc4-7413-34d5-9146-073acbed8710",
                        "entry_id": "37cf8326-e33a-322e-956b-0d41b784849d",
                        "glosses": [
                            "samenlevingsstructuur waarbij 'wraak' wordt genomen op mensen die zaken aankaarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6853514-c10d-4c1d-bcd7-9a1195f7c112",
                                "sense_id": "06b2efc4-7413-34d5-9146-073acbed8710",
                                "text": "Het personeel beklaagt zich over de werkomstandigheden. Wegens het personeelsgebrek zouden mensen geen verlof kunnen opnemen. Wie daarover klaagt of het reorganisatiebeleid bekritiseert, zou geïntimideerd worden door de leiding. Abvakabo zegt dat personeelsleden een \"angst- en afrekencultuur\" ervaren en hun mond niet open durven te doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e573dfe-683d-3198-9365-78e5043c91a9",
                        "entry_id": "37cf8326-e33a-322e-956b-0d41b784849d",
                        "glosses": [
                            "maatschappelijke tendens waarbij men personen en organisaties boycot en uitsluit die onwenselijk gedrag hebben vertoont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68784713-c6ff-4fe1-9dea-41f2c1593414",
                                "sense_id": "7e573dfe-683d-3198-9365-78e5043c91a9",
                                "text": "Verder was er applaus voor een bewoner die kritiek heeft op de media, die te kort door de bocht zouden berichten en zouden bijdragen aan de afrekencultuur."
                            }
                        ]
                    }
