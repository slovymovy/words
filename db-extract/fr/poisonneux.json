                                        "entry_id": "07198858-0294-3ecc-8ab0-bbe3eb14f430",
                                        "glosses": [
                                            "Killed, paralysed, or harmed by receiving a dose of poison."
                                        ],
                                        "tags": [
                                            "of a living thing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332e2695-3724-444b-b820-1cd0a49dcec7",
                                                "sense_id": "50ec571b-ec78-3f4a-b7ec-871cd8c4b019",
                                                "text": "The snake left its poisoned prey to die."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5633674-cd6c-3e13-93e4-91384d3f6162",
                                        "entry_id": "07198858-0294-3ecc-8ab0-bbe3eb14f430",
                                        "glosses": [
                                            "Containing poison; poisonous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ec569d-64df-46be-bf64-37e061f9b685",
                                                "sense_id": "e5633674-cd6c-3e13-93e4-91384d3f6162",
                                                "text": "The hunters began to fire their poisoned darts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a396f776-f9ed-32ef-bffd-9cc1cb405386",
                                        "entry_id": "07198858-0294-3ecc-8ab0-bbe3eb14f430",
                                        "glosses": [
                                            "Having a strongly negative effect; harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36072bf-75b6-41c3-9493-b122e9fc99a4",
                                                "sense_id": "a396f776-f9ed-32ef-bffd-9cc1cb405386",
                                                "text": "This is a poisoned work environment."
                                            }
                                        ]
