    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37896248-f5e7-33f3-93c1-40d6834d1975",
                    "sense_definition": "Abréviation courante pour désigner le permis de conduire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "autorisation_ecrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois d'apprentissage, mon frère a enfin obtenu son <w>permis</w> la semaine dernière."
                        },
                        {
                            "text": "Elle ne peut pas conduire cette voiture parce qu'elle n'a pas encore passé son <w>permis</w>."
                        }
                    ],
                    "common_phrases": [
                        "passer son permis",
                        "avoir son permis",
                        "permis de conduire"
                    ]
                },
                {
                    "sense_id": "54c1fc2c-0d01-346a-8c14-f072a4556d1f",
                    "sense_definition": "Document officiel délivré par une autorité pour autoriser l'exercice d'un droit ou d'une activité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autorisation_ecrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mairie a accordé le <w>permis</w> de construire pour notre nouvelle maison en banlieue."
                        },
                        {
                            "text": "Avant de commencer votre nouvel emploi à l'étranger, vous devez obligatoirement demander un <w>permis</w> de travail."
                        }
                    ],
                    "synonyms": [
                        "autorisation"
                    ],
                    "common_phrases": [
                        "permis de construire",
                        "permis de séjour",
                        "permis de travail"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19e4ad4b-1494-3462-b5d9-8555260c0078",
                    "sense_definition": "Qui est autorisé par la loi, la règle ou la morale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'est pas <w>permis</w> de fumer dans les lieux publics fermés comme les restaurants."
                        },
                        {
                            "text": "Durant cette fête traditionnelle, presque tout est <w>permis</w> tant que l'ambiance reste amicale."
                        }
                    ],
                    "synonyms": [
                        "autorisé",
                        "accepté"
                    ],
                    "antonyms": [
                        "interdit",
                        "défendu",
                        "prohibé"
                    ],
                    "common_phrases": [
                        "tout est permis"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8904884-33f3-388e-9403-b9c22fad6329",
                    "sense_definition": "Participe passé masculin singulier de <w>permettre</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle organisation du travail a <w>permis</w> d'améliorer rapidement les résultats de l'entreprise."
                        },
                        {
                            "text": "Le beau temps du week-end a <w>permis</w> aux enfants de jouer dehors toute la journée."
                        }
                    ]
                },
                {
                    "sense_id": "15236200-9d2c-35b0-a39f-19d7d7ebc280",
                    "sense_definition": "Première ou deuxième personne du singulier du passé simple de <w>permettre</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lui <w>permis</w> d'entrer dans la pièce après avoir soigneusement vérifié son identité."
                        },
                        {
                            "text": "Tu lui <w>permis</w> de partir plus tôt ce jour-là malgré le travail restant."
                        }
                    ]
                }
            ]
        }
    ]
}