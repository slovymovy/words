                "senses": [
                    {
                        "sense_id": "eacee65b-f4bd-3e6d-88b1-36b00fd348fd",
                        "entry_id": "be8b34a4-d030-3112-bd91-44cfa775bd3a",
                        "glosses": [
                            "Corps de cavalerie placé à la tête d’un camp pour empêcher que l’armée ne soit surprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5112cf39-a53e-41ab-8c58-15ad95663eb8",
                                "sense_id": "eacee65b-f4bd-3e6d-88b1-36b00fd348fd",
                                "text": "Au petit jour, ma compagnie partit en grand’garde."
                            },
                            {
                                "example_id": "b978dfd4-7abe-4435-938e-6a5b6ae6923d",
                                "sense_id": "eacee65b-f4bd-3e6d-88b1-36b00fd348fd",
                                "text": "Vers midi, les grand’gardes signalent des coureurs allemands dans la direction de Givron et d'Adon ; des cavaliers isolés s'approchent de Chaumont-Porcien, et, reçus à coups de fusil, se replient vivement."
                            },
                            {
                                "example_id": "70e2f8c3-2f54-485c-a533-1631cd1d265d",
                                "sense_id": "eacee65b-f4bd-3e6d-88b1-36b00fd348fd",
                                "text": "Notre compagnie, la première du bataillon, était de grand’garde, le 3, lorsqu’elle reçut le baptême du feu."
                            }
                        ]
                    },
                    {
                        "sense_id": "66af6f7d-2101-3743-b36c-d0f1294759ef",
                        "entry_id": "be8b34a4-d030-3112-bd91-44cfa775bd3a",
                        "glosses": [
                            "Corps de garde principal d’une place forte ou d’un camp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b703a63c-8ef4-494e-a843-09b41228ce8b",
                                "sense_id": "66af6f7d-2101-3743-b36c-d0f1294759ef",
                                "text": "On pouvait bien être vingt à crever de misère dans cette baraque de sabotiers où les chefs avaient cru devoir poster une manière de grand’garde, à la lisière d’un bois très suspect."
                            },
                            {
                                "example_id": "97b347fc-0885-4647-b878-bd90d84bb2ca",
                                "sense_id": "66af6f7d-2101-3743-b36c-d0f1294759ef",
                                "text": "On s’abouche avec la sentinelle, puis on parlemente successivement avec la grand’garde, l’avant-poste, le poste, le contre-poste."
                            }
                        ]
                    },
                    {
                        "sense_id": "57229a8d-6ae0-3f2b-a23f-84d8e4099154",
                        "entry_id": "be8b34a4-d030-3112-bd91-44cfa775bd3a",
                        "glosses": [
                            "Soldat d’un de ces corps."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0dc82ad4-9365-48d1-b05c-61d1bcbd8562",
                                "sense_id": "57229a8d-6ae0-3f2b-a23f-84d8e4099154",
                                "text": "De Lisiane à Besançon, à marcher dans le rang, piétinements à travers la boue, […], grand’gardes suppliciées de froid ; à faire le troupier sans apercevoir jamais l’ennemi, il avait perdu ses illusions dernières."
                            }
                        ]
                    }
