                    {
                        "sense_id": "340c1c50-1c8f-3db5-9873-fbb35436c4fe",
                        "entry_id": "d05e8cfc-94da-340d-b752-324ec83f912f",
                        "glosses": [
                            "Espèce d'équidé de petite taille comme un poney, dont la taille au garrot moyenne actuelle est voisine de 1,30 m, à l'origine équidé sauvage d'Asie occidentale, disparu au XIXe siècle, qui est un des ancêtres des chevaux actuels, et dont l'apparence a été reconstituée en Pologne à partir de poneys de ce pays : travaux agricoles, débardage, attelage, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3846c75-5159-4435-bd0c-b79c7c4c61c2",
                                "sense_id": "340c1c50-1c8f-3db5-9873-fbb35436c4fe",
                                "text": "Dans l’Antiquité, l’équitation et la guerre iront de pair, chez les Mongols, montés sur leurs tarpans, ancêtres, avec l’aryen, de toutes les races de chevaux du globe,"
                            }
                        ]
                    }
                ],
