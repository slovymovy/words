                                "target_senses": [
                                    {
                                        "sense_id": "0be8fde9-edaf-33e5-9a5f-131ef97bbbc4",
                                        "entry_id": "7a34c081-972c-32bf-be07-b4b9be4ef070",
                                        "glosses": [
                                            "Relatif au maniérisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7495700-5bc0-4822-87c3-382b8bc3c247",
                                                "sense_id": "0be8fde9-edaf-33e5-9a5f-131ef97bbbc4",
                                                "text": "Le style de Fontainebleau, à travers les gravures, transmit le style maniériste italien vers Anvers et l'Europe du Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f44242-f4f8-3bb9-b0a0-f7d142f35a18",
                                        "entry_id": "7a34c081-972c-32bf-be07-b4b9be4ef070",
                                        "glosses": [
                                            "Qui adopte la façon propre au maniérisme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26ef650-1228-4637-b4e1-7be1a87c77ce",
                                                "sense_id": "95f44242-f4f8-3bb9-b0a0-f7d142f35a18",
                                                "text": "Les vertèbres supplémentaires de la Grande Odalisque de Dominique Ingres ajoutent une note maniériste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maniériste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9681654e-5ea6-3c7a-8df3-ae93f556e300",
                                        "entry_id": "fed41f00-aed7-36c3-91c2-f37b66ed3318",
                                        "glosses": [
                                            "Peintre de la Renaissance tardive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c58bce-c10f-465d-aaa3-0f75e9e87f43",
                                                "sense_id": "9681654e-5ea6-3c7a-8df3-ae93f556e300",
                                                "text": "Giorgio Vassari est un maniériste."
                                            },
                                            {
                                                "example_id": "c136b1b1-0db8-43c2-9dec-b2f004c228a5",
                                                "sense_id": "9681654e-5ea6-3c7a-8df3-ae93f556e300",
                                                "text": "Boncher est un maniériste en joli, M. Courbet est un maniériste en laid ; mais tous deux sont des maniéristes ; chacun flatte la nature à sa façon : l’un lui prête des grâces, l’autre des disgrâces qu’elle n’a pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
