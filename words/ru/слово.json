                {
                    "sense_id": "a2a6d90f-b92d-349e-a5b5-91a12db3b00b",
                    "sense_definition": "Единица языка, которая служит для называния предметов, действий и признаков",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "linguistic_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом предложении всего одно <w>слово</w>.",
                            "target_lang_translations": {
