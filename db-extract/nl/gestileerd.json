        "nl-extract.jsonl": [
            {
                "entry_id": "c8f03b0a-dfe2-36cf-bf83-89348d2e85fc",
                "word": "gestileerd",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7721cbf-c8d0-3960-8cf2-faada6ffdd5b",
                        "entry_id": "c8f03b0a-dfe2-36cf-bf83-89348d2e85fc",
                        "glosses": [
                            "min of meer abstract of vereenvoudigd vormgegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7552284b-3abe-4063-bb3d-e6048cef7d91",
                                "sense_id": "a7721cbf-c8d0-3960-8cf2-faada6ffdd5b",
                                "text": "De gestileerde, in plastic gegoten vormen van Barbie gelden nog altijd als schoonheidsideaal."
                            },
                            {
                                "example_id": "9939475f-d26b-45f3-84b7-75074568f787",
                                "sense_id": "a7721cbf-c8d0-3960-8cf2-faada6ffdd5b",
                                "text": "Het beeldmerk wordt vanavond gepresenteerd op een informatiebijeenkomst voor bedrijven. De naam van het gebied Zoutmarke komt ook tot uiting in het logo, dat de vorm van een gestileerd zoutkristal heeft. De bijeenkomst is bedoeld voor ondernemers en bedrijven in het gebied en wordt gehouden in het Grolschcomplex."
                            },
                            {
                                "example_id": "9a002bdb-53cf-4180-9e22-9dd0bf808eb2",
                                "sense_id": "a7721cbf-c8d0-3960-8cf2-faada6ffdd5b",
                                "text": "André Hazes heeft een nieuw jeansjack gescoord met op de achterkant en voorzijde gestileerde portretten van zijn vader. \"Respecteer degene die je gecreëerd heeft\", legt de zanger voor de volledigheid uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95130389-5f3c-459c-913d-d962661abf01",
                        "source_entry_id": "c8f03b0a-dfe2-36cf-bf83-89348d2e85fc",
                        "source_sense_id": "a7721cbf-c8d0-3960-8cf2-faada6ffdd5b",
                        "target_lang_word": "edit",
                        "target_lang_code": "en",
