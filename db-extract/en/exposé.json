                                            {
                                                "example_id": "c0077d5a-8142-4f19-a6f4-259fb3a5410d",
                                                "sense_id": "a6c7f912-7d6a-39c6-8588-cb954ed18a2f",
                                                "text": "多年愛し合った男女が別れて後互いに弱点を暴露して公に争うが如きは醜き限りである。"
                                            },
                                            {
                                                "example_id": "037d07eb-9eb7-4726-8c3e-80c53a28b799",
                                                "sense_id": "a6c7f912-7d6a-39c6-8588-cb954ed18a2f",
                                                "text": "私の失敗は遺憾なく私のかくされていた虚栄心を暴露した。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc6b3561-31dd-31db-9dbb-7f45175e02f9",
                                        "entry_id": "23675e66-2f84-3e1f-aaf7-d02043c9cbd6",
                                        "glosses": [
                                            "不正や秘密、恥などが明るみに出ること。発覚。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
