                    ]
                },
                {
                    "sense_id": "0312d2f4-625a-3952-9949-3d6afac23253",
                    "sense_definition": "Heurter une surface sans y pénétrer et en étant dévié, glisser sans s'imprégner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce au traitement imperméable, les gouttes d'eau ne font que <w>rebondir</w> sur le tissu."
                        },
                        {
                            "text": "Les critiques sévères semblent <w>rebondir</w> sur lui sans jamais entamer sa détermination."
