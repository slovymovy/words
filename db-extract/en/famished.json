                    {
                        "translation_id": "e63a225a-168c-4378-9da4-331c1f83657b",
                        "source_entry_id": "3b2a8428-c2bc-34a5-bc33-48788a498275",
                        "source_sense_id": "7cdd3ee8-984b-35a6-9e49-a197eb7be8e9",
                        "source_sense_description": "extremely hungry",
                        "target_lang_word": "affamé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affamé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5f3990-0a32-3695-a447-0869e2fd4619",
                                        "entry_id": "0c3c32eb-43e2-3adb-a55b-d34f2ae7cf65",
                                        "glosses": [
                                            "Qui souffre de la faim, par absence ou privation de nourriture, avoir très faim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a19911-a3fb-4202-9de0-443bf87e70aa",
                                                "sense_id": "eb5f3990-0a32-3695-a447-0869e2fd4619",
                                                "text": "[…] il ne reste plus un habitant, plus une tête de bétail, plus un boisseau de grain. L’intendance ne réussit plus à pourvoir aux besoins de tous les ventres affamés dont elle a la charge."
                                            },
                                            {
                                                "example_id": "d3ca3c16-6993-4bdd-9c5f-26f16668a646",
                                                "sense_id": "eb5f3990-0a32-3695-a447-0869e2fd4619",
                                                "text": "L’accablement particulier qui l’oppressait ne provenait pas tant d’une anxiété patriotique que de la faim ; évidemment, il se sentait très affamé."
                                            },
                                            {
                                                "example_id": "5613f13f-44df-46a0-b4bb-fbd21b4899da",
                                                "sense_id": "eb5f3990-0a32-3695-a447-0869e2fd4619",
                                                "text": "Un matin, Géronimus affamé décida de partir à la chasse dans une contrée giboyeuse que lui avait indiquée son lézard Lazare."
                                            },
                                            {
                                                "example_id": "80ec12e4-1fb4-4a0c-b738-4cfe21222a91",
                                                "sense_id": "eb5f3990-0a32-3695-a447-0869e2fd4619",
                                                "text": "Au mot « héritage », presque tout le monde pitait mieux qu’une bande de poissons affamés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762b25f9-7957-3568-b770-ad480821c5c3",
                                        "entry_id": "0c3c32eb-43e2-3adb-a55b-d34f2ae7cf65",
                                        "glosses": [
                                            "Qui a de l’avidité pour quelque chose, qui souhaite quelque chose avec ardeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58b3a3b-44bd-4f61-a2bb-e00715f16b4e",
                                                "sense_id": "762b25f9-7957-3568-b770-ad480821c5c3",
                                                "text": "Être affamé de gloire, affamé d’honneurs, affamé de nouvelles."
                                            },
                                            {
                                                "example_id": "82e0c57b-e6e9-406c-b877-23627bdb4fff",
                                                "sense_id": "762b25f9-7957-3568-b770-ad480821c5c3",
                                                "text": "Et il raconta sa vie de chaque jour, poétiquement, de façon à faire vibrer dans le cœur de ces bourgeois privés d’herbe et affamés de promenades aux champs cet amour bête de la nature qui les hante toute l’année derrière le comptoir de leur boutique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affamé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84fd9098-5b5d-3fce-b371-bfaf766d357f",
                                        "entry_id": "a9a6be99-8242-33a6-a6da-f1eb2db9bedb",
                                        "glosses": [
                                            "Personne affamée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc13ce3-87ff-4c61-9f26-d71096be6b50",
                                                "sense_id": "84fd9098-5b5d-3fce-b371-bfaf766d357f",
                                                "text": "C’est un affamé."
                                            },
                                            {
                                                "example_id": "7715625e-0e68-43d7-b1c7-32a1e4952503",
                                                "sense_id": "84fd9098-5b5d-3fce-b371-bfaf766d357f",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune. La richesse des Roudier et des Granoux exaspérait Aristide au point de lui faire perdre toute prudence. Poussé par ses aigreurs jalouses d’affamé, il s’était fait de la bourgeoisie une ennemie irréconciliable, lorsque l’arrivée d’Eugène et la façon dont il se comporta à Plassans vinrent le consterner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affamé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "715f837e-ab3d-3dfa-bfa4-86391fbe7501",
                                        "entry_id": "bcf3d93d-b927-3461-a3d0-ef3c24926cab",
                                        "glosses": [
                                            "Participe passé masculin singulier de affamer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
