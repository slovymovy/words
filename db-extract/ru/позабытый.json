                                        "sense_id": "3b8ce741-79d1-3fc5-b63c-f53969cb583a",
                                        "entry_id": "be3d0aa7-ec98-3278-8971-7ca3e5ad0155",
                                        "glosses": [
                                            "A person or thing that has been forgotten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86aa5fdb-e7ec-491c-9bda-c40813909507",
                                                "sense_id": "3b8ce741-79d1-3fc5-b63c-f53969cb583a",
                                                "text": "Luckily for these unfortunate forgottens, New Year is approaching, a time when, despite the intuitions of the calendar, our thoughts often turn to the past."
                                            }
