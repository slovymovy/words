                                "target_senses": [
                                    {
                                        "sense_id": "c2b5c50e-0c02-31c8-8e68-d483a044646f",
                                        "entry_id": "8377a70b-092a-32a5-b16b-4baff15bcc79",
                                        "glosses": [
                                            "het niet meer helder kunnen denken;een psychische gesteldheid waarbij iemand zich niet meer kan oriënteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29d01e3-51c2-46db-8006-d8c85ea6e906",
                                                "sense_id": "c2b5c50e-0c02-31c8-8e68-d483a044646f",
                                                "text": "Onderweg in de trein praatte hij met zijn medereizigers over de politiek en over de nieuw aangelegde spoorlijnen, en evenals in Moskou was hij als verlamd door de verwardheid van zijn gedachten, een gevoel van ontevredenheid over zichzelf en een vaag besef van schaamte."
                                            },
                                            {
                                                "example_id": "13cf9fdc-02fe-42cf-9ea4-fa6679c2d5c0",
                                                "sense_id": "c2b5c50e-0c02-31c8-8e68-d483a044646f",
                                                "text": "De onderzoekers zelf hopen veel informatie uit de gegevens te halen. \"Het is interessant om te kijken wat voor soort overlast in welke gemeente voorkomt. Hoelang het duurt voordat mensen gaan klagen. Met welke overlast ze zitten. In welke combinatie dat voorkomt. Zo ligt psychische verwardheid vaak ten grondslag aan overlast\", vertelt Vols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f33d07d-a21b-472f-95b8-f7579b194065",
                        "source_entry_id": "9d4240ec-6b31-3002-9827-5bcb7d0febbf",
                        "source_sense_description": "state or quality of being perplexed",
                        "target_lang_word": "verwarring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwarring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6998f14-3487-350a-82b7-263c17655393",
                                        "entry_id": "11bf2424-1a2e-3a06-afe8-6b2f703b3217",
                                        "glosses": [
                                            "een verwarde toestand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa725d80-a898-4e27-a9f3-a0e557b11640",
                                                "sense_id": "b6998f14-3487-350a-82b7-263c17655393",
                                                "text": "Ze werden allemaal in verwarring gebracht."
                                            },
                                            {
                                                "example_id": "ff4574bc-2ccd-42bd-8bb3-76cc5f2b18f5",
                                                "sense_id": "b6998f14-3487-350a-82b7-263c17655393",
                                                "text": "Mijn verwarring moet compleet zijn geweest, net als mijn opluchting."
                                            },
                                            {
                                                "example_id": "8e86407f-d740-4004-87cb-4452287e31e4",
                                                "sense_id": "b6998f14-3487-350a-82b7-263c17655393",
                                                "text": "De hele wereld kon de verwarring bij Beatty zien toen hij in de envelop de tekst \"Emma Stone - La La Land\" aantrof. Zijn medepresentator Faye Dunaway dacht dat hij een grapje maakte, en las de filmtitel gelijk voor toen Beatty haar de tekst liet zien."
                                            },
                                            {
                                                "example_id": "826b57c2-6b03-4918-a6b2-0e355a38e5ae",
                                                "sense_id": "b6998f14-3487-350a-82b7-263c17655393",
                                                "text": "Olive zag de vertrouwde reactie; Teresa knipperde met haar ogen, in verwarring gebracht door het lichtblonde haar en de glamour die Sarah uitstraalde, waar ze ook was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
