            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a61914e-d152-30b2-a9af-de810b4a7e8d",
                    "sense_definition": "Faire parvenir d'un lieu ou d'une personne à une autre, communiquer une information, un savoir ou une maladie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication_diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le secrétaire va <w>transmettre</w> votre message au directeur dès son retour."
                        },
                        {
                            "text": "Cette tradition orale se <w>transmet</w> de génération en génération depuis très longtemps."
                        }
                    ],
                    "synonyms": [
                        "communiquer",
                        "diffuser",
                        "véhiculer"
                    ],
                    "common_phrases": [
                        "transmettre un message",
                        "transmettre le virus",
                        "transmettre son savoir"
                    ]
                },
                {
                    "sense_id": "dffa5bd6-b278-3f95-8721-fd35f9667429",
                    "sense_definition": "Céder ou transférer légalement la possession d'un bien, d'un droit ou d'un pouvoir à quelqu'un d'autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transfert_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef d'entreprise souhaite <w>transmettre</w> ses pouvoirs à son adjoint avant la fin de l'année."
                        },
                        {
                            "text": "Le vieux notaire a aidé la famille à <w>transmettre</w> la propriété du domaine aux enfants."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "léguer",
                        "transférer"
                    ],
                    "antonyms": [
                        "garder",
                        "retenir"
                    ],
                    "common_phrases": [
                        "transmettre un droit",
                        "transmettre un patrimoine",
                        "transmettre ses pouvoirs"
                    ]
                }
            ]
        }
    ]
