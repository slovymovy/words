                    "sense_id": "3e175608-e322-375e-a9c4-9a1ef0ff90e9",
                    "sense_definition": "To officially order someone to join the military or a specific organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>drafted</w> into the army shortly after he finished college.",
                            "target_lang_translations": {
                                "ru": "Его <w>призвали</w> в армию вскоре после окончания колледжа."
                            }
                        },
                        {
                            "text": "The committee decided to <w>draft</w> her as the new chairperson.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>привлечь</w> её в качестве нового председателя."
                            }
