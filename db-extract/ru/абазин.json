                "senses": [
                    {
                        "sense_id": "0532607c-1693-37f5-9ece-cbd51d6df63f",
                        "entry_id": "7f257069-a7db-3e4c-99fc-9e4a33c67990",
                        "glosses": [
                            "представитель народа абхазо-адыгской этноязыковой группы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c439905-1dfb-423c-baac-f36dfc347818",
                                "sense_id": "0532607c-1693-37f5-9ece-cbd51d6df63f",
                                "text": "Абазины Карачаево-Черкесии решили напрямую выбирать главу своего муниципалитета."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a00be2f-2de2-4b4c-b240-726c185743ab",
                        "source_entry_id": "7f257069-a7db-3e4c-99fc-9e4a33c67990",
                        "source_sense_id": "0532607c-1693-37f5-9ece-cbd51d6df63f",
