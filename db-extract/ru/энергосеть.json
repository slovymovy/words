                        "glosses": [
                            "сокр. от энергетическая сеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21269e2e-a13a-48b5-8c07-5555392469c0",
                                "sense_id": "8a117a90-2e4e-3a79-aa2d-c4d866beb33d",
                                "text": "Предприниматели заставили правительство вернуться к обсуждению механизмов взимания платы за присоединение к энергосетям."
                            }
