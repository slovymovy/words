                                "target_senses": [
                                    {
                                        "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                        "entry_id": "ced1fd10-9b4e-3607-90e6-1eaef00e69a2",
                                        "glosses": [
                                            "A rooflike cover, usually of canvas, extended over or before any place as a shelter from the sun, rain, or wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9708e5-bb47-4179-8f38-41c0e97e11fd",
                                                "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                                "text": "At Nairobi the mail waits an hour-and-a-half. The station has three long platforms, mostly covered in awnings, the island connected with the main platform (which is used by the mails in both directions) by a subway."
                                            },
                                            {
                                                "example_id": "d0aab8df-3b3e-427e-a169-c537ec9a2b16",
                                                "sense_id": "6a1dc2ac-7388-33e9-bf88-00439a2508f9",
                                                "text": "But instead, the distinctive ironwork and glass platform awnings have been carefully refurbished, while making them compatible with the overhead wiring. Kettering's island Platform 2/3 is especially noteworthy. Although it dates from 1879, when the station was enlarged to four platforms, the same original (1857) patterns for the delicate cast-ironwork seem to have been used - […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58216624-a3c0-3c82-9531-763016bc8457",
                                        "entry_id": "ced1fd10-9b4e-3607-90e6-1eaef00e69a2",
                                        "glosses": [
                                            "That part of the poop deck which is continued forward beyond the bulkhead of the cabin."
                                        ],
