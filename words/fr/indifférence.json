                    ]
                },
                {
                    "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                    "sense_definition": "État d'impassibilité ou de neutralité d'une personne qui ne laisse paraître aucune émotion ou ne prend aucun parti.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge écoutait les deux parties avec un calme remarquable et un air d'<w>indifférence</w>."
                        },
                        {
                            "text": "Elle tentait de masquer sa tristesse sous une apparente <w>indifférence</w> devant ses collègues de bureau."
                        }
                    ],
                    "synonyms": [
                        "impassibilité",
                        "neutralité"
                    ],
                    "antonyms": [
                        "partialité"
                    ],
                    "common_phrases": [
                        "air d'indifférence",
                        "liberté d'indifférence"
                    ]
                },
                {
                    "sense_id": "1b0ee35a-7dd0-3dda-948b-f7cfeba1b769",
                    "sense_definition": "Absence de sentiment amoureux ou d'attachement affectif envers quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'un mariage difficile, la passion avait finalement cédé la place à l'<w>indifférence</w>."
                        },
                        {
                            "text": "Il souffrait beaucoup de constater l'<w>indifférence</w> glaciale de celle dont il était autrefois éperdument amoureux."
