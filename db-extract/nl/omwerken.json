                                        "entry_id": "26efe2f0-6767-389e-9da7-8f7be925e8fe",
                                        "glosses": [
                                            "The act of writing again or anew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e112e2e2-6cca-4e92-97bc-3f9b5b2f314a",
                                                "sense_id": "cae8e49b-e543-34ed-b8d6-b0ffb0ba4ce4",
                                                "text": "The film script underwent a rewrite for the European market."
                                            },
                                            {
                                                "example_id": "66e8bde8-1ff3-4aff-9559-759c5971b662",
                                                "sense_id": "cae8e49b-e543-34ed-b8d6-b0ffb0ba4ce4",
                                                "text": "After a month of writing and another month for rehearsals and re-writes, the three planned a one-night-only performance billed as a work in progress at Josie's Cabaret and Juice Joint in San Francisco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ac383b-fcb8-3e9b-8cb2-3b3ff2097285",
                                        "entry_id": "26efe2f0-6767-389e-9da7-8f7be925e8fe",
                                        "glosses": [
                                            "Something that has been written again."
                                        ],
