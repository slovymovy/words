                "senses": [
                    {
                        "sense_id": "e32cb162-345b-330f-9b07-9f4cfb2c1fdf",
                        "entry_id": "a9ade691-1428-3599-a46f-1bfd93f7e8dd",
                        "glosses": [
                            "mehr als eine Fraktion betreffend; mehrere Fraktionen umfassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1582e481-9173-4cfa-b235-a8ee4e4f8209",
                                "sense_id": "e32cb162-345b-330f-9b07-9f4cfb2c1fdf",
                                "text": "„Im U-Ausschuss genoss Strauss fraktionsübergreifend den Respekt der Abgeordneten.“"
                            },
                            {
                                "example_id": "8e7c75fc-a381-435d-89a2-678c14b444e4",
                                "sense_id": "e32cb162-345b-330f-9b07-9f4cfb2c1fdf",
                                "text": "„Die AfD wird fraktionsübergreifend attackiert, aber auch gegen die Bundesregierung werden Vorwürfe erhoben.“"
                            },
                            {
                                "example_id": "629d3951-9c8f-4868-8eb6-07a706dde563",
                                "sense_id": "e32cb162-345b-330f-9b07-9f4cfb2c1fdf",
                                "text": "„Der Bundestag speichert massenhaft Daten der Abgeordneten – für drei Monate. Das hat fraktionsübergreifend Ärger erzeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
