                            {
                                "target_word": "following",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8ec7f7-26ec-3ecb-b4d9-3bd863fb6e6a",
                                        "entry_id": "d22f72ae-f697-3d5d-ad92-0917748d4f3d",
                                        "glosses": [
                                            "After, subsequent to."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98ab56e-d5a2-46e2-9ef5-7d3d400fe151",
                                                "sense_id": "ba8ec7f7-26ec-3ecb-b4d9-3bd863fb6e6a",
                                                "text": "Following the meeting, we all had a chat."
                                            },
                                            {
                                                "example_id": "2ee528fa-2969-44c8-87cf-2befc1cdc4c0",
                                                "sense_id": "ba8ec7f7-26ec-3ecb-b4d9-3bd863fb6e6a",
                                                "text": "We published our findings following a thorough review of others' earlier reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                                        "entry_id": "d22f72ae-f697-3d5d-ad92-0917748d4f3d",
                                        "glosses": [
                                            "In accordance with; as per."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9276b7-58a4-4017-af77-424e056e65cc",
                                                "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                                                "text": "Following all relevant safety instructions, administer a dose of the corticosteroid."
                                            },
                                            {
                                                "example_id": "cb4646aa-c0ac-424b-a901-48ad3252c3b3",
                                                "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                                                "text": "Administer a dose of the corticosteroid, following all relevant safety instructions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "following",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                                        "entry_id": "786b924d-fa0e-3a32-b1ac-03a36d525633",
                                        "glosses": [
                                            "A group of followers, attendants or admirers; an entourage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0a6bd9-5fbe-40a3-975d-64925c9173b4",
                                                "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                                                "text": "He had a loyal following."
                                            },
                                            {
                                                "example_id": "1192ec0f-9830-4541-8394-9d8d07f9bf0e",
                                                "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                                                "text": "And White Hart Lane was stunned when Rovers scored just five minutes after the restart in front of their away following."
                                            },
                                            {
                                                "example_id": "417bbe35-ec54-4159-8432-815b9eb18801",
                                                "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                                                "text": "Mikayla has 14.4 million followers on TikTok and it is growing every day, and she has accumulated over one billion likes on the app. She also has 2.5 million followers on Instagram. Both her followings accumulate to an impressive 16.9, almost 17 million followers."
                                            },
                                            {
                                                "example_id": "5da9cad8-a1cb-45fc-bcc9-162c0356d746",
                                                "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                                                "text": "Move Forward, which has built a strong following among young people, appeared to have outperformed expectations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020c8756-444c-397d-9e6b-3d36d129e1f4",
                                        "entry_id": "786b924d-fa0e-3a32-b1ac-03a36d525633",
                                        "glosses": [
                                            "Vocation; business; profession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ae90061-536c-399f-89f4-e5325b9a0005",
                                        "entry_id": "786b924d-fa0e-3a32-b1ac-03a36d525633",
                                        "glosses": [
                                            "A thing or things to be mentioned immediately after."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4232952e-c068-46a0-b518-190deba19cec",
                                                "sense_id": "1ae90061-536c-399f-89f4-e5325b9a0005",
                                                "text": "The following is a recommendation letter from the president."
                                            },
                                            {
                                                "example_id": "c8273a45-bbb7-4b96-aba6-1b8fd26e60e2",
                                                "sense_id": "1ae90061-536c-399f-89f4-e5325b9a0005",
                                                "text": "The following are the three most important questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c657280-0667-397a-835e-c30f10f51bd6",
                                        "entry_id": "786b924d-fa0e-3a32-b1ac-03a36d525633",
                                        "glosses": [
                                            "An account which is followed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1110936-3a3f-46b3-9218-7d7cf44b7bb6",
                                                "sense_id": "4c657280-0667-397a-835e-c30f10f51bd6",
                                                "text": "When a new user joins Weibo, he should register Weibo and get a unique ID, and then he takes some existing users as his followings and waits for others to follow him."
                                            },
                                            {
                                                "example_id": "d77e236e-6c92-46f2-8135-b65b5214728c",
                                                "sense_id": "4c657280-0667-397a-835e-c30f10f51bd6",
                                                "text": "A follower can follow any other users and receive any kind of tweets from his or her followings."
                                            },
                                            {
                                                "example_id": "d1fa7c49-46e3-48fc-88ae-8411c4c065e8",
                                                "sense_id": "4c657280-0667-397a-835e-c30f10f51bd6",
                                                "text": "She scrolled through her [Chloe’s] page and liked a few of her pictures that were like candy to her eyes before thoroughly checking her followings. She then checked Chloe’s followers, which was well over a thousand followers."
                                            }
                                        ]
                                    }
                                ]
                            },
