                "senses": [
                    {
                        "sense_id": "7efa15ae-bb77-3002-8984-2f14e2ad46a8",
                        "entry_id": "187e6fcf-ed43-396b-aa33-a2706b5a3e11",
                        "glosses": [
                            "Ajouter une capsule à (une bouteille déjà bouchée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbbeaa17-da07-41d2-b0b5-2f6c40b75ae2",
                                "sense_id": "7efa15ae-bb77-3002-8984-2f14e2ad46a8",
                                "text": "Certaines capsules de surbouchage, destinées à surboucher des bouteilles de vins effervescents tels que des champagnes, sont des coiffes très fines obtenues par roulage d'une jupe métallique ou métalloplastique (d'épaisseur typiquement inférieure ou égale à 50 μm) puis soudage ou thermoscellage d'une tête sur la jupe."
                            },
                            {
                                "example_id": "0813bc74-1335-4b14-b728-8b6f5c7396eb",
                                "sense_id": "7efa15ae-bb77-3002-8984-2f14e2ad46a8",
                                "text": "Surboucher une bouteille consiste à en coiffer le goulot d'une capsule préfabriquée ou découpée sur la machine suivant le cas."
                            }
                        ]
                    }
