                        ],
                        "examples": [
                            {
                                "example_id": "2240ddc0-72fb-4683-abf0-2389ab5393c3",
                                "sense_id": "8f39581a-1916-3bd5-87c9-0c432f009df2",
                                "text": "Lucas bava de rage en entendant l'amalgame. Faudrait voir à pas mélanger nos gens avec les importés ! Nos vieux sont beurdins, je te l'accorde, mais ils n'ont jamais été dangereux."
                            },
                            {
                                "example_id": "05c23ab2-b3f7-4c83-a1f3-374304b25128",
                                "sense_id": "8f39581a-1916-3bd5-87c9-0c432f009df2",
                                "text": "Elle hausse les épaules, comme sa mère et murmure, pour elle-même :\n— Aller causer à un mort ! L'est toute beurdine, à c't'heure, la Célestine."
                            }
                        ]
                    }
                ],
