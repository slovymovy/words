                        "glosses": [
                            "Donner un caractère andin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1adffc52-8f23-48ec-bef1-d539fbe0d3a2",
                                "sense_id": "7120b532-385d-32cc-8f7e-3d7e97e267cf",
                                "text": "Dans Creación de una pedagogía nacional (« Création d’une pédagogie nationale », 1910), Tamayo demande à cet effet la suppression du système d’éducation importé d’Europe qui s’efforce d’occidentaliser les Indiens, au profit d’un autre système éducatif qui s’attacherait à « andiniser » les non-Indiens."
                            },
                            {
                                "example_id": "aab345ab-6789-4011-8da1-06d9de3b3e4c",
                                "sense_id": "7120b532-385d-32cc-8f7e-3d7e97e267cf",
                                "text": "L’arrivée d’une importante population indigène a notablement marqué le paysage urbain : Lima s’est andinisée…"
                            }
                        ]
                    }
