                "senses": [
                    {
                        "sense_id": "648b4a0a-b19a-35cd-b587-b01f0c21b9f7",
                        "entry_id": "48fc6828-1c79-371a-a32f-19631f268521",
                        "glosses": [
                            "gebouw waar een volksvertegenwoordiging vergadert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b8b9001-7d41-4635-a0ce-ca16eda1fdd8",
                                "sense_id": "648b4a0a-b19a-35cd-b587-b01f0c21b9f7",
                                "text": "Vier doden, zeker 14 gewonde agenten en een grote deuk in de Amerikaanse democratie. De discussie over wie hiervoor verantwoordelijk is, barstte gelijk los nadat het Congresgebouw in Washington D.C. gisteren weer was veiliggesteld."
                            },
                            {
                                "example_id": "e2e0be02-c2dc-4027-ab16-2f9647463d5d",
                                "sense_id": "648b4a0a-b19a-35cd-b587-b01f0c21b9f7",
                                "text": "Terwijl Tsipras zijn toespraak hield, probeerden demonstranten het congresgebouw te bereiken. Het ging voornamelijk om mensen die protesteerden tegen de overeenkomst die Athene onlangs sloot met Skopje over een nieuwe naam voor het buurland Macedonië."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e1015e4-d4d1-361b-aa52-fb51b52db813",
                        "entry_id": "48fc6828-1c79-371a-a32f-19631f268521",
                        "glosses": [
                            "gebouw waar congressen gehouden kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c7d8c4-40ca-4f0a-93c5-0c9f02d610ac",
                                "sense_id": "8e1015e4-d4d1-361b-aa52-fb51b52db813",
                                "text": "Binnen in het congresgebouw is de sfeer totaal anders. Het wemelt er van de bewaking. Alle tassen worden zorgvuldig leeggehaald en gescand. De hal waar de belangrijkste speeches worden gehouden is zo groot, dat het enorme podium er volledig in verdwijnt."
                            }
                        ]
                    }
