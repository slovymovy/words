                "senses": [
                    {
                        "sense_id": "eb55e7cc-3e7b-3a1a-8e73-96cb72d30d89",
                        "entry_id": "5d0c2445-d765-36a4-be61-d5a8dd26f261",
                        "glosses": [
                            "für die erste Nacht des frisch vermählten Ehepaars besonders ausgestattetes und geschmücktes Bett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c10ca4-21ef-46fd-9648-f9e7c04cb348",
                                "sense_id": "eb55e7cc-3e7b-3a1a-8e73-96cb72d30d89",
                                "text": "„Schon der große botanische Systematiker Carl von Linné hat vor fast 300 Jahren erkannt, was es mit den Orchideenblütenblättern auf sich hat: Sie »spielen bei der Zeugung keine Rolle; sie sind lediglich das Brautbett, das der Schöpfer mit kostbaren Vorhängen geschmückt und mit köstlichen Düften parfümiert hat, damit Bräutigam und Braut ihre Vereinigung dann mit umso größerer Feierlichkeit begehen«.“"
                            },
                            {
                                "example_id": "95e4610e-fb86-4a7a-aa68-a9312a44a783",
                                "sense_id": "eb55e7cc-3e7b-3a1a-8e73-96cb72d30d89",
                                "text": "„Die Teilnehmer des Hochzeitszuges überschütteten die Zuschauer mit kandierten Mandeln, dem traditionellen Hochzeitskonfekt, und türmten die übriggebliebenen Mandeln zu süßen weißen Bergen auf dem Brautbett auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
