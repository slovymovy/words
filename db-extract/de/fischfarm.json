                ],
                "senses": [
                    {
                        "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                        "entry_id": "2c240959-7a51-3aba-b7e8-34688588db04",
                        "glosses": [
                            "größerer Betrieb, in dem Fische und andere kommerziell nutzbare Wassertiere gezüchtet und aufgezogen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc9a5c0-8146-4b0f-9f93-517074635988",
                                "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                                "text": "Wer in der Natur nicht genug Nahrung findet, baut sie selbst an. Dieses seit Beginn des Ackerbaus bekannte Konzept gilt auch für Fischfarmen."
                            },
                            {
                                "example_id": "f876a067-f2e1-46f8-a789-46950c5eeb84",
                                "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                                "text": "Die Landwirtschaft müsse mehr Qualitätsprodukte exportieren, Fischfarmen müssten die überfischten Meere entlasten."
                            },
                            {
                                "example_id": "5c2a5cd8-62f3-4d2b-89dd-fe718222b4a0",
                                "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                                "text": "Auch Fisch aus Öko-Aquakulturen ist akzeptabel, da ökologische Fischfarmen tier- und umweltfreundlicher arbeiten."
                            },
                            {
                                "example_id": "87597d03-402c-40ae-8f7b-0ac0f78310e1",
                                "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                                "text": "Ließe sich der wachsende Hunger der Weltbevölkerung nach Fisch befriedigen, wenn es nur noch Fischfarmen gäbe wie diese?"
                            },
                            {
                                "example_id": "3655bcf8-7a54-49b1-81b7-a8e3828f341a",
                                "sense_id": "217e8c09-cf5c-3e04-a180-b792cc856df2",
                                "text": "Auch Fischfarmen sind keine Lösung, wenn sie nicht nachhaltig betrieben – oft werden die Zuchtfische mit Fischmehl gefüttert, das aus weniger beliebten, im offenen Meer gefangenen Fischen hergestellt wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
