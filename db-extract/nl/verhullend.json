                        "examples": [
                            {
                                "example_id": "c180b35b-4601-4dfe-b993-09f2339b5e58",
                                "sense_id": "d1509cb3-a090-3c04-be8e-2addc3c3a6d2",
                                "text": "Jennifer verscheen in een lange jurk met lange laarzen voor een hotel in New York. Een meer verhullende look dan we van haar gewend waren."
                            },
                            {
                                "example_id": "d68289c8-a2e4-4759-899e-abbdae382a45",
                                "sense_id": "d1509cb3-a090-3c04-be8e-2addc3c3a6d2",
                                "text": "Ze is sinds eind vorig jaar in weinig verhullende kleding te bewonderen op de Boerinnenkalender van 2019. Dat beviel zó dat de 22-jarige Laura Poot uit Rockanje deze maand ook meedoet aan de landelijke verkiezing van Miss Boerin Nederland."
                            }
                        ]
                    }
