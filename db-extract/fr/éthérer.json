                ],
                "senses": [
                    {
                        "sense_id": "c0df8dab-d4f6-38db-93ae-9c7af82be937",
                        "entry_id": "c874c040-eae9-3665-b60c-ae24e4639675",
                        "glosses": [
                            "Donner le caractère de l’éther à quelque chose."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba84de6-d7e4-436c-b0ed-30d82783a15b",
                                "sense_id": "c0df8dab-d4f6-38db-93ae-9c7af82be937",
                                "text": "Ces nouveautés la séduisirent comme elles avaient séduit beaucoup de femmes avant elle : c’était pour ainsi dire un élément romanesque —qui éthérait à ses yeux les plaisirs de la dévotion."
                            }
                        ]
                    },
                    {
                        "sense_id": "463281c2-1850-33ee-b697-7da758e67e49",
                        "entry_id": "c874c040-eae9-3665-b60c-ae24e4639675",
                        "glosses": [
                            "Prendre le caractère de l’éther, de cette substance très subtile et invisible."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "17f98dbe-e449-4b0a-8874-6dedf2d18ca5",
                                "sense_id": "463281c2-1850-33ee-b697-7da758e67e49",
                                "text": "Face à eux, les frondaisons s’éthéraient dans la bruine que soulevait l’averse au contact du sol."
                            },
                            {
                                "example_id": "ed848663-5d35-44b3-9aab-3b1579749435",
                                "sense_id": "463281c2-1850-33ee-b697-7da758e67e49",
                                "text": "Il est des instants d’exaltation et d’extase où nos pensées s’épurent, se subtilisent, s’éthèrent en quelque sorte."
                            }
                        ]
                    }
                ],
