                ],
                "senses": [
                    {
                        "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                        "entry_id": "1573957c-5337-360d-9db8-93a0b45b0726",
                        "glosses": [
                            "Umstand, durch den sich jemand bewogen fühlt, ein Votiv einzugehen und es auch erfüllt; Beweggrund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4c834c-6406-43d8-9328-9fd8f5430d11",
                                "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                                "text": "„Votationsgrund bot die mehrfache Bedrohung dieses Almdorfes durch Schneegänge und Murengräben, die erst vor wenigen Jahren die Geröllmassen gefährlich nahe an die Baulichkeiten heranschoben.“"
                            },
                            {
                                "example_id": "1c91d26d-4422-4a83-b460-c404890ab5ef",
                                "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                                "text": "„Der gesamte Vorgang heisst Votation.“"
                            },
                            {
                                "example_id": "e22d2335-d814-4f7f-86a6-01eb71f7dee6",
                                "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                                "text": "„Sie werden von Tieren umgeben, ihrer beider Existenzgrundlage, worauf sich ihr Votationsgrund bezieht.“"
                            },
                            {
                                "example_id": "b40d5e49-7372-4584-86a5-7f32c0fc09f9",
                                "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                                "text": "„Der Text gibt Auskunft über den Votationsgrund: „Lob und Dank der Schmerzhaften Mutter Gottes Maria Dreieichen, das ist Rosalia Salzgruber und Sohn Josef von Ribbitz, durch ¾-jährige Gichtkrankheit behaftet, durch unser kindliches Zutrauen wieder unsere vorige Gesundheit erhalten haben.““"
                            },
                            {
                                "example_id": "09a8338c-f625-457a-a80b-2f37d5e64a67",
                                "sense_id": "436fef06-842a-3d4f-8db6-be48dde1db5a",
                                "text": "„Wie in den meisten Fällen befindet sich der Votivtafeltext hier in der unteren Bildhälfte, Votant und Votationsgrund sind bildmittig dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
