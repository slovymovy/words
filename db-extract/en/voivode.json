            {
                "entry_id": "530453b1-d7c2-36e5-b39f-1ac80926d405",
                "word": "voivode",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2051343f-b661-4516-a58d-ced54d4968e3",
