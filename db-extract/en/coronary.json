                                            {
                                                "example_id": "ff7409b9-eba4-41ce-8e40-e2ff4f954262",
                                                "sense_id": "591de505-fa02-3bd1-b57b-a3e692c9af1f",
                                                "text": "Ornamento coronario de flores."
