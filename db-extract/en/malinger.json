                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b389e45-9ae4-3597-b857-a9cdaa7f0504",
                        "entry_id": "25dda78d-c5b5-359b-acbe-17e3cfcbef19",
                        "glosses": [
                            "symulować chorobę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c530d9-f8cf-47bf-8e1d-9adfda58a810",
                                "sense_id": "2b389e45-9ae4-3597-b857-a9cdaa7f0504",
                                "text": "The retirees had met the other criteria for a successful claim, which includes hours of validity testing to show that their daily lives are significantly impaired and that they are not malingering.",
