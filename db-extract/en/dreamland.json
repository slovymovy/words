                                "target_senses": [
                                    {
                                        "sense_id": "80400e93-f048-33b2-a0c4-e867aa614588",
                                        "entry_id": "ef7a669d-a464-3a58-b8af-c125fabac9a1",
                                        "glosses": [
                                            "Land, das man nur im Traum erleben kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdc7ce8-9cac-4ab1-9fb9-93bfdff859d9",
                                                "sense_id": "80400e93-f048-33b2-a0c4-e867aa614588",
                                                "text": "„Dann schien es, als ob ich friedevoll auf einem sanften Meer von Tönen davontrieb, bis ich mich im Traumland befand und Mary Morstans liebes Gesicht sich über mich neigte.“"
                                            },
                                            {
                                                "example_id": "b86046d2-fda8-4be4-86f5-497e8686fab9",
                                                "sense_id": "80400e93-f048-33b2-a0c4-e867aa614588",
                                                "text": "„Sie wollte weglaufen, doch die magnetische Kraft des Traumlandes hielt sie fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f164da43-9a87-3337-be76-3e9c31a74549",
                                        "entry_id": "ef7a669d-a464-3a58-b8af-c125fabac9a1",
                                        "glosses": [
                                            "Land, das man als wunderbar erfährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a220629f-ddd3-42cc-91ca-91dc2d5b8036",
                                                "sense_id": "f164da43-9a87-3337-be76-3e9c31a74549",
                                                "text": "„Die Bundesrepublik, so viel ist gewiss, ist kein Traumland für internationale Fachkräfte und Hochqualifizierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
