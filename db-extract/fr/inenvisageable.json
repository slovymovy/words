                        "entry_id": "c586f638-1fc4-36e6-9291-962b5179a356",
                        "glosses": [
                            "Qu’on ne peut envisager, concevoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e7718f-3ce2-4b15-ade7-e17af63e5136",
                                "sense_id": "46e28ad6-1a16-31d4-87b5-49e600857ebb",
                                "text": "Pour Five Guys, qui a ouvert son premier restaurant à Bercy (12ᵉ) en 2016, « c’était inenvisageable de ne pas être à Paris », explique Constance Ergand, la responsable marketing de la marque."
                            },
                            {
                                "example_id": "0f7d3140-e53f-4348-b7a5-c80c38780bc2",
                                "sense_id": "46e28ad6-1a16-31d4-87b5-49e600857ebb",
                                "text": "Les mots étaient là, qu’est-ce qu’elle a fait, mais je ne pouvais pas comprendre leur sens, je ne voulais pas, c’était non, c’était hors de question, c’était impossible, c’était inenvisageable, ce n’était pas vrai, ce n’était pas la réalité, ce n’était pas ce que j’étais en train de vivre, ça ne pouvait pas finir comme ça."
                            }
                        ]
                    }
