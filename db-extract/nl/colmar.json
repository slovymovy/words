                        "cross_references": [
                            {
                                "target_word": "Кольмар",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b95883e0-7873-3062-96dd-78f9876e3ace",
                                        "entry_id": "39bec4c8-a783-392e-a38e-f8be11697fb8",
                                        "glosses": [
                                            "город во Франции, в центральном Эльзасе, коммуна на северо-востоке Франции в регионе Гранд-Эст"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717217f0-3e04-40fa-9ae4-5c3c9b651fac",
                                                "sense_id": "b95883e0-7873-3062-96dd-78f9876e3ace",
                                                "text": "Некоторые вещи французской полиции удалось отыскать на дне канала, они хранятся на складе музея в Кольмаре в ожидании исхода судебных разбирательств."
                                            },
                                            {
                                                "example_id": "61aa1eea-0bd2-4985-986f-289bd4e5755b",
                                                "sense_id": "b95883e0-7873-3062-96dd-78f9876e3ace",
                                                "text": "Осенью 1833 года в Берлине «молодой человек живого и независимого характера», как пишет о нём биограф, двадцатилетний француз родом из Кольмара по имени Жорж Шарль Дантес получил рекомендательное письмо в Россию на имя директора Канцелярии военного министерства графа Владимира Адлерберга."
                                            },
                                            {
                                                "example_id": "0edd5eca-81ab-4809-a43c-bbbc25654aff",
                                                "sense_id": "b95883e0-7873-3062-96dd-78f9876e3ace",
                                                "text": "Произошла первая бомбёжка французских городов немецкими самолётами: бомбили Кольмар, Лилль, Лион, Нанси и Понтуаз."
                                            },
                                            {
                                                "example_id": "8f7650ac-461a-40e9-88aa-3c3d4ea30d58",
                                                "sense_id": "b95883e0-7873-3062-96dd-78f9876e3ace",
                                                "text": "Только тогда получено было приказание великому князю прибыть в Париж, и он отправился туда через Кольмар и Нанси."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
