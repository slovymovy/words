                        "glosses": [
                            "cecha tego, co rozrzutne; cecha tych, którzy są rozrzutni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa47214-2a1e-4d17-bc6d-9657ee56b84a",
                                "sense_id": "d7794a3d-56a6-384d-8ca0-f889c94c165d",
                                "text": "Jednym z najbardziej potrzebnych wydatków Tysona było dziewięć tysięcy miesięcznie na psychoanalityka, u którego leczył się z chorobliwej rozrzutności"
                            }
                        ],
