                        "examples": [
                            {
                                "example_id": "a3f8b0ca-c8fe-45f4-90e7-18184e013815",
                                "sense_id": "4dab58ad-ada7-38df-bdf1-86bc6256e11e",
                                "text": "Aix-les-Bains liegt am Lac du Bourget und in der Nähe der französischen Alpen."
                            },
                            {
                                "example_id": "c2f62b0e-8c5a-4829-91fd-8a2de98e64bc",
                                "sense_id": "4dab58ad-ada7-38df-bdf1-86bc6256e11e",
                                "text": "Die Schweizer Grenze ist ungefähr 50 Kilometer von Aix-les-Bains entfernt, die italienische circa 70."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
