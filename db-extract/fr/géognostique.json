                ],
                "senses": [
                    {
                        "sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                        "entry_id": "875b2ea1-c8fb-3a0c-bb97-0ba0dc00d50e",
                        "glosses": [
                            "Qui a rapport à la géognosie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f53f3e-9299-4f40-9641-d11914b0fea6",
                                "sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                                "text": "C'est l'horizon géognostique des carrières de Connage, du fond d'Enfer, d’Haraucourt. On les exploite aussi à Vaux, à Belzy, arrondissement de Rethel."
                            },
                            {
                                "example_id": "60fde542-22cd-429f-95ef-e33fa17ca3d3",
                                "sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                                "text": "Oui, nous l’admettons, la transformation des espèces et l’unité originaire du type, parce que le grand livre géognostique est là pour nous dire la marche progressive de la création."
                            },
                            {
                                "example_id": "c98e70b3-ee20-4c35-a89b-4c42b049d1b2",
                                "sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                                "text": "C’est cette considération qui a porté le conseil de la Société, dans sa séance du 26 novembre, à décider que le récit de ces courses, rédigé par MM. de Caumont et Busnel, et dont on peut retrouver les détails dans la Topographie géognostique du Calvados serait très abrégé pour le bulletin."
                            },
                            {
                                "example_id": "23abb9a3-7437-4776-86d9-db537610b32a",
                                "sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                                "text": "Nous remontons d’un pas géognostique vers les cuisines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a01dbf30-044b-4c41-b4d0-345420fdca94",
                        "source_entry_id": "875b2ea1-c8fb-3a0c-bb97-0ba0dc00d50e",
                        "source_sense_id": "4eb649b7-45d0-3641-8c92-6d9a4d047cbb",
                        "target_lang_word": "geognostic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geognostic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c50316-c516-3738-b287-35df4d597e1f",
                                        "entry_id": "1d0a62f2-76d2-3f13-b9a8-a67f10de910d",
                                        "glosses": [
                                            "Pertaining to geognosy; geological."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c7ea270-17b5-4e8a-99e1-d8f7fe004a8f",
                                                "sense_id": "f6c50316-c516-3738-b287-35df4d597e1f",
                                                "text": "To a ploughboy, a pebble is an insignificant thing, suggestive possibly of some discomfort in walking, and fit only to shy at a bird, may be; but to the geologist it appears worthy a volume, and speaks to him of strata may be a million of years old, of glacial attrition, of volcanic action, of chemical constituents, of mineralogical principles, and crystallogenic attraction, of mathematical laws and geometric angles, and of future geognostic changes."
                                            },
                                            {
                                                "example_id": "df1e9949-2259-470e-80b6-6ad960a422dc",
                                                "sense_id": "f6c50316-c516-3738-b287-35df4d597e1f",
                                                "text": "Unfortunately I do not possess sufficient geognostic knowledge to be able to set this cavern down as an extinct volcano."
                                            },
                                            {
                                                "example_id": "496fe91f-ffec-456a-9567-4aad5f52271d",
                                                "sense_id": "f6c50316-c516-3738-b287-35df4d597e1f",
                                                "text": "There is, indeed, one piece of evidence for the probability of the comparative youth of our system, altogether apart from human traditions and the geognostic appearances of the surface of our planet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
