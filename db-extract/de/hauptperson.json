                        "cross_references": []
                    },
                    {
                        "translation_id": "8416620c-6b9f-433b-a36a-c6764ecb35f4",
                        "source_entry_id": "15e9c0a1-67c9-3eca-8c1f-83fddea4ec1d",
                        "source_sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
                        "source_sense_description": "diejenige Person, die in einem bestimmten Kontext am wichtigsten ist",
                        "target_lang_word": "personnage central",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5ac46d39-c808-4a61-9608-19826e5b8fd3",
                        "source_entry_id": "15e9c0a1-67c9-3eca-8c1f-83fddea4ec1d",
                        "source_sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
                        "source_sense_description": "diejenige Person, die in einem bestimmten Kontext am wichtigsten ist",
                        "target_lang_word": "vedette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vedette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Sentinelle, surtout de cavalerie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa66cd8c-4508-4960-92ed-eb2aa3b43edf",
                                                "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                                "text": "À notre approche un cavalier placé sans doute en vedette poussa un qui-vive retentissant."
                                            },
                                            {
                                                "example_id": "551349b5-fde2-49e6-94b5-a41169267ac9",
                                                "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                                "text": "Il était aisé de voir que ces énormes pièces avaient ôté aux assiégeants l’idée d’attaquer ce point, et aux assiégés celle d’y multiplier les moyens de défense. Aussi, d’un côté, les postes avancés et les vedettes étaient fort éloignés ; de l’autre, les sentinelles étaient rares et mal soutenues."
                                            },
                                            {
                                                "example_id": "8c7249a8-4609-4c69-b0c2-031b743ce9e0",
                                                "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                                "text": "Pendant ce temps, l’ennemi avait fait de nouvelles tentatives dans le haut du Loir ; ses vedettes s’étaient rapprochées de celles de la première division du 21ᵉ corps."
                                            },
                                            {
                                                "example_id": "d5f20175-4d38-43af-98ca-8770effedbe1",
                                                "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                                "text": "En plein jour, nous remarquâmes aussi très souvent que les sentinelles correspondaient entre elles par des mouvements exécutés avec le fusil et que les vedettes, bien que postées quelquefois à une grande distance les unes des autres, apprenaient toutes, au même instant, qu’un danger était proche."
                                            },
                                            {
                                                "example_id": "5b494804-00b5-498d-9ddc-0b5ac966a2c8",
                                                "sense_id": "9f0a00c8-feb4-34ac-996b-bb29935846f2",
                                                "text": "Leurs vedettes ne tardèrent point à signaler l’approche de nos Révérends Pères escortés de soldats lorrains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da6c8dbf-da96-39db-ba6a-a8d7c3268932",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Ce qui est placé de façon à être vu, à attirer l’attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380554de-e660-4337-b4f4-3f6dedd5328f",
                                                "sense_id": "da6c8dbf-da96-39db-ba6a-a8d7c3268932",
                                                "text": "En vedette, en vue."
                                            },
                                            {
                                                "example_id": "f12a762c-3bc9-478a-8a76-08064791ba7f",
                                                "sense_id": "da6c8dbf-da96-39db-ba6a-a8d7c3268932",
                                                "text": "Il faut mettre ce mot en vedette dans le texte."
                                            },
                                            {
                                                "example_id": "937bdba4-98b7-4523-a955-412d0da1c861",
                                                "sense_id": "da6c8dbf-da96-39db-ba6a-a8d7c3268932",
                                                "text": "Sa statue est bien en vedette dans la salle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859b0bec-2f16-3d04-8ae0-48bce1cc0f6a",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Place la plus apparente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f115db23-d9bd-4dc6-9b15-d056e9dab47c",
                                                "sense_id": "859b0bec-2f16-3d04-8ae0-48bce1cc0f6a",
                                                "text": "Avoir la vedette, occuper la vedette sur une affiche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add48890-4a91-3f31-b4cc-220fa6e005f7",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Celui, celle dont le nom occupe sur l’affiche la place la plus visible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09fd843b-2a77-4bcb-9dae-acb836f660aa",
                                                "sense_id": "add48890-4a91-3f31-b4cc-220fa6e005f7",
                                                "text": "À plat ventre, près de la rampe, l’électricien vérifiait les ampoules sans s’occuper de la vedette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c0069a-f1ea-3ff4-a68a-87e7a7805706",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Personne célèbre, surtout du monde du cinéma, de la télévision, de la musique populaire, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9231f9-65bd-4a49-9f14-e4b69b975ece",
                                                "sense_id": "73c0069a-f1ea-3ff4-a68a-87e7a7805706",
                                                "text": "De frime en panouille, il a aussi croisé au détour d’un plateau ces vedettes qu’il rejoindra bientôt : Belmondo, Delon, Noiret, Serrault, Galabru... et Bernard Blier, qui lui présente ses copains Gabin et Jean Carmet."
                                            },
                                            {
                                                "example_id": "f3d025c9-4b55-4680-a7d0-7c58df54a383",
                                                "sense_id": "73c0069a-f1ea-3ff4-a68a-87e7a7805706",
                                                "text": "Des caprices de pin-up, des croqueuses de diamants qui se déhanchent pour le milliardaire du jour, des vedettes américaines en villégiature à Cinecittà qui veulent en montrer aux jeunes Romains, des gigolos qui se lancent dans des kazatchoks pour impressionner la cliente, oui.' — (Clément Ghys, Vadim, le plaisir sans remords, 2017)"
                                            },
                                            {
                                                "example_id": "26d5f696-8a9f-405f-9fbc-9b4a42b7b0df",
                                                "sense_id": "73c0069a-f1ea-3ff4-a68a-87e7a7805706",
                                                "text": "En attendant, les festivals sont eux-mêmes victimes de cette course aux cachets et doivent sans cesse trouver plus de fraîche pour attirer des vedettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054de5ae-d6e4-3b63-9377-609228a49b73",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Bateau qui assure différents services, notamment les servitudes d’un navire plus important."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ebe34e-3b82-4ff6-8778-a430b07dbba9",
                                                "sense_id": "054de5ae-d6e4-3b63-9377-609228a49b73",
                                                "text": "Je quittai l’embarcadère, remorqué par Bob Schultz et son yacht à moteur We Two, escorté par une vedette de la police américaine, et par le commodore du Morris Yacht Club dans son yacht à moteur."
                                            },
                                            {
                                                "example_id": "eddbb8e3-b6b1-4a65-aaad-ca0b1acb6ca9",
                                                "sense_id": "054de5ae-d6e4-3b63-9377-609228a49b73",
                                                "text": "Sandakan m’apparaissait comme n’importe quel port de ces côtes perdues : quelques bâtiments blancs dans la verdure des palmes et des cocotiers, […], un wharf branlant et l’inévitable vedette poussive de la police."
                                            },
                                            {
                                                "example_id": "d210db78-fed7-4c40-9bd5-51d9a73493af",
                                                "sense_id": "054de5ae-d6e4-3b63-9377-609228a49b73",
                                                "text": "Bien sûr que je sais où est l'épave. J'amarre des vedettes trois jours par semaine. Mais je ne vous dirai pas. Ça risquerait d'attirer les curieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b931d699-073b-3d10-baad-6eba1320bb5a",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Bateau qui assure différents services, notamment les servitudes d’un navire plus important.",
                                            "Bateau à moteur puissant et rapide, pour la croisière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f119ea7-2a66-3076-877d-d3a0923df314",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Mot traité par une entrée de dictionnaire, mot vedette."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a38ac579-5c18-3d2e-b6fb-037b4cbcb585",
                                        "entry_id": "3eb06993-522b-33b2-9a06-535b19db3a41",
                                        "glosses": [
                                            "Appellatif par lequel on s’adresse à quelqu’un au début d’une lettre : Madame, Mademoiselle, Monsieur, Sire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a20670-a76f-4907-9e54-8e2e66a49955",
                                                "sense_id": "a38ac579-5c18-3d2e-b6fb-037b4cbcb585",
                                                "text": "La vedette, c’est-à-dire le titre, Monsieur, Madame, etc., et la première ligne du corps de la lettre, se mettent plus haut ou plus bas, selon le degré de respect qu’on veut marquer. Ainsi, la vedette au premier tiers de la page et la première ligne au second sont tout à fait respectueux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vedette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "845c2088-f145-3999-a9a7-37286ab03f14",
                                        "entry_id": "98d25f1e-6e97-3c51-9e5a-a1f8cdf7e9a1",
                                        "glosses": [
                                            "Important, de premier plan, en vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eddaadb9-e7fd-4296-a25d-eb7f9526ce2b",
                                                "sense_id": "845c2088-f145-3999-a9a7-37286ab03f14",
                                                "text": "Arnaud de Borchgrave, journaliste vedette de Newsweek."
                                            },
                                            {
                                                "example_id": "1b1fa19a-39c9-4485-84b1-dfb3c77eeb54",
                                                "sense_id": "845c2088-f145-3999-a9a7-37286ab03f14",
                                                "text": "Mot vedette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
