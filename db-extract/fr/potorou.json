                        "sense_id": "5b073c7c-4a0e-3c83-bd21-3d36c7e5f38e",
                        "entry_id": "de835954-959b-3d60-bbe4-edccaa5345ab",
                        "glosses": [
                            "Genre de marsupiaux d’Australie, de la taille d’un gros rat dont ils ont aussi l’allure générale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a2d8d6-564b-46f4-a6bf-225a797a1b3f",
                                "sense_id": "5b073c7c-4a0e-3c83-bd21-3d36c7e5f38e",
                                "text": "Un animal qui se rapproche des kangorous ^([sic]) est le potorou ; on n’en connaît qu’une seule espèce."
                            },
                            {
                                "example_id": "d9c251c2-13d8-4be5-b13d-83cf52c0929f",
                                "sense_id": "5b073c7c-4a0e-3c83-bd21-3d36c7e5f38e",
                                "text": "En général, la taille du Potorou est celle d’un petit Lapin. Les Potorous ont des mœurs très-douces et moins timides que celles des Kangourous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c7f87be-d330-4122-bacb-551c80141555",
                        "source_entry_id": "de835954-959b-3d60-bbe4-edccaa5345ab",
