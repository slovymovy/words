                                "target_senses": [
                                    {
                                        "sense_id": "d1bcb7e8-0523-3534-a889-c3d464e0e7cd",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Dispositif destiné à détecter quelque chose de difficilement perceptible ou caché ; capteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190713b7-17e3-4e24-b99e-65f7ab42cd8d",
                                                "sense_id": "d1bcb7e8-0523-3534-a889-c3d464e0e7cd",
                                                "text": "Détecteur à transfert de charges (anglais charge-coupled device, CCD), technologie de capteur photographique fonctionnant par effet photoélectrique sur un substrat semi-conducteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Dispositif effectuant une transformation non linéaire d'un signal électromagnétique en vue d’extraire une information portée par ce signal."
                                        ],
                                        "tags": [
                                            "Radiocommunications"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2074dcce-6f3a-4701-8557-3494f6420ae2",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Les récepteurs récents utilisent le discriminateur à coïncidence aussi appelé détecteur à quadrature ou détecteur synchrone."
                                            },
                                            {
                                                "example_id": "52e99d20-e1f9-42dd-95a8-2f68bda05cab",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Le détecteur à cristal est une diode, fonctionne en valve. Le rôle du détecteur est de servir de clapet anti-retour électrique au courant électrique alternatif de haute fréquence en supprimant l'une des alternances reçues […]."
                                            },
                                            {
                                                "example_id": "a24bc722-1273-421e-bb3d-e16dc17691ad",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Détecteur hétérodyne, détecteur qui transforme une entrée de haute fréquence en signal de basse fréquence par couplage non linéaire avec un oscillateur local à basse fréquence."
                                            },
                                            {
                                                "example_id": "f6ecb414-9fa0-4cf5-abbb-9c6f5202296e",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Détecteur homodyne, détecteur qui utilise un oscillateur local à la même fréquence que le signal d'entrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d43543-b242-3887-82a5-d588ba1ad585",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Personnel disposant d’un brevet d’aptitude à utiliser un détecteur radar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
