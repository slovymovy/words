                "senses": [
                    {
                        "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                        "entry_id": "3e93e23f-2d71-3427-930d-41616ae8b44e",
                        "glosses": [
                            "Untersuchung mit den Fingern und der Handfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c833f465-b066-4edf-b513-fbf0fa0af9b5",
                                "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                                "text": "„In 10,8% der Patienten wurden durch die manuelle Palpierung der Lunge weitere Metastasen gefunden […].“"
                            },
                            {
                                "example_id": "ed5a9fe8-ed31-43a3-b860-3d5c00eaa565",
                                "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                                "text": "„Beim paranephritischen Absceß ist vor allem Palpierung und Perkussion der Nierengegend des auf dem Bauche liegenden Kranken wichtig.“"
                            },
                            {
                                "example_id": "532ef1be-726d-48f1-87b6-5b2ac6f4c38f",
                                "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                                "text": "„Die Untersuchung geschieht in derselben Weise wie die Palpierung der Prostata.“"
                            },
                            {
                                "example_id": "d21d6510-e81f-4be6-bfdc-e392d6805b6d",
                                "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                                "text": "„Die Tonusabnahme, die Hypotonie oder Atonie, wird durch passive Bewegungen oder durch Palpierung ermittelt […].“"
                            },
                            {
                                "example_id": "b242f81e-fbdf-42e5-b3f9-02bd81df4d72",
                                "sense_id": "5b293b5a-453c-3c57-afb6-f49d9e54329d",
                                "text": "„[Die Läsionen] müssen eine rote Farbe sowie eine Schwellung aufweisen und bei der Palpierung warm sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
