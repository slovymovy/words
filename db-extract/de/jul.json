                    },
                    {
                        "translation_id": "4f271b3b-22cc-4251-a0bf-d72c37ea70f9",
                        "source_entry_id": "920dc64e-4335-31df-9032-d12abb955ad2",
                        "source_sense_id": "bf1e28aa-3c32-3017-a73e-b857bb3c7874",
                        "source_sense_description": "Wintersonnenwendefest",
                        "target_lang_word": "Yule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d16ebf0-2f2d-343d-bcf2-9c05e254d90a",
                                        "entry_id": "62598137-5f25-3fd3-89b9-97ddf627dcf1",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd4a615-944f-4ef9-9867-c71a87c63f73",
                                                "sense_id": "4d16ebf0-2f2d-343d-bcf2-9c05e254d90a",
                                                "text": "Daniel Yule, 30ᵉ à l’issue de la première manche du slalom de Chamonix, et donc dernier qualifié pour la seconde, a fini en levant les bras."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Yule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3624097-e1ea-3217-bfc7-07a10926a65f",
                                        "entry_id": "2f4cfc03-083e-3b11-bca5-1285d68b824c",
                                        "glosses": [
                                            "Ancienne célébration du solstice d’hiver chez les Anglo-Saxons, ainsi que chez les peuples germaniques et scandinaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cfd94c-1bda-4cff-a0b5-bcf26e12cb80",
                                                "sense_id": "a3624097-e1ea-3217-bfc7-07a10926a65f",
                                                "text": "Yule est, quant à elle, la plus connue des diverses fêtes préchrétiennes du solstice d’hiver chez les Germains et les Celtes. Alors que les ténèbres étendent leur emprise sur le monde, on invoque les dieux, notamment leur chef, le magicien Odin, et on leur offre des sacrifices."
                                            },
                                            {
                                                "example_id": "0d624141-1e92-44c5-a876-781951541734",
                                                "sense_id": "a3624097-e1ea-3217-bfc7-07a10926a65f",
                                                "text": "Je veux un beau Yule, dit-il alors d’une voix sourde. Un Yule qui vous réchauffe tout le corps, du sommet du crâne à l’extrémité des orteils.."
                                            },
                                            {
                                                "example_id": "3a24066c-1d20-490f-8742-733dc40c721d",
                                                "sense_id": "a3624097-e1ea-3217-bfc7-07a10926a65f",
                                                "text": "C’était la Yule, que les hommes appellent Noël même s’ils savent dans leur cœur cette fête plus ancienne que Bethléem et Babylone, plus ancienne que Memphis, que l’humanité."
                                            },
                                            {
                                                "example_id": "07e9fbc8-a192-4c4d-adff-d755498445ee",
                                                "sense_id": "a3624097-e1ea-3217-bfc7-07a10926a65f",
                                                "text": "Les gens parlaient des ‘Yules’ et cette période correspondait à un mois entier de festins et festivités en tout genre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
