                        "source_sense_id": "2fd7b1ce-1323-389d-9125-bb44ef7b75a5",
                        "source_sense_description": "foremost mast",
                        "target_lang_word": "fokkenmast",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fokkenmast",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "be8a82f1-b5af-3fcb-a8e3-903dcb9c5150",
                                        "entry_id": "8f26fe93-a6ed-36a0-b010-f84b64556e9b",
                                        "glosses": [
                                            "voorste mast van een driemastschip"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3504420e-5cf8-4002-a570-0f36758637ab",
                                                "sense_id": "be8a82f1-b5af-3fcb-a8e3-903dcb9c5150",
                                                "text": "Hij had een schip gekocht met een prachtig versierde fokkenmast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcb26fb3-971a-425c-8600-43d2b256de28",
                        "source_entry_id": "0ba68f50-2367-31d2-aac6-c1a31e965815",
                        "source_sense_id": "2fd7b1ce-1323-389d-9125-bb44ef7b75a5",
                        "source_sense_description": "foremost mast",
                        "target_lang_word": "mât de misaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mât de misaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a78c9d47-0c7e-396e-b1b0-b88b516c44b7",
                                        "entry_id": "65268e45-fb9d-3485-9822-d966ada96218",
                                        "glosses": [
                                            "Mât le plus proche de l’étrave sur un navire ayant deux mâts ou plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bdc262e-b801-40ab-8da2-3ff2a4c2ee0a",
                                                "sense_id": "a78c9d47-0c7e-396e-b1b0-b88b516c44b7",
                                                "text": "On peut encore y voir pour motif que les voiles du mât de misaine font canarder; elles sont plus petites que celles du grand mât à la vérité, mais leur éloignement du centre du tangage leur donne beaucoup de puissance."
                                            },
                                            {
                                                "example_id": "c06cef1c-35ea-47a2-9a77-616c405884d2",
                                                "sense_id": "a78c9d47-0c7e-396e-b1b0-b88b516c44b7",
                                                "text": "Et Jean-Marie, malgré la rafale, malgré les soubresauts du brick, grimpait au mât de misaine pour amarrer le hunier qui flottait au vent comme un drapeau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4672af1b-a1c5-4097-9965-1352a39c88bf",
                        "source_entry_id": "0ba68f50-2367-31d2-aac6-c1a31e965815",
                        "source_sense_id": "2fd7b1ce-1323-389d-9125-bb44ef7b75a5",
                        "source_sense_description": "foremost mast",
                        "target_lang_word": "Fockmast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fockmast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                        "entry_id": "bc92b6e8-20b7-37bc-ac61-1dd9125e0a8b",
                                        "glosses": [
                                            "erster Mast eines großen Segelschiffes"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00a33a7-8c1e-44c9-9e41-bc007d65fe12",
                                                "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                                            },
                                            {
                                                "example_id": "66dfed06-8458-4757-a4cd-6f64c08f8064",
                                                "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                                "text": "„Die Matrosen holten das Hauptmarssegel und das Großsegel ein, sodass nur noch die Segel des Fockmastes die Diligent vorantrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
