                                                "sense_id": "53f21f36-621f-3a0b-96be-0f568f8b8ac4",
                                                "text": "There is a difference between bookmaking, an entirely respectable profession, and fleecing people, which isn’t."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3bb49c-d89b-32fb-a788-d3257e53e330",
                                        "entry_id": "03d1c2fe-5a6b-3612-8927-1a351e9977f8",
                                        "glosses": [
                                            "To cut off the fleece from (a sheep or other animal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
