                "senses": [
                    {
                        "sense_id": "12e7cf5c-8d96-302e-ac03-0673e3c3852b",
                        "entry_id": "03796d6b-76a9-3446-a237-ea4b19deaef2",
                        "glosses": [
                            "Liste, auf der Personen aufgeführt sind, die für etwas kandidieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd7bbdde-e114-4585-9da9-ed57ddcddc98",
                                "sense_id": "12e7cf5c-8d96-302e-ac03-0673e3c3852b",
                                "text": "„Die Grazer SPÖ will in einem Pilotprojekt für die Gemeinderatswahl am 25. November - in deren Zuge auch die Bezirksvorsteher gekürt werden - im nordwestlichen Grazer Stadtbezirk Gösting sowohl Parteimitglieder als auch Bürger über die rote Kandidatenliste für den Bezirks-Chef abstimmen lassen.“"
                            },
                            {
                                "example_id": "103ebcdd-65c6-4558-a308-60b71f1986e9",
                                "sense_id": "12e7cf5c-8d96-302e-ac03-0673e3c3852b",
                                "text": "„Die entsprechenden Kandidatenlisten werden in den Wahllokalen aushängen.“"
                            },
                            {
                                "example_id": "0ed8f2a3-7b9c-441c-85e1-86c939daff65",
                                "sense_id": "12e7cf5c-8d96-302e-ac03-0673e3c3852b",
                                "text": "„Ein Blick auf die Kandidatenlisten der drei Volksparteien PPP, PML-N und PML-Q vor den Wahlen 2008 wie 2013 zeigt, dass diese vor allem Landbesitzer und Angehöriger dynastischer Familienclans nominiert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
