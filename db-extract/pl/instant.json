                                "target_senses": [
                                    {
                                        "sense_id": "ab08e34e-810d-3094-8300-69d173c1f0d6",
                                        "entry_id": "d5b53233-b66a-33d0-a506-63b86cf7549d",
                                        "glosses": [
                                            "A very short period of time; a moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f427164c-3d99-44d4-babb-9f38ff880f3a",
                                                "sense_id": "ab08e34e-810d-3094-8300-69d173c1f0d6",
                                                "text": "She paused for only an instant, which was just enough time for John to change the subject."
                                            },
                                            {
                                                "example_id": "256e241f-9209-4b58-8001-323ccfb462be",
                                                "sense_id": "ab08e34e-810d-3094-8300-69d173c1f0d6",
                                                "text": "Thy life is long, Eternity is short. So short that, shouldst thou die and Eternity should pass, and after the passing of Eternity thou shouldst live again, thou wouldst say: ‘I closed mine eyes but for an instant.’"
                                            },
                                            {
                                                "example_id": "f45c3559-3c21-4da4-a0f9-f93fea588b59",
                                                "sense_id": "ab08e34e-810d-3094-8300-69d173c1f0d6",
                                                "text": "\"On receiving the baton, steam was again turned on, and the train passed on to the bridge... when the train had got about 200 yards from the cabin [in the signal box], he observed sparks flying from the wheels; and after they had continued about three minutes, there was a sudden bright flash of light, and in an instant there was total darkness, the tail lamps of the train, the sparks, and flash of light, all, he said disappearing at the same instant.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11fed31-d3f4-3aa5-9166-7eba2f74101e",
                                        "entry_id": "d5b53233-b66a-33d0-a506-63b86cf7549d",
                                        "glosses": [
                                            "A single, usually precise, point in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6e8dcf-4b50-4cb6-9fd7-c2838dc3178d",
                                                "sense_id": "c11fed31-d3f4-3aa5-9166-7eba2f74101e",
                                                "text": "The instant the alarm went off, he fled the building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757a1aa4-f0c5-3720-a6f2-8c42fa0aceb5",
                                        "entry_id": "d5b53233-b66a-33d0-a506-63b86cf7549d",
                                        "glosses": [
                                            "A beverage or food which has been pre-processed to reduce preparation time, especially instant coffee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
