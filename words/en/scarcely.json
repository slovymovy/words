{
    "word_family": [
        "scarce",
        "scarcity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b6397fdf-f2fa-3f0f-b70a-7c6617a0b797",
                    "sense_definition": "Only just; by a very small margin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scarcely</w> had she arrived when the meeting started.",
                            "target_lang_translations": {
                                "ru": "<w>Едва</w> она приехала, как началось собрание."
                            }
                        },
                        {
                            "text": "The rabbit could <w>scarcely</w> breathe under the heavy pillow.",
                            "target_lang_translations": {
                                "ru": "Кролик <w>едва</w> мог дышать под тяжелой подушкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "barely",
                        "hardly",
                        "just",
                        "only just"
                    ],
                    "common_phrases": [
                        "scarcely had"
                    ],
                    "target_lang_definitions": {
                        "ru": "Только что; с большим трудом или с минимальным запасом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едва́",
                                "target_lang_sense_clarification": "используется для обозначения действия, которое произошло сразу после другого или с трудом"
                            },
                            {
                                "target_lang_word": "е́ле",
                                "target_lang_sense_clarification": "подчеркивает физическую трудность или слабость выполнения действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28123942-1168-30ee-9265-bde039dace00",
                    "sense_definition": "Certainly not; hardly at all.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One could <w>scarcely</w> expect him to know the answer.",
                            "target_lang_translations": {
                                "ru": "Вряд ли можно было <w>ожидать</w>, что он знает ответ."
                            }
                        },
                        {
                            "text": "It is <w>scarcely</w> to be wondered at that he failed.",
                            "target_lang_translations": {
                                "ru": "Едва ли стоит удивляться тому, что он потерпел неудачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безусловно нет; вряд ли; почти невозможно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вря́д ли",
                                "target_lang_sense_clarification": "выражает сильное сомнение в возможности или достоверности чего-либо"
                            },
                            {
                                "target_lang_word": "едва́ ли",
                                "target_lang_sense_clarification": "книжный вариант выражения сомнения, близкий к «вряд ли»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6d3dd3-3828-3844-b32f-9672b248dcd9",
                    "sense_definition": "Probably not.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One could <w>scarcely</w> find any fish in that polluted river.",
                            "target_lang_translations": {
                                "ru": "В той загрязненной реке вряд ли можно было найти хоть какую-то рыбу."
                            }
                        },
                        {
                            "text": "Travellers would <w>scarcely</w> expect to find a station there.",
                            "target_lang_translations": {
                                "ru": "Путешественники вряд ли ожидали найти там станцию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вероятно, нет; маловероятно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вря́д ли",
                                "target_lang_sense_clarification": "наиболее естественный способ выразить малую вероятность события"
                            },
                            {
                                "target_lang_word": "едва́ ли",
                                "target_lang_sense_clarification": "используется для выражения скептического отношения к возможности чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}