                                "target_senses": [
                                    {
                                        "sense_id": "a52da84b-8723-33eb-a7da-34667537dde1",
                                        "entry_id": "685c8174-2bf8-36dc-b445-d2431677fb21",
                                        "glosses": [
                                            "Being a part or component of a whole."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da2fdf8d-9d24-4ea3-bd3f-9feae43291c6",
                                                "sense_id": "a52da84b-8723-33eb-a7da-34667537dde1",
                                                "text": "Body, soul, and reason are the three parts necessarily constituent of a man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce415580-e44c-326b-8597-08e28c676ab4",
                                        "entry_id": "685c8174-2bf8-36dc-b445-d2431677fb21",
                                        "glosses": [
                                            "Constitutive or constituting."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfb6569d-e2c5-34f1-b4fd-0b9c07d6b463",
                                        "entry_id": "685c8174-2bf8-36dc-b445-d2431677fb21",
                                        "glosses": [
                                            "Constitutive or constituting.",
                                            "Authorized to make a constitution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becd4b16-a287-4f84-9521-a79bad81d69c",
                                                "sense_id": "cfb6569d-e2c5-34f1-b4fd-0b9c07d6b463",
                                                "text": "the Constituent Assembly"
                                            },
                                            {
                                                "example_id": "c41a3217-1722-464f-a966-90b6a5f2ccce",
                                                "sense_id": "cfb6569d-e2c5-34f1-b4fd-0b9c07d6b463",
                                                "text": "A question of right arises between the constituent and representative body."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constituent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "692e9d05-e21f-3dfc-8281-eaadcddfbf7d",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "A part, or component of a whole"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91996c5f-2644-4c2a-bbb1-e77b00a27ecf",
                                                "sense_id": "692e9d05-e21f-3dfc-8281-eaadcddfbf7d",
                                                "text": "We know how to bring these constituents together, and to cause them to form water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4eb1dd-173d-3a33-80cd-39dbf2cc19b3",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "A person or thing which constitutes, determines, or constructs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c0b921-fc00-47e7-9411-aa61c6039199",
                                                "sense_id": "4c4eb1dd-173d-3a33-80cd-39dbf2cc19b3",
                                                "text": "whose first composure and origination requires a higher and nobler Constituent than either Chance or the ordinary method of meer Natural causes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d25b5d8-76d7-39b7-9f64-5a80e183c98e",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "A resident of an area represented by an elected official, particularly in relation to that official."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96103d01-5c93-4be1-b644-9da0250a0574",
                                                "sense_id": "1d25b5d8-76d7-39b7-9f64-5a80e183c98e",
                                                "text": "To appeal from the representatives to the constituents."
                                            },
                                            {
                                                "example_id": "8bb76024-c449-4875-91c6-377bfdeca1d6",
                                                "sense_id": "1d25b5d8-76d7-39b7-9f64-5a80e183c98e",
                                                "text": "But the purported rise in violent videos online has led some MPs to campaign for courts to have more power to remove or block material on YouTube. The Labour MP Heidi Alexander said she was appalled after a constituent was robbed at knifepoint, and the attackers could be found brandishing weapons and rapping about gang violence online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e2333da-0a69-3371-a9db-08c31143dc4c",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "A voter who supports a (political) candidate; a supporter of a cause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43194935-2d72-3466-b16f-dc5a9ad758c2",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "One who appoints another to act for him as attorney in fact"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b0f67c0-4e5d-34a1-b324-8554444e7c28",
                                        "entry_id": "438cee82-4398-327d-9d3e-357a8199d065",
                                        "glosses": [
                                            "A functional element of a phrase or clause"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f05212-5cdb-4e7b-9f81-9900cdd5c90d",
                                                "sense_id": "3b0f67c0-4e5d-34a1-b324-8554444e7c28",
                                                "text": "Thus, the postulation of a Noun Phrase constituent is justified on morphological grounds, since it is not obvious how we could describe the grammar of the genitive s inflection in English without saying that it's a Noun Phrase inflection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f95b4df3-14da-4e6f-b698-4b2bcc317059",
                        "source_entry_id": "07970ae7-3e03-3e33-9238-f1311af5913e",
