                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-aircraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3749942-f8b0-35ec-80a2-ca8d336e7dcf",
                                        "entry_id": "0ede233f-81c4-3954-8b23-eae37e76e051",
                                        "glosses": [
                                            "Intended to attack aircraft."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfce378c-94a4-4a27-9610-53689413d547",
                                                "sense_id": "e3749942-f8b0-35ec-80a2-ca8d336e7dcf",
                                                "text": "Special lamps were provided for working during the blackout, and an anti-aircraft gun, manned by the R.A.O.C., was mounted on the coal depot line."
                                            },
                                            {
                                                "example_id": "c4fe92a9-5a11-4739-8629-88932de2c2f8",
                                                "sense_id": "e3749942-f8b0-35ec-80a2-ca8d336e7dcf",
                                                "text": "Truth's ships are clustered above the excavation site. And his infantry has deployed anti-aircraft batteries around the perimeter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anti-aircraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c5bbcac-0c95-3463-9adc-89319f5eb0e8",
                                        "entry_id": "3fe7f43f-a8eb-3b3a-a038-6a6d5de4f810",
                                        "glosses": [
                                            "Anti-aircraft artillery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eed6cd3-9a27-4510-b1c6-ba35eb369ee3",
                                                "sense_id": "9c5bbcac-0c95-3463-9adc-89319f5eb0e8",
                                                "text": "I am blacking out—ease the stick forward slightly—the sky is clear again—I turn out over water—reverse turn—there are antiaircraft on the island below—I reverse again—and again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0261925d-3faf-3129-bb80-636a593667d1",
                                        "entry_id": "3fe7f43f-a8eb-3b3a-a038-6a6d5de4f810",
                                        "glosses": [
                                            "An anti-aircraft artillery organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
