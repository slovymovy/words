                            {
                                "target_lang_word": "erpresserisch",
                                "target_lang_sense_clarification": "zwanghaft fordernd"
                            },
                            {
                                "target_lang_word": "hart",
                                "target_lang_sense_clarification": "streng und unnachgiebig beim Eintreiben"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c6d7b7e-31c4-300b-8b5f-c0f1e137be7f",
                    "sense_definition": "The present participle and gerund of <w>exact</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is <w>exacting</w> higher taxes from the wealthiest citizens this year.",
                            "target_lang_translations": {
                                "de": "Die Regierung <w>treibt</w> dieses Jahr höhere Steuern von den wohlhabendsten Bürgern <w>ein</w>."
                            }
                        },
                        {
                            "text": "He spent his time <w>exacting</w> revenge on those who had betrayed him in the past.",
                            "target_lang_translations": {
                                "de": "Er verbrachte seine Zeit damit, an denen Rache <w>zu nehmen</w>, die ihn in der Vergangenheit verraten hatten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb exact."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens von »exact«; etwas (wie Steuern, Rache oder Gehorsam) einfordern, eintreiben oder erzwingen."
