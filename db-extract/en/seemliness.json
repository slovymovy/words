                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29207048-ebee-383e-92ee-9deaf23464e6",
                        "entry_id": "37c08ed8-3f30-3bac-bfc5-a87326890257",
                        "glosses": [
                            "Anstand, Schicklichkeit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0da7c1ed-cc21-47de-8ebf-521507ad086c",
                        "source_entry_id": "37c08ed8-3f30-3bac-bfc5-a87326890257",
                        "source_sense_id": "29207048-ebee-383e-92ee-9deaf23464e6",
                        "source_sense_description": "Anstand, Schicklichkeit",
                        "target_lang_word": "Anstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                        "entry_id": "bb394fa9-21b6-349d-aa2c-bffeb6ef263c",
                                        "glosses": [
                                            "gute Umgangsform; gutes, höfliches Benehmen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7d6787-02ae-4cda-8978-9267924a8f60",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "Sie haben viel Anstand gezeigt."
                                            },
                                            {
                                                "example_id": "bb4addb7-59da-457a-a920-81b09dd459d8",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "Er wußte, dass sein Verhalten gegen Anstand und Sitte verstieß."
                                            },
                                            {
                                                "example_id": "e8a561b0-f7e0-4f99-8711-f2ef5ec3d3f7",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "„Während Torsten Albig beim Festmahl Anstand einforderte, blickten viele auf einen drahtigen Herrn mit weißem Haar.“"
                                            },
                                            {
                                                "example_id": "bfcbaa2b-fb29-4051-9166-9c35dece9969",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "„Ich ging zum Orchester und sah einen Augenlick später, wie sich der Herzog der Schauspielerin näherte und sie mit höflichem Anstand ansprach.“"
                                            },
                                            {
                                                "example_id": "b26db390-bc2e-47e4-8c62-b1bef5e7c224",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "„Ihre Bewegungen zeigten viel natürlichen Anstand und eine gewisse Lebendigkeit, die jedoch vollkommen innerhalb der Schranken mädchenhafter Züchtigkeit verblieb.“"
                                            },
                                            {
                                                "example_id": "a2ea853b-9b6a-42e9-94be-2ac4da7f4a9f",
                                                "sense_id": "070ba726-a898-3abb-95c0-f33657a796f4",
                                                "text": "„Sie ärgert sich über das, was sie als frivol empfindet, über die Grenzen bürgerlichen Anstandes hinausgehend, ist aber von seinem Stil mehr als angetan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3d5ef36-de27-3b6f-98fa-8f2e19e621c6",
                                        "entry_id": "bb394fa9-21b6-349d-aa2c-bffeb6ef263c",
                                        "glosses": [
                                            "Unterbrechung des Pirschganges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5e33c0-3cbe-426a-aba4-c06b4240dc3b",
                                                "sense_id": "e3d5ef36-de27-3b6f-98fa-8f2e19e621c6",
                                                "text": "Deshalb, so Diezel, eigne sich der Anstand auf den Waldhasen nur zur Disziplinierung der übereifrigen Jungjäger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e092cf62-531f-3986-b1ec-dcc50c5229cd",
                                        "entry_id": "bb394fa9-21b6-349d-aa2c-bffeb6ef263c",
                                        "glosses": [
                                            "Einwand, Beanstandung"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e3bb29-da54-4a61-854f-b645ca11f4dd",
                                                "sense_id": "e092cf62-531f-3986-b1ec-dcc50c5229cd",
                                                "text": "„Während der Dauer dieses Dienstes erhoben sich zweierlei Anstände mit der königlich niederländischen Regierung.“"
                                            },
                                            {
                                                "example_id": "7ac8a1ba-dd26-4ee8-a4c0-436831bc7ff9",
                                                "sense_id": "e092cf62-531f-3986-b1ec-dcc50c5229cd",
                                                "text": "„Falls sich bei der Beratung des Rechnungsabschlusses durch den Gemeinderat keine Anstände ergeben oder die Anstände behoben wurden, hat der Gemeinderat über den Rechnungsabschluss zu beschließen.“"
                                            },
                                            {
                                                "example_id": "80ec6732-2e8c-4379-a978-e01b920818ed",
                                                "sense_id": "e092cf62-531f-3986-b1ec-dcc50c5229cd",
                                                "text": "„Obwohl dieser die Kontrolle über die Minister auszuüben hat, diese aber wieder für ihre Amtstätigkeit dem Reichsrat verantwortlich sind, hat der Oberste Rechnungshof nicht dem Parlament, sondern dem Kaiser direkt Rechenschaft über die Resultate seiner Tätigkeit zu erstatten und eventuelle Anstände, die sich bei Prüfung der Rechnungen ergeben, der kaiserlichen Entscheidung zu unterbreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe0b9ff3-b51a-4b64-9ebe-7034e30aea04",
                        "source_entry_id": "37c08ed8-3f30-3bac-bfc5-a87326890257",
                        "source_sense_id": "29207048-ebee-383e-92ee-9deaf23464e6",
                        "source_sense_description": "Anstand, Schicklichkeit",
                        "target_lang_word": "Schicklichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schicklichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                        "entry_id": "5aabcabf-3ac9-34b3-956f-2b57d1334fb1",
                                        "glosses": [
                                            "Angemessenheit zur Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e34465b-5c3a-4876-9403-419115db53d8",
                                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                                "text": "Also war sie bei offiziellen Anlässen stets von vortrefflicher Schicklichkeit."
                                            },
                                            {
                                                "example_id": "b5bdc646-2beb-4a99-85c6-2d3387ac4972",
                                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                                "text": "„Der Schicklichkeit halber blickte die Contessa ihren Gatten an, und dieser sagte sogleich, er sei bereit und einverstanden, selbst wenn ich mir vorgenommen hätte, die ganze Familie zu entführen.“"
                                            },
                                            {
                                                "example_id": "6f556f8d-4b75-4616-99ba-2c3ffd88e9a2",
                                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                                "text": "„Man soll die Schicklichkeit wahren, aber der Begriff des Schicklichen ändert sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
