                        "examples": [
                            {
                                "example_id": "842cddde-5790-4c95-bddb-36b0a6e1e781",
                                "sense_id": "77281fc1-c30d-34b8-b525-338baa5b1ff9",
                                "text": "Advocaten lijken steeds vaker te worden bedreigd door hun cliënten, maar ze doen bijna nooit aangifte. Het vaktijdschrift Advocatenblad trekt die conclusies na een enquête waaraan 681 advocaten deelnamen."
                            },
                            {
                                "example_id": "d748f627-baef-4549-9b64-5617c1957db8",
                                "sense_id": "77281fc1-c30d-34b8-b525-338baa5b1ff9",
                                "text": "De verkiezing van de Meest Gewaardeerde Advocaat werd uitgeschreven onder lezers van het Advocatenblad. Tweehonderdvijftig collega-advocaten kozen hem als beste. Naast Anker waren ook arbeidsrechtadvocaat Rogier Duk en familierechtadvocaat Louis Zonnenberg genomineerd. Het was de eerste keer dat het Advocatenblad de verkiezing organiseerde."
                            }
                        ]
                    }
