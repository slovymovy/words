                "senses": [
                    {
                        "sense_id": "03886c23-4c03-3761-843a-ca81f4db8a8b",
                        "entry_id": "2c3381fa-4f3c-3695-86ac-b24d27a42a4d",
                        "glosses": [
                            "unbeeinflusste Möglichkeit, sich für eine Alternative unter zwei oder mehreren zu entscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0de0eea-26c6-42ba-9e8b-514c8162522c",
                                "sense_id": "03886c23-4c03-3761-843a-ca81f4db8a8b",
                                "text": "Man kann kaum von Wahlfreiheit sprechen, wenn es nur eine realistisch umzusetzende Alternative gibt."
                            },
                            {
                                "example_id": "57b17061-0ba9-4d2c-9528-6ef95161fed7",
                                "sense_id": "03886c23-4c03-3761-843a-ca81f4db8a8b",
                                "text": "Sie suchen eine neue Krankenkasse? Noch gilt hier Wahlfreiheit."
                            },
                            {
                                "example_id": "40250c1e-1e36-4496-a208-f7d21ff820db",
                                "sense_id": "03886c23-4c03-3761-843a-ca81f4db8a8b",
                                "text": "Die Wahlfreiheiten werden ständig erweitert und führen nicht selten zu Verunsicherungen bei den Studierenden."
                            },
                            {
                                "example_id": "67efd615-c813-4dd9-9138-c518c0830ab7",
                                "sense_id": "03886c23-4c03-3761-843a-ca81f4db8a8b",
                                "text": "Im Artikel wird für mehr Wahlfreiheit bei der Rechtschreibung plädiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
