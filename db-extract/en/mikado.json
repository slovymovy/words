                    {
                        "sense_id": "c640c37c-1f8c-3716-95fb-31b8d5a34bea",
                        "entry_id": "a2033d57-c824-328e-b0d6-e06ab9902c72",
                        "glosses": [
                            "Any emperor of Japan."
