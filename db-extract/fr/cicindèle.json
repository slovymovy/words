                "senses": [
                    {
                        "sense_id": "e3d9ff22-4250-3c81-9754-3ce4627cc0ca",
                        "entry_id": "fc4195fe-bd35-3c02-9114-ef78f069d49d",
                        "glosses": [
                            "Nom donné à des coléoptères prédateurs, rapides à la course et à fortes mandibules, appartenant au genre Cicindela ou à des genres voisins comme Cylindera."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30e1cbd1-7729-4d19-b5ac-a47b47c4a452",
                                "sense_id": "e3d9ff22-4250-3c81-9754-3ce4627cc0ca",
                                "text": "Apprenez également, môssieur Mouillavoine, que la cicindèle est un coléoptère, ce que vous n’êtes pas, môssieur Mouillesarrasin ! Et que la cicindèle champêtre que j’ai traquée jusque dans votre établissement est commune en France, verte et marquée de jaune !"
                            },
                            {
                                "example_id": "566d814b-ea99-4022-937d-f2e92f1a6c2b",
                                "sense_id": "e3d9ff22-4250-3c81-9754-3ce4627cc0ca",
                                "text": "La cicindèle est l'animal qui effectue les plus grandes pointes de vitesse, par rapport à la taille de son corps."
                            }
                        ]
                    }
                ],
                "translations": [
