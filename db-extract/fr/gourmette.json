                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feinschmeckerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8127e119-57d3-382d-8331-257a92dce35b",
                                        "entry_id": "e3b244a3-9792-31b4-90e5-950309a394d4",
                                        "glosses": [
                                            "weibliche Person mit einem verwöhnten und/oder anspruchsvollen Geschmack und einem ausgeprägten Sinn für feine Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a1f9a69-0fe6-4257-891b-ca54d70e4421",
                                                "sense_id": "8127e119-57d3-382d-8331-257a92dce35b",
                                                "text": "„Obwohl Meghan bereits eine eifrige Köchin und leidenschaftliche Feinschmeckerin war, »öffnete er ihr die Augen für Essensgenuss auf einem ganz anderen Niveau«, berichteten Freunde.“"
                                            },
                                            {
                                                "example_id": "df761386-aafd-4f60-9997-527163c6c8eb",
                                                "sense_id": "8127e119-57d3-382d-8331-257a92dce35b",
                                                "text": "„So war Paula schon früh zu einer kleinen Feinschmeckerin geworden und irgendwann dann auf die Idee gekommen, selbst Köchin zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
