                "senses": [
                    {
                        "sense_id": "f777f200-db36-3ca4-a87a-4fc2541ddc67",
                        "entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
                        "glosses": [
                            "Menial duties, especially as punishment."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bb592a12-9d00-39a7-b62b-d5280d2c6011",
                        "entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
                        "glosses": [
                            "Military clothing worn when doing menial tasks."
                        ],
                        "tags": [
                            "US",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1435c945-c127-4e9f-a02b-709e38d5f663",
                                "sense_id": "bb592a12-9d00-39a7-b62b-d5280d2c6011",
                                "text": "He looked up, met gray eyes ringed with paintstick. She was wearing faded French orbital fatigues and new white sneakers."
                            },
                            {
                                "example_id": "a4c82793-f2ff-4aea-80c3-6ab80a293536",
                                "sense_id": "bb592a12-9d00-39a7-b62b-d5280d2c6011",
                                "text": "Ross: … why do you have to wear underwear tonight?\nJoey: It's a rented tux, 'kay? I'm not gonna go commando in another man's fatigues."
                            },
                            {
                                "example_id": "887d642c-01f0-435c-80e2-76dd62287f87",
                                "sense_id": "bb592a12-9d00-39a7-b62b-d5280d2c6011",
                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23274b7d-3319-463a-bd5b-ee74a882ff95",
                        "source_entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
                        "source_sense_description": "military clothing",
                        "target_lang_word": "gevechtstenue",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gevechtstenue",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a0efed9b-2938-3a16-8b2a-8b6ba1b32d7f",
                                        "entry_id": "fbef76d5-b32a-3d22-a4b8-777844faef1c",
                                        "glosses": [
                                            "kleding die een militair draagt tijdens een militaire actie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f311f81-eb3c-4c40-9260-5b1a025797e3",
                                                "sense_id": "a0efed9b-2938-3a16-8b2a-8b6ba1b32d7f",
                                                "text": "Gezonde Hollandse jongens, in gevechtstenue over elkaar heen buitelend als konijnen in een duinpan."
                                            },
                                            {
                                                "example_id": "e93b60d8-d438-4210-b865-168108d408f2",
                                                "sense_id": "a0efed9b-2938-3a16-8b2a-8b6ba1b32d7f",
                                                "text": "In de bossen van Litouwen kom je deze maand Nederlandse militairen in gevechtstenue tegen. De reden: Iron Wolf 2017. Een grote oefening van de NAVO waar 5300 militairen uit verschillende NAVO-landen aan meedoen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed35f70a-c382-4643-b248-a8aab0d287d0",
                        "source_entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
