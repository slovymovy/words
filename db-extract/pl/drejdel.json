                "translations": [
                    {
                        "translation_id": "d0a27c1d-f896-40f1-8e9a-338461a47e3b",
                        "source_entry_id": "674be771-e491-346e-975b-f93c6a25f62a",
                        "source_sense_id": "981f1d4c-dd45-32de-be4f-8ab82eb8baf9",
                        "target_lang_word": "dreidel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreidel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb01308-b1f6-3490-9e12-d91ae3dbadf8",
                                        "entry_id": "7bafe1b0-ef2c-32fd-b3ce-f67d3473514a",
                                        "glosses": [
                                            "A four-sided spinning top, inscribed with the four Hebrew letters נ (nun), ג (gimel), ה (hey), and ש (shin) (or פ (pey)) on each side, often used to play a traditional game during the Jewish festival of Hanukkah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a176173-5f51-47d9-9d97-cef579a78cc9",
                                                "sense_id": "3eb01308-b1f6-3490-9e12-d91ae3dbadf8",
                                                "text": "I have a little dreidel. I made it out of clay. / And when it's dry and ready, then dreidel I shall play. / Oh dreidel, dreidel, dreidel, I made it out of clay. / Oh dreidel, dreidel, dreidel, then dreidel I shall play."
                                            },
                                            {
                                                "example_id": "64f6c537-7ee4-43e2-9621-0f3c41499959",
                                                "sense_id": "3eb01308-b1f6-3490-9e12-d91ae3dbadf8",
                                                "text": "The dreidel is a spinning toy, painstakingly fashioned out of plastic polymer by Jewish craftsmen in Vietnam. Used for tabletop gambling games during Hanukkah, the dreidel often ends up on the floor and sometimes in the dog's small intestine."
                                            },
                                            {
                                                "example_id": "1836872c-aa36-4129-9dcf-befbbc3d01a6",
                                                "sense_id": "3eb01308-b1f6-3490-9e12-d91ae3dbadf8",
                                                "text": "Erickson shared images on CNN iReport that show mixed holiday decorations in their Falmouth, Massachusetts, home, from a menorah and advent calendar to stockings bearing the phrase “shalom” and plates decorated with dreidels on a red plaid table cloth. […] Like the Kopelmans, they have a Christmas tree with dreidel ornaments and a menorah, which they light each night."
                                            },
                                            {
                                                "example_id": "9fcbe215-e858-43c5-950e-2bb69a525db4",
                                                "sense_id": "3eb01308-b1f6-3490-9e12-d91ae3dbadf8",
                                                "text": "Students from the Yeshiva Beth Yehudah School danced in dreidel costumes at a menorah lighting in Detroit on Thursday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e4d16f-5e54-38af-9a94-fb4f80c48def",
                                        "entry_id": "7bafe1b0-ef2c-32fd-b3ce-f67d3473514a",
                                        "glosses": [
                                            "A gambling game played using this top."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a2d5d4-bec1-46e5-b7fd-58984e179bdb",
                                                "sense_id": "31e4d16f-5e54-38af-9a94-fb4f80c48def",
                                                "text": "We do not spend our days huddled in smoke-filled rooms plotting world domination while Jared Kushner plays dreidel in the back with Noam Chomsky and George Soros sneaks the last latke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4346297-15da-441b-b57c-d63e83630336",
                        "source_entry_id": "674be771-e491-346e-975b-f93c6a25f62a",
                        "source_sense_id": "981f1d4c-dd45-32de-be4f-8ab82eb8baf9",
                        "target_lang_word": "toupie de Hanoucca",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "129267db-c283-44bc-b6d3-125bce1ca28d",
                        "source_entry_id": "674be771-e491-346e-975b-f93c6a25f62a",
                        "source_sense_id": "981f1d4c-dd45-32de-be4f-8ab82eb8baf9",
                        "target_lang_word": "Dreidel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreidel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d895c9b-5c13-3342-8149-a395fe2fd71e",
                                        "entry_id": "651f09c3-b7fb-381e-87ab-9cd74b595cbe",
                                        "glosses": [
                                            "vierseitiger Kreisel mit hebräischen Buchstaben, der an Chanukka von jüdischen Kindern zum Spiel um Süßigkeiten verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16b9ec6-a297-4136-b728-69f9e28d0954",
                                                "sense_id": "0d895c9b-5c13-3342-8149-a395fe2fd71e",
                                                "text": "„Das ist doch eine Riesen-Marktlücke! Wir brauchen keine glitzernden Kugeln oder Lametta dafür, aber Dreidel in allen möglichen Formen und Farben. Und welche zum Selbermachen!“"
                                            },
                                            {
                                                "example_id": "351b7969-fd3a-4fad-b77d-835c92d99b80",
                                                "sense_id": "0d895c9b-5c13-3342-8149-a395fe2fd71e",
                                                "text": "„Zum ersten Mal beim Nikolausmarkt dabei war an diesem Wochenende Helmut Vautz aus Hücheln. Der gelernte Metallarbeiter bot an seinem Stand selbstgedrechselte Holzschüsseln, Salz- und Pfefferstreuer, Dreidel, Flaschenöffner und liebevoll bearbeitete Schneemänner und Engel aus Holz an, die bei den begeisterten Besuchern bestens ankamen.“"
                                            },
                                            {
                                                "example_id": "81b24bf4-50d4-4d0c-b4cd-e5ccc7191ec8",
                                                "sense_id": "0d895c9b-5c13-3342-8149-a395fe2fd71e",
                                                "text": "„Der Einladung, das Fest spielerisch kennenzulernen, folgten nur wenige Kinder, dafür aber auch Heranwachsende und Erwachsene. Sie zeigten sich sehr wissbegierig bei einem museumspädagogischen Begleitprogramm und hatten ihre helle Freude am Spiel mit dem Dreidel, dem für Chanukka typischen Kreiselspiel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
