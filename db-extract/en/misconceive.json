                "senses": [
                    {
                        "sense_id": "eabca8e4-5280-32bb-9986-d767ee01af39",
                        "entry_id": "9b7ac7dc-5935-3466-83aa-4813a42159d4",
                        "glosses": [
                            "To misunderstand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b8a0437-808d-42ba-986f-d27ef588ae5c",
                                "sense_id": "eabca8e4-5280-32bb-9986-d767ee01af39",
                                "text": "1694, William Congreve, The Double-Dealer\nNay, misconceive me not, madam, when I say I have had a gen'rous and a faithful passion, which you had never favoured, but through revenge and policy."
                            }
                        ]
                    },
                    {
                        "sense_id": "db2b2ea0-f187-3939-8117-2b440c8e970b",
                        "entry_id": "9b7ac7dc-5935-3466-83aa-4813a42159d4",
                        "glosses": [
                            "To judge or plan badly, typically on the basis of faulty misunderstanding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1162f86-245c-41b9-b3b6-fc5cb67dc39e",
                                "sense_id": "db2b2ea0-f187-3939-8117-2b440c8e970b",
                                "text": "HS2 has never had that. It was missold, misnamed and misconceived. It was promoted as a piece of engineering, rather than as a vital part of the railway."
                            }
                        ]
                    }
                ],
