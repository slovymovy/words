                "senses": [
                    {
                        "sense_id": "f4d29da9-bdb9-39a9-95cf-21bf55c1755e",
                        "entry_id": "fed29e3d-99d9-3419-b9f6-c0ed247afb90",
                        "glosses": [
                            "Alerter de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09dbe757-0ccc-4f9c-8502-a54ded6ec96a",
                                "sense_id": "f4d29da9-bdb9-39a9-95cf-21bf55c1755e",
                                "text": "Le médecin doit simultanément organiser les secours, recueillir et transmettre les informations permettant au PECC de dimensionner les moyens sanitaires à engager éventuellement, sinon à préalerter les vecteurs d’évacuation."
                            },
                            {
                                "example_id": "955a73c3-ef33-42ac-9fb5-58c6033c4c2b",
                                "sense_id": "f4d29da9-bdb9-39a9-95cf-21bf55c1755e",
                                "text": "J’imagine que tu n’as pas agi sur un coup de tête. Que tu as dû mûrement réfléchir aux conséquences. Que peut-être même tu as dû préalerter ton compagnon de tes craintes puis de ta déception ?"
                            }
                        ]
                    }
