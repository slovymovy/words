                                                "sense_id": "4c4bc777-d375-30cc-9cf1-c2ad1ae4120f",
                                                "text": "Wir müssen die nächsten Monate überbrücken, bis Hans sein erstes Gehalt in der neuen Firma ausgezahlt bekommt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
