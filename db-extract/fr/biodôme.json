                        "glosses": [
                            "Bâtiment en forme de dôme abritant un écosystème miniature, en général faisant office de musée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77999175-a3cd-46bb-8e22-da3716a153bb",
                                "sense_id": "4cb2dbf7-e543-36f8-8d9a-463e54a36b38",
                                "text": "Le Biodôme n'expose pas des animaux, ni des plantes. Il expose des représentations d'écosystèmes ; écosystèmes qui sont eux-mêmes des concepts ou de simples représentations permettant de traiter du milieu naturel comme d'un système."
                            },
                            {
                                "example_id": "09c562f9-ca3b-4147-af1a-b29e5a59a87d",
                                "sense_id": "4cb2dbf7-e543-36f8-8d9a-463e54a36b38",
                                "text": "Lindsay Neville traversa le biodôme encombré d’Umeh Station et vit qu’on lui dégageait un passage."
                            }
                        ]
                    }
