                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5f7cad-e989-4451-b45f-ba5a51ff241a",
                                                "sense_id": "755196a6-e8ab-3373-a7ae-30c187c5ce82",
                                                "text": "R. Moskowitz charges cisgender readers to be as conscious and deliberate with our religious identities as transgender and gender non-conforming people are with theirs, arguing that holiness is only achieved through continuous and unrelenting struggle and change."
                                            },
                                            {
                                                "example_id": "e76812be-72d6-4e76-90b2-aa870b2d7391",
                                                "sense_id": "755196a6-e8ab-3373-a7ae-30c187c5ce82",
                                                "text": "“Through the Sacraments, God shares his holiness with us so that we, in turn, can make the world holier,” the conference says on its website."
                                            }
                                        ]
                                    }
