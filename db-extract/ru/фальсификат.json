                        ]
                    },
                    {
                        "translation_id": "411584c1-928a-4081-994a-06ce0d810d77",
                        "source_entry_id": "05acc167-bcee-3f98-8f42-4a73ff9c1d4e",
                        "source_sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                        "target_lang_word": "Fälschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fälschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das Fälschen, die Imitation eines Produktes unter Vortäuschung von dessen Authentizität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff60ecb4-b1c9-4cca-a159-cd42ff2dbf88",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "Die Fälschung von Banknoten ist ein Verbrechen."
                                            },
                                            {
                                                "example_id": "cc1b2bd3-8271-4399-8e22-4eb1d3b03f1c",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Es ging mit ihm immer mehr bergab, fünf oder sechs Jahre später beging er Fälschungen, für die er zu den Galeeren verurteilt wurde, wo er vor sechs oder sieben Jahren starb.“"
                                            },
                                            {
                                                "example_id": "7c21da85-b8a7-4513-a789-2a13d7c3eeca",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Doch bleibt die Möglichkeit einer Fälschung offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das gefälschte Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44853d19-b894-4b59-825a-ece998be4095",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "Die goldene Rolex-Uhr für fünfzig Dollar ist mit Sicherheit eine Fälschung, da das Original sehr viel teurer ist."
                                            },
                                            {
                                                "example_id": "aa16209d-21dd-4e6c-bbc7-d4efb49dc696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Sowohl vor als auch nach dieser Zeit wurden etliche Fälschungen produziert, die allesamt eine bessere Qualität als das Original aufweisen.“"
                                            },
                                            {
                                                "example_id": "8e7fc830-3a5e-4cb0-819b-2e9fbcb16696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Vielmehr hat Masaryk (flankiert von vielen Fachwissenschaftlern) endgültig nachgewiesen, dass die Handschriften eine Fälschung des berühmten Bibliothekars Václav Hanka waren.“"
                                            },
                                            {
                                                "example_id": "ee25d8b8-27fc-490a-a900-2daf7eb4cea9",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062ff22f-bdfb-4621-a4b6-c385cefc60f3",
                        "source_entry_id": "05acc167-bcee-3f98-8f42-4a73ff9c1d4e",
                        "source_sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                        "target_lang_word": "Falsifikat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falsifikat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                                        "entry_id": "57218b85-91b3-3e3d-ada7-e311d6e42d59",
                                        "glosses": [
                                            "Gegenstand, der ganz oder teilweise durch eine Fälschung entstanden ist, der also nicht das ist, was er zu sein scheint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5532ffd5-9f71-4b3d-813c-9ee840c97d63",
                                                "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                                                "text": "„Ein Goldring unbekannter Herkunft (…) mit älteren Runen in einem Oxforder Museum erwies sich jüngst als Falsifikat […].“"
                                            },
                                            {
                                                "example_id": "9dd34367-a876-43f8-a644-e58ee65fca75",
                                                "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                                                "text": "„Als die Masse glutrot kochte, goss er daraus gleich zwei Falsifikate.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbb9821-40fe-4fa7-8de3-c18ab6833f82",
                        "source_entry_id": "05acc167-bcee-3f98-8f42-4a73ff9c1d4e",
                        "source_sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                        "target_lang_word": "contrefaçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrefaçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be540743-2f8b-309e-a035-22f4ececf5d7",
                                        "entry_id": "f43cd892-3895-3572-be59-267fc7d13dac",
                                        "glosses": [
                                            "Copie, imitation, fabrication d’une chose au préjudice de son auteur, de son inventeur, de celui qui a le droit exclusif de la faire, de la fabriquer, de la vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f15d6d-bcf1-442f-a090-80ff696f00ee",
                                                "sense_id": "be540743-2f8b-309e-a035-22f4ececf5d7",
                                                "text": "Elle fut longtemps le siège d'imprimeries qui commencèrent par répandre en Europe les œuvres hardies des philosophes et des mécontents français, - et qui sont restées, sur certains points, des ateliers de contrefaçon pure et simple, qu'on aura bien de la peine à détruire."
                                            },
                                            {
                                                "example_id": "e0831f0d-104f-4865-a58e-3afdc51ad3bf",
                                                "sense_id": "be540743-2f8b-309e-a035-22f4ececf5d7",
                                                "text": "Être condamné pour contrefaçon."
                                            },
                                            {
                                                "example_id": "7e67b718-cd98-498b-8410-4c8005c594b8",
                                                "sense_id": "be540743-2f8b-309e-a035-22f4ececf5d7",
                                                "text": "Chose rare maintenant [Amsterdam] a une couleur à elle, un aspect particulier ; elle n’a pas pris la triste teinte de contrefaçon française de ses voisins de Belgique ; elle a encore des costumes, de vrais et sincères costumes nationaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d016a70-3c63-3e10-a659-124fad7db3bf",
                                        "entry_id": "f43cd892-3895-3572-be59-267fc7d13dac",
                                        "glosses": [
                                            "Chose contrefaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab018471-5471-4634-9ef9-76884cbc03f9",
                                                "sense_id": "5d016a70-3c63-3e10-a659-124fad7db3bf",
                                                "text": "C’est une contrefaçon."
                                            },
                                            {
                                                "example_id": "c175e7fb-2abb-4d96-a4aa-8ce6145802db",
                                                "sense_id": "5d016a70-3c63-3e10-a659-124fad7db3bf",
                                                "text": "Il y a plusieurs contrefaçons de cet ouvrage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
