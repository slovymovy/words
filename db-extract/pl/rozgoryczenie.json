                    {
                        "translation_id": "6d22c368-a547-418d-b7ac-e9c357503bf7",
                        "source_entry_id": "b4d58cf0-ddaa-3272-8a0a-da3eb26418ac",
                        "source_sense_id": "d79750f4-9fa3-3ffa-8460-10b0b15f1b8c",
