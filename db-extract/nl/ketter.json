                "senses": [
                    {
                        "sense_id": "4421ac1a-2380-355f-ae7e-9b993038e8eb",
                        "entry_id": "6bad9752-a919-3a6f-b3cb-65181e4aaf51",
                        "glosses": [
                            "iemand die vanwege afwijking van de katholieke leer tot misdadiger verklaard was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ff858f-ad99-45cc-b942-0ba0aa161144",
                                "sense_id": "4421ac1a-2380-355f-ae7e-9b993038e8eb",
                                "text": "De ketters werden op het marktplein levend verbrand."
                            },
                            {
                                "example_id": "940d02a8-1a28-489e-a626-eff80934746e",
                                "sense_id": "4421ac1a-2380-355f-ae7e-9b993038e8eb",
                                "text": "Doen andwerd ons vrouwe en sprachartoe\nsiet sprac si, mijn dochter hoe\nmijn sone anderwerf werd bespuet\nwie hem sijn pine werd vernvet\nvan ketteren ende van quaden cristinen",
                                "translation": "Toen antwoordde ons Vrouwe en sprak haar toe:\n„Ziet”, sprak zij, „mijn dochter, hoe\nmijn zoon andermaal bespuwd werd,\nwie hem zijn pijn door ketters en door slechte christenen vernieuwd werd."
                            }
                        ]
                    },
                    {
                        "sense_id": "da6403a7-dbe8-32c2-8114-2e713f1105c7",
                        "entry_id": "6bad9752-a919-3a6f-b3cb-65181e4aaf51",
                        "glosses": [
                            "aanhanger van een leerstelling, die in tegenspraak is met datgene wat een bepaalde geloofsgemeenschap beschouwt als de fundamentele geloofsleer"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aaacf3a-eed4-43bc-96b2-66aaea5b9e5e",
                        "source_entry_id": "6bad9752-a919-3a6f-b3cb-65181e4aaf51",
                        "source_sense_id": "4421ac1a-2380-355f-ae7e-9b993038e8eb",
                        "source_sense_description": "iemand die vanwege afwijking van de katholieke leer tot misdadiger verklaard was",
                        "target_lang_word": "Ketzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ketzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                        "entry_id": "49769190-0104-3031-867c-9a976eae95e5",
                                        "glosses": [
                                            "jemand, der kirchliche Dogmen und Glaubenslehren ablehnt und/oder öffentlich kritisiert"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85cbc3fe-f2e1-4b80-8f8f-2157c017fce4",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Aber bis ans Ende der Zeiten wird die Kirche auch auf der von ihr bewahrten und bewachten Reich-Gottes-Botschaft Jesu wie auf einem Pulverfaß sitzen, ständig in der Gefahr, sich selbst in die Luft zu sprengen. Und zu denen, die in der Kirche die Lunte an dieses Pulverfaß legen, gehören die Ketzer.“"
                                            },
                                            {
                                                "example_id": "63a8c6c6-52d6-4392-8b5a-6e4fcf2402aa",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Zu Wien, zu Madrid, ja zu Rom wurde der kühne und kluge Ketzer in Ehren gehalten, als das Haupt der großen Verbindung gegen das Haus Bourbon, und selbst zu Versailles war der Haß, den er einflößte, reichlich mit Bewunderung gemischt.“"
                                            },
                                            {
                                                "example_id": "3afa64f6-1e30-48fa-bbef-4764b9445854",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Vergeblich ließ Papst Martin V. 1425 einen neuen Kreuzzug gegen die Hussiten predigen. Niemand zeigte Muth und Eifer, gegen die siegreichen Ketzer anzukämpfen.“"
                                            },
                                            {
                                                "example_id": "c0aee941-97d1-4071-818e-c6d692d98fb0",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Schließlich wirft er die Frage auf, warum doch die Kirche so viele Jahrhunderte bestanden habe, ohne daß Ketzer verbrannt worden wären?“"
                                            },
                                            {
                                                "example_id": "3c7a27f5-42c8-4330-a7dc-145fbbafbd0a",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„In seinen Schriften sind Sätze, welche verdienen, daß deshalb 100.000 Ketzer verbrannt würden, und wenn man übrigens Luthers Sitten rühmt, so darf man nicht vergessen: daß der Teufel am liebsten durch Täuschungen solcher Art verführt.“"
                                            },
                                            {
                                                "example_id": "590b5e1e-dcfe-4b34-b72f-5e804da2167a",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Darum sind’s wirklich grobe Eselsköpfe, dass sie den einen Ketzer schelten, der wider der Kirche Gebräuche handelt.“"
                                            },
                                            {
                                                "example_id": "c198d2fc-076d-410a-ad42-3d7511ac66ec",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„In Deutschland findet Johannes Kepler gute wissenschaftliche Gründe für die Gültigkeit des heliozentrischen Systems, welches das alte geozentrische (ptolemäische) Bild ablösen sollte. Gleichzeitig ergreift in Italien – zu dicht am Zentrum der Kirche – Galileo Galilei Partei für die revolutionären Gedanken und wird dafür als Ketzer gebrandmarkt.“"
                                            },
                                            {
                                                "example_id": "34ef8c92-3573-4ace-8b30-b84651f84e14",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Abendland am Beginn des 21. Jahrhunderts heißt eben auch Aufklärung, heißt nicht nur Thomas von Aquin, sondern auch Immanuel Kant, meint nicht nur die Heerschar der Heiligen, sondern genauso die Heerschar der Ketzer, die verbrannt wurden, weil sie die herrschende Meinung und die Meinung der Herrschenden nicht teilten.“"
                                            },
                                            {
                                                "example_id": "1feda87f-21e0-42bd-8f79-0393fd4b5a88",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "„Erretten willst du die polnischen Herrn?",
                                                "translation": "O schütze nicht stolze Ketzer, mein Sohn!“"
                                            },
                                            {
                                                "example_id": "7ed09ee6-3e18-45a2-9061-3a988371a7a8",
                                                "sense_id": "bdf72b73-9ec2-311d-bd02-4ff89443027c",
                                                "text": "Giordano Bruno wurde am 17. Februar 1600 als Ketzer verbrannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42c2965c-d5e2-3ce4-8222-a4c9eab64cb1",
                                        "entry_id": "49769190-0104-3031-867c-9a976eae95e5",
                                        "glosses": [
                                            "jemand, der öffentlich eine Ansicht zu einem bestimmten Thema vertritt, die der überwiegenden Meinung widerspricht"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1083c345-2de0-4aa6-85ec-be46f864249a",
                                                "sense_id": "42c2965c-d5e2-3ce4-8222-a4c9eab64cb1",
                                                "text": "„Im Gegenzug werden die Ketzer einer Klimakatastrophe beschuldigt, von Energiekonzernen und reaktionären Gruppen finanziert und manipuliert zu werden.“"
                                            },
                                            {
                                                "example_id": "e7dc927a-f1fd-4dec-887c-b622b0d4556b",
                                                "sense_id": "42c2965c-d5e2-3ce4-8222-a4c9eab64cb1",
                                                "text": "„Ein Ketzer ist Georg K. Glaser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16b93afd-540e-3ace-8b97-8f55c6f7be12",
                                        "entry_id": "49769190-0104-3031-867c-9a976eae95e5",
                                        "glosses": [
                                            "Fälscher"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce3ff19-14ac-4ce6-9977-9dd8d245d254",
                                                "sense_id": "16b93afd-540e-3ace-8b97-8f55c6f7be12",
                                                "text": "„Wenn der Ketzer nach der Aufdeckung des Irrtums nicht unmittelbar umkehren und der Ketzerei abschwören will, muss er umgehend verbrannt werden, wenn er ein Laie ist. Die Fälscher des Geldes nämlich werden sofort dem Tod übergeben, um wieviel mehr die Fälscher des Glaubens!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "abd022f6-4d09-3080-b446-377c99821dbc",
                                        "entry_id": "49769190-0104-3031-867c-9a976eae95e5",
                                        "glosses": [
                                            "frevelhafter, sittenloser, lüsterner Mensch"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9a59d5-315e-45e5-bba9-5148d458cb9c",
                                                "sense_id": "abd022f6-4d09-3080-b446-377c99821dbc",
                                                "text": "„Jedoch sagt er von keinem, daß er ein schwangere Hur, ein Kindbetterin, ein Teuffels-Verbünder, ein nach dem Contraët vom Teuffel gehohlter, ein überwiesener und von ganzen Conciliis verdammter Ketzer, Sodomit, Zauberer, Dieb, gewesen, das seynd nichts anders als erzgrobe Lästerungen eines unverschämten praedicantischen SchmähMauls.“ (1742)"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
