                            {
                                "example_id": "6e2da562-ff49-48e1-be6a-12af498cfc1f",
                                "sense_id": "2b51f89a-dcaa-3c09-8a34-a597c70d9468",
                                "text": "Mam na imię Ligia i studiuję filologię klasyczną na Wydziale Filologicznym Uniwersytetu Łódzkiego."
                            },
                            {
                                "example_id": "d58b5af5-b40d-4178-8e5a-bdeecaf03818",
                                "sense_id": "2b51f89a-dcaa-3c09-8a34-a597c70d9468",
                                "text": "11 sierpnia przypadają imieniny Ligii."
                            },
                            {
                                "example_id": "1db6bb51-6611-4a29-b3b7-79cc332198f3",
                                "sense_id": "2b51f89a-dcaa-3c09-8a34-a597c70d9468",
                                "text": "Pani Ligio, proszę nas jutro odwiedzić."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
