                "senses": [
                    {
                        "sense_id": "6b0d5ff1-7186-3a2d-93a8-94a147dceb14",
                        "entry_id": "720098bc-7870-3da7-a474-8d79d070cfdc",
                        "glosses": [
                            "Subjekt, das im Satz zwar formal vorhanden ist, aber auf nichts außerhalb des Satzes, in der außersprachlichen Wirklichkeit, verweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73f5c2f-0736-44d8-a1c7-c3a59abfd66e",
                                "sense_id": "6b0d5ff1-7186-3a2d-93a8-94a147dceb14",
                                "text": "Anders als andere Subjekte beziehen sich Scheinsubjekte auf nichts außerhalb des Satzes: In dem Satz \"Es schneit\" ist es ein Scheinsubjekt, für das man niemand und nichts als handelndes Subjekt benennen kann. Scheinsubjekte haben im Deutschen auch nicht den Status eines Satzgliedes, da man sie durch nichts anderes – außer eventuell das Pronomen das – ersetzen kann."
                            },
                            {
                                "example_id": "92ee4e45-c82e-4a49-89e4-22f5e1e0c3c1",
                                "sense_id": "6b0d5ff1-7186-3a2d-93a8-94a147dceb14",
                                "text": "Auch in dem Satz \"Es geht mir gut.\" ist es ein Scheinsubjekt."
                            },
                            {
                                "example_id": "a4cf3e21-a9dd-4b8c-8252-f3a57ac93574",
                                "sense_id": "6b0d5ff1-7186-3a2d-93a8-94a147dceb14",
                                "text": "„Mit Hilfe des Scheinsubjekts es können zahlreiche andere Verben auch unpersönlich, das heißt als okkasionelle Ereignisverben gebraucht werden…“"
                            },
                            {
                                "example_id": "0e713cf1-bb3b-43a9-9123-4af840186647",
                                "sense_id": "6b0d5ff1-7186-3a2d-93a8-94a147dceb14",
                                "text": "„Das Scheinsubjekt es stellt ein Zwischending zwischen Satzglied und Nichtsatzglied dar, weil es nicht ersetzbar, aber verschiebbar ist…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
