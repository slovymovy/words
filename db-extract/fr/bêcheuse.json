            {
                "entry_id": "a8a76603-b14b-3518-b14d-0cc1ef5a6f81",
                "word": "bêcheuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0c022ac8-2c9b-421a-81d5-91ad2dc4a8a6",
                        "entry_id": "a8a76603-b14b-3518-b14d-0cc1ef5a6f81",
                        "tags": [
                            "plural"
                        ],
                        "form": "bêcheuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a5c10b7-ba76-3364-ab75-c583b466a328",
                        "entry_id": "a8a76603-b14b-3518-b14d-0cc1ef5a6f81",
                        "glosses": [
                            "Celle qui bêche, qui retourne la terre d’un jardin à l’aide d’une bêche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77c9040f-6424-3cfe-a634-618f2357c24c",
                        "entry_id": "a8a76603-b14b-3518-b14d-0cc1ef5a6f81",
                        "glosses": [
                            "Celle qui bêche, qui dit du mal des autres."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "17372fe0-a6b0-3a51-a427-26104cd3733f",
                        "entry_id": "a8a76603-b14b-3518-b14d-0cc1ef5a6f81",
                        "glosses": [
                            "Celle qui est prétentieuse et snob."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "aec130b6-528d-4364-97a7-2f4bc86ec1ac",
                                "sense_id": "17372fe0-a6b0-3a51-a427-26104cd3733f",
                                "text": "Dans ce milieu d’introvertis exubérants, elle faisait figure de grande fille pas bêcheuse mais secrète, sans états d’âme particuliers, […]."
                            },
                            {
                                "example_id": "10f98371-b199-4784-9ee8-cdafa945f872",
                                "sense_id": "17372fe0-a6b0-3a51-a427-26104cd3733f",
                                "text": "Quelle consolation de voir qu’on n’est pas tout seul, que tout vieillit autour de soi.\nSurtout les filles, les très belles, celles qu’on appelait « les bêcheuses ». Celles qui passaient, arrogantes, dans leur Floride décapotée, sans me regarder. Elles ne voulaient pas monter dans ma 2 CV."
                            },
                            {
                                "example_id": "dd672a3f-a2a5-4293-8b35-65f6b787ceea",
                                "sense_id": "17372fe0-a6b0-3a51-a427-26104cd3733f",
                                "text": "À treize ans, Hélène est une petite bêcheuse."
                            },
                            {
                                "example_id": "e9a8480c-b4f5-4ae8-961e-813360295313",
                                "sense_id": "17372fe0-a6b0-3a51-a427-26104cd3733f",
                                "text": "Une p'tite bourgeoise bêcheuse, maquillée comme un carré d'as."
                            }
                        ]
                    }
                ],
