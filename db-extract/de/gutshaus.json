                ],
                "senses": [
                    {
                        "sense_id": "4bdaf804-4e91-3f3b-bd34-4d53e856df88",
                        "entry_id": "88958ae2-d1bb-3fc7-8b49-6d84714252fc",
                        "glosses": [
                            "Haus des Gutsbesitzers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e5b5f03-cef4-4296-9b22-7e98872f9a60",
                                "sense_id": "4bdaf804-4e91-3f3b-bd34-4d53e856df88",
                                "text": "„Im Gutshaus dagegen ist seit 1920 eine Zentralheizung in Betrieb, mit einem großen Ofen im Keller.“"
                            },
                            {
                                "example_id": "50d0063b-55f0-4418-9f8f-ff559dcdab0a",
                                "sense_id": "4bdaf804-4e91-3f3b-bd34-4d53e856df88",
                                "text": "„Der Auerhof bestand aus einem Gutshaus, das nah am Rhein lag, und einem weitläufigen, Äcker, Wiesen, Weingärten und Stallungen umfassenden Areal.“"
                            },
                            {
                                "example_id": "239ad707-c826-462d-8e46-e2aa57de8079",
                                "sense_id": "4bdaf804-4e91-3f3b-bd34-4d53e856df88",
                                "text": "„Während wir durch das Parktor rollen, unter dem dichten Schirm uralter Linden aufs Gutshaus zu, entfaltet sich, in einem Anhauch von Wind, hoch über dem Dach die alte Wappenfahne der Krockows.“"
                            },
                            {
                                "example_id": "b2431f77-ac9c-4fff-8059-c9780301403d",
                                "sense_id": "4bdaf804-4e91-3f3b-bd34-4d53e856df88",
                                "text": "„Der nächste Beutezug führte sie zu einem stattlichen Gutshaus mit kleinen Türmen und hohen Fenstern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
