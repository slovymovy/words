                            {
                                "example_id": "5347796f-f9d7-437c-9be0-c920ae37650c",
                                "sense_id": "67e4764b-24b2-3bfe-a0c8-b4d81aedec52",
                                "text": "Mensen uitschelden die jou uitschelden is van alle tijden, een klassieker, ik vond het zelfs wel iets nostalgisch hebben. Het echte probleem was dat die schelders werkelijk jaloers leken op Ribéry en zijn bordje krankzinnigheid. Bijna niemand moest er om lachen."
                            },
                            {
                                "example_id": "214f6852-87d0-4977-b880-450cdd9ae0d6",
                                "sense_id": "67e4764b-24b2-3bfe-a0c8-b4d81aedec52",
                                "text": "Rutte meent dat het incident vooral terugslaat op de PVV-voorman. \"Als iemand u uitscheldt, dan is dat toch het probleem van de schelder?\""
                            }
                        ]
                    }
