                        "cross_references": [
                            {
                                "target_word": "yellow press",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d816fab1-cf4a-331f-86ec-9bcfdef03995",
                                        "entry_id": "5f3f7735-8213-37c1-8282-4b869978e266",
                                        "glosses": [
                                            "Newspapers which publish sensationalist articles rather than well researched and sober journalism."
                                        ],
                                        "tags": [
                                            "collective",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179b4d47-0858-4413-b5a7-4b5329ff4e1e",
                                                "sense_id": "d816fab1-cf4a-331f-86ec-9bcfdef03995",
                                                "text": "Near-synonyms: tabloids, gutter press"
                                            },
                                            {
                                                "example_id": "f287650a-03e1-4ee6-a471-ef6966fb05cb",
                                                "sense_id": "d816fab1-cf4a-331f-86ec-9bcfdef03995",
                                                "text": "The Olivette incident has often been cited as emblematic of the distortions published by Hearst and the rest of the yellow press during the Cuban revolution, but it seems to have been founded in an honest mistake."
                                            }
                                        ]
                                    }
                                ]
                            }
