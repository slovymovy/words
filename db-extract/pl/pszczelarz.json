                        ]
                    },
                    {
                        "translation_id": "278dfde1-26e7-430a-9e19-d862d3d995eb",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "Imker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                        "entry_id": "c9839a3a-e27f-3a25-85be-0fe93934ba31",
                                        "glosses": [
                                            "Person, die sich beruflich oder nebenberuflich mit Honiggewinnung und/oder der Zucht und Aufzucht von Bienenköniginnen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064f974f-9f24-4c43-ae41-1eebe9c1c8fb",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "Der Imker schleudert den Honig aus den Bienenwaben."
                                            },
                                            {
                                                "example_id": "2049df2d-c5b9-4241-af02-c023e7b7a32f",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "„Maschmann begann 1947 mit der Bienenzucht, weil die britischen Soldaten für jeden Imker zum Füttern zwei Pfund Zucker extra freigaben.“"
                                            },
                                            {
                                                "example_id": "be780cbd-4012-499d-a0e9-2978c0f9bae8",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "„Das Aus- und Einfliegen der Bienen ist doch anders als in lebendigen Stöcken, und dem Imker fällt es auf, dass der Geruch und die Geräusche doch nicht die gleichen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0bf0b16-392c-4ba8-b5e8-5c024cd8888f",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "Bienenzüchter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bienenzüchter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a0d0fc1-4cb6-31ef-a26c-255b3a717d10",
                                        "entry_id": "6731746d-d0b1-3b5d-a98a-c42538a8b2c8",
                                        "glosses": [
                                            "Person, die sich beruflich mit der Zucht von Bienen, gegebenenfalls auch nur von Bienenköniginnen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0e3f5d-ecdc-4177-8cc1-c85387c3adb7",
                                                "sense_id": "1a0d0fc1-4cb6-31ef-a26c-255b3a717d10",
                                                "text": "Die Bienenzüchter klagen über das schlechte Wetter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "343d3386-3126-444e-86c3-0cfd101d1ef9",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "пчеловод",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пчеловод",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a5b7b468-50a4-398f-96f5-d6cafd47fe82",
                                        "entry_id": "d8b71999-bba2-3d9b-8c09-7053c44af9a3",
                                        "glosses": [
                                            "тот, кто занимается пчеловодством; специалист занимающийся содержанием и разведением пчёл"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3faa78c6-417a-49e5-8d7b-3b0241e207ae",
                                                "sense_id": "a5b7b468-50a4-398f-96f5-d6cafd47fe82",
                                                "text": "Пчеловод, замечая, что пчела собирает цветочную пыль к приносит её в улей, говорит, что цель пчелы состоит в собирании мёда."
                                            },
                                            {
                                                "example_id": "2ea45a2c-4ce2-45c5-8bb0-ef50f2b5506d",
                                                "sense_id": "a5b7b468-50a4-398f-96f5-d6cafd47fe82",
                                                "text": "Староста поспешил сказать, что его прислала барыня, что она просит Трифона прийти посмотреть пасеку, что ихний пасечник старый, глухой дурак, а что он, Трифон, может, первый пчеловод во всей губернии по своему уму и понятию, — и немедля вытащил из одного кармана штанов бутылку водки, а из другого сало в шершавой серой бумаге, уже насквозь промаслившейся."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4549b4d3-4064-4c3c-b7ff-da05ae118ca6",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "пасечник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пасечник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e992839a-01e6-332e-8480-f829fe029040",
                                        "entry_id": "4eb0a603-ef66-3a3e-8e4c-c4b2047deabe",
                                        "glosses": [
                                            "тот, кто разводит пчёл, содержа пасеку или работая на ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8ba10d-4c57-472f-be06-1911c4d75c27",
                                                "sense_id": "e992839a-01e6-332e-8480-f829fe029040",
                                                "text": "Упрямый улей коричневой губкой висит на ветке, а странный пасечник с Тверского бульвара всё трясёт и трясёт своё дерево и подставляет пчёлам кошелку."
                                            },
                                            {
                                                "example_id": "27884c03-f0e8-4858-9191-a437d1502322",
                                                "sense_id": "e992839a-01e6-332e-8480-f829fe029040",
                                                "text": "Вынуть мёд из улья может только пасечник, любого другого пчёлы закусают до смерти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
