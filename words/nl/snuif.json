    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca52e15c-4763-348f-84e2-a9d529a06de9",
                    "sense_definition": "Een hele kleine hoeveelheid van een poeder of stof.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voeg een <w>snuif</w> zout toe aan de soep voor meer smaak. ",
                            "target_lang_translations": {
                                "fr": "Ajoutez une <w>pincée</w> de sel à la soupe pour plus de saveur."
                            }
                        },
                        {
                            "text": "Een <w>snuif</w> kaneel maakt het recept helemaal af.",
                            "target_lang_translations": {
                                "fr": "Une <w>pincée</w> de cannelle complète parfaitement la recette."
                            }
                        }
                    ],
                    "synonyms": [
                        "vleugje",
                        "snufje"
                    ],
                    "common_phrases": [
                        "een snuif zout"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une très petite quantité d'une poudre ou d'une substance."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pincée",
                                "target_lang_sense_clarification": "pour les ingrédients en poudre comme le sel ou les épices"
                            },
                            {
                                "target_lang_word": "soupçon",
                                "target_lang_sense_clarification": "une très petite quantité, une touche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e551b47c-e945-39e3-a635-09240f5fa309",
                    "sense_definition": "Fijngemalen tabak die door de neus wordt opgesnoven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man nam een <w>snuif</w> uit zijn tabaksdoos. ",
                            "target_lang_translations": {
                                "fr": "Le vieil homme a pris une <w>prise</w> dans sa tabatière."
                            }
                        },
                        {
                            "text": "Hij hield niet van roken, maar nam liever een <w>snuif</w>.",
                            "target_lang_translations": {
                                "fr": "Il n'aimait pas fumer, mais préférait prendre une <w>prise</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuiftabak"
                    ],
                    "common_phrases": [
                        "een snuif nemen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tabac finement moulu destiné à être pris par le nez."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "prise",
                                "target_lang_sense_clarification": "une quantité de tabac à priser"
                            },
                            {
                                "target_lang_word": "tabac à priser",
                                "target_lang_sense_clarification": "la substance elle-même"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "328948ef-4a3a-367b-b951-584b1ca704d3",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>snuiven</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>snuif</w> de frisse zeelucht diep in. ",
                            "target_lang_translations": {
                                "fr": "J'<w>inspire</w> profondément l'air frais de la mer."
                            }
                        },
                        {
                            "text": "Als ik verkouden ben, <w>snuif</w> ik vaak even.",
                            "target_lang_translations": {
                                "fr": "Quand j'ai un rhume, je <w>renifle</w> souvent."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik snuif"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent de l'indicatif du verbe 'snuiven' (renifler, inspirer)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "renifle",
                                "target_lang_sense_clarification": "aspirer de l'air par le nez"
                            },
                            {
                                "target_lang_word": "respire",
                                "target_lang_sense_clarification": "aspirer profondément une odeur ou de l'air"
                            }
                        ]
                    }
                }
            ]
        }
    ]
