                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "71d464f7-2e64-4d13-a3e7-33e98554acac",
                                "sense_id": "66ca1468-a8d5-38c1-a068-93910aca62b8",
                                "text": "Zaszedłem, ot tak sobie, do Jolki."
                            },
                            {
                                "example_id": "8dbe4861-9aa8-42ad-b856-b146f650f728",
                                "sense_id": "66ca1468-a8d5-38c1-a068-93910aca62b8",
                                "text": "Jolka z Waldkiem żyją na kocią łapę, mówią, że papierek do niczego nie jest im potrzebny."
                            },
                            {
                                "example_id": "897139ec-b163-4e61-9132-56c5a35e06a8",
                                "sense_id": "66ca1468-a8d5-38c1-a068-93910aca62b8",
                                "text": "Moja ostatnia randka z Jolką to był straszny niewypał."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
