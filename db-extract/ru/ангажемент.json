                "senses": [
                    {
                        "sense_id": "a12f513c-76a4-34c5-8aaa-fe8b846405e3",
                        "entry_id": "60d82dac-857f-307c-93a6-b1ba5ecd4f67",
                        "glosses": [
                            "театр. приглашение артиста, труппы, фотомодели и т. п. на определённый срок участвовать в спектаклях или концертах, шоу и т. п., занятость артистов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cbafd52-39d2-4b53-888a-535abe6b9da1",
                                "sense_id": "a12f513c-76a4-34c5-8aaa-fe8b846405e3",
                                "text": "Но Ира не слишком утомила себя игрой, она неприкрыто ждала ангажемента без всяких экивоков, и эта гибельная поза на мокрой ступеньке, как на краешке обрыва, ямочка от ветрянки на скуле, поникший бархат туфель, облепивших коренастые круглые ступни, — все это почему-то так возбудило, аж подбросило."
                            },
                            {
                                "example_id": "356397e5-5828-45ba-8c50-865210d0b3ad",
                                "sense_id": "a12f513c-76a4-34c5-8aaa-fe8b846405e3",
                                "text": "Это и номинации в конкурсах красоты, и обилие ангажемента на рекламные сессии, и участие в самых крутых ТВ-проектах."
                            }
                        ]
                    },
                    {
                        "sense_id": "782cd652-23b5-31a3-b914-f702cbbc00e4",
                        "entry_id": "60d82dac-857f-307c-93a6-b1ba5ecd4f67",
                        "glosses": [
                            "юр. соглашение, договор о таком приглашении; также срок такого соглашения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fda340-db48-45f4-8835-440a6f498745",
                                "sense_id": "782cd652-23b5-31a3-b914-f702cbbc00e4",
                                "text": "Рядовые гастролёрши, отклонив домогательства импресарио, рискуют остаться без продления ангажемента."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "971e73ba-e0c2-4eaf-b8e1-81fc7197b866",
                        "source_entry_id": "60d82dac-857f-307c-93a6-b1ba5ecd4f67",
                        "target_lang_word": "engagement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engagement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f58ad0d-b1bc-34f8-8b28-1f119262ae6d",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "An appointment, especially to speak or perform."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0f696ee-bb78-41b5-ae01-6213b8122490",
                                                "sense_id": "6f58ad0d-b1bc-34f8-8b28-1f119262ae6d",
                                                "text": "The lecturer has three speaking engagements this week."
                                            },
                                            {
                                                "example_id": "8eb171a1-76d5-4142-8443-8bde44bd228d",
                                                "sense_id": "6f58ad0d-b1bc-34f8-8b28-1f119262ae6d",
                                                "text": "prior engagement"
                                            },
                                            {
                                                "example_id": "48454ce5-90ca-4f9b-bc14-345d8d134090",
                                                "sense_id": "6f58ad0d-b1bc-34f8-8b28-1f119262ae6d",
                                                "text": "a future engagement"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7dcbbd9-15ae-3fbd-a3ff-5b3ed55865b2",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "Connection or attachment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399fc291-60c0-4f21-970a-173f5ff37781",
                                                "sense_id": "d7dcbbd9-15ae-3fbd-a3ff-5b3ed55865b2",
                                                "text": "Check the gears for full engagement before turning the handle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76da4b33-bcc0-3f74-891a-a39aa0d8af50",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "The feeling of being compelled, drawn in, connected to what is happening, interested in what will happen next."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e9ebdc-45b2-4674-b0c1-b89139dbcaa8",
                                                "sense_id": "76da4b33-bcc0-3f74-891a-a39aa0d8af50",
                                                "text": "In a recent study with a movie recommendation site […], higher message interactivity in the form of footprints of user actions, responsive suggestions in a search box, and live-chatting with an online agent led to greater perceived contingency and engagement with the site, which ultimately created more positive attitudes toward it and higher intention to recommend the site to others."
                                            },
                                            {
                                                "example_id": "166497ad-0406-4a97-bcb8-5165dff4520b",
                                                "sense_id": "76da4b33-bcc0-3f74-891a-a39aa0d8af50",
                                                "text": "Mr. Yudkowsky said OpenAI might have primed ChatGPT to entertain the delusions of users by optimizing its chatbot for “engagement” — creating conversations that keep a user hooked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce9f773d-aab6-3c77-ae38-c49864878112",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "The period of time when marriage is planned or promised."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9bffd4c-1b3b-436a-a56f-f0268ea2cc98",
                                                "sense_id": "ce9f773d-aab6-3c77-ae38-c49864878112",
                                                "text": "We are enjoying a long engagement, but haven't yet set a date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d27b08-99f9-3c93-897f-7e7a3696f7f5",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "In any situation of conflict, an actual instance of active hostilities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1313d3e-1e6f-4b3b-b27e-413dadf1eba6",
                                                "sense_id": "49d27b08-99f9-3c93-897f-7e7a3696f7f5",
                                                "text": "The engagement resulted in many casualties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3506b79b-4f9b-34b1-a08b-6285bc31446f",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "The point at which the fencers are close enough to join blades, or to make an effective attack during an encounter."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec00903b-c946-4633-9f24-b3330e326cc2",
                                                "sense_id": "3506b79b-4f9b-34b1-a08b-6285bc31446f",
                                                "text": "After engagement it quickly became clear which of the fencers was going to prevail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0b5dc6-a14e-3798-ba9e-a8e27caf9f85",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "A performance metric representing an instance where a user interacts with some content after an impression."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8271978f-a16b-3972-add1-b5b5eadfac67",
                                        "entry_id": "4cbe99ea-7a75-355a-a701-1d28ce5d843d",
                                        "glosses": [
                                            "A performance metric representing an instance where a user interacts with some content after an impression.",
                                            "The quantitative response to a piece of content; attention."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e964db2c-6f44-4b4b-86d6-87253074da82",
                                                "sense_id": "8271978f-a16b-3972-add1-b5b5eadfac67",
                                                "text": "A new peer-reviewed study from researchers at New York University and the Université Grenoble Alpes in France will show that misinformation got six times as much engagement on Facebook as real news, The Washington Post reports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
