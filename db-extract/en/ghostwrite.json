                    {
                        "sense_id": "17d6d3be-e509-3322-b238-4833db425cfe",
                        "entry_id": "a788fdaf-eab3-3241-8158-991d855d2aab",
                        "glosses": [
                            "To write under the name of another (especially literary works)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a554f57-4c35-4678-a1ba-acc0693e42c7",
                                "sense_id": "17d6d3be-e509-3322-b238-4833db425cfe",
                                "text": "Mariana would rather not ghostwrite for a living because she finds it a thankless task."
                            }
                        ]
                    },
                    {
                        "sense_id": "1254e0f1-324a-3d9c-9d23-fc19ffa178e8",
                        "entry_id": "a788fdaf-eab3-3241-8158-991d855d2aab",
                        "glosses": [
                            "To author a literary work or speech in the place of another."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "811c36f3-cd02-4a2d-a85d-5bd19d1a73be",
                                "sense_id": "1254e0f1-324a-3d9c-9d23-fc19ffa178e8",
                                "text": "The president has someone to ghostwrite his addresses."
                            },
                            {
                                "example_id": "ef3f6509-a668-439e-9b50-2bc189ebcb7a",
                                "sense_id": "1254e0f1-324a-3d9c-9d23-fc19ffa178e8",
                                "text": "Before I read her book, I wondered if it had been ghostwritten, like many such books."
                            }
                        ]
                    }
