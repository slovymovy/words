                "senses": [
                    {
                        "sense_id": "77cb89e9-b510-3080-8dfc-f803304cac50",
                        "entry_id": "b5821d18-5458-3b01-af7c-65b1c7e53343",
                        "glosses": [
                            "Kopfputz mit Haarkrönchen, oftmals bei Hochzeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f454c0b-1ce1-4e34-9fb4-0bd21ba0d614",
                                "sense_id": "77cb89e9-b510-3080-8dfc-f803304cac50",
                                "text": "Elisabeth trug einen schönen Schnatz auf ihrer Hochzeit.",
                                "translation": "[*] „Es gibt jedoch mehrere deutsche Übersetzungen der ‚Agonie in acht Krämpfen‘, darunter Die Jagd nach dem Schnark von Klaus Reichert (Insel-Bücherei 934), die Reclam-Ausgabe Die Jagd nach dem Schnatz von Oliver Sturm und Die Jagd nach dem Schlarg von Michael Ende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "035a3a0c-5bca-4ef5-9fff-e2132a924c17",
                        "source_entry_id": "b5821d18-5458-3b01-af7c-65b1c7e53343",
                        "source_sense_id": "77cb89e9-b510-3080-8dfc-f803304cac50",
                        "source_sense_description": "Kopfputz mit Haarkrönchen, oftmals bei Hochzeiten",
                        "target_lang_word": "chignon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chignon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                        "entry_id": "bdd8a135-d383-3a31-945a-b49941d0b469",
                                        "glosses": [
                                            "A roll or twist of hair worn at the nape of the neck; a bun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13aed2eb-1a1f-4e9a-ad03-c1512b1d5b64",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "The chignon cannot be confounded with other artificialities which ladies put on and off."
                                            },
                                            {
                                                "example_id": "967cc9ee-bc5b-4c8d-be36-aad85d14fbd8",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "Madame du Barry could not merely be credited with inventing the chignons which bear her name."
                                            },
                                            {
                                                "example_id": "e94d5193-5b8d-4c4d-a521-cb5811f807ba",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "If I close my eyes I can see Marie today as I saw her then. Round, rosy face, snub nose, dark hair piled up in a chignon."
                                            },
                                            {
                                                "example_id": "c7497ce1-b9d6-4145-9666-9d1ee0baf4c2",
                                                "sense_id": "c27862c9-0e90-35eb-b2e8-2f6a928342fe",
                                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1d0384-fae4-3c47-b29f-88734409effb",
                                        "entry_id": "bdd8a135-d383-3a31-945a-b49941d0b469",
                                        "glosses": [
                                            "A temporary swelling on a neonate's head after a ventouse-assisted delivery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
