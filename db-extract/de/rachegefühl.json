                "senses": [
                    {
                        "sense_id": "beb8a24e-e416-3275-9da2-0feccee136d2",
                        "entry_id": "b19e9def-c554-3b32-8c63-89a4cb20e0d2",
                        "glosses": [
                            "Gefühl der Rache; innerer Drang, sich zu rächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de08954-65de-47fa-a1e3-5e229f018517",
                                "sense_id": "beb8a24e-e416-3275-9da2-0feccee136d2",
                                "text": "„Ich stellte sie mir, wenn schon nicht verliebt, so doch zumindest nachsichtig diesem Affen gegenüber vor, und dieser Gedanke erfüllte mich mit Rachegefühlen gegen sie.“"
                            },
                            {
                                "example_id": "68b04158-358e-42ca-a0f0-dcd2b2084f8d",
                                "sense_id": "beb8a24e-e416-3275-9da2-0feccee136d2",
                                "text": "„Wenn er jetzt hier wäre, würde ich nicht einen Augenblick zögern, ihn umzubringen, aber aus ganz persönlichen Rachegefühlen und nicht, fürchte ich, aus irgendeinem hochmoralischen Grund oder um meines Vaterlandes willen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
