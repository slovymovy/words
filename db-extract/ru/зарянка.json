                                            {
                                                "example_id": "d805bf98-5074-4037-b4cf-dea00d7851c9",
                                                "sense_id": "aa387d5f-b000-3727-a748-d3b749e7044a",
                                                "text": "C’était un rouge-gorge, un charmant rouge-gorge !\nComme à foison,\nLe froid, ce vieux brigand des forêts, en égorge\nChaque saison."
                                            },
                                            {
                                                "example_id": "f8a87106-506d-4b0b-85d6-fb8c2b89072b",
                                                "sense_id": "aa387d5f-b000-3727-a748-d3b749e7044a",
                                                "text": "On retourne chez les rouges-gorges tueurs."
                                            },
                                            {
                                                "example_id": "d5fe950d-79f0-417b-876c-37d75b83ffd6",
                                                "sense_id": "aa387d5f-b000-3727-a748-d3b749e7044a",
                                                "text": "Faune : serin cini, pic vert, pigeon ramier, moineau domestique, rouge-gorge, fauvette à tête noire, martinet noir, pinson des arbres, tourterelle turque, merle noir, rougequeue noir, rougequeue à front blanc, abeille domestique"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db813c37-962e-3333-b3df-9ce92e3e4a09",
                                        "entry_id": "81fb9715-d31e-3819-87fc-937d87d919f5",
                                        "glosses": [
                                            "Merle d’Amérique."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82033906-c0fb-4448-b0f2-00d73a3143df",
                                                "sense_id": "db813c37-962e-3333-b3df-9ce92e3e4a09",
                                                "text": "… comme niché dans les trèfles pour mourir en paix, on a trouvé un pauvre rouge-gorge assommé raide …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
