                        "glosses": [
                            "grupa ludzi sprawujących władzę w państwie, jakiejś organizacji, instytucji"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3cc7973d-9dff-4c2a-9fa4-50d85d329238",
                                "sense_id": "e8a83e50-4249-3b00-8430-4e2bdf488b1f",
                                "text": "Sejmowa wierchuszka przyznała sobie wielkie premie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25e746d1-6baa-4416-a744-906cbbed49da",
                        "source_entry_id": "d1c65953-3e85-37c7-910f-ef811e57396f",
                        "source_sense_id": "e8a83e50-4249-3b00-8430-4e2bdf488b1f",
                        "target_lang_word": "top brass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "top brass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc0c8b7-51fc-3ef9-adee-fde364cd646a",
                                        "entry_id": "9d0802cd-b075-3b88-a2e0-18dd828d15d1",
                                        "glosses": [
                                            "A group of people who are the leaders or heads of an organization."
                                        ],
                                        "tags": [
                                            "collective",
                                            "colloquial",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6bf3a52-ded1-4e0f-8b94-f998a423632c",
                                                "sense_id": "bbc0c8b7-51fc-3ef9-adee-fde364cd646a",
                                                "text": "The top brass of the army are up to various types of mischief and they do not want the public or even Members of Parliament to know about them."
                                            },
                                            {
                                                "example_id": "ecf8e545-3d50-47c7-87d0-b66556f5f33d",
                                                "sense_id": "bbc0c8b7-51fc-3ef9-adee-fde364cd646a",
                                                "text": "The general who turned the tide at Alamein was not, prior to his arrival in the Middle East, one of the very \"top brass\"; but he was a soldier, not a detergent manufacturer."
                                            },
                                            {
                                                "example_id": "603edd77-2020-4aa7-b642-047f3d94a9e4",
                                                "sense_id": "bbc0c8b7-51fc-3ef9-adee-fde364cd646a",
                                                "text": "On 3 January, Republican senator Rick Scott urged in a letter to Newsweek’s top brass to “reconsider its relationship with Vipp Jaswal”."
                                            },
                                            {
                                                "example_id": "321e2011-798d-4938-8929-0bce96c70698",
                                                "sense_id": "bbc0c8b7-51fc-3ef9-adee-fde364cd646a",
                                                "text": "The military's top brass were seen making the decision on Russian state TV, with Gen Surovikin reporting on the situation on the ground in Kherson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "506b854b-cb59-4043-8a74-4cf388e9df76",
                        "source_entry_id": "d1c65953-3e85-37c7-910f-ef811e57396f",
                        "source_sense_id": "e8a83e50-4249-3b00-8430-4e2bdf488b1f",
