                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f758f10-ad87-3d4c-8b88-16fc38515ff1",
                        "entry_id": "ec4c9c8b-86d2-379b-b946-34332a351002",
                        "glosses": [
                            "A shot on goal directly following another that has been saved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80592ea-a850-4368-891d-5e5f028bc378",
                                "sense_id": "3f758f10-ad87-3d4c-8b88-16fc38515ff1",
                                "text": "It could have been much worse for City before the break, but goalkeeper Joe Hart saved Jamie Mackie's long-range shot and Helguson's headed follow-up - although the latter was offside - before Bothroyd hit the post with another header."
                            }
                        ]
