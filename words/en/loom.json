{
    "word_family": [
        "heirloom",
        "handloom",
        "power-loom"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a71395d9-d5cf-3062-93b0-416a4e08cb59",
                    "sense_definition": "To appear in an impressively large or threatening way, or to be about to happen in a way that causes worry.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "appear-threateningly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With the deadline <w>looming</w> large, the team worked through the night to finish the project.",
                            "target_lang_translations": {
                                "ru": "Поскольку крайний срок уже <w>маячил</w> на горизонте, команда работала всю ночь, чтобы закончить проект."
                            }
                        },
                        {
                            "text": "Dark clouds began to <w>loom</w> over the valley, suggesting a heavy storm was on its way.",
                            "target_lang_translations": {
                                "ru": "Темные тучи начали <w>нависать</w> над долиной, предвещая сильную бурю."
                            }
                        }
                    ],
                    "synonyms": [
                        "threaten",
                        "impend",
                        "tower",
                        "overhang"
                    ],
                    "common_phrases": [
                        "loom large",
                        "deadline looming",
                        "crisis looming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появляться в виде внушительной или угрожающей фигуры, либо предстоять (о событии), вызывая тревогу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать",
                                "target_lang_sense_clarification": "об угрозе или событии"
                            },
                            {
                                "target_lang_word": "маячить",
                                "target_lang_sense_clarification": "о чем-то неприятном впереди"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "о приближающейся опасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f719d960-39b3-3427-917a-76f14ed92fe3",
                    "sense_definition": "To appear indistinctly or come into view as a vague, often large, shape.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appear-vaguely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A massive ship started to <w>loom</w> through the fog as we approached the harbor.",
                            "target_lang_translations": {
                                "ru": "Огромный корабль начал <w>вырисовываться</w> в тумане, когда мы приближались к гавани."
                            }
                        },
                        {
                            "text": "The mountain peaks <w>loom</w> out of the mist in the early morning light.",
                            "target_lang_translations": {
                                "ru": "Горные вершины <w>виднеются</w> из тумана в свете раннего утра."
                            }
                        }
                    ],
                    "synonyms": [
                        "emerge",
                        "appear"
                    ],
                    "antonyms": [
                        "vanish",
                        "disappear"
                    ],
                    "common_phrases": [
                        "loom through the fog",
                        "loom out of the mist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неясно вырисовываться или появляться в виде смутных, часто крупных очертаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виднеться",
                                "target_lang_sense_clarification": "неясно проступать"
                            },
                            {
                                "target_lang_word": "вырисовываться",
                                "target_lang_sense_clarification": "сквозь туман или мглу"
                            },
                            {
                                "target_lang_word": "проступать",
                                "target_lang_sense_clarification": "сквозь дымку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f92c8a10-9fc2-3eec-b3bc-c77cccf6c234",
                    "sense_definition": "To be seen as great, eminent, or morally elevated.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "elevated-status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the history of science, his contributions <w>loom</w> high above those of his contemporaries.",
                            "target_lang_translations": {
                                "ru": "В истории науки его вклад <w>возвышается</w> над достижениями его современников."
                            }
                        },
                        {
                            "text": "The figure of the great leader <w>loomed</w> large in the minds of the citizens for generations.",
                            "target_lang_translations": {
                                "ru": "Фигура великого лидера <w>занимала центральное место</w> в умах граждан на протяжении многих поколений."
                            }
                        }
                    ],
                    "synonyms": [
                        "stand out",
                        "excel"
                    ],
                    "common_phrases": [
                        "loom high"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восприниматься как нечто великое, выдающееся или морально возвышенное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышаться",
                                "target_lang_sense_clarification": "фигурально, над современниками"
                            },
                            {
                                "target_lang_word": "занимать центральное место",
                                "target_lang_sense_clarification": "в умах или истории"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "561c7a94-8101-3e82-b5ba-bfe0641cb143",
                    "sense_definition": "A machine or frame used for weaving cloth from threads or yarn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaving-tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan spent hours at the <w>loom</w>, carefully weaving a complex pattern into the rug.",
                            "target_lang_translations": {
                                "ru": "Ремесленник часами сидел за <w>ткацким станком</w>, тщательно вплетая сложный узор в ковер."
                            }
                        },
                        {
                            "text": "Modern textile factories use a high-speed power <w>loom</w> to produce fabric much faster than by hand.",
                            "target_lang_translations": {
                                "ru": "Современные текстильные фабрики используют высокоскоростной механический <w>ткацкий станок</w>, чтобы производить ткань гораздо быстрее, чем вручную."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand loom",
                        "power loom",
                        "weaving loom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Станок или рама, используемые для изготовления ткани из нитей или пряжи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ткацкий станок",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "кросна",
                                "target_lang_sense_clarification": "ручной станок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dcf476b-9dc7-330c-92fa-786192683e84",
                    "sense_definition": "The middle part of an oar, located between the handle and the blade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oar-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gripped the <w>loom</w> of the oar firmly to maintain control while rowing against the current.",
                            "target_lang_translations": {
                                "ru": "Он крепко сжал <w>черенок</w> весла, чтобы сохранить контроль при гребле против течения."
                            }
                        },
                        {
                            "text": "The <w>loom</w> of the oar should be balanced correctly to prevent fatigue during long trips.",
                            "target_lang_translations": {
                                "ru": "<w>Веретено</w> весла должно быть правильно сбалансировано, чтобы предотвратить усталость во время долгих поездок."
                            }
                        }
                    ],
                    "synonyms": [
                        "shaft"
                    ],
                    "common_phrases": [
                        "loom of an oar"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средняя часть весла, расположенная между рукояткой и лопастью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенок",
                                "target_lang_sense_clarification": "стержень весла"
                            },
                            {
                                "target_lang_word": "веретено",
                                "target_lang_sense_clarification": "технический термин для части весла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35fb9730-e906-3314-985d-924fc407ffe2",
                    "sense_definition": "The distorted or vague appearance of an object seen from a distance or through a haze.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual-phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange <w>loom</w> of the distant island on the horizon confused the sailors.",
                            "target_lang_translations": {
                                "ru": "Странные <w>очертания</w> далекого острова на горизонте сбили моряков с толку."
                            }
                        },
                        {
                            "text": "Through the heat haze, the <w>loom</w> of the city buildings looked like a mirage.",
                            "target_lang_translations": {
                                "ru": "Сквозь марево <w>мираж</w> городских зданий казался призрачным."
                            }
                        }
                    ],
                    "synonyms": [
                        "mirage",
                        "distortion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искаженное или смутное очертание объекта, видимого издалека или сквозь дымку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мираж",
                                "target_lang_sense_clarification": "оптическое искажение"
                            },
                            {
                                "target_lang_word": "смутные очертания",
                                "target_lang_sense_clarification": "в мареве или тумане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deebc181-d1bd-3c88-b040-28bd26942530",
                    "sense_definition": "An old term for a tool, utensil, or weapon; now mostly found in the word <w>heirloom</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic-tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, the word <w>loom</w> was often used to describe any useful household implement.",
                            "target_lang_translations": {
                                "ru": "В древних текстах слово loom часто использовалось для описания любого полезного бытового <w>орудия</w>."
                            }
                        },
                        {
                            "text": "The term survives today primarily in the word heirloom, referring to a family <w>loom</w> passed down.",
                            "target_lang_translations": {
                                "ru": "Этот термин сохранился сегодня в основном в слове heirloom, означающем семейную <w>реликвию</w>, передаваемую по наследству."
                            }
                        }
                    ],
                    "synonyms": [
                        "tool",
                        "utensil",
                        "implement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used outside of compounds"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее название инструмента, утвари или оружия; ныне встречается в основном в слове «heirloom» (семейная реликвия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "архаичное значение инструмента"
                            },
                            {
                                "target_lang_word": "утварь",
                                "target_lang_sense_clarification": "предмет обихода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3835804f-02f3-3660-a7eb-1d09f398cdbe",
                    "sense_definition": "A regional name for a loon, which is a type of aquatic bird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some northern coastal areas, the local residents refer to the loon as a <w>loom</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых северных прибрежных районах местные жители называют полярную гагару словом <w>loom</w>."
                            }
                        },
                        {
                            "text": "The cry of the <w>loom</w> echoed across the lake during the quiet summer evening.",
                            "target_lang_translations": {
                                "ru": "Крик <w>гагары</w> эхом разносился над озером тихим летним вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "loon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal variant of loon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Региональное название гагары (водной птицы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гагара",
                                "target_lang_sense_clarification": "вид птицы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}