                "senses": [
                    {
                        "sense_id": "3ef806da-d885-3f9f-9b48-9532d8fa06a7",
                        "entry_id": "385c874d-c1f8-33be-8afe-1153a084dca3",
                        "glosses": [
                            "Burlesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0dc771d-c7f4-4928-bd4d-27ea62a611c3",
                                "sense_id": "3ef806da-d885-3f9f-9b48-9532d8fa06a7",
                                "text": "Burley shows came to Times Square after vaudeville started its decline, and took over many of the darkened old theaters. The Minsky family had become synonymous with burlesque beginning in its earliest days, was hugely profitable."
                            },
                            {
                                "example_id": "b5b65af8-fac2-4788-be73-89d383dc8fb8",
                                "sense_id": "3ef806da-d885-3f9f-9b48-9532d8fa06a7",
                                "text": "The Western Vaudeville Managers' Association (WVMA) and the Orpheum soon merged. [...] opined, \"that the top all-around artist of today is Jim Barton, who was a burley comic, a skater, a storyteller, a dancer, a singer,[…]\""
                            },
                            {
                                "example_id": "ddd80646-a68c-4800-96ef-020e7e600bcb",
                                "sense_id": "3ef806da-d885-3f9f-9b48-9532d8fa06a7",
                                "text": "It can vary anywhere from burley (burlesque) to Phi Beta Kappa. […]"
                            }
                        ]
                    }
                ],
