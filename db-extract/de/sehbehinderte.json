                "senses": [
                    {
                        "sense_id": "271ab7a0-6fc6-3666-be8c-747100e1fe1e",
                        "entry_id": "faa4885e-ce97-390f-a37f-864b6883e922",
                        "glosses": [
                            "weibliche Person, die aufgrund von Krankheit oder Verletzung beim Sehen dauerhaft stark beeinträchtigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed06ea8-bdf9-4f87-b844-1d8d987c33b7",
                                "sense_id": "271ab7a0-6fc6-3666-be8c-747100e1fe1e",
                                "text": "„Zeigt eine Sehbehinderte auf eine Textquelle wie eine Anzeigerafel, eine Lebensmittelpackung oder einen Zeitungsartikel, analysiert der Computer umgehend die Bilder, die ihm von der Kamera geschickt werden, und liest ihr dann den Text über Lautsprecher vor.“"
                            },
                            {
                                "example_id": "a5001a71-338f-455a-9bfd-75d8d9907cc7",
                                "sense_id": "271ab7a0-6fc6-3666-be8c-747100e1fe1e",
                                "text": "„Alle Lehrer hatten Angst davor, eine Sehbehinderte in der Klasse zu haben.“"
                            },
                            {
                                "example_id": "74f7fb76-6ad3-489a-9037-450e33d23fe8",
                                "sense_id": "271ab7a0-6fc6-3666-be8c-747100e1fe1e",
                                "text": "„Außerdem habe er wohl schon einmal eine Sehbehinderte im Büro gehabt, bei der dann alles schief gelaufen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
