                                    {
                                        "sense_id": "3f08d1b0-ed5e-37b2-a2a5-ee72c4562c4f",
                                        "entry_id": "e7f744eb-f42e-3b96-b59f-a8bcec397287",
                                        "glosses": [
                                            "Either of two (parts of) plants often used in combination"
                                        ],
                                        "tags": [
                                            "uncountable",
