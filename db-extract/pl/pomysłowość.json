                        "entry_id": "276a1e2d-74b6-3d1f-a6d5-f0bec814beff",
                        "glosses": [
                            "dodatnia cecha intelektu charakteryzująca się zdolnością do tworzenia nowych pomysłów, projektów i koncepcji, byciu pomysłowym i pełnym inwencji twórczej"
                        ],
