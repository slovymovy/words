                        "translation_id": "7416c816-8c4e-482a-9505-603fb8b016b4",
                        "source_entry_id": "8d65da27-9875-374e-9a04-aa70af4e0d7a",
                        "source_sense_id": "a4c7ab7a-fd3b-3a02-b207-0ac3ccf445a8",
