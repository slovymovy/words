                "senses": [
                    {
                        "sense_id": "330f74da-e486-31ea-b1b5-848f9cecfabe",
                        "entry_id": "4b840558-cc8e-3ab1-8052-47f15406d308",
                        "glosses": [
                            "Livreur de repas préparé au domicile du client, sur le lieu de travail, à Mumbai en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749f531e-8974-4ef3-a3e3-49b4e1cbc862",
                                "sense_id": "330f74da-e486-31ea-b1b5-848f9cecfabe",
                                "text": "C’est le plus souvent l’épouse ou la mère qui prépare le repas, avant de le confier à un dabbawala qui, grâce à un système de chiffres, de lettres et de couleurs, le fait parvenir à bon port."
                            },
                            {
                                "example_id": "d2582abf-d4df-41ec-9a12-f2eea2fbc2b6",
                                "sense_id": "330f74da-e486-31ea-b1b5-848f9cecfabe",
                                "text": "Leur singularité a inspiré des auteurs comme Salman Rushdie qui dans son roman Les versets sataniques met en scène un dabbawala […]."
                            },
                            {
                                "example_id": "f6f3d314-40bb-435c-b815-030ff8184bc3",
                                "sense_id": "330f74da-e486-31ea-b1b5-848f9cecfabe",
                                "text": "Une armée de dabbawalas, les porteurs de gamelles, débarque un chargement de chapatis, riz, mutton korma et autres délices faits maison."
                            }
                        ]
                    }
                ],
