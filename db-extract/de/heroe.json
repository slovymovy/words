                                "target_senses": [
                                    {
                                        "sense_id": "a166b6af-2fd0-34e5-8e1b-8805bb151d44",
                                        "entry_id": "bbee7279-ef49-36a9-ace8-4ac88d606fac",
                                        "glosses": [
                                            "bir olayda önemli yeri olan kişi, alp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032c9020-52f8-4bff-9b46-feed19039539",
                                                "sense_id": "a166b6af-2fd0-34e5-8e1b-8805bb151d44",
                                                "text": "Son golün kahramanının yüzü, öpülmekten tükürük içinde kalmıştı."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda7ce38-ffcf-3a27-950a-7b56dd4e0e87",
                                        "entry_id": "bbee7279-ef49-36a9-ace8-4ac88d606fac",
                                        "glosses": [
                                            "roman, hikâye, tiyatro vb. edebiyat türlerinde en önemli kişi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e931f176-fee4-4e1d-b0c6-a8abdf6db30c",
                                                "sense_id": "eda7ce38-ffcf-3a27-950a-7b56dd4e0e87",
                                                "text": "Piyesin kahramanı azgın bir herif, boyuna baldızına saldırıyor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kahraman",
                                "target_lang_code": "tr",
