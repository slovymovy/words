                    "common_phrases": [
                        "vrijheid van het individu",
                        "rechten van het individu",
                        "uniek individu"
                    ],
                    "target_lang_definitions": {
                        "en": "a single person in particular, considered as an independent unit as opposed to the group or the masses"
                    },
                    "translations": {
