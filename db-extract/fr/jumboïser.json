                        "sense_id": "ac125e35-df03-31cf-8001-4713501b5ee2",
                        "entry_id": "baeb4497-cf09-31fa-9fbc-8b1459b50391",
                        "glosses": [
                            "Rallonger (un navire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aba44b0-5bb0-4b2d-b7d0-32eb6e7ec892",
                                "sense_id": "ac125e35-df03-31cf-8001-4713501b5ee2",
                                "text": "S'il était possible de jumboïser vis-à-vis de tout le reste, il suffirait de le faire devant ou derrière cette zone."
                            },
                            {
                                "example_id": "273d269a-d4c2-469e-acfc-f266f02636f5",
                                "sense_id": "ac125e35-df03-31cf-8001-4713501b5ee2",
                                "text": "Après le Balmoral (ex-Norwegian Crown) en janvier, la compagnie Fred Olsen fait « jumboïser » un autre de ses paquebots."
                            },
                            {
                                "example_id": "81024c13-01fa-459d-b3fa-8224cb4a1366",
                                "sense_id": "ac125e35-df03-31cf-8001-4713501b5ee2",
                                "text": "Piriou va jumboïser le navire de servitude Le Milouin."
                            }
                        ]
                    }
