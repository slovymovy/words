                "senses": [
                    {
                        "sense_id": "8b1d833e-f0ca-3b4c-bd06-89437585787c",
                        "entry_id": "79649716-45c4-3822-be91-2de744759c57",
                        "glosses": [
                            "słabe, emanujące skądś światło"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f72837d-9169-4804-8519-a266367260bc",
                                "sense_id": "8b1d833e-f0ca-3b4c-bd06-89437585787c",
                                "text": "Próbka polonu emanuje niebieską poświatą – jest to efekt wzbudzenia otaczającego ją powietrza"
                            },
                            {
                                "example_id": "e2e83fe5-20cd-4a9d-8732-617a437201f2",
                                "sense_id": "8b1d833e-f0ca-3b4c-bd06-89437585787c",
                                "text": "Jej sylwetka była słabo widoczna w poświecie księżyca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "af368a9d-dd7c-39f0-a71f-33177b330f5e",
                        "entry_id": "79649716-45c4-3822-be91-2de744759c57",
                        "glosses": [
                            "oświecenie, pouczenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d359f23c-78ee-4e0c-a8e1-c55a96cc3fbf",
                        "source_entry_id": "79649716-45c4-3822-be91-2de744759c57",
                        "source_sense_id": "8b1d833e-f0ca-3b4c-bd06-89437585787c",
                        "target_lang_word": "afterglow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afterglow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The glow seen in the sky after sunset."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621fabdb-7a14-404e-9112-deaaa335d9e3",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "That the sunset in Egypt is gorgeous, every body knows; but I, for one, was not aware that there is a renewal of beauty, some time after the sun has departed and left all grey. […] everything begins to brighten again in twenty minutes;—the hills are again purple or golden,—the sands orange,—the palms verdant,—the moonlight on the water, a pale green ripple on a lilac surface: and this after-glow continues for ten minutes, when it slowly fades away."
                                            },
                                            {
                                                "example_id": "17922c11-658a-4130-9e4b-f5599bedd98a",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "Let my thoughts come to you, when I am gone, like the afterglow of sunset at the margin of starry silence."
                                            },
                                            {
                                                "example_id": "b9345935-e443-4e18-925d-6fc1c2911829",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "Why did dusk and fir-scent and the afterglow of autumnal sunsets make people say absurd things?"
                                            },
                                            {
                                                "example_id": "2233bebf-e821-45e6-b2e2-697428f91be2",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "At Stirling, we obtained a wonderful silhouette view of the Wallace Monument, and the dark line of the Ochil Hills, and the castle stood out clearly against the afterglow of the sunset."
                                            },
                                            {
                                                "example_id": "b0bd3d49-7efd-4b32-b11e-03ca3995499f",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "The sun had just gone down, and its afterglow was backlighting the city, which formed low cliffs around the bucolic void to the idle stockyards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8afb0be9-4ef2-3a8d-9440-575d6c9c14e7",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The light emitted by an incandescent object while cooling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6687f0ea-04da-4939-9e18-89d51d7bbe13",
                                                "sense_id": "8afb0be9-4ef2-3a8d-9440-575d6c9c14e7",
                                                "text": "1984, Paul Auster (as Paul Benjamin), Squeeze Play, London: Faber & Faber, 1991, Chapter 19, p. 176,\nNothing will matter to you more than that [base]ball. It will hold you so completely that when you at last file out and return to the normal world, it will stay with you like the afterglow of a flashbulb that’s gone off in your eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1aa43d3-0e8d-3cb5-b101-7f5bbb20735a",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The light emitted by a phosphor after excitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The mildly euphoric feeling experienced after a pleasurable experience, especially after an orgasm or drug-induced high."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "491061f9-7b60-40f0-9596-8814528684d4",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "[…] he threw down his book, stretched his legs towards the embers in the grate, and clasped his hands at the back of his head, in that agreeable afterglow of excitement when thought lapses from examination of a specific object into a suffusive sense of its connections with all the rest of our existence […]"
                                            },
                                            {
                                                "example_id": "58c9e67b-6897-4051-a5d3-a33d700018ce",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "She herself had grown old as people should grow old—steadily and firmly. No interruptions, no belated after-glows and spasmodic returns."
                                            },
                                            {
                                                "example_id": "2a30bbe8-1617-4d6d-9207-c671a896846b",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "Nor did he cease attentions once himself glutted: he remained a wooing protagonist even in the “afterglow,” as the sex manuals call it."
                                            },
                                            {
                                                "example_id": "e7507135-bcbb-4725-a7d4-f6e40eb76092",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "We were merely observers, getting totally absorbed in some exciting movie, our palms all sweaty, only to find that, after the houselights came on and we exited the theater, the thrilling afterglow that coursed through us ultimately meant nothing whatsoever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54252b61-5fcc-3c78-8e6a-2a1b0cc17753",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "An afterparty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf3ac29-19ef-47c2-8a2c-9c80ceb22c00",
                                                "sense_id": "54252b61-5fcc-3c78-8e6a-2a1b0cc17753",
                                                "text": "There's an afterglow with singing after the evening worship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bebdc6cb-7782-42c2-9e68-ee1eb79ef058",
                        "source_entry_id": "79649716-45c4-3822-be91-2de744759c57",
                        "source_sense_id": "8b1d833e-f0ca-3b4c-bd06-89437585787c",
                        "target_lang_word": "glow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88e25c1b-bd0a-39ba-849d-01ef5f92bbbf",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To emit light as if heated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9083a69a-bc5b-48f2-b08a-f0c0a6a74d63",
                                                "sense_id": "88e25c1b-bd0a-39ba-849d-01ef5f92bbbf",
                                                "text": "The fire was still glowing after ten hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To radiate thermal heat."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6060fb2b-1efb-417c-ab69-ea16e5f51c67",
                                                "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                                "text": "Iron glows red hot when heated to near its melting point."
                                            },
                                            {
                                                "example_id": "3b4cd424-b773-4a21-ab04-d9f1c2050560",
                                                "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                                "text": "After their workout, the gymnasts' faces were glowing red."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To display intense emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ede77ed-ade0-4061-87cc-a600989a15b8",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "The zealots glowed with religious fervor."
                                            },
                                            {
                                                "example_id": "52319447-453f-4a38-a2fc-00ef356d76e8",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "You are glowing from happiness!"
                                            },
                                            {
                                                "example_id": "9302c6b5-8c67-4390-971e-b432b8b3253c",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "A fire which every windy paſſion blows; / With pride it mounts, and with revenge it glows."
                                            },
                                            {
                                                "example_id": "a1d889a6-959c-43fd-a239-f6cd813344e7",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "Burns with one love, with one resentment glows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7490f5bb-1c28-35fd-a1a1-ff3a19c6e1d6",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To gaze especially passionately at something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To shine brightly and steadily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bc877d-ddf5-4e3c-a80a-4597b18a1197",
                                                "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                                "text": "The new baby's room glows with bright, loving colors."
                                            },
                                            {
                                                "example_id": "c29f901f-3990-4143-ac9d-0a94f1f4d735",
                                                "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1046295a-4c05-301f-bef2-de7a8c8c5d92",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To make hot; to flush."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9324d7b-efca-42e2-a675-e4b9779631b2",
                                                "sense_id": "1046295a-4c05-301f-bef2-de7a8c8c5d92",
                                                "text": "Fans, whose wind did seem / To glow the delicate cheeks which they did cool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To feel hot; to have a burning sensation, as of the skin, from friction, exercise, etc.; to burn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e136bf5c-3e37-435b-baef-6b321768e5f3",
                                                "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                                "text": "Did not his temples glow / In the same sultry winds and scorching heats?"
                                            },
                                            {
                                                "example_id": "79e74b46-7d35-48a6-a4ea-0cca4a7092fa",
                                                "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                                "text": "The cord slides swiftly through his glowing hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7843b11-23e1-3f80-be3a-3a0d105a09e5",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To be related to or part of an (chiefly online) undercover sting operation, especially by American federal agencies."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0676cf6-aee4-4ccf-8bfb-5799feb36041",
                                                "sense_id": "e7843b11-23e1-3f80-be3a-3a0d105a09e5",
                                                "text": "If this post glows any brighter I'm going to need sunglasses. 😄🕶👌"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9435c29-95eb-348f-8292-23761fbfdee2",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "to expose someone to the authorities."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83891cdc-a6af-3993-b83b-04f9d9610cae",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "to create a threatening online post that may involve violence, and look suspicious enough to attract a police investigation."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc962f8-aab1-36a7-91b5-b2681ad73e5e",
                                        "entry_id": "7d2edb10-a093-3067-9d93-0244b8d87973",
                                        "glosses": [
                                            "The light given off by a glowing object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "268b3216-dad7-41ef-b284-5f0d2ebc4725",
                                                "sense_id": "2cc962f8-aab1-36a7-91b5-b2681ad73e5e",
                                                "text": "Thus all that Art and Con had to do, when the night was favourable, was to advance a little way along the avenue, until they reached the place whence the light, if it was burning, must be visible, as a glow, a feeble glow, in the air, and thence to go on, towards the back door, or to go back, towards the gate, as the case might be."
                                            },
                                            {
                                                "example_id": "005e6b38-8a70-4f88-94cb-b97db8ab3101",
                                                "sense_id": "2cc962f8-aab1-36a7-91b5-b2681ad73e5e",
                                                "text": "The door of the twins' room opposite was open; a twenty-watt night-light threw a weak yellow glow into the passageway. David could hear the twins breathing in time with each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b97d2e-c4d7-3642-aacd-cfe33c100829",
                                        "entry_id": "7d2edb10-a093-3067-9d93-0244b8d87973",
                                        "glosses": [
                                            "The condition of being passionate or having warm feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                                        "entry_id": "7d2edb10-a093-3067-9d93-0244b8d87973",
                                        "glosses": [
                                            "The brilliance or warmth of color in an environment or on a person (especially one's face)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf96ef70-960b-493b-ada8-b5f5bf48b6e3",
                                                "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                                                "text": "He had a bright red glow on his face."
                                            },
                                            {
                                                "example_id": "fac2c737-cb81-4857-be1b-234226740b91",
                                                "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                                                "text": "O, not for thee the glow, the bloom,\n⁠Who changest not in any gale,\n⁠Nor branding summer suns avail\nTo touch thy thousand years of gloom: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
