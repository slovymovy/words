            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b56f49d5-7c8e-33dc-bdcb-495a2e265aa3",
                    "sense_definition": "leitet eine direkte Frage nach dem Grund oder der Ursache ein",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frage_grund",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Weshalb</w> hast du dich damals eigentlich nicht bei uns gemeldet?"
                        },
                        {
                            "text": "<w>Weshalb</w> machst du in diesem Moment so ein unglückliches Gesicht?"
                        }
                    ],
                    "synonyms": [
                        "warum",
                        "wieso",
                        "weswegen"
                    ]
                },
                {
                    "sense_id": "100ca17b-3fcf-3735-a240-86db71440f55",
                    "sense_definition": "leitet eine indirekte Frage nach dem Grund oder der Ursache ein",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frage_grund",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir wissen bis heute nicht, <w>weshalb</w> sich unser Kollege so entschieden hat."
                        },
                        {
                            "text": "Sie wollte unbedingt herausfinden, <w>weshalb</w> das Experiment nicht funktioniert hatte."
                        },
                        {
                            "text": "Niemand konnte mir sagen, <w>weshalb</w> der Zug plötzlich stehen geblieben war."
                        }
                    ],
                    "synonyms": [
                        "warum",
                        "wieso",
                        "weswegen"
                    ],
                    "common_phrases": [
                        "weshalb auch immer"
                    ]
                },
                {
                    "sense_id": "91815aef-7f5d-340a-b719-29503a92337a",
                    "sense_definition": "leitet einen Relativsatz ein, der sich auf einen genannten Grund oder Anlass bezieht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relativ_grund",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das war nicht der einzige Grund, <w>weshalb</w> das kleine Gespenst den Schlüsselbund ständig mit sich trug."
                        },
                        {
                            "text": "Es gab mehrere wichtige Ursachen, <w>weshalb</w> die Konferenz kurzfristig verschoben werden musste."
                        }
                    ],
                    "synonyms": [
                        "weswegen"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                    "sense_definition": "leitet einen Nebensatz ein, der die Folge oder Konsequenz des zuvor Gesagten ausdrückt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "folge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe heute Morgen verschlafen, <w>weshalb</w> ich meinen gewohnten Zug verpasst habe."
                        },
                        {
                            "text": "Die Straßen waren extrem glatt, <w>weshalb</w> viele Autofahrer vorsichtiger fuhren."
                        }
                    ],
                    "synonyms": [
                        "weswegen"
                    ]
                }
            ]
        }
