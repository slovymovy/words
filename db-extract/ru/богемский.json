                "senses": [
                    {
                        "sense_id": "f4a98b38-6349-3bf9-a9fb-891597b61bd7",
                        "entry_id": "15bcc27b-ae71-3dd1-a9a7-830f67ec3453",
                        "glosses": [
                            "истор. цыганский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626794f3-87fb-43c8-8f5d-e9e5649945ef",
                                "sense_id": "f4a98b38-6349-3bf9-a9fb-891597b61bd7",
                                "text": "Кавалер начинает <польку>, держа свою даму правой рукой, как в древнем аллемане .. Также к обыкновенному па примешивали так называемое богемское па, или двойную польку .. точно так, как в па полишинеля"
                            }
                        ]
                    },
                    {
                        "sense_id": "230d7429-f84a-37f5-9c10-c555ff89b1c9",
                        "entry_id": "15bcc27b-ae71-3dd1-a9a7-830f67ec3453",
                        "glosses": [
                            "то же, что богемный 1 293."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487d623b-eef3-4cca-8ad4-1d394b384799",
                                "sense_id": "230d7429-f84a-37f5-9c10-c555ff89b1c9",
                                "text": "Литературно-богемская жизнь."
                            },
                            {
                                "example_id": "6d534404-86df-48c0-a77a-6dee9f7c8c42",
                                "sense_id": "230d7429-f84a-37f5-9c10-c555ff89b1c9",
                                "text": "Дух был богемский и бестолковый. Путано, шумно, нехозяйственно — но весело."
                            }
                        ]
                    }
                ],
