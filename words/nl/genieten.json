                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij hebben tijdens de vakantie enorm van de zon <w>genoten</w>.",
                            "target_lang_translations": {
                                "en": "We <w>enjoyed</w> the sun immensely during the holiday.",
                                "ru": "Во время отпуска мы очень <w>наслаждались</w> солнцем.",
                                "fr": "Nous avons énormément <w>profité</w> du soleil pendant les vacances.",
                                "pl": "Podczas wakacji ogromnie <w>cieszyliśmy się</w> słońcem.",
                                "de": "Wir haben während des Urlaubs die Sonne sehr <w>genossen</w>.",
                                "it": "Durante le vacanze ci siamo <w>goduti</w> moltissimo il sole.",
                                "cs": "Během dovolené jsme si slunce nesmírně <w>užívali</w>.",
                                "tr": "Tatil boyunca güneşin tadını doyasıya <w>çıkardık</w>.",
                                "es": "Hemos <w>disfrutado</w> muchísimo del sol durante las vacaciones."
                            }
                        },
                        {
                            "text": "<w>Geniet</w> van het leven zolang het nog kan.",
                            "target_lang_translations": {
                                "en": "<w>Enjoy</w> life while you still can.",
                                "ru": "<w>Наслаждайся</w> жизнью, пока можешь.",
                                "fr": "<w>Profite</w> de la vie tant que tu le peux encore.",
                                "pl": "<w>Ciesz się</w> życiem, póki jeszcze możesz.",
                                "de": "<w>Genieße</w> das Leben, solange es noch geht.",
                                "it": "<w>Goditi</w> la vita finché puoi.",
                                "cs": "<w>Užívej</w> si života, dokud to ještě jde.",
                                "tr": "Hâlâ vaktin varken hayatın keyfini <w>çıkar</w>.",
                                "es": "<w>Disfruta</w> de la vida mientras puedas."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich vermaken",
                        "plezier hebben"
