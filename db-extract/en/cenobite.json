                        "entry_id": "d9ec021b-41ba-3918-a45d-842a00cac9b8",
                        "glosses": [
                            "A new or recent member of a Greek monastic religious order; a caloyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d75900-bafa-473e-935d-8a6f7077ac05",
                                "sense_id": "9630773f-2130-3ba2-9059-d3c07ce12017",
                                "text": "Lamprecht knew very well how the war was going and was perfunctory in his rounding up of Jews and cenobites."
                            }
                        ]
                    },
                    {
                        "sense_id": "18cbf5f4-9e19-3557-b7ea-8776846f5ce9",
                        "entry_id": "d9ec021b-41ba-3918-a45d-842a00cac9b8",
