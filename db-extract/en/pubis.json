                                        "sense_id": "632c1248-4897-37f9-b146-7b04b9b77828",
                                        "entry_id": "2646fe86-6711-3e43-896d-20927a13c1fa",
                                        "glosses": [
                                            "deel van het skelet dat het voorste deel van het heupbeen vormt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c720b9-59c2-44f7-a39d-d60e4bf93221",
                                                "sense_id": "632c1248-4897-37f9-b146-7b04b9b77828",
                                                "text": "De Duitser miste vorig jaar het EK in Frankrijk door een blessure aan zijn schaambeen. Reus moest ook het WK 2014 in Brazilië, dat werd gewonnen door Duitsland, missen door een enkelblessure."
                                            },
                                            {
                                                "example_id": "508c7d00-de27-49f1-b057-dac2bb24c6a3",
                                                "sense_id": "632c1248-4897-37f9-b146-7b04b9b77828",
                                                "text": "Finnbogason speelde sinds september niet meer in een officiële wedstrijd, wegens een ontsteking aan het schaambeen. Een week geleden deed hij wel weer mee in een oefenwedstrijd tegen Fürth (1-1), waarin hij meteen scoorde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d618140-4179-448d-9b11-25f4960d5504",
                        "source_entry_id": "cd6b8f2c-8226-3059-b50e-9cd073f1b753",
                        "source_sense_id": "966a862b-cba0-3a45-a8f0-58788d42d803",
