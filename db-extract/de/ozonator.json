                "senses": [
                    {
                        "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                        "entry_id": "514d8077-2da7-3528-95da-148c93e1f9d2",
                        "glosses": [
                            "Gerät mit einem Ionisator oder einer UV-C-Lampe, das Ozon erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfbe9baf-42be-4896-8a0b-2997b5c23deb",
                                "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                                "text": "„Der Starline Ozonator schafft dieses Problem endgültig aus der Welt. Mit dem Ozonator wird das Wasser desinfiziert.“"
                            },
                            {
                                "example_id": "05124dc2-4142-4b96-b545-a53caa009a05",
                                "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                                "text": "„Der Hydro-Force Flowclear Ozonator ist ein Poolreiniger aus Ozon, der den Chemikalienverbrauch bei Schwimmbecken drastisch reduziert.“"
                            },
                            {
                                "example_id": "40fca404-dcd5-4ed8-aa84-191aab4b4a2a",
                                "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                                "text": "„Der Ozonator ist ein Gerät mit einem Luftsprudler am Ende seines Schlauches, der in das Wasser, das Öl oder in die Nahrung eingetaucht wird.“"
                            },
                            {
                                "example_id": "4384299d-eb58-479e-917f-dd3ea5f118ae",
                                "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                                "text": "„Dazu produziert ein im Analysator integrierter Ozonator mittels elektrischer Energie aus reinem Sauerstoff (O2) Ozon (O3). Dieses wird dem Probengas zugeführt und führt zur Bildung von NO2 und angeregtem NO2*.“"
                            },
                            {
                                "example_id": "84bd0363-ddd0-432b-bf52-57e8c8d75200",
                                "sense_id": "d3dc6aab-32bc-3ac1-a7a8-634066b57609",
                                "text": "„Genutzt wurde ein selbstgebauter Ozonator aus der anorganischen Chemie, mit dem der Sauerstoff aus der Umgebungsluft oder aber reiner Sauerstoff aus einer Gasflasche mittels einer HF-Entladung ozoniert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
