                "senses": [
                    {
                        "sense_id": "4c110ea8-95ea-351e-b4b9-cb745ec71029",
                        "entry_id": "d5b0b3c5-4a8b-3cac-9bcc-7262fe904a6f",
                        "glosses": [
                            "техн. электрический сигнал, содержащий всю необходимую информацию для передачи и воспроизведения изображения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf45da1-8be4-4dcb-a0b0-a51b919c80bb",
                                "sense_id": "4c110ea8-95ea-351e-b4b9-cb745ec71029",
                                "text": "Передача шла без звука, а для передачи видеосигнала использовалась частота 5,3 МГц (56,6 м)."
                            },
                            {
                                "example_id": "cae80037-7e06-4694-ac48-18c8491ceeff",
                                "sense_id": "4c110ea8-95ea-351e-b4b9-cb745ec71029",
                                "text": "Видеосигнал передается посредством оптоволоконной связи, что позволяет избежать искажения сигнала в результате воздействия электромагнитных помех."
                            }
                        ]
                    }
