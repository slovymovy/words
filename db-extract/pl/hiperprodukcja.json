                                    {
                                        "sense_id": "e75c2f9b-b8a1-3267-bdca-f8f8c3bca5d3",
                                        "entry_id": "b4b6d85f-3e74-3dee-bcae-dd66574d7eb9",
                                        "glosses": [
                                            "To defeat an enemy and invade in great numbers, seizing the enemy positions conclusively."
