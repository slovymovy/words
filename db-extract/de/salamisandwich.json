                        "glosses": [
                            "mit Salami belegtes Sandwich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "002e21a1-c8a8-4314-92f5-e5ef8e2a9b8a",
                                "sense_id": "093b0523-7f6c-3632-af61-ac141c411224",
                                "text": "„Ich ging in die Küche, aß ein Salamisandwich und las noch einmal den Brief, den ich gestern von meiner Tante bekommen hatte.“"
                            },
                            {
                                "example_id": "4fd277bb-10ba-4f23-9674-f68c27efa277",
                                "sense_id": "093b0523-7f6c-3632-af61-ac141c411224",
                                "text": "„Im Laufe der Feierlichkeiten machte der theoretische Leichnam einen kurzen Spaziergang, um ein Salamisandwich zu essen, aber man stellte ein geschmackvolles Kenotaph als Fokus für das Ritual zur Verfügung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
