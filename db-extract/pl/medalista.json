                ],
                "senses": [
                    {
                        "sense_id": "3b8f6686-cecf-3098-b8af-b8a6f7c01079",
                        "entry_id": "a192a23f-3a2b-33b4-afcc-2987f1c0c71a",
                        "glosses": [
                            "sportowiec, który zdobył medal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc28b55-925a-4dbb-ae1e-5c04cc9ef635",
                                "sense_id": "3b8f6686-cecf-3098-b8af-b8a6f7c01079",
                                "text": "Skład biało-czerwonych zdecydowanie odbiegał od optymalnego, natomiast rywale do Chicago przyjechali w najmocniejszym zestawieniu, z kadrą naszpikowaną medalistami ostatnich mistrzostw świata i igrzysk olimpijskich w Rio de Janeiro."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "717c792d-99d0-3182-8e93-c40c031be746",
                        "entry_id": "a192a23f-3a2b-33b4-afcc-2987f1c0c71a",
                        "glosses": [
                            "zwierzę-samiec, którego hodowcę uhonorowano medalem"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16d9a6de-6fe5-415b-8ecb-ee3a3c66ed27",
                        "source_entry_id": "a192a23f-3a2b-33b4-afcc-2987f1c0c71a",
                        "source_sense_id": "3b8f6686-cecf-3098-b8af-b8a6f7c01079",
