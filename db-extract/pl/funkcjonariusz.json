                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd44972-91ff-4a4e-a2f6-aff0d4980192",
                        "source_entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "source_sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                        "target_lang_word": "Funktionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Funktionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3552c45c-dd9e-394e-aa0e-3cd04b4bb129",
                                        "entry_id": "3e3b8c04-9c0a-34fa-ab88-0c2e54deed2e",
                                        "glosses": [
                                            "Person, die mit der Wahrnehmung bestimmter Aufgaben in einer Institution/Organisation (in leitender Funktion) beauftragt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a703d87-73af-448d-9117-d9b3d590213e",
                                                "sense_id": "3552c45c-dd9e-394e-aa0e-3cd04b4bb129",
                                                "text": "„Erst nach und nach setzten hochrangige Funktionäre durch, dass sie ihre Gattinnen mitnehmen durften.“"
                                            },
                                            {
                                                "example_id": "733a4c17-e553-4c7d-a329-feba8f79b5c7",
                                                "sense_id": "3552c45c-dd9e-394e-aa0e-3cd04b4bb129",
                                                "text": "„Wir distanzieren uns von einem autoritären Sozialismus, in dem die politische Macht in den Händen einer äußerst begrenzten Gruppe von führenden Funktionären (oder gar nur eines ‚Führers‘) konzentriert ist, die außerhalb jeder gesellschaftlichen Kontrolle agieren.“"
                                            },
                                            {
                                                "example_id": "7b3baba8-23d6-4c04-95bc-2b90eea9a198",
                                                "sense_id": "3552c45c-dd9e-394e-aa0e-3cd04b4bb129",
                                                "text": "„Eilfertige Funktionäre der Rennleitung kamen und gingen, ihre Listen und Eintragungen ergänzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
