                                "example_id": "6e91ef89-93e7-475e-a7b7-fd04804c1fda",
                                "sense_id": "cc3ac47d-945a-35dd-8253-f0c10996e76b",
                                "text": "„Wird ein Gewerbebetrieb endgültig aufgegeben, erlischt mit dessen Baugenehmigung auch die Baugenehmigung für eine dazugehörige Betriebswohnung.“"
                            },
                            {
                                "example_id": "b0394d86-c357-4de2-a111-06acc870b2f0",
                                "sense_id": "cc3ac47d-945a-35dd-8253-f0c10996e76b",
                                "text": "„Bei dem Versteigerungsobjekt handelt es sich um eine freistehende Gewerbehalle mit Bürotrakt und einer Betriebswohnung.“"
                            }
                        ],
