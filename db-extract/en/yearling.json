                        "entry_id": "21ecc7ce-37e3-3b35-ac38-a0c67b242207",
                        "glosses": [
                            "An animal that is between one and two years old; one that is in its second year (but not yet two full years old)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54527e1a-cf2d-4640-9f4d-817eb973f0d3",
                                "sense_id": "aaa39b2b-2bc6-3256-a609-c9c348cff471",
                                "text": "a yearling lamb"
                            },
                            {
                                "example_id": "92f1a230-5c46-435d-b53a-abf3e50006f2",
                                "sense_id": "aaa39b2b-2bc6-3256-a609-c9c348cff471",
                                "text": "Tom Fettig and his wife, Kim, were there with 60 yearlings, about half of a herd they were helping their son raise on the outskirts of Bismarck."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d6674fe-8542-33d7-a159-f24c14c05ee0",
                        "entry_id": "21ecc7ce-37e3-3b35-ac38-a0c67b242207",
                        "glosses": [
                            "A racehorse that is considered to be one year old until a subsequent January 1st."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4df8f4b2-43fd-36f0-9c96-32bbf485534b",
                        "entry_id": "21ecc7ce-37e3-3b35-ac38-a0c67b242207",
                        "glosses": [
                            "A sophomore at West Point military academy."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "822e6258-343f-476e-8fa5-df1099bc94fb",
                                "sense_id": "4df8f4b2-43fd-36f0-9c96-32bbf485534b",
                                "text": "\"But is a plebe forbidden to stroll here?\"\n\"If a plebe did have the brass to try it,\" replied Anstey slowly, \"I reckon he would have to fight the whole yearling class in turn.\""
                            },
                            {
                                "example_id": "1912ab5a-48ec-4814-b958-b0609c86060c",
                                "sense_id": "4df8f4b2-43fd-36f0-9c96-32bbf485534b",
                                "text": "As a yearling, he admitted to doing his part in ensuring that plebes knew their place at the Academy, […]"
                            }
                        ]
                    }
                ],
