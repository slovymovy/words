            {
                "entry_id": "a7e80d45-6fc9-3c14-a2b0-15393d591d66",
                "word": "h",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f896a756-bb15-397d-bc67-d191262e8e84",
                        "entry_id": "a7e80d45-6fc9-3c14-a2b0-15393d591d66",
                        "glosses": [
                            "Heures, par exemple dans l’écriture de l’heure du jour (dans ce cas, précédé par un ou deux chiffres signifiant l’heure, et pouvant être suivi de deux chiffres signifiant les minutes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af4e90b-399d-4743-9296-4f1afc916e16",
                                "sense_id": "f896a756-bb15-397d-bc67-d191262e8e84",
                                "text": "Ça me fait penser à allumer la téloche pour regarder les infos de 9 h. J'attrape la télécommande et je mets la dix."
                            },
                            {
                                "example_id": "fa690601-2f3e-435b-a7be-59bca8861189",
                                "sense_id": "f896a756-bb15-397d-bc67-d191262e8e84",
                                "text": "Le premier forum des associations de la commune se tiendra samedi 10 septembre, de 10 h à midi, à la salle socioculturelle."
                            },
                            {
                                "example_id": "8513c69f-a0d0-40fd-a074-414cbed5fa5e",
                                "sense_id": "f896a756-bb15-397d-bc67-d191262e8e84",
                                "text": "Challengez-vous avec la randonnée (8h environ) autour de la rivière des Remparts qui relie le volcan à l’océan."
                            }
                        ]
                    }
                ],
