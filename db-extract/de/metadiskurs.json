                        "glosses": [
                            "Diskurs, der eine übergeordnete Funktion über andere Diskurse hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3fa07c5-72bc-4e75-b1a3-7e67431377f4",
                                "sense_id": "9f6ab14f-91f3-3ba6-9d9b-88530e9803f5",
                                "text": "„Im Gegensatz dazu erzählen Historiker - und das gilt für die meisten Lehrbücher und populären Geschichtsbücher, die unmittelbar und maßgeblich eine Geschichte erzählen - eine Geschichte ohne jeden ‹Metadiskurs›, als hätte es den gegenwärtigen Wissensstand in einem Gebiet schon immer gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
