                    {
                        "translation_id": "1c6f3654-746d-4db5-b7a4-8dbedb632e82",
                        "source_entry_id": "cfa5ae83-a260-371a-a180-19c006df3443",
                        "source_sense_description": "top of a ridge",
                        "target_lang_word": "хребе́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хребе́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61ba7d2a-31e4-3c31-9aa5-2ec1d1e38c9d",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "то же, что позвоночник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e00fe78d-22fe-40f6-9ece-704ef67ce975",
                                                "sense_id": "61ba7d2a-31e4-3c31-9aa5-2ec1d1e38c9d",
                                                "text": "Под столом валялись рыбьи головы и хребты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cfb372-468f-37ed-875b-e9f505d46f8b",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "прост. спина, спина как символ труда, физической энергии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4477589d-7abc-43d4-ba97-ea63b9871e9f",
                                                "sense_id": "21cfb372-468f-37ed-875b-e9f505d46f8b",
                                                "text": "По первому вашему мановению, он начинает и пахать, и бороновать, и сеять, и косить, и жать, или, другими словами, действовать хребтом, и действует им до тех пор, покуда вы сами наконец не скажете: довольно!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc7adb4-1411-3f45-97d4-75f62dda9044",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "перен. стержень, основа чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bd4bd60-2c90-3dc6-86be-1e95f5014938",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "верх, верхняя часть (волны, холма и т. п.); гребень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111be2a2-814a-485a-b3eb-420bdb652453",
                                                "sense_id": "9bd4bd60-2c90-3dc6-86be-1e95f5014938",
                                                "text": "Медленно поднимаясь на хребты волн, быстро спускаясь с них, приближалась к берегу лодка."
                                            },
                                            {
                                                "example_id": "6ff12f7e-c959-4645-b5c2-5f928923e11c",
                                                "sense_id": "9bd4bd60-2c90-3dc6-86be-1e95f5014938",
                                                "text": "Едва показался хребет бруствера, немцы открыли ураганный огонь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34880e69-2420-301a-a66a-b630880e3df3",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "геогр. горная цепь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3247ffa-8543-4ab7-b543-a228043a026a",
                                                "sense_id": "34880e69-2420-301a-a66a-b630880e3df3",
                                                "text": "К югу от озера тянутся два невысоких параллельных хребта, разделённые речной долиной."
                                            },
                                            {
                                                "example_id": "b994152c-25ef-4910-a75a-ba29c5950d50",
                                                "sense_id": "34880e69-2420-301a-a66a-b630880e3df3",
                                                "text": "Уж солнце начинало прятаться за снеговой хребет, когда я въехал в Койшаурскую долину."
                                            },
                                            {
                                                "example_id": "5c928842-79bb-4bb5-acd2-c5736c251dee",
                                                "sense_id": "34880e69-2420-301a-a66a-b630880e3df3",
                                                "text": "Хребет, по которому мы теперь шли, состоял из ряда голых вершин, подымающихся одна над другою в восходящем порядке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c3cb5e-e970-36ec-a573-96556b3f8c56",
                                        "entry_id": "260382ca-e732-3d9b-addf-1328fcd80ee1",
                                        "glosses": [
                                            "срединная часть зеркала реки, потока, озера"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "395889fa-299f-4ae3-a7e1-88247095fb74",
                                                "sense_id": "d0c3cb5e-e970-36ec-a573-96556b3f8c56",
                                                "text": "Двенадцать гребцов, в двадцать четыре весла, с песнями, понесли их по гладкому хребту зеркального озера."
                                            },
                                            {
                                                "example_id": "54cdf7fc-e4e6-4a1c-b429-da58ee7d3c05",
                                                "sense_id": "d0c3cb5e-e970-36ec-a573-96556b3f8c56",
                                                "text": "Река стала шероховатой, ее живой хребет вздрагивал и извивался под ногами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60618114-6c9d-4ad7-bc2e-3003438fe5d8",
                        "source_entry_id": "cfa5ae83-a260-371a-a180-19c006df3443",
                        "source_sense_description": "angle in the hull",
                        "target_lang_word": "Kimm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                                        "glosses": [
                                            "Grenzlinie auf See zwischen Wasseroberfläche und Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2efd67-6b1c-4233-945b-4c9840944a1b",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Angespannter als je zuvor suchten meine Blicke durch das Doppelglas in dem mir zugewiesenen rückwärtigen Sektor zunächst das Wasser der Kimm, dem Treffpunkt von Wasserfläche und dem bewölkten Himmel am Horizont.“"
                                            },
                                            {
                                                "example_id": "891ec7ec-e383-4b32-9329-c0cbb9dcd935",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Die Kimm zeichnet sich nun ringsum schon klar und deutlich ab.“"
                                            },
                                            {
                                                "example_id": "1fdbb82e-3302-4fdc-b8d8-19acfc3df587",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Palmen, Häuser, der Strand von Bagamoyo verschmelzen allmählich zu einem schmalen Strich an der Kimm.“"
                                            },
                                            {
                                                "example_id": "1b5b5910-d3a9-411c-a3f9-cc4247cad7db",
                                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                                "text": "„Die Kimm zitterte vor Hitze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                                        "glosses": [
                                            "Grenze zwischen Boden und Wand bei Schiffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9f361e-9def-4c82-8e32-a8fb0a71aa2d",
                                                "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                                                "text": "„Wir versuchten zunächst, das Schiff über die Untiefe zu zwingen, doch ohne Erfolg, und als die Ebbe kam, kippte es auf die Kimm, und die Schandeckel gerieten unter Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
