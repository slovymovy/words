                                "example_id": "3430f541-2962-4a87-816a-ad7b4fd51ef0",
                                "sense_id": "443ee59b-1c63-3941-8195-90bdfa57682f",
                                "text": "„Der Hauptgang wurde serviert. Geschmortes Fleisch mit Pilzen, Kartoffeln, Bratensoße und Gemüse.“"
                            }
                        ],
