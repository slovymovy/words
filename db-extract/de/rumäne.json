                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e5a8a1-7803-4cd3-8c42-71a9d4de3094",
                                "sense_id": "ce30e7b6-7131-3eca-a368-7135e7e2f1f3",
                                "text": "Ein Rumäne kommt für gewöhnlich aus Rumänien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a33e57d-781b-315c-be53-c9a3c1d4fd75",
                        "entry_id": "51190afe-5b13-3471-af63-b09f07b4417d",
