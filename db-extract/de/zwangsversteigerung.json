                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e1fecd-c2e4-4496-827d-464fea3e09dc",
                                "sense_id": "98406bcc-0ab3-3c45-b3f3-ca84302c4ad1",
                                "text": "Die Zwangsversteigerung erbrachte nur einen Bruchteil des eigentlichen Grundstückwertes."
                            },
                            {
                                "example_id": "d636fc70-6e2b-4cc2-8f73-cb04f91de43b",
                                "sense_id": "98406bcc-0ab3-3c45-b3f3-ca84302c4ad1",
                                "text": "„Andrea Fransdóttir und Tryggvi Traustason hatten das Haus 2006 gekauft und bis 2009 besessen, als der isländische Finanzierungsfonds für Hausbesitz es im Zuge einer Zwangsversteigerung erwarb.“"
                            }
                        ],
