            "senses": [
                {
                    "sense_id": "d0a3d39f-534e-3d32-a8b8-4823c5fc89e9",
                    "sense_definition": "Eine Zahl durch das Weglassen oder Verringern von Nachkommastellen auf einen niedrigeren Wert bringen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Händler <w>rundet</w> den Betrag an der Kasse großzügig <w>ab</w>."
                        },
                        {
                            "text": "Beim Rechnen mit Kommazahlen <w>runden</w> die Schüler das Ergebnis einfach <w>ab</w>."
                        }
                    ],
                    "antonyms": [
                        "aufrunden"
                    ],
                    "common_phrases": [
                        "eine Zahl abrunden",
                        "einen Betrag abrunden"
                    ]
                },
                {
                    "sense_id": "d1ab6ffa-8fcd-3849-a8a7-2149e5e80d47",
                    "sense_definition": "Etwas harmonisch vollenden oder stimmig ergänzen, sodass ein ausgewogenes Ganzes entsteht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein leckeres Dessert <w>rundete</w> das festliche Menü am Abend perfekt <w>ab</w>."
                        },
                        {
                            "text": "Ein interessanter Ausflug <w>rundet</w> das Programm dieser spannenden Reise harmonisch <w>ab</w>."
                        }
                    ],
                    "common_phrases": [
                        "das Bild abrunden",
                        "den Abend abrunden"
                    ]
                },
                {
                    "sense_id": "c33042fc-3839-375c-8248-7d6faefc0e64",
                    "sense_definition": "Scharfe Ecken oder Kanten eines Gegenstands glätten und in eine gewölbte Form bringen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem Lackieren müssen wir alle scharfen Kanten des Tisches sorgfältig <w>abrunden</w>."
                        },
                        {
                            "text": "Der erfahrene Tischler <w>rundet</w> das harte Holz mit feinem Schleifpapier <w>ab</w>."
                        }
                    ],
                    "synonyms": [
                        "brechen"
                    ],
                    "common_phrases": [
                        "die Kanten abrunden",
                        "die Ecken abrunden"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f26f3bc-70e0-3210-a87e-4ececde6c02e",
                    "sense_definition": "Das Glätten von Kanten oder Verringern von Zahlenwerten; substantivierter Infinitiv von <w>abrunden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das automatische <w>Abrunden</w> von Beträgen führt in der Buchhaltung manchmal zu Problemen."
                        },
                        {
                            "text": "Beim <w>Abrunden</w> der Ecken sollte man stets eine geeignete Feile verwenden."
