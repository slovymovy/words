                    {
                        "translation_id": "085a3e08-205c-444c-b84d-330a63dbb7f8",
                        "source_entry_id": "7d36fba4-a3af-39f4-90f7-ffe5a8717ca2",
                        "source_sense_id": "8a54d138-2b76-3f1a-9805-16932a682375",
                        "target_lang_word": "mess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17e8d5f0-3f45-31e0-8c97-6a1dad5ee071",
                                        "entry_id": "b7b8c4a2-5a15-3b12-805e-c7c52b19c3a5",
                                        "glosses": [
                                            "a thing or group of things in a disagreeable, disorganised, or dirty state; hence a bad situation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2185578-d484-4268-a4d1-2eac5d445f66",
                                                "sense_id": "17e8d5f0-3f45-31e0-8c97-6a1dad5ee071",
                                                "text": "No, look, I know that the place looks like a bit of a mess but it's actually a very delicate ecosystem. Everything is connected. It's like the rainforest. You change one thing, even the tiniest bit, and the whooole rainforest dies. You don't want the rainforest to die, do ya?"
                                            },
                                            {
                                                "example_id": "871fb7e1-0ed6-43cc-8677-520e68ff1a34",
                                                "sense_id": "17e8d5f0-3f45-31e0-8c97-6a1dad5ee071",
                                                "text": "He made a mess of it."
                                            },
                                            {
                                                "example_id": "802540a5-f9c6-4b60-aef0-fbf84389c5de",
                                                "sense_id": "17e8d5f0-3f45-31e0-8c97-6a1dad5ee071",
                                                "text": "My bedroom is such a mess; I need to tidy up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfcda41-fb77-3349-9642-07c25981a2f2",
                                        "entry_id": "b7b8c4a2-5a15-3b12-805e-c7c52b19c3a5",
                                        "glosses": [
                                            "a large quantity or number"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c063f963-a6fd-4b26-aecd-c41c29e381a0",
                                                "sense_id": "cbfcda41-fb77-3349-9642-07c25981a2f2",
                                                "text": "Messerschmidts! A whole mess of Messerschmidts!"
                                            },
                                            {
                                                "example_id": "abd82953-6b94-47f0-8b2a-beebb76dfbd4",
                                                "sense_id": "cbfcda41-fb77-3349-9642-07c25981a2f2",
                                                "text": "My boss dumped a whole mess of projects on my desk today."
                                            },
                                            {
                                                "example_id": "4c335ab7-51ee-42f0-b423-6555123f9526",
                                                "sense_id": "cbfcda41-fb77-3349-9642-07c25981a2f2",
                                                "text": "She brought back a mess of fish to fix for supper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664f8288-dfa9-3989-8858-dd97b57fd71a",
                                        "entry_id": "b7b8c4a2-5a15-3b12-805e-c7c52b19c3a5",
                                        "glosses": [
                                            "excrement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8700950d-e798-4b72-ae1b-61edf2266cf3",
                                                "sense_id": "664f8288-dfa9-3989-8858-dd97b57fd71a",
                                                "text": "There was dog mess all along the street."
                                            },
                                            {
                                                "example_id": "0489eaf0-cc90-4c53-9876-0e40e5ba7032",
                                                "sense_id": "664f8288-dfa9-3989-8858-dd97b57fd71a",
                                                "text": "Did you hear that? It scared the mess out of me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb0f9ab-1789-32a0-acf6-a34d34114612",
                                        "entry_id": "b7b8c4a2-5a15-3b12-805e-c7c52b19c3a5",
                                        "glosses": [
                                            "a person in a state of (especially emotional) turmoil or disarray; an emotional wreck"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6b69db-aeb9-4eb0-babb-8f11d5ac860e",
                                                "sense_id": "ccb0f9ab-1789-32a0-acf6-a34d34114612",
                                                "text": "Between the pain and the depression, I'm a mess."
                                            },
                                            {
                                                "example_id": "02e226da-81fc-48e0-ace8-5ce6567f591f",
                                                "sense_id": "ccb0f9ab-1789-32a0-acf6-a34d34114612",
                                                "text": "He's been a mess and a half ever since you excommunicated him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
