{
    "word_family": [
        "clobbering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f705209e-2118-3a46-9b54-48629d056f81",
                    "sense_definition": "To hit or bash severely; to defeat decisively or cause serious damage to.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hit_or_defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion managed to <w>clobber</w> his opponent in the very first round of the match.",
                            "target_lang_translations": {
                                "ru": "Чемпиону удалось <w>разгромить</w> своего соперника в самом первом раунде матча."
                            }
                        },
                        {
                            "text": "Local businesses were <w>clobbered</w> by the sudden increase in taxes.",
                            "target_lang_translations": {
                                "ru": "По местному бизнесу больно <w>ударило</w> внезапное повышение налогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "bash",
                        "batter",
                        "pummel",
                        "thrash"
                    ],
                    "common_phrases": [
                        "clobber the competition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts to describe physical hitting or heavy defeat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить, избить; нанести сокрушительное поражение или причинить серьезный ущерб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избивать",
                                "target_lang_sense_clarification": "наносить сильные побои"
                            },
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести сокрушительное поражение"
                            },
                            {
                                "target_lang_word": "сильно ударить",
                                "target_lang_sense_clarification": "физически ударить"
                            },
                            {
                                "target_lang_word": "больно ударить по",
                                "target_lang_sense_clarification": "нанести серьезный ущерб, например, бизнесу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c05e1ed-f157-3e55-8fa9-5c1ededc9171",
                    "sense_definition": "To overwrite data or override a value, often unintentionally or unexpectedly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overwrite_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>clobber</w> the existing configuration file when you run the installation script.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>перезаписать</w> существующий конфигурационный файл при запуске установочного скрипта."
                            }
                        },
                        {
                            "text": "The buggy function accidentally <w>clobbered</w> the memory address of the main program.",
                            "target_lang_translations": {
                                "ru": "Функция с багом случайно <w>затерла</w> адрес памяти основной программы."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwrite",
                        "override"
                    ],
                    "common_phrases": [
                        "clobber the memory"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used primarily in computer programming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перезаписать данные или переопределить значение, часто непреднамеренно или неожиданно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезаписать",
                                "target_lang_sense_clarification": "записать поверх существующих данных"
                            },
                            {
                                "target_lang_word": "затереть",
                                "target_lang_sense_clarification": "уничтожить данные путем перезаписи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03f5fce7-88ee-3f04-af47-23ac5c7e4cb7",
                    "sense_definition": "Clothing or personal belongings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_and_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on his best <w>clobber</w> before heading out to the party.",
                            "target_lang_translations": {
                                "ru": "Он надел свои лучшие <w>шмотки</w>, прежде чем отправиться на вечеринку."
                            }
                        },
                        {
                            "text": "We packed all our wet <w>clobber</w> into the back of the car after the hike.",
                            "target_lang_translations": {
                                "ru": "После похода мы сложили все наши мокрые <w>вещи</w> в багажник машины."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothing",
                        "gear",
                        "garb",
                        "togs"
                    ],
                    "common_phrases": [
                        "best clobber"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly British, Australian, and New Zealand slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for clothes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда или личные вещи (разговорное, преимущественно брит.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шмотки",
                                "target_lang_sense_clarification": "разговорное обозначение одежды"
                            },
                            {
                                "target_lang_word": "одежда",
                                "target_lang_sense_clarification": "вещи, которые носят"
                            },
                            {
                                "target_lang_word": "пожитки",
                                "target_lang_sense_clarification": "личные вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e2ba764-8d24-3ec1-bd41-b16b9a394e8e",
                    "sense_definition": "Equipment, gear, or tackle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_and_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you bring all your fishing <w>clobber</w> for the weekend trip.",
                            "target_lang_translations": {
                                "ru": "Обязательно возьми все свои рыболовные <w>снасти</w> для поездки на выходные."
                            }
                        },
                        {
                            "text": "The garage was filled with old gardening <w>clobber</w> that hadn't been used in years.",
                            "target_lang_translations": {
                                "ru": "Гараж был забит старым садовым <w>снаряжением</w>, которым не пользовались много лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "equipment",
                        "gear",
                        "kit",
                        "tackle"
                    ],
                    "common_phrases": [
                        "fishing clobber"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly British and Commonwealth informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снаряжение, экипировка или снасти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снаряжение",
                                "target_lang_sense_clarification": "экипировка или снасти"
                            },
                            {
                                "target_lang_word": "прибамбасы",
                                "target_lang_sense_clarification": "разговорное обозначение оборудования или снастей"
                            },
                            {
                                "target_lang_word": "снасти",
                                "target_lang_sense_clarification": "рыболовные или иные приспособления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfef3437-06fe-3149-b49a-201415b65608",
                    "sense_definition": "A heavy blow, thumping, or beating.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_blow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got a nasty <w>clobber</w> on the side of his head during the scuffle.",
                            "target_lang_translations": {
                                "ru": "Во время потасовки он получил неприятный <w>удар</w> в бок головы."
                            }
                        },
                        {
                            "text": "One more <w>clobber</w> like that would have knocked him completely unconscious.",
                            "target_lang_translations": {
                                "ru": "Еще один такой <w>удар</w> полностью лишил бы его чувств."
                            }
                        }
                    ],
                    "synonyms": [
                        "blow",
                        "thump",
                        "whack",
                        "beating"
                    ],
                    "common_phrases": [
                        "nasty clobber"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal noun usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный удар, затрещина или избиение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "сильный физический удар"
                            },
                            {
                                "target_lang_word": "затрещина",
                                "target_lang_sense_clarification": "сильный удар рукой"
                            },
                            {
                                "target_lang_word": "зуботычина",
                                "target_lang_sense_clarification": "разговорное обозначение удара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7ecbdf-bba5-3aa2-a91e-bd70c31cbff5",
                    "sense_definition": "A paste used by shoemakers to fill up and conceal cracks in leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shoemaking_paste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler applied a thick layer of <w>clobber</w> to hide the deep cracks in the old boots.",
                            "target_lang_translations": {
                                "ru": "Сапожник нанес толстый слой <w>замазки</w>, чтобы скрыть глубокие трещины на старых ботинках."
                            }
                        },
                        {
                            "text": "Using cheap <w>clobber</w> only temporarily masks the damage to the leather.",
                            "target_lang_translations": {
                                "ru": "Использование дешевой <w>замазки</w> лишь временно маскирует повреждения кожи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical shoemaking term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паста или замазка, используемая сапожниками для заполнения и скрытия трещин в коже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сапожная замазка",
                                "target_lang_sense_clarification": "паста для скрытия трещин в коже"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}