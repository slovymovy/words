    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                    "sense_definition": "Short for <w>medication</w> or medicine, especially prescribed drugs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs to take his <w>meds</w> every morning to stay healthy.",
                            "target_lang_translations": {
                                "ru": "Ему нужно принимать <w>лекарства</w> каждое утро, чтобы оставаться здоровым.",
                                "zh": "他每天早上都需要服用<w>药物</w>以保持健康。"
                            }
                        },
                        {
                            "text": "The doctor decided to change her <w>meds</w> after the checkup.",
                            "target_lang_translations": {
                                "ru": "Врач решил сменить ей <w>препараты</w> после осмотра.",
                                "zh": "医生在检查后决定更换她的<w>药物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "medication",
                        "medicine",
                        "drug"
                    ],
                    "common_phrases": [
                        "take meds",
                        "on meds",
                        "off meds"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in the plural form 'meds'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «medication» (лекарство) или «medicine», особенно в отношении прописанных препаратов.",
                        "zh": "指药物或处方药的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарства",
                                "target_lang_sense_clarification": "препараты, таблетки"
                            },
                            {
                                "target_lang_word": "медикаменты",
                                "target_lang_sense_clarification": "медицинские препараты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药物",
                                "target_lang_sense_clarification": "指代药品或处方药"
                            },
                            {
                                "target_lang_word": "药",
                                "target_lang_sense_clarification": "药物的通称"
                            }
                        ]
                    }
