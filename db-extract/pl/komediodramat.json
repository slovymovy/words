                "senses": [
                    {
                        "sense_id": "10aff2bb-1378-3b29-bb67-bccd387d83a4",
                        "entry_id": "e7cf10c4-aebb-39dc-a2b7-26235e2a6f6e",
                        "glosses": [
                            "dzieło sceniczne łączące elementy komedii i dramatu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eaf9d6f-adab-4e1c-8b48-d4bc4b385b84",
                                "sense_id": "10aff2bb-1378-3b29-bb67-bccd387d83a4",
                                "text": "Sami twórcy nie ukrywają, że stworzenie udanego komediodramatu wymaga ponadprzeciętnego warsztatu – niełatwo bowiem zgrabnie połączyć ze sobą elementy komiczne z tragicznymi, tak by tworzyły one spójną całość"
                            },
                            {
                                "example_id": "714486c6-7e94-4fc5-b861-d1bb8fb57692",
                                "sense_id": "10aff2bb-1378-3b29-bb67-bccd387d83a4",
                                "text": "Zapraszamy Państwa na premierowy pokaz francuskiego komediodramatu z 2013 roku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
