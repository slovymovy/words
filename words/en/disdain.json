{
    "word_family": [
        "disdainful",
        "disdainfully",
        "disdainfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                    "sense_definition": "A feeling of intense dislike or lack of respect for someone or something considered unworthy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling_of_contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat viewed the cheap supermarket catfood with <w>disdain</w> and stalked away.",
                            "target_lang_translations": {
                                "cs": "Kočka se na levné supermarketové krmivo dívala s <w>pohrdáním</w> a odkráčela pryč."
                            }
                        },
                        {
                            "text": "He looked at the messy room with <w>disdain</w> and refused to enter.",
                            "target_lang_translations": {
                                "cs": "Podíval se na ten nepořádek v pokoji s <w>opovržením</w> a odmítl vstoupit."
                            }
                        }
                    ],
                    "synonyms": [
                        "contempt",
                        "scorn"
                    ],
                    "antonyms": [
                        "respect",
                        "admiration"
                    ],
                    "common_phrases": [
                        "view with disdain",
                        "treat with disdain"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit silného odporu nebo nedostatek úcty k někomu či něčemu, co je považováno za bezcenné."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pohrdání",
                                "target_lang_sense_clarification": "obecný výraz pro pocit nedostatku úcty"
                            },
                            {
                                "target_lang_word": "opovržení",
                                "target_lang_sense_clarification": "silnější, formálnější vyjádření morální převahy"
                            },
                            {
                                "target_lang_word": "despekt",
                                "target_lang_sense_clarification": "postoj vyjadřující neúctu nebo přehlížení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3416f395-0f60-3ee9-a45e-da7d2e4d4438",
                    "sense_definition": "The state of being looked down upon or treated with shame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_of_contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen leader lived in <w>disdain</w> after his public failure.",
                            "target_lang_translations": {
                                "cs": "Poražený vůdce žil po svém veřejném selhání v <w>opovržení</w>."
                            }
                        },
                        {
                            "text": "She suffered the <w>disdain</w> of her peers after the scandal broke.",
                            "target_lang_translations": {
                                "cs": "Poté, co vypukl skandál, trpěla <w>opovržením</w> svých vrstevníků."
                            }
                        }
                    ],
                    "antonyms": [
                        "honor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav, kdy je někdo přehlížen nebo vystaven hanbě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opovržení",
                                "target_lang_sense_clarification": "stav, kdy je někdo společensky vnímán negativně"
                            },
                            {
                                "target_lang_word": "hanba",
                                "target_lang_sense_clarification": "stav společenského ponížení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b11ae4f-0e18-3b3a-97ca-5ca84195b299",
                    "sense_definition": "Something that is considered unworthy or deserving of contempt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_of_contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal act was a <w>disdain</w> to the entire community.",
                            "target_lang_translations": {
                                "cs": "Ten zločinný čin byl pro celou komunitu <w>ostudou</w>."
                            }
                        },
                        {
                            "text": "Such behavior is a <w>disdain</w> to those who value honesty.",
                            "target_lang_translations": {
                                "cs": "Takové chování je <w>urážkou</w> pro ty, kteří si váží poctivosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "abomination"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co je považováno za nehodné nebo zasluhující opovržení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ostuda",
                                "target_lang_sense_clarification": "něco, co vyvolává opovržení nebo hanbu"
                            },
                            {
                                "target_lang_word": "ohavnost",
                                "target_lang_sense_clarification": "něco morálně zavrženíhodného"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "393bc841-b09c-3294-b83e-0b442f28fd26",
                    "sense_definition": "To regard someone or something with strong contempt or to consider them unworthy of notice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling_of_contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrogant man <w>disdained</w> the advice of his younger colleagues.",
                            "target_lang_translations": {
                                "cs": "Ten arogantní muž <w>pohrdal</w> radami svých mladších kolegů."
                            }
                        },
                        {
                            "text": "Many people <w>disdain</w> the idea of government interference in their private lives.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí <w>opovrhuje</w> myšlenkou vládních zásahů do jejich soukromého života."
                            }
                        }
                    ],
                    "synonyms": [
                        "contemn"
                    ],
                    "antonyms": [
                        "respect",
                        "admire"
                    ],
                    "common_phrases": [
                        "disdain the idea"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohlížet na někoho nebo něco s velkým opovržením nebo to považovat za nestojící za pozornost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pohrdat",
                                "target_lang_sense_clarification": "cítit naprostou absenci úcty"
                            },
                            {
                                "target_lang_word": "opovrhovat",
                                "target_lang_sense_clarification": "považovat někoho za kvalitativně horšího"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a84874-d89b-35f6-8d67-a3306b7ab8be",
                    "sense_definition": "To feel indignant or offended by something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_of_contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officials <w>disdained</w> at the crowd's rude behavior during the speech.",
                            "target_lang_translations": {
                                "cs": "Úředníci se <w>pohoršovali</w> nad hrubým chováním davu během projevu."
                            }
                        },
                        {
                            "text": "They <w>disdained</w> at the suggestion that they were responsible for the error.",
                            "target_lang_translations": {
                                "cs": "Byli <w>uraženi</w> návrhem, že jsou za tu chybu zodpovědní."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Cítit rozhořčení nebo být něčím uražen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pohoršovat se",
                                "target_lang_sense_clarification": "cítit morální rozhořčení"
                            },
                            {
                                "target_lang_word": "být uražen",
                                "target_lang_sense_clarification": "cítit se dotčen něčím jednáním"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}