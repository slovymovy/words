        "fr-extract.jsonl": [
            {
                "entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                "word": "actualisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba5424ae-e69c-4c8e-977a-e78a170cb793",
                        "entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "tags": [
                            "plural"
                        ],
                        "form": "actualismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2b6284f-b1f9-39b6-8105-2be6388d7d7d",
                        "entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "glosses": [
                            "Doctrine qui insiste sur les nécessités de la vie et de l'action, des actes, ce qui est actuel, plus que sur les principes théoriques, immanents, ontologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c85176-5349-43e5-b583-bcc9121f08b7",
                                "sense_id": "b2b6284f-b1f9-39b6-8105-2be6388d7d7d",
                                "text": "Prendre la file immédiate, étudier le passé qui agit de façon distincte et continue sur nous, se placer au point de vue du présent, c’est l’actualisme, ou si l’on veut l’activisme que nous croyons justifié dans les recherches morales."
                            },
                            {
                                "example_id": "fcbbbd8c-6d19-4925-8db0-6b70e91f4f0f",
                                "sense_id": "b2b6284f-b1f9-39b6-8105-2be6388d7d7d",
                                "text": "Nous devinons l'infini sans pouvoir l’évaluer à tant ou tant. En l'espèce, nous ne pouvons décider s’il est pair ou impair, tout nombre pair renvoyant à un nombre impair plus grand que lui et réciproquement. C’est le quantum fixé, nombré, assigné qui consacre la méconnaissance de l'infini. En vertu d'un actualisme nominaliste valable pour ce monde d’alternative et machiavéliquement appliqué au tout-autre-ordre par l’effet de notre mauvaise foi, la détermination implique finitude comme la représentation particulière implique un arrêt de la pensée."
                            }
                        ]
                    },
                    {
                        "sense_id": "987123f9-5d4a-376c-989f-722692cf3d1d",
                        "entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "glosses": [
                            "Doctrine qui explique les phénomènes géologiques du passé de la terre par les mêmes causes qui produisent les phénomènes effectifs actuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73872575-0d67-4dca-bf35-6faff04b0617",
                                "sense_id": "987123f9-5d4a-376c-989f-722692cf3d1d",
                                "text": "Une « école française » se fortifie de plus en plus, que nous qualifierons d’actualisme non quantitatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "debe2655-b646-4239-ad8d-5df247ea9dc3",
                        "source_entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "source_sense_description": "Actualisme (Philosophie)",
                        "target_lang_word": "actualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5d4c043-30fa-3bf8-b6c6-69413f38886b",
                                        "entry_id": "c3bfbf30-41ca-3b81-905c-467615920ced",
                                        "glosses": [
                                            "The belief that actuality and existence are co‐extensive: i.e., that only actual things exist, and merely possible things do not."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bd61069-4a0d-4a15-97fb-57ba5f0fa6f1",
                        "source_entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "source_sense_description": "Actualisme (Géologie)",
                        "target_lang_word": "uniformitarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformitarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df8f5c7e-ebf8-3454-bf1b-1e6ed217c457",
                                        "entry_id": "61dacce1-cab2-3af4-b400-740b3370bbb0",
                                        "glosses": [
                                            "The scientific principle that natural laws and processes operated in the past in the same way and at the same rates that they operate today, and sometimes in the same way everywhere in the universe as well."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dac29d7-d5ed-4ac9-a7fb-4278b49cf0da",
                                                "sense_id": "df8f5c7e-ebf8-3454-bf1b-1e6ed217c457",
                                                "text": "There has been much puffy stuff written about whether Lyell's uniformitarianism permitted variations in intensity of causes, or whether he applied his logic in a consistent way, and whether he assumed indefinite stretches of geological time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
