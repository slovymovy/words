                                        "entry_id": "05f97cd0-2221-3f14-9e73-20f8ebb3f2c3",
                                        "glosses": [
                                            "die Pflanzenart Curcuma longa, Angehöriger einer Gattung der Ingwergewächse Zingiberaceae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cee777e-ab10-490a-9516-741fe788303b",
                                                "sense_id": "cfde2206-980e-3344-9d77-f53c95a24446",
                                                "text": "„Ich kenne doch Kurkuma.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7bab550-476b-33e2-ac7d-e2c23bfaa36b",
                                        "entry_id": "05f97cd0-2221-3f14-9e73-20f8ebb3f2c3",
                                        "glosses": [
                                            "auch: das Kurkuma; Gewürz aus den Gelbwurzeln der Kurkuma, auch verwendet zur Herstellung von Curry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac60c79-b8de-4422-be22-5ec6d6125d0c",
                                                "sense_id": "a7bab550-476b-33e2-ac7d-e2c23bfaa36b",
                                                "text": "„Das Rezept ist übrigens sehr gut, es geht aber auch mit Kurkuma.“"
                                            }
