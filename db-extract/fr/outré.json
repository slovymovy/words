                "senses": [
                    {
                        "sense_id": "0766f6bf-e598-3882-ab95-705382c6d1db",
                        "entry_id": "34216f3d-6606-3854-ab67-095463ade5dc",
                        "glosses": [
                            "Qui est excessif, exagéré, qui passe les bornes prescrites par la raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98894ccb-3899-4e99-941a-cd14d6c88454",
                                "sense_id": "0766f6bf-e598-3882-ab95-705382c6d1db",
                                "text": "Une pensée outrée."
                            },
                            {
                                "example_id": "fa9ef7e4-9cbb-42fc-85ef-a96024470978",
                                "sense_id": "0766f6bf-e598-3882-ab95-705382c6d1db",
                                "text": "Sa morale est outrée."
                            },
                            {
                                "example_id": "02970755-90d4-4cbc-aee8-d575ab5a8600",
                                "sense_id": "0766f6bf-e598-3882-ab95-705382c6d1db",
                                "text": "La traduction de Mudwoman paraît en octobre chez Philippe Rey, dernière livraison d’une production outrée d’une centaine de titres."
                            },
                            {
                                "example_id": "486ad790-a913-4b3a-b658-83ea234b5352",
                                "sense_id": "0766f6bf-e598-3882-ab95-705382c6d1db",
                                "text": "Cet homme est outré en tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "81c4e30a-f855-3437-923b-326843506a68",
                        "entry_id": "34216f3d-6606-3854-ab67-095463ade5dc",
                        "glosses": [
                            "Qui est poussé à bout, qui est transporté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d713a61d-766f-4c60-ba45-f1c58f50c889",
                                "sense_id": "81c4e30a-f855-3437-923b-326843506a68",
                                "text": "Outré de douleur, de dépit, de colère."
                            }
                        ]
                    },
                    {
                        "sense_id": "601c5462-64e3-30cb-9ba7-b72b684016ca",
                        "entry_id": "34216f3d-6606-3854-ab67-095463ade5dc",
                        "glosses": [
                            "Qui est révolté de colère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69924ede-fb82-4d44-b71a-ba0cec31feab",
                                "sense_id": "601c5462-64e3-30cb-9ba7-b72b684016ca",
                                "text": "Une maman qui allaitait son fils dans un restaurant s'est vu apostropher par un client visiblement outré qui lui a demandé de se couvrir car cela le dérangeait."
                            },
                            {
                                "example_id": "0909095e-cb1b-4abe-b8f5-a71b5f33fd08",
                                "sense_id": "601c5462-64e3-30cb-9ba7-b72b684016ca",
                                "text": "Il est outré de vos refus, de vos injures."
                            },
                            {
                                "example_id": "5c20f005-69eb-4f7c-8467-a875520fa5a4",
                                "sense_id": "601c5462-64e3-30cb-9ba7-b72b684016ca",
                                "text": "Il est outré."
                            }
                        ]
                    }
                ],
