                                        "glosses": [
                                            "Titre que l’on donne en Angleterre à la femme d’un lord ou d’un baronnet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a0fa5d-e0d7-4f68-a1f7-13ce08d6d896",
                                                "sense_id": "87734533-8fab-3225-8e31-11922de7c12d",
                                                "text": "Trois mousquetaires et une milady au milieu, lâcha l’adjudant en captant aussitôt les regards sidérés des époux."
                                            }
                                        ]
                                    }
