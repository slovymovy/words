                "senses": [
                    {
                        "sense_id": "55188369-20db-366f-aaed-f610525ccdda",
                        "entry_id": "76666920-324b-37b1-85b7-5ff999c7c232",
                        "glosses": [
                            "устар. уроженец, гражданин Венгрии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f558ed-f930-45e8-b511-0a9dde3b0b5f",
                                "sense_id": "55188369-20db-366f-aaed-f610525ccdda",
                                "text": "Нашёлся среди офицеров отчаянный парень ― венгерец, лейтенант Шайно."
                            }
                        ]
                    },
                    {
                        "sense_id": "39bebb59-2848-38e0-8673-695fbf53ef23",
                        "entry_id": "76666920-324b-37b1-85b7-5ff999c7c232",
                        "glosses": [
                            "диал. странствующий торговец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a8ae4e-e8dc-4413-b4d5-a3a7065f049d",
                                "sense_id": "39bebb59-2848-38e0-8673-695fbf53ef23",
                                "text": "Венгерец, как известно, был в шляпе с широкими полями и сферической тульей, в широком синем плаще, с коробкою за плечами, с палкою длинною в руке и с длинными усами."
                            }
                        ]
                    }
                ],
