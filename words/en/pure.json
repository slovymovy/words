                },
                {
                    "sense_id": "9c068a1f-69e8-32de-b6df-59dd4bb29d49",
                    "sense_definition": "Free of immoral behavior, guilt, or evil thoughts; innocent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>pure</w> heart and always tries to help others.",
