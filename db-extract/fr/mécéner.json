                ],
                "senses": [
                    {
                        "sense_id": "30b7f465-a71a-31b9-9c1f-390450bf85da",
                        "entry_id": "77fa6ea7-c979-31fb-98e3-e25fdb24251d",
                        "glosses": [
                            "Financer en tant que mécène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a587451-15fa-4930-be56-b66bc3bd30e8",
                                "sense_id": "30b7f465-a71a-31b9-9c1f-390450bf85da",
                                "text": "Plusieurs boîtes du CAC 40 ne demanderaient qu’à mécéner — et l’on emmerdait le Crédit Lyonnais."
                            },
                            {
                                "example_id": "e7c55456-4df3-486e-9290-0ab3074454c7",
                                "sense_id": "30b7f465-a71a-31b9-9c1f-390450bf85da",
                                "text": "Il n’hésitait pas non plus à « mécéner », comme il disait, de jeunes peintres ou sculpteurs : ses achats artistiques stimulaient son goût du risque et de l’entrepreneuriat."
                            },
                            {
                                "example_id": "500abce1-fd2e-4966-b59f-9c2af4a651ae",
                                "sense_id": "30b7f465-a71a-31b9-9c1f-390450bf85da",
                                "text": "Jeudi du mécénat « Mécéner la photographie »."
                            },
                            {
                                "example_id": "514cf446-ba5a-4063-a1dc-a81f31e6a0b9",
                                "sense_id": "30b7f465-a71a-31b9-9c1f-390450bf85da",
                                "text": "Si l’effet de souffle abat la comtesse du cinéma, sa volonté la [Albina du Boisrouvray] réincarne en bienfaitrice déployée, chez Médecins du monde puis, sous le sigle FXB, pour François-Xavier Bagnoud, elle engage sa fortune dans une ONG mécénant des orphelins du sida, des unités de soins palliatifs, des microentreprises en Inde et en Afrique."
                            }
                        ]
                    }
