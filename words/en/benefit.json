{
    "word_family": [
        "beneficial",
        "beneficiary",
        "benefactor",
        "beneficially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                    "sense_definition": "An advantage, profit, or helpful effect gained from something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "advantage_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise has many health <w>benefits</w> for people of all ages.",
                            "target_lang_translations": {
                                "ru": "Регулярные физические упражнения приносят много <w>пользы</w> здоровью людей всех возрастов.",
                                "tr": "Düzenli egzersizin her yaştan insan için birçok sağlık <w>faydası</w> vardır.",
                                "zh": "经常锻炼对各年龄段的人都有很多健康<w>好处</w>。"
                            }
                        },
                        {
                            "text": "We should work together for the mutual <w>benefit</w> of our community.",
                            "target_lang_translations": {
                                "ru": "Мы должны работать вместе ради общего <w>блага</w> нашего сообщества.",
                                "tr": "Topluluğumuzun karşılıklı <w>yararı</w> için birlikte çalışmalıyız.",
                                "zh": "我们应该为了社区的共同<w>利益</w>而共同努力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advantage",
                        "help",
                        "boon",
                        "gain",
                        "plus"
                    ],
                    "antonyms": [
                        "disadvantage",
                        "detriment",
                        "harm",
                        "hindrance",
                        "obstacle"
                    ],
                    "common_phrases": [
                        "for the benefit of",
                        "reap the benefits",
                        "mutual benefit",
                        "of benefit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преимущество, прибыль или полезный эффект, полученный от чего-либо.",
                        "tr": "Bir şeyden elde edilen avantaj, yarar veya olumlu etki.",
                        "zh": "从某事中获得的优势、利润或有益的效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́льза",
                                "target_lang_sense_clarification": "положительное, благотворное влияние"
                            },
                            {
                                "target_lang_word": "вы́года",
                                "target_lang_sense_clarification": "прибыль, доход или личный интерес"
                            },
                            {
                                "target_lang_word": "преиму́щество",
                                "target_lang_sense_clarification": "качество, выгодно отличающее от других"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fayda",
                                "target_lang_sense_clarification": "olumlu, yararlı etki"
                            },
                            {
                                "target_lang_word": "yarar",
                                "target_lang_sense_clarification": "sağlanan iyilik, olumlu sonuç"
                            },
                            {
                                "target_lang_word": "avantaj",
                                "target_lang_sense_clarification": "üstünlük, kolaylık sağlayan durum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好处",
                                "target_lang_sense_clarification": "指有益的方面或结果"
                            },
                            {
                                "target_lang_word": "益处",
                                "target_lang_sense_clarification": "指有益的帮助或效果"
                            },
                            {
                                "target_lang_word": "利益",
                                "target_lang_sense_clarification": "指对个人或集体有益的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f10882f-09b1-33aa-9103-73d0e9ec4762",
                    "sense_definition": "Money provided by the government or an insurance company to help someone in need, such as when they are sick, unemployed, or retired.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost his job last month and now claims unemployment <w>benefits</w>.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце он потерял работу и теперь получает <w>пособие</w> по безработице.",
                                "tr": "Geçen ay işini kaybetti ve şimdi işsizlik <w>ödeneği</w> alıyor.",
                                "zh": "他上个月失业了，现在正在领取失业<w>津贴</w>。"
                            }
                        },
                        {
                            "text": "The insurance policy includes a substantial death <w>benefit</w> for the family.",
                            "target_lang_translations": {
                                "ru": "Страховой полис предусматривает значительную <w>выплату</w> семье в случае смерти.",
                                "tr": "Sigorta poliçesi, aile için önemli miktarda ölüm <w>tazminatı</w> içeriyor.",
                                "zh": "这份保险单包含一笔给家属的丰厚死亡<w>保险金</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subsidy",
                        "aid",
                        "assistance"
                    ],
                    "common_phrases": [
                        "unemployment benefit",
                        "housing benefit",
                        "claim benefits",
                        "social security benefit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, предоставляемые государством или страховой компанией для помощи нуждающимся (больным, безработным и т.д.).",
                        "tr": "Devlet veya sigorta şirketi tarafından hasta, işsiz veya emekli gibi ihtiyaç sahiplerine sağlanan para.",
                        "zh": "政府或保险公司为生病、失业或退休等有需要的人提供的经济援助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посо́бие",
                                "target_lang_sense_clarification": "денежная помощь от государства"
                            },
                            {
                                "target_lang_word": "социа́льная вы́плата",
                                "target_lang_sense_clarification": "материальная помощь"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ödenek",
                                "target_lang_sense_clarification": "devlet veya kurum tarafından sağlanan para"
                            },
                            {
                                "target_lang_word": "yardım",
                                "target_lang_sense_clarification": "sosyal veya maddi destek"
                            },
                            {
                                "target_lang_word": "tazminat",
                                "target_lang_sense_clarification": "sigorta vb. ödemeleri"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "津贴",
                                "target_lang_sense_clarification": "政府发放的补助金"
                            },
                            {
                                "target_lang_word": "救济金",
                                "target_lang_sense_clarification": "针对失业或贫困的经济援助"
                            },
                            {
                                "target_lang_word": "保险金",
                                "target_lang_sense_clarification": "保险公司支付的赔偿或给付"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                    "sense_definition": "The sake or personal interest of a specific person, often used when doing something specifically to help, inform, or impress them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advantage_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke loudly for my <w>benefit</w> so that I would definitely hear the news.",
                            "target_lang_translations": {
                                "ru": "Она говорила громко специально для моего <w>сведения</w>, чтобы я точно услышал новости.",
                                "tr": "Haberleri kesinlikle duyayım diye benim <w>yararıma</w> yüksek sesle konuştu.",
                                "zh": "她大声说话是<w>为了</w>让我听清楚，好让我一定能听到这个消息。"
                            }
                        },
                        {
                            "text": "The demonstration was staged solely for the <w>benefit</w> of the new investors.",
                            "target_lang_translations": {
                                "ru": "Демонстрация была устроена исключительно в <w>интересах</w> новых инвесторов.",
                                "tr": "Gösteri sadece yeni yatırımcıların <w>çıkarı</w> doğrultusunda düzenlendi.",
                                "zh": "这次演示完全是<w>为了</w>新投资者而安排的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "for someone's benefit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личный интерес или благо конкретного человека; часто используется, когда что-то делается специально для него.",
                        "tr": "Belirli bir kişinin çıkarı veya kişisel yararı; genellikle birine yardımcı olmak, bilgi vermek veya onu etkilemek amacıyla yapıldığında kullanılır.",
                        "zh": "为了某人的利益或个人好处，通常指专门为了帮助、告知或给某人留下印象而做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интере́с",
                                "target_lang_sense_clarification": "личная заинтересованность, выгода"
                            },
                            {
                                "target_lang_word": "бла́го",
                                "target_lang_sense_clarification": "добро, счастье, благополучие"
                            },
                            {
                                "target_lang_word": "ра́ди",
                                "target_lang_sense_clarification": "предлог, указывающий на пользу для кого-то (for someone's benefit)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yarar",
                                "target_lang_sense_clarification": "birinin çıkarı veya faydası (örn. onun yararına)"
                            },
                            {
                                "target_lang_word": "çıkar",
                                "target_lang_sense_clarification": "kişisel menfaat, yarar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利益",
                                "target_lang_sense_clarification": "指为了某人的好处"
                            },
                            {
                                "target_lang_word": "为了……着想",
                                "target_lang_sense_clarification": "指考虑某人的需求或好处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccd8618e-19b3-39c1-9e12-8643c7755d89",
                    "sense_definition": "A public event, such as a concert or performance, held to raise money for a charitable cause.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "event_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>benefit</w> to raise funds for the local hospital.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>благотворительный концерт</w>, чтобы собрать средства для местной больницы.",
                                "tr": "Grup, yerel hastaneye fon sağlamak için bir <w>hayır konseri</w> verdi.",
                                "zh": "乐队举办了一场<w>慈善义演</w>，为当地医院筹集资金。"
                            }
                        },
                        {
                            "text": "Tickets for the charity <w>benefit</w> were sold out within hours.",
                            "target_lang_translations": {
                                "ru": "Билеты на благотворительный <w>вечер</w> были распроданы за несколько часов.",
                                "tr": "Hayır kurumu <w>etkinliği</w> biletleri birkaç saat içinde tükendi.",
                                "zh": "这场<w>慈善活动</w>的门票在几小时内就售罄了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "benefit concert",
                        "benefit performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное мероприятие (концерт, представление), проводимое для сбора средств на благотворительность.",
                        "tr": "Bir hayır kurumu için para toplamak amacıyla düzenlenen konser veya gösteri gibi halka açık etkinlik.",
                        "zh": "为慈善事业筹集资金而举办的公开活动，如音乐会或表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотвори́тельный конце́рт",
                                "target_lang_sense_clarification": "концерт для сбора средств"
                            },
                            {
                                "target_lang_word": "бенефи́с",
                                "target_lang_sense_clarification": "спектакль в честь одного участника (иногда благотворительный)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hayır etkinliği",
                                "target_lang_sense_clarification": "bağış toplama amaçlı gösteri veya gece"
                            },
                            {
                                "target_lang_word": "fayda konseri",
                                "target_lang_sense_clarification": "bağış toplamak için düzenlenen konser"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慈善义演",
                                "target_lang_sense_clarification": "为筹款而举办的表演活动"
                            },
                            {
                                "target_lang_word": "慈善活动",
                                "target_lang_sense_clarification": "为公益目的举办的活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                    "sense_definition": "To receive an advantage, profit, or good result from something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "receive_good",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students <w>benefit</w> greatly from small class sizes and individual attention.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>получают</w> огромную <w>пользу</w> от небольшого размера классов и индивидуального внимания.",
                                "tr": "Öğrenciler küçük sınıf mevcutlarından ve bireysel ilgiden büyük ölçüde <w>faydalanırlar</w>.",
                                "zh": "学生们从较小的班级规模和个性化关注中<w>受益</w>匪浅。"
                            }
                        },
                        {
                            "text": "I feel that I have <w>benefited</w> from listening to your advice.",
                            "target_lang_translations": {
                                "ru": "Я чувствую, что <w>извлек пользу</w> из твоих советов.",
                                "tr": "Tavsiyelerinizi dinlemekten <w>yarar gördüğümü</w> hissediyorum.",
                                "zh": "我觉得听了你的建议我<w>获益</w>良多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "benefit from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать преимущество, прибыль или хороший результат от чего-либо.",
                        "tr": "Bir şeyden avantaj, kazanç veya iyi bir sonuç elde etmek.",
                        "zh": "从某事中获得优势、利润或良好的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлека́ть по́льзу",
                                "target_lang_sense_clarification": "получать хороший результат"
                            },
                            {
                                "target_lang_word": "выи́грывать",
                                "target_lang_sense_clarification": "получать преимущество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "faydalanmak",
                                "target_lang_sense_clarification": "yarar sağlamak, iyi bir sonuç almak"
                            },
                            {
                                "target_lang_word": "yararlanmak",
                                "target_lang_sense_clarification": "olumlu etki görmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受益",
                                "target_lang_sense_clarification": "得到好处"
                            },
                            {
                                "target_lang_word": "获益",
                                "target_lang_sense_clarification": "获得利益或益处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                    "sense_definition": "To be helpful, useful, or good to someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "give_good",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tax laws will <w>benefit</w> families with young children.",
                            "target_lang_translations": {
                                "ru": "Новые налоговые законы <w>принесут пользу</w> семьям с маленькими детьми.",
                                "tr": "Yeni vergi kanunları küçük çocuklu ailelere <w>fayda sağlayacak</w>.",
                                "zh": "新的税法将<w>有益于</w>有小孩的家庭。"
                            }
                        },
                        {
                            "text": "This decision <w>benefits</w> the entire team, not just the manager.",
                            "target_lang_translations": {
                                "ru": "Это решение <w>идет на пользу</w> всей команде, а не только менеджеру.",
                                "tr": "Bu karar sadece yöneticiye değil, tüm takıma <w>yarar getiriyor</w>.",
                                "zh": "这个决定不仅对经理，而且对整个团队都<w>有益</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "help",
                        "aid",
                        "assist",
                        "serve"
                    ],
                    "antonyms": [
                        "harm"
                    ],
                    "common_phrases": [
                        "benefit society",
                        "benefit everyone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть полезным, приносить благо кому-либо или чему-либо.",
                        "tr": "Birine veya bir şeye yararlı, faydalı veya iyi gelmek.",
                        "zh": "对某人或某事有帮助、有用或有益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приноси́ть по́льзу",
                                "target_lang_sense_clarification": "быть полезным"
                            },
                            {
                                "target_lang_word": "идти́ на по́льзу",
                                "target_lang_sense_clarification": "оказывать благотворное влияние"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fayda sağlamak",
                                "target_lang_sense_clarification": "yararlı olmak, katkıda bulunmak"
                            },
                            {
                                "target_lang_word": "yarar getirmek",
                                "target_lang_sense_clarification": "olumlu sonuç doğurmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有益于",
                                "target_lang_sense_clarification": "对……有好处"
                            },
                            {
                                "target_lang_word": "造福",
                                "target_lang_sense_clarification": "给……带来利益"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}