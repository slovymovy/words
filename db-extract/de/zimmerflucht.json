                ],
                "senses": [
                    {
                        "sense_id": "2f5e3e59-5c42-37be-82d2-42c3b0c47b7f",
                        "entry_id": "7826fa95-84ea-3523-8cf9-65ca12bac9a8",
                        "glosses": [
                            "Enfilade, die Aneinanderreihung von Zimmern in gerader Linie mit mittiger Blickachse durch die hintereinander in einer Flucht angeordneten Türen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90fc082-8875-4e96-8a43-8bde1b92a35a",
                                "sense_id": "2f5e3e59-5c42-37be-82d2-42c3b0c47b7f",
                                "text": "„Sie schritt ihm voran durch die Zimmerflucht.“"
                            },
                            {
                                "example_id": "00bc7a36-31e4-4a6f-a781-3151c3e59fe0",
                                "sense_id": "2f5e3e59-5c42-37be-82d2-42c3b0c47b7f",
                                "text": "„Ich hatte mir eine riesige Zimmerflucht vorgestellt, mit Terrasse, weitem Blick über den East River und mindestens einem Bediensteten an der Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3abbffbf-bea8-38aa-821a-ddf95d2281c3",
                        "entry_id": "7826fa95-84ea-3523-8cf9-65ca12bac9a8",
                        "glosses": [
                            "Architektur: allgemein eine Anordnung oder Abfolge von funktional zusammengehörigen Zimmern, die durch Türen miteinander verbunden sind, Suite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b603e2e9-185b-4148-b734-eb2965c1a372",
                                "sense_id": "3abbffbf-bea8-38aa-821a-ddf95d2281c3",
                                "text": "„Ich hatte mir eine riesige Zimmerflucht vorgestellt, mit Terrasse, weitem Blick über den East River und mindestens einem Bediensteten an der Tür.“"
                            },
                            {
                                "example_id": "d936fb0a-0ac2-4874-9be2-1c65dda9cec3",
                                "sense_id": "3abbffbf-bea8-38aa-821a-ddf95d2281c3",
                                "text": "Eine Zimmerflucht stellt eine funktionale Nutzungseinheit dar."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de2ac8c3-c230-4b31-8de8-267550ec7e10",
                        "source_entry_id": "7826fa95-84ea-3523-8cf9-65ca12bac9a8",
                        "source_sense_id": "2f5e3e59-5c42-37be-82d2-42c3b0c47b7f",
                        "source_sense_description": "Architektur: eine Abfolge von Zimmern, die durch Türen miteinander verbunden sind",
                        "target_lang_word": "suite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75ea1ef2-30c5-3d15-8c2a-667450c7fc11",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "A group or train of attendants, servants etc.; a retinue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676786b6-c7b4-4182-be57-95e0e9b6afa8",
                                                "sense_id": "75ea1ef2-30c5-3d15-8c2a-667450c7fc11",
                                                "text": "[A]s to men, we shall live altogether at the Duc de Romagnecourt's, his suite of servants will be ours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07fd446d-6690-3e36-8fb4-a04b9a06e593",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "A connected series or succession of objects; a number of things used or classed together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e8a1dd-fd36-49a2-86f2-baaed61e35d7",
                                                "sense_id": "07fd446d-6690-3e36-8fb4-a04b9a06e593",
                                                "text": "a suite of rooms"
                                            },
                                            {
                                                "example_id": "2245b019-dec2-4138-9192-2ca2c0fc64c7",
                                                "sense_id": "07fd446d-6690-3e36-8fb4-a04b9a06e593",
                                                "text": "a suite of minerals"
                                            },
                                            {
                                                "example_id": "6700881f-02a9-439c-a611-101fab18d01b",
                                                "sense_id": "07fd446d-6690-3e36-8fb4-a04b9a06e593",
                                                "text": "Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            },
                                            {
                                                "example_id": "b3de90fb-27d6-4d6c-a5e3-7861ee84b663",
                                                "sense_id": "07fd446d-6690-3e36-8fb4-a04b9a06e593",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f4969b-604e-30df-a2a4-291f12cb3406",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "A group of connected rooms, usually separable from other rooms by means of access."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51525841-4ad4-47c8-b12d-12107ec0ef03",
                                                "sense_id": "14f4969b-604e-30df-a2a4-291f12cb3406",
                                                "text": "The Presidential suite is well appointed and allows for good security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0af165-66c8-3d74-bfaa-2c56648d6822",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "A musical form, popular before the time of the sonata, consisting of a string or series of pieces all in the same key, mostly in various dance rhythms, with sometimes an elaborate prelude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "889d5c27-326f-3562-8afc-ae48e484a51a",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "An excerpt of instrumental music from a larger work that contains other elements besides the music; for example, the Nutcracker Suite is the music (but not the dancing) from the ballet The Nutcracker, and the Carmen Suite is the instrumental music (but not the singing and dancing) from the opera Carmen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b839ddb2-8558-3d49-9175-c97e1b5a4cb4",
                                        "entry_id": "5d940304-2083-378b-923c-f44b211daf67",
                                        "glosses": [
                                            "A group of related computer programs distributed together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1052e7f7-7034-4664-b5ff-43ed8edd3885",
                        "source_entry_id": "7826fa95-84ea-3523-8cf9-65ca12bac9a8",
                        "source_sense_id": "2f5e3e59-5c42-37be-82d2-42c3b0c47b7f",
                        "source_sense_description": "Architektur: eine Abfolge von Zimmern, die durch Türen miteinander verbunden sind",
                        "target_lang_word": "enfilade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfilade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c90bf17b-f044-35df-b001-69666ba5cb90",
                                        "entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                                        "glosses": [
                                            "A line or straight passage, or the position of that which lies in a straight line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8daa62b5-f264-463d-84bc-a4317de926a1",
                                                "sense_id": "c90bf17b-f044-35df-b001-69666ba5cb90",
                                                "text": "In his Booker Prize-winning novel The Line of Beauty, Alan Hollinghurst wrote about people who know their world history as being able to look back through the millennia as an enfilade of rooms: Greece yields to Rome; Rome to the Byzantine Empire ... the Renaissance ... the British Empire ... America ... China. The same goes for people who can recite their kings and queens. British history clicks into a long enfilade of discrete, identifiable periods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d07d910-805c-357d-9377-84742e1f8599",
                                        "entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                                        "glosses": [
                                            "Gunfire directed along the length of a target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360f0cbc-b4c1-413d-bd75-12e13fb8f872",
                                                "sense_id": "3d07d910-805c-357d-9377-84742e1f8599",
                                                "text": "Uncle Charles, a truly unparalleled slinger of shit, is laying down an enfilade of same, trying to mollify men who seem way more in need of a good brow-mopping than I."
                                            },
                                            {
                                                "example_id": "495a3556-e6fb-415d-afca-bff08d3059d6",
                                                "sense_id": "3d07d910-805c-357d-9377-84742e1f8599",
                                                "text": "In minutes they had gained the top, fell prone, and began to pour deadly repeater-fire into the enemy below while their compatriots raked the top of the coulee with an enfilade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e05125-c08e-368e-b48e-1d9d7cf2145e",
                                        "entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                                        "glosses": [
                                            "A series of doors that provide a vista when open."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enfilade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b570b31-1b9f-3bc0-a192-faf646a925af",
                                        "entry_id": "a80ad5d2-d8f3-3401-b6a1-fd608bc97bf3",
                                        "glosses": [
                                            "To rake (something) with gunfire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aca0860-b084-46d2-a2b2-0bb4bf62ec8b",
                                                "sense_id": "2b570b31-1b9f-3bc0-a192-faf646a925af",
                                                "text": "A great quantity of artillery was placed upon the eminence, so as to batter and enfilade the left of their intrenchments."
                                            },
                                            {
                                                "example_id": "89382f5f-8269-4360-8330-467c67d6feaf",
                                                "sense_id": "2b570b31-1b9f-3bc0-a192-faf646a925af",
                                                "text": "As they scrambled up a narrow path they every where found holes dug to cover the defenders of the mountain, and sticks crossed for resting their guns, with which they enfiladed every angle, that from the steepness it was necessary to make in ascending."
                                            },
                                            {
                                                "example_id": "7b211dd9-ebe1-4120-a0b7-f68ab6990665",
                                                "sense_id": "2b570b31-1b9f-3bc0-a192-faf646a925af",
                                                "text": "It was by his order the shattered leading company flung itself into the houses when the Sin Verguenza were met by an enfilading volley as they reeled into the calle."
                                            },
                                            {
                                                "example_id": "4f8f79f7-3cb2-4c9b-8ba7-861b23b83ec3",
                                                "sense_id": "2b570b31-1b9f-3bc0-a192-faf646a925af",
                                                "text": "He killed the machine gun crew, and without further orders pushed on and enfiladed a ditch from which three officers and 160 men subsequently surrendered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f9bd81-8bef-3410-8f11-4ec6b1cea9b4",
                                        "entry_id": "a80ad5d2-d8f3-3401-b6a1-fd608bc97bf3",
                                        "glosses": [
                                            "To be directed toward (something) like enfilading gunfire."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c184fc3-9184-4a2e-980d-cbd49fddbb7a",
                                                "sense_id": "83f9bd81-8bef-3410-8f11-4ec6b1cea9b4",
                                                "text": "Together they saw the market thicken, and in course of time thin away with the slow decline of the sun towards the upper end of town, its rays taking the street endways and enfilading the long thoroughfare from top to bottom."
                                            },
                                            {
                                                "example_id": "caaf250b-d417-4c6d-8089-d116769c6745",
                                                "sense_id": "83f9bd81-8bef-3410-8f11-4ec6b1cea9b4",
                                                "text": "From her rocking chair in the parlour, Mrs. Zell’s scrutiny enfiladed the entire block."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5966241a-5ad2-3233-baed-a6befd8e4708",
                                        "entry_id": "a80ad5d2-d8f3-3401-b6a1-fd608bc97bf3",
                                        "glosses": [
                                            "To arrange (rooms or other structures) in a row."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab8b848c-7ae8-4f8c-9096-d395c052e4ef",
                                                "sense_id": "5966241a-5ad2-3233-baed-a6befd8e4708",
                                                "text": "[…] the house had been boldly planned with a ball-room, so that, instead of squeezing through a narrow passage to get to it (as at the Chiverses’) one marched solemnly down a vista of enfiladed drawing-rooms (the sea-green, the crimson and the bouton d’or), seeing from afar the many-candled lustres reflected in the polished parquetry […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
