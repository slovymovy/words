                        "glosses": [
                            "een van de planken die een houten vloer maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f4d4d2-f3dd-4a1f-ab5f-66d7e4e11cd6",
                                "sense_id": "5ecc2c8b-c241-3df9-99f2-f5053775bd81",
                                "text": "De nieuwe eigenaren van een kasteel in de Franse Alpen keken vreemd op toen ze bij een renovatie de vloerplanken vervingen. Op de onderkant van de vloerdelen stonden allerlei teksten geschreven."
                            },
                            {
                                "example_id": "f60514a5-b459-43c4-9ab9-c9c31588e9f2",
                                "sense_id": "5ecc2c8b-c241-3df9-99f2-f5053775bd81",
                                "text": "Consumenten moeten in de winkel in één oogopslag kunnen zien of het tuinmeubulair, de schutting of de vloerplanken gemaakt zijn van ’goed’ of ’fout’ hout."
                            }
                        ]
                    }
