                        ]
                    },
                    {
                        "translation_id": "175c9db1-b96f-43f5-a513-7a7977acbc23",
                        "source_entry_id": "fc9df206-8b06-34eb-b98e-3ab553721a88",
                        "source_sense_id": "4db1d95b-7c05-3e10-b371-9c16a1ff4dd9",
                        "source_sense_description": "to change the route taken by something",
                        "target_lang_word": "umleiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umleiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "770b7fbe-f065-3cde-b2d2-dad84baa5d16",
                                        "entry_id": "82cc3ccf-4574-3046-8664-b2e71dce9137",
                                        "glosses": [
                                            "(den Verkehr) über eine Ausweichstrecke führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73c4274-73fc-4cb4-b6c6-c4aa50676ec7",
                                                "sense_id": "770b7fbe-f065-3cde-b2d2-dad84baa5d16",
                                                "text": "„Mitten in London war ein neuer See entstanden, der Verkehr musste umgeleitet werden, es kam zu Staus, und Sheila fragte sich, ob es überhaupt Sinn hatte, zu Silva Mancini zu fahren.“"
                                            },
                                            {
                                                "example_id": "3a71ccf9-935a-49ed-ad7e-7f70ffe17d34",
                                                "sense_id": "770b7fbe-f065-3cde-b2d2-dad84baa5d16",
                                                "text": "„Wenn die ICE-Züge wegen Baustellen nicht gerade umgeleitet werden, dann gondeln sie kilometerlang durchs Idyll des Saaletals, von Hochgeschwindigkeit keine Spur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                        "entry_id": "82cc3ccf-4574-3046-8664-b2e71dce9137",
                                        "glosses": [
                                            "zu einem anderen Ziel bringen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c21ee4-00bd-4d1d-9741-fc2c6838d473",
                                                "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                                "text": "„Angreifer könnten nach einer erfolgreichen Attacke auch Anrufe mithören, eingehende Gespräche auf eine andere Nummer umleiten oder sogar den Inhalt der gekidnappten SIM-Karte komplett kopieren, die Karte quasi klonen.“"
                                            },
                                            {
                                                "example_id": "2f0d2e85-e143-46da-a3f9-26909a0ecd52",
                                                "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                                "text": "„Sie können eingehende Anrufe auf bestimmte Rufnummern umleiten.“"
                                            },
                                            {
                                                "example_id": "aca2d5b6-0d47-4a95-9a41-7a85cc90641f",
                                                "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                                "text": "„Bei der Umleitung können Sie die Ordner in vordefinierte Verzeichnisse auf den Servern umleiten oder für jeden Anwender in einem spezifischen Ordner automatisch ein Verzeichnis für die Ordnerumleitung anlegen lassen.“"
                                            },
                                            {
                                                "example_id": "b8704659-a325-41c3-b266-efd34295e71c",
                                                "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                                "text": "„Wählen Sie die Auswahlmöglichkeit dem exakten oben eingegebenen URL, wenn Sie Anfragen auf eine bestimmte Datei umleiten möchten.“"
                                            },
                                            {
                                                "example_id": "ba6ae5c8-84ae-4817-92f4-aef4034278ef",
                                                "sense_id": "5265a556-abb1-3a5b-96d4-f7bce9e0f26a",
                                                "text": "„Nicht einmal die Hoffnung, dass eine so eigenwillige Form des Rankings die Studentenströme von den großen zu den kleinen und von alten zu den neuen Universitäten umleiten würde, hat sich erfüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
