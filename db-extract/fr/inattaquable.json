                                        "sense_id": "be6c03cf-301b-336e-bd7f-811152bc609c",
                                        "entry_id": "2a44cf10-6888-368b-85e6-ee8f376e6fa1",
                                        "glosses": [
                                            "in der Situation befindlich, in der eine Person oder eine Sache aufgrund von Vorsichtsmaßnahmen weder verbal, argumentatorisch noch physisch angegriffen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1719608a-3879-4f39-ba70-26363df31409",
                                                "sense_id": "be6c03cf-301b-336e-bd7f-811152bc609c",
                                                "text": "„Ich legte meine Hände auf eine obere Stufe, lehnte mich zurück und fragte in dieser fast unangreifbaren Haltung, welche die letzte Rettung der Ringkämpfer ist: ‚Ihr habt eine lustige Art, Euch zu retten, indem Ihr Eueren Zustand bei den anderen voraussetzt.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32c6876f-6b9e-3e1e-9cdd-6c883f6115b4",
                                        "entry_id": "2a44cf10-6888-368b-85e6-ee8f376e6fa1",
                                        "glosses": [
                                            "fest, beständig, widerstandsfähig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0f19207-fde4-4deb-bddf-f1c2f864cca1",
                                                "sense_id": "32c6876f-6b9e-3e1e-9cdd-6c883f6115b4",
                                                "text": "„Echtes Interesse. Als sie im Mai beim Besuch des Pharmakonzerns Sanofi über krankmachende Bakterien sprach, die zunehmend unangreifbar für Antibiotika werden, war das so ein Moment. Merkel hat eine Mission.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
