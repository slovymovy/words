                    {
                        "sense_id": "36ca9b1e-206b-316c-85bb-c6a720130e5f",
                        "entry_id": "a8771a40-5203-3341-8fec-ff5b365cbb66",
                        "glosses": [
                            "In an alert manner; with alertness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf9f196-ba7a-4ea7-a409-dba040653988",
                                "sense_id": "36ca9b1e-206b-316c-85bb-c6a720130e5f",
                                "text": "Behind one of the old oaks which we have described in the preceding chapter, shrouding himself from observation like a hunter watching for his game, or an Indian for his enemy, but with different, very different purpose, Tyrrel lay on his breast near the Buck-stane, his eye on the horse-road which winded down the valley, and his ear alertly awake to every sound which mingled with the passing breeze, or with the ripple of the brook."
                            },
                            {
                                "example_id": "8a727cde-165c-442d-b9c4-9eef62989b62",
                                "sense_id": "36ca9b1e-206b-316c-85bb-c6a720130e5f",
                                "text": "I walked fast to avoid being overtaken. Every crossing was a danger, every passenger a thing to watch alertly."
                            },
                            {
                                "example_id": "f1ce8643-867a-4831-b429-ab9a9267d7d1",
                                "sense_id": "36ca9b1e-206b-316c-85bb-c6a720130e5f",
                                "text": "Miss Baker and I exchanged a short glance consciously devoid of meaning. I was about to speak when she sat up alertly and said “Sh!” in a warning voice."
                            },
                            {
                                "example_id": "37490293-3112-40de-ae68-be4108a0daf5",
                                "sense_id": "36ca9b1e-206b-316c-85bb-c6a720130e5f",
                                "text": "She was wearing tight white shorts and a grey tank top of Jasper’s, in which her small breasts moved alertly."
                            }
                        ]
                    }
                ],
