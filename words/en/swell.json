                    "sense_definition": "Very well.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everything is going <w>swell</w> with the new business venture.",
                            "target_lang_translations": {
                                "ru": "С новым бизнес-проектом все идет <w>прекрасно</w>."
