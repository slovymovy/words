                                    {
                                        "sense_id": "7bb93509-d4ff-3b96-9ad0-9e2a315a80b2",
                                        "entry_id": "2b3c6932-b162-3b39-8745-041b13aa72f6",
                                        "glosses": [
                                            "Tissu végétal composé de cellules non différenciées et dépourvu d’appareil vasculaire (apparemment sans feuilles ni racines)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468b50d3-046e-4ce0-a840-9cb6f4167e28",
                                                "sense_id": "7bb93509-d4ff-3b96-9ad0-9e2a315a80b2",
                                                "text": "L’embranchement des Thallophytes comprend les plantes qui ne possèdent ni fleurs, ni feuilles, ni tiges, ni racines, dont le corps a des formes filamenteuses ou aplaties et constitue ce qu’on appelle un thalle."
                                            },
                                            {
                                                "example_id": "f67dfb8d-876e-4411-87f9-598ca5900c75",
                                                "sense_id": "7bb93509-d4ff-3b96-9ad0-9e2a315a80b2",
                                                "text": "À l’inverse des formes protophytiques, le thalle est une formation pluricellulaire, parfois polyénergide."
                                            },
                                            {
                                                "example_id": "c491e678-f6f5-4de0-94f6-86703f06f9e0",
                                                "sense_id": "7bb93509-d4ff-3b96-9ad0-9e2a315a80b2",
                                                "text": "La forme de base des algues brunes est le thalle ‒ un organisme végétatif simple, relativement indifférencié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
