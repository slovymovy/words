                "senses": [
                    {
                        "sense_id": "86e0f8d7-9936-35cd-a7d0-2c1f1e9f599c",
                        "entry_id": "673b8289-5277-3d2d-9aaa-24a6a4b35f93",
                        "glosses": [
                            "mit einem Geschoß gebaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ecc44d-2d9b-46f4-aad3-5eb8e148fdbd",
                                "sense_id": "86e0f8d7-9936-35cd-a7d0-2c1f1e9f599c",
                                "text": "„Das neue Kinderhaus, in dem Räumlichkeiten für vier Kindergarten- und zwei Krippengruppen zur Verfügung stehen werden, war ursprünglich als zweiter Bauabschnitt der bereits 2015 eröffneten Kinderkrippe geplant worden, sollte aber nur eingeschoßig sein und ein deutlich geringeres Platzangebot haben.“"
                            },
                            {
                                "example_id": "e976b434-5cdb-441a-b2bd-5e8511d40b9f",
                                "sense_id": "86e0f8d7-9936-35cd-a7d0-2c1f1e9f599c",
                                "text": "„Nach den dem Bauantrag beigelegten Plan- und Beschreibungsunterlagen soll das Betriebsgebäude für die Freiwaschplätze und Technikräume eingeschoßig ausgeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
