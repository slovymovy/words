                "senses": [
                    {
                        "sense_id": "ffe2556b-d1de-3ed4-817f-ec633c4d5ad3",
                        "entry_id": "47a4f76f-2867-3719-9d33-0d4e14cfb2c6",
                        "glosses": [
                            "Relatif au rameau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdef0cd2-17ea-48d4-88a3-4d2280b4c987",
                                "sense_id": "ffe2556b-d1de-3ed4-817f-ec633c4d5ad3",
                                "text": "Nous avons estimé la production annuelle de bois raméal à environ 100,000,000 m³, dont la totalité est considérée comme étant un \"déchet\" ou une nuisance."
                            },
                            {
                                "example_id": "1e61dd1c-6b62-4f5a-a226-9be73bf214af",
                                "sense_id": "ffe2556b-d1de-3ed4-817f-ec633c4d5ad3",
                                "text": "L'avantage de fragmenter le bois raméal réside dans l'augmentation des surfaces de contact pour les décomposeurs et l'établissement de conditions abiotiques propices à l'évolution des populations microbiennes, ce qui est de nature à favoriser l'incorporation des composés azotés au sol."
                            }
                        ]
                    }
