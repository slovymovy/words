                        "examples": [
                            {
                                "example_id": "83d0bd01-b429-4c1b-88c1-f9f96577cf32",
                                "sense_id": "378ef374-6a05-3e24-a66f-78340d61b63d",
                                "text": "Tussen de ranken hielden zich talrijke hagedissen en insekten op, die zich op de gebarsten bepleistering door de zon lieten koesteren of onder de schaduwrijke bladeren verkoeling zochten."
                            },
                            {
                                "example_id": "60d37173-2d8b-46ff-bd37-278d1fae2b70",
                                "sense_id": "378ef374-6a05-3e24-a66f-78340d61b63d",
                                "text": "We liepen tegen de afschilferende bepleistering aan, maten elkaar met de blik en keken elkaar in de ogen."
                            }
                        ]
                    }
