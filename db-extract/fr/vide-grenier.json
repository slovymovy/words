                    }
                ],
                "senses": [
                    {
                        "sense_id": "4acb180a-bbb9-356d-aa95-fab23a702da3",
                        "entry_id": "6ec69035-47bb-31d5-b956-e3dc8571ec22",
                        "glosses": [
                            "privater Flohmarkt, privater Trödelmarkt, Garagenverkauf"
                        ],
                        "tags": [],
