                    {
                        "translation_id": "5d90f4cc-aa38-4ba4-a4f1-2ffc03bfe0ea",
                        "source_entry_id": "14d3d3f7-fc8f-32b6-bb07-714ebb1021e3",
                        "source_sense_description": "suit made of such fabric",
                        "target_lang_word": "Nadelstreifenanzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nadelstreifenanzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2be64516-d9cc-3a62-9866-62682c511f8b",
                                        "entry_id": "fad9bd91-256a-3d50-8201-699826c83da0",
                                        "glosses": [
                                            "durch Nadelstreifen gemusterter, oft teurer Anzug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eca3d16-8098-48b6-9eb5-3c351462c555",
                                                "sense_id": "2be64516-d9cc-3a62-9866-62682c511f8b",
                                                "text": "„Aus einem gepanzerten Geländewagen steigt ein großer, hagerer Mann mit einem schmalen Gesicht. Taubengrauer Nadelstreifenanzug, hellblaues Hemd, keine Krawatte. Stramm wie ein Armeegeneral schreitet er in einem Sicherheitsabstand von drei Armlängen die Zuschauergalerie ab.“"
                                            },
                                            {
                                                "example_id": "eaa65a61-7731-4804-a24b-9013baf83905",
                                                "sense_id": "2be64516-d9cc-3a62-9866-62682c511f8b",
                                                "text": "„Jörg Haider sitzt auf einer Bank gleich beim Fenster, er trägt einen gut sitzenden, aber unauffälligen Nadelstreifenanzug mit offenem Hemdkragen.“"
                                            },
                                            {
                                                "example_id": "1fbd2847-76aa-448a-9a4a-7ea15c65c8a5",
                                                "sense_id": "2be64516-d9cc-3a62-9866-62682c511f8b",
                                                "text": "„Ein schmächtiger Mann in Nadelstreifenanzug und ein wuchtiger Riese in goldfarbenem Boubou betraten den Raum.“"
                                            },
                                            {
                                                "example_id": "19635cdc-ca5c-4c1e-80de-9fdf5444b285",
                                                "sense_id": "2be64516-d9cc-3a62-9866-62682c511f8b",
                                                "text": "„Benjamin, heute in einem Nadelstreifenanzug, die langen Beine in das kleine Auto gefaltet, bekam eine steile Falte auf der Stirn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
