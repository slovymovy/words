                                    {
                                        "sense_id": "72543532-e042-358e-af17-e223ed65c6d6",
                                        "entry_id": "1b13eeab-144a-33f2-9a2c-bf5c7c4a6fa0",
                                        "glosses": [
                                            "To telephone."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19fdd92-2166-40d7-a54d-3fd4f7d44c9c",
                                                "sense_id": "72543532-e042-358e-af17-e223ed65c6d6",
                                                "text": "\"Vinny, you tosser, it's Keith. I thought you were back today. I'm in town. Bell us on the mobile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "243961f4-a607-376b-a295-313b989b554d",
                                        "entry_id": "1b13eeab-144a-33f2-9a2c-bf5c7c4a6fa0",
                                        "glosses": [
                                            "To develop bells or corollas; to take the form of a bell; to blossom."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef0dbdf-55e6-496b-9a7b-19bffac8c7a9",
                                                "sense_id": "243961f4-a607-376b-a295-313b989b554d",
                                                "text": "Hops bell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a012af3-e9c3-3205-b904-934fd2f686bd",
                                        "entry_id": "1b13eeab-144a-33f2-9a2c-bf5c7c4a6fa0",
                                        "glosses": [
                                            "To ring a bell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c07e972e-4d42-430e-a082-4c1af19f80bd",
                                                "sense_id": "9a012af3-e9c3-3205-b904-934fd2f686bd",
                                                "text": "So that the Euston signalman may be advised of approaching trains as soon as possible, the Camden signalman sets up and transmits the description of each train immediately after it is belled to him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9dd8f3-471e-3ea0-9103-641acdc70f9c",
                                        "entry_id": "5cc375d4-b1ce-3c88-9023-6822010e7fd7",
                                        "glosses": [
                                            "To bellow or roar."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f526c2e-0491-4ce1-88a2-6e8925b6e877",
                                                "sense_id": "bf9dd8f3-471e-3ea0-9103-641acdc70f9c",
                                                "text": "This animal is said to harbour in the place where he resides. When he cries, he is said to bell; the print of his hoof is called the slot; his tail is called the single; his excrement the fumet; his horns are called his head [...]."
                                            },
                                            {
                                                "example_id": "dfefb3bc-8837-46df-a05d-616d3297bc1d",
                                                "sense_id": "bf9dd8f3-471e-3ea0-9103-641acdc70f9c",
                                                "text": "As the dawn was breaking the Sambhur belled / Once, twice and again!"
                                            },
                                            {
                                                "example_id": "eb15975c-038f-435a-859f-2487b47de546",
                                                "sense_id": "bf9dd8f3-471e-3ea0-9103-641acdc70f9c",
                                                "text": "You acted part so well, went alɬ-fours upon earth / The live-long day, brayed, belled."
                                            },
                                            {
                                                "example_id": "a04d17c4-c299-4f44-bee5-6cb2aff675be",
                                                "sense_id": "bf9dd8f3-471e-3ea0-9103-641acdc70f9c",
                                                "text": "Then, incredibly, a rutting stag belled by the trunks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5dd9ff8-e654-3ead-b0d7-0c1dfb597435",
                                        "entry_id": "5cc375d4-b1ce-3c88-9023-6822010e7fd7",
                                        "glosses": [
                                            "To utter in a loud manner; to thunder forth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a39c44a-c081-4011-8b3c-dc8d1b5f1574",
                                                "sense_id": "f5dd9ff8-e654-3ead-b0d7-0c1dfb597435",
                                                "text": "Their leaders bell their bleating tunes In doleful sound."
                                            }
                                        ]
                                    }
                                ]
                            },
