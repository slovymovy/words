                                        "sense_id": "b26b54bb-17c2-309c-bb2c-c31a6aa8a120",
                                        "entry_id": "587740b4-e17e-30c2-b855-d7fd591392a0",
                                        "glosses": [
                                            "een wijd, wit linnen hemd, dat reikt tot aan de knieën en gedragen wordt over de toog door een priester of misdienaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e85c7b-623d-4a9b-bec5-3806b276a6c0",
                                                "sense_id": "b26b54bb-17c2-309c-bb2c-c31a6aa8a120",
                                                "text": "Een jonge diaken, wiens schouderbladen zich duidelijk aftekenden onder zijn dunne koorhemd, liep langs hem heen, ging naar een tafeltje bij de muur en begon gebeden te lezen."
                                            },
                                            {
                                                "example_id": "35da63f3-7937-4f13-87ad-909d5a6e5b40",
                                                "sense_id": "b26b54bb-17c2-309c-bb2c-c31a6aa8a120",
                                                "text": "Willebroek is verlaten, kanaalbruggen zijn afgezet met zakken. Belgen steken de Rupel over. In Boom zien ze vrouwen en kinderen bidden, een priester in zijn koorhemd. Honden trekken machinegeweren. Met spoedmarsen bereiken ze de forten van Antwerpen terwijl dekkingstroepen de vijand bestoken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
