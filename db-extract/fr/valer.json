                "senses": [
                    {
                        "sense_id": "1a9cc254-f895-387a-9c85-5eb9ec6873dd",
                        "entry_id": "30ddf315-6a39-3ccb-a283-3207ec70a1c1",
                        "glosses": [
                            "Suivre le fil de l’eau, se confier au courant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afbf9a52-8087-44b2-a91e-3b28695efbac",
                                "sense_id": "1a9cc254-f895-387a-9c85-5eb9ec6873dd",
                                "text": "C’est dans ses bras que j’ai valé, un an plus tard, jusqu’à Châteauneuf. Valer, cela veut dire, dans le langage de nos vieux mariniers, suivre le fil de l’eau, se confier au courant et, symboliquement, au destin."
                            },
                            {
                                "example_id": "93fe082b-8fb0-4193-ae76-9f1560ee86fc",
                                "sense_id": "1a9cc254-f895-387a-9c85-5eb9ec6873dd",
                                "text": "Vous devez savoir ce que vous valez, même si cela signifie qu'on vous laisse tranquille.Et c'est tellement réel ."
                            }
                        ]
                    }
                ],
