                        "examples": [
                            {
                                "example_id": "0891580c-384d-4911-a8be-77f8f584f1d9",
                                "sense_id": "e2d65597-1ced-3260-84b7-1868d228691c",
                                "text": "After returning from my first expedition none of these more northern lakes were zoologically known nor had the other great lakes the Victoria Nyanza and the chains of lakes in the eastern arm of the rift been sufficiently minutely examined to show whether the halolimnic fauna existed in any of them or not."
                            }
                        ]
                    }
