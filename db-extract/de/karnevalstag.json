                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08940be-034e-45e5-9ae7-574d4f8c5da8",
                                "sense_id": "9fa187ca-eedf-367f-8a5b-025cbcab2cf9",
                                "text": "„Der Nubbel ist eine angekleidete Strohpuppe, groß wie ein Erwachsener, die seit dem 18. Jahrhundert an Karneval als Sündenbock über dem Eingang vieler Kneipen hängt und am letzten Karnevalstag verbrannt wird.“"
                            },
                            {
                                "example_id": "b4b693a1-768e-4aad-aa5e-48cae23c78e7",
                                "sense_id": "9fa187ca-eedf-367f-8a5b-025cbcab2cf9",
                                "text": "„Am Dienstagmittag gab ich ihm einen Piaster und sagte, er solle den letzten Karnevalstag verbringen, wo er wolle; es genüge, wenn er am nächsten Mittag zurückkäme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
