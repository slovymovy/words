                        "form": "teenagers"
                    },
                    {
                        "form_id": "0463cbff-0584-4ed5-922d-cc4d1f76312f",
                        "entry_id": "efac58a7-84a5-395f-808a-dd1bd27b6e6b",
                        "tags": [],
                        "form": "teen-ager"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                        "entry_id": "efac58a7-84a5-395f-808a-dd1bd27b6e6b",
                        "glosses": [
                            "Adolescent, jeune personne ayant entre 13 et 19 ans."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8162ea77-9ce3-4240-a97b-331ef40f590d",
                                "sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                                "text": "On ne parlait pas de films pour adolescents, de musique de jeunes ou de mode teenager, tout simplement parce qu’il n’y avait pas de teenagers !"
                            },
                            {
                                "example_id": "2cc51a38-f998-417c-823e-f87a1b44c7b5",
                                "sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                                "text": "Quelles étaient vos distractions lorsque vous étiez teenager ? — Teenager ? Qu’est-ce que cela veut dire ? — Avant vingt ans."
                            },
                            {
                                "example_id": "0dec398c-e605-4ca3-bdd0-dc7577682f94",
                                "sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                                "text": "Cette musique, plus populaire, est plus accessible et plaît à un public plus large, essentiellement constitué de teenagers (mais pas à leurs parents)."
                            },
                            {
                                "example_id": "c58570a9-3db4-45c4-8b78-3c7d8d24841d",
                                "sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                                "text": "Car avant d'en arriver là, le jeune homme avait été un adolescent star. Une apparition foudroyante dans une panouille pour teenagers, à l'âge de treize ans. Et puis, un second rôle dans un film devenu culte, l'année d'après."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a95e3b6-8ba3-42db-be93-3efca72ee364",
                        "source_entry_id": "efac58a7-84a5-395f-808a-dd1bd27b6e6b",
                        "source_sense_id": "5319d184-acab-34eb-88f2-2296d8758609",
                        "target_lang_word": "Teenager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teenager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                        "entry_id": "e81d26d6-f6d8-3836-b32e-63355b67167f",
                                        "glosses": [
                                            "Junge oder Mädchen etwa im Alter zwischen 13 und 19 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15606abe-76b2-4c0e-a488-6f0330af86a0",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "Lisa ist ein Teenager."
                                            },
                                            {
                                                "example_id": "0c9afce0-4699-49a8-8804-c675f79f95ae",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Im siebten öffnete sich die Tür, ohne daß jemand aussteigen wollte, und im elften standen drei kichernde, aber sehr hübsche Teenager vor dem Lift, die dann nicht einsteigen wollten.“"
                                            },
                                            {
                                                "example_id": "8c8b623e-85bc-4b1f-9969-4b2d86f7df69",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Horst Eckert, ein Teenager ohne Abitur und mit nicht abgeschlossener Lehre als Schlosser, wird in Oldenburg Arbeit in der Baumwollspinnerei von Ripken finden, als Maschinenreiniger.“"
                                            },
                                            {
                                                "example_id": "345453dc-8c15-425d-b8fd-8ca34b159b61",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Andere Erzählungen zeigen Klein-Erna als Teenager oder als Frau und junge Mutter, so daß praktisch alle Arten von Witzen auf sie übertragen werden können.“"
                                            },
                                            {
                                                "example_id": "e2190439-ff57-448d-86ea-cc04bb861f78",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Vor wenigen Jahren verschied nach längerem seelischen Leiden sanft der Backfisch, und es begann der Einmarsch der Teenager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80b5bb52-cf88-4842-8fb6-16cfc6538559",
                        "source_entry_id": "efac58a7-84a5-395f-808a-dd1bd27b6e6b",
