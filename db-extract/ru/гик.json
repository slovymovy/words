                ],
                "senses": [
                    {
                        "sense_id": "be52412d-58ea-3186-ad5a-25a41c580cf5",
                        "entry_id": "367cf7a7-13c0-309b-b712-829eb94cfa98",
                        "glosses": [
                            "морск. рангоутное дерево, одним концом подвижно скреплённое с нижней частью мачты парусного судна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43374785-947e-42c0-978e-a542af666837",
                                "sense_id": "be52412d-58ea-3186-ad5a-25a41c580cf5",
                                "text": "Сегодня дождь, но теплый, почти летний, так что даже кот Васька не уходил с юта, а только сел под гик."
                            },
                            {
                                "example_id": "f535f1a7-a360-4015-9f9f-e67b20baa219",
                                "sense_id": "be52412d-58ea-3186-ad5a-25a41c580cf5",
                                "text": "При переходе с борта на борт от резкой перемены ветра меня пониже спины с силой ударяет гик — балка, к которой крепится грот."
                            }
                        ]
                    }
                ],
