                    {
                        "sense_id": "c0cecf6c-7d42-3513-950e-6cee63c8593d",
                        "entry_id": "9df3c24a-453a-3dbd-8c7f-1ba14167e25a",
                        "glosses": [
                            "An imaginary god or higher power responsible for rain."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "9eccb77d-7286-4d62-a306-c25cb7c81527",
                                "sense_id": "c0cecf6c-7d42-3513-950e-6cee63c8593d",
                                "text": "As soon as they see me scurrying around picking up snorkels and flippers they know the Big Wet is on its way. The skies will open and Hughie will send it down."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5814d6e-b8cd-3481-9b0e-0a8771825554",
                        "entry_id": "9df3c24a-453a-3dbd-8c7f-1ba14167e25a",
                        "glosses": [
                            "Imaginary god who creates surf (waves, and associated conditions)."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "2be82f3c-cff5-4111-a95b-07b3d74d7d00",
                                "sense_id": "c5814d6e-b8cd-3481-9b0e-0a8771825554",
                                "text": "2006, DC Green, Surf Europe\nPipe scowled. “Hughie... send us swell! Not just any swell, but a grand macking swell! In return, we pray you will accept this near-virginal surfboard sacrifice that we make in your name!”"
                            }
                        ]
                    }
