                                    },
                                    {
                                        "sense_id": "4f3caa5f-a09f-3e2a-85d9-88233f61801c",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "A wedge tornado."
