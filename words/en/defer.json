{
    "word_family": [
        "deference",
        "deferral",
        "deferment",
        "deferential"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1d2a354-c1d4-3db8-b5a5-dd28186e8a90",
                    "sense_definition": "To put off an action or event to a later time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>defer</w> the final decision until we have more information.",
                            "target_lang_translations": {
                                "es": "Decidimos <w>posponer</w> la decisión final hasta tener más información."
                            }
                        },
                        {
                            "text": "The company had to <w>defer</w> the project launch due to unexpected budget cuts.",
                            "target_lang_translations": {
                                "es": "La empresa tuvo que <w>aplazar</w> el lanzamiento del proyecto debido a recortes presupuestarios inesperados."
                            }
                        }
                    ],
                    "common_phrases": [
                        "defer a decision",
                        "defer payment"
                    ],
                    "target_lang_definitions": {
                        "es": "Posponer o retrasar una acción o evento para más adelante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "posponer",
                                "target_lang_sense_clarification": "dejar algo para más tarde"
                            },
                            {
                                "target_lang_word": "aplazar",
                                "target_lang_sense_clarification": "retrasar un evento o decisión"
                            },
                            {
                                "target_lang_word": "diferir",
                                "target_lang_sense_clarification": "dilatar o posponer en el tiempo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e74bc164-0406-3fec-8551-57e900bf0009",
                    "sense_definition": "To accept or follow the opinion or authority of someone else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>defer</w> to your expertise since you have more experience in this field.",
                            "target_lang_translations": {
                                "es": "Voy a <w>remitirme</w> a tu experiencia, ya que tienes más práctica en este campo."
                            }
                        },
                        {
                            "text": "The committee chose to <w>defer</w> to the chairperson regarding the final policy changes.",
                            "target_lang_translations": {
                                "es": "El comité prefirió <w>ceder</w> ante la presidencia respecto a los cambios definitivos de la política."
                            }
                        }
                    ],
                    "synonyms": [
                        "submit"
                    ],
                    "common_phrases": [
                        "defer to judgment",
                        "defer to authority"
                    ],
                    "target_lang_definitions": {
                        "es": "Aceptar o someterse a la opinión, criterio o autoridad de otra persona por respeto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "deferir",
                                "target_lang_sense_clarification": "remitirse a o ceder ante la opinión de alguien"
                            },
                            {
                                "target_lang_word": "ceder",
                                "target_lang_sense_clarification": "someterse a la autoridad o criterio de otro"
                            },
                            {
                                "target_lang_word": "remitirse",
                                "target_lang_sense_clarification": "dejar la decisión en manos de alguien con más experiencia o rango"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}