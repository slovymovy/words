                                        "entry_id": "803e3524-1b83-36b9-9fe1-b9c30894e394",
                                        "glosses": [
                                            "schwimmfähiges Fahrzeug, welches explosive und versteckte Ladungen entfernt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1e9eb4-5f8d-40c6-8ca1-dad3d1213468",
                                                "sense_id": "e712ce3b-fd37-3e64-830d-a1261dfa6723",
                                                "text": "„Es folgten Einsätze auf Schnellbooten, Minenräumbooten und anderen »fahrbaren Untersätzen«.“"
                                            },
                                            {
                                                "example_id": "afc43479-72b6-493e-ae9f-7d4d9abfb793",
                                                "sense_id": "e712ce3b-fd37-3e64-830d-a1261dfa6723",
                                                "text": "„Beide Boote warteten nun vor der Hafeneinfahrt auf Geleitschutz durch Sperrbrecher und Minenräumboote, denn die Einfahrt wurde immer wieder von feindlichen Flugzeugen oder U-Booten mit Minen belegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
