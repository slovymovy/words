                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5a035e28-3703-3ffb-8ddc-e84fd01faa38",
                        "entry_id": "ff79a891-2bf1-33bc-9df9-938ea590945d",
                        "glosses": [
