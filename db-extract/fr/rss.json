                    {
                        "sense_id": "8a85b846-dfb7-3ca7-bdd3-4c6e2a7db830",
                        "entry_id": "8ce98d1d-583c-3693-bc97-9696ccdc82ed",
                        "glosses": [
                            "République socialiste soviétique, n’importe laquelle des républiques formant l’URSS (1922-1991)."
                        ],
                        "tags": [
                            "Communisme",
                            "URSS"
                        ],
                        "examples": [
                            {
                                "example_id": "746a6a57-cae4-4a79-8ff9-301043e46eaa",
                                "sense_id": "8a85b846-dfb7-3ca7-bdd3-4c6e2a7db830",
                                "text": "Le plus vaste État du monde a donné naissance à 15 nouveaux pays dont la dénomination officielle a été transformée, puisque les 15 républiques de cette fédération étaient nommément définies comme des « Républiques socialistes soviétiques » (RSS d'Arménie, RSS de Biélorussie, etc.)."
                            }
                        ]
                    }
