                    },
                    {
                        "translation_id": "63fe6e44-91f2-4c1f-b6a4-92100c2086cf",
                        "source_entry_id": "a5026d71-65fc-3271-8b7e-4b7d8f94594e",
                        "source_sense_id": "c0a5c0f9-a498-3431-a13f-0931fa255bc3",
                        "source_sense_description": "een instelling die zich bezighoudt met het verzorgen en kweken van exotische diersoorten en het tonen ervan aan betalend publiek",
                        "target_lang_word": "jardin zoologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jardin zoologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                        "entry_id": "89901a30-a1aa-3778-9607-6d87804ccff2",
                                        "glosses": [
                                            "Lieu d’attraction où les visiteurs peuvent observer des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f7c85e-6c10-4123-ad57-6f20c2ff339f",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "Nul plaisir sinon exclusif (exemple : le jardin zoologique, le dimanche, pour la bonne compagnie)."
                                            },
                                            {
                                                "example_id": "a1d9ec6d-86a1-40da-8040-195557c8c621",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "[…] « Ils ont la manie de les prendre vivants pour les vendre à quelque jardin zoologique. » — (Il disait : un zoo, par abréviation.)"
                                            },
                                            {
                                                "example_id": "79c96eb8-1640-4ae2-acaa-c8a564dd10ae",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "Je vais passer mon après-midi au Jardin Zoologique, pour tuer le temps. Ce sont surtout les bêtes fauves qui m’intéressent. Ah ! les belles et malheureuses créatures !"
                                            },
                                            {
                                                "example_id": "7054fdd4-9e53-49dd-a8a0-00a78d638cd1",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "Le ciel romain vous abrite à présent ; un fossé, trop large pour votre élan, vous sépare de ceux qui vont, au jardin zoologique, narguer les félins ; et j'espère que vous m'avez oubliée, moi qui, vous sachant innocente de tout, sauf de votre race, souffris qu'on fît de vous une bête captive."
                                            },
                                            {
                                                "example_id": "6d44b226-64c9-423e-a41f-e9f393e73285",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "C'est ainsi, ne comptant plus sur les intermédiaires humains, qu'il s'était fait inscrire à la Société d'Acclimatation du Jardin Zoologique, et apprivoisait la variété d'animaux chère aux collectionneurs dont il voulait l'invitation."
                                            },
                                            {
                                                "example_id": "c3aa5840-09ea-4329-af67-5b5244962810",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "Les bêtes du jardin zoologique avaient compris les premières ; on venait d'ouvrir la seconde de leur double grille, l'invisible ; puis les banquiers."
                                            },
                                            {
                                                "example_id": "41b2e4f9-acc6-42b9-b6ea-f0dfd6e3a3b7",
                                                "sense_id": "f77a613e-7b3e-34af-b203-84db93c69a3d",
                                                "text": "Geoffroy Saint-Hilaire, qui cumulait avec son poste de savant celui de directeur de la Ménagerie, prescrit à tout son personnel d'éviter dorénavant le terme de ménagerie, et de lui préférer celui de jardin zoologique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
