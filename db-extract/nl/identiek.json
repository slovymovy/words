                                "target_senses": [
                                    {
                                        "sense_id": "549a0dff-26f8-33cc-8d51-3d82d76bf96a",
                                        "entry_id": "074f6ec8-16ce-3fcb-b630-694531fc58fd",
                                        "glosses": [
                                            "Propriété de plusieurs objets distincts d'être semblables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7197968c-a0bb-4706-8079-e85d84a22fca",
                                                "sense_id": "549a0dff-26f8-33cc-8d51-3d82d76bf96a",
                                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
