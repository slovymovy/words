{
    "word_family": [
        "berried",
        "berrying",
        "berrylike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "882c9559-8448-3e6c-91c5-8c01390746a9",
                    "sense_definition": "A small, juicy, and fleshy fruit, often edible, produced by various plants.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She picked a handful of sweet <w>berries</w> from the bush in the garden.",
                            "target_lang_translations": {
                                "ru": "Она сорвала горсть сладких <w>ягод</w> с куста в саду."
                            }
                        },
                        {
                            "text": "The children enjoyed eating fresh <w>berry</w> jam on their toast every morning.",
                            "target_lang_translations": {
                                "ru": "Детям нравилось каждое утро есть свежее <w>ягодное</w> варенье с тостами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild berry",
                        "berry bush",
                        "fresh berry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой сочный и мясистый плод, часто съедобный, производимый различными растениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ягода",
                                "target_lang_sense_clarification": "небольшой сочный плод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3ef828e-c6eb-3dd0-8466-6f3ded4b20b5",
                    "sense_definition": "A botanical term for a fleshy fruit produced from a single ovary, where the entire outer layer is edible and seeds are embedded in the pulp.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In botanical terms, a tomato is actually a <w>berry</w>, while a strawberry is not.",
                            "target_lang_translations": {
                                "ru": "С точки зрения ботаники помидор на самом деле является <w>ягодой</w>, а клубника — нет."
                            }
                        },
                        {
                            "text": "The scientist explained how the <w>berry</w> develops from the flower's ovary.",
                            "target_lang_translations": {
                                "ru": "Ученый объяснил, как <w>ягода</w> развивается из завязи цветка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical definition"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ботанический термин для обозначения многосемянного плода с тонкой кожицей и сочной мякотью, развивающегося из одной завязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ягода",
                                "target_lang_sense_clarification": "ботанический тип плода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5bcc6e7-f5b8-3d83-b165-d7d2921e9b9c",
                    "sense_definition": "A single seed of the coffee plant, commonly referred to as a bean.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coffee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quality of the coffee depends on the ripeness of the <w>berry</w> when harvested.",
                            "target_lang_translations": {
                                "ru": "Качество кофе зависит от зрелости <w>ягоды</w> при сборе урожая."
                            }
                        },
                        {
                            "text": "Workers spent the day picking the red coffee <w>berries</w> from the trees.",
                            "target_lang_translations": {
                                "ru": "Рабочие весь день собирали красные кофейные <w>ягоды</w> с деревьев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coffee berry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плод кофейного дерева, содержащий семена, которые обычно называют кофейными зернами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ягода",
                                "target_lang_sense_clarification": "плод кофейного дерева"
                            },
                            {
                                "target_lang_word": "кофейная вишня",
                                "target_lang_sense_clarification": "профессиональный термин для плода кофе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29147d9d-921a-30b0-a7a2-c0988b16381e",
                    "sense_definition": "One of the eggs of a fish or a crustacean, such as a lobster or crab.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The female lobster was carrying thousands of tiny <w>berries</w> under her tail.",
                            "target_lang_translations": {
                                "ru": "Самка омара несла под хвостом тысячи крошечных <w>икринок</w>."
                            }
                        },
                        {
                            "text": "It is often illegal to catch a crab that is in <w>berry</w> to protect the population.",
                            "target_lang_translations": {
                                "ru": "Часто запрещено ловить краба с <w>икрой</w>, чтобы защитить популяцию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in berry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Икринка рыбы или ракообразного, такого как омар или краб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "икринка",
                                "target_lang_sense_clarification": "отдельное яйцо рыбы или рака"
                            },
                            {
                                "target_lang_word": "икра",
                                "target_lang_sense_clarification": "совокупность яиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fdabe92-044d-3950-b862-afa7095a6986",
                    "sense_definition": "A slang term for a dollar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost over a hundred <w>berries</w> on a single bet at the races.",
                            "target_lang_translations": {
                                "ru": "Он проиграл больше сотни <w>баксов</w> на одной ставке на скачках."
                            }
                        },
                        {
                            "text": "That fancy watch must have cost him a lot of <w>berries</w>.",
                            "target_lang_translations": {
                                "ru": "Эти шикарные часы, должно быть, стоили ему кучу <w>денег</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated US slang for money"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение доллара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бакс",
                                "target_lang_sense_clarification": "сленг для доллара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5feece73-56df-3e5a-b42d-54fd13b4a4a4",
                    "sense_definition": "A hole or tunnel in the ground made by an animal, especially a rabbit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit quickly disappeared into its <w>berry</w> when it saw the fox.",
                            "target_lang_translations": {
                                "ru": "Кролик быстро скрылся в своей <w>норе</w>, когда увидел лису."
                            }
                        },
                        {
                            "text": "We found a small <w>berry</w> hidden under the roots of the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Мы нашли маленькую <w>нору</w>, спрятанную под корнями старого дуба."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional variation for burrow"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нора или туннель в земле, сделанный животным, особенно кроликом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нора",
                                "target_lang_sense_clarification": "жилище животного в земле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc481b6f-2faa-3125-8a61-a670c3ff8b91",
                    "sense_definition": "To gather or pick berries from plants.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harvesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every summer, the family goes <w>berrying</w> in the nearby woods.",
                            "target_lang_translations": {
                                "ru": "Каждое лето семья ходит <w>за ягодами</w> в ближайший лес."
                            }
                        },
                        {
                            "text": "We spent the whole afternoon <w>berrying</w> to make enough jam for the winter.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, <w>собирая ягоды</w>, чтобы наварить достаточно варенья на зиму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go berrying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать ягоды с растений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать ягоды",
                                "target_lang_sense_clarification": "процесс сбора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5af49fcf-f85c-359e-9b6c-4841f4ccb2d3",
                    "sense_definition": "To produce or bear berries.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bushes began <w>berrying</w> early this year due to the warm spring.",
                            "target_lang_translations": {
                                "ru": "В этом году кусты начали рано <w>плодоносить</w> из-за теплой весны."
                            }
                        },
                        {
                            "text": "Some ornamental plants are grown specifically for their ability to <w>berry</w> profusely in autumn.",
                            "target_lang_translations": {
                                "ru": "Некоторые декоративные растения выращивают специально из-за их способности обильно <w>давать ягоды</w> осенью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать плоды в виде ягод."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодоносить",
                                "target_lang_sense_clarification": "давать ягоды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d2c73f78-4f01-324c-a2e6-72ae1b008e03",
                    "sense_definition": "A common English surname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Berry</w> has been working at the local bank for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Берри</w> работает в местном банке уже более двадцати лет."
                            }
                        },
                        {
                            "text": "The famous musician Chuck <w>Berry</w> is known as a pioneer of rock and roll.",
                            "target_lang_translations": {
                                "ru": "Знаменитый музыкант Чак <w>Берри</w> известен как пионер рок-н-ролла."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берри",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fa2a22-f370-3077-89a5-a06722674c78",
                    "sense_definition": "A male given name, sometimes derived from the surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Berry</w> Gordy Jr. founded the famous Motown record label.",
                            "target_lang_translations": {
                                "ru": "<w>Берри</w> Горди-младший основал знаменитый лейбл звукозаписи Motown."
                            }
                        },
                        {
                            "text": "His friends call him <w>Berry</w> as a nickname for Beresford.",
                            "target_lang_translations": {
                                "ru": "Друзья зовут его <w>Берри</w> — это прозвище от имени Бересфорд."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, иногда производное от фамилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берри",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92aee40e-b675-38ea-a925-98dc8c8564e9",
                    "sense_definition": "A female given name, often used as a nickname for Beryl.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her name is Beryl, but everyone has called her <w>Berry</w> since childhood.",
                            "target_lang_translations": {
                                "ru": "Ее зовут Берил, но все с детства называют ее <w>Берри</w>."
                            }
                        },
                        {
                            "text": "<w>Berry</w> decided to start her own small business selling handmade jewelry.",
                            "target_lang_translations": {
                                "ru": "<w>Берри</w> решила открыть свой малый бизнес по продаже украшений ручной работы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, часто используемое как уменьшительное от Берил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берри",
                                "target_lang_sense_clarification": "женское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d54c526-11ac-30f4-b68c-ef3804f57c24",
                    "sense_definition": "A village or town located in various regions, such as New South Wales, Australia, or the United States.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a weekend trip to the historic village of <w>Berry</w> to see the markets.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на выходные в историческую деревню <w>Берри</w>, чтобы посетить рынки."
                            }
                        },
                        {
                            "text": "The town of <w>Berry</w> is known for its beautiful scenery and local produce.",
                            "target_lang_translations": {
                                "ru": "Город <w>Берри</w> известен своими красивыми пейзажами и местными продуктами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня или город, расположенный в различных регионах, таких как Новый Южный Уэльс в Австралии или США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берри",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92248c97-b853-322c-a236-54165bbf12f1",
                    "sense_definition": "A former province of France, located in the Centre-Val de Loire region.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The traditional music of <w>Berry</w> is still celebrated in rural parts of France.",
                            "target_lang_translations": {
                                "ru": "Традиционная музыка провинции <w>Берри</w> до сих пор почитается в сельских районах Франции."
                            }
                        },
                        {
                            "text": "He studied the history of the dukes who once ruled the province of <w>Berry</w>.",
                            "target_lang_translations": {
                                "ru": "Он изучал историю герцогов, которые когда-то правили провинцией <w>Берри</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "France"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшая провинция Франции, расположенная в регионе Центр — Долина Луары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Берри",
                                "target_lang_sense_clarification": "историческая область Франции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}