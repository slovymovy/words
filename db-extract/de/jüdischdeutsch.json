                "senses": [
                    {
                        "sense_id": "96acacc8-43f6-33c9-80de-4aeb52a9b9ee",
                        "entry_id": "4f3b292f-ed8e-3071-99a8-fa9961d5222d",
                        "glosses": [
                            "frühe Form des Jiddischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5e0b23-ac12-45f7-b32d-6bbb565fc949",
                                "sense_id": "96acacc8-43f6-33c9-80de-4aeb52a9b9ee",
                                "text": "„Bezeichnungen wie Jüdischdeutsch, ‚Judendeutsch‘, ‚Judenteutsch‘ begegnet man häufig …“ „Dazu sollten sie die Sprachen ihrer Wirtsvölker annehmen und das Judendeutsche oder Jiddische abwerfen.“"
                            },
                            {
                                "example_id": "b3d967b6-4db0-4536-ab87-d000967b7b15",
                                "sense_id": "96acacc8-43f6-33c9-80de-4aeb52a9b9ee",
                                "text": "„Für das heutige Jiddisch schlägt Beranek - in Übereinstimmung mit den heutigen jüdischen Jiddisten - den Namen ›Jiddisch‹ vor, den auch die Ostjuden selber - neben ›Máme-Lóschen‹ – für ihre Sprache benützen. Den früher üblichen Ausdruck Jüdischdeutsch oder ›Judendeutsch‹ will Beranek, auch das mit gutem Grund, für die frühe Stufe der Sprache vor der Flucht der Juden nach dem Osten reservieren. Die Juden selber empfanden ihre Sprache damals nämlich einfach als ›Deutsch‹ – sie nannten es ›Taitsch‹.“"
                            },
                            {
                                "example_id": "44f40be1-dac7-439c-91d8-f56d180463e5",
                                "sense_id": "96acacc8-43f6-33c9-80de-4aeb52a9b9ee",
                                "text": "„In einer ganz anderen, indirekten Weise hat die Entstehung des älteren Jüdischdeutsch (Vorform des Jiddischen) mit Sprachpolitik zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afcf119d-afc4-3ca3-9e50-a21e4fadffa1",
