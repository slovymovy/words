                "senses": [
                    {
                        "sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                        "entry_id": "f3d880d4-ecca-3cc9-8814-f996803dbebb",
                        "glosses": [
                            "Person, deren Hobby das Thema Eisenbahn ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "086ee56b-44d4-46f4-b956-1860ccb88bf0",
                                "sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                                "text": "Alte, dampfende, stinkende, staubige Dampfloks sind Lieblingsobjekte der Pufferküsser."
                            },
                            {
                                "example_id": "210aba00-0908-415a-84a1-6460e37413ca",
                                "sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                                "text": "„Nun zelebrieren die \"Pufferküsser\" den Fall des staatlichen Monopols im Personenverkehr wie ein Hochamt.“"
                            },
                            {
                                "example_id": "8b74a46d-386f-4cd7-983a-7750b23a7c65",
                                "sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                                "text": "„Als Erste kamen die Pufferküsser: Eisenbahnfotografen aus der Schweiz, Österreich oder Deutschland, die zu allen Entbehrungen bereit sind, nur damit sie die letzte Dampflok ihrer Art vor das Objektiv bekommen.“"
                            },
                            {
                                "example_id": "0ef0f8cc-ca6c-4c9d-bd7a-3ba6a3382322",
                                "sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                                "text": "„Wägli ist der Verfasser des \"kleinen Wägli\", der Bibel aller Schweizer Schwellenzähler und Pufferküsser, wie die Eisenbahnbegeisterten leicht spöttisch genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09a31b9d-4cf4-46d5-8957-da47b2a21970",
                        "source_entry_id": "f3d880d4-ecca-3cc9-8814-f996803dbebb",
                        "source_sense_id": "743be5b4-ce19-3a3f-ac0d-9a76854ea786",
                        "target_lang_word": "trainspotter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trainspotter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a80c6bb-805a-3c47-bf45-69e34e1ea3a4",
                                        "entry_id": "4dce159e-a072-3ad1-bde8-4abf2a2d3779",
                                        "glosses": [
                                            "A person whose hobby is train spotting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b4607c-5147-4a08-90e5-1af2f7c3a963",
                                                "sense_id": "1a80c6bb-805a-3c47-bf45-69e34e1ea3a4",
                                                "text": "`So are you like one of those anorak wearing trainspotter types?'"
                                            },
                                            {
                                                "example_id": "198e60ca-4451-4603-ba0e-3d2659e58413",
                                                "sense_id": "1a80c6bb-805a-3c47-bf45-69e34e1ea3a4",
                                                "text": "Above all, I remember the noise and smell of the steam locomotives, and it was those journeys that turned me into a trainspotter, which meant that soon a pencil, notebook and the Ian Allan locospotter's guide became essential items for the trip."
                                            },
                                            {
                                                "example_id": "d4554998-070d-48c2-aebb-cfcabe046d29",
                                                "sense_id": "1a80c6bb-805a-3c47-bf45-69e34e1ea3a4",
                                                "text": "“Unless you want to end up in the depot!” Then he looks at me more closely, suspecting a trainspotter in his midst. “Maybe, you do want to end up in the depot.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb681c8-1ad2-38c4-8133-08ac712882b4",
                                        "entry_id": "4dce159e-a072-3ad1-bde8-4abf2a2d3779",
                                        "glosses": [
                                            "An obsessive follower of any minority interest or hobby."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7874b6a-ce73-4199-9ab2-b89a926d0ad4",
