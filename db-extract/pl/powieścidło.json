                                        "sense_id": "1e2190af-78da-3dbc-960b-05b08d179e16",
                                        "entry_id": "27aa14c7-0284-359b-a5f7-29cbd288f42f",
                                        "glosses": [
                                            "A story longer than a short story, but shorter than a novella."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c29fa5-a6cb-474a-81f4-6900daa1b1f6",
                                                "sense_id": "1e2190af-78da-3dbc-960b-05b08d179e16",
                                                "text": "Best novella was Nnedi Okorafor’s African-flavoured space opera Binti (Tor), while best novelette was Folding Beijing by Hao Jingfang, translated by Ken Liu."
                                            },
                                            {
                                                "example_id": "9d2c5e94-0788-485f-a6f9-2c82089462ca",
                                                "sense_id": "1e2190af-78da-3dbc-960b-05b08d179e16",
                                                "text": "Nebula Awards® will be made in the following categories […] Novelette: at least 7,500 words but less than 17,500 words[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851a11e1-b049-3c04-be61-7949c49d5650",
                                        "entry_id": "27aa14c7-0284-359b-a5f7-29cbd288f42f",
                                        "glosses": [
                                            "A short piece of lyrical music, especially one for the piano."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29aec339-37ed-4242-8a8d-890a3ec29ed3",
                        "source_entry_id": "be22e94e-5be3-31b6-9e6b-78c0c780b2b9",
                        "source_sense_id": "1a08cbe8-f7c3-3248-81d6-c3a935dda4f6",
                        "target_lang_word": "Schmöker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmöker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7fa7971-6efd-3b21-8a47-3077d131df74",
                                        "entry_id": "bc031e08-304d-318f-a0f6-b9f9432079b5",
                                        "glosses": [
                                            "dickes, weniger anspruchsvolles, kurzweiliges Buch – zumeist belletristischen Inhalts"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae9feb4-ffc7-478f-b988-68b6abf174ed",
                                                "sense_id": "d7fa7971-6efd-3b21-8a47-3077d131df74",
                                                "text": "„Dann gab er ihr den betreffenden Schmöker in die Hand, und sie fragte ihn mit redlichem Eifer, was darin stand.“"
                                            },
                                            {
                                                "example_id": "b517d32e-d998-4033-bf12-8b9496aa719f",
                                                "sense_id": "d7fa7971-6efd-3b21-8a47-3077d131df74",
                                                "text": "„Pécuchet belegte einen dieser Räume für seine Sammlungen mit Beschlag; der letzte wurde für die Bibliothek bestimmt; und als sie die Schränke öffneten, fanden sie noch andere Schmöker vor, aber sie hatten keine Lust, auch nur deren Titel zu lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8de00c65-7fea-33d4-b9a3-fe9185dd6bd3",
                                        "entry_id": "bc031e08-304d-318f-a0f6-b9f9432079b5",
                                        "glosses": [
                                            "jemand, der gewohnheitsmäßig raucht"
                                        ],
                                        "tags": [
                                            "North German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b63886-dbf7-4284-a7d0-e9a23c7f6885",
                                                "sense_id": "8de00c65-7fea-33d4-b9a3-fe9185dd6bd3",
                                                "text": "Das du noch ein Schmöker bist, hätte ich nicht gedacht. Wolltest du nicht mal aufhören?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
