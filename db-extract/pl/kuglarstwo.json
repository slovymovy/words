                        "cross_references": [
                            {
                                "target_word": "prestidigitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                        "entry_id": "52ba94a0-6fa2-3112-9ded-66b61438e38b",
                                        "glosses": [
                                            "A performance of or skill in performing magic or conjuring tricks with the hands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a14a99-380a-4474-83ac-749ba561b7b0",
                                                "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                                "text": "My favorite prestidigitation was when he pulled the live dove out of that tiny scarf."
                                            },
                                            {
                                                "example_id": "659c5af1-db0e-46d3-9428-0eae7a238ad1",
                                                "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                                "text": "He borrowed another hat and displayed its perfect emptiness; he held up his empty hands: \"This is one of the most marvellous bits of prestidigitation known,\" he said. \"You have all seen this hat holds nothing in the world: I will now see if I can extract anything from its emptiness. You can all observe my hands go nowhere but into the hat, and they are both open and turned to you. Yet what is this?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                        "entry_id": "52ba94a0-6fa2-3112-9ded-66b61438e38b",
                                        "glosses": [
                                            "A show of skill or deceitful cleverness."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7515de1d-ddd3-482a-9f0c-b69dc627dece",
                                                "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                                "text": "His writing was peppered with verbal tricks and prestidigitation."
                                            },
                                            {
                                                "example_id": "d4da7527-5c7f-4128-a63a-f869e4d2cb74",
                                                "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                                "text": "The more modest place became the picture better; yet, as my eyes grew accustomed to the half-light, all the characteristic qualities came out--all the hesitations disguised as audacities, the tricks of prestidigitation by which, with such consummate skill, he managed to divert attention from the real business of the picture to some pretty irrelevance of detail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
