                "senses": [
                    {
                        "sense_id": "db068a2c-1d28-3cef-b9ce-20bb4000d23e",
                        "entry_id": "d05819ad-f5de-3840-a479-e6cc3a16b874",
                        "glosses": [
                            "Mener une vie de patachon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6df5399e-2a10-30ef-a271-0ce449c210cf",
                        "entry_id": "d05819ad-f5de-3840-a479-e6cc3a16b874",
                        "glosses": [
                            "Penser ou agir de façon désordonnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1945146-0dfe-4dd3-955e-bc5af3f66d3b",
                                "sense_id": "6df5399e-2a10-30ef-a271-0ce449c210cf",
                                "text": "« Vous patachonnez dans la tête ! objecte-t-il. Vous mélangez tout, cela n’a rien à voir. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "54ab3c91-e76f-386e-81da-a57652d196f1",
                        "entry_id": "d05819ad-f5de-3840-a479-e6cc3a16b874",
                        "glosses": [
                            "Aller lentement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "381196a4-ae9e-45aa-b5bc-7e4303129169",
                                "sense_id": "54ab3c91-e76f-386e-81da-a57652d196f1",
                                "text": "On patachonnait gentiment sur les petites routes."
                            },
                            {
                                "example_id": "9183049e-d37b-44b7-8d6c-98b8d7fbdf34",
                                "sense_id": "54ab3c91-e76f-386e-81da-a57652d196f1",
                                "text": "« Cela donne au jour le temps de se lever », dit-il, pour se consoler comme il peut de me voir patachonner."
                            }
                        ]
                    }
