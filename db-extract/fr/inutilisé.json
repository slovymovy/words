                                            {
                                                "example_id": "14af1330-54c6-476d-8458-5c6d9cf58212",
                                                "sense_id": "d703219a-9d35-3e59-9eb0-55447353c720",
                                                "text": "Hat jemand ein unbenutztes Taschentuch für mich?"
                                            }
