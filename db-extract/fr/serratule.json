            {
                "entry_id": "5288800c-2c40-3da8-8556-c31e0a418a71",
                "word": "serratule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10339b82-5fc1-486b-8393-a3fc4ffd88e4",
                        "entry_id": "5288800c-2c40-3da8-8556-c31e0a418a71",
                        "tags": [
                            "plural"
                        ],
                        "form": "serratules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92daf730-d902-3ff3-b912-e56de950413b",
                        "entry_id": "5288800c-2c40-3da8-8556-c31e0a418a71",
                        "glosses": [
                            "Plante appartenant au genre taxinomique Serratula, de la famille des Astéracées, dont une espèce (Serratula tinctoria) était utilisée en teinturerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77febc85-3750-48bf-804a-be553143de34",
                                "sense_id": "92daf730-d902-3ff3-b912-e56de950413b",
                                "text": "L’automne fait apparaître bétoine, bruyère cendrée et serratule des teinturiers, tandis que le jaune des ajoncs réchauffe le paysage en hiver."
                            },
                            {
                                "example_id": "9243202c-d739-4bb8-840a-062090f620f9",
                                "sense_id": "92daf730-d902-3ff3-b912-e56de950413b",
                                "text": "Pour distinguer la serratule de la centaurée, il y a au moins deux repères : les feuilles de la serratule sont effilées et dentelées, et les pétales filaments des fleurs se divisent en deux petits crochets à leur extrémité."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f2aafb1-d8af-3c28-bae2-20b177d51a2c",
                        "entry_id": "5288800c-2c40-3da8-8556-c31e0a418a71",
                        "glosses": [
                            "Nom vernaculaire du chardon des champs (Cirsium arvense)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ffef9e-3add-4011-9728-a5c41995d371",
                                "sense_id": "7f2aafb1-d8af-3c28-bae2-20b177d51a2c",
                                "text": "On indique comme plantes les plus nuisibles aux récoltes, le chardon ou serratule (cirsium arvense) qui croît partout; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e68eefb-ce7c-4a6e-a114-edbd61979b2a",
                        "source_entry_id": "5288800c-2c40-3da8-8556-c31e0a418a71",
                        "target_lang_word": "Scharte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8693362c-351f-3c85-bbb6-3bcc82a45a09",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "Einschnitt, Kerbe, Kratzer in einem Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a00cc3c-54b2-4b2d-94c3-dec17b8e8017",
                                                "sense_id": "8693362c-351f-3c85-bbb6-3bcc82a45a09",
                                                "text": "Das Schwert hat eine Scharte. Die Klinge ist schartig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "offen gelassene Stelle in einer Verteidigungsanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5870d4a-b16f-48ed-8785-0926060bc126",
                                                "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                                "text": "Die Scharten sind schmal und hoch und wurden in einem Abstand von cirka 5 Metern angelegt."
                                            },
                                            {
                                                "example_id": "3fe5fe7e-a17b-44d9-82ae-4b2cc027dd22",
                                                "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                                "text": "„Sie guckten durch eine Scharte in der Mauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b2540eb0-9c9b-3f43-b2a2-ab1fbb8e596b",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "kurz für: Hasenscharte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f42a53c-4bce-4137-b662-005678a60952",
                                                "sense_id": "b2540eb0-9c9b-3f43-b2a2-ab1fbb8e596b",
                                                "text": "So eine Scharte kann man doch heute operieren lassen, die Lippen-Kiefer-Gaumenspalte ist gar nicht so selten, wie man denkt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5110a97d-71f0-3378-bf42-4d171eb09ce5",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "(enge, schwer) passierbare Stelle im Gebirge, um von einem Tal in das nächste zu gelangen"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666484f9-0f18-4f18-a338-5152a7712d7a",
                                                "sense_id": "5110a97d-71f0-3378-bf42-4d171eb09ce5",
                                                "text": "Die Scharte ist nicht nur Verkehrsverbindung zwischen den beiden Tälern, sondern auch Wasserscheide."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4a2b0348-8d8f-3de4-b34d-c021f9ed905c",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "erlittener Nachteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1da6d6-1b82-48fc-9441-824ccac1bec7",
                                                "sense_id": "4a2b0348-8d8f-3de4-b34d-c021f9ed905c",
                                                "text": "„Um diese Scharte auszuwetzen, fing ich an, mir Landkarten auszudenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
