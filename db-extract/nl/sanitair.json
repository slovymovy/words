                                    },
                                    {
                                        "sense_id": "cdb81a1d-a8cf-3576-a2c9-7db6a7bbf034",
                                        "entry_id": "9de64663-7f92-3258-9e64-ac53975da426",
                                        "glosses": [
                                            "Clean and free from pathogens; hygienic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sanitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43111aa0-9399-38c7-adeb-f29ef14a18bd",
                                        "entry_id": "79880afa-1f93-3a10-a893-252c8014ee9f",
                                        "glosses": [
                                            "Sanitary towel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3447d7d-db34-4665-bc92-031a136192f1",
                                                "sense_id": "43111aa0-9399-38c7-adeb-f29ef14a18bd",
                                                "text": "When I made evening rounds, I saw women with their hair rolled, using the sanitaries for rollers."
                                            },
                                            {
                                                "example_id": "942aafab-0caa-479d-af46-bf4fd5b197f6",
                                                "sense_id": "43111aa0-9399-38c7-adeb-f29ef14a18bd",
                                                "text": "Women... bleed all over everything because of no proper sanitary protection for disposal and no tampons are issued, bloody unwrapped sanitaries are in every dorm john, every trash can, and blood on every faucet handle...and everywhere imaginable."
                                            },
                                            {
                                                "example_id": "c8166839-2d97-40e6-868c-832487ff63a9",
                                                "sense_id": "43111aa0-9399-38c7-adeb-f29ef14a18bd",
                                                "text": "But sanitaries are the worst. The prison only brings out two packs of sanitaries for everybody, and that's like 240 of sanitaries every month for all the women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a20b69b-5099-41dd-aacb-8e67288ff941",
                        "source_entry_id": "eb5d4cb3-6c98-3395-9437-a5e03f52fb04",
                        "source_sense_id": "5b6f9a51-3768-3463-b8a7-518d640cadcc",
                        "source_sense_description": "met betrekking tot de gezondheid",
                        "target_lang_word": "hygienic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hygienic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6036bc7f-9a52-3ea0-a2f4-771c9525efeb",
                                        "entry_id": "b0f31642-6d06-315c-9b64-da02fa36d2d1",
                                        "glosses": [
                                            "Pertaining to hygiene; clean, sanitary, free of disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dd56da9-871a-30d8-9c1e-704c9a55dd4d",
                                        "entry_id": "b0f31642-6d06-315c-9b64-da02fa36d2d1",
                                        "glosses": [
                                            "Whose expansion is guaranteed not to cause the accidental capture of identifiers."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd4d6c2-b09b-4e6d-827e-9814b612333d",
                                                "sense_id": "7dd56da9-871a-30d8-9c1e-704c9a55dd4d",
                                                "text": "Of course, anyone with a Scheme background is probably howling at this point because they have a hygienic macro system that makes unintended variable capture impossible. Allowing variable capture when we really, really want it makes Clojure's macro system technically more dangerous than hygienic systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66753c91-22ed-4d74-bf31-76fe63b88d52",
                        "source_entry_id": "eb5d4cb3-6c98-3395-9437-a5e03f52fb04",
                        "source_sense_id": "5b6f9a51-3768-3463-b8a7-518d640cadcc",
                        "source_sense_description": "met betrekking tot de gezondheid",
                        "target_lang_word": "sanitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3ff358-24e9-3dd3-816b-6fc48a8a53e4",
                                        "entry_id": "3289d015-f5a1-3127-b552-01b1d3522ffa",
                                        "glosses": [
                                            "Qui a rapport à la santé, et particulièrement à la conservation de la santé publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddac28b8-14c7-4dfc-9806-5c20c4b12e15",
                                                "sense_id": "5f3ff358-24e9-3dd3-816b-6fc48a8a53e4",
                                                "text": "La première édition, à l’été 2020, avait pris des airs de guinguette améliorée à cause des mesures sanitaires post-confinement."
                                            },
                                            {
                                                "example_id": "390467be-c691-4bdc-8395-0e4966637982",
                                                "sense_id": "5f3ff358-24e9-3dd3-816b-6fc48a8a53e4",
                                                "text": "À des fins de veille sanitaire, le ministre chargé de l’agriculture constitue sous son autorité des réseaux de surveillance et de prévention des risques sanitaires au sein desquels des missions de surveillance ou de prévention peuvent être confiées à des organismes à vocation sanitaire ou à des organisations vétérinaires à vocation technique reconnus par l’autorité administrative."
                                            },
                                            {
                                                "example_id": "67d113d1-656c-4cc6-8fc5-e5aca4f18147",
                                                "sense_id": "5f3ff358-24e9-3dd3-816b-6fc48a8a53e4",
                                                "text": "Les infections subcliniques, révélées uniquement par l’inspection sanitaire des carcasses, ne seraient pas rares."
                                            },
                                            {
                                                "example_id": "a377369c-a2ba-489e-9b44-2bee379b2d4a",
                                                "sense_id": "5f3ff358-24e9-3dd3-816b-6fc48a8a53e4",
                                                "text": "L’embastillement sanitaire et épidémiologique peut pour autant nuire davantage que l’emmurement volontaire de l’abstraction créative ? Peut-il conduire à un esseulement frisant la déréliction ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sanitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a50ed459-10fd-3ea9-8803-2a7e7a562359",
                                        "entry_id": "efa6eec8-ff1d-3170-8e0f-159d82fb0a58",
                                        "glosses": [
                                            "Cabinet de toilette, toilettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c849ff-986a-4db0-a4ae-8093846843ea",
                                                "sense_id": "a50ed459-10fd-3ea9-8803-2a7e7a562359",
                                                "text": "On peut envisager d'installer soi-même une salle de bains. Les industriels ont mis au point des sanitaires préfabriqués : leur principal avantage est une simplification des branchements d'arrivée et d'évacuation des eaux."
                                            },
                                            {
                                                "example_id": "9e6a8b30-a86a-4392-bde2-12be15888874",
                                                "sense_id": "a50ed459-10fd-3ea9-8803-2a7e7a562359",
                                                "text": "La petite maison offre un confort inouï pour la classe ouvrière de l’époque – deux pièces de jour, des chambres distinctes pour les parents et les enfants, des sanitaires, un grand jardin, un potager."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
