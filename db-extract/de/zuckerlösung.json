                "senses": [
                    {
                        "sense_id": "675555f4-774f-3330-a62a-05a8a521e147",
                        "entry_id": "fe58f3f2-fc39-3c6b-a6ad-2154b45507b3",
                        "glosses": [
                            "Wasser, in dem Zucker gelöst wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4282ed25-febf-4dd5-939a-fea3c667d6db",
                                "sense_id": "675555f4-774f-3330-a62a-05a8a521e147",
                                "text": "„Die Kanüle sticht durch ihre Haut und die Zuckerlösung strömt in ihre Adern.“"
                            },
                            {
                                "example_id": "395b7940-005d-4fa5-a8b4-62fe913917bf",
                                "sense_id": "675555f4-774f-3330-a62a-05a8a521e147",
                                "text": "„Die Schöne Frau war zwar der Ansicht, dass der eine oder andere Konsument aus medizinischen Gründen absolut keinen Liter Zuckerlösung zu sich nehmen sollte, aber das behielt sie für sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
