{
    "word_family": [
        "enshrine",
        "enshrinement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bc95d6d-07c1-374e-8632-d3076a1d6e6f",
                    "sense_definition": "A holy or sacred place dedicated to a specific deity, ancestor, hero, martyr, or saint.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sacred_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people travel long distances to visit the <w>shrine</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди преодолевают большие расстояния, чтобы посетить <w>святилище</w>.",
                                "es": "Mucha gente viaja largas distancias para visitar el <w>santuario</w>."
                            }
                        },
                        {
                            "text": "They built a small <w>shrine</w> in the garden to honor their ancestors.",
                            "target_lang_translations": {
                                "ru": "Они построили в саду небольшой <w>алтарь</w>, чтобы почтить память предков.",
                                "es": "Construyeron un pequeño <w>altar</w> en el jardín para honrar a sus antepasados."
                            }
                        }
                    ],
                    "synonyms": [
                        "sanctuary",
                        "temple",
                        "altar"
                    ],
                    "common_phrases": [
                        "visit a shrine",
                        "build a shrine",
                        "roadside shrine",
                        "Buddhist shrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Святое или священное место, посвященное определенному божеству, предку, герою или святому.",
                        "es": "Lugar santo o sagrado dedicado a una deidad, antepasado, héroe, mártir o santo en particular."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святилище",
                                "target_lang_sense_clarification": "общее название священного места"
                            },
                            {
                                "target_lang_word": "храм",
                                "target_lang_sense_clarification": "здание для богослужений"
                            },
                            {
                                "target_lang_word": "алтарь",
                                "target_lang_sense_clarification": "небольшое место для поклонения, часто домашнее"
                            },
                            {
                                "target_lang_word": "часовня",
                                "target_lang_sense_clarification": "маленькая церковь"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "santuario",
                                "target_lang_sense_clarification": "lugar sagrado de devoción o peregrinación"
                            },
                            {
                                "target_lang_word": "altar",
                                "target_lang_sense_clarification": "estructura u oratorio pequeño para el culto"
                            },
                            {
                                "target_lang_word": "ermita",
                                "target_lang_sense_clarification": "pequeña capilla o santuario comúnmente en despoblado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bdc4295-f268-3aad-9e54-f036735c512c",
                    "sense_definition": "A place or object respected because of its history or associations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sacred_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician's childhood home has become a <w>shrine</w> for his fans.",
                            "target_lang_translations": {
                                "ru": "Дом детства музыканта стал <w>местом поклонения</w> для его фанатов.",
                                "es": "La casa de la infancia del músico se ha convertido en un <w>santuario</w> para sus seguidores."
                            }
                        },
                        {
                            "text": "This library is considered a <w>shrine</w> of learning and knowledge.",
                            "target_lang_translations": {
                                "ru": "Эта библиотека считается <w>храмом</w> науки и знаний.",
                                "es": "Esta biblioteca es considerada un <w>templo</w> del aprendizaje y del saber."
                            }
                        }
                    ],
                    "synonyms": [
                        "memorial",
                        "monument"
                    ],
                    "common_phrases": [
                        "shrine to democracy",
                        "national shrine",
                        "shrine of art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или предмет, почитаемые из-за их истории или важных ассоциаций.",
                        "es": "Lugar u objeto muy respetado por su historia o por las asociaciones o recuerdos que evoca."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святыня",
                                "target_lang_sense_clarification": "предмет или место глубокого почитания"
                            },
                            {
                                "target_lang_word": "место поклонения",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "santuario",
                                "target_lang_sense_clarification": "lugar emblemático u objeto de gran reverencia"
                            },
                            {
                                "target_lang_word": "templo",
                                "target_lang_sense_clarification": "lugar dedicado a un saber, arte o actividad"
                            },
                            {
                                "target_lang_word": "lugar de peregrinación",
                                "target_lang_sense_clarification": "sitio muy frecuentado por admiradores o devotos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8fbe338-0b26-3091-85f9-700c604ade1f",
                    "sense_definition": "A case, box, or receptacle, especially one containing sacred relics.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest carefully opened the golden <w>shrine</w> to reveal the ancient bones.",
                            "target_lang_translations": {
                                "ru": "Священник осторожно открыл золотую <w>раку</w>, чтобы показать древние мощи.",
                                "es": "El sacerdote abrió con cuidado el <w>relicario</w> dorado para mostrar los antiguos huesos."
                            }
                        },
                        {
                            "text": "Visitors admired the intricate craftsmanship of the medieval <w>shrine</w>.",
                            "target_lang_translations": {
                                "ru": "Посетители восхищались искусной работой средневекового <w>ковчега</w>.",
                                "es": "Los visitantes admiraron la elaborada artesanía del <w>relicario</w> medieval."
                            }
                        }
                    ],
                    "synonyms": [
                        "reliquary"
                    ],
                    "common_phrases": [
                        "golden shrine",
                        "relic shrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ларец, ящик или вместилище, особенно содержащее священные реликвии (мощи).",
                        "es": "Cofre, arqueta o receptáculo, especialmente aquel que contiene reliquias sagradas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рака",
                                "target_lang_sense_clarification": "гробница с мощами святого"
                            },
                            {
                                "target_lang_word": "ковчег",
                                "target_lang_sense_clarification": "ларец для хранения святынь"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "relicario",
                                "target_lang_sense_clarification": "caja o estuche para custodiar reliquias"
                            },
                            {
                                "target_lang_word": "urna",
                                "target_lang_sense_clarification": "caja o recipiente cerrado para restos o reliquias"
                            },
                            {
                                "target_lang_word": "arqueta",
                                "target_lang_sense_clarification": "cofre pequeño decorado con fines religiosos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f852e74-6530-3d60-8f1f-d18278e467ce",
                    "sense_definition": "To place reverently, as if in a holy place; to enshrine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her memory was <w>shrined</w> in his heart forever.",
                            "target_lang_translations": {
                                "ru": "Память о ней навеки <w>сохранилась</w> в его сердце.",
                                "es": "El recuerdo de ella quedó <w>atesorado</w> en su corazón para siempre."
                            }
                        },
                        {
                            "text": "The precious artifact was <w>shrined</w> within the temple walls.",
                            "target_lang_translations": {
                                "ru": "Драгоценный артефакт <w>хранился</w> в стенах храма.",
                                "es": "El valioso artefacto fue <w>custodiado</w> entre los muros del templo."
                            }
                        }
                    ],
                    "synonyms": [
                        "enshrine",
                        "cherish"
                    ],
                    "common_phrases": [
                        "shrined in memory"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usually replaced by 'enshrine' in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Благоговейно хранить или помещать, словно в святом месте.",
                        "es": "Guardar o custodiar con reverencia o devoción, como si fuera en un lugar sagrado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "беречь как святыню"
                            },
                            {
                                "target_lang_word": "лелеять",
                                "target_lang_sense_clarification": "нежно беречь в памяти"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atesorar",
                                "target_lang_sense_clarification": "guardar con aprecio en la memoria o el corazón"
                            },
                            {
                                "target_lang_word": "consagrar",
                                "target_lang_sense_clarification": "venerar o reservar con devoción"
                            },
                            {
                                "target_lang_word": "guardar",
                                "target_lang_sense_clarification": "conservar con cuidado y respeto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}