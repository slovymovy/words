{
    "word_family": [
        "thunderous",
        "thundery",
        "thunderbolt",
        "thunderstorm",
        "thunderclap",
        "thundering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23cb5e1a-8148-3d65-9451-0f7e8fc4d738",
                    "sense_definition": "The loud rumbling or crashing sound caused by the expansion of air around a lightning bolt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were frightened by the loud <w>thunder</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Дети были напуганы громким <w>громом</w> во время шторма."
                            }
                        },
                        {
                            "text": "We heard a loud <w>clap</w> of <w>thunder</w> just before the rain started.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>раскат</w> грома прямо перед тем, как начался дождь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clap of thunder",
                        "roll of thunder",
                        "distant thunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий рокочущий или грохочущий звук, вызванный расширением воздуха вокруг разряда молнии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гром",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "раскат грома",
                                "target_lang_sense_clarification": "звуковой эффект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6c88ce5-ea62-3703-84b2-6fa93bb5bdbe",
                    "sense_definition": "A deep, heavy, rumbling noise that resembles the sound of atmospheric thunder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thunder</w> of the waterfall could be heard from a mile away.",
                            "target_lang_translations": {
                                "ru": "<w>Грохот</w> водопада был слышен за милю."
                            }
                        },
                        {
                            "text": "He was startled by the <w>thunder</w> of hoofbeats as the horses ran past.",
                            "target_lang_translations": {
                                "ru": "Он вздрогнул от <w>топота</w> копыт, когда лошади промчались мимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thunder of hoofbeats",
                        "thunder of drums"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий, тяжелый, рокочущий шум, напоминающий звук атмосферного грома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "сильный, оглушительный звук"
                            },
                            {
                                "target_lang_word": "рокот",
                                "target_lang_sense_clarification": "монотонное раскатистое звучание"
                            },
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "протяжный шум"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09bb5437-6281-334f-8f63-b88c40d694ea",
                    "sense_definition": "An alarming or startling threat, denunciation, or strong verbal warning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced the <w>thunders</w> of the opposition after his controversial speech.",
                            "target_lang_translations": {
                                "ru": "Политик столкнулся с <w>громами</w> негодования оппозиции после своей скандальной речи."
                            }
                        },
                        {
                            "text": "The <w>thunders</w> of the church were directed at those who broke the law.",
                            "target_lang_translations": {
                                "ru": "Церковные <w>проклятия</w> были направлены на тех, кто нарушил закон."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in a literary or dramatic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тревожная или пугающая угроза, осуждение или строгое устное предупреждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громы",
                                "target_lang_sense_clarification": "гневные речи или угрозы"
                            },
                            {
                                "target_lang_word": "проклятия",
                                "target_lang_sense_clarification": "в контексте церковного или официального осуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20503168-69fe-31c3-8890-0ac207e85beb",
                    "sense_definition": "A very long word, specifically one of the hundred-letter words used by James Joyce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars often analyze the first <w>thunder</w> in Finnegans Wake for its linguistic complexity.",
                            "target_lang_translations": {
                                "ru": "Ученые часто анализируют первое <w>слово-гром</w> в «Поминках по Финнегану» на предмет его лингвистической сложности."
                            }
                        },
                        {
                            "text": "The author used a <w>thunder</w> word to represent the fall of man.",
                            "target_lang_translations": {
                                "ru": "Автор использовал <w>громоподобное слово</w>, чтобы изобразить грехопадение человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "thunder word"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень длинное слово, в частности, одно из стобуквенных слов, использованных Джеймсом Джойсом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слово-гром",
                                "target_lang_sense_clarification": "литературоведческий термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f1ba61f-c503-3b0d-82c2-fd5bfa82ef03",
                    "sense_definition": "To produce the sound of thunder during a storm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>thundered</w> all night, making it very difficult for us to sleep.",
                            "target_lang_translations": {
                                "ru": "Всю ночь <w>гремело</w>, из-за чего нам было очень трудно уснуть."
                            }
                        },
                        {
                            "text": "The sky grew dark and it began to <w>thunder</w> and lighten.",
                            "target_lang_translations": {
                                "ru": "Небо потемнело, и начали сверкать молнии и <w>греметь</w> гром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thunder and lighten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звуки грома во время грозы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греметь",
                                "target_lang_sense_clarification": "о громе"
                            },
                            {
                                "target_lang_word": "грохотать",
                                "target_lang_sense_clarification": "издавать раскатистые звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81bdcc01-8063-3fe8-9174-444cd502689b",
                    "sense_definition": "To make a very loud, deep, and rumbling noise while moving.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy freight train <w>thundered</w> along the tracks through the valley.",
                            "target_lang_translations": {
                                "ru": "Тяжелый товарный состав с <w>грохотом</w> пронесся по путям через долину."
                            }
                        },
                        {
                            "text": "The herd of elephants <w>thundered</w> across the dry plains.",
                            "target_lang_translations": {
                                "ru": "Стадо слонов с <w>топотом</w> пронеслось по засушливым равнинам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thunder along",
                        "thunder past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать очень громкий, глубокий и рокочущий шум во время движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грохотать",
                                "target_lang_sense_clarification": "о движущемся транспорте или массе"
                            },
                            {
                                "target_lang_word": "нестись с грохотом",
                                "target_lang_sense_clarification": "быстрое шумное движение"
                            },
                            {
                                "target_lang_word": "прогреметь",
                                "target_lang_sense_clarification": "проехать с шумом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d7e7318-5179-3ea0-bb61-3ad253bfe8af",
                    "sense_definition": "To speak or shout something in a very loud, angry, or threatening voice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Get out of my house!\" he <w>thundered</w> at the intruder.",
                            "target_lang_translations": {
                                "ru": "«Вон из моего дома!» — <w>прогремел</w> он незваному гостю."
                            }
                        },
                        {
                            "text": "The judge <w>thundered</w> his final decision to the silent courtroom.",
                            "target_lang_translations": {
                                "ru": "Судья <w>громогласно объявил</w> свое окончательное решение в притихшем зале суда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thunder a command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или кричать что-либо очень громким, сердитым или угрожающим голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греметь",
                                "target_lang_sense_clarification": "говорить очень громко и властно"
                            },
                            {
                                "target_lang_word": "прогреметь",
                                "target_lang_sense_clarification": "выкрикнуть громогласно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1bf6157-1b35-3a3a-9ebf-823c622fdf67",
                    "sense_definition": "To strike or move something with incredible power and speed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "power_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>thundered</w> the ball into the back of the net.",
                            "target_lang_translations": {
                                "ru": "Нападающий мощным ударом <w>вколотил</w> мяч в сетку ворот."
                            }
                        },
                        {
                            "text": "He <w>thundered</w> a powerful shot from outside the penalty area.",
                            "target_lang_translations": {
                                "ru": "Он <w>нанес</w> мощнейший удар из-за пределов штрафной площади."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thunder a shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять или перемещать что-либо с невероятной силой и скоростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вколотить",
                                "target_lang_sense_clarification": "с силой забить мяч"
                            },
                            {
                                "target_lang_word": "пробить",
                                "target_lang_sense_clarification": "нанести мощный удар"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c00c9a2-9804-3701-b777-8ed052c27515",
                    "sense_definition": "The English name for the 13th chapter (sura) of the Qur'an, known as Ar-Ra'd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_text",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "The <w>Thunder</w> contains verses that discuss the power of God in nature.",
                            "target_lang_translations": {
                                "ru": "Сура «<w>Гром</w>» содержит аяты, в которых говорится о могуществе Бога в природе."
                            }
                        },
                        {
                            "text": "He spent the afternoon reading a translation of the sura titled <w>Thunder</w>.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел за чтением перевода суры под названием «<w>Гром</w>»."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Русское название 13-й суры Корана, известной как Ар-Раад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гром",
                                "target_lang_sense_clarification": "название суры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}