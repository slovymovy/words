{
    "word_family": [
        "festering",
        "festerment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b822d43-cb70-3a91-9ff8-797ee161da05",
                    "sense_definition": "To undergo infection, become septic, or produce pus (of a wound or sore).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not clean the cut immediately, it might <w>fester</w> and become infected. ",
                            "target_lang_translations": {
                                "nl": "Als je de snijwond niet onmiddellijk schoonmaakt, kan deze gaan <w>etteren</w> en geïnfecteerd raken."
                            }
                        },
                        {
                            "text": "The untended cut began to <w>fester</w> under the dirty bandage. ",
                            "target_lang_translations": {
                                "nl": "De niet-verzorgde snijwond begon onder het vuile verband te <w>zweren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rot",
                        "decay",
                        "decompose",
                        "putrefy"
                    ],
                    "common_phrases": [
                        "fester under the bandage"
                    ],
                    "target_lang_definitions": {
                        "nl": "Infecteren, ontstoken raken of pus produceren (van een wond of zweer)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "etteren",
                                "target_lang_sense_clarification": "van een wond of ontsteking"
                            },
                            {
                                "target_lang_word": "zweren",
                                "target_lang_sense_clarification": "pus vormen of ontstoken raken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d430ccae-0f2c-3da1-a9dc-36ea509e969e",
                    "sense_definition": "To become progressively worse or more bitter, especially through neglect or suppression (of feelings or problems).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is better to express your feelings directly rather than let anger <w>fester</w> inside you. ",
                            "target_lang_translations": {
                                "nl": "Het is beter om je gevoelens direct te uiten dan dat je woede vanbinnen laat <w>knagen</w>."
                            }
                        },
                        {
                            "text": "Do not let resentment <w>fester</w> for weeks without talking to your friend. ",
                            "target_lang_translations": {
                                "nl": "Laat wrok niet wekenlang <w>voortwoekeren</w> zonder met je vriend te praten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "let resentment fester",
                        "fester inside",
                        "let it fester"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geleidelijk erger of bitterder worden, vooral door verwaarlozing of onderdrukking (van gevoelens of problemen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blijven knagen",
                                "target_lang_sense_clarification": "van negatieve gevoelens of gedachten"
                            },
                            {
                                "target_lang_word": "voortwoekeren",
                                "target_lang_sense_clarification": "van conflicten of wrok"
                            },
                            {
                                "target_lang_word": "verergeren",
                                "target_lang_sense_clarification": "erger of ernstiger worden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab8b498e-ecec-3b3b-9b64-7af99da4d13d",
                    "sense_definition": "An infected, pus-filled sore or ulcer on the skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor carefully treated the painful <w>fester</w> on the patient's arm. ",
                            "target_lang_translations": {
                                "nl": "De dokter behandelde zorgvuldig de pijnlijke <w>zweer</w> op de arm van de patiënt."
                            }
                        },
                        {
                            "text": "A small prick from a needle turned into an uncomfortable <w>fester</w>. ",
                            "target_lang_translations": {
                                "nl": "Een klein prikje van een naald veranderde in een ongemakkelijke <w>zweer</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "painful fester"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een geïnfecteerde, pusachtige zweer of plek op de huid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zweer",
                                "target_lang_sense_clarification": "ontstoken, pusachtige plek op de huid"
                            },
                            {
                                "target_lang_word": "munt",
                                "target_lang_sense_clarification": "geïnfecteerde huidzweer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "037a839f-a6c6-3a63-85d0-ba085ab68e8f",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fester</w> signed the document at the end of the meeting. ",
                            "target_lang_translations": {
                                "nl": "Meneer <w>Fester</w> ondertekende het document aan het einde van de vergadering."
                            }
                        },
                        {
                            "text": "We invited the <w>Fester</w> family to our neighborhood gathering. ",
                            "target_lang_translations": {
                                "nl": "We hebben de familie <w>Fester</w> uitgenodigd voor onze buurtbijeenkomst."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een achternaam van Duitse oorsprong."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Fester",
                                "target_lang_sense_clarification": "familienaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}