                "senses": [
                    {
                        "sense_id": "c5f6d90a-0b63-36c5-9ec1-d04957b7c45f",
                        "entry_id": "52081ce2-9d40-30c6-b54d-108d90533e83",
                        "glosses": [
                            "Stempel, dessen Hauptfunktion darin besteht, eine Briefmarke zu entwerten, sodass sie nicht noch einmal verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb48e8e-c2ae-47e3-a0f4-35d4df7b1637",
                                "sense_id": "c5f6d90a-0b63-36c5-9ec1-d04957b7c45f",
                                "text": "„Diese waren keine echten ‚Entwerter‘ (‚Killerstempel‘) im eigentlichen Sinne...“"
                            },
                            {
                                "example_id": "af120555-a26d-4059-ae17-ab1b60abc91e",
                                "sense_id": "c5f6d90a-0b63-36c5-9ec1-d04957b7c45f",
                                "text": "„Dass Bayern einen separaten Entwerterstempel einführte, lag im Trend: Frankreich, Belgien, Preußen, Sachsen, bald auch Baden sowie Thurn und Taxis setzten auf solche ‚Killerstempel‘.“"
                            },
                            {
                                "example_id": "7617fde1-2db6-4e66-88b6-953ab0925343",
                                "sense_id": "c5f6d90a-0b63-36c5-9ec1-d04957b7c45f",
                                "text": "„Stempel der US German Seapost waren mit einem Killerstempel kombiniert. Die ovalen Killerstempel sollten jede Wiederverwendung der Marke verhindern.“"
                            },
                            {
                                "example_id": "2213ed72-ef16-4578-8b4c-e80472331484",
                                "sense_id": "c5f6d90a-0b63-36c5-9ec1-d04957b7c45f",
                                "text": "„Die Killerstempel dagegen, die die Post Maschinenstempel nennt, nutzen nur dem Unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
