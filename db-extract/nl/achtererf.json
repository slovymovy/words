                                        "sense_id": "c1374148-9445-3814-a9d7-6afa93f48027",
                                        "entry_id": "e35dd4b4-77cc-3730-9cdd-c891a1c4af11",
                                        "glosses": [
                                            "Erbe, der erst nach einem anderen erbt"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d7c982-f2d1-43e7-9665-6c9596f6f071",
                                                "sense_id": "c1374148-9445-3814-a9d7-6afa93f48027",
                                                "text": "„Mit dem sogenannten Berliner Testament setzen sich die Ehepartner gegenseitig zu Alleinerben ein und bestimmen einen Dritten, meist die gemeinsamen Kinder, als Nacherben nach dem Tod des zuletzt verstorbenen Partners.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
