                    },
                    {
                        "translation_id": "6c11d9ad-86ce-481b-b7a0-c00ed470491f",
                        "source_entry_id": "13bb565b-ad5b-383b-8eea-2fc880017da9",
                        "source_sense_description": "время уменьшения наполовину",
                        "target_lang_word": "half-life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The time required for half the nuclei in a sample of an isotope to undergo radioactive decay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff77dc60-bf07-45ea-a816-63af82dbbcd7",
                                                "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                                "text": "\"The guy that just left—what's he got in his lungs?\" / \"Well, I'm not very sure. But the two best candidates are uranium-233 and plutonium-239, one or both.\" / \"They're in his bones too, aren't they?\" / \"Yeah, they're both boneseekers. And they've got half-lives of one hundred sixty-two thousand and twenty-four thousand years respectively. So they stay hot for a long time.\""
                                            },
                                            {
                                                "example_id": "b9084599-0403-4ceb-bd97-a44b96c5b012",
                                                "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                                "text": "O₂^(•−) and OH^• are highly unstable (half-life at the level of microseconds and nanoseconds, respectively) and cannot cross membrane, while H₂O₂, though not a free radical but a ROS, is relatively stable (half-life around 1 ms) (Møller et al. 2007) and can cross membranes through aquaporins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1998337-af91-3f74-96bb-e666fb2a8fc5",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "In a chemical reaction, the time required for the concentration of a reactant to fall from a chosen value to half that value."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f664353b-d6f0-35e7-ae33-bbd868a60d1b",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The time it takes for a substance (drug, radioactive nuclide, or other) to lose half of its pharmacological, physiologic, or radiological activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0daf28-2ca0-4961-aa96-a6889b601c9d",
                                                "sense_id": "f664353b-d6f0-35e7-ae33-bbd868a60d1b",
                                                "text": "For nonporous surfaces such as steel, in a dark and low-humidity environment, the CCP virus has an 18-hour half-life—the time required for it to decrease by half , according to the researchers' findings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b118f584-4fa5-3c49-a8df-3a57a61d71e8",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The amount of time it takes for an idea or a fashion to lose half of its influential power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab237bd4-59a0-4e65-8ab3-73526dc627e6",
                                                "sense_id": "b118f584-4fa5-3c49-a8df-3a57a61d71e8",
                                                "text": "Most books of scholarship have surprisingly short intellectual half-lives during which they make a difference\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
