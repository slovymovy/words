                    {
                        "sense_id": "87da2157-ff8b-3042-af75-ae6c97f73771",
                        "entry_id": "905e1115-3e8c-34b6-9e3a-c8a141bae26f",
                        "glosses": [
                            "heel erg luid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cffd430-21fd-47aa-aa7c-9f7ab8b65ffa",
                                "sense_id": "87da2157-ff8b-3042-af75-ae6c97f73771",
                                "text": "„Een huiveringwekkende geluidsinstallatie en strakke (inter)nationale line up zorgen ervoor dat er stevig geknald gaat worden”, laat de organisatie weten. „Door de afgelegen ligging kan de muziek er loeihard klinken.” Het festival begint ’s middags en duurt tot middernacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd59339c-0192-3d1b-b595-dcd0faf4189a",
                        "entry_id": "905e1115-3e8c-34b6-9e3a-c8a141bae26f",
                        "glosses": [
                            "heel krachtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76da55e3-a918-44e5-bd50-3e2713f0fb4d",
                                "sense_id": "dd59339c-0192-3d1b-b595-dcd0faf4189a",
                                "text": "Europa is nog niet klaar met 'Selmayr-gate'. De resolutie die het Parlement heeft opgetuigd voor een eerste stemming op maandag 16 april is loeihard geworden."
                            }
                        ]
                    }
                ],
