    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5e71586-1a35-3e6b-a8fc-83dac3d66183",
                    "sense_definition": "Manque de justice, d'équité ou d'impartialité dans un comportement ou un principe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caractere_injuste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens éprouvent un profond sentiment d'<w>injustice</w> face à cette décision arbitraire du gouvernement."
                        },
                        {
                            "text": "Quand elle a été punie sans raison valable, elle n'a pas pu s'empêcher de crier à l'<w>injustice</w>."
                        }
                    ],
                    "synonyms": [
                        "iniquité",
                        "partialité"
                    ],
                    "antonyms": [
                        "équité",
                        "justice"
                    ],
                    "common_phrases": [
                        "sentiment d'injustice",
                        "crier à l'injustice"
                    ]
                },
                {
                    "sense_id": "d8e8a921-cc0b-36c7-bb1a-6a1e07bfd69e",
                    "sense_definition": "Acte ou comportement concret contraire à la justice ou au droit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acte_injuste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a reconnu son erreur et a tout fait pour réparer une <w>injustice</w> commise envers son employé."
                        },
                        {
                            "text": "Les journalistes ont refusé de fermer les yeux face aux nombreuses <w>injustices</w> perpétrées par le régime en place."
                        }
                    ],
                    "synonyms": [
                        "abus",
                        "iniquité",
                        "tort"
                    ],
                    "antonyms": [
                        "justice"
                    ],
                    "common_phrases": [
                        "commettre une injustice",
                        "réparer une injustice",
                        "subir une injustice"
                    ]
                },
                {
                    "sense_id": "e51be2a7-87d4-3c1b-b4b4-02b3e21f9cef",
                    "sense_definition": "Situation sociale, politique ou économique caractérisée par un déséquilibre ou un traitement inéquitable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "situation_injuste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses associations se mobilisent chaque jour pour lutter contre l'<w>injustice</w> dans les quartiers défavorisés."
                        },
                        {
                            "text": "La crise économique a accentué les <w>injustices</w> sociales qui frappent les familles les plus vulnérables."
                        }
                    ],
                    "synonyms": [
                        "inégalité",
                        "iniquité"
                    ],
                    "antonyms": [
                        "égalité",
                        "justice"
                    ],
                    "common_phrases": [
                        "injustices sociales",
                        "lutter contre l'injustice"
                    ]
                }
            ]
        }
    ]
