                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237beae5-38a9-4af8-a646-7988e78e4da7",
                                "sense_id": "44ead6ee-d876-3708-899d-1dec7071af15",
                                "text": "Il y a deux ans quand Jake Allen a taquiné le saumon sur la rivière Miramichi avec Cormier, il n’a pas passé son temps à chercher les secrets d’une aussi longue carrière au baseball."
                            }
                        ]
                    }
