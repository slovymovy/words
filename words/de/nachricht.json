                    "frequency": "High",
                    "semantic_group_id": "Journalismus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden Abend um zwanzig Uhr sehen meine Eltern die <w>Nachrichten</w> im Fernsehen."
