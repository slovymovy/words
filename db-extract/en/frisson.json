                                        "entry_id": "6a0dfae8-b0f8-306f-96e9-ef401e26a0c0",
                                        "glosses": [
                                            "kleine, unkontrollierte, wiederholte Hin- und Herbewegungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c26bfa87-6f78-45e9-928d-fddbe897bbc1",
                                                "sense_id": "98678a5e-80c1-3f83-a5ee-d4bc704e09e4",
