                ],
                "senses": [
                    {
                        "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                        "entry_id": "8708e84a-f05f-3779-827b-17cd310918a6",
                        "glosses": [
                            "Ausbau einer (meist alten oder defekten) Heizung und Einbau einer neuen Heizung"
                        ],
                        "tags": [
                            "Gebäudesanierung"
                        ],
                        "examples": [
                            {
                                "example_id": "bf4c9cc1-1294-404c-aed6-bdd08818e89e",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Wann ist ein Heizungsaustausch nötig?“"
                            },
                            {
                                "example_id": "cbc3809c-78b2-4b91-a852-f3d6a4128480",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "Eine knappe Million Hausbesitzer in Deutschland wird 2024 von einer Pflicht zum Heizungsaustausch ihrer Gas- oder Ölheizung betroffen sein, weil ihre Heizung dann älter als 30 Jahre ist."
                            },
                            {
                                "example_id": "7699de9c-4b53-4075-b69d-b484c4fb7e69",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Manche Sanierungsmaßnahmen müssen bei einem Immobilienkauf ergriffen werden. Das kann etwa für den Heizungsaustausch gelten, wenn die Heizung ein bestimmtes Alter erreicht hat“ […]."
                            },
                            {
                                "example_id": "5f4a45f3-d1d3-4ede-bcc2-6135c0de1d17",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Doch schon vor dem neuen Beschluss zum Heizungsaustausch sah das Gebäudeenergiegesetz vor, dass Hauseigentümer mit Heizkessel, die mit einem flüssigen oder gasförmigen Brennstoff beschickt werden und ab dem 1. Januar 1991 eingebaut oder aufgestellt worden sind, diese nach Ablauf von 30 Jahren nicht mehr betreiben dürfen.“"
                            },
                            {
                                "example_id": "01fe85e3-22b6-4963-9a92-ed95e18ec5f0",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Nachdem die frühere Umweltministerin Tanja Gönner (CDU) Hausbesitzer verpflichtete, bei einem Heizungsaustausch teilweise auf erneuerbare Energien umzustellen, gingen die Sanierungsraten stark zurück. Viele Hausbesitzer reparieren nun offenbar lieber die alte Anlage.“"
                            },
                            {
                                "example_id": "809104e1-f357-4539-a9a9-29adcd645658",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "Der Heizungsaustauch ist für viele Bürger teuer."
                            },
                            {
                                "example_id": "f8530dd0-fde7-49e2-9902-34e436768813",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Je später der Heizungsaustausch angegangen wird, umso schlechter ist das nicht nur für den Klimaschutz.“"
                            },
                            {
                                "example_id": "021eff1b-0ecd-42ef-b993-55f341640663",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "[…] „Für den Heizungsaustausch fehlt ein gutes Förderprogramm, mit dem der großflächige Wertverlust von Wohngebäuden und soziale Härten vermieden werden können.“"
                            },
                            {
                                "example_id": "583e863a-88e5-4bf6-8d20-93a29513788f",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "[Schlagzeile:] „Streit über Wärmewende – CDU will 50 Prozent Förderung bei Heizungsaustausch“"
                            },
                            {
                                "example_id": "0d730bca-c5fd-4334-a945-2caa88783318",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "[Schlagzeile:] „FDP will Gesetz zum Heizungsaustausch verhindern“"
                            },
                            {
                                "example_id": "d1d9b776-77c7-4fc8-a748-a4b37d26ccc7",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "[Dänemark:] „Seit 2016 gilt in Bestandsgebäuden ein Verbot des Austauschs alter fossiler Heizkessel gegen neue fossile Heizungen. Zugleich wurde ein Förderprogramm für den Heizungsaustausch aufgelegt.“"
                            },
                            {
                                "example_id": "46600d7f-6e77-42f3-b37b-d1608076d4f4",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Das am Mittwoch auf den Weg gebrachte Gesetz zum Heizungsaustausch ist nach Bramanns Ansicht kein Grund zur Sorge: »Eine Wärmepumpe einzubauen, ist keine Raketentechnologie.«“"
                            },
                            {
                                "example_id": "259b6186-c8eb-4fbe-9b30-01c5d0270092",
                                "sense_id": "8f14eb38-ef23-3021-83ab-867d62c80919",
                                "text": "„Es gibt also gute Gründe für eine Heizungssanierung. Damit einem reibungslosen Heizungsaustausch nichts im Wege steht, hier unsere Tipps:“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
