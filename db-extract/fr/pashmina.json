                                "target_senses": [
                                    {
                                        "sense_id": "0f98da46-4cc1-330d-9e6a-e2b8a13fadf8",
                                        "entry_id": "233cdef9-948b-3c88-8940-d33a21186298",
                                        "glosses": [
                                            "A Cashmere; a goat native to Kashmir."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38eae4f9-d058-39b2-a4f9-f9ee5dd3fd5d",
                                        "entry_id": "233cdef9-948b-3c88-8940-d33a21186298",
                                        "glosses": [
                                            "The fine wool that grows under the hair of this goat; cashmere."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdc404c4-79f6-3dad-ab9d-a33b147067f4",
                                        "entry_id": "233cdef9-948b-3c88-8940-d33a21186298",
                                        "glosses": [
                                            "A soft fabric made from this wool; (in particular) a shawl made from this fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1eaf7a-11d1-4b93-91b2-a421b674bc37",
                                                "sense_id": "bdc404c4-79f6-3dad-ab9d-a33b147067f4",
                                                "text": "However, Leh's most important product is the soft underwool of sheep and goats, most of which are tended by nomads, men who roam about the uplands with their herds. It is this fine, soft wool which is used to make the famous pashmina shawls of Kashmir."
                                            },
                                            {
                                                "example_id": "2afd684e-5e3a-4bbe-a15a-15dd4852fa2b",
                                                "sense_id": "bdc404c4-79f6-3dad-ab9d-a33b147067f4",
                                                "text": "Pashmina was invented more than four hundred years ago when Nur Jaban, wife of the Emperor Jehangir, asked her weavers to present a woolen fabric that was \"as light as a cloud but as warm as a tender embrace.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
