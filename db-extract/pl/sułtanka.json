                "senses": [
                    {
                        "sense_id": "84832536-eff2-3966-bba6-f53b80458329",
                        "entry_id": "fe3bd2a2-04ab-3ef8-b10e-a2870dff0ae5",
                        "glosses": [
                            "okrągła jasnożółta rodzynka bez pestek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b68d902-0fe8-4987-a09b-acca46a9386d",
                                "sense_id": "84832536-eff2-3966-bba6-f53b80458329",
                                "text": "W ciągu dziewięciu miesięcy ubiegłego roku sprowadziliśmy ok. 5 tys. ton samych tylko jasnożółtych rodzynek sułtanek"
                            },
                            {
                                "example_id": "71bdd283-05bb-4912-82e1-87c80a01dbbd",
                                "sense_id": "84832536-eff2-3966-bba6-f53b80458329",
                                "text": "Najpopularniejsze rodzaje rodzynek to sułtanki z Turcji i Iranu, ale można spotkać koryntki Grecji, a także złote bezpestkowe rodzynki Thompson z Chile"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "212e9556-975a-368d-8c00-97065ea5dd62",
                        "entry_id": "fe3bd2a2-04ab-3ef8-b10e-a2870dff0ae5",
                        "glosses": [
                            "córka, krewna, małżonka, nałożnica, siostra, żona sułtana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a8d3dfc-2b63-400a-8288-64ceb994306b",
                                "sense_id": "212e9556-975a-368d-8c00-97065ea5dd62",
                                "text": "– Alhambra to taki zamek rozwlekły, pokoje, przejścia, połączenia z ogrodami. – To tam przyłapał sułtan sułtankę na zdradzie"
                            },
                            {
                                "example_id": "1df92354-d521-4572-951d-34c4effc6416",
                                "sense_id": "212e9556-975a-368d-8c00-97065ea5dd62",
                                "text": "Zapoczątkowany przez Roksolanę okres rzeczywistego wpływu żon sułtanów na ich mężów nazywany jest rządem sułtanek – w czym upatruje się jedną z przyczyn upadku Imperium Osmańskiego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
