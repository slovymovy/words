                "senses": [
                    {
                        "sense_id": "4bb9d0ea-f900-3106-9853-5dc7b886bd94",
                        "entry_id": "b272efc7-229e-37e2-a846-680cebe5f586",
                        "glosses": [
                            "(zumeist einwöchige und üblicherweise im Juni oder Oktober stattfindende) kurze Schulferien"
                        ],
                        "tags": [
                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "c5e6457a-b41e-4452-81af-636f861b08f4",
                                "sense_id": "4bb9d0ea-f900-3106-9853-5dc7b886bd94",
                                "text": "„Seit August vergangen Jahres wird gebaut und nach den Zwischenferien in der ersten Juliwoche soll der komplette Physik- und Chemieunterricht dort stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                        "entry_id": "b272efc7-229e-37e2-a846-680cebe5f586",
                        "glosses": [
                            "oft einwöchige kurze Schul- oder Hochschulferien"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "f262b75e-4714-4142-921c-bcd32f2ed0ee",
                                "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                                "text": "„Anlangend die Einstellung der Vorlesungen von Weihnachten bis Neujahr, so finden diese Zwischenferien in Würtemberg bis jetzt nur factisch statt, und man hält dafür, daß es hierbei oder bei der Duldung derselben um so mehr zu belassen sey, als eine gesetzliche Festsetzung derselben, nach dem gewöhnlichen Gange der Dinge, nur zur factischen Verlängerung dieser Zwischenferien führen dürfte.“"
                            },
                            {
                                "example_id": "34d95126-eb09-4669-ab83-3c0cb04b0016",
                                "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                                "text": "„Die vielen ganzen und halben Feiertage ersetzen die vermissten Zwischenferien reichlich.“"
                            },
                            {
                                "example_id": "9ce66ec0-3b18-46a7-9e8c-6bf4ce22d693",
                                "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                                "text": "„Stadtschulratspräsidentin Susanne Brandsteidl plädiert für eine zentrale Regelung, da Eltern mit Kindern in verschiedenen Schulen nicht damit rechnen können, dass die Kinder zu gleichen Zeiten ‚Zwischenferien‘ haben.“"
                            },
                            {
                                "example_id": "3de5650d-0c28-4783-8458-4d0065211fca",
                                "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                                "text": "„Als sie in den Zwischenferien Ende Februar mit Angelo zu Freddie nach Oxford fuhr und er in seinem Körbchen die ganze Fahrt durchschlief, war sie so stolz, als hätte sie den Mount Everest bezwungen.“"
                            },
                            {
                                "example_id": "c723cfe2-7527-4780-84a8-2b5cc78ec7e4",
                                "sense_id": "b1b7041f-a89b-3fee-8a57-610da06e2b72",
                                "text": "„Dennoch wäre ein vernünftiger Rhythmus von längeren Arbeitsperioden und Ferienzeiten anstatt der Hektik von allerlei Zwischenferien und den ominösen österreichischen Fenstertagen eine ökonomisch und sozialhygienisch sinnvolle Maßnahme.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
