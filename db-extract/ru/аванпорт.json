                    },
                    {
                        "form_id": "5ca94354-2bfb-40eb-8272-ac99e774306a",
                        "entry_id": "5473821b-735f-355f-8087-e89fb44b0294",
                        "tags": [
                            "singular",
                            "locative"
                        ],
                        "form": "(в) аванпо́рте и (в) аванпорту́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                        "entry_id": "5473821b-735f-355f-8087-e89fb44b0294",
                        "glosses": [
                            "внешняя часть порта, приспособленная для разгрузки и погрузки судов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731a18a3-5d48-4730-8588-7ebb70734dd7",
                                "sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                                "text": "Миновав плавучий маяк, эскадра зашла за каменный волнолом и бросила якорь в довольно просторном аванпорте."
                            },
                            {
                                "example_id": "b836c032-7556-49cf-9a00-168c89c86723",
                                "sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                                "text": "Выскочив со стороны моря, они вихрем промчались на бреющем и внезапно ударили по транспортам, стоявшим в аванпорту."
                            },
                            {
                                "example_id": "7d22f0cf-b984-4510-ba55-740240e6605d",
                                "sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                                "text": "Высокую оценку проекту аванпорта дал министр транспорта Максим Соколов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bebadfa7-6995-47d7-a888-e946c87729fb",
                        "source_entry_id": "5473821b-735f-355f-8087-e89fb44b0294",
                        "source_sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                        "target_lang_word": "outport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1e6928-360e-3cba-9563-cd888488ebf0",
                                        "entry_id": "be391e69-5e23-328d-9a29-b6d9da7300e8",
                                        "glosses": [
                                            "A port city or harbor which is secondary to a main port; it may be a distant one or a nearby auxiliary one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e69d0d-2840-4d03-821a-77a8b3ef877a",
                                                "sense_id": "dd1e6928-360e-3cba-9563-cd888488ebf0",
                                                "text": "Outport or provincial contacts like those of Cogan, Vassal, Bidgood, or Samuel Cole were exceptions. To a remarkable extent the first exchanges of goods were carried on between London and Boston. In fact, the bulk of the traffic originated in a few streets of the English capital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c828fffa-a04a-35b1-a93b-c9e4cca4b90f",
                                        "entry_id": "be391e69-5e23-328d-9a29-b6d9da7300e8",
                                        "glosses": [
                                            "Any city, town, or village having a port, other than the main port of St. John's."
                                        ],
                                        "tags": [
                                            "Newfoundland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0344acad-ac55-44ae-bcb5-9a7947122a51",
                        "source_entry_id": "5473821b-735f-355f-8087-e89fb44b0294",
                        "source_sense_id": "ba0031e1-6fbe-35fc-9b66-49a43812c700",
                        "target_lang_word": "avant-port",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant-port",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db9e9eca-50bd-3907-8bde-ed6f3d2e2178",
                                        "entry_id": "59e449bd-6fa7-3b20-b363-5055955980e7",
                                        "glosses": [
                                            "Entrée d’un grand port, en dehors de son enceinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238cb15c-8a14-48fc-a9f2-e8664b54769d",
                                                "sense_id": "db9e9eca-50bd-3907-8bde-ed6f3d2e2178",
                                                "text": "Les huîtrières, grands réservoirs établis au S.-E. de l’avant-port (pl. F5), sont remplies de centaines de mille d'huitres presque pendant toute l'année."
                                            },
                                            {
                                                "example_id": "bf50efed-d03a-4f79-8fc5-0d9c5562bc1b",
                                                "sense_id": "db9e9eca-50bd-3907-8bde-ed6f3d2e2178",
                                                "text": "Pour cela il faudra que le bateau soit amené du bassin dans l’avant-port avant la nuit, à cause du pont tournant…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
