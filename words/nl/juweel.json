                    "sense_id": "50ff0ba7-23e5-350c-ba9f-a781e9dd39b1",
                    "sense_definition": "Een sieraad gemaakt van edelmetaal of bezet met edelstenen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sieraden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt een prachtig <w>juweel</w> om haar hals tijdens het gala.",
                            "target_lang_translations": {
                                "en": "She is wearing a beautiful <w>jewel</w> around her neck during the gala."
                            }
                        },
                        {
                            "text": "De koningin verscheen met kostbare <w>juwelen</w> op de officiële receptie.",
                            "target_lang_translations": {
