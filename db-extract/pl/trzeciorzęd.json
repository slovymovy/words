                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tertiär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a23cd93d-73ee-3ec9-8c59-681b953fa40f",
                                        "entry_id": "afa9d08a-874e-3839-bbb9-beea65d473ae",
                                        "glosses": [
                                            "ein geologischer Zeitabschnitt der Erdneuzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d45df2-6290-4e68-94d1-f5e869b5bdd3",
                                                "sense_id": "a23cd93d-73ee-3ec9-8c59-681b953fa40f",
                                                "text": "Das Tertiär begann vor 65 Millionen Jahren zum Ende der Kreidezeit."
                                            },
                                            {
                                                "example_id": "d42024ab-b660-4b20-a637-eeb497a60c51",
                                                "sense_id": "a23cd93d-73ee-3ec9-8c59-681b953fa40f",
                                                "text": "„In den ältesten Tertiär-Schichten liegen die wenigen lebenden Arten mitten zwischen einer Menge erloschener Formen.“"
                                            },
                                            {
                                                "example_id": "77a69fc9-8146-4ce5-914e-054c335a3b67",
                                                "sense_id": "a23cd93d-73ee-3ec9-8c59-681b953fa40f",
                                                "text": "„Erst am Ende des Tertiärs und insbesondere im Quartär hat sich die Ahr tiefer in das Rumpfgebirge eingeschnitten und auf diese Weise Felswände wie die Engelsley freigelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6976b740-abbb-48b6-8594-d22a40aa97cf",
