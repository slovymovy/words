                ],
                "senses": [
                    {
                        "sense_id": "b2e79533-7a5d-325f-b9ec-5f50195857a3",
                        "entry_id": "42953f7d-74ff-386e-89ca-e03935017809",
                        "glosses": [
                            "Donner un caractère alterné à quelque chose, alterner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "88b86ce4-51ae-4ff2-80d0-4e9eff81613d",
                                "sense_id": "b2e79533-7a5d-325f-b9ec-5f50195857a3",
                                "text": "Le deuxième choriste entonne l’hymne, parce que le premier choriste a entonné le cinquième psaume et que le même premier choriste doit entonner Magnificat ; c’est donc pour alterniser et afin qu’on les voie donner le ton tour à tour ; car chez nous ils n’ont aucune part au répons."
                            },
                            {
                                "example_id": "2fbc4d10-d8e3-4d16-8965-56d3ab0e8e8b",
                                "sense_id": "b2e79533-7a5d-325f-b9ec-5f50195857a3",
                                "text": "Donc en ce jour, il faut que j’alternise football via le Hockey ^([sic : hockey])."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b91aad9-7f7d-3c05-91fa-afcbcc39625a",
                        "entry_id": "42953f7d-74ff-386e-89ca-e03935017809",
                        "glosses": [
                            "Adopter un caractère alternatif."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7f064bb8-b84b-46d6-8a27-232310c03ad1",
                                "sense_id": "3b91aad9-7f7d-3c05-91fa-afcbcc39625a",
                                "text": "Et la taxation doit prendre la forme d’un impôt sur le producteur, plutôt que sur le consommateur; on incite ainsi bien plus fortement le producteur à se moderniser, à « s’alterniser »."
                            }
                        ]
                    }
