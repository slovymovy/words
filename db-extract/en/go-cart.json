                        "entry_id": "c430473c-6f21-36cb-af86-e1fcecf18e13",
                        "glosses": [
                            "A small, open-wheeled vehicle for racing; often spelled go-kart."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a9db06b-3c46-35dc-a5f4-3aa8745484d3",
                        "entry_id": "c430473c-6f21-36cb-af86-e1fcecf18e13",
                        "glosses": [
                            "A framework moving on casters, designed to support children as they learn to walk; a baby walker."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f048a9-8c42-400a-9c70-918c99e36642",
                        "source_entry_id": "c430473c-6f21-36cb-af86-e1fcecf18e13",
                        "source_sense_description": "a racing vehicle",
                        "target_lang_word": "kart",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kart",
