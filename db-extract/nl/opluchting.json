                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7ff778bf-f770-4aff-a928-e3895d7a1694",
                        "entry_id": "51b86ba1-fb63-384e-b01c-dbc6402fa563",
                        "tags": [
                            "plural"
                        ],
