                ],
                "senses": [
                    {
                        "sense_id": "0a4eb311-1b84-3668-aec2-d565ea19d2c9",
                        "entry_id": "46229d6d-86e2-3802-af01-544b2adb88fe",
                        "glosses": [
                            "Angestellter eines Tanzlokals, einer Tanzschule, der sich als Tanzpartner den weiblichen Gästen anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03109dbd-7dc1-4a78-ab30-69d1454ba71d",
                                "sense_id": "0a4eb311-1b84-3668-aec2-d565ea19d2c9",
                                "text": "„Werner versuchte sich gerade in der Mitte der provisorischen Tanzfläche als Eintänzer in Sachen Flamenco.“"
                            },
                            {
                                "example_id": "a2948e57-9772-4b03-afe6-980e172969b2",
                                "sense_id": "0a4eb311-1b84-3668-aec2-d565ea19d2c9",
                                "text": "„Um sich im Berlin der 1920er-Jahre durchzuschlagen, hatte er als Eintänzer gearbeitet und sonntags schon einige Strapazen hinter sich gebracht […].“"
                            },
                            {
                                "example_id": "ba04d4f8-40a0-49dc-ba3d-9ee1076fdc6d",
                                "sense_id": "0a4eb311-1b84-3668-aec2-d565ea19d2c9",
                                "text": "„Gegenüber, am anderen Ende des Saales, warteten die Kellner und die männlichen Eintänzer an der langen Theke auf Kundschaft.“"
                            },
                            {
                                "example_id": "bf9e129b-63dd-4c6e-8cdd-82b08ace3295",
                                "sense_id": "0a4eb311-1b84-3668-aec2-d565ea19d2c9",
                                "text": "„Danach kam ein Eintänzer, schon älter, der sie ebenso professionell wie gelangweilt in einen Tango führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b725daee-ade3-3ca5-bbdd-af112cab90f3",
                        "entry_id": "46229d6d-86e2-3802-af01-544b2adb88fe",
                        "glosses": [
                            "jemand, der auf einer Tanzfläche einen Tanz vorführt, um Stimmung zu erzeugen, die anderen zum Tanzen zu motivieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c23268-1d56-41b7-8fd2-7c5878158cd0",
                                "sense_id": "b725daee-ade3-3ca5-bbdd-af112cab90f3",
                                "text": "„Werner versuchte sich gerade in der Mitte der provisorischen Tanzfläche als Eintänzer in Sachen Flamenco.“"
                            },
                            {
                                "example_id": "81cea857-f10c-424f-a831-fc2c9a8f4bb1",
                                "sense_id": "b725daee-ade3-3ca5-bbdd-af112cab90f3",
                                "text": "„Um sich im Berlin der 1920er-Jahre durchzuschlagen, hatte er als Eintänzer gearbeitet und sonntags schon einige Strapazen hinter sich gebracht […].“"
                            },
                            {
                                "example_id": "45fdf397-907c-4d0f-b92f-19f609db1cfe",
