                                        "glosses": [
                                            "A striped freshwater mussel, Dreissena polymorpha, originating in Russia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c32829e5-700f-447d-b77d-3d9fa47d5a50",
                                                "sense_id": "15889ced-4ae1-3ff9-8dd7-96e0370f1bf7",
                                                "text": "Zebra mussels are causing significant problems as an invasive species in North America."
                                            }
