                                            {
                                                "example_id": "397a68c4-e5c9-4cdb-a23c-0fa572b652c8",
                                                "sense_id": "e0e8a2bd-e7a3-33f4-9940-0b41ccfe04e3",
                                                "text": "The task was the harder in that the restored service had not only to start forthwith but also to last for several months pending modifications to the multiple-unit electric stock, and this called for organisation on a semi-permanent basis."
                                            },
                                            {
                                                "example_id": "8a18e2f7-d8ec-4a60-a001-5e5958171d70",
                                                "sense_id": "e0e8a2bd-e7a3-33f4-9940-0b41ccfe04e3",
                                                "text": "He wants to offer a better experience of the railways, especially as women and children are increasingly making return visits to see the men of their families as the war drags on and their exile becomes semi-permanent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ce6e55-cca7-4196-b4ae-4b60de4f13d1",
                        "source_entry_id": "0e2e9258-a2b3-3722-85c4-3760c6a9264d",
