                "senses": [
                    {
                        "sense_id": "0a5ee9a4-8615-34a3-9aef-31a3b53932c5",
                        "entry_id": "69b92878-470b-3cc5-839a-6921bf5971be",
                        "glosses": [
                            "истор. отрывок из эпического произведения, исполняемый рапсодом"
                        ],
                        "tags": [
                            "y древних греков:"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "95098a08-50cc-3205-83ee-644532d62ea8",
                        "entry_id": "69b92878-470b-3cc5-839a-6921bf5971be",
                        "glosses": [
                            "муз. инструментальное или вокально-инструментальное произведение на темы народных песен, танцев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8649098b-711d-4f3a-a3d8-959329c1272a",
                                "sense_id": "95098a08-50cc-3205-83ee-644532d62ea8",
                                "text": "Наверху за потолком какой-то энергический мужчина, вероятно ученик консерватории, разучивал на рояли рапсодию Листа с таким усердием, что, казалось, по крыше дома ехал товарный поезд."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fad9d56d-6b5a-41d4-a264-b089d64bbe90",
                        "source_entry_id": "69b92878-470b-3cc5-839a-6921bf5971be",
                        "target_lang_word": "rhapsody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhapsody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a58567a-e873-33d2-8af8-17057766a5c1",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An epic poem, or part of one, suitable for uninterrupted recitation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eca1f65-7988-3f03-969e-f70d59278f09",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An exaggeratedly enthusiastic or exalted expression of feeling in speech or writing."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5299868-b0f3-41a7-a3bf-3dc5cde325d9",
                                                "sense_id": "4eca1f65-7988-3f03-969e-f70d59278f09",
                                                "text": "Of course here Mr. Pen went off into a rhapsody through which, as we have perfect command over our own feelings, we have no reason to follow the lad. Of course, love, truth, and eternity were produced: and words were tried but found impossible to plumb the tremendous depth of his affection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b579ffd1-83d9-3557-894f-ca50bd5e3be0",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An instrumental composition of irregular form, often incorporating improvisation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "A random collection or medley; a miscellany; also, a confused string of stories, words, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd54c05-8cf8-4661-9301-62e6fa5ee20b",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "Such an act / That blurs the grace and blush of modesty; / Calls virtue hypocrite; takes off the rose / From the fair forehead of an innocent love / And sets a blister there; makes marriage vows / As false as dicers' oaths; O, such a deed / As from the body of contraction plucks / The very soul, and sweet religion makes / A rhapsody of words!"
                                            },
                                            {
                                                "example_id": "f10a1857-49a9-4578-9536-04ff02bc77b2",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "This concerneth not those mingle-mangles of many kinds of stuffe, or as the Grecians call them Rapsodies, that for such are published[…]."
                                            },
                                            {
                                                "example_id": "b480f902-2cd7-40e6-8a65-021246ad5603",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "He, that makes no reflexions on what he reads, only loads his mind with a rhapsody of tales fit for the entertainment of others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11ac6da8-0fd0-34b7-901c-54ba7a68a58a",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "A literary composition consisting of miscellaneous works."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
