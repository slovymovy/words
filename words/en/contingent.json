{
    "word_family": [
        "contingency",
        "contingence",
        "contingently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43b920d1-cb13-3974-b26d-11f571158d56",
                    "sense_definition": "Dependent on something else that is undetermined or unknown; occurring only if specific circumstances exist.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "dependency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The success of the outdoor festival is <w>contingent</w> on the weather remaining dry.",
                            "target_lang_translations": {
                                "ru": "Успех фестиваля на открытом воздухе <w>зависит</w> от того, останется ли погода сухой.",
                                "zh": "户外节日的成功<w>取决于</w>天气是否持续晴朗。"
                            }
                        },
                        {
                            "text": "Her promotion is <w>contingent</w> upon completing the project by the end of the month.",
                            "target_lang_translations": {
                                "ru": "Ее повышение <w>обусловлено</w> завершением проекта к концу месяца.",
                                "zh": "她的晋升<w>以</w>月底前完成项目<w>为条件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conditional"
                    ],
                    "antonyms": [
                        "certain"
                    ],
                    "common_phrases": [
                        "contingent on",
                        "contingent upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависящий от чего-либо неопределенного или неизвестного; происходящий только при наличии определенных обстоятельств.",
                        "zh": "取决于某种不确定或未知因素；仅在特定情况下发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависящий",
                                "target_lang_sense_clarification": "находящийся в зависимости от условий"
                            },
                            {
                                "target_lang_word": "обусловленный",
                                "target_lang_sense_clarification": "определяемый наличием условий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "取决于",
                                "target_lang_sense_clarification": "表示受某条件制约"
                            },
                            {
                                "target_lang_word": "以……为条件",
                                "target_lang_sense_clarification": "表示受某条件制约"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2856877a-d4d0-3cca-ad1a-ae802d5f8e31",
                    "sense_definition": "Relating to temporary work or workers hired for a limited time rather than on a permanent basis.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company relies on <w>contingent</w> labor to handle the extra demand during the holidays.",
                            "target_lang_translations": {
                                "ru": "Компания полагается на <w>временную</w> рабочую силу, чтобы справиться с дополнительным спросом во время праздников.",
                                "zh": "公司依靠<w>临时</w>劳动力来应对假期期间的额外需求。"
                            }
                        },
                        {
                            "text": "As a <w>contingent</w> worker, he does not receive the same health benefits as full-time employees.",
                            "target_lang_translations": {
                                "ru": "Как <w>внештатный</w> сотрудник, он не получает тех же медицинских льгот, что и штатные работники.",
                                "zh": "作为一名<w>非全职</w>员工，他无法享受与全职员工相同的医疗福利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "contingent worker",
                        "contingent labor",
                        "contingent staff"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к временной работе или сотрудникам, нанятым на ограниченный срок, а не на постоянной основе.",
                        "zh": "指临时性的工作或非长期雇佣的员工。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "временный",
                                "target_lang_sense_clarification": "о персонале или работе"
                            },
                            {
                                "target_lang_word": "внештатный",
                                "target_lang_sense_clarification": "не состоящий в постоянном штате"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临时",
                                "target_lang_sense_clarification": "指非正式或短期的"
                            },
                            {
                                "target_lang_word": "非全职",
                                "target_lang_sense_clarification": "指非正式员工"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19d109b-d72d-3df0-b568-00d1ce79d695",
                    "sense_definition": "Possible or liable to happen, but not certain; incidental.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must prepare for any <w>contingent</w> expenses that might arise during the trip.",
                            "target_lang_translations": {
                                "ru": "Мы должны подготовиться к любым <w>непредвиденным</w> расходам, которые могут возникнуть во время поездки.",
                                "zh": "我们必须为旅行中可能出现的任何<w>意外</w>开支做好准备。"
                            }
                        },
                        {
                            "text": "The contract covers various <w>contingent</w> liabilities that are not yet confirmed.",
                            "target_lang_translations": {
                                "ru": "Контракт покрывает различные <w>условные</w> обязательства, которые еще не подтверждены.",
                                "zh": "合同涵盖了各种尚未确认的<w>或有</w>负债。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incidental"
                    ],
                    "antonyms": [
                        "inevitable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможный или вероятный, но не гарантированный; возникающий попутно или случайно.",
                        "zh": "可能发生但不确定；偶然的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непредвиденный",
                                "target_lang_sense_clarification": "о расходах или обстоятельствах"
                            },
                            {
                                "target_lang_word": "условный",
                                "target_lang_sense_clarification": "финанс. (напр. условные обязательства)"
                            },
                            {
                                "target_lang_word": "возможный",
                                "target_lang_sense_clarification": "могущий произойти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意外的",
                                "target_lang_sense_clarification": "指未预料到的"
                            },
                            {
                                "target_lang_word": "或有的",
                                "target_lang_sense_clarification": "财务术语，指可能发生的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fddae6f7-f29f-3636-9a60-56a96f67b30d",
                    "sense_definition": "True only under certain conditions; not necessarily true or false in all possible worlds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In philosophy, a <w>contingent</w> proposition is one that could have been false.",
                            "target_lang_translations": {
                                "ru": "В философии <w>контингентное</w> суждение — это суждение, которое могло бы быть ложным.",
                                "zh": "在哲学中，<w>偶然</w>命题是指那些本可能为假的命题。"
                            }
                        },
                        {
                            "text": "He argued that historical events are <w>contingent</w> rather than predetermined by fate.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что исторические события <w>случайны</w>, а не предопределены судьбой.",
                                "zh": "他认为历史事件是<w>偶然</w>的，而非由命运预先注定。"
                            }
                        }
                    ],
                    "antonyms": [
                        "necessary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophy"
                        },
                        {
                            "trait_type": "form",
                            "comment": "logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Истинный только при определенных условиях; не являющийся логически необходимым или неизбежным.",
                        "zh": "仅在特定条件下成立；并非在所有情况下都必然为真。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контингентный",
                                "target_lang_sense_clarification": "филос. термин"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "в логике: противоположный необходимому"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶然的",
                                "target_lang_sense_clarification": "逻辑学中指非必然的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4ec52d0-81db-3dba-b71d-055bd73d6302",
                    "sense_definition": "A group of people representing an organization or country, or forming part of a larger gathering.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>contingent</w> of supporters traveled to the stadium to cheer for their team.",
                            "target_lang_translations": {
                                "ru": "Большой <w>контингент</w> болельщиков отправился на стадион, чтобы поддержать свою команду.",
                                "zh": "一大批<w>代表团</w>支持者前往体育场为他们的球队加油。"
                            }
                        },
                        {
                            "text": "The peacekeeping force included a significant <w>contingent</w> from Canada.",
                            "target_lang_translations": {
                                "ru": "Миротворческие силы включали значительный <w>контингент</w> из Канады.",
                                "zh": "维和部队中包括一支来自加拿大的重要<w>队伍</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "large contingent",
                        "strong contingent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, представляющая организацию или страну, или являющаяся частью большего собрания.",
                        "zh": "代表某个组织或国家的一群人，或大型集会的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контингент",
                                "target_lang_sense_clarification": "группа людей, войск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代表团",
                                "target_lang_sense_clarification": "指特定群体"
                            },
                            {
                                "target_lang_word": "队伍",
                                "target_lang_sense_clarification": "指特定群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76f439bf-cd5b-3167-bfad-32bd1f9d2665",
                    "sense_definition": "An event which may or may not happen; an unforeseen occurrence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general planned for every possible <w>contingent</w> before the battle began.",
                            "target_lang_translations": {
                                "ru": "Генерал спланировал действия на случай любого возможного <w>непредвиденного обстоятельства</w> перед началом битвы.",
                                "zh": "战斗开始前，将军为每一种可能的<w>突发事件</w>都做了计划。"
                            }
                        },
                        {
                            "text": "We need to be ready for any <w>contingent</w> that might delay the launch.",
                            "target_lang_translations": {
                                "ru": "Нам нужно быть готовыми к любой <w>случайности</w>, которая может задержать запуск.",
                                "zh": "我们需要为任何可能推迟发射的<w>偶然情况</w>做好准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contingency",
                        "eventuality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, которое может произойти или не произойти; непредвиденный случай.",
                        "zh": "可能发生也可能不发生的事件；突发情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непредвиденное обстоятельство",
                                "target_lang_sense_clarification": "случайность"
                            },
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "возможное событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突发事件",
                                "target_lang_sense_clarification": "指意外情况"
                            },
                            {
                                "target_lang_word": "偶然情况",
                                "target_lang_sense_clarification": "指可能发生的事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0037f7d2-3b49-3914-ad13-92ac04085e56",
                    "sense_definition": "A share or proportion that falls to someone in a division.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each heir received their <w>contingent</w> of the estate after the legal proceedings.",
                            "target_lang_translations": {
                                "ru": "Каждый наследник получил свою <w>долю</w> наследства после судебного разбирательства.",
                                "zh": "法律程序结束后，每位继承人都收到了他们应得的遗产<w>份额</w>。"
                            }
                        },
                        {
                            "text": "The soldiers were issued their daily <w>contingent</w> of supplies.",
                            "target_lang_translations": {
                                "ru": "Солдатам выдали их суточную <w>норму</w> припасов.",
                                "zh": "士兵们领到了他们每日的物资<w>配额</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proportion"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доля или часть, причитающаяся кому-либо при распределении.",
                        "zh": "分配时应得的份额或比例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть целого"
                            },
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "норма или доля"
                            },
                            {
                                "target_lang_word": "пай",
                                "target_lang_sense_clarification": "взнос или часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "份额",
                                "target_lang_sense_clarification": "指应得的部分"
                            },
                            {
                                "target_lang_word": "配额",
                                "target_lang_sense_clarification": "指分配的定额"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}