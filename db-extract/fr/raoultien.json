                    {
                        "sense_id": "b44faa3f-50a2-350e-b139-3e2029e6931b",
                        "entry_id": "4eb37e76-0d0d-30ff-bc9d-4b356ad05a1d",
                        "glosses": [
                            "Relatif à Didier Raoult, ses idées ou ses partisans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1edf74ac-6b4d-463d-832a-f4cd39631e1b",
                                "sense_id": "b44faa3f-50a2-350e-b139-3e2029e6931b",
                                "text": "C'est parce que le Pr Raoult lui faisait penser à Coluche que Jeanno Boyer, patron d'un bar à Aix-en-Provence, a créé un rendez-vous « raoultien » au succès fulgurant."
                            },
                            {
                                "example_id": "246f15fe-9801-4c6c-9dc0-4ddbb30ef296",
                                "sense_id": "b44faa3f-50a2-350e-b139-3e2029e6931b",
                                "text": "Le mot « méthodologie » remporte la médaille d’or pour « le mot le plus articulé de la semaine » celle qui suit l’annonce des résultats de l’essai raoultien."
                            }
                        ]
                    }
