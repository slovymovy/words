                "word": "goliard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3837e918-e17d-4ab5-9a8c-52ed60185804",
                        "entry_id": "ecd1d985-cda6-3f2e-87a0-f860c7dae301",
                        "tags": [
                            "plural"
