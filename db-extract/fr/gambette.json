                ],
                "senses": [
                    {
                        "sense_id": "9e10fb94-44bc-38e2-acde-ca79f398922a",
                        "entry_id": "442970f9-c191-3a5a-a5b4-8f5f2b0d6859",
                        "glosses": [
                            "Petite ou jolie jambe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "18c372a5-0781-457c-b68e-d48e52794303",
                                "sense_id": "9e10fb94-44bc-38e2-acde-ca79f398922a",
                                "text": "On dit que j'ai de belles gambettes."
                            },
                            {
                                "example_id": "42e35d08-b931-4de5-a085-3dd38ff88e5c",
                                "sense_id": "9e10fb94-44bc-38e2-acde-ca79f398922a",
                                "text": "Les bras d’Anonyme — qui était à tel point plongé dans ses calculs géométriques qu’il ne s’aperçut même pas de ma présence ; et moi, le frappant à l’épaule, je le détournai de la contemplation de certaines gambettes qui sautillaient de l’autre côté de la rue."
                            },
                            {
                                "example_id": "5a21fb50-fe7b-44d1-811a-8905e93cc2cf",
                                "sense_id": "9e10fb94-44bc-38e2-acde-ca79f398922a",
                                "text": "Déjà les boys et les danseuses faisaient la haie en chantant un chœur tonitruant et en tortillant des gambettes..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
