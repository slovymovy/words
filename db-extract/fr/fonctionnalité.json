                ],
                "senses": [
                    {
                        "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                        "glosses": [
                            "Ensemble des caractères ou des propriétés qui font que quelque chose remplit bien sa fonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7284809e-9759-4dcc-a806-a1bfea2c6764",
                                "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                                "text": "En effet, une bonne fonctionnalité de la cellule pancréatique va compenser le déficit d’efficacité de l’insuline."
                            },
                            {
                                "example_id": "e2383812-314e-46ec-a527-dce54fcca9be",
                                "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                                "text": "Les études consacrées à la situation linguistique en Alsace ont été élaborées à partir d’enquêtes qui ont révélé la perte de fonctionnalité du dialecte, éliminé de nombreux domaines d’utilisation par le français, ainsi qu’une érosion lexicale manifeste…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                        "glosses": [
                            "Fonction implantée dans un système informatique permettant à l’utilisateur d’effectuer un traitement."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "4288f58b-9aa8-4192-8874-8be03955d544",
                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                "text": "Par exemple, il semble logique que deux logiciels de réservation de billets de trains aient tous deux prévu une fonctionnalité permettant de choisir une destination particulière."
                            },
                            {
                                "example_id": "f7dabf2e-a903-4b5d-bd42-624f30d490f7",
                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                "text": "La plupart du temps, ces programmes ne peuvent fonctionner seuls car ils sont uniquement destinés à apporter une fonctionnalité à un ou plusieurs logiciels […]"
                            },
                            {
                                "example_id": "0cdf416f-0eaa-46d8-87a5-5e938728f2c8",
                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                "text": "Ce logiciel a de nombreuses fonctionnalités."
                            },
                            {
                                "example_id": "1b828cb2-2600-4fed-a14e-6e9a54b8d730",
                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                "text": "Je dois coder la fonctionnalité de modification interactive pour demain."
                            }
                        ]
                    },
                    {
                        "sense_id": "d32a5589-6492-3749-89ea-d756d2f2ba03",
                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                        "glosses": [
                            "Nombre de fonctions réactives d'une molécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17f08bc-133b-43a5-bbc3-969c1e2574cc",
                                "sense_id": "d32a5589-6492-3749-89ea-d756d2f2ba03",
                                "text": "Pour obtenir un polymère tridimensionnel, il faut au moins un monomère de fonctionnalité supérieure à 2."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "590812fd-1f14-4ba7-ae1b-9611d9142483",
                        "source_entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                        "target_lang_word": "Funktionalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Funktionalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                                        "entry_id": "40059a9b-2570-3618-93ed-7f82d9f653b8",
                                        "glosses": [
                                            "die Fähigkeit eines Produktes oder einer Komponente, bestimmte Aufgaben zu lösen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e93d5fe-e784-4cb0-b3f8-0b8c9afde6ba",
                                                "sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                                                "text": "„Diesen Siegeszug hat ein Kleidungsstück vollendet, das in seiner Funktionalität und seiner Bedeutungsprägnanz zum modischen Signum der liberalen Gesellschaften geworden ist: die Jeans.“"
                                            }
