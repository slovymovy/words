                                    {
                                        "sense_id": "83d16ce7-7b5c-3c95-ab6e-d51eec97c961",
                                        "entry_id": "bf149053-ee73-387d-8089-7dde614ae21d",
                                        "glosses": [
                                            "dergestalt, dass es ausgehalten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c02413f-c4a8-4e75-a74a-199df7b7e657",
                                                "sense_id": "83d16ce7-7b5c-3c95-ab6e-d51eec97c961",
                                                "text": "Die Schmerzen nach der Operation waren gerade noch erträglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e683309-70e2-307c-96e4-76d28c53009f",
                                        "entry_id": "bf149053-ee73-387d-8089-7dde614ae21d",
                                        "glosses": [
                                            "mittelmäßige Qualität aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e76c185-8fd4-440e-a1d3-08b2b6d885a7",
                                                "sense_id": "3e683309-70e2-307c-96e4-76d28c53009f",
                                                "text": "Mit ihrem Einkommen können sie ein erträgliches Leben führen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "924c62fa-4001-4b03-8cf0-c07f1ad95d08",
                        "source_entry_id": "3225e2b3-e286-39aa-899b-00e592694b1b",
                        "target_lang_word": "auszuhalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
