                ],
                "senses": [
                    {
                        "sense_id": "eedf9ef0-fba1-32ee-86e2-320d1bb439b4",
                        "entry_id": "9b8b758c-33ef-3c4d-b9e9-e851d9a6d12a",
                        "glosses": [
                            "склониться, пригнуться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e197a3-87e3-400a-8e08-a7404f23bc46",
                                "sense_id": "eedf9ef0-fba1-32ee-86e2-320d1bb439b4",
                                "text": "В некоторых местах колосья ржи спутались и поникли от бури."
                            }
                        ]
                    },
                    {
                        "sense_id": "5789f7ce-87eb-31a6-810f-5f5803179e75",
                        "entry_id": "9b8b758c-33ef-3c4d-b9e9-e851d9a6d12a",
                        "glosses": [
                            "склонить, нагнуть (голову, ветви и т. п.)"
                        ],
                        "tags": [
                            "чем"
                        ],
                        "examples": [
                            {
                                "example_id": "02a36715-88e7-4fe9-a6c5-9c9eb2f14b5d",
                                "sense_id": "5789f7ce-87eb-31a6-810f-5f5803179e75",
                                "text": "Обнаженные деревья, тоскливо поникнув ветвями, задумались перед наступлением долгих зимних холодов."
                            }
                        ]
                    },
                    {
                        "sense_id": "03186289-e339-3533-a6ce-80fe9545e86d",
                        "entry_id": "9b8b758c-33ef-3c4d-b9e9-e851d9a6d12a",
                        "glosses": [
                            "перен. утратить бодрость духа, впасть в подавленное настроение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b0fb370-4d02-4e8d-b175-ae5e7dabf66d",
                                "sense_id": "03186289-e339-3533-a6ce-80fe9545e86d",
                                "text": "Тут-то увидел Акакий Акакиевич, что без новой шинели нельзя обойтись, и поник совершенно духом."
                            },
                            {
                                "example_id": "a196f77e-405e-4594-87f6-a81fcc566a1a",
                                "sense_id": "03186289-e339-3533-a6ce-80fe9545e86d",
                                "text": "Заслышав шаги Алексея, она [Зиночка] вся подалась вперед, но, увидев, что он не один, поникла и сжалась."
                            }
                        ]
                    }
                ],
