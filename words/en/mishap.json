{
    "word_family": [
        "hap",
        "hapless",
        "happen",
        "mishappen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ee3e24d-b410-393b-9e2c-ab9325a27d0b",
                    "sense_definition": "An unfortunate, minor accident or mistake that causes problems.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misfortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire trip went smoothly, apart from a minor <w>mishap</w> with our luggage at the airport.",
                            "target_lang_translations": {
                                "es": "Todo el viaje transcurrió sin problemas, aparte de un pequeño <w>percance</w> con nuestro equipaje en el aeropuerto."
                            }
                        },
                        {
                            "text": "A slight technical <w>mishap</w> delayed the start of the concert by twenty minutes.",
                            "target_lang_translations": {
                                "es": "Un ligero <w>contratiempo</w> técnico retrasó el inicio del concierto veinte minutos."
                            }
                        }
                    ],
                    "synonyms": [
                        "contretemps"
                    ],
                    "common_phrases": [
                        "minor mishap",
                        "technical mishap",
                        "without mishap"
                    ],
                    "target_lang_definitions": {
                        "es": "Accidente menor, contratiempo o error desafortunado que causa inconvenientes."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "percance",
                                "target_lang_sense_clarification": "accidente menor o contratiempo imprevisto"
                            },
                            {
                                "target_lang_word": "contratiempo",
                                "target_lang_sense_clarification": "suceso imprevisto que retrasa u obstaculiza algo"
                            },
                            {
                                "target_lang_word": "incidente",
                                "target_lang_sense_clarification": "pequeño suceso o complicación inesperada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "357ef063-a097-3935-9346-4926295f8999",
                    "sense_definition": "Bad luck or unfortunate circumstances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "misfortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Through sheer <w>mishap</w>, they lost the documents right before the deadline.",
                            "target_lang_translations": {
                                "es": "Por pura <w>mala suerte</w>, perdieron los documentos justo antes de la fecha límite."
                            }
                        },
                        {
                            "text": "He seemed cursed by persistent sickness and <w>mishap</w> throughout that year.",
                            "target_lang_translations": {
                                "es": "Parecía maldito por continuas enfermedades e <w>infortunios</w> a lo largo de aquel año."
                            }
                        }
                    ],
                    "synonyms": [
                        "adversity",
                        "bad luck",
                        "ill luck",
                        "mischance",
                        "misfortune",
                        "unluckiness"
                    ],
                    "antonyms": [
                        "goodhap"
                    ],
                    "target_lang_definitions": {
                        "es": "Mala suerte, infortunio o circunstancias desafortunadas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mala suerte",
                                "target_lang_sense_clarification": "fortuna adversa o infortunio"
                            },
                            {
                                "target_lang_word": "infortunio",
                                "target_lang_sense_clarification": "estado o suceso desafortunado"
                            },
                            {
                                "target_lang_word": "desgracia",
                                "target_lang_sense_clarification": "adversidad o mala fortuna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94c59b05-876e-3a7f-b995-f8f220f420c1",
                    "sense_definition": "To occur or turn out through misfortune.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whatever <w>mishapped</w> during the journey was quickly forgotten upon their arrival.",
                            "target_lang_translations": {
                                "es": "Cualquier cosa que <w>acaeciera desgraciadamente</w> durante el viaje se olvidó rápidamente a su llegada."
                            }
                        },
                        {
                            "text": "She feared that something dreadful might <w>mishap</w> while they were away.",
                            "target_lang_translations": {
                                "es": "Temía que algo espantoso pudiera <w>acontecer</w> mientras estaban fuera."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Ocurrir o resultar por desgracia o mala fortuna (uso arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "acaecer desgraciadamente",
                                "target_lang_sense_clarification": "suceder por infortunio"
                            },
                            {
                                "target_lang_word": "acontecer",
                                "target_lang_sense_clarification": "ocurrir de forma adversa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}