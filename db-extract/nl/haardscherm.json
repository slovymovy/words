                        "entry_id": "27c40a68-d4e8-3536-81c5-9e438b1dd9a0",
                        "glosses": [
                            "verticaal vlak, vaak versierd, neergezet tussen iemand en het haardvuur als middel tegen al te grote verhitting"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "1e8f7a86-4f3a-4195-b54e-531735f9420e",
                                "sense_id": "2865138a-eaad-34cb-a2dd-debdf76ae891",
                                "text": "De kaarsen waren al op, en achter het haardscherm brandde een goed vuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "509984ed-cc94-3616-abae-4237fc91fa97",
                        "entry_id": "27c40a68-d4e8-3536-81c5-9e438b1dd9a0",
                        "glosses": [
                            "verticaal rooster om vonken en kooltjes die van een brandend haardvuur kunnen komen tegen te houden"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "26cdc211-b9a8-417a-9f9e-6c6db2dba185",
                                "sense_id": "509984ed-cc94-3616-abae-4237fc91fa97",
                                "text": "We hadden vooral gepraat over de brand bij M. de Bagueville, en opeens bedacht Mme d'Aine, die al in bed lag, dat er nog een kolossaal blok hout brandend in de haard lag. Stel je voor dat niemand het haardscherm ervoor heeft gezet, en het blok op het parket rolt, zoals al eens is gebeurd."
                            }
                        ]
                    }
