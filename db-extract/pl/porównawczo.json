                        "target_lang_word": "vergleichsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergleichsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                        "entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                                        "glosses": [
                                            "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fcf6d6-3189-4efc-b416-d9fb5cd2673b",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Eine Kompaktkamera ist ein kleiner und unter Betrachtung seiner Bauform vergleichsweise leichter Fotoapparat.“"
                                            },
                                            {
                                                "example_id": "a3138683-d2a1-48d2-962b-2d150e5456d7",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„In einem Land, in dem beispielsweise Arbeitskräfte knapp sind, werden die Löhne vergleichsweise höher sein als in einem Land, in dem ein Überangebot an Arbeitskräften besteht.“"
                                            },
                                            {
                                                "example_id": "4d6aab51-6f76-40ef-b758-c92355331e33",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Beitragsstabilität klingt zwar vergleichsweise harmlos. Es bedeutet aber, dass die Finanzkraft der Sender durch die Inflation von Jahr zu Jahr immer weiter sänke.“"
                                            },
                                            {
                                                "example_id": "336c876f-6e6f-45ca-afdb-d6899706f7a4",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                                            },
                                            {
                                                "example_id": "efde95f7-06fd-481c-a8c2-f71059812a15",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Ein vergleichsweise milder Winter sorgt dafür, dass die Vögel nicht in die Gärten kommen, so lange sie in Wäldern, auf Wiesen und Feldern noch Nahrung finden […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
