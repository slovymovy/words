                "senses": [
                    {
                        "sense_id": "00b8d978-cc4a-3df0-916c-82da298c2931",
                        "entry_id": "a28e4034-713e-35bd-a057-36687bef1f39",
                        "glosses": [
                            "Güterzugwagen (Kesselwagen), der für den Transport von Erdöl bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff83b85-be88-45f0-b0f7-a80c6a09a325",
                                "sense_id": "00b8d978-cc4a-3df0-916c-82da298c2931",
                                "text": "„Der Zug kommt, wieder achtundvierzig Erdölwagen; er donnert zwischen den Bergen wie ein Wasserfall.“"
                            },
                            {
                                "example_id": "5b05f31d-13ee-45d1-a1e2-c080c1a77655",
                                "sense_id": "00b8d978-cc4a-3df0-916c-82da298c2931",
                                "text": "„Die offenen Wagen mit den glänzenden Kohlen und dem Koks, der mit glitzerndem Reif überzogen schien, mit den schweren Eisenplatten, den riesigen Kisten, den aus wasserdichtem Zeltstoff hervorlugenden Maschinen, alle diese hochbeladenen Wagen, abwechselnd mit ungefügen Erdölwagen, schoben sich langsam zu den Fabriktoren hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
