                                            {
                                                "example_id": "938658ac-9b67-4224-9e74-d880f68d428c",
                                                "sense_id": "687363ad-8c5b-32e3-90f8-addac6b413c4",
                                                "text": "Einige Ökonomen hatten zuletzt gefordert, die EZB müsse mit groß angelegten Wertpapierkäufen die Geldmenge aufblähen um so ein Abgleiten in eine deflationäre Spirale von vornherein abzuwehren."
                                            },
                                            {
                                                "example_id": "8ca00f40-ec6f-42fa-9969-e820145a57a8",
                                                "sense_id": "687363ad-8c5b-32e3-90f8-addac6b413c4",
                                                "text": "Anhaltende Kostensenkungen, um die Dividenden der Anleger aufzublähen und Barmittel für Aktienrückkäufe freizusetzen, haben äusserst negative Folgen für die Rechte und Existenzgrundlagen von IUL-Mitgliedern in aller Welt."
                                            },
                                            {
                                                "example_id": "e526b30f-f84d-4f12-927c-ee169c5a6c72",
                                                "sense_id": "687363ad-8c5b-32e3-90f8-addac6b413c4",
                                                "text": "Also, Ofentrieb bezeichnet das Aufgehen des Teiges im Ofen, hervorgerufen durch die umgebende Hitze, die die im Teig eingeschlossenen Kohlendioxidbläschen aufblähen läßt und zu einem voluminösen Brot/Brötchen führt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "678eeb24-e712-3942-b918-22f871244583",
                                        "entry_id": "1f85fc4c-1446-39bf-a7e1-91adeed1c729",
                                        "glosses": [
                                            "rund/prall werden"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31022b05-ffaa-4f93-b336-2c722271edee",
                                                "sense_id": "678eeb24-e712-3942-b918-22f871244583",
                                                "text": "Es [das Universum] blähte sich auf, weshalb die Physiker von einer vorübergehenden „Inflation“ sprechen."
                                            },
                                            {
                                                "example_id": "287b4873-d925-4b2f-9b03-c965331385f0",
                                                "sense_id": "678eeb24-e712-3942-b918-22f871244583",
                                                "text": "Bei einigen Notebook-Akkus mit Polymerzellen kann sich der Akku aufblähen."
                                            },
                                            {
                                                "example_id": "caac3344-d8b7-4e6c-9283-0b518cc2ef03",
                                                "sense_id": "678eeb24-e712-3942-b918-22f871244583",
                                                "text": "Das zeigte sich, als der 1965 der erste Mensch, Alexei Leonow, im Weltraum frei schwebte: Sein Anzug blähte sich auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f8214d81-4c71-35db-9b1c-d16fbfadc23e",
                                        "entry_id": "1f85fc4c-1446-39bf-a7e1-91adeed1c729",
                                        "glosses": [
                                            "sich wichtigmachen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd3f12c-f1c0-47eb-94aa-9be81aa83571",
                                                "sense_id": "f8214d81-4c71-35db-9b1c-d16fbfadc23e",
                                                "text": "Bläh dich nicht so auf! Es gibt bessere Sportler als dich."
                                            },
                                            {
                                                "example_id": "5279729c-533d-4627-bf98-907ddbf4e592",
                                                "sense_id": "f8214d81-4c71-35db-9b1c-d16fbfadc23e",
                                                "text": "Kasperle blähte sich auf wie ein Fröschlein, das gerade quak, quak! geschrien hat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
