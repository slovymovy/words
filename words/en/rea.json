                                "target_lang_word": "РеА",
                                "target_lang_sense_clarification": "медицинская аббревиатура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90582edf-2226-3b46-8cff-5bf65897e420",
                    "sense_definition": "Initialism of request for an equitable adjustment, used in US government contracting to seek compensation for unexpected costs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contracting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor submitted an <w>REA</w> after the project scope changed significantly.",
                            "target_lang_translations": {
                                "ru": "Подрядчик подал <w>запрос на корректировку</w> после того, как объем проекта значительно изменился."
                            }
                        },
                        {
                            "text": "Negotiating an <w>REA</w> can be a lengthy process in federal procurement.",
                            "target_lang_translations": {
                                "ru": "Согласование <w>REA</w> может быть длительным процессом в сфере федеральных закупок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "submit an REA",
                        "formal REA"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрос на справедливое регулирование; используется в государственных контрактах США для получения компенсации за непредвиденные расходы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос на корректировку контракта",
                                "target_lang_sense_clarification": "в контексте госзакупок США"
                            }
                        ]
