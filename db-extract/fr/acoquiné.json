                    {
                        "sense_id": "564cf09c-3d99-35d9-b402-699e6653c233",
                        "entry_id": "faeaf8bb-dfeb-3f48-befa-6bbcc7307077",
                        "glosses": [
                            "(Vieilli) Attaché par une habitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c079759-df7e-448c-a8ef-49f10ab0cd31",
                                "sense_id": "564cf09c-3d99-35d9-b402-699e6653c233",
                                "text": "À première vue, cependant, rien en lui ne trahissait autre chose qu’un octogénaire banal acoquiné à l’orgueil de son blason."
                            },
                            {
                                "example_id": "634c6bc6-b806-4f43-aa48-bf7727232d56",
                                "sense_id": "564cf09c-3d99-35d9-b402-699e6653c233",
                                "text": "Et tout son désarroi de vieil homme acoquiné, prêt à payer de n’importe quel prix le plaisir dont on le sevrait, apparut dans l’effarement de ses yeux et le tremblement de ses lèvres."
                            }
                        ]
                    }
                ],
