                ],
                "senses": [
                    {
                        "sense_id": "8b7cb41b-a412-358e-9c62-a29ec2a308fb",
                        "entry_id": "bdd3edac-fdda-360a-af26-fa71a6477ca2",
                        "glosses": [
                            "een voertuig waarin zuigelingen of kleuters met de hand verreden kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee5f6ee-c289-4676-a8d3-17c2dd4a9f5f",
                                "sense_id": "8b7cb41b-a412-358e-9c62-a29ec2a308fb",
                                "text": "Leg hem maar even in de kinderwagen, dan kunnen we een eindje wandelen."
                            },
                            {
                                "example_id": "3729271e-83f5-4645-92b9-d0c1a5b3bee0",
                                "sense_id": "8b7cb41b-a412-358e-9c62-a29ec2a308fb",
                                "text": "Daarna sloot hij zich aan bij de Vrije Fransen in Londen, vloog vanuit Bromma op een koude winteravond in een vrachtvliegtuig over de Hardangervidda naar Schotland. Mama was er met mij, dik ingepakt in de kinderwagen, om afscheid te nemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "824de98a-5dd5-4f6f-bd88-04a796285d4e",
                        "source_entry_id": "bdd3edac-fdda-360a-af26-fa71a6477ca2",
                        "source_sense_id": "8b7cb41b-a412-358e-9c62-a29ec2a308fb",
                        "source_sense_description": "een voertuig waarin zuigelingen of kleuters met de hand verreden kunnen worden",
                        "target_lang_word": "pram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25305dbb-ae2c-356b-b794-5184afe906ff",
                                        "entry_id": "e88b5d55-33fa-3189-a274-6f9e18935d39",
                                        "glosses": [
                                            "A small vehicle, usually covered, in which a newborn baby is pushed around in a lying position."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6046902f-094a-45c7-baeb-603655349f94",
                                                "sense_id": "25305dbb-ae2c-356b-b794-5184afe906ff",
                                                "text": "Janet Bird née Ollerenshaw was pushing her pram along Tockley High Street."
                                            },
                                            {
                                                "example_id": "33ec4b5c-ecc0-4882-a164-d9ffc59655ec",
                                                "sense_id": "25305dbb-ae2c-356b-b794-5184afe906ff",
                                                "text": "For a start the pram was heavier than it appeared, and also they were pulling it along very uneven ground. The edge of the field was slightly banked which tilted the pram at an angle."
                                            },
                                            {
                                                "example_id": "91385851-f39c-4217-a53b-583eef7eb93a",
                                                "sense_id": "25305dbb-ae2c-356b-b794-5184afe906ff",
                                                "text": "Stepping over her, he unbuttoned the pram′s apron and pulled it back.\nAt first he couldn′t make out what the pram contained. He had to crane himself over, holding his body back from the obscuring light. The pram was full of groceries—cabbage, sprouts, potatoes."
                                            },
                                            {
                                                "example_id": "894a162e-4b64-43e4-b438-585a06501f55",
                                                "sense_id": "25305dbb-ae2c-356b-b794-5184afe906ff",
                                                "text": "The Key Train Requirements document, released in July by the Rail Safety and Standards Board (RSSB), includes a new clause covering people travelling with pushchairs. It highlights the need for space in carriages for unfolded pushchairs or prams, separate from areas for wheelchairs and cycles. It also recommends extending seat reservations to include pram spaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a418527-52da-3298-9912-047b3733903f",
                                        "entry_id": "e88b5d55-33fa-3189-a274-6f9e18935d39",
                                        "glosses": [
                                            "A pushchair; a buggy."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea68e00-476b-3787-8c6f-8c164b5de9fb",
                                        "entry_id": "36fdf5cf-dc5a-34f2-b06f-83717befc90d",
                                        "glosses": [
                                            "A flat-bottomed barge used on shallow shores to convey cargo to and from ships that cannot enter the harbour."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ffeea53-1102-3796-84d2-a6f18d8f3bd9",
                                        "entry_id": "36fdf5cf-dc5a-34f2-b06f-83717befc90d",
                                        "glosses": [
                                            "A similar barge used as platform for cannons in shallow waters which seagoing warships cannot enter."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b91cde9-b1b2-389f-932e-2b8cca609d30",
                                        "entry_id": "36fdf5cf-dc5a-34f2-b06f-83717befc90d",
                                        "glosses": [
                                            "A type of dinghy with a flat bow."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccacda9e-0e45-400b-9110-b299a91d433e",
                                                "sense_id": "4b91cde9-b1b2-389f-932e-2b8cca609d30",
                                                "text": "Although the pram, like the johnboat, has a squared-off bow as well as stern, the bow lines on the pram will be narrower than those encountered on a johnboat."
                                            },
                                            {
                                                "example_id": "c6846ca9-d93c-441a-968e-a02049ac65a1",
                                                "sense_id": "4b91cde9-b1b2-389f-932e-2b8cca609d30",
                                                "text": "Nothing can beat the simple pleasure of paddling a pram around on a foggy dawn, probing pad flats, stumps and fallen logs for lurking bass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
