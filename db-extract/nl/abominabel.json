                ],
                "translations": [
                    {
                        "translation_id": "d82cfc1d-2664-4408-879e-a4d4cb9bea30",
                        "source_entry_id": "47472c7d-c9ad-3b77-8c93-3ac4ecff2309",
                        "source_sense_id": "5b6eeff6-b71f-33da-b765-76e61bbf585f",
                        "source_sense_description": "bijzonder slecht",
                        "target_lang_word": "abscheulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abscheulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94a446ef-b1d9-3bc4-9aa1-c8e5c5b081aa",
                                        "entry_id": "3fb6f457-4d00-3a5c-a586-b5dae9a04226",
                                        "glosses": [
                                            "Ekel, Abscheu, Widerwillen, Ablehnung erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a009a91c-4f74-442e-9156-4321e020773b",
                                                "sense_id": "94a446ef-b1d9-3bc4-9aa1-c8e5c5b081aa",
                                                "text": "Viele Leute finden Schlangen abscheulich."
                                            },
                                            {
                                                "example_id": "b097a539-f0bc-4015-aa2b-dd3ef4aa9841",
                                                "sense_id": "94a446ef-b1d9-3bc4-9aa1-c8e5c5b081aa",
                                                "text": "Das ist ja eine abscheuliche Farbkombination!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c34eef0f-968c-3ce0-817e-2b7294eb7a3b",
                                        "entry_id": "3fb6f457-4d00-3a5c-a586-b5dae9a04226",
                                        "glosses": [
                                            "(moralisch) verwerflich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d3e5b9-c1cd-4425-bb6b-f0c22fdcbcb1",
                                                "sense_id": "c34eef0f-968c-3ce0-817e-2b7294eb7a3b",
                                                "text": "„Von Nicolo heißt es: ‚Beschämung, Wollust und Rache vereinigten sich jetzt, um die abscheulichste Tat, die je verübt worden ist, auszubrüten‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b36dec46-021b-4fb6-9aad-bf868e2da559",
                        "source_entry_id": "47472c7d-c9ad-3b77-8c93-3ac4ecff2309",
                        "source_sense_id": "5b6eeff6-b71f-33da-b765-76e61bbf585f",
                        "source_sense_description": "bijzonder slecht",
                        "target_lang_word": "scheußlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheußlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                        "entry_id": "b729e3c4-0c1a-366d-9cd1-4070a8503bcb",
                                        "glosses": [
                                            "Widerwillen, Abscheu erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd9d2f0-1a70-4477-bf41-1aece0a76d87",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Warum schmeckt Espresso oft so scheußlich?"
                                            },
                                            {
                                                "example_id": "12edabfd-3899-466b-aff0-233bf668e95a",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Diesen scheußlichen Mantel werde ich nie wieder tragen."
                                            },
                                            {
                                                "example_id": "ba890f44-6b32-4cd5-975e-1e137e198e36",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Er hat sich wieder einmal scheußlich benommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                        "entry_id": "b729e3c4-0c1a-366d-9cd1-4070a8503bcb",
                                        "glosses": [
                                            "in hohem Maße unangenehm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e6d380-18e6-4421-bac7-d103af487ae5",
                                                "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                                "text": "Das ist eine wirklich scheußliche Entwicklung."
                                            },
                                            {
                                                "example_id": "807afb9b-92aa-44b3-96b8-30dd90e0e141",
                                                "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                                "text": "„Doch schon vierzehn Tage reichten hin, ihm klarzumachen, daß es so nicht ging: ‚Der Schacher ist zu scheußlich‘, gestand er Marx in einem Brief vom 20. Januar 1845, ‚Barmen ist zu scheußlich, die Zeitverschwendung ist zu scheußlich, und besonders ist es zu scheußlich, nicht nur Bourgeois, sondern sogar Fabrikant, aktiv gegen das Proletariat auftretender Bourgeois zu bleiben. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8011cb89-8cfc-4be8-bcb3-c351de31145d",
                        "source_entry_id": "47472c7d-c9ad-3b77-8c93-3ac4ecff2309",
                        "source_sense_id": "5b6eeff6-b71f-33da-b765-76e61bbf585f",
                        "source_sense_description": "bijzonder slecht",
                        "target_lang_word": "abominable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abominable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                        "entry_id": "3cd5e97d-d9a6-3e3a-8e3b-9110e2a6bf27",
                                        "glosses": [
                                            "Qui est en horreur ; qui mérite d’être tenu en horreur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3519fd7a-ff8a-41f0-baa0-4fd3138d5132",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Quand on a repositionné l’abominable lit médicalisé droit devant la télé, mon frère a dit, tu veux regarder la télé maman ?"
                                            },
                                            {
                                                "example_id": "a686644b-0a4d-4be2-ba68-21f9d797e931",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Mais la grande débâcle a commencé en 1875 et en 1876, quand, coïncidant avec le mouvement malthusien qui déjà gagnait les esprits, survint l’abominable phylloxera."
                                            },
                                            {
                                                "example_id": "bcc9be4f-f0fc-47ad-a1cc-5a94a52c8a3d",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Ahurissant : on la juge pour la complicité dans des crimes abominables, et Monique Olivier se dépeint en ménagère effacée, régalant son tyran de mari de cacasse à cul nu et de tarte au sucre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                        "entry_id": "3cd5e97d-d9a6-3e3a-8e3b-9110e2a6bf27",
                                        "glosses": [
                                            "Qui est dégoûtant."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3f95ea-9bc7-4ae8-b7f9-36c2e6309b5f",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Il devait me les payer. Mais, comme par hasard, cet abominable pingre, doublé d'un combineur sans vergogne, n'avait jamais le sou sur lui."
                                            },
                                            {
                                                "example_id": "074c4673-2393-473c-bfaa-00c601ea1fe9",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Un type au sourire abominable, sur des affiches, disait aux passants, droit dans les yeux, Votre argent m’intéresse."
                                            },
                                            {
                                                "example_id": "436d79f5-4512-4dff-bb23-5f0450862b47",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                                            },
                                            {
                                                "example_id": "c2122afc-7b3e-4a5c-96c1-ee281bf3952d",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Cette comédie, cette musique est abominable."
                                            },
                                            {
                                                "example_id": "707fb7a8-e6c6-48a2-92e7-20d9304d36b3",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Une odeur abominable. — Il fait un temps abominable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ba19ee9-3587-48b6-a659-aa48ff97d36c",
                        "source_entry_id": "47472c7d-c9ad-3b77-8c93-3ac4ecff2309",
                        "source_sense_id": "5b6eeff6-b71f-33da-b765-76e61bbf585f",
                        "source_sense_description": "bijzonder slecht",
                        "target_lang_word": "abominable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abominable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                        "entry_id": "3cd5e97d-d9a6-3e3a-8e3b-9110e2a6bf27",
                                        "glosses": [
                                            "Qui est en horreur ; qui mérite d’être tenu en horreur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3519fd7a-ff8a-41f0-baa0-4fd3138d5132",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Quand on a repositionné l’abominable lit médicalisé droit devant la télé, mon frère a dit, tu veux regarder la télé maman ?"
                                            },
                                            {
                                                "example_id": "a686644b-0a4d-4be2-ba68-21f9d797e931",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Mais la grande débâcle a commencé en 1875 et en 1876, quand, coïncidant avec le mouvement malthusien qui déjà gagnait les esprits, survint l’abominable phylloxera."
                                            },
                                            {
                                                "example_id": "bcc9be4f-f0fc-47ad-a1cc-5a94a52c8a3d",
                                                "sense_id": "7a8a3526-b302-3f71-82fe-73c9473d9b14",
                                                "text": "Ahurissant : on la juge pour la complicité dans des crimes abominables, et Monique Olivier se dépeint en ménagère effacée, régalant son tyran de mari de cacasse à cul nu et de tarte au sucre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                        "entry_id": "3cd5e97d-d9a6-3e3a-8e3b-9110e2a6bf27",
                                        "glosses": [
                                            "Qui est dégoûtant."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3f95ea-9bc7-4ae8-b7f9-36c2e6309b5f",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Il devait me les payer. Mais, comme par hasard, cet abominable pingre, doublé d'un combineur sans vergogne, n'avait jamais le sou sur lui."
                                            },
                                            {
                                                "example_id": "074c4673-2393-473c-bfaa-00c601ea1fe9",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Un type au sourire abominable, sur des affiches, disait aux passants, droit dans les yeux, Votre argent m’intéresse."
                                            },
                                            {
                                                "example_id": "436d79f5-4512-4dff-bb23-5f0450862b47",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                                            },
                                            {
                                                "example_id": "c2122afc-7b3e-4a5c-96c1-ee281bf3952d",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Cette comédie, cette musique est abominable."
                                            },
                                            {
                                                "example_id": "707fb7a8-e6c6-48a2-92e7-20d9304d36b3",
                                                "sense_id": "08cfdece-6db1-3597-977b-dc37e5501d2b",
                                                "text": "Une odeur abominable. — Il fait un temps abominable."
                                            }
                                        ]
                                    }
                                ]
                            }
