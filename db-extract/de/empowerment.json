                "senses": [
                    {
                        "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                        "entry_id": "b7f4ee4b-6f23-39b6-ba5f-38e58a6c3714",
                        "glosses": [
                            "Ermächtigung, Stärkung der Selbstbestimmung, Unterstützung der Autonomie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730e2a7d-3fdf-490e-8401-9a5de036dbb6",
                                "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                                "text": "Empowerment bringt im politischen Sinne auch einen konfliktreichen Prozess der Umverteilung politischer Macht mit sich. Gerade auch, wenn man das Black Economic Empowerment näher betrachtet."
                            },
                            {
                                "example_id": "ffd57415-25cf-49fd-b119-542cce37f8c3",
                                "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                                "text": "Im medizinischen Sinne hilft Empowerment dem Patienten, Probleme und Krisen des Alltags aus eigener Kraft bewältigen zu können."
                            },
                            {
                                "example_id": "f07305a4-92d7-4645-bd31-0b8d2edde6a6",
                                "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                                "text": "Empowerment kann im sozialen Umfeld das Engagement des Einzelnen im Gemeinwesen begünstigen."
                            },
                            {
                                "example_id": "e4e1d569-44fe-4c1f-bf46-30eedc0592f1",
                                "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                                "text": "Empowerment unterstützt Menschen bei ihrer Suche nach Selbstbestimmung und autonomer Lebensregie."
                            },
                            {
                                "example_id": "a474c7a2-68fc-4a4d-bf1b-d003b4f10b65",
                                "sense_id": "d904f53a-117d-31f7-a9a7-043d3cb8c488",
                                "text": "Zyniker behaupten Empowerment am Arbeitsplatz bedeutet ein breiteres Arbeitsfeld mit mehr Verantwortung, aber ohne die dazugehörige Gehaltssteigerung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
