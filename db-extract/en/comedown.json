                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e0fdca0-2d12-3b9b-a3b7-2b5355f69ff0",
                        "entry_id": "4837e048-70e5-3b29-89d3-3b388cbf802f",
                        "glosses": [
                            "der Niedergang, Abstieg"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b53ee40d-710c-4f61-8f29-b20398451812",
                        "source_entry_id": "4837e048-70e5-3b29-89d3-3b388cbf802f",
                        "source_sense_id": "0e0fdca0-2d12-3b9b-a3b7-2b5355f69ff0",
                        "source_sense_description": "der Niedergang, Abstieg",
                        "target_lang_word": "Niedergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niedergang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                        "entry_id": "412a1fa8-f433-3fdf-9091-77876bda5311",
                                        "glosses": [
                                            "der Prozess des Zugrundegehens, des Zusammenbrechens"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c778bf-280a-4d88-89f3-785a46820f70",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "Im fünften Jahrhundert begann der Niedergang des Römischen Reiches."
                                            },
                                            {
                                                "example_id": "f6635c3e-3f02-4a0b-86f7-13f781313aac",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "Die Alten beklagen den Niedergang der Sitten."
                                            },
                                            {
                                                "example_id": "e60857de-e48f-410a-99c3-4c49760e8aea",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "Der Niedergang begann mit dem Versuch, im Netz Geld zu verdienen."
                                            },
                                            {
                                                "example_id": "820908f4-0ca7-4ba9-8901-4b3ff6a0fe4e",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "„Angeblich waren die Wiedervereinigung und der Niedergang der DDR durch Weingenuss beschleunigt worden.“"
                                            },
                                            {
                                                "example_id": "ba4c9dc5-697a-4574-bd0f-9d7b8fa26023",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "„Der Niedergang seines Kollegen hatte seinen Lauf genommen.“"
                                            },
                                            {
                                                "example_id": "10ab5406-a823-4a10-a311-4b03715649c9",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "„Im Zuge der Weltwirtschaftskrise geht es jedoch mit der Gießerei bergab, Heinrichs muss Konkurs anmelden, und der geschäftliche Niedergang zerstört die Familie.“"
                                            },
                                            {
                                                "example_id": "fd93ef94-b9f4-4472-8020-e270e786e871",
                                                "sense_id": "45e339fc-54ee-3840-a1b7-3e63444e4434",
                                                "text": "„Zu den Gegnern der aufsteigenden Handelshäuser gehörte die Hanse, deren ökonomische und politische Macht seit Längerem im Niedergang begriffen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "875bacd3-e466-3828-a8b6-3a9103933c4e",
                                        "entry_id": "412a1fa8-f433-3fdf-9091-77876bda5311",
                                        "glosses": [
                                            "kleine Treppe oder Leiter auf Schiffen zur Verbindung zweier Decks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1599a79-7aec-4d6c-aae2-ef598bed378f",
                                                "sense_id": "875bacd3-e466-3828-a8b6-3a9103933c4e",
                                                "text": "Der junge Matrose stürzte am steilen Niedergang und brach sich ein Bein."
                                            },
                                            {
                                                "example_id": "446cceb2-2e90-4191-aeaf-39527e97a330",
                                                "sense_id": "875bacd3-e466-3828-a8b6-3a9103933c4e",
                                                "text": "„Nach der ersten Inspektion an Deck wagten sich Deveau und Wright vorsichtig den Niedergang hinunter in die Räume unter Deck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a98dc1d3-eb3b-4562-bfbf-408d9a460045",
                        "source_entry_id": "4837e048-70e5-3b29-89d3-3b388cbf802f",
                        "source_sense_id": "0e0fdca0-2d12-3b9b-a3b7-2b5355f69ff0",
                        "source_sense_description": "der Niedergang, Abstieg",
                        "target_lang_word": "Abstieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstieg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae467bc-ba3f-30d3-81d6-28561703aee7",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "das Herunterklettern aus der Höhe in tiefere Bereiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941ac20e-e72b-4060-a8db-1bef873100d7",
                                                "sense_id": "4ae467bc-ba3f-30d3-81d6-28561703aee7",
                                                "text": "Der Abstieg ist oft schwieriger als das Erklimmen des Gipfels."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "die Verringerung eines Niveaus, zum Beispiel des sozialen Status"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f59893-f43a-4276-9099-dbac049b1add",
                                                "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                                "text": "Durch seine Drogensucht war der gesellschaftliche Abstieg des früheren Superstars nicht mehr aufzuhalten."
                                            },
                                            {
                                                "example_id": "66e6e071-8094-406d-9e37-d6580501c114",
                                                "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                                "text": "„Hier zählen auch Symbole – und da ist der Abstieg aus dem exklusiven Kreis der besten Schuldner der Erde ein Menetekel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "228976ce-50b4-3ca4-9ebd-eb91474653cc",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "der Wechsel in eine niedrigere Liga oder Klasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2b69e3-6f00-419c-9185-44c9885e494d",
                                                "sense_id": "228976ce-50b4-3ca4-9ebd-eb91474653cc",
                                                "text": "Wenn sie das nächste Spiel nicht gewinnen, wird der Abstieg in die Regionalliga unvermeidlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
