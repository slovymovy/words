                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter is het buiten vaak erg <w>koud</w>.",
                            "target_lang_translations": {
                                "en": "In winter it is often very <w>cold</w> outside.",
                                "ru": "Зимой на улице часто очень <w>холодно</w>.",
                                "pl": "Zimą na zewnątrz często jest bardzo <w>zimno</w>.",
                                "de": "Im Winter ist es draußen oft sehr <w>kalt</w>.",
                                "fr": "En hiver, il fait souvent très <w>froid</w> dehors.",
                                "it": "In inverno fuori fa spesso molto <w>freddo</w>.",
                                "cs": "V zimě je venku často velmi <w>chladno</w>.",
                                "tr": "Kışın dışarısı genellikle çok <w>soğuk</w> olur.",
                                "es": "En invierno a menudo hace mucho <w>frío</w> afuera."
                            }
                        },
                        {
                            "text": "Ik drink liever een glas <w>koud</w> water dan thee.",
                            "target_lang_translations": {
                                "en": "I prefer drinking a glass of <w>cold</w> water to tea.",
                                "ru": "Я предпочитаю выпить стакан <w>холодной</w> воды, чем чай.",
                                "pl": "Wolę wypić szklankę <w>zimnej</w> wody niż herbatę.",
                                "de": "Ich trinke lieber ein Glas <w>kaltes</w> Wasser als Tee.",
                                "fr": "Je préfère boire un verre d'eau <w>froide</w> plutôt que du thé.",
                                "it": "Preferisco bere un bicchiere d'acqua <w>fredda</w> piuttosto che il tè.",
                                "cs": "Raději piji sklenici <w>studené</w> vody než čaj.",
                                "tr": "Çay yerine bir bardak <w>soğuk</w> su içmeyi tercih ederim.",
                                "es": "Prefiero beber un vaso de agua <w>fría</w> que té."
                            }
