                "translations": [
                    {
                        "translation_id": "8f025c56-5d0d-488c-a92f-4c1fe2b7c77e",
                        "source_entry_id": "30ff5fb4-4958-3a6d-8a57-e621067f0071",
                        "source_sense_id": "1536f208-39d0-353e-97fe-fc19caec348a",
                        "target_lang_word": "Winterquartier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winterquartier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5876cc1d-5958-3b14-9f6e-d9456b95aaff",
                                        "entry_id": "52fd6626-61f8-386d-9eee-64f624b4cc40",
                                        "glosses": [
                                            "Unterkunft während des Winters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c5b2dc-7711-43d2-a20b-897bef21e3a1",
                                                "sense_id": "5876cc1d-5958-3b14-9f6e-d9456b95aaff",
                                                "text": "„Kurz darauf gingen beide Parteien ins Winterquartier, und beide begannen zu bauen.“"
                                            },
                                            {
                                                "example_id": "0627f38d-9936-4f68-bc83-9ac2ea85bbc5",
                                                "sense_id": "5876cc1d-5958-3b14-9f6e-d9456b95aaff",
                                                "text": "„Die Winterquartiere römischer Truppen betrachteten sie als unrechtmäßige Besetzung ihres Territoriums, sie versuchten, die Römer zu vertreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "adcaf83b-37b1-3dae-951e-bcbe0cc28b0a",
                                        "entry_id": "52fd6626-61f8-386d-9eee-64f624b4cc40",
                                        "glosses": [
                                            "Platz, an dem Tiere den Winter verbringen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf9e0674-7538-4c97-b78f-dfbc92f0e8e7",
                        "source_entry_id": "30ff5fb4-4958-3a6d-8a57-e621067f0071",
                        "source_sense_id": "1536f208-39d0-353e-97fe-fc19caec348a",
                        "target_lang_word": "зимовка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зимовка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0ac230-9277-3200-9b70-414fbdd3235a",
                                        "entry_id": "4ca0cca4-96e7-3e93-bbd6-1ec8f06c23e3",
                                        "glosses": [
                                            "действие по значению гл. зимовать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab131210-7b7c-4e66-98f4-413028254b5a",
                                                "sense_id": "aa0ac230-9277-3200-9b70-414fbdd3235a",
                                                "text": "Война и особенно скучная зимовка в глухих местах Финляндии утомили его нравственно, быть может, более, чем физически, и он с удовольствием думал о возвращении в круг близких ему людей, «под тень домашних богов»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ecff92-284a-3cb8-8fe3-fd4d87b28636",
                                        "entry_id": "4ca0cca4-96e7-3e93-bbd6-1ec8f06c23e3",
                                        "glosses": [
                                            "место, жильё, где зимуют люди"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b96a1d-d629-4ce8-bb97-4d36662e8e16",
                                                "sense_id": "14ecff92-284a-3cb8-8fe3-fd4d87b28636",
                                                "text": "Расположиться на зимовке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ed0e8a-eaba-480c-b64c-081039127f4d",
                        "source_entry_id": "30ff5fb4-4958-3a6d-8a57-e621067f0071",
                        "source_sense_id": "1536f208-39d0-353e-97fe-fc19caec348a",
                        "target_lang_word": "зимовье",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зимовье",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "92e0df36-46bf-3646-964b-ddbf44450fe6",
                                        "entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                                        "glosses": [
                                            "проведение зимы где-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085b8478-5138-3b4f-a51a-958abed8952c",
                                        "entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                                        "glosses": [
                                            "место, помещение, где зимуют люди"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c330d6-a208-4450-bc3f-78d3835e29d6",
                                                "sense_id": "085b8478-5138-3b4f-a51a-958abed8952c",
                                                "text": "Сплотились, стали валить лес, рубить поначалу зимовья, позже обращённые в баньки, подбадривать других — не давали опустить руки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e92fe1d-0e98-3a19-a74f-83f4e7ad5775",
                                        "entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                                        "glosses": [
                                            "место, где проводят зиму животные, в том числе рыбы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901a0ddd-edbc-4c82-8538-fb61cd0d930c",
                                                "sense_id": "6e92fe1d-0e98-3a19-a74f-83f4e7ad5775",
                                                "text": "Видимо, легче изменить привычки птиц, которые миллионы лет стремятся на зимовье одним и тем же маршрутом, чем отучить людей охотиться на редких животных."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
