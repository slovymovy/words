                        "entry_id": "b0829831-566b-3a46-b846-ce57f921951e",
                        "glosses": [
                            "перен. крайнее безрассудство; безрассудный поступок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01fe7cd-4e82-42e6-afb9-d43cf3bb097d",
                                "sense_id": "4fa0ed2a-dd77-31fb-a2a0-d0526dc1d8e1",
                                "text": "Безумству храбрых поем мы песню!"
                            }
                        ]
                    }
