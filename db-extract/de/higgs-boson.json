                                "target_senses": [
                                    {
                                        "sense_id": "5de7cef2-c72a-377e-a7b7-c1124640a418",
                                        "entry_id": "caa0179a-5928-3ffc-b72a-9c4c63627f94",
                                        "glosses": [
                                            "een d.d. 2 juli 2012 mogelijk net ontdekt elementair deeltje dat een grote rol speelt in de theorievorming van de elementaire deeltjes"
                                        ],
                                        "tags": [
                                            "deeltjesfysica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8742a0ea-7584-44f7-85ca-dd5dfb79a256",
                                                "sense_id": "5de7cef2-c72a-377e-a7b7-c1124640a418",
                                                "text": "De ontdekking van het higgsboson zou een grote doorbraak in de hoge-energiefysica betekenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52831c2e-155d-44b7-b1d6-0143a57d70d3",
                        "source_entry_id": "e289304f-a7ad-3715-b571-e0f4a90a1130",
                        "source_sense_id": "86220580-47e3-3e32-9594-b726060a385f",
                        "target_lang_word": "higgsdeeltje",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "higgsdeeltje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31af5e99-fccf-3b27-8c2b-33df3dc04543",
                                        "entry_id": "8a5afeb3-bfd6-3673-b5ba-3ad67d9aa2e0",
                                        "glosses": [
                                            "een naar Peter Higgs vernoemd elementair deeltje dat in 1964 door François Englert en Robert Brout voor het eerst werd voorspeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c57ef3-4725-4e60-a54e-36a477792c47",
                                                "sense_id": "31af5e99-fccf-3b27-8c2b-33df3dc04543",
                                                "text": "Zijn grootste succes kende de LHC in 2012, toen fysici in de versneller het langgezochte higgsdeeltje ontdekten. Dat deeltje wordt breed beschouwd als het laatste ontbrekende puzzelstukje van het zogeheten standaardmodel, de natuurkundetheorie die alle deeltjes en hun gedrag in een enkele wiskundige formule giet."
                                            }
                                        ]
                                    }
                                ]
                            }
