                                "target_senses": [
                                    {
                                        "sense_id": "82883c6d-8efe-350e-b359-cf709414f50e",
                                        "entry_id": "fb643f09-d5f8-3d34-a543-35468098d583",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd1c925-a571-4734-b06a-f4135237cb6a",
                                                "sense_id": "82883c6d-8efe-350e-b359-cf709414f50e",
                                                "text": "Certes, je n’étais pas une sainte car, de mon côté, le mariage me servait à m’émanciper et, Denis étant en mer, j’en profitais pour aller danser en boite avec mon amie Béatrice, flirtant un peu avec des jeunes gens qui me plaisaient et, quand ils me donnaient rendez-vous, je leur disais m’appeler Natacha leur faisant ainsi faux bond !"
                                            },
                                            {
                                                "example_id": "dadfe2c0-21f4-4898-b1fb-6c8cd2eea046",
                                                "sense_id": "82883c6d-8efe-350e-b359-cf709414f50e",
                                                "text": "Pour tout savoir sur l’autopalpation, 20 Minutes a rencontré Natacha Naoun, oncologue médicale à l’hôpital Gustave-Roussy de Villejuif (Val-de-Marne)."
                                            },
                                            {
                                                "example_id": "e33d516f-24fc-49a0-81f7-89c2759e2509",
                                                "sense_id": "82883c6d-8efe-350e-b359-cf709414f50e",
                                                "text": "Maurane, Axelle Red, Natacha Atlas, Lara Fabian, entre autres, ont trouvé leur place au palmarès, et Stromae a été salué, pour sa part, à cinq reprises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
