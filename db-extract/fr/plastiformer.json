                "senses": [
                    {
                        "sense_id": "4eaf80f2-eade-3868-b25a-a4eba75f5bb7",
                        "entry_id": "e053e1f3-e47a-3df1-bf5f-21b205bf1821",
                        "glosses": [
                            "Plastifier une surface ou un volume, pour lui donner une forme simple ou complexe, extraite facilement par la suite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf3da10-c570-4325-8728-338ed1bd8a54",
                                "sense_id": "4eaf80f2-eade-3868-b25a-a4eba75f5bb7",
                                "text": "Elle tournait et retournait la carte plastiformée de la « journaliste », une ride de perplexité déformant son joli front."
                            },
                            {
                                "example_id": "0a43183a-6381-4eee-a7e6-7035008190f3",
                                "sense_id": "4eaf80f2-eade-3868-b25a-a4eba75f5bb7",
                                "text": "Ou lui – l’opérateur alternatif (téléphonie), oreilletté\nChez hyperphone – il vend grésillant aux lourds essoufflés\nNimbus ou aux ventres plastiformés dans les calbutes\nOu même aux faims des becs volubiles des minutes\nÀ l’international."
                            },
                            {
                                "example_id": "a845fbcf-71e4-4ef5-9fcd-9ab10463f863",
                                "sense_id": "4eaf80f2-eade-3868-b25a-a4eba75f5bb7",
                                "text": "Quoi de mieux par ce temps frais et humide qu'une bonne tartiflette au barbecue entre amis ? ... En troquant bien sur le traditionnel Reblochon inconnu sur cette partie de globe, par un mélange cheddar+camembert-plastiformé, et en ajoutant du potiron pour parfaire la version australienne."
                            },
                            {
                                "example_id": "6678d8fe-3fe7-4390-a4af-327460c7ae22",
                                "sense_id": "4eaf80f2-eade-3868-b25a-a4eba75f5bb7",
                                "text": "C'est quoi un logo \"plastiformé\"\"\"\"?"
                            }
                        ]
                    }
