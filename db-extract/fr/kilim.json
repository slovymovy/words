                                            {
                                                "example_id": "9fbe647f-38f9-4350-a262-669a93593adb",
                                                "sense_id": "c9aeeb56-625a-32d1-a9c7-97446f5e4e9f",
                                                "text": "The khan they all deferred to was a wiry, hook-nosed man with a growth of grey stubble on his chin, who sat on a kelim, listening to the others' arguments without moving a muscle."
                                            }
