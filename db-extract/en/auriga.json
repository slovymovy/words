                    },
                    {
                        "translation_id": "efe0de70-d209-468a-bcb5-c38c7b49db67",
                        "source_entry_id": "79afac03-e2f9-381a-a41d-2959dad68917",
                        "source_sense_id": "2218632e-2881-3154-82c7-bcc3ea602400",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Fuhrmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuhrmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                        "entry_id": "16798adc-e5c5-3a2f-bd21-f9f6c7cbb296",
                                        "glosses": [
                                            "der ein Fuhrwerk lenkende Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0c2688-6a3f-42f7-bcab-161b37ac96b5",
                                                "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                                "text": "Nach so vielen Stunden Fahrt mussten Zugochse und Fuhrmann eine Rast machen, wozu sich der Dorfweiher anbot."
                                            },
                                            {
                                                "example_id": "0956e6d9-cadc-4f4c-a239-096705de261d",
                                                "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                                "text": "„Soeben hat der Fuhrmann ihnen die Frauen zurückgebracht, und an diesem Abend sind sie bester Laune.“"
                                            },
                                            {
                                                "example_id": "56d4b5a4-6b9d-4017-af7a-9a7caf4d36ec",
                                                "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                                "text": "„Wer sollte in den fluchenden Fuhrleuten, die in einer verrufenen Vorstadtkneipe zechen und karten, Höflinge vermuten, die sonst in silberbestickten Kleidern einherstelzen?“"
                                            },
                                            {
                                                "example_id": "b1a9caf3-01c5-4d32-86e7-0e7b201d6e06",
                                                "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                                "text": "„Pierres Kutscher schrie die bäuerlichen Fuhrleute ärgerlich an, sie sollten sich doch an die eigene Wegseite halten.“"
                                            },
                                            {
                                                "example_id": "43684c82-22be-43f4-b690-76ad0988f8c8",
                                                "sense_id": "eb4df6ff-d8b6-3f96-bef0-1c38e82f4150",
                                                "text": "„Der Altstädter Hof ist eine Kneipe, in der wandernde Artisten, Zigeuner und Fuhrleute verkehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ba0a985-27c5-3edd-9e82-a103fe9a2f3b",
                                        "entry_id": "16798adc-e5c5-3a2f-bd21-f9f6c7cbb296",
                                        "glosses": [
                                            "ein Sternbild am Nordhimmel"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65650245-1d7a-4789-97de-1061ca45515d",
                                                "sense_id": "5ba0a985-27c5-3edd-9e82-a103fe9a2f3b",
                                                "text": "Hoch am Himmel ist der Fuhrmann mit seinem hellen Stern Capella zu finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
