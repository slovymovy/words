                ],
                "senses": [
                    {
                        "sense_id": "647f5261-5e8e-3174-aa86-627d7ff90ca1",
                        "entry_id": "bfa318f6-14cd-3198-8e53-95ccfa123400",
                        "glosses": [
                            "Enlever son caractère anthropologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d1f561-bd1f-4b03-905a-10a52a50359d",
                                "sense_id": "647f5261-5e8e-3174-aa86-627d7ff90ca1",
                                "text": "En voulant désanthropologiser les savoirs, en ayant recours à une histoire discontinuiste et en décrivant des discours sans sujet, il ne ferait jamais qu’être à la verticale de son temps."
                            },
                            {
                                "example_id": "a5870041-5444-4d96-8b9d-189297e1ed1b",
                                "sense_id": "647f5261-5e8e-3174-aa86-627d7ff90ca1",
                                "text": "C’est pourquoi J.-F. Lyotard insiste pour dire qu’il faudrait « désanthropologiser » Kant encore plus."
                            }
                        ]
                    }
                ],
