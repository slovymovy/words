                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c519f3c1-f43d-3c71-9163-374f276e06d6",
                                        "entry_id": "2e439923-f4e8-34db-9f9d-ca6b6aa5a5ef",
                                        "glosses": [
                                            "Qui appartient aux planètes, qui concerne les planètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031a086b-e767-4c4f-b066-7d6e9940fc5b",
                                                "sense_id": "c519f3c1-f43d-3c71-9163-374f276e06d6",
                                                "text": "Région, système planétaire."
                                            },
                                            {
                                                "example_id": "d9502907-41b6-4e21-bf89-732821f8ad05",
                                                "sense_id": "c519f3c1-f43d-3c71-9163-374f276e06d6",
                                                "text": "Année planétaire : Le temps qu’une planète emploie à faire sa révolution autour du soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e1b13d-fc1c-31dd-8686-24adb10fd260",
                                        "entry_id": "2e439923-f4e8-34db-9f9d-ca6b6aa5a5ef",
                                        "glosses": [
                                            "Qui tourne autour d’un objet central."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c6ec5f-3b5a-415f-a0a7-f4b8eee152ad",
                                                "sense_id": "85e1b13d-fc1c-31dd-8686-24adb10fd260",
                                                "text": "Électrons planétaires : Qui entourent le noyau de l’atome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                        "entry_id": "2e439923-f4e8-34db-9f9d-ca6b6aa5a5ef",
                                        "glosses": [
                                            "Qui englobe, concerne la Terre entière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686dccd4-f076-49bb-bc7f-4a3dec853ce7",
                                                "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                                "text": "Le village planétaire."
                                            },
                                            {
                                                "example_id": "b47233fe-4386-4dfb-9bb7-9d923bd44fd5",
                                                "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                                "text": "Le réchauffement climatique a un impact à l’échelle planétaire."
                                            },
                                            {
                                                "example_id": "179b6bdc-61ca-4115-a5e2-07db10f2b7b0",
                                                "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                                "text": "Son dernier morceau est un succès planétaire."
                                            },
                                            {
                                                "example_id": "d5175ebb-9617-4cf2-8a81-d2889754da27",
                                                "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                                "text": "Cet astéroïde fait peser une menace planétaire."
                                            },
                                            {
                                                "example_id": "1f477fed-5324-46e7-aaa1-217bbf8f52a3",
                                                "sense_id": "6587dd7a-3919-3f69-800f-c797c7f81531",
                                                "text": "Mais les plus graves conclusions concernaient l’année suivante, où l’on prévoyait déjà, dans le scénario pessimiste, une famine planétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c1af21a-3e28-3ae0-861a-8c321e0b439c",
                                        "entry_id": "2e439923-f4e8-34db-9f9d-ca6b6aa5a5ef",
                                        "glosses": [
                                            "Relatif à certains systèmes d’engrenages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a10d33-6541-4001-8a28-9b16e1f48f20",
                                                "sense_id": "0c1af21a-3e28-3ae0-861a-8c321e0b439c",
                                                "text": "La disposition à engrenages planétaires comporte un pignon central monté directement sur l’arbre du moteur, un équipage de satellites et une couronne fixe dans laquelle les satellites engrènent en tournant sur eux-mêmes. — (La Technique moderne, volume 28, H. Dunod & E. Pinat, 1936, page 481)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "planétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5801ca0c-6d34-392c-8c9a-a4c687a21f35",
                                        "entry_id": "2b887a80-c86e-3e78-ac4a-21d1cf691e6b",
                                        "glosses": [
                                            "Personne qui se considère comme citoyenne du monde, sans enracinement national."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05566df4-c349-4a34-bfc8-79a9324dcfa0",
                                                "sense_id": "5801ca0c-6d34-392c-8c9a-a4c687a21f35",
                                                "text": "Et quand les planétaires, délivrés de tout ancrage, accueillent, à leur descente de bateau, des migrants, c'est-à-dire des êtres définis non plus par leur origine ou leur destination mais par l'errance, et l'errance seulement, ce sont, selon la théorie de Slezkine, des Juifs qui secourent des Juifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "planétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5af4ae09-cd67-329a-b69c-2063c953fbf7",
                                        "entry_id": "cf293f90-2ef8-37f7-88dd-24a112c76c23",
                                        "glosses": [
                                            "Mécanisme représentant le mouvement des planètes autour du Soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdaade2d-e5fa-4a2e-839b-159736adc687",
                                                "sense_id": "5af4ae09-cd67-329a-b69c-2063c953fbf7",
                                                "text": "Les planétaires les plus célèbres sont ceux de Huygens, et celui qu’on a nommé orrery, parce que lord Orrery le fit construire le premier et en répandit l’usage en Angleterre. On peut voir un planétaire plus moderne et plus parfait à la bibliothèque royale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddc49f19-1b96-343b-8919-a04dc9825633",
                                        "entry_id": "cf293f90-2ef8-37f7-88dd-24a112c76c23",
                                        "glosses": [
                                            "Engrenage d’un différentiel monté sur un demi-arbre de roue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
