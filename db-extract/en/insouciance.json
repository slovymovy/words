                                        "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                        "entry_id": "7a17c6bd-38cc-3be9-bf09-962ff5c7f6b9",
                                        "glosses": [
                                            "Fassung, Selbstbeherrschung in einer schwierigen Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135d97d5-dcec-499e-9c37-b564093e48c6",
                                                "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                                "text": "Bewahren Sie vor Ihrem Chef stets die Contenance!"
                                            },
                                            {
                                                "example_id": "1dbf9265-fcd2-42fd-b053-faf5e0bccf64",
                                                "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                                "text": "„Obwohl der Laden brummte und sich an der Annonce die Bons türmten, bewahrte der Küchenchef die Contenance und stand mir geduldig Rede und Antwort.“"
                                            },
                                            {
                                                "example_id": "79d32a21-678e-4e22-97ea-45fdb18ab0af",
                                                "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                                "text": "„Und auf einmal ist Merkel die Frau, die sich durch die Ebenen müht, mit den Putins, Trumps und Erdoğans dieser Welt herumschlagen, dabei aber stets auch staatsfrauliche Contenance wahren muss.“"
                                            },
                                            {
                                                "example_id": "c7769131-1486-46fb-9192-3543ae4a287b",
                                                "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                                "text": "„Den Experimentierkoffer können sie hier vergessen, dachte er, während er langsam seine Contenance wiederfand.“"
                                            },
                                            {
                                                "example_id": "3b565be5-4aaf-4a4e-980a-a6755f3ddb43",
                                                "sense_id": "4c327813-3658-3e6c-a9e6-5dd7cb2775b4",
                                                "text": "„Wie lange schafft man es, die Contenance zu wahren?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
