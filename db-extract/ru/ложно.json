        "ru-extract.jsonl": [
            {
                "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                "word": "ложно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b1b2f40-8123-3090-a7d1-2248fb270236",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "не соответствуя истине, будучи ошибочным, ненастоящим."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ea3476-62ad-4fd9-957a-3d5cd9f6f987",
                                "sense_id": "2b1b2f40-8123-3090-a7d1-2248fb270236",
                                "text": "Ложно истолковать факты."
                            }
                        ]
                    },
                    {
                        "sense_id": "38c42c50-244e-387b-85ac-a08c35ee5d19",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "фальшиво, притворно, показно."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a673a5ac-6525-39fc-ab16-6827b04d6b3d",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "несправедливо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcacd4f9-34de-4156-aaf5-bcb6bfddff27",
                                "sense_id": "a673a5ac-6525-39fc-ab16-6827b04d6b3d",
                                "text": "Жаль пацанов, которых ложно обвинили, но больше всего мне жалко Валевиду!"
                            }
                        ]
                    },
                    {
                        "sense_id": "851fdbf9-3525-363f-a4e5-6214e96652ce",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "оценочная характеристика чего-либо как не соответствующего истине, ошибочного, не настоящего."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7964a6a-b61a-4d7f-b758-ee50b0f572c9",
                                "sense_id": "851fdbf9-3525-363f-a4e5-6214e96652ce",
                                "text": "[Арманда] по актам ложно значится дочерью Марии Эрве. (Булгаков, Жизнь господина де Мольера)"
                            }
                        ]
                    },
                    {
                        "sense_id": "9c898283-fe5f-3882-be16-b3cd95ad2f35",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "оценочная характеристика чего-либо как фальшивого, притворного, показного."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a1f6f7d-c083-33c9-896f-785f55be62ce",
                        "entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "glosses": [
                            "оценочная характеристика чего-либо как имеющего лишь внешнее сходство с настоящим, действительным."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7285670e-de37-44df-86b7-a35cf7f9fc13",
                        "source_entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "target_lang_word": "falsely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                        "entry_id": "034d856e-cc91-386e-9613-25146cefc7d1",
                                        "glosses": [
                                            "In a false manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1c1f23-2096-4444-a485-3c1380a713e5",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "He protested his innocence to the end, claiming he had been falsely charged and convicted."
                                            },
                                            {
                                                "example_id": "65a30b8b-6180-4117-aba8-767ef1b3d580",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "This could not be more falsely stated."
                                            },
                                            {
                                                "example_id": "24cad39d-5f38-414e-a4cc-6980323b3674",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "Our insensitive laughter echoes even more falsely now."
                                            },
                                            {
                                                "example_id": "ea6ec17d-0583-4b71-b56a-0b3cfd29c4de",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "And on none of them does the name ring more falsely than on Robert Southey."
                                            },
                                            {
                                                "example_id": "8a1622e8-80be-45e6-94ad-77757122ccdf",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "President Donald Trump falsely claimed Thursday that some states saw gas prices fall to just $1.98 on Wednesday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dcfe2bb-c810-4e9a-b77c-75316f13abab",
                        "source_entry_id": "b44ac8a0-9495-3d6d-96b2-448b4b9fc9f8",
                        "target_lang_word": "falsamente",
                        "target_lang_code": "es",
