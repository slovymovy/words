                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7544330-d3c6-331f-83b8-963bc63151c8",
                        "entry_id": "745fa222-9c29-3f68-a333-c0ab0d87d548",
                        "glosses": [
                            "возглас, выражающий сильные — обычно неожиданные — чувства: радость, испуг, удивление и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e87cc08-2865-4eb7-b624-0a1f1677e30a",
                                "sense_id": "d7544330-d3c6-331f-83b8-963bc63151c8",
                                "text": "(Вздыхает.) Экая жара, боже мой! (Помолчав.) Эка парит, господи!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac98d537-4083-4558-b9b9-f9984342c67f",
                        "source_entry_id": "745fa222-9c29-3f68-a333-c0ab0d87d548",
                        "source_sense_id": "d7544330-d3c6-331f-83b8-963bc63151c8",
                        "target_lang_word": "Lord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6cd674b-aa62-3ecf-ab3f-491a1ba04a58",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "The Abrahamic deity of the Jewish, Christian, and Islamic faiths."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8958c015-fa70-4c28-af14-f4af1cb9cd17",
                                                "sense_id": "a6cd674b-aa62-3ecf-ab3f-491a1ba04a58",
                                                "text": "The breath of worldly men cannot depose,\nThe deputy elected by the Lord."
                                            },
                                            {
                                                "example_id": "716c2034-d965-4b26-a94b-4dee71d29ae7",
                                                "sense_id": "a6cd674b-aa62-3ecf-ab3f-491a1ba04a58",
                                                "text": "Their act emphasized their acceptance of Islam as their new allegiance and the forsaking of the true and Living God, Jehovah (the LORD), with devotion to the moon god idol Allah.\n Abram was given a new name, as well, by the LORD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe308b14-0237-3af8-bfd2-ca4bbfcf26c2",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "The Abrahamic deity of the Jewish, Christian, and Islamic faiths.",
                                            "The God of Abraham and the Jewish scriptures."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb8a1735-46c8-3d08-acb3-119d107b8cf5",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "The Abrahamic deity of the Jewish, Christian, and Islamic faiths.",
                                            "God the Father; the Godhead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3842d8fc-9c26-41dc-bdf6-1a8afdf13a62",
                                                "sense_id": "cb8a1735-46c8-3d08-acb3-119d107b8cf5",
                                                "text": "Some trust in charets, and some in horses: but wee will remember the Name of the Lord our God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b39afa13-784e-354a-a446-ab8d326431c7",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "Jesus Christ, God the Son."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af614e40-80f1-49a6-ad8e-6719a231f3d5",
                                                "sense_id": "b39afa13-784e-354a-a446-ab8d326431c7",
                                                "text": "Therfore I doe you to vnderſtand that no má ſpeaking in the Spirit of God, ſaith anáthema to IESVS. And no man can ſay, Our Lord IESVS: but in the holy Ghoſt."
                                            },
                                            {
                                                "example_id": "14f163ba-d668-4fba-97aa-4d98fdccacad",
                                                "sense_id": "b39afa13-784e-354a-a446-ab8d326431c7",
                                                "text": "How loyal in the following of thy Lord!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6943931-d957-361c-9b7c-28215b975d67",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "Any other deity particularly important to a religion or a worshipper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aad9cae-ac3f-4814-b553-6be48135ab41",
                                                "sense_id": "e6943931-d957-361c-9b7c-28215b975d67",
                                                "text": "...and our Lord [the Horned God] as Master, Father, and Sage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49b9bb3-bfdd-37f5-96b7-4d51c6f175c1",
                                        "entry_id": "3a2f85ac-31b4-3d19-bc50-d85c4a290361",
                                        "glosses": [
                                            "An English surname transferred from the nickname, originally a nickname for someone who either acted as if he were a lord or had worked in a lord's household."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Lord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4033144a-9e9d-380e-bb5f-1ba3c242a32c",
                                        "entry_id": "57cae6e8-5e60-3786-bfe7-f04b38bbaad1",
                                        "glosses": [
                                            "An interjection variously expressing astonishment, surprise, resignation."
                                        ],
                                        "tags": [],
