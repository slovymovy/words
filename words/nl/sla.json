                    "target_lang_definitions": {
                        "en": "A plant with green leaves that is often eaten raw.",
                        "ru": "Растение с зелеными листьями, которое часто едят в сыром виде.",
                        "pl": "Roślina o zielonych liściach, która jest często jedzona na surowo.",
                        "de": "Eine Pflanze mit grünen Blättern, die oft roh gegessen wird.",
                        "fr": "Une plante à feuilles vertes qui est souvent consommée crue.",
                        "it": "Una pianta con foglie verdi che viene spesso consumata cruda.",
                        "cs": "Rostlina se zelenými listy, která se často jí syrová.",
                        "tr": "Genellikle çiğ olarak yenen, yeşil yapraklı bir bitki.",
                        "es": "Una planta de hojas verdes que a menudo se come cruda."
                    },
