                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f0bc3cb-1d74-3c16-826e-7219d03daeca",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To raise (someone) to a more important, responsible, or remunerative job or rank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5c8997-4803-4228-8700-a5f7cc665141",
                                                "sense_id": "3f0bc3cb-1d74-3c16-826e-7219d03daeca",
                                                "text": "He promoted his clerk to office manager."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d9e426-e6f0-368a-b31f-2b6b5b2cce5c",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To advocate or urge on behalf of (something or someone); to attempt to popularize or sell by means of advertising or publicity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e51cb9-1510-4393-93fa-373dc2143cd7",
                                                "sense_id": "a8d9e426-e6f0-368a-b31f-2b6b5b2cce5c",
                                                "text": "They promoted the abolition of daylight saving time."
                                            },
                                            {
                                                "example_id": "5a9e064a-0b4b-4207-95e2-a9b8a974a3ef",
                                                "sense_id": "a8d9e426-e6f0-368a-b31f-2b6b5b2cce5c",
                                                "text": "They promoted the new film with giant billboards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa30072f-b70e-3af9-b20e-7fe136ab128a",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To encourage, urge or incite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde7d1db-3c65-4473-84ce-b57f3e95e256",
                                                "sense_id": "fa30072f-b70e-3af9-b20e-7fe136ab128a",
                                                "text": "so that finding myself on the point of going, and loath to leave the tender partner of my joys behind me, I employed all the forwarding motions and arts my experience suggested to me, to promote his keeping me company to our journey's end.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "451f45a3-f874-45df-b43a-d0555ca4b055",
                                                "sense_id": "fa30072f-b70e-3af9-b20e-7fe136ab128a",
                                                "text": "It appears that Le Guin is promoting a sort of self-critique on her own ideology. Interestingly, although the story does give such an impression, the problematic characteristics of the Anarresti society are far more severe than economic scarcities or isolation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0a3592-f1ab-3034-bd84-d7476143a37b",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To elevate to a higher league."
                                        ],
                                        "tags": [
                                            "passive",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c30e31-7b7e-4929-9712-8af9fd601edc",
                                                "sense_id": "4b0a3592-f1ab-3034-bd84-d7476143a37b",
                                                "text": "At the end of the season, three teams are promoted to the Premier League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca37c846-6fdc-3bf6-97af-ce21e6088ca2",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To increase the activity of (a catalyst) by changing its surface structure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70689111-9a72-3662-be57-16f8e20d56bc",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To exchange (a pawn) for a queen or other piece when it reaches the eighth rank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813d2fe1-651e-48a0-bd7d-f009017c8d43",
                                                "sense_id": "70689111-9a72-3662-be57-16f8e20d56bc",
                                                "text": "Having crossed the chessboard, his pawn was promoted to a queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9c82f4-20c7-35c9-a1de-eec1d9ffb9fb",
                                        "entry_id": "248b9380-0378-3a83-bd95-b63432784747",
                                        "glosses": [
                                            "To move on to a subsequent stage of education."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4462f5f7-b9b5-4235-a794-b964e5abe1c2",
                                                "sense_id": "8a9c82f4-20c7-35c9-a1de-eec1d9ffb9fb",
                                                "text": "At the end of Primary 6 students can promote directly to the secondary section of SIS."
                                            }
