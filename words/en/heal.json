{
    "word_family": [
        "healer",
        "healing",
        "health",
        "healthy",
        "unhealthy",
        "healthiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88faa6a2-231e-3ebc-9fc3-f469d1e34c27",
                    "sense_definition": "To become healthy again after an injury or illness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said that the deep cut on your arm will <w>heal</w> quickly if you keep it clean.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что глубокий порез на твоей руке быстро <w>заживёт</w>, если ты будешь держать его в чистоте."
                            }
                        },
                        {
                            "text": "It usually takes several weeks for a broken bone to <w>heal</w> completely.",
                            "target_lang_translations": {
                                "ru": "Обычно требуется несколько недель, чтобы сломанная кость полностью <w>срослась</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "get better",
                        "recover"
                    ],
                    "common_phrases": [
                        "heal quickly",
                        "heal completely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова стать здоровым после травмы или болезни; затянуться (о ране)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заживать",
                                "target_lang_sense_clarification": "о ранах и порезах"
                            },
                            {
                                "target_lang_word": "зажить",
                                "target_lang_sense_clarification": "окончательно восстановиться"
                            },
                            {
                                "target_lang_word": "зарастать",
                                "target_lang_sense_clarification": "о шрамах или глубоких ранах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5f9963-dc1a-3d4d-ac63-ed75159bc4c7",
                    "sense_definition": "To make someone or something healthy again; to cure a disease or wound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse applied a special ointment to <w>heal</w> the wound and prevent infection.",
                            "target_lang_translations": {
                                "ru": "Медсестра нанесла специальную мазь, чтобы <w>заживить</w> рану и предотвратить инфекцию."
                            }
                        },
                        {
                            "text": "Many people believe that certain natural herbs have the power to <w>heal</w> various ailments.",
                            "target_lang_translations": {
                                "ru": "Многие люди верят, что определенные природные травы обладают силой <w>исцелять</w> различные недуги."
                            }
                        }
                    ],
                    "synonyms": [
                        "cure",
                        "make whole"
                    ],
                    "common_phrases": [
                        "heal the wound",
                        "power to heal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо или что-либо снова здоровым; вылечить болезнь или рану."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исцелять",
                                "target_lang_sense_clarification": "возвращать здоровье, часто в высоком смысле"
                            },
                            {
                                "target_lang_word": "вылечить",
                                "target_lang_sense_clarification": "полностью избавить от недуга"
                            },
                            {
                                "target_lang_word": "заживлять",
                                "target_lang_sense_clarification": "способствовать заживлению раны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd369f9b-c0c9-3981-83b7-831dfd8d581f",
                    "sense_definition": "To resolve a conflict or emotional pain; to make a situation whole again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took many years of honest conversation to <w>heal</w> the rift between the two brothers.",
                            "target_lang_translations": {
                                "ru": "Потребовалось много лет честных разговоров, чтобы <w>залечить</w> раскол между двумя братьями."
                            }
                        },
                        {
                            "text": "Time and support from friends can help to <w>heal</w> a broken heart after a difficult breakup.",
                            "target_lang_translations": {
                                "ru": "Время и поддержка друзей могут помочь <w>исцелить</w> разбитое сердце после тяжелого расставания."
                            }
                        }
                    ],
                    "synonyms": [
                        "make whole"
                    ],
                    "common_phrases": [
                        "heal the rift",
                        "heal a broken heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешить конфликт или душевную боль; восстановить целостность ситуации или отношений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залечить",
                                "target_lang_sense_clarification": "о душевных ранах"
                            },
                            {
                                "target_lang_word": "исцелить",
                                "target_lang_sense_clarification": "о разбитом сердце или раздоре"
                            },
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "о разногласиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4ee35ae-a896-3469-9026-58675cf09309",
                    "sense_definition": "An alternative form of <w>hele</w> meaning to hide or keep secret.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old ritual, the initiate had to swear to <w>heal</w> and conceal the secrets of the craft.",
                            "target_lang_translations": {
                                "ru": "В старинном ритуале посвященный должен был поклясться <w>хранить</w> и скрывать секреты ремесла."
                            }
                        },
                        {
                            "text": "The ancient text used the word <w>heal</w> to mean keeping a secret from the uninitiated.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте слово <w>heal</w> использовалось в значении сохранения тайны от непосвященных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heal and conceal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in specific historical or ritual contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная форма слова hele, означающая скрывать или хранить в тайне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "держать в секрете"
                            },
                            {
                                "target_lang_word": "утаивать",
                                "target_lang_sense_clarification": "не разглашать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18fd2a56-0ade-319c-88f9-069005cfec77",
                    "sense_definition": "In gaming, a spell or ability used to restore health points to a character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming_mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest in our group needs to cast a <w>heal</w> on the tank before he dies.",
                            "target_lang_translations": {
                                "ru": "Жрецу в нашей группе нужно кинуть <w>хил</w> на танка, пока тот не умер."
                            }
                        },
                        {
                            "text": "I have one powerful <w>heal</w> left in my mana pool for this boss fight.",
                            "target_lang_translations": {
                                "ru": "У меня осталось одно мощное <w>лечение</w> в запасе маны для этой битвы с боссом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast a heal",
                        "powerful heal"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in video game culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В видеоиграх: заклинание или способность, восстанавливающая очки здоровья персонажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хил",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "лечение",
                                "target_lang_sense_clarification": "восстановление здоровья"
                            },
                            {
                                "target_lang_word": "исцеление",
                                "target_lang_sense_clarification": "игровое заклинание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e32ba1b7-ee91-3812-ad51-caebab712eb1",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local furniture store was founded by a man named Mr. <w>Heal</w> in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Местный мебельный магазин был основан человеком по фамилии мистер <w>Хил</w> в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "We are meeting with Professor <w>Heal</w> to discuss the results of the historical research.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с профессором <w>Хилом</w>, чтобы обсудить результаты исторического исследования."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хил",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}