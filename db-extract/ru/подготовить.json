                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подгото́вив"
                    },
                    {
                        "form_id": "98f28999-d09f-49e7-85d6-1d5bcaa75c9c",
                        "entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подгото́вивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2b4f34e-847b-3a18-9b13-eed347a64839",
                        "entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "glosses": [
                            "провести предварительную работу для осуществления, проведения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64741e4-1485-4d4c-b9d9-3ae6ef5f89cd",
                                "sense_id": "a2b4f34e-847b-3a18-9b13-eed347a64839",
                                "text": "Обычно Татарский имел дело с PR-шестерками, но в этот раз его вызвали к совладельцу фирмы, которая собиралась стать дистрибьютором «Diesel». Это был хмурый корректный юноша. Прочитав несколько раз две принесенных Татарским странички, он хмыкнул, подумал, позвонил секретарше и попросил подготовить бумаги."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c667024-2357-3e96-86c6-c5928574fe88",
                        "entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "glosses": [
                            "дать необходимые знания, обучить для какой-либо деятельности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5897a062-32c4-45c0-a15c-d8e918c863ea",
                                "sense_id": "8c667024-2357-3e96-86c6-c5928574fe88",
                                "text": "Здесь все усилия направлены на главную цель — подготовить студента к сдаче экзаменов с самым высоким результатом."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3241832-b724-3d79-8063-548a65bd8bca",
                        "entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "glosses": [
                            "настроить для восприятия какого-либо известия, сообщения и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9d06cd-8c51-4e08-a28c-611a0c83055e",
                                "sense_id": "f3241832-b724-3d79-8063-548a65bd8bca",
                                "text": "Нужно до известной степени подготовить публику, приручить читателя, образовать его вкусы в известном направлении, а потом уж и начать звонить вовсю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3edbdddd-ba39-473e-bd5a-c7e0fbee2942",
                        "source_entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "target_lang_word": "prepare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prepare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff91511d-e5bc-3ed2-826c-1949594d81a8",
                                        "entry_id": "ec3e234e-c236-3af2-a64d-02c7b7de1cdc",
                                        "glosses": [
                                            "To make ready for a specific future purpose; to set up; to assemble or equip; to forearm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94918c61-9f83-456c-99c2-4cdd4f12b6b3",
                                                "sense_id": "ff91511d-e5bc-3ed2-826c-1949594d81a8",
                                                "text": "that they may prepare a city for habitation"
                                            },
                                            {
                                                "example_id": "c11252b7-4229-4e68-83bf-6080cfe76852",
                                                "sense_id": "ff91511d-e5bc-3ed2-826c-1949594d81a8",
                                                "text": "our souls, not yet prepared for upper light"
                                            },
                                            {
                                                "example_id": "6a86d084-a32f-49ce-996c-ed2156b48da5",
                                                "sense_id": "ff91511d-e5bc-3ed2-826c-1949594d81a8",
                                                "text": "We prepared the spacecraft for takeoff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef640f01-29be-385a-a6c7-73bb15dabf17",
                                        "entry_id": "ec3e234e-c236-3af2-a64d-02c7b7de1cdc",
                                        "glosses": [
                                            "To make ready for eating or drinking; to cook."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b8fa73-7bc9-4cd5-98aa-25ee0f7e656d",
                                                "sense_id": "ef640f01-29be-385a-a6c7-73bb15dabf17",
                                                "text": "We prepared a fish for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                        "entry_id": "ec3e234e-c236-3af2-a64d-02c7b7de1cdc",
                                        "glosses": [
                                            "To make oneself ready; to get ready, make preparation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c7f88b-e6fc-43f3-b832-b9c61bfacab2",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "We prepared for a bumpy ride."
                                            },
                                            {
                                                "example_id": "92200ba6-1a18-4917-871a-2a3c79d8ca19",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            },
                                            {
                                                "example_id": "15d980aa-b2d6-4fd7-b8ce-6df3332e8477",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "Tourists visited a memorial hall adorned by a slogan in the handwriting of Chiang Kai-shek, Taiwan's divisive former nationalist leader: \"Stay alert and prepare for battle.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ace6ec1-44d6-3044-bc29-e1fcb8f815df",
                                        "entry_id": "ec3e234e-c236-3af2-a64d-02c7b7de1cdc",
                                        "glosses": [
                                            "To produce or make by combining elements; to synthesize, compound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5cf9ed-22fe-4664-b70d-732d53dd38d8",
                                                "sense_id": "1ace6ec1-44d6-3044-bc29-e1fcb8f815df",
                                                "text": "She prepared a meal from what was left in the cupboards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prepare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a694783-27cb-34b1-93ed-6e7e08e28ff1",
                                        "entry_id": "8b3cd839-e7c9-32c6-9d96-b895405f280d",
                                        "glosses": [
                                            "preparation"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ffb353-d530-49a8-8086-b79f6a4db01d",
                                                "sense_id": "8a694783-27cb-34b1-93ed-6e7e08e28ff1",
                                                "text": "Go levy men, and make prepare for war;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c757fe63-f847-4f19-b95f-67cac834c996",
