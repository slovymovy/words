                "senses": [
                    {
                        "sense_id": "1781d6e0-6ade-3cbd-821a-0f5ad0d69748",
                        "entry_id": "e6d3dee5-6ec5-3c3f-b034-988c4e75a14d",
                        "glosses": [
                            "Mécaniser de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d32ab3-db0e-4851-939c-b30124aafd71",
                                "sense_id": "1781d6e0-6ade-3cbd-821a-0f5ad0d69748",
                                "text": "En France, il est d’usage de mépriser les petits boulots, il y a la volonté d’ultra-mécaniser."
                            },
                            {
                                "example_id": "0530fa9c-a78e-4816-b39a-91bd4b747bf4",
                                "sense_id": "1781d6e0-6ade-3cbd-821a-0f5ad0d69748",
                                "text": "Ce n’est point pour contrebalancer le penchant de notre société à s’ultra-mécaniser qu’elle doit « comprendre » des philosophes, des essayistes, des poètes."
                            }
                        ]
                    }
