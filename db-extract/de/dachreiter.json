                "senses": [
                    {
                        "sense_id": "a9adec17-b0d5-3300-b017-ecdeb5716fe1",
                        "entry_id": "93e3670f-2e8e-31b9-ae46-1dd5d124f4c1",
                        "glosses": [
                            "schmaler, schlanker Turm auf dem First eines Daches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23bc7cc3-f8a7-407d-9cda-99dc9e7d11b2",
                                "sense_id": "a9adec17-b0d5-3300-b017-ecdeb5716fe1",
                                "text": "„Dachreiter werden sowohl beim Neubau als auch nachträglich ohne große Vorbereitung einfach auf ein Flach- oder Gefälledach aufgesetzt und abgedichtet.“"
                            },
                            {
                                "example_id": "25ed9e1b-e4c5-43da-83a2-9c0fc915c2b8",
                                "sense_id": "a9adec17-b0d5-3300-b017-ecdeb5716fe1",
                                "text": "„Der sogenannte Dachreiter ist ein auf dem Dachfirst eines Hauptdaches sitzendes Türmchen.“"
                            },
                            {
                                "example_id": "5c44aa8c-480b-402c-8e72-e560338ce6a4",
                                "sense_id": "a9adec17-b0d5-3300-b017-ecdeb5716fe1",
                                "text": "„Dieser Ecke schräg gegenüber, unmittelbar hinter dem Pfarrhause, steigt der Kirchhof lehnan, auf ihm, so ziemlich in seiner Mitte, die frühmittelalterliche Feldsteinkirche mit einem aus dem vorigen Jahrhundert stammenden Dachreiter und einem zur Seite des alten Rundbogenportals angebrachten Holzarm, dran eine Glocke hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
