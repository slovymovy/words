{
    "word_family": [
        "beg",
        "beggary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                    "sense_definition": "A person who asks others for money or food as a way of living.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beggar</w> sat on the street corner asking passersby for spare change.",
                            "target_lang_translations": {
                                "ru": "<w>Нищий</w> сидел на углу улицы и просил мелочь у прохожих."
                            }
                        },
                        {
                            "text": "In the story, the hero meets a <w>beggar</w> who is actually a king in disguise.",
                            "target_lang_translations": {
                                "ru": "В этой истории герой встречает <w>нищего</w>, который на самом деле является переодетым королём."
                            }
                        }
                    ],
                    "synonyms": [
                        "mendicant",
                        "panhandler"
                    ],
                    "common_phrases": [
                        "street beggar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который просит деньги или еду у других, чтобы выжить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нищий",
                                "target_lang_sense_clarification": "человек, живущий подаянием"
                            },
                            {
                                "target_lang_word": "попрошайка",
                                "target_lang_sense_clarification": "человек, выпрашивающий деньги или еду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9395d9ae-6187-3568-9c22-59033e99ce7b",
                    "sense_definition": "A person who is extremely poor and lacks basic necessities.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>beggar</w> after losing all his money in the bad investment.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя <w>нищим</w> после того, как потерял все свои деньги из-за неудачной инвестиции."
                            }
                        },
                        {
                            "text": "The family lived like <w>beggars</w> during the harsh winter months.",
                            "target_lang_translations": {
                                "ru": "В суровые зимние месяцы семья жила как <w>нищие</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pauper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне бедный человек, лишённый самого необходимого для жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нищий",
                                "target_lang_sense_clarification": "очень бедный человек"
                            },
                            {
                                "target_lang_word": "бедняк",
                                "target_lang_sense_clarification": "неимущий человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8067cce7-1ab4-32ad-b5e1-52455d14aea7",
                    "sense_definition": "A person who is considered annoying, foolish, or unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What does that silly <w>beggar</w> think he is doing in the middle of the road?",
                            "target_lang_translations": {
                                "ru": "Что этот глупый <w>чудак</w> делает посреди дороги?"
                            }
                        },
                        {
                            "text": "Leave that poor <w>beggar</w> alone; he does not know any better.",
                            "target_lang_translations": {
                                "ru": "Оставь этого бедного <w>бедолагу</w> в покое, он просто не понимает."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly beggar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to refer to a person, often with a sense of pity or mild annoyance."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, вызывающий раздражение, недотёпа или бедолага (в разговорной речи)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедолага",
                                "target_lang_sense_clarification": "с сочувствием или жалостью"
                            },
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "с лёгким раздражением или удивлением"
                            },
                            {
                                "target_lang_word": "дуралей",
                                "target_lang_sense_clarification": "о глупом человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e32bae4-1ba6-3548-b770-126bc1fadcd7",
                    "sense_definition": "To cause someone to become extremely poor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impoverish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high cost of medical bills threatened to <w>beggar</w> the entire family.",
                            "target_lang_translations": {
                                "ru": "Огромные счета за лечение грозили <w>разорить</w> всю семью."
                            }
                        },
                        {
                            "text": "The war served only to <w>beggar</w> the nation and its citizens.",
                            "target_lang_translations": {
                                "ru": "Война лишь <w>пустила по миру</w> страну и её граждан."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доводить кого-либо до крайней бедности, разорять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорять",
                                "target_lang_sense_clarification": "лишать средств к существованию"
                            },
                            {
                                "target_lang_word": "пуoperatingить по миру",
                                "target_lang_sense_clarification": "доводить до нищеты"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "финансово истощать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                    "sense_definition": "To be so extraordinary that it cannot be described or surpassed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impoverish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beauty of the sunset <w>beggars</w> description.",
                            "target_lang_translations": {
                                "ru": "Красота заката просто <w>не поддаётся</w> описанию."
                            }
                        },
                        {
                            "text": "The sheer scale of the project <w>beggars</w> belief.",
                            "target_lang_translations": {
                                "ru": "Сам масштаб этого проекта просто <w>не укладывается</w> в голове."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beggars belief",
                        "beggars description"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть настолько поразительным или необычайным, что это невозможно описать словами или в это трудно поверить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не поддаваться",
                                "target_lang_sense_clarification": "в устойчивых выражениях (описанию, вероятию)"
                            },
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть выше возможностей описания"
                            }
                        ]
