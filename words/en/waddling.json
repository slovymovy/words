{
    "word_family": [
        "waddle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "224923df-c145-38d6-a6bc-545f39c2a8d1",
                    "sense_definition": "The present participle and gerund of <w>waddle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duck was <w>waddling</w> slowly across the grass toward the pond.",
                            "target_lang_translations": {
                                "zh": "那只鸭子正<w>摇摇摆摆地</w>穿过草地，向池塘走去。"
                            }
                        },
                        {
                            "text": "After the heavy meal, he felt like <w>waddling</w> back to his chair.",
                            "target_lang_translations": {
                                "zh": "吃完那顿大餐后，他感觉自己只能<w>摇摇摆摆地</w>走回椅子旁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "waddling along",
                        "waddling away"
                    ],
                    "target_lang_definitions": {
                        "zh": "指像鸭子一样左右摇摆地走路。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇摇摆摆地走",
                                "target_lang_sense_clarification": "描述动作方式，强调左右摇晃的步态。"
                            },
                            {
                                "target_lang_word": "蹒跚",
                                "target_lang_sense_clarification": "形容走路不稳，摇摇晃晃。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa0617b4-0d7b-384a-96c6-64d805f22f24",
                    "sense_definition": "The act of walking with short, unsteady steps, swaying from side to side.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler's <w>waddling</w> made everyone in the room smile.",
                            "target_lang_translations": {
                                "zh": "那个幼儿<w>蹒跚</w>的步态让屋里的每个人都笑了。"
                            }
                        },
                        {
                            "text": "The penguin's <w>waddling</w> is a very efficient way to move on ice.",
                            "target_lang_translations": {
                                "zh": "企鹅<w>摇摆步态</w>是在冰面上移动的一种非常有效的方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tottering",
                        "shuffling"
                    ],
                    "common_phrases": [
                        "funny waddling"
                    ],
                    "target_lang_definitions": {
                        "zh": "指左右摇摆、步履蹒跚的走路姿态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇摆步态",
                                "target_lang_sense_clarification": "指代那种左右摇晃的走路方式。"
                            },
                            {
                                "target_lang_word": "蹒跚",
                                "target_lang_sense_clarification": "指代走路摇晃不稳的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}