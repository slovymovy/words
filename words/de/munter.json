                    "semantic_group_id": "wachsein",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer kalten Dusche fühlte er sich sofort wieder <w>munter</w>.",
                            "target_lang_translations": {
                                "en": "After a cold shower, he immediately felt <w>wide awake</w> again.",
                                "ru": "После холодного душа он сразу снова почувствовал себя <w>бодрым</w>.",
                                "nl": "Na een koude douche voelde hij zich meteen weer <w>wakker</w>.",
                                "pl": "Po zimnym prysznicu poczuł się od razu znów <w>rzeźwy</w>.",
                                "fr": "Après une douche froide, il s'est immédiatement senti à nouveau <w>bien réveillé</w>.",
                                "it": "Dopo una doccia fredda si sentì subito di nuovo <w>ben sveglio</w>.",
                                "cs": "Po studené sprše se hned zase cítil <w>svěží</w>.",
                                "tr": "Soğuk bir duşun ardından hemen yeniden <w>zinde</w> hissetti.",
                                "es": "Después de una ducha fría, enseguida volvió a sentirse <w>despierto</w>.",
                                "zh": "洗了个冷水澡后，他立刻又觉得<w>精神</w>了。"
                            }
                        },
                        {
                            "text": "Obwohl es noch sehr früh war, sprang sie frisch und <w>munter</w> aus dem Bett.",
                            "target_lang_translations": {
                                "en": "Although it was still very early, she jumped out of bed fresh and <w>alert</w>.",
                                "ru": "Хотя было ещё очень рано, она выскочила из постели свежей и <w>бодрой</w>.",
                                "nl": "Hoewel het nog heel vroeg was, sprong ze fris en <w>monter</w> uit bed.",
                                "pl": "Chociaż było jeszcze bardzo wcześnie, wyskoczyła z łóżka świeża i <w>rześka</w>.",
                                "fr": "Même s'il était encore très tôt, elle a sauté du lit fraîche et <w>dispose</w>.",
                                "it": "Sebbene fosse ancora molto presto, saltò giù dal letto fresca e <w>pimpante</w>.",
                                "cs": "Ačkoli bylo ještě velmi brzy, vyskočila z postele svěží a <w>čilá</w>.",
                                "tr": "Henüz çok erken olmasına rağmen, yataktan dinç ve <w>zinde</w> bir şekilde fırladı.",
                                "es": "Aunque todavía era muy temprano, saltó de la cama fresca y <w>espabilada</w>.",
                                "zh": "虽然时间还很早，她还是神清气爽、格外<w>精神</w>地从床上跳了起来。"
                            }
                        }
