                    {
                        "translation_id": "9798d0fc-027b-404c-b711-357920c493fa",
                        "source_entry_id": "947997b7-745f-391c-9d5e-370d5ae11919",
                        "source_sense_id": "9e3fa247-79ec-3b81-8c23-1a0402cb44b4",
