                ],
                "senses": [
                    {
                        "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                        "entry_id": "b918ba77-c6e6-3658-b9c5-fa0cb5c2fec7",
                        "glosses": [
                            "a foreign country or countries, or any territory outside homeland"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "13b6c31a-fb38-417e-ae8c-3b1e05283699",
                                "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                                "text": "уе́хать в заграни́цу",
                                "translation": "to leave the home country, to go abroad",
                                "english": "to leave the home country, to go abroad"
                            },
                            {
                                "example_id": "86f1801a-d8d7-4524-ad6b-ac297a5d117d",
                                "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                                "text": "ката́ться по заграни́цам",
                                "translation": "to go abroad frequently, to travel from one foreign country to another.",
                                "english": "to go abroad frequently, to travel from one foreign country to another."
                            },
                            {
                                "example_id": "ae8cde87-5444-4ff2-b2ca-43d21ea1d090",
                                "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                                "text": "торгова́ть с заграни́цей",
                                "translation": "to do foreign trade, to trade overseas.",
                                "english": "to do foreign trade, to trade overseas."
                            },
                            {
                                "example_id": "7e96ce96-652d-4ab1-b59b-6825e22a875e",
                                "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                                "text": "быть заграни́цей",
                                "translation": "to be abroad",
                                "english": "to be abroad"
                            },
                            {
                                "example_id": "b4eccc16-acef-4d39-9de6-fa3b076576e6",
                                "sense_id": "ae10d76e-bc72-322c-ba6e-3dc8dcddf784",
                                "text": "Он сейча́с заграни́цей",
                                "translation": "He is abroad now.",
                                "english": "He is abroad now."
                            }
                        ]
                    }
                ],
