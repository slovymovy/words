                "senses": [
                    {
                        "sense_id": "d9a4a075-fbf1-3ed4-83f6-71698f8a6e88",
                        "entry_id": "5d4eff1a-489c-3cff-b5c7-6b4329e9628a",
                        "glosses": [
                            "taki, którego nie można naprawić"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5019a5b-78eb-4ef0-88b5-39538333943c",
                                "sense_id": "d9a4a075-fbf1-3ed4-83f6-71698f8a6e88",
                                "text": "Mam dość pesymistyczny pogląd na naturę rzeczy i uważam, że świat jest raczej nienaprawialny"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7606d63-bd90-4619-9eed-ca1246073c79",
                        "source_entry_id": "5d4eff1a-489c-3cff-b5c7-6b4329e9628a",
                        "source_sense_id": "d9a4a075-fbf1-3ed4-83f6-71698f8a6e88",
                        "target_lang_word": "irreclaimable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreclaimable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d542c535-d616-30ca-8c1c-85206f3a2ebb",
                                        "entry_id": "bd13f02d-3430-3d1c-93a1-1579498acdba",
                                        "glosses": [
                                            "Incapable of being reclaimed; not reclaimable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14390f99-6f8b-4277-9b62-740e500f5c0c",
                                                "sense_id": "d542c535-d616-30ca-8c1c-85206f3a2ebb",
                                                "text": "irreclaimable land"
                                            },
                                            {
                                                "example_id": "631a298f-8f28-4c91-bd85-74aa25bcaa3f",
                                                "sense_id": "d542c535-d616-30ca-8c1c-85206f3a2ebb",
                                                "text": "To most in prison/jail, the necessity to be trusted and believed is indispensable. The majority have already lost their stateliness, credibility and so on in the judicial mechanism. Add to that the certainty that all else is irreclaimable in the procedure and you can have the predominant component for suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcca7753-9eb8-397b-a16a-0e57f278e9fb",
                                        "entry_id": "bd13f02d-3430-3d1c-93a1-1579498acdba",
                                        "glosses": [
                                            "Unredeemable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785ce6ff-7af1-4018-9e5e-6a18ae1f0de7",
                                                "sense_id": "dcca7753-9eb8-397b-a16a-0e57f278e9fb",
                                                "text": "an irreclaimable criminal"
                                            },
                                            {
                                                "example_id": "a49712aa-b8ea-4ca0-b79d-61f9c923d786",
                                                "sense_id": "dcca7753-9eb8-397b-a16a-0e57f278e9fb",
                                                "text": "Even then, Wingfield endeavoured to retain the hawk by the substitution of another — young Kate, as he called her, a wild, raking bird as ever flew, whose kitish propensities had, some time before, led him to give her up as irreclaimable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc7f11f5-d5c2-4bc8-91d7-0adf6285c4da",
                        "source_entry_id": "5d4eff1a-489c-3cff-b5c7-6b4329e9628a",
                        "source_sense_id": "d9a4a075-fbf1-3ed4-83f6-71698f8a6e88",
                        "target_lang_word": "irreparable",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreparable",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "622ea9c0-0537-36a8-b01f-524618c0d9c2",
                                        "entry_id": "253c4bae-8778-397a-bba1-373be2246fc4",
                                        "glosses": [
                                            "Que no se puede reparar ni arreglar."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38cafd7e-659b-4617-96f4-9cabe2708c79",
                        "source_entry_id": "5d4eff1a-489c-3cff-b5c7-6b4329e9628a",
                        "source_sense_id": "d9a4a075-fbf1-3ed4-83f6-71698f8a6e88",
                        "target_lang_word": "irreparabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreparabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5099faaf-0333-32b3-a9fa-70976e1795c6",
                                        "entry_id": "701186dd-cf96-3435-a49a-51754f88f954",
                                        "glosses": [
                                            "nicht mehr zu reparieren"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3eff705-cc1f-4f60-9229-cbbafaf4fd8d",
                                                "sense_id": "5099faaf-0333-32b3-a9fa-70976e1795c6",
                                                "text": "Eine Grafikkarte ist in der Regel irreparabel, wenn sie einmal kaputt ist."
                                            },
                                            {
                                                "example_id": "271516f1-a826-45df-82ad-1af784a168f7",
                                                "sense_id": "5099faaf-0333-32b3-a9fa-70976e1795c6",
                                                "text": "„Während sein eigenes Rad noch fahrbereit ist, zeigt das Vorderrad des Unfallgegners eine irreparable Acht, so dass es gänzlich auszubauen ist.“"
                                            },
                                            {
                                                "example_id": "16fc36eb-0a33-461c-86e8-e2b7665397c2",
                                                "sense_id": "5099faaf-0333-32b3-a9fa-70976e1795c6",
                                                "text": "„[…] an meinem Rasierer ist das Kabel geteilt, wodurch der ganze Apparat irreparabel erscheint […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8646453-b390-326c-9bf4-6c5081dff409",
                                        "entry_id": "701186dd-cf96-3435-a49a-51754f88f954",
                                        "glosses": [
                                            "unwiederbringlich, endgültig verloren"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc902de2-f33d-48c5-8816-5ff1fedd0f55",
                                                "sense_id": "a8646453-b390-326c-9bf4-6c5081dff409",
                                                "text": "Die Schäden der Krise für unser Unternehmen sind irreparabel. Wir werden vermutlich in Konkurs gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05963f2a-d942-39a9-9635-114e4706debf",
                                        "entry_id": "701186dd-cf96-3435-a49a-51754f88f954",
                                        "glosses": [
                                            "nicht mehr heilbar"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969b005e-9201-4460-ae6e-2d51ba247b8f",
                                                "sense_id": "05963f2a-d942-39a9-9635-114e4706debf",
                                                "text": "Er zog sich beim Sturz vom Motorrad eine Verletzung am Knie zu, die irreparabel ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
