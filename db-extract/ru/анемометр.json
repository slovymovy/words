                    {
                        "sense_id": "f64e5cd5-dd08-3554-876e-04c769b82e2a",
                        "entry_id": "d295c88d-9167-3ca7-8a52-0623a5549020",
                        "glosses": [
                            "метеорологический прибор для измерения скорости и определения направления потока сплошной среды (газов или жидкостей)"
                        ],
