                        "entry_id": "9ef8a3d7-4412-3a70-abe2-83bdad22ab0a",
                        "glosses": [
                            "A cycle with three wheels, powered by pedals and usually intended for young children."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a7cdcf-a556-4635-a489-90ef55f75f82",
                                "sense_id": "0586b219-2fb9-3584-a7c1-3038f5fe5e75",
                                "text": "[S]o I rode home on my brand new tricycle to find the rest of the family parked in front of the box."
                            }
                        ]
                    },
