                    {
                        "sense_id": "996c2711-c348-3189-b3d9-8105534e8d28",
                        "entry_id": "c7011094-762a-38f6-b9e4-4bd36da64189",
                        "glosses": [
                            "Qui manque de délicatesse dans les sentiments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99747383-30ee-44de-8ecb-2d4d14a7ff76",
                                "sense_id": "996c2711-c348-3189-b3d9-8105534e8d28",
                                "text": "Si quelqu’un d’indélicat a fait la découverte avant nous, quelle tentation!"
                            },
                            {
                                "example_id": "04a3756b-2bfb-49d2-9c42-e80abdac426f",
                                "sense_id": "996c2711-c348-3189-b3d9-8105534e8d28",
                                "text": "C’est être bien indélicat que d’agir ainsi."
                            },
                            {
                                "example_id": "af773365-0897-40f3-9597-f92185d8f2ee",
                                "sense_id": "996c2711-c348-3189-b3d9-8105534e8d28",
                                "text": "Par extension, Ce procédé me semble fort indélicat."
                            }
                        ]
                    }
                ],
                "translations": [
