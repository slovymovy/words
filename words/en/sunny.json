                    "sense_definition": "A sunfish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy was excited to catch a small <w>sunny</w> in the lake.",
                            "target_lang_translations": {
                                "ru": "Мальчик был рад поймать маленького <w>со́лнечного о́куня</w> в озере.",
                                "zh": "那个男孩很兴奋地在湖里抓到了一条小<w>太阳鱼</w>。"
                            }
                        },
                        {
                            "text": "We spent the afternoon fishing for <w>sunnies</w> off the dock.",
                            "target_lang_translations": {
                                "ru": "Мы провели день, ловя <w>со́лнечных окуне́й</w> с причала.",
                                "zh": "我们下午在码头钓<w>太阳鱼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a sunfish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность рыбы (солнечная рыба).",
                        "zh": "一种太阳鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
