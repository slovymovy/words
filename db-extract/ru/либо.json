                            },
                            {
                                "target_word": "or",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                        "entry_id": "0146f72c-f61a-3892-b691-d13a87d85a76",
                                        "glosses": [
                                            "Before; ere. Generally followed by \\\"ever\\\" or \\\"e'er\\\"."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57bd3a7e-968e-4647-b1ea-0a0b0053e6c3",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "Or euer the siluer corde be loosed, or the golden bowle be broken, or the pitcher be broken at the fountaine, or the wheele broken at the cisterne. Then shall the dust returne to the earth as it was: and the spirit shall returne vnto God who gaue it."
                                            },
                                            {
                                                "example_id": "0ef390a2-7938-48dc-bfa1-bff7ff628e39",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "I looked to heaven, and tried to pray;\nBut or ever a prayer had gusht,\nA wicked whisper came, and made\nMy heart as dry as dust."
                                            },
                                            {
                                                "example_id": "7e0a7779-efa6-49a9-bced-e396f6e30564",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "And Time went forth into the worlds to obey the commands of the gods, yet he cast furtive glances at his masters, and the gods distrusted Time because he had known the worlds or ever the gods became."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdbec0ea-e88e-4bb5-bf5d-7998d3aee95a",
                        "source_entry_id": "5413195e-1ad6-3558-977b-4dfad6e6482c",
                        "source_sense_id": "916a6aea-3fa6-3a32-babe-086a02482e19",
                        "target_lang_word": "either",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "either",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "706dd508-9cf3-3006-8ebe-adb9b0e1f4af",
                                        "entry_id": "452126e8-27b7-3341-95b4-c2bbedc54846",
                                        "glosses": [
                                            "Any one (of two)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd0951d4-88f3-4267-81e9-976ac405af63",
                                                "sense_id": "706dd508-9cf3-3006-8ebe-adb9b0e1f4af",
                                                "text": "You can have it in either colour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded1c13b-f1c7-3835-b105-69078b07b68c",
                                        "entry_id": "452126e8-27b7-3341-95b4-c2bbedc54846",
                                        "glosses": [
                                            "Each of two; both."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c057615-5bef-472c-af45-be7169ab6829",
                                                "sense_id": "ded1c13b-f1c7-3835-b105-69078b07b68c",
                                                "text": "There is a locomotive at either end of the train, one pulling and the other pushing."
                                            },
                                            {
                                                "example_id": "437b02c1-aeea-4ac3-9416-a985394b6420",
                                                "sense_id": "ded1c13b-f1c7-3835-b105-69078b07b68c",
                                                "text": "There are roses on either side of the garden."
                                            },
                                            {
                                                "example_id": "50952223-d4af-46e7-a8a3-94789250053e",
                                                "sense_id": "ded1c13b-f1c7-3835-b105-69078b07b68c",
                                                "text": "His flowing hair\n In curls on either cheek played."
                                            },
                                            {
                                                "example_id": "455a6e08-53c2-4383-9fca-99a865e8d81d",
                                                "sense_id": "ded1c13b-f1c7-3835-b105-69078b07b68c",
                                                "text": "Her hands, long and beautiful, lay on either side of her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4e2b35-3dc0-3a5e-a4b8-63118ccf4a50",
                                        "entry_id": "452126e8-27b7-3341-95b4-c2bbedc54846",
                                        "glosses": [
                                            "Any one (of more than two)."
                                        ],
                                        "tags": [
                                            "often",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9f0dbf-b119-40c3-a4e3-47e82c9d44f1",
                                                "sense_id": "ea4e2b35-3dc0-3a5e-a4b8-63118ccf4a50",
                                                "text": "I hope you will be ready to own publicly, whenever you shall be called to it, that by your great and frequent urgency you prevailed on me to publish a very loose and uncorrect account of my travels, with directions to hire some young gentleman of either university to put them in order, and correct the style, as my cousin Dampier did, by my advice, in his book called “A Voyage round the world.”"
                                            },
                                            {
                                                "example_id": "1e006595-7e58-4045-afb5-28c90b86f3f4",
                                                "sense_id": "ea4e2b35-3dc0-3a5e-a4b8-63118ccf4a50",
                                                "text": "They entreat, they pray, they beg, they supplicate (will either of these do, Miss Clary?) that you will make no scruple to go to your uncle Antony's […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "either",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e06770-87c4-3f22-b061-748e35aab2f8",
                                        "entry_id": "0a008d6e-4025-39d6-aa6b-417ed61c86c5",
                                        "glosses": [
                                            "One or the other of two people or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f522b92-1936-4af4-b343-429ec8467800",
                                                "sense_id": "e6e06770-87c4-3f22-b061-748e35aab2f8",
                                                "text": "He made me two offers, but I did not accept either."
                                            },
                                            {
                                                "example_id": "ebfd17c7-4850-46d3-af73-50b0a42a34c7",
                                                "sense_id": "e6e06770-87c4-3f22-b061-748e35aab2f8",
                                                "text": "Hodgson may now have to bring in James Milner on the left and, on that basis, a certain amount of gloss was taken off a night on which Welbeck scored twice but barely celebrated either before leaving the pitch angrily complaining to the Slovakian referee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ffd67a9-06dc-3008-a32f-890bc51f1ec6",
                                        "entry_id": "0a008d6e-4025-39d6-aa6b-417ed61c86c5",
                                        "glosses": [
                                            "Both, each of two or more."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11dccbb9-79a0-4251-8a9f-d246fa631880",
                                                "sense_id": "9ffd67a9-06dc-3008-a32f-890bc51f1ec6",
                                                "text": "Scarce a palm of ground could be gotten by either of the three."
                                            },
                                            {
                                                "example_id": "ad9760e5-433c-40e8-a85c-ead17d32d14a",
                                                "sense_id": "9ffd67a9-06dc-3008-a32f-890bc51f1ec6",
                                                "text": "And either vowd with all their power and wit, / To let not others honour be defaste […]"
                                            },
                                            {
                                                "example_id": "f16c6270-79a8-4946-846d-43f3a819863e",
                                                "sense_id": "9ffd67a9-06dc-3008-a32f-890bc51f1ec6",
                                                "text": "There have been three famous talkers in Great British, either of whom would illustrate what I say about dogmatists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "either",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fafd59-bece-35bd-9200-2350052a92d0",
                                        "entry_id": "a246dea0-ed0f-3fb6-83d3-ddd9cb6eb0ca",
                                        "glosses": [
                                            "As well."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee3aecd4-315f-44b0-b63e-bcf6408c2b21",
                                                "sense_id": "f4fafd59-bece-35bd-9200-2350052a92d0",
                                                "text": "I don't like him, and I don't like her either."
                                            },
                                            {
                                                "example_id": "7112e750-0890-4132-af49-1eef06facb25",
                                                "sense_id": "f4fafd59-bece-35bd-9200-2350052a92d0",
                                                "text": "I know a cheap Spanish restaurant. It's not far from here, either."
                                            },
                                            {
                                                "example_id": "4bbf3bf4-cd60-4ecb-83b4-a153fb0ff39b",
                                                "sense_id": "f4fafd59-bece-35bd-9200-2350052a92d0",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw[…]that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "either",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                        "entry_id": "b0d2a4c5-2816-3f7f-8f91-1842d145ee40",
                                        "glosses": [
                                            "Introduces the first of two (or occasionally more) options or possibilities, the second (or last) of which is introduced by “or”."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b0663e-6e51-47ea-b48b-0e7fc34bf7e0",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "Either you eat your dinner or you go to your room."
                                            },
                                            {
                                                "example_id": "1a78de30-9c16-4c4a-a8c9-aba3384da756",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "You can have either potatoes or rice with that, but not both."
                                            },
                                            {
                                                "example_id": "72287f95-2a1d-450f-9a19-3c28248d6fe8",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "You'll be either early, late, or on time."
                                            },
                                            {
                                                "example_id": "ab288b9c-a0e8-4b45-8992-bc9ce058b37b",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "Either you'll finish your homework or you'll be grounded you home."
                                            },
                                            {
                                                "example_id": "e9fc4c54-71c6-4588-9b90-73d74f0ab236",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "You can't be a table and a chair. You're either a Jew or a gentile."
                                            },
                                            {
                                                "example_id": "1f24e23a-a03b-4cfd-aa3a-f014746078ed",
                                                "sense_id": "1937685b-bd93-3e2e-a703-8376925391cd",
                                                "text": "Thus, when he drew up instructions in lawyer language[…]his clerks[…]understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
