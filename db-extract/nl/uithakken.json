                    },
                    {
                        "translation_id": "1aee0620-4215-4351-ac16-53896ed7b66c",
                        "source_entry_id": "7a142f47-3f08-34d3-bca5-e8f923a9666d",
                        "source_sense_id": "24776089-c963-3142-b7dc-598ef15a6cb0",
                        "target_lang_word": "carve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b5b495-f660-3f33-a016-102636b50dbe",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To cut."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d736a155-59bc-4d56-b717-e4fbc968e11d",
                                                "sense_id": "a8b5b495-f660-3f33-a016-102636b50dbe",
                                                "text": "My good blade carves the casques of men, / My tough lance thrusteth sure, / My strength is as the strength of ten, / Because my heart is pure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4bd01d5-d224-38c7-8b72-dbf4a02cb874",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To cut meat in order to serve it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "578931b5-06b7-4da0-a385-ed9dcd576945",
                                                "sense_id": "e4bd01d5-d224-38c7-8b72-dbf4a02cb874",
                                                "text": "You carve the roast and I’ll serve the vegetables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To shape to sculptural effect; to produce (a work) by cutting, or to cut (a material) into a finished work, especially with cuts that are curved rather than only straight slices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac02ca66-1b9d-4ef9-844f-723364a45572",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "to carve a name into a tree"
                                            },
                                            {
                                                "example_id": "8b741bea-a812-4c9c-9eb4-ce82989f35cd",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "The facades of the buildings fronting upon the avenue within the wall were richly carven[…]."
                                            },
                                            {
                                                "example_id": "3e7838df-6c95-492a-9273-e017402cbc38",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9252d2c-cc69-309c-9a28-4a373fbe5c14",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To perform a series of turns without pivoting, so that the tip and tail of the snowboard take the same path."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To take or make, as by cutting; to provide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e740d73-9c1e-4284-a82b-749d9313895f",
                                                "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                                "text": "[…] who could easily have carved themselves their own food."
                                            },
                                            {
                                                "example_id": "6a5e21f8-5786-406b-bb59-949f1f851739",
                                                "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                                "text": "The Reds carved the first opening of the second period as Glen Johnson's pull-back found David Ngog but the Frenchman hooked wide from six yards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1108f64e-b112-3ad7-a268-867b82287525",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To lay out; to contrive; to design; to plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f3c0e3-12a4-49dc-be75-92e43e787b6e",
                                                "sense_id": "1108f64e-b112-3ad7-a268-867b82287525",
                                                "text": "Lie ten nights awake carving the fashion of a new doublet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                        "entry_id": "154dd4d0-af89-3a4c-b8af-ad11dcf05821",
                                        "glosses": [
                                            "A carucate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71bd15e-8ace-41bd-95a5-c783b71fbdf1",
                                                "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                                "text": "Whereof John de Ditton holds a moiety of the village for half a carve of land."
                                            },
                                            {
                                                "example_id": "5101627c-e074-44ee-82cc-a44ec565ba59",
                                                "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                                "text": "... half a carve of arable land in Ballyncore, one carve of arable land in Pales, a quarter of arable land in Clonnemeagh, half a carve of arable land in Ballyfaden, half a carve of arable land in Ballymadran, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d4422e-fabd-3515-8432-88abb1ba1cd8",
                                        "entry_id": "154dd4d0-af89-3a4c-b8af-ad11dcf05821",
                                        "glosses": [
                                            "The act of carving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420b37e3-8ab3-4ff6-98fa-dd1f3cfe716b",
                                                "sense_id": "29d4422e-fabd-3515-8432-88abb1ba1cd8",
                                                "text": "Give that turkey a careful carve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d002c45a-9c74-4d72-bb1f-f271c349f983",
                        "source_entry_id": "7a142f47-3f08-34d3-bca5-e8f923a9666d",
                        "source_sense_id": "24776089-c963-3142-b7dc-598ef15a6cb0",
                        "target_lang_word": "carve out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carve out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "436a0f27-28e0-360c-8f1a-cb2b51ca1eef",
                                        "entry_id": "9692f15a-10c5-34c3-9c67-f0fc0e85f48b",
                                        "glosses": [
                                            "To hollow by carving."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2a9b3eb-6737-3c9e-9687-98dc0cd8f035",
                                        "entry_id": "9692f15a-10c5-34c3-9c67-f0fc0e85f48b",
                                        "glosses": [
                                            "To create (a reputation, chance, role, rank, career, victory) by hard work, or as if by cutting."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5892779b-b12b-458c-9ea8-6815cd492069",
                                                "sense_id": "b2a9b3eb-6737-3c9e-9687-98dc0cd8f035",
                                                "text": "[Macbeth][…] with his brandished steel […] carved out his passage."
                                            },
                                            {
                                                "example_id": "daf28056-e07d-4862-bdde-96c98c947992",
                                                "sense_id": "b2a9b3eb-6737-3c9e-9687-98dc0cd8f035",
                                                "text": "Fortunes were carved out of the property of the crown."
                                            },
                                            {
                                                "example_id": "7c257499-d03a-448d-8fbb-2fac0366a268",
                                                "sense_id": "b2a9b3eb-6737-3c9e-9687-98dc0cd8f035",
                                                "text": "Our movement's roots are intertwined with the movements for Black civil rights and Black power, movements which carved out the contexts, the language, the emotional, legal and strategic footprints for lesbians and gay men to follow in."
                                            },
                                            {
                                                "example_id": "ca0bb749-4789-47e7-9c4c-c8c057ec2b53",
                                                "sense_id": "b2a9b3eb-6737-3c9e-9687-98dc0cd8f035",
                                                "text": "The hosts went close on several occasions with Victor Obinna and Robbie Keane impressive in the first half, yet they had trouble carving out many clear openings and the defeat leaves them at the bottom of the Premier League on goal difference, two points from safety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03396e99-2e6f-4da4-b477-79f68db63046",
                        "source_entry_id": "7a142f47-3f08-34d3-bca5-e8f923a9666d",
                        "source_sense_id": "24776089-c963-3142-b7dc-598ef15a6cb0",
                        "target_lang_word": "cut out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                        "entry_id": "34837277-a787-3b98-9cc6-bd6980145fb3",
                                        "glosses": [
                                            "Well suited; appropriate; fit for a particular activity or purpose."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c94d12-7880-440f-b1a7-5d27c47b53c2",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "I'm not really cut out for camping outdoors. I'm allergic to mosquito bites."
                                            },
                                            {
                                                "example_id": "7db05aa4-8bfa-487d-8f38-9cd4d96c01f5",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "We've got our work cut out for us."
                                            },
                                            {
                                                "example_id": "df7a5963-3845-4039-830a-3820a0a97530",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "Do you think he is cut out for the role of manager?"
                                            },
                                            {
                                                "example_id": "b7f10ab0-9f74-4437-bf9a-a834cf14f14f",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "I was cut out to be a jazzman the way the righteous are chosen for the church."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cut out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecafdbeb-b7fa-3a82-9349-6bf78f8aa76d",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see cut, out. To separate into parts with or as if with a sharp-edged instrument; sever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04df8b31-0444-4dd8-ae5e-bc855795eb65",
                                                "sense_id": "ecafdbeb-b7fa-3a82-9349-6bf78f8aa76d",
                                                "text": "Cut out the letters and paste them on the poster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To refrain from (doing something, using something etc.), to stop or cease (doing something)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6179f1-b29a-44ca-90ae-c10e9c333592",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "He had to cut out smoking in order to be prepared for the marathon."
                                            },
                                            {
                                                "example_id": "621abda5-6a59-4a81-a306-73f28a44caec",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "She kept clicking her heels. He told her to cut it out."
                                            },
                                            {
                                                "example_id": "28191c3d-f755-4ca9-9ac4-cd63d3252a50",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "Hockey is an exciting and healthful form of exercise, well suited to college students, but if it is to retain favor the intercollegiate league should cut out the muckerism which has attended its contests on the ice in recent years."
                                            },
                                            {
                                                "example_id": "f2f4dded-03f5-41ae-a875-92bb91082f7d",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "“Cut that joshing out,” she said, coolly and briskly. “Who do you think you are talking to? Your check, please. Oh, Lordy!—”"
                                            },
                                            {
                                                "example_id": "2852092b-532b-409a-8a28-0f83e0f4a657",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "I have no wind, if you want to know the truth. I'm quite a heavy smoker, for one thing — that is, I used to be. They made me cut it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To remove; to omit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844352a6-6a39-47b6-a35f-8558920deb70",
                                                "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                                "text": "If we cut out the middle-man, we will both have better profits."
                                            },
                                            {
                                                "example_id": "d26b1841-778d-4485-9d30-e1effaa4633a",
                                                "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                                "text": "Help me find a sharper knife\nI need to cut you out my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9550e715-339e-3e05-8c5c-a7cf6b865c16",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To oust; to replace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628c4036-f566-4156-85e8-6ea7ff91200e",
                                                "sense_id": "9550e715-339e-3e05-8c5c-a7cf6b865c16",
                                                "text": "[…] cut him out in the affections of his lady-love!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "448d9fe1-968b-3749-b930-7bb2371aaf80",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To separate (an animal) from the herd."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f5c4e8-918f-4615-bcc2-83ffbf3886c3",
                                                "sense_id": "448d9fe1-968b-3749-b930-7bb2371aaf80",
                                                "text": "There was little fear that the navigator of the captured Osprey, the man who had lived in Chile and \"cut out\" cattle on the Carrum Plains, would prove lacking in knowledge of riding, seamanship, or Spanish customs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To stop working, to switch off; (of a person on the telephone etc.) to be inaudible, be disconnected."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa70642-d9a5-45ce-be01-cb1fe6ae44e1",
                                                "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                                "text": "It was around then that the engine suddenly cut out."
                                            },
                                            {
                                                "example_id": "7a337a13-11a5-4d7d-8c7c-2c67d72277e5",
                                                "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                                "text": "Can you say that again? You keep cutting out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba639814-8471-3bba-afab-5b393cdda026",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To leave suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e7710a-3ca1-42a5-8330-24c522e30ec8",
                                                "sense_id": "ba639814-8471-3bba-afab-5b393cdda026",
                                                "text": "He must have cut out of the party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81be3766-fa50-35dd-b0a2-e358e78a8dfa",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To arrange or prepare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be382b8-ec34-40a2-9490-24cf8e1ad4cd",
                                                "sense_id": "81be3766-fa50-35dd-b0a2-e358e78a8dfa",
                                                "text": "He has his work cut out for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f87acc18-244d-3b5d-a676-6fc200917a07",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To intercept."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e7194a-d2f4-4c0f-8072-ed8c970f9958",
                                                "sense_id": "f87acc18-244d-3b5d-a676-6fc200917a07",
                                                "text": "As lax as the visitors' defence was, Blackpool's backline was solid. In the first half the Seasiders cut out final balls to Meireles, one of Liverpool's best players, on two occasions and after the break the brilliant Craig Cathcart got enough on his headed clearance to prevent Torres from planting into the net at the far post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc009c5-c8df-3d06-90d4-f5e0caadbe22",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To take a ship out of a harbor etc. by getting between her and the shore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12b3c79b-c443-3616-8412-c14277997849",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To serve time in prison as an alternative to paying fines."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
