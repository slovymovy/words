                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf9940f-9ef0-4647-9bb7-a59985b114ce",
                                "sense_id": "ab3ef48c-3ab6-3f34-8e66-73887169a4c1",
                                "text": "The koshas, which are not based on any specific text, have some unusal properties. They are written in verse and include nouns and indeclinables but not verbs. The words are arranged according to topics. They deal with synonyms and homonyms and were meant for the use of poets. The best-known kosha in Sanskrit is the lexicon prepared by a Buddhist scholar Amarasinha, who was also a poet. This dictionary is usually known as Amarakosha (‘Amara's dictionary’) rather than by its actual name, Namalinganushasana."
                            }
                        ]
                    }
