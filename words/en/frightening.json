{
    "word_family": [
        "fright",
        "frighten",
        "frightened",
        "frightful",
        "frightfully"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b695d3f4-1a50-3534-aa7f-fada5e783730",
                    "sense_definition": "Causing fear or capable of causing fear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fear_causing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Riding the rollercoaster was a <w>frightening</w> experience for the young child.",
                            "target_lang_translations": {
                                "ru": "Катание на американских горках стало <w>пугающим</w> событием для маленького ребенка.",
                                "es": "Montar en la montaña rusa fue una experiencia <w>aterradora</w> para el niño pequeño."
                            }
                        },
                        {
                            "text": "The sudden noise in the dark house was very <w>frightening</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапный шум в темном доме был очень <w>пугающим</w>.",
                                "es": "El ruido repentino en la casa a oscuras fue muy <w>aterrador</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scary",
                        "terrifying",
                        "alarming",
                        "horrifying",
                        "chilling"
                    ],
                    "common_phrases": [
                        "frightening experience",
                        "frightening thought",
                        "frightening prospect",
                        "very frightening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий страх или способный напугать.",
                        "es": "Que causa miedo o es capaz de provocar temor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугающий",
                                "target_lang_sense_clarification": "вызывающий чувство страха или тревоги"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "вызывающий сильный страх"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aterrador",
                                "target_lang_sense_clarification": "que produce miedo o terror intenso"
                            },
                            {
                                "target_lang_word": "alarmante",
                                "target_lang_sense_clarification": "que causa preocupación o inquietud"
                            },
                            {
                                "target_lang_word": "espeluznante",
                                "target_lang_sense_clarification": "que da mucho miedo o causa escalofríos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41536165-ea95-3ec3-b9d1-83acf85e2abd",
                    "sense_definition": "Extremely bad, unpleasant, or intense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cost of living in the city has reached a <w>frightening</w> level.",
                            "target_lang_translations": {
                                "ru": "Стоимость жизни в городе достигла <w>пугающего</w> уровня.",
                                "es": "El coste de la vida en la ciudad ha alcanzado un nivel <w>alarmante</w>."
                            }
                        },
                        {
                            "text": "He made a <w>frightening</w> mess in the kitchen while cooking dinner.",
                            "target_lang_translations": {
                                "ru": "Он устроил <w>страшный</w> беспорядок на кухне, пока готовил ужин.",
                                "es": "Hizo un desastre <w>terrible</w> en la cocina mientras preparaba la cena."
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "terrible",
                        "dreadful",
                        "horrible"
                    ],
                    "common_phrases": [
                        "frightening mess",
                        "frightening cost",
                        "frightening speed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an intensifier for negative things"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, неприятный или сильный (используется для усиления).",
                        "es": "Extremadamente malo, desagradable o intenso (usado como intensificador)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой или неприятный"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "чрезвычайный, сильный (разговорное)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "terrible",
                                "target_lang_sense_clarification": "extremadamente malo, desastroso o severo"
                            },
                            {
                                "target_lang_word": "espantoso",
                                "target_lang_sense_clarification": "enorme o sumamente desagradable"
                            },
                            {
                                "target_lang_word": "descomunal",
                                "target_lang_sense_clarification": "extraordinariamente grande o intenso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c77c4f77-1da7-3892-a6af-298a36209a16",
                    "sense_definition": "Present participle and gerund of <w>frighten</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_scaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist was <w>frightening</w> the timid children with his strange experiment.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>пугал</w> робких детей своим странным экспериментом.",
                                "es": "El científico estaba <w>asustando</w> a los niños tímidos con su extraño experimento."
                            }
                        },
                        {
                            "text": "She succeeded in <w>frightening</w> the birds away from the garden.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>отпугнуть</w> птиц из сада.",
                                "es": "Logró <w>ahuyentar</w> a los pájaros del jardín."
                            }
                        }
                    ],
                    "synonyms": [
                        "scaring",
                        "terrifying",
                        "alarming"
                    ],
                    "common_phrases": [
                        "frightening away",
                        "frightening off"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола frighten (пугать).",
                        "es": "Participio de presente o gerundio de frighten (asustar o atemorizar)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "пугая",
                                "target_lang_sense_clarification": "деепричастие"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asustando",
                                "target_lang_sense_clarification": "gerundio del verbo asustar"
                            },
                            {
                                "target_lang_word": "atemorizando",
                                "target_lang_sense_clarification": "gerundio del verbo atemorizar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
