                    {
                        "sense_id": "5ba94fdd-b99b-3f2f-b76c-ad263709b68a",
                        "entry_id": "245bbbdd-6856-3425-81c8-147d7b6ca8e7",
                        "glosses": [
                            "Teilgebiet der Grammatik, speziell der Morphologie (Morphemik), das sich mit den Flexionsformen befasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68053d93-1a41-42c0-a8cd-a2e8ca5895bb",
                                "sense_id": "5ba94fdd-b99b-3f2f-b76c-ad263709b68a",
                                "text": "Die Formenlehre des Deutschen umfasst die Flexionsformen der Deklination, Komparation und Konjugation."
                            },
                            {
                                "example_id": "1b6f44c9-5d99-4367-9143-db9ee717fd53",
                                "sense_id": "5ba94fdd-b99b-3f2f-b76c-ad263709b68a",
                                "text": "„Nach traditioneller Auffassung beschreibt die Morphemik die Arten und Formen der Wörter (…). Sie wird auch als Wortartenlehre, Wortlehre, Formenlehre oder Flexionslehre bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
