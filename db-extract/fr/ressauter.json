                ],
                "senses": [
                    {
                        "sense_id": "a89b656f-7501-3cd0-b760-546fe193b760",
                        "entry_id": "199245a5-c496-31c2-a65c-2b8b38d92e76",
                        "glosses": [
                            "Sauter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e367e70e-ce21-42a5-9e1b-7c3a484a8520",
                                "sense_id": "a89b656f-7501-3cd0-b760-546fe193b760",
                                "text": "La forme blanche saute et ressaute dans la nuit : comme pour dire à l’oreille."
                            },
                            {
                                "example_id": "c83afed8-9b85-47c4-9328-cfc356b7d164",
                                "sense_id": "a89b656f-7501-3cd0-b760-546fe193b760",
                                "text": "Nous sautons et ressautons un ruisseau qui s’empêtre dans nos jambes comme une bande molletière défaite."
                            },
                            {
                                "example_id": "1f089bd5-fd59-436a-9a8e-13f68769a7d5",
                                "sense_id": "a89b656f-7501-3cd0-b760-546fe193b760",
                                "text": "Il n’eut pas plutôt dit cela, que la clochette sauta et ressauta, et que je vis arriver sur lui un petit cheval maigre, tout hérissonné, qui avait des yeux comme des charbons ardents, et, au cou, une sonnette reluisante comme de l’or. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 57)"
                            }
                        ]
                    },
                    {
                        "sense_id": "4509c0e4-fa9e-3ba1-b28c-ba9213a2a141",
                        "entry_id": "199245a5-c496-31c2-a65c-2b8b38d92e76",
                        "glosses": [
                            "Faire un ressaut, en parlant de parties d'une construction."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "893590d0-8bc2-43e7-a0c6-89c3f23d96ce",
                                "sense_id": "4509c0e4-fa9e-3ba1-b28c-ba9213a2a141",
                                "text": "Entablement, corniche qui ressaute."
                            }
                        ]
                    }
