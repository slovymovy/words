{
    "word_family": [
        "tip",
        "tipper",
        "tiptop"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0658f548-5da2-3e1a-b904-a37cc81939be",
                    "sense_definition": "een fooi geven aan iemand voor een verleende dienst",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fooi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als de service in het restaurant uitstekend is, <w>tip</w> ik meestal tien procent.",
                            "target_lang_translations": {
                                "en": "If the service in the restaurant is excellent, I usually <w>tip</w> ten percent."
                            }
                        },
                        {
                            "text": "In sommige landen is het heel gebruikelijk om de ober royaal te <w>tippen</w>.",
                            "target_lang_translations": {
                                "en": "In some countries, it is very customary to <w>tip</w> the waiter generously."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de ober tippen",
                        "royaal tippen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give a tip or gratuity to someone for a service rendered"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tip",
                                "target_lang_sense_clarification": "to give a gratuity"
                            },
                            {
                                "target_lang_word": "give a tip",
                                "target_lang_sense_clarification": "to leave a gratuity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99c71077-4fa3-3051-810b-335d2e94ff9a",
                    "sense_definition": "nuttige of geheime informatie, advies of een hint geven aan iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een bezorgde buurman besloot meteen de politie te <w>tippen</w> over de verdachte situatie.",
                            "target_lang_translations": {
                                "en": "A concerned neighbour decided to <w>tip off</w> the police immediately about the suspicious situation."
                            }
                        },
                        {
                            "text": "Mijn collega <w>tipte</w> mij over een interessante vacature bij een ander bedrijf.",
                            "target_lang_translations": {
                                "en": "My colleague <w>tipped</w> me <w>off</w> about an interesting job opening at another company."
                            }
                        }
                    ],
                    "synonyms": [
                        "inlichten",
                        "waarschuwen"
                    ],
                    "common_phrases": [
                        "de politie tippen"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide useful or confidential information, advice, or a hint to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tip off",
                                "target_lang_sense_clarification": "to alert or inform secretly"
                            },
                            {
                                "target_lang_word": "tip",
                                "target_lang_sense_clarification": "to give useful information or a hint to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f636a5-7817-3b7d-877f-c49e982118ec",
                    "sense_definition": "dezelfde kwaliteit of hetzelfde niveau bereiken als iets of iemand anders; evenaren (vrijwel altijd met 'aan' en in ontkennende zin)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergelijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn nieuwe restaurant is aardig, maar kan niet <w>tippen</w> aan de kwaliteit van het oude.",
                            "target_lang_translations": {
                                "en": "His new restaurant is nice, but it cannot <w>match</w> the quality of the old one."
                            }
                        },
                        {
                            "text": "Geen enkele andere hardloper kan dit seizoen aan haar toptijd <w>tippen</w>.",
                            "target_lang_translations": {
                                "en": "No other runner can <w>come close to</w> her top time this season."
                            }
                        }
                    ],
                    "synonyms": [
                        "evenaren"
                    ],
                    "common_phrases": [
                        "kunnen tippen aan",
                        "niet kunnen tippen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to match, equal, or reach the same level of quality as someone or something else (almost always used with 'aan' in negative contexts)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "match",
                                "target_lang_sense_clarification": "to equal in quality"
                            },
                            {
                                "target_lang_word": "compare to",
                                "target_lang_sense_clarification": "to be in the same league as"
                            },
                            {
                                "target_lang_word": "hold a candle to",
                                "target_lang_sense_clarification": "idiomatic, in negative contexts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7d0bed8-d75a-391b-8408-8fe6038e0388",
                    "sense_definition": "iemand noemen of aanwijzen als de vermoedelijke winnaar of favoriet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voorspellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vrijwel alle sportjournalisten <w>tipten</w> hem vooraf als de grote winnaar van de etappe.",
                            "target_lang_translations": {
                                "en": "Virtually all sports journalists <w>tipped</w> him beforehand as the big winner of the stage."
                            }
                        },
                        {
                            "text": "Zij werd door de jury al vroeg <w>getipt</w> als favoriet voor de prestigieuze prijs.",
                            "target_lang_translations": {
                                "en": "She was <w>tipped</w> early on by the jury as the favourite for the prestigious award."
                            }
                        }
                    ],
                    "common_phrases": [
                        "getipt als favoriet",
                        "getipt als winnaar"
                    ],
                    "target_lang_definitions": {
                        "en": "to name or designate someone as the likely winner or favourite"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tip",
                                "target_lang_sense_clarification": "to predict or pick as winner"
                            },
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "to favour as the likely winner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd7dc1f-ee5d-3245-9f73-df1ec01e3dad",
                    "sense_definition": "iets heel even of met een korte, lichte beweging aanraken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij hield de sigaar rustig vast en <w>tipte</w> de as voorzichtig in de asbak.",
                            "target_lang_translations": {
                                "en": "He calmly held the cigar and gently <w>flicked</w> the ash into the ashtray."
                            }
                        },
                        {
                            "text": "Met het puntje van haar vinger <w>tipte</w> ze even aan het koude glas.",
                            "target_lang_translations": {
                                "en": "With the tip of her finger, she briefly <w>tapped</w> the cold glass."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to touch something briefly or with a light, short tap"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tap",
                                "target_lang_sense_clarification": "to touch lightly"
                            },
                            {
                                "target_lang_word": "flick",
                                "target_lang_sense_clarification": "e.g. ash off a cigar"
                            },
                            {
                                "target_lang_word": "touch lightly",
                                "target_lang_sense_clarification": "to touch gently"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d795d1bf-682d-3842-9bd9-2127bb9ed8d3",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>tip</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze website vind je handige <w>tippen</w> om energie te besparen in huis.",
                            "target_lang_translations": {
                                "en": "On this website you will find handy <w>tips</w> to save energy at home."
                            }
                        },
                        {
                            "text": "De politie kreeg tientallen nuttige <w>tippen</w> binnen na de uitzending op televisie.",
                            "target_lang_translations": {
                                "en": "The police received dozens of useful <w>tips</w> after the television broadcast."
                            }
                        }
                    ],
                    "synonyms": [
                        "tips"
                    ],
                    "common_phrases": [
                        "handige tippen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "In Nederland is 'tips' gangbaarder; 'tippen' komt vooral voor in Vlaanderen of informele spreektaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'tip' (pieces of advice, hints, or gratuities)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tips",
                                "target_lang_sense_clarification": "pieces of advice or hints"
                            },
                            {
                                "target_lang_word": "hints",
                                "target_lang_sense_clarification": "helpful suggestions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}