                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8e7ab5-dc7f-4853-a2bc-9f7fc81dce28",
                                "sense_id": "850aeb76-cdbf-3759-ba38-b81183afa63a",
                                "text": "Dała się poznać jako bezkompromisowa komentatorka polskiej rzeczywistości"
