                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42167614-643e-4383-88dd-6ad857d8fd94",
                                                "sense_id": "ac8c8b7f-2077-3007-b8c6-b61dcb968086",
                                                "text": "Der Jemen hat durch zahlreiche Entführungen traurige Berühmtheit erlangt."
                                            },
                                            {
                                                "example_id": "979a503b-6af4-4a1e-af55-c8fd3f5268f3",
                                                "sense_id": "ac8c8b7f-2077-3007-b8c6-b61dcb968086",
                                                "text": "Sanaa ist die Hauptstadt von Jemen."
                                            },
                                            {
                                                "example_id": "c6c6387d-84af-4f50-9227-ac030b93e86d",
                                                "sense_id": "ac8c8b7f-2077-3007-b8c6-b61dcb968086",
                                                "text": "Im Jemen leben rund 22 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "a32e578b-f13d-4073-935d-cebfb7e408d9",
                                                "sense_id": "ac8c8b7f-2077-3007-b8c6-b61dcb968086",
                                                "text": "„Im Jemen gibt es immer wieder Entführung westlicher Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
