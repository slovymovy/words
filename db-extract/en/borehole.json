                        "tags": [
                            "plural"
                        ],
                        "form": "boreholes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                        "entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                        "glosses": [
                            "A hole bored into the ground to collect samples for analysis or to extract oil or water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d2bb00-ae85-409d-8118-e99a3e4a8deb",
                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                "text": "Near-synonym: well"
                            },
                            {
                                "example_id": "b9b963b4-f02c-46af-98d4-15a95ebc3b99",
                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                "text": "The state of the groundwater is monitored at various boreholes in the area."
                            },
                            {
                                "example_id": "5e0ff919-1fa1-40e3-9793-addab1258de3",
                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                "text": "Extensive borehole information and tendered contract prices make these cost estimates much more plausible than earlier estimates."
                            }
                        ]
                    },
                    {
                        "sense_id": "e02e48b2-5015-36dd-8cb6-6d1cedb39a43",
                        "entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                        "glosses": [
                            "Any other hole that has been bored into something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a39d59a-2bb5-48a3-afc6-9ec0fec46d3d",
                                "sense_id": "e02e48b2-5015-36dd-8cb6-6d1cedb39a43",
                                "text": "There were little boreholes in the oak beam, indicating that insects had once taken some interest in it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d524891d-1b8d-43a4-bf94-12e88001d9db",
                        "source_entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                        "source_sense_description": "hole bored into the ground",
                        "target_lang_word": "otwór wiertniczy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9cff7860-f108-45b6-822d-0ae00650fcd9",
                        "source_entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                        "source_sense_description": "hole bored into the ground",
                        "target_lang_word": "сква́жина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сква́жина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "52e70fd8-a4bc-370d-8064-f8ad191a3bff",
                                        "entry_id": "3642036d-362b-3ddf-9180-16ca82c8c8ca",
                                        "glosses": [
                                            "узкое отверстие в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782923ae-eb8b-4536-b729-71add685a185",
                                                "sense_id": "52e70fd8-a4bc-370d-8064-f8ad191a3bff",
                                                "text": "Ведь я в замочную скважину видел: ты сложа руки сидел…"
                                            },
                                            {
                                                "example_id": "e64d1ff0-ced7-45e3-8b68-352613cac384",
                                                "sense_id": "52e70fd8-a4bc-370d-8064-f8ad191a3bff",
                                                "text": "Сухой тростник он срезал // И скважины проткнул, // Один конец зажал он, // В другой конец подул."
                                            },
                                            {
                                                "example_id": "65b0ac38-36cd-44c9-851a-94e6ed352371",
                                                "sense_id": "52e70fd8-a4bc-370d-8064-f8ad191a3bff",
                                                "text": "Размышления его прерваны были светом, блеснувшим сквозь все скважины дверей, который дал знать, что свеча в передней уже зажжена Иваном."
                                            },
                                            {
                                                "example_id": "702567b4-3d50-47ec-ada3-cf1267473f26",
                                                "sense_id": "52e70fd8-a4bc-370d-8064-f8ad191a3bff",
                                                "text": "Около первого окна, с опущенной на солнце небеленой холстинной старой, сквозь скважины которой яркое солнце кладёт на всё, что ни попадется, такие блестящие огненные кружки, что глазам больно смотреть на них, стоят пяльцы, по белому полотну которых тихо гуляют мухи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0738c9dd-cf17-3a0b-a853-4a5b2cdc0a35",
                                        "entry_id": "3642036d-362b-3ddf-9180-16ca82c8c8ca",
                                        "glosses": [
                                            "горн. нефтегаз. выработка круглого сечения, пробурённая с поверхности земли или с подземной выработки без доступа человека."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
