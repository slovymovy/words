{
    "word_family": [
        "verzaking",
        "verzaakster"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d070fe1-7642-33da-b1dd-04b555cb1b98",
                    "sense_definition": "het niet nakomen van een plicht of belofte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kon het niet over zijn hart verkrijgen om zijn plicht te <w>verzaken</w>.",
                            "target_lang_translations": {
                                "en": "He couldn't bring himself to <w>neglect</w> his duty."
                            }
                        },
                        {
                            "text": "Zij zal nooit haar verantwoordelijkheid <w>verzaken</w> als het erop aankomt.",
                            "target_lang_translations": {
                                "en": "She will never <w>fail in</w> her responsibility when it matters."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzuimen",
                        "verloochenen",
                        "nalaten"
                    ],
                    "antonyms": [
                        "nakomen",
                        "vervullen"
                    ],
                    "common_phrases": [
                        "plicht verzaken",
                        "verantwoordelijkheid verzaken"
                    ],
                    "target_lang_definitions": {
                        "en": "failing to fulfill a duty, promise, or obligation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "neglect",
                                "target_lang_sense_clarification": "to fail to carry out a duty or responsibility"
                            },
                            {
                                "target_lang_word": "fail in",
                                "target_lang_sense_clarification": "to not perform as expected regarding a duty"
                            },
                            {
                                "target_lang_word": "shirk",
                                "target_lang_sense_clarification": "to avoid or neglect a responsibility"
                            },
                            {
                                "target_lang_word": "default on",
                                "target_lang_sense_clarification": "to fail to fulfill a formal obligation or promise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea42808b-ffc6-3e6c-a6ea-926c33491855",
                    "sense_definition": "vrijwillig afstand doen van iets, zoals een geloof of een recht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ridder moest zijn geloof <w>verzaken</w> om in leven te blijven.",
                            "target_lang_translations": {
                                "en": "The knight had to <w>renounce</w> his faith to stay alive."
                            }
                        },
                        {
                            "text": "Hij besloot de wereld te <w>verzaken</w> en in een klooster te gaan wonen.",
                            "target_lang_translations": {
                                "en": "He decided to <w>forsake</w> the world and go live in a monastery."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzweren",
                        "verloochenen",
                        "prijsgeven"
                    ],
                    "antonyms": [
                        "aanhangen",
                        "belijden"
                    ],
                    "common_phrases": [
                        "geloof verzaken",
                        "wereld verzaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "voluntarily renouncing or giving up something, such as a faith, belief, or right"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "renounce",
                                "target_lang_sense_clarification": "to formally declare one's abandonment of a right or belief"
                            },
                            {
                                "target_lang_word": "forsake",
                                "target_lang_sense_clarification": "to abandon or give up something valued"
                            },
                            {
                                "target_lang_word": "abjure",
                                "target_lang_sense_clarification": "to solemnly renounce a belief or cause"
                            },
                            {
                                "target_lang_word": "relinquish",
                                "target_lang_sense_clarification": "to voluntarily cease to keep or claim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdfafc41-3cab-33d0-9cd7-eb6fc6ba4b16",
                    "sense_definition": "bij een kaartspel een gevraagde kleur niet bekennen terwijl men die wel heeft",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "kaartspel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat hij per ongeluk een ruiten speelde in plaats van een harten, zat hij te <w>verzaken</w>.",
                            "target_lang_translations": {
                                "en": "Because he accidentally played a diamond instead of a heart, he was <w>revoking</w>."
                            }
                        },
                        {
                            "text": "Als je bij bridge gaat <w>verzaken</w>, krijg je vaak een flinke straf.",
                            "target_lang_translations": {
                                "en": "If you <w>renege</w> in bridge, you often get a heavy penalty."
                            }
                        }
                    ],
                    "synonyms": [
                        "niet-bekennen"
                    ],
                    "antonyms": [
                        "bekennen"
                    ],
                    "common_phrases": [
                        "kleur verzaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specifiek voor kaartspelen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "in a card game, failing to follow suit when one is able to do so"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revoke",
                                "target_lang_sense_clarification": "to fail to follow suit in a card game"
                            },
                            {
                                "target_lang_word": "renege",
                                "target_lang_sense_clarification": "to fail to follow suit in a card game (common in US)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}