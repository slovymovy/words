                        "glosses": [
                            "A chief or transcendent traitor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68500517-87f8-4929-9118-2fb8aab51a9f",
                                "sense_id": "412096e3-ad47-3a74-a5ee-5f2811285ba9",
                                "text": "[…] that caitiffe Cardinall, and English Arch-traitor, from his Cannon of corrupt conceipt dischargeth two seditious Libels against his Souereign:"
                            },
                            {
                                "example_id": "0ec1d8ad-552c-4d23-8150-319c90d85e97",
                                "sense_id": "412096e3-ad47-3a74-a5ee-5f2811285ba9",
                                "text": "1754, Isaac Watts, Remnants of Time, Employed in Prose and Verse, in The Posthumous Works of the Late Reverend Dr. Isaac Watts, London: T. and T. Longman et al., p. 276,\nHe [Jesus] led Satan the Arch-Traitor bound at his Chariot Wheels […]"
                            },
                            {
                                "example_id": "20f48ca4-4647-4dcf-a985-87cd23e04f9e",
                                "sense_id": "412096e3-ad47-3a74-a5ee-5f2811285ba9",
                                "text": "Myself, arch-traitor to myself;\nMy hollowest friend, my deadliest foe,\nMy clog whatever road I go."
                            },
                            {
                                "example_id": "b7791145-a9cf-4586-bc97-6e0f2c4ae45c",
                                "sense_id": "412096e3-ad47-3a74-a5ee-5f2811285ba9",
                                "text": "In the furious battle over the 1906 Pure Food Law, he [Henry J. Heinz] was a hero to reformers and, to many of his fellow food processors, an archtraitor."
                            }
                        ]
                    }
