{
    "word_family": [
        "wind",
        "waaien",
        "windvlaag",
        "windstil"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf513aa8-e9b3-33b0-8d33-f0dd08daa34f",
                    "sense_definition": "Zich opfrissen door in de buitenlucht of wind te wandelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange werkweek ga ik graag even <w>uitwaaien</w> aan het strand.",
                            "target_lang_translations": {
                                "zh": "忙碌了一周后，我喜欢去海边<w>吹吹风</w>。"
                            }
                        },
                        {
                            "text": "Het is heerlijk weer om in het bos te gaan <w>uitwaaien</w>.",
                            "target_lang_translations": {
                                "zh": "天气很好，适合去森林里<w>透透气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frisse neus halen"
                    ],
                    "common_phrases": [
                        "lekker uitwaaien"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过在户外或风中散步来放松身心、呼吸新鲜空气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吹风",
                                "target_lang_sense_clarification": "指到户外散步以放松心情。"
                            },
                            {
                                "target_lang_word": "透气",
                                "target_lang_sense_clarification": "指到户外呼吸新鲜空气以缓解压力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbe078fb-9800-321c-ac39-acf63118e217",
                    "sense_definition": "Door de wind gedoofd worden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "doven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kaars is door de tocht <w>uitgewaaid</w>.",
                            "target_lang_translations": {
                                "zh": "蜡烛被穿堂风<w>吹灭</w>了。"
                            }
                        },
                        {
                            "text": "Het vuur was snel <w>uitgewaaid</w> door de harde wind.",
                            "target_lang_translations": {
                                "zh": "大火被强风迅速<w>吹灭</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指火苗或灯火被风吹灭。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吹灭",
                                "target_lang_sense_clarification": "指火源因风而熄灭。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd07b49-572b-3934-b127-0d0823b48433",
                    "sense_definition": "Zich in de wind ontplooien of wapperen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wapperen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vlag liet zich prachtig <w>uitwaaien</w> in de sterke zeewind.",
                            "target_lang_translations": {
                                "zh": "旗帜在强劲的海风中优美地<w>飘扬</w>。"
                            }
                        },
                        {
                            "text": "De gordijnen <w>waaiden</w> vrolijk <w>uit</w> door het open raam.",
                            "target_lang_translations": {
                                "zh": "窗帘随风从打开的窗户向外<w>飘动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wapperen"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体在风中展开或飘动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "飘扬",
                                "target_lang_sense_clarification": "指旗帜等在风中展开飘动。"
                            },
                            {
                                "target_lang_word": "飘动",
                                "target_lang_sense_clarification": "指窗帘等随风摆动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}