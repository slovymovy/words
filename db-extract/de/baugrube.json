                ],
                "senses": [
                    {
                        "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                        "entry_id": "05368f4f-f6fd-30bd-8fa9-a89cbd2f754e",
                        "glosses": [
                            "Raum unterhalb der Geländeoberfläche, dem im Untergrund gelegenen Teil einer zu errichtenden baulichen Anlage sowie den seitlichen Arbeitsräume und der Baugrubensicherung Platz bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e284e9-2609-4b60-8a7e-10e6ccad31c3",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "„Spezialtiefbauer […] sichern Baugruben, erstellen tragfähige Fundamente für Bauwerke und bringen Pfähle zur Stabilisierung ins Erdreich ein.“"
                            },
                            {
                                "example_id": "e0e2b7ff-ac61-4607-9ab5-2c31ca219abf",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "Endlich war die Baugrube abgenommen und das Fundament konnte in ihren Grund gegossen werden."
                            },
                            {
                                "example_id": "1e093847-b5ea-443a-b776-3977dc8be042",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "Am 5. Januar 1889 wurde mit dem Bau der Ostseeschleusen dadurch begonnen, dass die Baugrube bis + 13,77[1]) d.h. bis 6 m (19,68' engl.) unter Mittelwasser-Ostsee ausgehoben und mit Deichen umgeben wurde, welche einen sicheren Abschluss gegen die Sturmfluthen der Ostsee gewähren."
                            },
                            {
                                "example_id": "c21c591a-e01b-43ab-be43-06a9befb0362",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "„Als ich vor vielen Jahren zum ersten Mal nach Berlin gekommen war, hatte ich schon überall die gleichen Baukräne und Baugruben gesehen.“"
                            },
                            {
                                "example_id": "30c602bf-8067-40bc-8fd5-ad3579feec96",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "„Eine 32-jährige Frau fuhr mit ihrem Auto in eine Baugrube, in der zu diesem Zeitpunkt ein Arbeiter tätig war.“"
                            },
                            {
                                "example_id": "d4e6876e-dcb4-4f9a-bb03-5a7611df33e7",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "„Etwa 30 Feuerwehrleute […] mussten einen Arbeiter aus einer Baugrube befreien, der bis zur Brust im kalten, nassen Sand steckte.“"
                            },
                            {
                                "example_id": "526f8743-e9ae-47d1-a606-644d40f318ac",
                                "sense_id": "eb9ef0ed-5bab-37aa-a942-8a748627f703",
                                "text": "„Die Roche baut neue Laborgebäude im Wettsteinquartier. In der Baugrube finden wird fast täglich gesprengt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
