                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1398a130-380c-35bb-8c72-49a6476e1510",
                        "entry_id": "bdf7df97-e042-346b-bd81-35ec4add8686",
                        "glosses": [
                            "Titre équivalent à celui de patriarche porté par des dignitaires de plusieurs Églises chrétiennes orthodoxes orientales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df8fef9-2717-42a5-84d6-fe482a4b4189",
                                "sense_id": "1398a130-380c-35bb-8c72-49a6476e1510",
                                "text": "Cette structure hiérarchique était encore intacte lorsque les évêques de ces diocèses rencontrèrent le catholicos Georges Iᵉʳ en 676."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67fc367a-a15b-4405-a1e2-ef4bf6ff77a8",
                        "source_entry_id": "bdf7df97-e042-346b-bd81-35ec4add8686",
                        "source_sense_id": "1398a130-380c-35bb-8c72-49a6476e1510",
                        "target_lang_word": "catholicos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catholicos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52a00930-f4b8-32a2-a9a1-958608fd15c9",
                                        "entry_id": "1657a66d-d909-3d44-a21d-decacb534274",
                                        "glosses": [
                                            "A high-ranking bishop or patriarch in certain Eastern Christian traditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17157a85-50ec-4f67-b132-b8748b0a201e",
                                                "sense_id": "52a00930-f4b8-32a2-a9a1-958608fd15c9",
                                                "text": "Kavad had quickly ordered that a new Catholicos should be chosen for the Church, ending a hiatus of twenty years in which Shah Khusrau had prevented the office being filled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7292f98d-c585-429a-ab18-187cd05cbe44",
                        "source_entry_id": "bdf7df97-e042-346b-bd81-35ec4add8686",
                        "source_sense_id": "1398a130-380c-35bb-8c72-49a6476e1510",
                        "target_lang_word": "καθολικός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "καθολικός",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "e6c0d66e-6901-3539-8494-1b496793f7c6",
                                        "entry_id": "f8a99f2e-f2c3-3c5d-b6f4-9a106f870348",
                                        "glosses": [
                                            "που αναφέρεται σε ή περιλαμβάνει όλα τα μέλη ενός συνόλου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa36ae20-6ca9-4d9c-8692-1def714fa653",
                                                "sense_id": "e6c0d66e-6901-3539-8494-1b496793f7c6",
                                                "text": "Η καθολική αντίσταση του λαού απέναντι στον κατακτητή..."
                                            },
                                            {
                                                "example_id": "27058838-21ec-4b58-92f8-32578d337f8f",
                                                "sense_id": "e6c0d66e-6901-3539-8494-1b496793f7c6",
                                                "text": "※ Ο δήμαρχος και οι δημοτικοί σύμβουλοι, οι σύμβουλοι της δημοτικής ή τοπικής κοινότητας και οι εκπρόσωποι της τοπικής κοινότητας εκλέγονται κάθε πέντε (5) χρόνια με άμεση, καθολική και μυστική ψηφοφορία. (Νόμος 3852/2010, Νέα Αρχιτεκτονική της Αυτοδιοίκησης και της Αποκεντρωμένης Διοίκησης − Πρόγραμμα Καλλικράτης, ΦΕΚ A 87 - 07.06.2010)"
                                            },
                                            {
                                                "example_id": "bc57fea5-809a-4980-9721-c0db332652a0",
                                                "sense_id": "e6c0d66e-6901-3539-8494-1b496793f7c6",
                                                "text": "※ Μόνο όταν η Βασιλεύουσα, παρά την ηρωική αντίσταση των ολιγάριθμων υπερασπιστών της, υπό την ηγεσία του αυτοκράτορα-μάρτυρα Κωνσταντίνου ΙΑ' Παλαιολόγου, και των ευάριθμων συμμάχων της υπό τον Γενοβέζο Τζουστινιάνι, ελύγισε υπό τα πλήγματα του τεράστιου σε αριθμό στρατού και στόλου του νεαρού σουλτάνου Μωάμεθ Β', μόνο τότε η Δύση θα κατανοήσει το μέγεθος της καταστροφής και της απειλής κατά της καθολικής τώρα χριστιανοσύνης. (Ελένη Γλύκατζη - Αρβελέρ, Γιατί το Βυζάντιο, σελ. 53)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e3f2d3c-a41f-3c97-8a72-4e7e02ef9d97",
                                        "entry_id": "f8a99f2e-f2c3-3c5d-b6f4-9a106f870348",
                                        "glosses": [
                                            "σχετικός με τον καθολικισμό"
                                        ],
                                        "tags": [
                                            "εκκλησιαστικός όρος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb53007-f01a-4764-bed1-eb59f3d3bd98",
                                                "sense_id": "8e3f2d3c-a41f-3c97-8a72-4e7e02ef9d97",
                                                "text": "η Καθολική Εκκλησία, το καθολικό δόγμα"
                                            },
                                            {
                                                "example_id": "1424ab0d-e0d0-402a-8776-5ffa06c4d53d",
                                                "sense_id": "8e3f2d3c-a41f-3c97-8a72-4e7e02ef9d97",
                                                "text": "και με θηλυκό καθολικιά στον προφορικό λόγο"
                                            }
