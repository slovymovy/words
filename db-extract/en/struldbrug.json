                "senses": [
                    {
                        "sense_id": "2737f98d-0c0f-371f-b647-022575e9664d",
                        "entry_id": "05eb2718-0951-321b-be87-607ebc173490",
                        "glosses": [
                            "Someone or something that is immortal or extremely ancient, but which may have persisted past the point where it should be dead."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dafcb16e-141c-4cee-922f-2905142327b8",
                                "sense_id": "2737f98d-0c0f-371f-b647-022575e9664d",
                                "text": "It might be thought a precedent, and he would not like it; he who is to inherit the place when that old Struldbrug, Gotham, is withered and cast away, when that old log is so barnacle-bored as to be worthless."
                            },
                            {
                                "example_id": "8b667a9f-b17f-4b86-b3a1-926fedf51826",
                                "sense_id": "2737f98d-0c0f-371f-b647-022575e9664d",
                                "text": "Antique memorial, exiled to Egypt's shame, Forlorn Struldbrug! why should we covet thee?"
                            },
                            {
                                "example_id": "9318f092-7cb6-4a0b-b1a7-44bc9db765bb",
                                "sense_id": "2737f98d-0c0f-371f-b647-022575e9664d",
                                "text": "To me he is, like the greater number of classics in all ages and countries, a literary Struldbrug, rather than a true ambrosia-fed immortal."
                            },
                            {
                                "example_id": "0557dc86-0fd3-46a3-9daf-c9c1f0dcc994",
                                "sense_id": "2737f98d-0c0f-371f-b647-022575e9664d",
                                "text": "Apparently immortal, an anthropoid and vital Struldbrug, the Earl, 201 years old, is a red-haired naked beast, his forehead jutting out like a shelf."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
