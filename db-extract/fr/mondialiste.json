        "fr-extract.jsonl": [
            {
                "entry_id": "0c9f721d-ec70-3fd1-9ffd-0991979d9849",
                "word": "mondialiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef9a729e-8c5c-4b98-b58c-2352c46e8f9d",
                        "entry_id": "0c9f721d-ec70-3fd1-9ffd-0991979d9849",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mondialistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                        "entry_id": "0c9f721d-ec70-3fd1-9ffd-0991979d9849",
                        "glosses": [
                            "Relatif à la doctrine du mondialisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a683ac7-3d67-4a14-b1f4-dbd37aa61e5c",
                                "sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                                "text": "… l’accent mis sur le progrès des pays attardés ne correspond qu’à la priorité actuelle désignée par une stratégie authentiquement mondialiste."
                            },
                            {
                                "example_id": "0b949977-d962-426b-a84b-4e9b0e1f3cf6",
                                "sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                                "text": "Mais, je milite surtout pour que l’on instaure un jour un gouvernement mondialiste, qui administrera les problèmes à l’échelle de la planéte."
                            },
                            {
                                "example_id": "a2d6c160-f904-49cf-b598-e95248534fd0",
                                "sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                                "text": "La théorie du complot mondialiste et l’imaginaire conspirationniste qui l’anime traversent les pays, les périodes, les groupes et les partis politiques."
                            },
                            {
                                "example_id": "09d10bc9-0035-4561-a4bc-764fbd98b7a2",
                                "sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                                "text": "Ambre rétorquait qu’en effet, il n’y avait plus de morale concernant le chômage, qu’il était désormais devenu un simple droit dénué de tout devoir ou de toute connotation négative, mais qu’il y avait, par contre, une nouvelle morale, écologiste, mondialiste, non-spéciste, qui lui dictait d’agir au-delà de son propre bien-être et de sa carrière…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9455cc0d-f103-4513-961b-e30eac89ee44",
                        "source_entry_id": "0c9f721d-ec70-3fd1-9ffd-0991979d9849",
                        "source_sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                        "target_lang_word": "globalistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "66ffc1f5-d4f9-4171-96f5-b3bb2899d275",
                        "source_entry_id": "0c9f721d-ec70-3fd1-9ffd-0991979d9849",
                        "source_sense_id": "7dc44ddd-e49b-37b9-8502-892ce3eed943",
                        "target_lang_word": "globalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                                        "entry_id": "72a9902d-9c80-30b9-a529-725797de4653",
                                        "glosses": [
                                            "Of or pertaining to globalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630e7b5f-13e1-4b49-b0d8-8bd20405136b",
                                                "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                                                "text": "From a globalist point of view, talk of threats to a local culture or identity can look like bigotry and even racism: what reason could there be for excluding people when we are all part of a welcoming, global culture?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "globalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2f322d-1ed8-3165-ad1c-bdbbbff6aa05",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "An advocate of globalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443ed4e3-b161-4ac8-9652-a5af031f1ee5",
                                                "sense_id": "ff2f322d-1ed8-3165-ad1c-bdbbbff6aa05",
                                                "text": "You are either a globalist or a nationalist; one cannot be both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac10689-276e-3222-8309-dac97137dd35",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "A Jew, implying that Jews are more loyal to a global conspiracy than the country which they live in."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "633820b4-4140-3ddc-8482-b1336cdd79c6",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "One who believes that Adolf Hitler intended to extend the Third Reich beyond the continent of Europe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "One who believes international events are primarily caused by conflicts between great powers."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3f0148-2645-43c6-abfc-bda93f66c06f",
                                                "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                                "text": "\"Globalists\" tend to view international issues in terms of US-Soviet rivalry, while \"regionalists\" see them more often as manifestations of local rivalries and problems."
                                            },
                                            {
                                                "example_id": "456cdc63-eb79-4ad1-a15f-187d8d7afeed",
                                                "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                                "text": "The authors suggest that the globalist emphasis among policymakers has increased during the Reagan administration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
