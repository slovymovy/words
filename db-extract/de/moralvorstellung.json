                "senses": [
                    {
                        "sense_id": "01ad3c80-8f4f-33d0-8307-d5bf62bcc8ef",
                        "entry_id": "d7fadd45-2526-390a-ba35-3e7c53819de5",
                        "glosses": [
                            "Bild von einem perfekten religiös-ethischen (moralisch wertvollem) Miteinander, das innerhalb einer Gruppe geteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca8ac588-1b89-4d6d-9def-4ab37260811c",
                                "sense_id": "01ad3c80-8f4f-33d0-8307-d5bf62bcc8ef",
                                "text": "„Lügen ist Sünde, so die gängige Moralvorstellung.“"
                            },
                            {
                                "example_id": "842b04a7-639e-42aa-b5d3-a04f75594e65",
                                "sense_id": "01ad3c80-8f4f-33d0-8307-d5bf62bcc8ef",
                                "text": "„Moderne Moralvorstellungen und die Möglichkeit zur sicheren Empfängnisverhütung haben der Sexualität viel von ihrer elementaren Wucht genommen.“"
                            },
                            {
                                "example_id": "566aadba-39da-4610-bbb3-9db9cb5fcc5a",
                                "sense_id": "01ad3c80-8f4f-33d0-8307-d5bf62bcc8ef",
                                "text": "„Die restriktiven Moralvorstellungen, die unter Cromwell den Alltag in einschneidender Weise geprägt hatten, zerbröckelten.“"
                            },
                            {
                                "example_id": "09848fd2-216f-4f41-bb33-223576380fe5",
                                "sense_id": "01ad3c80-8f4f-33d0-8307-d5bf62bcc8ef",
                                "text": "„In keinem anderen Land wurden die Moralvorstellungen so radikal verändert wie hier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
