                ],
                "senses": [
                    {
                        "sense_id": "be370fdf-0192-3a9d-85e6-982de9850ec7",
                        "entry_id": "caf0c5df-7b19-3299-af47-774c73f7f008",
                        "glosses": [
                            "To mix (things) together."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5a125fdd-0efd-431e-b094-e51fc5af81ca",
                                "sense_id": "be370fdf-0192-3a9d-85e6-982de9850ec7",
                                "text": "These representative species often meet and interlock; and as the one becomes rarer and rarer, the other becomes more and more frequent, till the one replaces the other. But if we compare these species where they intermingle, they are generally as absolutely distinct from each other in every detail of structure as are specimens taken from the metropolis inhabited by each."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bb41d06-4f78-347b-a938-b56053bd4bc1",
                        "entry_id": "caf0c5df-7b19-3299-af47-774c73f7f008",
                        "glosses": [
                            "To become mixed together."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7398a430-dd05-4f76-b6ee-345eedf7b3af",
                        "source_entry_id": "caf0c5df-7b19-3299-af47-774c73f7f008",
                        "source_sense_description": "to mix (things) together",
                        "target_lang_word": "brasser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brasser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25b9a572-62df-3af8-b2d4-5d769daf41fa",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Fabriquer de la bière en remuant le malt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d129e1f-bf70-464e-a614-f0681a8c40c6",
                                                "sense_id": "25b9a572-62df-3af8-b2d4-5d769daf41fa",
                                                "text": "Là étaient tous les instruments d'économie domestique de ces pauvres filles, leur petit cuvier pour faire la lessive, leur petite cuve avec un appareil elliptique pour brasser elles-mêmes leur bière."
                                            },
                                            {
                                                "example_id": "41304026-599b-482a-8dde-f048a1e56643",
                                                "sense_id": "25b9a572-62df-3af8-b2d4-5d769daf41fa",
                                                "text": "Abraham était allé couper du bois d’iLalanyathi pour se confectionner une nouvelle sagaie, tandis que Jabulile était demeurée dans l’umuzi à brasser la bière, son petit Thabo dans le dos emmitouflé dans un kaross de peau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77f4146-fcc5-3522-ab8d-a9f092a84a83",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Faire fermenter des pommes pour fabriquer du cidre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56361f11-8724-41eb-9358-7907abbcba1f",
                                                "sense_id": "b77f4146-fcc5-3522-ab8d-a9f092a84a83",
                                                "text": "Au mois de novembre ils brassèrent du cidre. C'était Bouvard qui fouettait le cheval, et Pécuchet, monté dans l'auge, retournait le marc avec une pelle."
                                            },
                                            {
                                                "example_id": "bb295726-174c-4605-bdc8-4f31f620033f",
                                                "sense_id": "b77f4146-fcc5-3522-ab8d-a9f092a84a83",
                                                "text": "On prépare encore une boisson très-capiteuse et agréable au goût, nommée cidresse, avec les poires, en les brassant avec partie égale de pommes bien mûres. Mais elle passe vîte à l’acescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9ee082-72de-3732-a41c-6c0b1a6afe0d",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Tramer, fomenter, comploter."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf9d0904-cb47-482c-be53-d4efc38caeba",
                                                "sense_id": "5a9ee082-72de-3732-a41c-6c0b1a6afe0d",
                                                "text": "Il se brassait une conspiration conçue à Vienne, tramée à Rome, et prête d'éclater à Naples."
                                            },
                                            {
                                                "example_id": "6a5df1ff-8225-4366-a8f9-da21a7394106",
                                                "sense_id": "5a9ee082-72de-3732-a41c-6c0b1a6afe0d",
                                                "text": "Le pèlerin, d'aussi loin qu'il le vie,\nFeignit de croire apercevoir la dame,\nEt lui cria : Quoi donc méchante femme !\nA ton mari tu brassais un tel tour !\nEst-ce le fruit de son parfait amour !\nDieu soit témoin que pour toi j'en ai honte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad5137c5-4650-33d1-b188-17d59b959538",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Mouvoir, agiter en vue d’une opération."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a844e556-1cce-40db-b200-efe737fb6cd7",
                                                "sense_id": "ad5137c5-4650-33d1-b188-17d59b959538",
                                                "text": "Brasser du métal, des cuirs, des épingles, des clous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c619e2b-601d-3957-abad-8dccdfb7cec9",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Mélanger des cartes ou tout autre objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "354fe9df-4f00-40e1-aa7f-38d9ccafb296",
                                                "sense_id": "6c619e2b-601d-3957-abad-8dccdfb7cec9",
                                                "text": "Brasser les cartes, les dés, les feuilles."
                                            },
                                            {
                                                "example_id": "9a49cbb3-3167-47a0-a0c6-de61c7213edf",
                                                "sense_id": "6c619e2b-601d-3957-abad-8dccdfb7cec9",
                                                "text": "M. Bergeret conversait avec M. Goubin, devant deux chopes, au bruit des dominos brassés sur le marbre des tables voisines."
                                            },
                                            {
                                                "example_id": "929fb85f-4cd8-4dfa-8fa2-41b9e30b43ef",
                                                "sense_id": "6c619e2b-601d-3957-abad-8dccdfb7cec9",
                                                "text": "Il sortit de la poche de sa robe de chambre un paquet de cartes, et les brassa."
                                            },
                                            {
                                                "example_id": "8888f572-a39a-4b58-ae7a-16d437228e0e",
                                                "sense_id": "6c619e2b-601d-3957-abad-8dccdfb7cec9",
                                                "text": "Il était à ce moment dans son bureau et brassait au hasard, comme il avait dû le faire des dizaines de fois au cours des deux dernières semaines, les photos du sol de la scène du crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31198578-c8cc-3a7c-8ae3-5bb7bb7559f6",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Connecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627560a1-9c98-4295-9a95-fe7ba3895370",
                                                "sense_id": "31198578-c8cc-3a7c-8ae3-5bb7bb7559f6",
                                                "text": "Mais comment brasser ces deux lignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1337e8-e850-3e03-a20a-2c9a61315bb8",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Parler."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dc286a2-48e9-3110-8448-ca79b860bb43",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Se frotter le corps avec les bras."
                                        ],
                                        "tags": [
                                            "pronominal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d4a9ac2-a4d4-423e-acf6-fab8cfdcbc95",
                                                "sense_id": "2dc286a2-48e9-3110-8448-ca79b860bb43",
                                                "text": "Quand on tremble comme ça : brrr ! brrr !... qu'on souffle dans ses mains et qu'on fait aller les bras comme ceci…\n. (Il se brasse vigoureusement.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e0a0d9e-260b-34d3-be22-1c2f191ec563",
                                        "entry_id": "1ac4fb75-cda8-38d2-932a-43597f4272d7",
                                        "glosses": [
                                            "Créer ou maintenir une situation où il y a beaucoup d'action ; malmener."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48999c1b-a7e7-4117-ac75-446d60ed11c1",
                                                "sense_id": "4e0a0d9e-260b-34d3-be22-1c2f191ec563",
                                                "text": "Ça va brasser !"
                                            },
                                            {
                                                "example_id": "d3d2657a-84c5-4940-950b-ac0d408a18f2",
                                                "sense_id": "4e0a0d9e-260b-34d3-be22-1c2f191ec563",
                                                "text": "Or, Mme Blais s’est beaucoup fait brasser ces derniers mois. Certains en ont fait le bouc émissaire du printemps meurtrier dans les CHSLD."
                                            },
                                            {
                                                "example_id": "c6548d5d-03fd-4983-86d8-5629975a49f5",
                                                "sense_id": "4e0a0d9e-260b-34d3-be22-1c2f191ec563",
                                                "text": "La crise de l’agriculture brasse croyances, savoirs, opinions, émotions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brasser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77b72383-fd40-34e7-8a03-b265e6de44d0",
                                        "entry_id": "037e89c1-cf6b-37db-9350-9d8c5184160f",
                                        "glosses": [
                                            "Mouvoir les bras d’une vergue pour changer la direction de la voile qu’elle porte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a57e76-c271-4645-8a9f-e81e19aa9d82",
                                                "sense_id": "77b72383-fd40-34e7-8a03-b265e6de44d0",
                                                "text": "Brasser au vent."
                                            },
                                            {
                                                "example_id": "76ec4524-17a5-4e9a-8650-e11db650e9f2",
                                                "sense_id": "77b72383-fd40-34e7-8a03-b265e6de44d0",
                                                "text": "Il s’agissait donc de conserver des voiles et de les brasser obliquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f2bdfb-a6dc-3864-8dd4-fc2c0400b9d1",
                                        "entry_id": "037e89c1-cf6b-37db-9350-9d8c5184160f",
                                        "glosses": [
                                            "Nager la brasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47c4980-8472-409c-b3d8-ea9898d7f20e",
                                                "sense_id": "22f2bdfb-a6dc-3864-8dd4-fc2c0400b9d1",
                                                "text": "Je regardai et je vis trois ou quatre hommes qui nageaient vers ma cange et criaient : « Bakhchich, Christiani Kaouadja! » Puis ils approchèrent des plats-bords qu'ils saisissaient de leurs mains, recevant mon aumône, qu'ils mettaient dans leur bouche, et s'éloignèrent en brassant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef04452a-afed-4fa8-ac38-17d8fbe4d914",
                        "source_entry_id": "caf0c5df-7b19-3299-af47-774c73f7f008",
                        "source_sense_description": "to mix (things) together",
                        "target_lang_word": "entremêler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entremêler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                        "entry_id": "65a5bf19-9d58-3bbe-8fc3-0de0fec00907",
                                        "glosses": [
                                            "Mêler, insérer plusieurs choses parmi d’autres dont elles diffèrent plus ou moins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6f3dee-04aa-4eb3-bd55-f4b7be95eff7",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des fleurs rouges parmi des blanches."
                                            },
                                            {
                                                "example_id": "842f6e63-0c3b-4886-8ff1-769c16318630",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des livres et des brochures."
                                            },
                                            {
                                                "example_id": "1e740734-2d54-46bd-b1b8-8c79b84a9e0f",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Il faut entremêler ces orangers et ces grenadiers."
                                            },
                                            {
                                                "example_id": "277f2efb-c9da-49e3-af63-f58c792aa508",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Des nuances qui s’entremêlent."
                                            },
                                            {
                                                "example_id": "f92cb122-f33e-4f1d-b0a2-0ea4839bdeec",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Il ne faut point entremêler des questions si différentes."
                                            },
                                            {
                                                "example_id": "252b7fa8-3094-4626-a8cd-6c3101d272c8",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des plaisanteries et des propos sérieux."
                                            },
                                            {
                                                "example_id": "446d3b57-2ab6-42b4-a86d-f6ee9897ec3d",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Un travail entremêlé de lectures."
                                            },
                                            {
                                                "example_id": "d40da095-6ff7-424f-b280-00a029138e24",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "C’était un Marseillais qui ne parlait que de la Canebière, du cabanon, d’Olive, de Marius, de pêche à la rascasse. On l’aurait laissé faire, il eût entremêlé L’Internationale de galéjades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
