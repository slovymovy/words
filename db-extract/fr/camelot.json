            {
                "entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                "word": "camelot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "713ab8df-4383-4d75-ba08-b32bbd407aff",
                        "entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                        "tags": [
                            "plural"
                        ],
                        "form": "camelots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                        "entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                        "glosses": [
                            "Espèce d’étoffe qui était faite ordinairement de poil de chèvre ou de laine mêlée quelquefois de soie en chaîne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6bf954-6418-4ca5-aa54-cd20621709cd",
                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                "text": "Son manteau de camelot bleu était une antiquité locale au même titre que le clocher de l’église."
                            },
                            {
                                "example_id": "9a3966d2-e90d-4b0a-92b2-1746f4eb8c05",
                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                "text": "Parmi les importations du sud, on remarque les fruits secs, le sucre, les articles de verroterie, le camelot, la laine, l’opium, etc., en petite quantité."
                            },
                            {
                                "example_id": "709936bd-859a-45b7-a83f-2a1a7d144178",
                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                "text": "— Mais pas laide, Madame, interrompit vivement Passerose ; vous êtes encore belle et aimable, malgré votre petit bonnet de fermière, votre jupe de drap rayé, votre corsage de camelot rouge et votre guimpe de simple toile."
                            },
                            {
                                "example_id": "db41d685-40aa-4706-a176-01b3ae20c382",
                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                "text": "Il n’y aura pas de concurrence pour les étoffes de laine d’autres espèces et qualités, telles que camelots, callimanco, shallons, durants, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd4feccf-8582-4a54-81fc-5bb2b2347cd3",
                        "source_entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                        "source_sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                        "target_lang_word": "Kamelhaar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "83a6df88-7d05-439e-adaa-70bbca7ea099",
                        "source_entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                        "source_sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                        "target_lang_word": "camlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                        "entry_id": "312cbcaf-2721-367c-9db5-51c2c919951e",
                                        "glosses": [
                                            "A fine fabric made from wool (originally camel, but later goat) and silk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99bb4bf-6bb2-4b02-8796-e2f3695d4062",
                                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                                "text": "She wore a sort of jacket of bright red camlet, richly braided with gold and silver lace; a fringe of which also hung from her gray petticoat, which was short enough to show her feet and ankles, whose small size was rendered more remarkable by the peculiar-shaped boot."
                                            },
                                            {
                                                "example_id": "4adf3ed7-fb98-4f4e-a8fb-2f08fb911207",
                                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                                "text": "She was richly clad in a bodice of gold-coloured camlet and a skirt of gray silk trimmed with gold and silver lace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                        "entry_id": "7931007d-9ce0-3499-a5bd-60e85062e9b1",
                                        "glosses": [
                                            "Made of camlet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3591206-ebf9-4e85-a74f-a218f3833e78",
                                                "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                                "text": "This morning came home my fine Camlett cloak, with gold buttons, and a silk suit, which cost me much money, and I pray God to make me able to pay for it."
                                            },
                                            {
                                                "example_id": "de0cf906-883b-4861-887c-d81d00a896e6",
                                                "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                                "text": "With this announcement he hurried away to the outer door of the Blue Dragon, and almost immediately returned with a companion shorter than himself, who was wrapped in an old blue camlet cloak with a lining of faded scarlet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a62a642-9b3e-47d2-af6c-2247fe6f71d3",
                        "source_entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
