                ],
                "senses": [
                    {
                        "sense_id": "eff86c61-3009-3f56-8ced-6c3e5d4418a8",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "budynek, niekiedy wysoki, w którym pełni się straż"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8ad18c-41c5-4b96-980e-61df6bc9dd07",
                                "sense_id": "eff86c61-3009-3f56-8ced-6c3e5d4418a8",
                                "text": "W malborskich strażnicach rzadko czuwała straż zamkowa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "25a9c3a1-f46b-3036-81c6-d2c95742535c",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "budynek lub zespół budynków, w którym stacjonował pododdział ochraniający przydzielony odcinek granicy państwowej w Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6adb6e6-0c4c-4973-966c-a080d306dcb2",
                                "sense_id": "25a9c3a1-f46b-3036-81c6-d2c95742535c",
                                "text": "Wieczorna grupa wartownicza już powróciła do strażnicy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2b094f8a-68c1-37ad-8e16-4d8215c71991",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "pododdział Wojsk Ochrony Pogranicza lub Straży Granicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b2112d1-89a3-4630-a285-744197202099",
                                "sense_id": "2b094f8a-68c1-37ad-8e16-4d8215c71991",
                                "text": "Ze względu na trudne warunki terenowe strażnice mogły wystawiać placówki ochraniające granicę na odcinku od 3 do 7 kilometrów"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "dc917f4b-71d9-3065-91bd-8c6a3fba55fb",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "ostoja, świątynia w sensie kulturowym, społecznym itp."
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "195f4289-42c6-4b77-8263-2749e1e9fb83",
                                "sense_id": "dc917f4b-71d9-3065-91bd-8c6a3fba55fb",
                                "text": "Dla wielu Jasna Góra stanowiła podczas zaborów strażnicę polskości."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "caaf987b-c0f7-3547-8a2d-39d15cb04577",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "strażniczka"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "afa6b743-0d81-4af6-b6c2-ce48dd681179",
                                "sense_id": "caaf987b-c0f7-3547-8a2d-39d15cb04577",
                                "text": "Zaczynam pojmować, że nauka to strażnica każdego kroku człowieka"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "03819f9d-adcd-3976-a1cf-2984604e103b",
                        "entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "glosses": [
                            "reg. (Śląsk Cieszyński i Żywiecczyzna) remiza, budynek straży pożarnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22f43d37-8ad6-4675-a2b3-ae83693adf29",
                                "sense_id": "03819f9d-adcd-3976-a1cf-2984604e103b",
                                "text": "Strażnica OSP wreszcie zostanie dokończona. Wreszcie, bo budynek czeka na to ponad 30 lat!"
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f73a798a-c6b9-49fa-b373-82067f25fe1a",
                        "source_entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "source_sense_id": "eff86c61-3009-3f56-8ced-6c3e5d4418a8",
                        "target_lang_word": "watchtower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchtower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                        "entry_id": "37aef86b-1367-30b8-9d4c-ae97b6d7ff75",
                                        "glosses": [
                                            "An observation tower in which a lookout keeps watch over prisoners, or looks out for fires, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69596e3e-9d88-4030-8361-d387a301e56f",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "A \"watchtower\" Website, keeping track of paedophile groups around the world, is expected to be up and running next year. The campaign will also liaise with law enforcement agencies around the world and share information on suspected Internet paedophiles."
                                            },
                                            {
                                                "example_id": "74f8aed0-4b5c-4601-a224-52b5d74dd5c2",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Redcap - A malevolent goblin easily distinguishable by their namesake red cap, fiery red eyes, claws and iron boots. They often appear as little old men, but can run very fast despite the boots. They reside in castles and watchtowers along the English-Scottish border, but will move their residence to avoid detection."
                                            },
                                            {
                                                "example_id": "a651f21a-fd57-4e38-b05a-cfd1101c2e6b",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Residents of Tungyin, a frontline islet under Taiwan’s Matsu islands cluster, said they spotted an unidentified aircraft flying overhead at 2.45pm on February 5, while video footage from the watchtower monitor showed an aircraft crossing the skies and flying out towards the east.\nThe military commanding centre of Tungyin confirmed that “a fixed-wing twin-propeller aircraft [had] briefly entered the airspace and soon left”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
