                    ],
                    "common_phrases": [
                        "ticket stub",
                        "pay stub",
                        "check stub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть бумажного документа (билета, квитанции), предназначенная для отрыва и сохранения для учета или идентификации."
