                "senses": [
                    {
                        "sense_id": "1a86a0d5-8b37-3336-9084-e9d032831734",
                        "entry_id": "de68e700-47bd-3522-84f2-b0cb59421ccf",
                        "glosses": [
                            "Frapper, fouetter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "07e86b5b-3f38-49f9-bcb6-51f6f20a7102",
                                "sense_id": "1a86a0d5-8b37-3336-9084-e9d032831734",
                                "text": "Il habite Pont-d’Any avec la Mado (une mauvaise Française, mais qui ne se gêne pas pour le schlaguer à coups de poêlon)."
                            },
                            {
                                "example_id": "abf8f691-6eda-495d-b1b1-f0fd0ff32f9c",
                                "sense_id": "1a86a0d5-8b37-3336-9084-e9d032831734",
                                "text": "Comme nous allons les schlaguer !"
                            },
                            {
                                "example_id": "7422705d-6a8e-4902-8e9d-5177a2018696",
                                "sense_id": "1a86a0d5-8b37-3336-9084-e9d032831734",
                                "text": "On t’a schlagué, t’as plus d’œil, t’as plus de bras ; c’est Nous !"
                            },
                            {
                                "example_id": "e70876fd-4bed-4e94-a3f9-628ace77f0f9",
                                "sense_id": "1a86a0d5-8b37-3336-9084-e9d032831734",
                                "text": "J'entends not'canon qui résonne/ Ca va chauffer, Dieu m'en pardonne/ Avant qu'il soit peu mes schlagueurs/ Vous s’rez schlagués par nos vainqueurs"
                            }
                        ]
                    }
