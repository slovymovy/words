                        "cross_references": [
                            {
                                "target_word": "cabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef29420b-9276-3741-9805-2f576d25a8c9",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The transport of goods or passengers between two points in the same country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0538bd-ad4f-49f5-85e2-cf0cbd6e17a0",
                                                "sense_id": "ef29420b-9276-3741-9805-2f576d25a8c9",
                                                "text": "Cabotage traffic may be carried by a foreign carrier on special permission of the civil aeronautics authorities […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05ecd84-885d-35d7-aa77-78a1cfd07bf3",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The right to engage in such transport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d0d8af3-732f-4b63-8d15-f884dd2200cb",
                                                "sense_id": "a05ecd84-885d-35d7-aa77-78a1cfd07bf3",
                                                "text": "Cabotage, used as a legal term, here refers to the right to transport goods or passengers between ports of a country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4532884-b835-30e6-8132-27ecab5447ba",
                                        "entry_id": "7411a230-3015-39ac-a80e-332a04c5a9e7",
                                        "glosses": [
                                            "The exclusive right of a country to control such transport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8530ea6c-5012-462c-aa46-f1c409628f78",
                                                "sense_id": "f4532884-b835-30e6-8132-27ecab5447ba",
                                                "text": "Professor Levine distinguishes two kinds of cabotage: \"primary cabotage\" which can be compared with ninth freedom cabotages and \"long-haul limited cabotage\" which can be compared with eighth freedom cabotage […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "769e2ee4-b954-47e6-b55e-01fadff7b2a3",
                        "source_entry_id": "8e81e7cf-4f4d-3454-a088-07bdaa924529",
                        "source_sense_id": "89a80e81-11c9-3ee2-823b-fddae7e02742",
                        "target_lang_word": "cabotage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabotage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbba4aa-cf8d-36e2-be7b-8ad2c2ac9164",
                                        "entry_id": "cac02f52-af5c-32e6-b664-7fbdbf6345e3",
                                        "glosses": [
                                            "Action de caboter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56048712-fb4a-493c-ba04-ea89db61194f",
                                                "sense_id": "3cbba4aa-cf8d-36e2-be7b-8ad2c2ac9164",
                                                "text": "Grand, petit cabotage. Faire le cabotage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1bf61bd-2a64-3673-9939-69c8aeb3f7a6",
                                        "entry_id": "cac02f52-af5c-32e6-b664-7fbdbf6345e3",
                                        "glosses": [
                                            "Type de navigation maritime consistant à se déplacer de port en port en restant à proximité des côtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc75c7e0-9452-48ce-aa81-1344040f7089",
                                                "sense_id": "b1bf61bd-2a64-3673-9939-69c8aeb3f7a6",
                                                "text": "J’ai tout de même été bien content de quitter le métier avec ce que j’ai eu, et de pouvoir m’acheter un chasse-marée pour faire le cabotage."
                                            },
                                            {
                                                "example_id": "20c4c1a2-01aa-480c-a3a7-13e8ed1bf83a",
                                                "sense_id": "b1bf61bd-2a64-3673-9939-69c8aeb3f7a6",
                                                "text": "Il faisait le cabotage entre les différents ports de l’Australie et de la Nouvelle-Zélande."
                                            },
                                            {
                                                "example_id": "89196d1f-83d2-4840-9161-b25c95365904",
                                                "sense_id": "b1bf61bd-2a64-3673-9939-69c8aeb3f7a6",
                                                "text": "Je suis un homme et non plus un petit garçon ! J’ai quarante ans ! Je suis capitaine au cabotage…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f518c09-0725-3681-a563-02292e1ea6f9",
                                        "entry_id": "cac02f52-af5c-32e6-b664-7fbdbf6345e3",
                                        "glosses": [
                                            "Connaissance des bancs, des courants, des mouillages qui sont le long d’une côte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "698b6c78-7d1b-3ee8-a2c3-0c14bb6a5da9",
                                        "entry_id": "cac02f52-af5c-32e6-b664-7fbdbf6345e3",
                                        "glosses": [
                                            "Dans le droit du transport routier de marchandises, fait de quitter un pays avec un véhicule et à le charger puis décharger, à plusieurs reprises, dans un pays étranger, avec retour obligatoire au pays d’origine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b812310-17e8-464b-97c5-58105d3ebf4e",
                                                "sense_id": "698b6c78-7d1b-3ee8-a2c3-0c14bb6a5da9",
                                                "text": "Pour prévenir le « cabotage systématique », vu comme une concurrence déloyale, une période de carence de quatre jours est prévue avant que d’autres opérations puissent être effectuées dans le même pays avec le même véhicule. Les nouvelles règles introduisent aussi l’enregistrement des passages de frontières par tachygraphe, un dispositif retraçant les mouvements du véhicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
