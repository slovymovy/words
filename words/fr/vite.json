                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "urgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vite</w>, le train va partir dans moins de deux minutes !"
                        },
                        {
                            "text": "<w>Vite</w>, apportez une trousse de premiers secours pour ce voyageur blessé !"
                        }
                    ],
                    "synonyms": [
                        "dépêchons",
                        "et que ça saute"
                    ],
                    "common_phrases": [
