                    {
                        "form_id": "d54f9e90-629d-41c2-8f9e-aa609b7c35bb",
                        "entry_id": "376f7e5d-67ce-3271-b2ea-ac0fae209b77",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hommagen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                        "entry_id": "376f7e5d-67ce-3271-b2ea-ac0fae209b77",
                        "glosses": [
                            "Veranstaltung oder (künstlerisches) Werk, das als Ehrung für jemanden entworfen wurde, der eine Art Vorbildfunktion hatte, oder für etwas, das besonders inspirierend war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a09f56-1aa8-4dc1-8b56-3ce198db9c05",
                                "sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                                "text": "„Zu den beiden wichtigsten Eckpunkten seiner Architektur zählen das Glashaus auf seinem Anwesen in New Canaan (1949), einer Hommage an Mies van der Rohe, und das AT & T-Building in New York (1984); es ist die Inkunabel des postmodernen Hochhauses.“"
                            },
                            {
                                "example_id": "f6d9fb83-de97-4929-8d69-07e23bc214b9",
                                "sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                                "text": "„Aus diesem Blickwinkel betrachtet, galt deshalb mein spätherbstlicher Besuch mehr einer Hommage an die Vergangenheit, als einer der sonst üblichen eingespielten gastronomischen Bestandsaufnahmen.“"
                            },
                            {
                                "example_id": "a4fb7554-06a3-41a4-a857-be6d44c1f12b",
                                "sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                                "text": "„Sieben Monate verbringt er in Paris, das ihm ein letztes Fest bereitet, als 1926 ein umfangreicher Band erscheint mit einer Hommage Frankreichs an Rilke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd12ab90-5ca5-4360-8c75-9c7d0cbc2b07",
                        "source_entry_id": "376f7e5d-67ce-3271-b2ea-ac0fae209b77",
                        "source_sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                        "source_sense_description": "Veranstaltung oder (künstlerisches) Werk als Ehrung für jemanden",
                        "target_lang_word": "homage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "A demonstration of respect, as towards a person after his or her retirement or death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae42d67a-a544-4e4b-bde8-99f9f52978fe",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "I ſought no homage from the Race that vvrite; / I kept, like Aſian Monarchs, from their ſight: […]"
                                            },
                                            {
                                                "example_id": "70d26426-77e0-4292-971d-c8ea44d5478a",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "When a man squeezes the hand of a pretty woman, […] she will consider such an impertinent freedom in the light of an insult, if she have any true delicacy, instead of being flattered by this unmeaning homage to beauty."
                                            },
                                            {
                                                "example_id": "cf92f92c-5b4f-4742-afcd-0abc9b448810",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "It’s appropriate that we pay homage to them and the sacrifices they made."
                                            },
                                            {
                                                "example_id": "4e1e8bce-9668-497d-9c4e-5fe393efbf27",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "My rainy-day tour in April during the first lockdown was, in fact, a homage to Sir John Betjeman - the poet and railway campaigner whose statue can be found on the upper concourse of St Pancras station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07ba8b6d-290a-39b3-915f-445760495933",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "An artistic work imitating another in a flattering style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a730ee-9ac5-4a1b-8308-8ce599acc7d6",
                                                "sense_id": "07ba8b6d-290a-39b3-915f-445760495933",
                                                "text": "He likes to tell people that it's a Hitchcockian thriller, but that's kind of like saying Happy Gilmore is a homage to Woody Allen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f99a1181-6879-3ef4-bf77-1f7d138e848d",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "In feudalism, the formal oath of a vassal to honor his or her lord's rights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3a727d-46d3-4ce9-87aa-053dfd05ddee",
                                                "sense_id": "f99a1181-6879-3ef4-bf77-1f7d138e848d",
                                                "text": "We'll do thee homage, and be rul'd by thee, / Love thee as our commander and our king."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbddf2d0-0d05-35e1-9659-c2ffb906dd4e",
                                        "entry_id": "8423c830-cc83-3344-b45e-edbe0af53c24",
                                        "glosses": [
                                            "To pay reverence to by external action."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08eaf535-1387-3b57-a3d5-74f7caba90fb",
                                        "entry_id": "8423c830-cc83-3344-b45e-edbe0af53c24",
                                        "glosses": [
                                            "To cause to pay homage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989ccc5e-44ec-4436-a188-c96cf7591ff8",
                                                "sense_id": "08eaf535-1387-3b57-a3d5-74f7caba90fb",
                                                "text": "The Austrian Crowns and Romes seven Hills she shook; >br>To her great Neptune Homag'd all his Streams"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0e4fd1b-0089-460e-9378-22e60a0897ef",
                        "source_entry_id": "376f7e5d-67ce-3271-b2ea-ac0fae209b77",
                        "source_sense_id": "a7d8fccf-ef50-3a9b-b70e-3855cec6e79e",
                        "source_sense_description": "Veranstaltung oder (künstlerisches) Werk als Ehrung für jemanden",
                        "target_lang_word": "hommage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hommage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5d70a8-de54-31d6-8bb4-1af615c3d43f",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Devoir que le vassal était tenu de rendre au seigneur dont son fief relevait."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe4ea4be-ab06-4ca0-8c6a-9b8265da5610",
                                                "sense_id": "9e5d70a8-de54-31d6-8bb4-1af615c3d43f",
                                                "text": "Il est vrai qu’il m’a éloigné de sa présence et qu’il a refusé mon hommage ; par conséquent, je ne lui dois ni amitié ni allégeance ; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "420289fa-391b-3ec3-bf66-b8a9677e6b79",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Marque de soumission, de respect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef883e86-d915-4367-87f8-33b5911a213e",
                                                "sense_id": "420289fa-391b-3ec3-bf66-b8a9677e6b79",
                                                "text": "Ce n’est pas que le premier regard d’Ivanhoé eût exprimé plus que cet hommage général que la jeunesse rend toujours à la beauté ; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Témoignage de respectueux dévouement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3067fdbf-65c5-4be4-abe2-18b98858b78c",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Trouvez ici, mademoiselle, les hommages que nous devons à toutes les femmes, même à celles qui sont inconnues et masquées."
                                            },
                                            {
                                                "example_id": "c32faf86-0a5c-4c90-aca5-83f5555121a8",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Tu vois, frère, que j’ai autour de moi quelques hommes irrités ; tu ferais bien d’aller vers notre mère, de lui porter mes hommages affectueux, …."
                                            },
                                            {
                                                "example_id": "97658a67-87f3-4420-942d-8fad43a65bf6",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Insensible aux hommages, la jeune fille regardait avec une espèce d'anxiété le château des Tuileries, …."
                                            },
                                            {
                                                "example_id": "c13f39b6-f6d0-46ec-bbf8-c6982a71a8ce",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Le maire de Saint-Michel fit son entrée dans le cabinet du préfet, marchant courbé en deux, le dos voûté, les bras arrondis. C’était, à la lettre, l’homme qui dépose ses hommages aux pieds de son supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff82859-b649-3db7-a3ea-b1347450bcf3",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Don respectueux, offrande."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d2abda-a318-47e1-bec3-a382f765de19",
                                                "sense_id": "eff82859-b649-3db7-a3ea-b1347450bcf3",
                                                "text": "Faire hommage à quelqu’un d’une chose. - Je lui ai fait hommage de mon livre. - Daignez agréer ceci comme un hommage de ma reconnaissance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
