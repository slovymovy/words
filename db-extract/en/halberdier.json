                    {
                        "sense_id": "b69516dc-19ff-3434-85cd-59cb4dd2df4c",
                        "entry_id": "3f058959-3de2-31b8-82df-2698b41597ba",
                        "glosses": [
                            "A soldier armed with a halberd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770ddc3b-a03c-46c7-ac65-78e5431091f8",
                                "sense_id": "b69516dc-19ff-3434-85cd-59cb4dd2df4c",
                                "text": "Jones did not think fit to acquaint the serjeant with his design; though he might have done it with great safety, for the halberdier was himself a man of honour, and had killed his man."
                            }
                        ]
                    }
                ],
                "translations": [
