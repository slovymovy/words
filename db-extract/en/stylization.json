                        "glosses": [
                            "The process or result of designing or presenting in accordance with a style. Adoption of a style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6745c8-6706-44da-82c0-cfc86f7055be",
                                "sense_id": "e6306c72-0e8d-3efa-8369-f8d6143c4ace",
                                "text": "If you separate your work from reality, the artistry and stylization become the focus."
                            }
                        ]
