                        "entry_id": "11081302-02c3-3d0f-ab77-67cc2cef9307",
                        "glosses": [
                            "Type d'aquaterrarium consacré aux espèces des marais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54accf56-ba7e-42b2-8e15-16aaf282b113",
                                "sense_id": "d843c6fa-9cfc-344c-9410-5ca8cf1ec4b2",
                                "text": "En paludarium, la culture émergée en atmosphère humide est plus aisée, la fougère se ramifie et sa coloration verte s’assombrit."
                            }
                        ]
                    }
                ],
