{
    "word_family": [
        "junk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe7f241d-2180-3af5-82b6-632a72f46f6c",
                    "sense_definition": "A person who is extremely enthusiastic about or obsessed with a particular activity or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother is a total adrenaline <w>junkie</w> who loves skydiving and rock climbing.",
                            "target_lang_translations": {
                                "tr": "Erkek kardeşim paraşütle atlamayı ve kaya tırmanışını çok seven tam bir adrenalin <w>bağımlısıdır</w>."
                            }
                        },
                        {
                            "text": "As a self-proclaimed news <w>junkie</w>, she checks various websites multiple times every morning.",
                            "target_lang_translations": {
                                "tr": "Kendi tabiriyle bir haber <w>tutkunu</w> olarak, her sabah çeşitli internet sitelerini defalarca kontrol eder."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthusiast",
                        "fan",
                        "buff",
                        "devotee",
                        "aficionado"
                    ],
                    "common_phrases": [
                        "adrenaline junkie",
                        "news junkie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe an enthusiast"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir etkinliğe, konuya veya ilgi alanına aşırı derecede düşkün, tutkulu ya da bağımlı olan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bağımlısı",
                                "target_lang_sense_clarification": "bir şeye aşırı düşkün kimse"
                            },
                            {
                                "target_lang_word": "tutkunu",
                                "target_lang_sense_clarification": "bir şeye büyük heves duyan kimse"
                            },
                            {
                                "target_lang_word": "hastası",
                                "target_lang_sense_clarification": "argo/günlük dil, bir şeye aşırı meraklı kimse"
                            },
                            {
                                "target_lang_word": "müptelası",
                                "target_lang_sense_clarification": "bir alışkanlıktan veya ilgiden vazgeçemeyen kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e990db6a-8344-3b27-8c3d-04fe6d5eb9d3",
                    "sense_definition": "A person who is addicted to illegal drugs, particularly heroin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "addict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local clinic offers counseling and medical support for recovering <w>junkies</w>.",
                            "target_lang_translations": {
                                "tr": "Yerel klinik, iyileşme sürecindeki <w>keşler</w> için danışmanlık ve tıbbi destek sunuyor."
                            }
                        },
                        {
                            "text": "He lost his home and all his savings after becoming a heroin <w>junkie</w>.",
                            "target_lang_translations": {
                                "tr": "Bir eroin <w>bağımlısı</w> hâline geldikten sonra evini ve tüm birikimini kaybetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "drug addict",
                        "addict",
                        "abuser"
                    ],
                    "common_phrases": [
                        "heroin junkie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often derogatory term for a drug addict"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle eroin başta olmak üzere yasa dışı uyuşturucu maddelere bağımlı olan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "keş",
                                "target_lang_sense_clarification": "argo, uyuşturucu bağımlısı"
                            },
                            {
                                "target_lang_word": "uyuşturucu bağımlısı",
                                "target_lang_sense_clarification": "genel ve resmî kullanım"
                            },
                            {
                                "target_lang_word": "eroinman",
                                "target_lang_sense_clarification": "özellikle eroin bağımlısı"
                            },
                            {
                                "target_lang_word": "madde bağımlısı",
                                "target_lang_sense_clarification": "yasa dışı madde kullanan kimse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}