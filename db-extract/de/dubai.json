                                "example_id": "99342d66-6bda-45eb-8302-24f3aa6467f5",
                                "sense_id": "bd1b3386-ff4f-365f-b897-865b0966690d",
                                "text": "Dubai ist besonders wegen seiner spektakulären Bauvorhaben bekannt."
                            },
                            {
                                "example_id": "485600a2-d092-40b3-967a-02f11020646a",
                                "sense_id": "bd1b3386-ff4f-365f-b897-865b0966690d",
                                "text": "„Als ihm 2004 erlaub wurde, zu seiner Familie im Exil in Dubai zu ziehen, hatte er elf von siebzehn Jahren Ehe im Gefängnis verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
