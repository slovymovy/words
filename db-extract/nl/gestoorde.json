                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c98fa7-e68a-4e6a-ab0d-a696860b2257",
                                "sense_id": "5f2cee2f-9b33-37d5-8b58-877b0dc4f2a9",
                                "text": "- De vragenstellers moesten zich in schaapskleren hullen om te onthullen wat er aan verborgen oordelen leeft, en ze wilden met hun vragen blootleggen dat niet iedereen dezelfde definitie van verkrachting heeft. Niemand die je er rechtstreeks naar vraagt keurt verkrachting goed, maar toch gebeurt het, niet alleen door seksueel gestoorden, ook door klasgenoten, cafégangers of collega’s. De daders voelen zich geen verkrachter."
                            }
                        ]
                    }
