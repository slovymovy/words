{
    "word_family": [
        "knobby"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9d74038-f896-3380-9304-5c9556c45a10",
                    "sense_definition": "A rounded control switch that can be turned on its axis, designed to be operated by the fingers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turn the <w>knob</w> to the right to increase the volume.",
                            "target_lang_translations": {
                                "zh": "向右转动<w>旋钮</w>可以调大音量。"
                            }
                        },
                        {
                            "text": "She adjusted the <w>knob</w> on the stove to heat the pan.",
                            "target_lang_translations": {
                                "zh": "她调节了炉子上的<w>旋钮</w>来加热平底锅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dial",
                        "switch"
                    ],
                    "common_phrases": [
                        "volume knob",
                        "control knob"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种圆形的控制开关，可以通过旋转来调节设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "旋钮",
                                "target_lang_sense_clarification": "用于调节音量、温度等设备的圆形控制部件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92136386-90ee-362a-85d6-4599fffb6638",
                    "sense_definition": "A ball-shaped part of a handle, lever, etc., designed to be grabbed by the hand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "handle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned the door <w>knob</w> and walked into the room.",
                            "target_lang_translations": {
                                "zh": "他转动<w>门把手</w>走进了房间。"
                            }
                        },
                        {
                            "text": "The brass <w>knob</w> was cold to the touch.",
                            "target_lang_translations": {
                                "zh": "那个黄铜<w>门把手</w>摸起来很凉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "handle"
                    ],
                    "common_phrases": [
                        "door knob"
                    ],
                    "target_lang_definitions": {
                        "zh": "门把手或杠杆末端的球形抓握部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "门把手",
                                "target_lang_sense_clarification": "安装在门上用于开关门的把手。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb0618d-e878-3660-84db-0b353b8d3663",
                    "sense_definition": "A small, rounded amount of a substance, typically butter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a <w>knob</w> of butter to the pan before cooking the eggs.",
                            "target_lang_translations": {
                                "zh": "煎蛋前在锅里加一<w>小块</w>黄油。"
                            }
                        },
                        {
                            "text": "Melt a small <w>knob</w> of butter in the sauce.",
                            "target_lang_translations": {
                                "zh": "在酱汁里融化一<w>小块</w>黄油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dollop",
                        "pat"
                    ],
                    "common_phrases": [
                        "knob of butter"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一小块（通常指黄油）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小块",
                                "target_lang_sense_clarification": "用于描述黄油等物质的少量块状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08c744ba-9abe-3356-84f1-689ce2680e83",
                    "sense_definition": "A prominent rounded hill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hiked up the <w>knob</w> to get a better view of the valley.",
                            "target_lang_translations": {
                                "zh": "我们爬上了那座<w>小圆丘</w>，以便更好地俯瞰山谷。"
                            }
                        },
                        {
                            "text": "The trail leads directly to the top of the grassy <w>knob</w>.",
                            "target_lang_translations": {
                                "zh": "这条小路直通长满草的<w>小圆丘</w>顶端。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hill",
                        "mound"
                    ],
                    "target_lang_definitions": {
                        "zh": "指突出的圆形小山丘。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小圆丘",
                                "target_lang_sense_clarification": "地理上指形状圆润的小山。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2f2e45-0b11-3247-9f24-573917c2dc94",
                    "sense_definition": "A contemptible or foolish person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>knob</w> and just listen to what I am saying.",
                            "target_lang_translations": {
                                "zh": "别像个<w>蠢货</w>一样，听我说完。"
                            }
                        },
                        {
                            "text": "He acted like a total <w>knob</w> at the party last night.",
                            "target_lang_translations": {
                                "zh": "他昨晚在派对上表现得像个十足的<w>蠢货</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool",
                        "jerk"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指令人讨厌或愚蠢的人（英式俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "用于贬低他人愚蠢或令人厌烦。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5411a01-1f46-3563-bd7e-30716a01036a",
                    "sense_definition": "To have sexual intercourse with.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bragged about who he had <w>knobbed</w> over the weekend.",
                            "target_lang_translations": {
                                "zh": "他吹嘘周末和谁<w>做爱</w>了。"
                            }
                        },
                        {
                            "text": "They <w>knobbed</w> in the back of the car.",
                            "target_lang_translations": {
                                "zh": "他们在车后座<w>做爱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "copulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指发生性关系（粗俗俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "做爱",
                                "target_lang_sense_clarification": "指性行为的粗俗表达。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}