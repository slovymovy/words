                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "о страсти, интересе, надежде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nachlassen",
                                "target_lang_sense_clarification": "Intensität, Interesse oder Kraft"
                            },
                            {
                                "target_lang_word": "abflauen",
