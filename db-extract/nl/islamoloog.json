                        "examples": [
                            {
                                "example_id": "326da433-a969-4b19-9de9-e1c46981dda3",
                                "sense_id": "6e762b13-6ef8-34fe-b23c-031fce1fd091",
                                "text": "Filosoof en Islamoloog Tariq Ramadan reageert vanuit Athene op de ontwikkelingen in de Arabische wereld."
                            },
                            {
                                "example_id": "19921570-0053-45c0-86ae-29fcf2e61851",
                                "sense_id": "6e762b13-6ef8-34fe-b23c-031fce1fd091",
                                "text": "Ook islamoloog Maurits Berger, verbonden aan de universiteit van Leiden, is voorstander van een islamitische geschillencommissie in Nederland. \"Bij andere religies, joden en katholieken, bestaan ook rechtbanken om geschillen op te lossen. Let wel: het gaat hier niet om strafrecht, het afhakken van handen of zo. Het gaat hier om het oplossen van problemen van wanhopige vrouwen die nu niet weten waar ze terechtkunnen. We hebben het hier over diep religieuze vrouwen.\""
                            }
                        ]
                    }
