                "translations": [
                    {
                        "translation_id": "88fd4e87-8626-4bd6-a21f-664a924950e8",
                        "source_entry_id": "08fab7e3-e8a4-3d03-a631-58b819256228",
                        "source_sense_id": "c2d57cbf-2a3f-3ef4-85dc-f0d7937e96e0",
                        "target_lang_word": "Westphalian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Westphalian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b959fb60-bfeb-32e1-a0fb-a29ff3b63c84",
                                        "entry_id": "31fc014d-0e7f-302e-963b-d2862bf726a3",
                                        "glosses": [
                                            "Of or pertaining to the Westphalia region or its people and culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bca6f86-0103-40fe-a12e-a8a593df2b9f",
                                                "sense_id": "b959fb60-bfeb-32e1-a0fb-a29ff3b63c84",
                                                "text": "Then comes the imperative necessity of eating smoked Westphalian ham for breakfast: this is on the principle that imitation is the most delicate flattery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb38534-a686-3848-9566-1a75790814b7",
                                        "entry_id": "31fc014d-0e7f-302e-963b-d2862bf726a3",
                                        "glosses": [
                                            "Of or pertaining to Westphalian Low German."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e9908f-9011-3d7f-8e87-f9f193224860",
                                        "entry_id": "31fc014d-0e7f-302e-963b-d2862bf726a3",
                                        "glosses": [
                                            "Of or pertaining to the Peace of Westphalia of 1648 which established a new system of political order in Central Europe, based on the concept of co-existing sovereign states."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8acf8fc-dadf-4fc6-9376-d9545e07ee6c",
                                                "sense_id": "58e9908f-9011-3d7f-8e87-f9f193224860",
                                                "text": "The long stagnation and despotism under the Chinese world order in East Asia before the late 19th century are thus pretentiously repackaged as China's alternative to the Western-dominated, Westphalian system of international relations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Westphalian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9c62e9-dd42-3ab7-86fc-d4da9762839b",
                                        "entry_id": "103b734d-e352-3758-a466-605ae2d5ddd8",
                                        "glosses": [
                                            "A native or inhabitant of Westphalia, a geographic region, part of the state of North Rhine-Westphalia, Germany."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c434684-5277-3756-bbdd-0e34d729a1eb",
                                        "entry_id": "103b734d-e352-3758-a466-605ae2d5ddd8",
                                        "glosses": [
                                            "One of the major dialect groups of West Low German spoken in Westphalia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68bc8568-1d95-31d2-a41a-85ab354affea",
                                        "entry_id": "103b734d-e352-3758-a466-605ae2d5ddd8",
                                        "glosses": [
                                            "A European phase of the upper Carboniferous period."
