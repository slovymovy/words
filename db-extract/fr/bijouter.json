                ],
                "senses": [
                    {
                        "sense_id": "7b0e15f8-e95b-33e9-aa1b-b4a30abeeaed",
                        "entry_id": "783bccc1-6c70-3546-9595-154b3e725633",
                        "glosses": [
                            "Mettre des bijoux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a1dace-4018-4b88-825f-3644eb118ef0",
                                "sense_id": "7b0e15f8-e95b-33e9-aa1b-b4a30abeeaed",
                                "text": "Je m’affuble de ma robe la plus somptueuse, je me maquille avec une opulence discrète, je me bijoute non moins discrètement et choisis entre deux accessoires le plus présentable : mon sac à main de tous les jours!"
                            },
                            {
                                "example_id": "edc032c4-05d3-4db4-88de-7a1dff7987de",
                                "sense_id": "7b0e15f8-e95b-33e9-aa1b-b4a30abeeaed",
                                "text": "Enrobée, bottée, bijoutée, parfumée, maquillée et le sac qui ne dépareille pas, c’est primordial. Non. Je me dérobe, débotte, débijoute, déparfume, démaquille et j’oublie le sac."
                            }
                        ]
                    }
                ],
