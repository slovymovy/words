                                        "entry_id": "133d11a4-35e7-3f4b-b11c-f8bd5f9027f4",
                                        "glosses": [
                                            "A camera: a device for taking still photographs."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9498c4ae-a4e6-459c-b3b8-563a1cab9d3c",
                                                "sense_id": "247509df-d155-3ad5-b223-328dd577cd5e",
                                                "text": "To diagnose / Our modest pose / The Kodaks do their best"
                                            },
                                            {
                                                "example_id": "cc08f588-d78b-4582-9095-fbb5d0444b0d",
                                                "sense_id": "247509df-d155-3ad5-b223-328dd577cd5e",
                                                "text": "Charmian and Martin brought up the rear, armed with kodaks. We dived under the avocado trees […] and came on a spot that satisfied Martin's photographic eye."
                                            },
                                            {
                                                "example_id": "0368338d-a22f-4371-9627-ef89d33939bd",
                                                "sense_id": "247509df-d155-3ad5-b223-328dd577cd5e",
                                                "text": "An American girl snapped her Kodak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5110e6fb-402a-3d06-b4d7-ffa2f470977f",
                                        "entry_id": "133d11a4-35e7-3f4b-b11c-f8bd5f9027f4",
                                        "glosses": [
                                            "A still photograph."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740b9193-e7d6-4fc3-9ed4-c0e8d9231f57",
                                                "sense_id": "5110e6fb-402a-3d06-b4d7-ffa2f470977f",
                                                "text": "There were photographs everywhere: photographs framed and unframed; photographs large and photographs small, the fresh and the faded; tintypes, kodaks, “full lengths,” “cabinets,” groups—every type of photograph; […]"
                                            },
                                            {
                                                "example_id": "89fb3f81-91d3-4a55-82a7-c0ce4d424a38",
                                                "sense_id": "5110e6fb-402a-3d06-b4d7-ffa2f470977f",
                                                "text": "You may consult the kodaks taken at my arrest if you are curious, Archivist."
                                            }
                                        ]
                                    }
                                ]
