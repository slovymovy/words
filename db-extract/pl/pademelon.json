                                        "entry_id": "3940d1e6-8bf4-3a31-b201-e6228673dd10",
                                        "glosses": [
                                            "Any of various cucurbitaceous plants, especially Cucumis myriocarpus, native to Africa but naturalized in inland Australia."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c02108b2-981b-4d29-8ff6-867a6db816b2",
                                                "sense_id": "62d9888b-81c4-3516-92f9-ab4185902b0d",
                                                "text": "Not even an occasional clod of earth stowed in the middle of a sack, or a few hefty paddy-melons, could make the toil profitable."
                                            },
                                            {
                                                "example_id": "4a7a9b76-255e-49ee-a019-5553bbf5bf78",
                                                "sense_id": "62d9888b-81c4-3516-92f9-ab4185902b0d",
                                                "text": "The road was a straight band of tarmac and, on either side, there were strips of red dirt with paddy-melon growing over them."
                                            }
                                        ]
                                    }
