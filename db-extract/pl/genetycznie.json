                                        "examples": [
                                            {
                                                "example_id": "25f1603b-0757-474c-bf70-6af738eef018",
                                                "sense_id": "9916b804-eb1a-3de6-a7ed-9203149b84db",
                                                "text": "Genetically modified crops."
                                            },
                                            {
                                                "example_id": "b48cc69b-7ba1-4374-a393-a0e56ea24a4b",
                                                "sense_id": "9916b804-eb1a-3de6-a7ed-9203149b84db",
                                                "text": "John Smith is genetically related to Jane Doe."
                                            },
                                            {
                                                "example_id": "e51fd87a-50e0-49dd-813d-3ac70c22cd85",
                                                "sense_id": "9916b804-eb1a-3de6-a7ed-9203149b84db",
                                                "text": "Moreover, in the framework of the Turkish campaign against cousin marriage, the MZD is considered as dangerous as the FBD in terms of genetic risk. Nevertheless, many Alawi informants maintain that the MZD is genetically the least[…]"
                                            },
                                            {
                                                "example_id": "860d3c3c-180f-47b8-a956-385e94649686",
                                                "sense_id": "9916b804-eb1a-3de6-a7ed-9203149b84db",
                                                "text": "As one of the largest producers of genetically modified (GM) seeds in the country, Monsanto has been vilified by activists who describe GM products as 'frankenfood.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599d41a9-6e70-3801-82f3-629b2e63322e",
                                        "entry_id": "676de4c1-e4f6-3fb5-ad17-512ee93e0613",
                                        "glosses": [
                                            "In terms of origin or development."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20e6212b-ddb0-40e1-a65e-aebb440571e9",
                                                "sense_id": "599d41a9-6e70-3801-82f3-629b2e63322e",
                                                "text": "Hildebrandt is certainly right in maintaining that all dream-images could be explained genetically, if we spent sufficient time and concentration on tracing their origin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a211dfe-c20d-3bf8-a2a0-b063b672caeb",
                                        "entry_id": "676de4c1-e4f6-3fb5-ad17-512ee93e0613",
                                        "glosses": [
                                            "By being members of the same linguistic family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
