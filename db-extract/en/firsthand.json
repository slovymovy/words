        "zh-extract.jsonl": [
            {
                "entry_id": "6a43a171-a685-363a-9d10-88a15a1c0297",
                "word": "firsthand",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                        "entry_id": "6a43a171-a685-363a-9d10-88a15a1c0297",
                        "glosses": [
                            "一手的，直接的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c9c33b-85f3-42f0-bbfa-e48dcbcc8e61",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "firsthand knowledge",
                                "translation": "第一手知识"
                            },
                            {
                                "example_id": "33d8a869-1563-4ced-aa2b-1ce3d9b00467",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "I recently received a firsthand report from an old friend — John A. Keel — who until last year was as skeptical a newshound as I have known."
                            },
                            {
                                "example_id": "cd74c18e-a2d0-4976-9ff0-45f08d72964e",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "Ours is a generation of aromantics, jaded about matters of the heart — often before gaining firsthand experience."
                            },
                            {
                                "example_id": "1a4c248d-54be-463b-a0dd-a4f648887cda",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "1990 March, Cliff Gromer, Firsthand Report: Yamaha WaveRunner III, Popular Mechanics."
                            },
                            {
                                "example_id": "8de73e8a-8104-43c7-9a41-351655b26a3b",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "Given Mr. Kissinger’s firsthand experience in the anguishing decisions about withdrawal from Vietnam, the disclosure sparked the inevitable Iraq-Vietnam comparisons that Mr. Bush has assiduously sought to avoid."
                            },
                            {
                                "example_id": "b6aa8b43-f0d5-4319-b42b-5996b5b61e0e",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "But in his strongest criticism yet of the superdatabase, Sir Ken Macdonald, the former director of public prosecutions, who has firsthand experience of working with intelligence and law enforcement agencies, told the Guardian such assurances would prove worthless in the long run..."
                            },
                            {
                                "example_id": "8c68b862-b368-4c4f-8689-f34b4594b94f",
                                "sense_id": "cbec0272-2224-3cf2-8df8-898094620cf9",
                                "text": "The same sort of doublethink is evident in the White House’s treatment of firsthand impeachment witnesses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c51cb8fc-daba-3b7b-a865-75793201df53",
                        "entry_id": "6a43a171-a685-363a-9d10-88a15a1c0297",
                        "glosses": [
                            "全新的，未使用过的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a9e689-2809-4362-aff2-9e9e497f1487",
                                "sense_id": "c51cb8fc-daba-3b7b-a865-75793201df53",
                                "text": "a firsthand copy"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "8730c2fe-915c-425e-a489-9f1506fe0305",
                        "source_entry_id": "6a43a171-a685-363a-9d10-88a15a1c0297",
                        "source_sense_ids": [],
                        "source_sense_description": "一手的，直接的",
                        "linkage_type": "synonyms",
