{
    "word_family": [
        "tough",
        "toughness",
        "toughie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7499af84-99b0-3a7d-9cb8-9a25fc534616",
                    "sense_definition": "To make something or someone stronger, more resilient, or more resistant to difficulty or wear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new training program is designed to <w>toughen</w> the athletes before the competition.",
                            "target_lang_translations": {
                                "ru": "Новая программа тренировок разработана, чтобы <w>закалить</w> спортсменов перед соревнованиями."
                            }
                        },
                        {
                            "text": "The government decided to <w>toughen</w> laws against environmental pollution.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>ужесточить</w> законы против загрязнения окружающей среды."
                            }
                        },
                        {
                            "text": "Exposure to harsh weather will <w>toughen</w> skin over time.",
                            "target_lang_translations": {
                                "ru": "Воздействие суровой погоды со временем поможет <w>укрепить</w> кожу."
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthen",
                        "harden",
                        "fortify",
                        "reinforce"
                    ],
                    "antonyms": [
                        "weaken",
                        "soften"
                    ],
                    "common_phrases": [
                        "toughen laws",
                        "toughen skin",
                        "toughen resolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо или кого-либо сильнее, выносливее или устойчивее к трудностям или износу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужесточать",
                                "target_lang_sense_clarification": "о законах, правилах или мерах"
                            },
                            {
                                "target_lang_word": "закалять",
                                "target_lang_sense_clarification": "о характере, организме или человеке"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать более прочным или стойким"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c2a973-117d-362d-b154-48c635ae4f61",
                    "sense_definition": "To become stronger, more resilient, or more resistant to difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the winter progressed, the young hikers began to <w>toughen</w> up.",
                            "target_lang_translations": {
                                "ru": "По мере того как зима вступала в свои права, молодые туристы начали <w>закаляться</w>."
                            }
                        },
                        {
                            "text": "The clay will <w>toughen</w> as it dries in the sun.",
                            "target_lang_translations": {
                                "ru": "Глина будет <w>твердеть</w> по мере высыхания на солнце."
                            }
                        }
                    ],
                    "synonyms": [
                        "harden",
                        "strengthen"
                    ],
                    "antonyms": [
                        "weaken"
                    ],
                    "common_phrases": [
                        "toughen up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться сильнее, выносливее или устойчивее к трудностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закаляться",
                                "target_lang_sense_clarification": "становиться физически или морально сильнее"
                            },
                            {
                                "target_lang_word": "твердеть",
                                "target_lang_sense_clarification": "о материалах, становящихся прочными"
                            },
                            {
                                "target_lang_word": "крепнуть",
                                "target_lang_sense_clarification": "становиться более крепким"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}