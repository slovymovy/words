                        "source_sense_id": "0f9944b0-09ab-3255-9414-cda26e7a29c1",
                        "target_lang_word": "re-equipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "re-equipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef9bd06-a4e6-3067-8b9a-400289ac7f40",
                                        "entry_id": "6aed5408-5619-3ac5-bbb3-0c1e24edc605",
                                        "glosses": [
                                            "Alternative form of reequipment."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5588a8-cba7-4d5d-b7bc-53d24084c412",
                                                "sense_id": "5ef9bd06-a4e6-3067-8b9a-400289ac7f40",
                                                "text": "They seem to fall well below the 100 m.p.h. standard of running so confidently promised when the 1955 modernisation and re-equipment plan was first made public by the British Transport Commission."
                                            },
                                            {
                                                "example_id": "1b8f6aa7-16b0-4b8a-9dce-c80cca5913f2",
                                                "sense_id": "5ef9bd06-a4e6-3067-8b9a-400289ac7f40",
                                                "text": "The decade [1980s] was also one of re-equipment. More HSTs arrived, West Coast Main Line services received Mk 3 coaches, and the second generation of DMUs entered traffic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
