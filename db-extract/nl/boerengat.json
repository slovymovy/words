                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4ffeb9f4-f844-47ea-bbf0-cb4042e06f8e",
                                "sense_id": "ea778bd3-cd1c-3ade-a3a4-7f7bb863e098",
                                "text": "„Het is natuurlijk toch een beetje een boerengat, om te winkelen en leuk uit te gaan moet ik naar Asuncion en dat is toch 500 kilometer verderop.”"
                            },
                            {
                                "example_id": "438c0628-ed91-4cb4-b9b2-0c19d4f64cf4",
                                "sense_id": "ea778bd3-cd1c-3ade-a3a4-7f7bb863e098",
                                "text": "Nadat de commune in India in het vizier van de autoriteiten was gekomen, verhuisde het hele gezelschap naar een boerengat in Oregon, in de VS. Daar kochten ze een ranch die ze omdoopten tot Rajneeshpuram. Het idee was om er een vreedzame, ecologische gemeenschap uit de bouwen."
                            }
                        ]
                    }
