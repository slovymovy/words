                                        "sense_id": "0723cafa-a6d9-3461-bbdb-ac257a4512d0",
                                        "entry_id": "490c26c5-8bb2-3931-8a2a-a430050fae03",
                                        "glosses": [
                                            "Heiligung, Aufwertung einer Person oder Sache durch eine rituelle Zeremonie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72e9148-056a-4c3e-89b8-640286989c13",
                                                "sense_id": "0723cafa-a6d9-3461-bbdb-ac257a4512d0",
                                                "text": "Die Weihe der neuen Kirche findet Ostern statt."
                                            },
                                            {
                                                "example_id": "596dbbfd-fe67-4897-9740-f64d3199bd99",
                                                "sense_id": "0723cafa-a6d9-3461-bbdb-ac257a4512d0",
                                                "text": "Der Bischof ist jetzt bereit zur Weihe der Priester."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c5b5c23-986c-3cab-a466-19e6c6962429",
                                        "entry_id": "490c26c5-8bb2-3931-8a2a-a430050fae03",
                                        "glosses": [
                                            "Erhabenheit, Würde und heiliger Ernst"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1656870a-ac4c-407e-b7ef-83bfd9486cf7",
                                                "sense_id": "6c5b5c23-986c-3cab-a466-19e6c6962429",
                                                "text": "\"Der Jesus von Nazareth, der als Messias auftrat, die Sittlichkeit des Gottesreiches verkündete, das Himmelreich auf Erden gründete und starb, um seinem Werke die Weihe zu geben, hat nie existiert. Es ist eine Gestalt, die vom Rationalismus entworfen, vom Liberalismus belebt und von der modernen Theologie in ein geschichtliches Gewand gekleidet wurde.\" (Albert Schweitzer)"
                                            },
                                            {
                                                "example_id": "9cd9b177-b471-4f38-a4a0-49b44c2bb794",
                                                "sense_id": "6c5b5c23-986c-3cab-a466-19e6c6962429",
                                                "text": "Die Teilnahme des Bischofs verleiht der Veranstaltung eine höhere Weihe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
