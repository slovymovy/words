{
    "word_family": [
        "distraction",
        "distraitement",
        "distrayant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fae1b7c-7570-304a-8fda-073d657b9e89",
                    "sense_definition": "Détourner l'attention ou la concentration de quelqu'un de ce qu'il est en train de faire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit de la circulation finit par le <w>distraire</w> pendant ses révisions."
                        },
                        {
                            "text": "Éteins la télévision pour ne pas te laisser <w>distraire</w> par ces images."
                        }
                    ],
                    "synonyms": [
                        "déconcentrer",
                        "perturber"
                    ],
                    "antonyms": [
                        "concentrer"
                    ],
                    "common_phrases": [
                        "distraire l'attention",
                        "se laisser distraire"
                    ]
                },
                {
                    "sense_id": "2723a676-30d8-36b7-b137-b77a35932e82",
                    "sense_definition": "Divertir quelqu'un en lui faisant passer un moment agréable pour lui changer les idées.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divertissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce spectacle de magie a réussi à <w>distraire</w> les enfants tout l'après-midi."
                        },
                        {
                            "text": "Ses amis ont tout essayé pour le <w>distraire</w> après cette triste nouvelle."
                        }
                    ],
                    "synonyms": [
                        "amuser",
                        "divertir"
                    ],
                    "antonyms": [
                        "ennuyer"
                    ],
                    "common_phrases": [
                        "distraire un enfant",
                        "distraire les esprits"
                    ]
                },
                {
                    "sense_id": "8ba6404e-4988-3bb1-b0a3-b0df99a95141",
                    "sense_definition": "S'accorder un moment de loisir ou de récréation pour s'amuser et se détendre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divertissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue semaine de travail, elle aime se <w>distraire</w> au cinéma."
                        },
                        {
                            "text": "Il lit quelques pages chaque soir simplement pour se <w>distraire</w> un peu."
                        }
                    ],
                    "synonyms": [
                        "s'amuser",
                        "se divertir"
                    ],
                    "antonyms": [
                        "s'ennuyer"
                    ],
                    "common_phrases": [
                        "chercher à se distraire",
                        "moyen de se distraire"
                    ]
                },
                {
                    "sense_id": "1ed1cda1-c48f-3dfb-8f05-4287a4cf773c",
                    "sense_definition": "Séparer, prélever ou retrancher une part d'un tout, notamment dans un contexte juridique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a dû <w>distraire</w> cette parcelle du reste de la propriété familiale."
                        },
                        {
                            "text": "Le tribunal a ordonné de <w>distraire</w> plusieurs biens de la procédure de saisie."
                        }
                    ],
                    "synonyms": [
                        "détacher",
                        "prélever",
                        "retrancher"
                    ],
                    "antonyms": [
                        "joindre",
                        "rattacher"
                    ],
                    "common_phrases": [
                        "distraire une somme",
                        "distraire une parcelle"
                    ]
                }
            ]
        }
    ]
}