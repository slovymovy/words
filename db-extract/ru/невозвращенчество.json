                    },
                    {
                        "translation_id": "a03ae795-7201-434b-b505-11f6be2634ff",
                        "source_entry_id": "9b5accbe-5f9f-3414-90a6-fde4d4b4255c",
                        "source_sense_id": "825c51ae-7655-338c-86a8-3990c5ffcbd7",
                        "target_lang_word": "Abfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "der bei der Verwendung oder Verarbeitung übrig gebliebene Rest (auch im übertragenen Sinn)"
                                        ],
                                        "tags": [
                                            "Hauswirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93943d77-c0d7-454d-b396-f8f42d6c1a04",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "Kannst du bitte den Abfall nach unten bringen?"
                                            },
                                            {
                                                "example_id": "9d3b9198-1d85-446d-ae80-79daf8c8a4a7",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "Nach manchem Abfall werden wir uns recken, um Wertstoffe zu entdecken, wenn die Rohstoffe verrecken."
                                            },
                                            {
                                                "example_id": "6bb20a75-4d71-4bb5-83a2-aebc0c8469fe",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "„Die sogenannten banalen Abfälle sind mit den Haushaltsabfällen zu vergleichen, kommen jedoch aus der Industrie.“"
                                            },
                                            {
                                                "example_id": "b0f3a476-9202-4023-8b70-979afd83904c",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "„Zwischen den 1950er und 80er Jahren wurde nuklearer Abfall als günstige und einfache Lösung im Ozean verklappt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "das (unauffällige) Schwinden der Verbindung zu – oder die (ausdrückliche) Lossagung von – einer Lehre, Religion, politischen Partei oder Richtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efaceb8-8939-4e0a-b96e-6340da318d0a",
                                                "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                                "text": "Sein Meinungswandel kam einem Abfall von seinem Glauben gleich."
                                            },
                                            {
                                                "example_id": "75a630b8-28d4-47a4-97e4-f6c2c93341f3",
                                                "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                                "text": "„O Gott, halt uns bei dieser Lehr, dem Irrtum und dem Abfall wehr!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86fd8edc-c770-3564-9bad-2b4990e5188f",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "starke abfallende Neigung im Geländeprofil"
                                        ],
                                        "tags": [
                                            "Geländeform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94674c32-be1a-4264-bc29-7bc478aba2c0",
                                                "sense_id": "86fd8edc-c770-3564-9bad-2b4990e5188f",
                                                "text": "Dann folgt ein steiler Abfall im Gelände."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a4ad8254-f6c1-3b1f-9fc9-693c011faf50",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "die Abnahme, das Geringerwerden eines Wertes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a99d78-7d53-4f53-861f-7252aab61d16",
                                                "sense_id": "a4ad8254-f6c1-3b1f-9fc9-693c011faf50",
                                                "text": "Mit diesem Abfall der Turbinenleistung hat der Hersteller nicht gerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
