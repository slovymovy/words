                "senses": [
                    {
                        "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                        "entry_id": "1a3f135a-7923-32f4-ba51-0accd915f942",
                        "glosses": [
                            "weibliche Person, die Angehörige/Expertin im 'Sachverständigenrat zur Begutachtung der gesamtwirtschaftlichen Entwicklung' ist"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f1a093-338f-41b9-94b8-32b356949a76",
                                "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                                "text": "„2020 wurde Grimm zusammen mit Monika Schnitzer als sogenannte Wirtschaftsweise in den Sachverständigenrat zur Begutachtung der gesamtwirtschaftlichen Entwicklung berufen.“"
                            },
                            {
                                "example_id": "9ae1ace9-5879-41ad-be7b-4e1c9790b92a",
                                "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                                "text": "„Von einem Embargo auf russisches Gas rät die Wirtschaftsweise ab.“"
                            },
                            {
                                "example_id": "794dc510-89fb-4357-b634-5fba43aa17a3",
                                "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                                "text": "„Man dürfe den Benzinpreis nicht künstlich niedrig halten und damit Preissignale verzerren, warnte die Wirtschaftsweise Monika Schnitzer, Professorin für Wirtschaftsforschung an der Universität München.“"
                            },
                            {
                                "example_id": "5f20c164-75ac-45d4-87fa-4ef34455fca0",
                                "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                                "text": "„Um den Fachkräftemangel anzugehen, braucht es aus Sicht der Wirtschaftsweisen Monika Schnitzer 1,5 Millionen Zuwanderer pro Jahr.“"
                            },
                            {
                                "example_id": "079e3f58-3e5b-446d-a7c8-bb7f107b434f",
                                "sense_id": "b1f5baf2-2825-3988-afad-1ab0da5ad6c9",
                                "text": "„Die Wirtschaftsweise Grimm kritisiert, dass die Klimaschutzziele nicht erreicht würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
