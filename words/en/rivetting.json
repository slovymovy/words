                    "sense_id": "dbd14be2-f986-342f-9a11-299ed8dc46c8",
                    "sense_definition": "Alternative spelling of <w>riveting</w>, referring to the process or act of joining parts with rivets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structure failed because the <w>rivetting</w> was not done to standard specifications.",
                            "target_lang_translations": {
