                "senses": [
                    {
                        "sense_id": "80e1136b-ff04-36c1-b022-b8e926a8a09d",
                        "entry_id": "b00e4e27-e8cf-3006-b10f-b76a99241bad",
                        "glosses": [
                            "vrouw die het beheer heeft over contant geld en de kaswijzigingen bijhoudt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "451f088c-1079-48f4-8712-433d7812ae1c",
                                "sense_id": "80e1136b-ff04-36c1-b022-b8e926a8a09d",
                                "text": "De kassierster zette zonder pardon het bordje \"gesloten\" voor mijn neus en ging naar huis."
                            },
                            {
                                "example_id": "b708ff5c-600b-4c91-bde7-94577aba7249",
                                "sense_id": "80e1136b-ff04-36c1-b022-b8e926a8a09d",
                                "text": "Terwijl mijn broer en zijn vrienden op de brandkast achter in de bank afliepen, hield ik de mensen op de grond onder controle, vooral de kassierster die bang was geweest voor haar mantelpakje, want haar benen stonden me wel aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdf98334-96c7-394d-90e7-f13d37865150",
                        "entry_id": "b00e4e27-e8cf-3006-b10f-b76a99241bad",
                        "glosses": [
                            "vrouw of meisje met de taak de betalingen van klanten in een winkel of amusementsbedrijf te verwerken"
                        ],
                        "tags": [
                            "beroep",
                            "Belgisch-Nederlands"
                        ],
                        "examples": [
                            {
                                "example_id": "658ffaac-08bc-483e-a96f-a00565967a0a",
                                "sense_id": "fdf98334-96c7-394d-90e7-f13d37865150",
                                "text": "Gisterenavond heeft een gemaskerde overvaller een kassierster bedreigd met een mes. Dat gebeurde in de Carrefour Market in Donk bij Herk-de-Stad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0586bd20-dfa0-4da1-90f4-8b614f0eeab7",
                        "source_entry_id": "b00e4e27-e8cf-3006-b10f-b76a99241bad",
                        "source_sense_id": "80e1136b-ff04-36c1-b022-b8e926a8a09d",
                        "source_sense_description": "vrouw die het beheer heeft over contant geld en de kaswijzigingen bijhoudt",
                        "target_lang_word": "Kassiererin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kassiererin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                        "entry_id": "97af040c-751c-3283-acc2-9eaa1932bbda",
                                        "glosses": [
                                            "die Kasse Führende, Verwalterin der Kasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c061433a-2679-4cad-b909-2df52911a236",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "An dieser Packung klebt kein Preisschild. Ich werde die Kassiererin nach dem Preis fragen."
                                            },
                                            {
                                                "example_id": "2f5c684c-c42e-40b2-912e-fafa75cf1600",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Kassiererin am Tresen sagte mir, dass der samische Tanzabend abgesagt wurde, der dort am kommenden Wochenende stattfinden sollte.“"
                                            },
                                            {
                                                "example_id": "1680351d-88fb-48f8-8621-78c76795e504",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Mundbewegungen der Kassiererin kann Eos wegen der Entfernung nicht erkennen, und Anrath wendet ihr meistens den Rücken zu.“"
                                            },
                                            {
                                                "example_id": "587ebacf-3196-45f4-9595-94cddd3f2eb7",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Kassiererin, keine aus dem Dorf, sah kaum auf.“"
                                            },
                                            {
                                                "example_id": "73be57cc-6b04-408f-9fe5-824303a067ca",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Der Strichcode nutzt uns Verbrauchern ganz direkt: Wenn die Kassiererin im Supermarkt einen Artikel scannt, dann wird dabei automatisch die Prüfziffer kontrolliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
