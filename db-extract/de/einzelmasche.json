                ],
                "senses": [
                    {
                        "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                        "entry_id": "50fd71f0-5c73-350d-a9b0-da401025e9a5",
                        "glosses": [
                            "kleinstmögliche Fadenverbindungseinheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bfd0fd9-26e7-47a8-846f-130ca4491c63",
                                "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                                "text": "„Hat der Wirkstoff eine Breite von 2000 Einzelmaschen, so muß man 2000 Fäden für die Kette verwenden.“"
                            },
                            {
                                "example_id": "5675bad9-33cc-4775-aa22-3fbec54f6229",
                                "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                                "text": "„Beim Wirkprozeß kommen neuerliche Spannungen in die Ware; die Einzelmaschen befinden sich in einem unterschiedlichen Spannungszustand.“"
                            },
                            {
                                "example_id": "a3de1165-df8b-400f-911c-c54a4835cb41",
                                "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                                "text": "„Hier gilt die Devise: Nicht Einzelmaschen stricken, sondern gemeinsam das Muster entwerfen.“"
                            },
                            {
                                "example_id": "242da03a-fb69-4c06-aa4d-f02cff4989de",
                                "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                                "text": "„Daher haben norwegische Pullover und Jacken mit großen Schulterbordüren im (eigentlich) einfarbigen Rumpfteil oft andersfarbige Einzelmaschen.“"
                            },
                            {
                                "example_id": "5b5ec1d3-6c12-45b1-a703-ad0945731b2a",
                                "sense_id": "dd1a1713-7322-3d35-bf57-98bf4a4f663a",
                                "text": "„Streuselmuster entstehen durch regelmäßig wiederholte Einzelmaschen oder kleine Maschengruppen in einer zweiten Farbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
