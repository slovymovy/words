                "senses": [
                    {
                        "sense_id": "288b6b94-a3ec-3561-988a-bc6fec9ab7e6",
                        "entry_id": "606f1a44-fdb4-3b48-9c9f-7fd16c716c62",
                        "glosses": [
                            "tłumacz, przewodnik i pośrednik między cudzoziemcami a mieszkańcami Bliskiego Wschodu"
                        ],
                        "tags": [
