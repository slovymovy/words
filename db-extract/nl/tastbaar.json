                        "sense_id": "5f3715e3-9e98-3469-b168-ae3ce86a58ef",
                        "entry_id": "0b31ed37-784f-3307-82c2-0b1f9ab6d8e6",
                        "glosses": [
                            "voelbaar, duidelijk zichtbaar, substantieel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58385763-4a32-44b8-a278-18a0fd966e1e",
                                "sense_id": "5f3715e3-9e98-3469-b168-ae3ce86a58ef",
                                "text": "De directeur eiste tastbare resultaten van zijn personeel."
                            },
                            {
                                "example_id": "6ec022e2-322b-4f6b-87e2-dad3e69ed04e",
                                "sense_id": "5f3715e3-9e98-3469-b168-ae3ce86a58ef",
                                "text": "Financieel psycholoog Anne Abbenes begrijpt waarom veel jongeren verkoopautomaten aanschaffen en bij bedrijven plaatsen. \"In tegenstelling tot het investeren in crypto is een verkoopautomaat iets heel tastbaars. Je ziet duidelijk wanneer de machine je geld oplevert en dat kan vooral voor jongeren een verstandige keuze zijn.\""
                            }
                        ]
                    }
                ],
