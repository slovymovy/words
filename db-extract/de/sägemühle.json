                        "entry_id": "da28ab22-b890-3338-9c23-c736fc58b649",
                        "glosses": [
                            "ein durch Wasser oder Windkraft angetriebenes Sägewerk, das Bretter und Balken herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a498159-9d2f-4b82-85fe-517bb23bbc1c",
                                "sense_id": "fbc8e2d7-ef54-32a6-b74e-17f5dc8ba2ff",
                                "text": "Die Sägemühle in Edane hat das beste Angebot gemacht, dorthin werden wir das Holz verkaufen."
                            },
                            {
                                "example_id": "684cfbb8-dba3-4d29-a93a-df98841402ec",
                                "sense_id": "fbc8e2d7-ef54-32a6-b74e-17f5dc8ba2ff",
                                "text": "„Der Ingenieur hatte am Wasserfall eine einfache Sägemühle aufgestellt, gegen Ende des Monats war das Rippenwerk schon fertiggestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
