                "senses": [
                    {
                        "sense_id": "0fc31375-b4fa-31c5-b7f6-eed429ab8b9f",
                        "entry_id": "12f7c4b5-76a9-3392-b028-ce2cfd5f372f",
                        "glosses": [
                            "Verfahren, bei dem man einen schriftlichen Text kontrolliert liest, dabei unterschiedlich betont und damit verschiedene Interpretationsmöglichkeiten gegeneinander abwägt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea9c048-da0d-4f1c-89e2-1efe7a34f4af",
                                "sense_id": "0fc31375-b4fa-31c5-b7f6-eed429ab8b9f",
                                "text": "„Klangprobe: Da von geschriebenen Texten ausgegangen wird, werden durch klangähnliche Realisierung die kleinsten (relativ) selbständigen Einheiten ermittelt…“"
                            },
                            {
                                "example_id": "5cf32f7e-3781-4a28-803d-8ead8650b838",
                                "sense_id": "0fc31375-b4fa-31c5-b7f6-eed429ab8b9f",
                                "text": "Bei dem Satz \"Der kleine Junge ist sehr krank\" kann man mit der Klangprobe unterschiedliche Wörter betonen und dadurch verschiedene Lesarten erzeugen: \"Dér kleine Junge ist sehr krank\" bedeutet etwas anderes als \"Der kleine Junge íst sehr krank.\""
                            },
                            {
                                "example_id": "b00a9a1b-19ee-45f7-8ecc-9d86d24be9a9",
                                "sense_id": "0fc31375-b4fa-31c5-b7f6-eed429ab8b9f",
                                "text": "Die Klangprobe ist ein operationales Verfahren der Analyse von Interpretationsmöglichkeiten von Texten."
                            },
                            {
                                "example_id": "d8883305-760f-4679-a7ef-b91e8715c127",
                                "sense_id": "0fc31375-b4fa-31c5-b7f6-eed429ab8b9f",
                                "text": "„Bei der Klangprobe wird ein schriftlicher Text in gesprochene Sprache umgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "863550f8-0da6-3882-bb28-2308207d982a",
                        "entry_id": "12f7c4b5-76a9-3392-b028-ce2cfd5f372f",
                        "glosses": [
                            "probeweises Spielen eines Instruments oder Geräts, um seine Klangqualität oder die des betreffenden Raums zu prüfen oder zu verbessern."
                        ],
                        "tags": [
