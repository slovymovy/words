                                "target_senses": [
                                    {
                                        "sense_id": "25dec137-31f8-31b7-b05a-cc7611ff75e7",
                                        "entry_id": "b076c65e-d5a9-38da-9e73-15aa811de4ac",
                                        "glosses": [
                                            "Hauptstadt von Mexiko"
                                        ],
                                        "tags": [],
