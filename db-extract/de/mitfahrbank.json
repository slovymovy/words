                "senses": [
                    {
                        "sense_id": "1d43b3dd-01a5-3050-a453-8611913e510b",
                        "entry_id": "4c33b7e0-0341-37cb-a73c-1397e63c551f",
                        "glosses": [
                            "Sitzgelegenheit, auf der man warten kann, bis eine Mitfahrgelegenheit eintrifft"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "446d5132-7d3e-4fec-978c-a99c0baaf4ab",
                                "sense_id": "1d43b3dd-01a5-3050-a453-8611913e510b",
                                "text": "„Per Anhalter fahren, ohne den Daumen rausstrecken zu müssen: Diese Chance hat, wer auf der Mitfahrbank Platz nimmt.“"
                            },
                            {
                                "example_id": "0366e86a-1df8-4b9f-b43c-473f509b10ac",
                                "sense_id": "1d43b3dd-01a5-3050-a453-8611913e510b",
                                "text": "„Eine Mitfahrbank gibt es in der Region beispielsweise in Schondorf.“"
                            },
                            {
                                "example_id": "de233330-dc12-4260-8a02-d4d90293d1c6",
                                "sense_id": "1d43b3dd-01a5-3050-a453-8611913e510b",
                                "text": "„An den verwaisten Haltestellen stehen seit drei Wochen sogenannte Mitfahrbänke, auf denen all jene warten können, die zum Einkaufen oder für Arzttermine doch mal in die Stadt müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
