                "senses": [
                    {
                        "sense_id": "7ec83da9-3a37-3c4b-8339-fed37bab77b9",
                        "entry_id": "3cfa8e0f-929e-345b-b694-54960799b77f",
                        "glosses": [
                            "Eigenschaft, schwank/unsicher zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48630695-00f6-4088-a57a-4342890eaac1",
                                "sense_id": "7ec83da9-3a37-3c4b-8339-fed37bab77b9",
                                "text": "„Ein Trost nur, daß Joseph eben so jung war; seine Schwankheit würde sich festigen, robuster und ständiger werden, zur Ehrbarkeit reifen im Gottesverstande.“"
                            },
                            {
                                "example_id": "35e9e1bd-bf7e-411e-99a8-2520bc03b64a",
                                "sense_id": "7ec83da9-3a37-3c4b-8339-fed37bab77b9",
                                "text": "„Doch Josephs Träume, das fühlte der Alte, konnten es brauchen, in genaue Zucht genommen zu werden durchs Buchstäblich-Vernünftige, – das konnte zur Festigung seiner Schwankheit segensreich beitragen, und mit gehörnten Nacktläufern und Geiferern würde er, der Gebildete, keine Ähnlichkeit haben.“"
                            }
                        ],
