                "senses": [
                    {
                        "sense_id": "72a6f0d7-079a-364d-9ac1-d05483c5aa4d",
                        "entry_id": "5420c61e-8de9-31e3-b598-f64d6b1e57ba",
                        "glosses": [
                            "Sondersprache, die der Abschottung gegenüber Außenstehenden dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081e4042-04f3-4fd8-b4b9-4c3da56a5c1a",
                                "sense_id": "72a6f0d7-079a-364d-9ac1-d05483c5aa4d",
                                "text": "„Vielfach könnte man dabei, in Anlehnung an den von Yinger eingeführten Begriff der Kontrakultur von Kontrasprachen reden.“"
                            },
                            {
                                "example_id": "d2aeee2e-650f-4396-9485-a98a9b78c664",
                                "sense_id": "72a6f0d7-079a-364d-9ac1-d05483c5aa4d",
                                "text": "„Kontrasprachen liegen dann vor, wenn man sich ohne objektive Geheimhaltungsgründe von der Gesellschaft und ihrer Ordnung absetzen will, als äußeres Anzeichen der Sonderung…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
