                ],
                "senses": [
                    {
                        "sense_id": "92b9b27d-61d1-3980-9014-81bda51add8e",
                        "entry_id": "1db32694-1790-3100-a3d9-776cb5ee31a7",
                        "glosses": [
                            "Trinkgefäß, gefertigt aus einem Birkenstamm"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4eca639c-d705-4777-8611-796da9badfda",
                                "sense_id": "92b9b27d-61d1-3980-9014-81bda51add8e",
                                "text": "„Der Laienbruder, der versah getreulich das Amt des Mundschenken, aus einer großen, hölzernen zunftreich mit geschnitztem Bildwerk verzierten Kanne von Birkenholz, welche damals scherzweise ein Birkenmeier genannt wurde.“"
                            },
                            {
                                "example_id": "1903b5c7-34e1-433f-ac2a-9b145b2a6141",
                                "sense_id": "92b9b27d-61d1-3980-9014-81bda51add8e",
                                "text": "„Pitcher ist ein Trinkgeschirr, ursprünglich wohl mehr ein Birkenmeier, Stübchen und Schleiskanne, als Krug.“"
                            },
                            {
                                "example_id": "281088ad-c8b2-4e56-8bbd-df662ab3779f",
                                "sense_id": "92b9b27d-61d1-3980-9014-81bda51add8e",
                                "text": "„Er trank sogleich zum Willkommen drei Birkenmeier aus, warf sich zum Vorsänger auf, und nahm von Theodor im Winkel gar keine Notiz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
