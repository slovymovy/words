                ],
                "senses": [
                    {
                        "sense_id": "d33810f8-484d-3a48-a705-5b4d8667e0b5",
                        "entry_id": "c3b37ba0-5fbf-3ec9-8da8-f40a4423cff2",
                        "glosses": [
                            "relative Höhe/Tiefe der Stimme beim Sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55088625-b857-499e-b3c5-24a5d395c13e",
                                "sense_id": "d33810f8-484d-3a48-a705-5b4d8667e0b5",
                                "text": "„Spricht der andere bedächtig und mit sonorer Stimmlage und macht er lange Pausen, dann spricht man ebenfalls bedächtig und mit sonorer Stimmlage und macht auch lange Pausen.“"
                            },
                            {
                                "example_id": "822df000-1dc9-4675-9ced-cd2df5605dac",
                                "sense_id": "d33810f8-484d-3a48-a705-5b4d8667e0b5",
                                "text": "Dem Chor fehlen noch einige Sänger mit tiefer Stimmlage."
                            },
                            {
                                "example_id": "8d96b0f1-4966-462c-8cef-466128ef517d",
                                "sense_id": "d33810f8-484d-3a48-a705-5b4d8667e0b5",
                                "text": "„Ich versuchte, ruhig zu klingen, aber ich kannte diesen Blick, ich kannte die Stimmlage und jetzt auch noch ihre Atemnot.“"
                            },
                            {
                                "example_id": "afb4dafa-5cbc-42ca-8348-cef27d174145",
                                "sense_id": "d33810f8-484d-3a48-a705-5b4d8667e0b5",
                                "text": "„Und die Stimmlage ist ihm mehr als vertraut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
