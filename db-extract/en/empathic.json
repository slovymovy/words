                                    {
                                        "sense_id": "839a5e4f-e142-3d3d-9a4e-1de0d76c834b",
                                        "entry_id": "979ce944-ef47-34a5-93fe-f0ca55513c0a",
                                        "glosses": [
                                            "Empathie zeigend; Mitgefühl habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2410e6bf-0cd0-4831-8e4c-26da270e8729",
                                                "sense_id": "839a5e4f-e142-3d3d-9a4e-1de0d76c834b",
                                                "text": "„Empathische Eltern können das eigene Einfühlungsvermögen an ihre Kinder weitergeben – und diese wiederum an ihren späteren Nachwuchs. Das zeigt eine Langzeitstudie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63eb1f70-3ac5-402c-a976-e5696a0e2547",
                        "source_entry_id": "543a27bf-aee4-3cc6-93c8-dad21b665728",
                        "source_sense_description": "showing or expressing empathy",
                        "target_lang_word": "einfühlsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einfühlsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e62c8e67-ec25-3ba5-ab10-2ee3f9db744a",
                                        "entry_id": "4b73c46e-e35d-3d63-8eea-645066cdeee1",
                                        "glosses": [
                                            "jemandes Gefühle sehr gut verstehen könnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d239fab1-fe6d-4dfa-b00b-67fcffa6cb15",
                                                "sense_id": "e62c8e67-ec25-3ba5-ab10-2ee3f9db744a",
                                                "text": "Sie ist ein sehr einfühlsamer Mensch."
                                            },
                                            {
                                                "example_id": "14129951-40e6-4d7b-841d-080fa5e9e7f2",
                                                "sense_id": "e62c8e67-ec25-3ba5-ab10-2ee3f9db744a",
                                                "text": "„Christoph Seibert bringt es ans Licht: Die Vielfalt religiöser Erfahrung ist von keinem Philosophen so einfühlsam und reflektiert dargestellt worden wie von William James.“"
                                            },
                                            {
                                                "example_id": "796737c8-a4ef-4e78-836d-6cb74dc4f1a8",
                                                "sense_id": "e62c8e67-ec25-3ba5-ab10-2ee3f9db744a",
                                                "text": "„Maischberger gelingt es durch einfühlsames Fragen ihr Gegenüber ins Reden zu bringen.“"
                                            },
                                            {
                                                "example_id": "da900e4d-7222-49e4-bba5-adb2d7188d16",
                                                "sense_id": "e62c8e67-ec25-3ba5-ab10-2ee3f9db744a",
                                                "text": "„In einer einfühlsamen Rede gedenkt Neuseelands Premierministerin Ardern der Opfer des Anschlags von Christchurch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d94b98ac-7302-4074-b42f-bfd9a87271b4",
