                                "target_senses": [
                                    {
                                        "sense_id": "1100d21c-14bc-382c-97f9-cb9e7c14224a",
                                        "entry_id": "84c30908-acd7-3167-9032-43cca87a3fdc",
                                        "glosses": [
                                            "het weinige licht dat in de nacht beschikbaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673bf6c0-3648-4a79-b22d-b5f1fe8f92f2",
                                                "sense_id": "1100d21c-14bc-382c-97f9-cb9e7c14224a",
                                                "text": "De gevoerde gordijnen lieten niets van het weinige nachtlicht dat zich in de luchtkoker wist te verzamelen de slaapkamer binnen."
                                            },
                                            {
                                                "example_id": "67ce98d2-baca-4dda-9cf5-dc199cf3b034",
                                                "sense_id": "1100d21c-14bc-382c-97f9-cb9e7c14224a",
                                                "text": "In ons dagelijks leven komen we allerlei kleuren tegen, en zo leert ons brein ons hoe omgaan met de interpretatie daarvan in verschillende situaties. Het zou dus uit kunnen maken of je veel daglicht of 'nachtlicht' ziet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e4f00b7-ee5b-383c-9ee7-7117f31f6194",
                                        "entry_id": "84c30908-acd7-3167-9032-43cca87a3fdc",
                                        "glosses": [
                                            "lamp die 's-nachts brandt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b236d3ca-ca92-4d58-8936-1bac044a3d55",
                        "source_entry_id": "13a9d368-ff58-3c7a-aa14-0da2e672e859",
                        "source_sense_description": "a small, dim light or lamp left on overnight",
                        "target_lang_word": "veilleuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veilleuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "461ba326-9889-3bca-8127-aa91b0268656",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Celle qui veille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82f3f463-bdc7-340c-a137-b3cf817bbaa4",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Religieuse ou laïque qui veille un mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ecb644-2b23-41e2-912a-4c5ccca2c05e",
                                                "sense_id": "82f3f463-bdc7-340c-a137-b3cf817bbaa4",
                                                "text": "Mais les deux veilleuses avaient vu cet homme et avaient reconnu Thibault ; mais on entendait de grandes clameurs, où le nom de Thibault était mêlé."
                                            },
                                            {
                                                "example_id": "a0f4e150-b212-47e4-a321-e662b95059e6",
                                                "sense_id": "82f3f463-bdc7-340c-a137-b3cf817bbaa4",
                                                "text": "Garde-malade, sage-femme, et veilleuse des morts, recevant ceux qui viennent, recueillant leur premier cri, lavant de la première eau leur chair nouvelle, …."
                                            },
                                            {
                                                "example_id": "d52eea5f-c2a6-45e6-bdeb-5c6d6d8d3404",
                                                "sense_id": "82f3f463-bdc7-340c-a137-b3cf817bbaa4",
                                                "text": "Quand, vers quatre heures, je revenais de l’école, je trouvais rassemblées à la cuisine, près de ma grand-mère, trois ou quatre femmes, toujours les mêmes : Octavie, la mère de mon cousin Abel, la servante de la Grande et parfois une vieille aux gestes lents, à la voix douce, que l’on appelait la Veilleuse des morts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afbb19-f145-3afa-9989-1bfdff66975b",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Celle qui est de garde, de surveillance, spécialement la nuit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "142fe72d-877a-3ffb-b25e-eb93baf42387",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Veilleuse de nuit."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0423e647-6eb7-33d9-8372-680a9fbfae7e",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Salariée qui effectue de la veille stratégique en entreprise."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Petite lampe que l’on laisse allumée toute la nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ee4c32-4a6d-4bdf-9477-5c81cd023fec",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "Je tournai la tête du côté de la muraille ; mais, comme il me fut impossible de m’endormir, deux au trois fois je me retournai, et deux ou trois fois, à la lumière de ma veilleuse, je le vis dans le même fauteuil."
                                            },
                                            {
                                                "example_id": "4ca7a9cf-e7a4-49d3-835c-36d1ba289551",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "Vraiment, ce que nous appelons chez nous le soleil n’est à côté de cela qu’une pâle veilleuse à l’agonie sur la table de nuit d’un malade."
                                            },
                                            {
                                                "example_id": "b7ae2ba0-0691-4909-9319-3b270b9b7a7d",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "Sur la pointe des pieds, elle alla faire glisser les stores, puis alluma une veilleuse dont le cristal dépoli laissa tomber une nuée dans l’atmosphère."
                                            },
                                            {
                                                "example_id": "5fa7f638-cfee-4d3f-858e-dffc8b262e21",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "La mer a le charme des choses qui ne se taisent pas la nuit, qui sont pour notre vie inquiète une permission de dormir, une promesse que tout ne va pas s'anéantir, comme la veilleuse des petits enfants qui se sentent moins seuls quand elle brille."
                                            },
                                            {
                                                "example_id": "c3d54194-dd24-4455-9a2e-480a123f133b",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "L’on y voyait à peine, le sanctuaire n’étant éclairé que par des veilleuses pendues au plafond, des veilleuses couleur d’orange sanguine et d’or trouble."
                                            },
                                            {
                                                "example_id": "acaa4e10-b348-4b49-a57c-fdcd3bff62a7",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "La veilleuse éclairait Carmen d’une pâle lueur rose."
                                            },
                                            {
                                                "example_id": "d7619c0c-caec-4009-ae15-0112222f421a",
                                                "sense_id": "7ec2c1c1-ec0a-3084-a039-fc3f66588f78",
                                                "text": "Enfin — et ce n’était pas son moindre succès — Agata avait réussi à ôter les veilleuses dont la présence dans les églises de New York ne s’explique que par la panique du feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f08de72-22a7-39a5-86a9-862168c7ac42",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Petite mèche enduite de cire, qui brûle dans cette lampe et qui est maintenue sur l’huile par une petite rondelle de carton doublée de liège."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "968e8523-47ee-4ddb-be67-38485ad03617",
                                                "sense_id": "8f08de72-22a7-39a5-86a9-862168c7ac42",
                                                "text": "Dans un verre posé près de la pendule, une couche d’huile sur de l’eau supporte une rondelle de liège argenté et une courte mèche. C’est la veilleuse."
                                            },
                                            {
                                                "example_id": "3989f593-a564-4d74-bc95-146bc149c01e",
                                                "sense_id": "8f08de72-22a7-39a5-86a9-862168c7ac42",
                                                "text": "Acheter une boîte de veilleuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64929356-f9e0-38ea-aadb-110aec5bd3d0",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Phare de voiture dit aussi, feu de position."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13feedaa-1916-4d9f-bbc5-2a4a3ce5ff06",
                                                "sense_id": "64929356-f9e0-38ea-aadb-110aec5bd3d0",
                                                "text": "Elle […] éteint le moteur, mais laisse ses veilleuses allumées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfbb77d-5812-343b-b784-8ade834a30d0",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Flamme allumée en permanence et qui permet à un brûleur d’être allumé rapidement sans risque de fuite de gaz, par exemple dans une chaudière ou sur une torchère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20dcad8-89e4-4594-9257-4861dd27b7b7",
                                                "sense_id": "0cfbb77d-5812-343b-b784-8ade834a30d0",
                                                "text": "La torchère a été conçue pour pouvoir brûler le biogaz en tout temps. Pour ce faire, une veilleuse (petit brûleur) au propane reste allumée pendant, et seulement pendant que passe le biogaz."
                                            },
                                            {
                                                "example_id": "e7030d3b-5a30-4c24-ab72-8bb6668c3510",
                                                "sense_id": "0cfbb77d-5812-343b-b784-8ade834a30d0",
                                                "text": "La veilleuse est un élément important de la chaudière à gaz. Il s’agit de cette petite flamme bleue constamment allumée qui permet d’alimenter la maison en eau chaude et en chauffage. Si celle-ci s’éteint, c’est le signe d’un dysfonctionnement de l’équipement général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0000bab-ecf8-30ff-ada0-a37b9eb9aaef",
                                        "entry_id": "e913c79f-f36e-3c16-847e-b9e92fdfc1bf",
                                        "glosses": [
                                            "Synonyme de colchique."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19e3f3b-590b-4399-ae5c-863847086aba",
                                                "sense_id": "d0000bab-ecf8-30ff-ada0-a37b9eb9aaef",
                                                "text": "Je remarquai dans l’herbe des veilleuses toujours mélancoliques pour moi à cause des réminiscences de mes divers et nombreux automnes."
                                            },
                                            {
                                                "example_id": "17165bd6-512b-4056-bac2-216daaee337b",
                                                "sense_id": "d0000bab-ecf8-30ff-ada0-a37b9eb9aaef",
                                                "text": "C’était le début de l’automne, quand nos filles abritent encore sous les halettes leurs visages rudes et doux, un peu moqueurs, et que, déjà, sur nos prairies d’un vert mêlé de jaune, apparaissent les veilleuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
