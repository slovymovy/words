                                    {
                                        "sense_id": "402cbbcf-3b33-387a-873a-01ec138c5421",
                                        "entry_id": "e9aaa415-8aae-3189-93df-b13ecccdbda7",
                                        "glosses": [
                                            "Sorte de courroie longue et étroite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c48dbc9-a96f-4dcf-9783-5845e7e6cd75",
                                                "sense_id": "402cbbcf-3b33-387a-873a-01ec138c5421",
                                                "text": "Lo…, aidé d’un autre, m’attacha par les poignets et les chevilles avec des lanières de cuir fixées au bois."
                                            },
                                            {
                                                "example_id": "435173af-799f-4413-8555-d2ad5a7df5a9",
                                                "sense_id": "402cbbcf-3b33-387a-873a-01ec138c5421",
                                                "text": "Les étriers, larges et pesants, sont attachés à des anneaux de fer au moyen d’étrivières très courtes en soie ou en lanières de cuir tressées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf92873-1865-3b1a-8a95-70a1666cab90",
                                        "entry_id": "e9aaa415-8aae-3189-93df-b13ecccdbda7",
                                        "glosses": [
                                            "Pièce de viande de cette forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e6e90e-01d9-4bb6-ba2d-5fc3649c6f3a",
                                                "sense_id": "1cf92873-1865-3b1a-8a95-70a1666cab90",
                                                "text": "Lanières de bœuf et ses nombreux légumes cuisinés avec une pointe de crème fraîche !."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727d2490-804c-3ca2-b0aa-8eaf26fb60d3",
                                        "entry_id": "e9aaa415-8aae-3189-93df-b13ecccdbda7",
                                        "glosses": [
                                            "Bande de plastique imprégnée d’acaricide, utilisée comme traitement des ruches contre la varroose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada6cf70-a48a-4f0b-89c7-3c295cb6d5de",
                                                "sense_id": "727d2490-804c-3ca2-b0aa-8eaf26fb60d3",
                                                "text": "De cette manière la totalité de la lanière est en contact avec les abeilles et elle ne risque pas de tomber au fond de la ruche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d742a58a-ce89-46c7-be05-7cfac0b7eb49",
                        "source_entry_id": "1a1ee1ed-5b0b-3105-a6c5-45a723a593fa",
                        "source_sense_description": "strap",
                        "target_lang_word": "Riemen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Riemen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd733835-1f19-3b9e-a4c8-1029ed680079",
                                        "entry_id": "b35c30da-1d90-3926-9db1-2ea3e05ec022",
                                        "glosses": [
                                            "Streifenartige Haltevorrichtung; Band; Zügel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70857ba7-ecab-43f3-a091-8a5db3a0f4e3",
                                                "sense_id": "dd733835-1f19-3b9e-a4c8-1029ed680079",
                                                "text": "Der Stiefelschaft wurde durch einen kleinen Riemen zusammengehalten."
                                            },
                                            {
                                                "example_id": "cd16e096-e22f-42ab-ba8a-a569f4a175f3",
                                                "sense_id": "dd733835-1f19-3b9e-a4c8-1029ed680079",
                                                "text": "Die Schwungscheibe wird über einen Riemen angetrieben."
                                            },
                                            {
                                                "example_id": "8c398018-14ab-4180-ba48-609c34e62edc",
                                                "sense_id": "dd733835-1f19-3b9e-a4c8-1029ed680079",
                                                "text": "Einmal gestand er, dass sein Vater ihn mit dem Riemen geschlagen habe […]."
                                            },
                                            {
                                                "example_id": "68294c84-36de-444d-9f53-d78f55806d3f",
                                                "sense_id": "dd733835-1f19-3b9e-a4c8-1029ed680079",
                                                "text": "„Er stand sodann auf, und nachdem er den Riemen um seinen Hals gelegt, nahm er den Sarg an seine Brust und kehrte zurück zu den Comanchees.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                        "entry_id": "b35c30da-1d90-3926-9db1-2ea3e05ec022",
                                        "glosses": [
                                            "mit beiden Händen zu bewegendes Paddel oder Ruder in einem Boot"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07ab493-8be6-4fa1-8c8d-10f3d709d635",
                                                "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                                "text": "Legt euch in die Riemen, Männer!"
                                            },
                                            {
                                                "example_id": "cbc5f2d0-080f-4b34-a50d-95f06c0dc394",
                                                "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                                "text": "„Die Kugeln flogen uns in einem dichten Netz um die Ohren, und zwei unserer Riemen zersplitterten.“"
                                            },
                                            {
                                                "example_id": "616b115a-3ddb-4ac6-8f56-beaee026982f",
                                                "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                                "text": "„Die jungen Krieger wurden in offene Boote an die Riemen gesetzt, jeweils backbord oder steuerbord wie in modernen Galeeren, und dann mussten sie pullen, bis sie von den Ruderbänken kippten.“"
                                            },
                                            {
                                                "example_id": "edbfd522-1587-48cb-ac5d-87a942d7943a",
                                                "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                                "text": "„Der Mann an den Riemen drückte vorsichtig zurück und versuchte, das Boot sanft ans Dock zu bringen.“"
                                            },
                                            {
                                                "example_id": "76c4ee6a-61bc-4f23-9b7f-20927ba37d3b",
                                                "sense_id": "614684b5-9ed4-3e65-b32d-458d69b6da39",
                                                "text": "„Sie mußten zu den Riemen greifen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
