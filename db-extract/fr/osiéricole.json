                        "glosses": [
                            "Relatif à la culture de l’osier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e3ab67a-9f57-4da1-be40-3728f137864e",
                                "sense_id": "7cf26afc-5fa6-3595-b106-840720b9bc6a",
                                "text": "Dans cette ferme osiéricole de la plaine de la Garonne, vous découvrirez tout le travail de l’osier, ses techniques de culture et de transformation, notamment pour la vannerie et la tonnellerie."
                            },
                            {
                                "example_id": "3b659c53-79cc-4014-998a-cd34cfd42ea9",
                                "sense_id": "7cf26afc-5fa6-3595-b106-840720b9bc6a",
                                "text": "Ce serait là un fait d’une très grande importance au point de vue osiéricole, ce greffage permettant de produire l’osier dans des terrains trop humides où l’eau reste stagnante, comme dans les champs d’épandage des eaux d'égouts, terrains dans lesquels le peuplier réussit très bien et l’osier très mal."
                            }
                        ]
                    }
