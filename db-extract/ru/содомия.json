                    }
                ],
                "translations": [
                    {
                        "translation_id": "af283a65-28aa-486f-85ab-6f1f484046df",
                        "source_entry_id": "8a9cce56-3f8a-38e1-8d1e-04d528bbf73f",
                        "source_sense_description": "педерастия, мужеложество",
                        "target_lang_word": "sodomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sodomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "866b24e2-d20c-35cd-a412-f1786a17d2fd",
                                        "entry_id": "349c20a9-1b98-3816-9871-61def0a57a41",
                                        "glosses": [
                                            "Any of several forms of sexual intercourse held to be unnatural, particularly bestiality or homosexuality, but also (sometimes) anal, oral, or manual sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57683f9f-f329-4378-b951-10a2672961e8",
                                                "sense_id": "866b24e2-d20c-35cd-a412-f1786a17d2fd",
                                                "text": "Mr. Shakur and his road manager, Charles Fuller, 24, were convicted Dec. 1 of first-degree sexual abuse, but they were acquitted of weapons and sodomy charges."
                                            },
                                            {
                                                "example_id": "841977bd-bb6b-469e-bf09-695e9468dddc",
                                                "sense_id": "866b24e2-d20c-35cd-a412-f1786a17d2fd",
                                                "text": "On March 3, in the ocean off Hai-feng County, the pirates robbed a fishing junk, and captured Hsu-ch’iung whom crew member Ssu T’ien forced to commit sodomy. On March 11 in a bay in Hsin-an County, they robbed another t’o-feng vessel, captured and imprisoned Tan Se-chin and Tan Ya-pang and forced them to gather firewood."
                                            },
                                            {
                                                "example_id": "b53debd4-c05e-4c1c-83eb-49accf53a02a",
                                                "sense_id": "866b24e2-d20c-35cd-a412-f1786a17d2fd",
                                                "text": "[…] engaged her in conversation as to where she was going, stated that he would take her to her destination directly, forced her to commit oral sodomy upon him […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e3afbfe-9ac7-38d4-b088-f1e15fefb61c",
                                        "entry_id": "349c20a9-1b98-3816-9871-61def0a57a41",
                                        "glosses": [
                                            "Anal sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f013cb94-cff6-484b-9a97-93bfd1adfeee",
                                                "sense_id": "8e3afbfe-9ac7-38d4-b088-f1e15fefb61c",
                                                "text": "The only published study (Feigen, 1954), which looked at 68 adults engaging in consensual anal sex, found that “it was not possible to relate the appearance of the anus to the practice of sodomy; there was no appreciable difference of the anus in those who practiced sodomy frequently and those that practiced it rarely\" (p. 81)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca0577fe-14fd-405f-b24f-126bbea9aa0f",
                        "source_entry_id": "8a9cce56-3f8a-38e1-8d1e-04d528bbf73f",
                        "source_sense_description": "педерастия, мужеложество",
                        "target_lang_word": "buggery",
                        "target_lang_code": "en",
