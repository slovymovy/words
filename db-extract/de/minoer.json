                "senses": [
                    {
                        "sense_id": "0714bcc9-551e-34d2-993e-56955fa71140",
                        "entry_id": "37bb90bf-6ff8-3b7d-9c18-3f7028385e22",
                        "glosses": [
                            "Angehöriger der bronzezeitlichen minoischen Hochkultur auf Kreta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79218c7e-4f35-46ad-bd11-bc6db44fb694",
                                "sense_id": "0714bcc9-551e-34d2-993e-56955fa71140",
                                "text": "„Für die Minoer als erste Seemacht des Mittelmeeres war die Beherrschung der Inseln rund um Kreta und in der näheren Umgebung eine nahezu natürliche Angelegenheit.“"
                            },
                            {
                                "example_id": "e6067bbb-eec8-4fc6-8fd9-0bf9b65e612b",
                                "sense_id": "0714bcc9-551e-34d2-993e-56955fa71140",
                                "text": "„Bis auf zahlreiche Handelsstützpunkte scheinen die Kyklader und Minoer keine Kolonien besessen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
