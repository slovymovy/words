                ],
                "senses": [
                    {
                        "sense_id": "83859a29-e6e4-3290-904d-dd43df18172b",
                        "entry_id": "10cdd49b-8459-3d8c-9598-797122405c50",
                        "glosses": [
                            "vergleichsweise, ungewöhnlich schmal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b72fafb-e820-4421-9baa-e699a0935fa7",
                                "sense_id": "83859a29-e6e4-3290-904d-dd43df18172b",
                                "text": "„Denn infolge der fränkischen Realteilung gibt es entlang der rund 400 Meter langen Strecke bis zur Schleuse 91 oft nur handtuchbreite, aber sehr lange Grundstücke mit insgesamt 140 Eigentümern.“"
                            },
                            {
                                "example_id": "09137666-f28c-4f94-922f-95b8dce13cbb",
                                "sense_id": "83859a29-e6e4-3290-904d-dd43df18172b",
                                "text": "„Das handtuchbreite, zweistöckige Haus aus Backsteinen stand inmitten einer Reihe.“"
                            },
                            {
                                "example_id": "0475eec8-d601-4150-9c9c-9dad767f845f",
                                "sense_id": "83859a29-e6e4-3290-904d-dd43df18172b",
                                "text": "„Er faßte sie hart bei den Schultern, stieß sie in eine schmale, kaum handtuchbreite Gasse und preßte ihre Schultern mit beiden Händen gegen eine Hausmauer.“"
                            },
                            {
                                "example_id": "5ed41f77-4c48-44c4-8a4a-a7e5ba319855",
                                "sense_id": "83859a29-e6e4-3290-904d-dd43df18172b",
                                "text": "„Der östliche Strand, rechts vom Dorf Mae Nam, ist bei Flut aber stellenweise kaum handtuchbreit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
