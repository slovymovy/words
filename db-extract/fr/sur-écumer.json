                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecffb809-2be0-47bd-a05c-f0ccd30d052c",
                                "sense_id": "8d1ac861-27bb-31a2-8c63-6fdbcb6f4a4e",
                                "text": "Attention de ne pas filtrer sur UV, charbon actif ou de sur-écumer pour laisser des particules en suspension dans l'eau."
                            },
                            {
                                "example_id": "39616210-1000-4313-a2ff-2e71b95ff44e",
