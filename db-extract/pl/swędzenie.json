                    },
                    {
                        "translation_id": "063201d8-7fc9-4522-8b9e-e1dad6f39f59",
                        "source_entry_id": "d1eb50f1-54b2-371b-965d-fd50ecb4123d",
                        "source_sense_id": "a51eecfa-19f3-35fb-bb35-c427fef0e866",
                        "target_lang_word": "Juckreiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juckreiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                        "entry_id": "a7bc4096-3551-346c-ab8c-f3a95bf084dc",
                                        "glosses": [
                                            "unangenehmer Hautreiz, der zum Kratzen der betroffenen Stelle veranlasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781ab532-bca3-4ac2-b376-76b3ac7e5d8c",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Der Speichel ist es, der den anschließenden Juckreiz verursacht.“"
                                            },
                                            {
                                                "example_id": "09525141-cd4b-4ba2-a0aa-37db8d16f1b6",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Louise muss ihre Arme und ihr Gesicht unter eiskaltes Wasser halten, um den Juckreiz zu lindern, der sie auffrisst.“"
                                            },
                                            {
                                                "example_id": "2a29a8bd-f4fa-4b71-bf93-1c2e22cae809",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Leider Gottes zieht man sich dort, ob durch die Luft, ob durch das Wasser oder den Wein, einen leichten Ausschlag zu, was den Bolognesern das Vergnügen verschafft, sich zu kratzen; das ist nicht so nebensächlich, wie man denkt, wenn der Juckreiz nur leicht ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "322bf831-1524-42ec-8b69-b319a0d8184a",
                        "source_entry_id": "d1eb50f1-54b2-371b-965d-fd50ecb4123d",
                        "source_sense_id": "a51eecfa-19f3-35fb-bb35-c427fef0e866",
                        "target_lang_word": "зуд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зуд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "631ea99e-0c2a-3f7f-b2e3-626252d789a1",
                                        "entry_id": "c8577d95-dab8-3fbd-9df2-c3a6a2086c67",
                                        "glosses": [
                                            "неприятное тягостное ощущение, вызываемое постоянным слабым раздражением кожных нервных окончаний, воспринимающих боль, и сопровождающееся потребностью расчёсывать кожу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1fcecf-d0bb-4886-9a35-7357e95da7b1",
                                                "sense_id": "631ea99e-0c2a-3f7f-b2e3-626252d789a1",
                                                "text": "Привычным стали жжение и зуд возле ключиц, под мышками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371e93ef-3325-3eac-8ce1-32470b1b0770",
                                        "entry_id": "c8577d95-dab8-3fbd-9df2-c3a6a2086c67",
                                        "glosses": [
                                            "перен., разг. беспокойство, нестерпимое стремление к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d2773b-ac34-4abb-950c-c363f84066dc",
                                                "sense_id": "371e93ef-3325-3eac-8ce1-32470b1b0770",
                                                "text": "Насколько я знаю, у некоторых лидеров правоохранительных органов сегодня снова появился зуд вернуться к анонимкам под предлогом необходимости усиления борьбы с преступностью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
