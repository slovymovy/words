                    {
                        "translation_id": "641ce8fb-0f99-4e0c-93bb-2432031c6892",
                        "source_entry_id": "bb81daf4-b23d-3361-a3f9-b1efd82bfe6c",
                        "source_sense_id": "aa676882-97cc-3049-822c-8cdfc9fcee4f",
