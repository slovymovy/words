                                "target_senses": [
                                    {
                                        "sense_id": "237aa128-9796-3c23-9999-2056eb1a4e8e",
                                        "entry_id": "4af099f2-3500-3afe-8c6c-8cf06e51420c",
                                        "glosses": [
                                            "Moving or operating quickly, as a train not making local stops."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf2565e0-3cde-3a1f-8c7f-fd711e8d51e6",
                                        "entry_id": "4af099f2-3500-3afe-8c6c-8cf06e51420c",
                                        "glosses": [
                                            "Specific or precise; directly and distinctly stated; not merely implied."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "920a92bf-fb9e-463c-98de-013eae6ee2bd",
                                                "sense_id": "cf2565e0-3cde-3a1f-8c7f-fd711e8d51e6",
                                                "text": "I gave him express instructions not to begin until I arrived, but he ignored me."
                                            },
                                            {
                                                "example_id": "82cdc13a-1141-4ecc-8333-709767ff97ac",
                                                "sense_id": "cf2565e0-3cde-3a1f-8c7f-fd711e8d51e6",
                                                "text": "This book cannot be copied without the express permission of the publisher."
                                            },
                                            {
                                                "example_id": "649fd847-2e3d-4d20-97bb-ca1d361864a8",
                                                "sense_id": "cf2565e0-3cde-3a1f-8c7f-fd711e8d51e6",
                                                "text": "Beginning with the next issue, which will be the January, 1950, issue, this magazine will be published on the first of every month. This step has been taken at the express wish of readers despite the present paper and production difficulties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1087fb08-95b7-3d08-ba1e-888046199ed3",
                                        "entry_id": "4af099f2-3500-3afe-8c6c-8cf06e51420c",
                                        "glosses": [
                                            "Truly depicted; exactly resembling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e62f7c-8a2c-4859-93ba-c64cf203cc32",
                                                "sense_id": "1087fb08-95b7-3d08-ba1e-888046199ed3",
                                                "text": "In my eyes it bore a livelier image of the spirit, it seemed more express and single, than the imperfect and divided countenance."
                                            },
                                            {
                                                "example_id": "b3aaf8cc-71a0-4895-b517-a10d6844feef",
                                                "sense_id": "1087fb08-95b7-3d08-ba1e-888046199ed3",
                                                "text": "Soon as the potion works, their human countenance, / The express resemblance of the gods, is changed / Into some brutish form, of wolf, or bear, / Or ounce, or tiger, hog, or bearded goat, / All other parts remaining as they were[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef89ab2-c89f-3644-8bcd-7c54815bfd06",
                                        "entry_id": "4af099f2-3500-3afe-8c6c-8cf06e51420c",
                                        "glosses": [
                                            "Providing a more limited but presumably faster service than a full or complete dealer of the same kind or type."
                                        ],
                                        "tags": [
                                            "postpositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a82e46-e13e-4168-a5fb-e9ce1aa69cc5",
                                                "sense_id": "2ef89ab2-c89f-3644-8bcd-7c54815bfd06",
                                                "text": "Tesco Express"
                                            },
                                            {
                                                "example_id": "c29da646-81d6-4b94-8c1f-95e6afc0ac9e",
                                                "sense_id": "2ef89ab2-c89f-3644-8bcd-7c54815bfd06",
                                                "text": "McDonald's Express"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "express",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "A mode of transportation, often a train, that travels quickly or directly, either on a regular schedule or as a special or excursion. Express trains often pass through stations along the way without stopping at them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa2dbd9-b545-4816-ba50-e6eed9d9c77a",
                                                "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                                "text": "I took the express into town."
                                            },
                                            {
                                                "example_id": "dd01d9e6-3e56-4577-8f09-aa565014c41c",
                                                "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                                "text": "Your attention please. Train 4715 is now boarding on track 3, section B. This train is an express. This train does not stop at Foo, Bar, or Fubar stations."
                                            },
                                            {
                                                "example_id": "4d82e739-4c0f-4940-acba-9e8140ce6c00",
                                                "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                                "text": "The train was moving less fast through the summer night. The swift express had changed into something almost a parliamentary, had stopped three times since Norwich, and now, at long last, was approaching Banton."
                                            },
                                            {
                                                "example_id": "4f7a6626-8738-49fe-b1eb-c97c8cc0e89b",
                                                "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                                "text": "Except for the mid-winter period, when the 11.30 a.m. from Paddington and its opposite number will be withdrawn - Torquay now has seven daily expresses to and from Paddington as compared with five down and six up previously."
                                            },
                                            {
                                                "example_id": "9fcbcf65-8193-40f9-b371-9355e0c97c7e",
                                                "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                                                "text": "This is also a TransPennine Express service which makes a mockery of the word 'express'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0344c1c2-e418-34a6-87c4-221b4a80e6d6",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "A mode of transportation, often a train, that travels quickly or directly, either on a regular schedule or as a special or excursion. Express trains often pass through stations along the way without stopping at them.",
                                            "a public utility vehicle, typically a jeepney, that traverses through an expressway"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61760945-398b-3717-8126-11e39ead63a4",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "A service that allows mail or money to be sent rapidly from one destination to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fe57321-36f7-3d3f-b110-a750b79a4966",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "An express rifle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb365f9-0c0d-4a40-a040-2d2a716c8c18",
                                                "sense_id": "7fe57321-36f7-3d3f-b110-a750b79a4966",
                                                "text": "\"Give me my express,\" I said, laying down the Winchester, and he handed it to me cocked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79febad6-e830-311a-97a0-8755293ed16d",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "A clear image or representation; an expression; a plain declaration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49623b83-78c4-4d21-86fb-a9903bef0738",
                                                "sense_id": "79febad6-e830-311a-97a0-8755293ed16d",
                                                "text": "And this [holy communion] being the great myſtery of Chriſtianity, and the onely remanent expreſſe of Chriſts ſacrifice on earth, it is moſt conſonant to the Analogy of the myſtery, that this commemorative ſacrifice be preſented by perſons as ſeparate, and diſtinct in our miniſtery, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55fac9f1-f574-349a-9338-1f03a0c468ff",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "A messenger sent on a special errand; a courier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004a30ba-75c8-48d9-b3ee-7264718479a3",
                                                "sense_id": "55fac9f1-f574-349a-9338-1f03a0c468ff",
                                                "text": "I learned, to my inexpressible terror, that at two o'clock, the day before, an express had been sent to Geraldine by Mr Bergasse, with a letter, which he had received from the Hotel de Romagnecourt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0a443c-1072-3a23-9762-1942d770b301",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "An express office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba794165-e8b0-4e54-a2cd-870a86ffcf82",
                                                "sense_id": "ec0a443c-1072-3a23-9762-1942d770b301",
                                                "text": "She charged him […] to ask at the express if anything came up from town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a428d9-4cab-3b71-ba0d-bac25c64357b",
                                        "entry_id": "7ec118e8-2834-3b84-ad50-12da242cfc50",
                                        "glosses": [
                                            "That which is sent by an express messenger or message."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e999c33-9ef7-4973-9699-9a23fc5f017b",
                                                "sense_id": "f4a428d9-4cab-3b71-ba0d-bac25c64357b",
                                                "text": "popular captations, which some men use in their Speeches, and Expresses"
                                            },
                                            {
                                                "example_id": "787b913c-9d30-466d-82b8-3d15bf1ab296",
                                                "sense_id": "f4a428d9-4cab-3b71-ba0d-bac25c64357b",
                                                "text": "“5th, If an express requires extraordinary despatch, the man-mountain shall be obliged to carry, in his pocket, the messenger and horse a six days journey, once in every moon, and return the said messenger back (if so required) safe to our imperial presence."
                                            },
                                            {
                                                "example_id": "c4c5166e-832d-4178-869f-43d40e19c8b2",
                                                "sense_id": "f4a428d9-4cab-3b71-ba0d-bac25c64357b",
                                                "text": "So much was Sir Edward delighted that he sent an express to inform Lord Meersbrook of this great act of friendship, in order that he might be the more easy on their account;..."
                                            }
                                        ]
                                    }
                                ]
                            },
