                        "entry_id": "505491db-6af3-3b51-90b5-ba4f54c5a13f",
                        "glosses": [
                            "Semblant d’été en automne."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2e6884e5-1f23-47ec-acd2-f06163d4ad6f",
                                "sense_id": "7af17d20-a1fd-3718-bab1-0509ea4d791b",
                                "text": "L’Amirauté, quand je l’atteignis à l’heure de la sieste, portes et fenêtres closes dans le flamboiement de l’arrière-été, semblait abandonnée."
                            },
                            {
                                "example_id": "1c4c7cd5-28a3-4c1c-a27d-cb64884eba99",
                                "sense_id": "7af17d20-a1fd-3718-bab1-0509ea4d791b",
                                "text": "… ne pas perdre un instant de cet arrière-été."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab3eeec-570b-4751-af06-d16c04a5a716",
                        "source_entry_id": "505491db-6af3-3b51-90b5-ba4f54c5a13f",
