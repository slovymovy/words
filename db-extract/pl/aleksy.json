                                        "examples": [
                                            {
                                                "example_id": "094f9ec6-63b2-4b83-aad0-5f7581dc4999",
                                                "sense_id": "b5cb25e0-8d0e-3ee7-b528-5686e534fe7c",
                                                "text": "Alexis geht nichts über seinen Handarbeitskreis. Dafür verzichtet er im Zweifel sogar darauf, sich Synchronschwimmen im Fernsehen anzusehen."
                                            },
                                            {
                                                "example_id": "2e77840d-ee18-4baf-b064-0b9b68d153fd",
                                                "sense_id": "b5cb25e0-8d0e-3ee7-b528-5686e534fe7c",
                                                "text": "Gestern wurde Alexis wieder aus dem Krankenhaus entlassen, wo er zwei Wochen in Behandlung gewesen war, nachdem ihm ein Baseball an den Kopf geflogen war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alexis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e41b5193-143a-31ac-8566-8b94f48f551e",
