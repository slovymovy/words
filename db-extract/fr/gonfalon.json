                    {
                        "form_id": "4828c0b3-4ac8-410b-91cc-9ebe3a0929b5",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "tags": [],
                        "form": "gonfanon"
                    },
                    {
                        "form_id": "f8c67b7f-951b-4761-abfc-cdd784d54e9b",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "tags": [],
                        "form": "confalon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "glosses": [
                            "Fanion dont les chevaliers ornaient leur lance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2891a56-37bd-4992-af41-86a3d739e849",
                                "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                                "text": "Et ton nom brodé d’or sur mon blanc gonfalon."
                            },
                            {
                                "example_id": "7d98a9ed-5877-47df-bfb2-ef2e988d9957",
                                "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                                "text": "Un gonfalon élimé, au sommet d’une perche plantée devant l’entrée, portait le nom du propriétaire..."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6adf826-d0c7-3ffc-af50-9d036b72531a",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "glosses": [
                            "Bannière d’église à trois ou quatre fanons, qui sont des pièces pendantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e8e83a-e2aa-40e2-a173-4a4bfa8b7f4a",
                                "sense_id": "d6adf826-d0c7-3ffc-af50-9d036b72531a",
                                "text": "Au bas de la nef est suspendu le gonfalon pontifical qui avec le médaillon portatif en bois doré, forme les insignes de la Basilique."
                            }
                        ]
                    },
                    {
                        "sense_id": "372df336-c61b-33c4-b774-190548bd0a01",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "glosses": [
                            "Bannière des républiques ou communes italiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca55370d-c7c5-4037-84e1-ef314974a1df",
                                "sense_id": "372df336-c61b-33c4-b774-190548bd0a01",
                                "text": "Le gonfalonier était le gardien du gonfalon, ou étendard, dans les communes médiévales italiennes, surtout en Toscane."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2c6be78-6dfa-38f0-b942-58ab17a527df",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "glosses": [
                            "Voir gonfanon."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "46406590-56c6-394b-bab3-56053b8f0787",
                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "glosses": [
                            "Confrérie de séculiers dits pénitents à qui saint Bonaventure prescrivit en 1264 une forme particulière de prières ; plus tard Grégoire XIII confirma cette confrérie et lui donna le soin de délivrer les chrétiens esclaves des mains des infidèles."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8344f8b4-e9b5-4a99-a56f-c7084863047c",
                        "source_entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                        "target_lang_word": "gonfalon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonfalon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64f02cc1-320a-3d36-a179-5837c4e9d008",
                                        "entry_id": "129e4b0c-4889-3a40-b989-e36d284a196c",
                                        "glosses": [
                                            "A standard or ensign, consisting of a pole with a crosspiece from which a banner is suspended, especially as used in church processions, but also for civic and military display."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef7c4d5-17fb-442e-8170-4f3cf0373b8f",
                                                "sense_id": "64f02cc1-320a-3d36-a179-5837c4e9d008",
                                                "text": "Ten thousand thousand Ensignes high advanc'd,\nStandards, and Gonfalons twixt Van and Reare\nStreame in the Aire, and for distinction serve"
                                            },
                                            {
                                                "example_id": "914aec66-d6ea-4605-994f-4e7297f23c7a",
                                                "sense_id": "64f02cc1-320a-3d36-a179-5837c4e9d008",
                                                "text": "Ruthlessly pricking our gonfalon bubble,\nMaking a Giant hit into a double—\nWords that are heavy with nothing but trouble:\n“Tinker to Evers to Chance.”"
                                            },
                                            {
                                                "example_id": "51f65145-5454-4f8e-9cbb-45904655502c",
                                                "sense_id": "64f02cc1-320a-3d36-a179-5837c4e9d008",
                                                "text": "With vermilion leaf or bronze—\nTatters of gorgeous gonfalons—"
                                            },
                                            {
                                                "example_id": "d061913d-77e0-4a6c-891f-11dda2974d91",
                                                "sense_id": "64f02cc1-320a-3d36-a179-5837c4e9d008",
                                                "text": "It was in the queer little Church of Vera Cruz, beneath the castle, that the Knights Templar performed their secret rites of chivalry, standing vigil over their arms all night, in all the mysterious splendour of seneschal, gonfalon, and accolade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e0e6d4-63ae-348e-9eed-a949b86148b1",
                                        "entry_id": "129e4b0c-4889-3a40-b989-e36d284a196c",
                                        "glosses": [
                                            "Alternative form of gonfanon."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
