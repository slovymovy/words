                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6908eba-ff76-4115-96c9-2057550d2d86",
                                "sense_id": "2024c477-0f0d-3417-9f1a-0ed5e20a4ca9",
                                "text": "Смельчак лихо прокатился, стоя на ногах, и вызвал общее одобрение."
                            },
                            {
                                "example_id": "b3676e44-76ac-43fc-82e3-6e709139546c",
                                "sense_id": "2024c477-0f0d-3417-9f1a-0ed5e20a4ca9",
                                "text": "Они не запрещают вход, но редкий смельчак рискнет все-таки воспользоваться правом входа."
                            }
                        ]
                    }
