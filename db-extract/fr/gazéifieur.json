                "senses": [
                    {
                        "sense_id": "544e6707-f72a-301c-ab7d-e1f8037e68bf",
                        "entry_id": "bd5587ca-1e5b-3bd5-84f6-a382fb96c84c",
                        "glosses": [
                            "Dispositif dans lequel se déroule la gazéification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d2b50b-b5cd-4a19-9dd5-3f18448b42d4",
                                "sense_id": "544e6707-f72a-301c-ab7d-e1f8037e68bf",
                                "text": "Dans un gazéifieur, ces éléments vont se recombiner chimiquement entre eux ainsi qu’avec l’hydrogène, l’oxygène et le carbone, pour se retrouver sous différentes formes telles que les carbonates et des oxydes réfractaires."
                            },
                            {
                                "example_id": "9c296f62-d756-4e66-a8f8-d3e97a19c386",
                                "sense_id": "544e6707-f72a-301c-ab7d-e1f8037e68bf",
                                "text": "Les gazéifieurs classiques conviennent aux petites puissances (10 MW maximum), produisent un gaz plutôt pauvre mais ne nécessitent pas d’apports énergétiques extérieurs."
                            }
                        ]
                    }
                ],
