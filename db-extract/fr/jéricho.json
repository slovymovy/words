        "fr-extract.jsonl": [
            {
                "entry_id": "5ad3548b-46c0-34bd-93f9-122b5651d4e2",
                "word": "Jéricho",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1930f9b2-2336-366d-b7ac-b0fc432d50c7",
                        "entry_id": "5ad3548b-46c0-34bd-93f9-122b5651d4e2",
                        "glosses": [
                            "Ville historique de Palestine, portant aujourd'hui en Cisjordanie le nom de Er-Riha."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218b3fb1-e944-4d39-8e36-6a2a09331353",
                                "sense_id": "1930f9b2-2336-366d-b7ac-b0fc432d50c7",
                                "text": "Au lieu de nous rendre directement à Er-Riha, nom actuel de Jéricho, en suivant dans la plaine la dernière partie de la route qui compte encore trois kilomètres, dirigeons-nous vers le nord en côtoyant les montagnes."
                            },
                            {
                                "example_id": "e54da89c-0819-4dbc-9ffb-d5fd7b437353",
                                "sense_id": "1930f9b2-2336-366d-b7ac-b0fc432d50c7",
                                "text": "Pourtant, avant de rentrer à Alexandrie, il lui faut encore aller à Damas, à Jérusalem et aussi à Gaza, et enfin à Jéricho ! Il lui faut, elle reine d'Égypte, rencontrer Hérode."
                            },
                            {
                                "example_id": "cc6966bf-b25c-4e1e-8535-139f0672a29d",
                                "sense_id": "1930f9b2-2336-366d-b7ac-b0fc432d50c7",
                                "text": "Jéricho, rappelons-le, est la ville conquise par Josué « avec violence et cruauté »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef729576-bd96-4d1c-93b3-f5c37aec458c",
                        "source_entry_id": "5ad3548b-46c0-34bd-93f9-122b5651d4e2",
                        "source_sense_id": "1930f9b2-2336-366d-b7ac-b0fc432d50c7",
                        "target_lang_word": "Jericho",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jericho",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                        "entry_id": "2fb8045a-9606-3d57-887e-d5dc89f30dd4",
                                        "glosses": [
                                            "eine Stadt im Westjordanland; oft älteste Stadt der Welt genannt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3e02c7-4ae8-4962-b1b6-8b97cdaa94cc",
                                                "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                                "text": "„Der erste Eindruck von Jericho war keineswegs der, dem ich entgegengefiebert hatte.“"
                                            },
                                            {
                                                "example_id": "02de401b-ee01-48bf-9f98-4e8a3d9e7c68",
                                                "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                                "text": "Ich bin in Jericho geboren."
                                            },
                                            {
                                                "example_id": "00b8b693-f769-4338-9aa9-9664acfaec09",
                                                "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                                "text": "Wir haben in Jericho unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "aca2b204-1dd7-4225-a14a-89c19e609d22",
                                                "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                                "text": "Nach Jericho führen viele Wege."
                                            },
                                            {
                                                "example_id": "e8881ad0-dc3e-41bd-abca-0536fbe294a9",
                                                "sense_id": "1ad5b598-f3bb-3636-9c7d-caf174499d88",
                                                "text": "Jericho liegt auf der Nordhalbkugel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
