                "senses": [
                    {
                        "sense_id": "7f0bafc7-f192-3b30-82ba-aac41fd0c06f",
                        "entry_id": "b28da018-7713-38d5-8723-3d5ef18965b9",
                        "glosses": [
                            "künstlich geschaffenes Becken oder großer Raum zur vorübergehenden Speicherung von größeren Mengen an Wasser oder auch anderen Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a7ccb5-8fd0-46fb-bb3b-06919a3e3e13",
                                "sense_id": "7f0bafc7-f192-3b30-82ba-aac41fd0c06f",
                                "text": "„Planung, Bau, Betrieb und Unterhaltung von Talsperren, Wasserspeichern und Rückhaltebecken obliegen ihren Eigentümern oder Betreibern; die §§ 67a bis 67e sind für Vorbereitung und Durchführung von Baumaßnahmen entsprechend anzuwenden.“"
                            },
                            {
                                "example_id": "5feed9a5-9cbd-4a66-b5a4-f7f93001b2c5",
                                "sense_id": "7f0bafc7-f192-3b30-82ba-aac41fd0c06f",
                                "text": "„Nötig wurde das neue Rückhaltebecken, weil die Hochwassergefahr in den letzten Jahren stetig gestiegen ist.“"
                            },
                            {
                                "example_id": "ab84d669-51ce-4cae-acb6-0f62a9cb9796",
                                "sense_id": "7f0bafc7-f192-3b30-82ba-aac41fd0c06f",
                                "text": "„Der Bau des großen Rückhaltebeckens dient übrigens nicht nur der Sicherheit der vorhandenen Bausubstanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
