    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a2bd5f7-90f6-34ab-8f63-1df4831824f8",
                    "sense_definition": "In een wedstrijd of competitie op een achterstand staan",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "wedstrijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ploeg <w>staat</w> al vroeg in de wedstrijd met 1-0 <w>achter</w>.",
                            "target_lang_translations": {
                                "en": "The team is already <w>trailing</w> 1-0 early in the match."
                            }
                        },
                        {
                            "text": "Ondanks een goed begin <w>stond</w> het team toch met twee doelpunten <w>achter</w>.",
                            "target_lang_translations": {
                                "en": "Despite a good start, the team was still <w>behind</w> by two goals."
                            }
                        }
                    ],
                    "antonyms": [
                        "voorstaan"
                    ],
                    "common_phrases": [
                        "met 1-0 achterstaan",
                        "ver achterstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a losing position in a game or competition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be behind",
                                "target_lang_sense_clarification": "in a score or ranking"
                            },
                            {
                                "target_lang_word": "to be trailing",
                                "target_lang_sense_clarification": "in a competition or race"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a0476b8-eadf-3e12-8a66-a3fe5a312323",
                    "sense_definition": "Iemand steunen of het eens zijn met een idee of persoon",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "steun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn ouders <w>stonden</w> altijd <w>achter</w> zijn beslissing om te gaan reizen.",
                            "target_lang_translations": {
                                "en": "His parents always <w>supported</w> his decision to go traveling."
                            }
                        },
                        {
                            "text": "De directie <w>staat</w> volledig <w>achter</w> dit nieuwe plan voor het bedrijf.",
                            "target_lang_translations": {
                                "en": "The management fully <w>stands behind</w> this new company plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "steunen",
                        "ondersteunen"
                    ],
                    "common_phrases": [
                        "volledig achterstaan",
                        "achter iemand staan"
                    ],
                    "target_lang_definitions": {
                        "en": "To support or agree with an idea, plan, or person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to support",
                                "target_lang_sense_clarification": "to back someone or something"
                            },
                            {
                                "target_lang_word": "to stand behind",
                                "target_lang_sense_clarification": "to show firm support for a decision or person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}