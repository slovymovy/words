                        "form": "woodwinds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                        "entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                        "glosses": [
                            "Any (typically wooden) musical instrument that produces sound by the player blowing into it, through a reed, or across an opening. Woodwind instruments include the recorder, flute, piccolo, clarinet, oboe, cor anglais and bassoon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9664a293-261f-4c1f-b635-566141a2500e",
                                "sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                                "text": "The seven-member Bell Orchestre was indeed a miniorchestra, with strings, brass, woodwinds and percussion along with occasional guitar and analog electronic noise."
                            },
                            {
                                "example_id": "17c0c465-71e2-4e58-9b06-397897ab5df5",
                                "sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                                "text": "The graceful, otherworldly sounds on which the first movement was built gave way to sharply articulated, dissonantly blaring woodwind and brass chords, and eventually to a mechanistic passage that combined rumbling low notes and a steady, searing high pitch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebda5879-79ba-45e5-b115-66ea23b404f6",
                        "source_entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                        "source_sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "houtblaasinstrument",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "houtblaasinstrument",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdf2312-8a41-32af-81fc-5e71fc7128e0",
                                        "entry_id": "6db69f7c-b81b-3547-a48b-14c23fa19835",
                                        "glosses": [
                                            "een muziekinstrument waarmee het geluid onstaat, door de splitsing van een geblazen luchtstroom op de rand van een mondgat of van een labium; dan wel door het persen van de luchtstroom langs een enkel of dubbel strookje riet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da41d8be-c51f-463c-ac04-14ed7669979d",
                                                "sense_id": "ecdf2312-8a41-32af-81fc-5e71fc7128e0",
                                                "text": "Veel houtblaasinstrumenten zijn van metaal gemaakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c572192-6271-4100-8f56-d9d71eb38b79",
                        "source_entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                        "source_sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Substance dure et fibreuse des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27628b81-fd7e-4f38-97aa-ad4d2cd7e841",
                                                "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                                "text": "Le bois est un matériau noble, une matière vivante."
                                            },
                                            {
                                                "example_id": "7919a429-cf78-4105-afc9-a80c19a22755",
                                                "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                                "text": "Les mines sont étançonnées et étayées avec du bois auquel on met le feu, ce qui fait tomber une partie des défenses de la barbacane."
                                            },
                                            {
                                                "example_id": "1658bd56-a966-46b1-9b62-bccaa5363ddf",
                                                "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                                "text": "Le mouvement de rotation imprimé par le vent à l'arbre est transmis aux meules par l’intermédiaire d’engrenages, qui sont ordinairement en bois."
                                            },
                                            {
                                                "example_id": "a8642ed6-f089-426d-9275-3500356b89f6",
                                                "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                                "text": "Hippocrate sauva Athènes de la peste en brûlant dans les rues des bois aromatiques et en faisant suspendre partout des paquets de fleurs parfumées."
                                            },
                                            {
                                                "example_id": "2ece03ab-42c1-4ce2-931f-4a1dcb42bc80",
                                                "sense_id": "07402398-dcde-3a01-bdc2-45ea7fc7f624",
                                                "text": "J’éduquais mon oreille à traduire des multitudes de sons infimes, petits trots de souris et grincements de bois, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d64d0fb-fc39-39a4-96c7-69e43789298c",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Objet construit dans cette matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77cb9d0c-cd2b-4b32-815e-e74dc9336ffa",
                                                "sense_id": "8d64d0fb-fc39-39a4-96c7-69e43789298c",
                                                "text": "Au nord ouest, près de la route de Sommerance, se dressaient les bois de la potence, instrument de la haute justice seigneuriale. Parfois y oscillait un squelette blanchi, […]."
                                            },
                                            {
                                                "example_id": "454826ca-9983-4461-9191-d7d5da2a8390",
                                                "sense_id": "8d64d0fb-fc39-39a4-96c7-69e43789298c",
                                                "text": "Dans une cour à demi couverte, sur une espèce d’estrade, se dressaient les bois de la guillotine et, devant, les forçats se tenaient à genoux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Ensemble d’arbres assez proches, délimité par une lisière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad83229-6e00-4d88-bed6-cebe51d97ce3",
                                                "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                                "text": "La plupart des montagnes de Walachie sont garnies de bois composés de poiriers, de cerisiers, d’abricotiers et autres arbres fruitiers qui donnent aux forêts l’aspect d’immenses vergers."
                                            },
                                            {
                                                "example_id": "d9ba9160-8e69-4516-960d-0840692fed97",
                                                "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                                "text": "Deux bois, l’un à son amorce, l’autre au mitan, chevauchent la longue articulation crayeuse qui porte le nom de plateau de Lorette."
                                            },
                                            {
                                                "example_id": "2690e420-9204-487f-b4e9-d8e778a29cdf",
                                                "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                                "text": "[…] et déjà nous accostions à l’estacade du bois de la Chaise, un bois de pins tristes et d’yeuses superbes, aux troncs tordus, au feuillage presque noir."
                                            },
                                            {
                                                "example_id": "0230f5f2-a618-4d58-87e7-0a7b3c1305bf",
                                                "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            },
                                            {
                                                "example_id": "7c82107e-7d8f-4b9b-b10b-8c74cd696ab9",
                                                "sense_id": "1a1c92b5-3adb-3d86-a3be-a1804666914a",
                                                "text": "Le long des rivières se développe une végétation de Cannes de Provence qui s’encombre de Saules et de Peupliers jusqu’à donner des bois de ces arbres qui sont un autre climax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc2dcfd-1def-3fb2-adcd-e97bef26f249",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Famille d’instruments à vent de matières très variées (bois, métal, plastique, terre cuite, os, ivoire, cristal, etc.) et dont le son n'est pas produit par la vibration des lèvres de l'instrumentiste, et comprenant :\\nLes flûtes (vibration de l’air sur un biseau)\\nLes hautbois (vibration d’une anche double)\\nLes clarinettes (vibration d'une anche simple)"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f201758-90d0-4c50-b4a8-c7edfd341d91",
                                                "sense_id": "fcc2dcfd-1def-3fb2-adcd-e97bef26f249",
                                                "text": "La flûte est un instrument de la famille des bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a02ee72-9cbf-3d51-835b-eae17755e6ff",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Une section d'orchestre ou un groupe de musiciens qui jouent les instruments de ce type."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11a35724-1518-32a4-9489-bf3d92f7fea4",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Organe osseux des cervidés qui pousse sur leurs têtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4726698-b181-483f-bea7-bac2cf03e146",
                                                "sense_id": "11a35724-1518-32a4-9489-bf3d92f7fea4",
                                                "text": "Dans l’ensemble, la densité du bois est un peu inférieure à celle du squelette. On peut considérer qu’un bois est constitué de 44% de substances organiques et de 56% de substances minérales essentiellement représentées par du phosphate tricalcique."
                                            },
                                            {
                                                "example_id": "9abb09ac-b480-4921-b308-b3d293dff273",
                                                "sense_id": "11a35724-1518-32a4-9489-bf3d92f7fea4",
                                                "text": "L’os et le bois de cervidés (notamment le renne) ont servi, au Paléolithique supérieur, à produire une industrie abondante et diversifiée, dont certaines pièces, décorées ou non (propulseurs, sagaies, harpons), sont de véritables œuvres d’art."
                                            },
                                            {
                                                "example_id": "74ce1ad4-41da-4005-8ed0-ad15e1f672f3",
                                                "sense_id": "11a35724-1518-32a4-9489-bf3d92f7fea4",
                                                "text": "Un père du Minnesota aurait utilisé les bois d’un orignal pour tuer un délinquant sexuel qui, selon lui, traquait sa fille."
                                            },
                                            {
                                                "example_id": "1fd18fea-a5cb-46a1-bcc9-c39621051517",
                                                "sense_id": "11a35724-1518-32a4-9489-bf3d92f7fea4",
                                                "text": "Le bois du renne est aplati."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d6f0b9-0e1f-381c-ada5-a240d5734cf6",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Menues branches, des rejetons que les arbres poussent chaque année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f5aa9a-9d70-470b-820d-5fb6afbfc451",
                                                "sense_id": "97d6f0b9-0e1f-381c-ada5-a240d5734cf6",
                                                "text": "Élaguer des arbres fruitiers qui poussent trop de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5c292f-cda6-34c0-bd8c-4ced88bd2853",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Gravure sur bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76926529-1bbd-42fd-b6a8-416842a5321b",
                                                "sense_id": "2b5c292f-cda6-34c0-bd8c-4ced88bd2853",
                                                "text": "Les clichés héliographiques de M. Amand Durand, dont nous allons reparler à l'instant, sont excellents lorsqu'ils fac-similent des bois anciens, des dessins à la plume bien accusés, bien francs; […]."
                                            },
                                            {
                                                "example_id": "3c9356ea-12e9-48b2-ad84-34dd95280cbb",
                                                "sense_id": "2b5c292f-cda6-34c0-bd8c-4ced88bd2853",
                                                "text": "Bois de fil : Gravé dans le sens de la fibre."
                                            },
                                            {
                                                "example_id": "1696ae91-50f0-40f1-8e29-168ee0763d5c",
                                                "sense_id": "2b5c292f-cda6-34c0-bd8c-4ced88bd2853",
                                                "text": "Bois debout ou de bout : Gravé perpendiculairement à la fibre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3890e3f-5fa4-395e-901b-08162156349b",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Club de golf à tête arrondie, utilisé pour frapper la balle à grande distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea4c43a-3090-462c-b756-5213cd6e5ad7",
                                                "sense_id": "f3890e3f-5fa4-395e-901b-08162156349b",
                                                "text": "Située à Carlsbad en Californie et spécialisée dans la fabrication d'équipement de golf, cette compagnie fabrique des bois, des fers, des wedges, des putters, des balles de golf et licencie son nom pour ce qui concerne l'habillement, les chaussures, les chronomètres et les accessoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d40a8a-9128-3b3a-86dd-6a529b9f5810",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "La forêt en général."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89deac3c-9d6d-44c4-8f89-c1da6397bd8a",
                                                "sense_id": "f1d40a8a-9128-3b3a-86dd-6a529b9f5810",
                                                "text": "Le bois ! Un simple chantier pour eux, où gagner mieux qu’en usine […]. Ceints de soleil, d'air vif, on tâche à sa guise, à son allure, sans surveillants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81b3ba4-008e-34e2-bdbf-5f0a8cd4f1d5",
                                        "entry_id": "a8c19fee-8a0d-33c7-98d8-2020a8137ce9",
                                        "glosses": [
                                            "Coque."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23ae9f9-0356-467f-98b0-0cd23d381189",
                                                "sense_id": "b81b3ba4-008e-34e2-bdbf-5f0a8cd4f1d5",
                                                "text": "Tirer en plein bois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dca176bb-a1b0-35ca-b1eb-46c0093214bd",
                                        "entry_id": "803c7c3f-ac64-39be-a6a5-946e1cb08205",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de boire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb26015-b4e1-4acb-b091-08a513a422b5",
                                                "sense_id": "dca176bb-a1b0-35ca-b1eb-46c0093214bd",
                                                "text": "Je bois à la santé du Kattegat à moitié banquisé, dit Marta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2750b8-c01a-314a-88dc-41fb62aa832b",
                                        "entry_id": "803c7c3f-ac64-39be-a6a5-946e1cb08205",
                                        "glosses": [
