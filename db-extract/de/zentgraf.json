                ],
                "senses": [
                    {
                        "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                        "entry_id": "20bc0f60-bb0e-31eb-93ec-f2ff09428af6",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4288f389-ca4e-4cd7-8f26-c828789e133a",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Frau Zentgraf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a69b2c23-5e8b-444c-a432-aa2ee1bccd4a",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Herr Zentgraf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe721b05-35bc-48da-a85c-fda1fe6de854",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Die Zentgrafs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "edd794a5-bd6c-450e-b3ef-6dbbf84386b2",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Der Zentgraf trägt nie die Schals, die die Zentgraf ihm strickt."
                            },
                            {
                                "example_id": "ef9d7094-e0bf-491d-8bd0-fc1418c9b994",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zentgraf kommt, geht der Herr Zentgraf.“"
                            },
                            {
                                "example_id": "354783c6-1a10-4f4b-a18b-cc0487d57e9e",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Zentgraf kommt und geht."
                            },
                            {
                                "example_id": "3c0d294d-535e-4456-adbe-996af9fe078c",
                                "sense_id": "ba5104e5-8855-3ab9-aee4-2111ba82654d",
                                "text": "Zentgrafs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
