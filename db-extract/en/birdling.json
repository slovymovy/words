                                "target_senses": [
                                    {
                                        "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                        "entry_id": "466ffe92-d71b-3d1a-b054-1a90e18500e1",
                                        "glosses": [
                                            "kleiner Vogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72198ce3-fcd3-4264-ad33-7607d62c7044",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "Guck mal, eine Kuckucksuhr! Wenn du genau hinsiehst, kannst du gleich ein kleines Vögelchen sehen, das herausschaut."
                                            },
                                            {
                                                "example_id": "5bf2380a-4b0a-484e-b6b7-470e7bdb3e41",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Ein paar Mal kreiste das Vögelchen über der Polizeistation, bevor es hinüber zum Grün der Sportplätze flog.“"
                                            },
                                            {
                                                "example_id": "1ede66a2-8417-4018-b07e-e88f55265269",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Dort war eines Nachmittags ein Vögelchen durch eines der sommerlich geöffneten Fenster hereingeflattert.“"
                                            },
                                            {
                                                "example_id": "19df51c0-5c88-4f6d-b1b0-85716c989d75",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Sie nippte an dem Braten wie ein Vögelchen und aß ein paar Graupen und trank drei Mundvoll Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7a8036b-68f2-41a8-a622-40b35080b43b",
