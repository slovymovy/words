                ],
                "senses": [
                    {
                        "sense_id": "efdacf4a-b96f-32a3-8b36-f74f8defdd03",
                        "entry_id": "8cb90d3d-c1cc-3928-a6f3-3176a737cacf",
                        "glosses": [
                            "so, dass es bezähmt werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "224a4446-abf1-4991-aaf2-993e35ca3e0c",
                                "sense_id": "efdacf4a-b96f-32a3-8b36-f74f8defdd03",
                                "text": "„Urica fühlte, daß er ihre Ruhe braviere und der Zorn stieg kaum bezähmbar in ihr auf.“"
                            },
                            {
                                "example_id": "82389cca-7ffe-4361-b287-ceb5de66476d",
                                "sense_id": "efdacf4a-b96f-32a3-8b36-f74f8defdd03",
                                "text": "„Was den phantastischen Begriff anbelangt, daß keiner hervorragenden Persönlichkeit Ruhm und hohe Ehren eingeräumt werden dürften, … so steht er nicht nur mit dem Triebe der Menschen in Widerspruch, sondern auch mit denen der Tiere, die, wenn bezähmbar, das Gefühl des Lobes und des Strebens mit den Menschen teilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ff28e3-4b29-4023-87fe-002faff5c599",
                        "source_entry_id": "8cb90d3d-c1cc-3928-a6f3-3176a737cacf",
