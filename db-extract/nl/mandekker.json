                        "glosses": [
                            "verdediger die ervoor zorgt dat een aanvaller van de tegenpartij geen kansen krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4efe9a-de4d-4560-b7f2-a518bc089441",
                                "sense_id": "2c538ca7-22f5-3f43-9db3-5ad5b79d155c",
                                "text": "De mandekker komt van Leicester City naar de vroegere club van zijn idool Rio Ferdinand."
                            },
                            {
                                "example_id": "a27bb8ae-21e7-4a14-9e56-262f223279ee",
                                "sense_id": "2c538ca7-22f5-3f43-9db3-5ad5b79d155c",
                                "text": "De Slowaakse mandekker Martin Skrtel (34) komt transfervrij naar Bergamo, nadat hij de afgelopen drie jaar uitkwam voor Fenerbahçe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
