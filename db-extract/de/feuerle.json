                ],
                "senses": [
                    {
                        "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                        "entry_id": "46b74f3d-a8d6-3452-8295-ab40e413740c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8858214a-2b1b-4b44-b62a-6efe172703b5",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Feuerles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4e014550-6714-4d21-9b5e-84bc37a203b2",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Feuerle kommt und geht."
                            },
                            {
                                "example_id": "8afb95e2-4f2f-407f-b2df-8313a4b7779f",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Frau Feuerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cb1f789e-a96d-419d-aece-ce286ee44274",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Herr Feuerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e46889c-0e53-433a-911b-665144e2fb78",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Die Feuerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "39ec61d9-9880-42e1-9bfa-2d98af28e6b1",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Der Feuerle trägt nie die Pullover, die die Feuerle ihm strickt."
                            },
                            {
                                "example_id": "fa8120a4-6603-4065-9cde-0c65eb54642b",
                                "sense_id": "9b32c046-6949-38d9-a62c-2601ab64b0eb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feuerle kommt, geht der Herr Feuerle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
