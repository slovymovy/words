                "senses": [
                    {
                        "sense_id": "ed6e2187-4f6b-3422-baa4-13c4e48afda8",
                        "entry_id": "88e402ca-bd12-3e5e-84d7-eeba85f706ae",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным галка; свойственный галке, характерный для неё, также принадлежащий галке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f4a74f-e624-4788-8702-76bd970be1ac",
                                "sense_id": "ed6e2187-4f6b-3422-baa4-13c4e48afda8",
                                "text": "В окне ― заря и галочьи стаи."
                            },
                            {
                                "example_id": "52d2c589-12b1-4253-a86d-c992b5e81503",
                                "sense_id": "ed6e2187-4f6b-3422-baa4-13c4e48afda8",
                                "text": "Кроме галочьих на снегу появились следы кошачьи."
                            }
                        ]
                    }
                ],
