                            {
                                "example_id": "b09ebed8-f158-4e5c-a727-3ffe2674619e",
                                "sense_id": "3a4105b1-4c1e-3f07-a591-a032038c04b8",
                                "text": "„Der Anschlag eines palästinensischen Selbstmordattentäters auf eine Familienfeier am Pessach-Abend 2002 in Netanja, bei dem 30 Israelis getötet und über 100 verletzt wurden, überschattete das Friedensangebot, verstärkte in Israel die Furcht vor dem Terrorismus und verdrängte die Initiative sofort aus Medien, Diskurs und Bewusstsein.“"
                            },
                            {
                                "example_id": "6bb0dbec-9d26-4094-96c2-b7b6f527970e",
                                "sense_id": "3a4105b1-4c1e-3f07-a591-a032038c04b8",
                                "text": "„Am Abend des 21. Mai reiste Eschkol nach Avichail nördlich von Netanja.“"
                            }
