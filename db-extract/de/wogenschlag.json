                "senses": [
                    {
                        "sense_id": "d3138e6c-3296-35f2-b36f-e35eee5c1d47",
                        "entry_id": "cc03ffd4-8df3-3f24-aa3c-9ba20b302c47",
                        "glosses": [
                            "die (hörbare) Bewegung oder das Anbranden einer Welle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f97acafc-33be-41f0-b71b-2a8bb17396cc",
                                "sense_id": "d3138e6c-3296-35f2-b36f-e35eee5c1d47",
                                "text": "„Einmal schlug eine so schwere Sturzsee in mein Boot, daß ich haltmachen und das Wasser ausschöpfen mußte; das Herz klopfte mir dabei wie einem Vogel, aber allmählich gewöhnte ich mich an die Lage und lenkte mein Korakel so geschickt durch die Wellen, daß nur ab und zu ein Wogenschlag seinen Bug traf und mir den Schaum ins Gesicht warf.“"
                            },
                            {
                                "example_id": "4e5a39ac-4992-4b8b-a4be-48e702c0cc1a",
                                "sense_id": "d3138e6c-3296-35f2-b36f-e35eee5c1d47",
                                "text": "„Zuweilen schien sein Wogenschlag auszusetzen; dann hörte man nur noch das leise Plätschern der Quellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
