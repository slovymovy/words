                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87d8cda-1584-49ef-9a93-895327a7f4bd",
                                "sense_id": "96066e73-1604-35c0-a9df-c05a930fa411",
                                "text": "Ma patrie, voyant cette misopédie des chanoines [qui refusaient à un jeune homme les moyens de s'instruire], …"
                            },
                            {
                                "example_id": "699dbabb-12f0-4de4-bc17-2682a80cb5cb",
                                "sense_id": "96066e73-1604-35c0-a9df-c05a930fa411",
                                "text": "La misopédie du groupe terroriste Boko Haram."
                            }
                        ]
                    }
                ],
