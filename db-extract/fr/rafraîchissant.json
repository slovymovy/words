                "senses": [
                    {
                        "sense_id": "6bbadf6b-e039-3201-8147-21737f8efd0a",
                        "entry_id": "021d5dad-32a9-3bc3-aad4-967760fe78ed",
                        "glosses": [
                            "Qui rafraîchit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d043ba-01ad-470a-8a68-327e4bdb438e",
                                "sense_id": "6bbadf6b-e039-3201-8147-21737f8efd0a",
                                "text": "La noix verte du cocotier donne une eau rafraîchissante."
                            },
                            {
                                "example_id": "95229a60-2862-4c12-9a1e-d3b7689f00da",
                                "sense_id": "6bbadf6b-e039-3201-8147-21737f8efd0a",
                                "text": "Une brise rafraîchissante."
                            }
                        ]
                    },
                    {
                        "sense_id": "db4c447c-24e8-3887-bc26-c0e464529d1a",
                        "entry_id": "021d5dad-32a9-3bc3-aad4-967760fe78ed",
                        "glosses": [
                            "Revigorant, plaisant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "79398054-19f7-4c7e-bf87-989397d9aabb",
                                "sense_id": "db4c447c-24e8-3887-bc26-c0e464529d1a",
                                "text": "Je ne sais ce que devint ce moine ou prétendu moine qu’il eût été si rafraîchissant de crever à la baïonnette."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fc7139f-9430-3b1e-83a1-3ad3ed0d38a7",
                        "entry_id": "021d5dad-32a9-3bc3-aad4-967760fe78ed",
                        "glosses": [
                            "Qualifie certains remèdes qui diminuent l’irritation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d3c336-8acd-4059-a1fe-486c183fdecc",
                                "sense_id": "7fc7139f-9430-3b1e-83a1-3ad3ed0d38a7",
                                "text": "On ne savait que faire, car on ignorait la nature de la maladie, mais sur le conseil de Madge, […], le mal fut combattu par des tisanes rafraîchissantes et des cataplasmes."
                            }
                        ]
                    }
