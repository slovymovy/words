                                "target_senses": [
                                    {
                                        "sense_id": "da5ca773-fa30-3491-92f5-0c52d4058f6c",
                                        "entry_id": "7d485044-20b3-34a5-a54c-e34749c7742d",
                                        "glosses": [
                                            "To sell; to offer for sale by outcry in the street; to carry (merchandise) about from place to place for sale; to peddle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d77ce8f-7b94-48f4-8b52-d72b5e74ec56",
                                                "sense_id": "da5ca773-fa30-3491-92f5-0c52d4058f6c",
                                                "text": "The vendors were hawking their wares from little tables lining either side of the market square."
                                            },
                                            {
                                                "example_id": "2259dfaa-8762-46a5-badb-283bffbcf20f",
                                                "sense_id": "da5ca773-fa30-3491-92f5-0c52d4058f6c",
                                                "text": "His works were hawked in every street."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hawk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2f6a8b-51e7-3092-851e-e55dcb7f6be8",
                                        "entry_id": "7167b785-9f21-3876-8b2d-511e64d65364",
                                        "glosses": [
                                            "A noisy effort to force up phlegm from the throat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hawk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                                        "entry_id": "44ee010e-c24d-3b82-9a1c-d65e9c3a2c8c",
                                        "glosses": [
                                            "To expectorate, to cough up (something, such as mucus) from one's throat; to produce (something) by coughing or clearing one's throat."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8084d39-1b1d-497d-bd15-c0db089053f9",
                                                "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                                                "text": "to hawk a loogie"
                                            },
                                            {
                                                "example_id": "1202dd3b-7935-4402-a934-81eefba8a591",
                                                "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                                                "text": "[I]s a trobled with the cough a the Lunges ſtill? does he hawke anights ſtill?"
                                            },
                                            {
                                                "example_id": "6470115b-69b5-423b-bef1-4f098f4a6883",
                                                "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                                                "text": "He hawked up, with incredible straining, the interjection ah!"
                                            },
                                            {
                                                "example_id": "4a8109a2-ecb5-4fbd-8724-89e65cb53cfa",
                                                "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                                                "text": "He had a new tough manner of pulling down breath and hawking into the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11348ce7-549e-31ca-bac9-2b7a837de5e8",
                                        "entry_id": "44ee010e-c24d-3b82-9a1c-d65e9c3a2c8c",
                                        "glosses": [
                                            "To try to cough up something from one's throat; to clear the throat loudly; to cough heavily, especially causing uvular frication."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
