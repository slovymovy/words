                                "sense_id": "68593ad6-5841-3c40-805b-1e8a8d3353a8",
                                "text": "Jackson liegt circa 100km westlich von Detroit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "acf2b8bb-fe58-37a3-812d-2f8350465453",
                        "entry_id": "8debb887-87e6-3330-b3ed-229d195bc93d",
