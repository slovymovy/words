                "senses": [
                    {
                        "sense_id": "904b42bf-8212-3a1a-a23f-f42d31709204",
                        "entry_id": "2172789d-a4eb-32f2-926d-d005af834300",
                        "glosses": [
                            "Monter (un cheval), plus ou moins bien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80dc1223-4e2a-4e54-b0f8-d41b2b1c37e7",
                                "sense_id": "904b42bf-8212-3a1a-a23f-f42d31709204",
                                "text": "De plus, je dirais que si tu souhaites le montailler de temps en temps doucettement, tu pourras mieux le faire, s’il vit dehors, car il se maintiendra un minimum en muscle."
                            },
                            {
                                "example_id": "c4c3b493-3f57-48cd-9ca3-8a42159f0876",
                                "sense_id": "904b42bf-8212-3a1a-a23f-f42d31709204",
                                "text": "Pour juger ce que les autres font, s’ils \"bricolent\" ou \"montaillent\", il faut d’abord comprendre."
                            },
                            {
                                "example_id": "721dbfd2-b4c4-4327-b9cb-e0cc9adbf6fa",
                                "sense_id": "904b42bf-8212-3a1a-a23f-f42d31709204",
                                "text": "Donc que tu passes à un autre moment de la journée pour t’en occuper + montailler un peu, à l’occasion, ça lui change les idées et le paysage, et elle doit être contente de ressortir du box."
                            }
                        ]
                    }
