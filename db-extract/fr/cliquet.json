                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c54fd331-e44e-35d1-b658-9f173c40d964",
                                        "entry_id": "d69caa7c-0826-308d-aff9-3ded12384240",
                                        "glosses": [
                                            "A ratchet wrench."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cb92bd6-bb6b-3289-81f8-05950f3c56b7",
                                        "entry_id": "d69caa7c-0826-308d-aff9-3ded12384240",
                                        "glosses": [
                                            "A procedure or regulation that goes in one direction, usually up."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d327039f-519a-4429-8883-6f5d149d37a0",
                                                "sense_id": "0cb92bd6-bb6b-3289-81f8-05950f3c56b7",
                                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7e87a3-f3ba-36a0-b92b-4351dc9eed9c",
                                        "entry_id": "d69caa7c-0826-308d-aff9-3ded12384240",
                                        "glosses": [
                                            "A noisemaker or musical instrument where sound is generated by a board striking against a rotating gear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f117ce64-5a12-4c38-9236-6725ccf85d89",
                                                "sense_id": "3f7e87a3-f3ba-36a0-b92b-4351dc9eed9c",
                                                "text": "Ahead of them a group of mandibulous sales men had set up their combustion cups and incendiary ratchets to demonstrate their wares to whatever officers might come by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52491851-22a6-3886-9345-6e6bd02ee7ea",
                                        "entry_id": "d69caa7c-0826-308d-aff9-3ded12384240",
                                        "glosses": [
                                            "Ellipsis of full ratchet."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ratchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90f232c1-5bd4-355e-a591-b910666d2483",
                                        "entry_id": "a65a47ff-b7eb-3e08-8f83-b75ff3103d1d",
                                        "glosses": [
                                            "To increment or decrement; especially, to offer controlled motion that can increment while resisting decrement, or vice versa."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8964b9c0-427a-4a7f-8f54-ca46e4ac9ff8",
                                                "sense_id": "90f232c1-5bd4-355e-a591-b910666d2483",
                                                "text": "This holddown ratchets, which allows the person loading the trailer to cinch down the straps."
                                            },
                                            {
                                                "example_id": "89725ddb-4084-41ca-80bd-4ba354cdd03a",
                                                "sense_id": "90f232c1-5bd4-355e-a591-b910666d2483",
                                                "text": "Compared with the excellent scroll wheels on the Basilisk V3 and G502 X, the G203’s scroll wheel feels less defined and mushier in its ratcheting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                        "entry_id": "a65a47ff-b7eb-3e08-8f83-b75ff3103d1d",
                                        "glosses": [
                                            "To cause (something) to become incremented or decremented."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e684750a-6ded-474e-8e7d-d98e8e2311aa",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "Get this holddown into position, but don't start ratcheting it yet. When I say go, you start ratcheting it, OK?"
                                            },
                                            {
                                                "example_id": "51314c0a-14cf-4de6-ab10-ac1e453942d7",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "It's time to ratchet up the intensity level here."
                                            },
                                            {
                                                "example_id": "5b3b6898-81e3-4a53-9ae3-9d6bd96b38e4",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ratchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3741e3b5-11a0-3e02-a58f-95407897b995",
                                        "entry_id": "d8a20476-4915-325b-a55a-6e7ec246a0e4",
                                        "glosses": [
                                            "Ghetto; unseemly, indecorous."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781d4500-fe4c-4cd4-91a3-39f152fc521d",
                                                "sense_id": "3741e3b5-11a0-3e02-a58f-95407897b995",
                                                "text": "The one thing that always accompanies Miley's ratchet look (along with the gang signs) is the tongue, which is sort of like saying this persona that she has adopted is some sort of gonzo idiot who can't keep its tongue in her head."
                                            },
                                            {
                                                "example_id": "c3474751-29f9-426b-b8df-3bc35e55aab7",
                                                "sense_id": "3741e3b5-11a0-3e02-a58f-95407897b995",
                                                "text": "The feminine-meets-fiesty creations are right on par with all the reasons we love the rightgeously^([sic]) ratchet “Work” singer — and she knows it."
                                            },
                                            {
                                                "example_id": "57e4530d-6136-42f4-b2a5-a92cceee396e",
                                                "sense_id": "3741e3b5-11a0-3e02-a58f-95407897b995",
                                                "text": "Classy in the streets but we ratchet"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ratchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee5d424-0686-390e-b323-89b417593449",
                                        "entry_id": "a8c866de-e79d-37ef-ad18-8bc0d740ccd9",
                                        "glosses": [
                                            "A person, usually a female, who acts or behaves in a ghetto, unseemly, or indecorous way or manner."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a2fa79b-7f50-421c-98d5-3007a99205af",
                                                "sense_id": "0ee5d424-0686-390e-b323-89b417593449",
                                                "text": "I love it when jaboons let their jibbering get them in 5 times as much trouble as they're already in. Let's see if this ratchet can keep her dick trap shut in court."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
