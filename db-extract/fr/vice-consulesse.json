                        "glosses": [
                            "Épouse d’un vice-consul."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f38c69af-d85c-47bb-908c-7fc61283de5e",
                                "sense_id": "ad137d1c-c5e7-3094-b332-0a42e6ff2cd6",
                                "text": "Elle suivra certes son mari dans tous les aspects et les degrés de sa carrière , qu’elle soit “drogmanesse”, “consulesse”, “vice-consulesse” ou épouse de négociant, voire de simple “commis de commerce”, mais elle le fera plutôt “de l’intérieur” que par la tentative impensable d’un parallélisme de carrière, sachant que “chacun doit rester à sa place”."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa6e7234-118d-31ed-a9f3-20ec9ec27e7d",
                        "entry_id": "99100a0a-bf7f-3945-9555-19d834984c75",
                        "glosses": [
                            "Celle qui supplée le consul en son absence, ou qui fait les fonctions de consul dans les lieux où il n’y a point de consul."
                        ],
                        "tags": [
                            "Métier",
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebe236c-a04c-421e-8bc2-249d10f71b8f",
                                "sense_id": "fa6e7234-118d-31ed-a9f3-20ec9ec27e7d",
                                "text": "En tant que Vice-Consulesse de Séquanie, Préteuse de notre Justice, Édile de notre Circonscription, Questeuse de nos Finances, et Curionne présidant nos Cérémonies, donne l’ordre !"
                            }
                        ]
                    }
