                    {
                        "translation_id": "2c2b708f-9ee5-4b0b-9118-c673cfdfb6a6",
                        "source_entry_id": "f7295ff3-9889-3fec-9a90-28d30b364a87",
                        "source_sense_id": "032b4ec4-a89b-3711-9fa0-f778b7b705ed",
                        "target_lang_word": "well-to-do",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-to-do",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e19037ae-4734-355d-9a9f-bab0c6aa18a1",
                                        "entry_id": "c7c2a63a-d6d5-35c2-8ea9-e5983c013a14",
                                        "glosses": [
                                            "Rich, prosperous, financially stable and comfortable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97a221a-f502-4e58-b7b6-ecba5199ba10",
                                                "sense_id": "e19037ae-4734-355d-9a9f-bab0c6aa18a1",
                                                "text": "Some philosophers aver that the well-to-do should be taxed at a higher rate than poorer people."
                                            },
                                            {
                                                "example_id": "f684f4ff-16d4-44f0-a36b-93a55e2c3457",
                                                "sense_id": "e19037ae-4734-355d-9a9f-bab0c6aa18a1",
                                                "text": "From another point of view, it was a place without a soul. The well-to-do had hearts of stone; the rich were brutally bumptious; the Press, the Municipality, all the public men, were ridiculously, vaingloriously self-satisfied."
                                            },
                                            {
                                                "example_id": "9e19b3c3-cecc-459f-b553-7809d1ad8937",
                                                "sense_id": "e19037ae-4734-355d-9a9f-bab0c6aa18a1",
                                                "text": "There was a single arrivals platform, nearest to King's Cross. The large arch beneath the clock gave access to Hansom carriages clip-clopping up the cobbled ramp from the main gate in Euston Road, directly onto the platform, to meet well-to-do passengers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7595a7c3-1f91-4a9d-b2b4-b545532e9553",
                        "source_entry_id": "f7295ff3-9889-3fec-9a90-28d30b364a87",
