                        "examples": [
                            {
                                "example_id": "827baf94-b1ad-4c14-8e7d-dc6ccf6f5525",
                                "sense_id": "ee6ab9af-a00d-3474-8c50-d8f4b4d109c9",
                                "text": "Ik trek veel aandacht bij de dames in mijn flitsende, rode cabrio."
                            },
                            {
                                "example_id": "2f833052-f378-4f1f-b922-41e1e8d9b13d",
                                "sense_id": "ee6ab9af-a00d-3474-8c50-d8f4b4d109c9",
                                "text": "Ooit had ik een Mercedes van de zaak, een Mercedes cabrio en een Volkswagen. Ik droom ervan dat we na ons pensioen een cabrio-vierzitter van Mercedes hebben, dan kunnen de kinderen mee. Annemarie wil dan een Range Rover Vogue. Vroeger vond ik bezit echt belangrijk, sinds ik kanker heb gehad niet meer. Gezondheid is nu belangrijker.”"
                            }
                        ]
