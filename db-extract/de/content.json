                "senses": [
                    {
                        "sense_id": "6cfc42fa-438b-33a3-8dfe-e5991d077ef7",
                        "entry_id": "59025472-cf8c-37af-baa5-3eb14899bf20",
                        "glosses": [
                            "Inhalt (zum Beispiel Text, Audio- oder Videomaterial), der über Massenmedien verbreitet wird"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "0601d400-047f-46d7-833b-8d37443a3120",
                                "sense_id": "6cfc42fa-438b-33a3-8dfe-e5991d077ef7",
                                "text": "„Wem darf der Content auf welche Weise zugängig gemacht werden?“"
                            },
                            {
                                "example_id": "bb2b2c37-f451-4aea-9a96-eaf8367c4a93",
                                "sense_id": "6cfc42fa-438b-33a3-8dfe-e5991d077ef7",
                                "text": "„Diese Contents können zum einen der Unterhaltung dienen, andererseits aber auch einen Nutzen stiften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c5589e6-7765-4a8e-b0b0-888a80fc7fe4",
                        "source_entry_id": "59025472-cf8c-37af-baa5-3eb14899bf20",
                        "source_sense_id": "6cfc42fa-438b-33a3-8dfe-e5991d077ef7",
                        "source_sense_description": "EDV: Inhalt (zum Beispiel Text, Audio- oder Videomaterial), der über Massenmedien verbreitet wird",
                        "target_lang_word": "content",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "391d8dc6-2ed7-3cb3-924e-380a8fc1e4d5",
                                        "entry_id": "2cd10522-82a8-39ca-9212-fb4011d6999e",
                                        "glosses": [
                                            "Satisfied, pleased, contented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5770e5d-7b3d-4a5b-bd8a-6a91c74daaaf",
                                                "sense_id": "391d8dc6-2ed7-3cb3-924e-380a8fc1e4d5",
                                                "text": "This new-comer was a man who in any company would have seemed striking.[…]He was smooth-faced, and his fresh skin and well-developed figure bespoke the man in good physical condition through active exercise, yet well content with the world's apportionment."
                                            },
                                            {
                                                "example_id": "de61fe65-66bf-4853-b417-0a5affebf676",
                                                "sense_id": "391d8dc6-2ed7-3cb3-924e-380a8fc1e4d5",
                                                "text": "You, Aubrey, are my most complete man. You're brave, compassionate, kind: a content man. That is your secret—contentment; I am 24 and I've never known it. I'm forever in pursuit, and I don't even know what I am chasing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                        "entry_id": "b3f1fe0d-ddf2-33da-8560-ca6410762db6",
                                        "glosses": [
                                            "Satisfaction, contentment; pleasure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9dcb8f-1ccc-4f19-b7a0-dc2927c8f48e",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "They were in a state of sleepy content after supper."
                                            },
                                            {
                                                "example_id": "d9d820fb-c5f6-446a-a32e-b8a3835a18af",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "‘It is very difficult to […] learn to seek content, instead of happiness.’"
                                            },
                                            {
                                                "example_id": "8851567e-5b5a-4627-8832-6ce7d9250133",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "‘I understand you—upon every other subject, but the only one, my content requires, you are ready to obey me.’"
                                            },
                                            {
                                                "example_id": "a4455f37-d311-453f-8eb1-d2107eb77418",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "Like an empress, I feel great content surrounded by the familiar sounds of laughter, bickering, rattling plates, clicking chopsticks, smacking lips, and noisy sipping of the longevity brew."
                                            },
                                            {
                                                "example_id": "1c402fcb-0887-4677-af31-661610433954",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "Such is the fullness of my heart's content."
                                            },
                                            {
                                                "example_id": "0a6f5466-ffa2-4062-9a8b-bdc1ed1d08aa",
                                                "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                                                "text": "Kleph moved slowly from the door and sank upon the chaise longue with a little sigh of content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6409ba93-7e96-3667-a2b8-8524dbe3a38e",
                                        "entry_id": "b3f1fe0d-ddf2-33da-8560-ca6410762db6",
                                        "glosses": [
                                            "Acquiescence without examination."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef0cce4-cdda-4291-a41f-2d1bc0d659aa",
                                                "sense_id": "6409ba93-7e96-3667-a2b8-8524dbe3a38e",
                                                "text": "The sense they humbly take upon content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464ec01b-a057-39d0-b999-3107053e521e",
                                        "entry_id": "b3f1fe0d-ddf2-33da-8560-ca6410762db6",
                                        "glosses": [
                                            "That which contents or satisfies; that which if attained would make one happy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab86bb98-5377-4cd1-8fb1-ff449fba9fe7",
                                                "sense_id": "464ec01b-a057-39d0-b999-3107053e521e",
                                                "text": "So will I in England work your grace's full content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b09fbb-9381-3fe1-b698-6db5a82b4b73",
                                        "entry_id": "b3f1fe0d-ddf2-33da-8560-ca6410762db6",
                                        "glosses": [
                                            "An expression of assent to a bill or motion; an affirmative vote."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c96c40c-3316-3138-95ac-0633d6c431b8",
                                        "entry_id": "b3f1fe0d-ddf2-33da-8560-ca6410762db6",
                                        "glosses": [
                                            "A member who votes in assent."
                                        ],
                                        "tags": [
                                            "UK",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a158eaa-895e-3bde-9801-4e5fecf9b627",
                                        "entry_id": "d27e5ae3-5813-3e7f-acd3-72cc30d2fdaa",
                                        "glosses": [
                                            "Alright, agreed."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                                        "entry_id": "85dfa78e-5524-34dc-87c2-961bd318b502",
                                        "glosses": [
                                            "To give contentment or satisfaction to; to satisfy; to make happy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7390d2e8-2c16-4bdb-852f-13e28c4b89a0",
                                                "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                                                "text": "You can't have any more. You'll have to content yourself with what you already have."
                                            },
                                            {
                                                "example_id": "2f7fd814-58d3-4d18-9a3d-a6f59d1eb5c6",
                                                "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                                                "text": "And so Pilate, willing to content the people, released Barabbas unto them, and delivered Jesus, when he had scourged him, to be crucified."
                                            },
                                            {
                                                "example_id": "f67f40b5-60ba-4cf4-b9aa-8117f2020b97",
                                                "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                                                "text": "Do not content yourselves with meer Words and Names, lest your laboured Improvements only amass a heap of unintelligible Phrases, and you feed upon Husks instead of Kernels."
                                            },
                                            {
                                                "example_id": "e9d2b4b1-4e57-4fda-ac0d-584654d2fe48",
                                                "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                                                "text": "Caz Hildebrand and Jacob Kenedy recommend rigatoni in the Geometry of Pasta, and Christopher Boswell, the chef behind the Rome Sustainable Food project, prefers wholemeal paccheri or rigatoni in his book Pasta, on the basis that “the flavour of the whole grain is strong enough to stand up to the sharp and salty sheep’s milk cheese” (as I can find neither easily, I have to content myself with brown penne instead)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2ba9c7-813b-30f7-87f6-07a2d4a261a8",
                                        "entry_id": "85dfa78e-5524-34dc-87c2-961bd318b502",
                                        "glosses": [
                                            "To satisfy the expectations of; to pay; to requite."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5619d0d9-91da-4865-929b-4ed7dee2605d",
                                                "sense_id": "7e2ba9c7-813b-30f7-87f6-07a2d4a261a8",
                                                "text": "Come the next Sabbath, and I will content you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd88234d-b3f4-3720-8060-9de7073fcbe5",
                                        "entry_id": "3d106018-24c8-34b6-9e95-16c415faf426",
                                        "glosses": [
                                            "Contained."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "content",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f80c8d5-d9ae-386b-8f7a-bc83466016e9",
                                        "entry_id": "6e428c06-f62a-3fcb-84fa-9d5102d4b112",
                                        "glosses": [
                                            "That which is contained."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                        "entry_id": "6e428c06-f62a-3fcb-84fa-9d5102d4b112",
                                        "glosses": [
                                            "Subject matter; semantic information (or a portion or body thereof); that which is contained in writing, speech, video, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3d6690-569f-48b9-ba76-3d5edd44daf3",
                                                "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                                "text": "Although eloquently delivered, the content of the speech was objectionable."
                                            },
                                            {
                                                "example_id": "538e808e-eaed-4f14-8257-de8bb44cb591",
                                                "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                                "text": "You can look up the chapter on special relativity in the table of contents."
                                            },
                                            {
                                                "example_id": "618fe1c0-8b6a-413b-949c-c82f3ec2ab6b",
                                                "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                                "text": "Hugh admitting that he never had, and moreover that he couldn’t read, Mrs Varden declared with much severity, that he ought to he even more ashamed of himself than before, and strongly recommended him to save up his pocket-money for the purchase of one, and further to teach himself the contents with all convenient diligence."
                                            },
                                            {
                                                "example_id": "95b72207-d750-45c1-914d-243f6b140954",
                                                "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                                "text": "In the future, instead of bottles of dead \"content,\" I imagine electronically defined venues, where minds residing in bodies scattered all over the planet are admitted, either by subscription or a ticket at a time, into the real-time presence of the creative act."
                                            },
                                            {
                                                "example_id": "55a09263-48b2-4f1f-af49-7a1520e7c93d",
                                                "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36c81ef9-432f-3a85-8634-ce94f02bdb54",
                                        "entry_id": "6e428c06-f62a-3fcb-84fa-9d5102d4b112",
                                        "glosses": [
                                            "Subject matter; semantic information (or a portion or body thereof); that which is contained in writing, speech, video, etc.",
                                            "One or more creative works."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e153e278-75f4-4306-bec6-42df30bb2444",
                                                "sense_id": "36c81ef9-432f-3a85-8634-ce94f02bdb54",
                                                "text": "Some online video creators upload new content every day."
                                            },
                                            {
                                                "example_id": "148711d0-4daa-4a3d-9bd5-531197941bc0",
                                                "sense_id": "36c81ef9-432f-3a85-8634-ce94f02bdb54",
