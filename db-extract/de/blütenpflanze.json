                "senses": [
                    {
                        "sense_id": "25e654ce-0ab8-3ca4-967d-4ef383cd4ae0",
                        "entry_id": "e9ae4149-f7d8-3f2e-9b04-a31bddb29176",
                        "glosses": [
                            "die höheren Pflanzen, die als Fortpflanzungsorgan echte Blüten ausbilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f12e292e-b12b-4555-8ddf-6f98934f49ec",
                                "sense_id": "25e654ce-0ab8-3ca4-967d-4ef383cd4ae0",
                                "text": "Die Gruppe der Blütenpflanzen umfasst die einfacher organisierten Nacktsamer (=Gymnospermen, d.s. hauptsächlich Nadelhölzer) und die höher organisierten Bedecktsamer (=Angiospermen, d.s. die eigentlichen, höheren Blütenpflanzen)."
                            },
                            {
                                "example_id": "01e9a98c-0bd2-4157-80e9-54f0e6c8b6ce",
                                "sense_id": "25e654ce-0ab8-3ca4-967d-4ef383cd4ae0",
                                "text": "„Die Blütenpflanzen beeinflussen außerdem das Klima, gestalten unsere Ökosysteme und haben sogar zur Entstehung zahlreicher neuer Insekten, Pilze und Vögel beigetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4903613-96b0-41c0-aaea-e98ea827df81",
                        "source_entry_id": "e9ae4149-f7d8-3f2e-9b04-a31bddb29176",
                        "source_sense_id": "25e654ce-0ab8-3ca4-967d-4ef383cd4ae0",
                        "source_sense_description": "Botanik: die höheren Pflanzen, die als Fortpflanzungsorgan echte Blüten ausbilden",
                        "target_lang_word": "plante à fleurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plante à fleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a254a435-08fd-3edd-a9ce-6cb4024775d5",
                                        "entry_id": "1531a576-448e-3c73-b7cf-753a072005ef",
                                        "glosses": [
                                            "Synonyme d’angiosperme ou Magnoliophyta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f497dc-d957-4887-86cc-979854a44269",
                                                "sense_id": "a254a435-08fd-3edd-a9ce-6cb4024775d5",
                                                "text": "On doit en effet rapporter à des cryptogames et à des gymnospermes, les plus anciennes empreintes connues d'origine sûrement végétale (silurien supérieur), tandis que les premières plantes à fleurs (angiospermes) ont été retrouvées dans des couches beaucoup plus récentes (zénomanien)."
                                            },
                                            {
                                                "example_id": "37ddccb4-636a-49ec-808a-0219d6a2ea03",
                                                "sense_id": "a254a435-08fd-3edd-a9ce-6cb4024775d5",
                                                "text": "C'est seulement à la fin du secondaire, à l'époque crétacée qu'apparaissent les angiospermes ou plantes à fleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
