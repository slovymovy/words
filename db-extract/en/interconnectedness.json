                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interconnexion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                        "entry_id": "4663713d-1299-391e-bdac-470c0b5f04e3",
                                        "glosses": [
                                            "Intégration d’un ensemble par des connexions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52695b7a-990d-40c6-a862-7eedba59f7fc",
                                                "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                                "text": "Notre cerveau contient six milliards de cellules nerveuses. Chacune d’elles peut se relier à vingt-cinq mille autres. Le nombre des interconnexions possibles a de quoi faire vaciller l’esprit…"
                                            },
                                            {
                                                "example_id": "c126cbee-e5c6-4f2a-a84e-d3e50e57b17f",
                                                "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                                "text": "Les équipements d’interconnexion d’un réseau informatique sont les briques constitutives des réseaux informatiques physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                        "entry_id": "4663713d-1299-391e-bdac-470c0b5f04e3",
                                        "glosses": [
                                            "Connexion qui intègre un ou plusieurs systèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eeae6ae-a9b9-497e-ab3a-fc05a167558d",
                                                "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                                "text": "Le traitement et les fichiers ne font l’objet d’aucune interconnexion, aucun rapprochement ni aucune forme de mise en relation avec d’autres traitements ou fichiers."
                                            },
                                            {
                                                "example_id": "5aadddbf-c909-445f-93cc-de77994341e3",
                                                "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                                "text": "Le routage sur internet n’est pas effectué par une instance centralisée, vu la taille du réseau et son organisation. Difficile d’organiser autour d’un seul protocole ce qui est avant tout une interconnexion de réseaux très différents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
