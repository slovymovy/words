                        "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                        "entry_id": "2515e2cf-c9d5-31d0-a3da-e0d1f27337e5",
                        "glosses": [
                            "Variante de seringa."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6db97fa1-1d67-4b62-b5d3-a502b7a9ccf4",
                                "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                                "text": "J’aime ce parc romantique où s’élèvent majestueusement chênes, marronniers, cèdres et magnolias dont l’ancienneté témoigne qu’ils ne sont pas les caprices arboricoles de nouveaux riches. Sous leurs frondaisons, des bosquets de seringats se livrent à une sauvage exubérance."
                            },
                            {
                                "example_id": "d2cf32dd-a388-4314-a41c-596731ac1126",
                                "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                                "text": "C’est une gamme parcourant tout le clavier de l’odorat, touchant aux entêtantes senteurs du seringat et du sureau."
                            }
                        ]
                    }
                ],
