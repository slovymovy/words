                "senses": [
                    {
                        "sense_id": "58294ea7-2d5d-3397-a6bc-29866ef32d38",
                        "entry_id": "542b52a8-de02-3edf-bf77-9c7e18a4869f",
                        "glosses": [
                            "weibliche Person, die (oft als Mitglied) im Auftrag einer Regierung handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b2f97f-3619-4a76-86dd-ceebcb375fd5",
                                "sense_id": "58294ea7-2d5d-3397-a6bc-29866ef32d38",
                                "text": "„Dass sie noch dazu offensiv die Entlassung einer ranghoher Regierungsvertreterin verlangt, lässt umso mehr aufhorchen.“"
                            },
                            {
                                "example_id": "65ea6998-6bbb-49bb-93dc-8815cb7b7887",
                                "sense_id": "58294ea7-2d5d-3397-a6bc-29866ef32d38",
                                "text": "„Ein ganz anderer Wunsch für Mays Gespräche mit den beiden Staatschefs kam derweil von der britischen Regierungsvertreterin Andrea Leadsom: Sie hat Änderungen am längst fertig gezurrten Brexit-Abkommen vorgeschlagen.“"
                            },
                            {
                                "example_id": "4682e205-2d22-4177-b454-95b6e7f3b06c",
                                "sense_id": "58294ea7-2d5d-3397-a6bc-29866ef32d38",
                                "text": "„Nach versehentlich von einer belgischen Regierungsvertreterin veröffentlichten Informationen ist das Moderna-Mittel mit 18 Dollar (14,66 Euro) je Dosis am teuersten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
