                                        "glosses": [
                                            "die zum Kampf befähigende Stärke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f39d8d5-3239-40b0-a0af-60f3a4506ee0",
                                                "sense_id": "ad33835d-45b9-316d-922b-eb8f3ed6802a",
                                                "text": "„Die seit der Epoche Alexanders des Großen anerkannte Dominanz der makedonischen Phalanx wurde durch die Schlagkraft der römischen Legionen abgelöst.“"
                                            },
                                            {
                                                "example_id": "3e2a4602-ac17-42a3-80dd-91f36c1d40a0",
                                                "sense_id": "ad33835d-45b9-316d-922b-eb8f3ed6802a",
                                                "text": "„Der geflügelte Löwe sollte den Herrschaftsanspruch und die militärische Schlagkraft der Hafenstadt symbolisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7564642f-f574-331a-a0fd-1a5f1bfb8f24",
                                        "entry_id": "bd73863a-f8e3-3947-a9b8-109307064263",
                                        "glosses": [
                                            "Fähigkeit, eine überzeugend Wirkung zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13718a0-cd4d-49fd-aa6f-b9d3c8b4dfb6",
                                                "sense_id": "7564642f-f574-331a-a0fd-1a5f1bfb8f24",
                                                "text": "Gegen die Schlagkraft seiner Argumente ist kein Kraut gewachsen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
