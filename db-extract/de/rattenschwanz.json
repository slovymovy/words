                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54665262-2609-482e-a5d4-c2c747feff77",
                                "sense_id": "95f65972-dc15-3e67-bc18-c6bb07b955ff",
                                "text": "Sie trägt ihre grauen Haare kurz, mit einem Rattenschwanz, der sich über ihren Nacken schlängelt."
                            }
                        ],
