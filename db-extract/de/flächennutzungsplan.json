                        "sense_id": "6c4a3543-bf54-3d05-bde1-b45716c6f15f",
                        "entry_id": "54af45f4-26cd-339e-a489-96395038f3e3",
                        "glosses": [
                            "eine öffentliche Darlegung, wie eine Stadt oder Gemeinde ihr Gebiet zu nutzen beabsichtigt"
                        ],
                        "tags": [
                            "Raumplanung"
                        ],
                        "examples": [
                            {
                                "example_id": "e24a0b9a-ecc5-46c3-bdd9-117c001cc272",
                                "sense_id": "6c4a3543-bf54-3d05-bde1-b45716c6f15f",
                                "text": "Der Flächennutzungsplan „ist das Ergebnis eines grundsätzlichen politischen sowie fachlichen Planungsprozesses einer Gemeinde.“"
                            },
                            {
                                "example_id": "ce0f961f-3e9a-418e-871b-97421270ced7",
                                "sense_id": "6c4a3543-bf54-3d05-bde1-b45716c6f15f",
                                "text": "Unsere Stadt hat angekündigt, bald einen neuen Flächennutzungsplan aufzustellen."
                            },
                            {
                                "example_id": "e57eda92-5d88-4b16-b915-d8023e23868c",
                                "sense_id": "6c4a3543-bf54-3d05-bde1-b45716c6f15f",
                                "text": "Über das Internet kann jedermann in die Flächennutzungspläne der Gemeinden Einsicht nehmen."
                            }
