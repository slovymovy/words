                        "source_sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                        "source_sense_description": "Technik: Teil einer Bremse, der die Umdrehungsgeschwindigkeit von Rädern verringert",
                        "target_lang_word": "sabot de frein",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
