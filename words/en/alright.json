                                "nl": "<w>Hoi</w> Dave, hoe gaat het?",
                                "pl": "<w>Cześć</w>, Dave? Jak leci?",
                                "de": "<w>Alles klar</w>, Dave? Wie läuft's?",
                                "fr": "<w>Salut</w> Dave, comment ça va ?",
                                "it": "<w>Tutto bene</w>, Dave? Come vanno le cose?",
                                "cs": "<w>Ahoj</w>, Dave? Jak se máš?",
                                "tr": "<w>Selam</w> Dave, nasıl gidiyor?",
                                "es": "¿<w>Qué tal</w>, Dave? ¿Cómo va todo?"
                            }
                        }
