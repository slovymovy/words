                "senses": [
                    {
                        "sense_id": "a18f30b0-faa7-3893-a0b2-19cfdb0143a5",
                        "entry_id": "35b4f737-05ee-39aa-90f2-5851775a12f5",
                        "glosses": [
                            "разг., сниж. что-либо растопыренное, неуклюже изогнутое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f62cc42-f834-4a15-b4d5-e43d8485f2c8",
                                "sense_id": "a18f30b0-faa7-3893-a0b2-19cfdb0143a5",
                                "text": "Лерик плохо писал — перо у него то и дело брызгало, буквы выходили раскоряки."
                            }
                        ]
                    },
                    {
                        "sense_id": "450d73a8-819d-3b09-a946-f84b1bb2dbf5",
                        "entry_id": "35b4f737-05ee-39aa-90f2-5851775a12f5",
                        "glosses": [
                            "разг., сниж. сделанный из жердей или планок треугольник с ножками, употребляемый при измерении земельных участков"
                        ],
                        "tags": [],
                        "examples": []
