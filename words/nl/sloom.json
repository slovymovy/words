                    "sense_id": "315a9cef-2833-3469-b815-fa95167a76aa",
                    "sense_definition": "Traag, futloos en zonder energie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange werkdag voel ik me vaak erg <w>sloom</w>.",
                            "target_lang_translations": {
                                "en": "After a long workday, I often feel very <w>sluggish</w>.",
                                "de": "Nach einem langen Arbeitstag fühle ich mich oft sehr <w>träge</w>."
                            }
                        },
                        {
                            "text": "De computer is de laatste tijd ontzettend <w>sloom</w> geworden.",
                            "target_lang_translations": {
                                "en": "The computer has become incredibly <w>slow</w> lately.",
                                "de": "Der Computer ist in letzter Zeit unglaublich <w>langsam</w> geworden."
                            }
                        }
                    ],
                    "synonyms": [
