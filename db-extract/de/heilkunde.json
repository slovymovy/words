                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1df4a345-c5e7-4b14-a4ef-536b15c68558",
                        "source_entry_id": "b01a39dc-7ac1-336e-b8a8-82c4a69be7da",
                        "source_sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                        "target_lang_word": "medicine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medicine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6001a5-ba8f-3927-befd-be2299155d39",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "A substance which specifically promotes healing when ingested or consumed in some way; a pharmaceutical drug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafdaa11-a828-451a-a1cd-ba5da76edfff",
                                                "sense_id": "6c6001a5-ba8f-3927-befd-be2299155d39",
                                                "text": "This medicine has fewer adverse effects than others in its drug class."
                                            },
                                            {
                                                "example_id": "39a08e30-d6fe-46d4-b5a5-f3d42318381e",
                                                "sense_id": "6c6001a5-ba8f-3927-befd-be2299155d39",
                                                "text": "Using a weekly pill organizer is a good way to help remind yourself to take your medicine each day, and it also tells you whether you already took today's pills (it's not unusual to forget doing a habitual task)!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f70bec-bb95-3f26-9b9f-85106be8aa35",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "Any treatment or cure."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6757bf5c-89b7-4079-b9ff-4cfbeb7bd915",
                                                "sense_id": "e5f70bec-bb95-3f26-9b9f-85106be8aa35",
                                                "text": "A legislative remedy might be some harsh medicine; is that cure worse than the ill?"
                                            },
                                            {
                                                "example_id": "5defcd18-5894-424c-a7c7-f5f3b0c1835f",
                                                "sense_id": "e5f70bec-bb95-3f26-9b9f-85106be8aa35",
                                                "text": "Surely every medicine is an innovation; and he that will not apply new remedies, must expect new evils […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9fa76f-df4b-39a6-a9f9-eea0fd1f3c89",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "The study of the cause, diagnosis, prognosis and treatment of disease or illness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef0389f-8f86-4b7d-b25b-7d5dcdbbf021",
                                                "sense_id": "ac9fa76f-df4b-39a6-a9f9-eea0fd1f3c89",
                                                "text": "She's studying medicine at university because she wants to be a doctor in the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a87978-1a5b-3e2a-92a0-2c5214e0d02e",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "The profession and practice of physicians, including surgeons."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb16df6-6269-4b39-856f-8ca78a0cec53",
                                                "sense_id": "f0a87978-1a5b-3e2a-92a0-2c5214e0d02e",
                                                "text": "The history of medicine can be discretized into eras with differing relationships between physicians and surgeons"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09c73151-9b17-320d-9f39-2fe728b18ee5",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "The profession and practice of physicians, including surgeons.",
                                            "The profession and practice of nonsurgical physicians as sometimes distinguished from that of surgeons."
                                        ],
                                        "tags": [
                                            "historical",
                                            "mainly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8149475d-8103-4974-898f-5c605c02a574",
                                                "sense_id": "09c73151-9b17-320d-9f39-2fe728b18ee5",
                                                "text": "the evolving relationship of medicine to surgery in the nineteenth century"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "779e1c47-39b7-3b5b-b416-fe0926438745",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "Ritual magic used, as by a medicine man, to promote a desired outcome in healing, hunting, or warfare; traditional medicine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16ed558d-6d99-302f-8036-5dc7088a2d48",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "Among the Native Americans, any object supposed to give control over natural or magical forces, to act as a protective charm, or to cause healing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8802ae37-7f29-48bc-9ac2-382a770b3902",
                                                "sense_id": "16ed558d-6d99-302f-8036-5dc7088a2d48",
                                                "text": "The North American Indian boy usually took as his medicine the first animal of which he dreamed during the long and solitary fast that he observed at puberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5525d0e-d5d4-3915-8d2f-cf822f4abab1",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "Black magic, superstition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f5d033e-92b4-3bbb-8343-14e4e39c661e",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "A philter or love potion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a19476-22d6-44f3-894a-a3943bf791ac",
                                                "sense_id": "3f5d033e-92b4-3bbb-8343-14e4e39c661e",
                                                "text": "If the rascal have not given me medicines to make me love him, I'll be hanged. It could not be else. I have drunk medicines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c542c3-f21b-3945-a413-1f772809ad76",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "A physician."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ade46066-e94a-450b-a7f4-67c7b7dc92ab",
                                                "sense_id": "a2c542c3-f21b-3945-a413-1f772809ad76",
                                                "text": "I have seen a medicine / That's able to breathe life into a stone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d9ab074-2226-359c-a0f4-9cd8614918ab",
                                        "entry_id": "8b32abd6-e0b8-3db0-9fa7-874c9d93523b",
                                        "glosses": [
                                            "Recreational drugs, especially alcoholic drinks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "medicine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d97de0f-b70a-36c9-b45c-23e8dfa2062a",
                                        "entry_id": "1fdd8ef8-f350-3427-b0ee-8734e0493a9c",
                                        "glosses": [
                                            "To treat with medicine."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22838822-a545-4744-8cfe-2531077d88f4",
                                                "sense_id": "1d97de0f-b70a-36c9-b45c-23e8dfa2062a",
                                                "text": "And we shall find, under the head of the medicining of the body, some things on the subject of medicine in general, which could be better said there than here, because of the wrath of professional dignitaries,- the eye of the 'basilisk,' was not perhaps quite so terrible in that quarter then, as it was in some others."
