                        "examples": [
                            {
                                "example_id": "ba51b3de-170b-498e-ba53-43e3edb2b95c",
                                "sense_id": "bfcdcf49-8df6-3bff-af14-fefb19f8023a",
                                "text": "Caroline vertrekt met een groep medici van de vzw See and Smile. Ze is verpleegster in het AZ Groeninge in Kortrijk waar ze werkt op de dienst oogchirurgie en de afdeling neus-, keel- en oorziekten. De Standaard 17 SEPTEMBER 2009 OM 00:00 UUR"
                            },
                            {
                                "example_id": "187c5408-6059-4ee2-9186-1d16c21d1f2e",
                                "sense_id": "bfcdcf49-8df6-3bff-af14-fefb19f8023a",
                                "text": "Zeldzamere oorzaken van misselijkheid zijn ontstekingen van de maag of de darm, oorziekten, lever- en nierziekten, stofwisselingsziekten, suikerziekte, hormonale ziekten, verhoogde hersendruk, en intoxicaties met (genees)middelen."
                            },
                            {
                                "example_id": "d13751d2-5bcf-42d3-b248-d7e048d747d3",
                                "sense_id": "bfcdcf49-8df6-3bff-af14-fefb19f8023a",
                                "text": "Peking heeft daarom aangekondigd dat er fiscale maatregelen genomen zullen worden om boeren te stimuleren meer varkens te produceren. Ook de strategische voorraad van enkele honderdduizenden varkens zal worden ingezet om de tekorten als gevolg van overstromingen, droogte en de blauwe oorziekte op te vullen."
                            }
                        ]
