                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb6afa1-e56c-48e4-b9c4-83c31b325f49",
                                "sense_id": "8f408d35-89ef-34ca-ab02-8f335224c821",
                                "text": "Der Körper wurde aufgrund einer vorhergehenden Dekapitation ohne Kopf aufgefunden."
