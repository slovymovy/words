                    },
                    {
                        "sense_id": "2f72cc87-254c-389b-972e-9355ec16c19f",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
                            "brązowawy pigment używany w malarstwie, glinka farbiarska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bfd620-9235-4857-b12a-5c6a32a14497",
                                "sense_id": "2f72cc87-254c-389b-972e-9355ec16c19f",
                                "text": "Producentami umbry są głównie Cypr, Anglia, Francja, Niemcy i Ameryka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "fe590e60-9512-37f3-9480-625ed6b2a035",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
                            "Umbra krameri, gatunek szczupakokształtnej ryby z rodziny muławkowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc99c7ef-e31c-41f2-851e-a20ed3873aaa",
                                "sense_id": "fe590e60-9512-37f3-9480-625ed6b2a035",
                                "text": "Ubarwienie umbry jest zielonobrunatne z nieregularnymi ciemnymi plamami"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "c167a78d-0dbb-3ff2-ac72-1532f8c0c63b",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
                            "osobnik z gatunku umbra (1.3)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ded1e1-6491-41e9-bf2e-91d0b5ba861e",
                                "sense_id": "c167a78d-0dbb-3ff2-ac72-1532f8c0c63b",
                                "text": "Miecio trzyma w akwarium pięć umbr i piskorzyka."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "06caa132-7323-3a1f-ae5d-ebfc03f915e0",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
                            "wewnętrzny cień Ziemi obserwowany na powierzchni Księżyca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10392caa-8f65-4d22-8457-45bf36136405",
                                "sense_id": "06caa132-7323-3a1f-ae5d-ebfc03f915e0",
                                "text": "Umbra posiada kształt stożka"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "4dd67306-f729-3a58-bf34-51ffadfd273e",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
                            "najciemniejsza część plamy słonecznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d348a96-3a2c-48f2-9843-9297a372e71a",
                                "sense_id": "4dd67306-f729-3a58-bf34-51ffadfd273e",
                                "text": "W obszarze plamy słonecznej astronom wskazał umbrę."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "aca3711f-7945-3550-b4ce-504d0148174e",
                        "entry_id": "3c2cd020-0c84-32ac-beb7-399d3237f170",
                        "glosses": [
