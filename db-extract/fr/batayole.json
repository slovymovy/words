                                        "examples": [
                                            {
                                                "example_id": "d4dcb17a-24d8-4ebb-970f-001e94c303d2",
                                                "sense_id": "72441b15-8688-383a-be55-c75db4747c0a",
                                                "text": "The train began to move. Lace walked with it, holding a stanchion."
                                            },
                                            {
                                                "example_id": "e3ec6f95-48d6-47e4-9821-eb5cb8e51768",
                                                "sense_id": "72441b15-8688-383a-be55-c75db4747c0a",
                                                "text": "You cross under the rusting stanchions of the old elevated highway and walk out to the pier."
                                            },
                                            {
                                                "example_id": "de251063-d400-439b-b674-c40dd483b292",
                                                "sense_id": "72441b15-8688-383a-be55-c75db4747c0a",
                                                "text": "Hiro climbs on his bike, eases it through the neighbourhood and onto the Street, and then gosses it up to a few hundred miles an hour, slaloming between the stanchions of the monorail, praticing."
                                            },
                                            {
                                                "example_id": "cfaf818f-ea81-4a21-b981-44e6a9c9da8a",
                                                "sense_id": "72441b15-8688-383a-be55-c75db4747c0a",
                                                "text": "He staggers against a stanchion, trips over a rope, and tumbles into the space between the quay and the steel plates of the freighter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb7fb36-3629-34d9-b1a5-360fa7368483",
                                        "entry_id": "207299ee-7e50-3987-b791-7ce883806473",
                                        "glosses": [
                                            "A framework of such posts, used to secure or confine cattle."
                                        ],
