                "senses": [
                    {
                        "sense_id": "1a19fd26-c7dd-333a-b55b-bac52d4463f0",
                        "entry_id": "9c894c56-d726-3b44-9f4e-dae3553fd5b7",
                        "glosses": [
                            "ставить в строй, в ряд"
                        ],
                        "tags": [
                            "кого-что"
                        ],
                        "examples": [
                            {
                                "example_id": "45de582e-8a1b-463b-b49a-5144feb61732",
                                "sense_id": "1a19fd26-c7dd-333a-b55b-bac52d4463f0",
                                "text": "Выстраивать полк."
                            },
                            {
                                "example_id": "4e87164d-6812-4271-8952-16a3c1e28e9a",
                                "sense_id": "1a19fd26-c7dd-333a-b55b-bac52d4463f0",
                                "text": "Выстраивать солдат в одну шеренгу."
                            }
                        ]
                    },
                    {
                        "sense_id": "615a6c64-71d7-37c1-89e8-fa304555656a",
                        "entry_id": "9c894c56-d726-3b44-9f4e-dae3553fd5b7",
                        "glosses": [
                            "ставить в ряд, расставлять"
                        ],
                        "tags": [
                            "что"
                        ],
                        "examples": [
                            {
                                "example_id": "f442668e-eaa4-46ac-8476-c2ca23d305ce",
                                "sense_id": "615a6c64-71d7-37c1-89e8-fa304555656a",
                                "text": "Выстраивать шахматные фигуры."
                            },
                            {
                                "example_id": "ba17b198-df88-4155-909c-71283ba30f40",
                                "sense_id": "615a6c64-71d7-37c1-89e8-fa304555656a",
                                "text": "Конечно, выстраивать литературу по ранжиру и издавать согласно строю: сперва командиров, потом их помощников, потом всех остальных — гораздо удобней, но это уже поток, а поточные линии уместней в промышленности, но не в литературе, если ее воспринимать всерьез."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cfd006c-88e3-3edf-ab62-c312bf788d98",
                        "entry_id": "9c894c56-d726-3b44-9f4e-dae3553fd5b7",
                        "glosses": [
                            "строить, сооружать, возводить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87667ed3-d28f-4fd9-acc4-5bc3723dede7",
                                "sense_id": "1cfd006c-88e3-3edf-ab62-c312bf788d98",
                                "text": "Выстраивать дом."
                            },
                            {
                                "example_id": "a82be71c-4e09-4de6-a7c7-afde47da5771",
                                "sense_id": "1cfd006c-88e3-3edf-ab62-c312bf788d98",
                                "text": "Если мы в таком партнерском духе будем выстраивать отношения, это пойдет на пользу всем."
                            }
                        ]
                    },
                    {
                        "sense_id": "2af28236-6923-315a-b791-8b47e50b3b26",
