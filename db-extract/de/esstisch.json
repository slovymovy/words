                        ],
                        "form": "die Esstische"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                        "entry_id": "728ddc9a-1066-3d87-bd76-750c3cb222df",
                        "glosses": [
                            "ein Tisch, an dem normalerweise gegessen wird"
                        ],
                        "tags": [
                            "Mobiliar"
                        ],
                        "examples": [
                            {
                                "example_id": "71a34361-74b4-4d38-ba42-fb42f4197abc",
                                "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                                "text": "Wir haben uns einen neuen Esstisch gekauft."
                            },
                            {
                                "example_id": "8d51804f-b390-4166-860e-0b8791f89fad",
                                "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                                "text": "„Sie stellte das Tablett auf den Esstisch und ging in die Küche zurück, um eine Schale Wasser zu holen.“"
                            },
                            {
                                "example_id": "720f0c14-170b-4967-a7d1-934b0e029e6e",
                                "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                                "text": "„Auf dem mächtigen Esstisch liegen parallel angeordnete Stifte, eine Bienenwachskerze brennt.“"
                            },
                            {
                                "example_id": "a771c0b6-2ad7-4af0-b192-aeb788247749",
                                "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                                "text": "„Fereschte stellt eine Schüssel mit Salat auf den Esstisch und streicht mit einer Hand kurz über das schwarz lackierte Holz.“"
                            },
                            {
                                "example_id": "3c94ddf8-f684-4597-948b-f2cdab595690",
                                "sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                                "text": "„Dann fällt sein Blick auf einen meiner Texte, der ausgedruckt auf dem Esstisch liegt, auf demselben Esstisch, auf den mich gestern Valmont gefesselt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9327ab0-504b-4c5c-96df-2135adce48fa",
                        "source_entry_id": "728ddc9a-1066-3d87-bd76-750c3cb222df",
                        "source_sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                        "source_sense_description": "Mobiliar: ein Tisch, an dem normalerweise gegessen wird",
                        "target_lang_word": "dining-table",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dining-table",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                        "entry_id": "ceb4ead3-9c05-3bf6-bf26-d7e4d4abc4e7",
                                        "glosses": [
                                            "Dated form of dining table."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5b7718-89a7-4410-9312-d91061f97960",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "And he kept shaking Mr. Gibson’s hand all the time till he had placed him, nothing loth, at the well-covered dining-table."
                                            },
                                            {
                                                "example_id": "195ab304-1e7f-44cb-9c61-36c6d41e076c",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "1868, \"A Clergyman\" (John Morison), Australia in 1866, page 165,\nWhen gold-digging commenced in California, the writer was staying at an hotel in Wellington, New Zealand, where a Yankee trader was also staying. Seated at the dining-table, the latter was discoursing of the business he was doing […] ."
                                            },
                                            {
                                                "example_id": "42e4d430-b5e7-4a01-9f4e-a49d437c2893",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "Between the windows looking upon the lake hangs the great looking-glass, over the Pembroke dining-table."
                                            },
                                            {
                                                "example_id": "ba167bbf-94c6-4f70-ae99-48df627d69d9",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "Did I wish the roses renewed in a bowl upon the dining-table, sure enough at the next meal they would be replaced by fresh ones."
                                            },
                                            {
                                                "example_id": "c95ddb28-de15-44bc-8442-d33016b24110",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "So Patty rested, until Pansy came and called them to a most appetising little lunch spread very simply on the dining-table."
                                            },
                                            {
                                                "example_id": "944160d2-6eee-45e8-8bc3-0ce3793ec3fc",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "Local custom gives us an “Advent Tree” or “Advent Wreath”: the trees are diminutive Christmas trees, which bear one candle for each Sunday in Advent; the wreaths are wooden rings with as many holes as there are days before Christmas Eve, decorated with fir green, and gay ribbons, and hung up over the dining-table, one candle being added every night till the circle is complete."
                                            },
                                            {
                                                "example_id": "78b2ec38-6516-48ae-8dff-1954738fba34",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "He saw marriage as a settling down to the serious business of life; a settling down that was symbolized in the large stuccoed house in St John's Wood Park, with its long mahogany dining-table, its family portraits, its oak-panelled smoking-room, its leather-bound books running in long, dusty rows from floor to ceiling; its drawing-room whose heavily brocaded windows looked out on a trim garden, its thick carpets, its kitchened basement, its high, wide bedrooms, its airy nursery."
                                            },
                                            {
                                                "example_id": "31d6547b-fef1-43cc-9135-b8b34dbd78e0",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "The dining-table, uncollapsible and highly varnished, the piano, the chesterfield, stuffed chairs and a few sofas made a foundation on which to heap lesser articles."
                                            },
                                            {
                                                "example_id": "d90fe27d-d00b-4b12-afe2-a3b8ba53f681",
                                                "sense_id": "3891e3ab-985b-3791-8a1e-21202f14ddff",
                                                "text": "Perhaps, she thought now, polishing Theresa’s dining-table, we could go to some of those people who help you, be counselled; […] “And Hermione’s plate, soiled but with no food on it, as if she had eaten, was on the dining-table,” said Karen, who had seen it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "858dfabb-7e85-4435-939d-a194a24b6ecd",
                        "source_entry_id": "728ddc9a-1066-3d87-bd76-750c3cb222df",
                        "source_sense_id": "954d3fa1-5963-37fe-bd04-3096c6724404",
                        "source_sense_description": "Mobiliar: ein Tisch, an dem normalerweise gegessen wird",
                        "target_lang_word": "table de salle à manger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
