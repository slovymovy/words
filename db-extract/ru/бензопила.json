                                        "entry_id": "c53928eb-c8a8-3f36-9368-032f0fc95c97",
                                        "glosses": [
                                            "A power saw that has a power-driven and fast-revolving chain of metal teeth, usually used to cut trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a664973-6d8f-4f1e-906e-e5cb9089839f",
                                                "sense_id": "77bddc69-d9ce-3961-80cd-1eb65006ccc4",
                                                "text": "He used a chainsaw to cut through the fallen tree on the roadway."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chainsaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5724f06-8cd0-3097-88cc-0498f641ddee",
                                        "entry_id": "911823ff-12d3-3c43-9f6d-4099e48002ff",
                                        "glosses": [
                                            "To cut with a chainsaw."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7caf4b43-61b9-43ea-973a-872e0207aeea",
                                                "sense_id": "a5724f06-8cd0-3097-88cc-0498f641ddee",
                                                "text": "She and Barber once stopped a developer from chainsawing mature trees on Mississauga Rd. by standing in front of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1205ed47-7b52-3f3c-b4c7-025c787a5540",
