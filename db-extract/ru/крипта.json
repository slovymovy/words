                                "target_senses": [
                                    {
                                        "sense_id": "4ff3bb6b-0982-3b0d-95b4-ea79df2242f3",
                                        "entry_id": "cada5ad3-b98c-377e-a372-deab8b818be1",
                                        "glosses": [
                                            "A cave or cavern."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08bae9c8-af7d-30ba-872f-7362d1f6d108",
                                        "entry_id": "cada5ad3-b98c-377e-a372-deab8b818be1",
                                        "glosses": [
                                            "An underground vault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ba4c167-e629-33de-8c25-dd508d44043c",
                                        "entry_id": "cada5ad3-b98c-377e-a372-deab8b818be1",
                                        "glosses": [
                                            "An underground vault.",
                                            "Especially: one beneath a church that is used as a burial chamber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "134f042f-3328-49cf-a309-3dce59657383",
                                                "sense_id": "4ba4c167-e629-33de-8c25-dd508d44043c",
                                                "text": "Near-synonyms: vault, tomb, sepulchre, sepulcher"
                                            },
                                            {
                                                "example_id": "7a2370a1-0dd7-4dc3-b178-21e49eb2129d",
                                                "sense_id": "4ba4c167-e629-33de-8c25-dd508d44043c",
                                                "text": "She turned and waved a hand to him, she cried a word, but he didn't hear it, it was a lost word. A sable wraith she was in the parkland, fading away into the dolorous crypt of winter."
                                            },
                                            {
                                                "example_id": "bb0829eb-a017-4d8c-813e-30b751ec2702",
                                                "sense_id": "4ba4c167-e629-33de-8c25-dd508d44043c",
                                                "text": "On its arrival at Bank, incidentally, the City & South London's directors had threatened to demolish the church of St Mary Woolnoth, but after a public outcry the company built its station in the crypt of the church, the bodies being transferred [...]. Therefore St Mary Woolnoth doesn't have a crypt. Or you could say that its crypt is Bank station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d867e4bc-3552-360a-8efe-25f8bcb2ecc9",
                                        "entry_id": "cada5ad3-b98c-377e-a372-deab8b818be1",
                                        "glosses": [
                                            "A small pit or cavity in the surface of an organ or other structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a174ea20-99b3-4dfc-98c8-e1aeb09dcfb9",
                                                "sense_id": "d867e4bc-3552-360a-8efe-25f8bcb2ecc9",
                                                "text": "Near-synonyms: fovea, fossa"
                                            },
                                            {
                                                "example_id": "09676859-d2cf-499b-961f-e183afdacfec",
                                                "sense_id": "d867e4bc-3552-360a-8efe-25f8bcb2ecc9",
                                                "text": "Sometimes, too much foreign material can get caught in the crypts, leading to frequent infections."
                                            }
                                        ]
