                    {
                        "translation_id": "d376f792-2c3f-46c7-a41c-7c7fbf5edd74",
                        "source_entry_id": "2a43d559-7f64-3f3c-8d74-57b6dc483756",
                        "source_sense_id": "71f21834-e55a-3b53-af35-c9f9b5616523",
