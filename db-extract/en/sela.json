                        "examples": [
                            {
                                "example_id": "5c52c05c-9ec3-48a2-bc03-9f99325524a5",
                                "sense_id": "cea8157e-1c89-35ac-80fd-521d0de3ff11",
                                "text": "Selah, the capital of Idumea, built on an elevated plain, was situated in a deep valley, the entrance to which is by a lengthened defile, in some places not more than eight feet wide, which, in some parts, rising from 400 to 700 feet, nearly meet over head, about ninety miles to the south-east of Jerusalem. Mount Hor, celebrated in Scripture, overlooks the ruins of this ancient capital. It was called by the name of Petra from its rocky position; and by one of the prophets it is denominated \"the Rock\": it is also said, that Amaziah slew of Edom in the valley of Salt ten thousand, and took Selah by war, and called of it the name of Joktheel unto this day. (Jer. xlix. 16, 2 Kings xiv. 7)"
                            }
                        ]
