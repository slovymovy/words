                        "glosses": [
                            "морск. петля на тросе, образованная путём переплетения его прядей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6884ea1-1939-4ca2-a892-536c07420298",
                                "sense_id": "e0a76f1e-5bd2-3534-b039-7cc405e1dfef",
                                "text": "Каждый трос заканчивается огонами с коушами, заплетёнными вручную."
                            }
                        ]
                    },
                    {
                        "sense_id": "85ecb04c-df68-324c-85ed-5cd5be1d4ac6",
                        "entry_id": "a658e9ff-fda6-3feb-9e64-2ab4131b8c37",
                        "glosses": [
                            "морск. кольцо из троса, сделанное на его середине или конце"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4a6d54-bd3e-4463-b42e-2eacdb032ec7",
                                "sense_id": "85ecb04c-df68-324c-85ed-5cd5be1d4ac6",
                                "text": "К счастью, на фрегате оба каната закреплены были огоном за шпор грот-мачты."
                            }
                        ]
                    }
