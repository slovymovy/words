                            {
                                "example_id": "1c0c1c28-f0ff-401a-b5ff-784702800616",
                                "sense_id": "d63cf926-7fe9-3629-adf6-301f5da88c36",
                                "text": "Saisir intuitivement une proposition. Newton paraît avoir saisi intuitivement plusieurs théorèmes dont la démonstration n'a été donnée qu’après lui."
                            },
                            {
                                "example_id": "5d54a229-c573-4ff2-bb22-8490e92dc7bb",
                                "sense_id": "d63cf926-7fe9-3629-adf6-301f5da88c36",
                                "text": "Parce que tout homme est intuitivement convaincu de la vérité de cette proposition : 2 est plus que 1."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7dbb53b-3c01-3e53-8c7f-69c489538351",
