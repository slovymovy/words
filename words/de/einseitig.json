                },
                {
                    "sense_id": "f562c74a-8471-3aef-ae24-d4657851ea14",
                    "sense_definition": "Nur einen bestimmten Standpunkt berücksichtigend; voreingenommen und nicht objektiv.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Zeitung wurde wegen ihrer sehr <w>einseitigen</w> Berichterstattung über den Streik scharf kritisiert."
                        },
                        {
                            "text": "Man sollte dieses komplexe politische Thema keinesfalls aus einer so <w>einseitigen</w> Perspektive beurteilen."
