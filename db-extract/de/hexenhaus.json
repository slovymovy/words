                "senses": [
                    {
                        "sense_id": "9f4ceb56-d7f0-3bad-b92b-0a882699583c",
                        "entry_id": "7bbbfdc7-2aa6-35bb-aa1e-7fe758f0c056",
                        "glosses": [
                            "verfluchtes, von Hexen bewohntes Haus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f59b0d-9504-4782-a730-61c19c78519b",
                                "sense_id": "9f4ceb56-d7f0-3bad-b92b-0a882699583c",
                                "text": "„Er wusste, dass sein Zimmer sich in einem alten Hexenhaus befand - aus ebendiesem Grund hatte er es gemietet.“"
                            },
                            {
                                "example_id": "15866797-a8b6-4db4-9aa0-6f321a0c29ae",
                                "sense_id": "9f4ceb56-d7f0-3bad-b92b-0a882699583c",
                                "text": "„Vom Gehsteig aus schaute sie zurück; das von Efeu halb überwucherte Gebäude aus grauem Stein erinnerte an ein Hexenhaus, das wie ein Fremdkörper zwischen gewöhnliche Wohnhäuser eingezwängt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
