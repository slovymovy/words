                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4255d718-1fa4-4240-a9d1-916ea88233e4",
                                                "sense_id": "6c9b5094-754c-35ae-93e4-749712ae6df3",
                                                "text": "I have a funny feeling in my gut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad80af9-c9c9-30a9-b1cb-ce97fc1f0761",
                                        "entry_id": "2407876c-9b63-384c-a97a-343fda0c92dd",
                                        "glosses": [
                                            "A class that is not demanding or challenging."
                                        ],
                                        "tags": [
