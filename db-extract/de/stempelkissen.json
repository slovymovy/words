                                "target_senses": [
                                    {
                                        "sense_id": "2d9bb5e6-22a1-3641-b7c2-177171c6ef1e",
                                        "entry_id": "c54ca162-e393-323a-841b-cae4852a1d75",
                                        "glosses": [
                                            "Sorte de boîte plate en métal ou en plastique renfermant un coussin imprégné d’encre, sur lequel on appuie un timbre gravé pour l’encrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b3bc00-fa47-4baa-bde2-159ce344a34b",
                                                "sense_id": "2d9bb5e6-22a1-3641-b7c2-177171c6ef1e",
                                                "text": "Elle désignait son index qui portait encore la trace du tampon encreur.\n— Ils ont pris mes empreintes… Geneviève était blanche."
                                            },
                                            {
                                                "example_id": "a9a9ed6e-a975-4769-a07b-f4581bc487a2",
                                                "sense_id": "2d9bb5e6-22a1-3641-b7c2-177171c6ef1e",
                                                "text": "Le capitaine bafouilla tout en jouant avec le tampon encreur entre ses doigts.\n— Vous êtes la…\n Il cherchait le mot juste. Clotilde devina ceux qu’il ne voulait pas prononcer."
                                            },
                                            {
                                                "example_id": "b79c58f6-a85e-41e9-9dd1-718a34e00f35",
                                                "sense_id": "2d9bb5e6-22a1-3641-b7c2-177171c6ef1e",
                                                "text": "L'agrandissement de la photo d'un orteil montre l'empreinte appliquée d'un doigt à l'aide d'un tampon encreur. La signature. La même que sur le mur du loft de Courbevoie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
