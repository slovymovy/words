                        "entry_id": "636fa1c4-3380-3d23-8d19-aff1c9e5f2e3",
                        "glosses": [
                            "verdeeld in kleine stukjes die te overzien zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc684363-be1b-4abd-8227-d2fc525b33aa",
                                "sense_id": "13181023-b086-396a-acc1-a8b1c93050ba",
                                "text": "De stof werd in kleine behapbare stukjes door de leraar geëxamineerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7975a7d-dfa6-3bdf-8260-a65e8929b5c8",
                        "entry_id": "636fa1c4-3380-3d23-8d19-aff1c9e5f2e3",
                        "glosses": [
                            "begrijpelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011135a4-9b56-4287-a6ab-d34845a89b62",
                                "sense_id": "b7975a7d-dfa6-3bdf-8260-a65e8929b5c8",
                                "text": "Steen des aanstoots: de aanvechtbare keuzes die de samenstellers telkens maken. Teksten uit kranten en tijdschriften worden ingekort, omgewerkt, vereenvoudigd en soms met extra zinnen aangevuld – een redactionele doodzonde – om ze bevraagbaar en behapbaar te maken."
                            }
                        ]
                    }
