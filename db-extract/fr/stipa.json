                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b60ef2-34a9-4b36-bd7a-c03818d7608b",
                                "sense_id": "d0999967-b7e2-3c5e-951d-c94e1847ec1b",
                                "text": "Ici, les sentolines se mêlent aux stipas, aux phormiums et aux seigles de mer."
                            },
                            {
                                "example_id": "e4bcda02-ce01-4fe8-b2f9-31c028fca306",
                                "sense_id": "d0999967-b7e2-3c5e-951d-c94e1847ec1b",
                                "text": "Les stipas sont des herbes vivaces qui forment une touffe qui peut être persistante ou caduque."
                            },
                            {
                                "example_id": "28aee7b6-f429-432e-a566-9a9308deedcd",
                                "sense_id": "d0999967-b7e2-3c5e-951d-c94e1847ec1b",
                                "text": "Les stipas sont les graminées les plus décoratives avec sont ses panicules légères qui se plient au rythme du vent."
                            }
                        ]
                    }
                ],
