                    },
                    {
                        "form_id": "132d13da-be03-4e54-a141-157da734e41c",
                        "entry_id": "7405f30a-27dd-34f4-b079-2e55f2a6bb5b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind satanologisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7e7983b-845c-381f-a7cd-66626285b2e3",
                        "entry_id": "7405f30a-27dd-34f4-b079-2e55f2a6bb5b",
                        "glosses": [
                            "den Teufel (Satan) betreffend, ihm zugehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170ca7b8-421c-4c27-ac88-0e2506d9bf50",
                                "sense_id": "f7e7983b-845c-381f-a7cd-66626285b2e3",
                                "text": "„Die überkommene satanologische und dämonologische Erklärung gewisser Phänomene läßt sich heute nicht mehr halten, eine grundsätzliche Neuinterpretation tut not.“"
                            },
                            {
                                "example_id": "837776c2-0ddf-412e-ba5d-77e709db6335",
                                "sense_id": "f7e7983b-845c-381f-a7cd-66626285b2e3",
                                "text": "„Mit der vermehrten Aufnahme der Paradieserzählung erfolgt im ersten Jahrhundert auch eine zunehmende satanologische Deutung der Ereignisse, wobei das bereits bekannte, wenn auch keineswegs einheitliche, Paradigma einer Teufelsgestalt auf Gen 3 appliziert wird.“"
                            },
                            {
                                "example_id": "536969e5-c545-4157-8b76-8f9d457d62ed",
                                "sense_id": "f7e7983b-845c-381f-a7cd-66626285b2e3",
                                "text": "„Auch Irenäus deutet die Schlange satanologisch und führt den Neid des ,Teufels“ als Begründung für die Versuchung der Menschen an (Dem. 16).“"
                            },
                            {
                                "example_id": "d200a105-3e9d-4036-8934-d5254f46250c",
                                "sense_id": "f7e7983b-845c-381f-a7cd-66626285b2e3",
