                "senses": [
                    {
                        "sense_id": "b5fa7217-07b6-385b-8554-0c0c58c5e204",
                        "entry_id": "f9902974-9374-3ab7-a6b8-b4fa43c05bd3",
                        "glosses": [
                            "mathematische Theorie von Systemen, die chaotisches Verhalten zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc90b326-58e9-4020-af03-6cc473a30992",
                                "sense_id": "b5fa7217-07b6-385b-8554-0c0c58c5e204",
                                "text": "„Der Schmetterlingseffekt ist ein Prinzip der Chaostheorie.“"
                            },
                            {
                                "example_id": "a0810c2e-04fc-4209-bbc4-085e5e969484",
                                "sense_id": "b5fa7217-07b6-385b-8554-0c0c58c5e204",
                                "text": "„Wir üben, testen und experimentieren, um die Chaostheorie zu illustrieren.“"
                            },
                            {
                                "example_id": "0fb45aee-4235-4b02-b16e-e053db0bc9da",
                                "sense_id": "b5fa7217-07b6-385b-8554-0c0c58c5e204",
                                "text": "„Das liegt nicht etwa daran, dass die Wissenschaftler nicht schlau genug sind, die Modelle zu ungenau oder die Computer zu langsam, sondern an der Chaostheorie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
