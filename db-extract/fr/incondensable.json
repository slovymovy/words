                    {
                        "sense_id": "7d406778-358f-3315-bee1-a310d6e7412d",
                        "entry_id": "00f9be33-a439-39b7-bc4f-590d770b3f1e",
                        "glosses": [
                            "Qualifie un gaz que l’on ne peut pas condenser en liquide par des moyens conventionnels."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "cdbe3240-147a-470b-aca2-015008ba8a4a",
                                "sense_id": "7d406778-358f-3315-bee1-a310d6e7412d",
                                "text": "Le fluide élastique que l’on obtient par ces moyens, & sur-tout par le dernier, est, de même que tous les autres gaz, sans couleur, diaphane, invisible, incondensable en liqueur par le froid, & conserve cet état aérien tant qu’il reste pur …."
                            },
                            {
                                "example_id": "d87e5f9e-5284-40de-b72a-0398106966b9",
                                "sense_id": "7d406778-358f-3315-bee1-a310d6e7412d",
                                "text": "L’air est, comme tous les autres fluides permanens de cette espèce, pesant, compressible, élastique, transparent, sans couleur, invisible, et incondensable en liqueur par le froid."
                            },
                            {
                                "example_id": "4600d561-d27e-4b08-aaf7-555ff583af24",
                                "sense_id": "7d406778-358f-3315-bee1-a310d6e7412d",
                                "text": "La présence de gaz incondensables dans un réseau vapeur diminue la pression de vapeur et diminue donc la température."
                            }
                        ]
                    }
                ],
