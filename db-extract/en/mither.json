                "senses": [
                    {
                        "sense_id": "19f86cda-fec5-3b9c-bced-5eaa12b9133b",
                        "entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "glosses": [
                            "To make an unnecessary fuss, moan, bother."
                        ],
                        "tags": [
                            "Northern-England",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "df2a9758-fdc7-4194-b346-e6f93014087e",
                                "sense_id": "19f86cda-fec5-3b9c-bced-5eaa12b9133b",
                                "text": "The European Commission is pondering how to compel phone companies to come up with a universal plug for their chargers. Apple, which uses its own design for its charger cables, is mithering about the change."
                            }
                        ]
                    },
                    {
                        "sense_id": "25dc0d96-26f4-3d08-a315-36f7a21a720d",
                        "entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "glosses": [
                            "To pester or irritate someone."
                        ],
                        "tags": [
                            "Northern-England",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b27dccdb-f37a-49fa-84d5-374e91b4d35c",
                                "sense_id": "25dc0d96-26f4-3d08-a315-36f7a21a720d",
                                "text": "\"Every night after work I'd mither [pester] my dad to take me out into the field and practise. There were definitely times when he didn't want to do it, but he never said no."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08bd5c61-e820-4e4a-a46f-2122fcfe93b1",
                        "source_entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "source_sense_description": "intransitive: to mither",
                        "target_lang_word": "раздража́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раздража́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "77a1a748-77e5-36d6-81ad-3c18eb34c172",
                                        "entry_id": "4fd345f9-3259-3663-8086-a4e5baf38135",
                                        "glosses": [
                                            "физиол. воздействовать чем-либо на организм или на отдельный орган, вызывая какую-либо реакцию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b1897c-af09-4542-8b3f-1d46553bd45d",
                                                "sense_id": "77a1a748-77e5-36d6-81ad-3c18eb34c172",
                                                "text": "Движения лягушки от прикосновения к её коже значительно усиливаются, если раздражать ей электрическим током средние части головного мозга."
                                            },
                                            {
                                                "example_id": "2d29cc1f-a249-4ae9-b26f-1db117c19d43",
                                                "sense_id": "77a1a748-77e5-36d6-81ad-3c18eb34c172",
                                                "text": "Самый опыт в общих чертах состоял обыкновенно в следующем: вскрывают при или без этеризации позвоночный канал сзади, обнажают спинной мозг и, дав совершенно пройти наркозу или отдохнуть животному, начинают раздражать различные части ― передние, задние, боковые столбы в различных их точках и направлениях, ― делают разрезы, снимают на небольшом пространстве задние или другие столбы и раздражают открытую серую массу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff4c3f3-9f10-38a0-b6a5-aca2e6bef3d2",
                                        "entry_id": "4fd345f9-3259-3663-8086-a4e5baf38135",
                                        "glosses": [
                                            "физиол. вызывать боль, зуд и т. п. в чём-либо, воспаление чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ab91c2c-b43f-30c0-a41a-499a96d0012a",
                                        "entry_id": "4fd345f9-3259-3663-8086-a4e5baf38135",
                                        "glosses": [
                                            "возбуждать, волновать"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b60f1fa7-1f77-3bfb-8c04-4c66cf2314ff",
                                        "entry_id": "4fd345f9-3259-3663-8086-a4e5baf38135",
                                        "glosses": [
                                            "перен. усиливать, обострять"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff6a56e1-8e93-34c2-8a37-487c575f4ba2",
                                        "entry_id": "4fd345f9-3259-3663-8086-a4e5baf38135",
                                        "glosses": [
                                            "приводить в состояние недовольства, досады, злости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790be418-cdb6-4484-a488-82c718f80861",
                                                "sense_id": "ff6a56e1-8e93-34c2-8a37-487c575f4ba2",
                                                "text": "Но это приятное ощущение длилось недолго. Свет стал утомлять, раздражать. Хотелось крикнуть: «Погасите свет!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca7163a-8e39-4950-acd2-bafdd7c6e005",
                        "source_entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "source_sense_description": "transitive to mither",
                        "target_lang_word": "lastigvallen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lastigvallen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c083d064-0466-329e-a204-a9ecc862395d",
                                        "entry_id": "b4155d6c-20b9-3d11-b41c-16e51117b81f",
                                        "glosses": [
                                            "op hinderlijke wijze iemands aandacht opeisen, hinderen, irriteren in iemands concentratie of bezigheden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4890f08d-30fd-4c0c-832a-a5df74fb8ac7",
                                                "sense_id": "c083d064-0466-329e-a204-a9ecc862395d",
                                                "text": "Hij werd vaak lastiggevallen."
                                            },
                                            {
                                                "example_id": "77536ed7-94db-4f0a-bad7-4ac5e8d0878a",
                                                "sense_id": "c083d064-0466-329e-a204-a9ecc862395d",
                                                "text": "Hij had gelijk, mijn experiment om in stilte te lopen moest ik meer in afzondering uitproberen en niet de groep er te veel mee lastigvallen, dus ik trok me in de dagen daarna steeds meer terug."
                                            },
                                            {
                                                "example_id": "5f070bb8-14df-469e-bdf5-8001274fe70c",
                                                "sense_id": "c083d064-0466-329e-a204-a9ecc862395d",
                                                "text": "Laat voor 't hofgerecht betuigen\ndat gij hiertoe geperst wordt. Scheur uw kleed\ntot een bewijs van rouw en harteleed.\n Hofpriester:\n Hoe durft de vorst Gods volk zo lastigvallen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1036c2b5-f966-3eed-aaa9-080b50cbc59e",
                                        "entry_id": "b4155d6c-20b9-3d11-b41c-16e51117b81f",
                                        "glosses": [
                                            "op vervelende wijze iemands aandacht trekken door na te roepen, obscene of dreigende gebaren te maken (e.d.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09bf7277-705e-4d30-b2c4-8df3331564b4",
                                                "sense_id": "1036c2b5-f966-3eed-aaa9-080b50cbc59e",
                                                "text": "Vormen deze mannen een groep? Is hier dan sprake van overlast door een probleemgroep? Zijn de mannen ruzie aan het maken, meisjes aan het lastigvallen en handelen ze in drugs? Of zijn het gewoon mensen die in de buurt wonen en elkaar gezellig op straat ontmoeten, terwijl ze aan de auto sleutelen, omdat ze nu eenmaal geen geld hebben om hem naar de garage te brengen?"
                                            },
                                            {
                                                "example_id": "6628c347-05c6-4184-945a-7a94d03a4153",
                                                "sense_id": "1036c2b5-f966-3eed-aaa9-080b50cbc59e",
                                                "text": "Eindelijk liet zij de valsche gekscheersters vrij! Niemand echter dierf sedert dien haar te lastigvallen in zake van haren stiel, doenwijze of wel oorsprong!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65434030-fafe-41ee-9d47-8b5802bc8296",
                        "source_entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "source_sense_description": "transitive to mither",
                        "target_lang_word": "докуча́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "докуча́ть",
