                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f862099c-b793-4378-b33f-f16f8e2e0950",
                        "source_entry_id": "56767159-c78c-3c2b-a2fd-945f0f85e89e",
                        "source_sense_id": "ad8fe136-2563-3941-92ba-1e5ee84baba6",
                        "target_lang_word": "Monster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f7a7cc2-ec96-33ea-ba38-ccd649caf799",
                                        "entry_id": "6182ed42-7905-3d05-8662-537a1329118a",
                                        "glosses": [
                                            "Fabelwesen, das sich durch Größe, Stärke, aber auch Hässlichkeit auszeichnet;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1688c196-c9ff-4ce0-a0aa-4b42aaae2afd",
                                                "sense_id": "3f7a7cc2-ec96-33ea-ba38-ccd649caf799",
                                                "text": "Ein Monster attackierte die Stadt."
                                            },
                                            {
                                                "example_id": "5a456073-67b1-4047-8c31-15c81de4802e",
                                                "sense_id": "3f7a7cc2-ec96-33ea-ba38-ccd649caf799",
                                                "text": "„So hielt ich mir ganz selbstverständlich meine eigenen Monster unter dem Bett, die mich regelmäßig daran hinderten, dasselbige zu verlassen.“"
                                            },
                                            {
                                                "example_id": "b5150b33-e2f8-413b-9d35-d04e72424846",
                                                "sense_id": "3f7a7cc2-ec96-33ea-ba38-ccd649caf799",
                                                "text": "„Aber die alten Reisenden, die auf Segelschiffen die Welt durchquerten, waren mindestens genauso dramatisch, glaubten an Monster und rachsüchtige Göttinnen und die Unendlichkeit einer Welt, die sie nicht verstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4f4a24f-024c-326b-a195-3b1432bb9f2f",
                                        "entry_id": "6182ed42-7905-3d05-8662-537a1329118a",
                                        "glosses": [
                                            "Ungeheuer"
                                        ],
                                        "tags": [
                                            "Beleidigung eines Tieres oder eines Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f3da58-2236-4240-9f94-fec17662a081",
                                                "sense_id": "e4f4a24f-024c-326b-a195-3b1432bb9f2f",
                                                "text": "Was hast du angestellt, du kleines Monster?!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad3b3dd-043a-49b8-a184-0d3775894219",
                        "source_entry_id": "56767159-c78c-3c2b-a2fd-945f0f85e89e",
                        "source_sense_id": "ad8fe136-2563-3941-92ba-1e5ee84baba6",
                        "target_lang_word": "Monstrum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monstrum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a470d34-bd0e-3e0c-9351-236e0efef03d",
                                        "entry_id": "9e6cb1b2-60dd-3ffb-8d70-d4dcf8d45fb1",
                                        "glosses": [
                                            "ein schreckliches Wesen, ein gruseliges Monster oder großes Ungeheuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf70bf9-4548-43d6-8f30-abb124faf796",
                                                "sense_id": "5a470d34-bd0e-3e0c-9351-236e0efef03d",
                                                "text": "Das Monstrum lauerte in der Ecke hinter dem Ofen, bereit, jeden Eindringling in die Flucht zu schlagen."
                                            },
                                            {
                                                "example_id": "a6238863-b74b-40ad-bafc-f189ff1cf598",
                                                "sense_id": "5a470d34-bd0e-3e0c-9351-236e0efef03d",
                                                "text": "„Dieses Monstrum trug gleichzeitig einen Stahlhelm, einen Homburg und einen Doktorhut.“"
                                            },
                                            {
                                                "example_id": "6b38842b-2cb2-4f2d-ba55-77e627ebff0d",
                                                "sense_id": "5a470d34-bd0e-3e0c-9351-236e0efef03d",
                                                "text": "„Wird ein Autor über 150 Jahre lang wegen seiner Werke als Monstrum verfolgt, dann erwartet man, was die Schilderung seines Lebens betrifft, so etwas wie die Biographie eines Monstrums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b8c29ef-805a-36b6-9914-75b12220c86d",
                                        "entry_id": "9e6cb1b2-60dd-3ffb-8d70-d4dcf8d45fb1",
                                        "glosses": [
                                            "etwas Unförmiges, etwas Großes, etwas Überdimensioniertes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e7b9ef-f754-4674-9de8-66f02f3fb2dd",
                                                "sense_id": "8b8c29ef-805a-36b6-9914-75b12220c86d",
                                                "text": "Was ist denn das für ein Monstrum? Ich hatte gesagt, ich suche einen Rasenmäher für 500 qm Rasenfläche!"
                                            },
                                            {
                                                "example_id": "a9beae61-cc00-4976-8c18-b191965f619b",
                                                "sense_id": "8b8c29ef-805a-36b6-9914-75b12220c86d",
                                                "text": "Schau mal diesen hier an: das ist ein Monstrum von einem Schaufelbagger!"
                                            },
                                            {
                                                "example_id": "79e88d72-dfa8-4515-a4f2-716a15d92693",
                                                "sense_id": "8b8c29ef-805a-36b6-9914-75b12220c86d",
                                                "text": "„Sie sah ein vages Bild vor sich, von einem großen gelben Monstrum, das man ihr auf den Rücken geschnallt hatte und das fast ein Viertel ihres damaligen Körpergewichts wog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7a4036a-4ff6-427e-a77a-e9ffa04888f5",
                        "source_entry_id": "56767159-c78c-3c2b-a2fd-945f0f85e89e",
                        "source_sense_id": "ad8fe136-2563-3941-92ba-1e5ee84baba6",
                        "target_lang_word": "монстр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "монстр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                        "entry_id": "a3122291-002e-3e50-a0c3-12624f283300",
                                        "glosses": [
                                            "существо (животное, человек) с врождёнными недостатками в строении, наружности, отличающими его от обычных существ; чудовище, урод"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7580adb0-4155-48e8-9110-1335e1e7bb01",
                                                "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                                "text": "1 февраля [Петр] запретил чеканить мелкие серебряные деньги, 6 февраля подновил указ о монстрах, указав приносить рождающихся уродов к комендантам городов, назнача плату за человеческие — по 10 р. , за скотские — по 5, за птичие — по 3 (за мёртвые); за живых же: за человеческий — по 100, за звериный — по 15, за птичий — по 7 руб. и проч."
                                            },
                                            {
                                                "example_id": "269fec5d-29eb-4008-b371-4b07d2367b6c",
                                                "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                                "text": "Между прочим, — не знаю, любите ли вы диковинки, но если любите, могу вам предложить, тоже бесплатно, в качестве домашнего зверька, довольно волнующего маленького монстра, девицу с тремя грудками, одна из которых — прелесть, и вообще — это редкое и очаровательное чудо природы."
                                            },
                                            {
                                                "example_id": "534cffc4-6b84-434b-a60f-00e07d677205",
                                                "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                                "text": "Существо было лишено чешуи. Просто тонкая кожа, мягкая как у лягушки. Он решил попробовать и выпотрошить голубого монстра — кости мало отличались от обычных рыбьих костей, мясо оказалось розовым, как у форели."
                                            },
                                            {
                                                "example_id": "62df0bb1-68d1-428e-bd0d-616f0a909e11",
                                                "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                                "text": "Похоже, западному кинозрителю уже приелись монстры — клыкастые вампиры, живые мертвецы, циклопическая обезьяна Кинг-Конг."
                                            },
                                            {
                                                "example_id": "9b223879-3f78-4ef3-b094-35a55463a716",
                                                "sense_id": "14dfdb50-b155-37c2-97be-b2e1641e15c3",
                                                "text": "Романские мастера создали целый мир ужасных существ, но они их представили так правдоподобно, что их монстры кажутся жившими в доисторическую эпоху."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e10630-d4c5-3c14-912d-c9c5a17ac04b",
                                        "entry_id": "a3122291-002e-3e50-a0c3-12624f283300",
                                        "glosses": [
                                            "перен. о человеке, резко отличающемся от других своими отрицательными нравственными качествами (грубостью, невежеством и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a7adc6-cf70-4690-a905-8b5381009c2f",
                                                "sense_id": "63e10630-d4c5-3c14-912d-c9c5a17ac04b",
                                                "text": "Я сказала, что вы — медведь, монстр!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aa150a-bf2f-3e3d-bb98-b3623339cd56",
                                        "entry_id": "a3122291-002e-3e50-a0c3-12624f283300",
                                        "glosses": [
                                            "перен. о чём-либо, поражающем своим уродством, величиной, своими необычными свойствами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eae6e93-fbb8-4bc8-b11c-b7d53c5e30f7",
                                                "sense_id": "72aa150a-bf2f-3e3d-bb98-b3623339cd56",
                                                "text": "Но модель атома Бора была, конечно, монстром — над стройным телом классически прекрасной электронной теории высилась абстрактная голова квантовых скачков."
                                            },
                                            {
                                                "example_id": "6aec0c4a-758b-4de4-8b45-170c0cf06e1e",
                                                "sense_id": "72aa150a-bf2f-3e3d-bb98-b3623339cd56",
                                                "text": "На Невском, как грибы, вырастали одно за другим «роскошные» здания — настоящие «монстры», вроде магазина Елисеева или дома Зингера."
                                            },
                                            {
                                                "example_id": "22a30de6-f585-4a0e-ab7c-bc807b1c2d05",
                                                "sense_id": "72aa150a-bf2f-3e3d-bb98-b3623339cd56",
                                                "text": "«Московские известия» с их огромным тиражом относились к монстрам газетного мира и вызывали уважение."
                                            },
                                            {
                                                "example_id": "415eb6c4-2664-41a4-84c4-9e22b4faa449",
                                                "sense_id": "72aa150a-bf2f-3e3d-bb98-b3623339cd56",
                                                "text": "Второй по величине табачный монстр планеты после «Филип Моррис» — корпорация «Бритиш Американ Тобакко» начала проникновение на российский рынок в 1991 году."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
