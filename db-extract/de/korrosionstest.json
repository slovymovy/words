                ],
                "senses": [
                    {
                        "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                        "entry_id": "e075498f-065c-379a-9037-69ac639b395f",
                        "glosses": [
                            "Überprüfung auf chemische Zerstörbarkeit eines Werkstoffs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d76db9c-db16-4661-95d8-bd4c1d98aabd",
                                "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                                "text": "„Der Korrosionstest erfolgt bei einer Gesamtumdrehungszahl von etwa 10 000 Umdrehungen und gestattet eine Versuchsdauer von 24 Stunden, auch dann, wenn schmelzgegossene Steine als Proben verwendet werden.“"
                            },
                            {
                                "example_id": "60975c53-6bea-4213-8494-b9fa8e53aaef",
                                "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                                "text": "„Wie man erkennen kann, hat die beschichtete Fingerprobe den einstündigen Korrosionstest nicht überstanden und ist in 2 Teile zerfallen.“"
                            },
                            {
                                "example_id": "e9fbecff-fc50-4352-b716-fae40b917fe2",
                                "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                                "text": "„Korrosionsteste werden an den Nadeln mit Hilfe eines Schnelltestes nach DIN- Vorschrift in einer wäßrigen Lösung durchgeführt (Farbumschlag des gelben Blutlaugensalzes).“"
                            },
                            {
                                "example_id": "bc5ea499-69c4-436f-95ea-90aec6cb3b39",
                                "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                                "text": "„Schwer entflammbare Hydraulikflüssigkeiten zur Verwendung auf Kriegsschiffen müssen zusätzlich verschärfte Korrosionsteste erfüllen […].“"
                            },
                            {
                                "example_id": "a1ef4580-a54b-4988-866f-54669c4783fe",
                                "sense_id": "1d98a1dd-cd1d-3c2f-843a-4d173239776c",
                                "text": "„Um Prüfzeiträume zu verkürzen und so schneller zu Lebensdaueraussagen zu kommen, werden z.B. die Angriffsbedingungen bei Korrosionstests verschärft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
