                "senses": [
                    {
                        "sense_id": "a1ac8a37-acbf-36fa-8ee1-6d732eb78804",
                        "entry_id": "d998b0c9-0eeb-3ed2-8989-4d563747670c",
                        "glosses": [
                            "rzeżączka"
                        ],
                        "tags": [
