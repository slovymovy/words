                                        "glosses": [
                                            "An instance of bashing; a physical or verbal attack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf29240-169a-4160-b80c-d22654bf0104",
                                                "sense_id": "aa4ac13a-801e-302a-b7d0-af3c9cc2e3b2",
                                                "text": "I gulped a bit of tea. ‘I bet, Dad,’ I said, ‘you give those poor old 1930s of yours a bit of a bashing.’"
                                            },
                                            {
                                                "example_id": "3129f599-046e-429b-802b-8a3b44db36a2",
                                                "sense_id": "aa4ac13a-801e-302a-b7d0-af3c9cc2e3b2",
                                                "text": "Jean-Claude Juncker has called for an end to “Russia-bashing” two months after scores of Moscow’s diplomats across the EU were expelled in response to the use of a nerve agent in the UK."
                                            }
                                        ]
                                    }
                                ]
