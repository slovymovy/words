                                "target_senses": [
                                    {
                                        "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                        "entry_id": "503a8526-d59f-3d5c-b769-0a0ec29868ad",
                                        "glosses": [
                                            "Qui peut être adapté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7009920f-d1e4-4799-ac1b-942447ab9e5d",
                                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                                "text": "Zara a copié des défilés, H&M et Uniqlo ont multiplié les collaborations, et les consommateurs découvert des vestiaires adaptables à toutes les silhouettes de mode et à bas prix."
                                            },
                                            {
                                                "example_id": "4ddc6b92-a776-48ec-8e8f-ac94a8989530",
                                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                                "text": "Pour se rapprocher au plus près de la cinématique individuelle du patient, Hanau propose, en 1921, le Kinoscope, premier articulateur totalement adaptable."
                                            },
                                            {
                                                "example_id": "e6f7adc1-22ce-47dd-bd9d-a281e28d919a",
                                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                                "text": "Dreeft est une paire de roues équipées d’un système de freinage par rétropédalage, adaptable à tout fauteuil roulant manuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5249eb6b-a6af-4de5-963c-3afef4b7549f",
                        "source_entry_id": "98a89478-620d-3913-982a-173eb11e3164",
                        "source_sense_id": "e41a8764-aa74-35dd-84b0-1d676d02f0ce",
                        "source_sense_description": "capable of adapting or of being adapted",
                        "target_lang_word": "anpassungsfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anpassungsfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                        "entry_id": "7de071b3-e073-3c31-aa51-b88a10a3ed78",
                                        "glosses": [
                                            "in der Lage (fähig), sich auf die Umgebung/Bedingungen/Anforderungen einzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8cf0f5-73b1-4ef3-a610-3cc50e1dfb78",
                                                "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                                "text": "Spatzen und Tauben sind an fast jede Umgebung anpassungsfähig, in der es für sie genügend Futter gibt."
                                            },
                                            {
                                                "example_id": "08dac345-d01f-4f46-b686-39bdbc79355b",
                                                "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                                "text": "„Er schrieb: »Nicht die stärkste Art überlebt, auch nicht die intelligenteste, sondern die anpassungsfähigste.«“"
                                            },
                                            {
                                                "example_id": "4e7cad0c-3eb9-41e5-b833-34c9ce8c4103",
                                                "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                                "text": "Er ist nicht gerade anpassungsfähig, eher so ein Sturkopf."
                                            },
                                            {
                                                "example_id": "8dcecac8-3121-49de-8343-8fdc7bd14b71",
                                                "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                                "text": "Hier ist ein knielanges Sommerkleid mit bequemem Schnitt, aus anpassungsfähigem Material gefertigt, das der Figur schmeichelt."
                                            },
                                            {
                                                "example_id": "cd22264c-eb60-40f0-82b1-65d1ef66f2cf",
                                                "sense_id": "ad334f46-6bd9-3cae-90f1-4e159e475445",
                                                "text": "„Äußerlich anpassungsfähig und im Innern zählebig, haben die Stierspiele bisher alle Anfeindungen überlebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
