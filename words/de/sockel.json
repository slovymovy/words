                    "frequency": "Middle",
                    "semantic_group_id": "Architektur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die schwere Bronzefigur steht auf einem massiven <w>Sockel</w> aus weißem Marmor."
                        },
                        {
                            "text": "Die Restauratoren reinigten den steinernen <w>Sockel</w> des Denkmals sehr vorsichtig von Moos und Schmutz."
                        }
                    ],
