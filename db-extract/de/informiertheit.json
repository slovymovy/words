                "senses": [
                    {
                        "sense_id": "802c562f-b515-33eb-aa6a-efcfd0910947",
                        "entry_id": "50d7637d-bfc2-3cdf-8b12-37e73c2a0e8b",
                        "glosses": [
                            "Eigenschaft, das erforderliche Wissen über eine bestimmte Angelegenheit zu besitzen; Ausmaß des Wissensstandes einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc887a50-40b3-4595-a6af-9f15f50b50d5",
                                "sense_id": "802c562f-b515-33eb-aa6a-efcfd0910947",
                                "text": "„Wird nur von einer mangelnden Informiertheit ausgegangen, ist es geboten, den Informationsstand zu erhöhen und den paternalistischen Eingriff danach aufzuheben.“"
                            },
                            {
                                "example_id": "7374c1a9-dfc5-4f5c-ba46-560330cc681a",
                                "sense_id": "802c562f-b515-33eb-aa6a-efcfd0910947",
                                "text": "„Schließlich ermöglicht der Rundfunk, dass die modernen (Stadt-)Menschen ihrem Anspruch nach Informiertheit genügen können.“"
                            },
                            {
                                "example_id": "a0b854e6-2a74-4600-a929-263083046fd0",
                                "sense_id": "802c562f-b515-33eb-aa6a-efcfd0910947",
                                "text": "„Intelligenz, Bildung und Kreativität sind erst dann relevant, wenn zumindest eine grundlegend korrekte und themenspezifische Informiertheit gewährleistet ist.“"
                            },
                            {
                                "example_id": "4c89d16c-cb7b-4172-a1e0-f2c245dd865a",
                                "sense_id": "802c562f-b515-33eb-aa6a-efcfd0910947",
                                "text": "„Erstens gelten in einer Demokratie politische Bildung und Informiertheit über das Nachrichtengeschehen als grundlegende Anforderungen an den mündigen Bürger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
