                "senses": [
                    {
                        "sense_id": "8fe1d947-2c17-3c42-8048-5f7ad175a8bf",
                        "entry_id": "5277235d-4ebd-3b61-af49-32d710f8ba9b",
                        "glosses": [
                            "A tribe making up part of a larger tribe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbece079-63f8-48e3-8215-837cc530847c",
                                "sense_id": "8fe1d947-2c17-3c42-8048-5f7ad175a8bf",
                                "text": "This leaves for consideration of this group of small tribes, or subtribes, so far as mapped by the writer quoted, the Teule, Cazcan, and Tecuexe."
                            }
                        ]
                    },
                    {
                        "sense_id": "72944d04-f84f-3f0a-acbe-6d1bf807f65e",
                        "entry_id": "5277235d-4ebd-3b61-af49-32d710f8ba9b",
                        "glosses": [
                            "A taxonomic category ranking below tribe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade030b0-8d47-4bdf-9c51-128f964d0fc0",
                                "sense_id": "72944d04-f84f-3f0a-acbe-6d1bf807f65e",
                                "text": "The tempo of evolution in South American hamsters was very rapid – in the course of the Pliocene and Anthropocene 40 genera were formed here, at which time a series of them attained the level of tribe and subtribe (Oxymycteri, Phyllotiini, Ichthyomyini)."
                            },
                            {
                                "example_id": "f0fdd58a-79af-478a-8cbb-6db9f35bfdb1",
                                "sense_id": "72944d04-f84f-3f0a-acbe-6d1bf807f65e",
                                "text": "Brieger and his associates first divide the subtribe Epidendrinae […] into what could be called series, distinguishing four such series in the subtribe."
                            }
                        ]
                    }
                ],
