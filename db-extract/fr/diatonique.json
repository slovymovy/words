                        "entry_id": "cbc4b7d7-0918-324d-90ba-0a4964ab31fd",
                        "glosses": [
                            "Qui procède par les tons naturels de la gamme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58782555-d18c-4814-b8ae-7d1cf45446e9",
                                "sense_id": "d6c48959-2431-3e8a-bf99-9fba14eec450",
                                "text": "L’échelle diatonique est la gamme de sept sons do, ré, mi, fa, sol, la, si."
                            },
                            {
                                "example_id": "3ddaef00-a79a-48af-bc7f-d4e706fabca3",
                                "sense_id": "d6c48959-2431-3e8a-bf99-9fba14eec450",
                                "text": "Les sept notes de la gamme sont séparées entre elles par des intervalles qu’on appelle tons et demi-tons diatoniques."
                            },
                            {
                                "example_id": "f4b7c4fe-7b34-4e75-8c55-29d0746fadc1",
                                "sense_id": "d6c48959-2431-3e8a-bf99-9fba14eec450",
                                "text": "La musique des psaumes chantés ici appartient aux trois genres de la musique byzantine : diatonique, enharmonique et chromatique."
                            }
                        ]
                    }
