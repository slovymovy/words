                "senses": [
                    {
                        "sense_id": "d8cfcad1-0abe-359a-89c2-4908833f8f10",
                        "entry_id": "79cc8a0e-4e82-3ec9-aaf6-e2088bf131e8",
                        "glosses": [
                            "Métier du lavage et blanchissement du linge."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "c516bcd2-c0cd-43c2-bde9-833356128b50",
                                "sense_id": "d8cfcad1-0abe-359a-89c2-4908833f8f10",
                                "text": "Pour fabriquer le savon proprement dit utilisé dans la toilette et en blanchisserie, on traite une huile ou une graisse par la soude ou la potasse ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e11726-1cb6-3fd0-8341-4bf188a3e40f",
                        "entry_id": "79cc8a0e-4e82-3ec9-aaf6-e2088bf131e8",
                        "glosses": [
                            "Lieu où l’on blanchit du linge, des toiles ou de la cire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97deb34d-18d0-4dd9-ada0-77c3d91c4d7a",
                                "sense_id": "e1e11726-1cb6-3fd0-8341-4bf188a3e40f",
                                "text": "Plus tard, je découvrirai encore la blanchisserie, dans une cour inaccessible aux clients. Une petite pièce rajoutée, équipée de machines à laver, de sèche-linges et d’une presse à repasser, où sont également stockés les draps et serviettes."
                            },
                            {
                                "example_id": "bf755465-3d97-4f27-8f07-a135ed577ce7",
                                "sense_id": "e1e11726-1cb6-3fd0-8341-4bf188a3e40f",
                                "text": "Aller à la blanchisserie. établir une blanchisserie."
                            }
                        ]
                    },
                    {
                        "sense_id": "983b3b5e-3320-3d07-8d6e-3a1480ca39b7",
                        "entry_id": "79cc8a0e-4e82-3ec9-aaf6-e2088bf131e8",
                        "glosses": [
                            "Établissement, usine ou boutique où le linge, après avoir été blanchi, est repassé pour être livré aux clients."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
