                                "target_senses": [
                                    {
                                        "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
                                        "glosses": [
                                            "äußere Begrenzung eines Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437ae1fe-dad1-475f-a088-2b56eaa2a379",
                                                "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                                "text": "Um ein gutes Foto zu schießen, stand er nah am Rande des Felsens."
                                            },
                                            {
                                                "example_id": "f4d127f0-b9a1-4d04-82c5-4a5146ef7147",
                                                "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                                "text": "Er wartete am Rande der Fahrbahn auf den Abschleppdienst."
                                            },
                                            {
                                                "example_id": "e8c50501-383a-40d4-8205-0fd4ffb6d172",
                                                "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                                "text": "Sie trug eine Brille mit dickem Rand."
                                            },
                                            {
                                                "example_id": "38d9e5c4-7eea-4f1e-af64-7c4ab20a8a69",
                                                "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                                "text": "Der Kamillentee schwappt über den Rand."
                                            },
                                            {
                                                "example_id": "d14255b3-499c-4821-bdac-be5d7d43ed26",
                                                "sense_id": "7441d60c-73d6-3977-b5be-7e426238d47a",
                                                "text": "Am Strand von Tanger, in der glühendheißen Sonne liegen sie, am Rande der Wüste (Ideal: „Sex in der Wüste“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "743d1186-3f28-3bed-add5-ed398f5877dd",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
                                        "glosses": [
                                            "äußere Begrenzung einer (abstrakten) Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24834d64-8d4a-4b21-b261-57c825ea4bb6",
                                                "sense_id": "743d1186-3f28-3bed-add5-ed398f5877dd",
                                                "text": "Er steht politisch am rechten Rand."
                                            },
                                            {
                                                "example_id": "323a7c59-7058-49b0-b5e6-e4fb572a1c98",
                                                "sense_id": "743d1186-3f28-3bed-add5-ed398f5877dd",
                                                "text": "Mit der neuen Investition brachte er sein Unternehmen an den Rand des Abgrunds."
                                            },
                                            {
                                                "example_id": "6857d3f9-37a6-4f13-9396-e190e0599b36",
                                                "sense_id": "743d1186-3f28-3bed-add5-ed398f5877dd",
                                                "text": "Mit seinen ständigen Streitereien brachte er sie an den Rand der Verzweiflung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8e4a3c7-f7eb-3f50-a525-08d0f6a0f4e3",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
                                        "glosses": [
                                            "außen frei bleibende Fläche eines Papierbogens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2adc028-533f-439e-8a61-308764e0cf45",
                                                "sense_id": "c8e4a3c7-f7eb-3f50-a525-08d0f6a0f4e3",
                                                "text": "Er vermerkte seinen Geistesblitz mit schwarzer Tinte am Rand."
                                            },
                                            {
                                                "example_id": "9b11c439-a1be-49a8-a794-b7c0ee28fab4",
                                                "sense_id": "c8e4a3c7-f7eb-3f50-a525-08d0f6a0f4e3",
                                                "text": "Die Lehrerin erklärte den Schülern, dass bei Diktaten der Rand nicht beschrieben werde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cfc65ee1-c458-3a95-b5fc-421cfa4b5436",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
                                        "glosses": [
                                            "etwas in der Form eines dünnen Streifens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4effbb-4e6c-4ae0-8950-6e563979c52e",
                                                "sense_id": "cfc65ee1-c458-3a95-b5fc-421cfa4b5436",
                                                "text": "Nach einer durchzechten Nacht hatte er Ränder um die Augen."
                                            },
                                            {
                                                "example_id": "989fde82-3565-4490-bbc5-594066199ee6",
                                                "sense_id": "cfc65ee1-c458-3a95-b5fc-421cfa4b5436",
                                                "text": "Der Rand des Teppichs war ausgefranst."
                                            },
                                            {
                                                "example_id": "f1d2382d-d210-4de7-81a0-ed2c9e6fd9f8",
                                                "sense_id": "cfc65ee1-c458-3a95-b5fc-421cfa4b5436",
                                                "text": "Das Eichenlaub ziert die Mitte des Tellers und einen schmalen Rand."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1f73d2cf-59e0-3f95-b3b8-ba8cc4895edc",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
                                        "glosses": [
                                            "Mund"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01bd1270-d453-462d-a109-fc2f66ab625b",
                                                "sense_id": "1f73d2cf-59e0-3f95-b3b8-ba8cc4895edc",
                                                "text": "Halt jetzt deinen Rand!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "93dccedc-ff40-3872-a37b-5b50237ef9c0",
                                        "entry_id": "656818de-0b52-3248-a751-2bdc0d74bfd2",
