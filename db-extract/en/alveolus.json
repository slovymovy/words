                "senses": [
                    {
                        "sense_id": "b86ce2ab-d358-3cc7-9290-fa97cda3448b",
                        "entry_id": "221c769e-c5eb-30d6-a3e9-d43b06efa3be",
                        "glosses": [
                            "A small cavity or pit.",
                            "Any of the many tiny air sacs in the lungs in which the bronchioles terminate and where oxygen and carbon dioxide are rapidly exchanged with the pulmonary capillaries."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f65ffdc7-a1a0-3f9b-b68a-c291d43b91d1",
                        "entry_id": "221c769e-c5eb-30d6-a3e9-d43b06efa3be",
                        "glosses": [
                            "A small cavity or pit.",
                            "The bony socket in which the root of a tooth resides."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b9091273-9856-3ead-b680-8ae3536f0519",
                        "entry_id": "221c769e-c5eb-30d6-a3e9-d43b06efa3be",
                        "glosses": [
                            "A small cavity or pit.",
                            "An acinus (saclike cavity) in a gland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71102125-5a69-44b9-a0c5-544860edef04",
                                "sense_id": "b9091273-9856-3ead-b680-8ae3536f0519",
                                "text": "The sprouts proliferate and canalize to form the lactiferous ducts and the outbuddings form the alveoli of the mammary glands."
                            }
                        ]
                    },
                    {
                        "sense_id": "a71504d4-580a-3e72-9fb3-5bff38309f87",
                        "entry_id": "221c769e-c5eb-30d6-a3e9-d43b06efa3be",
                        "glosses": [
                            "A small cavity or pit.",
                            "The socket of a macrotrichium (seta)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cfd65a6-c723-4cf7-bd76-3547b0499557",
