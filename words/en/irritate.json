{
    "word_family": [
        "irritation",
        "irritant",
        "irritable",
        "irritability",
        "irritatingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a17610b-3295-3a85-96ba-80b7cc9aea18",
                    "sense_definition": "To provoke impatience, anger, or annoyance in someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site began to <w>irritate</w> the office workers.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройки начал <w>раздражать</w> офисных работников."
                            }
                        },
                        {
                            "text": "It would <w>irritate</w> him to know that his hard work was being ignored by the manager.",
                            "target_lang_translations": {
                                "ru": "Его бы <w>разозлило</w> известие о том, что менеджер игнорирует его тяжелый труд."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "bother",
                        "exasperate",
                        "irk",
                        "peeve",
                        "vex"
                    ],
                    "antonyms": [
                        "please",
                        "soothe",
                        "placate"
                    ],
                    "common_phrases": [
                        "irritate someone",
                        "easily irritate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство нетерпения, гнева или досады."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать недовольство или досаду"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "приводить в состояние злости"
                            },
                            {
                                "target_lang_word": "сердить",
                                "target_lang_sense_clarification": "вызывать гнев или раздражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8570834f-0c2d-3987-ba6d-94e2b6d4d8f1",
                    "sense_definition": "To cause physical discomfort, inflammation, or pain in a part of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical discomfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Harsh chemicals in some soaps can <w>irritate</w> sensitive skin and cause a red rash.",
                            "target_lang_translations": {
                                "ru": "Агрессивные химикаты в некоторых видах мыла могут <w>раздражать</w> чувствительную кожу и вызывать красную сыпь."
                            }
                        },
                        {
                            "text": "The smoke from the fire started to <w>irritate</w> her eyes and throat.",
                            "target_lang_translations": {
                                "ru": "Дым от костра начал <w>раздражать</w> её глаза и горло."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflame",
                        "chafe",
                        "aggravate",
                        "sting"
                    ],
                    "antonyms": [
                        "soothe"
                    ],
                    "common_phrases": [
                        "irritate the skin",
                        "irritate the eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать физический дискомфорт, воспаление или боль в какой-либо части тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать воспаление или зуд"
                            },
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "вызывать раздражение трением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f2ae23-30fd-309a-9103-13f8586bd4ef",
                    "sense_definition": "To render a law or agreement null and void.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal invalidation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new statute was designed to <w>irritate</w> previous local regulations that were no longer effective.",
                            "target_lang_translations": {
                                "ru": "Новый устав был разработан, чтобы <w>аннулировать</w> прежние местные постановления, которые более не были эффективны."
                            }
                        },
                        {
                            "text": "Legal scholars debated whether the clause would <w>irritate</w> the entire contract.",
                            "target_lang_translations": {
                                "ru": "Правоведы спорили о том, может ли этот пункт <w>сделать недействительным</w> весь контракт."
                            }
                        }
                    ],
                    "synonyms": [
                        "annul",
                        "nullify",
                        "invalidate",
                        "abrogate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать закон или соглашение недействительным или утратившим силу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "объявлять недействительным"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "прекращать действие закона или договора"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}