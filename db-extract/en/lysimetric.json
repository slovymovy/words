                                "example_id": "c94300d8-34b5-4823-a920-b31268d8a548",
                                "sense_id": "b0130db2-3fd8-37ca-9ba0-dffe0a6be39b",
                                "text": "Various methods of lysimetric investigation have been proposed and used, all of them possessing many points of value."
                            },
                            {
                                "example_id": "2235c659-84d2-4911-81cb-f6d9325956cb",
                                "sense_id": "b0130db2-3fd8-37ca-9ba0-dffe0a6be39b",
                                "text": "Therefore, their water table should be maintained at the same level as in the surrounding peat deposit, i.e. lysimetric evaporimeters must be used, for instance the GGI B-1000 type."
                            },
                            {
                                "example_id": "8e2d7b26-0a87-4e09-8af3-279cb2e72208",
                                "sense_id": "b0130db2-3fd8-37ca-9ba0-dffe0a6be39b",
                                "text": "Lysimetric experiments represent one of the relatively precise methods for arriving at the balance of important biogenic elements in the soil — plant system."
                            }
                        ]
