                                        "examples": [
                                            {
                                                "example_id": "e8c525c0-3166-4b99-9a0e-9661851efc4a",
                                                "sense_id": "2c736d94-b43c-313f-b932-6e4e306d2cb5",
                                                "text": "Hij kan het roken niet voor een dagje laten."
                                            },
                                            {
                                                "example_id": "ffb9bf10-36b5-4a96-be90-349077d542fc",
                                                "sense_id": "2c736d94-b43c-313f-b932-6e4e306d2cb5",
                                                "text": "In verschillende landen is het bij wet verboden te roken in openbare gebouwen."
                                            },
                                            {
                                                "example_id": "1682282c-7f61-457f-b7a3-f196254f7840",
                                                "sense_id": "2c736d94-b43c-313f-b932-6e4e306d2cb5",
                                                "text": "De gesprekken met deze dames waren diepgaander, maar voor de rest vloekten ze evenveel als de gemiddelde man, lieten ze evenveel scheten, rookten ze evenveel wiet en liepen ze even hard."
                                            },
                                            {
                                                "example_id": "1c53a6a0-501b-4714-9f28-785545975869",
                                                "sense_id": "2c736d94-b43c-313f-b932-6e4e306d2cb5",
                                                "text": "Ik had geen zin om te beginnen met roken, niet één zwemmer rookte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39df7486-81f9-35e0-a7fe-7df66c49d5b2",
                                        "entry_id": "34d038fb-12a8-3c5c-a979-d822408f7115",
                                        "glosses": [
