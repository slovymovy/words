        "fr-extract.jsonl": [
            {
                "entry_id": "f00fa396-b5e2-37c6-ace1-3fcaa41f943e",
                "word": "gasoil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fb886e28-b06c-40f4-912d-2c3ea5b5667e",
                        "entry_id": "f00fa396-b5e2-37c6-ace1-3fcaa41f943e",
                        "tags": [
                            "plural"
                        ],
                        "form": "gasoils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7a889fe-5393-3383-8f8e-f5bf72c76f3f",
                        "entry_id": "f00fa396-b5e2-37c6-ace1-3fcaa41f943e",
                        "glosses": [
                            "Carburant d'origine pétrolière utilisé par les moteurs diesel, mélange d'hydrocarbures allant de C₁₀ à C₁₈."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a02cea1-3744-43a5-bd6b-caa6bbcb1acf",
                                "sense_id": "d7a889fe-5393-3383-8f8e-f5bf72c76f3f",
                                "text": "Les besoins en énergie de Tériya Bugu sont couverts en partie par le solaire thermique et photovoltaïque ainsi que le biogaz mais la plus grande part de l’électricité est produite par des groupes électrogènes fonctionnant au gasoil. La consommation en carburant s’élève actuellement 65 000 L/an."
                            },
                            {
                                "example_id": "7a7a074a-68f0-48a7-af47-b927613a0a29",
                                "sense_id": "d7a889fe-5393-3383-8f8e-f5bf72c76f3f",
                                "text": "Le diméthipin a eu une action défanante assez lente, comparable à celle de l'association de dinosèbe et de gasoil, mais nettement moins rapide que celle du diquat."
                            },
                            {
                                "example_id": "cf3eee23-f27f-4d96-b0de-7ab4a1f98b39",
                                "sense_id": "d7a889fe-5393-3383-8f8e-f5bf72c76f3f",
                                "text": "À la suite de ces actions, les syndicats agricoles FDSEA et JA ont sollicité, auprès du conseil départemental, « une indemnisation financière du gasoil consommé pour tous les agriculteurs qui se sont portés volontaires », expliquent-ils dans un communiqué."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b16d0028-23b5-4c59-9d0c-19caf6e0de93",
                        "source_entry_id": "f00fa396-b5e2-37c6-ace1-3fcaa41f943e",
                        "source_sense_id": "d7a889fe-5393-3383-8f8e-f5bf72c76f3f",
                        "target_lang_word": "Diesel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diesel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54aaabdb-cc28-329a-9a1b-03a9cb543e0f",
                                        "entry_id": "ac0c6b75-fc22-3afc-8e70-b8f82ea50e37",
                                        "glosses": [
                                            "Kurzform für Dieselmotor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e917e908-a58a-4776-a02a-f8bef8d536a4",
                                                "sense_id": "54aaabdb-cc28-329a-9a1b-03a9cb543e0f",
                                                "text": "Der Diesel braucht keine Zündkerze."
                                            },
                                            {
                                                "example_id": "b83646ed-4cfc-4985-a1db-4ed6ccaad393",
                                                "sense_id": "54aaabdb-cc28-329a-9a1b-03a9cb543e0f",
                                                "text": "„Es war wie immer, die Diesel sangen im Diskant, und das Boot bebte vor Kraft, der Turm nahm viel Wasser über, das Vorschiff wuchtete manchmal so schwer in die See, daß man Angst bekommen konnte, es käme niemals wieder hoch.“"
                                            },
                                            {
                                                "example_id": "1b9700ac-8b90-4c1a-b496-91341b37a4c6",
                                                "sense_id": "54aaabdb-cc28-329a-9a1b-03a9cb543e0f",
                                                "text": "„Dann war für längere Zeit nur das monotone Brummen des Diesels in der Fahrerkabine des Trucks zu hören.“"
                                            },
                                            {
                                                "example_id": "717fefc1-9526-4d12-8733-8901643cf04e",
                                                "sense_id": "54aaabdb-cc28-329a-9a1b-03a9cb543e0f",
                                                "text": "„Ich lasse meinen Blick über die beiden Diesel laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd437dcd-5a51-3735-9aaa-b339df414b16",
                                        "entry_id": "ac0c6b75-fc22-3afc-8e70-b8f82ea50e37",
                                        "glosses": [
                                            "mit Dieselmotor betriebenes Fahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ed2d0c-a241-4a2c-858d-f126003c7740",
                                                "sense_id": "cd437dcd-5a51-3735-9aaa-b339df414b16",
                                                "text": "Der Diesel verbraucht für 100 km viel weniger Kraftstoff als ein Benziner."
                                            },
                                            {
                                                "example_id": "2d53e8ca-90f8-4f85-a4ee-8f7e1c4c29a8",
                                                "sense_id": "cd437dcd-5a51-3735-9aaa-b339df414b16",
                                                "text": "Ohne [die Kurbelwelle] fährt kein Benziner oder Diesel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ee4cc685-3277-3887-92e8-4d6cc705a127",
                                        "entry_id": "ac0c6b75-fc22-3afc-8e70-b8f82ea50e37",
                                        "glosses": [
                                            "Kurzform für Dieselkraftstoff, einen Treibstoff mit schweren Kohlenwasserstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1125604-ff00-4b5f-bb1c-459ca377969f",
                                                "sense_id": "ee4cc685-3277-3887-92e8-4d6cc705a127",
                                                "text": "Mit Diesel eingerieben kann ich die Gartenwerkzeuge vor dem Verrosten schützen."
                                            },
                                            {
                                                "example_id": "f9cebc0b-2480-4f35-877b-415043867b5f",
                                                "sense_id": "ee4cc685-3277-3887-92e8-4d6cc705a127",
                                                "text": "„Normalerweise stinkt es nach Diesel, aber jetzt ist es wohl auch Angstschweiß, der hier stinkt, und dazu wer weiß was alles – Pisse vor allem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "005515a5-bba7-3c49-bd9c-5f0ab7f77288",
                                        "entry_id": "ac0c6b75-fc22-3afc-8e70-b8f82ea50e37",
                                        "glosses": [
                                            "Cola-Bier-Mischgetränk"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332881a4-f259-4642-a2a1-68e371e11498",
                                                "sense_id": "005515a5-bba7-3c49-bd9c-5f0ab7f77288",
                                                "text": "„Am bekanntesten dürfte das Cola- oder Schussbier sein, in anderen Gegenden Deutschlands auch Dreckiges, Flieger oder Diesel genannt. Andere beliebte Mischgetränke sind das Radler – in Norddeutschland Alsterwasser genannt – mit Zitronenlimonade.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Diesel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                        "entry_id": "2ea33bf5-cbe7-313d-9fd5-df137a031de4",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "164d525f-55e6-4e9e-9bdb-df466ebe6244",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Frau Diesel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a5e26da3-37e3-4b6c-ab52-9e4645c0c8e9",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Herr Diesel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4c550b7e-5486-4ded-8eec-6e56f7a61450",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Die Diesels fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "dc95cd4e-aa66-4a23-9439-6e2d9a88b9ef",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Der Diesel trägt nie die Pullover, die die Diesel ihm strickt."
                                            },
                                            {
                                                "example_id": "7b0d38be-e99d-4716-adc0-0066307c2a2d",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Diesel kommt, geht der Herr Diesel.“"
                                            },
                                            {
                                                "example_id": "bbae71ea-1d40-4f27-a0e9-7f9c695da3c4",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Diesel kommt und geht."
                                            },
                                            {
                                                "example_id": "99e42fed-905c-405c-bd37-265045b5a13d",
                                                "sense_id": "d3ad7323-fb41-3c79-b280-a79d4edef4e9",
                                                "text": "Diesels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12560d91-e2ec-4db8-a550-4046268348e1",
                        "source_entry_id": "f00fa396-b5e2-37c6-ace1-3fcaa41f943e",
