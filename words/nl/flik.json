            "senses": [
                {
                    "sense_id": "e2e5bae6-8f6a-313d-b0b7-c15db9a03a51",
                    "sense_definition": "informele benaming voor een politieagent",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>flikken</w> kwamen snel ter plaatse na de melding.",
                            "target_lang_translations": {
                                "ru": "<w>Менты</w> быстро прибыли на место после вызова."
                            }
                        },
                        {
                            "text": "Pas op, daar staan de <w>flikken</w> te controleren.",
                            "target_lang_translations": {
                                "ru": "Осторожно, там <w>менты</w> стоят, проверяют."
                            }
                        }
                    ],
                    "synonyms": [
                        "politieagent",
                        "smeris"
                    ],
                    "common_phrases": [
                        "de flikken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное название полицейского"
                    },
                    "translations": {
