                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a88544-396d-450c-880f-4a9682e4afbf",
                                                "sense_id": "938735a1-c274-3945-baf5-7616c9cea9e8",
                                                "text": "Du solltest dich intensiver mit elektrischen Einheiten befassen."
                                            }
