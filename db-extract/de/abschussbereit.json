                ],
                "senses": [
                    {
                        "sense_id": "dae54229-907f-3387-affc-3cf28d49cb40",
                        "entry_id": "1f2d87fb-3337-31ec-b035-fa827b49c2c6",
                        "glosses": [
                            "vorbereitet sein, zu schießen oder etwas abzuschießen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc0387b-b2c6-45b1-9d3b-4f58460b68e9",
                                "sense_id": "dae54229-907f-3387-affc-3cf28d49cb40",
                                "text": "„Zuvor hatte die libanesische Armee, die gemeinsam mit einer 12.000 Mann starken Friedenstruppe der Vereinten Nationen darüber wachen soll, dass der waffenfrei ist, vier weitere abschussbereite Raketen in Hula gefunden und entschärft.“"
                            },
                            {
                                "example_id": "1155a309-b124-43bf-b061-de8d84bc2225",
                                "sense_id": "dae54229-907f-3387-affc-3cf28d49cb40",
                                "text": "„Danach teilen sich zum Beispiel die Crews, die die 450 abschussbereiten interkontinentalen Atomraketen warten, einen einzigen Schraubenschlüssel, den man braucht, um die Sprengköpfe der Raketen abzumontieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
