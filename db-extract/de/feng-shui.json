                                "target_senses": [
                                    {
                                        "sense_id": "00b1849d-d704-324c-81bd-d5f5eaca4f24",
                                        "entry_id": "ae055983-acfb-3468-bbed-2cc223738114",
                                        "glosses": [
                                            "(pseudo-science) Art taoïste chinois dont le but est d’harmoniser le qi d’un lieu de manière à favoriser la santé, le bien-être et la prospérité de ses occupants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b958c1e1-f30d-4520-931b-04e8cc3870d7",
                                                "sense_id": "00b1849d-d704-324c-81bd-d5f5eaca4f24",
                                                "text": "Parmi les pratiques provenant du taoïsme, on retrouve : l’acupuncture, le shiatsu (une technique de massage), le taï-chi-chuan (un art martial) et même le feng shui (art du bien-vivre dans la maison)."
                                            },
                                            {
                                                "example_id": "713f51ba-668b-4203-9235-73ff0028dd02",
                                                "sense_id": "00b1849d-d704-324c-81bd-d5f5eaca4f24",
                                                "text": "Le feng shui est un ensemble d’anciennes règles qui tentent d’obtenir une harmonie entre l’homme et la nature."
                                            },
                                            {
                                                "example_id": "c6dbbb55-44b6-4c0b-a46d-0985475359b5",
                                                "sense_id": "00b1849d-d704-324c-81bd-d5f5eaca4f24",
                                                "text": "Quand j'ai dit è ma mère que je voulais un miroir comme le sien dans ma chambre, elle m'a dit que ce n'est pas feng shui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
