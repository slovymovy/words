                    {
                        "translation_id": "214872d2-5eff-470b-8ea3-c2d841838e03",
                        "source_entry_id": "5f61deba-4a27-3403-b153-d04503a3d19c",
                        "source_sense_description": "illegal trader",
                        "target_lang_word": "bootlegger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootlegger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a27fab2-7f39-33b0-b250-0144a450dd46",
                                        "entry_id": "1bc1e66a-e292-3c62-99d1-d839c5e502fd",
                                        "glosses": [
                                            "Marchand illégal, spécialement de l’alcool de contrebande."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9eb4cb3-48b6-40d6-855b-902e2cc931a9",
                                                "sense_id": "2a27fab2-7f39-33b0-b250-0144a450dd46",
                                                "text": "Il se faisait passer pour un ancien major Howard, de l’American Legion, mais on a pu établir que c’était un ancien « bootlegger » de New York connu aux États-Unis sous le sobriquet de Gros Fred."
                                            },
                                            {
                                                "example_id": "26851552-66d5-4e7e-b0ff-4207b44ec632",
                                                "sense_id": "2a27fab2-7f39-33b0-b250-0144a450dd46",
                                                "text": "L’inspecteur de police Riley, après avoir examiné l’endroit, a déclaré que le trou avait dû être creusé par des bootleggers qui cherchaient une cachette sûre pour leur alcool de contrebande."
                                            },
                                            {
                                                "example_id": "83e0167a-8285-40a6-b899-1b0a15d4866c",
                                                "sense_id": "2a27fab2-7f39-33b0-b250-0144a450dd46",
                                                "text": "S'ensuivirent quelques mondanités sur les mérites comparés de liqueurs d'hommes. Accord autour du Rebel Yell, un rince-cochon de première, distillé parcimonieusement par des bootleggers fous."
                                            },
                                            {
                                                "example_id": "f5567679-ff77-417c-9980-e1575d223213",
                                                "sense_id": "2a27fab2-7f39-33b0-b250-0144a450dd46",
                                                "text": "Oui on est heureux quand qu’on est sur le bootlegger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80b01c09-8bc3-48a3-800c-fe5cdfe96148",
                        "source_entry_id": "5f61deba-4a27-3403-b153-d04503a3d19c",
                        "source_sense_description": "illegal trader",
                        "target_lang_word": "trafiquant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trafiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0df98dd-8da3-38b5-aa98-85063e06e914",
                                        "entry_id": "aa2fb450-e12a-3272-b91a-5c694ae3ae50",
                                        "glosses": [
                                            "Commerçant, négociant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230cf9a9-655a-46a2-938f-6358a47aa900",
                                                "sense_id": "c0df98dd-8da3-38b5-aa98-85063e06e914",
                                                "text": "Perrot poursuit ses courses lointaines jusqu'en 1697, partageant son temps entre ses occupations de trafiquant, d'interprète, de diplomate et de pacificateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                        "entry_id": "aa2fb450-e12a-3272-b91a-5c694ae3ae50",
                                        "glosses": [
                                            "Truand spécialisé dans le commerce de produits interdits, contrefaits ou de contrebande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed5b1db-3f9d-4063-810b-a936253e467a",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Un édit alla jusqu’à prononcer la peine de mort contre les trafiquants […]"
                                            },
                                            {
                                                "example_id": "a2672611-8b5c-4d0f-8d25-a1a71e6f6fd0",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Un vague et déprimant malaise planait. Sous le porche des Réguliers, personne. Les trafiquants de drogue qui s’y postaient le soir s’étaient, prudemment, éclipsés."
                                            },
                                            {
                                                "example_id": "918f732f-01ea-4a18-bfbb-d652f69a000c",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Notre ancienne camée n'avait jamais été revendeuse et, notre trafiquant ignorait qu'elle ne se schnouffait plus."
                                            },
                                            {
                                                "example_id": "71ba54d1-f618-48be-a9dc-9ecaa6fb92b4",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Claude Riendeau, lui, est un ex-flic devenu voleur à main armée, usurier, trafiquant de coke et « détaillant » d’armes, comme il aime dire pudiquement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trafiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "637a9cb5-1e6d-3adc-bef5-3dbad1f82481",
                                        "entry_id": "b5f4e72a-9202-3035-854a-1c7a70ca77db",
                                        "glosses": [
                                            "Participe présent de trafiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bdf8e9e-e233-40c0-bbca-e8a2dfd39ca4",
                        "source_entry_id": "5f61deba-4a27-3403-b153-d04503a3d19c",
                        "source_sense_description": "illegal trader",
                        "target_lang_word": "Schwarzhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarzhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b24250b-2ee4-359f-806c-23430d2ea7cb",
                                        "entry_id": "b3f128b8-02c4-3262-9022-4f6762b7d876",
                                        "glosses": [
                                            "Person, die Schwarzhandel, also illegalen Handel betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ecd8662-bd6a-41ba-9e4a-60533b7093a6",
                                                "sense_id": "5b24250b-2ee4-359f-806c-23430d2ea7cb",
                                                "text": "„Die holländische Westindien-Kompanie beharrte auf ihrem dubiosen Anspruch auf das Fort, zum Teil auch deswegen, weil Konny es zu einem Schlupfwinkel für europäische Schwarzhändler gemacht hatte.“"
                                            },
                                            {
                                                "example_id": "29f224f5-b7cf-42d6-9d96-5b2297ee7bc5",
                                                "sense_id": "5b24250b-2ee4-359f-806c-23430d2ea7cb",
                                                "text": "„Und Ichtiar, der hauptberuflich als Polizist arbeitet und nebenberuflich als Schwarzhändler, nickt lässig.“"
                                            },
                                            {
                                                "example_id": "4e14e664-b21b-4998-b40f-cb0f01fe42c5",
                                                "sense_id": "5b24250b-2ee4-359f-806c-23430d2ea7cb",
                                                "text": "„Da hüpft das Herz jedes Schwarzhändlers.“"
                                            },
                                            {
                                                "example_id": "c8ad8320-5189-4859-bf5b-2b6cff2efbed",
                                                "sense_id": "5b24250b-2ee4-359f-806c-23430d2ea7cb",
                                                "text": "„Er verschob, wie andere Schwarzhändler, riesige Mengen von kriegswichtigen Gütern – aber nicht, um sie an die Deutschen zu verkaufen, sondern um sie vor den Deutschen in Sicherheit zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
