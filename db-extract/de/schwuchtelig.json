                        "examples": [
                            {
                                "example_id": "df066656-105f-467a-86f8-5509630f902e",
                                "sense_id": "7c1ce7ff-1748-3222-9804-430b376735e7",
                                "text": "„Joe Lon schob sich ein Eigelb in den Mund und goss einen Schluck Whiskey hinterher. ›Hast den schwuchteligen Debattierspieler getroffen?‹“"
                            },
                            {
                                "example_id": "ea5f4238-d7f9-41b6-8efb-eaf2dd94b359",
                                "sense_id": "7c1ce7ff-1748-3222-9804-430b376735e7",
                                "text": "„›Dein Anwalt ist tot, du Scheißhaufen. Dieser schwuchtelige Winkeladvokat von Murrell hatte vor vier Jahren einen Herzinfarkt.‹“"
                            }
