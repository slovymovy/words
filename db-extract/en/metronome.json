                    },
                    {
                        "translation_id": "f3905c71-f39f-40e5-b08d-a0a3d1b28826",
                        "source_entry_id": "7ec8d223-95c8-3d4e-82eb-79e2a8876b73",
                        "source_sense_id": "ea0cc22d-d059-3209-b616-1d5a9f12294d",
                        "source_sense_description": "a device used in music",
                        "target_lang_word": "métronome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métronome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                        "entry_id": "8be17a7e-cb4a-38cf-81eb-0fa2de70300f",
                                        "glosses": [
                                            "Instrument d’horlogerie qui sert à battre la mesure."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8794223c-c708-4a14-8cdb-d8ba88e694ac",
                                                "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                                "text": "Sur les hauteurs dominant le fleuve, un métronome géant battait la mesure où s'élevait encore, quelques années auparavant, une statue déboulonnable à l'effigie du petit père des peuples."
                                            },
                                            {
                                                "example_id": "44d2149f-838e-4587-b60c-43cd7e8f6744",
                                                "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                                "text": "Il entendit les grognements d’une bête furieuse. Réguliers. Affreux métronome fracassant le silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ada8b90-8643-4307-aec9-b151e385991f",
                        "source_entry_id": "7ec8d223-95c8-3d4e-82eb-79e2a8876b73",
                        "source_sense_id": "ea0cc22d-d059-3209-b616-1d5a9f12294d",
                        "source_sense_description": "a device used in music",
                        "target_lang_word": "Metronom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metronom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                        "entry_id": "c0e43fa3-3166-3e57-8e85-a6a7b268f876",
                                        "glosses": [
                                            "Gerät, das durch lautes Ticken dem Musiker das eingestellte Tempo vorgibt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9eaa7c-93dd-4359-a241-46cee62b0a41",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„40 Jahre, in denen der sonnengegerbte Mann einem so gleichmäßigen Arbeitsrhythmus folgen sollte, als steuerte ihn ein Metronom...“"
                                            },
                                            {
                                                "example_id": "fcf16342-03ac-44f6-ad8b-7d94d96df0e7",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„Jedenfalls, solange die Komponisten so freundlich waren, ihre entsprechenden Angaben mit dem Hinweis zu versehen, auf welchen Wert das Metronom zu stellen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efea0610-01e7-4633-9fca-63ba8be8dd15",
                        "source_entry_id": "7ec8d223-95c8-3d4e-82eb-79e2a8876b73",
