                        "sense_id": "0caa859b-0eb2-33b7-be99-f8611b2f977f",
                        "entry_id": "a0f02d1d-ef20-3a5c-8116-48109b61ec34",
                        "glosses": [
                            "Personne qui a une peur maladive du feu, des incendies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e984f095-6ff4-40fd-8509-6df2860a4c0a",
                                "sense_id": "0caa859b-0eb2-33b7-be99-f8611b2f977f",
                                "text": "Le pyrophobe est ce malade, qui passe sa nuit à chercher dans son appartement, sur les tapis, sous les meubles, les allumettes ou tout autre objet, susceptible de provoquer un incendie."
                            },
                            {
                                "example_id": "43763953-4589-41e9-b265-2294325bbabd",
                                "sense_id": "0caa859b-0eb2-33b7-be99-f8611b2f977f",
                                "text": "Elle avait décidé, après vingt et un ans de vie commune avec un pyrophobe de niveau trois, de soigner le mal par le mal."
                            }
                        ]
                    }
                ],
