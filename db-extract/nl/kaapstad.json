                            {
                                "example_id": "000d6ca7-8a45-4c1e-b062-c8a6bff3ce13",
                                "sense_id": "8ebe568d-e313-3e74-9852-90c2e2427e9b",
                                "text": "Er worden tegenwoordig veel vakanties geboekt naar Kaapstad."
