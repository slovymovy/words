{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2a323418-7569-3740-8d38-3bff34808885",
                    "sense_definition": "Неожиданно, внезапно, без всякого предупреждения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "suddenly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Вдруг</w> пошёл сильный дождь, и мы побежали домой.",
                            "target_lang_translations": {
                                "en": "<w>Suddenly</w> it started raining heavily, and we ran home.",
                                "zh": "<w>突然</w>下起了大雨，我们跑回了家。"
                            }
                        },
                        {
                            "text": "Мы спокойно разговаривали, как <w>вдруг</w> погас свет.",
                            "target_lang_translations": {
                                "en": "We were talking calmly when <w>suddenly</w> the lights went out.",
                                "zh": "我们正平静地交谈着，<w>忽然</w>灯灭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "внезапно",
                        "неожиданно",
                        "без предупреждения"
                    ],
                    "common_phrases": [
                        "как вдруг",
                        "и вдруг"
                    ],
                    "target_lang_definitions": {
                        "en": "Unexpectedly, suddenly, without any warning.",
                        "zh": "指事情发生得非常快，出乎意料，没有预兆。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suddenly",
                                "target_lang_sense_clarification": "happening quickly and unexpectedly"
                            },
                            {
                                "target_lang_word": "all of a sudden",
                                "target_lang_sense_clarification": "idiomatic phrase for suddenly"
                            },
                            {
                                "target_lang_word": "unexpectedly",
                                "target_lang_sense_clarification": "not foreseen or predicted"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "表示情况发生得急促，出乎意料"
                            },
                            {
                                "target_lang_word": "忽然",
                                "target_lang_sense_clarification": "表示动作或情况发生得迅速"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd0fd3af-3e8a-3d57-8618-2f93c045b37f",
                    "sense_definition": "Употребляется для выражения предположения, допущения или опасения относительно возможного нежелательного события; соответствует по значению словам «а если», «возможно».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "what_if",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А <w>вдруг</w> они узнают правду?",
                            "target_lang_translations": {
                                "en": "<w>What if</w> they find out the truth?",
                                "zh": "<w>万一</w>他们知道了真相怎么办？"
                            }
                        },
                        {
                            "text": "Возьми с собой зонт, <w>вдруг</w> погода испортится.",
                            "target_lang_translations": {
                                "en": "Take an umbrella with you <w>in case</w> the weather turns bad.",
                                "zh": "带上伞吧，<w>万一</w>天气变坏呢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "а если",
                        "может статься",
                        "возможно"
                    ],
                    "common_phrases": [
                        "а вдруг"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express an assumption, supposition, or fear regarding a possible event; corresponds to \"what if\" or \"in case\".",
                        "zh": "用于表达对某种可能发生（通常是不希望发生）的情况的担忧或假设，相当于“万一”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what if",
                                "target_lang_sense_clarification": "used to suggest a possible future event, often with concern"
                            },
                            {
                                "target_lang_word": "in case",
                                "target_lang_sense_clarification": "as a precaution against a possible event"
                            },
                            {
                                "target_lang_word": "maybe",
                                "target_lang_sense_clarification": "expressing possibility"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "万一",
                                "target_lang_sense_clarification": "表示可能性极小但又不得不防的情况"
                            },
                            {
                                "target_lang_word": "要是",
                                "target_lang_sense_clarification": "用于假设某种情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc550c6c-0dbc-38cd-a327-92fb9d88d9f3",
                    "sense_definition": "Сразу, одновременно, в один момент (обычно в устаревших или книжных текстах).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "simultaneously",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все гости заговорили <w>вдруг</w>, перебивая друг друга.",
                            "target_lang_translations": {
                                "en": "All the guests started speaking <w>at once</w>, interrupting each other.",
                                "zh": "客人们<w>一齐</w>开口说话，互相打断对方。"
                            }
                        },
                        {
                            "text": "Такое сложное дело не сделаешь <w>вдруг</w>, нужно время.",
                            "target_lang_translations": {
                                "en": "You can't do such a complex job <w>all at once</w>; it takes time.",
                                "zh": "这么复杂的事情不可能<w>一下子</w>就做完，需要时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сразу",
                        "разом",
                        "зараз",
                        "за один приём"
                    ],
                    "antonyms": [
                        "порознь"
                    ],
                    "common_phrases": [
                        "не вдруг"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "в значении «одновременно» или «разом»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Immediately, simultaneously, or in a single moment (usually in dated or literary contexts).",
                        "zh": "指同时发生或在极短时间内完成（多见于书面语或旧式用法）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at once",
                                "target_lang_sense_clarification": "simultaneously or immediately"
                            },
                            {
                                "target_lang_word": "all at once",
                                "target_lang_sense_clarification": "suddenly and simultaneously"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一齐",
                                "target_lang_sense_clarification": "表示同时发生"
                            },
                            {
                                "target_lang_word": "一下子",
                                "target_lang_sense_clarification": "表示在极短的时间内"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}