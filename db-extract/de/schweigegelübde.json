                "senses": [
                    {
                        "sense_id": "9a8fb549-b64e-3355-a226-be4e76dcec7a",
                        "entry_id": "1593d13e-2025-3796-8bc8-3aaa0a35380d",
                        "glosses": [
                            "Versprechen (meist gegenüber Gott), nicht zu sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "638ea216-2fc4-4d3b-b1f2-e11f5cd74bf7",
                                "sense_id": "9a8fb549-b64e-3355-a226-be4e76dcec7a",
                                "text": "„Im Vergleich zu holländischen Zügen ähneln die deutschen einem Kloster mit Schweigegelübde.“"
                            },
                            {
                                "example_id": "2250343b-d4cf-49be-8f39-6f4c31da3ab1",
                                "sense_id": "9a8fb549-b64e-3355-a226-be4e76dcec7a",
                                "text": "„1314 war es nämlich, als der Habsburgische Herzog hungernd durch den Wienerwald irrte und danach die Kartause Mauerbach errichten ließ – ein Kloster für einen Prior und zwölf Mönche, die hier in der Abgeschiedenheit ihr Schweigegelübde lebten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
