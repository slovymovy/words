        "fr-extract.jsonl": [
            {
                "entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                "word": "oliban",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "871391be-0866-45b5-a89a-f6c85e932240",
                        "entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                        "tags": [
