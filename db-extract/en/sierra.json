                        "entry_id": "879f2ede-d68a-3d90-b687-847cd30adb5c",
                        "glosses": [
                            "Ellipsis of Sierra Nevada: a mountain range in the Western United States."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
